00151A  1                       .INCLUDE "io.asm"
00151A  2               ;
00151A  2               ;
00151A  2               ;
00151A  2               ; i/o
00151A  2               ;--------------------------------------------------------------
00151A  2               ; TLOAD: Load a text file from disk into the editor.
00151A  2               ; Prompts for filename, opens via DOS/65 PEM, reads sequential
00151A  2               ; 128-byte records into text memory, stops at CP/M EOF ($1A).
00151A  2               ;--------------------------------------------------------------
00151A  2               TLOAD:
00151A  2  20 D7 13 A9          TOPPRINTMESSAGE loadmsg ; "Load:" on command line
00151E  2  55 A0 17 20  
001522  2  28 09        
001524  2  A9 01                LDA     #1
001526  2  8D 49 06             STA     SHOWCRSR        ; TURN ON CURSOR
001529  2  20 3A 10             JSR     input           ; get filename in inbuff, length in A
00152C  2  F0 4C                BEQ     @tabort         ; empty = abort
00152E  2  8D 1F 18             STA     inlen
001531  2  20 05 16             JSR     fcb_prep        ; parse inbuff → fcb
001534  2               
001534  2               ; initialize DOS/65 file system
001534  2  A2 0D                LDX     #13
001536  2  20 03 01             JSR     PEM
001539  2               
001539  2  9C 49 06             STZ     SHOWCRSR        ; TURN OFF CURSOR
00153C  2               ; open the file (before erasing text!)
00153C  2  A9 00                LDA     #0
00153E  2  8D C0 1C             STA     fcb+32          ; next record = 0
001541  2  A9 A0                LDA     #<fcb
001543  2  A0 1C                LDY     #>fcb
001545  2  A2 0F                LDX     #15             ; PEM: open file
001547  2  20 03 01             JSR     PEM
00154A  2  C9 FF                CMP     #$FF
00154C  2  D0 03                BNE     :+
00154E  2  4C DC 15             JMP     @notfound       ; file not found
001551  2               :
001551  2               ; file opened successfully - now erase existing text
001551  2  20 EE 08             JSR     erase           ; resets curr/toplin/lastline to texstart
001554  2               
001554  2               ; set DMA buffer to codebuffer (128 bytes)
001554  2  A9 1B                LDA     #<codebuffer
001556  2  A0 19                LDY     #>codebuffer
001558  2  A2 1A                LDX     #26             ; PEM: set DMA address
00155A  2  20 03 01             JSR     PEM
00155D  2               
00155D  2               ; destination pointer: load at curr (= texstart after erase)
00155D  2  A5 5F 85 FB          COPY16  curr,tex
001561  2  A5 60 85 FC  
001565  2               
001565  2               @readloop:
001565  2  A9 A0                LDA     #<fcb
001567  2  A0 1C                LDY     #>fcb
001569  2  A2 14                LDX     #20             ; PEM: read sequential
00156B  2  20 03 01             JSR     PEM
00156E  2  A0 00                LDY     #0              ; default: no bytes to copy
001570  2  C9 00                CMP     #$00
001572  2  F0 0A                BEQ     @gotdata        ; success - 128 bytes in codebuffer
001574  2  C9 01                CMP     #$01
001576  2  F0 3D                BEQ     @closefile      ; EOF - done reading
001578  2  80 72                BRA     @ioerror        ; any other value = error
00157A  2               
00157A  2               @tabort:
00157A  2  20 C4 13             JSR     sysmsg          ; restore banner
00157D  2  60                   RTS
00157E  2               
00157E  2               @gotdata:
00157E  2               @copybyte:
00157E  2  B9 1B 19             LDA     codebuffer,Y
001581  2  C9 1A                CMP     #$1A            ; CP/M EOF marker?
001583  2  F0 30                BEQ     @closefile
001585  2  C9 0A                CMP     #10
001587  2  D0 0B                BNE     :++
001589  2  A5 FB                LDA     tex
00158B  2  D0 02                BNE     :+
00158D  2  C6 FC                DEC     tex+1
00158F  2               :
00158F  2  C6 FB                DEC     tex
001591  2  4C 9C 15             JMP     @skipbyte
001594  2               :
001594  2  C9 0D                CMP     #13
001596  2  D0 02                bne     :+
001598  2  A9 1F                LDA     #retchar
00159A  2               :
00159A  2  91 FB                STA     (tex),Y         ; store in text memory
00159C  2               @skipbyte:
00159C  2  C8                   INY
00159D  2  C0 80                CPY     #128
00159F  2  D0 DD                BNE     @copybyte
0015A1  2               
0015A1  2               ; advance destination by 128 bytes
0015A1  2  18                   CLC
0015A2  2  A5 FB                LDA     tex
0015A4  2  69 80                ADC     #128
0015A6  2  85 FB                STA     tex
0015A8  2  A5 FC                LDA     tex+1
0015AA  2  69 00                ADC     #0
0015AC  2  85 FC                STA     tex+1
0015AE  2               
0015AE  2               ; check for text area overflow
0015AE  2  A5 FC                LDA     tex+1
0015B0  2  CD 10 18             CMP     texend+1
0015B3  2  90 B0                BCC     @readloop       ; still room
0015B5  2               ; fall through to close (text area full)
0015B5  2               
0015B5  2               @closefile:
0015B5  2               ; lastline = tex + Y (end of loaded data)
0015B5  2  98                   TYA
0015B6  2  18                   CLC
0015B7  2  65 FB                ADC     tex
0015B9  2  8D 1C 18             STA     lastline
0015BC  2  A5 FC                LDA     tex+1
0015BE  2  69 00                ADC     #0
0015C0  2  8D 1D 18             STA     lastline+1
0015C3  2               
0015C3  2               ; close the file
0015C3  2  A9 A0                LDA     #<fcb
0015C5  2  A0 1C                LDY     #>fcb
0015C7  2  A2 10                LDX     #16             ; PEM: close file
0015C9  2  20 03 01             JSR     PEM
0015CC  2               
0015CC  2  20 D7 13 A9          TOPPRINTMESSAGE okmsg
0015D0  2  4B A0 17 20  
0015D4  2  28 09        
0015D6  2  A9 01                LDA     #1
0015D8  2  8D 18 18             STA     msgflg
0015DB  2  60                   RTS                     ; returns to main (via stacked return addr)
0015DC  2               
0015DC  2               @notfound:
0015DC  2  20 D7 13 A9          TOPPRINTMESSAGE fnfmsg
0015E0  2  32 A0 17 20  
0015E4  2  28 09        
0015E6  2  A9 01                LDA     #1
0015E8  2  8D 18 18             STA     msgflg
0015EB  2  60                   RTS
0015EC  2               
0015EC  2               @ioerror:
0015EC  2               ; close file on error
0015EC  2  A9 A0                LDA     #<fcb
0015EE  2  A0 1C                LDY     #>fcb
0015F0  2  A2 10                LDX     #16
0015F2  2  20 03 01             JSR     PEM
0015F5  2  20 D7 13 A9          TOPPRINTMESSAGE ioerrmsg
0015F9  2  41 A0 17 20  
0015FD  2  28 09        
0015FF  2  A9 01                LDA     #1
001601  2  8D 18 18             STA     msgflg
001604  2  60                   RTS
001605  2               
001605  2               
001605  2               
001605  2               ;--------------------------------------------------------------
001605  2               ; fcb_prep: Parse filename from inbuff into fcb (33-byte FCB).
001605  2               ; Handles optional "X:" drive prefix, 8.3 format, uppercase.
001605  2               ; Input: inbuff (null-terminated filename)
001605  2               ; Output: fcb filled with drive, name, extension, zeros
001605  2               ;--------------------------------------------------------------
001605  2               fcb_prep:
001605  2               ; clear entire fcb to zeros
001605  2  A2 20                LDX     #32
001607  2  A9 00                LDA     #0
001609  2               @clr:
001609  2  9D A0 1C             STA     fcb,X
00160C  2  CA                   DEX
00160D  2  10 FA                BPL     @clr
00160F  2               
00160F  2               ; fill name (bytes 1-8) and extension (bytes 9-11) with spaces
00160F  2  A2 01                LDX     #1
001611  2  A9 20                LDA     #space
001613  2               @spc:
001613  2  9D A0 1C             STA     fcb,X
001616  2  E8                   INX
001617  2  E0 0C                CPX     #12
001619  2  D0 F8                BNE     @spc
00161B  2               
00161B  2               ; check for drive prefix (e.g., "A:")
00161B  2  A0 00                LDY     #0              ; Y = index into inbuff
00161D  2  AD 73 18             LDA     inbuff+1
001620  2  C9 3A                CMP     #':'
001622  2  D0 0E                BNE     @nodrive
001624  2               ; extract drive letter
001624  2  AD 72 18             LDA     inbuff
001627  2  20 6A 16             JSR     @toupper
00162A  2  38                   SEC
00162B  2  E9 40                SBC     #'A'-1          ; A=1, B=2, etc.
00162D  2  8D A0 1C             STA     fcb             ; fcb+0 = drive number
001630  2  A0 02                LDY     #2              ; skip past "X:"
001632  2               @nodrive:
001632  2               ; copy filename (up to 8 chars, until '.' or null)
001632  2  A2 01                LDX     #1              ; X = FCB position (1-8)
001634  2               @fname:
001634  2  B9 72 18             LDA     inbuff,Y
001637  2  F0 30                BEQ     @done           ; null terminator = end
001639  2  C9 2E                CMP     #'.'
00163B  2  F0 18                BEQ     @doext          ; dot = start extension
00163D  2  20 6A 16             JSR     @toupper
001640  2  9D A0 1C             STA     fcb,X
001643  2  C8                   INY
001644  2  E8                   INX
001645  2  E0 09                CPX     #9              ; max 8 chars for name
001647  2  D0 EB                BNE     @fname
001649  2               ; if name > 8 chars, skip to dot or end
001649  2               @skip:
001649  2  B9 72 18             LDA     inbuff,Y
00164C  2  F0 1B                BEQ     @done
00164E  2  C9 2E                CMP     #'.'
001650  2  F0 03                BEQ     @doext
001652  2  C8                   INY
001653  2  80 F4                BRA     @skip
001655  2               
001655  2               @doext:
001655  2  C8                   INY                     ; skip the '.'
001656  2  A2 09                LDX     #9              ; X = FCB position (9-11)
001658  2               @ext:
001658  2  B9 72 18             LDA     inbuff,Y
00165B  2  F0 0C                BEQ     @done           ; null terminator
00165D  2  20 6A 16             JSR     @toupper
001660  2  9D A0 1C             STA     fcb,X
001663  2  C8                   INY
001664  2  E8                   INX
001665  2  E0 0C                CPX     #12             ; max 3 chars for extension
001667  2  D0 EF                BNE     @ext
001669  2               @done:
001669  2  60                   RTS
00166A  2               
00166A  2               @toupper:
00166A  2  C9 61                CMP     #'a'
00166C  2  90 06                BCC     @noup
00166E  2  C9 7B                CMP     #'z'+1
001670  2  B0 02                BCS     @noup
001672  2  29 DF                AND     #$DF            ; clear bit 5 → uppercase
001674  2               @noup:
001674  2  60                   RTS
001675  2               
001675  2               TSAVE:
001675  2               verify:
001675  2               catalog:
001675  2               dcmnd:
001675  2               print:
001675  2               ;; stubs - not yet implemented
001675  2  60                   RTS
