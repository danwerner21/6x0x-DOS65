0013D7  2               ;topclr keeps the command line clean.
0013D7  2               ;It is called before most messages.
0013D7  2               ;It's like a one-line clear-screen.
0013D7  2               topclr:
0013D7  2               ; map video text page into $A000-$AFFF
0013D7  2  A0 F9                LDY     #VIDTEXT_PAGE
0013D9  2  20 EA 14             JSR     vid_enter
0013DC  2               ; fill row 0 ($A000-$A04F) with spaces
0013DC  2  A0 4F                LDY     #79
0013DE  2  A9 20                LDA     #space
0013E0  2               @tcloop:
0013E0  2  99 00 A0             STA     $A000,Y
0013E3  2  88                   DEY
0013E4  2  10 FA                BPL     @tcloop
0013E6  2               ; unmap video
0013E6  2  20 F7 14             JSR     vid_exit
0013E9  2               ; position firmware cursor at row 0, col 0 for PRINTMESSAGE
0013E9  2  A2 00                LDX     #0
0013EB  2  A0 00                LDY     #0
0013ED  2  A9 25                LDA     #FC_LOCATE
0013EF  2  85 32                STA     farfunct
0013F1  2  20 F0 FF             JSR     DO_FARCALL
0013F4  2  60                   RTS
