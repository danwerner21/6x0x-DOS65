000000r 1               ;__SpeedScript_________________________________________________________________
000000r 1               ;
000000r 1               ; SpeedScript 3.1 by Charles Brannon
000000r 1               ; published in Compute Magazine for various 8-bit computers.
000000r 1               ; This project is a port of the Commodore 64 version of SpeedScript
000000r 1               ; to the 6502PC running DOS/65 with the memory mapped video card.
000000r 1               ;
000000r 1               ;______________________________________________________________________________
000000r 1                       .PSC02
000000r 1               
000000r 1                       .SEGMENT "TEA"
000000r 1                       .ORG    $0800
000800  1               
000800  1                       .INCLUDE "macro.asm"
000800  2               ; some macros
000800  2                       .macro COPY16  src, dst
000800  2                       LDA     src
000800  2                       STA     dst
000800  2                       LDA     src+1
000800  2                       STA     dst+1
000800  2                       .endmacro
000800  2               
000800  2                       .macro COPY162  src, dst, dst2
000800  2                       LDA     src
000800  2                       STA     dst
000800  2                       STA     dst2
000800  2                       LDA     src+1
000800  2                       STA     dst+1
000800  2                       STA     dst2+1
000800  2                       .endmacro
000800  2               
000800  2               
000800  2                       .macro ADD16   left,right
000800  2                       CLC
000800  2                       LDA     left
000800  2                       ADC     right
000800  2                       STA     left
000800  2                       LDA     left+1
000800  2                       ADC     right+1
000800  2                       STA     left+1
000800  2                       .endmacro
000800  2               
000800  2               ;Compares two 16-bit values, and sets the C and Z flags the
000800  2               ;same as a LDA and CMP;instruction would for 8-bit addresses.
000800  2                       .macro COMP16  left,right
000800  2                       SEC
000800  2                       LDA     left
000800  2                       SBC     right
000800  2                       STA     temp
000800  2                       LDA     left+1
000800  2                       SBC     right+1
000800  2                       ORA     temp
000800  2                       .endmacro
000800  2               
000800  2               ; Compares two 16-bit values but only affects the C flag.
000800  2                       .macro COMPC16 left,right
000800  2                       SEC
000800  2                       LDA     left
000800  2                       SBC     right
000800  2                       LDA     left+1
000800  2                       SBC     right+1
000800  2                       .endmacro
000800  2               
000800  2               ;  sub16 left,right       :  left - right -> left
000800  2               ;  sub16 left,right,dst   : left - right -> dst
000800  2                       .macro SUB16   left,right
000800  2                       SEC
000800  2                       LDA     left
000800  2                       SBC     right
000800  2                       STA     left
000800  2                       LDA     left+1
000800  2                       SBC     right+1
000800  2                       STA     left+1
000800  2                       .endmacro
000800  2               
000800  2                       .macro SUB162   left,right,dst
000800  2                       SEC
000800  2                       LDA     left
000800  2                       SBC     right
000800  2                       STA     dst
000800  2                       LDA     left+1
000800  2                       SBC     right+1
000800  2                       STA     dst+1
000800  2                       .endmacro
000800  2               
000800  2               ; Subtract an 8-bit value from a 16-bit one
000800  2                       .macro  SUB8    left,right
000800  2                       SEC
000800  2                       LDA     left
000800  2                       SBC     right
000800  2                       STA     left
000800  2                       LDA     left+1
000800  2                       SBC     #0
000800  2                       STA     left+1
000800  2                       .endmacro
000800  2               
000800  2               
000800  2                       .macro  SUB82    left,right,dst
000800  2                       SEC
000800  2                       LDA     left
000800  2                       SBC     right
000800  2                       STA     dst
000800  2                       LDA     left+1
000800  2                       SBC     #0
000800  2                       STA     dst+1
000800  2                       .endmacro
000800  2               
000800  2                       .macro  SUB83    left,right,dst,dst2
000800  2                       SEC
000800  2                       LDA     left
000800  2                       SBC     right
000800  2                       STA     dst
000800  2                       STA     dst2
000800  2                       LDA     left+1
000800  2                       SBC     #0
000800  2                       STA     dst+1
000800  2                       STA     dst2+1
000800  2                       .endmacro
000800  2               
000800  2                       .macro PRINTMESSAGE message
000800  2                       LDA     #<message
000800  2                       LDY     #>message
000800  2                       JSR     PRMSG
000800  2                       .endmacro
000800  2               
000800  2                       .macro  TOPPRINTMESSAGE message
000800  2                       JSR     topclr
000800  2                       PRINTMESSAGE message
000800  2                       .endmacro
000800  2               
000800  2               ;Display a 16-bit integer from the A and X registers
000800  2               ;in decimal using CHROUT.
000800  2                       .macro         DISPLAY_NUMBER
000800  2                       JSR     displaynum
000800  2                       .endmacro
000800  2               
000800  2               ;TODO: convert to something that works on X16
000800  2               ; should branch if the SHIFT and CTRL keys are
000800  2               ; specifically held down.
000800  2                       .macro   B_UNLESS_SHIFT_CTRL addr
000800  2                       LDA     653
000800  2                       CMP     #5
000800  2                       BNE     addr
000800  2                       .endmacro
000800  2               
000800  2               ;TODO: convert to something that works on X16
000800  2               ; should branch if the SHIFT key is held down,
000800  2               ; regardless of any other qualifiers
000800  2                       .macro        B_UNLESS_SHIFT addr
000800  2                       LDA     653
000800  2                       AND     #1
000800  2                       BNE     addr
000800  2                       .endmacro
000800  2               
000800  2                       .MACRO  B_IF_PUNCT dst
000800  2                       CMP     #'.'
000800  2                       BEQ     dst
000800  2                       CMP     #'!'
000800  2                       BEQ     dst
000800  2                       CMP     #'?'
000800  2                       BEQ     dst
000800  2                       .ENDMACRO
000800  2               
000800  2                       .macro        PRCODE  dst
000800  2                       JSR     aschex
000800  2                       STA     dst
000800  2                       .endmacro
000800  2                       .macro  PRCODE16 dst
000800  2                       PRCODE  dst
000800  2                       LDA     hex+1
000800  2                       STA     dst+1
000800  2                       .endmacro
000800  2               
000800  2                       .macro  RVS_TEXT text
000800  2                       .BYTE   $12
000800  2                       .BYTE   text
000800  2                       .BYTE   $92
000800  2                       .endmacro
