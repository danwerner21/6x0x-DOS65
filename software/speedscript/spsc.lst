001361  2               
001361  2               ;The initialization routine sets up the
001361  2               ;memory map, clears out certain flags,
001361  2               ;and enables the raster interrupt
001361  2               
001361  2               INIT:
001361  2               ; set 80 col text mode here
001361  2  A2 50                LDX     #80
001363  2  86 50                STX     COLUMNS
001365  2               ; Use 23 rows so refresh paints rows 1-22 only.
001365  2               ; Row 0 = banner, row 23 = unused. Screen has 24 rows (0-23).
001365  2               ; Painting row 23 wraps cursor to row 24 which auto-scrolls.
001365  2  A0 17                LDY     #23
001367  2  84 51                STY     ROWS
001369  2               ; clear screen
001369  2  A9 26                LDA     #FC_SCNCLR
00136B  2  85 32                STA     farfunct
00136D  2  20 F0 FF             JSR     DO_FARCALL
001370  2               ; init default cursor tracking
001370  2  A9 01                LDA     #1
001372  2  85 5D                STA     csrrow
001374  2  64 5C                STZ     csrcol
001376  2               
001376  2  A9 01                LDA     #TOPFGCOLOR
001378  2  8D 19 18             STA     INSMODE
00137B  2  9C 0D 18             STZ     texstart
00137E  2  9C 0F 18             STZ     texend
001381  2  9C 11 18             STZ     texbuf
001384  2  9C 13 18             STZ     bufend
001387  2  9C DD 18             STZ     huntlen
00138A  2  9C FC 18             STZ     replen
00138D  2  9C 49 06             STZ     SHOWCRSR        ; TURN OFF CURSOR
001390  2               
001390  2  A9 1C                LDA     #>END           ;
001392  2  1A                   INC
001393  2  8D 0E 18             STA     texstart+1
001396  2  A9 90                LDA     #>TEXEND_INIT
001398  2  8D 10 18             STA     texend+1
00139B  2  A9 A0                LDA     #>TEXBUF_INIT
00139D  2  8D 12 18             STA     texbuf+1
0013A0  2  A9 B8                LDA     #>BUFEND_INIT
0013A2  2  8D 14 18             STA     bufend+1
0013A5  2  8D DB 18             STA     fpos+1
0013A8  2  60                   RTS
