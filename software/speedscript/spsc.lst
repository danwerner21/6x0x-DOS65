0013F9  2  85 32                STA     farfunct
0013FB  2  20 F0 FF             JSR     DO_FARCALL      ; returns A=key or A=$FF if no key
0013FE  2  7A                   PLY
0013FF  2  FA                   PLX
001400  2  C9 FF                CMP     #$FF
001402  2  D0 02                BNE     @gotkey
001404  2  A9 00                LDA     #0              ; return 0 for "no key"
001406  2               @gotkey:
001406  2  60                   RTS
001407  2               
001407  2               chrout:
001407  2  DA                   PHX
001408  2  5A                   PHY
001409  2  48                   PHA                     ; save character
00140A  2  A9 13                LDA     #FC_CHROUT      ; FARCALL #19 - output char
00140C  2  85 32                STA     farfunct
00140E  2  68                   PLA                     ; restore character to A
00140F  2  20 F0 FF             JSR     DO_FARCALL
001412  2  7A                   PLY
001413  2  FA                   PLX
001414  2  60                   RTS
001415  2               
001415  2               ; drain all pending keystrokes from the keyboard buffer
001415  2               drainkeys:
001415  2  A2 0B                LDX     #11             ; keyboard status
001417  2  20 03 01             JSR     PEM
00141A  2  C9 00                CMP     #0
00141C  2  F0 08                BEQ     @drained
00141E  2  A2 06                LDX     #6              ; consume the key
001420  2  20 03 01             JSR     PEM
001423  2  4C 15 14             JMP     drainkeys
001426  2               @drained:
001426  2  60                   RTS
001427  2               
001427  2               ;refresh copies a screenful of text
001427  2               ;from the area of memory pointed to by
001427  2               ;toplin. It works like a printer routine,
001427  2               ;fitting a line of text between the screen
001427  2               ;margins, wrapping words, and restarts
001427  2               ;at the left margin after printing a car-
001427  2               ;riage return.
001427  2               ;
001427  2               ;It also tracks the screen position of
001427  2               ;the cursor (curr) so the hardware cursor
001427  2               ;can be painted there afterward.
001427  2               ;
001427  2               ;Uses direct video memory writes via MMU
001427  2               ;paging for performance (~18x faster than
001427  2               ;per-character FARCALL calls).
001427  2               
001427  2               refresh:
001427  2               ; force screen dimensions (protect against corruption)
001427  2  A9 17                LDA     #23
001429  2  85 51                STA     ROWS
00142B  2  A9 50                LDA     #80
00142D  2  85 50                STA     COLUMNS
00142F  2               ; set pointer tex to top of visible text
00142F  2  AD 16 18 85          COPY16  toplin,tex
001433  2  FB AD 17 18  
001437  2  85 FC        
001439  2  A9 01                LDA     #1
00143B  2  85 5B                STA     scrrow          ; start at screen row 1 (row 0 = command line)
00143D  2               ; default cursor position (in case curr is off-screen)
00143D  2  A9 01                LDA     #1
00143F  2  85 5D                STA     csrrow
001441  2  64 5C                STZ     csrcol
001443  2               
001443  2               ; map video text page into $A000-$AFFF
001443  2  A0 F9                LDY     #VIDTEXT_PAGE
001445  2  20 EA 14             JSR     vid_enter
001448  2               ; initialize video pointer to row 1 ($A000 + 1*80 = $A050)
001448  2  A9 50                LDA     #$50
00144A  2  85 FD                STA     indir
00144C  2  A9 A0                LDA     #$A0
00144E  2  85 FE                STA     indir+1
001450  2               
001450  2               ; main page loop: process one screen row per iteration
001450  2               RPPAGE:
001450  2  A0 00                LDY     #0
001452  2               ; scan text for line break point
001452  2               RPLINE:
001452  2  B1 FB                LDA     (tex),Y
001454  2  C8                   INY
001455  2  29 7F                AND     #$7F            ; strip high bit for comparison
001457  2  C9 1F                CMP     #retchar        ; end of paragraph?
001459  2  F0 14                BEQ     RBREAK
00145B  2  C4 50                CPY     COLUMNS
00145D  2  D0 F3                BNE     RPLINE
00145F  2               
00145F  2               ; hit screen width without a paragraph break - word wrap
00145F  2               ; scan backward for a space to break at
00145F  2  88                   DEY
001460  2               RSLOOP:
001460  2  B1 FB                LDA     (tex),Y
001462  2  29 7F                AND     #$7F
001464  2  C9 20                CMP     #space
001466  2  F0 06                BEQ     RSBRK           ; found a space - wrap here
001468  2  88                   DEY
001469  2  D0 F5                BNE     RSLOOP
00146B  2               ; no space found in entire line - force break at column width
00146B  2  A4 50                LDY     COLUMNS
00146D  2  88                   DEY
00146E  2               RSBRK:
00146E  2  C8                   INY                     ; wrap point (char after the space)
00146F  2               RBREAK:
00146F  2  84 5E                STY     temp            ; temp = number of chars in this line
001471  2               
001471  2               ; copy line to video memory, tracking cursor position
001471  2  A0 00                LDY     #0
001473  2               RCOPY:
001473  2               ; check if this text position is the cursor (tex + Y == curr?)
001473  2  98                   TYA
001474  2  18                   CLC
001475  2  65 FB                ADC     tex             ; A = low byte of tex+Y
001477  2  48                   PHA                     ; save (preserves carry for high byte calc)
001478  2  A5 FC                LDA     tex+1
00147A  2  69 00                ADC     #0              ; A = high byte of tex+Y
00147C  2  C5 60                CMP     curr+1          ; compare high bytes
00147E  2  D0 0D                BNE     @nocsr
001480  2  68                   PLA                     ; A = low byte of tex+Y
001481  2  C5 5F                CMP     curr            ; compare low bytes
001483  2  D0 09                BNE     @nocsr2
001485  2               ; found the cursor position on screen
001485  2  84 5C                STY     csrcol
001487  2  A5 5B                LDA     scrrow
001489  2  85 5D                STA     csrrow
00148B  2  80 01                BRA     @dochr
00148D  2               @nocsr:
00148D  2  68                   PLA                     ; clean up stack
00148E  2               @nocsr2:
00148E  2               @dochr:
00148E  2               ; read character from text memory and write to video RAM
00148E  2  B1 FB                LDA     (tex),Y         ; read from text buffer (below $A000)
001490  2  29 7F                AND     #$7F            ; strip high bit
001492  2  C9 20                CMP     #space
001494  2  B0 02                BCS     @rok            ; >= 32 is printable
001496  2  A9 20                LDA     #space          ; replace control chars with space
001498  2               @rok:
001498  2  91 FD                STA     (indir),Y       ; write directly to video RAM
00149A  2  C8                   INY
00149B  2  C4 5E                CPY     temp
00149D  2  D0 D4                BNE     RCOPY
00149F  2               
00149F  2               ; store length of first screen line in LENTABLE
00149F  2  A5 5B                LDA     scrrow
0014A1  2  C9 01                CMP     #1
0014A3  2  D0 05                BNE     RCLRLN
0014A5  2  A5 5E                LDA     temp
0014A7  2  8D 15 18             STA     LENTABLE
0014AA  2               
0014AA  2               ; pad remainder of line with spaces
0014AA  2               RCLRLN:
0014AA  2  A4 5E                LDY     temp
0014AC  2  A9 20                LDA     #space
0014AE  2               @rpad:
0014AE  2  C4 50                CPY     COLUMNS
0014B0  2  F0 05                BEQ     RCLEARED
0014B2  2  91 FD                STA     (indir),Y       ; write space to video RAM
0014B4  2  C8                   INY
0014B5  2  80 F7                BRA     @rpad
0014B7  2               
0014B7  2               RCLEARED:
0014B7  2               ; advance tex past the characters consumed
0014B7  2  18                   CLC
0014B8  2  A5 5E                LDA     temp
0014BA  2  65 FB                ADC     tex
0014BC  2  85 FB                STA     tex
0014BE  2  A5 FC                LDA     tex+1
0014C0  2  69 00                ADC     #0
0014C2  2  85 FC                STA     tex+1
0014C4  2               
0014C4  2               ; advance video pointer to next row (+80 bytes)
0014C4  2  18                   CLC
0014C5  2  A5 FD                LDA     indir
0014C7  2  69 50                ADC     #80
0014C9  2  85 FD                STA     indir
0014CB  2  A5 FE                LDA     indir+1
0014CD  2  69 00                ADC     #0
0014CF  2  85 FE                STA     indir+1
0014D1  2               
0014D1  2               ; next screen row
0014D1  2  E6 5B                INC     scrrow
0014D3  2  A5 5B                LDA     scrrow
0014D5  2  C5 51                CMP     ROWS
0014D7  2  F0 03                BEQ     @refdone
0014D9  2  4C 50 14             JMP     RPPAGE
0014DC  2               @refdone:
0014DC  2               
0014DC  2               ; unmap video memory
0014DC  2  20 F7 14             JSR     vid_exit
0014DF  2               ; record bottom-of-screen text address
0014DF  2  A5 FB 8D 20          COPY16  tex,BOTSCR
0014E3  2  18 A5 FC 8D  
0014E7  2  21 18        
0014E9  2  60                   RTS
0014EA  2               
0014EA  2               ; --- video memory paging helpers ---
0014EA  2               ; Following the pattern from dbasic/screencmds.asm
0014EA  2               
0014EA  2               ; Map a video sub-page into $A000-$AFFF via Task 01.
0014EA  2               ; Y = video sub-page (e.g. VIDTEXT_PAGE for text chars).
0014EA  2               ; Trashes A, X. Preserves Y.
0014EA  2               vid_enter:
0014EA  2  A9 01                LDA     #$01            ; configure Task 01
0014EC  2  A2 0A                LDX     #$0A            ; bank $A ($A000-$AFFF)
0014EE  2  20 F6 FF             JSR     SETPAGE         ; Y = video sub-page (set by caller)
0014F1  2  A9 01                LDA     #$01
0014F3  2  8D E0 EF             STA     PC6502_ACT_TASK ; switch to Task 01
0014F6  2  60                   RTS
0014F7  2               
0014F7  2               ; Switch back to Task 00 (normal memory at $A000-$AFFF).
0014F7  2               vid_exit:
0014F7  2  A9 00                LDA     #$00
0014F9  2  8D E0 EF             STA     PC6502_ACT_TASK ; switch to Task 00
0014FC  2  60                   RTS
0014FD  2               
0014FD  2               ; --- cursor helpers using FARCALL #58/#59 ---
0014FD  2               
0014FD  2               ; Paint the hardware cursor at the position found during refresh.
0014FD  2               ; Call this AFTER refresh returns.
0014FD  2               showcursor:
0014FD  2  A6 5C                LDX     csrcol
0014FF  2  A4 5D                LDY     csrrow
001501  2  A9 25                LDA     #FC_LOCATE
001503  2  85 32                STA     farfunct
001505  2  20 F0 FF             JSR     DO_FARCALL
001508  2  A9 3A                LDA     #FC_PAINTCSR
00150A  2  85 32                STA     farfunct
00150C  2  20 F0 FF             JSR     DO_FARCALL
00150F  2  60                   RTS
001510  2               
001510  2               ; Remove the hardware cursor from the screen.
001510  2               ; Call this BEFORE refresh or when processing a keypress.
001510  2               hidecursor:
001510  2  A9 3B                LDA     #FC_UNPAINTCSR
001512  2  85 32                STA     farfunct
001514  2  20 F0 FF             JSR     DO_FARCALL
001517  2  60                   RTS
001518  2               
001518  2               BORDER:
001518  2  60                   RTS
001519  2               
001519  2               scrcol:
001519  2               LETTERS:
001519  2  60                   RTS
