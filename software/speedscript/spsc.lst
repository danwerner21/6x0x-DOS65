000800  2               ;Locations used by high-speed memory
000800  2               ;move routines:
000800  2               
000800  2               froml           = $26
000800  2               fromh           = $27
000800  2               destl           = $28
000800  2               desth           = $29
000800  2               llen            = $2A
000800  2               hlen            = $2B
000800  2               
000800  2               ;curr: Position of cursor within text
000800  2               ;memory. scr: used by the refresh
000800  2               ;routine.
000800  2               
000800  2               curr            = $39
000800  2               
000800  2               ;tex: An alternate location used in tan-
000800  2               ;dem with curr. COLR is used by RE-
000800  2               ;FRESH. temp is used throughout as a
000800  2               ;reusable scratchpad pointer. INDIR is
000800  2               ;also a reusable indirect pointer.
000800  2               ;UNDERCURS stores the value of the
000800  2               ;character highlighted by the cursor.
000800  2               
000800  2               tex             = $FB
000800  2               temp            = $3B
000800  2               indir           = $FD
000800  2               UNDERCURS       = $FA
000800  2               
000800  2               ;WINDCOLR: Color of command line
000800  2               ;window supported by refresh.
000800  2               ;RETCHAR is the screen-
000800  2               ;code value of the return mark (a left-
000800  2               ;pointing arrow).
000800  2               
000800  2               windcolr        = $0C
000800  2               retchar         = 31
000800  2               
000800  2               
000800  2               
000800  2               ;SCREEN          = $FFED
000800  2               ;PLOT            = $FFF0
000800  2               ;chrout          = $FFD2
000800  2               ;stop            = $FFE1
000800  2               ;setlfs          = $FFBA
000800  2               ;setnam          = $FFBD
000800  2               ;clall           = $FFE7
000800  2               ;open            = $FFC0
000800  2               ;chrin           = $FFCF
000800  2               ;chkin           = $FFC6
000800  2               ;chkout          = $FFC9
000800  2               ;getin           = $FFE4
000800  2               ;clrchn          = $FFCC
000800  2               ;close           = $FFC3
000800  2               ;load            = $FFD5
000800  2               ;save            = $FFD8
000800  2               ;ioinit          = $FF84
000800  2               ;scnkey = $FF9F ; not supported in x16?
000800  2               
000800  2               ; VERA I/O registers
000800  2               ;V_H_INC1        = $10
