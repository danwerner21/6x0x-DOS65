000800  1               
000800  1               ;Called only when initally run. It is
000800  1               ;assumed that the author's initials (that
000800  1               ;conveniently work out in hex) are not
000800  1               ;normally present in memory. If they
000800  1               ;are, we know that SpeedScript has been
000800  1               ;run before, so we avoid the ERASE
000800  1               ;routine to preserve the text in memory.
000800  1               
000800  1               BEGIN:
000800  1  20 CC 13             JSR     INIT
000803  1  A9 CB                LDA     #$CB
000805  1  CD A2 19             CMP     firstrun
000808  1  8D A2 19             STA     firstrun
00080B  1  F0 03                BEQ     SKIPERAS
00080D  1  20 F8 08             JSR     erase
000810  1               SKIPERAS:
000810  1  20 04 14             JSR     INIT2
000813  1  4C 49 09             JMP     main
000816  1               
000816  1               ;UMOVE is a high-speed memory move
000816  1               ;routine. It gets its speed from self-
000816  1               ;modifying code (the $0000's at
000816  1               ;MOVLOOP are replaced by actual ad-
000816  1               ;dresses when UMOVE is called). Some
000816  1               ;assemblers may assemble this as a
000816  1               ;zero-page mode, so you may want to
000816  1               ;change the $0000's to $FFFF's. UMOVE
000816  1               ;is used to move an overlapping range
000816  1               ;of memory upward, so it is used to de-
000816  1               ;lete. Set froml/fromh to point to
000816  1               ;the source area of memory,
000816  1               ;destl/desth to point to the destina-
000816  1               ;tion, and llen/hlen to hold the
000816  1               ;length of the area being moved.
000816  1               
000816  1               umove:
000816  1  A5 26                LDA     froml
000818  1  8D 36 08             STA     MOVLOOP+1
00081B  1  A5 27                LDA     fromh
00081D  1  8D 37 08             STA     MOVLOOP+2
000820  1  A5 28                LDA     destl
000822  1  8D 39 08             STA     MOVLOOP+4
000825  1  A5 29                LDA     desth
000827  1  8D 3A 08             STA     MOVLOOP+5
00082A  1  A6 2B                LDX     hlen
00082C  1  F0 20                BEQ     SKIPMOV
00082E  1               MOV1:
00082E  1  A9 00                LDA     #0
000830  1               MOV2:
000830  1  8D 49 16             STA     endpos
000833  1  A0 00                LDY     #0
000835  1               MOVLOOP:
000835  1  B9 00 00             LDA     $0000,Y
000838  1  99 00 00             STA     $0000,Y
00083B  1  C8                   INY
00083C  1  CC 49 16             CPY     endpos
00083F  1  D0 F4                BNE     MOVLOOP
000841  1  EE 37 08             INC     MOVLOOP+2
000844  1  EE 3A 08             INC     MOVLOOP+5
000847  1  E0 00                CPX     #0
000849  1  F0 07                BEQ     OUT
00084B  1  CA                   DEX
00084C  1  D0 E0                BNE     MOV1
00084E  1               SKIPMOV:
00084E  1  A5 2A                LDA     llen
000850  1  D0 DE                BNE     MOV2
000852  1               OUT:
000852  1  60                   RTS
000853  1               ;DMOVE uses the same variables as UMOVE, but is used to move an
000853  1               ;overlapping block of memory down ward, so it is used to insert. If the block
000853  1               ;of memory to be moved does not overlap the destination area, then either
000853  1               ;routine can be used.
000853  1               dmove:
000853  1  A5 2B                LDA     hlen
000855  1  AA                   TAX
000856  1  05 2A                ORA     llen
000858  1  D0 01                BNE     NOTNULL
00085A  1  60                   RTS
00085B  1               NOTNULL:
00085B  1  18                   CLC
00085C  1  8A                   TXA
00085D  1  65 27                ADC     fromh
00085F  1  8D 7E 08             STA     DMOVLOOP+2
000862  1  A5 26                LDA     froml
000864  1  8D 7D 08             STA     DMOVLOOP+1
000867  1  18                   CLC
000868  1  8A                   TXA
000869  1  65 29                ADC     desth
00086B  1  8D 81 08             STA     DMOVLOOP+5
00086E  1  A5 28                LDA     destl
000870  1  8D 80 08             STA     DMOVLOOP+4
000873  1  E8                   INX
000874  1  A4 2A                LDY     llen
000876  1  D0 04                BNE     DMOVLOOP
000878  1  F0 0D                BEQ     SKIPDMOV
00087A  1               DMOV1:
00087A  1  A0 FF                LDY     #255
00087C  1               DMOVLOOP:
00087C  1  B9 00 00             LDA     $0000,Y
00087F  1  99 00 00             STA     $0000,Y
000882  1  88                   DEY
000883  1  C0 FF                CPY     #255
000885  1  D0 F5                BNE     DMOVLOOP
000887  1               SKIPDMOV:
000887  1  CE 7E 08             DEC     DMOVLOOP+2
00088A  1  CE 81 08             DEC     DMOVLOOP+5
00088D  1  CA                   DEX
00088E  1  D0 EA                BNE     DMOV1
000890  1  60                   RTS
000891  1               
000891  1               ; displaynum replaces the call to BASIC $BCDC
000891  1               ; from the original one.
000891  1               nums:
000891  1  01 00 0A 00          .WORD   1,10,100,1000,10000
000895  1  64 00 E8 03  
000899  1  10 27        
00089B  1               numarg:
00089B  1  00 00                .WORD   0
00089D  1               numspace:
00089D  1  20                   .BYTE   $20
00089E  1               displaynum:
00089E  1  8E 9B 08             STX     numarg
0008A1  1  8D 9C 08             STA     numarg+1
0008A4  1               ;lda #space
0008A4  1               ;jsr chrout ; leading space just like real one
0008A4  1               basicdisplaynum:
0008A4  1  A0 08                LDY     #8
0008A6  1               dnzz:
0008A6  1  AD 9C 08             LDA     numarg+1
0008A9  1  D9 92 08             CMP     nums+1,y
0008AC  1  90 0A                BCC     dn2
0008AE  1  D0 0C                BNE     startout
0008B0  1  AD 9B 08             LDA     numarg
0008B3  1  D9 91 08             CMP     nums,y
0008B6  1  B0 04                BCS     startout
0008B8  1               dn2:
0008B8  1  88                   DEY
0008B9  1  88                   DEY
0008BA  1  D0 EA                BNE     dnzz
0008BC  1               startout:
0008BC  1  A9 30                LDA     #$30
0008BE  1  8D 9D 08             STA     numspace
0008C1  1               diglp:
0008C1  1  AD 9C 08             LDA     numarg+1
0008C4  1  D9 92 08             CMP     nums+1,y
0008C7  1  90 24                BCC     digitout
0008C9  1  D0 0A                BNE     dontcmp
0008CB  1  AD 9B 08             LDA     numarg
0008CE  1  F9 91 08             SBC     nums,y          ;carry already set
0008D1  1  90 1A                BCC     digitout
0008D3  1  B0 06                BCS     digsub
0008D5  1               dontcmp:
0008D5  1  AD 9B 08             LDA     numarg
0008D8  1  F9 91 08             SBC     nums,y          ;carry already set
0008DB  1               digsub: ; subtract value of digit
0008DB  1  EE 9D 08             INC     numspace
0008DE  1  8D 9B 08             STA     numarg          ;already subtracted
0008E1  1  AD 9C 08             LDA     numarg+1
0008E4  1  F9 92 08             SBC     nums+1,y
0008E7  1  8D 9C 08             STA     numarg+1
0008EA  1  4C C1 08             JMP     diglp
0008ED  1               digitout:
0008ED  1  AD 9D 08             LDA     numspace
0008F0  1  20 40 14             JSR     chrout
0008F3  1  88                   DEY
0008F4  1  88                   DEY
0008F5  1  10 C5                BPL     startout
0008F7  1  60                   RTS
0008F8  1               
0008F8  1               
0008F8  1               ; comment from left column of page 99
0008F8  1               
0008F8  1               erase:
0008F8  1  AD 3C 16             LDA     texstart
0008FB  1  85 FB                STA     tex
0008FD  1  8D 45 16             STA     toplin
000900  1  8D 4B 16             STA     lastline
000903  1  85 39                STA     curr
000905  1  AD 3D 16             LDA     texstart+1
000908  1  85 FC                STA     tex+1
00090A  1  8D 46 16             STA     toplin+1
00090D  1  8D 4C 16             STA     lastline+1
000910  1  85 3A                STA     curr+1
000912  1  38                   SEC
000913  1  AD 3F 16             LDA     texend+1
000916  1  ED 3D 16             SBC     texstart+1
000919  1  AA                   TAX
00091A  1  A9 20                LDA     #space
00091C  1               CLRLOOP:
00091C  1  A0 FF                LDY     #255
00091E  1  C6 FC                DEC     tex+1
000920  1  91 FB                STA     (tex),Y
000922  1  C8                   INY
000923  1  E6 FC                INC     tex+1
000925  1               CLR2:
000925  1  91 FB                STA     (tex),Y
000927  1  C8                   INY
000928  1  D0 FB                BNE     CLR2
00092A  1  E6 FC                INC     tex+1
00092C  1  CA                   DEX
00092D  1  D0 F6                BNE     CLR2
00092F  1  91 FB                STA     (tex),Y
000931  1  60                   RTS
000932  1               
000932  1               ; PRMSG is used anytime we need to
000932  1               ; print something at the top of the screen
000932  1               ; (the command line). Pass it the address
000932  1               ; of the message to be printed by storing
000932  1               ; the low .byte of the address in the accu
000932  1               ; mulator, and the high .byte in the
000932  1               ; register. The message in memory must
000932  1               ; end with a zero .byte. The routine does
000932  1               ; not add a carriage return.
000932  1               
000932  1               PRMSG:
000932  1  85 3B                STA     temp
000934  1  84 3C                STY     temp+1
000936  1  A0 00                LDY     #0
000938  1               PRLOOP:
000938  1  B1 3B                LDA     (temp),Y
00093A  1  F0 06                BEQ     PREXIT
00093C  1  20 40 14             JSR     chrout
00093F  1  C8                   INY
000940  1  D0 F6                BNE     PRLOOP
000942  1               PREXIT:
000942  1  60                   RTS
000943  1               getakey:
000943  1  20 34 14             JSR     chrin
000946  1  F0 FB                BEQ     getakey
000948  1  60                   RTS
000949  1               
000949  1               
000949  1               
000949  1               ;The MAIN loop blinks the cursor,
000949  1               ;checks for keystrokes, converts
000949  1               ;them from ASCII to screen codes,
000949  1               ;puts them in text at the CURRent position, and increments
000949  1               ;the CURRent position and lastline. It also checks for special
000949  1               ;cases like the back-arrow and the return key and passes control
000949  1               ;characters to the CONTROL routine. SHIFTed spaces are turned into
000949  1               ;unSHIFTed ones. The INSMODE flag is checked to see if we should
000949  1               ;insert a space before a character.
000949  1               main:
000949  1  9C A5 1A             STZ     blinkflag
00094C  1  B2 39                LDA     (curr)
00094E  1  85 FA                STA     UNDERCURS
000950  1               main2:
000950  1  B2 39                LDA     (curr)
000952  1  49 80                EOR     #$80
000954  1  92 39                STA     (curr)
000956  1  AD A5 1A             LDA     blinkflag
000959  1  49 01                EOR     #1
00095B  1  8D A5 1A             STA     blinkflag
00095E  1  20 4D 14             JSR     refresh
000961  1               WAIT:
000961  1  20 34 14             JSR     chrin
000964  1  D0 0B                BNE     KEYPRESS
000966  1  A5 A2                LDA     162             ;TODO: TI seconds counter
000968  1  29 10                AND     #16
00096A  1  F0 F5                BEQ     WAIT
00096C  1  64 A2                STZ     162
00096E  1  4C 50 09             JMP     main2
000971  1               KEYPRESS:
000971  1  AA                   TAX
000972  1  A5 FA                LDA     UNDERCURS
000974  1  92 39                STA     (curr)
000976  1  9C A5 1A             STZ     blinkflag
000979  1  E0 5F                CPX     #95
00097B  1  D0 0A                BNE     NOTBKS
00097D  1  20 42 0B             JSR     left
000980  1  A9 20                LDA     #32
000982  1  92 39                STA     (curr)
000984  1  4C 49 09             JMP     main
000987  1               NOTBKS:
000987  1  AD 47 16             LDA     msgflg
00098A  1  F0 05                BEQ     nomsg
00098C  1  DA                   PHX
00098D  1  20 21 14             JSR     sysmsg
000990  1  FA                   PLX
000991  1               nomsg:
000991  1  8A                   TXA
000992  1  C9 0D                CMP     #13
000994  1  D0 02                BNE     notcr
000996  1  A2 5F                LDX     #retchar+64
000998  1               notcr:
000998  1  8A                   TXA
000999  1  29 7F                AND     #127
00099B  1  C9 20                CMP     #32
00099D  1  90 4B                BCC     CONTROL
00099F  1  E0 A0                CPX     #160
0009A1  1  D0 02                BNE     NESHIFT
0009A3  1  A2 20                LDX     #space
0009A5  1               NESHIFT:
0009A5  1  8A                   TXA
0009A6  1  48                   PHA
0009A7  1  A0 00                LDY     #0
0009A9  1  B1 39                LDA     (curr),Y
0009AB  1  C9 1F                CMP     #retchar
