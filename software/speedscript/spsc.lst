001459  2               scrcol:
001459  2               ;        .BYTE   12              ; gray
001459  2               ;;TEXCOLR (text color) is used in the refresh routine
001459  2               ;;and stored into color memory. Both SCRCOL and TEXCOLR
001459  2               ;;are stored within the SpeedScript code so that after
001459  2               ;;they're changed, you can resave SpeedScript and it
001459  2               ;;will come up with your color choice in the future.
001459  2               LETTERS:
001459  2               ;        LDA     TEXCOLR
001459  2               ;        INA
001459  2               ;        AND     #$0F
001459  2               ;        TAX
001459  2               ;        LDA     TEXCOLR
001459  2               ;        AND     #$F0
001459  2               ;        STX     TEXCOLR
001459  2               ;        ORA     TEXCOLR
001459  2               ;        STA     TEXCOLR
001459  2               ;        BRA     COLORALL
001459  2               ;TEXCOLR:
001459  2               ;        .BYTE   $cb             ;dark gray on light gray
001459  2               
001459  2               
001459  2  60                   rts
