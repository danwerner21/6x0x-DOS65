001861r 2               ; check for compound-type access (array subscript or record field)
001861r 2  AD rr rr             LDA     sym_save_type
001864r 2  C9 05                CMP     #TY_ARRAY
001866r 2  F0 3E                BEQ     @array_assign
001868r 2  C9 06                CMP     #TY_RECORD
00186Ar 2  D0 03                BNE     :+
00186Cr 2  4C rr rr             JMP     @record_assign
