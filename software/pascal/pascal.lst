0021CCr 2  4C rr rr             JMP     @sym_func_call
0021CFr 2               :
0021CFr 2  C9 02                CMP     #SYM_CONST
0021D1r 2  D0 03                BNE     :+
0021D3r 2  4C rr rr             JMP     @const_emit
0021D6r 2               :
