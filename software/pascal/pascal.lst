001342r 2               
001342r 1                       .include        "SYMTAB.ASM"
001342r 2               .PC02
001342r 2               ; symtab.asm — symbol table for Pascal/65 compiler
001342r 2               ;
001342r 2               ; Each entry occupies 16 bytes in the SYMTAB_BASE area:
001342r 2               ;   [0]    name length (1-15)
001342r 2               ;   [1-15] name chars (uppercase, padded with spaces)
001342r 2               ;   [16]   symbol kind: SYM_VAR, SYM_CONST, SYM_PROC, SYM_FUNC, SYM_TYPE, SYM_PARAM
001342r 2               ;   [17]   data type:   TY_INT, TY_CHAR, TY_BOOL, TY_STRING, TY_ARRAY, TY_RECORD, TY_PTR
001342r 2               ;   [18-19] value/offset (word): variable offset from BASE/MP; const value; proc address
001342r 2               ;   [20]   scope depth (0=global)
001342r 2               ;   [21]   parameter count (for SYM_PROC/SYM_FUNC)
001342r 2               ;   [22-23] type info pointer (for array/record types)
001342r 2               ;   [24-31] reserved
001342r 2               
001342r 2               SYM_ENTRY_SZ    = 32
001342r 2               
001342r 2               ; Symbol kinds
001342r 2               SYM_VAR         = 1
001342r 2               SYM_CONST       = 2
001342r 2               SYM_PROC        = 3
001342r 2               SYM_FUNC        = 4
001342r 2               SYM_TYPE        = 5
001342r 2               SYM_PARAM       = 6
001342r 2               SYM_RETVAL      = 7             ; binding for `funcname := expr` in fn body
001342r 2               SYM_VARREF      = 8             ; VAR (by-reference) parameter — local slot holds an address
001342r 2               
001342r 2               ; Data type codes
001342r 2               TY_INT          = 1
001342r 2               TY_CHAR         = 2
001342r 2               TY_BOOL         = 3
001342r 2               TY_STRING       = 4
001342r 2               TY_ARRAY        = 5
001342r 2               TY_RECORD       = 6
001342r 2               TY_PTR          = 7
001342r 2               TY_NONE         = 0             ; for procedures
001342r 2               
001342r 2                       .segment        "CODE"
001342r 2               
001342r 2               ; Number of entries currently in symbol table
001342r 2               symtab_count:
001342r 2  00 00                .WORD   0
001344r 2               
001344r 2               ; ---------------------------------------------------------------------------
001344r 2               ; symtab_init — clear symbol table
001344r 2               ; ---------------------------------------------------------------------------
001344r 2               symtab_init:
001344r 2  A9 00                LDA     #0
001346r 2  8D rr rr             STA     symtab_count
001349r 2  8D rr rr             STA     symtab_count+1
00134Cr 2  60                   RTS
00134Dr 2               
00134Dr 2               ; ---------------------------------------------------------------------------
00134Dr 2               ; symtab_find — look up ident_buf in symbol table
00134Dr 2               ; Returns: carry set = found (tmp3 = pointer to entry)
00134Dr 2               ;          carry clear = not found
00134Dr 2               ; Searches from newest (highest index) to oldest for proper scoping
00134Dr 2               ; ---------------------------------------------------------------------------
00134Dr 2               symtab_find:
00134Dr 2  AD rr rr             LDA     symtab_count
001350r 2  0D rr rr             ORA     symtab_count+1
001353r 2  D0 02                BNE     :+
001355r 2  18                   CLC
001356r 2  60                   RTS                     ; empty table
001357r 2               :
001357r 2               ; start from last entry
001357r 2  AD rr rr             LDA     symtab_count
00135Ar 2  85 rr                STA     tmp2
00135Cr 2  AD rr rr             LDA     symtab_count+1
00135Fr 2  85 rr                STA     tmp2+1
001361r 2               @loop:
001361r 2  A5 rr                LDA     tmp2
001363r 2  05 rr                ORA     tmp2+1
001365r 2  F0 34                BEQ     @not_found
001367r 2               ; decrement tmp2
001367r 2  A5 rr                LDA     tmp2
001369r 2  D0 02                BNE     :+
00136Br 2  C6 rr                DEC     tmp2+1
00136Dr 2               :
00136Dr 2  C6 rr                DEC     tmp2
00136Fr 2               ; compute entry address: SYMTAB_BASE + tmp2 * SYM_ENTRY_SZ
00136Fr 2               ; tmp2 * 32 = tmp2 << 5
00136Fr 2  A5 rr                LDA     tmp2
001371r 2  0A                   ASL
001372r 2  0A                   ASL
001373r 2  0A                   ASL
001374r 2  0A                   ASL
001375r 2  0A                   ASL                     ; *32
001376r 2  18                   CLC
001377r 2  69 00                ADC     #<SYMTAB_BASE
001379r 2  85 rr                STA     tmp3
00137Br 2  A5 rr                LDA     tmp2+1
00137Dr 2  2A                   ROL
00137Er 2  69 80                ADC     #>SYMTAB_BASE
001380r 2  85 rr                STA     tmp3+1
001382r 2               ; compare name length
001382r 2  A0 00                LDY     #0
001384r 2  B1 rr                LDA     (tmp3),y
001386r 2  CD rr rr             CMP     ident_buf
001389r 2  D0 D6                BNE     @loop
00138Br 2               ; compare name chars
00138Br 2  AA                   TAX                     ; X = length
00138Cr 2  A0 00                LDY     #0
00138Er 2               @cmp:
00138Er 2  C8                   INY
00138Fr 2  B1 rr                LDA     (tmp3),y
001391r 2  D9 rr rr             CMP     ident_buf,y
001394r 2  D0 CB                BNE     @loop
001396r 2  CA                   DEX
001397r 2  D0 F5                BNE     @cmp
001399r 2  38                   SEC
00139Ar 2  60                   RTS
00139Br 2               @not_found:
00139Br 2  18                   CLC
00139Cr 2  60                   RTS
00139Dr 2               
00139Dr 2               ; ---------------------------------------------------------------------------
00139Dr 2               ; symtab_add — add entry to symbol table
00139Dr 2               ; Inputs:
00139Dr 2               ;   ident_buf = name
00139Dr 2               ;   A = kind (SYM_*)
00139Dr 2               ;   X = data type (TY_*)
00139Dr 2               ;   tmp2 = value/offset word (lo in tmp2, hi in tmp2+1)
00139Dr 2               ; Returns: tmp3 = pointer to new entry; carry set = table full
00139Dr 2               ; ---------------------------------------------------------------------------
00139Dr 2               symtab_add:
00139Dr 2  48                   PHA                     ; save kind (A) — the rest of this routine clobbers A
00139Er 2  8A                   TXA
00139Fr 2  48                   PHA                     ; save data type (X)
0013A0r 2               ; check capacity
0013A0r 2  AD rr rr             LDA     symtab_count+1
0013A3r 2  C9 00                CMP     #(SYMTAB_MAXSZ / SYM_ENTRY_SZ) >> 8
0013A5r 2  90 0B                BCC     :+
0013A7r 2  AD rr rr             LDA     symtab_count
0013AAr 2  C9 C0                CMP     #(SYMTAB_MAXSZ / SYM_ENTRY_SZ) & $FF
0013ACr 2  90 04                BCC     :+
0013AEr 2  68                   PLA                     ; discard saved type
0013AFr 2  68                   PLA                     ; discard saved kind
0013B0r 2  38                   SEC
0013B1r 2  60                   RTS                     ; table full
0013B2r 2               
0013B2r 2               :       ; compute address of new entry
0013B2r 2  AD rr rr             LDA     symtab_count
0013B5r 2  0A                   ASL
0013B6r 2  0A                   ASL
0013B7r 2  0A                   ASL
0013B8r 2  0A                   ASL
0013B9r 2  0A                   ASL                     ; *32
0013BAr 2  18                   CLC
0013BBr 2  69 00                ADC     #<SYMTAB_BASE
0013BDr 2  85 rr                STA     tmp3
0013BFr 2  AD rr rr             LDA     symtab_count+1
0013C2r 2  2A                   ROL
0013C3r 2  69 80                ADC     #>SYMTAB_BASE
0013C5r 2  85 rr                STA     tmp3+1
0013C7r 2               
0013C7r 2               ; copy name
0013C7r 2  A0 00                LDY     #0
0013C9r 2  AD rr rr             LDA     ident_buf       ; length
0013CCr 2  91 rr                STA     (tmp3),y
0013CEr 2  AA                   TAX
0013CFr 2               @name_copy:
0013CFr 2  C8                   INY
0013D0r 2  B9 rr rr             LDA     ident_buf,y
0013D3r 2  91 rr                STA     (tmp3),y
0013D5r 2  CA                   DEX
0013D6r 2  D0 F7                BNE     @name_copy
0013D8r 2               
0013D8r 2               ; fill unused name bytes with space
0013D8r 2  C8                   INY
0013D9r 2               @pad:
0013D9r 2  C0 10                CPY     #16
0013DBr 2  B0 07                BCS     @done_pad
0013DDr 2  A9 20                LDA     #' '
0013DFr 2  91 rr                STA     (tmp3),y
0013E1r 2  C8                   INY
0013E2r 2  80 F5                BRA     @pad
0013E4r 2               @done_pad:
0013E4r 2               
0013E4r 2               ; data type (was saved on stack first)
0013E4r 2  68                   PLA
0013E5r 2  A0 11                LDY     #17
0013E7r 2  91 rr                STA     (tmp3),y
0013E9r 2               
0013E9r 2               ; kind (was saved on stack second-to-last → on top first)
0013E9r 2  68                   PLA
0013EAr 2  A0 10                LDY     #16
0013ECr 2  91 rr                STA     (tmp3),y
0013EEr 2               
0013EEr 2               ; value/offset
0013EEr 2  A5 rr                LDA     tmp2
0013F0r 2  A0 12                LDY     #18
0013F2r 2  91 rr                STA     (tmp3),y
0013F4r 2  A5 rr                LDA     tmp2+1
0013F6r 2  A0 13                LDY     #19
0013F8r 2  91 rr                STA     (tmp3),y
0013FAr 2               
0013FAr 2               ; scope depth
0013FAr 2  A5 rr                LDA     scope_depth
0013FCr 2  A0 14                LDY     #20
0013FEr 2  91 rr                STA     (tmp3),y
001400r 2               
001400r 2               ; zero rest
001400r 2  A9 00                LDA     #0
001402r 2  A0 15                LDY     #21
001404r 2               @zero:
001404r 2  91 rr                STA     (tmp3),y
001406r 2  C8                   INY
001407r 2  C0 20                CPY     #SYM_ENTRY_SZ
001409r 2  90 F9                BCC     @zero
00140Br 2               
00140Br 2               ; increment count
00140Br 2  EE rr rr             INC     symtab_count
00140Er 2  D0 03                BNE     :+
001410r 2  EE rr rr             INC     symtab_count+1
001413r 2               :
001413r 2  18                   CLC
001414r 2  60                   RTS
001415r 2               
001415r 2               ; ---------------------------------------------------------------------------
001415r 2               ; symtab_enter_scope — increment scope depth
001415r 2               ; ---------------------------------------------------------------------------
001415r 2               symtab_enter_scope:
001415r 2  E6 rr                INC     scope_depth
001417r 2  60                   RTS
001418r 2               
001418r 2               ; ---------------------------------------------------------------------------
001418r 2               ; symtab_leave_scope — remove all entries at current scope, decrement depth
001418r 2               ; ---------------------------------------------------------------------------
001418r 2               symtab_leave_scope:
001418r 2               ; Remove all entries added at current scope depth, then decrement depth.
001418r 2               ; Entries are appended in order, so trim from the end.
001418r 2               @trim:
001418r 2  AD rr rr             LDA     symtab_count
00141Br 2  0D rr rr             ORA     symtab_count+1
00141Er 2  F0 34                BEQ     @done           ; table empty
001420r 2               ; compute address of last entry: SYMTAB_BASE + (count-1)*32
001420r 2  AD rr rr             LDA     symtab_count
001423r 2  38                   SEC
001424r 2  E9 01                SBC     #1
001426r 2  85 rr                STA     tmp2
001428r 2  AD rr rr             LDA     symtab_count+1
00142Br 2  E9 00                SBC     #0
00142Dr 2  85 rr                STA     tmp2+1
00142Fr 2               ; tmp2 * 32 (shift left 5) → entry address
00142Fr 2  A5 rr                LDA     tmp2
001431r 2  0A                   ASL
001432r 2  0A                   ASL
001433r 2  0A                   ASL
001434r 2  0A                   ASL
001435r 2  0A                   ASL
001436r 2  18                   CLC
001437r 2  69 00                ADC     #<SYMTAB_BASE
001439r 2  85 rr                STA     tmp3
00143Br 2  A5 rr                LDA     tmp2+1
00143Dr 2  2A                   ROL
00143Er 2  69 80                ADC     #>SYMTAB_BASE
001440r 2  85 rr                STA     tmp3+1
001442r 2               ; check scope depth field (offset 20 in entry)
001442r 2  A0 14                LDY     #20
001444r 2  B1 rr                LDA     (tmp3),y
001446r 2  C5 rr                CMP     scope_depth
001448r 2  D0 0A                BNE     @done           ; entry belongs to an outer scope — stop
00144Ar 2               ; remove this entry
00144Ar 2  CE rr rr             DEC     symtab_count
00144Dr 2  D0 C9                BNE     @trim
00144Fr 2  CE rr rr             DEC     symtab_count+1
001452r 2  80 C4                BRA     @trim
001454r 2               @done:
001454r 2  C6 rr                DEC     scope_depth
001456r 2  60                   RTS
001457r 2               
001457r 1                       .include        "CODEGEN.ASM"
001457r 2               ; codegen.asm — p-code emitter for Pascal/65 compiler
001457r 2               ;
001457r 2               ; All generated p-code accumulates in CODEBUF_BASE.
001457r 2               ; cg_pc (zero page) tracks the next write offset.
001457r 2               
001457r 2                       .segment        "CODE"
001457r 2               
001457r 2               ; ---------------------------------------------------------------------------
001457r 2               ; emit_byte — append byte A to code buffer
001457r 2               ; ---------------------------------------------------------------------------
001457r 2               emit_byte:
001457r 2  48                   PHA                     ; save byte to emit
001458r 2               ; check buffer full
001458r 2  A5 rr                LDA     cg_pc+1
00145Ar 2  C9 80                CMP     #>CODEBUF_MAXSZ
00145Cr 2  90 13                BCC     :+
00145Er 2  A5 rr                LDA     cg_pc
001460r 2  C9 00                CMP     #<CODEBUF_MAXSZ
001462r 2  90 0D                BCC     :+
001464r 2               ; error: p-code buffer full
001464r 2  68                   PLA
001465r 2  A9 rr                LDA     #<err_pcd_full
001467r 2  85 rr                STA     tmp0
001469r 2  A9 rr                LDA     #>err_pcd_full
00146Br 2  85 rr                STA     tmp0+1
00146Dr 2  20 rr rr             JSR     compile_error
001470r 2  60                   RTS
001471r 2               :
001471r 2               ; store at CODEBUF_BASE + cg_pc
001471r 2  A5 rr                LDA     cg_pc
001473r 2  18                   CLC
001474r 2  69 00                ADC     #<CODEBUF_BASE
001476r 2  85 rr                STA     tmp2
001478r 2  A5 rr                LDA     cg_pc+1
00147Ar 2  69 30                ADC     #>CODEBUF_BASE
00147Cr 2  85 rr                STA     tmp2+1
00147Er 2  68                   PLA
00147Fr 2  A0 00                LDY     #0
001481r 2  91 rr                STA     (tmp2),y
001483r 2               ; advance cg_pc
001483r 2  E6 rr                INC     cg_pc
001485r 2  D0 02                BNE     :+
001487r 2  E6 rr                INC     cg_pc+1
001489r 2               :
001489r 2  60                   RTS
00148Ar 2               
00148Ar 2               ; ---------------------------------------------------------------------------
00148Ar 2               ; emit_word — append word (lo then hi) from tmp2 to code buffer
00148Ar 2               ; ---------------------------------------------------------------------------
00148Ar 2               emit_word:
00148Ar 2  A5 rr                LDA     tmp2
00148Cr 2  20 rr rr             JSR     emit_byte
00148Fr 2  A5 rr                LDA     tmp2+1
001491r 2  20 rr rr             JSR     emit_byte
001494r 2  60                   RTS
001495r 2               
001495r 2               ; ---------------------------------------------------------------------------
001495r 2               ; emit_opcode — emit single opcode byte in A
001495r 2               ; ---------------------------------------------------------------------------
001495r 2               emit_opcode:
001495r 2  20 rr rr             JSR     emit_byte
001498r 2  60                   RTS
001499r 2               
