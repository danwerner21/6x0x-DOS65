002776r 2  A9 1C                LDA     #TOK_RPAREN
002778r 2  20 rr rr             JSR     parse_eat_token
00277Br 2  20 rr rr             JSR     emit_FEOF
00277Er 2  A9 03                LDA     #TY_BOOL
002780r 2  85 rr                STA     expr_type
002782r 2  60                   RTS
002783r 2               
002783r 2               parse_builtin_eoln:
002783r 2  20 rr rr             JSR     next_token              ; consume EOLN
002786r 2  A9 1B                LDA     #TOK_LPAREN
002788r 2  20 rr rr             JSR     parse_eat_token
00278Br 2  20 rr rr             JSR     parse_expression        ; file ptr (TY_TEXT)
00278Er 2  A9 1C                LDA     #TOK_RPAREN
002790r 2  20 rr rr             JSR     parse_eat_token
002793r 2  20 rr rr             JSR     emit_FEOLN
002796r 2  A9 03                LDA     #TY_BOOL
002798r 2  85 rr                STA     expr_type
00279Ar 2  60                   RTS
00279Br 2               
00279Br 2               ; NEW(p) — bump-allocate 2 bytes (pointer-to-INTEGER, v1) and store the
00279Br 2               ; new heap address into pointer variable p.
00279Br 2               ;   parse_arg_lvalue pushes &p; emit_NEW pushes the fresh pointer; STIND
00279Br 2               ;   takes (NOS=addr, TOS=val) and writes val to addr.
00279Br 2               parse_builtin_new:
00279Br 2  20 rr rr             JSR     next_token              ; consume NEW
00279Er 2  A9 1B                LDA     #TOK_LPAREN
0027A0r 2  20 rr rr             JSR     parse_eat_token
0027A3r 2  20 rr rr             JSR     parse_arg_lvalue        ; push &p
0027A6r 2  A9 1C                LDA     #TOK_RPAREN
0027A8r 2  20 rr rr             JSR     parse_eat_token
0027ABr 2  A9 00                LDA     #0
0027ADr 2  85 rr                STA     scratch                 ; size hi = 0
0027AFr 2  A9 02                LDA     #2                      ; v1: always allocate 2 bytes
0027B1r 2  20 rr rr             JSR     emit_NEW
0027B4r 2  4C rr rr             JMP     emit_STIND
0027B7r 2               
0027B7r 2               ; DISPOSE(p) — bump allocator can't free, so just discard the pointer.
0027B7r 2               parse_builtin_dispose:
0027B7r 2  20 rr rr             JSR     next_token              ; consume DISPOSE
0027BAr 2  A9 1B                LDA     #TOK_LPAREN
0027BCr 2  20 rr rr             JSR     parse_eat_token
0027BFr 2  20 rr rr             JSR     parse_expression        ; push p (value)
0027C2r 2  A9 1C                LDA     #TOK_RPAREN
0027C4r 2  20 rr rr             JSR     parse_eat_token
0027C7r 2  4C rr rr             JMP     emit_DISP
0027CAr 2               
0027CAr 2               ; TRUE / FALSE — predefined boolean constants.  Push 1/0 as TY_BOOL so
0027CAr 2               ; pw_emit_file routes to FWRB ("TRUE"/"FALSE") and pw_emit_console to WRITB.
0027CAr 2               parse_builtin_true:
0027CAr 2  20 rr rr             JSR     next_token              ; consume TRUE
0027CDr 2  A9 01                LDA     #1
0027CFr 2  20 rr rr             JSR     emit_LDCB
0027D2r 2  A9 03                LDA     #TY_BOOL
0027D4r 2  85 rr                STA     expr_type
0027D6r 2  60                   RTS
0027D7r 2               
0027D7r 2               parse_builtin_false:
0027D7r 2  20 rr rr             JSR     next_token              ; consume FALSE
0027DAr 2  A9 00                LDA     #0
0027DCr 2  20 rr rr             JSR     emit_LDCB
0027DFr 2  A9 03                LDA     #TY_BOOL
0027E1r 2  85 rr                STA     expr_type
0027E3r 2  60                   RTS
0027E4r 2               
0027E4r 1                       .include        "SYMTAB.ASM"
0027E4r 2               .PC02
0027E4r 2               ; symtab.asm — symbol table for Pascal/65 compiler
0027E4r 2               ;
0027E4r 2               ; Each entry occupies 16 bytes in the SYMTAB_BASE area:
0027E4r 2               ;   [0]    name length (1-15)
0027E4r 2               ;   [1-15] name chars (uppercase, padded with spaces)
0027E4r 2               ;   [16]   symbol kind: SYM_VAR, SYM_CONST, SYM_PROC, SYM_FUNC, SYM_TYPE, SYM_PARAM
0027E4r 2               ;   [17]   data type:   TY_INT, TY_CHAR, TY_BOOL, TY_STRING, TY_ARRAY, TY_RECORD, TY_PTR, TY_TEXT, TY_SET, TY_REAL
0027E4r 2               ;   [18-19] value/offset (word): variable offset from BASE/MP; const value; proc address
0027E4r 2               ;   [20]   scope depth (0=global)
0027E4r 2               ;   [21]   parameter count (for SYM_PROC/SYM_FUNC)
0027E4r 2               ;   [22-23] type info pointer (for array/record types)
0027E4r 2               ;   [24-31] formal parameter types 0..7 (for SYM_PROC/SYM_FUNC)
0027E4r 2               
0027E4r 2               SYM_ENTRY_SZ    = 32
0027E4r 2               
0027E4r 2               ; Symbol kinds
0027E4r 2               SYM_VAR         = 1
0027E4r 2               SYM_CONST       = 2
0027E4r 2               SYM_PROC        = 3
0027E4r 2               SYM_FUNC        = 4
0027E4r 2               SYM_TYPE        = 5
0027E4r 2               SYM_PARAM       = 6
0027E4r 2               SYM_RETVAL      = 7             ; binding for `funcname := expr` in fn body
0027E4r 2               SYM_VARREF      = 8             ; VAR (by-reference) parameter — local slot holds an address
0027E4r 2               
0027E4r 2               ; Data type codes
0027E4r 2               TY_INT          = 1
0027E4r 2               TY_CHAR         = 2
0027E4r 2               TY_BOOL         = 3
0027E4r 2               TY_STRING       = 4
0027E4r 2               TY_ARRAY        = 5
0027E4r 2               TY_RECORD       = 6
0027E4r 2               TY_PTR          = 7
0027E4r 2               TY_TEXT         = 8             ; TEXT file variable (168-byte struct)
0027E4r 2               TY_SET          = 9             ; 16-bit set mask over element values 0..15
0027E4r 2               TY_REAL         = 10            ; signed fixed-point REAL (scale 100, 2 decimal places)
0027E4r 2               TY_NONE         = 0             ; for procedures
0027E4r 2               
0027E4r 2                       .segment        "CODE"
0027E4r 2               
0027E4r 2               ; Number of entries currently in symbol table
0027E4r 2               symtab_count:
0027E4r 2  00 00                .WORD   0
0027E6r 2               
0027E6r 2               ; ---------------------------------------------------------------------------
0027E6r 2               ; symtab_init — clear symbol table
0027E6r 2               ; ---------------------------------------------------------------------------
0027E6r 2               symtab_init:
0027E6r 2  A9 00                LDA     #0
0027E8r 2  8D rr rr             STA     symtab_count
0027EBr 2  8D rr rr             STA     symtab_count+1
0027EEr 2  8D rr rr             STA     field_table_count
0027F1r 2  8D rr rr             STA     field_depth
0027F4r 2  60                   RTS
0027F5r 2               
0027F5r 2               ; ---------------------------------------------------------------------------
0027F5r 2               ; field_table_add — append a record-field entry
0027F5r 2               ; Inputs:
0027F5r 2               ;   ident_buf = field name (length at [0], chars at [1..])
0027F5r 2               ;   A         = byte offset within the record
0027F5r 2               ;   X         = field data type (TY_*)
0027F5r 2               ; Returns: A = newly-assigned field index (current count - 1)
0027F5r 2               ;          carry set if field table is full (entry not added)
0027F5r 2               ; Clobbers: tmp2, tmp3, Y
0027F5r 2               ; ---------------------------------------------------------------------------
0027F5r 2               field_table_add:
0027F5r 2  48                   PHA                     ; save offset
0027F6r 2  8A                   TXA
0027F7r 2  48                   PHA                     ; save type
0027F8r 2               ; capacity check (max 32 entries)
0027F8r 2  AD rr rr             LDA     field_table_count
0027FBr 2  C9 20                CMP     #32
0027FDr 2  90 04                BCC     :+
0027FFr 2  68                   PLA                     ; discard type
002800r 2  68                   PLA                     ; discard offset
002801r 2  38                   SEC
002802r 2  60                   RTS
002803r 2               :
002803r 2               ; compute entry address: field_table + count*16
002803r 2  AD rr rr             LDA     field_table_count
002806r 2  0A                   ASL
002807r 2  0A                   ASL
002808r 2  0A                   ASL
002809r 2  0A                   ASL                     ; *16 (count<64 fits in 10 bits, but we land in low byte; high carry becomes part of address)
00280Ar 2  85 rr                STA     tmp2
00280Cr 2  A9 00                LDA     #0
00280Er 2  2A                   ROL                     ; capture carry into hi
00280Fr 2  18                   CLC
002810r 2  69 rr                ADC     #>field_table
002812r 2  85 rr                STA     tmp2+1
002814r 2  A5 rr                LDA     tmp2
002816r 2  18                   CLC
002817r 2  69 rr                ADC     #<field_table
002819r 2  85 rr                STA     tmp2
00281Br 2  90 02                BCC     :+
00281Dr 2  E6 rr                INC     tmp2+1
00281Fr 2               :
00281Fr 2               ; copy name length + chars
00281Fr 2  A0 00                LDY     #0
002821r 2  AD rr rr             LDA     ident_buf
002824r 2  91 rr                STA     (tmp2),y
002826r 2  AA                   TAX                     ; X = length
002827r 2  A0 01                LDY     #1
002829r 2               @nm:
002829r 2  C0 0D                CPY     #13
00282Br 2  B0 0D                BCS     @padn
00282Dr 2  E0 00                CPX     #0
00282Fr 2  F0 09                BEQ     @padn
002831r 2  B9 rr rr             LDA     ident_buf,y
002834r 2  91 rr                STA     (tmp2),y
002836r 2  CA                   DEX
002837r 2  C8                   INY
002838r 2  80 EF                BRA     @nm
00283Ar 2               @padn:
00283Ar 2  C0 0D                CPY     #13
00283Cr 2  B0 07                BCS     @done_nm
00283Er 2  A9 20                LDA     #' '
002840r 2  91 rr                STA     (tmp2),y
002842r 2  C8                   INY
002843r 2  80 F5                BRA     @padn
002845r 2               @done_nm:
002845r 2               ; offset (was on stack first → second pull)
002845r 2               ; type   (was on stack last  → first pull)
002845r 2  68                   PLA                     ; type
002846r 2  A0 0E                LDY     #14
002848r 2  91 rr                STA     (tmp2),y
00284Ar 2  68                   PLA                     ; offset
00284Br 2  A0 0D                LDY     #13
00284Dr 2  91 rr                STA     (tmp2),y
00284Fr 2  AD rr rr             LDA     field_depth     ; nesting depth so scans can skip
002852r 2  A0 0F                LDY     #15             ; fields owned by deeper inline records
002854r 2  91 rr                STA     (tmp2),y
002856r 2               ; bump count, return new index
002856r 2  AD rr rr             LDA     field_table_count
002859r 2  EE rr rr             INC     field_table_count
00285Cr 2  18                   CLC
00285Dr 2  60                   RTS
00285Er 2               
00285Er 2               ; ---------------------------------------------------------------------------
00285Er 2               ; field_lookup_in_record — find ident_buf among a contiguous range of fields
00285Er 2               ; Inputs:
00285Er 2               ;   ident_buf = field name to find
00285Er 2               ;   A         = first field index in field_table
00285Er 2               ;   X         = number of fields to scan
00285Er 2               ; Returns: carry set = found
00285Er 2               ;            A = byte offset within record
00285Er 2               ;            X = field data type
00285Er 2               ;          carry clear = not found
00285Er 2               ; Clobbers: tmp2, tmp3, Y
00285Er 2               ; ---------------------------------------------------------------------------
00285Er 2               field_lookup_in_record:
00285Er 2  85 rr                STA     tmp3            ; tmp3 = current field index
002860r 2  86 rr                STX     tmp3+1          ; tmp3+1 = remaining count
002862r 2               ; Read the depth of field[tmp3] — the scan's "target depth". Slots
002862r 2               ; deeper than this belong to inline sub-records and are skipped so
002862r 2               ; the scan stays at the record's own nesting level.
002862r 2  A5 rr                LDA     tmp3
002864r 2  0A                   ASL
002865r 2  0A                   ASL
002866r 2  0A                   ASL
002867r 2  0A                   ASL
002868r 2  85 rr                STA     tmp2
00286Ar 2  A9 00                LDA     #0
00286Cr 2  2A                   ROL
00286Dr 2  18                   CLC
00286Er 2  69 rr                ADC     #>field_table
002870r 2  85 rr                STA     tmp2+1
002872r 2  A5 rr                LDA     tmp2
002874r 2  18                   CLC
002875r 2  69 rr                ADC     #<field_table
002877r 2  85 rr                STA     tmp2
002879r 2  90 02                BCC     :+
00287Br 2  E6 rr                INC     tmp2+1
00287Dr 2               :
00287Dr 2  A0 0F                LDY     #15
00287Fr 2  B1 rr                LDA     (tmp2),y
002881r 2  8D rr rr             STA     field_lookup_depth
002884r 2               @scan:
002884r 2  A5 rr                LDA     tmp3+1
002886r 2  F0 4C                BEQ     @nf
002888r 2               ; compute entry addr: field_table + tmp3*16
002888r 2  A5 rr                LDA     tmp3
00288Ar 2  0A                   ASL
00288Br 2  0A                   ASL
00288Cr 2  0A                   ASL
00288Dr 2  0A                   ASL                     ; *16 (low byte; carry → hi)
00288Er 2  85 rr                STA     tmp2
002890r 2  A9 00                LDA     #0
002892r 2  2A                   ROL
002893r 2  18                   CLC
002894r 2  69 rr                ADC     #>field_table
002896r 2  85 rr                STA     tmp2+1
002898r 2  A5 rr                LDA     tmp2
00289Ar 2  18                   CLC
00289Br 2  69 rr                ADC     #<field_table
00289Dr 2  85 rr                STA     tmp2
00289Fr 2  90 02                BCC     :+
0028A1r 2  E6 rr                INC     tmp2+1
0028A3r 2               :
0028A3r 2               ; skip slots whose depth differs from the scan's target depth
0028A3r 2  A0 0F                LDY     #15
0028A5r 2  B1 rr                LDA     (tmp2),y
0028A7r 2  CD rr rr             CMP     field_lookup_depth
0028AAr 2  D0 22                BNE     @next
0028ACr 2               ; compare name length
0028ACr 2  A0 00                LDY     #0
0028AEr 2  B1 rr                LDA     (tmp2),y
0028B0r 2  CD rr rr             CMP     ident_buf
0028B3r 2  D0 19                BNE     @next
0028B5r 2  AA                   TAX                     ; X = length
0028B6r 2  A0 01                LDY     #1
0028B8r 2               @cmpn:
0028B8r 2  B1 rr                LDA     (tmp2),y
0028BAr 2  D9 rr rr             CMP     ident_buf,y
0028BDr 2  D0 0F                BNE     @next
0028BFr 2  C8                   INY
0028C0r 2  CA                   DEX
0028C1r 2  D0 F5                BNE     @cmpn
0028C3r 2               ; match — return offset and type
0028C3r 2  A0 0E                LDY     #14
0028C5r 2  B1 rr                LDA     (tmp2),y        ; type
0028C7r 2  AA                   TAX
0028C8r 2  A0 0D                LDY     #13
0028CAr 2  B1 rr                LDA     (tmp2),y        ; offset
0028CCr 2  38                   SEC
0028CDr 2  60                   RTS
0028CEr 2               @next:
0028CEr 2  E6 rr                INC     tmp3
0028D0r 2  C6 rr                DEC     tmp3+1
0028D2r 2  80 B0                BRA     @scan
0028D4r 2               @nf:
0028D4r 2  18                   CLC
0028D5r 2  60                   RTS
0028D6r 2               
0028D6r 2               ; ---------------------------------------------------------------------------
0028D6r 2               ; symtab_find — look up ident_buf in symbol table
0028D6r 2               ; Returns: carry set = found (tmp3 = pointer to entry)
0028D6r 2               ;          carry clear = not found
0028D6r 2               ; Searches from newest (highest index) to oldest for proper scoping
0028D6r 2               ; ---------------------------------------------------------------------------
0028D6r 2               symtab_find:
0028D6r 2  AD rr rr             LDA     symtab_count
0028D9r 2  0D rr rr             ORA     symtab_count+1
0028DCr 2  D0 02                BNE     :+
0028DEr 2  18                   CLC
0028DFr 2  60                   RTS                     ; empty table
0028E0r 2               :
0028E0r 2               ; start from last entry
0028E0r 2  AD rr rr             LDA     symtab_count
0028E3r 2  85 rr                STA     tmp2
0028E5r 2  AD rr rr             LDA     symtab_count+1
0028E8r 2  85 rr                STA     tmp2+1
0028EAr 2               @loop:
0028EAr 2  A5 rr                LDA     tmp2
0028ECr 2  05 rr                ORA     tmp2+1
0028EEr 2  F0 34                BEQ     @not_found
0028F0r 2               ; decrement tmp2
0028F0r 2  A5 rr                LDA     tmp2
0028F2r 2  D0 02                BNE     :+
0028F4r 2  C6 rr                DEC     tmp2+1
0028F6r 2               :
0028F6r 2  C6 rr                DEC     tmp2
0028F8r 2               ; compute entry address: SYMTAB_BASE + tmp2 * SYM_ENTRY_SZ
0028F8r 2               ; tmp2 * 32 = tmp2 << 5
0028F8r 2  A5 rr                LDA     tmp2
0028FAr 2  0A                   ASL
0028FBr 2  0A                   ASL
0028FCr 2  0A                   ASL
0028FDr 2  0A                   ASL
0028FEr 2  0A                   ASL                     ; *32
0028FFr 2  18                   CLC
002900r 2  69 00                ADC     #<SYMTAB_BASE
002902r 2  85 rr                STA     tmp3
002904r 2  A5 rr                LDA     tmp2+1
002906r 2  2A                   ROL
002907r 2  69 80                ADC     #>SYMTAB_BASE
002909r 2  85 rr                STA     tmp3+1
00290Br 2               ; compare name length
00290Br 2  A0 00                LDY     #0
00290Dr 2  B1 rr                LDA     (tmp3),y
00290Fr 2  CD rr rr             CMP     ident_buf
002912r 2  D0 D6                BNE     @loop
002914r 2               ; compare name chars
002914r 2  AA                   TAX                     ; X = length
002915r 2  A0 00                LDY     #0
002917r 2               @cmp:
002917r 2  C8                   INY
002918r 2  B1 rr                LDA     (tmp3),y
00291Ar 2  D9 rr rr             CMP     ident_buf,y
00291Dr 2  D0 CB                BNE     @loop
00291Fr 2  CA                   DEX
002920r 2  D0 F5                BNE     @cmp
002922r 2  38                   SEC
002923r 2  60                   RTS
002924r 2               @not_found:
002924r 2  18                   CLC
002925r 2  60                   RTS
002926r 2               
002926r 2               ; ---------------------------------------------------------------------------
002926r 2               ; symtab_add — add entry to symbol table
002926r 2               ; Inputs:
002926r 2               ;   ident_buf = name
002926r 2               ;   A = kind (SYM_*)
002926r 2               ;   X = data type (TY_*)
002926r 2               ;   tmp2 = value/offset word (lo in tmp2, hi in tmp2+1)
002926r 2               ; Returns: tmp3 = pointer to new entry; carry set = table full
002926r 2               ; ---------------------------------------------------------------------------
002926r 2               symtab_add:
002926r 2  48                   PHA                     ; save kind (A) — the rest of this routine clobbers A
002927r 2  8A                   TXA
002928r 2  48                   PHA                     ; save data type (X)
002929r 2               ; check capacity
002929r 2  AD rr rr             LDA     symtab_count+1
00292Cr 2  C9 00                CMP     #(SYMTAB_MAXSZ / SYM_ENTRY_SZ) >> 8
00292Er 2  90 0B                BCC     :+
002930r 2  AD rr rr             LDA     symtab_count
002933r 2  C9 C0                CMP     #(SYMTAB_MAXSZ / SYM_ENTRY_SZ) & $FF
002935r 2  90 04                BCC     :+
002937r 2  68                   PLA                     ; discard saved type
002938r 2  68                   PLA                     ; discard saved kind
002939r 2  38                   SEC
00293Ar 2  60                   RTS                     ; table full
00293Br 2               
00293Br 2               :       ; compute address of new entry
00293Br 2  AD rr rr             LDA     symtab_count
00293Er 2  0A                   ASL
00293Fr 2  0A                   ASL
002940r 2  0A                   ASL
002941r 2  0A                   ASL
002942r 2  0A                   ASL                     ; *32
002943r 2  18                   CLC
002944r 2  69 00                ADC     #<SYMTAB_BASE
002946r 2  85 rr                STA     tmp3
002948r 2  AD rr rr             LDA     symtab_count+1
00294Br 2  2A                   ROL
00294Cr 2  69 80                ADC     #>SYMTAB_BASE
00294Er 2  85 rr                STA     tmp3+1
002950r 2               
002950r 2               ; copy name
002950r 2  A0 00                LDY     #0
002952r 2  AD rr rr             LDA     ident_buf       ; length
002955r 2  91 rr                STA     (tmp3),y
002957r 2  AA                   TAX
002958r 2               @name_copy:
002958r 2  C8                   INY
002959r 2  B9 rr rr             LDA     ident_buf,y
00295Cr 2  91 rr                STA     (tmp3),y
00295Er 2  CA                   DEX
00295Fr 2  D0 F7                BNE     @name_copy
002961r 2               
002961r 2               ; fill unused name bytes with space
002961r 2  C8                   INY
002962r 2               @pad:
002962r 2  C0 10                CPY     #16
002964r 2  B0 07                BCS     @done_pad
002966r 2  A9 20                LDA     #' '
002968r 2  91 rr                STA     (tmp3),y
00296Ar 2  C8                   INY
00296Br 2  80 F5                BRA     @pad
00296Dr 2               @done_pad:
00296Dr 2               
00296Dr 2               ; data type (was saved on stack first)
00296Dr 2  68                   PLA
00296Er 2  A0 11                LDY     #17
002970r 2  91 rr                STA     (tmp3),y
002972r 2               
002972r 2               ; kind (was saved on stack second-to-last → on top first)
002972r 2  68                   PLA
002973r 2  A0 10                LDY     #16
002975r 2  91 rr                STA     (tmp3),y
002977r 2               
002977r 2               ; value/offset
002977r 2  A5 rr                LDA     tmp2
002979r 2  A0 12                LDY     #18
00297Br 2  91 rr                STA     (tmp3),y
00297Dr 2  A5 rr                LDA     tmp2+1
00297Fr 2  A0 13                LDY     #19
002981r 2  91 rr                STA     (tmp3),y
002983r 2               
002983r 2               ; scope depth
002983r 2  A5 rr                LDA     scope_depth
002985r 2  A0 14                LDY     #20
002987r 2  91 rr                STA     (tmp3),y
002989r 2               
002989r 2               ; zero rest
002989r 2  A9 00                LDA     #0
00298Br 2  A0 15                LDY     #21
00298Dr 2               @zero:
00298Dr 2  91 rr                STA     (tmp3),y
00298Fr 2  C8                   INY
002990r 2  C0 20                CPY     #SYM_ENTRY_SZ
002992r 2  90 F9                BCC     @zero
002994r 2               
002994r 2               ; increment count
002994r 2  EE rr rr             INC     symtab_count
002997r 2  D0 03                BNE     :+
002999r 2  EE rr rr             INC     symtab_count+1
00299Cr 2               :
00299Cr 2  18                   CLC
00299Dr 2  60                   RTS
00299Er 2               
00299Er 2               ; ---------------------------------------------------------------------------
00299Er 2               ; symtab_enter_scope — increment scope depth
00299Er 2               ; ---------------------------------------------------------------------------
00299Er 2               symtab_enter_scope:
00299Er 2  E6 rr                INC     scope_depth
0029A0r 2  60                   RTS
0029A1r 2               
0029A1r 2               ; ---------------------------------------------------------------------------
0029A1r 2               ; symtab_leave_scope — remove all entries at current scope, decrement depth
0029A1r 2               ; ---------------------------------------------------------------------------
0029A1r 2               symtab_leave_scope:
0029A1r 2               ; Remove all entries added at current scope depth, then decrement depth.
0029A1r 2               ; Entries are appended in order, so trim from the end.
0029A1r 2               @trim:
0029A1r 2  AD rr rr             LDA     symtab_count
0029A4r 2  0D rr rr             ORA     symtab_count+1
0029A7r 2  F0 34                BEQ     @done           ; table empty
0029A9r 2               ; compute address of last entry: SYMTAB_BASE + (count-1)*32
0029A9r 2  AD rr rr             LDA     symtab_count
0029ACr 2  38                   SEC
0029ADr 2  E9 01                SBC     #1
0029AFr 2  85 rr                STA     tmp2
0029B1r 2  AD rr rr             LDA     symtab_count+1
0029B4r 2  E9 00                SBC     #0
0029B6r 2  85 rr                STA     tmp2+1
0029B8r 2               ; tmp2 * 32 (shift left 5) → entry address
0029B8r 2  A5 rr                LDA     tmp2
0029BAr 2  0A                   ASL
0029BBr 2  0A                   ASL
0029BCr 2  0A                   ASL
0029BDr 2  0A                   ASL
0029BEr 2  0A                   ASL
0029BFr 2  18                   CLC
0029C0r 2  69 00                ADC     #<SYMTAB_BASE
0029C2r 2  85 rr                STA     tmp3
0029C4r 2  A5 rr                LDA     tmp2+1
0029C6r 2  2A                   ROL
0029C7r 2  69 80                ADC     #>SYMTAB_BASE
0029C9r 2  85 rr                STA     tmp3+1
0029CBr 2               ; check scope depth field (offset 20 in entry)
0029CBr 2  A0 14                LDY     #20
0029CDr 2  B1 rr                LDA     (tmp3),y
0029CFr 2  C5 rr                CMP     scope_depth
0029D1r 2  D0 0A                BNE     @done           ; entry belongs to an outer scope — stop
0029D3r 2               ; remove this entry
0029D3r 2  CE rr rr             DEC     symtab_count
0029D6r 2  D0 C9                BNE     @trim
0029D8r 2  CE rr rr             DEC     symtab_count+1
0029DBr 2  80 C4                BRA     @trim
0029DDr 2               @done:
0029DDr 2  C6 rr                DEC     scope_depth
0029DFr 2  60                   RTS
0029E0r 2               
0029E0r 1                       .include        "CODEGEN.ASM"
0029E0r 2               ; codegen.asm — p-code emitter for Pascal/65 compiler
0029E0r 2               ;
0029E0r 2               ; All generated p-code accumulates in CODEBUF_BASE.
0029E0r 2               ; cg_pc (zero page) tracks the next write offset.
0029E0r 2               
0029E0r 2                       .segment        "CODE"
0029E0r 2               
0029E0r 2               ; ---------------------------------------------------------------------------
0029E0r 2               ; emit_byte — append byte A to code buffer
0029E0r 2               ; ---------------------------------------------------------------------------
0029E0r 2               emit_byte:
0029E0r 2  48                   PHA                     ; save byte to emit
0029E1r 2               ; check buffer full
0029E1r 2  A5 rr                LDA     cg_pc+1
0029E3r 2  C9 80                CMP     #>CODEBUF_MAXSZ
0029E5r 2  90 13                BCC     :+
0029E7r 2  A5 rr                LDA     cg_pc
0029E9r 2  C9 00                CMP     #<CODEBUF_MAXSZ
0029EBr 2  90 0D                BCC     :+
0029EDr 2               ; error: p-code buffer full
0029EDr 2  68                   PLA
0029EEr 2  A9 rr                LDA     #<err_pcd_full
0029F0r 2  85 rr                STA     tmp0
0029F2r 2  A9 rr                LDA     #>err_pcd_full
0029F4r 2  85 rr                STA     tmp0+1
0029F6r 2  20 rr rr             JSR     compile_error
0029F9r 2  60                   RTS
0029FAr 2               :
0029FAr 2               ; store at CODEBUF_BASE + cg_pc
0029FAr 2  A5 rr                LDA     cg_pc
0029FCr 2  18                   CLC
0029FDr 2  69 00                ADC     #<CODEBUF_BASE
0029FFr 2  85 rr                STA     tmp2
002A01r 2  A5 rr                LDA     cg_pc+1
002A03r 2  69 49                ADC     #>CODEBUF_BASE
002A05r 2  85 rr                STA     tmp2+1
002A07r 2  68                   PLA
002A08r 2  A0 00                LDY     #0
002A0Ar 2  91 rr                STA     (tmp2),y
002A0Cr 2               ; advance cg_pc
002A0Cr 2  E6 rr                INC     cg_pc
002A0Er 2  D0 02                BNE     :+
002A10r 2  E6 rr                INC     cg_pc+1
002A12r 2               :
002A12r 2  60                   RTS
002A13r 2               
002A13r 2               ; ---------------------------------------------------------------------------
002A13r 2               ; emit_word — append word (lo then hi) from tmp2 to code buffer
002A13r 2               ; ---------------------------------------------------------------------------
002A13r 2               emit_word:
002A13r 2  A5 rr                LDA     tmp2
002A15r 2  20 rr rr             JSR     emit_byte
002A18r 2  A5 rr                LDA     tmp2+1
002A1Ar 2  20 rr rr             JSR     emit_byte
002A1Dr 2  60                   RTS
002A1Er 2               
002A1Er 2               ; ---------------------------------------------------------------------------
002A1Er 2               ; emit_opcode — emit single opcode byte in A
002A1Er 2               ; ---------------------------------------------------------------------------
002A1Er 2               emit_opcode:
002A1Er 2  20 rr rr             JSR     emit_byte
002A21r 2  60                   RTS
002A22r 2               
002A22r 2               ; --- Constant emitters ---
002A22r 2               
002A22r 2               emit_LDCI:                      ; push sign-extended byte in A
002A22r 2  48                   PHA
002A23r 2  A9 00                LDA     #OP_LDCI
002A25r 2  20 rr rr             JSR     emit_byte
002A28r 2  68                   PLA
002A29r 2  20 rr rr             JSR     emit_byte
002A2Cr 2  60                   RTS
002A2Dr 2               
002A2Dr 2               emit_LDCW:                      ; push word: lo in A, hi in scratch
002A2Dr 2  48                   PHA
002A2Er 2  A9 01                LDA     #OP_LDCW
002A30r 2  20 rr rr             JSR     emit_byte
002A33r 2  68                   PLA
002A34r 2  20 rr rr             JSR     emit_byte
002A37r 2  A5 rr                LDA     scratch
002A39r 2  20 rr rr             JSR     emit_byte
002A3Cr 2  60                   RTS
002A3Dr 2               
002A3Dr 2               emit_LDCC:                      ; push char in A
002A3Dr 2  48                   PHA
002A3Er 2  A9 02                LDA     #OP_LDCC
002A40r 2  20 rr rr             JSR     emit_byte
002A43r 2  68                   PLA
002A44r 2  20 rr rr             JSR     emit_byte
002A47r 2  60                   RTS
002A48r 2               
002A48r 2               emit_LDCB:                      ; push boolean in A (0=false, 1=true)
002A48r 2  48                   PHA
002A49r 2  A9 03                LDA     #OP_LDCB
002A4Br 2  20 rr rr             JSR     emit_byte
002A4Er 2  68                   PLA
002A4Fr 2  20 rr rr             JSR     emit_byte
002A52r 2  60                   RTS
002A53r 2               
002A53r 2               emit_LDCN:
002A53r 2  A9 05                LDA     #OP_LDCN
002A55r 2  20 rr rr             JSR     emit_byte
002A58r 2  60                   RTS
002A59r 2               
002A59r 2               ; emit_LDCS — emit OP_LDCS followed by length byte and string bytes.
002A59r 2               ; Source string lives in ident_buf (length at [0], chars at [1..N]).
002A59r 2               ; The runtime will inline-fetch length+chars and push the address of
002A59r 2               ; the length byte as a Pascal-style string pointer.
002A59r 2               emit_LDCS:
002A59r 2  A9 04                LDA     #OP_LDCS
002A5Br 2  20 rr rr             JSR     emit_byte
002A5Er 2  AD rr rr             LDA     ident_buf       ; length
002A61r 2  85 rr                STA     scratch         ; counter / length cache
002A63r 2  20 rr rr             JSR     emit_byte       ; emit length byte
002A66r 2  A2 00                LDX     #0
002A68r 2               @loop:
002A68r 2  E4 rr                CPX     scratch
002A6Ar 2  B0 0B                BCS     @done
002A6Cr 2  BD rr rr             LDA     ident_buf+1,x
002A6Fr 2  DA                   PHX
002A70r 2  20 rr rr             JSR     emit_byte       ; clobbers tmp2 only
002A73r 2  FA                   PLX
002A74r 2  E8                   INX
002A75r 2  80 F1                BRA     @loop
002A77r 2               @done:
002A77r 2  60                   RTS
002A78r 2               
002A78r 2               ; --- Local variable emitters ---
002A78r 2               
002A78r 2               emit_LDL:                       ; byte offset in A
002A78r 2  48                   PHA
002A79r 2  A9 10                LDA     #OP_LDL
002A7Br 2  20 rr rr             JSR     emit_byte
002A7Er 2  68                   PLA
002A7Fr 2  20 rr rr             JSR     emit_byte
002A82r 2  60                   RTS
002A83r 2               
002A83r 2               emit_STL:
002A83r 2  48                   PHA
002A84r 2  A9 11                LDA     #OP_STL
002A86r 2  20 rr rr             JSR     emit_byte
002A89r 2  68                   PLA
002A8Ar 2  20 rr rr             JSR     emit_byte
002A8Dr 2  60                   RTS
002A8Er 2               
002A8Er 2               emit_LDA_L:
002A8Er 2  48                   PHA
002A8Fr 2  A9 12                LDA     #OP_LDA_L
002A91r 2  20 rr rr             JSR     emit_byte
002A94r 2  68                   PLA
002A95r 2  20 rr rr             JSR     emit_byte
002A98r 2  60                   RTS
002A99r 2               
002A99r 2               ; --- Global variable emitters ---
002A99r 2               
002A99r 2               emit_LDG:                       ; word offset: lo in A, hi in scratch
002A99r 2  48                   PHA
002A9Ar 2  A9 18                LDA     #OP_LDG
002A9Cr 2  20 rr rr             JSR     emit_byte
002A9Fr 2  68                   PLA
002AA0r 2  20 rr rr             JSR     emit_byte
002AA3r 2  A5 rr                LDA     scratch
002AA5r 2  20 rr rr             JSR     emit_byte
002AA8r 2  60                   RTS
002AA9r 2               
002AA9r 2               emit_STG:
002AA9r 2  48                   PHA
002AAAr 2  A9 19                LDA     #OP_STG
002AACr 2  20 rr rr             JSR     emit_byte
002AAFr 2  68                   PLA
002AB0r 2  20 rr rr             JSR     emit_byte
002AB3r 2  A5 rr                LDA     scratch
002AB5r 2  20 rr rr             JSR     emit_byte
002AB8r 2  60                   RTS
002AB9r 2               
002AB9r 2               emit_LDA_G:                     ; word offset: lo in A, hi in scratch
002AB9r 2  48                   PHA
002ABAr 2  A9 1A                LDA     #OP_LDA_G
002ABCr 2  20 rr rr             JSR     emit_byte
002ABFr 2  68                   PLA
002AC0r 2  20 rr rr             JSR     emit_byte
002AC3r 2  A5 rr                LDA     scratch
002AC5r 2  20 rr rr             JSR     emit_byte
002AC8r 2  60                   RTS
002AC9r 2               
002AC9r 2               ; --- Indirect (VAR-param) emitters ---
002AC9r 2               
002AC9r 2               emit_LDIND:
002AC9r 2  A9 20                LDA     #OP_LDIND
002ACBr 2  4C rr rr             JMP     emit_byte
002ACEr 2               
002ACEr 2               emit_STIND:
002ACEr 2  A9 21                LDA     #OP_STIND
002AD0r 2  4C rr rr             JMP     emit_byte
002AD3r 2               
002AD3r 2               ; emit_INDEX — OP_INDEX + 2-byte element size word (lo in A, hi in scratch)
002AD3r 2               emit_INDEX:
002AD3r 2  48                   PHA
002AD4r 2  A9 24                LDA     #OP_INDEX
002AD6r 2  20 rr rr             JSR     emit_byte
002AD9r 2  68                   PLA
002ADAr 2  20 rr rr             JSR     emit_byte
002ADDr 2  A5 rr                LDA     scratch
002ADFr 2  20 rr rr             JSR     emit_byte
002AE2r 2  60                   RTS
002AE3r 2               
002AE3r 2               ; emit_NEW — OP_NEW + 2-byte allocation size (lo in A, hi in scratch)
002AE3r 2               emit_NEW:
002AE3r 2  48                   PHA
002AE4r 2  A9 70                LDA     #OP_NEW
002AE6r 2  20 rr rr             JSR     emit_byte
002AE9r 2  68                   PLA
002AEAr 2  20 rr rr             JSR     emit_byte
002AEDr 2  A5 rr                LDA     scratch
002AEFr 2  20 rr rr             JSR     emit_byte
002AF2r 2  60                   RTS
002AF3r 2               
002AF3r 2               ; emit_DISP — OP_DISP (no operand)
002AF3r 2               emit_DISP:
002AF3r 2  A9 71                LDA     #OP_DISP
002AF5r 2  4C rr rr             JMP     emit_byte
002AF8r 2               
002AF8r 2               ; ---------------------------------------------------------------------------
002AF8r 2               ; codegen_alloc_array_global — allocate ARRAY [array_lo..array_hi] in globals
002AF8r 2               ; Element size fixed at 2 (all scalars are word-sized).
002AF8r 2               ; Returns: tmp2 = adjusted_offset = raw_base - lo*2
002AF8r 2               ;          cg_globals advanced by (hi - lo + 1) * 2
002AF8r 2               ; Clobbers: tmp2, tmp3
002AF8r 2               ; ---------------------------------------------------------------------------
002AF8r 2               codegen_alloc_array_global:
002AF8r 2               ; count = hi - lo + 1  (16-bit)
002AF8r 2  AD rr rr             LDA     array_hi
002AFBr 2  38                   SEC
002AFCr 2  ED rr rr             SBC     array_lo
002AFFr 2  85 rr                STA     tmp2
002B01r 2  AD rr rr             LDA     array_hi+1
002B04r 2  ED rr rr             SBC     array_lo+1
002B07r 2  85 rr                STA     tmp2+1
002B09r 2  E6 rr                INC     tmp2
002B0Br 2  D0 02                BNE     :+
002B0Dr 2  E6 rr                INC     tmp2+1
002B0Fr 2               :
002B0Fr 2               ; alloc_size = count * 2
002B0Fr 2  06 rr                ASL     tmp2
002B11r 2  26 rr                ROL     tmp2+1
002B13r 2               ; save raw_base = cg_globals before advancing
002B13r 2  A5 rr                LDA     cg_globals
002B15r 2  85 rr                STA     tmp3
002B17r 2  A5 rr                LDA     cg_globals+1
002B19r 2  85 rr                STA     tmp3+1
002B1Br 2               ; advance cg_globals by alloc_size (tmp2)
002B1Br 2  A5 rr                LDA     cg_globals
002B1Dr 2  18                   CLC
002B1Er 2  65 rr                ADC     tmp2
002B20r 2  85 rr                STA     cg_globals
002B22r 2  A5 rr                LDA     cg_globals+1
002B24r 2  65 rr                ADC     tmp2+1
002B26r 2  85 rr                STA     cg_globals+1
002B28r 2               ; adjusted_offset = raw_base (tmp3) - lo*2 (tmp2 reused)
002B28r 2  AD rr rr             LDA     array_lo
002B2Br 2  0A                   ASL
002B2Cr 2  85 rr                STA     tmp2
002B2Er 2  AD rr rr             LDA     array_lo+1
002B31r 2  2A                   ROL
002B32r 2  85 rr                STA     tmp2+1
002B34r 2  A5 rr                LDA     tmp3
002B36r 2  38                   SEC
002B37r 2  E5 rr                SBC     tmp2
002B39r 2  85 rr                STA     tmp2
002B3Br 2  A5 rr                LDA     tmp3+1
002B3Dr 2  E5 rr                SBC     tmp2+1
002B3Fr 2  85 rr                STA     tmp2+1
002B41r 2  60                   RTS
002B42r 2               
002B42r 2               ; ---------------------------------------------------------------------------
002B42r 2               ; codegen_alloc_record_global — reserve record_size bytes in globals
002B42r 2               ; Returns: tmp2 = offset of record's first byte
002B42r 2               ;          cg_globals advanced by record_size
002B42r 2               ; ---------------------------------------------------------------------------
002B42r 2               codegen_alloc_record_global:
002B42r 2  A5 rr                LDA     cg_globals
002B44r 2  85 rr                STA     tmp2
002B46r 2  A5 rr                LDA     cg_globals+1
002B48r 2  85 rr                STA     tmp2+1
002B4Ar 2  18                   CLC
002B4Br 2  A5 rr                LDA     cg_globals
002B4Dr 2  6D rr rr             ADC     record_size
002B50r 2  85 rr                STA     cg_globals
002B52r 2  A5 rr                LDA     cg_globals+1
002B54r 2  6D rr rr             ADC     record_size+1
002B57r 2  85 rr                STA     cg_globals+1
002B59r 2  60                   RTS
002B5Ar 2               
002B5Ar 2               ; ---------------------------------------------------------------------------
002B5Ar 2               ; codegen_alloc_text_global — reserve FILE_STRUCT_SZ (168) bytes for a TEXT
002B5Ar 2               ; variable.  Returns tmp2 = offset of struct's first byte; cg_globals bumped.
002B5Ar 2               ; ---------------------------------------------------------------------------
002B5Ar 2               codegen_alloc_text_global:
002B5Ar 2  A5 rr                LDA     cg_globals
002B5Cr 2  85 rr                STA     tmp2
002B5Er 2  A5 rr                LDA     cg_globals+1
002B60r 2  85 rr                STA     tmp2+1
002B62r 2  18                   CLC
002B63r 2  A5 rr                LDA     cg_globals
002B65r 2  69 A8                ADC     #FILE_STRUCT_SZ
002B67r 2  85 rr                STA     cg_globals
002B69r 2  A5 rr                LDA     cg_globals+1
002B6Br 2  69 00                ADC     #0
002B6Dr 2  85 rr                STA     cg_globals+1
002B6Fr 2  60                   RTS
002B70r 2               
002B70r 2               ; --- Arithmetic emitters ---
002B70r 2               
002B70r 2               emit_ADI:
002B70r 2  A9 30                LDA     #OP_ADI
002B72r 2  4C rr rr             JMP     emit_byte
002B75r 2               
002B75r 2               emit_SBI:
002B75r 2  A9 31                LDA     #OP_SBI
002B77r 2  4C rr rr             JMP     emit_byte
002B7Ar 2               
002B7Ar 2               emit_MPI:
002B7Ar 2  A9 32                LDA     #OP_MPI
002B7Cr 2  4C rr rr             JMP     emit_byte
002B7Fr 2               
002B7Fr 2               emit_DVI:
002B7Fr 2  A9 33                LDA     #OP_DVI
002B81r 2  4C rr rr             JMP     emit_byte
002B84r 2               
002B84r 2               emit_MPR:
002B84r 2  A9 A5                LDA     #OP_MPR
002B86r 2  4C rr rr             JMP     emit_byte
002B89r 2               
002B89r 2               emit_DVR:
002B89r 2  A9 A6                LDA     #OP_DVR
002B8Br 2  4C rr rr             JMP     emit_byte
002B8Er 2               
002B8Er 2               emit_MOD:
002B8Er 2  A9 34                LDA     #OP_MOD
002B90r 2  4C rr rr             JMP     emit_byte
002B93r 2               
002B93r 2               emit_NGI:
002B93r 2  A9 35                LDA     #OP_NGI
002B95r 2  4C rr rr             JMP     emit_byte
002B98r 2               
002B98r 2               ; --- Comparison emitters ---
002B98r 2               
002B98r 2               emit_EQUI:
002B98r 2  A9 40                LDA     #OP_EQUI
002B9Ar 2  4C rr rr             JMP     emit_byte
002B9Dr 2               
002B9Dr 2               emit_NEQI:
002B9Dr 2  A9 41                LDA     #OP_NEQI
002B9Fr 2  4C rr rr             JMP     emit_byte
002BA2r 2               
002BA2r 2               emit_LESI:
002BA2r 2  A9 42                LDA     #OP_LESI
002BA4r 2  4C rr rr             JMP     emit_byte
002BA7r 2               
002BA7r 2               emit_LEQI:
002BA7r 2  A9 43                LDA     #OP_LEQI
002BA9r 2  4C rr rr             JMP     emit_byte
002BACr 2               
002BACr 2               emit_GTRI:
002BACr 2  A9 44                LDA     #OP_GTRI
002BAEr 2  4C rr rr             JMP     emit_byte
002BB1r 2               
002BB1r 2               emit_GEQI:
002BB1r 2  A9 45                LDA     #OP_GEQI
002BB3r 2  4C rr rr             JMP     emit_byte
002BB6r 2               
002BB6r 2               ; --- Logical ---
002BB6r 2               
002BB6r 2               emit_LAND:
002BB6r 2  A9 38                LDA     #OP_LAND
002BB8r 2  4C rr rr             JMP     emit_byte
002BBBr 2               
002BBBr 2               emit_LOR:
002BBBr 2  A9 39                LDA     #OP_LOR
002BBDr 2  4C rr rr             JMP     emit_byte
002BC0r 2               
002BC0r 2               emit_LNOT:
002BC0r 2  A9 3A                LDA     #OP_LNOT
002BC2r 2  4C rr rr             JMP     emit_byte
002BC5r 2               
002BC5r 2               emit_BNOT:
002BC5r 2  A9 3B                LDA     #OP_BNOT
002BC7r 2  4C rr rr             JMP     emit_byte
002BCAr 2               
002BCAr 2               emit_INSET:
002BCAr 2  A9 A4                LDA     #OP_INSET
002BCCr 2  4C rr rr             JMP     emit_byte
002BCFr 2               
002BCFr 2               ; --- Jump emitters ---
002BCFr 2               ; Returns: A/scratch = offset of the word operand in code buffer
002BCFr 2               ; (needed for backpatching)
002BCFr 2               
002BCFr 2               emit_UJP:                       ; emit UJP with placeholder offset
002BCFr 2  A9 50                LDA     #OP_UJP
002BD1r 2  20 rr rr             JSR     emit_byte
002BD4r 2  A5 rr                LDA     cg_pc           ; save patch address
002BD6r 2  48                   PHA
002BD7r 2  A5 rr                LDA     cg_pc+1
002BD9r 2  48                   PHA
002BDAr 2  A9 00                LDA     #$00
002BDCr 2  20 rr rr             JSR     emit_byte       ; placeholder lo
002BDFr 2  A9 00                LDA     #$00
002BE1r 2  20 rr rr             JSR     emit_byte       ; placeholder hi
002BE4r 2  68                   PLA
002BE5r 2  85 rr                STA     scratch
002BE7r 2  68                   PLA                     ; lo of patch address
002BE8r 2  60                   RTS                     ; caller: save A/scratch as patch point
002BE9r 2               
002BE9r 2               emit_FJP:
002BE9r 2  A9 51                LDA     #OP_FJP
002BEBr 2  20 rr rr             JSR     emit_byte
002BEEr 2  A5 rr                LDA     cg_pc
002BF0r 2  48                   PHA
002BF1r 2  A5 rr                LDA     cg_pc+1
002BF3r 2  48                   PHA
002BF4r 2  A9 00                LDA     #$00
002BF6r 2  20 rr rr             JSR     emit_byte
002BF9r 2  A9 00                LDA     #$00
002BFBr 2  20 rr rr             JSR     emit_byte
002BFEr 2  68                   PLA
002BFFr 2  85 rr                STA     scratch
002C01r 2  68                   PLA
002C02r 2  60                   RTS
002C03r 2               
002C03r 2               emit_TJP:
002C03r 2  A9 52                LDA     #OP_TJP
002C05r 2  20 rr rr             JSR     emit_byte
002C08r 2  A5 rr                LDA     cg_pc
002C0Ar 2  48                   PHA
002C0Br 2  A5 rr                LDA     cg_pc+1
002C0Dr 2  48                   PHA
002C0Er 2  A9 00                LDA     #$00
002C10r 2  20 rr rr             JSR     emit_byte
002C13r 2  A9 00                LDA     #$00
002C15r 2  20 rr rr             JSR     emit_byte
002C18r 2  68                   PLA
002C19r 2  85 rr                STA     scratch
002C1Br 2  68                   PLA
002C1Cr 2  60                   RTS
002C1Dr 2               
002C1Dr 2               ; ---------------------------------------------------------------------------
002C1Dr 2               ; patch_jump — fill in jump offset at patch address stored in tmp2 (word)
002C1Dr 2               ; The offset is computed as: (current cg_pc) - (patch_addr + 2)
002C1Dr 2               ; i.e. relative to instruction after the operand word
002C1Dr 2               ; ---------------------------------------------------------------------------
002C1Dr 2               patch_jump:
002C1Dr 2               ; delta = cg_pc - (patch_addr + 2)
002C1Dr 2               ;   compute (cg_pc - 2) first, then subtract patch_addr
002C1Dr 2  A5 rr                LDA     cg_pc
002C1Fr 2  38                   SEC
002C20r 2  E9 02                SBC     #2
002C22r 2  85 rr                STA     scratch         ; lo of (cg_pc - 2)
002C24r 2  A5 rr                LDA     cg_pc+1
002C26r 2  E9 00                SBC     #0
002C28r 2  85 rr                STA     scratch+1       ; hi of (cg_pc - 2)
002C2Ar 2  38                   SEC
002C2Br 2  A5 rr                LDA     scratch
002C2Dr 2  E5 rr                SBC     tmp2
002C2Fr 2  48                   PHA
002C30r 2  A5 rr                LDA     scratch+1
002C32r 2  E5 rr                SBC     tmp2+1
002C34r 2  85 rr                STA     scratch+1       ; high byte of delta
002C36r 2  68                   PLA
002C37r 2  85 rr                STA     scratch         ; low byte of delta
002C39r 2               ; write delta at patch address (CODEBUF_BASE + tmp2)
002C39r 2  A5 rr                LDA     tmp2
002C3Br 2  18                   CLC
002C3Cr 2  69 00                ADC     #<CODEBUF_BASE
002C3Er 2  85 rr                STA     tmp3
002C40r 2  A5 rr                LDA     tmp2+1
002C42r 2  69 49                ADC     #>CODEBUF_BASE
002C44r 2  85 rr                STA     tmp3+1
002C46r 2  A0 00                LDY     #0
002C48r 2  A5 rr                LDA     scratch
002C4Ar 2  91 rr                STA     (tmp3),y
002C4Cr 2  C8                   INY
002C4Dr 2  A5 rr                LDA     scratch+1
002C4Fr 2  91 rr                STA     (tmp3),y
002C51r 2  60                   RTS
002C52r 2               
002C52r 2               ; --- I/O emitters ---
002C52r 2               
002C52r 2               emit_WRITI:
002C52r 2  A9 80                LDA     #OP_WRITI
002C54r 2  4C rr rr             JMP     emit_byte
002C57r 2               
002C57r 2               emit_WRITC:
002C57r 2  A9 81                LDA     #OP_WRITC
002C59r 2  4C rr rr             JMP     emit_byte
002C5Cr 2               
002C5Cr 2               emit_WRITB:
002C5Cr 2  A9 82                LDA     #OP_WRITB
002C5Er 2  4C rr rr             JMP     emit_byte
002C61r 2               
002C61r 2               emit_WRITS:
002C61r 2  A9 83                LDA     #OP_WRITS
002C63r 2  4C rr rr             JMP     emit_byte
002C66r 2               
002C66r 2               emit_WRITLN:
002C66r 2  A9 84                LDA     #OP_WRITLN
002C68r 2  4C rr rr             JMP     emit_byte
002C6Br 2               
002C6Br 2               emit_READI:
002C6Br 2  A9 85                LDA     #OP_READI
002C6Dr 2  4C rr rr             JMP     emit_byte
002C70r 2               
002C70r 2               emit_WRITR:
002C70r 2  A9 88                LDA     #OP_WRITR
002C72r 2  4C rr rr             JMP     emit_byte
002C75r 2               
002C75r 2               emit_READR:
002C75r 2  A9 89                LDA     #OP_READR
002C77r 2  4C rr rr             JMP     emit_byte
002C7Ar 2               
002C7Ar 2               emit_READC:
002C7Ar 2  A9 86                LDA     #OP_READC
002C7Cr 2  4C rr rr             JMP     emit_byte
002C7Fr 2               
002C7Fr 2               ; --- Stack ---
002C7Fr 2               
002C7Fr 2               emit_DUP:
002C7Fr 2  A9 90                LDA     #OP_DUP
002C81r 2  4C rr rr             JMP     emit_byte
002C84r 2               
002C84r 2               emit_POP:
002C84r 2  A9 91                LDA     #OP_POP
002C86r 2  4C rr rr             JMP     emit_byte
002C89r 2               
002C89r 2               emit_SWAP:
002C89r 2  A9 92                LDA     #OP_SWAP
002C8Br 2  4C rr rr             JMP     emit_byte
002C8Er 2               
002C8Er 2               ; --- Calls ---
002C8Er 2               
002C8Er 2               emit_MRKSTK:                    ; local size in A
002C8Er 2  48                   PHA
002C8Fr 2  A9 64                LDA     #OP_MRKSTK
002C91r 2  20 rr rr             JSR     emit_byte
002C94r 2  68                   PLA
002C95r 2  4C rr rr             JMP     emit_byte
002C98r 2               
002C98r 2               ; emit_MRKA — A=pcount, X=lsize_extra
002C98r 2               ; Emits OP_MRKA + pcount byte + lsize_extra byte.  See op_MRKA in prun.asm
002C98r 2               ; for runtime semantics.
002C98r 2               emit_MRKA:
002C98r 2  DA                   PHX                     ; save lsize_extra
002C99r 2  48                   PHA                     ; save pcount
002C9Ar 2  A9 67                LDA     #OP_MRKA
002C9Cr 2  20 rr rr             JSR     emit_byte
002C9Fr 2  68                   PLA                     ; pcount
002CA0r 2  20 rr rr             JSR     emit_byte
002CA3r 2  68                   PLA                     ; lsize_extra
002CA4r 2  4C rr rr             JMP     emit_byte
002CA7r 2               
002CA7r 2               emit_RET:
002CA7r 2  A9 62                LDA     #OP_RET
002CA9r 2  4C rr rr             JMP     emit_byte
002CACr 2               
002CACr 2               emit_RETF:
002CACr 2  A9 63                LDA     #OP_RETF
002CAEr 2  4C rr rr             JMP     emit_byte
002CB1r 2               
002CB1r 2               emit_STR:
002CB1r 2  A9 66                LDA     #OP_STR
002CB3r 2  4C rr rr             JMP     emit_byte
002CB6r 2               
002CB6r 2               ; emit_CALL — A = target absolute code-buffer addr lo, scratch = hi
002CB6r 2               ; Emits OP_CALL + signed 16-bit offset = target - (cg_pc_after_operand)
002CB6r 2               emit_CALL:
002CB6r 2  48                   PHA                     ; target lo
002CB7r 2  A5 rr                LDA     scratch
002CB9r 2  48                   PHA                     ; target hi
002CBAr 2  A9 60                LDA     #OP_CALL
002CBCr 2  20 rr rr             JSR     emit_byte       ; clobbers tmp2; preserves scratch & 6502 stack
002CBFr 2               ; compute offset = target - cg_pc - 2 (16-bit)
002CBFr 2  68                   PLA                     ; target hi
002CC0r 2  AA                   TAX
002CC1r 2  68                   PLA                     ; target lo
002CC2r 2  38                   SEC
002CC3r 2  E9 02                SBC     #2
002CC5r 2  48                   PHA                     ; partial lo
002CC6r 2  8A                   TXA                     ; target hi
002CC7r 2  E9 00                SBC     #0
002CC9r 2  85 rr                STA     scratch         ; partial hi
002CCBr 2  68                   PLA                     ; partial lo
002CCCr 2  38                   SEC
002CCDr 2  E5 rr                SBC     cg_pc
002CCFr 2  48                   PHA                     ; offset lo
002CD0r 2  A5 rr                LDA     scratch
002CD2r 2  E5 rr                SBC     cg_pc+1
002CD4r 2  85 rr                STA     scratch         ; offset hi
002CD6r 2  68                   PLA
002CD7r 2  20 rr rr             JSR     emit_byte       ; emit offset lo
002CDAr 2  A5 rr                LDA     scratch
002CDCr 2  20 rr rr             JSR     emit_byte       ; emit offset hi
002CDFr 2  60                   RTS
002CE0r 2               
002CE0r 2               emit_HALT:
002CE0r 2  A9 FF                LDA     #OP_HALT
002CE2r 2  4C rr rr             JMP     emit_byte
002CE5r 2               
002CE5r 2               ; --- String built-ins ---
002CE5r 2               
002CE5r 2               emit_LEN:
002CE5r 2  A9 A0                LDA     #OP_LEN
002CE7r 2  4C rr rr             JMP     emit_byte
002CEAr 2               
002CEAr 2               emit_POS:
002CEAr 2  A9 A1                LDA     #OP_POS
002CECr 2  4C rr rr             JMP     emit_byte
002CEFr 2               
002CEFr 2               emit_COPY:
002CEFr 2  A9 A2                LDA     #OP_COPY
002CF1r 2  4C rr rr             JMP     emit_byte
002CF4r 2               
002CF4r 2               emit_CONCAT:
002CF4r 2  A9 A3                LDA     #OP_CONCAT
002CF6r 2  4C rr rr             JMP     emit_byte
002CF9r 2               
002CF9r 2               ; --- TEXT file I/O ---
002CF9r 2               
002CF9r 2               emit_FASSGN:
002CF9r 2  A9 B0                LDA     #OP_FASSGN
002CFBr 2  4C rr rr             JMP     emit_byte
002CFEr 2               emit_FRESET:
002CFEr 2  A9 B1                LDA     #OP_FRESET
002D00r 2  4C rr rr             JMP     emit_byte
002D03r 2               emit_FREWRT:
002D03r 2  A9 B2                LDA     #OP_FREWRT
002D05r 2  4C rr rr             JMP     emit_byte
002D08r 2               emit_FCLOSE:
002D08r 2  A9 B3                LDA     #OP_FCLOSE
002D0Ar 2  4C rr rr             JMP     emit_byte
002D0Dr 2               emit_FWRC:
002D0Dr 2  A9 B4                LDA     #OP_FWRC
002D0Fr 2  4C rr rr             JMP     emit_byte
002D12r 2               emit_FWRS:
002D12r 2  A9 B5                LDA     #OP_FWRS
002D14r 2  4C rr rr             JMP     emit_byte
002D17r 2               emit_FWRI:
002D17r 2  A9 B6                LDA     #OP_FWRI
002D19r 2  4C rr rr             JMP     emit_byte
002D1Cr 2               emit_FWRR:
002D1Cr 2  A9 C0                LDA     #OP_FWRR
002D1Er 2  4C rr rr             JMP     emit_byte
002D21r 2               emit_FWLN:
002D21r 2  A9 B7                LDA     #OP_FWLN
002D23r 2  4C rr rr             JMP     emit_byte
002D26r 2               emit_FRDC:
002D26r 2  A9 B8                LDA     #OP_FRDC
002D28r 2  4C rr rr             JMP     emit_byte
002D2Br 2               emit_FRDI:
002D2Br 2  A9 B9                LDA     #OP_FRDI
002D2Dr 2  4C rr rr             JMP     emit_byte
002D30r 2               emit_FRDR:
002D30r 2  A9 C1                LDA     #OP_FRDR
002D32r 2  4C rr rr             JMP     emit_byte
002D35r 2               emit_FRDLN:
002D35r 2  A9 BA                LDA     #OP_FRDLN
002D37r 2  4C rr rr             JMP     emit_byte
002D3Ar 2               emit_FEOF:
002D3Ar 2  A9 BB                LDA     #OP_FEOF
002D3Cr 2  4C rr rr             JMP     emit_byte
002D3Fr 2               emit_FAPPND:
002D3Fr 2  A9 BC                LDA     #OP_FAPPND
002D41r 2  4C rr rr             JMP     emit_byte
002D44r 2               emit_FRDS:
002D44r 2  A9 BD                LDA     #OP_FRDS
002D46r 2  4C rr rr             JMP     emit_byte
002D49r 2               emit_FWRB:
002D49r 2  A9 BE                LDA     #OP_FWRB
002D4Br 2  4C rr rr             JMP     emit_byte
002D4Er 2               emit_FEOLN:
002D4Er 2  A9 BF                LDA     #OP_FEOLN
002D50r 2  4C rr rr             JMP     emit_byte
002D53r 2               
002D53r 2               ; ---------------------------------------------------------------------------
002D53r 2               ; codegen_alloc_global — reserve N bytes in global area; return offset in tmp2
002D53r 2               ; N in A
002D53r 2               ; ---------------------------------------------------------------------------
002D53r 2               codegen_alloc_global:
002D53r 2  A5 rr                LDA     cg_globals
002D55r 2  85 rr                STA     tmp2
002D57r 2  A5 rr                LDA     cg_globals+1
002D59r 2  85 rr                STA     tmp2+1
002D5Br 2               ; advance by N (passed in A — caller puts size here)
002D5Br 2               ; For now allocate 2 bytes (word) per variable
002D5Br 2  A5 rr                LDA     cg_globals
002D5Dr 2  18                   CLC
002D5Er 2  69 02                ADC     #2
002D60r 2  85 rr                STA     cg_globals
002D62r 2  90 02                BCC     :+
002D64r 2  E6 rr                INC     cg_globals+1
002D66r 2               :
002D66r 2  60                   RTS
002D67r 2               
002D67r 1                       .include        "IOLIB.ASM"
002D67r 2               .pc02
002D67r 2               ; iolib.asm — console and file I/O wrappers for DOS/65
002D67r 2               ;
002D67r 2               ; Uses PEM function 2 (CONOUT) for character output.
002D67r 2               ; This routes through DFT_CONSOLE and works on all platforms
002D67r 2               ; (serial, ESP video, memory-mapped video) regardless of which
002D67r 2               ; console driver is active.
002D67r 2               
002D67r 2                       .segment        "CODE"
002D67r 2               
002D67r 2               ; ---------------------------------------------------------------------------
002D67r 2               ; console_putc — output character in A to console via PEM #2
002D67r 2               ; ---------------------------------------------------------------------------
002D67r 2               console_putc:
002D67r 2  48                   PHA
002D68r 2  A2 02                LDX     #PEM_CONOUT
002D6Ar 2  20 03 01             JSR     PEM_ENTRY
002D6Dr 2  68                   PLA
002D6Er 2  60                   RTS
002D6Fr 2               
002D6Fr 2               ; ---------------------------------------------------------------------------
002D6Fr 2               ; console_newline — emit CR+LF
002D6Fr 2               ; ---------------------------------------------------------------------------
002D6Fr 2               console_newline:
002D6Fr 2  A9 0D                LDA     #$0D
002D71r 2  A2 02                LDX     #PEM_CONOUT
002D73r 2  20 03 01             JSR     PEM_ENTRY
002D76r 2  A9 0A                LDA     #$0A
002D78r 2  A2 02                LDX     #PEM_CONOUT
002D7Ar 2  20 03 01             JSR     PEM_ENTRY
002D7Dr 2  60                   RTS
002D7Er 2               
002D7Er 2               ; ---------------------------------------------------------------------------
002D7Er 2               ; console_print_sz — print null-terminated string at tmp0
002D7Er 2               ; ---------------------------------------------------------------------------
002D7Er 2               console_print_sz:
002D7Er 2  A0 00                LDY     #0
002D80r 2               @loop:
002D80r 2  B1 rr                LDA     (tmp0),y
002D82r 2  F0 08                BEQ     @done
002D84r 2  A2 02                LDX     #PEM_CONOUT
002D86r 2  20 03 01             JSR     PEM_ENTRY
002D89r 2  C8                   INY
002D8Ar 2  D0 F4                BNE     @loop
002D8Cr 2               @done:
002D8Cr 2  60                   RTS
002D8Dr 2               
002D8Dr 2               ; ---------------------------------------------------------------------------
002D8Dr 2               ; console_print_pstr — print length-prefixed Pascal string at tmp0
002D8Dr 2               ; ---------------------------------------------------------------------------
002D8Dr 2               console_print_pstr:
002D8Dr 2  A0 00                LDY     #0
002D8Fr 2  B1 rr                LDA     (tmp0),y        ; length byte
002D91r 2  F0 10                BEQ     @done
002D93r 2  AA                   TAX                     ; X = remaining chars — but X used by PEM!
002D94r 2               ; save length, use tmp1 as counter
002D94r 2  85 rr                STA     tmp1
002D96r 2  C8                   INY
002D97r 2               @loop:
002D97r 2  B1 rr                LDA     (tmp0),y
002D99r 2  A2 02                LDX     #PEM_CONOUT
002D9Br 2  20 03 01             JSR     PEM_ENTRY
002D9Er 2  C8                   INY
002D9Fr 2  C6 rr                DEC     tmp1
002DA1r 2  D0 F4                BNE     @loop
002DA3r 2               @done:
002DA3r 2  60                   RTS
002DA4r 2               
002DA4r 2               ; ---------------------------------------------------------------------------
002DA4r 2               ; console_print_dec — print signed 16-bit integer in tmp0:tmp0+1
002DA4r 2               ; ---------------------------------------------------------------------------
002DA4r 2               console_print_dec:
002DA4r 2  A5 rr                LDA     tmp0+1
002DA6r 2  10 14                BPL     @positive
002DA8r 2  A9 2D                LDA     #'-'
002DAAr 2  A2 02                LDX     #PEM_CONOUT
002DACr 2  20 03 01             JSR     PEM_ENTRY
002DAFr 2  A9 00                LDA     #0
002DB1r 2  38                   SEC
002DB2r 2  E5 rr                SBC     tmp0
002DB4r 2  85 rr                STA     tmp0
002DB6r 2  A9 00                LDA     #0
002DB8r 2  E5 rr                SBC     tmp0+1
002DBAr 2  85 rr                STA     tmp0+1
002DBCr 2               @positive:
002DBCr 2  A9 00                LDA     #0
002DBEr 2  48                   PHA                     ; sentinel
002DBFr 2               @div_loop:
002DBFr 2  20 rr rr             JSR     div16_by10      ; quotient→tmp0, remainder→scratch
002DC2r 2  A5 rr                LDA     scratch
002DC4r 2  18                   CLC
002DC5r 2  69 30                ADC     #'0'
002DC7r 2  48                   PHA
002DC8r 2  A5 rr                LDA     tmp0
002DCAr 2  05 rr                ORA     tmp0+1
002DCCr 2  D0 F1                BNE     @div_loop
002DCEr 2               @print_loop:
002DCEr 2  68                   PLA
002DCFr 2  F0 07                BEQ     @done2          ; sentinel
002DD1r 2  A2 02                LDX     #PEM_CONOUT
002DD3r 2  20 03 01             JSR     PEM_ENTRY
002DD6r 2  80 F6                BRA     @print_loop
002DD8r 2               @done2:
002DD8r 2  60                   RTS
002DD9r 2               
002DD9r 2               ; ---------------------------------------------------------------------------
002DD9r 2               ; div16_by10 — divide tmp0:tmp0+1 by 10
002DD9r 2               ; Result: quotient in tmp0:tmp0+1, remainder in scratch
002DD9r 2               ; ---------------------------------------------------------------------------
002DD9r 2               div16_by10:
002DD9r 2  A9 00                LDA     #0
002DDBr 2  85 rr                STA     scratch
002DDDr 2  A2 10                LDX     #16
002DDFr 2               @bit:
002DDFr 2  06 rr                ASL     tmp0
002DE1r 2  26 rr                ROL     tmp0+1
002DE3r 2  26 rr                ROL     scratch
002DE5r 2  A5 rr                LDA     scratch
002DE7r 2  C9 0A                CMP     #10
002DE9r 2  90 06                BCC     @no_sub
002DEBr 2  E9 0A                SBC     #10
002DEDr 2  85 rr                STA     scratch
002DEFr 2  E6 rr                INC     tmp0
002DF1r 2               @no_sub:
002DF1r 2  CA                   DEX
002DF2r 2  D0 EB                BNE     @bit
002DF4r 2  60                   RTS
002DF5r 2               
002DF5r 2               ; ---------------------------------------------------------------------------
002DF5r 2               ; console_read_line — read a line into buffer at tmp0, max len in x_save
002DF5r 2               ; Returns: Y = length (not including CR)
002DF5r 2               ; ---------------------------------------------------------------------------
002DF5r 2               console_read_line:
002DF5r 2  8E rr rr             STX     x_save
002DF8r 2  A0 00                LDY     #0
002DFAr 2               @loop:
002DFAr 2  A2 01                LDX     #PEM_CONIN
002DFCr 2  20 03 01             JSR     PEM_ENTRY
002DFFr 2  C9 0D                CMP     #$0D
002E01r 2  F0 28                BEQ     @done
002E03r 2  C9 08                CMP     #$08            ; backspace
002E05r 2  D0 1C                BNE     @store
002E07r 2  C0 00                CPY     #0
002E09r 2  F0 EF                BEQ     @loop
002E0Br 2  88                   DEY
002E0Cr 2  A9 08                LDA     #$08
002E0Er 2  A2 02                LDX     #PEM_CONOUT
002E10r 2  20 03 01             JSR     PEM_ENTRY
002E13r 2  A9 20                LDA     #' '
002E15r 2  A2 02                LDX     #PEM_CONOUT
002E17r 2  20 03 01             JSR     PEM_ENTRY
002E1Ar 2  A9 08                LDA     #$08
002E1Cr 2  A2 02                LDX     #PEM_CONOUT
002E1Er 2  20 03 01             JSR     PEM_ENTRY
002E21r 2  80 D7                BRA     @loop
002E23r 2               @store:
002E23r 2  91 rr                STA     (tmp0),y
002E25r 2  C8                   INY
002E26r 2  CC rr rr             CPY     x_save
002E29r 2  90 CF                BCC     @loop
002E2Br 2               @done:
002E2Br 2  60                   RTS
002E2Cr 2               x_save:
002E2Cr 2  00                   .BYTE   0
002E2Dr 2               
002E2Dr 2               ; ---------------------------------------------------------------------------
002E2Dr 2               ; file_open — open file via FCB at tmp1; returns A=0 success, $FF=not found
002E2Dr 2               ; PEM calling convention: X=function, A=FCB addr lo, Y=FCB addr hi
002E2Dr 2               ; ---------------------------------------------------------------------------
002E2Dr 2               file_open:
002E2Dr 2  A5 rr                LDA     tmp1
002E2Fr 2  A4 rr                LDY     tmp1+1
002E31r 2  A2 0F                LDX     #PEM_OPEN
002E33r 2  20 03 01             JSR     PEM_ENTRY
002E36r 2  60                   RTS
002E37r 2               
002E37r 2               ; ---------------------------------------------------------------------------
002E37r 2               ; file_make — create/truncate file via FCB at tmp1
002E37r 2               ; ---------------------------------------------------------------------------
002E37r 2               file_make:
002E37r 2  A5 rr                LDA     tmp1
002E39r 2  A4 rr                LDY     tmp1+1
002E3Br 2  A2 16                LDX     #PEM_MAKE
002E3Dr 2  20 03 01             JSR     PEM_ENTRY
002E40r 2  60                   RTS
002E41r 2               
002E41r 2               ; ---------------------------------------------------------------------------
002E41r 2               ; file_read_sector — read 128 bytes into DMA_BUF; returns A=0 ok, A=1 EOF
002E41r 2               ; ---------------------------------------------------------------------------
002E41r 2               file_read_sector:
002E41r 2  A5 rr                LDA     tmp1
002E43r 2  A4 rr                LDY     tmp1+1
002E45r 2  A2 14                LDX     #PEM_READ
002E47r 2  20 03 01             JSR     PEM_ENTRY
002E4Ar 2  60                   RTS
002E4Br 2               
002E4Br 2               ; ---------------------------------------------------------------------------
002E4Br 2               ; file_write_sector — write 128 bytes from DMA_BUF
002E4Br 2               ; ---------------------------------------------------------------------------
002E4Br 2               file_write_sector:
002E4Br 2  A5 rr                LDA     tmp1
002E4Dr 2  A4 rr                LDY     tmp1+1
002E4Fr 2  A2 15                LDX     #PEM_WRITE
002E51r 2  20 03 01             JSR     PEM_ENTRY
002E54r 2  60                   RTS
002E55r 2               
002E55r 2               ; ---------------------------------------------------------------------------
002E55r 2               ; file_close — close FCB at tmp1
002E55r 2               ; ---------------------------------------------------------------------------
002E55r 2               file_close:
002E55r 2  A5 rr                LDA     tmp1
002E57r 2  A4 rr                LDY     tmp1+1
002E59r 2  A2 10                LDX     #PEM_CLOSE
002E5Br 2  20 03 01             JSR     PEM_ENTRY
002E5Er 2  60                   RTS
002E5Fr 2               
002E5Fr 2               ; ---------------------------------------------------------------------------
002E5Fr 2               ; file_setdma — point PEM at the 128-byte buffer at (A:Y)
002E5Fr 2               ; A = lo, Y = hi.  Trashes X.
002E5Fr 2               ; ---------------------------------------------------------------------------
002E5Fr 2               file_setdma:
002E5Fr 2  A2 1A                LDX     #PEM_SETDMA
002E61r 2  4C 03 01             JMP     PEM_ENTRY
002E64r 2               
002E64r 2               ; ---------------------------------------------------------------------------
002E64r 2               ; file_setdma_default — restore PEM DMA pointer to system DMA_BUF
002E64r 2               ; ---------------------------------------------------------------------------
002E64r 2               file_setdma_default:
002E64r 2  A9 28                LDA     #<DMA_BUF
002E66r 2  A0 01                LDY     #>DMA_BUF
002E68r 2  A2 1A                LDX     #PEM_SETDMA
002E6Ar 2  4C 03 01             JMP     PEM_ENTRY
002E6Dr 2               
002E6Dr 1                       .include        "MESSAGES.ASM"
002E6Dr 2               ; messages.asm — compiler error and status strings (null-terminated)
002E6Dr 2               
002E6Dr 2                       .segment  "CODE"
002E6Dr 2               
002E6Dr 2               msg_banner:
002E6Dr 2  50 61 73 63          .BYTE   "Pascal/65 Compiler v0.1 for DOS/65",13,10,0
002E71r 2  61 6C 2F 36  
002E75r 2  35 20 43 6F  
002E92r 2               msg_compiling:
002E92r 2  43 6F 6D 70          .BYTE   "Compiling...",13,10,0
002E96r 2  69 6C 69 6E  
002E9Ar 2  67 2E 2E 2E  
002EA1r 2               msg_ok:
002EA1r 2  4F 4B 0D 0A          .BYTE   "OK",13,10,0
002EA5r 2  00           
002EA6r 2               msg_errors:
002EA6r 2  20 65 72 72          .BYTE   " error(s)",13,10,0
002EAAr 2  6F 72 28 73  
002EAEr 2  29 0D 0A 00  
002EB2r 2               msg_line:
002EB2r 2  20 4C 69 6E          .BYTE   " Line ",0
002EB6r 2  65 20 00     
002EB9r 2               msg_col:
002EB9r 2  20 43 6F 6C          .BYTE   " Col ",0
002EBDr 2  20 00        
002EBFr 2               
002EBFr 2               ; Compiler errors
002EBFr 2               err_unexpected:
002EBFr 2  55 6E 65 78          .BYTE   "Unexpected token",0
002EC3r 2  70 65 63 74  
002EC7r 2  65 64 20 74  
002ED0r 2               err_expected_id:
002ED0r 2  49 44 45 4E          .byte   "IDENTIFIER expected",0
002ED4r 2  54 49 46 49  
