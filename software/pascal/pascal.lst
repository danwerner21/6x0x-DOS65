0015D4r 2               ; ---------------------------------------------------------------------------
0015D4r 2               ; parse_assign_or_call — identifier already consumed by caller (in ident_buf)
0015D4r 2               ; If next is ':=' → assignment
0015D4r 2               ; If next is '(' → procedure call
0015D4r 2               ; If identifier is WRITE/WRITELN → built-in I/O
0015D4r 2               ; ---------------------------------------------------------------------------
0015D4r 2               parse_assign_or_call:
0015D4r 2               ; Dispatch built-in I/O procedures by length+initial letter.  RECORD/REPEAT
0015D4r 2               ; are reserved keywords so they never reach this dispatch as identifiers.
0015D4r 2               ;   len 3 : NEW
0015D4r 2               ;   len 4 : READ
0015D4r 2               ;   len 5 : WRITE  | RESET  | CLOSE
0015D4r 2               ;   len 6 : READLN | ASSIGN | APPEND
0015D4r 2               ;   len 7 : WRITELN| REWRITE | DISPOSE
0015D4r 2  AD rr rr             LDA     ident_buf       ; length
