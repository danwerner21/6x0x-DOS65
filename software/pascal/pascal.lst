000000r 2               ; ---------------------------------------------------------------------------
000000r 2               ; Useful macros
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               
000000r 2               ; Call PEM with function number in X
000000r 2               .macro PEM func
000000r 2                       ldx     #func
000000r 2                       jsr     PEM_ENTRY
000000r 2               .endmacro
000000r 2               
000000r 1                       .include        "ZEROPAGE.ASM"
000000r 2               ; zeropage.asm — zero-page variable layout for PASCAL.COM and PRUN.COM
000000r 2               ;
000000r 2               ; Avoid $00-$2F (DOS/65 system), $32 (FARFUNCT), $39-$3A (DOS/65).
000000r 2               ; Safe range: $50-$EF
000000r 2               
000000r 2                       .segment        "ZEROPAGE"
000000r 2               
000000r 2  xx xx xx xx          .RES    $50             ; skip $00-$4F (DOS/65 system zero page)
000004r 2  xx xx xx xx  
000008r 2  xx xx xx xx  
000050r 2               
000050r 2               ; ---------------------------------------------------------------------------
000050r 2               ; P-machine registers — start at $50 as noted in comments below
000050r 2               ; ---------------------------------------------------------------------------
000050r 2               
000050r 2               pm_ipc:
000050r 2  xx xx                .RES    2               ; $50-$51  interpreter program counter
000052r 2               pm_sp:
000052r 2  xx xx                .RES    2               ; $52-$53  p-machine stack pointer
000054r 2               pm_mp:
000054r 2  xx xx                .RES    2               ; $54-$55  mark/frame pointer
000056r 2               pm_base:
000056r 2  xx xx                .RES    2               ; $56-$57  global variable base
000058r 2               pm_np:
000058r 2  xx xx                .RES    2               ; $58-$59  heap top (grows downward)
00005Ar 2               
00005Ar 2               ; General-purpose temporaries
00005Ar 2               tmp0:
00005Ar 2  xx xx                .RES    2               ; $5A-$5B
00005Cr 2               tmp1:
00005Cr 2  xx xx                .RES    2               ; $5C-$5D
00005Er 2               tmp2:
00005Er 2  xx xx                .RES    2               ; $5E-$5F
000060r 2               tmp3:
000060r 2  xx xx                .RES    2               ; $60-$61
000062r 2               
000062r 2               ; Byte-width scratch (often used by macros)
000062r 2               scratch:
000062r 2  xx                   .RES    1               ; $62
000063r 2               
000063r 2               ; ---------------------------------------------------------------------------
000063r 2               ; Compiler-specific zero-page variables (only used by PASCAL.COM)
000063r 2               ; ---------------------------------------------------------------------------
000063r 2               
000063r 2               ; Lexer state
000063r 2               lex_line:
000063r 2  xx xx                .RES    2               ; $63-$64  current source line number
000065r 2               lex_col:
000065r 2  xx                   .RES    1               ; $65      current column
000066r 2               lex_char:
000066r 2  xx                   .RES    1               ; $66      lookahead character
000067r 2               tok_type:
000067r 2  xx                   .RES    1               ; $67      current token type
000068r 2               tok_ival_lo:
000068r 2  xx                   .RES    1               ; $68      integer token value (lo)
000069r 2               tok_ival_hi:
000069r 2  xx                   .RES    1               ; $69      integer token value (hi)
00006Ar 2               
00006Ar 2               ; Parser / code generator state
00006Ar 2               cg_pc:
00006Ar 2  xx xx                .RES    2               ; $6A-$6B  current emit offset into code buffer
00006Cr 2               cg_globals:
00006Cr 2  xx xx                .RES    2               ; $6C-$6D  next available global variable offset
00006Er 2               scope_depth:
00006Er 2  xx                   .RES    1               ; $6E      current lexical nesting depth (0=global)
00006Fr 2               sym_chain:
00006Fr 2  xx xx                .RES    2               ; $6F-$70  pointer into symbol table chain
000071r 2               
000071r 2               ; FCB pointers (compiler I/O)
000071r 2               src_fcb:
000071r 2  xx xx                .RES    2               ; $71-$72  pointer to source FCB
000073r 2               out_fcb:
000073r 2  xx xx                .RES    2               ; $73-$74  pointer to output FCB
000075r 2               src_buf_pos:
000075r 2  xx                   .RES    1               ; $75      position within 128-byte sector buffer
000076r 2               src_buf_end:
000076r 2  xx                   .RES    1               ; $76      bytes valid in sector buffer
000077r 2               
000077r 2               ; FOR-loop scratch (parse_for; not nestable)
000077r 2               for_loop_top:
000077r 2  xx xx                .RES    2               ; $77-$78  cg_pc of loop test (back-jump target)
000079r 2               for_patch:
000079r 2  xx xx                .RES    2               ; $79-$7A  FJP exit patch address
00007Br 2               
00007Br 2               ; Result type of the most recently parsed expression (TY_INT/TY_CHAR/
00007Br 2               ; TY_BOOL/TY_STRING/etc.).  Used by parse_write_args to dispatch the
00007Br 2               ; right WRIT* opcode.  Set by parse_factor / parse_simple_expr /
00007Br 2               ; parse_expression as each rule produces its result.
00007Br 2               expr_type:
00007Br 2  xx                   .RES    1               ; $7B
00007Cr 2               
00007Cr 1               
00007Cr 1               ; ---------------------------------------------------------------------------
00007Cr 1               ; FCBs and file buffers
00007Cr 1               ; ---------------------------------------------------------------------------
00007Cr 1                       .segment        "CPMDATA"
000000r 1               
000000r 1               comp_src_fcb:
000000r 1  xx xx xx xx          .RES    36              ; source file FCB (.PAS)
000004r 1  xx xx xx xx  
000008r 1  xx xx xx xx  
000024r 1               comp_out_fcb:
000024r 1  xx xx xx xx          .RES    36              ; output file FCB (.PCD)
000028r 1  xx xx xx xx  
00002Cr 1  xx xx xx xx  
000048r 1               
000048r 1               ; 128-byte sector buffer for source reads
000048r 1               src_sector:
000048r 1  xx xx xx xx          .RES    128
00004Cr 1  xx xx xx xx  
000050r 1  xx xx xx xx  
0000C8r 1               
0000C8r 1               ; Comma-list buffer for parse_var_decls — collects names "A, B, C" before
0000C8r 1               ; the type is known so each can be added to the symbol table with the
0000C8r 1               ; same type code.  8 slots × 16 bytes; excess names are silently dropped.
0000C8r 1               var_name_count:
0000C8r 1  xx                   .RES    1
0000C9r 1               var_name_buf:
0000C9r 1  xx xx xx xx          .RES    128
0000CDr 1  xx xx xx xx  
0000D1r 1  xx xx xx xx  
000149r 1               
000149r 1               ; Field table for RECORD types.  32 entries × 16 bytes each:
000149r 1               ;   [0]    field name length (1-12)
000149r 1               ;   [1-12] field name chars (uppercase, padded with spaces)
000149r 1               ;   [13]   byte offset within the record
000149r 1               ;   [14]   field data type (TY_INT/TY_CHAR/TY_BOOL)
000149r 1               ;   [15]   reserved
000149r 1               field_table_count:
000149r 1  xx                   .RES    1
00014Ar 1               field_table:
00014Ar 1  xx xx xx xx          .RES    512             ; 32 entries × 16 bytes
00014Er 1  xx xx xx xx  
000152r 1  xx xx xx xx  
00034Ar 1               
00034Ar 1               ; Per-field "nested" metadata, parallel to field_table.  Only meaningful
00034Ar 1               ; when the field's type is TY_RECORD: holds the nested record's
00034Ar 1               ; first_field index and field count so chained access (`a.outer.inner`)
00034Ar 1               ; can traverse into the inner record.  Anonymous and named nested
00034Ar 1               ; records are both supported here.
00034Ar 1               field_nested_first:
00034Ar 1  xx xx xx xx          .RES    32
00034Er 1  xx xx xx xx  
000352r 1  xx xx xx xx  
00036Ar 1               field_nested_count:
00036Ar 1  xx xx xx xx          .RES    32
00036Er 1  xx xx xx xx  
000372r 1  xx xx xx xx  
00038Ar 1               
00038Ar 1               ; Separate buffer for collecting field names inside a RECORD declaration.
00038Ar 1               ; Distinct from var_name_buf so inline `VAR x: RECORD ... END` doesn't
00038Ar 1               ; lose the outer "x" while the field group is being parsed. Each active
00038Ar 1               ; RECORD nesting depth gets its own slice so an inner anonymous RECORD
00038Ar 1               ; doesn't overwrite the outer field names that still need to be added.
00038Ar 1               FIELD_NAME_DEPTHS = 8
00038Ar 1               field_name_count:
00038Ar 1  xx xx xx xx          .RES    FIELD_NAME_DEPTHS
00038Er 1  xx xx xx xx  
000392r 1               field_name_buf:
000392r 1  xx xx xx xx          .RES    128 * FIELD_NAME_DEPTHS
000396r 1  xx xx xx xx  
00039Ar 1  xx xx xx xx  
000792r 1               
000792r 1               ; Scratch slots used by @rec_addf to remember the most recently-parsed
000792r 1               ; field's nested-record metadata.  Populated by the wrapper around the
000792r 1               ; recursive parse_type_spec call when the field type is TY_RECORD.
000792r 1               nest_save_first:
000792r 1  xx                   .RES    1
000793r 1               nest_save_count:
000793r 1  xx                   .RES    1
000794r 1               nest_save_size:
000794r 1  xx xx                .RES    2
000796r 1               
000796r 1               ; Nesting depth tracked by parse_type_spec @rec_loop. 0 = outside any
000796r 1               ; RECORD; bumped on entry, decremented on exit. Stored into byte 15 of
000796r 1               ; each field_table entry by field_table_add so field_lookup_in_record
000796r 1               ; can skip slots that belong to a deeper inline record. Without this
000796r 1               ; an outer record whose later fields follow an inline RECORD would
000796r 1               ; have an interleaved layout that count-based scan can't navigate.
000796r 1               field_depth:
000796r 1  xx                   .RES    1
000797r 1               field_lookup_depth:
000797r 1  xx                   .RES    1
000798r 1               
000798r 1               ; Active WITH contexts. Each entry stores a hidden global word that holds
000798r 1               ; the selected record's runtime base address, plus that record's first-field
000798r 1               ; index/count so unqualified identifiers can resolve as fields.
000798r 1               WITH_DEPTHS = 8
000798r 1               with_depth:
000798r 1  xx                   .RES    1
000799r 1               with_base_lo:
000799r 1  xx xx xx xx          .RES    WITH_DEPTHS
00079Dr 1  xx xx xx xx  
0007A1r 1               with_base_hi:
0007A1r 1  xx xx xx xx          .RES    WITH_DEPTHS
0007A5r 1  xx xx xx xx  
0007A9r 1               with_first_field:
0007A9r 1  xx xx xx xx          .RES    WITH_DEPTHS
0007ADr 1  xx xx xx xx  
0007B1r 1               with_field_count:
0007B1r 1  xx xx xx xx          .RES    WITH_DEPTHS
0007B5r 1  xx xx xx xx  
0007B9r 1               
0007B9r 1               ; Record-valued expressions leave an address on the stack and publish the
0007B9r 1               ; matching field-table span here so WITH selectors can reuse it.
0007B9r 1               expr_record_first:
0007B9r 1  xx                   .RES    1
0007BAr 1               expr_record_count:
0007BAr 1  xx                   .RES    1
0007BBr 1               
0007BBr 1               ; Scratch filled by with_lookup_field before parse_with_field_{load,assign}.
0007BBr 1               with_lookup_off:
0007BBr 1  xx                   .RES    1
0007BCr 1               with_lookup_type:
0007BCr 1  xx                   .RES    1
0007BDr 1               with_lookup_base_lo:
0007BDr 1  xx                   .RES    1
0007BEr 1               with_lookup_base_hi:
0007BEr 1  xx                   .RES    1
0007BFr 1               with_lookup_first:
0007BFr 1  xx                   .RES    1
0007C0r 1               with_lookup_count:
0007C0r 1  xx                   .RES    1
0007C1r 1               
0007C1r 1               ; Top-level source mode: 0=plain program, 1=UNIT interface, 2=UNIT
0007C1r 1               ; implementation. Used so interface routine headings can be rebound to
0007C1r 1               ; their later implementation bodies without creating duplicate globals.
0007C1r 1               unit_section:
0007C1r 1  xx                   .RES    1
0007C2r 1               unit_import_mode:
0007C2r 1  xx                   .RES    1               ; 0=standalone source, nonzero=USES-import nesting depth
0007C3r 1               
0007C3r 1               ; Names collected from a single top-level USES clause. Separate from
0007C3r 1               ; var_name_buf because imported unit compilation reuses var_name_buf.
0007C3r 1               USES_NAME_SLOTS = 8
0007C3r 1               uses_name_count:
0007C3r 1  xx                   .RES    1
0007C4r 1               uses_name_buf:
0007C4r 1  xx xx xx xx          .RES    16 * USES_NAME_SLOTS
0007C8r 1  xx xx xx xx  
0007CCr 1  xx xx xx xx  
000844r 1               
000844r 1               ; Imported-unit de-duplication table. Names are stored in uppercase
000844r 1               ; ident_buf layout (length byte + 15 chars) so nested/repeated USES
000844r 1               ; clauses compile a unit at most once.
000844r 1               USED_UNIT_SLOTS = 8
000844r 1               used_unit_count:
000844r 1  xx                   .RES    1
000845r 1               used_unit_buf:
000845r 1  xx xx xx xx          .RES    16 * USED_UNIT_SLOTS
000849r 1  xx xx xx xx  
00084Dr 1  xx xx xx xx  
0008C5r 1               
0008C5r 1               ; Source-context stack for nested USES imports. Each entry saves the
0008C5r 1               ; current source FCB, buffered DMA sector, and lexer position so the
0008C5r 1               ; compiler can suspend one file, compile another, then resume cleanly.
0008C5r 1               SRC_CTX_DEPTHS = 4
0008C5r 1               src_ctx_depth:
0008C5r 1  xx                   .RES    1
0008C6r 1               src_ctx_buf_pos:
0008C6r 1  xx xx xx xx          .RES    SRC_CTX_DEPTHS
0008CAr 1               src_ctx_buf_end:
0008CAr 1  xx xx xx xx          .RES    SRC_CTX_DEPTHS
0008CEr 1               src_ctx_line_lo:
0008CEr 1  xx xx xx xx          .RES    SRC_CTX_DEPTHS
0008D2r 1               src_ctx_line_hi:
0008D2r 1  xx xx xx xx          .RES    SRC_CTX_DEPTHS
0008D6r 1               src_ctx_col:
0008D6r 1  xx xx xx xx          .RES    SRC_CTX_DEPTHS
0008DAr 1               src_ctx_char:
0008DAr 1  xx xx xx xx          .RES    SRC_CTX_DEPTHS
0008DEr 1               src_ctx_fcb:
0008DEr 1  xx xx xx xx          .RES    36 * SRC_CTX_DEPTHS
0008E2r 1  xx xx xx xx  
0008E6r 1  xx xx xx xx  
00096Er 1               src_ctx_dma:
00096Er 1  xx xx xx xx          .RES    128 * SRC_CTX_DEPTHS
000972r 1  xx xx xx xx  
000976r 1  xx xx xx xx  
000B6Er 1               
000B6Er 1               ; Code generation buffer — p-code accumulates here until file write.
000B6Er 1               ; Keep this above the live CPMDATA working set used by the parser.
000B6Er 1               ; This holds up to ~32KB of generated p-code.
000B6Er 1               CODEBUF_BASE    = $4900
000B6Er 1               CODEBUF_MAXSZ   = $8000         ; 32 KB
000B6Er 1               
000B6Er 1               ; Symbol table area
000B6Er 1               SYMTAB_BASE     = $8000
000B6Er 1               SYMTAB_MAXSZ    = $1800         ; 6 KB (≈200 entries at ~30 bytes each)
000B6Er 1               
000B6Er 1               ; String pool for identifier strings and string literals
000B6Er 1               STRPOOL_BASE    = $9800
000B6Er 1               STRPOOL_MAXSZ   = $0800         ; 2 KB
000B6Er 1               
000B6Er 1               ; ---------------------------------------------------------------------------
000B6Er 1               ; Entry point
000B6Er 1               ; ---------------------------------------------------------------------------
000B6Er 1                       .segment        "TEA"
000000r 1               
000000r 1  4C rr rr             JMP     pascal_main
000003r 1               
000003r 1                       .segment        "CODE"
000000r 1               
000000r 1               pascal_main:
000000r 1               ; print banner
000000r 1  A9 rr                LDA     #<msg_banner
000002r 1  85 rr                STA     tmp0
000004r 1  A9 rr                LDA     #>msg_banner
000006r 1  85 rr                STA     tmp0+1
000008r 1  20 rr rr             JSR     console_print_sz
00000Br 1               
00000Br 1               ; build source FCB from DEFAULT_FCB ($0107) argument
00000Br 1  20 rr rr             JSR     build_src_fcb
00000Er 1  90 03                BCC     :+
000010r 1  4C rr rr             JMP     @no_file
000013r 1               :
000013r 1               ; print "Compiling: <name>"
000013r 1  A9 rr                LDA     #<msg_compiling
000015r 1  85 rr                STA     tmp0
000017r 1  A9 rr                LDA     #>msg_compiling
000019r 1  85 rr                STA     tmp0+1
00001Br 1  20 rr rr             JSR     console_print_sz
00001Er 1               
00001Er 1               ; open source file
00001Er 1  A9 rr                LDA     #<comp_src_fcb
000020r 1  85 rr                STA     src_fcb
000022r 1  A9 rr                LDA     #>comp_src_fcb
000024r 1  85 rr                STA     src_fcb+1
000026r 1  A9 rr                LDA     #<comp_src_fcb
000028r 1  85 rr                STA     tmp1
00002Ar 1  A9 rr                LDA     #>comp_src_fcb
00002Cr 1  85 rr                STA     tmp1+1
00002Er 1  20 rr rr             JSR     file_open
000031r 1  C9 FF                CMP     #$FF            ; PEM open: $FF=not found, 0-3=dir entry
000033r 1  D0 03                BNE     :+
000035r 1  4C rr rr             JMP     @no_file
000038r 1               :
000038r 1               
000038r 1               ; create output .PCD file
000038r 1  20 rr rr             JSR     build_out_fcb
00003Br 1  A9 rr                LDA     #<comp_out_fcb
00003Dr 1  85 rr                STA     tmp1
00003Fr 1  A9 rr                LDA     #>comp_out_fcb
000041r 1  85 rr                STA     tmp1+1
000043r 1  20 rr rr             JSR     file_make
000046r 1  C9 FF                CMP     #$FF            ; PEM make: $FF=dir full, 0-3=dir entry
000048r 1  D0 03                BNE     :+
00004Ar 1  4C rr rr             JMP     @out_err
00004Dr 1               :
00004Dr 1               
00004Dr 1               ; initialise compiler state
00004Dr 1  20 rr rr             JSR     compiler_init
000050r 1               
000050r 1               ; run compilation
000050r 1  20 rr rr             JSR     compile_program
000053r 1               
000053r 1               ; write .PCD file
000053r 1  20 rr rr             JSR     write_pcd
000056r 1               
000056r 1               ; close files
000056r 1  A9 rr                LDA     #<comp_src_fcb
000058r 1  85 rr                STA     tmp1
00005Ar 1  A9 rr                LDA     #>comp_src_fcb
00005Cr 1  85 rr                STA     tmp1+1
00005Er 1  20 rr rr             JSR     file_close
000061r 1  A9 rr                LDA     #<comp_out_fcb
000063r 1  85 rr                STA     tmp1
000065r 1  A9 rr                LDA     #>comp_out_fcb
000067r 1  85 rr                STA     tmp1+1
000069r 1  20 rr rr             JSR     file_close
00006Cr 1               
00006Cr 1               ; print result
00006Cr 1  AD rr rr             LDA     error_count
00006Fr 1  0D rr rr             ORA     error_count+1
000072r 1  D0 0E                BNE     @had_errors
000074r 1  A9 rr                LDA     #<msg_ok
000076r 1  85 rr                STA     tmp0
000078r 1  A9 rr                LDA     #>msg_ok
00007Ar 1  85 rr                STA     tmp0+1
00007Cr 1  20 rr rr             JSR     console_print_sz
00007Fr 1  4C 00 01             JMP     WARM_BOOT
000082r 1               
000082r 1               @had_errors:
000082r 1  AD rr rr             LDA     error_count
000085r 1  85 rr                STA     tmp0
000087r 1  AD rr rr             LDA     error_count+1
00008Ar 1  85 rr                STA     tmp0+1
00008Cr 1  20 rr rr             JSR     console_print_dec
00008Fr 1  A9 rr                LDA     #<msg_errors
000091r 1  85 rr                STA     tmp0
000093r 1  A9 rr                LDA     #>msg_errors
000095r 1  85 rr                STA     tmp0+1
000097r 1  20 rr rr             JSR     console_print_sz
00009Ar 1  4C 00 01             JMP     WARM_BOOT
00009Dr 1               
00009Dr 1               @no_file:
00009Dr 1  A9 rr                LDA     #<err_nofile
00009Fr 1  85 rr                STA     tmp0
0000A1r 1  A9 rr                LDA     #>err_nofile
0000A3r 1  85 rr                STA     tmp0+1
0000A5r 1  20 rr rr             JSR     console_print_sz
0000A8r 1  4C 00 01             JMP     WARM_BOOT
0000ABr 1               
0000ABr 1               @out_err:
0000ABr 1  A9 rr                LDA     #<err_outfile
0000ADr 1  85 rr                STA     tmp0
0000AFr 1  A9 rr                LDA     #>err_outfile
0000B1r 1  85 rr                STA     tmp0+1
0000B3r 1  20 rr rr             JSR     console_print_sz
0000B6r 1  4C 00 01             JMP     WARM_BOOT
0000B9r 1               
0000B9r 1               ; ---------------------------------------------------------------------------
0000B9r 1               ; build_src_fcb — populate comp_src_fcb from DEFAULT_FCB ($0107), force ".PAS"
0000B9r 1               ; DOS/65 CCM copies the parsed argument FCB to dflfcb=$0107, not $005C.
0000B9r 1               ; Returns: carry clear = ok, carry set = no filename
0000B9r 1               ; ---------------------------------------------------------------------------
0000B9r 1               build_src_fcb:
0000B9r 1  A2 00                LDX     #0
0000BBr 1               @copy:
0000BBr 1  BD 07 01             LDA     DEFAULT_FCB,x
0000BEr 1  9D rr rr             STA     comp_src_fcb,x
0000C1r 1  E8                   INX
0000C2r 1  E0 0C                CPX     #12
0000C4r 1  90 F5                BCC     @copy
0000C6r 1  A9 00                LDA     #0
0000C8r 1               @zero:
0000C8r 1  9D rr rr             STA     comp_src_fcb,x
0000CBr 1  E8                   INX
0000CCr 1  E0 24                CPX     #36
0000CEr 1  90 F8                BCC     @zero
0000D0r 1  AD rr rr             LDA     comp_src_fcb+1
0000D3r 1  C9 20                CMP     #' '
0000D5r 1  F0 11                BEQ     @noname
0000D7r 1  A9 50                LDA     #'P'
0000D9r 1  8D rr rr             STA     comp_src_fcb+9
0000DCr 1  A9 41                LDA     #'A'
0000DEr 1  8D rr rr             STA     comp_src_fcb+10
0000E1r 1  A9 53                LDA     #'S'
0000E3r 1  8D rr rr             STA     comp_src_fcb+11
0000E6r 1  18                   CLC
0000E7r 1  60                   RTS
0000E8r 1               @noname:
0000E8r 1  38                   SEC
0000E9r 1  60                   RTS
0000EAr 1               
0000EAr 1               ; ---------------------------------------------------------------------------
0000EAr 1               ; build_out_fcb — copy filename from comp_src_fcb, change extension to "PCD"
0000EAr 1               ; ---------------------------------------------------------------------------
0000EAr 1               build_out_fcb:
0000EAr 1  A2 00                LDX     #0
0000ECr 1               @copy:
0000ECr 1  BD rr rr             LDA     comp_src_fcb,x
0000EFr 1  9D rr rr             STA     comp_out_fcb,x
0000F2r 1  E8                   INX
0000F3r 1  E0 24                CPX     #36
0000F5r 1  90 F5                BCC     @copy
0000F7r 1  A9 50                LDA     #'P'
0000F9r 1  8D rr rr             STA     comp_out_fcb+9
0000FCr 1  A9 43                LDA     #'C'
0000FEr 1  8D rr rr             STA     comp_out_fcb+10
000101r 1  A9 44                LDA     #'D'
000103r 1  8D rr rr             STA     comp_out_fcb+11
000106r 1  60                   RTS
000107r 1               
000107r 1               ; ---------------------------------------------------------------------------
000107r 1               ; build_named_src_fcb — populate comp_src_fcb from ident_buf, force ".PAS"
000107r 1               ; The identifier is uppercased already by the lexer. Names longer than 8
000107r 1               ; chars are truncated to fit the FCB filename field.
000107r 1               ; Returns: carry clear = ok, carry set = empty name
000107r 1               ; ---------------------------------------------------------------------------
000107r 1               build_named_src_fcb:
000107r 1  AD rr rr             LDA     ident_buf
00010Ar 1  D0 02                BNE     :+
00010Cr 1  38                   SEC
00010Dr 1  60                   RTS
00010Er 1  A2 00        :       LDX     #0
000110r 1  A9 00                LDA     #0
000112r 1               @zero:
000112r 1  9D rr rr             STA     comp_src_fcb,x
000115r 1  E8                   INX
000116r 1  E0 24                CPX     #36
000118r 1  90 F8                BCC     @zero
00011Ar 1  A2 01                LDX     #1
00011Cr 1  A9 20                LDA     #' '
00011Er 1               @pad_name:
00011Er 1  9D rr rr             STA     comp_src_fcb,x
000121r 1  E8                   INX
000122r 1  E0 0C                CPX     #12
000124r 1  90 F8                BCC     @pad_name
000126r 1  A2 00                LDX     #0
000128r 1               @copy_name:
000128r 1  EC rr rr             CPX     ident_buf
00012Br 1  B0 0D                BCS     @set_ext
00012Dr 1  E0 08                CPX     #8
00012Fr 1  B0 09                BCS     @set_ext
000131r 1  BD rr rr             LDA     ident_buf+1,x
000134r 1  9D rr rr             STA     comp_src_fcb+1,x
000137r 1  E8                   INX
000138r 1  80 EE                BRA     @copy_name
00013Ar 1               @set_ext:
00013Ar 1  A9 50                LDA     #'P'
00013Cr 1  8D rr rr             STA     comp_src_fcb+9
00013Fr 1  A9 41                LDA     #'A'
000141r 1  8D rr rr             STA     comp_src_fcb+10
000144r 1  A9 53                LDA     #'S'
000146r 1  8D rr rr             STA     comp_src_fcb+11
000149r 1  18                   CLC
00014Ar 1  60                   RTS
00014Br 1               
00014Br 1               ; source_ctx_fcb_ptr — A=stack index, returns tmp0 -> saved FCB slot
00014Br 1               source_ctx_fcb_ptr:
00014Br 1  85 rr                STA     scratch
00014Dr 1  A9 rr                LDA     #<src_ctx_fcb
00014Fr 1  85 rr                STA     tmp0
000151r 1  A9 rr                LDA     #>src_ctx_fcb
000153r 1  85 rr                STA     tmp0+1
000155r 1               @scfp_loop:
000155r 1  A5 rr                LDA     scratch
000157r 1  F0 0F                BEQ     @scfp_done
000159r 1  18                   CLC
00015Ar 1  A5 rr                LDA     tmp0
00015Cr 1  69 24                ADC     #36
00015Er 1  85 rr                STA     tmp0
000160r 1  90 02                BCC     :+
000162r 1  E6 rr                INC     tmp0+1
000164r 1  C6 rr        :       DEC     scratch
000166r 1  80 ED                BRA     @scfp_loop
000168r 1               @scfp_done:
000168r 1  60                   RTS
000169r 1               
000169r 1               ; source_ctx_dma_ptr — A=stack index, returns tmp0 -> saved DMA slot
000169r 1               source_ctx_dma_ptr:
000169r 1  85 rr                STA     scratch
00016Br 1  A9 rr                LDA     #<src_ctx_dma
00016Dr 1  85 rr                STA     tmp0
00016Fr 1  A9 rr                LDA     #>src_ctx_dma
000171r 1  85 rr                STA     tmp0+1
000173r 1               @scdp_loop:
000173r 1  A5 rr                LDA     scratch
000175r 1  F0 0F                BEQ     @scdp_done
000177r 1  18                   CLC
000178r 1  A5 rr                LDA     tmp0
00017Ar 1  69 80                ADC     #$80
00017Cr 1  85 rr                STA     tmp0
00017Er 1  90 02                BCC     :+
000180r 1  E6 rr                INC     tmp0+1
000182r 1  C6 rr        :       DEC     scratch
000184r 1  80 ED                BRA     @scdp_loop
000186r 1               @scdp_done:
000186r 1  60                   RTS
000187r 1               
000187r 1               ; ---------------------------------------------------------------------------
000187r 1               ; source_push_current / source_pop_current — save and restore the active
000187r 1               ; source-file context around USES-imported unit compilation.
000187r 1               ; source_push_current returns carry set if the context stack is full.
000187r 1               ; ---------------------------------------------------------------------------
000187r 1               source_push_current:
000187r 1  AE rr rr             LDX     src_ctx_depth
00018Ar 1  E0 04                CPX     #SRC_CTX_DEPTHS
00018Cr 1  90 02                BCC     @spc_room
00018Er 1  38                   SEC
00018Fr 1  60                   RTS
000190r 1               @spc_room:
000190r 1  A5 rr                LDA     src_buf_pos
000192r 1  9D rr rr             STA     src_ctx_buf_pos,x
000195r 1  A5 rr                LDA     src_buf_end
000197r 1  9D rr rr             STA     src_ctx_buf_end,x
00019Ar 1  A5 rr                LDA     lex_line
00019Cr 1  9D rr rr             STA     src_ctx_line_lo,x
00019Fr 1  A5 rr                LDA     lex_line+1
0001A1r 1  9D rr rr             STA     src_ctx_line_hi,x
0001A4r 1  A5 rr                LDA     lex_col
0001A6r 1  9D rr rr             STA     src_ctx_col,x
0001A9r 1  A5 rr                LDA     lex_char
0001ABr 1  9D rr rr             STA     src_ctx_char,x
0001AEr 1  8A                   TXA
0001AFr 1  20 rr rr             JSR     source_ctx_fcb_ptr
0001B2r 1  A0 00                LDY     #0
0001B4r 1               @spc_fcb_copy:
0001B4r 1  B9 rr rr             LDA     comp_src_fcb,y
0001B7r 1  91 rr                STA     (tmp0),y
0001B9r 1  C8                   INY
0001BAr 1  C0 24                CPY     #36
0001BCr 1  90 F6                BCC     @spc_fcb_copy
0001BEr 1  8A                   TXA
0001BFr 1  20 rr rr             JSR     source_ctx_dma_ptr
0001C2r 1  A0 00                LDY     #0
0001C4r 1               @spc_dma_copy:
0001C4r 1  B9 28 01             LDA     DMA_BUF,y
0001C7r 1  91 rr                STA     (tmp0),y
0001C9r 1  C8                   INY
0001CAr 1  C0 80                CPY     #128
0001CCr 1  90 F6                BCC     @spc_dma_copy
0001CEr 1  EE rr rr             INC     src_ctx_depth
0001D1r 1  18                   CLC
0001D2r 1  60                   RTS
0001D3r 1               
0001D3r 1               source_pop_current:
0001D3r 1  AD rr rr             LDA     src_ctx_depth
0001D6r 1  F0 4C                BEQ     @spop_done
0001D8r 1  CE rr rr             DEC     src_ctx_depth
0001DBr 1  AE rr rr             LDX     src_ctx_depth
0001DEr 1  BD rr rr             LDA     src_ctx_buf_pos,x
0001E1r 1  85 rr                STA     src_buf_pos
0001E3r 1  BD rr rr             LDA     src_ctx_buf_end,x
0001E6r 1  85 rr                STA     src_buf_end
0001E8r 1  BD rr rr             LDA     src_ctx_line_lo,x
0001EBr 1  85 rr                STA     lex_line
0001EDr 1  BD rr rr             LDA     src_ctx_line_hi,x
0001F0r 1  85 rr                STA     lex_line+1
0001F2r 1  BD rr rr             LDA     src_ctx_col,x
0001F5r 1  85 rr                STA     lex_col
0001F7r 1  BD rr rr             LDA     src_ctx_char,x
0001FAr 1  85 rr                STA     lex_char
0001FCr 1  8A                   TXA
0001FDr 1  20 rr rr             JSR     source_ctx_fcb_ptr
000200r 1  A0 00                LDY     #0
000202r 1               @spop_fcb_copy:
000202r 1  B1 rr                LDA     (tmp0),y
000204r 1  99 rr rr             STA     comp_src_fcb,y
000207r 1  C8                   INY
000208r 1  C0 24                CPY     #36
00020Ar 1  90 F6                BCC     @spop_fcb_copy
00020Cr 1  8A                   TXA
00020Dr 1  20 rr rr             JSR     source_ctx_dma_ptr
000210r 1  A0 00                LDY     #0
000212r 1               @spop_dma_copy:
000212r 1  B1 rr                LDA     (tmp0),y
000214r 1  99 28 01             STA     DMA_BUF,y
000217r 1  C8                   INY
000218r 1  C0 80                CPY     #128
00021Ar 1  90 F6                BCC     @spop_dma_copy
00021Cr 1  A9 rr                LDA     #<comp_src_fcb
00021Er 1  85 rr                STA     src_fcb
000220r 1  A9 rr                LDA     #>comp_src_fcb
000222r 1  85 rr                STA     src_fcb+1
000224r 1               @spop_done:
000224r 1  60                   RTS
000225r 1               
000225r 1               ; ---------------------------------------------------------------------------
000225r 1               ; compiler_init — zero-out compiler state
000225r 1               ; ---------------------------------------------------------------------------
000225r 1               error_count:
000225r 1  00 00                .WORD   0
000227r 1               
000227r 1               compiler_init:
000227r 1  A9 00                LDA     #0
000229r 1  8D rr rr             STA     error_count
00022Cr 1  8D rr rr             STA     error_count+1
00022Fr 1               ; IPC starts at 0 (offset into code buffer)
00022Fr 1  85 rr                STA     cg_pc
000231r 1  85 rr                STA     cg_pc+1
000233r 1               ; globals start at 0
000233r 1  85 rr                STA     cg_globals
000235r 1  85 rr                STA     cg_globals+1
000237r 1               ; scope depth 0 = global
000237r 1  85 rr                STA     scope_depth
000239r 1  8D rr rr             STA     with_depth
00023Cr 1  8D rr rr             STA     expr_record_first
00023Fr 1  8D rr rr             STA     expr_record_count
000242r 1  8D rr rr             STA     unit_section
000245r 1  8D rr rr             STA     unit_import_mode
000248r 1  8D rr rr             STA     uses_name_count
00024Br 1  8D rr rr             STA     used_unit_count
00024Er 1  8D rr rr             STA     src_ctx_depth
000251r 1               ; main entry-point patch slot — sentinel hi byte = $FF means "none/done"
000251r 1  A9 FF                LDA     #$FF
000253r 1  8D rr rr             STA     main_jmp_patch+1
000256r 1  8D rr rr             STA     body_chain_patch+1
000259r 1               ; init lexer and prime first token
000259r 1  20 rr rr             JSR     lexer_init
00025Cr 1  20 rr rr             JSR     next_token
00025Fr 1  60                   RTS
000260r 1               
000260r 1               ; ---------------------------------------------------------------------------
000260r 1               ; compile_error — print error with line/col; increment error_count
000260r 1               ; tmp0 = pointer to error string
000260r 1               ; ---------------------------------------------------------------------------
000260r 1               compile_error:
000260r 1               ; save caller's message pointer (tmp0) into tmp3
000260r 1  A5 rr                LDA     tmp0
000262r 1  85 rr                STA     tmp3
000264r 1  A5 rr                LDA     tmp0+1
000266r 1  85 rr                STA     tmp3+1
000268r 1               ; print "Line "
000268r 1  A9 rr                LDA     #<msg_line
00026Ar 1  85 rr                STA     tmp0
00026Cr 1  A9 rr                LDA     #>msg_line
00026Er 1  85 rr                STA     tmp0+1
000270r 1  20 rr rr             JSR     console_print_sz
000273r 1               ; print line number
000273r 1  A5 rr                LDA     lex_line
000275r 1  85 rr                STA     tmp0
000277r 1  A5 rr                LDA     lex_line+1
000279r 1  85 rr                STA     tmp0+1
00027Br 1  20 rr rr             JSR     console_print_dec
00027Er 1               ; print ": "
00027Er 1  A9 3A                LDA     #':'
000280r 1  A2 02                LDX     #PEM_CONOUT
000282r 1  20 03 01             JSR     PEM_ENTRY
000285r 1  A9 20                LDA     #' '
000287r 1  A2 02                LDX     #PEM_CONOUT
000289r 1  20 03 01             JSR     PEM_ENTRY
00028Cr 1               ; print the error message text
00028Cr 1  A5 rr                LDA     tmp3
00028Er 1  85 rr                STA     tmp0
000290r 1  A5 rr                LDA     tmp3+1
000292r 1  85 rr                STA     tmp0+1
000294r 1  20 rr rr             JSR     console_print_sz
000297r 1  20 rr rr             JSR     console_newline
00029Ar 1               ; increment error count
00029Ar 1  EE rr rr             INC     error_count
00029Dr 1  D0 03                BNE     :+
00029Fr 1  EE rr rr             INC     error_count+1
0002A2r 1               :
0002A2r 1  60                   RTS
0002A3r 1               
0002A3r 1               ; ---------------------------------------------------------------------------
0002A3r 1               ; write_pcd — write .PCD header + entire code buffer to output file
0002A3r 1               ;   Sector 0:        12-byte header  + first 116 bytes of code  (padded)
0002A3r 1               ;   Sectors 1..N-1:  128 bytes of code each                     (last padded)
0002A3r 1               ;
0002A3r 1               ; Uses tmp0 = source pointer (into CODEBUF_BASE),
0002A3r 1               ;      tmp3 = bytes remaining to write,
0002A3r 1               ;      tmp1 = FCB pointer (re-loaded before each file_write_sector).
0002A3r 1               ; ---------------------------------------------------------------------------
0002A3r 1               write_pcd:
0002A3r 1               ; --- src_ptr = CODEBUF_BASE; remaining = cg_pc ---
0002A3r 1  A9 00                LDA     #<CODEBUF_BASE
0002A5r 1  85 rr                STA     tmp0
0002A7r 1  A9 49                LDA     #>CODEBUF_BASE
0002A9r 1  85 rr                STA     tmp0+1
0002ABr 1  A5 rr                LDA     cg_pc
0002ADr 1  85 rr                STA     tmp3
0002AFr 1  A5 rr                LDA     cg_pc+1
0002B1r 1  85 rr                STA     tmp3+1
0002B3r 1               
0002B3r 1               ; --- header bytes 0..11 directly into DMA_BUF ---
0002B3r 1  A9 50                LDA     #PCD_MAGIC_0
0002B5r 1  8D 28 01             STA     DMA_BUF+0
0002B8r 1  A9 43                LDA     #PCD_MAGIC_1
0002BAr 1  8D 29 01             STA     DMA_BUF+1
0002BDr 1  A9 01                LDA     #PCD_VERSION
0002BFr 1  8D 2A 01             STA     DMA_BUF+2
0002C2r 1  A9 00                LDA     #0
0002C4r 1  8D 2B 01             STA     DMA_BUF+3
0002C7r 1  A5 rr                LDA     cg_pc
0002C9r 1  8D 2C 01             STA     DMA_BUF+PCD_CODESZ
0002CCr 1  A5 rr                LDA     cg_pc+1
0002CEr 1  8D 2D 01             STA     DMA_BUF+PCD_CODESZ+1
0002D1r 1  A5 rr                LDA     cg_globals
0002D3r 1  8D 2E 01             STA     DMA_BUF+PCD_GLOBSZ
0002D6r 1  A5 rr                LDA     cg_globals+1
0002D8r 1  8D 2F 01             STA     DMA_BUF+PCD_GLOBSZ+1
0002DBr 1  A9 00                LDA     #0
0002DDr 1  8D 30 01             STA     DMA_BUF+PCD_STRSZ
0002E0r 1  8D 31 01             STA     DMA_BUF+PCD_STRSZ+1
0002E3r 1  8D 32 01             STA     DMA_BUF+PCD_ENTRY
0002E6r 1  8D 33 01             STA     DMA_BUF+PCD_ENTRY+1
0002E9r 1               
0002E9r 1               ; --- first sector: copy code into DMA_BUF[12..127] ---
0002E9r 1  A0 00                LDY     #0              ; src offset within this batch
0002EBr 1  A2 0C                LDX     #PCD_HEADER_SZ  ; dest offset in DMA
0002EDr 1               @fill1:
0002EDr 1  E0 80                CPX     #128
0002EFr 1  B0 23                BCS     @write1
0002F1r 1  A5 rr                LDA     tmp3
0002F3r 1  05 rr                ORA     tmp3+1
0002F5r 1  F0 11                BEQ     @pad1
0002F7r 1  B1 rr                LDA     (tmp0),y
0002F9r 1  9D 28 01             STA     DMA_BUF,x
0002FCr 1  E8                   INX
0002FDr 1  C8                   INY
0002FEr 1               ; remaining--
0002FEr 1  A5 rr                LDA     tmp3
000300r 1  D0 02                BNE     :+
000302r 1  C6 rr                DEC     tmp3+1
000304r 1               :
000304r 1  C6 rr                DEC     tmp3
000306r 1  80 E5                BRA     @fill1
000308r 1               @pad1:
000308r 1  E0 80                CPX     #128
00030Ar 1  B0 08                BCS     @write1
00030Cr 1  A9 00                LDA     #0
00030Er 1  9D 28 01             STA     DMA_BUF,x
000311r 1  E8                   INX
000312r 1  80 F4                BRA     @pad1
000314r 1               @write1:
000314r 1               ; advance src by Y (bytes consumed from this batch)
000314r 1  84 rr                STY     scratch
000316r 1  18                   CLC
000317r 1  A5 rr                LDA     tmp0
000319r 1  65 rr                ADC     scratch
00031Br 1  85 rr                STA     tmp0
00031Dr 1  90 02                BCC     :+
00031Fr 1  E6 rr                INC     tmp0+1
000321r 1               :
000321r 1  A9 rr                LDA     #<comp_out_fcb
000323r 1  85 rr                STA     tmp1
000325r 1  A9 rr                LDA     #>comp_out_fcb
000327r 1  85 rr                STA     tmp1+1
000329r 1  20 rr rr             JSR     file_write_sector
00032Cr 1               
00032Cr 1               ; --- additional sectors (full 128 bytes each, last pad with 0) ---
00032Cr 1               @next_sec:
00032Cr 1  A5 rr                LDA     tmp3
00032Er 1  05 rr                ORA     tmp3+1
000330r 1  F0 42                BEQ     @done
000332r 1  A0 00                LDY     #0
000334r 1               @fill2:
000334r 1  C0 80                CPY     #128
000336r 1  B0 22                BCS     @write2
000338r 1  A5 rr                LDA     tmp3
00033Ar 1  05 rr                ORA     tmp3+1
00033Cr 1  F0 10                BEQ     @pad2
00033Er 1  B1 rr                LDA     (tmp0),y
000340r 1  99 28 01             STA     DMA_BUF,y
000343r 1  C8                   INY
000344r 1  A5 rr                LDA     tmp3
000346r 1  D0 02                BNE     :+
000348r 1  C6 rr                DEC     tmp3+1
00034Ar 1               :
00034Ar 1  C6 rr                DEC     tmp3
00034Cr 1  80 E6                BRA     @fill2
00034Er 1               @pad2:
00034Er 1  C0 80                CPY     #128
000350r 1  B0 08                BCS     @write2
000352r 1  A9 00                LDA     #0
000354r 1  99 28 01             STA     DMA_BUF,y
000357r 1  C8                   INY
000358r 1  80 F4                BRA     @pad2
00035Ar 1               @write2:
00035Ar 1               ; advance src by 128 (Y is the count copied from src this sector;
00035Ar 1               ; padded bytes at the tail are not source bytes, but remaining is
00035Ar 1               ; already 0 in that case and the loop will exit).
00035Ar 1  84 rr                STY     scratch
00035Cr 1  18                   CLC
00035Dr 1  A5 rr                LDA     tmp0
00035Fr 1  65 rr                ADC     scratch
000361r 1  85 rr                STA     tmp0
000363r 1  90 02                BCC     :+
000365r 1  E6 rr                INC     tmp0+1
000367r 1               :
000367r 1  A9 rr                LDA     #<comp_out_fcb
000369r 1  85 rr                STA     tmp1
00036Br 1  A9 rr                LDA     #>comp_out_fcb
00036Dr 1  85 rr                STA     tmp1+1
00036Fr 1  20 rr rr             JSR     file_write_sector
000372r 1  80 B8                BRA     @next_sec
000374r 1               @done:
000374r 1  60                   RTS
000375r 1               
000375r 1               ; ---------------------------------------------------------------------------
000375r 1               ; Include sub-modules (compiler phases)
000375r 1               ; ---------------------------------------------------------------------------
000375r 1                       .include        "LEXER.ASM"
000375r 2               .PC02
000375r 2               ; lexer.asm — Pascal tokenizer
000375r 2               ;
000375r 2               ; Reads source file through 128-byte sector buffer.
000375r 2               ; Produces token stream via next_token (sets tok_type + value vars in ZP).
000375r 2               
000375r 2               ; ---------------------------------------------------------------------------
000375r 2               ; Keyword table — each entry: length byte, ASCII chars, token code
000375r 2               ; Searched linearly; 18 keywords.
000375r 2               ; ---------------------------------------------------------------------------
000375r 2                       .segment        "CODE"
000375r 2               
000375r 2               keyword_table:
000375r 2               ; length, chars..., token
000375r 2  03 41 4E 44          .BYTE   3, "AND",       TOK_AND
000379r 2  40           
00037Ar 2  05 41 52 52          .BYTE   5, "ARRAY",     TOK_ARRAY
00037Er 2  41 59 41     
000381r 2  05 42 45 47          .BYTE   5, "BEGIN",     TOK_BEGIN
000385r 2  49 4E 42     
000388r 2  04 43 41 53          .BYTE   4, "CASE",      TOK_CASE
00038Cr 2  45 43        
00038Er 2  05 43 4F 4E          .BYTE   5, "CONST",     TOK_CONST
000392r 2  53 54 44     
000395r 2  03 44 49 56          .BYTE   3, "DIV",       TOK_DIV
000399r 2  45           
00039Ar 2  02 44 4F 46          .BYTE   2, "DO",        TOK_DO
00039Er 2  06 44 4F 57          .BYTE   6, "DOWNTO",    TOK_DOWNTO
0003A2r 2  4E 54 4F 47  
0003A6r 2  04 45 4C 53          .BYTE   4, "ELSE",      TOK_ELSE
0003AAr 2  45 48        
0003ACr 2  03 45 4E 44          .BYTE   3, "END",       TOK_END
0003B0r 2  49           
0003B1r 2  03 46 4F 52          .BYTE   3, "FOR",       TOK_FOR
0003B5r 2  4A           
0003B6r 2  08 46 55 4E          .BYTE   8, "FUNCTION",  TOK_FUNCTION
0003BAr 2  43 54 49 4F  
0003BEr 2  4E 4B        
0003C0r 2  02 49 46 4C          .BYTE   2, "IF",        TOK_IF
0003C4r 2  0E 49 4D 50          .BYTE   14, "IMPLEMENTATION", TOK_IMPLEMENTATION
0003C8r 2  4C 45 4D 45  
0003CCr 2  4E 54 41 54  
0003D4r 2  02 49 4E 4D          .BYTE   2, "IN",        TOK_IN
0003D8r 2  09 49 4E 54          .BYTE   9, "INTERFACE", TOK_INTERFACE
0003DCr 2  45 52 46 41  
0003E0r 2  43 45 60     
0003E3r 2  03 4D 4F 44          .BYTE   3, "MOD",       TOK_MOD_KW
0003E7r 2  4E           
0003E8r 2  03 4E 49 4C          .BYTE   3, "NIL",       TOK_NIL
0003ECr 2  4F           
0003EDr 2  03 4E 4F 54          .BYTE   3, "NOT",       TOK_NOT
0003F1r 2  50           
0003F2r 2  02 4F 46 51          .BYTE   2, "OF",        TOK_OF
0003F6r 2  02 4F 52 52          .BYTE   2, "OR",        TOK_OR
0003FAr 2  09 50 52 4F          .BYTE   9, "PROCEDURE", TOK_PROCEDURE
0003FEr 2  43 45 44 55  
000402r 2  52 45 53     
000405r 2  07 50 52 4F          .BYTE   7, "PROGRAM",   TOK_PROGRAM
000409r 2  47 52 41 4D  
00040Dr 2  54           
00040Er 2  06 52 45 43          .BYTE   6, "RECORD",    TOK_RECORD
000412r 2  4F 52 44 55  
000416r 2  06 52 45 50          .BYTE   6, "REPEAT",    TOK_REPEAT
00041Ar 2  45 41 54 56  
00041Er 2  03 53 45 54          .BYTE   3, "SET",       TOK_SET
000422r 2  57           
000423r 2  04 54 48 45          .BYTE   4, "THEN",      TOK_THEN
000427r 2  4E 58        
000429r 2  02 54 4F 59          .BYTE   2, "TO",        TOK_TO
00042Dr 2  04 54 59 50          .BYTE   4, "TYPE",      TOK_TYPE
000431r 2  45 5A        
000433r 2  04 55 4E 49          .BYTE   4, "UNIT",      TOK_UNIT
000437r 2  54 61        
000439r 2  05 55 4E 54          .BYTE   5, "UNTIL",     TOK_UNTIL
00043Dr 2  49 4C 5B     
000440r 2  04 55 53 45          .BYTE   4, "USES",      TOK_USES
000444r 2  53 62        
000446r 2  03 56 41 52          .BYTE   3, "VAR",       TOK_VAR
00044Ar 2  5C           
00044Br 2  05 57 48 49          .BYTE   5, "WHILE",     TOK_WHILE
00044Fr 2  4C 45 5D     
000452r 2  04 57 49 54          .BYTE   4, "WITH",      TOK_WITH
000456r 2  48 5E        
000458r 2  00                   .BYTE   0               ; sentinel
000459r 2               
000459r 2               ; Identifier buffer (max 63 chars + length byte at [0])
000459r 2               ident_buf:
000459r 2  xx xx xx xx          .RES    64
00045Dr 2  xx xx xx xx  
000461r 2  xx xx xx xx  
000499r 2               
000499r 2               ; Saved-name buffer for parser (e.g. var-decl name preservation across
000499r 2               ; parse_type_spec which clobbers ident_buf).
000499r 2               save_name_buf:
000499r 2  xx xx xx xx          .RES    16
00049Dr 2  xx xx xx xx  
0004A1r 2  xx xx xx xx  
0004A9r 2               
0004A9r 2               ; Saved symbol info — used by parse_assign_or_call to preserve symbol
0004A9r 2               ; entry fields across next_token + parse_expression, which clobber tmp3.
0004A9r 2               sym_save_kind:
0004A9r 2  xx                   .RES    1
0004AAr 2               sym_save_type:
0004AAr 2  xx                   .RES    1               ; SYM entry offset 17 (data type: TY_*)
0004ABr 2               sym_save_scope:
0004ABr 2  xx                   .RES    1
0004ACr 2               sym_save_off:
0004ACr 2  xx xx                .RES    2
0004AEr 2               sym_save_pcount:
0004AEr 2  xx                   .RES    1                       ; SYM_PROC param count (entry offset 21)
0004AFr 2               sym_save_vmask:
0004AFr 2  xx                   .RES    1               ; SYM_PROC/SYM_FUNC VAR-param bitmap (entry offset 22)
0004B0r 2               sym_save_lsize:
0004B0r 2  xx                   .RES    1               ; SYM_PROC/SYM_FUNC total local-area size (entry offset 23)
0004B1r 2               sym_param_types:
0004B1r 2  xx xx xx xx          .RES    8               ; formal parameter types 0..7 copied from entry bytes 24..31
0004B5r 2  xx xx xx xx  
0004B9r 2               
0004B9r 2               ; ARRAY type scratch — set by parse_type_spec when it parses an ARRAY type;
0004B9r 2               ; read by parse_var_decls to compute storage size and adjusted offset.
0004B9r 2               array_lo:
0004B9r 2  xx xx                .RES    2               ; lower bound (signed word)
0004BBr 2               array_hi:
0004BBr 2  xx xx                .RES    2               ; upper bound (signed word)
0004BDr 2               array_elem_ty:
0004BDr 2  xx                   .RES    1               ; element base type (TY_INT, TY_CHAR, TY_BOOL …)
0004BEr 2               
0004BEr 2               ; RECORD type scratch — set by parse_type_spec when it parses a RECORD type
0004BEr 2               ; (or resolves a TYPE alias of a RECORD).  Read by parse_var_decls and by
0004BEr 2               ; parse_type_decls to copy into the new SYM_VAR/SYM_TYPE entry.
0004BEr 2               record_size:
0004BEr 2  xx xx                .RES    2               ; total record size in bytes
0004C0r 2               record_first_field:
0004C0r 2  xx                   .RES    1               ; index of first field in field_table
0004C1r 2               record_field_count:
0004C1r 2  xx                   .RES    1               ; number of fields in this record
0004C2r 2               
0004C2r 2               ; Procedure-declaration scratch (parse_proc_decl; not nestable in this build).
0004C2r 2               proc_param_count:
0004C2r 2  xx                   .RES    1               ; running count while parsing param list
0004C3r 2               proc_entry_idx:
0004C3r 2  xx xx                .RES    2               ; symtab entry pointer (legacy name; for backpatch)
0004C5r 2               param_var_mask:
0004C5r 2  xx                   .RES    1               ; bitmap of which params are VAR (bit i ↔ param i, max 8)
0004C6r 2               group_is_var:
0004C6r 2  xx                   .RES    1               ; 1 while parsing the names of a VAR-prefixed group
0004C7r 2               local_alloc_off:
0004C7r 2  xx                   .RES    1               ; next free local-AR offset; init = pcount*2 at proc entry
0004C8r 2               uses_saved_tok:
0004C8r 2  xx                   .RES    1               ; saved top-level lookahead token while USES imports other source files
0004C9r 2               
0004C9r 2               ; Function-call scratch (parse_factor @sym_func_call; nested fn calls in args
0004C9r 2               ; not yet supported — see TODO).
0004C9r 2               fcall_pcount:
0004C9r 2  xx                   .RES    1
0004CAr 2               fcall_lo:
0004CAr 2  xx                   .RES    1
0004CBr 2               fcall_hi:
0004CBr 2  xx                   .RES    1
0004CCr 2               fcall_type:
0004CCr 2  xx                   .RES    1
0004CDr 2               fcall_vmask:
0004CDr 2  xx                   .RES    1               ; the called proc/func's VAR-param bitmap
0004CEr 2               fcall_lsize:
0004CEr 2  xx                   .RES    1               ; the called proc/func's total local-area size (params+locals)
0004CFr 2               fcall_param_types:
0004CFr 2  xx xx xx xx          .RES    8               ; formal parameter types 0..7 for the active function call
0004D3r 2  xx xx xx xx  
0004D7r 2               
0004D7r 2               ; Record-chain scratch (parse_statement / parse_factor). Used while walking
0004D7r 2               ; dotted field access through nested RECORD values.
0004D7r 2               field_chain_type:
0004D7r 2  xx                   .RES    1
0004D8r 2               field_chain_first:
0004D8r 2  xx                   .RES    1
0004D9r 2               field_chain_count:
0004D9r 2  xx                   .RES    1
0004DAr 2               
0004DAr 2               ; SET literal scratch (compile-time only). SET values are 16-bit masks over
0004DAr 2               ; element values 0..15 in this build.
0004DAr 2               set_lit_mask:
0004DAr 2  xx xx                .RES    2
0004DCr 2               set_lit_lo:
0004DCr 2  xx                   .RES    1
0004DDr 2               set_lit_hi:
0004DDr 2  xx                   .RES    1
0004DEr 2               set_lit_cur:
0004DEr 2  xx                   .RES    1
0004DFr 2               real_frac_count:
0004DFr 2  xx                   .RES    1               ; lexer scratch while tokenising fixed-point REAL literals
0004E0r 2               
0004E0r 2               ; Main-program entry-point patch slot. compile_program emits a UJP at code
0004E0r 2               ; offset 0; top-level BEGIN/init blocks patch it to the first startup body
0004E0r 2               ; that should run. Hi byte = $FF means "already patched / none pending"
0004E0r 2               ; (sentinel — never a valid patch addr since cg_pc starts at 0).
0004E0r 2               main_jmp_patch:
0004E0r 2  xx xx                .RES    2
0004E2r 2               
0004E2r 2               ; Pending tail-jump patch for the most recently emitted top-level body.
0004E2r 2               ; Each startup body (unit init or main BEGIN) ends with a UJP placeholder so
0004E2r 2               ; later top-level bodies can be chained together without falling through into
0004E2r 2               ; intervening procedure/function code.
0004E2r 2               body_chain_patch:
0004E2r 2  xx xx                .RES    2
0004E4r 2               
0004E4r 2               ; ---------------------------------------------------------------------------
0004E4r 2               ; lexer_init — reset lexer state; call before compile_program
0004E4r 2               ; ---------------------------------------------------------------------------
0004E4r 2               lexer_init:
0004E4r 2  A9 01                LDA     #1
0004E6r 2  85 rr                STA     lex_line
0004E8r 2  A9 00                LDA     #0
0004EAr 2  85 rr                STA     lex_line+1
0004ECr 2  85 rr                STA     lex_col
0004EEr 2  85 rr                STA     src_buf_pos
0004F0r 2  85 rr                STA     src_buf_end
0004F2r 2               ; prime lex_char
0004F2r 2  20 rr rr             JSR     lexer_getc
0004F5r 2  60                   RTS
0004F6r 2               
0004F6r 2               ; ---------------------------------------------------------------------------
0004F6r 2               ; next_token — advance to next token, set tok_type
0004F6r 2               ; On return:
0004F6r 2               ;   tok_type  = token code
0004F6r 2               ;   tok_ival  = integer value (if TOK_INT)
0004F6r 2               ;   ident_buf = identifier string (if TOK_IDENT)
0004F6r 2               ; ---------------------------------------------------------------------------
0004F6r 2               next_token:
0004F6r 2               ; skip whitespace and comments
0004F6r 2               @skip:
0004F6r 2  A5 rr                LDA     lex_char
0004F8r 2  F0 3B                BEQ     @eof
0004FAr 2  C9 20                CMP     #' '
0004FCr 2  F0 13                BEQ     @ws
0004FEr 2  C9 09                CMP     #$09            ; TAB
000500r 2  F0 0F                BEQ     @ws
000502r 2  C9 0D                CMP     #$0D            ; CR — treat as whitespace, LF counts the line
000504r 2  F0 0B                BEQ     @ws
000506r 2  C9 0A                CMP     #$0A            ; LF
000508r 2  F0 0C                BEQ     @nl
00050Ar 2  C9 7B                CMP     #'{'            ; Pascal comment start
00050Cr 2  F0 17                BEQ     @comment
00050Er 2  4C rr rr             JMP     @not_ws
000511r 2               @ws:
000511r 2  20 rr rr             JSR     lexer_getc
000514r 2  80 E0                BRA     @skip
000516r 2               @nl:
000516r 2  E6 rr                INC     lex_line
000518r 2  D0 02                BNE     :+
00051Ar 2  E6 rr                INC     lex_line+1
00051Cr 2               :
00051Cr 2  A9 00                LDA     #0
00051Er 2  85 rr                STA     lex_col
000520r 2  20 rr rr             JSR     lexer_getc
000523r 2  80 D1                BRA     @skip
000525r 2               @comment:
000525r 2               ; skip { ... }
000525r 2               @cloop:
000525r 2  20 rr rr             JSR     lexer_getc
000528r 2  A5 rr                LDA     lex_char        ; PLY inside lexer_getc clobbers Z; reload to test EOF
00052Ar 2  F0 09                BEQ     @eof
00052Cr 2  C9 7D                CMP     #'}'
00052Er 2  D0 F5                BNE     @cloop
000530r 2  20 rr rr             JSR     lexer_getc
000533r 2  80 C1                BRA     @skip
000535r 2               @eof:
000535r 2  A9 00                LDA     #TOK_EOF
000537r 2  85 rr                STA     tok_type
000539r 2  60                   RTS
00053Ar 2               
00053Ar 2               @not_ws:
00053Ar 2               ; letter → identifier or keyword
00053Ar 2  20 rr rr             JSR     is_letter
00053Dr 2  90 03                BCC     :+
00053Fr 2  4C rr rr             JMP     @ident
000542r 2               :
000542r 2               
000542r 2               ; digit → integer literal
000542r 2  20 rr rr             JSR     is_digit
000545r 2  90 03                BCC     :+
000547r 2  4C rr rr             JMP     @number
00054Ar 2               :
00054Ar 2               
00054Ar 2               ; string → string literal
00054Ar 2  C9 27                CMP     #$27            ; single quote
00054Cr 2  D0 03                BNE     :+
00054Er 2  4C rr rr             JMP     @string
000551r 2               :
000551r 2               
000551r 2               ; operators and punctuation
000551r 2  4C rr rr             JMP     @punct
000554r 2               
000554r 2               ; --- Identifier ---
000554r 2               @ident:
000554r 2  A0 00                LDY     #0
000556r 2               @id_loop:
000556r 2  A5 rr                LDA     lex_char
000558r 2  20 rr rr             JSR     to_upper
00055Br 2  99 rr rr             STA     ident_buf+1,y
00055Er 2  C8                   INY
00055Fr 2  C0 3F                CPY     #63
000561r 2  F0 0F                BEQ     @id_done
000563r 2  20 rr rr             JSR     lexer_getc
000566r 2  A5 rr                LDA     lex_char
000568r 2  20 rr rr             JSR     is_letter
00056Br 2  B0 E9                BCS     @id_loop
00056Dr 2  20 rr rr             JSR     is_digit
000570r 2  B0 E4                BCS     @id_loop
000572r 2               @id_done:
000572r 2  98                   TYA
000573r 2  8D rr rr             STA     ident_buf       ; length
000576r 2               ; check against keyword table
000576r 2  20 rr rr             JSR     lookup_keyword
000579r 2  85 rr                STA     tok_type
00057Br 2  60                   RTS
00057Cr 2               
00057Cr 2               ; --- Numeric literal (integer or fixed-point REAL) ---
00057Cr 2               @number:
00057Cr 2  A9 00                LDA     #0
00057Er 2  85 rr                STA     tok_ival_lo
000580r 2  85 rr                STA     tok_ival_hi
000582r 2               @num_loop:
000582r 2  A5 rr                LDA     lex_char
000584r 2  38                   SEC
000585r 2  E9 30                SBC     #'0'
000587r 2  20 rr rr             JSR     mul10_tokval    ; tokval = tokval*10 + digit
00058Ar 2  20 rr rr             JSR     lexer_getc
00058Dr 2  A5 rr                LDA     lex_char
00058Fr 2  20 rr rr             JSR     is_digit
000592r 2  B0 EE                BCS     @num_loop
000594r 2  A5 rr                LDA     lex_char
000596r 2  C9 2E                CMP     #'.'
000598r 2  D0 5D                BNE     @num_int
00059Ar 2  A5 rr                LDA     src_buf_pos
00059Cr 2  C5 rr                CMP     src_buf_end
00059Er 2  B0 57                BCS     @num_int               ; dot at sector boundary -> treat as integer
0005A0r 2  A8                   TAY
0005A1r 2  B9 28 01             LDA     DMA_BUF,y
0005A4r 2  C9 2E                CMP     #'.'
0005A6r 2  F0 4F                BEQ     @num_int               ; 1..10 range syntax
0005A8r 2  C9 30                CMP     #'0'
0005AAr 2  90 4B                BCC     @num_int
0005ACr 2  C9 3A                CMP     #'9'+1
0005AEr 2  B0 47                BCS     @num_int
0005B0r 2  A9 00                LDA     #0
0005B2r 2  8D rr rr             STA     real_frac_count
0005B5r 2  20 rr rr             JSR     lexer_getc             ; consume '.' -> first fractional digit
0005B8r 2               @real_loop:
0005B8r 2  A5 rr                LDA     lex_char
0005BAr 2  20 rr rr             JSR     is_digit
0005BDr 2  90 17                BCC     @real_done
0005BFr 2  AD rr rr             LDA     real_frac_count
0005C2r 2  C9 02                CMP     #2
0005C4r 2  B0 0B                BCS     @real_skip_digit
0005C6r 2  A5 rr                LDA     lex_char
0005C8r 2  38                   SEC
0005C9r 2  E9 30                SBC     #'0'
0005CBr 2  20 rr rr             JSR     mul10_tokval
0005CEr 2  EE rr rr             INC     real_frac_count
0005D1r 2               @real_skip_digit:
0005D1r 2  20 rr rr             JSR     lexer_getc
0005D4r 2  80 E2                BRA     @real_loop
0005D6r 2               @real_done:
0005D6r 2  AD rr rr             LDA     real_frac_count
0005D9r 2  C9 00                CMP     #0
0005DBr 2  D0 0C                BNE     :+
0005DDr 2  A9 00                LDA     #0
0005DFr 2  20 rr rr             JSR     mul10_tokval
0005E2r 2  A9 00                LDA     #0
0005E4r 2  20 rr rr             JSR     mul10_tokval
0005E7r 2  80 09                BRA     @num_real
0005E9r 2  C9 01        :       CMP     #1
0005EBr 2  D0 05                BNE     @num_real
0005EDr 2  A9 00                LDA     #0
0005EFr 2  20 rr rr             JSR     mul10_tokval
0005F2r 2               @num_real:
0005F2r 2  A9 05                LDA     #TOK_REAL
0005F4r 2  85 rr                STA     tok_type
0005F6r 2  60                   RTS
0005F7r 2               @num_int:
0005F7r 2  A9 02                LDA     #TOK_INT
0005F9r 2  85 rr                STA     tok_type
0005FBr 2  60                   RTS
0005FCr 2               
0005FCr 2               ; --- String literal ---
0005FCr 2               @string:
0005FCr 2  20 rr rr             JSR     lexer_getc      ; skip opening quote
0005FFr 2  A0 00                LDY     #0
000601r 2               @str_loop:
000601r 2  A5 rr                LDA     lex_char
000603r 2  F0 21                BEQ     @str_done       ; EOF
000605r 2  C9 27                CMP     #$27
000607r 2  F0 09                BEQ     @str_close
000609r 2  99 rr rr             STA     ident_buf+1,y
00060Cr 2  C8                   INY
00060Dr 2  20 rr rr             JSR     lexer_getc
000610r 2  80 EF                BRA     @str_loop
000612r 2               @str_close:
000612r 2  20 rr rr             JSR     lexer_getc      ; skip closing quote
000615r 2               ; check for '' (escaped quote)
000615r 2  A5 rr                LDA     lex_char
000617r 2  C9 27                CMP     #$27
000619r 2  D0 0B                BNE     @str_done
00061Br 2  A9 27                LDA     #$27
00061Dr 2  99 rr rr             STA     ident_buf+1,y
000620r 2  C8                   INY
000621r 2  20 rr rr             JSR     lexer_getc
000624r 2  80 DB                BRA     @str_loop
000626r 2               @str_done:
000626r 2  98                   TYA
000627r 2  8D rr rr             STA     ident_buf
00062Ar 2  A9 03                LDA     #TOK_STRING
00062Cr 2  85 rr                STA     tok_type
00062Er 2  60                   RTS
00062Fr 2               
00062Fr 2               ; --- Punctuation / operators ---
00062Fr 2               @punct:
00062Fr 2  A2 00                LDX     #0
000631r 2  A5 rr                LDA     lex_char
000633r 2  C9 2B                CMP     #'+'
000635r 2  D0 02                BNE     :+
000637r 2  A2 10                LDX     #TOK_PLUS
000639r 2               :
000639r 2  C9 2D                CMP     #'-'
00063Br 2  D0 02                BNE     :+
00063Dr 2  A2 11                LDX     #TOK_MINUS
00063Fr 2               :
00063Fr 2  C9 2A                CMP     #'*'
000641r 2  D0 02                BNE     :+
000643r 2  A2 12                LDX     #TOK_STAR
000645r 2               :
000645r 2  C9 2F                CMP     #'/'
000647r 2  D0 02                BNE     :+
000649r 2  A2 13                LDX     #TOK_SLASH
00064Br 2               :
00064Br 2  C9 3D                CMP     #'='
00064Dr 2  D0 02                BNE     :+
00064Fr 2  A2 14                LDX     #TOK_EQ
000651r 2               :
000651r 2  C9 28                CMP     #'('
000653r 2  D0 02                BNE     :+
000655r 2  A2 1B                LDX     #TOK_LPAREN
000657r 2               :
000657r 2  C9 29                CMP     #')'
000659r 2  D0 02                BNE     :+
00065Br 2  A2 1C                LDX     #TOK_RPAREN
00065Dr 2               :
00065Dr 2  C9 5B                CMP     #'['
00065Fr 2  D0 02                BNE     :+
000661r 2  A2 1D                LDX     #TOK_LBRACK
000663r 2               :
000663r 2  C9 5D                CMP     #']'
000665r 2  D0 02                BNE     :+
000667r 2  A2 1E                LDX     #TOK_RBRACK
000669r 2               :
000669r 2  C9 2C                CMP     #','
00066Br 2  D0 02                BNE     :+
00066Dr 2  A2 1F                LDX     #TOK_COMMA
00066Fr 2               :
00066Fr 2  C9 3B                CMP     #';'
000671r 2  D0 02                BNE     :+
000673r 2  A2 20                LDX     #TOK_SEMICOLON
000675r 2               :
000675r 2  C9 5E                CMP     #'^'
000677r 2  D0 02                BNE     :+
000679r 2  A2 24                LDX     #TOK_CARET
00067Br 2               :
00067Br 2  C9 3C                CMP     #'<'
00067Dr 2  D0 22                BNE     @not_lt
00067Fr 2  20 rr rr             JSR     lexer_getc
000682r 2  A5 rr                LDA     lex_char
000684r 2  C9 3D                CMP     #'='
000686r 2  F0 09                BEQ     @leq
000688r 2  C9 3E                CMP     #'>'
00068Ar 2  F0 0D                BEQ     @neq
00068Cr 2  A9 16                LDA     #TOK_LT
00068Er 2  85 rr                STA     tok_type
000690r 2  60                   RTS
000691r 2               @leq:
000691r 2  20 rr rr             JSR     lexer_getc
000694r 2  A9 18                LDA     #TOK_LEQ
000696r 2  85 rr                STA     tok_type
000698r 2  60                   RTS
000699r 2               @neq:
000699r 2  20 rr rr             JSR     lexer_getc
00069Cr 2  A9 15                LDA     #TOK_NEQ
00069Er 2  85 rr                STA     tok_type
0006A0r 2  60                   RTS
0006A1r 2               @not_lt:
0006A1r 2  C9 3E                CMP     #'>'
0006A3r 2  D0 16                BNE     @not_gt
0006A5r 2  20 rr rr             JSR     lexer_getc
0006A8r 2  A5 rr                LDA     lex_char
0006AAr 2  C9 3D                CMP     #'='
0006ACr 2  F0 05                BEQ     @geq
0006AEr 2  A9 17                LDA     #TOK_GT
0006B0r 2  85 rr                STA     tok_type
0006B2r 2  60                   RTS
0006B3r 2               @geq:
0006B3r 2  20 rr rr             JSR     lexer_getc
0006B6r 2  A9 19                LDA     #TOK_GEQ
0006B8r 2  85 rr                STA     tok_type
0006BAr 2  60                   RTS
0006BBr 2               @not_gt:
0006BBr 2  C9 3A                CMP     #':'
0006BDr 2  D0 16                BNE     @not_colon
0006BFr 2  20 rr rr             JSR     lexer_getc
0006C2r 2  A5 rr                LDA     lex_char
0006C4r 2  C9 3D                CMP     #'='
0006C6r 2  F0 05                BEQ     @assign
0006C8r 2  A9 21                LDA     #TOK_COLON
0006CAr 2  85 rr                STA     tok_type
0006CCr 2  60                   RTS
0006CDr 2               @assign:
0006CDr 2  20 rr rr             JSR     lexer_getc
0006D0r 2  A9 1A                LDA     #TOK_ASSIGN
0006D2r 2  85 rr                STA     tok_type
0006D4r 2  60                   RTS
0006D5r 2               @not_colon:
0006D5r 2  C9 2E                CMP     #'.'
0006D7r 2  D0 16                BNE     @not_dot
0006D9r 2  20 rr rr             JSR     lexer_getc
0006DCr 2  A5 rr                LDA     lex_char
0006DEr 2  C9 2E                CMP     #'.'
0006E0r 2  F0 05                BEQ     @dotdot
0006E2r 2  A9 22                LDA     #TOK_DOT
0006E4r 2  85 rr                STA     tok_type
0006E6r 2  60                   RTS
0006E7r 2               @dotdot:
0006E7r 2  20 rr rr             JSR     lexer_getc
0006EAr 2  A9 23                LDA     #TOK_DOTDOT
0006ECr 2  85 rr                STA     tok_type
0006EEr 2  60                   RTS
0006EFr 2               @not_dot:
0006EFr 2               ; If a single-byte operator matched above, X holds its TOK_* code.
0006EFr 2               ; Otherwise X=0 and the character is unknown — skip and retry.
0006EFr 2  E0 00                CPX     #0
0006F1r 2  F0 07                BEQ     @unknown
0006F3r 2  8A                   TXA
0006F4r 2  85 rr                STA     tok_type
0006F6r 2  20 rr rr             JSR     lexer_getc
0006F9r 2  60                   RTS
0006FAr 2               @unknown:
0006FAr 2  20 rr rr             JSR     lexer_getc
0006FDr 2  4C rr rr             JMP     next_token
000700r 2               
000700r 2               ; ---------------------------------------------------------------------------
000700r 2               ; lexer_getc — fetch next character into lex_char
000700r 2               ; Refills sector buffer via file_read_sector when empty
000700r 2               ; ---------------------------------------------------------------------------
000700r 2               lexer_getc:
000700r 2  5A                   PHY                     ; preserve caller's Y across refill + read
000701r 2  A5 rr                LDA     src_buf_pos
000703r 2  C5 rr                CMP     src_buf_end
000705r 2  90 17                BCC     @from_buf       ; still have data
000707r 2               ; refill buffer — set tmp1 to source FCB first
000707r 2               ; (other code paths leave tmp1 pointing at output FCB)
000707r 2  A5 rr                LDA     src_fcb
000709r 2  85 rr                STA     tmp1
00070Br 2  A5 rr                LDA     src_fcb+1
00070Dr 2  85 rr                STA     tmp1+1
00070Fr 2  20 rr rr             JSR     file_read_sector
000712r 2  C9 00                CMP     #0
000714r 2  D0 15                BNE     @eof_char
000716r 2  A9 80                LDA     #128
000718r 2  85 rr                STA     src_buf_end
00071Ar 2  A9 00                LDA     #0
00071Cr 2  85 rr                STA     src_buf_pos
00071Er 2               @from_buf:
00071Er 2  A4 rr                LDY     src_buf_pos
000720r 2  B9 28 01             LDA     DMA_BUF,y
000723r 2  E6 rr                INC     src_buf_pos
000725r 2  85 rr                STA     lex_char
000727r 2  E6 rr                INC     lex_col
000729r 2  7A                   PLY
00072Ar 2  60                   RTS
00072Br 2               @eof_char:
00072Br 2  A9 00                LDA     #0
00072Dr 2  85 rr                STA     lex_char
00072Fr 2  7A                   PLY
000730r 2  60                   RTS
000731r 2               
000731r 2               ; ---------------------------------------------------------------------------
000731r 2               ; lookup_keyword — check ident_buf against keyword_table
000731r 2               ; Returns: A = keyword token code, or TOK_IDENT if not found
000731r 2               ; ---------------------------------------------------------------------------
000731r 2               lookup_keyword:
000731r 2  A9 rr                LDA     #<keyword_table
000733r 2  85 rr                STA     tmp2
000735r 2  A9 rr                LDA     #>keyword_table
000737r 2  85 rr                STA     tmp2+1
000739r 2               @next_kw:
000739r 2  A0 00                LDY     #0
00073Br 2  B1 rr                LDA     (tmp2),y        ; keyword length (0 = sentinel)
00073Dr 2  F0 2C                BEQ     @not_found
00073Fr 2  CD rr rr             CMP     ident_buf       ; compare lengths first
000742r 2  D0 15                BNE     @advance
000744r 2  AA                   TAX                     ; X = length
000745r 2  A0 01                LDY     #1
000747r 2               @cmp_loop:
000747r 2  B1 rr                LDA     (tmp2),y
000749r 2  D9 rr rr             CMP     ident_buf,y
00074Cr 2  D0 0B                BNE     @advance
00074Er 2  C8                   INY
00074Fr 2  CA                   DEX
000750r 2  D0 F5                BNE     @cmp_loop
000752r 2               ; match: token code is at offset length+1
000752r 2  AC rr rr             LDY     ident_buf
000755r 2  C8                   INY
000756r 2  B1 rr                LDA     (tmp2),y
000758r 2  60                   RTS
000759r 2               @advance:
000759r 2               ; skip to next entry: advance tmp2 by (length+2)
000759r 2               ; (Y may be >0 if we got here from @cmp_loop — reset to 0 first)
000759r 2  A0 00                LDY     #0
00075Br 2  B1 rr                LDA     (tmp2),y        ; length byte
00075Dr 2  18                   CLC
00075Er 2  69 02                ADC     #2              ; +1 for length byte, +1 for token byte
000760r 2  18                   CLC
000761r 2  65 rr                ADC     tmp2
000763r 2  85 rr                STA     tmp2
000765r 2  90 02                BCC     :+
000767r 2  E6 rr                INC     tmp2+1
000769r 2               :
000769r 2  80 CE                BRA     @next_kw
00076Br 2               @not_found:
00076Br 2  A9 01                LDA     #TOK_IDENT
00076Dr 2  60                   RTS
00076Er 2               
00076Er 2               ; ---------------------------------------------------------------------------
00076Er 2               ; is_letter — test lex_char; carry set if A-Z or a-z
00076Er 2               ; ---------------------------------------------------------------------------
00076Er 2               is_letter:
00076Er 2  A5 rr                LDA     lex_char
000770r 2  C9 41                CMP     #'A'
000772r 2  90 10                BCC     @no
000774r 2  C9 5B                CMP     #'Z'+1
000776r 2  90 0E                BCC     @yes
000778r 2  C9 61                CMP     #'a'
00077Ar 2  90 08                BCC     @no
00077Cr 2  C9 7B                CMP     #'z'+1
00077Er 2  90 06                BCC     @yes
000780r 2  C9 5F                CMP     #'_'
000782r 2  F0 02                BEQ     @yes
000784r 2               @no:
000784r 2  18                   CLC
000785r 2  60                   RTS
000786r 2               @yes:
000786r 2  38                   SEC
000787r 2  60                   RTS
000788r 2               
000788r 2               ; ---------------------------------------------------------------------------
000788r 2               ; is_digit — test lex_char; carry set if 0-9
000788r 2               ; ---------------------------------------------------------------------------
000788r 2               is_digit:
000788r 2  A5 rr                LDA     lex_char
00078Ar 2  C9 30                CMP     #'0'
00078Cr 2  90 06                BCC     @no
00078Er 2  C9 3A                CMP     #'9'+1
000790r 2  B0 02                BCS     @no
000792r 2  38                   SEC
000793r 2  60                   RTS
000794r 2               @no:
000794r 2  18                   CLC
000795r 2  60                   RTS
000796r 2               
000796r 2               ; ---------------------------------------------------------------------------
000796r 2               ; to_upper — convert A to uppercase (A-Z,a-z only, others pass through)
000796r 2               ; ---------------------------------------------------------------------------
000796r 2               to_upper:
000796r 2  C9 61                CMP     #'a'
000798r 2  90 06                BCC     @done
00079Ar 2  C9 7B                CMP     #'z'+1
00079Cr 2  B0 02                BCS     @done
00079Er 2  29 DF                AND     #$DF
0007A0r 2               @done:
0007A0r 2  60                   RTS
0007A1r 2               
0007A1r 2               ; ---------------------------------------------------------------------------
0007A1r 2               ; mul10_tokval — tokval = tokval*10 + A  (A = digit 0-9)
0007A1r 2               ; ---------------------------------------------------------------------------
0007A1r 2               mul10_tokval:
0007A1r 2  48                   PHA
0007A2r 2               ; multiply tok_ival by 10: x10 = x*8 + x*2
0007A2r 2  A5 rr                LDA     tok_ival_lo
0007A4r 2  0A                   ASL                     ; *2
0007A5r 2  85 rr                STA     tmp2
0007A7r 2  A5 rr                LDA     tok_ival_hi
0007A9r 2  2A                   ROL
0007AAr 2  85 rr                STA     tmp2+1
0007ACr 2  A5 rr                LDA     tmp2            ; *4
0007AEr 2  0A                   ASL
0007AFr 2  85 rr                STA     tmp3
0007B1r 2  A5 rr                LDA     tmp2+1
0007B3r 2  2A                   ROL
0007B4r 2  85 rr                STA     tmp3+1
0007B6r 2  A5 rr                LDA     tmp3            ; *8
0007B8r 2  0A                   ASL
0007B9r 2  85 rr                STA     tmp3
0007BBr 2  A5 rr                LDA     tmp3+1
0007BDr 2  2A                   ROL
0007BEr 2  85 rr                STA     tmp3+1
0007C0r 2               ; *10 = *8 + *2
0007C0r 2  A5 rr                LDA     tmp3
0007C2r 2  18                   CLC
0007C3r 2  65 rr                ADC     tmp2
0007C5r 2  85 rr                STA     tok_ival_lo
0007C7r 2  A5 rr                LDA     tmp3+1
0007C9r 2  65 rr                ADC     tmp2+1
0007CBr 2  85 rr                STA     tok_ival_hi
0007CDr 2               ; add digit
0007CDr 2  68                   PLA
0007CEr 2  18                   CLC
0007CFr 2  65 rr                ADC     tok_ival_lo
0007D1r 2  85 rr                STA     tok_ival_lo
0007D3r 2  90 02                BCC     :+
0007D5r 2  E6 rr                INC     tok_ival_hi
0007D7r 2               :
0007D7r 2  60                   RTS
0007D8r 2               
0007D8r 1                       .include        "PARSER.ASM"
0007D8r 2               ; parser.asm — recursive-descent Pascal parser + single-pass code generator
0007D8r 2               ;
0007D8r 2               ; Entry point: compile_program (called from pascal_main)
0007D8r 2               ;
0007D8r 2               ; This is a skeleton. Each parse routine calls next_token and emits p-code
0007D8r 2               ; directly (no AST nodes). Phase 3 fleshes out the full grammar.
0007D8r 2               
0007D8r 2                       .segment        "CODE"
0007D8r 2               
0007D8r 2               ; ---------------------------------------------------------------------------
0007D8r 2               ; expect — verify current token is `expected_tok`, advance, error if not
0007D8r 2               ; expected_tok passed in X; error string pointer in tmp3 (lo) and A (hi)
0007D8r 2               ; ---------------------------------------------------------------------------
0007D8r 2               expect:
0007D8r 2  A5 rr                LDA     tok_type
0007DAr 2  E4 rr                CPX     tok_type
0007DCr 2  F0 18                BEQ     @ok
0007DEr 2               ; mismatch — report error using tmp3 as message pointer
0007DEr 2  A5 rr                LDA     tmp3
0007E0r 2  85 rr                STA     tmp0
0007E2r 2  A5 rr                LDA     tmp3+1
0007E4r 2  85 rr                STA     tmp0+1
0007E6r 2  20 rr rr             JSR     compile_error
0007E9r 2               ; attempt recovery: skip tokens until we see the expected one or EOF
0007E9r 2               @recover:
0007E9r 2  A5 rr                LDA     tok_type
0007EBr 2  F0 09                BEQ     @ok             ; EOF — stop recovery
0007EDr 2  E4 rr                CPX     tok_type
0007EFr 2  F0 05                BEQ     @ok
0007F1r 2  20 rr rr             JSR     next_token
0007F4r 2  80 F3                BRA     @recover
0007F6r 2               @ok:
0007F6r 2  20 rr rr             JSR     next_token
0007F9r 2  60                   RTS
0007FAr 2               
0007FAr 2               ; Helper macros — not ca65 .macros since they'd be complex; use inline calls.
0007FAr 2               
0007FAr 2               ; ---------------------------------------------------------------------------
0007FAr 2               ; compile_program — top-level dispatcher for PROGRAM or UNIT sources.
0007FAr 2               ; ---------------------------------------------------------------------------
0007FAr 2               compile_program:
0007FAr 2  20 rr rr             JSR     symtab_init
0007FDr 2  A9 00                LDA     #0
0007FFr 2  8D rr rr             STA     unit_section
000802r 2  A5 rr                LDA     tok_type
000804r 2  C9 61                CMP     #TOK_UNIT
000806r 2  F0 03                BEQ     @unit_src
000808r 2  4C rr rr             JMP     @program_src
00080Br 2               @unit_src:
00080Br 2  4C rr rr             JMP     compile_unit
00080Er 2               @program_src:
00080Er 2               ; expect PROGRAM keyword
00080Er 2  A5 rr                LDA     tok_type
000810r 2  C9 54                CMP     #TOK_PROGRAM
000812r 2  D0 0F                BNE     @no_hdr         ; allow missing PROGRAM header (lenient)
000814r 2  20 rr rr             JSR     next_token
000817r 2               ; program name (identifier)
000817r 2  20 rr rr             JSR     next_token
00081Ar 2               ; semicolon
00081Ar 2  A5 rr                LDA     tok_type
00081Cr 2  C9 20                CMP     #TOK_SEMICOLON
00081Er 2  D0 03                BNE     :+
000820r 2  20 rr rr             JSR     next_token
000823r 2               :
000823r 2               @no_hdr:
000823r 2               ; Emit a forward UJP at code offset 0; parse_block patches it to point
000823r 2               ; to the main BEGIN block once all proc bodies have been emitted ahead
000823r 2               ; of it. The .PCD entry point stays at offset 0 (start of code = UJP).
000823r 2  20 rr rr             JSR     emit_UJP        ; A=patch_lo, scratch=patch_hi
000826r 2  8D rr rr             STA     main_jmp_patch
000829r 2  A5 rr                LDA     scratch
00082Br 2  8D rr rr             STA     main_jmp_patch+1
00082Er 2  20 rr rr             JSR     parse_block
000831r 2               ; Emit HALT at end of main program
000831r 2  20 rr rr             JSR     patch_startup_chain_if_needed
000834r 2  20 rr rr             JSR     emit_HALT
000837r 2  60                   RTS
000838r 2               
000838r 2               ; patch_startup_chain_if_needed — patch any pending top-level startup jumps
000838r 2               ; to the current cg_pc. This handles both the entry UJP (jump to the first
000838r 2               ; unit-init/main body) and the tail UJP emitted after each prior top-level
000838r 2               ; body (jump to the next one, or eventually HALT).
000838r 2               patch_startup_chain_if_needed:
000838r 2  AD rr rr             LDA     main_jmp_patch+1
00083Br 2  C9 FF                CMP     #$FF
00083Dr 2  F0 12                BEQ     @pscii_tail
00083Fr 2  AD rr rr             LDA     main_jmp_patch
000842r 2  85 rr                STA     tmp2
000844r 2  AD rr rr             LDA     main_jmp_patch+1
000847r 2  85 rr                STA     tmp2+1
000849r 2  20 rr rr             JSR     patch_jump
00084Cr 2  A9 FF                LDA     #$FF
00084Er 2  8D rr rr             STA     main_jmp_patch+1
000851r 2               @pscii_tail:
000851r 2  AD rr rr             LDA     body_chain_patch+1
000854r 2  C9 FF                CMP     #$FF
000856r 2  F0 12                BEQ     @pscii_done
000858r 2  AD rr rr             LDA     body_chain_patch
00085Br 2  85 rr                STA     tmp2
00085Dr 2  AD rr rr             LDA     body_chain_patch+1
000860r 2  85 rr                STA     tmp2+1
000862r 2  20 rr rr             JSR     patch_jump
000865r 2  A9 FF                LDA     #$FF
000867r 2  8D rr rr             STA     body_chain_patch+1
00086Ar 2               @pscii_done:
00086Ar 2  60                   RTS
00086Br 2               
00086Br 2               ; ---------------------------------------------------------------------------
00086Br 2               ; compile_unit — UNIT name ; INTERFACE ... IMPLEMENTATION ... [BEGIN ...] END.
00086Br 2               ; UNIT sources may be standalone roots or USES-imported. The INTERFACE
00086Br 2               ; section registers globals and routine headings; IMPLEMENTATION provides the
00086Br 2               ; bodies plus an optional init block. Imported units compile inline into the
00086Br 2               ; current .PCD while the startup jump chain preserves init order.
00086Br 2               ; ---------------------------------------------------------------------------
00086Br 2               compile_unit:
00086Br 2  20 rr rr             JSR     next_token              ; consume UNIT
00086Er 2  A5 rr                LDA     tok_type
000870r 2  C9 01                CMP     #TOK_IDENT
000872r 2  D0 21                BNE     :+
000874r 2  AD rr rr             LDA     unit_import_mode
000877r 2  D0 19                BNE     @cu_name_done
000879r 2  AE rr rr             LDX     used_unit_count
00087Cr 2  E0 08                CPX     #USED_UNIT_SLOTS
00087Er 2  B0 12                BCS     @cu_name_done
000880r 2  DA                   PHX
000881r 2  20 rr rr             JSR     used_unit_slot_ptr
000884r 2  A0 0F                LDY     #15
000886r 2               @cu_root_name_copy:
000886r 2  B9 rr rr             LDA     ident_buf,y
000889r 2  91 rr                STA     (tmp2),y
00088Br 2  88                   DEY
00088Cr 2  10 F8                BPL     @cu_root_name_copy
00088Er 2  FA                   PLX
00088Fr 2  EE rr rr             INC     used_unit_count
000892r 2               @cu_name_done:
000892r 2  20 rr rr             JSR     next_token              ; consume unit name
000895r 2  A5 rr        :       LDA     tok_type
000897r 2  C9 20                CMP     #TOK_SEMICOLON
000899r 2  D0 03                BNE     :+
00089Br 2  20 rr rr             JSR     next_token
00089Er 2  A5 rr        :       LDA     tok_type
0008A0r 2  C9 60                CMP     #TOK_INTERFACE
0008A2r 2  F0 0D                BEQ     @cu_have_iface
0008A4r 2  A9 rr                LDA     #<err_unexpected
0008A6r 2  85 rr                STA     tmp0
0008A8r 2  A9 rr                LDA     #>err_unexpected
0008AAr 2  85 rr                STA     tmp0+1
0008ACr 2  20 rr rr             JSR     compile_error
0008AFr 2  80 03                BRA     @cu_after_iface_kw
0008B1r 2               @cu_have_iface:
0008B1r 2  20 rr rr             JSR     next_token              ; consume INTERFACE
0008B4r 2               @cu_after_iface_kw:
0008B4r 2  AD rr rr             LDA     unit_import_mode
0008B7r 2  D0 0B                BNE     @cu_iface_ready
0008B9r 2  20 rr rr             JSR     emit_UJP
0008BCr 2  8D rr rr             STA     main_jmp_patch
0008BFr 2  A5 rr                LDA     scratch
0008C1r 2  8D rr rr             STA     main_jmp_patch+1
0008C4r 2               @cu_iface_ready:
0008C4r 2  A9 01                LDA     #1
0008C6r 2  8D rr rr             STA     unit_section
0008C9r 2  20 rr rr             JSR     parse_interface_block
0008CCr 2  A5 rr                LDA     tok_type
0008CEr 2  C9 5F                CMP     #TOK_IMPLEMENTATION
0008D0r 2  F0 0D                BEQ     @cu_have_impl
0008D2r 2  A9 rr                LDA     #<err_unexpected
0008D4r 2  85 rr                STA     tmp0
0008D6r 2  A9 rr                LDA     #>err_unexpected
0008D8r 2  85 rr                STA     tmp0+1
0008DAr 2  20 rr rr             JSR     compile_error
0008DDr 2  80 03                BRA     @cu_impl_start
0008DFr 2               @cu_have_impl:
0008DFr 2  20 rr rr             JSR     next_token              ; consume IMPLEMENTATION
0008E2r 2               @cu_impl_start:
0008E2r 2  A9 02                LDA     #2
0008E4r 2  8D rr rr             STA     unit_section
0008E7r 2  20 rr rr             JSR     parse_block
0008EAr 2  AD rr rr             LDA     unit_import_mode
0008EDr 2  D0 06                BNE     @cu_done
0008EFr 2  20 rr rr             JSR     patch_startup_chain_if_needed
0008F2r 2  20 rr rr             JSR     emit_HALT
0008F5r 2               @cu_done:
0008F5r 2  A9 00                LDA     #0
0008F7r 2  8D rr rr             STA     unit_section
0008FAr 2  60                   RTS
0008FBr 2               
0008FBr 2               ; ---------------------------------------------------------------------------
0008FBr 2               ; parse_interface_block — top-level INTERFACE declarations only.
0008FBr 2               ; Mirrors parse_block but PROCEDURE/FUNCTION consume headings without bodies.
0008FBr 2               ; Stops when IMPLEMENTATION (or anything unrecognised) is reached.
0008FBr 2               ; ---------------------------------------------------------------------------
0008FBr 2               parse_interface_block:
0008FBr 2               @pib_again:
0008FBr 2  A5 rr                LDA     tok_type
0008FDr 2  C9 62                CMP     #TOK_USES
0008FFr 2  F0 15                BEQ     @pib_uses
000901r 2  C9 44                CMP     #TOK_CONST
000903r 2  F0 16                BEQ     @pib_const
000905r 2  C9 5A                CMP     #TOK_TYPE
000907r 2  F0 1A                BEQ     @pib_type
000909r 2  C9 5C                CMP     #TOK_VAR
00090Br 2  F0 1E                BEQ     @pib_var
00090Dr 2  C9 53                CMP     #TOK_PROCEDURE
00090Fr 2  F0 22                BEQ     @pib_proc
000911r 2  C9 4B                CMP     #TOK_FUNCTION
000913r 2  F0 26                BEQ     @pib_func
000915r 2  60                   RTS
000916r 2               @pib_uses:
000916r 2  20 rr rr             JSR     parse_uses_clause
000919r 2  80 E0                BRA     @pib_again
00091Br 2               @pib_const:
00091Br 2  20 rr rr             JSR     next_token
00091Er 2  20 rr rr             JSR     parse_const_decls
000921r 2  80 D8                BRA     @pib_again
000923r 2               @pib_type:
000923r 2  20 rr rr             JSR     next_token
000926r 2  20 rr rr             JSR     parse_type_decls
000929r 2  80 D0                BRA     @pib_again
00092Br 2               @pib_var:
00092Br 2  20 rr rr             JSR     next_token
00092Er 2  20 rr rr             JSR     parse_var_decls
000931r 2  80 C8                BRA     @pib_again
000933r 2               @pib_proc:
000933r 2  20 rr rr             JSR     next_token
000936r 2  20 rr rr             JSR     parse_proc_iface_decl
000939r 2  80 C0                BRA     @pib_again
00093Br 2               @pib_func:
00093Br 2  20 rr rr             JSR     next_token
00093Er 2  20 rr rr             JSR     parse_func_iface_decl
000941r 2  80 B8                BRA     @pib_again
000943r 2               
000943r 2               ; ---------------------------------------------------------------------------
000943r 2               ; import_unit_by_name — ident_buf names a UNIT source file to compile into the
000943r 2               ; current output. Repeated/nested imports are de-duplicated globally.
000943r 2               ; ---------------------------------------------------------------------------
000943r 2               import_unit_by_name:
000943r 2  A2 00                LDX     #0
000945r 2               @iun_scan:
000945r 2  EC rr rr             CPX     used_unit_count
000948r 2  B0 25                BCS     @iun_add
00094Ar 2  DA                   PHX
00094Br 2  20 rr rr             JSR     used_unit_slot_ptr
00094Er 2  A0 00                LDY     #0
000950r 2  B1 rr                LDA     (tmp2),y
000952r 2  CD rr rr             CMP     ident_buf
000955r 2  D0 12                BNE     @iun_next
000957r 2  85 rr                STA     scratch
000959r 2  A0 01                LDY     #1
00095Br 2               @iun_cmp:
00095Br 2  B1 rr                LDA     (tmp2),y
00095Dr 2  D9 rr rr             CMP     ident_buf,y
000960r 2  D0 07                BNE     @iun_next
000962r 2  C6 rr                DEC     scratch
000964r 2  F0 07                BEQ     @iun_found
000966r 2  C8                   INY
000967r 2  80 F2                BRA     @iun_cmp
000969r 2               @iun_next:
000969r 2  FA                   PLX
00096Ar 2  E8                   INX
00096Br 2  80 D8                BRA     @iun_scan
00096Dr 2               @iun_found:
00096Dr 2  FA                   PLX
00096Er 2  60                   RTS
00096Fr 2               @iun_add:
00096Fr 2  E0 08                CPX     #USED_UNIT_SLOTS
000971r 2  90 0C                BCC     :+
000973r 2  A9 rr                LDA     #<err_too_many
000975r 2  85 rr                STA     tmp0
000977r 2  A9 rr                LDA     #>err_too_many
000979r 2  85 rr                STA     tmp0+1
00097Br 2  20 rr rr             JSR     compile_error
00097Er 2  60                   RTS
00097Fr 2  DA           :       PHX
000980r 2  20 rr rr             JSR     used_unit_slot_ptr
000983r 2  A0 0F                LDY     #15
000985r 2               @iun_copy_name:
000985r 2  B9 rr rr             LDA     ident_buf,y
000988r 2  91 rr                STA     (tmp2),y
00098Ar 2  88                   DEY
00098Br 2  10 F8                BPL     @iun_copy_name
00098Dr 2  FA                   PLX
00098Er 2  EE rr rr             INC     used_unit_count
000991r 2  20 rr rr             JSR     source_push_current
000994r 2  90 0C                BCC     @iun_pushed
000996r 2  A9 rr                LDA     #<err_too_many
000998r 2  85 rr                STA     tmp0
00099Ar 2  A9 rr                LDA     #>err_too_many
00099Cr 2  85 rr                STA     tmp0+1
00099Er 2  20 rr rr             JSR     compile_error
0009A1r 2  60                   RTS
0009A2r 2               @iun_pushed:
0009A2r 2  20 rr rr             JSR     build_named_src_fcb
0009A5r 2  90 04                BCC     :+
0009A7r 2  20 rr rr             JSR     source_pop_current
0009AAr 2  60                   RTS
0009ABr 2  A9 rr        :       LDA     #<comp_src_fcb
0009ADr 2  85 rr                STA     src_fcb
0009AFr 2  85 rr                STA     tmp1
0009B1r 2  A9 rr                LDA     #>comp_src_fcb
0009B3r 2  85 rr                STA     src_fcb+1
0009B5r 2  85 rr                STA     tmp1+1
0009B7r 2  20 rr rr             JSR     file_open
0009BAr 2  C9 FF                CMP     #$FF
0009BCr 2  D0 0F                BNE     @iun_open_ok
0009BEr 2  A9 rr                LDA     #<err_nofile
0009C0r 2  85 rr                STA     tmp0
0009C2r 2  A9 rr                LDA     #>err_nofile
0009C4r 2  85 rr                STA     tmp0+1
0009C6r 2  20 rr rr             JSR     compile_error
0009C9r 2  20 rr rr             JSR     source_pop_current
0009CCr 2  60                   RTS
0009CDr 2               @iun_open_ok:
0009CDr 2  EE rr rr             INC     unit_import_mode
0009D0r 2  20 rr rr             JSR     lexer_init
0009D3r 2  20 rr rr             JSR     next_token
0009D6r 2  20 rr rr             JSR     compile_unit
0009D9r 2  CE rr rr             DEC     unit_import_mode
0009DCr 2  A9 rr                LDA     #<comp_src_fcb
0009DEr 2  85 rr                STA     tmp1
0009E0r 2  A9 rr                LDA     #>comp_src_fcb
0009E2r 2  85 rr                STA     tmp1+1
0009E4r 2  20 rr rr             JSR     file_close
0009E7r 2  20 rr rr             JSR     source_pop_current
0009EAr 2  60                   RTS
0009EBr 2               
0009EBr 2               ; ---------------------------------------------------------------------------
0009EBr 2               ; parse_uses_clause — top-level USES unit1, unit2, ... ;
0009EBr 2               ; Collects the unit names from the current source first, then compiles each
0009EBr 2               ; imported UNIT source while the current file context is suspended.
0009EBr 2               ; ---------------------------------------------------------------------------
0009EBr 2               parse_uses_clause:
0009EBr 2  20 rr rr             JSR     next_token              ; consume USES
0009EEr 2  A9 00                LDA     #0
0009F0r 2  8D rr rr             STA     uses_name_count
0009F3r 2               @puc_collect:
0009F3r 2  A5 rr                LDA     tok_type
0009F5r 2  C9 01                CMP     #TOK_IDENT
0009F7r 2  D0 34                BNE     @puc_done_collect
0009F9r 2  AE rr rr             LDX     uses_name_count
0009FCr 2  E0 08                CPX     #USES_NAME_SLOTS
0009FEr 2  B0 14                BCS     @puc_skip_store
000A00r 2  DA                   PHX
000A01r 2  20 rr rr             JSR     uses_name_slot_ptr
000A04r 2  A0 0F                LDY     #15
000A06r 2               @puc_store:
000A06r 2  B9 rr rr             LDA     ident_buf,y
000A09r 2  91 rr                STA     (tmp2),y
000A0Br 2  88                   DEY
000A0Cr 2  10 F8                BPL     @puc_store
000A0Er 2  FA                   PLX
000A0Fr 2  EE rr rr             INC     uses_name_count
000A12r 2  80 0B                BRA     @puc_after_store
000A14r 2               @puc_skip_store:
000A14r 2  A9 rr                LDA     #<err_too_many
000A16r 2  85 rr                STA     tmp0
000A18r 2  A9 rr                LDA     #>err_too_many
000A1Ar 2  85 rr                STA     tmp0+1
000A1Cr 2  20 rr rr             JSR     compile_error
000A1Fr 2               @puc_after_store:
000A1Fr 2  20 rr rr             JSR     next_token              ; consume unit name
000A22r 2  A5 rr                LDA     tok_type
000A24r 2  C9 1F                CMP     #TOK_COMMA
000A26r 2  D0 05                BNE     @puc_done_collect
000A28r 2  20 rr rr             JSR     next_token
000A2Br 2  80 C6                BRA     @puc_collect
000A2Dr 2               @puc_done_collect:
000A2Dr 2  A5 rr                LDA     tok_type
000A2Fr 2  48                   PHA
000A30r 2  A2 00                LDX     #0
000A32r 2               @puc_import_loop:
000A32r 2  EC rr rr             CPX     uses_name_count
000A35r 2  B0 16                BCS     @puc_resume
000A37r 2  DA                   PHX
000A38r 2  20 rr rr             JSR     uses_name_slot_ptr
000A3Br 2  A0 0F                LDY     #15
000A3Dr 2               @puc_restore_name:
000A3Dr 2  B1 rr                LDA     (tmp2),y
000A3Fr 2  99 rr rr             STA     ident_buf,y
000A42r 2  88                   DEY
000A43r 2  10 F8                BPL     @puc_restore_name
000A45r 2  20 rr rr             JSR     import_unit_by_name
000A48r 2  FA                   PLX
000A49r 2  E8                   INX
000A4Ar 2  4C rr rr             JMP     @puc_import_loop
000A4Dr 2               @puc_resume:
000A4Dr 2  68                   PLA
000A4Er 2  C9 20                CMP     #TOK_SEMICOLON
000A50r 2  D0 04                BNE     @puc_no_semi
000A52r 2  20 rr rr             JSR     next_token
000A55r 2  60                   RTS
000A56r 2               @puc_no_semi:
000A56r 2  85 rr                STA     tok_type
000A58r 2  60                   RTS
000A59r 2               
000A59r 2               ; ---------------------------------------------------------------------------
000A59r 2               ; parse_block — { const_part } { type_part } { var_part } { proc_part } statement_part
000A59r 2               ; ---------------------------------------------------------------------------
000A59r 2               parse_block:
000A59r 2               @again:
000A59r 2  A5 rr                LDA     tok_type
000A5Br 2  C9 62                CMP     #TOK_USES
000A5Dr 2  D0 09                BNE     @blk_chk_const
000A5Fr 2  A5 rr                LDA     scope_depth
000A61r 2  D0 05                BNE     @blk_chk_const
000A63r 2  20 rr rr             JSR     parse_uses_clause
000A66r 2  80 F1                BRA     @again
000A68r 2               @blk_chk_const:
000A68r 2  C9 44                CMP     #TOK_CONST
000A6Ar 2  F0 15                BEQ     @const
000A6Cr 2  C9 5A                CMP     #TOK_TYPE
000A6Er 2  F0 19                BEQ     @type
000A70r 2  C9 5C                CMP     #TOK_VAR
000A72r 2  F0 1D                BEQ     @var
000A74r 2  C9 53                CMP     #TOK_PROCEDURE
000A76r 2  F0 21                BEQ     @proc
000A78r 2  C9 4B                CMP     #TOK_FUNCTION
000A7Ar 2  F0 25                BEQ     @func
000A7Cr 2  C9 42                CMP     #TOK_BEGIN
000A7Er 2  F0 29                BEQ     @body
000A80r 2  60                   RTS                     ; nothing recognisable
000A81r 2               
000A81r 2               @const:
000A81r 2  20 rr rr             JSR     next_token
000A84r 2  20 rr rr             JSR     parse_const_decls
000A87r 2  80 D0                BRA     @again
000A89r 2               @type:
000A89r 2  20 rr rr             JSR     next_token
000A8Cr 2  20 rr rr             JSR     parse_type_decls
000A8Fr 2  80 C8                BRA     @again
000A91r 2               @var:
000A91r 2  20 rr rr             JSR     next_token
000A94r 2  20 rr rr             JSR     parse_var_decls
000A97r 2  80 C0                BRA     @again
000A99r 2               @proc:
000A99r 2  20 rr rr             JSR     next_token
000A9Cr 2  20 rr rr             JSR     parse_proc_decl
000A9Fr 2  80 B8                BRA     @again
000AA1r 2               @func:
000AA1r 2  20 rr rr             JSR     next_token
000AA4r 2  20 rr rr             JSR     parse_func_decl
000AA7r 2  80 B0                BRA     @again
000AA9r 2               @body:  ; If at global scope, patch the startup chain to this body's start
000AA9r 2                       ; before emitting any top-level init/main code.
000AA9r 2  A5 rr                LDA     scope_depth
000AABr 2  D0 03                BNE     @body_emit
000AADr 2  20 rr rr             JSR     patch_startup_chain_if_needed
000AB0r 2               @body_emit:
000AB0r 2  20 rr rr             JSR     parse_compound_stmt
000AB3r 2  A5 rr                LDA     scope_depth
000AB5r 2  D0 0B                BNE     @body_done
000AB7r 2  20 rr rr             JSR     emit_UJP
000ABAr 2  8D rr rr             STA     body_chain_patch
000ABDr 2  A5 rr                LDA     scratch
000ABFr 2  8D rr rr             STA     body_chain_patch+1
000AC2r 2               @body_done:
000AC2r 2  60                   RTS
000AC3r 2               
000AC3r 2               ; ---------------------------------------------------------------------------
000AC3r 2               ; parse_const_decls — name = [-]INT_LIT ;  { name = [-]INT_LIT ; }
000AC3r 2               ; Each constant goes into the symbol table as SYM_CONST with the literal
000AC3r 2               ; value stored at offsets 18-19; references emit LDCW with that value.
000AC3r 2               ; ---------------------------------------------------------------------------
000AC3r 2               parse_const_decls:
000AC3r 2               @loop:
000AC3r 2  A5 rr                LDA     tok_type
000AC5r 2  C9 01                CMP     #TOK_IDENT
000AC7r 2  F0 01                BEQ     @have_ident
000AC9r 2  60                   RTS                     ; done — no more constants
000ACAr 2               @have_ident:
000ACAr 2               ; save const name into save_name_buf
000ACAr 2  A0 0F                LDY     #15
000ACCr 2               @savename:
000ACCr 2  B9 rr rr             LDA     ident_buf,y
000ACFr 2  99 rr rr             STA     save_name_buf,y
000AD2r 2  88                   DEY
000AD3r 2  10 F7                BPL     @savename
000AD5r 2  20 rr rr             JSR     next_token      ; consume name
000AD8r 2               ; expect '='
000AD8r 2  A5 rr                LDA     tok_type
000ADAr 2  C9 14                CMP     #TOK_EQ
000ADCr 2  D0 03                BNE     :+
000ADEr 2  20 rr rr             JSR     next_token
000AE1r 2               :       ; optional unary minus — record in scratch (next_token preserves it)
000AE1r 2  A9 00                LDA     #0
000AE3r 2  85 rr                STA     scratch
000AE5r 2  A5 rr                LDA     tok_type
000AE7r 2  C9 11                CMP     #TOK_MINUS
000AE9r 2  D0 07                BNE     @no_minus
000AEBr 2  A9 FF                LDA     #$FF
000AEDr 2  85 rr                STA     scratch
000AEFr 2  20 rr rr             JSR     next_token
000AF2r 2               @no_minus:
000AF2r 2  A9 01                LDA     #TY_INT
000AF4r 2  85 rr                STA     expr_type
000AF6r 2                       ; expect INT/REAL literal
000AF6r 2  A5 rr                LDA     tok_type
000AF8r 2  C9 02                CMP     #TOK_INT
000AFAr 2  F0 0C                BEQ     @have_int
000AFCr 2  C9 05                CMP     #TOK_REAL
000AFEr 2  F0 15                BEQ     @have_real
000B00r 2                       ; bad value — store 0 and try to recover
000B00r 2  A9 00                LDA     #0
000B02r 2  85 rr                STA     tmp2
000B04r 2  85 rr                STA     tmp2+1
000B06r 2  80 1C                BRA     @add_const
000B08r 2               @have_int:
000B08r 2  A5 rr                LDA     tok_ival_lo
000B0Ar 2  85 rr                STA     tmp2
000B0Cr 2  A5 rr                LDA     tok_ival_hi
000B0Er 2  85 rr                STA     tmp2+1
000B10r 2  20 rr rr             JSR     next_token      ; consume INT
000B13r 2  80 0F                BRA     @add_const
000B15r 2               @have_real:
000B15r 2  A5 rr                LDA     tok_ival_lo
000B17r 2  85 rr                STA     tmp2
000B19r 2  A5 rr                LDA     tok_ival_hi
000B1Br 2  85 rr                STA     tmp2+1
000B1Dr 2  A9 0A                LDA     #TY_REAL
000B1Fr 2  85 rr                STA     expr_type
000B21r 2  20 rr rr             JSR     next_token      ; consume REAL
000B24r 2               @add_const:
000B24r 2               ; apply negate flag if set
000B24r 2  A5 rr                LDA     scratch
000B26r 2  F0 0D                BEQ     @no_neg
000B28r 2  38                   SEC
000B29r 2  A9 00                LDA     #0
000B2Br 2  E5 rr                SBC     tmp2
000B2Dr 2  85 rr                STA     tmp2
000B2Fr 2  A9 00                LDA     #0
000B31r 2  E5 rr                SBC     tmp2+1
000B33r 2  85 rr                STA     tmp2+1
000B35r 2               @no_neg:
000B35r 2               ; install in symbol table — value lives at offsets 18-19
000B35r 2  20 rr rr             JSR     swap_ident_save
000B38r 2  A9 02                LDA     #SYM_CONST
000B3Ar 2  A6 rr                LDX     expr_type
000B3Cr 2  20 rr rr             JSR     symtab_add
000B3Fr 2  20 rr rr             JSR     swap_ident_save
000B42r 2               ; expect ';'
000B42r 2  A5 rr                LDA     tok_type
000B44r 2  C9 20                CMP     #TOK_SEMICOLON
000B46r 2  F0 03                BEQ     @pcd_semi
000B48r 2  4C rr rr             JMP     @loop
000B4Br 2               @pcd_semi:
000B4Br 2  20 rr rr             JSR     next_token
000B4Er 2  4C rr rr             JMP     @loop
000B51r 2               
000B51r 2               ; ---------------------------------------------------------------------------
000B51r 2               ; parse_type_decls — name = type_spec ;  { ... }
000B51r 2               ; Each binding registers a SYM_TYPE entry whose offset-17 byte holds the
000B51r 2               ; base TY_* code.  parse_type_spec resolves later references back to this
000B51r 2               ; base type via symtab_find.
000B51r 2               ; ---------------------------------------------------------------------------
000B51r 2               parse_type_decls:
000B51r 2               @loop:
000B51r 2  A5 rr                LDA     tok_type
000B53r 2  C9 01                CMP     #TOK_IDENT
000B55r 2  F0 01                BEQ     :+
000B57r 2  60                   RTS                     ; done — no more type decls
000B58r 2               :       ; save type name into save_name_buf (parse_type_spec clobbers ident_buf)
000B58r 2  A0 0F                LDY     #15
000B5Ar 2               @savename:
000B5Ar 2  B9 rr rr             LDA     ident_buf,y
000B5Dr 2  99 rr rr             STA     save_name_buf,y
000B60r 2  88                   DEY
000B61r 2  10 F7                BPL     @savename
000B63r 2  20 rr rr             JSR     next_token      ; consume name
000B66r 2               ; expect '='
000B66r 2  A5 rr                LDA     tok_type
000B68r 2  C9 14                CMP     #TOK_EQ
000B6Ar 2  D0 03                BNE     :+
000B6Cr 2  20 rr rr             JSR     next_token
000B6Fr 2               :       ; parse the type definition; A = TY_* code
000B6Fr 2  20 rr rr             JSR     parse_type_spec
000B72r 2  85 rr                STA     scratch         ; save base type code
000B74r 2               ; bring the saved name back into ident_buf for symtab_add
000B74r 2  20 rr rr             JSR     swap_ident_save
000B77r 2               ; SYM_TYPE has no storage; offset bytes are unused (overwritten below
000B77r 2               ; for record types, which need to remember size + field-table location).
000B77r 2  A9 00                LDA     #0
000B79r 2  85 rr                STA     tmp2
000B7Br 2  85 rr                STA     tmp2+1
000B7Dr 2  A9 05                LDA     #SYM_TYPE
000B7Fr 2  A6 rr                LDX     scratch
000B81r 2  20 rr rr             JSR     symtab_add
000B84r 2               ; If this is a RECORD alias, stash record_size in bytes 18-19 and
000B84r 2               ; first_field/field_count in bytes 22-23 so later var-decls and field
000B84r 2               ; lookups can recover it.
000B84r 2  A5 rr                LDA     scratch
000B86r 2  C9 06                CMP     #TY_RECORD
000B88r 2  D0 1C                BNE     @td_no_rec
000B8Ar 2  AD rr rr             LDA     record_size
000B8Dr 2  A0 12                LDY     #18
000B8Fr 2  91 rr                STA     (tmp3),y
000B91r 2  AD rr rr             LDA     record_size+1
000B94r 2  A0 13                LDY     #19
000B96r 2  91 rr                STA     (tmp3),y
000B98r 2  AD rr rr             LDA     record_first_field
000B9Br 2  A0 16                LDY     #22
000B9Dr 2  91 rr                STA     (tmp3),y
000B9Fr 2  AD rr rr             LDA     record_field_count
000BA2r 2  A0 17                LDY     #23
000BA4r 2  91 rr                STA     (tmp3),y
000BA6r 2               @td_no_rec:
000BA6r 2               ; expect ';'
000BA6r 2  A5 rr                LDA     tok_type
000BA8r 2  C9 20                CMP     #TOK_SEMICOLON
000BAAr 2  F0 03                BEQ     @ptd_semi
000BACr 2  4C rr rr             JMP     @loop
000BAFr 2               @ptd_semi:
000BAFr 2  20 rr rr             JSR     next_token
000BB2r 2  4C rr rr             JMP     @loop
000BB5r 2               
000BB5r 2               ; ---------------------------------------------------------------------------
000BB5r 2               ; parse_var_decls — name { , name } : type ;  { ... }
000BB5r 2               ; All names on one line share the same type, allocated in order.
000BB5r 2               ; ---------------------------------------------------------------------------
000BB5r 2               parse_var_decls:
000BB5r 2               @decl_loop:
000BB5r 2  A5 rr                LDA     tok_type
000BB7r 2  C9 01                CMP     #TOK_IDENT
000BB9r 2  F0 01                BEQ     :+
000BBBr 2  60                   RTS                     ; done — no more var decls
000BBCr 2               :       ; --- collect comma-separated names into var_name_buf ---
000BBCr 2  A9 00                LDA     #0
000BBEr 2  8D rr rr             STA     var_name_count
000BC1r 2               @collect:
000BC1r 2  A5 rr                LDA     tok_type
000BC3r 2  C9 01                CMP     #TOK_IDENT
000BC5r 2  D0 31                BNE     @end_collect
000BC7r 2  AD rr rr             LDA     var_name_count
000BCAr 2  C9 08                CMP     #8
000BCCr 2  B0 1C                BCS     @skip_save
000BCEr 2                       ; tmp2 = var_name_buf + count*16   (count<8 → fits without manual carry)
000BCEr 2  0A                   ASL
000BCFr 2  0A                   ASL
000BD0r 2  0A                   ASL
000BD1r 2  0A                   ASL                     ; *16
000BD2r 2  18                   CLC
000BD3r 2  69 rr                ADC     #<var_name_buf
000BD5r 2  85 rr                STA     tmp2
000BD7r 2  A9 00                LDA     #0
000BD9r 2  69 rr                ADC     #>var_name_buf
000BDBr 2  85 rr                STA     tmp2+1
000BDDr 2  A0 0F                LDY     #15
000BDFr 2               @cp_in:
000BDFr 2  B9 rr rr             LDA     ident_buf,y
000BE2r 2  91 rr                STA     (tmp2),y
000BE4r 2  88                   DEY
000BE5r 2  10 F8                BPL     @cp_in
000BE7r 2  EE rr rr             INC     var_name_count
000BEAr 2               @skip_save:
000BEAr 2  20 rr rr             JSR     next_token      ; consume name
000BEDr 2  A5 rr                LDA     tok_type
000BEFr 2  C9 1F                CMP     #TOK_COMMA
000BF1r 2  D0 05                BNE     @end_collect
000BF3r 2  20 rr rr             JSR     next_token      ; consume ','
000BF6r 2  80 C9                BRA     @collect
000BF8r 2               @end_collect:
000BF8r 2               ; expect ':'
000BF8r 2  A5 rr                LDA     tok_type
000BFAr 2  C9 21                CMP     #TOK_COLON
000BFCr 2  D0 03                BNE     :+
000BFEr 2  20 rr rr             JSR     next_token
000C01r 2               :       ; parse type — A = TY_*
000C01r 2  20 rr rr             JSR     parse_type_spec
000C04r 2  85 rr                STA     scratch         ; stash type
000C06r 2               ; --- add each collected name to symbol table ---
000C06r 2               ; NOTE: consume ';' AFTER the add loop so next_token doesn't clobber
000C06r 2               ; ident_buf before @cp_out restores the saved name.
000C06r 2  A2 00                LDX     #0
000C08r 2               @add_loop:
000C08r 2  EC rr rr             CPX     var_name_count
000C0Br 2  90 03                BCC     :+
000C0Dr 2  4C rr rr             JMP     @post_add       ; out-of-range branch — use jmp
000C10r 2               :
000C10r 2  DA                   PHX                     ; preserve loop counter across symtab_add
000C11r 2               ; tmp2 = var_name_buf + X*16
000C11r 2  8A                   TXA
000C12r 2  0A                   ASL
000C13r 2  0A                   ASL
000C14r 2  0A                   ASL
000C15r 2  0A                   ASL
000C16r 2  18                   CLC
000C17r 2  69 rr                ADC     #<var_name_buf
000C19r 2  85 rr                STA     tmp2
000C1Br 2  A9 00                LDA     #0
000C1Dr 2  69 rr                ADC     #>var_name_buf
000C1Fr 2  85 rr                STA     tmp2+1
000C21r 2               ; copy slot → ident_buf so symtab_add sees the right name
000C21r 2  A0 0F                LDY     #15
000C23r 2               @cp_out:
000C23r 2  B1 rr                LDA     (tmp2),Y
000C25r 2  99 rr rr             STA     ident_buf,y
000C28r 2  88                   DEY
000C29r 2  10 F8                BPL     @cp_out
000C2Br 2               ; allocate storage — global if at top level, else from proc local AR
000C2Br 2  A5 rr                LDA     scope_depth
000C2Dr 2  F0 2D                BEQ     @gv_alloc
000C2Fr 2               ; local: tmp2 = local_alloc_off; bump by per-type size
000C2Fr 2  AD rr rr             LDA     local_alloc_off
000C32r 2  85 rr                STA     tmp2
000C34r 2  A9 00                LDA     #0
000C36r 2  85 rr                STA     tmp2+1
000C38r 2  A5 rr                LDA     scratch                 ; type code
000C3Ar 2  C9 06                CMP     #TY_RECORD
000C3Cr 2  F0 0B                BEQ     @lv_rec
000C3Er 2               ; default scalar / pointer / etc — 2 bytes
000C3Er 2  18                   CLC
000C3Fr 2  AD rr rr             LDA     local_alloc_off
000C42r 2  69 02                ADC     #2
000C44r 2  8D rr rr             STA     local_alloc_off
000C47r 2  80 33                BRA     @do_va_add
000C49r 2               @lv_rec:
000C49r 2  18                   CLC
000C4Ar 2  AD rr rr             LDA     local_alloc_off
000C4Dr 2  6D rr rr             ADC     record_size
000C50r 2  8D rr rr             STA     local_alloc_off
000C53r 2                       ; record_size+1 is normally 0 (records < 256 bytes) but
000C53r 2                       ; propagate the carry to be safe.
000C53r 2  A9 00                LDA     #0
000C55r 2  6D rr rr             ADC     record_size+1
000C58r 2  F0 22                BEQ     @do_va_add              ; no high-byte growth
000C5Ar 2                       ; would overflow byte counter; not handled — abort cleanly
000C5Ar 2  80 20                BRA     @do_va_add
000C5Cr 2               @gv_alloc:
000C5Cr 2  A5 rr                LDA     scratch
000C5Er 2  C9 05                CMP     #TY_ARRAY
000C60r 2  F0 0D                BEQ     @gv_array
000C62r 2  C9 06                CMP     #TY_RECORD
000C64r 2  F0 0E                BEQ     @gv_record
000C66r 2  C9 08                CMP     #TY_TEXT
000C68r 2  F0 0F                BEQ     @gv_text
000C6Ar 2  20 rr rr             JSR     codegen_alloc_global    ; scalar: 2 bytes, offset in tmp2
000C6Dr 2  80 0D                BRA     @do_va_add
000C6Fr 2               @gv_array:
000C6Fr 2  20 rr rr             JSR     codegen_alloc_array_global  ; array: right size, adj offset in tmp2
000C72r 2  80 08                BRA     @do_va_add
000C74r 2               @gv_record:
000C74r 2  20 rr rr             JSR     codegen_alloc_record_global ; record: record_size bytes, offset in tmp2
000C77r 2  80 03                BRA     @do_va_add
000C79r 2               @gv_text:
000C79r 2  20 rr rr             JSR     codegen_alloc_text_global   ; TEXT file: 168 bytes, offset in tmp2
000C7Cr 2               @do_va_add:
000C7Cr 2  A5 rr                LDA     scratch         ; type code
000C7Er 2  AA                   TAX
000C7Fr 2  A9 01                LDA     #SYM_VAR
000C81r 2  20 rr rr             JSR     symtab_add      ; tmp3 = pointer to new entry
000C84r 2               ; type-specific metadata in entry bytes 22-23
000C84r 2  A5 rr                LDA     scratch
000C86r 2  C9 05                CMP     #TY_ARRAY
000C88r 2  D0 0F                BNE     @va_chk_rec
000C8Ar 2  AD rr rr             LDA     array_elem_ty
000C8Dr 2  A0 16                LDY     #22
000C8Fr 2  91 rr                STA     (tmp3),y
000C91r 2  A9 02                LDA     #2              ; elemsize = 2 (word)
000C93r 2  A0 17                LDY     #23
000C95r 2  91 rr                STA     (tmp3),y
000C97r 2  80 12                BRA     @va_done
000C99r 2               @va_chk_rec:
000C99r 2  C9 06                CMP     #TY_RECORD
000C9Br 2  D0 0E                BNE     @va_done
000C9Dr 2  AD rr rr             LDA     record_first_field
000CA0r 2  A0 16                LDY     #22
000CA2r 2  91 rr                STA     (tmp3),y
000CA4r 2  AD rr rr             LDA     record_field_count
000CA7r 2  A0 17                LDY     #23
000CA9r 2  91 rr                STA     (tmp3),y
000CABr 2               @va_done:
000CABr 2  FA                   PLX
000CACr 2  E8                   INX
000CADr 2  4C rr rr             JMP     @add_loop       ; jmp — body grew past bra range
000CB0r 2               @post_add:
000CB0r 2               ; now safe to consume ';' — ident_buf already used
000CB0r 2  A5 rr                LDA     tok_type
000CB2r 2  C9 20                CMP     #TOK_SEMICOLON
000CB4r 2  D0 03                BNE     @pva_next
000CB6r 2  20 rr rr             JSR     next_token
000CB9r 2               @pva_next:
000CB9r 2  4C rr rr             JMP     @decl_loop
000CBCr 2               
000CBCr 2               ; swap 16 bytes between ident_buf and save_name_buf
000CBCr 2               swap_ident_save:
000CBCr 2  A0 0F                LDY     #15
000CBEr 2               @sw:
000CBEr 2  B9 rr rr             LDA     ident_buf,y
000CC1r 2  BE rr rr             LDX     save_name_buf,y
000CC4r 2  99 rr rr             STA     save_name_buf,y
000CC7r 2  8A                   TXA
000CC8r 2  99 rr rr             STA     ident_buf,y
000CCBr 2  88                   DEY
000CCCr 2  10 F0                BPL     @sw
000CCEr 2  60                   RTS
000CCFr 2               
000CCFr 2               ; field_name_slot_ptr â€” tmp2 = pointer to the current RECORD depth's
000CCFr 2               ; field-name slot. A = slot index (0..7).
000CCFr 2               field_name_slot_ptr:
000CCFr 2  0A                   ASL
000CD0r 2  0A                   ASL
000CD1r 2  0A                   ASL
000CD2r 2  0A                   ASL                             ; slot * 16
000CD3r 2  85 rr                STA     tmp2
000CD5r 2  A9 00                LDA     #0
000CD7r 2  85 rr                STA     tmp2+1
000CD9r 2  AE rr rr             LDX     field_depth
000CDCr 2  CA                   DEX                             ; 1-based depth -> 0-based slice index
000CDDr 2               @fnsp_depth:
000CDDr 2  E0 00                CPX     #0
000CDFr 2  F0 0E                BEQ     @fnsp_base
000CE1r 2  18                   CLC
000CE2r 2  A5 rr                LDA     tmp2
000CE4r 2  69 80                ADC     #$80
000CE6r 2  85 rr                STA     tmp2
000CE8r 2  90 02                BCC     :+
000CEAr 2  E6 rr                INC     tmp2+1
000CECr 2  CA           :       DEX
000CEDr 2  80 EE                BRA     @fnsp_depth
000CEFr 2               @fnsp_base:
000CEFr 2  18                   CLC
000CF0r 2  A5 rr                LDA     tmp2
000CF2r 2  69 rr                ADC     #<field_name_buf
000CF4r 2  85 rr                STA     tmp2
000CF6r 2  A5 rr                LDA     tmp2+1
000CF8r 2  69 rr                ADC     #>field_name_buf
000CFAr 2  85 rr                STA     tmp2+1
000CFCr 2  60                   RTS
000CFDr 2               
000CFDr 2               ; uses_name_slot_ptr — tmp2 = pointer to USES-name slot X (0..7)
000CFDr 2               uses_name_slot_ptr:
000CFDr 2  8A                   TXA
000CFEr 2  0A                   ASL
000CFFr 2  0A                   ASL
000D00r 2  0A                   ASL
000D01r 2  0A                   ASL
000D02r 2  18                   CLC
000D03r 2  69 rr                ADC     #<uses_name_buf
000D05r 2  85 rr                STA     tmp2
000D07r 2  A9 00                LDA     #0
000D09r 2  69 rr                ADC     #>uses_name_buf
000D0Br 2  85 rr                STA     tmp2+1
000D0Dr 2  60                   RTS
000D0Er 2               
000D0Er 2               ; used_unit_slot_ptr — tmp2 = pointer to imported-unit slot X (0..7)
000D0Er 2               used_unit_slot_ptr:
000D0Er 2  8A                   TXA
000D0Fr 2  0A                   ASL
000D10r 2  0A                   ASL
000D11r 2  0A                   ASL
000D12r 2  0A                   ASL
000D13r 2  18                   CLC
000D14r 2  69 rr                ADC     #<used_unit_buf
000D16r 2  85 rr                STA     tmp2
000D18r 2  A9 00                LDA     #0
000D1Ar 2  69 rr                ADC     #>used_unit_buf
000D1Cr 2  85 rr                STA     tmp2+1
000D1Er 2  60                   RTS
000D1Fr 2               
000D1Fr 2               ; store_proc_param_type — record the current parameter's type code in the
000D1Fr 2               ; owning proc/func entry at byte 24+proc_param_count (up to 8 params).
000D1Fr 2               store_proc_param_type:
000D1Fr 2  48                   PHA
000D20r 2  AC rr rr             LDY     proc_param_count
000D23r 2  C0 08                CPY     #8
000D25r 2  B0 13                BCS     @sppt_drop
000D27r 2  AD rr rr             LDA     proc_entry_idx
000D2Ar 2  85 rr                STA     tmp3
000D2Cr 2  AD rr rr             LDA     proc_entry_idx+1
000D2Fr 2  85 rr                STA     tmp3+1
000D31r 2  98                   TYA
000D32r 2  18                   CLC
000D33r 2  69 18                ADC     #24
000D35r 2  A8                   TAY
000D36r 2  68                   PLA
000D37r 2  91 rr                STA     (tmp3),y
000D39r 2  60                   RTS
000D3Ar 2               @sppt_drop:
000D3Ar 2  68                   PLA
000D3Br 2  60                   RTS
000D3Cr 2               
000D3Cr 2               ; ---------------------------------------------------------------------------
000D3Cr 2               ; parse_type_spec — consume type token(s), return TY_* code in A
000D3Cr 2               ; ---------------------------------------------------------------------------
000D3Cr 2               parse_type_spec:
000D3Cr 2  A5 rr                LDA     tok_type
000D3Er 2  C9 01                CMP     #TOK_IDENT
000D40r 2  F0 03                BEQ     :+
000D42r 2  4C rr rr             JMP     @not_ident
000D45r 2               :
000D45r 2               ; First check for a user-defined SYM_TYPE alias — built-ins like
000D45r 2               ; INTEGER/CHAR/BOOLEAN aren't in the symtab so this lookup falls
000D45r 2               ; through harmlessly when there's no user binding.
000D45r 2  20 rr rr             JSR     symtab_find
000D48r 2  90 34                BCC     @builtin
000D4Ar 2  A0 10                LDY     #16
000D4Cr 2  B1 rr                LDA     (tmp3),y
000D4Er 2  C9 05                CMP     #SYM_TYPE
000D50r 2  D0 2C                BNE     @builtin
000D52r 2  A0 11                LDY     #17
000D54r 2  B1 rr                LDA     (tmp3),y
000D56r 2  85 rr                STA     scratch         ; preserve across next_token
000D58r 2               ; If alias resolves to a RECORD, copy the record metadata back into the
000D58r 2               ; record_* globals so the caller (parse_var_decls) sees it.
000D58r 2  C9 06                CMP     #TY_RECORD
000D5Ar 2  D0 1C                BNE     @sty_no_rec
000D5Cr 2  A0 12                LDY     #18
000D5Er 2  B1 rr                LDA     (tmp3),y
000D60r 2  8D rr rr             STA     record_size
000D63r 2  A0 13                LDY     #19
000D65r 2  B1 rr                LDA     (tmp3),y
000D67r 2  8D rr rr             STA     record_size+1
000D6Ar 2  A0 16                LDY     #22
000D6Cr 2  B1 rr                LDA     (tmp3),y
000D6Er 2  8D rr rr             STA     record_first_field
000D71r 2  A0 17                LDY     #23
000D73r 2  B1 rr                LDA     (tmp3),y
000D75r 2  8D rr rr             STA     record_field_count
000D78r 2               @sty_no_rec:
000D78r 2  20 rr rr             JSR     next_token
000D7Br 2  A5 rr                LDA     scratch
000D7Dr 2  60                   RTS
000D7Er 2               @builtin:
000D7Er 2               ; check for built-in type names
000D7Er 2  AD rr rr             LDA     ident_buf       ; length
000D81r 2  C9 07                CMP     #7
000D83r 2  D0 20                BNE     @chk3
000D85r 2               ; "INTEGER" (7 chars)
000D85r 2  AD rr rr             LDA     ident_buf+1
000D88r 2  C9 49                CMP     #'I'
000D8Ar 2  D0 06                BNE     @chk_bool
000D8Cr 2  20 rr rr             JSR     next_token
000D8Fr 2  A9 01                LDA     #TY_INT
000D91r 2  60                   RTS
000D92r 2               @chk_bool:
000D92r 2  AD rr rr             LDA     ident_buf+1
000D95r 2  C9 42                CMP     #'B'
000D97r 2  D0 06                BNE     @chk_str
000D99r 2  20 rr rr             JSR     next_token
000D9Cr 2  A9 03                LDA     #TY_BOOL
000D9Er 2  60                   RTS
000D9Fr 2               @chk_str:
000D9Fr 2  20 rr rr             JSR     next_token
000DA2r 2  A9 01                LDA     #TY_INT         ; default
000DA4r 2  60                   RTS
000DA5r 2               @chk3:
000DA5r 2  C9 04                CMP     #4
000DA7r 2  D0 27                BNE     @chk6
000DA9r 2               ; 4-char built-in types: "CHAR", "TEXT", or "REAL"
000DA9r 2  AD rr rr             LDA     ident_buf+1
000DACr 2  C9 43                CMP     #'C'
000DAEr 2  D0 06                BNE     @chk_text
000DB0r 2  20 rr rr             JSR     next_token
000DB3r 2  A9 02                LDA     #TY_CHAR
000DB5r 2  60                   RTS
000DB6r 2               @chk_text:
000DB6r 2  C9 54                CMP     #'T'
000DB8r 2  D0 06                BNE     @chk_real
000DBAr 2  20 rr rr             JSR     next_token
000DBDr 2  A9 08                LDA     #TY_TEXT
000DBFr 2  60                   RTS
000DC0r 2               @chk_real:
000DC0r 2  C9 52                CMP     #'R'
000DC2r 2  D0 06                BNE     @chk3b
000DC4r 2  20 rr rr             JSR     next_token
000DC7r 2  A9 0A                LDA     #TY_REAL
000DC9r 2  60                   RTS
000DCAr 2               @chk3b:
000DCAr 2  20 rr rr             JSR     next_token
000DCDr 2  A9 01                LDA     #TY_INT
000DCFr 2  60                   RTS
000DD0r 2               @chk6:
000DD0r 2  C9 06                CMP     #6
000DD2r 2  D0 06                BNE     @default_type
000DD4r 2               ; "STRING" (6)
000DD4r 2  20 rr rr             JSR     next_token
000DD7r 2  A9 04                LDA     #TY_STRING
000DD9r 2  60                   RTS
000DDAr 2               @default_type:
000DDAr 2  20 rr rr             JSR     next_token
000DDDr 2  A9 01                LDA     #TY_INT
000DDFr 2  60                   RTS
000DE0r 2               @not_ident:
000DE0r 2  A5 rr                LDA     tok_type
000DE2r 2  C9 41                CMP     #TOK_ARRAY
000DE4r 2  D0 56                BNE     @not_array
000DE6r 2               ; --- ARRAY [lo..hi] OF basetype ---
000DE6r 2  20 rr rr             JSR     next_token      ; consume ARRAY → expect '['
000DE9r 2  A5 rr                LDA     tok_type
000DEBr 2  C9 1D                CMP     #TOK_LBRACK
000DEDr 2  D0 03                BNE     :+
000DEFr 2  20 rr rr             JSR     next_token      ; consume '['
000DF2r 2               :
000DF2r 2               ; parse lo bound (integer literal)
000DF2r 2  A5 rr                LDA     tok_ival_lo
000DF4r 2  8D rr rr             STA     array_lo
000DF7r 2  A5 rr                LDA     tok_ival_hi
000DF9r 2  8D rr rr             STA     array_lo+1
000DFCr 2  A5 rr                LDA     tok_type
000DFEr 2  C9 02                CMP     #TOK_INT
000E00r 2  D0 03                BNE     :+
000E02r 2  20 rr rr             JSR     next_token      ; consume lo
000E05r 2               :
000E05r 2               ; expect '..'
000E05r 2  A5 rr                LDA     tok_type
000E07r 2  C9 23                CMP     #TOK_DOTDOT
000E09r 2  D0 03                BNE     :+
000E0Br 2  20 rr rr             JSR     next_token      ; consume '..'
000E0Er 2               :
000E0Er 2               ; parse hi bound
000E0Er 2  A5 rr                LDA     tok_ival_lo
000E10r 2  8D rr rr             STA     array_hi
000E13r 2  A5 rr                LDA     tok_ival_hi
000E15r 2  8D rr rr             STA     array_hi+1
000E18r 2  A5 rr                LDA     tok_type
000E1Ar 2  C9 02                CMP     #TOK_INT
000E1Cr 2  D0 03                BNE     :+
000E1Er 2  20 rr rr             JSR     next_token      ; consume hi
000E21r 2               :
000E21r 2               ; expect ']'
000E21r 2  A5 rr                LDA     tok_type
000E23r 2  C9 1E                CMP     #TOK_RBRACK
000E25r 2  D0 03                BNE     :+
000E27r 2  20 rr rr             JSR     next_token      ; consume ']'
000E2Ar 2               :
000E2Ar 2               ; expect 'OF'
000E2Ar 2  A5 rr                LDA     tok_type
000E2Cr 2  C9 51                CMP     #TOK_OF
000E2Er 2  D0 03                BNE     :+
000E30r 2  20 rr rr             JSR     next_token      ; consume 'OF'
000E33r 2               :
000E33r 2               ; parse element type (recursive — handles named types, built-ins)
000E33r 2  20 rr rr             JSR     parse_type_spec
000E36r 2  8D rr rr             STA     array_elem_ty
000E39r 2  A9 05                LDA     #TY_ARRAY
000E3Br 2  60                   RTS
000E3Cr 2               @not_array:
000E3Cr 2  A5 rr                LDA     tok_type
000E3Er 2  C9 57                CMP     #TOK_SET
000E40r 2  F0 03                BEQ     :+
000E42r 2  4C rr rr             JMP     @not_set
000E45r 2               :
000E45r 2               ; --- SET OF lo..hi ---
000E45r 2               ; v1 stores sets as 16-bit masks over element values 0..15, so the
000E45r 2               ; declared bounds must fit within that range. The bounds are validated
000E45r 2               ; here but not otherwise retained for later type-checking.
000E45r 2  20 rr rr             JSR     next_token              ; consume SET
000E48r 2  A5 rr                LDA     tok_type
000E4Ar 2  C9 51                CMP     #TOK_OF
000E4Cr 2  D0 03                BNE     :+
000E4Er 2  20 rr rr             JSR     next_token              ; consume OF
000E51r 2               :
000E51r 2  A5 rr                LDA     tok_type
000E53r 2  C9 02                CMP     #TOK_INT
000E55r 2  D0 37                BNE     @set_bad
000E57r 2  A5 rr                LDA     tok_ival_hi
000E59r 2  D0 33                BNE     @set_bad
000E5Br 2  A5 rr                LDA     tok_ival_lo
000E5Dr 2  8D rr rr             STA     set_lit_lo
000E60r 2  C9 10                CMP     #16
000E62r 2  B0 2A                BCS     @set_bad
000E64r 2  20 rr rr             JSR     next_token
000E67r 2  A5 rr                LDA     tok_type
000E69r 2  C9 23                CMP     #TOK_DOTDOT
000E6Br 2  D0 21                BNE     @set_bad
000E6Dr 2  20 rr rr             JSR     next_token
000E70r 2  A5 rr                LDA     tok_type
000E72r 2  C9 02                CMP     #TOK_INT
000E74r 2  D0 18                BNE     @set_bad
000E76r 2  A5 rr                LDA     tok_ival_hi
000E78r 2  D0 14                BNE     @set_bad
000E7Ar 2  A5 rr                LDA     tok_ival_lo
000E7Cr 2  8D rr rr             STA     set_lit_hi
000E7Fr 2  C9 10                CMP     #16
000E81r 2  B0 0B                BCS     @set_bad
000E83r 2  CD rr rr             CMP     set_lit_lo
000E86r 2  90 06                BCC     @set_bad
000E88r 2  20 rr rr             JSR     next_token
000E8Br 2  A9 09                LDA     #TY_SET
000E8Dr 2  60                   RTS
000E8Er 2               @set_bad:
000E8Er 2  A9 rr                LDA     #<err_type
000E90r 2  85 rr                STA     tmp0
000E92r 2  A9 rr                LDA     #>err_type
000E94r 2  85 rr                STA     tmp0+1
000E96r 2  20 rr rr             JSR     compile_error
000E99r 2  A5 rr                LDA     tok_type
000E9Br 2  C9 02                CMP     #TOK_INT
000E9Dr 2  D0 03                BNE     :+
000E9Fr 2  20 rr rr             JSR     next_token
000EA2r 2  A9 09        :       LDA     #TY_SET
000EA4r 2  60                   RTS
000EA5r 2               @not_set:
000EA5r 2  A5 rr                LDA     tok_type
000EA7r 2  C9 55                CMP     #TOK_RECORD
000EA9r 2  F0 03                BEQ     :+
000EABr 2  4C rr rr             JMP     @not_record
000EAEr 2               :
000EAEr 2               ; --- RECORD field { ; field } END ---
000EAEr 2               ; Each field group: name { , name } : type
000EAEr 2               ; All fields are stored as 2-byte slots; offsets are 0, 2, 4, ...
000EAEr 2  20 rr rr             JSR     next_token              ; consume RECORD
000EB1r 2  EE rr rr             INC     field_depth             ; mark new fields as belonging
000EB4r 2                                                       ; to this nesting level
000EB4r 2  A9 00                LDA     #0
000EB6r 2  8D rr rr             STA     record_size
000EB9r 2  8D rr rr             STA     record_size+1
000EBCr 2  8D rr rr             STA     record_field_count
000EBFr 2  AD rr rr             LDA     field_table_count
000EC2r 2  8D rr rr             STA     record_first_field
000EC5r 2               @rec_loop:
000EC5r 2  A5 rr                LDA     tok_type
000EC7r 2  C9 49                CMP     #TOK_END
000EC9r 2  D0 03                BNE     :+
000ECBr 2  4C rr rr             JMP     @rec_end
000ECEr 2               :
000ECEr 2  C9 01                CMP     #TOK_IDENT
000ED0r 2  F0 03                BEQ     :+
000ED2r 2  4C rr rr             JMP     @rec_end                ; safety — bail on unexpected token
000ED5r 2               :
000ED5r 2               ; --- collect comma-separated field names into field_name_buf ---
000ED5r 2               ;     (separate from var_name_buf so an inline RECORD inside a VAR
000ED5r 2               ;      decl doesn't clobber the outer variable names being collected)
000ED5r 2  AE rr rr             LDX     field_depth
000ED8r 2  CA                   DEX
000ED9r 2  A9 00                LDA     #0
000EDBr 2  9D rr rr             STA     field_name_count,x
000EDEr 2               @rec_collect:
000EDEr 2  A5 rr                LDA     tok_type
000EE0r 2  C9 01                CMP     #TOK_IDENT
000EE2r 2  D0 2D                BNE     @rec_endcol
000EE4r 2  AE rr rr             LDX     field_depth
000EE7r 2  CA                   DEX
000EE8r 2  BD rr rr             LDA     field_name_count,x
000EEBr 2  C9 08                CMP     #8
000EEDr 2  B0 14                BCS     @rec_skip_save
000EEFr 2  20 rr rr             JSR     field_name_slot_ptr
000EF2r 2  A0 0F                LDY     #15
000EF4r 2               @rec_cpin:
000EF4r 2  B9 rr rr             LDA     ident_buf,y
000EF7r 2  91 rr                STA     (tmp2),y
000EF9r 2  88                   DEY
000EFAr 2  10 F8                BPL     @rec_cpin
000EFCr 2  AE rr rr             LDX     field_depth
000EFFr 2  CA                   DEX
000F00r 2  FE rr rr             INC     field_name_count,x
000F03r 2               @rec_skip_save:
000F03r 2  20 rr rr             JSR     next_token              ; consume name
000F06r 2  A5 rr                LDA     tok_type
000F08r 2  C9 1F                CMP     #TOK_COMMA
000F0Ar 2  D0 05                BNE     @rec_endcol
000F0Cr 2  20 rr rr             JSR     next_token              ; consume ','
000F0Fr 2  80 CD                BRA     @rec_collect
000F11r 2               @rec_endcol:
000F11r 2               ; expect ':'
000F11r 2  A5 rr                LDA     tok_type
000F13r 2  C9 21                CMP     #TOK_COLON
000F15r 2  D0 03                BNE     :+
000F17r 2  20 rr rr             JSR     next_token
000F1Ar 2               :       ; parse field type — recurse; result in A.  Save outer record
000F1Ar 2               ; bookkeeping (size + first_field + field_count) so a nested RECORD
000F1Ar 2               ; can use the same globals without losing our state.  After the inner
000F1Ar 2               ; parse, capture the inner's metadata into nest_save_* and restore.
000F1Ar 2  AD rr rr             LDA     record_size
000F1Dr 2  48                   PHA
000F1Er 2  AD rr rr             LDA     record_size+1
000F21r 2  48                   PHA
000F22r 2  AD rr rr             LDA     record_first_field
000F25r 2  48                   PHA
000F26r 2  AD rr rr             LDA     record_field_count
000F29r 2  48                   PHA
000F2Ar 2  20 rr rr             JSR     parse_type_spec         ; may recurse into RECORD
000F2Dr 2  85 rr                STA     scratch                 ; field type code
000F2Fr 2               ; capture inner's metadata for @rec_addf (only meaningful for TY_RECORD)
000F2Fr 2  AD rr rr             LDA     record_size
000F32r 2  8D rr rr             STA     nest_save_size
000F35r 2  AD rr rr             LDA     record_size+1
000F38r 2  8D rr rr             STA     nest_save_size+1
000F3Br 2  AD rr rr             LDA     record_first_field
000F3Er 2  8D rr rr             STA     nest_save_first
000F41r 2  AD rr rr             LDA     record_field_count
000F44r 2  8D rr rr             STA     nest_save_count
000F47r 2               ; restore outer record bookkeeping
000F47r 2  68                   PLA
000F48r 2  8D rr rr             STA     record_field_count
000F4Br 2  68                   PLA
000F4Cr 2  8D rr rr             STA     record_first_field
000F4Fr 2  68                   PLA
000F50r 2  8D rr rr             STA     record_size+1
000F53r 2  68                   PLA
000F54r 2  8D rr rr             STA     record_size
000F57r 2               ; --- add each collected name to field_table at current record_size ---
000F57r 2  A2 00                LDX     #0
000F59r 2               @rec_addf:
000F59r 2  8A                   TXA
000F5Ar 2  AC rr rr             LDY     field_depth
000F5Dr 2  88                   DEY
000F5Er 2  D9 rr rr             CMP     field_name_count,y
000F61r 2  B0 68                BCS     @rec_endf
000F63r 2  DA                   PHX
000F64r 2  8A                   TXA
000F65r 2  20 rr rr             JSR     field_name_slot_ptr
000F68r 2  A0 0F                LDY     #15
000F6Ar 2               @rec_cpout:
000F6Ar 2  B1 rr                LDA     (tmp2),y
000F6Cr 2  99 rr rr             STA     ident_buf,y
000F6Fr 2  88                   DEY
000F70r 2  10 F8                BPL     @rec_cpout
000F72r 2               ; If the previous field group's type was an inline RECORD, its fields
000F72r 2               ; got appended to field_table BEFORE this outer field. Bump
000F72r 2               ; record_first_field past those leading slots so the lookup-scan starts
000F72r 2               ; at the first outer-depth field instead of an inner one. Only applies
000F72r 2               ; when no outer fields have been recorded yet.
000F72r 2  AD rr rr             LDA     record_field_count
000F75r 2  D0 06                BNE     :+
000F77r 2  AD rr rr             LDA     field_table_count
000F7Ar 2  8D rr rr             STA     record_first_field
000F7Dr 2               :
000F7Dr 2               ; field_table_add: A=offset (record_size lo), X=type
000F7Dr 2               ;   Returns: A = newly-assigned field index
000F7Dr 2  AD rr rr             LDA     record_size
000F80r 2  A6 rr                LDX     scratch
000F82r 2  20 rr rr             JSR     field_table_add
000F85r 2               ; If this field's type is TY_RECORD, fold the inner record's
000F85r 2               ; first_field/count (saved in nest_save_*) into the parallel
000F85r 2               ; nested arrays so chained access can traverse it.
000F85r 2  48                   PHA                             ; save field index
000F86r 2  A6 rr                LDX     scratch                 ; field type
000F88r 2  E0 06                CPX     #TY_RECORD
000F8Ar 2  D0 0D                BNE     @rec_no_nest
000F8Cr 2  AA                   TAX                             ; X = field index (A still holds it)
000F8Dr 2  AD rr rr             LDA     nest_save_first
000F90r 2  9D rr rr             STA     field_nested_first,x
000F93r 2  AD rr rr             LDA     nest_save_count
000F96r 2  9D rr rr             STA     field_nested_count,x
000F99r 2               @rec_no_nest:
000F99r 2  68                   PLA                             ; restore (no longer needed)
000F9Ar 2  EE rr rr             INC     record_field_count
000F9Dr 2               ; advance record_size by this field's size:
000F9Dr 2               ;   record fields → nest_save_size (set by inner parse)
000F9Dr 2               ;   anything else → 2 (all scalars are word-sized)
000F9Dr 2  A6 rr                LDX     scratch
000F9Fr 2  E0 06                CPX     #TY_RECORD
000FA1r 2  F0 10                BEQ     @rec_adv_rec
000FA3r 2  18                   CLC
000FA4r 2  AD rr rr             LDA     record_size
000FA7r 2  69 02                ADC     #2
000FA9r 2  8D rr rr             STA     record_size
000FACr 2  90 03                BCC     :+
000FAEr 2  EE rr rr             INC     record_size+1
000FB1r 2  80 13        :       BRA     @rec_advanced
000FB3r 2               @rec_adv_rec:
000FB3r 2  18                   CLC
000FB4r 2  AD rr rr             LDA     record_size
000FB7r 2  6D rr rr             ADC     nest_save_size
000FBAr 2  8D rr rr             STA     record_size
000FBDr 2  AD rr rr             LDA     record_size+1
000FC0r 2  6D rr rr             ADC     nest_save_size+1
000FC3r 2  8D rr rr             STA     record_size+1
000FC6r 2               @rec_advanced:
000FC6r 2  FA                   PLX
000FC7r 2  E8                   INX
000FC8r 2  4C rr rr             JMP     @rec_addf
000FCBr 2               @rec_endf:
000FCBr 2               ; expect ';' between groups, or END
000FCBr 2  A5 rr                LDA     tok_type
000FCDr 2  C9 20                CMP     #TOK_SEMICOLON
000FCFr 2  D0 06                BNE     @rec_check_end
000FD1r 2  20 rr rr             JSR     next_token              ; consume ';'
000FD4r 2  4C rr rr             JMP     @rec_loop
000FD7r 2               @rec_check_end:
000FD7r 2  A5 rr                LDA     tok_type
000FD9r 2  C9 49                CMP     #TOK_END
000FDBr 2  F0 03                BEQ     :+
000FDDr 2  4C rr rr             JMP     @rec_loop               ; recover — try again
000FE0r 2               :
000FE0r 2               @rec_end:
000FE0r 2  20 rr rr             JSR     next_token              ; consume END
000FE3r 2  CE rr rr             DEC     field_depth             ; leaving this nesting level
000FE6r 2               ; record_field_count was per-named-field; recompute as the slot span so
000FE6r 2               ; field_lookup_in_record covers any inline-record sub-fields that got
000FE6r 2               ; physically interleaved between this record's named fields.
000FE6r 2  38                   SEC
000FE7r 2  AD rr rr             LDA     field_table_count
000FEAr 2  ED rr rr             SBC     record_first_field
000FEDr 2  8D rr rr             STA     record_field_count
000FF0r 2  A9 06                LDA     #TY_RECORD
000FF2r 2  60                   RTS
000FF3r 2               @not_record:
000FF3r 2  A5 rr                LDA     tok_type
000FF5r 2  C9 24                CMP     #TOK_CARET
000FF7r 2  D0 09                BNE     @not_caret
000FF9r 2               ; --- ^BASETYPE — pointer type. Element type recorded but not yet
000FF9r 2               ; type-checked; v1 only supports pointer-to-INTEGER (2-byte cell).
000FF9r 2  20 rr rr             JSR     next_token              ; consume '^'
000FFCr 2  20 rr rr             JSR     parse_type_spec         ; consume base type, result in A
000FFFr 2                       ; (base type code intentionally discarded — bump allocator
000FFFr 2                       ;  always grants 2 bytes per NEW; revisit when records land)
000FFFr 2  A9 07                LDA     #TY_PTR
001001r 2  60                   RTS
001002r 2               @not_caret:
001002r 2  20 rr rr             JSR     next_token
001005r 2  A9 01                LDA     #TY_INT
001007r 2  60                   RTS
001008r 2               
001008r 2               ; ---------------------------------------------------------------------------
001008r 2               ; parse_arg_lvalue — used for VAR-by-reference call arguments.  Expects the
001008r 2               ; current token to be an IDENT naming a variable; consumes the ident and
001008r 2               ; emits an opcode that pushes the variable's address.
001008r 2               ;
001008r 2               ;   SYM_VAR    global → OP_LDA_G <wordoff>
001008r 2               ;   SYM_VAR    local  → OP_LDA_L <byteoff>
001008r 2               ;   SYM_VARREF (passing a VAR param through) → OP_LDL <byteoff>   (the
001008r 2               ;              local slot itself already holds the upstream address)
001008r 2               ;
001008r 2               ; Anything else (literal, function call, undefined name) is silently ignored
001008r 2               ; — the argument slot will hold whatever was last on the stack.  Pascal
001008r 2               ; semantics say it's a compile error, but we emit no diagnostic for now.
001008r 2               ; ---------------------------------------------------------------------------
001008r 2               parse_arg_lvalue:
001008r 2  A5 rr                LDA     tok_type
00100Ar 2  C9 01                CMP     #TOK_IDENT
00100Cr 2  F0 01                BEQ     :+
00100Er 2  60                   RTS
00100Fr 2               :
00100Fr 2  20 rr rr             JSR     symtab_find
001012r 2  B0 01                BCS     :+
001014r 2  60                   RTS                     ; undefined — emit nothing
001015r 2               :       ; Snapshot kind, scope, offset before next_token clobbers tmp3.
001015r 2  A0 10                LDY     #16
001017r 2  B1 rr                LDA     (tmp3),y
001019r 2  48                   PHA                     ; kind
00101Ar 2  A0 14                LDY     #20
00101Cr 2  B1 rr                LDA     (tmp3),y
00101Er 2  48                   PHA                     ; scope
00101Fr 2  A0 13                LDY     #19
001021r 2  B1 rr                LDA     (tmp3),y
001023r 2  48                   PHA                     ; off hi
001024r 2  A0 12                LDY     #18
001026r 2  B1 rr                LDA     (tmp3),y
001028r 2  48                   PHA                     ; off lo (top)
001029r 2  20 rr rr             JSR     next_token      ; consume ident
00102Cr 2  68                   PLA                     ; off lo
00102Dr 2  AA                   TAX
00102Er 2  68                   PLA                     ; off hi
00102Fr 2  85 rr                STA     scratch
001031r 2  68                   PLA                     ; scope
001032r 2  A8                   TAY
001033r 2  68                   PLA                     ; kind
001034r 2  C9 08                CMP     #SYM_VARREF
001036r 2  F0 0C                BEQ     @lv_passthrough
001038r 2  C0 00                CPY     #0
00103Ar 2  D0 04                BNE     @lv_local
00103Cr 2  8A                   TXA
00103Dr 2  4C rr rr             JMP     emit_LDA_G
001040r 2               @lv_local:
001040r 2  8A                   TXA
001041r 2  4C rr rr             JMP     emit_LDA_L
001044r 2               @lv_passthrough:
001044r 2  8A                   TXA
001045r 2  4C rr rr             JMP     emit_LDL        ; slot already holds caller's address
001048r 2               
001048r 2               ; ---------------------------------------------------------------------------
001048r 2               ; with_lookup_field — search active WITH contexts for ident_buf as an
001048r 2               ; unqualified field name. Innermost WITH wins.
001048r 2               ; Returns: carry set if found, A=field offset, X=field type
001048r 2               ;          carry clear if not found
001048r 2               ; Side effects on hit:
001048r 2               ;   with_lookup_off/type      = matched field offset/type
001048r 2               ;   with_lookup_base_lo/hi    = hidden global holding the WITH base address
001048r 2               ;   with_lookup_first/count   = nested-record metadata for this field
001048r 2               ; ---------------------------------------------------------------------------
001048r 2               with_lookup_field:
001048r 2  AD rr rr             LDA     with_depth
00104Br 2  D0 02                BNE     :+
00104Dr 2  18                   CLC
00104Er 2  60                   RTS
00104Fr 2  AE rr rr     :       LDX     with_depth
001052r 2  CA                   DEX
001053r 2               @wlf_ctx:
001053r 2  86 rr                STX     tmp1
001055r 2  BC rr rr             LDY     with_field_count,x
001058r 2  BD rr rr             LDA     with_first_field,x
00105Br 2  84 rr                STY     scratch
00105Dr 2  A6 rr                LDX     scratch
00105Fr 2  20 rr rr             JSR     field_lookup_in_record
001062r 2  90 2B                BCC     @wlf_next
001064r 2  8D rr rr             STA     with_lookup_off
001067r 2  8A                   TXA
001068r 2  8D rr rr             STA     with_lookup_type
00106Br 2  A6 rr                LDX     tmp3
00106Dr 2  BD rr rr             LDA     field_nested_first,x
001070r 2  8D rr rr             STA     with_lookup_first
001073r 2  BD rr rr             LDA     field_nested_count,x
001076r 2  8D rr rr             STA     with_lookup_count
001079r 2  A6 rr                LDX     tmp1
00107Br 2  BD rr rr             LDA     with_base_lo,x
00107Er 2  8D rr rr             STA     with_lookup_base_lo
001081r 2  BD rr rr             LDA     with_base_hi,x
001084r 2  8D rr rr             STA     with_lookup_base_hi
001087r 2  AD rr rr             LDA     with_lookup_off
00108Ar 2  AE rr rr             LDX     with_lookup_type
00108Dr 2  38                   SEC
00108Er 2  60                   RTS
00108Fr 2               @wlf_next:
00108Fr 2  A6 rr                LDX     tmp1
001091r 2  E0 00                CPX     #0
001093r 2  F0 03                BEQ     @wlf_nf
001095r 2  CA                   DEX
001096r 2  80 BB                BRA     @wlf_ctx
001098r 2               @wlf_nf:
001098r 2  18                   CLC
001099r 2  60                   RTS
00109Ar 2               
00109Ar 2               ; emit_with_field_base — push the selected WITH record's base address, then
00109Ar 2               ; add the matched field offset (with_lookup_off) if nonzero.
00109Ar 2               emit_with_field_base:
00109Ar 2  AD rr rr             LDA     with_lookup_base_hi
00109Dr 2  85 rr                STA     scratch
00109Fr 2  AD rr rr             LDA     with_lookup_base_lo
0010A2r 2  20 rr rr             JSR     emit_LDG
0010A5r 2  AD rr rr             LDA     with_lookup_off
0010A8r 2  F0 06                BEQ     @ewfb_done
0010AAr 2  20 rr rr             JSR     emit_LDCI
0010ADr 2  20 rr rr             JSR     emit_ADI
0010B0r 2               @ewfb_done:
0010B0r 2  60                   RTS
0010B1r 2               
0010B1r 2               ; ---------------------------------------------------------------------------
0010B1r 2               ; parse_param_list — assumes '(' has already been consumed.  Parses zero or
0010B1r 2               ; more comma/semicolon-separated parameter groups, then ')'.  Each parameter
0010B1r 2               ; is added to symtab as SYM_VAR with offset = proc_param_count*2 and the
0010B1r 2               ; group's type code.  proc_param_count is incremented per param.
0010B1r 2               ;
0010B1r 2               ; Pascal supports two separator forms:
0010B1r 2               ;   ( A, B: INTEGER )            — names sharing one type, COMMA separated
0010B1r 2               ;   ( A: INTEGER; B: CHAR )      — different types, SEMICOLON between groups
0010B1r 2               ;   ( A, B: INTEGER; C: CHAR )   — both forms mixed
0010B1r 2               ;
0010B1r 2               ; Reuses var_name_buf (128 bytes / 8 names per group).  Safe because the
0010B1r 2               ; param list is fully parsed before parse_block runs (which is what calls
0010B1r 2               ; parse_var_decls).
0010B1r 2               ; ---------------------------------------------------------------------------
0010B1r 2               parse_param_list:
0010B1r 2  A9 00                LDA     #0
0010B3r 2  8D rr rr             STA     param_var_mask  ; reset bitmap (set by caller too — paranoia)
0010B6r 2               @group_loop:
0010B6r 2               ; A leading VAR keyword marks the entire group as by-reference.
0010B6r 2  A9 00                LDA     #0
0010B8r 2  8D rr rr             STA     group_is_var
0010BBr 2  A5 rr                LDA     tok_type
0010BDr 2  C9 5C                CMP     #TOK_VAR
0010BFr 2  D0 08                BNE     @no_var_kw
0010C1r 2  A9 01                LDA     #1
0010C3r 2  8D rr rr             STA     group_is_var
0010C6r 2  20 rr rr             JSR     next_token      ; consume VAR
0010C9r 2               @no_var_kw:
0010C9r 2  A5 rr                LDA     tok_type
0010CBr 2  C9 01                CMP     #TOK_IDENT
0010CDr 2  F0 03                BEQ     @have_ident     ; jmp trampoline — body is too big for bra
0010CFr 2  4C rr rr             JMP     @done_params
0010D2r 2               @have_ident:
0010D2r 2               ; --- collect comma-separated names of this group ---
0010D2r 2  A9 00                LDA     #0
0010D4r 2  8D rr rr             STA     var_name_count
0010D7r 2               @gcollect:
0010D7r 2  A5 rr                LDA     tok_type
0010D9r 2  C9 01                CMP     #TOK_IDENT
0010DBr 2  D0 31                BNE     @gend
0010DDr 2  AD rr rr             LDA     var_name_count
0010E0r 2  C9 08                CMP     #8
0010E2r 2  B0 1C                BCS     @gskip          ; buffer full — silently drop name
0010E4r 2  0A                   ASL
0010E5r 2  0A                   ASL
0010E6r 2  0A                   ASL
0010E7r 2  0A                   ASL
0010E8r 2  18                   CLC
0010E9r 2  69 rr                ADC     #<var_name_buf
0010EBr 2  85 rr                STA     tmp2
0010EDr 2  A9 00                LDA     #0
0010EFr 2  69 rr                ADC     #>var_name_buf
0010F1r 2  85 rr                STA     tmp2+1
0010F3r 2  A0 0F                LDY     #15
0010F5r 2               @gcp:
0010F5r 2  B9 rr rr             LDA     ident_buf,y
0010F8r 2  91 rr                STA     (tmp2),y
0010FAr 2  88                   DEY
0010FBr 2  10 F8                BPL     @gcp
0010FDr 2  EE rr rr             INC     var_name_count
001100r 2               @gskip:
001100r 2  20 rr rr             JSR     next_token      ; consume name
001103r 2  A5 rr                LDA     tok_type
001105r 2  C9 1F                CMP     #TOK_COMMA
001107r 2  D0 05                BNE     @gend
001109r 2  20 rr rr             JSR     next_token      ; consume ','
00110Cr 2  80 C9                BRA     @gcollect
00110Er 2               @gend:
00110Er 2               ; expect ':'
00110Er 2  A5 rr                LDA     tok_type
001110r 2  C9 21                CMP     #TOK_COLON
001112r 2  D0 03                BNE     :+
001114r 2  20 rr rr             JSR     next_token
001117r 2               :
001117r 2  20 rr rr             JSR     parse_type_spec
00111Ar 2  85 rr                STA     scratch         ; stash type for this group
00111Cr 2               ; --- add each collected name as SYM_VAR ---
00111Cr 2  A2 00                LDX     #0
00111Er 2               @addloop:
00111Er 2  EC rr rr             CPX     var_name_count
001121r 2  90 03                BCC     :+
001123r 2  4C rr rr             JMP     @groupdone
001126r 2               :
001126r 2  DA                   PHX
001127r 2  A5 rr                LDA     scratch
001129r 2  20 rr rr             JSR     store_proc_param_type
00112Cr 2               ; copy var_name_buf[X*16] → ident_buf
00112Cr 2  8A                   TXA
00112Dr 2  0A                   ASL
00112Er 2  0A                   ASL
00112Fr 2  0A                   ASL
001130r 2  0A                   ASL
001131r 2  18                   CLC
001132r 2  69 rr                ADC     #<var_name_buf
001134r 2  85 rr                STA     tmp2
001136r 2  A9 00                LDA     #0
001138r 2  69 rr                ADC     #>var_name_buf
00113Ar 2  85 rr                STA     tmp2+1
00113Cr 2  A0 0F                LDY     #15
00113Er 2               @cpout:
00113Er 2  B1 rr                LDA     (tmp2),y
001140r 2  99 rr rr             STA     ident_buf,y
001143r 2  88                   DEY
001144r 2  10 F8                BPL     @cpout
001146r 2               ; offset for this param = proc_param_count * 2
001146r 2  AD rr rr             LDA     proc_param_count
001149r 2  0A                   ASL
00114Ar 2  85 rr                STA     tmp2
00114Cr 2  A9 00                LDA     #0
00114Er 2  85 rr                STA     tmp2+1
001150r 2               ; If this is a VAR group, set the matching bit in param_var_mask
001150r 2               ; and use SYM_VARREF instead of SYM_VAR.
001150r 2  AD rr rr             LDA     group_is_var
001153r 2  F0 1E                BEQ     @use_var_kind
001155r 2               ; set bit (1 << proc_param_count) in param_var_mask (max 8 params)
001155r 2  AC rr rr             LDY     proc_param_count
001158r 2  C0 08                CPY     #8
00115Ar 2  B0 10                BCS     @skip_mask      ; >8 params: silently drop bit
00115Cr 2  A9 01                LDA     #1
00115Er 2               @shl:
00115Er 2  C0 00                CPY     #0
001160r 2  F0 04                BEQ     @done_shl
001162r 2  0A                   ASL
001163r 2  88                   DEY
001164r 2  80 F8                BRA     @shl
001166r 2               @done_shl:
001166r 2  0D rr rr             ORA     param_var_mask
001169r 2  8D rr rr             STA     param_var_mask
00116Cr 2               @skip_mask:
00116Cr 2  A5 rr                LDA     scratch         ; type
00116Er 2  AA                   TAX
00116Fr 2  A9 08                LDA     #SYM_VARREF
001171r 2  80 05                BRA     @do_add
001173r 2               @use_var_kind:
001173r 2  A5 rr                LDA     scratch         ; type
001175r 2  AA                   TAX
001176r 2  A9 01                LDA     #SYM_VAR
001178r 2               @do_add:
001178r 2  20 rr rr             JSR     symtab_add
00117Br 2  A5 rr                LDA     scratch
00117Dr 2  C9 05                CMP     #TY_ARRAY
00117Fr 2  D0 0F                BNE     @pl_chk_rec
001181r 2  AD rr rr             LDA     array_elem_ty
001184r 2  A0 16                LDY     #22
001186r 2  91 rr                STA     (tmp3),y
001188r 2  A9 02                LDA     #2
00118Ar 2  A0 17                LDY     #23
00118Cr 2  91 rr                STA     (tmp3),y
00118Er 2  80 12                BRA     @pl_meta_done
001190r 2               @pl_chk_rec:
001190r 2  C9 06                CMP     #TY_RECORD
001192r 2  D0 0E                BNE     @pl_meta_done
001194r 2  AD rr rr             LDA     record_first_field
001197r 2  A0 16                LDY     #22
001199r 2  91 rr                STA     (tmp3),y
00119Br 2  AD rr rr             LDA     record_field_count
00119Er 2  A0 17                LDY     #23
0011A0r 2  91 rr                STA     (tmp3),y
0011A2r 2               @pl_meta_done:
0011A2r 2  EE rr rr             INC     proc_param_count
0011A5r 2  FA                   PLX
0011A6r 2  E8                   INX
0011A7r 2  4C rr rr             JMP     @addloop        ; bra would be out of range now
0011AAr 2               @groupdone:
0011AAr 2               ; SEMICOLON → another group; else fall through to ')'
0011AAr 2  A5 rr                LDA     tok_type
0011ACr 2  C9 20                CMP     #TOK_SEMICOLON
0011AEr 2  D0 06                BNE     @done_params
0011B0r 2  20 rr rr             JSR     next_token      ; consume ';'
0011B3r 2  4C rr rr             JMP     @group_loop
0011B6r 2               @done_params:
0011B6r 2  A5 rr                LDA     tok_type
0011B8r 2  C9 1C                CMP     #TOK_RPAREN
0011BAr 2  D0 03                BNE     :+
0011BCr 2  20 rr rr             JSR     next_token      ; consume ')'
0011BFr 2               :
0011BFr 2  60                   RTS
0011C0r 2               
0011C0r 2               ; ---------------------------------------------------------------------------
0011C0r 2               ; parse_param_sig_list — parse a PROCEDURE/FUNCTION signature parameter list
0011C0r 2               ; without creating SYM_VAR entries. Used by UNIT interface headings so the
0011C0r 2               ; exported routine can record only param-count / VAR-mask metadata.
0011C0r 2               ; ---------------------------------------------------------------------------
0011C0r 2               parse_param_sig_list:
0011C0r 2  A9 00                LDA     #0
0011C2r 2  8D rr rr             STA     param_var_mask
0011C5r 2               @psig_group:
0011C5r 2  A9 00                LDA     #0
0011C7r 2  8D rr rr             STA     group_is_var
0011CAr 2  A5 rr                LDA     tok_type
0011CCr 2  C9 5C                CMP     #TOK_VAR
0011CEr 2  D0 08                BNE     @psig_no_var
0011D0r 2  A9 01                LDA     #1
0011D2r 2  8D rr rr             STA     group_is_var
0011D5r 2  20 rr rr             JSR     next_token
0011D8r 2               @psig_no_var:
0011D8r 2  A5 rr                LDA     tok_type
0011DAr 2  C9 01                CMP     #TOK_IDENT
0011DCr 2  F0 03                BEQ     @psig_have_ident
0011DEr 2  4C rr rr             JMP     @psig_done
0011E1r 2               @psig_have_ident:
0011E1r 2  A9 00                LDA     #0
0011E3r 2  8D rr rr             STA     var_name_count
0011E6r 2               @psig_collect:
0011E6r 2  A5 rr                LDA     tok_type
0011E8r 2  C9 01                CMP     #TOK_IDENT
0011EAr 2  D0 11                BNE     @psig_end_names
0011ECr 2  EE rr rr             INC     var_name_count
0011EFr 2  20 rr rr             JSR     next_token
0011F2r 2  A5 rr                LDA     tok_type
0011F4r 2  C9 1F                CMP     #TOK_COMMA
0011F6r 2  D0 05                BNE     @psig_end_names
0011F8r 2  20 rr rr             JSR     next_token
0011FBr 2  80 E9                BRA     @psig_collect
0011FDr 2               @psig_end_names:
0011FDr 2  A5 rr                LDA     tok_type
0011FFr 2  C9 21                CMP     #TOK_COLON
001201r 2  D0 03                BNE     :+
001203r 2  20 rr rr             JSR     next_token
001206r 2  20 rr rr     :       JSR     parse_type_spec
001209r 2  85 rr                STA     scratch
00120Br 2  A2 00                LDX     #0
00120Dr 2               @psig_add:
00120Dr 2  EC rr rr             CPX     var_name_count
001210r 2  B0 27                BCS     @psig_group_done
001212r 2  A5 rr                LDA     scratch
001214r 2  20 rr rr             JSR     store_proc_param_type
001217r 2  AD rr rr             LDA     group_is_var
00121Ar 2  F0 17                BEQ     @psig_inc
00121Cr 2  AC rr rr             LDY     proc_param_count
00121Fr 2  C0 08                CPY     #8
001221r 2  B0 10                BCS     @psig_inc
001223r 2  A9 01                LDA     #1
001225r 2               @psig_shl:
001225r 2  C0 00                CPY     #0
001227r 2  F0 04                BEQ     @psig_shl_done
001229r 2  0A                   ASL
00122Ar 2  88                   DEY
00122Br 2  80 F8                BRA     @psig_shl
00122Dr 2               @psig_shl_done:
00122Dr 2  0D rr rr             ORA     param_var_mask
001230r 2  8D rr rr             STA     param_var_mask
001233r 2               @psig_inc:
001233r 2  EE rr rr             INC     proc_param_count
001236r 2  E8                   INX
001237r 2  80 D4                BRA     @psig_add
001239r 2               @psig_group_done:
001239r 2  A5 rr                LDA     tok_type
00123Br 2  C9 20                CMP     #TOK_SEMICOLON
00123Dr 2  D0 06                BNE     @psig_done
00123Fr 2  20 rr rr             JSR     next_token
001242r 2  4C rr rr             JMP     @psig_group
001245r 2               @psig_done:
001245r 2  A5 rr                LDA     tok_type
001247r 2  C9 1C                CMP     #TOK_RPAREN
001249r 2  D0 03                BNE     :+
00124Br 2  20 rr rr             JSR     next_token
00124Er 2  60           :       RTS
00124Fr 2               
00124Fr 2               ; ---------------------------------------------------------------------------
00124Fr 2               ; parse_proc_iface_decl — PROCEDURE heading in a UNIT INTERFACE section.
00124Fr 2               ; Registers a global SYM_PROC with placeholder code offset 0 and fills
00124Fr 2               ; param-count / VAR-mask metadata for later callers and implementation.
00124Fr 2               ; ---------------------------------------------------------------------------
00124Fr 2               parse_proc_iface_decl:
00124Fr 2  A5 rr                LDA     tok_type
001251r 2  C9 01                CMP     #TOK_IDENT
001253r 2  F0 01                BEQ     :+
001255r 2  60                   RTS
001256r 2  A9 00        :       LDA     #0
001258r 2  8D rr rr             STA     proc_param_count
00125Br 2  8D rr rr             STA     param_var_mask
00125Er 2  85 rr                STA     tmp2
001260r 2  85 rr                STA     tmp2+1
001262r 2  A9 03                LDA     #SYM_PROC
001264r 2  A2 00                LDX     #TY_NONE
001266r 2  20 rr rr             JSR     symtab_add
001269r 2  A5 rr                LDA     tmp3
00126Br 2  8D rr rr             STA     proc_entry_idx
00126Er 2  A5 rr                LDA     tmp3+1
001270r 2  8D rr rr             STA     proc_entry_idx+1
001273r 2  20 rr rr             JSR     next_token              ; consume name
001276r 2  A5 rr                LDA     tok_type
001278r 2  C9 1B                CMP     #TOK_LPAREN
00127Ar 2  D0 06                BNE     @ppid_patch
00127Cr 2  20 rr rr             JSR     next_token
00127Fr 2  20 rr rr             JSR     parse_param_sig_list
001282r 2               @ppid_patch:
001282r 2  AD rr rr             LDA     proc_entry_idx
001285r 2  85 rr                STA     tmp3
001287r 2  AD rr rr             LDA     proc_entry_idx+1
00128Ar 2  85 rr                STA     tmp3+1
00128Cr 2  A0 15                LDY     #21
00128Er 2  AD rr rr             LDA     proc_param_count
001291r 2  91 rr                STA     (tmp3),y
001293r 2  A0 16                LDY     #22
001295r 2  AD rr rr             LDA     param_var_mask
001298r 2  91 rr                STA     (tmp3),y
00129Ar 2  A5 rr                LDA     tok_type
00129Cr 2  C9 20                CMP     #TOK_SEMICOLON
00129Er 2  D0 03                BNE     :+
0012A0r 2  20 rr rr             JSR     next_token
0012A3r 2  60           :       RTS
0012A4r 2               
0012A4r 2               ; ---------------------------------------------------------------------------
0012A4r 2               ; parse_func_iface_decl — FUNCTION heading in a UNIT INTERFACE section.
0012A4r 2               ; Registers a global SYM_FUNC with placeholder code offset 0 and patches
0012A4r 2               ; the return type plus param-count / VAR-mask metadata.
0012A4r 2               ; ---------------------------------------------------------------------------
0012A4r 2               parse_func_iface_decl:
0012A4r 2  A5 rr                LDA     tok_type
0012A6r 2  C9 01                CMP     #TOK_IDENT
0012A8r 2  F0 01                BEQ     :+
0012AAr 2  60                   RTS
0012ABr 2  A9 00        :       LDA     #0
0012ADr 2  8D rr rr             STA     proc_param_count
0012B0r 2  8D rr rr             STA     param_var_mask
0012B3r 2  85 rr                STA     tmp2
0012B5r 2  85 rr                STA     tmp2+1
0012B7r 2  A9 04                LDA     #SYM_FUNC
0012B9r 2  A2 00                LDX     #TY_NONE
0012BBr 2  20 rr rr             JSR     symtab_add
0012BEr 2  A5 rr                LDA     tmp3
0012C0r 2  8D rr rr             STA     proc_entry_idx
0012C3r 2  A5 rr                LDA     tmp3+1
0012C5r 2  8D rr rr             STA     proc_entry_idx+1
0012C8r 2  20 rr rr             JSR     next_token              ; consume name
0012CBr 2  A5 rr                LDA     tok_type
0012CDr 2  C9 1B                CMP     #TOK_LPAREN
0012CFr 2  D0 06                BNE     @pfid_after_params
0012D1r 2  20 rr rr             JSR     next_token
0012D4r 2  20 rr rr             JSR     parse_param_sig_list
0012D7r 2               @pfid_after_params:
0012D7r 2  A5 rr                LDA     tok_type
0012D9r 2  C9 21                CMP     #TOK_COLON
0012DBr 2  D0 03                BNE     :+
0012DDr 2  20 rr rr             JSR     next_token
0012E0r 2  20 rr rr     :       JSR     parse_type_spec
0012E3r 2  85 rr                STA     scratch
0012E5r 2  AD rr rr             LDA     proc_entry_idx
0012E8r 2  85 rr                STA     tmp3
0012EAr 2  AD rr rr             LDA     proc_entry_idx+1
0012EDr 2  85 rr                STA     tmp3+1
0012EFr 2  A0 11                LDY     #17
0012F1r 2  A5 rr                LDA     scratch
0012F3r 2  91 rr                STA     (tmp3),y
0012F5r 2  A0 15                LDY     #21
0012F7r 2  AD rr rr             LDA     proc_param_count
0012FAr 2  91 rr                STA     (tmp3),y
0012FCr 2  A0 16                LDY     #22
0012FEr 2  AD rr rr             LDA     param_var_mask
001301r 2  91 rr                STA     (tmp3),y
001303r 2  A5 rr                LDA     tok_type
001305r 2  C9 20                CMP     #TOK_SEMICOLON
001307r 2  D0 03                BNE     :+
001309r 2  20 rr rr             JSR     next_token
00130Cr 2  60           :       RTS
00130Dr 2               
00130Dr 2               ; ---------------------------------------------------------------------------
00130Dr 2               ; parse_proc_decl — PROCEDURE name [ ( params ) ] ; <block> ;
00130Dr 2               ; The PROCEDURE keyword has already been consumed by parse_block @proc.
00130Dr 2               ;
00130Dr 2               ; Phase B: value parameters supported.  Each parameter occupies 2 bytes in
00130Dr 2               ; the AR at MP+AR_LOCALS+offset and is stored into the symbol table as
00130Dr 2               ; SYM_VAR in the inner scope.  Param-count is recorded on the proc's symbol
00130Dr 2               ; entry (offset 21) so callers know how many args to push.
00130Dr 2               ; ---------------------------------------------------------------------------
00130Dr 2               parse_proc_decl:
00130Dr 2               ; expect identifier (proc name)
00130Dr 2  A5 rr                LDA     tok_type
00130Fr 2  C9 01                CMP     #TOK_IDENT
001311r 2  F0 01                BEQ     @have_name
001313r 2  60                   RTS
001314r 2               @have_name:
001314r 2               ; Save outer local_alloc_off on 6502 stack — nested procs would
001314r 2               ; otherwise clobber the enclosing proc's allocator state.
001314r 2  AD rr rr             LDA     local_alloc_off
001317r 2  48                   PHA
001318r 2               
001318r 2               ; save proc name into save_name_buf (ident_buf gets clobbered later)
001318r 2  A0 0F                LDY     #15
00131Ar 2               @savename:
00131Ar 2  B9 rr rr             LDA     ident_buf,y
00131Dr 2  99 rr rr             STA     save_name_buf,y
001320r 2  88                   DEY
001321r 2  10 F7                BPL     @savename
001323r 2               
001323r 2               ; UNIT implementation bodies may be preceded by an INTERFACE heading.
001323r 2               ; Reuse that global SYM_PROC entry instead of creating a duplicate.
001323r 2  A5 rr                LDA     scope_depth
001325r 2  D0 2A                BNE     @new_entry
001327r 2  AD rr rr             LDA     unit_section
00132Ar 2  C9 02                CMP     #2
00132Cr 2  D0 23                BNE     @new_entry
00132Er 2  20 rr rr             JSR     symtab_find
001331r 2  90 1E                BCC     @new_entry
001333r 2  A0 10                LDY     #16
001335r 2  B1 rr                LDA     (tmp3),y
001337r 2  C9 03                CMP     #SYM_PROC
001339r 2  D0 16                BNE     @new_entry
00133Br 2  A0 14                LDY     #20
00133Dr 2  B1 rr                LDA     (tmp3),y
00133Fr 2  D0 10                BNE     @new_entry
001341r 2  A5 rr                LDA     tmp3
001343r 2  8D rr rr             STA     proc_entry_idx
001346r 2  A5 rr                LDA     tmp3+1
001348r 2  8D rr rr             STA     proc_entry_idx+1
00134Br 2  20 rr rr             JSR     next_token
00134Er 2  4C rr rr             JMP     @enter_scope
001351r 2               @new_entry:
001351r 2               
001351r 2  20 rr rr             JSR     next_token      ; consume name
001354r 2               
001354r 2               ; Register proc in symbol table NOW so we have an entry to update
001354r 2               ; with the param count once the param list has been parsed.
001354r 2               ; Offset (proc entry point) = current cg_pc.
001354r 2  20 rr rr             JSR     swap_ident_save ; ident_buf <-> save_name_buf
001357r 2  A5 rr                LDA     cg_pc
001359r 2  85 rr                STA     tmp2
00135Br 2  A5 rr                LDA     cg_pc+1
00135Dr 2  85 rr                STA     tmp2+1
00135Fr 2  A9 03                LDA     #SYM_PROC
001361r 2  A2 00                LDX     #TY_NONE
001363r 2  20 rr rr             JSR     symtab_add
001366r 2  A5 rr                LDA     tmp3
001368r 2  8D rr rr             STA     proc_entry_idx
00136Br 2  A5 rr                LDA     tmp3+1
00136Dr 2  8D rr rr             STA     proc_entry_idx+1
001370r 2  20 rr rr             JSR     swap_ident_save
001373r 2               
001373r 2               ; Enter scope: params and any locals belong to the proc's frame.
001373r 2               @enter_scope:
001373r 2  20 rr rr             JSR     symtab_enter_scope
001376r 2               
001376r 2               ; init param count and VAR-mask
001376r 2  A9 00                LDA     #0
001378r 2  8D rr rr             STA     proc_param_count
00137Br 2  8D rr rr             STA     param_var_mask
00137Er 2               
00137Er 2               ; Optional parameter list
00137Er 2  A5 rr                LDA     tok_type
001380r 2  C9 1B                CMP     #TOK_LPAREN
001382r 2  D0 06                BNE     @backpatch_pcount
001384r 2  20 rr rr             JSR     next_token      ; consume '('
001387r 2  20 rr rr             JSR     parse_param_list
00138Ar 2               
00138Ar 2               @backpatch_pcount:
00138Ar 2               ; Write param count into proc's symbol entry (offset 21).
00138Ar 2  AD rr rr             LDA     proc_entry_idx
00138Dr 2  85 rr                STA     tmp3
00138Fr 2  AD rr rr             LDA     proc_entry_idx+1
001392r 2  85 rr                STA     tmp3+1
001394r 2  A0 12                LDY     #18
001396r 2  A5 rr                LDA     cg_pc
001398r 2  91 rr                STA     (tmp3),y
00139Ar 2  C8                   INY
00139Br 2  A5 rr                LDA     cg_pc+1
00139Dr 2  91 rr                STA     (tmp3),y
00139Fr 2  A0 15                LDY     #21
0013A1r 2  AD rr rr             LDA     proc_param_count
0013A4r 2  91 rr                STA     (tmp3),y
0013A6r 2  A0 16                LDY     #22
0013A8r 2  AD rr rr             LDA     param_var_mask
0013ABr 2  91 rr                STA     (tmp3),y
0013ADr 2               
0013ADr 2               ; Initialize local_alloc_off to start right after the params.
0013ADr 2               ; VAR declarations inside the body extend this; final value is
0013ADr 2               ; backpatched into entry offset 23 below as the MRKSTK size.
0013ADr 2  AD rr rr             LDA     proc_param_count
0013B0r 2  0A                   ASL
0013B1r 2  8D rr rr             STA     local_alloc_off
0013B4r 2               
0013B4r 2               ; expect ';'
0013B4r 2  A5 rr                LDA     tok_type
0013B6r 2  C9 20                CMP     #TOK_SEMICOLON
0013B8r 2  D0 03                BNE     :+
0013BAr 2  20 rr rr             JSR     next_token
0013BDr 2               :
0013BDr 2               ; No callee prologue: the caller emits MRKSTK + arg-stores + CALL,
0013BDr 2               ; so by the time we land at the proc entry the activation record
0013BDr 2               ; (and its param slots) already exists.
0013BDr 2               
0013BDr 2               ; Recurse: proc body may have its own const/type/var/proc/begin block.
0013BDr 2  20 rr rr             JSR     parse_block
0013C0r 2               
0013C0r 2               ; Epilogue
0013C0r 2  20 rr rr             JSR     emit_RET
0013C3r 2               
0013C3r 2               ; Backpatch total local-area size (params + declared locals) into
0013C3r 2               ; the proc's symbol entry at offset 23.  The caller reads this and
0013C3r 2               ; emits MRKSTK <lsize> so the AR is large enough to hold all locals
0013C3r 2               ; below pm_sp (otherwise value-stack pushes corrupt local slots).
0013C3r 2  AD rr rr             LDA     proc_entry_idx
0013C6r 2  85 rr                STA     tmp3
0013C8r 2  AD rr rr             LDA     proc_entry_idx+1
0013CBr 2  85 rr                STA     tmp3+1
0013CDr 2  A0 17                LDY     #23
0013CFr 2  AD rr rr             LDA     local_alloc_off
0013D2r 2  91 rr                STA     (tmp3),y
0013D4r 2               
0013D4r 2  20 rr rr             JSR     symtab_leave_scope
0013D7r 2               
0013D7r 2               ; Consume trailing ';' after END
0013D7r 2  A5 rr                LDA     tok_type
0013D9r 2  C9 20                CMP     #TOK_SEMICOLON
0013DBr 2  D0 03                BNE     :+
0013DDr 2  20 rr rr             JSR     next_token
0013E0r 2               :
0013E0r 2  68                   PLA
0013E1r 2  8D rr rr             STA     local_alloc_off ; restore outer allocator state
0013E4r 2  60                   RTS
0013E5r 2               
0013E5r 2               ; ---------------------------------------------------------------------------
0013E5r 2               ; parse_func_decl — FUNCTION name [ ( params ) ] : RETURN_TYPE ; <block> ;
0013E5r 2               ; The FUNCTION keyword has already been consumed by parse_block @func.
0013E5r 2               ; Mirrors parse_proc_decl but registers SYM_FUNC, parses the return type,
0013E5r 2               ; adds a SYM_RETVAL inner-scope binding (so `name := expr` in the body
0013E5r 2               ; emits OP_STR), and emits OP_RETF as the epilogue.
0013E5r 2               ; ---------------------------------------------------------------------------
0013E5r 2               parse_func_decl:
0013E5r 2               ; expect identifier (func name)
0013E5r 2  A5 rr                LDA     tok_type
0013E7r 2  C9 01                CMP     #TOK_IDENT
0013E9r 2  F0 01                BEQ     @have_name
0013EBr 2  60                   RTS
0013ECr 2               @have_name:
0013ECr 2               ; Save outer local_alloc_off on 6502 stack — nested func/proc would
0013ECr 2               ; otherwise clobber the enclosing frame's allocator state.
0013ECr 2  AD rr rr             LDA     local_alloc_off
0013EFr 2  48                   PHA
0013F0r 2               
0013F0r 2               ; save func name into save_name_buf
0013F0r 2  A0 0F                LDY     #15
0013F2r 2               @savename:
0013F2r 2  B9 rr rr             LDA     ident_buf,y
0013F5r 2  99 rr rr             STA     save_name_buf,y
0013F8r 2  88                   DEY
0013F9r 2  10 F7                BPL     @savename
0013FBr 2               
0013FBr 2               ; UNIT implementation bodies may bind to an INTERFACE-declared SYM_FUNC.
0013FBr 2  A5 rr                LDA     scope_depth
0013FDr 2  D0 2A                BNE     @new_entry
0013FFr 2  AD rr rr             LDA     unit_section
001402r 2  C9 02                CMP     #2
001404r 2  D0 23                BNE     @new_entry
001406r 2  20 rr rr             JSR     symtab_find
001409r 2  90 1E                BCC     @new_entry
00140Br 2  A0 10                LDY     #16
00140Dr 2  B1 rr                LDA     (tmp3),y
00140Fr 2  C9 04                CMP     #SYM_FUNC
001411r 2  D0 16                BNE     @new_entry
001413r 2  A0 14                LDY     #20
001415r 2  B1 rr                LDA     (tmp3),y
001417r 2  D0 10                BNE     @new_entry
001419r 2  A5 rr                LDA     tmp3
00141Br 2  8D rr rr             STA     proc_entry_idx
00141Er 2  A5 rr                LDA     tmp3+1
001420r 2  8D rr rr             STA     proc_entry_idx+1
001423r 2  20 rr rr             JSR     next_token
001426r 2  4C rr rr             JMP     @enter_scope
001429r 2               @new_entry:
001429r 2               
001429r 2  20 rr rr             JSR     next_token      ; consume name
00142Cr 2               
00142Cr 2               ; Register SYM_FUNC NOW so we have an entry to backpatch.
00142Cr 2               ; Type backpatched after we parse `: RETURN_TYPE`.
00142Cr 2  20 rr rr             JSR     swap_ident_save ; ident_buf <-> save_name_buf
00142Fr 2  A5 rr                LDA     cg_pc
001431r 2  85 rr                STA     tmp2
001433r 2  A5 rr                LDA     cg_pc+1
001435r 2  85 rr                STA     tmp2+1
001437r 2  A9 04                LDA     #SYM_FUNC
001439r 2  A2 00                LDX     #TY_NONE        ; placeholder
00143Br 2  20 rr rr             JSR     symtab_add
00143Er 2  A5 rr                LDA     tmp3
001440r 2  8D rr rr             STA     proc_entry_idx
001443r 2  A5 rr                LDA     tmp3+1
001445r 2  8D rr rr             STA     proc_entry_idx+1
001448r 2  20 rr rr             JSR     swap_ident_save
00144Br 2               
00144Br 2               ; Enter scope: params, locals, and SYM_RETVAL belong to fn frame.
00144Br 2               @enter_scope:
00144Br 2  20 rr rr             JSR     symtab_enter_scope
00144Er 2               
00144Er 2               ; init param count and VAR-mask
00144Er 2  A9 00                LDA     #0
001450r 2  8D rr rr             STA     proc_param_count
001453r 2  8D rr rr             STA     param_var_mask
001456r 2               
001456r 2               ; Optional parameter list
001456r 2  A5 rr                LDA     tok_type
001458r 2  C9 1B                CMP     #TOK_LPAREN
00145Ar 2  D0 06                BNE     @after_params
00145Cr 2  20 rr rr             JSR     next_token      ; consume '('
00145Fr 2  20 rr rr             JSR     parse_param_list
001462r 2               
001462r 2               @after_params:
001462r 2               ; Expect ':' then return type
001462r 2  A5 rr                LDA     tok_type
001464r 2  C9 21                CMP     #TOK_COLON
001466r 2  D0 03                BNE     :+
001468r 2  20 rr rr             JSR     next_token
00146Br 2               :
00146Br 2  20 rr rr             JSR     parse_type_spec
00146Er 2  85 rr                STA     scratch         ; save return type code
001470r 2               
001470r 2               ; Recompute SYM_FUNC entry pointer from proc_entry_idx and backpatch
001470r 2               ; offset 17 (return type) and offset 21 (param count).
001470r 2  AD rr rr             LDA     proc_entry_idx
001473r 2  85 rr                STA     tmp3
001475r 2  AD rr rr             LDA     proc_entry_idx+1
001478r 2  85 rr                STA     tmp3+1
00147Ar 2  A0 12                LDY     #18
00147Cr 2  A5 rr                LDA     cg_pc
00147Er 2  91 rr                STA     (tmp3),y
001480r 2  C8                   INY
001481r 2  A5 rr                LDA     cg_pc+1
001483r 2  91 rr                STA     (tmp3),y
001485r 2  A0 11                LDY     #17
001487r 2  A5 rr                LDA     scratch
001489r 2  91 rr                STA     (tmp3),y
00148Br 2  A0 15                LDY     #21
00148Dr 2  AD rr rr             LDA     proc_param_count
001490r 2  91 rr                STA     (tmp3),y
001492r 2  A0 16                LDY     #22
001494r 2  AD rr rr             LDA     param_var_mask
001497r 2  91 rr                STA     (tmp3),y
001499r 2               
001499r 2               ; Initialize local_alloc_off to start right after the params.
001499r 2               ; VAR declarations in the body extend this; final value is
001499r 2               ; backpatched into entry offset 23 as the MRKSTK size.
001499r 2  AD rr rr             LDA     proc_param_count
00149Cr 2  0A                   ASL
00149Dr 2  8D rr rr             STA     local_alloc_off
0014A0r 2               
0014A0r 2               ; Add SYM_RETVAL binding: same name as function; assignments to
0014A0r 2               ; this name in the body emit OP_STR (writes MP+AR_RET_VAL).
0014A0r 2               ; save_name_buf still holds the function name (parse_param_list uses
0014A0r 2               ; var_name_buf, not save_name_buf).  Swap it into ident_buf.
0014A0r 2  20 rr rr             JSR     swap_ident_save
0014A3r 2  A9 00                LDA     #0
0014A5r 2  85 rr                STA     tmp2
0014A7r 2  85 rr                STA     tmp2+1
0014A9r 2  A9 07                LDA     #SYM_RETVAL
0014ABr 2  A6 rr                LDX     scratch
0014ADr 2  20 rr rr             JSR     symtab_add
0014B0r 2               
0014B0r 2               ; Expect ';' before body
0014B0r 2  A5 rr                LDA     tok_type
0014B2r 2  C9 20                CMP     #TOK_SEMICOLON
0014B4r 2  D0 03                BNE     :+
0014B6r 2  20 rr rr             JSR     next_token
0014B9r 2               :
0014B9r 2  20 rr rr             JSR     parse_block
0014BCr 2               
0014BCr 2  20 rr rr             JSR     emit_RETF
0014BFr 2               
0014BFr 2               ; Backpatch total local-area size into the func's symbol entry at
0014BFr 2               ; offset 23 (params + declared body locals).  Caller emits MRKSTK
0014BFr 2               ; with this value so the AR holds all locals below pm_sp.
0014BFr 2  AD rr rr             LDA     proc_entry_idx
0014C2r 2  85 rr                STA     tmp3
0014C4r 2  AD rr rr             LDA     proc_entry_idx+1
0014C7r 2  85 rr                STA     tmp3+1
0014C9r 2  A0 17                LDY     #23
0014CBr 2  AD rr rr             LDA     local_alloc_off
0014CEr 2  91 rr                STA     (tmp3),y
0014D0r 2               
0014D0r 2  20 rr rr             JSR     symtab_leave_scope
0014D3r 2               
0014D3r 2               ; Consume trailing ';' after END
0014D3r 2  A5 rr                LDA     tok_type
0014D5r 2  C9 20                CMP     #TOK_SEMICOLON
0014D7r 2  D0 03                BNE     :+
0014D9r 2  20 rr rr             JSR     next_token
0014DCr 2               :
0014DCr 2  68                   PLA
0014DDr 2  8D rr rr             STA     local_alloc_off ; restore outer allocator state
0014E0r 2  60                   RTS
0014E1r 2               
0014E1r 2               ; ---------------------------------------------------------------------------
0014E1r 2               ; parse_compound_stmt — BEGIN { statement ; } END
0014E1r 2               ; ---------------------------------------------------------------------------
0014E1r 2               parse_compound_stmt:
0014E1r 2               ; consume BEGIN
0014E1r 2  A5 rr                LDA     tok_type
0014E3r 2  C9 42                CMP     #TOK_BEGIN
0014E5r 2  D0 36                BNE     @done
0014E7r 2  20 rr rr             JSR     next_token
0014EAr 2               @loop:
0014EAr 2  A5 rr                LDA     tok_type
0014ECr 2  C9 49                CMP     #TOK_END
0014EEr 2  F0 2A                BEQ     @end
0014F0r 2  C9 00                CMP     #TOK_EOF
0014F2r 2  F0 29                BEQ     @done
0014F4r 2               ; remember tok before parse_statement to detect no-progress
0014F4r 2  85 rr                STA     tmp3
0014F6r 2  20 rr rr             JSR     parse_statement
0014F9r 2  A5 rr                LDA     tok_type
0014FBr 2  C9 20                CMP     #TOK_SEMICOLON
0014FDr 2  F0 15                BEQ     @consume_semi
0014FFr 2  C9 49                CMP     #TOK_END
001501r 2  F0 17                BEQ     @end
001503r 2  C9 00                CMP     #TOK_EOF
001505r 2  F0 16                BEQ     @done
001507r 2               ; if parse_statement didn't consume anything, force-advance to avoid
001507r 2               ; an infinite loop on an unrecognised token
001507r 2  C5 rr                CMP     tmp3
001509r 2  F0 03                BEQ     @pcs_force_advance
00150Br 2  4C rr rr             JMP     @loop
00150Er 2               @pcs_force_advance:
00150Er 2  20 rr rr             JSR     next_token
001511r 2  4C rr rr             JMP     @loop
001514r 2               @consume_semi:
001514r 2  20 rr rr             JSR     next_token
001517r 2  4C rr rr             JMP     @loop
00151Ar 2               @end:
00151Ar 2  20 rr rr             JSR     next_token      ; consume END
00151Dr 2               @done:
00151Dr 2  60                   RTS
00151Er 2               
00151Er 2               ; ---------------------------------------------------------------------------
00151Er 2               ; parse_statement — dispatch based on current token
00151Er 2               ; ---------------------------------------------------------------------------
00151Er 2               parse_statement:
00151Er 2  A5 rr                LDA     tok_type
001520r 2  C9 42                CMP     #TOK_BEGIN
001522r 2  F0 19                BEQ     @compound
001524r 2  C9 5E                CMP     #TOK_WITH
001526r 2  F0 18                BEQ     @with
001528r 2  C9 4C                CMP     #TOK_IF
00152Ar 2  F0 1C                BEQ     @if
00152Cr 2  C9 5D                CMP     #TOK_WHILE
00152Er 2  F0 1C                BEQ     @while
001530r 2  C9 4A                CMP     #TOK_FOR
001532r 2  F0 1C                BEQ     @for
001534r 2  C9 56                CMP     #TOK_REPEAT
001536r 2  F0 1C                BEQ     @repeat
001538r 2  C9 01                CMP     #TOK_IDENT
00153Ar 2  F0 08                BEQ     @assign_or_call
00153Cr 2  60                   RTS                     ; empty statement
00153Dr 2               
00153Dr 2               @compound:
00153Dr 2  4C rr rr             JMP     parse_compound_stmt
001540r 2               
001540r 2               @with:
001540r 2  20 rr rr             JSR     parse_with_stmt
001543r 2  60                   RTS
001544r 2               
001544r 2               @assign_or_call:
001544r 2  20 rr rr             JSR     parse_assign_or_call
001547r 2  60                   RTS
001548r 2               
001548r 2               @if:
001548r 2  20 rr rr             JSR     parse_if
00154Br 2  60                   RTS
00154Cr 2               
00154Cr 2               @while:
00154Cr 2  20 rr rr             JSR     parse_while
00154Fr 2  60                   RTS
001550r 2               
001550r 2               @for:
001550r 2  20 rr rr             JSR     parse_for
001553r 2  60                   RTS
001554r 2               
001554r 2               @repeat:
001554r 2  20 rr rr             JSR     parse_repeat
001557r 2  60                   RTS
001558r 2               
001558r 2               ; ---------------------------------------------------------------------------
001558r 2               ; parse_with_stmt — WITH record_expr { , record_expr } DO statement
001558r 2               ; Each selector gets a hidden global word holding the runtime record base
001558r 2               ; address. The compile-time WITH context stack records the matching field
001558r 2               ; table span so unqualified identifiers can resolve as fields.
001558r 2               ; ---------------------------------------------------------------------------
001558r 2               parse_with_stmt:
001558r 2  AD rr rr             LDA     with_depth
00155Br 2  48                   PHA                             ; restore point after the body
00155Cr 2  20 rr rr             JSR     next_token              ; consume WITH
00155Fr 2               @pws_item:
00155Fr 2  20 rr rr             JSR     parse_expression
001562r 2  A5 rr                LDA     expr_type
001564r 2  C9 06                CMP     #TY_RECORD
001566r 2  F0 10                BEQ     @pws_record
001568r 2  A9 rr                LDA     #<err_type
00156Ar 2  85 rr                STA     tmp0
00156Cr 2  A9 rr                LDA     #>err_type
00156Er 2  85 rr                STA     tmp0+1
001570r 2  20 rr rr             JSR     compile_error
001573r 2  20 rr rr             JSR     emit_POP                ; discard non-record expression result
001576r 2  80 43                BRA     @pws_after_item
001578r 2               @pws_record:
001578r 2  A9 02                LDA     #2
00157Ar 2  20 rr rr             JSR     codegen_alloc_global    ; tmp2 = hidden word for base addr
00157Dr 2  A5 rr                LDA     tmp2
00157Fr 2  48                   PHA
001580r 2  A5 rr                LDA     tmp2+1
001582r 2  48                   PHA
001583r 2  A5 rr                LDA     tmp2+1
001585r 2  85 rr                STA     scratch
001587r 2  A5 rr                LDA     tmp2
001589r 2  20 rr rr             JSR     emit_STG                ; save selector address
00158Cr 2  AE rr rr             LDX     with_depth
00158Fr 2  E0 08                CPX     #WITH_DEPTHS
001591r 2  90 0D                BCC     @pws_push
001593r 2  A9 rr                LDA     #<err_too_many
001595r 2  85 rr                STA     tmp0
001597r 2  A9 rr                LDA     #>err_too_many
001599r 2  85 rr                STA     tmp0+1
00159Br 2  20 rr rr             JSR     compile_error
00159Er 2  80 19                BRA     @pws_discard_hidden
0015A0r 2               @pws_push:
0015A0r 2  68                   PLA
0015A1r 2  9D rr rr             STA     with_base_hi,x
0015A4r 2  68                   PLA
0015A5r 2  9D rr rr             STA     with_base_lo,x
0015A8r 2  AD rr rr             LDA     expr_record_first
0015ABr 2  9D rr rr             STA     with_first_field,x
0015AEr 2  AD rr rr             LDA     expr_record_count
0015B1r 2  9D rr rr             STA     with_field_count,x
0015B4r 2  EE rr rr             INC     with_depth
0015B7r 2  80 02                BRA     @pws_after_item
0015B9r 2               @pws_discard_hidden:
0015B9r 2  68                   PLA
0015BAr 2  68                   PLA
0015BBr 2               @pws_after_item:
0015BBr 2  A5 rr                LDA     tok_type
0015BDr 2  C9 1F                CMP     #TOK_COMMA
0015BFr 2  D0 05                BNE     @pws_need_do
0015C1r 2  20 rr rr             JSR     next_token
0015C4r 2  80 99                BRA     @pws_item
0015C6r 2               @pws_need_do:
0015C6r 2  A5 rr                LDA     tok_type
0015C8r 2  C9 46                CMP     #TOK_DO
0015CAr 2  F0 0D                BEQ     @pws_do
0015CCr 2  A9 rr                LDA     #<err_expected_do
0015CEr 2  85 rr                STA     tmp0
0015D0r 2  A9 rr                LDA     #>err_expected_do
0015D2r 2  85 rr                STA     tmp0+1
0015D4r 2  20 rr rr             JSR     compile_error
0015D7r 2  80 03                BRA     @pws_body
0015D9r 2               @pws_do:
0015D9r 2  20 rr rr             JSR     next_token              ; consume DO
0015DCr 2               @pws_body:
0015DCr 2  20 rr rr             JSR     parse_statement
0015DFr 2  68                   PLA
0015E0r 2  8D rr rr             STA     with_depth
0015E3r 2  60                   RTS
0015E4r 2               
0015E4r 2               ; ---------------------------------------------------------------------------
0015E4r 2               ; parse_with_field_assign — current token is the field IDENT already matched
0015E4r 2               ; by with_lookup_field. Handles scalar fields, pointer-field dereference, and
0015E4r 2               ; chained nested-record assignments such as `WITH R DO A.X := 1`.
0015E4r 2               ; ---------------------------------------------------------------------------
0015E4r 2               parse_with_field_assign:
0015E4r 2  20 rr rr             JSR     next_token              ; consume field name
0015E7r 2  20 rr rr             JSR     emit_with_field_base    ; push &field / &subrecord
0015EAr 2  AD rr rr             LDA     with_lookup_type
0015EDr 2  C9 06                CMP     #TY_RECORD
0015EFr 2  F0 30                BEQ     @pwfa_record
0015F1r 2  C9 07                CMP     #TY_PTR
0015F3r 2  D0 1C                BNE     @pwfa_scalar
0015F5r 2  A5 rr                LDA     tok_type
0015F7r 2  C9 24                CMP     #TOK_CARET
0015F9r 2  D0 16                BNE     @pwfa_scalar
0015FBr 2  20 rr rr             JSR     emit_LDIND              ; load pointer value from field cell
0015FEr 2  20 rr rr             JSR     next_token              ; consume '^'
001601r 2  A5 rr                LDA     tok_type
001603r 2  C9 1A                CMP     #TOK_ASSIGN
001605r 2  D0 03                BNE     :+
001607r 2  20 rr rr             JSR     next_token
00160Ar 2  20 rr rr     :       JSR     parse_expression
00160Dr 2  20 rr rr             JSR     emit_STIND
001610r 2  60                   RTS
001611r 2               @pwfa_scalar:
001611r 2  A5 rr                LDA     tok_type
001613r 2  C9 1A                CMP     #TOK_ASSIGN
001615r 2  D0 03                BNE     :+
001617r 2  20 rr rr             JSR     next_token
