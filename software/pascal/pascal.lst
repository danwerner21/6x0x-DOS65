002356r 2  FA                   PLX
002357r 2  80 05                BRA     @fc_arg_stored
002359r 2               @fc_arg_value:
002359r 2  DA                   PHX
00235Ar 2  20 rr rr             JSR     parse_expression
00235Dr 2  FA                   PLX
00235Er 2               @fc_arg_stored:
00235Er 2  8A                   TXA
00235Fr 2  0A                   ASL
002360r 2  20 rr rr             JSR     emit_STL        ; store popped value (or address) into local slot X
002363r 2  E8                   INX
002364r 2  EC rr rr             CPX     fcall_pcount
002367r 2  B0 0C                BCS     @fc_done_args
002369r 2  A5 rr                LDA     tok_type
00236Br 2  C9 1F                CMP     #TOK_COMMA
00236Dr 2  D0 06                BNE     @fc_done_args
00236Fr 2  20 rr rr             JSR     next_token      ; consume ','
002372r 2  4C rr rr             JMP     @fc_arg_loop    ; jmp — body grew past bra range
002375r 2               @fc_done_args:
002375r 2  A5 rr                LDA     tok_type
002377r 2  C9 1C                CMP     #TOK_RPAREN
002379r 2  D0 17                BNE     @fc_emit_call
00237Br 2  20 rr rr             JSR     next_token      ; consume ')'
00237Er 2  80 12                BRA     @fc_emit_call
002380r 2               @fc_no_args:
002380r 2               ; Accept optional "()"
002380r 2  A5 rr                LDA     tok_type
002382r 2  C9 1B                CMP     #TOK_LPAREN
002384r 2  D0 0C                BNE     @fc_emit_call
002386r 2  20 rr rr             JSR     next_token
002389r 2  A5 rr                LDA     tok_type
00238Br 2  C9 1C                CMP     #TOK_RPAREN
00238Dr 2  D0 03                BNE     @fc_emit_call
00238Fr 2  20 rr rr             JSR     next_token
002392r 2               @fc_emit_call:
002392r 2  AD rr rr             LDA     fcall_lo
002395r 2  0D rr rr             ORA     fcall_hi
002398r 2  D0 0B                BNE     :+
00239Ar 2  A9 rr                LDA     #<err_undef
00239Cr 2  85 rr                STA     tmp0
