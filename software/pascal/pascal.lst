001991r 2               ; compare name length
001991r 2  A0 00                LDY     #0
001993r 2  B1 rr                LDA     (tmp2),y
001995r 2  CD rr rr             CMP     ident_buf
001998r 2  D0 19                BNE     @next
00199Ar 2  AA                   TAX                     ; X = length
00199Br 2  A0 01                LDY     #1
