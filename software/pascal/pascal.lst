001313r 2  AD rr rr             LDA     fcall_type
001316r 2  85 rr                STA     expr_type
001318r 2  60                   RTS
001319r 2               
001319r 2               @paren:
001319r 2  20 rr rr             JSR     next_token      ; consume '('
00131Cr 2  20 rr rr             JSR     parse_expression
00131Fr 2  A5 rr                LDA     tok_type
001321r 2  C9 1C                CMP     #TOK_RPAREN
001323r 2  D0 03                BNE     :+
001325r 2  20 rr rr             JSR     next_token
001328r 2               :
001328r 2  60                   RTS                     ; expr_type already set by parse_expression
001329r 2               
001329r 2               @not_expr:
001329r 2  20 rr rr             JSR     next_token
00132Cr 2  20 rr rr             JSR     parse_factor
