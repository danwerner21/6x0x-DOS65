002750r 2  A9 1C                LDA     #TOK_RPAREN
002752r 2  20 rr rr             JSR     parse_eat_token
002755r 2  4C rr rr             JMP     emit_FAPPND
002758r 2               
002758r 2               parse_builtin_close:
002758r 2  20 rr rr             JSR     next_token              ; consume CLOSE
00275Br 2  A9 1B                LDA     #TOK_LPAREN
00275Dr 2  20 rr rr             JSR     parse_eat_token
002760r 2  20 rr rr             JSR     parse_expression
002763r 2  A9 1C                LDA     #TOK_RPAREN
002765r 2  20 rr rr             JSR     parse_eat_token
002768r 2  4C rr rr             JMP     emit_FCLOSE
00276Br 2               
