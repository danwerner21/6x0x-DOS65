00249Er 2  20 rr rr             JSR     parse_expression
0024A1r 2  A9 1C                LDA     #TOK_RPAREN
0024A3r 2  20 rr rr             JSR     parse_eat_token
0024A6r 2  4C rr rr             JMP     emit_FRESET
0024A9r 2               
0024A9r 2               parse_builtin_rewrite:
0024A9r 2  20 rr rr             JSR     next_token              ; consume REWRITE
0024ACr 2  A9 1B                LDA     #TOK_LPAREN
0024AEr 2  20 rr rr             JSR     parse_eat_token
0024B1r 2  20 rr rr             JSR     parse_expression
0024B4r 2  A9 1C                LDA     #TOK_RPAREN
0024B6r 2  20 rr rr             JSR     parse_eat_token
0024B9r 2  4C rr rr             JMP     emit_FREWRT
0024BCr 2               
0024BCr 2               parse_builtin_append:
0024BCr 2  20 rr rr             JSR     next_token              ; consume APPEND
0024BFr 2  A9 1B                LDA     #TOK_LPAREN
0024C1r 2  20 rr rr             JSR     parse_eat_token
0024C4r 2  20 rr rr             JSR     parse_expression
0024C7r 2  A9 1C                LDA     #TOK_RPAREN
0024C9r 2  20 rr rr             JSR     parse_eat_token
0024CCr 2  4C rr rr             JMP     emit_FAPPND
0024CFr 2               
0024CFr 2               parse_builtin_close:
0024CFr 2  20 rr rr             JSR     next_token              ; consume CLOSE
0024D2r 2  A9 1B                LDA     #TOK_LPAREN
0024D4r 2  20 rr rr             JSR     parse_eat_token
0024D7r 2  20 rr rr             JSR     parse_expression
0024DAr 2  A9 1C                LDA     #TOK_RPAREN
0024DCr 2  20 rr rr             JSR     parse_eat_token
0024DFr 2  4C rr rr             JMP     emit_FCLOSE
0024E2r 2               
0024E2r 2               parse_builtin_eof:
0024E2r 2  20 rr rr             JSR     next_token              ; consume EOF
0024E5r 2  A9 1B                LDA     #TOK_LPAREN
0024E7r 2  20 rr rr             JSR     parse_eat_token
0024EAr 2  20 rr rr             JSR     parse_expression        ; file ptr (TY_TEXT)
0024EDr 2  A9 1C                LDA     #TOK_RPAREN
0024EFr 2  20 rr rr             JSR     parse_eat_token
0024F2r 2  20 rr rr             JSR     emit_FEOF
0024F5r 2  A9 03                LDA     #TY_BOOL
0024F7r 2  85 rr                STA     expr_type
0024F9r 2  60                   RTS
0024FAr 2               
0024FAr 2               parse_builtin_eoln:
0024FAr 2  20 rr rr             JSR     next_token              ; consume EOLN
0024FDr 2  A9 1B                LDA     #TOK_LPAREN
0024FFr 2  20 rr rr             JSR     parse_eat_token
002502r 2  20 rr rr             JSR     parse_expression        ; file ptr (TY_TEXT)
002505r 2  A9 1C                LDA     #TOK_RPAREN
002507r 2  20 rr rr             JSR     parse_eat_token
00250Ar 2  20 rr rr             JSR     emit_FEOLN
00250Dr 2  A9 03                LDA     #TY_BOOL
00250Fr 2  85 rr                STA     expr_type
002511r 2  60                   RTS
002512r 2               
002512r 2               ; NEW(p) — bump-allocate 2 bytes (pointer-to-INTEGER, v1) and store the
002512r 2               ; new heap address into pointer variable p.
002512r 2               ;   parse_arg_lvalue pushes &p; emit_NEW pushes the fresh pointer; STIND
002512r 2               ;   takes (NOS=addr, TOS=val) and writes val to addr.
002512r 2               parse_builtin_new:
002512r 2  20 rr rr             JSR     next_token              ; consume NEW
002515r 2  A9 1B                LDA     #TOK_LPAREN
002517r 2  20 rr rr             JSR     parse_eat_token
00251Ar 2  20 rr rr             JSR     parse_arg_lvalue        ; push &p
00251Dr 2  A9 1C                LDA     #TOK_RPAREN
00251Fr 2  20 rr rr             JSR     parse_eat_token
002522r 2  A9 00                LDA     #0
002524r 2  85 rr                STA     scratch                 ; size hi = 0
002526r 2  A9 02                LDA     #2                      ; v1: always allocate 2 bytes
002528r 2  20 rr rr             JSR     emit_NEW
00252Br 2  4C rr rr             JMP     emit_STIND
00252Er 2               
00252Er 2               ; DISPOSE(p) — bump allocator can't free, so just discard the pointer.
00252Er 2               parse_builtin_dispose:
00252Er 2  20 rr rr             JSR     next_token              ; consume DISPOSE
002531r 2  A9 1B                LDA     #TOK_LPAREN
002533r 2  20 rr rr             JSR     parse_eat_token
002536r 2  20 rr rr             JSR     parse_expression        ; push p (value)
002539r 2  A9 1C                LDA     #TOK_RPAREN
00253Br 2  20 rr rr             JSR     parse_eat_token
00253Er 2  4C rr rr             JMP     emit_DISP
002541r 2               
002541r 2               ; TRUE / FALSE — predefined boolean constants.  Push 1/0 as TY_BOOL so
002541r 2               ; pw_emit_file routes to FWRB ("TRUE"/"FALSE") and pw_emit_console to WRITB.
002541r 2               parse_builtin_true:
002541r 2  20 rr rr             JSR     next_token              ; consume TRUE
002544r 2  A9 01                LDA     #1
002546r 2  20 rr rr             JSR     emit_LDCB
002549r 2  A9 03                LDA     #TY_BOOL
00254Br 2  85 rr                STA     expr_type
00254Dr 2  60                   RTS
00254Er 2               
00254Er 2               parse_builtin_false:
00254Er 2  20 rr rr             JSR     next_token              ; consume FALSE
002551r 2  A9 00                LDA     #0
002553r 2  20 rr rr             JSR     emit_LDCB
002556r 2  A9 03                LDA     #TY_BOOL
002558r 2  85 rr                STA     expr_type
00255Ar 2  60                   RTS
00255Br 2               
00255Br 1                       .include        "SYMTAB.ASM"
00255Br 2               .PC02
00255Br 2               ; symtab.asm — symbol table for Pascal/65 compiler
00255Br 2               ;
00255Br 2               ; Each entry occupies 16 bytes in the SYMTAB_BASE area:
00255Br 2               ;   [0]    name length (1-15)
00255Br 2               ;   [1-15] name chars (uppercase, padded with spaces)
00255Br 2               ;   [16]   symbol kind: SYM_VAR, SYM_CONST, SYM_PROC, SYM_FUNC, SYM_TYPE, SYM_PARAM
00255Br 2               ;   [17]   data type:   TY_INT, TY_CHAR, TY_BOOL, TY_STRING, TY_ARRAY, TY_RECORD, TY_PTR, TY_TEXT, TY_SET
00255Br 2               ;   [18-19] value/offset (word): variable offset from BASE/MP; const value; proc address
00255Br 2               ;   [20]   scope depth (0=global)
00255Br 2               ;   [21]   parameter count (for SYM_PROC/SYM_FUNC)
00255Br 2               ;   [22-23] type info pointer (for array/record types)
00255Br 2               ;   [24-31] reserved
00255Br 2               
00255Br 2               SYM_ENTRY_SZ    = 32
00255Br 2               
00255Br 2               ; Symbol kinds
00255Br 2               SYM_VAR         = 1
00255Br 2               SYM_CONST       = 2
00255Br 2               SYM_PROC        = 3
00255Br 2               SYM_FUNC        = 4
00255Br 2               SYM_TYPE        = 5
00255Br 2               SYM_PARAM       = 6
00255Br 2               SYM_RETVAL      = 7             ; binding for `funcname := expr` in fn body
00255Br 2               SYM_VARREF      = 8             ; VAR (by-reference) parameter — local slot holds an address
00255Br 2               
00255Br 2               ; Data type codes
00255Br 2               TY_INT          = 1
00255Br 2               TY_CHAR         = 2
00255Br 2               TY_BOOL         = 3
00255Br 2               TY_STRING       = 4
00255Br 2               TY_ARRAY        = 5
00255Br 2               TY_RECORD       = 6
00255Br 2               TY_PTR          = 7
00255Br 2               TY_TEXT         = 8             ; TEXT file variable (168-byte struct)
00255Br 2               TY_SET          = 9             ; 16-bit set mask over element values 0..15
00255Br 2               TY_NONE         = 0             ; for procedures
00255Br 2               
00255Br 2                       .segment        "CODE"
00255Br 2               
00255Br 2               ; Number of entries currently in symbol table
00255Br 2               symtab_count:
00255Br 2  00 00                .WORD   0
00255Dr 2               
00255Dr 2               ; ---------------------------------------------------------------------------
00255Dr 2               ; symtab_init — clear symbol table
00255Dr 2               ; ---------------------------------------------------------------------------
00255Dr 2               symtab_init:
00255Dr 2  A9 00                LDA     #0
00255Fr 2  8D rr rr             STA     symtab_count
002562r 2  8D rr rr             STA     symtab_count+1
002565r 2  8D rr rr             STA     field_table_count
002568r 2  8D rr rr             STA     field_depth
00256Br 2  60                   RTS
00256Cr 2               
00256Cr 2               ; ---------------------------------------------------------------------------
00256Cr 2               ; field_table_add — append a record-field entry
00256Cr 2               ; Inputs:
00256Cr 2               ;   ident_buf = field name (length at [0], chars at [1..])
00256Cr 2               ;   A         = byte offset within the record
00256Cr 2               ;   X         = field data type (TY_*)
00256Cr 2               ; Returns: A = newly-assigned field index (current count - 1)
00256Cr 2               ;          carry set if field table is full (entry not added)
00256Cr 2               ; Clobbers: tmp2, tmp3, Y
00256Cr 2               ; ---------------------------------------------------------------------------
00256Cr 2               field_table_add:
00256Cr 2  48                   PHA                     ; save offset
00256Dr 2  8A                   TXA
00256Er 2  48                   PHA                     ; save type
00256Fr 2               ; capacity check (max 32 entries)
00256Fr 2  AD rr rr             LDA     field_table_count
002572r 2  C9 20                CMP     #32
002574r 2  90 04                BCC     :+
002576r 2  68                   PLA                     ; discard type
002577r 2  68                   PLA                     ; discard offset
002578r 2  38                   SEC
002579r 2  60                   RTS
00257Ar 2               :
00257Ar 2               ; compute entry address: field_table + count*16
00257Ar 2  AD rr rr             LDA     field_table_count
00257Dr 2  0A                   ASL
00257Er 2  0A                   ASL
00257Fr 2  0A                   ASL
002580r 2  0A                   ASL                     ; *16 (count<64 fits in 10 bits, but we land in low byte; high carry becomes part of address)
002581r 2  85 rr                STA     tmp2
002583r 2  A9 00                LDA     #0
002585r 2  2A                   ROL                     ; capture carry into hi
002586r 2  18                   CLC
002587r 2  69 rr                ADC     #>field_table
002589r 2  85 rr                STA     tmp2+1
00258Br 2  A5 rr                LDA     tmp2
00258Dr 2  18                   CLC
00258Er 2  69 rr                ADC     #<field_table
002590r 2  85 rr                STA     tmp2
002592r 2  90 02                BCC     :+
002594r 2  E6 rr                INC     tmp2+1
002596r 2               :
002596r 2               ; copy name length + chars
002596r 2  A0 00                LDY     #0
002598r 2  AD rr rr             LDA     ident_buf
00259Br 2  91 rr                STA     (tmp2),y
00259Dr 2  AA                   TAX                     ; X = length
00259Er 2  A0 01                LDY     #1
0025A0r 2               @nm:
0025A0r 2  C0 0D                CPY     #13
0025A2r 2  B0 0D                BCS     @padn
0025A4r 2  E0 00                CPX     #0
0025A6r 2  F0 09                BEQ     @padn
0025A8r 2  B9 rr rr             LDA     ident_buf,y
0025ABr 2  91 rr                STA     (tmp2),y
0025ADr 2  CA                   DEX
0025AEr 2  C8                   INY
0025AFr 2  80 EF                BRA     @nm
0025B1r 2               @padn:
0025B1r 2  C0 0D                CPY     #13
0025B3r 2  B0 07                BCS     @done_nm
0025B5r 2  A9 20                LDA     #' '
0025B7r 2  91 rr                STA     (tmp2),y
0025B9r 2  C8                   INY
0025BAr 2  80 F5                BRA     @padn
0025BCr 2               @done_nm:
0025BCr 2               ; offset (was on stack first → second pull)
0025BCr 2               ; type   (was on stack last  → first pull)
0025BCr 2  68                   PLA                     ; type
0025BDr 2  A0 0E                LDY     #14
0025BFr 2  91 rr                STA     (tmp2),y
0025C1r 2  68                   PLA                     ; offset
0025C2r 2  A0 0D                LDY     #13
0025C4r 2  91 rr                STA     (tmp2),y
0025C6r 2  AD rr rr             LDA     field_depth     ; nesting depth so scans can skip
0025C9r 2  A0 0F                LDY     #15             ; fields owned by deeper inline records
0025CBr 2  91 rr                STA     (tmp2),y
0025CDr 2               ; bump count, return new index
0025CDr 2  AD rr rr             LDA     field_table_count
0025D0r 2  EE rr rr             INC     field_table_count
0025D3r 2  18                   CLC
0025D4r 2  60                   RTS
0025D5r 2               
0025D5r 2               ; ---------------------------------------------------------------------------
0025D5r 2               ; field_lookup_in_record — find ident_buf among a contiguous range of fields
0025D5r 2               ; Inputs:
0025D5r 2               ;   ident_buf = field name to find
0025D5r 2               ;   A         = first field index in field_table
0025D5r 2               ;   X         = number of fields to scan
0025D5r 2               ; Returns: carry set = found
0025D5r 2               ;            A = byte offset within record
0025D5r 2               ;            X = field data type
0025D5r 2               ;          carry clear = not found
0025D5r 2               ; Clobbers: tmp2, tmp3, Y
0025D5r 2               ; ---------------------------------------------------------------------------
0025D5r 2               field_lookup_in_record:
0025D5r 2  85 rr                STA     tmp3            ; tmp3 = current field index
0025D7r 2  86 rr                STX     tmp3+1          ; tmp3+1 = remaining count
0025D9r 2               ; Read the depth of field[tmp3] — the scan's "target depth". Slots
0025D9r 2               ; deeper than this belong to inline sub-records and are skipped so
0025D9r 2               ; the scan stays at the record's own nesting level.
0025D9r 2  A5 rr                LDA     tmp3
0025DBr 2  0A                   ASL
0025DCr 2  0A                   ASL
0025DDr 2  0A                   ASL
0025DEr 2  0A                   ASL
0025DFr 2  85 rr                STA     tmp2
0025E1r 2  A9 00                LDA     #0
0025E3r 2  2A                   ROL
0025E4r 2  18                   CLC
0025E5r 2  69 rr                ADC     #>field_table
0025E7r 2  85 rr                STA     tmp2+1
0025E9r 2  A5 rr                LDA     tmp2
0025EBr 2  18                   CLC
0025ECr 2  69 rr                ADC     #<field_table
0025EEr 2  85 rr                STA     tmp2
0025F0r 2  90 02                BCC     :+
0025F2r 2  E6 rr                INC     tmp2+1
0025F4r 2               :
0025F4r 2  A0 0F                LDY     #15
0025F6r 2  B1 rr                LDA     (tmp2),y
0025F8r 2  8D rr rr             STA     field_lookup_depth
0025FBr 2               @scan:
0025FBr 2  A5 rr                LDA     tmp3+1
0025FDr 2  F0 4C                BEQ     @nf
0025FFr 2               ; compute entry addr: field_table + tmp3*16
0025FFr 2  A5 rr                LDA     tmp3
002601r 2  0A                   ASL
002602r 2  0A                   ASL
002603r 2  0A                   ASL
002604r 2  0A                   ASL                     ; *16 (low byte; carry → hi)
002605r 2  85 rr                STA     tmp2
002607r 2  A9 00                LDA     #0
002609r 2  2A                   ROL
00260Ar 2  18                   CLC
00260Br 2  69 rr                ADC     #>field_table
00260Dr 2  85 rr                STA     tmp2+1
00260Fr 2  A5 rr                LDA     tmp2
002611r 2  18                   CLC
002612r 2  69 rr                ADC     #<field_table
002614r 2  85 rr                STA     tmp2
002616r 2  90 02                BCC     :+
002618r 2  E6 rr                INC     tmp2+1
00261Ar 2               :
00261Ar 2               ; skip slots whose depth differs from the scan's target depth
00261Ar 2  A0 0F                LDY     #15
00261Cr 2  B1 rr                LDA     (tmp2),y
00261Er 2  CD rr rr             CMP     field_lookup_depth
002621r 2  D0 22                BNE     @next
002623r 2               ; compare name length
002623r 2  A0 00                LDY     #0
002625r 2  B1 rr                LDA     (tmp2),y
002627r 2  CD rr rr             CMP     ident_buf
00262Ar 2  D0 19                BNE     @next
00262Cr 2  AA                   TAX                     ; X = length
00262Dr 2  A0 01                LDY     #1
00262Fr 2               @cmpn:
00262Fr 2  B1 rr                LDA     (tmp2),y
002631r 2  D9 rr rr             CMP     ident_buf,y
002634r 2  D0 0F                BNE     @next
002636r 2  C8                   INY
002637r 2  CA                   DEX
002638r 2  D0 F5                BNE     @cmpn
00263Ar 2               ; match — return offset and type
00263Ar 2  A0 0E                LDY     #14
00263Cr 2  B1 rr                LDA     (tmp2),y        ; type
00263Er 2  AA                   TAX
00263Fr 2  A0 0D                LDY     #13
002641r 2  B1 rr                LDA     (tmp2),y        ; offset
002643r 2  38                   SEC
002644r 2  60                   RTS
002645r 2               @next:
002645r 2  E6 rr                INC     tmp3
002647r 2  C6 rr                DEC     tmp3+1
002649r 2  80 B0                BRA     @scan
00264Br 2               @nf:
00264Br 2  18                   CLC
00264Cr 2  60                   RTS
00264Dr 2               
00264Dr 2               ; ---------------------------------------------------------------------------
00264Dr 2               ; symtab_find — look up ident_buf in symbol table
00264Dr 2               ; Returns: carry set = found (tmp3 = pointer to entry)
00264Dr 2               ;          carry clear = not found
00264Dr 2               ; Searches from newest (highest index) to oldest for proper scoping
00264Dr 2               ; ---------------------------------------------------------------------------
00264Dr 2               symtab_find:
00264Dr 2  AD rr rr             LDA     symtab_count
002650r 2  0D rr rr             ORA     symtab_count+1
002653r 2  D0 02                BNE     :+
002655r 2  18                   CLC
002656r 2  60                   RTS                     ; empty table
002657r 2               :
002657r 2               ; start from last entry
002657r 2  AD rr rr             LDA     symtab_count
00265Ar 2  85 rr                STA     tmp2
00265Cr 2  AD rr rr             LDA     symtab_count+1
00265Fr 2  85 rr                STA     tmp2+1
002661r 2               @loop:
002661r 2  A5 rr                LDA     tmp2
002663r 2  05 rr                ORA     tmp2+1
002665r 2  F0 34                BEQ     @not_found
002667r 2               ; decrement tmp2
002667r 2  A5 rr                LDA     tmp2
002669r 2  D0 02                BNE     :+
00266Br 2  C6 rr                DEC     tmp2+1
00266Dr 2               :
00266Dr 2  C6 rr                DEC     tmp2
00266Fr 2               ; compute entry address: SYMTAB_BASE + tmp2 * SYM_ENTRY_SZ
00266Fr 2               ; tmp2 * 32 = tmp2 << 5
00266Fr 2  A5 rr                LDA     tmp2
002671r 2  0A                   ASL
002672r 2  0A                   ASL
002673r 2  0A                   ASL
002674r 2  0A                   ASL
002675r 2  0A                   ASL                     ; *32
002676r 2  18                   CLC
002677r 2  69 00                ADC     #<SYMTAB_BASE
002679r 2  85 rr                STA     tmp3
00267Br 2  A5 rr                LDA     tmp2+1
00267Dr 2  2A                   ROL
00267Er 2  69 80                ADC     #>SYMTAB_BASE
002680r 2  85 rr                STA     tmp3+1
002682r 2               ; compare name length
002682r 2  A0 00                LDY     #0
002684r 2  B1 rr                LDA     (tmp3),y
002686r 2  CD rr rr             CMP     ident_buf
002689r 2  D0 D6                BNE     @loop
00268Br 2               ; compare name chars
00268Br 2  AA                   TAX                     ; X = length
00268Cr 2  A0 00                LDY     #0
00268Er 2               @cmp:
00268Er 2  C8                   INY
00268Fr 2  B1 rr                LDA     (tmp3),y
002691r 2  D9 rr rr             CMP     ident_buf,y
002694r 2  D0 CB                BNE     @loop
002696r 2  CA                   DEX
002697r 2  D0 F5                BNE     @cmp
002699r 2  38                   SEC
00269Ar 2  60                   RTS
00269Br 2               @not_found:
00269Br 2  18                   CLC
00269Cr 2  60                   RTS
00269Dr 2               
00269Dr 2               ; ---------------------------------------------------------------------------
00269Dr 2               ; symtab_add — add entry to symbol table
00269Dr 2               ; Inputs:
00269Dr 2               ;   ident_buf = name
00269Dr 2               ;   A = kind (SYM_*)
00269Dr 2               ;   X = data type (TY_*)
00269Dr 2               ;   tmp2 = value/offset word (lo in tmp2, hi in tmp2+1)
00269Dr 2               ; Returns: tmp3 = pointer to new entry; carry set = table full
00269Dr 2               ; ---------------------------------------------------------------------------
00269Dr 2               symtab_add:
00269Dr 2  48                   PHA                     ; save kind (A) — the rest of this routine clobbers A
00269Er 2  8A                   TXA
00269Fr 2  48                   PHA                     ; save data type (X)
0026A0r 2               ; check capacity
0026A0r 2  AD rr rr             LDA     symtab_count+1
0026A3r 2  C9 00                CMP     #(SYMTAB_MAXSZ / SYM_ENTRY_SZ) >> 8
0026A5r 2  90 0B                BCC     :+
0026A7r 2  AD rr rr             LDA     symtab_count
0026AAr 2  C9 C0                CMP     #(SYMTAB_MAXSZ / SYM_ENTRY_SZ) & $FF
0026ACr 2  90 04                BCC     :+
0026AEr 2  68                   PLA                     ; discard saved type
0026AFr 2  68                   PLA                     ; discard saved kind
0026B0r 2  38                   SEC
0026B1r 2  60                   RTS                     ; table full
0026B2r 2               
0026B2r 2               :       ; compute address of new entry
0026B2r 2  AD rr rr             LDA     symtab_count
0026B5r 2  0A                   ASL
0026B6r 2  0A                   ASL
0026B7r 2  0A                   ASL
0026B8r 2  0A                   ASL
0026B9r 2  0A                   ASL                     ; *32
0026BAr 2  18                   CLC
0026BBr 2  69 00                ADC     #<SYMTAB_BASE
0026BDr 2  85 rr                STA     tmp3
0026BFr 2  AD rr rr             LDA     symtab_count+1
0026C2r 2  2A                   ROL
0026C3r 2  69 80                ADC     #>SYMTAB_BASE
0026C5r 2  85 rr                STA     tmp3+1
0026C7r 2               
0026C7r 2               ; copy name
0026C7r 2  A0 00                LDY     #0
0026C9r 2  AD rr rr             LDA     ident_buf       ; length
0026CCr 2  91 rr                STA     (tmp3),y
0026CEr 2  AA                   TAX
0026CFr 2               @name_copy:
0026CFr 2  C8                   INY
0026D0r 2  B9 rr rr             LDA     ident_buf,y
0026D3r 2  91 rr                STA     (tmp3),y
0026D5r 2  CA                   DEX
0026D6r 2  D0 F7                BNE     @name_copy
0026D8r 2               
0026D8r 2               ; fill unused name bytes with space
0026D8r 2  C8                   INY
0026D9r 2               @pad:
0026D9r 2  C0 10                CPY     #16
0026DBr 2  B0 07                BCS     @done_pad
0026DDr 2  A9 20                LDA     #' '
0026DFr 2  91 rr                STA     (tmp3),y
0026E1r 2  C8                   INY
0026E2r 2  80 F5                BRA     @pad
0026E4r 2               @done_pad:
0026E4r 2               
0026E4r 2               ; data type (was saved on stack first)
0026E4r 2  68                   PLA
0026E5r 2  A0 11                LDY     #17
0026E7r 2  91 rr                STA     (tmp3),y
0026E9r 2               
0026E9r 2               ; kind (was saved on stack second-to-last → on top first)
0026E9r 2  68                   PLA
0026EAr 2  A0 10                LDY     #16
0026ECr 2  91 rr                STA     (tmp3),y
0026EEr 2               
0026EEr 2               ; value/offset
0026EEr 2  A5 rr                LDA     tmp2
0026F0r 2  A0 12                LDY     #18
0026F2r 2  91 rr                STA     (tmp3),y
0026F4r 2  A5 rr                LDA     tmp2+1
0026F6r 2  A0 13                LDY     #19
0026F8r 2  91 rr                STA     (tmp3),y
0026FAr 2               
0026FAr 2               ; scope depth
0026FAr 2  A5 rr                LDA     scope_depth
0026FCr 2  A0 14                LDY     #20
0026FEr 2  91 rr                STA     (tmp3),y
002700r 2               
002700r 2               ; zero rest
002700r 2  A9 00                LDA     #0
002702r 2  A0 15                LDY     #21
002704r 2               @zero:
002704r 2  91 rr                STA     (tmp3),y
002706r 2  C8                   INY
002707r 2  C0 20                CPY     #SYM_ENTRY_SZ
002709r 2  90 F9                BCC     @zero
00270Br 2               
00270Br 2               ; increment count
00270Br 2  EE rr rr             INC     symtab_count
00270Er 2  D0 03                BNE     :+
002710r 2  EE rr rr             INC     symtab_count+1
002713r 2               :
002713r 2  18                   CLC
002714r 2  60                   RTS
002715r 2               
002715r 2               ; ---------------------------------------------------------------------------
002715r 2               ; symtab_enter_scope — increment scope depth
002715r 2               ; ---------------------------------------------------------------------------
002715r 2               symtab_enter_scope:
002715r 2  E6 rr                INC     scope_depth
002717r 2  60                   RTS
002718r 2               
002718r 2               ; ---------------------------------------------------------------------------
002718r 2               ; symtab_leave_scope — remove all entries at current scope, decrement depth
002718r 2               ; ---------------------------------------------------------------------------
002718r 2               symtab_leave_scope:
002718r 2               ; Remove all entries added at current scope depth, then decrement depth.
002718r 2               ; Entries are appended in order, so trim from the end.
002718r 2               @trim:
002718r 2  AD rr rr             LDA     symtab_count
00271Br 2  0D rr rr             ORA     symtab_count+1
00271Er 2  F0 34                BEQ     @done           ; table empty
002720r 2               ; compute address of last entry: SYMTAB_BASE + (count-1)*32
002720r 2  AD rr rr             LDA     symtab_count
002723r 2  38                   SEC
002724r 2  E9 01                SBC     #1
002726r 2  85 rr                STA     tmp2
002728r 2  AD rr rr             LDA     symtab_count+1
00272Br 2  E9 00                SBC     #0
00272Dr 2  85 rr                STA     tmp2+1
00272Fr 2               ; tmp2 * 32 (shift left 5) → entry address
00272Fr 2  A5 rr                LDA     tmp2
002731r 2  0A                   ASL
002732r 2  0A                   ASL
002733r 2  0A                   ASL
002734r 2  0A                   ASL
002735r 2  0A                   ASL
002736r 2  18                   CLC
002737r 2  69 00                ADC     #<SYMTAB_BASE
002739r 2  85 rr                STA     tmp3
00273Br 2  A5 rr                LDA     tmp2+1
00273Dr 2  2A                   ROL
00273Er 2  69 80                ADC     #>SYMTAB_BASE
002740r 2  85 rr                STA     tmp3+1
002742r 2               ; check scope depth field (offset 20 in entry)
002742r 2  A0 14                LDY     #20
002744r 2  B1 rr                LDA     (tmp3),y
002746r 2  C5 rr                CMP     scope_depth
002748r 2  D0 0A                BNE     @done           ; entry belongs to an outer scope — stop
00274Ar 2               ; remove this entry
00274Ar 2  CE rr rr             DEC     symtab_count
00274Dr 2  D0 C9                BNE     @trim
00274Fr 2  CE rr rr             DEC     symtab_count+1
002752r 2  80 C4                BRA     @trim
002754r 2               @done:
002754r 2  C6 rr                DEC     scope_depth
002756r 2  60                   RTS
002757r 2               
002757r 1                       .include        "CODEGEN.ASM"
002757r 2               ; codegen.asm — p-code emitter for Pascal/65 compiler
002757r 2               ;
002757r 2               ; All generated p-code accumulates in CODEBUF_BASE.
002757r 2               ; cg_pc (zero page) tracks the next write offset.
002757r 2               
002757r 2                       .segment        "CODE"
002757r 2               
002757r 2               ; ---------------------------------------------------------------------------
002757r 2               ; emit_byte — append byte A to code buffer
002757r 2               ; ---------------------------------------------------------------------------
002757r 2               emit_byte:
002757r 2  48                   PHA                     ; save byte to emit
002758r 2               ; check buffer full
002758r 2  A5 rr                LDA     cg_pc+1
00275Ar 2  C9 80                CMP     #>CODEBUF_MAXSZ
00275Cr 2  90 13                BCC     :+
00275Er 2  A5 rr                LDA     cg_pc
002760r 2  C9 00                CMP     #<CODEBUF_MAXSZ
002762r 2  90 0D                BCC     :+
002764r 2               ; error: p-code buffer full
002764r 2  68                   PLA
002765r 2  A9 rr                LDA     #<err_pcd_full
002767r 2  85 rr                STA     tmp0
002769r 2  A9 rr                LDA     #>err_pcd_full
00276Br 2  85 rr                STA     tmp0+1
00276Dr 2  20 rr rr             JSR     compile_error
002770r 2  60                   RTS
002771r 2               :
002771r 2               ; store at CODEBUF_BASE + cg_pc
002771r 2  A5 rr                LDA     cg_pc
002773r 2  18                   CLC
002774r 2  69 00                ADC     #<CODEBUF_BASE
002776r 2  85 rr                STA     tmp2
002778r 2  A5 rr                LDA     cg_pc+1
00277Ar 2  69 45                ADC     #>CODEBUF_BASE
00277Cr 2  85 rr                STA     tmp2+1
00277Er 2  68                   PLA
00277Fr 2  A0 00                LDY     #0
002781r 2  91 rr                STA     (tmp2),y
002783r 2               ; advance cg_pc
002783r 2  E6 rr                INC     cg_pc
002785r 2  D0 02                BNE     :+
002787r 2  E6 rr                INC     cg_pc+1
002789r 2               :
002789r 2  60                   RTS
00278Ar 2               
00278Ar 2               ; ---------------------------------------------------------------------------
00278Ar 2               ; emit_word — append word (lo then hi) from tmp2 to code buffer
00278Ar 2               ; ---------------------------------------------------------------------------
00278Ar 2               emit_word:
00278Ar 2  A5 rr                LDA     tmp2
00278Cr 2  20 rr rr             JSR     emit_byte
00278Fr 2  A5 rr                LDA     tmp2+1
002791r 2  20 rr rr             JSR     emit_byte
002794r 2  60                   RTS
002795r 2               
002795r 2               ; ---------------------------------------------------------------------------
002795r 2               ; emit_opcode — emit single opcode byte in A
002795r 2               ; ---------------------------------------------------------------------------
002795r 2               emit_opcode:
002795r 2  20 rr rr             JSR     emit_byte
002798r 2  60                   RTS
002799r 2               
002799r 2               ; --- Constant emitters ---
002799r 2               
002799r 2               emit_LDCI:                      ; push sign-extended byte in A
002799r 2  48                   PHA
00279Ar 2  A9 00                LDA     #OP_LDCI
00279Cr 2  20 rr rr             JSR     emit_byte
00279Fr 2  68                   PLA
0027A0r 2  20 rr rr             JSR     emit_byte
0027A3r 2  60                   RTS
0027A4r 2               
0027A4r 2               emit_LDCW:                      ; push word: lo in A, hi in scratch
0027A4r 2  48                   PHA
0027A5r 2  A9 01                LDA     #OP_LDCW
0027A7r 2  20 rr rr             JSR     emit_byte
0027AAr 2  68                   PLA
0027ABr 2  20 rr rr             JSR     emit_byte
0027AEr 2  A5 rr                LDA     scratch
0027B0r 2  20 rr rr             JSR     emit_byte
0027B3r 2  60                   RTS
0027B4r 2               
0027B4r 2               emit_LDCC:                      ; push char in A
0027B4r 2  48                   PHA
0027B5r 2  A9 02                LDA     #OP_LDCC
0027B7r 2  20 rr rr             JSR     emit_byte
0027BAr 2  68                   PLA
0027BBr 2  20 rr rr             JSR     emit_byte
0027BEr 2  60                   RTS
0027BFr 2               
0027BFr 2               emit_LDCB:                      ; push boolean in A (0=false, 1=true)
0027BFr 2  48                   PHA
0027C0r 2  A9 03                LDA     #OP_LDCB
0027C2r 2  20 rr rr             JSR     emit_byte
0027C5r 2  68                   PLA
0027C6r 2  20 rr rr             JSR     emit_byte
0027C9r 2  60                   RTS
0027CAr 2               
0027CAr 2               emit_LDCN:
0027CAr 2  A9 05                LDA     #OP_LDCN
0027CCr 2  20 rr rr             JSR     emit_byte
0027CFr 2  60                   RTS
0027D0r 2               
0027D0r 2               ; emit_LDCS — emit OP_LDCS followed by length byte and string bytes.
0027D0r 2               ; Source string lives in ident_buf (length at [0], chars at [1..N]).
0027D0r 2               ; The runtime will inline-fetch length+chars and push the address of
0027D0r 2               ; the length byte as a Pascal-style string pointer.
0027D0r 2               emit_LDCS:
0027D0r 2  A9 04                LDA     #OP_LDCS
0027D2r 2  20 rr rr             JSR     emit_byte
0027D5r 2  AD rr rr             LDA     ident_buf       ; length
0027D8r 2  85 rr                STA     scratch         ; counter / length cache
0027DAr 2  20 rr rr             JSR     emit_byte       ; emit length byte
0027DDr 2  A2 00                LDX     #0
0027DFr 2               @loop:
0027DFr 2  E4 rr                CPX     scratch
0027E1r 2  B0 0B                BCS     @done
0027E3r 2  BD rr rr             LDA     ident_buf+1,x
0027E6r 2  DA                   PHX
0027E7r 2  20 rr rr             JSR     emit_byte       ; clobbers tmp2 only
0027EAr 2  FA                   PLX
0027EBr 2  E8                   INX
0027ECr 2  80 F1                BRA     @loop
0027EEr 2               @done:
0027EEr 2  60                   RTS
0027EFr 2               
0027EFr 2               ; --- Local variable emitters ---
0027EFr 2               
