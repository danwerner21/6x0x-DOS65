002235r 2  A9 09                LDA     #TY_SET
002237r 2  85 rr                STA     expr_type
002239r 2  60                   RTS
00223Ar 2               
00223Ar 2               ; ---------------------------------------------------------------------------
00223Ar 2               ; parse_factor — literal | set-literal | variable | ( expr ) | NOT factor
00223Ar 2               ; ---------------------------------------------------------------------------
00223Ar 2               parse_factor:
00223Ar 2  A5 rr                LDA     tok_type
00223Cr 2  C9 02                CMP     #TOK_INT
00223Er 2  D0 03                BNE     :+
002240r 2  4C rr rr             JMP     @int_lit
002243r 2               :
002243r 2  C9 05                CMP     #TOK_REAL
002245r 2  D0 03                BNE     :+
002247r 2  4C rr rr             JMP     @real_lit
00224Ar 2               :
00224Ar 2  C9 04                CMP     #TOK_CHAR
00224Cr 2  D0 03                BNE     :+
00224Er 2  4C rr rr             JMP     @char_lit
002251r 2               :
002251r 2  C9 03                CMP     #TOK_STRING
002253r 2  D0 03                BNE     :+
002255r 2  4C rr rr             JMP     @str_lit
002258r 2               :
002258r 2  C9 1D                CMP     #TOK_LBRACK
00225Ar 2  D0 03                BNE     :+
00225Cr 2  4C rr rr             JMP     @set_lit
00225Fr 2               :
00225Fr 2  C9 01                CMP     #TOK_IDENT
002261r 2  D0 03                BNE     :+
002263r 2  4C rr rr             JMP     @ident_or_call
002266r 2               :
002266r 2  C9 1B                CMP     #TOK_LPAREN
002268r 2  D0 03                BNE     :+
00226Ar 2  4C rr rr             JMP     @paren
00226Dr 2               :
00226Dr 2  C9 50                CMP     #TOK_NOT
00226Fr 2  D0 03                BNE     :+
002271r 2  4C rr rr             JMP     @not_expr
002274r 2               :
002274r 2  C9 4F                CMP     #TOK_NIL
002276r 2  D0 03                BNE     :+
002278r 2  4C rr rr             JMP     @nil
00227Br 2               :
00227Br 2  60                   RTS
00227Cr 2               
00227Cr 2               @int_lit:
00227Cr 2  A5 rr                LDA     tok_ival_lo
00227Er 2  48                   PHA
00227Fr 2  A5 rr                LDA     tok_ival_hi
002281r 2  D0 11                BNE     @big_int
002283r 2  68                   PLA
002284r 2  30 0B                BMI     @big_int_lo     ; lo's bit 7 set — LDCI would sign-extend wrongly
002286r 2  20 rr rr             JSR     emit_LDCI
002289r 2  20 rr rr             JSR     next_token
00228Cr 2  A9 01                LDA     #TY_INT
00228Er 2  85 rr                STA     expr_type
002290r 2  60                   RTS
002291r 2               @big_int_lo:
002291r 2  48                   PHA
002292r 2  A9 00                LDA     #0
002294r 2               @big_int:
002294r 2  85 rr                STA     scratch
002296r 2  68                   PLA
002297r 2  20 rr rr             JSR     emit_LDCW
00229Ar 2  20 rr rr             JSR     next_token
00229Dr 2  A9 01                LDA     #TY_INT
00229Fr 2  85 rr                STA     expr_type
0022A1r 2  60                   RTS
0022A2r 2               
0022A2r 2               @real_lit:
0022A2r 2  A5 rr                LDA     tok_ival_hi
0022A4r 2  85 rr                STA     scratch
0022A6r 2  A5 rr                LDA     tok_ival_lo
0022A8r 2  20 rr rr             JSR     emit_LDCW
0022ABr 2  20 rr rr             JSR     next_token
0022AEr 2  A9 0A                LDA     #TY_REAL
0022B0r 2  85 rr                STA     expr_type
0022B2r 2  60                   RTS
0022B3r 2               
0022B3r 2               @char_lit:
0022B3r 2  A5 rr                LDA     tok_ival_lo
0022B5r 2  20 rr rr             JSR     emit_LDCC
0022B8r 2  20 rr rr             JSR     next_token
0022BBr 2  A9 02                LDA     #TY_CHAR
0022BDr 2  85 rr                STA     expr_type
0022BFr 2  60                   RTS
0022C0r 2               
0022C0r 2               @str_lit:
0022C0r 2               ; Inline string: emit OP_LDCS + length + chars.  Runtime pushes the
0022C0r 2               ; address of the length byte as a Pascal-string pointer.
0022C0r 2  20 rr rr             JSR     emit_LDCS
0022C3r 2  20 rr rr             JSR     next_token
0022C6r 2  A9 04                LDA     #TY_STRING
0022C8r 2  85 rr                STA     expr_type
0022CAr 2  60                   RTS
0022CBr 2               
0022CBr 2               @set_lit:
0022CBr 2  20 rr rr             JSR     parse_set_literal
0022CEr 2  60                   RTS
0022CFr 2               
0022CFr 2               @ident_or_call:
0022CFr 2               ; First check for built-ins (LENGTH/POS/COPY/CONCAT/EOF/EOLN/TRUE/FALSE)
0022CFr 2               ; by length+initial.  These take precedence over user identifiers
0022CFr 2               ; (matching WRITE/READ handling in parse_assign_or_call).  All dispatch
0022CFr 2               ; branches use JMPs because the target blocks are scattered too far for
0022CFr 2               ; ±127 byte BEQ range.
0022CFr 2  AD rr rr             LDA     ident_buf
0022D2r 2  C9 03                CMP     #3
0022D4r 2  D0 03                BNE     @bi_dn3
0022D6r 2  4C rr rr             JMP     @bi_chk3
0022D9r 2               @bi_dn3:
0022D9r 2  C9 04                CMP     #4
0022DBr 2  D0 03                BNE     @bi_dn4
0022DDr 2  4C rr rr             JMP     @bi_chk4
0022E0r 2               @bi_dn4:
0022E0r 2  C9 05                CMP     #5
0022E2r 2  D0 03                BNE     @bi_dn5
0022E4r 2  4C rr rr             JMP     @bi_chk5
0022E7r 2               @bi_dn5:
0022E7r 2  C9 06                CMP     #6
0022E9r 2  D0 03                BNE     @bi_dn6
0022EBr 2  4C rr rr             JMP     @bi_chk_len_or_cat
0022EEr 2               @bi_dn6:
0022EEr 2  4C rr rr             JMP     @do_lookup
0022F1r 2               @bi_chk4:
0022F1r 2               ; 4-letter built-ins: COPY, EOLN, TRUE
0022F1r 2  AD rr rr             LDA     ident_buf+1
0022F4r 2  C9 43                CMP     #'C'
0022F6r 2  D0 03                BNE     :+
0022F8r 2  4C rr rr             JMP     @bi_chk_copy
0022FBr 2               :
0022FBr 2  C9 45                CMP     #'E'
0022FDr 2  F0 07                BEQ     @bi_try_eoln
0022FFr 2  C9 54                CMP     #'T'
002301r 2  F0 1B                BEQ     @bi_try_true
002303r 2  4C rr rr             JMP     @do_lookup
002306r 2               @bi_try_eoln:
002306r 2  AD rr rr             LDA     ident_buf+2
002309r 2  C9 4F                CMP     #'O'
00230Br 2  D0 29                BNE     @bi4_no
00230Dr 2  AD rr rr             LDA     ident_buf+3
002310r 2  C9 4C                CMP     #'L'
002312r 2  D0 22                BNE     @bi4_no
002314r 2  AD rr rr             LDA     ident_buf+4
002317r 2  C9 4E                CMP     #'N'
002319r 2  D0 1B                BNE     @bi4_no
00231Br 2  4C rr rr             JMP     parse_builtin_eoln
00231Er 2               @bi_try_true:
00231Er 2  AD rr rr             LDA     ident_buf+2
002321r 2  C9 52                CMP     #'R'
002323r 2  D0 11                BNE     @bi4_no
002325r 2  AD rr rr             LDA     ident_buf+3
002328r 2  C9 55                CMP     #'U'
00232Ar 2  D0 0A                BNE     @bi4_no
00232Cr 2  AD rr rr             LDA     ident_buf+4
00232Fr 2  C9 45                CMP     #'E'
002331r 2  D0 03                BNE     @bi4_no
002333r 2  4C rr rr             JMP     parse_builtin_true
002336r 2               @bi4_no:
002336r 2  4C rr rr             JMP     @do_lookup
002339r 2               @bi_chk5:
002339r 2               ; 5-letter built-ins: FALSE
002339r 2  AD rr rr             LDA     ident_buf+1
00233Cr 2  C9 46                CMP     #'F'
00233Er 2  D0 1F                BNE     @bi5_no
002340r 2  AD rr rr             LDA     ident_buf+2
002343r 2  C9 41                CMP     #'A'
002345r 2  D0 18                BNE     @bi5_no
002347r 2  AD rr rr             LDA     ident_buf+3
00234Ar 2  C9 4C                CMP     #'L'
00234Cr 2  D0 11                BNE     @bi5_no
00234Er 2  AD rr rr             LDA     ident_buf+4
002351r 2  C9 53                CMP     #'S'
002353r 2  D0 0A                BNE     @bi5_no
002355r 2  AD rr rr             LDA     ident_buf+5
002358r 2  C9 45                CMP     #'E'
00235Ar 2  D0 03                BNE     @bi5_no
00235Cr 2  4C rr rr             JMP     parse_builtin_false
00235Fr 2               @bi5_no:
00235Fr 2  4C rr rr             JMP     @do_lookup
002362r 2               @bi_chk3:
002362r 2               ; 3-letter built-ins: POS, EOF
002362r 2  AD rr rr             LDA     ident_buf+1
002365r 2  C9 50                CMP     #'P'
002367r 2  F0 17                BEQ     @bi_chk_pos
002369r 2  C9 45                CMP     #'E'
00236Br 2  F0 02                BEQ     @bi_chk_eof
00236Dr 2  80 6E                BRA     @do_lookup
00236Fr 2               @bi_chk_eof:
00236Fr 2  AD rr rr             LDA     ident_buf+2
002372r 2  C9 4F                CMP     #'O'
002374r 2  D0 67                BNE     @do_lookup
002376r 2  AD rr rr             LDA     ident_buf+3
002379r 2  C9 46                CMP     #'F'
00237Br 2  D0 60                BNE     @do_lookup
00237Dr 2  4C rr rr             JMP     parse_builtin_eof
002380r 2               @bi_chk_pos:
002380r 2  AD rr rr             LDA     ident_buf+2
002383r 2  C9 4F                CMP     #'O'
002385r 2  D0 56                BNE     @do_lookup
002387r 2  AD rr rr             LDA     ident_buf+3
00238Ar 2  C9 53                CMP     #'S'
00238Cr 2  D0 4F                BNE     @do_lookup
00238Er 2  4C rr rr             JMP     parse_builtin_pos
002391r 2               @bi_chk_copy:
002391r 2  AD rr rr             LDA     ident_buf+1
002394r 2  C9 43                CMP     #'C'
002396r 2  D0 45                BNE     @do_lookup
002398r 2  AD rr rr             LDA     ident_buf+2
00239Br 2  C9 4F                CMP     #'O'
00239Dr 2  D0 3E                BNE     @do_lookup
00239Fr 2  AD rr rr             LDA     ident_buf+3
0023A2r 2  C9 50                CMP     #'P'
0023A4r 2  D0 37                BNE     @do_lookup
0023A6r 2  AD rr rr             LDA     ident_buf+4
0023A9r 2  C9 59                CMP     #'Y'
0023ABr 2  D0 30                BNE     @do_lookup
0023ADr 2  4C rr rr             JMP     parse_builtin_copy
0023B0r 2               @bi_chk_len_or_cat:
0023B0r 2  AD rr rr             LDA     ident_buf+1
0023B3r 2  C9 4C                CMP     #'L'
0023B5r 2  F0 15                BEQ     @bi_try_length
0023B7r 2  C9 43                CMP     #'C'
0023B9r 2  D0 22                BNE     @do_lookup
0023BBr 2               ; CONCAT? check 'O','N','C','A','T'
0023BBr 2  AD rr rr             LDA     ident_buf+2
0023BEr 2  C9 4F                CMP     #'O'
0023C0r 2  D0 1B                BNE     @do_lookup
0023C2r 2  AD rr rr             LDA     ident_buf+3
0023C5r 2  C9 4E                CMP     #'N'
0023C7r 2  D0 14                BNE     @do_lookup
0023C9r 2  4C rr rr             JMP     parse_builtin_concat
0023CCr 2               @bi_try_length:
0023CCr 2  AD rr rr             LDA     ident_buf+2
0023CFr 2  C9 45                CMP     #'E'
0023D1r 2  D0 0A                BNE     @do_lookup
0023D3r 2  AD rr rr             LDA     ident_buf+3
0023D6r 2  C9 4E                CMP     #'N'
0023D8r 2  D0 03                BNE     @do_lookup
0023DAr 2  4C rr rr             JMP     parse_builtin_length
0023DDr 2               @do_lookup:
0023DDr 2  20 rr rr             JSR     with_lookup_field
0023E0r 2  90 03                BCC     @lookup_symtab
0023E2r 2  4C rr rr             JMP     parse_with_field_load
0023E5r 2               @lookup_symtab:
0023E5r 2               ; Look up BEFORE next_token — next_token may overwrite ident_buf
0023E5r 2               ; if the following token is an identifier or keyword (e.g. J THEN).
0023E5r 2  20 rr rr             JSR     symtab_find
0023E8r 2  B0 0F                BCS     @sym_ok
0023EAr 2  20 rr rr             JSR     next_token      ; consume ident
0023EDr 2  A9 00                LDA     #0
0023EFr 2  85 rr                STA     scratch
0023F1r 2  20 rr rr             JSR     emit_LDCW       ; undefined: emit 0
0023F4r 2  A9 01                LDA     #TY_INT
0023F6r 2  85 rr                STA     expr_type
0023F8r 2  60                   RTS
0023F9r 2               @sym_ok:
0023F9r 2               ; Snapshot kind/type/scope/offset/pcount onto the 6502 stack —
0023F9r 2               ; sym_save_* would conflict with parse_assign_or_call when this
0023F9r 2               ; @ident_or_call runs inside a nested parse_expression.
0023F9r 2  A0 16                LDY     #22
0023FBr 2  B1 rr                LDA     (tmp3),y
0023FDr 2  8D rr rr             STA     fcall_vmask     ; (only meaningful for SYM_FUNC)
002400r 2  A0 17                LDY     #23
002402r 2  B1 rr                LDA     (tmp3),y
002404r 2  8D rr rr             STA     fcall_lsize     ; full local-area size for MRKSTK
002407r 2  A0 18                LDY     #24
002409r 2  A2 00                LDX     #0
00240Br 2               @copy_fptypes:
00240Br 2  B1 rr                LDA     (tmp3),y
00240Dr 2  9D rr rr             STA     fcall_param_types,x
002410r 2  C8                   INY
002411r 2  E8                   INX
002412r 2  E0 08                CPX     #8
002414r 2  90 F5                BCC     @copy_fptypes
002416r 2  A0 15                LDY     #21
002418r 2  B1 rr                LDA     (tmp3),y
00241Ar 2  48                   PHA                     ; pcount (deepest)
00241Br 2  A0 10                LDY     #16
00241Dr 2  B1 rr                LDA     (tmp3),y
00241Fr 2  48                   PHA                     ; kind
002420r 2  A0 11                LDY     #17
002422r 2  B1 rr                LDA     (tmp3),y
002424r 2  85 rr                STA     expr_type       ; data type code
002426r 2  A0 14                LDY     #20
002428r 2  B1 rr                LDA     (tmp3),y
00242Ar 2  48                   PHA                     ; scope
00242Br 2  A0 13                LDY     #19
00242Dr 2  B1 rr                LDA     (tmp3),y
00242Fr 2  48                   PHA                     ; off hi
002430r 2  A0 12                LDY     #18
002432r 2  B1 rr                LDA     (tmp3),y
002434r 2  48                   PHA                     ; off lo (top)
002435r 2  20 rr rr             JSR     next_token      ; consume ident (may overwrite ident_buf/tmp3)
002438r 2  68                   PLA                     ; off lo
002439r 2  AA                   TAX                     ; X = off lo
00243Ar 2  68                   PLA                     ; off hi
00243Br 2  85 rr                STA     scratch         ; scratch = off hi
00243Dr 2  68                   PLA                     ; scope
00243Er 2  A8                   TAY                     ; Y = scope (preserved across kind test)
00243Fr 2  68                   PLA                     ; kind
002440r 2  C9 04                CMP     #SYM_FUNC
002442r 2  D0 03                BNE     :+
002444r 2  4C rr rr             JMP     @sym_func_call
002447r 2               :
002447r 2  C9 02                CMP     #SYM_CONST
002449r 2  D0 03                BNE     :+
00244Br 2  4C rr rr             JMP     @const_emit
00244Er 2               :
00244Er 2  C9 08                CMP     #SYM_VARREF
002450r 2  D0 03                BNE     :+
002452r 2  4C rr rr             JMP     @varref_load
002455r 2               :
002455r 2               ; SYM_VAR (default; PROC also falls through here for now)
002455r 2  68                   PLA                     ; discard pcount
002456r 2  C0 00                CPY     #0
002458r 2  D0 25                BNE     @local_load
00245Ar 2               ; global SYM_VAR — check for array subscript, record field, or TEXT file
00245Ar 2  A5 rr                LDA     expr_type
00245Cr 2  C9 05                CMP     #TY_ARRAY
00245Er 2  F0 13                BEQ     @arr_rhs_global
002460r 2  C9 06                CMP     #TY_RECORD
002462r 2  F0 15                BEQ     @rec_rhs_global
002464r 2  C9 08                CMP     #TY_TEXT
002466r 2  F0 07                BEQ     @text_rhs_global
002468r 2  8A                   TXA
002469r 2  20 rr rr             JSR     emit_LDG
00246Cr 2  4C rr rr             JMP     @maybe_deref_ptr
00246Fr 2               @text_rhs_global:
00246Fr 2  8A                   TXA                     ; push struct address, leave expr_type=TY_TEXT
002470r 2  4C rr rr             JMP     emit_LDA_G
002473r 2               @arr_rhs_global:
002473r 2  8A                   TXA                     ; A=off_lo, scratch=off_hi still valid
002474r 2  20 rr rr             JSR     emit_LDA_G
002477r 2  80 23                BRA     @arr_rhs_index
002479r 2               @rec_rhs_global:
002479r 2  8A                   TXA                     ; A=off_lo, scratch=off_hi
00247Ar 2  20 rr rr             JSR     emit_LDA_G
00247Dr 2  80 4A                BRA     @rec_rhs_field
00247Fr 2               @local_load:
00247Fr 2  A5 rr                LDA     expr_type
002481r 2  C9 05                CMP     #TY_ARRAY
002483r 2  F0 13                BEQ     @arr_rhs_local
002485r 2  C9 06                CMP     #TY_RECORD
002487r 2  F0 3C                BEQ     @rec_rhs_local
002489r 2  C9 08                CMP     #TY_TEXT
00248Br 2  F0 07                BEQ     @text_rhs_local
00248Dr 2  8A                   TXA
