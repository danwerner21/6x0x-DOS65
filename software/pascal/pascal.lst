0016ADr 2               
0016ADr 2               ; ---------------------------------------------------------------------------
0016ADr 2               ; parse_assign_or_call — identifier already consumed by caller (in ident_buf)
0016ADr 2               ; If next is ':=' → assignment
0016ADr 2               ; If next is '(' → procedure call
0016ADr 2               ; If identifier is WRITE/WRITELN → built-in I/O
0016ADr 2               ; ---------------------------------------------------------------------------
0016ADr 2               parse_assign_or_call:
0016ADr 2               ; Dispatch built-in I/O procedures by length+initial letter.  RECORD/REPEAT
0016ADr 2               ; are reserved keywords so they never reach this dispatch as identifiers.
0016ADr 2               ;   len 3 : NEW
0016ADr 2               ;   len 4 : READ
0016ADr 2               ;   len 5 : WRITE  | RESET  | CLOSE
0016ADr 2               ;   len 6 : READLN | ASSIGN | APPEND
0016ADr 2               ;   len 7 : WRITELN| REWRITE | DISPOSE
0016ADr 2  AD rr rr             LDA     ident_buf       ; length
0016B0r 2  C9 03                CMP     #3
0016B2r 2  F0 16                BEQ     @chk_new
0016B4r 2  C9 04                CMP     #4
0016B6r 2  D0 03                bne     :+
0016B8r 2  4C rr rr             jmp     @chk_read
0016BBr 2               :
0016BBr 2  C9 05                CMP     #5
0016BDr 2  F0 2C                BEQ     @chk_len5
0016BFr 2  C9 06                CMP     #6
0016C1r 2  F0 40                BEQ     @chk_len6
0016C3r 2  C9 07                CMP     #7
0016C5r 2  F0 5B                BEQ     @chk_len7
0016C7r 2  4C rr rr             JMP     @lookup_sym
0016CAr 2               
0016CAr 2               @chk_new:
0016CAr 2               ; "NEW" (3)
0016CAr 2  AD rr rr             LDA     ident_buf+1
0016CDr 2  C9 4E                CMP     #'N'
0016CFr 2  F0 03                beq     :+
0016D1r 2  4C rr rr             JMP     @lookup_sym
0016D4r 2               :
0016D4r 2  AD rr rr             LDA     ident_buf+2
0016D7r 2  C9 45                CMP     #'E'
0016D9r 2  F0 03                beq     :+
0016DBr 2  4C rr rr             JMP     @lookup_sym
0016DEr 2               :
0016DEr 2  AD rr rr             LDA     ident_buf+3
0016E1r 2  C9 57                CMP     #'W'
0016E3r 2  F0 03                BEQ     :+
0016E5r 2  4C rr rr             JMP     @lookup_sym
0016E8r 2               :
0016E8r 2  4C rr rr             JMP     parse_builtin_new
0016EBr 2               
0016EBr 2               @chk_len5:
0016EBr 2  AD rr rr             LDA     ident_buf+1
0016EEr 2  C9 57                CMP     #'W'
0016F0r 2  F0 5A                BEQ     @chk_write
0016F2r 2  C9 52                CMP     #'R'
0016F4r 2  D0 03                BNE     :+
0016F6r 2  4C rr rr             JMP     @chk_reset
0016F9r 2               :
0016F9r 2  C9 43                CMP     #'C'
0016FBr 2  D0 03                BNE     :+
0016FDr 2  4C rr rr             JMP     @chk_close
001700r 2               :
001700r 2  4C rr rr             JMP     @lookup_sym
001703r 2               
001703r 2               @chk_len6:
001703r 2  AD rr rr             LDA     ident_buf+1
001706r 2  C9 52                CMP     #'R'
001708r 2  F0 7B                BEQ     @chk_readln
00170Ar 2  C9 41                CMP     #'A'
00170Cr 2  F0 03                BEQ     @chk_len6_a
00170Er 2  4C rr rr             JMP     @lookup_sym
001711r 2               @chk_len6_a:
001711r 2  AD rr rr             LDA     ident_buf+2
001714r 2  C9 50                CMP     #'P'
001716r 2  D0 03                BNE     :+
001718r 2  4C rr rr             JMP     @chk_append
00171Br 2               :
00171Br 2  C9 53                CMP     #'S'
00171Dr 2  F0 7A                BEQ     @chk_assign
00171Fr 2  4C rr rr             JMP     @lookup_sym
001722r 2               
001722r 2               @chk_len7:
001722r 2  AD rr rr             LDA     ident_buf+1
001725r 2  C9 57                CMP     #'W'
001727r 2  F0 31                BEQ     @chk_writeln
001729r 2  C9 52                CMP     #'R'
00172Br 2  F0 75                BEQ     @chk_rewrite
00172Dr 2  C9 44                CMP     #'D'
00172Fr 2  F0 03                BEQ     @chk_dispose
001731r 2  4C rr rr             JMP     @lookup_sym
001734r 2               
001734r 2               @chk_dispose:
001734r 2               ; "DISPOSE" (7) — verify I,S,P,O,S,E
001734r 2  AD rr rr             LDA     ident_buf+2
001737r 2  C9 49                CMP     #'I'
001739r 2  D0 6D                BNE     @lookup_sym_jmp
00173Br 2  AD rr rr             LDA     ident_buf+3
00173Er 2  C9 53                CMP     #'S'
001740r 2  D0 66                BNE     @lookup_sym_jmp
001742r 2  AD rr rr             LDA     ident_buf+4
001745r 2  C9 50                CMP     #'P'
001747r 2  D0 5F                BNE     @lookup_sym_jmp
001749r 2  4C rr rr             JMP     parse_builtin_dispose
