001467r 2  A9 03                LDA     #TY_BOOL
001469r 2  85 rr                STA     expr_type
00146Br 2  80 AD                BRA     @mulop
00146Dr 2               
00146Dr 2               TOK_DIV_KW      = TOK_DIV       ; alias
00146Dr 2               
00146Dr 2               ; ---------------------------------------------------------------------------
00146Dr 2               ; parse_factor — literal | variable | ( expr ) | NOT factor
00146Dr 2               ; ---------------------------------------------------------------------------
00146Dr 2               parse_factor:
00146Dr 2  A5 rr                LDA     tok_type
00146Fr 2  C9 02                CMP     #TOK_INT
001471r 2  D0 03                BNE     :+
001473r 2  4C rr rr             JMP     @int_lit
001476r 2               :
001476r 2  C9 04                CMP     #TOK_CHAR
001478r 2  D0 03                BNE     :+
00147Ar 2  4C rr rr             JMP     @char_lit
00147Dr 2               :
00147Dr 2  C9 03                CMP     #TOK_STRING
00147Fr 2  D0 03                BNE     :+
001481r 2  4C rr rr             JMP     @str_lit
001484r 2               :
001484r 2  C9 01                CMP     #TOK_IDENT
001486r 2  D0 03                BNE     :+
001488r 2  4C rr rr             JMP     @ident_or_call
00148Br 2               :
00148Br 2  C9 1B                CMP     #TOK_LPAREN
00148Dr 2  D0 03                BNE     :+
00148Fr 2  4C rr rr             JMP     @paren
001492r 2               :
001492r 2  C9 4F                CMP     #TOK_NOT
001494r 2  D0 03                BNE     :+
001496r 2  4C rr rr             JMP     @not_expr
001499r 2               :
001499r 2  C9 4E                CMP     #TOK_NIL
00149Br 2  D0 03                BNE     :+
