0012B1r 2  20 rr rr             JSR     parse_simple_expr
0012B4r 2  20 rr rr             JSR     emit_GEQI
0012B7r 2               @rel_done:
0012B7r 2  A9 03                LDA     #TY_BOOL
0012B9r 2  85 rr                STA     expr_type
0012BBr 2  60                   RTS
