0012BCr 2               ; ---------------------------------------------------------------------------
0012BCr 2               ; parse_simple_expr — term { (+|-|OR) term }
0012BCr 2               ; ---------------------------------------------------------------------------
0012BCr 2               parse_simple_expr:
0012BCr 2               ; check for unary minus
0012BCr 2  A5 rr                LDA     tok_type
0012BEr 2  C9 11                CMP     #TOK_MINUS
0012C0r 2  D0 0E                BNE     :+
0012C2r 2  20 rr rr             JSR     next_token
0012C5r 2  20 rr rr             JSR     parse_term
0012C8r 2  20 rr rr             JSR     emit_NGI
0012CBr 2  A9 01                LDA     #TY_INT
0012CDr 2  85 rr                STA     expr_type
0012CFr 2  60                   RTS
0012D0r 2               :
0012D0r 2  20 rr rr             JSR     parse_term
0012D3r 2               @addop:
0012D3r 2  A5 rr                LDA     tok_type
0012D5r 2  C9 10                CMP     #TOK_PLUS
0012D7r 2  F0 09                BEQ     @add
0012D9r 2  C9 11                CMP     #TOK_MINUS
0012DBr 2  F0 14                BEQ     @sub
0012DDr 2  C9 51                CMP     #TOK_OR
0012DFr 2  F0 1F                BEQ     @or
0012E1r 2  60                   RTS
