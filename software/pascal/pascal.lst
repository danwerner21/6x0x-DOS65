0017D6r 2  A0 14                LDY     #20
0017D8r 2  B1 rr                LDA     (tmp3),y
0017DAr 2  8D rr rr             STA     sym_save_scope
0017DDr 2  A0 12                LDY     #18
0017DFr 2  B1 rr                LDA     (tmp3),y
