0018F5r 2  85 rr                STA     expr_type
0018F7r 2  60                   RTS
0018F8r 2               
0018F8r 1                       .include        "SYMTAB.ASM"
0018F8r 2               .PC02
0018F8r 2               ; symtab.asm — symbol table for Pascal/65 compiler
0018F8r 2               ;
0018F8r 2               ; Each entry occupies 16 bytes in the SYMTAB_BASE area:
0018F8r 2               ;   [0]    name length (1-15)
0018F8r 2               ;   [1-15] name chars (uppercase, padded with spaces)
0018F8r 2               ;   [16]   symbol kind: SYM_VAR, SYM_CONST, SYM_PROC, SYM_FUNC, SYM_TYPE, SYM_PARAM
0018F8r 2               ;   [17]   data type:   TY_INT, TY_CHAR, TY_BOOL, TY_STRING, TY_ARRAY, TY_RECORD, TY_PTR
0018F8r 2               ;   [18-19] value/offset (word): variable offset from BASE/MP; const value; proc address
0018F8r 2               ;   [20]   scope depth (0=global)
0018F8r 2               ;   [21]   parameter count (for SYM_PROC/SYM_FUNC)
0018F8r 2               ;   [22-23] type info pointer (for array/record types)
0018F8r 2               ;   [24-31] reserved
0018F8r 2               
0018F8r 2               SYM_ENTRY_SZ    = 32
0018F8r 2               
0018F8r 2               ; Symbol kinds
0018F8r 2               SYM_VAR         = 1
0018F8r 2               SYM_CONST       = 2
0018F8r 2               SYM_PROC        = 3
0018F8r 2               SYM_FUNC        = 4
0018F8r 2               SYM_TYPE        = 5
0018F8r 2               SYM_PARAM       = 6
0018F8r 2               SYM_RETVAL      = 7             ; binding for `funcname := expr` in fn body
0018F8r 2               SYM_VARREF      = 8             ; VAR (by-reference) parameter — local slot holds an address
0018F8r 2               
0018F8r 2               ; Data type codes
0018F8r 2               TY_INT          = 1
0018F8r 2               TY_CHAR         = 2
0018F8r 2               TY_BOOL         = 3
0018F8r 2               TY_STRING       = 4
0018F8r 2               TY_ARRAY        = 5
0018F8r 2               TY_RECORD       = 6
0018F8r 2               TY_PTR          = 7
0018F8r 2               TY_TEXT         = 8             ; TEXT file variable (168-byte struct)
0018F8r 2               TY_NONE         = 0             ; for procedures
0018F8r 2               
0018F8r 2                       .segment        "CODE"
0018F8r 2               
0018F8r 2               ; Number of entries currently in symbol table
0018F8r 2               symtab_count:
0018F8r 2  00 00                .WORD   0
0018FAr 2               
0018FAr 2               ; ---------------------------------------------------------------------------
0018FAr 2               ; symtab_init — clear symbol table
0018FAr 2               ; ---------------------------------------------------------------------------
0018FAr 2               symtab_init:
0018FAr 2  A9 00                LDA     #0
0018FCr 2  8D rr rr             STA     symtab_count
0018FFr 2  8D rr rr             STA     symtab_count+1
001902r 2  8D rr rr             STA     field_table_count
001905r 2  60                   RTS
001906r 2               
001906r 2               ; ---------------------------------------------------------------------------
001906r 2               ; field_table_add — append a record-field entry
001906r 2               ; Inputs:
001906r 2               ;   ident_buf = field name (length at [0], chars at [1..])
001906r 2               ;   A         = byte offset within the record
001906r 2               ;   X         = field data type (TY_*)
001906r 2               ; Returns: A = newly-assigned field index (current count - 1)
001906r 2               ;          carry set if field table is full (entry not added)
001906r 2               ; Clobbers: tmp2, tmp3, Y
001906r 2               ; ---------------------------------------------------------------------------
001906r 2               field_table_add:
001906r 2  48                   PHA                     ; save offset
001907r 2  8A                   TXA
001908r 2  48                   PHA                     ; save type
001909r 2               ; capacity check (max 32 entries)
001909r 2  AD rr rr             LDA     field_table_count
00190Cr 2  C9 20                CMP     #32
00190Er 2  90 04                BCC     :+
001910r 2  68                   PLA                     ; discard type
001911r 2  68                   PLA                     ; discard offset
001912r 2  38                   SEC
001913r 2  60                   RTS
001914r 2               :
001914r 2               ; compute entry address: field_table + count*16
001914r 2  AD rr rr             LDA     field_table_count
001917r 2  0A                   ASL
001918r 2  0A                   ASL
001919r 2  0A                   ASL
00191Ar 2  0A                   ASL                     ; *16 (count<64 fits in 10 bits, but we land in low byte; high carry becomes part of address)
00191Br 2  85 rr                STA     tmp2
00191Dr 2  A9 00                LDA     #0
00191Fr 2  2A                   ROL                     ; capture carry into hi
001920r 2  18                   CLC
001921r 2  69 rr                ADC     #>field_table
001923r 2  85 rr                STA     tmp2+1
001925r 2  A5 rr                LDA     tmp2
