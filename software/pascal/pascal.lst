0012FAr 2  D0 0C                BNE     @fc_emit_call
0012FCr 2  20 rr rr             JSR     next_token
0012FFr 2  A5 rr                LDA     tok_type
001301r 2  C9 1C                CMP     #TOK_RPAREN
001303r 2  D0 03                BNE     @fc_emit_call
001305r 2  20 rr rr             JSR     next_token
001308r 2               @fc_emit_call:
001308r 2  AD rr rr             LDA     fcall_hi
00130Br 2  85 rr                STA     scratch
00130Dr 2  AD rr rr             LDA     fcall_lo
001310r 2  20 rr rr             JSR     emit_CALL
