001A81r 2  18                   CLC
001A82r 2  60                   RTS
001A83r 2               
001A83r 2               ; ---------------------------------------------------------------------------
001A83r 2               ; symtab_enter_scope — increment scope depth
001A83r 2               ; ---------------------------------------------------------------------------
001A83r 2               symtab_enter_scope:
001A83r 2  E6 rr                INC     scope_depth
001A85r 2  60                   RTS
001A86r 2               
001A86r 2               ; ---------------------------------------------------------------------------
001A86r 2               ; symtab_leave_scope — remove all entries at current scope, decrement depth
001A86r 2               ; ---------------------------------------------------------------------------
001A86r 2               symtab_leave_scope:
001A86r 2               ; Remove all entries added at current scope depth, then decrement depth.
001A86r 2               ; Entries are appended in order, so trim from the end.
001A86r 2               @trim:
001A86r 2  AD rr rr             LDA     symtab_count
001A89r 2  0D rr rr             ORA     symtab_count+1
001A8Cr 2  F0 34                BEQ     @done           ; table empty
