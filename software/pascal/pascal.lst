001B7Er 2               
001B7Er 2               ; --- Global variable emitters ---
001B7Er 2               
001B7Er 2               emit_LDG:                       ; word offset: lo in A, hi in scratch
001B7Er 2  48                   PHA
001B7Fr 2  A9 18                LDA     #OP_LDG
001B81r 2  20 rr rr             JSR     emit_byte
001B84r 2  68                   PLA
001B85r 2  20 rr rr             JSR     emit_byte
001B88r 2  A5 rr                LDA     scratch
001B8Ar 2  20 rr rr             JSR     emit_byte
001B8Dr 2  60                   RTS
001B8Er 2               
001B8Er 2               emit_STG:
001B8Er 2  48                   PHA
001B8Fr 2  A9 19                LDA     #OP_STG
001B91r 2  20 rr rr             JSR     emit_byte
001B94r 2  68                   PLA
001B95r 2  20 rr rr             JSR     emit_byte
001B98r 2  A5 rr                LDA     scratch
001B9Ar 2  20 rr rr             JSR     emit_byte
001B9Dr 2  60                   RTS
001B9Er 2               
001B9Er 2               emit_LDA_G:                     ; word offset: lo in A, hi in scratch
001B9Er 2  48                   PHA
001B9Fr 2  A9 1A                LDA     #OP_LDA_G
001BA1r 2  20 rr rr             JSR     emit_byte
001BA4r 2  68                   PLA
001BA5r 2  20 rr rr             JSR     emit_byte
001BA8r 2  A5 rr                LDA     scratch
001BAAr 2  20 rr rr             JSR     emit_byte
001BADr 2  60                   RTS
001BAEr 2               
001BAEr 2               ; --- Indirect (VAR-param) emitters ---
001BAEr 2               
001BAEr 2               emit_LDIND:
001BAEr 2  A9 20                LDA     #OP_LDIND
001BB0r 2  4C rr rr             JMP     emit_byte
001BB3r 2               
001BB3r 2               emit_STIND:
001BB3r 2  A9 21                LDA     #OP_STIND
001BB5r 2  4C rr rr             JMP     emit_byte
001BB8r 2               
001BB8r 2               ; emit_INDEX — OP_INDEX + 2-byte element size word (lo in A, hi in scratch)
001BB8r 2               emit_INDEX:
001BB8r 2  48                   PHA
001BB9r 2  A9 24                LDA     #OP_INDEX
001BBBr 2  20 rr rr             JSR     emit_byte
001BBEr 2  68                   PLA
001BBFr 2  20 rr rr             JSR     emit_byte
001BC2r 2  A5 rr                LDA     scratch
001BC4r 2  20 rr rr             JSR     emit_byte
001BC7r 2  60                   RTS
001BC8r 2               
001BC8r 2               ; ---------------------------------------------------------------------------
001BC8r 2               ; codegen_alloc_array_global — allocate ARRAY [array_lo..array_hi] in globals
001BC8r 2               ; Element size fixed at 2 (all scalars are word-sized).
001BC8r 2               ; Returns: tmp2 = adjusted_offset = raw_base - lo*2
001BC8r 2               ;          cg_globals advanced by (hi - lo + 1) * 2
001BC8r 2               ; Clobbers: tmp2, tmp3
001BC8r 2               ; ---------------------------------------------------------------------------
001BC8r 2               codegen_alloc_array_global:
001BC8r 2               ; count = hi - lo + 1  (16-bit)
001BC8r 2  AD rr rr             LDA     array_hi
001BCBr 2  38                   SEC
001BCCr 2  ED rr rr             SBC     array_lo
001BCFr 2  85 rr                STA     tmp2
001BD1r 2  AD rr rr             LDA     array_hi+1
001BD4r 2  ED rr rr             SBC     array_lo+1
001BD7r 2  85 rr                STA     tmp2+1
001BD9r 2  E6 rr                INC     tmp2
001BDBr 2  D0 02                BNE     :+
001BDDr 2  E6 rr                INC     tmp2+1
001BDFr 2               :
001BDFr 2               ; alloc_size = count * 2
001BDFr 2  06 rr                ASL     tmp2
001BE1r 2  26 rr                ROL     tmp2+1
001BE3r 2               ; save raw_base = cg_globals before advancing
001BE3r 2  A5 rr                LDA     cg_globals
001BE5r 2  85 rr                STA     tmp3
001BE7r 2  A5 rr                LDA     cg_globals+1
001BE9r 2  85 rr                STA     tmp3+1
001BEBr 2               ; advance cg_globals by alloc_size (tmp2)
001BEBr 2  A5 rr                LDA     cg_globals
001BEDr 2  18                   CLC
001BEEr 2  65 rr                ADC     tmp2
001BF0r 2  85 rr                STA     cg_globals
001BF2r 2  A5 rr                LDA     cg_globals+1
001BF4r 2  65 rr                ADC     tmp2+1
001BF6r 2  85 rr                STA     cg_globals+1
001BF8r 2               ; adjusted_offset = raw_base (tmp3) - lo*2 (tmp2 reused)
001BF8r 2  AD rr rr             LDA     array_lo
001BFBr 2  0A                   ASL
001BFCr 2  85 rr                STA     tmp2
001BFEr 2  AD rr rr             LDA     array_lo+1
001C01r 2  2A                   ROL
001C02r 2  85 rr                STA     tmp2+1
001C04r 2  A5 rr                LDA     tmp3
001C06r 2  38                   SEC
001C07r 2  E5 rr                SBC     tmp2
001C09r 2  85 rr                STA     tmp2
001C0Br 2  A5 rr                LDA     tmp3+1
001C0Dr 2  E5 rr                SBC     tmp2+1
001C0Fr 2  85 rr                STA     tmp2+1
001C11r 2  60                   RTS
001C12r 2               
001C12r 2               ; ---------------------------------------------------------------------------
001C12r 2               ; codegen_alloc_record_global — reserve record_size bytes in globals
001C12r 2               ; Returns: tmp2 = offset of record's first byte
001C12r 2               ;          cg_globals advanced by record_size
001C12r 2               ; ---------------------------------------------------------------------------
001C12r 2               codegen_alloc_record_global:
001C12r 2  A5 rr                LDA     cg_globals
001C14r 2  85 rr                STA     tmp2
001C16r 2  A5 rr                LDA     cg_globals+1
001C18r 2  85 rr                STA     tmp2+1
001C1Ar 2  18                   CLC
001C1Br 2  A5 rr                LDA     cg_globals
001C1Dr 2  6D rr rr             ADC     record_size
001C20r 2  85 rr                STA     cg_globals
001C22r 2  A5 rr                LDA     cg_globals+1
001C24r 2  6D rr rr             ADC     record_size+1
001C27r 2  85 rr                STA     cg_globals+1
001C29r 2  60                   RTS
001C2Ar 2               
001C2Ar 2               ; ---------------------------------------------------------------------------
001C2Ar 2               ; codegen_alloc_text_global — reserve FILE_STRUCT_SZ (168) bytes for a TEXT
001C2Ar 2               ; variable.  Returns tmp2 = offset of struct's first byte; cg_globals bumped.
001C2Ar 2               ; ---------------------------------------------------------------------------
001C2Ar 2               codegen_alloc_text_global:
001C2Ar 2  A5 rr                LDA     cg_globals
001C2Cr 2  85 rr                STA     tmp2
001C2Er 2  A5 rr                LDA     cg_globals+1
001C30r 2  85 rr                STA     tmp2+1
001C32r 2  18                   CLC
001C33r 2  A5 rr                LDA     cg_globals
001C35r 2  69 A8                ADC     #FILE_STRUCT_SZ
001C37r 2  85 rr                STA     cg_globals
001C39r 2  A5 rr                LDA     cg_globals+1
001C3Br 2  69 00                ADC     #0
001C3Dr 2  85 rr                STA     cg_globals+1
001C3Fr 2  60                   RTS
001C40r 2               
001C40r 2               ; --- Arithmetic emitters ---
001C40r 2               
001C40r 2               emit_ADI:
001C40r 2  A9 30                LDA     #OP_ADI
001C42r 2  4C rr rr             JMP     emit_byte
001C45r 2               
001C45r 2               emit_SBI:
001C45r 2  A9 31                LDA     #OP_SBI
001C47r 2  4C rr rr             JMP     emit_byte
001C4Ar 2               
001C4Ar 2               emit_MPI:
001C4Ar 2  A9 32                LDA     #OP_MPI
001C4Cr 2  4C rr rr             JMP     emit_byte
001C4Fr 2               
001C4Fr 2               emit_DVI:
001C4Fr 2  A9 33                LDA     #OP_DVI
001C51r 2  4C rr rr             JMP     emit_byte
001C54r 2               
001C54r 2               emit_MOD:
001C54r 2  A9 34                LDA     #OP_MOD
001C56r 2  4C rr rr             JMP     emit_byte
001C59r 2               
