0015D9r 2  F0 16                BEQ     @chk_new
0015DBr 2  C9 04                CMP     #4
0015DDr 2  D0 03                bne     :+
0015DFr 2  4C rr rr             jmp     @chk_read
0015E2r 2               :
0015E2r 2  C9 05                CMP     #5
0015E4r 2  F0 2C                BEQ     @chk_len5
0015E6r 2  C9 06                CMP     #6
0015E8r 2  F0 40                BEQ     @chk_len6
0015EAr 2  C9 07                CMP     #7
0015ECr 2  F0 5B                BEQ     @chk_len7
