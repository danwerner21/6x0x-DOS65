00128Dr 2  20 rr rr             JSR     parse_simple_expr
001290r 2  20 rr rr             JSR     emit_LESI
001293r 2  4C rr rr             JMP     @rel_done
001296r 2               @rel_gt:
001296r 2  20 rr rr             JSR     next_token
001299r 2  20 rr rr             JSR     parse_simple_expr
00129Cr 2  20 rr rr             JSR     emit_GTRI
00129Fr 2  4C rr rr             JMP     @rel_done
0012A2r 2               @rel_leq:
0012A2r 2  20 rr rr             JSR     next_token
0012A5r 2  20 rr rr             JSR     parse_simple_expr
