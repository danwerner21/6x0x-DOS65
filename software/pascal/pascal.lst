001499r 2               
001499r 2               emit_LDCI:                      ; push sign-extended byte in A
001499r 2  48                   PHA
00149Ar 2  A9 00                LDA     #OP_LDCI
00149Cr 2  20 rr rr             JSR     emit_byte
00149Fr 2  68                   PLA
0014A0r 2  20 rr rr             JSR     emit_byte
0014A3r 2  60                   RTS
0014A4r 2               
0014A4r 2               emit_LDCW:                      ; push word: lo in A, hi in scratch
0014A4r 2  48                   PHA
