0018F4r 2  AD rr rr             LDA     sym_save_scope
0018F7r 2  D0 0D                BNE     @rec_la_local
0018F9r 2  AD rr rr             LDA     sym_save_off+1
0018FCr 2  85 rr                STA     scratch
