002185r 2  60                   RTS
002186r 2               
002186r 2               ; parse_set_literal — current token is '['. Supports [] and constant integer
002186r 2               ; items/ranges like [1,3,5] and [3..6]. Elements must be 0..15 in this build.
002186r 2               parse_set_literal:
002186r 2  A9 00                LDA     #0
002188r 2  8D rr rr             STA     set_lit_mask
00218Br 2  8D rr rr             STA     set_lit_mask+1
00218Er 2  20 rr rr             JSR     next_token              ; consume '['
002191r 2  A5 rr                LDA     tok_type
002193r 2  C9 1E                CMP     #TOK_RBRACK
002195r 2  D0 03                BNE     @psl_item
002197r 2  4C rr rr             JMP     @psl_close
00219Ar 2               @psl_item:
00219Ar 2  A5 rr                LDA     tok_type
00219Cr 2  C9 02                CMP     #TOK_INT
00219Er 2  D0 55                BNE     @psl_bad_item
0021A0r 2  A5 rr                LDA     tok_ival_hi
0021A2r 2  D0 51                BNE     @psl_bad_item
0021A4r 2  A5 rr                LDA     tok_ival_lo
0021A6r 2  C9 10                CMP     #16
0021A8r 2  B0 4B                BCS     @psl_bad_item
0021AAr 2  8D rr rr             STA     set_lit_lo
0021ADr 2  20 rr rr             JSR     next_token              ; consume item lo
0021B0r 2  A5 rr                LDA     tok_type
0021B2r 2  C9 23                CMP     #TOK_DOTDOT
0021B4r 2  D0 37                BNE     @psl_single
0021B6r 2  20 rr rr             JSR     next_token              ; consume ..
0021B9r 2  A5 rr                LDA     tok_type
0021BBr 2  C9 02                CMP     #TOK_INT
0021BDr 2  D0 3E                BNE     @psl_bad_range
0021BFr 2  A5 rr                LDA     tok_ival_hi
0021C1r 2  D0 3A                BNE     @psl_bad_range
0021C3r 2  A5 rr                LDA     tok_ival_lo
0021C5r 2  C9 10                CMP     #16
0021C7r 2  B0 34                BCS     @psl_bad_range
0021C9r 2  8D rr rr             STA     set_lit_hi
0021CCr 2  CD rr rr             CMP     set_lit_lo
0021CFr 2  90 2C                BCC     @psl_bad_range
0021D1r 2  20 rr rr             JSR     next_token              ; consume item hi
0021D4r 2  AD rr rr             LDA     set_lit_lo
0021D7r 2  8D rr rr             STA     set_lit_cur
0021DAr 2               @psl_range_loop:
0021DAr 2  AD rr rr             LDA     set_lit_cur
0021DDr 2  20 rr rr             JSR     set_lit_add_value
0021E0r 2  AD rr rr             LDA     set_lit_cur
0021E3r 2  CD rr rr             CMP     set_lit_hi
0021E6r 2  F0 21                BEQ     @psl_after_item
0021E8r 2  EE rr rr             INC     set_lit_cur
0021EBr 2  80 ED                BRA     @psl_range_loop
0021EDr 2               @psl_single:
0021EDr 2  AD rr rr             LDA     set_lit_lo
0021F0r 2  20 rr rr             JSR     set_lit_add_value
0021F3r 2  80 14                BRA     @psl_after_item
0021F5r 2               @psl_bad_item:
0021F5r 2  20 rr rr             JSR     set_lit_type_error
0021F8r 2  20 rr rr             JSR     next_token
0021FBr 2  80 0C                BRA     @psl_after_item
0021FDr 2               @psl_bad_range:
0021FDr 2  20 rr rr             JSR     set_lit_type_error
002200r 2  A5 rr                LDA     tok_type
002202r 2  C9 02                CMP     #TOK_INT
002204r 2  D0 03                BNE     @psl_after_item
002206r 2  20 rr rr             JSR     next_token
002209r 2               @psl_after_item:
002209r 2  A5 rr                LDA     tok_type
00220Br 2  C9 1F                CMP     #TOK_COMMA
00220Dr 2  D0 05                BNE     @psl_done_items
00220Fr 2  20 rr rr             JSR     next_token
002212r 2  80 86                BRA     @psl_item
002214r 2               @psl_done_items:
002214r 2  A5 rr                LDA     tok_type
002216r 2  C9 1E                CMP     #TOK_RBRACK
002218r 2  F0 0D                BEQ     @psl_close
00221Ar 2  A9 rr                LDA     #<err_expected_rb
00221Cr 2  85 rr                STA     tmp0
00221Er 2  A9 rr                LDA     #>err_expected_rb
002220r 2  85 rr                STA     tmp0+1
002222r 2  20 rr rr             JSR     compile_error
002225r 2  80 03                BRA     @psl_emit
002227r 2               @psl_close:
002227r 2  20 rr rr             JSR     next_token              ; consume ']'
00222Ar 2               @psl_emit:
00222Ar 2  AD rr rr             LDA     set_lit_mask+1
00222Dr 2  85 rr                STA     scratch
00222Fr 2  AD rr rr             LDA     set_lit_mask
