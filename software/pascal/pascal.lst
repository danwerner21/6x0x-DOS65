001A03r 2  A9 42                LDA     #OP_LESI
001A05r 2  4C rr rr             JMP     emit_byte
001A08r 2               
001A08r 2               emit_LEQI:
001A08r 2  A9 43                LDA     #OP_LEQI
001A0Ar 2  4C rr rr             JMP     emit_byte
001A0Dr 2               
001A0Dr 2               emit_GTRI:
001A0Dr 2  A9 44                LDA     #OP_GTRI
001A0Fr 2  4C rr rr             JMP     emit_byte
001A12r 2               
001A12r 2               emit_GEQI:
001A12r 2  A9 45                LDA     #OP_GEQI
001A14r 2  4C rr rr             JMP     emit_byte
001A17r 2               
001A17r 2               ; --- Logical ---
001A17r 2               
001A17r 2               emit_LAND:
001A17r 2  A9 38                LDA     #OP_LAND
001A19r 2  4C rr rr             JMP     emit_byte
001A1Cr 2               
001A1Cr 2               emit_LOR:
001A1Cr 2  A9 39                LDA     #OP_LOR
001A1Er 2  4C rr rr             JMP     emit_byte
001A21r 2               
001A21r 2               emit_LNOT:
001A21r 2  A9 3A                LDA     #OP_LNOT
001A23r 2  4C rr rr             JMP     emit_byte
001A26r 2               
001A26r 2               ; --- Jump emitters ---
001A26r 2               ; Returns: A/scratch = offset of the word operand in code buffer
001A26r 2               ; (needed for backpatching)
001A26r 2               
001A26r 2               emit_UJP:                       ; emit UJP with placeholder offset
001A26r 2  A9 50                LDA     #OP_UJP
001A28r 2  20 rr rr             JSR     emit_byte
001A2Br 2  A5 rr                LDA     cg_pc           ; save patch address
001A2Dr 2  48                   PHA
001A2Er 2  A5 rr                LDA     cg_pc+1
001A30r 2  48                   PHA
001A31r 2  A9 00                LDA     #$00
001A33r 2  20 rr rr             JSR     emit_byte       ; placeholder lo
001A36r 2  A9 00                LDA     #$00
001A38r 2  20 rr rr             JSR     emit_byte       ; placeholder hi
001A3Br 2  68                   PLA
001A3Cr 2  85 rr                STA     scratch
001A3Er 2  68                   PLA                     ; lo of patch address
001A3Fr 2  60                   RTS                     ; caller: save A/scratch as patch point
001A40r 2               
001A40r 2               emit_FJP:
001A40r 2  A9 51                LDA     #OP_FJP
001A42r 2  20 rr rr             JSR     emit_byte
001A45r 2  A5 rr                LDA     cg_pc
001A47r 2  48                   PHA
001A48r 2  A5 rr                LDA     cg_pc+1
001A4Ar 2  48                   PHA
001A4Br 2  A9 00                LDA     #$00
001A4Dr 2  20 rr rr             JSR     emit_byte
001A50r 2  A9 00                LDA     #$00
001A52r 2  20 rr rr             JSR     emit_byte
001A55r 2  68                   PLA
001A56r 2  85 rr                STA     scratch
001A58r 2  68                   PLA
001A59r 2  60                   RTS
001A5Ar 2               
001A5Ar 2               emit_TJP:
001A5Ar 2  A9 52                LDA     #OP_TJP
001A5Cr 2  20 rr rr             JSR     emit_byte
001A5Fr 2  A5 rr                LDA     cg_pc
001A61r 2  48                   PHA
001A62r 2  A5 rr                LDA     cg_pc+1
001A64r 2  48                   PHA
001A65r 2  A9 00                LDA     #$00
001A67r 2  20 rr rr             JSR     emit_byte
001A6Ar 2  A9 00                LDA     #$00
001A6Cr 2  20 rr rr             JSR     emit_byte
001A6Fr 2  68                   PLA
001A70r 2  85 rr                STA     scratch
001A72r 2  68                   PLA
001A73r 2  60                   RTS
001A74r 2               
001A74r 2               ; ---------------------------------------------------------------------------
001A74r 2               ; patch_jump — fill in jump offset at patch address stored in tmp2 (word)
001A74r 2               ; The offset is computed as: (current cg_pc) - (patch_addr + 2)
001A74r 2               ; i.e. relative to instruction after the operand word
001A74r 2               ; ---------------------------------------------------------------------------
001A74r 2               patch_jump:
001A74r 2               ; delta = cg_pc - (patch_addr + 2)
001A74r 2               ;   compute (cg_pc - 2) first, then subtract patch_addr
001A74r 2  A5 rr                LDA     cg_pc
001A76r 2  38                   SEC
001A77r 2  E9 02                SBC     #2
001A79r 2  85 rr                STA     scratch         ; lo of (cg_pc - 2)
001A7Br 2  A5 rr                LDA     cg_pc+1
001A7Dr 2  E9 00                SBC     #0
001A7Fr 2  85 rr                STA     scratch+1       ; hi of (cg_pc - 2)
001A81r 2  38                   SEC
001A82r 2  A5 rr                LDA     scratch
001A84r 2  E5 rr                SBC     tmp2
001A86r 2  48                   PHA
001A87r 2  A5 rr                LDA     scratch+1
001A89r 2  E5 rr                SBC     tmp2+1
001A8Br 2  85 rr                STA     scratch+1       ; high byte of delta
001A8Dr 2  68                   PLA
001A8Er 2  85 rr                STA     scratch         ; low byte of delta
001A90r 2               ; write delta at patch address (CODEBUF_BASE + tmp2)
001A90r 2  A5 rr                LDA     tmp2
001A92r 2  18                   CLC
001A93r 2  69 00                ADC     #<CODEBUF_BASE
001A95r 2  85 rr                STA     tmp3
001A97r 2  A5 rr                LDA     tmp2+1
001A99r 2  69 30                ADC     #>CODEBUF_BASE
001A9Br 2  85 rr                STA     tmp3+1
001A9Dr 2  A0 00                LDY     #0
001A9Fr 2  A5 rr                LDA     scratch
001AA1r 2  91 rr                STA     (tmp3),y
001AA3r 2  C8                   INY
001AA4r 2  A5 rr                LDA     scratch+1
001AA6r 2  91 rr                STA     (tmp3),y
001AA8r 2  60                   RTS
001AA9r 2               
001AA9r 2               ; --- I/O emitters ---
001AA9r 2               
001AA9r 2               emit_WRITI:
001AA9r 2  A9 80                LDA     #OP_WRITI
001AABr 2  4C rr rr             JMP     emit_byte
001AAEr 2               
001AAEr 2               emit_WRITC:
001AAEr 2  A9 81                LDA     #OP_WRITC
001AB0r 2  4C rr rr             JMP     emit_byte
001AB3r 2               
