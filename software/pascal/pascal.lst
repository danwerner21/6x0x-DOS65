0018F2r 2  C9 1F                CMP     #TOK_COMMA
0018F4r 2  D0 06                BNE     @done_args
0018F6r 2  20 rr rr             JSR     next_token      ; consume ','
0018F9r 2  4C rr rr             JMP     @arg_loop       ; jmp — body grew past bra range
0018FCr 2               @done_args:
0018FCr 2  A5 rr                LDA     tok_type
0018FEr 2  C9 1C                CMP     #TOK_RPAREN
001900r 2  D0 17                BNE     @emit_call
001902r 2  20 rr rr             JSR     next_token      ; consume ')'
001905r 2  80 12                BRA     @emit_call
001907r 2               @no_args:
001907r 2               ; No declared params — accept and skip "()" if present.
001907r 2  A5 rr                LDA     tok_type
001909r 2  C9 1B                CMP     #TOK_LPAREN
00190Br 2  D0 0C                BNE     @emit_call
00190Dr 2  20 rr rr             JSR     next_token      ; consume '('
001910r 2  A5 rr                LDA     tok_type
001912r 2  C9 1C                CMP     #TOK_RPAREN
001914r 2  D0 03                BNE     @emit_call
001916r 2  20 rr rr             JSR     next_token      ; consume ')'
001919r 2               @emit_call:
001919r 2               ; Emit CALL <delta>: A=target lo, scratch=target hi
001919r 2  AD rr rr             LDA     sym_save_off
00191Cr 2  0D rr rr             ORA     sym_save_off+1
00191Fr 2  D0 0B                BNE     :+
001921r 2  A9 rr                LDA     #<err_undef
001923r 2  85 rr                STA     tmp0
001925r 2  A9 rr                LDA     #>err_undef
001927r 2  85 rr                STA     tmp0+1
001929r 2  20 rr rr             JSR     compile_error
00192Cr 2  AD rr rr     :       LDA     sym_save_off+1
00192Fr 2  85 rr                STA     scratch
001931r 2  AD rr rr             LDA     sym_save_off
001934r 2  20 rr rr             JSR     emit_CALL
001937r 2  60                   RTS
001938r 2               
001938r 2               ; ---------------------------------------------------------------------------
001938r 2               ; parse_write_args — WRITE/WRITELN argument list.
001938r 2               ;   Returns X=0 if console mode (caller emits WRITLN normally),
001938r 2               ;           X=1 if file mode (file ptr left on stack — caller emits FWLN
001938r 2               ;               or POP to consume it).
001938r 2               ; ---------------------------------------------------------------------------
001938r 2               parse_write_args:
001938r 2  A5 rr                LDA     tok_type
00193Ar 2  C9 1B                CMP     #TOK_LPAREN
00193Cr 2  D0 2F                BNE     @done_console
00193Er 2  20 rr rr             JSR     next_token              ; consume '('
001941r 2  A5 rr                LDA     tok_type
001943r 2  C9 1C                CMP     #TOK_RPAREN
001945r 2  F0 1D                BEQ     @close_console
001947r 2  20 rr rr             JSR     parse_expression        ; parse first arg
00194Ar 2               ; If first arg is TY_TEXT, switch to file mode (leave file ptr on stack).
00194Ar 2  A5 rr                LDA     expr_type
00194Cr 2  C9 08                CMP     #TY_TEXT
00194Er 2  F0 20                BEQ     @file_mode
001950r 2               ; Console mode — emit appropriate WRIT* for first arg, then loop.
001950r 2  20 rr rr             JSR     pw_emit_console
001953r 2               @cons_loop:
001953r 2  A5 rr                LDA     tok_type
001955r 2  C9 1F                CMP     #TOK_COMMA
001957r 2  D0 0B                BNE     @close_console
001959r 2  20 rr rr             JSR     next_token              ; consume ','
00195Cr 2  20 rr rr             JSR     parse_expression
00195Fr 2  20 rr rr             JSR     pw_emit_console
001962r 2  80 EF                BRA     @cons_loop
001964r 2               @close_console:
001964r 2  A5 rr                LDA     tok_type
001966r 2  C9 1C                CMP     #TOK_RPAREN
001968r 2  D0 03                BNE     :+
00196Ar 2  20 rr rr             JSR     next_token              ; consume ')'
00196Dr 2               :
00196Dr 2               @done_console:
00196Dr 2  A2 00                LDX     #0
00196Fr 2  60                   RTS
001970r 2               
001970r 2               @file_mode:
001970r 2               @file_loop:
001970r 2  A5 rr                LDA     tok_type
001972r 2  C9 1F                CMP     #TOK_COMMA
001974r 2  D0 0E                BNE     @close_file
001976r 2  20 rr rr             JSR     next_token              ; consume ','
001979r 2  20 rr rr             JSR     emit_DUP                ; dup file ptr (consumed by FWRX)
00197Cr 2  20 rr rr             JSR     parse_expression        ; arg on top of stack
00197Fr 2  20 rr rr             JSR     pw_emit_file
001982r 2  80 EC                BRA     @file_loop
001984r 2               @close_file:
001984r 2  A5 rr                LDA     tok_type
001986r 2  C9 1C                CMP     #TOK_RPAREN
001988r 2  D0 03                BNE     :+
00198Ar 2  20 rr rr             JSR     next_token              ; consume ')'
00198Dr 2               :
00198Dr 2  A2 01                LDX     #1
00198Fr 2  60                   RTS
001990r 2               
001990r 2               ; pw_emit_console — emit WRITS/WRITC/WRITB/WRITI based on expr_type
001990r 2               pw_emit_console:
001990r 2  A5 rr                LDA     expr_type
001992r 2  C9 04                CMP     #TY_STRING
001994r 2  D0 03                BNE     :+
001996r 2  4C rr rr             JMP     emit_WRITS
001999r 2               :
001999r 2  C9 02                CMP     #TY_CHAR
00199Br 2  D0 03                BNE     :+
00199Dr 2  4C rr rr             JMP     emit_WRITC
0019A0r 2               :
0019A0r 2  C9 03                CMP     #TY_BOOL
0019A2r 2  D0 03                BNE     :+
0019A4r 2  4C rr rr             JMP     emit_WRITB
0019A7r 2               :
0019A7r 2  4C rr rr             JMP     emit_WRITI
0019AAr 2               
0019AAr 2               ; pw_emit_file — emit FWRS/FWRC/FWRB/FWRI based on expr_type
0019AAr 2               pw_emit_file:
0019AAr 2  A5 rr                LDA     expr_type
0019ACr 2  C9 04                CMP     #TY_STRING
0019AEr 2  D0 03                BNE     :+
0019B0r 2  4C rr rr             JMP     emit_FWRS
0019B3r 2               :
0019B3r 2  C9 02                CMP     #TY_CHAR
0019B5r 2  D0 03                BNE     :+
0019B7r 2  4C rr rr             JMP     emit_FWRC
0019BAr 2               :
0019BAr 2  C9 03                CMP     #TY_BOOL
0019BCr 2  D0 03                BNE     :+
0019BEr 2  4C rr rr             JMP     emit_FWRB
0019C1r 2               :
0019C1r 2  4C rr rr             JMP     emit_FWRI
0019C4r 2               
0019C4r 2               ; emit_console_read_arg — current token must be an IDENT naming the target
0019C4r 2               ; variable. CHAR targets compile as:
0019C4r 2               ;   <addr> READC STIND
0019C4r 2               ; so the zero-extended character from OP_READC is stored into the variable's
0019C4r 2               ; 2-byte cell. Everything else currently uses READI.
0019C4r 2               emit_console_read_arg:
0019C4r 2  20 rr rr             JSR     symtab_find
0019C7r 2  90 11                BCC     @cra_int
0019C9r 2  A0 11                LDY     #17
0019CBr 2  B1 rr                LDA     (tmp3),y
0019CDr 2  C9 02                CMP     #TY_CHAR
0019CFr 2  D0 09                BNE     @cra_int
0019D1r 2  20 rr rr             JSR     parse_arg_lvalue
0019D4r 2  20 rr rr             JSR     emit_READC
0019D7r 2  4C rr rr             JMP     emit_STIND
0019DAr 2               @cra_int:
0019DAr 2  20 rr rr             JSR     parse_arg_lvalue
0019DDr 2  4C rr rr             JMP     emit_READI
0019E0r 2               
0019E0r 2               ; ---------------------------------------------------------------------------
0019E0r 2               ; parse_read_args — READ/READLN argument list.  Each argument must be a
0019E0r 2               ; variable identifier. Console mode dispatches by target type:
0019E0r 2               ;   CHAR    -> READC + STIND
0019E0r 2               ;   default -> READI
0019E0r 2               ; File mode still routes through FRDC / FRDS / FRDI based on target type.
0019E0r 2               ; ---------------------------------------------------------------------------
0019E0r 2               parse_read_args:
0019E0r 2  A5 rr                LDA     tok_type
0019E2r 2  C9 1B                CMP     #TOK_LPAREN
0019E4r 2  D0 3A                BNE     @rdone_console
0019E6r 2  20 rr rr             JSR     next_token              ; consume '('
0019E9r 2  A5 rr                LDA     tok_type
0019EBr 2  C9 1C                CMP     #TOK_RPAREN
0019EDr 2  F0 28                BEQ     @rclose_console
0019EFr 2  C9 01                CMP     #TOK_IDENT
0019F1r 2  D0 24                BNE     @rclose_console
0019F3r 2               ; Peek: is the first ident a TY_TEXT variable?
0019F3r 2  20 rr rr             JSR     symtab_find
0019F6r 2  90 08                BCC     @cons_first
0019F8r 2  A0 11                LDY     #17
0019FAr 2  B1 rr                LDA     (tmp3),y
0019FCr 2  C9 08                CMP     #TY_TEXT
0019FEr 2  F0 23                BEQ     @file_first
001A00r 2               @cons_first:
001A00r 2  20 rr rr             JSR     emit_console_read_arg
001A03r 2               @cons_loop:
001A03r 2  A5 rr                LDA     tok_type
001A05r 2  C9 1F                CMP     #TOK_COMMA
001A07r 2  D0 0E                BNE     @rclose_console
001A09r 2  20 rr rr             JSR     next_token
001A0Cr 2  A5 rr                LDA     tok_type
001A0Er 2  C9 01                CMP     #TOK_IDENT
001A10r 2  D0 05                BNE     @rclose_console
001A12r 2  20 rr rr             JSR     emit_console_read_arg
001A15r 2  80 EC                BRA     @cons_loop
001A17r 2               @rclose_console:
001A17r 2  A5 rr                LDA     tok_type
001A19r 2  C9 1C                CMP     #TOK_RPAREN
001A1Br 2  D0 03                BNE     :+
001A1Dr 2  20 rr rr             JSR     next_token              ; consume ')'
001A20r 2               :
001A20r 2               @rdone_console:
001A20r 2  A2 00                LDX     #0
001A22r 2  60                   RTS
001A23r 2               
001A23r 2               @file_first:
001A23r 2               ; Push the file ptr (struct address) by parsing the ident as an expression —
001A23r 2               ; for TY_TEXT this emits LDA_G/LDA_L which pushes the struct's address.
001A23r 2  20 rr rr             JSR     parse_expression
001A26r 2               @file_loop:
001A26r 2  A5 rr                LDA     tok_type
001A28r 2  C9 1F                CMP     #TOK_COMMA
001A2Ar 2  D0 3B                BNE     @close_file
001A2Cr 2  20 rr rr             JSR     next_token              ; consume ','
001A2Fr 2  A5 rr                LDA     tok_type
001A31r 2  C9 01                CMP     #TOK_IDENT
001A33r 2  D0 32                BNE     @close_file
001A35r 2               ; Peek var type so we know whether to emit FRDC, FRDS, or FRDI.
001A35r 2  20 rr rr             JSR     symtab_find
001A38r 2  90 22                BCC     @file_int_default
001A3Ar 2  A0 11                LDY     #17
001A3Cr 2  B1 rr                LDA     (tmp3),y
001A3Er 2  C9 02                CMP     #TY_CHAR
001A40r 2  D0 0B                BNE     @file_chk_str
001A42r 2  20 rr rr             JSR     emit_DUP                ; dup file ptr
001A45r 2  20 rr rr             JSR     parse_arg_lvalue
001A48r 2  20 rr rr             JSR     emit_FRDC
001A4Br 2  80 D9                BRA     @file_loop
001A4Dr 2               @file_chk_str:
001A4Dr 2  C9 04                CMP     #TY_STRING
001A4Fr 2  D0 0B                BNE     @file_int_default
001A51r 2  20 rr rr             JSR     emit_DUP                ; dup file ptr
001A54r 2  20 rr rr             JSR     parse_arg_lvalue
001A57r 2  20 rr rr             JSR     emit_FRDS
001A5Ar 2  80 CA                BRA     @file_loop
001A5Cr 2               @file_int_default:
001A5Cr 2  20 rr rr             JSR     emit_DUP                ; dup file ptr
001A5Fr 2  20 rr rr             JSR     parse_arg_lvalue
001A62r 2  20 rr rr             JSR     emit_FRDI
001A65r 2  80 BF                BRA     @file_loop
001A67r 2               @close_file:
001A67r 2  A5 rr                LDA     tok_type
001A69r 2  C9 1C                CMP     #TOK_RPAREN
001A6Br 2  D0 03                BNE     :+
001A6Dr 2  20 rr rr             JSR     next_token              ; consume ')'
001A70r 2               :
001A70r 2  A2 01                LDX     #1
001A72r 2  60                   RTS
001A73r 2               
001A73r 2               ; ---------------------------------------------------------------------------
001A73r 2               ; parse_if — IF expr THEN stmt [ ELSE stmt ]
001A73r 2               ; ---------------------------------------------------------------------------
001A73r 2               parse_if:
001A73r 2  20 rr rr             JSR     next_token      ; consume IF
001A76r 2  20 rr rr             JSR     parse_expression
001A79r 2               ; emit FJP with placeholder; save patch addr on 6502 stack
001A79r 2               ; (parse_statement will clobber tmp2 / scratch)
001A79r 2  20 rr rr             JSR     emit_FJP        ; A=patch_lo, scratch=patch_hi
001A7Cr 2  48                   PHA                     ; save FJP patch lo
001A7Dr 2  A5 rr                LDA     scratch
001A7Fr 2  48                   PHA                     ; save FJP patch hi
001A80r 2               ; THEN
001A80r 2  A5 rr                LDA     tok_type
001A82r 2  C9 58                CMP     #TOK_THEN
001A84r 2  D0 03                BNE     :+
001A86r 2  20 rr rr             JSR     next_token
001A89r 2               :
001A89r 2  20 rr rr             JSR     parse_statement
001A8Cr 2               ; check for ELSE
001A8Cr 2  A5 rr                LDA     tok_type
001A8Er 2  C9 48                CMP     #TOK_ELSE
001A90r 2  D0 30                BNE     @patch_then
001A92r 2               ; emit UJP over else branch
001A92r 2  20 rr rr             JSR     emit_UJP        ; A=patch_lo, scratch=patch_hi
001A95r 2  48                   PHA                     ; save UJP patch lo
001A96r 2  A5 rr                LDA     scratch
001A98r 2  48                   PHA                     ; save UJP patch hi
001A99r 2               ; restore FJP patch addr into tmp2 and patch it to here
001A99r 2               ; (need to dig under the UJP entries on the stack)
001A99r 2               ; stack top → bottom: UJP_hi, UJP_lo, FJP_hi, FJP_lo
001A99r 2  68                   PLA                     ; UJP hi
001A9Ar 2  8D rr rr             STA     sym_save_off    ; reuse sym_save_off as temp byte
001A9Dr 2  68                   PLA                     ; UJP lo
001A9Er 2  8D rr rr             STA     sym_save_off+1
001AA1r 2  68                   PLA                     ; FJP hi
001AA2r 2  85 rr                STA     tmp2+1
001AA4r 2  68                   PLA                     ; FJP lo
001AA5r 2  85 rr                STA     tmp2
001AA7r 2  20 rr rr             JSR     patch_jump      ; patch FJP → start of else branch
001AAAr 2               ; push UJP patch addr back for after-else patching
001AAAr 2  AD rr rr             LDA     sym_save_off+1  ; UJP lo
001AADr 2  48                   PHA
001AAEr 2  AD rr rr             LDA     sym_save_off    ; UJP hi
001AB1r 2  48                   PHA
001AB2r 2  20 rr rr             JSR     next_token      ; consume ELSE
001AB5r 2  20 rr rr             JSR     parse_statement
001AB8r 2               ; patch UJP to here
001AB8r 2  68                   PLA                     ; UJP hi
001AB9r 2  85 rr                STA     tmp2+1
001ABBr 2  68                   PLA                     ; UJP lo
001ABCr 2  85 rr                STA     tmp2
001ABEr 2  20 rr rr             JSR     patch_jump
001AC1r 2  60                   RTS
001AC2r 2               @patch_then:
001AC2r 2               ; no ELSE — restore FJP patch addr and patch to here
001AC2r 2  68                   PLA                     ; FJP hi
001AC3r 2  85 rr                STA     tmp2+1
001AC5r 2  68                   PLA                     ; FJP lo
001AC6r 2  85 rr                STA     tmp2
001AC8r 2  20 rr rr             JSR     patch_jump
001ACBr 2  60                   RTS
001ACCr 2               
001ACCr 2               ; ---------------------------------------------------------------------------
001ACCr 2               ; parse_while — WHILE expr DO stmt
001ACCr 2               ; ---------------------------------------------------------------------------
001ACCr 2               parse_while:
001ACCr 2  20 rr rr             JSR     next_token      ; consume WHILE
001ACFr 2               ; save loop top
001ACFr 2  A5 rr                LDA     cg_pc
001AD1r 2  85 rr                STA     tmp2
001AD3r 2  A5 rr                LDA     cg_pc+1
001AD5r 2  85 rr                STA     tmp2+1
001AD7r 2               ; we'll need loop_top later; save on 6502 stack
001AD7r 2  A5 rr                LDA     tmp2+1
001AD9r 2  48                   PHA
001ADAr 2  A5 rr                LDA     tmp2
001ADCr 2  48                   PHA
001ADDr 2  20 rr rr             JSR     parse_expression
001AE0r 2  20 rr rr             JSR     emit_FJP        ; exit if false
001AE3r 2  48                   PHA
001AE4r 2  A5 rr                LDA     scratch
001AE6r 2  48                   PHA
001AE7r 2               ; DO
001AE7r 2  A5 rr                LDA     tok_type
001AE9r 2  C9 46                CMP     #TOK_DO
001AEBr 2  D0 03                BNE     :+
001AEDr 2  20 rr rr             JSR     next_token
001AF0r 2               :
001AF0r 2  20 rr rr             JSR     parse_statement
001AF3r 2               ; emit UJP back to loop top
001AF3r 2  A9 50                LDA     #OP_UJP
001AF5r 2  20 rr rr             JSR     emit_byte
001AF8r 2               ; offset = loop_top - (cg_pc + 2)
001AF8r 2  68                   PLA
001AF9r 2  85 rr                STA     tmp3            ; FJP patch hi
001AFBr 2  68                   PLA
001AFCr 2  85 rr                STA     tmp3+1          ; FJP patch lo — note: reversed from earlier push
001AFEr 2               ; compute back-edge offset
001AFEr 2  68                   PLA                     ; loop_top lo
001AFFr 2  85 rr                STA     tmp2
001B01r 2  68                   PLA                     ; loop_top hi
001B02r 2  85 rr                STA     tmp2+1
001B04r 2               ; delta = loop_top - (cg_pc + 2)
001B04r 2  38                   SEC
001B05r 2  A5 rr                LDA     tmp2
001B07r 2  E5 rr                SBC     cg_pc
001B09r 2  85 rr                STA     scratch
001B0Br 2  A5 rr                LDA     tmp2+1
001B0Dr 2  E5 rr                SBC     cg_pc+1
001B0Fr 2  85 rr                STA     scratch+1
001B11r 2  A5 rr                LDA     scratch
001B13r 2  38                   SEC
001B14r 2  E9 02                SBC     #2
001B16r 2  85 rr                STA     scratch
001B18r 2  B0 02                BCS     :+
001B1Ar 2  C6 rr                DEC     scratch+1
001B1Cr 2               :
001B1Cr 2  A5 rr                LDA     scratch
001B1Er 2  20 rr rr             JSR     emit_byte
001B21r 2  A5 rr                LDA     scratch+1
001B23r 2  20 rr rr             JSR     emit_byte
001B26r 2               ; patch FJP exit
001B26r 2               ; tmp3+1:tmp3 holds FJP patch addr (note push order was lo,hi → pla gets hi first)
001B26r 2               ; Rebuild properly:
001B26r 2  A5 rr                LDA     tmp3+1
001B28r 2  85 rr                STA     tmp2
001B2Ar 2  A5 rr                LDA     tmp3
001B2Cr 2  85 rr                STA     tmp2+1
001B2Er 2  20 rr rr             JSR     patch_jump
001B31r 2  60                   RTS
001B32r 2               
001B32r 2               ; ---------------------------------------------------------------------------
001B32r 2               ; parse_for — FOR id := expr TO|DOWNTO expr DO stmt
001B32r 2               ;
001B32r 2               ; Codegen layout:
001B32r 2               ;   <init>:   parse expr1; STG/STL var
001B32r 2               ;             parse expr2; STG hidden_global   (limit, evaluated once)
001B32r 2               ;   loop_top: LDG/LDL var; LDG hidden_global
001B32r 2               ;             LEQI (TO) | GEQI (DOWNTO)
001B32r 2               ;             FJP exit
001B32r 2               ;             <body>
001B32r 2               ;             LDG/LDL var; LDCI 1; ADI|SBI; STG/STL var
001B32r 2               ;             UJP loop_top
001B32r 2               ;   exit:
001B32r 2               ;
001B32r 2               ; State on 6502 stack across body:
001B32r 2               ;   var_off_lo, var_off_hi, var_scope, dir, lim_off_hi, lim_off_lo
001B32r 2               ; for_loop_top / for_patch live in zp (FOR is not nestable in this build).
001B32r 2               ; ---------------------------------------------------------------------------
001B32r 2               parse_for:
001B32r 2  20 rr rr             JSR     next_token      ; consume FOR
001B35r 2               
001B35r 2  A5 rr                LDA     tok_type
001B37r 2  C9 01                CMP     #TOK_IDENT
001B39r 2  F0 01                BEQ     :+
001B3Br 2  60                   RTS                     ; not an ident — silently bail
001B3Cr 2               :
001B3Cr 2  20 rr rr             JSR     symtab_find
001B3Fr 2  B0 04                BCS     :+
001B41r 2  20 rr rr             JSR     next_token      ; consume the bad ident
001B44r 2  60                   RTS
001B45r 2               :
001B45r 2               ; snapshot var info into sym_save_*
001B45r 2  A0 14                LDY     #20
001B47r 2  B1 rr                LDA     (tmp3),y
001B49r 2  8D rr rr             STA     sym_save_scope
001B4Cr 2  A0 12                LDY     #18
001B4Er 2  B1 rr                LDA     (tmp3),y
001B50r 2  8D rr rr             STA     sym_save_off
001B53r 2  A0 13                LDY     #19
001B55r 2  B1 rr                LDA     (tmp3),y
001B57r 2  8D rr rr             STA     sym_save_off+1
001B5Ar 2  20 rr rr             JSR     next_token      ; consume identifier
001B5Dr 2               
001B5Dr 2               ; push var info: scope, off_hi, off_lo (top)
001B5Dr 2  AD rr rr             LDA     sym_save_scope
001B60r 2  48                   PHA
001B61r 2  AD rr rr             LDA     sym_save_off+1
001B64r 2  48                   PHA
001B65r 2  AD rr rr             LDA     sym_save_off
001B68r 2  48                   PHA
001B69r 2               
001B69r 2               ; ':='
001B69r 2  A5 rr                LDA     tok_type
001B6Br 2  C9 1A                CMP     #TOK_ASSIGN
001B6Dr 2  D0 03                BNE     :+
001B6Fr 2  20 rr rr             JSR     next_token
001B72r 2               :
001B72r 2  20 rr rr             JSR     parse_expression; initial value on TOS
001B75r 2               
001B75r 2               ; restore sym_save_* (parse_expression may have clobbered them)
001B75r 2  68                   PLA
001B76r 2  8D rr rr             STA     sym_save_off
001B79r 2  68                   PLA
001B7Ar 2  8D rr rr             STA     sym_save_off+1
001B7Dr 2  68                   PLA
001B7Er 2  8D rr rr             STA     sym_save_scope
001B81r 2  20 rr rr             JSR     for_emit_store_var
001B84r 2               
001B84r 2               ; re-push var info for use after loop
001B84r 2  AD rr rr             LDA     sym_save_scope
001B87r 2  48                   PHA
001B88r 2  AD rr rr             LDA     sym_save_off+1
001B8Br 2  48                   PHA
001B8Cr 2  AD rr rr             LDA     sym_save_off
001B8Fr 2  48                   PHA
001B90r 2               
001B90r 2               ; direction byte: 0 = TO, 1 = DOWNTO
001B90r 2  A9 00                LDA     #0
001B92r 2  A6 rr                LDX     tok_type
001B94r 2  E0 47                CPX     #TOK_DOWNTO
001B96r 2  D0 02                BNE     :+
001B98r 2  A9 01                LDA     #1
001B9Ar 2               :
001B9Ar 2  48                   PHA                     ; push dir
001B9Br 2  20 rr rr             JSR     next_token      ; consume TO / DOWNTO
001B9Er 2               
001B9Er 2               ; parse limit expression and store to a hidden global
001B9Er 2  20 rr rr             JSR     parse_expression
001BA1r 2  20 rr rr             JSR     codegen_alloc_global; tmp2 = hidden offset
001BA4r 2               ; push the offset NOW — emit_STG will clobber tmp2
001BA4r 2  A5 rr                LDA     tmp2+1
001BA6r 2  48                   PHA                     ; lim_hi
001BA7r 2  A5 rr                LDA     tmp2
001BA9r 2  48                   PHA                     ; lim_lo (top)
001BAAr 2               ; reload from stack peek for emit_STG (A = lo, scratch = hi)
001BAAr 2  BA                   TSX
001BABr 2  BD 02 01             LDA     $0102,x
001BAEr 2  85 rr                STA     scratch
001BB0r 2  BD 01 01             LDA     $0101,x
001BB3r 2  20 rr rr             JSR     emit_STG
001BB6r 2               
001BB6r 2               ; consume DO
001BB6r 2  A5 rr                LDA     tok_type
001BB8r 2  C9 46                CMP     #TOK_DO
001BBAr 2  D0 03                BNE     :+
001BBCr 2  20 rr rr             JSR     next_token
001BBFr 2               :
001BBFr 2               ; --- loop top ---
001BBFr 2  A5 rr                LDA     cg_pc
001BC1r 2  85 rr                STA     for_loop_top
001BC3r 2  A5 rr                LDA     cg_pc+1
001BC5r 2  85 rr                STA     for_loop_top+1
001BC7r 2               
001BC7r 2               ; emit LDG/LDL var — restore sym_save_* via TSX peek
001BC7r 2               ; stack from top: lim_lo, lim_hi, dir, var_lo, var_hi, var_scope
001BC7r 2  BA                   TSX
001BC8r 2  BD 04 01             LDA     $0104,x         ; var_lo
001BCBr 2  8D rr rr             STA     sym_save_off
001BCEr 2  BD 05 01             LDA     $0105,x         ; var_hi
001BD1r 2  8D rr rr             STA     sym_save_off+1
001BD4r 2  BD 06 01             LDA     $0106,x         ; var_scope
001BD7r 2  8D rr rr             STA     sym_save_scope
001BDAr 2  20 rr rr             JSR     for_emit_load_var
001BDDr 2               
001BDDr 2               ; emit LDG limit — limit hi at $0102,x, lo at $0101,x
001BDDr 2  BA                   TSX
001BDEr 2  BD 02 01             LDA     $0102,x
001BE1r 2  85 rr                STA     scratch
001BE3r 2  BD 01 01             LDA     $0101,x
001BE6r 2  20 rr rr             JSR     emit_LDG
001BE9r 2               
001BE9r 2               ; comparison: TO → LEQI (var <= limit), DOWNTO → GEQI
001BE9r 2  BA                   TSX
001BEAr 2  BD 03 01             LDA     $0103,x         ; dir
001BEDr 2  F0 05                BEQ     @cmp_to
001BEFr 2  20 rr rr             JSR     emit_GEQI
001BF2r 2  80 03                BRA     @cmp_done
001BF4r 2               @cmp_to:
001BF4r 2  20 rr rr             JSR     emit_LEQI
001BF7r 2               @cmp_done:
001BF7r 2               
001BF7r 2               ; FJP exit placeholder
001BF7r 2  20 rr rr             JSR     emit_FJP        ; A=patch_lo, scratch=patch_hi
001BFAr 2  85 rr                STA     for_patch
001BFCr 2  A5 rr                LDA     scratch
001BFEr 2  85 rr                STA     for_patch+1
001C00r 2               
001C00r 2               ; --- body ---
001C00r 2  20 rr rr             JSR     parse_statement
001C03r 2               
001C03r 2               ; --- pop state in reverse push order ---
001C03r 2  68                   PLA                     ; lim_lo (discard)
001C04r 2  68                   PLA                     ; lim_hi (discard)
001C05r 2  68                   PLA                     ; direction
001C06r 2  8D rr rr             STA     sym_save_kind   ; reuse for direction storage
001C09r 2  68                   PLA                     ; var_lo
001C0Ar 2  8D rr rr             STA     sym_save_off
001C0Dr 2  68                   PLA                     ; var_hi
001C0Er 2  8D rr rr             STA     sym_save_off+1
001C11r 2  68                   PLA                     ; var_scope
001C12r 2  8D rr rr             STA     sym_save_scope
001C15r 2               
001C15r 2               ; emit increment / decrement: LDG var, LDCI 1, ADI|SBI, STG var
001C15r 2  20 rr rr             JSR     for_emit_load_var
001C18r 2  A9 01                LDA     #1
001C1Ar 2  20 rr rr             JSR     emit_LDCI
001C1Dr 2  AD rr rr             LDA     sym_save_kind   ; direction
001C20r 2  F0 05                BEQ     @inc
001C22r 2  20 rr rr             JSR     emit_SBI
001C25r 2  80 03                BRA     @inc_done
001C27r 2               @inc:
001C27r 2  20 rr rr             JSR     emit_ADI
001C2Ar 2               @inc_done:
001C2Ar 2  20 rr rr             JSR     for_emit_store_var
001C2Dr 2               
001C2Dr 2               ; emit UJP back to loop_top
001C2Dr 2               ; offset = for_loop_top - (cg_pc_after_opcode + 2)
001C2Dr 2  A9 50                LDA     #OP_UJP
001C2Fr 2  20 rr rr             JSR     emit_byte
001C32r 2  38                   SEC
001C33r 2  A5 rr                LDA     for_loop_top
001C35r 2  E5 rr                SBC     cg_pc
001C37r 2  85 rr                STA     scratch
001C39r 2  A5 rr                LDA     for_loop_top+1
001C3Br 2  E5 rr                SBC     cg_pc+1
001C3Dr 2  85 rr                STA     scratch+1
001C3Fr 2  38                   SEC
001C40r 2  A5 rr                LDA     scratch
001C42r 2  E9 02                SBC     #2
001C44r 2  85 rr                STA     scratch
001C46r 2  B0 02                BCS     :+
001C48r 2  C6 rr                DEC     scratch+1
001C4Ar 2               :
001C4Ar 2  A5 rr                LDA     scratch
001C4Cr 2  20 rr rr             JSR     emit_byte
001C4Fr 2  A5 rr                LDA     scratch+1
001C51r 2  20 rr rr             JSR     emit_byte
001C54r 2               
001C54r 2               ; patch FJP exit
001C54r 2  A5 rr                LDA     for_patch
001C56r 2  85 rr                STA     tmp2
001C58r 2  A5 rr                LDA     for_patch+1
001C5Ar 2  85 rr                STA     tmp2+1
001C5Cr 2  20 rr rr             JSR     patch_jump
001C5Fr 2  60                   RTS
001C60r 2               
001C60r 2               ; ---------------------------------------------------------------------------
001C60r 2               ; for_emit_load_var / for_emit_store_var — emit LDG/LDL or STG/STL based on
001C60r 2               ; sym_save_scope (0 = global) and sym_save_off (offset).
001C60r 2               ; ---------------------------------------------------------------------------
001C60r 2               for_emit_load_var:
001C60r 2  AD rr rr             LDA     sym_save_scope
001C63r 2  D0 0B                BNE     @local
001C65r 2  AD rr rr             LDA     sym_save_off+1
001C68r 2  85 rr                STA     scratch
001C6Ar 2  AD rr rr             LDA     sym_save_off
001C6Dr 2  4C rr rr             JMP     emit_LDG
001C70r 2               @local:
001C70r 2  AD rr rr             LDA     sym_save_off
001C73r 2  4C rr rr             JMP     emit_LDL
001C76r 2               
001C76r 2               for_emit_store_var:
001C76r 2  AD rr rr             LDA     sym_save_scope
001C79r 2  D0 0B                BNE     @local
001C7Br 2  AD rr rr             LDA     sym_save_off+1
001C7Er 2  85 rr                STA     scratch
001C80r 2  AD rr rr             LDA     sym_save_off
001C83r 2  4C rr rr             JMP     emit_STG
001C86r 2               @local:
001C86r 2  AD rr rr             LDA     sym_save_off
001C89r 2  4C rr rr             JMP     emit_STL
001C8Cr 2               
001C8Cr 2               ; ---------------------------------------------------------------------------
001C8Cr 2               ; parse_repeat — REPEAT stmt { ; stmt } UNTIL expr
001C8Cr 2               ; ---------------------------------------------------------------------------
001C8Cr 2               parse_repeat:
001C8Cr 2  20 rr rr             JSR     next_token      ; consume REPEAT
001C8Fr 2               ; save top
001C8Fr 2  A5 rr                LDA     cg_pc
001C91r 2  48                   PHA
001C92r 2  A5 rr                LDA     cg_pc+1
001C94r 2  48                   PHA
001C95r 2               @loop:
001C95r 2  A5 rr                LDA     tok_type
001C97r 2  C9 5B                CMP     #TOK_UNTIL
001C99r 2  F0 12                BEQ     @until
001C9Br 2  C9 00                CMP     #TOK_EOF
001C9Dr 2  F0 41                BEQ     @done
001C9Fr 2  20 rr rr             JSR     parse_statement
001CA2r 2  A5 rr                LDA     tok_type
001CA4r 2  C9 20                CMP     #TOK_SEMICOLON
001CA6r 2  D0 ED                BNE     @loop
001CA8r 2  20 rr rr             JSR     next_token
001CABr 2  80 E8                BRA     @loop
001CADr 2               @until:
001CADr 2  20 rr rr             JSR     next_token      ; consume UNTIL
001CB0r 2  20 rr rr             JSR     parse_expression
001CB3r 2               ; FJP back to top
001CB3r 2  A9 51                LDA     #OP_FJP
001CB5r 2  20 rr rr             JSR     emit_byte
001CB8r 2  68                   PLA
001CB9r 2  85 rr                STA     tmp2+1
001CBBr 2  68                   PLA
001CBCr 2  85 rr                STA     tmp2
001CBEr 2  38                   SEC
001CBFr 2  A5 rr                LDA     tmp2
001CC1r 2  E5 rr                SBC     cg_pc
001CC3r 2  85 rr                STA     scratch
001CC5r 2  A5 rr                LDA     tmp2+1
001CC7r 2  E5 rr                SBC     cg_pc+1
001CC9r 2  85 rr                STA     scratch+1
001CCBr 2  A5 rr                LDA     scratch
001CCDr 2  38                   SEC
001CCEr 2  E9 02                SBC     #2
001CD0r 2  85 rr                STA     scratch
001CD2r 2  B0 02                BCS     :+
001CD4r 2  C6 rr                DEC     scratch+1
001CD6r 2               :
001CD6r 2  A5 rr                LDA     scratch
001CD8r 2  20 rr rr             JSR     emit_byte
001CDBr 2  A5 rr                LDA     scratch+1
001CDDr 2  20 rr rr             JSR     emit_byte
001CE0r 2               @done:
001CE0r 2  60                   RTS
001CE1r 2               
001CE1r 2               ; ---------------------------------------------------------------------------
001CE1r 2               ; parse_expression — full expression with operator precedence
001CE1r 2               ; Phase 1: simple additive + comparison; no precedence climbing yet
001CE1r 2               ; ---------------------------------------------------------------------------
001CE1r 2               parse_expression:
001CE1r 2  20 rr rr             JSR     parse_simple_expr
001CE4r 2               ; check for relational operator
001CE4r 2  A5 rr                LDA     tok_type
001CE6r 2  C9 4D                CMP     #TOK_IN
001CE8r 2  F0 19                BEQ     @rel_in
001CEAr 2  C9 14                CMP     #TOK_EQ
001CECr 2  F0 21                BEQ     @rel_eq
001CEEr 2  C9 15                CMP     #TOK_NEQ
001CF0r 2  F0 29                BEQ     @rel_neq
001CF2r 2  C9 16                CMP     #TOK_LT
001CF4r 2  F0 31                BEQ     @rel_lt
001CF6r 2  C9 17                CMP     #TOK_GT
001CF8r 2  F0 39                BEQ     @rel_gt
001CFAr 2  C9 18                CMP     #TOK_LEQ
001CFCr 2  F0 41                BEQ     @rel_leq
001CFEr 2  C9 19                CMP     #TOK_GEQ
001D00r 2  F0 49                BEQ     @rel_geq
001D02r 2  60                   RTS                     ; expr_type set by parse_simple_expr
001D03r 2               @rel_in:
001D03r 2  20 rr rr             JSR     next_token
001D06r 2  20 rr rr             JSR     parse_simple_expr
001D09r 2  20 rr rr             JSR     emit_INSET
001D0Cr 2  4C rr rr             JMP     @rel_done
001D0Fr 2               @rel_eq:
001D0Fr 2  20 rr rr             JSR     next_token
001D12r 2  20 rr rr             JSR     parse_simple_expr
001D15r 2  20 rr rr             JSR     emit_EQUI
001D18r 2  4C rr rr             JMP     @rel_done
001D1Br 2               @rel_neq:
001D1Br 2  20 rr rr             JSR     next_token
001D1Er 2  20 rr rr             JSR     parse_simple_expr
001D21r 2  20 rr rr             JSR     emit_NEQI
001D24r 2  4C rr rr             JMP     @rel_done
001D27r 2               @rel_lt:
001D27r 2  20 rr rr             JSR     next_token
001D2Ar 2  20 rr rr             JSR     parse_simple_expr
001D2Dr 2  20 rr rr             JSR     emit_LESI
001D30r 2  4C rr rr             JMP     @rel_done
001D33r 2               @rel_gt:
001D33r 2  20 rr rr             JSR     next_token
001D36r 2  20 rr rr             JSR     parse_simple_expr
001D39r 2  20 rr rr             JSR     emit_GTRI
001D3Cr 2  4C rr rr             JMP     @rel_done
001D3Fr 2               @rel_leq:
001D3Fr 2  20 rr rr             JSR     next_token
001D42r 2  20 rr rr             JSR     parse_simple_expr
