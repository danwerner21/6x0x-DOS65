001281r 2  68                   PLA                     ; discard pcount
001282r 2  8A                   TXA
001283r 2  20 rr rr             JSR     emit_LDL        ; push address from slot
001286r 2  20 rr rr             JSR     emit_LDIND      ; deref → push word
001289r 2  60                   RTS
00128Ar 2               @const_emit:
00128Ar 2               ; CONST: offset bytes hold the literal value. X=lo, scratch=hi.
00128Ar 2  68                   PLA                     ; discard pcount
00128Br 2  8A                   TXA
00128Cr 2  20 rr rr             JSR     emit_LDCW
00128Fr 2  60                   RTS
001290r 2               @sym_func_call:
001290r 2               ; SYM_FUNC: emit MRKSTK + arg-stores + CALL.  Result is left on TOS
001290r 2               ; by op_RETF.  expr_type is the function's return type (already set).
001290r 2               ; X=off lo, scratch=off hi, top of 6502 stack = pcount.
001290r 2               ; NOTE: not nest-safe — calling a function inside another function
001290r 2               ; call's argument list will clobber fcall_*.  TODO: fix later.
001290r 2  8E rr rr             STX     fcall_lo
001293r 2  A5 rr                LDA     scratch
