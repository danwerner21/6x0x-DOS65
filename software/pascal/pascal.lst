002727r 2  20 rr rr             JSR     parse_expression
00272Ar 2  A9 1C                LDA     #TOK_RPAREN
00272Cr 2  20 rr rr             JSR     parse_eat_token
00272Fr 2  4C rr rr             JMP     emit_FRESET
002732r 2               
002732r 2               parse_builtin_rewrite:
002732r 2  20 rr rr             JSR     next_token              ; consume REWRITE
002735r 2  A9 1B                LDA     #TOK_LPAREN
