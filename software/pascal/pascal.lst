001A92r 2  E9 01                SBC     #1
001A94r 2  85 rr                STA     tmp2
001A96r 2  AD rr rr             LDA     symtab_count+1
001A99r 2  E9 00                SBC     #0
001A9Br 2  85 rr                STA     tmp2+1
