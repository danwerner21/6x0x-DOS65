00159Cr 2  48                   PHA
00159Dr 2  A5 rr                LDA     cg_pc+1
00159Fr 2  48                   PHA
0015A0r 2  A9 00                LDA     #$00
0015A2r 2  20 rr rr             JSR     emit_byte       ; placeholder lo
0015A5r 2  A9 00                LDA     #$00
0015A7r 2  20 rr rr             JSR     emit_byte       ; placeholder hi
0015AAr 2  68                   PLA
0015ABr 2  85 rr                STA     scratch
0015ADr 2  68                   PLA                     ; lo of patch address
0015AEr 2  60                   RTS                     ; caller: save A/scratch as patch point
0015AFr 2               
0015AFr 2               emit_FJP:
0015AFr 2  A9 51                LDA     #OP_FJP
0015B1r 2  20 rr rr             JSR     emit_byte
