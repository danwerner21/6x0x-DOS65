001AC5r 1                       .include        "CODEGEN.ASM"
001AC5r 2               ; codegen.asm — p-code emitter for Pascal/65 compiler
001AC5r 2               ;
001AC5r 2               ; All generated p-code accumulates in CODEBUF_BASE.
001AC5r 2               ; cg_pc (zero page) tracks the next write offset.
001AC5r 2               
001AC5r 2                       .segment        "CODE"
001AC5r 2               
001AC5r 2               ; ---------------------------------------------------------------------------
001AC5r 2               ; emit_byte — append byte A to code buffer
001AC5r 2               ; ---------------------------------------------------------------------------
001AC5r 2               emit_byte:
001AC5r 2  48                   PHA                     ; save byte to emit
001AC6r 2               ; check buffer full
001AC6r 2  A5 rr                LDA     cg_pc+1
001AC8r 2  C9 80                CMP     #>CODEBUF_MAXSZ
001ACAr 2  90 13                BCC     :+
001ACCr 2  A5 rr                LDA     cg_pc
001ACEr 2  C9 00                CMP     #<CODEBUF_MAXSZ
001AD0r 2  90 0D                BCC     :+
001AD2r 2               ; error: p-code buffer full
001AD2r 2  68                   PLA
001AD3r 2  A9 rr                LDA     #<err_pcd_full
001AD5r 2  85 rr                STA     tmp0
001AD7r 2  A9 rr                LDA     #>err_pcd_full
001AD9r 2  85 rr                STA     tmp0+1
001ADBr 2  20 rr rr             JSR     compile_error
001ADEr 2  60                   RTS
001ADFr 2               :
001ADFr 2               ; store at CODEBUF_BASE + cg_pc
001ADFr 2  A5 rr                LDA     cg_pc
001AE1r 2  18                   CLC
001AE2r 2  69 00                ADC     #<CODEBUF_BASE
001AE4r 2  85 rr                STA     tmp2
001AE6r 2  A5 rr                LDA     cg_pc+1
001AE8r 2  69 30                ADC     #>CODEBUF_BASE
001AEAr 2  85 rr                STA     tmp2+1
001AECr 2  68                   PLA
001AEDr 2  A0 00                LDY     #0
001AEFr 2  91 rr                STA     (tmp2),y
001AF1r 2               ; advance cg_pc
001AF1r 2  E6 rr                INC     cg_pc
001AF3r 2  D0 02                BNE     :+
001AF5r 2  E6 rr                INC     cg_pc+1
001AF7r 2               :
001AF7r 2  60                   RTS
001AF8r 2               
001AF8r 2               ; ---------------------------------------------------------------------------
001AF8r 2               ; emit_word — append word (lo then hi) from tmp2 to code buffer
001AF8r 2               ; ---------------------------------------------------------------------------
001AF8r 2               emit_word:
001AF8r 2  A5 rr                LDA     tmp2
001AFAr 2  20 rr rr             JSR     emit_byte
001AFDr 2  A5 rr                LDA     tmp2+1
