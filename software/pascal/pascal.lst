00138Cr 2  D0 03                BNE     :+
00138Er 2  4C rr rr             JMP     @not_expr
001391r 2               :
001391r 2  C9 4E                CMP     #TOK_NIL
001393r 2  D0 03                BNE     :+
001395r 2  4C rr rr             JMP     @nil
001398r 2               :
001398r 2  60                   RTS
001399r 2               
001399r 2               @int_lit:
001399r 2  A5 rr                LDA     tok_ival_lo
00139Br 2  48                   PHA
00139Cr 2  A5 rr                LDA     tok_ival_hi
00139Er 2  D0 11                BNE     @big_int
0013A0r 2  68                   PLA
0013A1r 2  30 0B                BMI     @big_int_lo     ; lo's bit 7 set — LDCI would sign-extend wrongly
0013A3r 2  20 rr rr             JSR     emit_LDCI
0013A6r 2  20 rr rr             JSR     next_token
0013A9r 2  A9 01                LDA     #TY_INT
0013ABr 2  85 rr                STA     expr_type
0013ADr 2  60                   RTS
