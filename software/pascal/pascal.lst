0014A1r 2               
0014A1r 2               @int_lit:
0014A1r 2  A5 rr                LDA     tok_ival_lo
0014A3r 2  48                   PHA
0014A4r 2  A5 rr                LDA     tok_ival_hi
0014A6r 2  D0 11                BNE     @big_int
0014A8r 2  68                   PLA
0014A9r 2  30 0B                BMI     @big_int_lo     ; lo's bit 7 set — LDCI would sign-extend wrongly
0014ABr 2  20 rr rr             JSR     emit_LDCI
0014AEr 2  20 rr rr             JSR     next_token
0014B1r 2  A9 01                LDA     #TY_INT
0014B3r 2  85 rr                STA     expr_type
0014B5r 2  60                   RTS
0014B6r 2               @big_int_lo:
0014B6r 2  48                   PHA
0014B7r 2  A9 00                LDA     #0
0014B9r 2               @big_int:
0014B9r 2  85 rr                STA     scratch
0014BBr 2  68                   PLA
0014BCr 2  20 rr rr             JSR     emit_LDCW
0014BFr 2  20 rr rr             JSR     next_token
0014C2r 2  A9 01                LDA     #TY_INT
0014C4r 2  85 rr                STA     expr_type
0014C6r 2  60                   RTS
0014C7r 2               
0014C7r 2               @char_lit:
