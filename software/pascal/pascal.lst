0012E2r 2  20 rr rr             JSR     next_token
0012E5r 2  20 rr rr             JSR     parse_term
0012E8r 2  20 rr rr             JSR     emit_ADI
0012EBr 2  A9 01                LDA     #TY_INT
0012EDr 2  85 rr                STA     expr_type
0012EFr 2  80 E2                BRA     @addop
0012F1r 2               @sub:
0012F1r 2  20 rr rr             JSR     next_token
0012F4r 2  20 rr rr             JSR     parse_term
0012F7r 2  20 rr rr             JSR     emit_SBI
0012FAr 2  A9 01                LDA     #TY_INT
0012FCr 2  85 rr                STA     expr_type
0012FEr 2  80 D3                BRA     @addop
001300r 2               @or:
001300r 2  20 rr rr             JSR     next_token
001303r 2  20 rr rr             JSR     parse_term
001306r 2  20 rr rr             JSR     emit_LOR
001309r 2  A9 03                LDA     #TY_BOOL
00130Br 2  85 rr                STA     expr_type
00130Dr 2  80 C4                BRA     @addop
00130Fr 2               
00130Fr 2               ; ---------------------------------------------------------------------------
00130Fr 2               ; parse_term — factor { (*|DIV|MOD|AND) factor }
00130Fr 2               ; ---------------------------------------------------------------------------
00130Fr 2               parse_term:
00130Fr 2  20 rr rr             JSR     parse_factor
001312r 2               @mulop:
001312r 2  A5 rr                LDA     tok_type
001314r 2  C9 12                CMP     #TOK_STAR
001316r 2  F0 11                BEQ     @mul
001318r 2  C9 45                CMP     #TOK_DIV
00131Ar 2  F0 1C                BEQ     @div
00131Cr 2  C9 45                CMP     #TOK_DIV_KW
00131Er 2  F0 18                BEQ     @div
001320r 2  C9 4D                CMP     #TOK_MOD_KW
001322r 2  F0 23                BEQ     @mod
001324r 2  C9 40                CMP     #TOK_AND
001326r 2  F0 2E                BEQ     @and
001328r 2  60                   RTS
001329r 2               @mul:
001329r 2  20 rr rr             JSR     next_token
00132Cr 2  20 rr rr             JSR     parse_factor
