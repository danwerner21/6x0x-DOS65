002704r 2  20 rr rr             JSR     next_token              ; consume ASSIGN
002707r 2  A9 1B                LDA     #TOK_LPAREN
002709r 2  20 rr rr             JSR     parse_eat_token
00270Cr 2  20 rr rr             JSR     parse_expression        ; file ptr (TY_TEXT)
00270Fr 2  A9 1F                LDA     #TOK_COMMA
002711r 2  20 rr rr             JSR     parse_eat_token
