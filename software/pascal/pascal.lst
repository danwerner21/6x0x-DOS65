00127Er 2  20 rr rr             JSR     next_token
001281r 2  20 rr rr             JSR     parse_simple_expr
001284r 2  20 rr rr             JSR     emit_NEQI
001287r 2  4C rr rr             JMP     @rel_done
00128Ar 2               @rel_lt:
