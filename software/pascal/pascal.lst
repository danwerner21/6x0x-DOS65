00133Br 2  20 rr rr             JSR     parse_factor
00133Er 2  20 rr rr             JSR     emit_DVI
001341r 2  A9 01                LDA     #TY_INT
001343r 2  85 rr                STA     expr_type
001345r 2  80 CB                BRA     @mulop
001347r 2               @mod:
001347r 2  20 rr rr             JSR     next_token
00134Ar 2  20 rr rr             JSR     parse_factor
