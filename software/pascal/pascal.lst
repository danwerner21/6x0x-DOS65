001E34r 2  85 rr                STA     expr_type
001E36r 2  80 9C                BRA     @mulop
001E38r 2               
001E38r 2               TOK_DIV_KW      = TOK_DIV       ; alias
001E38r 2               
001E38r 2               ; maybe_deref_loaded_ptr — a pointer value is already on the stack.
001E38r 2               ; If the following token is '^', consume it and load the pointed-to word.
001E38r 2               ; v1 pointer dereference still assumes pointer-to-INTEGER.
001E38r 2               maybe_deref_loaded_ptr:
001E38r 2  A5 rr                LDA     expr_type
001E3Ar 2  C9 07                CMP     #TY_PTR
001E3Cr 2  D0 10                BNE     @mdlp_done
001E3Er 2  A5 rr                LDA     tok_type
001E40r 2  C9 24                CMP     #TOK_CARET
001E42r 2  D0 0A                BNE     @mdlp_done
001E44r 2  20 rr rr             JSR     next_token
001E47r 2  20 rr rr             JSR     emit_LDIND
001E4Ar 2  A9 01                LDA     #TY_INT
001E4Cr 2  85 rr                STA     expr_type
001E4Er 2               @mdlp_done:
001E4Er 2  60                   RTS
001E4Fr 2               
001E4Fr 2               ; parse_with_field_load — current token is the field IDENT already matched by
001E4Fr 2               ; with_lookup_field. Emits code for the field expression and leaves expr_type
001E4Fr 2               ; set appropriately. Record-valued results stay as addresses on the stack.
001E4Fr 2               parse_with_field_load:
001E4Fr 2  20 rr rr             JSR     next_token              ; consume field name
001E52r 2  20 rr rr             JSR     emit_with_field_base
001E55r 2  AD rr rr             LDA     with_lookup_type
001E58r 2  85 rr                STA     expr_type
001E5Ar 2  C9 06                CMP     #TY_RECORD
001E5Cr 2  F0 06                BEQ     @pwfl_record
001E5Er 2  20 rr rr             JSR     emit_LDIND
001E61r 2  4C rr rr             JMP     maybe_deref_loaded_ptr
001E64r 2               @pwfl_record:
001E64r 2  A5 rr                LDA     tok_type
001E66r 2  C9 22                CMP     #TOK_DOT
001E68r 2  F0 0D                BEQ     @pwfl_chain_prep
001E6Ar 2  AD rr rr             LDA     with_lookup_first
001E6Dr 2  8D rr rr             STA     expr_record_first
001E70r 2  AD rr rr             LDA     with_lookup_count
001E73r 2  8D rr rr             STA     expr_record_count
001E76r 2  60                   RTS
001E77r 2               @pwfl_chain_prep:
001E77r 2  AD rr rr             LDA     with_lookup_first
001E7Ar 2  8D rr rr             STA     fcall_vmask
001E7Dr 2  AD rr rr             LDA     with_lookup_count
001E80r 2  8D rr rr             STA     fcall_lsize
001E83r 2               @pwfl_chain:
001E83r 2  A5 rr                LDA     tok_type
001E85r 2  C9 22                CMP     #TOK_DOT
001E87r 2  D0 03                BNE     :+
001E89r 2  20 rr rr             JSR     next_token
001E8Cr 2               :
001E8Cr 2  AD rr rr             LDA     fcall_vmask
001E8Fr 2  AE rr rr             LDX     fcall_lsize
001E92r 2  20 rr rr             JSR     field_lookup_in_record
001E95r 2  90 57                BCC     @pwfl_nf
001E97r 2  48                   PHA
001E98r 2  8A                   TXA
001E99r 2  8D rr rr             STA     field_chain_type
001E9Cr 2  A5 rr                LDA     tmp3
001E9Er 2  AA                   TAX
001E9Fr 2  BD rr rr             LDA     field_nested_first,x
001EA2r 2  8D rr rr             STA     field_chain_first
001EA5r 2  BD rr rr             LDA     field_nested_count,x
001EA8r 2  8D rr rr             STA     field_chain_count
001EABr 2  68                   PLA
001EACr 2  F0 06                BEQ     @pwfl_no_off
001EAEr 2  20 rr rr             JSR     emit_LDCI
001EB1r 2  20 rr rr             JSR     emit_ADI
001EB4r 2               @pwfl_no_off:
001EB4r 2  20 rr rr             JSR     next_token              ; consume nested field name
001EB7r 2  AD rr rr             LDA     field_chain_type
001EBAr 2  C9 06                CMP     #TY_RECORD
001EBCr 2  D0 14                BNE     @pwfl_done_chain
001EBEr 2  A5 rr                LDA     tok_type
001EC0r 2  C9 22                CMP     #TOK_DOT
001EC2r 2  D0 0E                BNE     @pwfl_done_chain
001EC4r 2  AD rr rr             LDA     field_chain_first
001EC7r 2  8D rr rr             STA     fcall_vmask
001ECAr 2  AD rr rr             LDA     field_chain_count
001ECDr 2  8D rr rr             STA     fcall_lsize
001ED0r 2  80 B1                BRA     @pwfl_chain
001ED2r 2               @pwfl_done_chain:
001ED2r 2  AD rr rr             LDA     field_chain_type
001ED5r 2  85 rr                STA     expr_type
001ED7r 2  C9 06                CMP     #TY_RECORD
001ED9r 2  F0 06                BEQ     @pwfl_record_result
001EDBr 2  20 rr rr             JSR     emit_LDIND
001EDEr 2  4C rr rr             JMP     maybe_deref_loaded_ptr
001EE1r 2               @pwfl_record_result:
001EE1r 2  AD rr rr             LDA     field_chain_first
001EE4r 2  8D rr rr             STA     expr_record_first
001EE7r 2  AD rr rr             LDA     field_chain_count
001EEAr 2  8D rr rr             STA     expr_record_count
001EEDr 2  60                   RTS
001EEEr 2               @pwfl_nf:
001EEEr 2  A9 rr                LDA     #<err_undef
001EF0r 2  85 rr                STA     tmp0
001EF2r 2  A9 rr                LDA     #>err_undef
001EF4r 2  85 rr                STA     tmp0+1
001EF6r 2  20 rr rr             JSR     compile_error
001EF9r 2  20 rr rr             JSR     next_token
001EFCr 2  20 rr rr             JSR     emit_LDIND
001EFFr 2  A9 01                LDA     #TY_INT
001F01r 2  85 rr                STA     expr_type
001F03r 2  60                   RTS
001F04r 2               
001F04r 2               ; ---------------------------------------------------------------------------
001F04r 2               ; SET literal helpers
001F04r 2               ; ---------------------------------------------------------------------------
001F04r 2               set_lit_type_error:
001F04r 2  A9 rr                LDA     #<err_type
001F06r 2  85 rr                STA     tmp0
001F08r 2  A9 rr                LDA     #>err_type
001F0Ar 2  85 rr                STA     tmp0+1
001F0Cr 2  20 rr rr             JSR     compile_error
001F0Fr 2  60                   RTS
001F10r 2               
001F10r 2               ; set_lit_add_value — A=value 0..15. ORs the matching bit into set_lit_mask.
001F10r 2               set_lit_add_value:
001F10r 2  AA                   TAX
001F11r 2  A9 01                LDA     #1
001F13r 2  85 rr                STA     tmp0
001F15r 2  A9 00                LDA     #0
001F17r 2  85 rr                STA     tmp0+1
001F19r 2               @slav_shift:
001F19r 2  E0 00                CPX     #0
001F1Br 2  F0 07                BEQ     @slav_merge
001F1Dr 2  06 rr                ASL     tmp0
001F1Fr 2  26 rr                ROL     tmp0+1
001F21r 2  CA                   DEX
001F22r 2  80 F5                BRA     @slav_shift
001F24r 2               @slav_merge:
001F24r 2  AD rr rr             LDA     set_lit_mask
001F27r 2  05 rr                ORA     tmp0
001F29r 2  8D rr rr             STA     set_lit_mask
001F2Cr 2  AD rr rr             LDA     set_lit_mask+1
001F2Fr 2  05 rr                ORA     tmp0+1
001F31r 2  8D rr rr             STA     set_lit_mask+1
001F34r 2  60                   RTS
001F35r 2               
001F35r 2               ; parse_set_literal — current token is '['. Supports [] and constant integer
001F35r 2               ; items/ranges like [1,3,5] and [3..6]. Elements must be 0..15 in this build.
001F35r 2               parse_set_literal:
001F35r 2  A9 00                LDA     #0
001F37r 2  8D rr rr             STA     set_lit_mask
001F3Ar 2  8D rr rr             STA     set_lit_mask+1
001F3Dr 2  20 rr rr             JSR     next_token              ; consume '['
001F40r 2  A5 rr                LDA     tok_type
001F42r 2  C9 1E                CMP     #TOK_RBRACK
001F44r 2  D0 03                BNE     @psl_item
001F46r 2  4C rr rr             JMP     @psl_close
001F49r 2               @psl_item:
001F49r 2  A5 rr                LDA     tok_type
001F4Br 2  C9 02                CMP     #TOK_INT
001F4Dr 2  D0 55                BNE     @psl_bad_item
001F4Fr 2  A5 rr                LDA     tok_ival_hi
001F51r 2  D0 51                BNE     @psl_bad_item
001F53r 2  A5 rr                LDA     tok_ival_lo
001F55r 2  C9 10                CMP     #16
001F57r 2  B0 4B                BCS     @psl_bad_item
001F59r 2  8D rr rr             STA     set_lit_lo
001F5Cr 2  20 rr rr             JSR     next_token              ; consume item lo
001F5Fr 2  A5 rr                LDA     tok_type
001F61r 2  C9 23                CMP     #TOK_DOTDOT
001F63r 2  D0 37                BNE     @psl_single
001F65r 2  20 rr rr             JSR     next_token              ; consume ..
001F68r 2  A5 rr                LDA     tok_type
001F6Ar 2  C9 02                CMP     #TOK_INT
001F6Cr 2  D0 3E                BNE     @psl_bad_range
001F6Er 2  A5 rr                LDA     tok_ival_hi
001F70r 2  D0 3A                BNE     @psl_bad_range
001F72r 2  A5 rr                LDA     tok_ival_lo
001F74r 2  C9 10                CMP     #16
001F76r 2  B0 34                BCS     @psl_bad_range
001F78r 2  8D rr rr             STA     set_lit_hi
001F7Br 2  CD rr rr             CMP     set_lit_lo
001F7Er 2  90 2C                BCC     @psl_bad_range
001F80r 2  20 rr rr             JSR     next_token              ; consume item hi
001F83r 2  AD rr rr             LDA     set_lit_lo
001F86r 2  8D rr rr             STA     set_lit_cur
001F89r 2               @psl_range_loop:
001F89r 2  AD rr rr             LDA     set_lit_cur
001F8Cr 2  20 rr rr             JSR     set_lit_add_value
001F8Fr 2  AD rr rr             LDA     set_lit_cur
001F92r 2  CD rr rr             CMP     set_lit_hi
001F95r 2  F0 21                BEQ     @psl_after_item
001F97r 2  EE rr rr             INC     set_lit_cur
001F9Ar 2  80 ED                BRA     @psl_range_loop
001F9Cr 2               @psl_single:
001F9Cr 2  AD rr rr             LDA     set_lit_lo
001F9Fr 2  20 rr rr             JSR     set_lit_add_value
001FA2r 2  80 14                BRA     @psl_after_item
001FA4r 2               @psl_bad_item:
001FA4r 2  20 rr rr             JSR     set_lit_type_error
001FA7r 2  20 rr rr             JSR     next_token
001FAAr 2  80 0C                BRA     @psl_after_item
001FACr 2               @psl_bad_range:
001FACr 2  20 rr rr             JSR     set_lit_type_error
001FAFr 2  A5 rr                LDA     tok_type
001FB1r 2  C9 02                CMP     #TOK_INT
001FB3r 2  D0 03                BNE     @psl_after_item
001FB5r 2  20 rr rr             JSR     next_token
001FB8r 2               @psl_after_item:
001FB8r 2  A5 rr                LDA     tok_type
001FBAr 2  C9 1F                CMP     #TOK_COMMA
001FBCr 2  D0 05                BNE     @psl_done_items
001FBEr 2  20 rr rr             JSR     next_token
001FC1r 2  80 86                BRA     @psl_item
001FC3r 2               @psl_done_items:
001FC3r 2  A5 rr                LDA     tok_type
001FC5r 2  C9 1E                CMP     #TOK_RBRACK
001FC7r 2  F0 0D                BEQ     @psl_close
001FC9r 2  A9 rr                LDA     #<err_expected_rb
001FCBr 2  85 rr                STA     tmp0
001FCDr 2  A9 rr                LDA     #>err_expected_rb
001FCFr 2  85 rr                STA     tmp0+1
001FD1r 2  20 rr rr             JSR     compile_error
001FD4r 2  80 03                BRA     @psl_emit
001FD6r 2               @psl_close:
001FD6r 2  20 rr rr             JSR     next_token              ; consume ']'
001FD9r 2               @psl_emit:
001FD9r 2  AD rr rr             LDA     set_lit_mask+1
001FDCr 2  85 rr                STA     scratch
001FDEr 2  AD rr rr             LDA     set_lit_mask
001FE1r 2  20 rr rr             JSR     emit_LDCW
001FE4r 2  A9 09                LDA     #TY_SET
001FE6r 2  85 rr                STA     expr_type
001FE8r 2  60                   RTS
001FE9r 2               
001FE9r 2               ; ---------------------------------------------------------------------------
001FE9r 2               ; parse_factor — literal | set-literal | variable | ( expr ) | NOT factor
001FE9r 2               ; ---------------------------------------------------------------------------
001FE9r 2               parse_factor:
001FE9r 2  A5 rr                LDA     tok_type
001FEBr 2  C9 02                CMP     #TOK_INT
001FEDr 2  D0 03                BNE     :+
001FEFr 2  4C rr rr             JMP     @int_lit
001FF2r 2               :
001FF2r 2  C9 04                CMP     #TOK_CHAR
001FF4r 2  D0 03                BNE     :+
001FF6r 2  4C rr rr             JMP     @char_lit
001FF9r 2               :
001FF9r 2  C9 03                CMP     #TOK_STRING
001FFBr 2  D0 03                BNE     :+
001FFDr 2  4C rr rr             JMP     @str_lit
002000r 2               :
002000r 2  C9 1D                CMP     #TOK_LBRACK
002002r 2  D0 03                BNE     :+
002004r 2  4C rr rr             JMP     @set_lit
002007r 2               :
002007r 2  C9 01                CMP     #TOK_IDENT
002009r 2  D0 03                BNE     :+
00200Br 2  4C rr rr             JMP     @ident_or_call
00200Er 2               :
00200Er 2  C9 1B                CMP     #TOK_LPAREN
002010r 2  D0 03                BNE     :+
002012r 2  4C rr rr             JMP     @paren
002015r 2               :
002015r 2  C9 50                CMP     #TOK_NOT
002017r 2  D0 03                BNE     :+
002019r 2  4C rr rr             JMP     @not_expr
00201Cr 2               :
00201Cr 2  C9 4F                CMP     #TOK_NIL
00201Er 2  D0 03                BNE     :+
002020r 2  4C rr rr             JMP     @nil
002023r 2               :
002023r 2  60                   RTS
002024r 2               
002024r 2               @int_lit:
002024r 2  A5 rr                LDA     tok_ival_lo
002026r 2  48                   PHA
002027r 2  A5 rr                LDA     tok_ival_hi
002029r 2  D0 11                BNE     @big_int
00202Br 2  68                   PLA
00202Cr 2  30 0B                BMI     @big_int_lo     ; lo's bit 7 set — LDCI would sign-extend wrongly
00202Er 2  20 rr rr             JSR     emit_LDCI
002031r 2  20 rr rr             JSR     next_token
002034r 2  A9 01                LDA     #TY_INT
002036r 2  85 rr                STA     expr_type
002038r 2  60                   RTS
002039r 2               @big_int_lo:
002039r 2  48                   PHA
00203Ar 2  A9 00                LDA     #0
00203Cr 2               @big_int:
00203Cr 2  85 rr                STA     scratch
00203Er 2  68                   PLA
00203Fr 2  20 rr rr             JSR     emit_LDCW
002042r 2  20 rr rr             JSR     next_token
002045r 2  A9 01                LDA     #TY_INT
002047r 2  85 rr                STA     expr_type
002049r 2  60                   RTS
00204Ar 2               
00204Ar 2               @char_lit:
00204Ar 2  A5 rr                LDA     tok_ival_lo
00204Cr 2  20 rr rr             JSR     emit_LDCC
00204Fr 2  20 rr rr             JSR     next_token
002052r 2  A9 02                LDA     #TY_CHAR
002054r 2  85 rr                STA     expr_type
002056r 2  60                   RTS
002057r 2               
002057r 2               @str_lit:
002057r 2               ; Inline string: emit OP_LDCS + length + chars.  Runtime pushes the
002057r 2               ; address of the length byte as a Pascal-string pointer.
002057r 2  20 rr rr             JSR     emit_LDCS
00205Ar 2  20 rr rr             JSR     next_token
00205Dr 2  A9 04                LDA     #TY_STRING
00205Fr 2  85 rr                STA     expr_type
002061r 2  60                   RTS
002062r 2               
002062r 2               @set_lit:
002062r 2  20 rr rr             JSR     parse_set_literal
002065r 2  60                   RTS
002066r 2               
002066r 2               @ident_or_call:
002066r 2               ; First check for built-ins (LENGTH/POS/COPY/CONCAT/EOF/EOLN/TRUE/FALSE)
002066r 2               ; by length+initial.  These take precedence over user identifiers
002066r 2               ; (matching WRITE/READ handling in parse_assign_or_call).  All dispatch
002066r 2               ; branches use JMPs because the target blocks are scattered too far for
002066r 2               ; ±127 byte BEQ range.
002066r 2  AD rr rr             LDA     ident_buf
002069r 2  C9 03                CMP     #3
00206Br 2  D0 03                BNE     @bi_dn3
00206Dr 2  4C rr rr             JMP     @bi_chk3
002070r 2               @bi_dn3:
002070r 2  C9 04                CMP     #4
002072r 2  D0 03                BNE     @bi_dn4
002074r 2  4C rr rr             JMP     @bi_chk4
002077r 2               @bi_dn4:
002077r 2  C9 05                CMP     #5
002079r 2  D0 03                BNE     @bi_dn5
00207Br 2  4C rr rr             JMP     @bi_chk5
00207Er 2               @bi_dn5:
00207Er 2  C9 06                CMP     #6
002080r 2  D0 03                BNE     @bi_dn6
002082r 2  4C rr rr             JMP     @bi_chk_len_or_cat
002085r 2               @bi_dn6:
002085r 2  4C rr rr             JMP     @do_lookup
002088r 2               @bi_chk4:
002088r 2               ; 4-letter built-ins: COPY, EOLN, TRUE
002088r 2  AD rr rr             LDA     ident_buf+1
00208Br 2  C9 43                CMP     #'C'
00208Dr 2  D0 03                BNE     :+
00208Fr 2  4C rr rr             JMP     @bi_chk_copy
002092r 2               :
002092r 2  C9 45                CMP     #'E'
002094r 2  F0 07                BEQ     @bi_try_eoln
002096r 2  C9 54                CMP     #'T'
002098r 2  F0 1B                BEQ     @bi_try_true
00209Ar 2  4C rr rr             JMP     @do_lookup
00209Dr 2               @bi_try_eoln:
00209Dr 2  AD rr rr             LDA     ident_buf+2
0020A0r 2  C9 4F                CMP     #'O'
0020A2r 2  D0 29                BNE     @bi4_no
0020A4r 2  AD rr rr             LDA     ident_buf+3
0020A7r 2  C9 4C                CMP     #'L'
0020A9r 2  D0 22                BNE     @bi4_no
0020ABr 2  AD rr rr             LDA     ident_buf+4
0020AEr 2  C9 4E                CMP     #'N'
0020B0r 2  D0 1B                BNE     @bi4_no
0020B2r 2  4C rr rr             JMP     parse_builtin_eoln
0020B5r 2               @bi_try_true:
0020B5r 2  AD rr rr             LDA     ident_buf+2
0020B8r 2  C9 52                CMP     #'R'
0020BAr 2  D0 11                BNE     @bi4_no
0020BCr 2  AD rr rr             LDA     ident_buf+3
0020BFr 2  C9 55                CMP     #'U'
0020C1r 2  D0 0A                BNE     @bi4_no
0020C3r 2  AD rr rr             LDA     ident_buf+4
0020C6r 2  C9 45                CMP     #'E'
0020C8r 2  D0 03                BNE     @bi4_no
0020CAr 2  4C rr rr             JMP     parse_builtin_true
0020CDr 2               @bi4_no:
0020CDr 2  4C rr rr             JMP     @do_lookup
0020D0r 2               @bi_chk5:
0020D0r 2               ; 5-letter built-ins: FALSE
0020D0r 2  AD rr rr             LDA     ident_buf+1
0020D3r 2  C9 46                CMP     #'F'
0020D5r 2  D0 1F                BNE     @bi5_no
0020D7r 2  AD rr rr             LDA     ident_buf+2
0020DAr 2  C9 41                CMP     #'A'
0020DCr 2  D0 18                BNE     @bi5_no
0020DEr 2  AD rr rr             LDA     ident_buf+3
0020E1r 2  C9 4C                CMP     #'L'
0020E3r 2  D0 11                BNE     @bi5_no
0020E5r 2  AD rr rr             LDA     ident_buf+4
0020E8r 2  C9 53                CMP     #'S'
0020EAr 2  D0 0A                BNE     @bi5_no
0020ECr 2  AD rr rr             LDA     ident_buf+5
0020EFr 2  C9 45                CMP     #'E'
0020F1r 2  D0 03                BNE     @bi5_no
0020F3r 2  4C rr rr             JMP     parse_builtin_false
0020F6r 2               @bi5_no:
0020F6r 2  4C rr rr             JMP     @do_lookup
0020F9r 2               @bi_chk3:
0020F9r 2               ; 3-letter built-ins: POS, EOF
0020F9r 2  AD rr rr             LDA     ident_buf+1
0020FCr 2  C9 50                CMP     #'P'
0020FEr 2  F0 17                BEQ     @bi_chk_pos
002100r 2  C9 45                CMP     #'E'
002102r 2  F0 02                BEQ     @bi_chk_eof
002104r 2  80 6E                BRA     @do_lookup
002106r 2               @bi_chk_eof:
002106r 2  AD rr rr             LDA     ident_buf+2
002109r 2  C9 4F                CMP     #'O'
00210Br 2  D0 67                BNE     @do_lookup
00210Dr 2  AD rr rr             LDA     ident_buf+3
002110r 2  C9 46                CMP     #'F'
002112r 2  D0 60                BNE     @do_lookup
002114r 2  4C rr rr             JMP     parse_builtin_eof
002117r 2               @bi_chk_pos:
002117r 2  AD rr rr             LDA     ident_buf+2
00211Ar 2  C9 4F                CMP     #'O'
00211Cr 2  D0 56                BNE     @do_lookup
00211Er 2  AD rr rr             LDA     ident_buf+3
002121r 2  C9 53                CMP     #'S'
002123r 2  D0 4F                BNE     @do_lookup
002125r 2  4C rr rr             JMP     parse_builtin_pos
002128r 2               @bi_chk_copy:
002128r 2  AD rr rr             LDA     ident_buf+1
00212Br 2  C9 43                CMP     #'C'
00212Dr 2  D0 45                BNE     @do_lookup
00212Fr 2  AD rr rr             LDA     ident_buf+2
002132r 2  C9 4F                CMP     #'O'
002134r 2  D0 3E                BNE     @do_lookup
002136r 2  AD rr rr             LDA     ident_buf+3
002139r 2  C9 50                CMP     #'P'
00213Br 2  D0 37                BNE     @do_lookup
00213Dr 2  AD rr rr             LDA     ident_buf+4
002140r 2  C9 59                CMP     #'Y'
002142r 2  D0 30                BNE     @do_lookup
002144r 2  4C rr rr             JMP     parse_builtin_copy
002147r 2               @bi_chk_len_or_cat:
002147r 2  AD rr rr             LDA     ident_buf+1
00214Ar 2  C9 4C                CMP     #'L'
00214Cr 2  F0 15                BEQ     @bi_try_length
00214Er 2  C9 43                CMP     #'C'
002150r 2  D0 22                BNE     @do_lookup
002152r 2               ; CONCAT? check 'O','N','C','A','T'
002152r 2  AD rr rr             LDA     ident_buf+2
002155r 2  C9 4F                CMP     #'O'
002157r 2  D0 1B                BNE     @do_lookup
002159r 2  AD rr rr             LDA     ident_buf+3
00215Cr 2  C9 4E                CMP     #'N'
00215Er 2  D0 14                BNE     @do_lookup
002160r 2  4C rr rr             JMP     parse_builtin_concat
002163r 2               @bi_try_length:
002163r 2  AD rr rr             LDA     ident_buf+2
002166r 2  C9 45                CMP     #'E'
002168r 2  D0 0A                BNE     @do_lookup
00216Ar 2  AD rr rr             LDA     ident_buf+3
00216Dr 2  C9 4E                CMP     #'N'
00216Fr 2  D0 03                BNE     @do_lookup
002171r 2  4C rr rr             JMP     parse_builtin_length
002174r 2               @do_lookup:
002174r 2  20 rr rr             JSR     with_lookup_field
002177r 2  90 03                BCC     @lookup_symtab
002179r 2  4C rr rr             JMP     parse_with_field_load
00217Cr 2               @lookup_symtab:
00217Cr 2               ; Look up BEFORE next_token — next_token may overwrite ident_buf
00217Cr 2               ; if the following token is an identifier or keyword (e.g. J THEN).
00217Cr 2  20 rr rr             JSR     symtab_find
00217Fr 2  B0 0F                BCS     @sym_ok
002181r 2  20 rr rr             JSR     next_token      ; consume ident
002184r 2  A9 00                LDA     #0
002186r 2  85 rr                STA     scratch
002188r 2  20 rr rr             JSR     emit_LDCW       ; undefined: emit 0
00218Br 2  A9 01                LDA     #TY_INT
00218Dr 2  85 rr                STA     expr_type
00218Fr 2  60                   RTS
002190r 2               @sym_ok:
002190r 2               ; Snapshot kind/type/scope/offset/pcount onto the 6502 stack —
002190r 2               ; sym_save_* would conflict with parse_assign_or_call when this
002190r 2               ; @ident_or_call runs inside a nested parse_expression.
002190r 2  A0 16                LDY     #22
002192r 2  B1 rr                LDA     (tmp3),y
002194r 2  8D rr rr             STA     fcall_vmask     ; (only meaningful for SYM_FUNC)
002197r 2  A0 17                LDY     #23
002199r 2  B1 rr                LDA     (tmp3),y
00219Br 2  8D rr rr             STA     fcall_lsize     ; full local-area size for MRKSTK
00219Er 2  A0 15                LDY     #21
0021A0r 2  B1 rr                LDA     (tmp3),y
0021A2r 2  48                   PHA                     ; pcount (deepest)
0021A3r 2  A0 10                LDY     #16
0021A5r 2  B1 rr                LDA     (tmp3),y
0021A7r 2  48                   PHA                     ; kind
0021A8r 2  A0 11                LDY     #17
0021AAr 2  B1 rr                LDA     (tmp3),y
0021ACr 2  85 rr                STA     expr_type       ; data type code
0021AEr 2  A0 14                LDY     #20
0021B0r 2  B1 rr                LDA     (tmp3),y
0021B2r 2  48                   PHA                     ; scope
0021B3r 2  A0 13                LDY     #19
0021B5r 2  B1 rr                LDA     (tmp3),y
0021B7r 2  48                   PHA                     ; off hi
0021B8r 2  A0 12                LDY     #18
0021BAr 2  B1 rr                LDA     (tmp3),y
0021BCr 2  48                   PHA                     ; off lo (top)
0021BDr 2  20 rr rr             JSR     next_token      ; consume ident (may overwrite ident_buf/tmp3)
0021C0r 2  68                   PLA                     ; off lo
0021C1r 2  AA                   TAX                     ; X = off lo
0021C2r 2  68                   PLA                     ; off hi
0021C3r 2  85 rr                STA     scratch         ; scratch = off hi
0021C5r 2  68                   PLA                     ; scope
0021C6r 2  A8                   TAY                     ; Y = scope (preserved across kind test)
0021C7r 2  68                   PLA                     ; kind
0021C8r 2  C9 04                CMP     #SYM_FUNC
