002113r 2  D0 0E                BNE     @pwfl_done_chain
002115r 2  AD rr rr             LDA     field_chain_first
002118r 2  8D rr rr             STA     fcall_vmask
00211Br 2  AD rr rr             LDA     field_chain_count
