000000r 1               ; pascal.asm — Pascal/65 Compiler for DOS/65
000000r 1               ;
000000r 1               ; Usage: PASCAL <sourcename>
000000r 1               ;   Reads <sourcename>.PAS, writes <sourcename>.PCD
000000r 1               ;
000000r 1               ; Phase 1 entry point and top-level driver only.
000000r 1               ; Lexer, parser, symbol table, and code generator are in separate files
000000r 1               ; included at the bottom of this file.
000000r 1               
000000r 1               .PC02   ; enable 65C02 (bra/phx/plx) for write_pcd etc.
000000r 1                       ; lexer.asm also asserts this; included files
000000r 1                       ; pick it up after lexer.asm runs.
000000r 1               
000000r 1                       .include        "DEFINITIONS.ASM"
000000r 2               ; definitions.asm — constants, token codes, p-code opcodes, macros
000000r 2               
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               ; DOS/65 system entry points
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               PEM_ENTRY       = $0103         ; JSR here; function # in X
000000r 2               WARM_BOOT       = $0100
000000r 2               DEFAULT_FCB     = $0107         ; DOS/65 dflfcb (parsed argument FCB)
000000r 2               DMA_BUF         = $0128         ; DOS/65 dflbuf (default DMA buffer)
000000r 2               
000000r 2               ; PEM function numbers
000000r 2               PEM_CONIN       = 1             ; console input with echo (blocking)
000000r 2               PEM_CONOUT      = 2             ; console output (A=char)
000000r 2               PEM_DIRCON      = 6             ; direct console I/O (BLOCKING — use fn 11 first)
000000r 2               PEM_CONSTAT     = 11            ; console status (non-blocking)
000000r 2               PEM_OPEN        = 15
000000r 2               PEM_CLOSE       = 16
000000r 2               PEM_SEARCH      = 17
000000r 2               PEM_DELETE      = 19
000000r 2               PEM_READ        = 20
000000r 2               PEM_WRITE       = 21
000000r 2               PEM_MAKE        = 22
000000r 2               PEM_SETDMA      = 26            ; set DMA buffer address (A=lo, Y=hi)
000000r 2               
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               ; P-code opcodes
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               
000000r 2               ; --- Constants ---
000000r 2               OP_LDCI         = $00           ; push sign-extended byte constant
000000r 2               OP_LDCW         = $01           ; push word constant (lo, hi)
000000r 2               OP_LDCC         = $02           ; push char constant
000000r 2               OP_LDCB         = $03           ; push boolean constant (0/1)
000000r 2               OP_LDCS         = $04           ; push string constant (len + bytes)
000000r 2               OP_LDCN         = $05           ; push NIL
000000r 2               
000000r 2               ; --- Local variable access ---
000000r 2               OP_LDL          = $10           ; push 16-bit local (byte offset from MP+8)
000000r 2               OP_STL          = $11           ; pop into 16-bit local
000000r 2               OP_LDA_L        = $12           ; push address of local
000000r 2               OP_LDB_L        = $13           ; push byte/char/bool local
000000r 2               OP_STB_L        = $14           ; pop byte into local
000000r 2               
000000r 2               ; --- Global variable access ---
000000r 2               OP_LDG          = $18           ; push 16-bit global (word offset from BASE)
000000r 2               OP_STG          = $19           ; pop into 16-bit global
000000r 2               OP_LDA_G        = $1A           ; push address of global
000000r 2               OP_LDB_G        = $1B           ; push byte global
000000r 2               OP_STB_G        = $1C           ; pop byte into global
000000r 2               
000000r 2               ; --- Indirect / array ---
000000r 2               OP_LDIND        = $20           ; TOS=addr → push word at addr
000000r 2               OP_STIND        = $21           ; NOS=addr, TOS=val → store
000000r 2               OP_LDB_IND      = $22           ; TOS=addr → push byte at addr
000000r 2               OP_STB_IND      = $23           ; NOS=addr, TOS=val → store byte
000000r 2               OP_INDEX        = $24           ; array index: addr=NOS+TOS*elemsize (word follows)
000000r 2               
000000r 2               ; --- Integer arithmetic ---
000000r 2               OP_ADI          = $30
000000r 2               OP_SBI          = $31
000000r 2               OP_MPI          = $32
000000r 2               OP_DVI          = $33
000000r 2               OP_MOD          = $34
000000r 2               OP_NGI          = $35           ; negate
000000r 2               OP_ABI          = $36           ; absolute value
000000r 2               OP_SQI          = $37           ; square
000000r 2               
000000r 2               ; --- Logical / bitwise ---
000000r 2               OP_LAND         = $38
000000r 2               OP_LOR          = $39
000000r 2               OP_LNOT         = $3A           ; logical NOT ($0000 ↔ $FFFF)
000000r 2               OP_BNOT         = $3B           ; bitwise complement
000000r 2               
000000r 2               ; --- Comparison (push $FFFF=true, $0000=false) ---
000000r 2               OP_EQUI         = $40
000000r 2               OP_NEQI         = $41
000000r 2               OP_LESI         = $42
000000r 2               OP_LEQI         = $43
000000r 2               OP_GTRI         = $44
000000r 2               OP_GEQI         = $45
000000r 2               OP_EQUB         = $46           ; byte equality
000000r 2               OP_EQUS         = $47           ; string equality
000000r 2               
000000r 2               ; --- Control flow ---
000000r 2               OP_UJP          = $50           ; unconditional jump (signed word offset)
000000r 2               OP_FJP          = $51           ; jump if false (pop TOS)
000000r 2               OP_TJP          = $52           ; jump if true  (pop TOS)
000000r 2               OP_IXPJP        = $53           ; case jump table
000000r 2               
000000r 2               ; --- Procedure/function calls ---
000000r 2               OP_CALL         = $60           ; call (signed word offset from current IPC)
000000r 2               OP_CALI         = $61           ; call absolute address (word)
000000r 2               OP_RET          = $62           ; return from procedure
000000r 2               OP_RETF         = $63           ; return from function (leave result on stack)
000000r 2               OP_MRKSTK       = $64           ; set up activation record (byte: local size)
000000r 2               OP_DEPSTK       = $65           ; tear down activation record
000000r 2               OP_STR          = $66           ; pop word, store at MP+AR_RET_VAL (function result)
000000r 2               
000000r 2               ; --- Heap ---
000000r 2               OP_NEW          = $70           ; allocate (word size follows); push pointer
000000r 2               OP_DISP         = $71           ; free pointer on TOS
000000r 2               
000000r 2               ; --- I/O ---
000000r 2               OP_WRITI        = $80           ; write integer
000000r 2               OP_WRITC        = $81           ; write character
000000r 2               OP_WRITB        = $82           ; write boolean
000000r 2               OP_WRITS        = $83           ; write string
000000r 2               OP_WRITLN       = $84           ; write newline
000000r 2               OP_READI        = $85           ; read integer
000000r 2               OP_READC        = $86           ; read character
000000r 2               OP_READS        = $87           ; read string
000000r 2               
000000r 2               ; --- Stack manipulation ---
000000r 2               OP_DUP          = $90
000000r 2               OP_POP          = $91
000000r 2               OP_SWAP         = $92
000000r 2               OP_MOVS         = $93           ; copy n bytes (byte count follows)
000000r 2               
000000r 2               ; --- String built-ins ---
000000r 2               OP_LEN          = $A0           ; TOS=strptr -> TOS=length (int)
000000r 2               OP_POS          = $A1           ; NOS=substr, TOS=str -> TOS=1-based pos (0=not found)
000000r 2               OP_COPY         = $A2           ; NNOS=str, NOS=index, TOS=count -> TOS=result strptr
000000r 2               OP_CONCAT       = $A3           ; NOS=s1, TOS=s2 -> TOS=result strptr
000000r 2               
000000r 2               ; --- TEXT file I/O ---
000000r 2               ; All file ops take a file-struct pointer (NOS / TOS).
000000r 2               OP_FASSGN       = $B0           ; NOS=fileptr, TOS=strptr (filename) -> set FCB
000000r 2               OP_FRESET       = $B1           ; TOS=fileptr -> open existing for reading
000000r 2               OP_FREWRT       = $B2           ; TOS=fileptr -> create/truncate for writing
000000r 2               OP_FCLOSE       = $B3           ; TOS=fileptr -> flush and close
000000r 2               OP_FWRC         = $B4           ; NOS=fileptr, TOS=char -> append char
000000r 2               OP_FWRS         = $B5           ; NOS=fileptr, TOS=strptr -> append string
000000r 2               OP_FWRI         = $B6           ; NOS=fileptr, TOS=int   -> append decimal
000000r 2               OP_FWLN         = $B7           ; TOS=fileptr -> append CR+LF
000000r 2               OP_FRDC         = $B8           ; NOS=fileptr, TOS=charvar addr -> read char
000000r 2               OP_FRDI         = $B9           ; NOS=fileptr, TOS=intvar  addr -> read decimal int
000000r 2               OP_FRDLN        = $BA           ; TOS=fileptr -> skip remaining chars to end-of-line
000000r 2               OP_FEOF         = $BB           ; TOS=fileptr -> push EOF flag (0=false, $FFFF=true)
000000r 2               OP_FRDS         = $BD           ; NOS=fileptr, TOS=strvar addr -> read string to EOL
000000r 2               OP_FWRB         = $BE           ; NOS=fileptr, TOS=bool -> append "TRUE"/"FALSE"
000000r 2               OP_FEOLN        = $BF           ; TOS=fileptr -> push EOLN flag (true if at CR/LF/EOF)
000000r 2               
000000r 2               ; TEXT-file struct layout (168 bytes per variable)
000000r 2               F_FCB           = 0             ; 36 bytes
000000r 2               F_BUF           = 36            ; 128 bytes
000000r 2               F_MODE          = 164           ; 0=closed, 1=read, 2=write
000000r 2               F_POS           = 165           ; 0..127 buffer position
000000r 2               F_EOF           = 166           ; 0=more data, 1=EOF reached
000000r 2               F_SPARE         = 167
000000r 2               FILE_STRUCT_SZ  = 168
000000r 2               
000000r 2               F_MODE_CLOSED   = 0
000000r 2               F_MODE_READ     = 1
000000r 2               F_MODE_WRITE    = 2
000000r 2               
000000r 2               CTRL_Z          = $1A           ; CP/M text-file end-of-data marker
000000r 2               
000000r 2               ; --- Halt ---
000000r 2               OP_HALT         = $FF
000000r 2               
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               ; .PCD file magic / version
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               PCD_MAGIC_0     = $50           ; 'P'
000000r 2               PCD_MAGIC_1     = $43           ; 'C'
000000r 2               PCD_VERSION     = $01
000000r 2               
000000r 2               ; PCD header offsets
000000r 2               PCD_MAGIC       = 0
000000r 2               PCD_VER         = 2
000000r 2               PCD_CODESZ      = 4             ; word: code section size
000000r 2               PCD_GLOBSZ      = 6             ; word: global data size
000000r 2               PCD_STRSZ       = 8             ; word: string pool size
000000r 2               PCD_ENTRY       = 10            ; word: entry point offset into code
000000r 2               PCD_HEADER_SZ   = 12
000000r 2               
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               ; Token codes (used by compiler lexer/parser)
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               TOK_EOF         = 0
000000r 2               TOK_IDENT       = 1
000000r 2               TOK_INT         = 2
000000r 2               TOK_STRING      = 3
000000r 2               TOK_CHAR        = 4
000000r 2               
000000r 2               ; Operators / punctuation
000000r 2               TOK_PLUS        = $10           ; +
000000r 2               TOK_MINUS       = $11           ; -
000000r 2               TOK_STAR        = $12           ; *
000000r 2               TOK_SLASH       = $13           ; /
000000r 2               TOK_EQ          = $14           ; =
000000r 2               TOK_NEQ         = $15           ; <>
000000r 2               TOK_LT          = $16           ; <
000000r 2               TOK_GT          = $17           ; >
000000r 2               TOK_LEQ         = $18           ; <=
000000r 2               TOK_GEQ         = $19           ; >=
000000r 2               TOK_ASSIGN      = $1A           ; :=
000000r 2               TOK_LPAREN      = $1B           ; (
000000r 2               TOK_RPAREN      = $1C           ; )
000000r 2               TOK_LBRACK      = $1D           ; [
000000r 2               TOK_RBRACK      = $1E           ; ]
000000r 2               TOK_COMMA       = $1F           ; ,
000000r 2               TOK_SEMICOLON   = $20           ; ;
000000r 2               TOK_COLON       = $21           ; :
000000r 2               TOK_DOT         = $22           ; .
000000r 2               TOK_DOTDOT      = $23           ; ..
000000r 2               TOK_CARET       = $24           ; ^
000000r 2               
000000r 2               ; Keywords
000000r 2               TOK_AND         = $40
000000r 2               TOK_ARRAY       = $41
000000r 2               TOK_BEGIN       = $42
000000r 2               TOK_CASE        = $43
000000r 2               TOK_CONST       = $44
000000r 2               TOK_DIV         = $45
000000r 2               TOK_DO          = $46
000000r 2               TOK_DOWNTO      = $47
000000r 2               TOK_ELSE        = $48
000000r 2               TOK_END         = $49
000000r 2               TOK_FOR         = $4A
000000r 2               TOK_FUNCTION    = $4B
000000r 2               TOK_IF          = $4C
000000r 2               TOK_MOD_KW      = $4D
000000r 2               TOK_NIL         = $4E
000000r 2               TOK_NOT         = $4F
000000r 2               TOK_OF          = $50
000000r 2               TOK_OR          = $51
000000r 2               TOK_PROCEDURE   = $52
000000r 2               TOK_PROGRAM     = $53
000000r 2               TOK_RECORD      = $54
000000r 2               TOK_REPEAT      = $55
000000r 2               TOK_THEN        = $56
000000r 2               TOK_TO          = $57
000000r 2               TOK_TYPE        = $58
000000r 2               TOK_UNTIL       = $59
000000r 2               TOK_VAR         = $5A
000000r 2               TOK_WHILE       = $5B
000000r 2               TOK_WITH        = $5C
000000r 2               
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               ; Useful macros
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               
000000r 2               ; Call PEM with function number in X
000000r 2               .macro PEM func
000000r 2                       ldx     #func
000000r 2                       jsr     PEM_ENTRY
000000r 2               .endmacro
000000r 2               
000000r 1                       .include        "ZEROPAGE.ASM"
000000r 2               ; zeropage.asm — zero-page variable layout for PASCAL.COM and PRUN.COM
000000r 2               ;
000000r 2               ; Avoid $00-$2F (DOS/65 system), $32 (FARFUNCT), $39-$3A (DOS/65).
000000r 2               ; Safe range: $50-$EF
000000r 2               
000000r 2                       .segment        "ZEROPAGE"
000000r 2               
000000r 2  xx xx xx xx          .RES    $50             ; skip $00-$4F (DOS/65 system zero page)
000004r 2  xx xx xx xx  
000008r 2  xx xx xx xx  
000050r 2               
000050r 2               ; ---------------------------------------------------------------------------
000050r 2               ; P-machine registers — start at $50 as noted in comments below
000050r 2               ; ---------------------------------------------------------------------------
000050r 2               
000050r 2               pm_ipc:
000050r 2  xx xx                .RES    2               ; $50-$51  interpreter program counter
000052r 2               pm_sp:
000052r 2  xx xx                .RES    2               ; $52-$53  p-machine stack pointer
000054r 2               pm_mp:
000054r 2  xx xx                .RES    2               ; $54-$55  mark/frame pointer
000056r 2               pm_base:
000056r 2  xx xx                .RES    2               ; $56-$57  global variable base
000058r 2               pm_np:
000058r 2  xx xx                .RES    2               ; $58-$59  heap top (grows downward)
00005Ar 2               
00005Ar 2               ; General-purpose temporaries
00005Ar 2               tmp0:
00005Ar 2  xx xx                .RES    2               ; $5A-$5B
00005Cr 2               tmp1:
00005Cr 2  xx xx                .RES    2               ; $5C-$5D
00005Er 2               tmp2:
00005Er 2  xx xx                .RES    2               ; $5E-$5F
000060r 2               tmp3:
000060r 2  xx xx                .RES    2               ; $60-$61
000062r 2               
000062r 2               ; Byte-width scratch (often used by macros)
000062r 2               scratch:
000062r 2  xx                   .RES    1               ; $62
000063r 2               
000063r 2               ; ---------------------------------------------------------------------------
000063r 2               ; Compiler-specific zero-page variables (only used by PASCAL.COM)
000063r 2               ; ---------------------------------------------------------------------------
000063r 2               
000063r 2               ; Lexer state
000063r 2               lex_line:
000063r 2  xx xx                .RES    2               ; $63-$64  current source line number
000065r 2               lex_col:
000065r 2  xx                   .RES    1               ; $65      current column
000066r 2               lex_char:
000066r 2  xx                   .RES    1               ; $66      lookahead character
000067r 2               tok_type:
000067r 2  xx                   .RES    1               ; $67      current token type
000068r 2               tok_ival_lo:
000068r 2  xx                   .RES    1               ; $68      integer token value (lo)
000069r 2               tok_ival_hi:
000069r 2  xx                   .RES    1               ; $69      integer token value (hi)
00006Ar 2               
00006Ar 2               ; Parser / code generator state
00006Ar 2               cg_pc:
00006Ar 2  xx xx                .RES    2               ; $6A-$6B  current emit offset into code buffer
00006Cr 2               cg_globals:
00006Cr 2  xx xx                .RES    2               ; $6C-$6D  next available global variable offset
00006Er 2               scope_depth:
00006Er 2  xx                   .RES    1               ; $6E      current lexical nesting depth (0=global)
00006Fr 2               sym_chain:
00006Fr 2  xx xx                .RES    2               ; $6F-$70  pointer into symbol table chain
000071r 2               
000071r 2               ; FCB pointers (compiler I/O)
000071r 2               src_fcb:
000071r 2  xx xx                .RES    2               ; $71-$72  pointer to source FCB
000073r 2               out_fcb:
000073r 2  xx xx                .RES    2               ; $73-$74  pointer to output FCB
000075r 2               src_buf_pos:
000075r 2  xx                   .RES    1               ; $75      position within 128-byte sector buffer
000076r 2               src_buf_end:
000076r 2  xx                   .RES    1               ; $76      bytes valid in sector buffer
000077r 2               
000077r 2               ; FOR-loop scratch (parse_for; not nestable)
000077r 2               for_loop_top:
000077r 2  xx xx                .RES    2               ; $77-$78  cg_pc of loop test (back-jump target)
000079r 2               for_patch:
000079r 2  xx xx                .RES    2               ; $79-$7A  FJP exit patch address
00007Br 2               
00007Br 2               ; Result type of the most recently parsed expression (TY_INT/TY_CHAR/
00007Br 2               ; TY_BOOL/TY_STRING/etc.).  Used by parse_write_args to dispatch the
00007Br 2               ; right WRIT* opcode.  Set by parse_factor / parse_simple_expr /
00007Br 2               ; parse_expression as each rule produces its result.
00007Br 2               expr_type:
00007Br 2  xx                   .RES    1               ; $7B
00007Cr 2               
00007Cr 1               
00007Cr 1               ; ---------------------------------------------------------------------------
00007Cr 1               ; FCBs and file buffers
00007Cr 1               ; ---------------------------------------------------------------------------
00007Cr 1                       .segment        "CPMDATA"
000000r 1               
000000r 1               comp_src_fcb:
000000r 1  xx xx xx xx          .RES    36              ; source file FCB (.PAS)
000004r 1  xx xx xx xx  
000008r 1  xx xx xx xx  
000024r 1               comp_out_fcb:
000024r 1  xx xx xx xx          .RES    36              ; output file FCB (.PCD)
000028r 1  xx xx xx xx  
00002Cr 1  xx xx xx xx  
000048r 1               
000048r 1               ; 128-byte sector buffer for source reads
000048r 1               src_sector:
000048r 1  xx xx xx xx          .RES    128
00004Cr 1  xx xx xx xx  
000050r 1  xx xx xx xx  
0000C8r 1               
0000C8r 1               ; Comma-list buffer for parse_var_decls — collects names "A, B, C" before
0000C8r 1               ; the type is known so each can be added to the symbol table with the
0000C8r 1               ; same type code.  8 slots × 16 bytes; excess names are silently dropped.
0000C8r 1               var_name_count:
0000C8r 1  xx                   .RES    1
0000C9r 1               var_name_buf:
0000C9r 1  xx xx xx xx          .RES    128
0000CDr 1  xx xx xx xx  
0000D1r 1  xx xx xx xx  
000149r 1               
000149r 1               ; Field table for RECORD types.  32 entries × 16 bytes each:
000149r 1               ;   [0]    field name length (1-12)
000149r 1               ;   [1-12] field name chars (uppercase, padded with spaces)
000149r 1               ;   [13]   byte offset within the record
000149r 1               ;   [14]   field data type (TY_INT/TY_CHAR/TY_BOOL)
000149r 1               ;   [15]   reserved
000149r 1               field_table_count:
000149r 1  xx                   .RES    1
00014Ar 1               field_table:
00014Ar 1  xx xx xx xx          .RES    512             ; 32 entries × 16 bytes
00014Er 1  xx xx xx xx  
000152r 1  xx xx xx xx  
00034Ar 1               
00034Ar 1               ; Code generation buffer — p-code accumulates here until file write
00034Ar 1               ; Overlaps the CPMDATA area above $2400 after FCBs.
00034Ar 1               ; This holds up to ~32KB of generated p-code.
00034Ar 1               CODEBUF_BASE    = $3000
00034Ar 1               CODEBUF_MAXSZ   = $8000         ; 32 KB
00034Ar 1               
00034Ar 1               ; Symbol table area
00034Ar 1               SYMTAB_BASE     = $8000
00034Ar 1               SYMTAB_MAXSZ    = $1800         ; 6 KB (≈200 entries at ~30 bytes each)
00034Ar 1               
00034Ar 1               ; String pool for identifier strings and string literals
00034Ar 1               STRPOOL_BASE    = $9800
00034Ar 1               STRPOOL_MAXSZ   = $0800         ; 2 KB
00034Ar 1               
00034Ar 1               ; ---------------------------------------------------------------------------
00034Ar 1               ; Entry point
00034Ar 1               ; ---------------------------------------------------------------------------
00034Ar 1                       .segment        "TEA"
000000r 1               
000000r 1  4C rr rr             JMP     pascal_main
000003r 1               
000003r 1                       .segment        "CODE"
000000r 1               
000000r 1               pascal_main:
000000r 1               ; print banner
000000r 1  A9 rr                LDA     #<msg_banner
000002r 1  85 rr                STA     tmp0
000004r 1  A9 rr                LDA     #>msg_banner
000006r 1  85 rr                STA     tmp0+1
000008r 1  20 rr rr             JSR     console_print_sz
00000Br 1               
00000Br 1               ; build source FCB from DEFAULT_FCB ($0107) argument
00000Br 1  20 rr rr             JSR     build_src_fcb
00000Er 1  90 03                BCC     :+
000010r 1  4C rr rr             JMP     @no_file
000013r 1               :
000013r 1               ; print "Compiling: <name>"
000013r 1  A9 rr                LDA     #<msg_compiling
000015r 1  85 rr                STA     tmp0
000017r 1  A9 rr                LDA     #>msg_compiling
000019r 1  85 rr                STA     tmp0+1
00001Br 1  20 rr rr             JSR     console_print_sz
00001Er 1               
00001Er 1               ; open source file
00001Er 1  A9 rr                LDA     #<comp_src_fcb
000020r 1  85 rr                STA     src_fcb
000022r 1  A9 rr                LDA     #>comp_src_fcb
000024r 1  85 rr                STA     src_fcb+1
000026r 1  A9 rr                LDA     #<comp_src_fcb
000028r 1  85 rr                STA     tmp1
00002Ar 1  A9 rr                LDA     #>comp_src_fcb
00002Cr 1  85 rr                STA     tmp1+1
00002Er 1  20 rr rr             JSR     file_open
000031r 1  C9 FF                CMP     #$FF            ; PEM open: $FF=not found, 0-3=dir entry
000033r 1  D0 03                BNE     :+
000035r 1  4C rr rr             JMP     @no_file
000038r 1               :
000038r 1               
000038r 1               ; create output .PCD file
000038r 1  20 rr rr             JSR     build_out_fcb
00003Br 1  A9 rr                LDA     #<comp_out_fcb
00003Dr 1  85 rr                STA     tmp1
00003Fr 1  A9 rr                LDA     #>comp_out_fcb
000041r 1  85 rr                STA     tmp1+1
000043r 1  20 rr rr             JSR     file_make
000046r 1  C9 FF                CMP     #$FF            ; PEM make: $FF=dir full, 0-3=dir entry
000048r 1  D0 03                BNE     :+
00004Ar 1  4C rr rr             JMP     @out_err
00004Dr 1               :
00004Dr 1               
00004Dr 1               ; initialise compiler state
00004Dr 1  20 rr rr             JSR     compiler_init
000050r 1               
000050r 1               ; run compilation
000050r 1  20 rr rr             JSR     compile_program
000053r 1               
000053r 1               ; write .PCD file
000053r 1  20 rr rr             JSR     write_pcd
000056r 1               
000056r 1               ; close files
000056r 1  A9 rr                LDA     #<comp_src_fcb
000058r 1  85 rr                STA     tmp1
00005Ar 1  A9 rr                LDA     #>comp_src_fcb
00005Cr 1  85 rr                STA     tmp1+1
00005Er 1  20 rr rr             JSR     file_close
000061r 1  A9 rr                LDA     #<comp_out_fcb
000063r 1  85 rr                STA     tmp1
000065r 1  A9 rr                LDA     #>comp_out_fcb
000067r 1  85 rr                STA     tmp1+1
000069r 1  20 rr rr             JSR     file_close
00006Cr 1               
00006Cr 1               ; print result
00006Cr 1  AD rr rr             LDA     error_count
00006Fr 1  0D rr rr             ORA     error_count+1
000072r 1  D0 0E                BNE     @had_errors
000074r 1  A9 rr                LDA     #<msg_ok
000076r 1  85 rr                STA     tmp0
000078r 1  A9 rr                LDA     #>msg_ok
00007Ar 1  85 rr                STA     tmp0+1
00007Cr 1  20 rr rr             JSR     console_print_sz
00007Fr 1  4C 00 01             JMP     WARM_BOOT
000082r 1               
000082r 1               @had_errors:
000082r 1  AD rr rr             LDA     error_count
000085r 1  85 rr                STA     tmp0
000087r 1  AD rr rr             LDA     error_count+1
00008Ar 1  85 rr                STA     tmp0+1
00008Cr 1  20 rr rr             JSR     console_print_dec
00008Fr 1  A9 rr                LDA     #<msg_errors
000091r 1  85 rr                STA     tmp0
000093r 1  A9 rr                LDA     #>msg_errors
000095r 1  85 rr                STA     tmp0+1
000097r 1  20 rr rr             JSR     console_print_sz
00009Ar 1  4C 00 01             JMP     WARM_BOOT
00009Dr 1               
00009Dr 1               @no_file:
00009Dr 1  A9 rr                LDA     #<err_nofile
00009Fr 1  85 rr                STA     tmp0
0000A1r 1  A9 rr                LDA     #>err_nofile
0000A3r 1  85 rr                STA     tmp0+1
0000A5r 1  20 rr rr             JSR     console_print_sz
0000A8r 1  4C 00 01             JMP     WARM_BOOT
0000ABr 1               
0000ABr 1               @out_err:
0000ABr 1  A9 rr                LDA     #<err_outfile
0000ADr 1  85 rr                STA     tmp0
0000AFr 1  A9 rr                LDA     #>err_outfile
0000B1r 1  85 rr                STA     tmp0+1
0000B3r 1  20 rr rr             JSR     console_print_sz
0000B6r 1  4C 00 01             JMP     WARM_BOOT
0000B9r 1               
0000B9r 1               ; ---------------------------------------------------------------------------
0000B9r 1               ; build_src_fcb — populate comp_src_fcb from DEFAULT_FCB ($0107), force ".PAS"
0000B9r 1               ; DOS/65 CCM copies the parsed argument FCB to dflfcb=$0107, not $005C.
0000B9r 1               ; Returns: carry clear = ok, carry set = no filename
0000B9r 1               ; ---------------------------------------------------------------------------
0000B9r 1               build_src_fcb:
0000B9r 1  A2 00                LDX     #0
0000BBr 1               @copy:
0000BBr 1  BD 07 01             LDA     DEFAULT_FCB,x
0000BEr 1  9D rr rr             STA     comp_src_fcb,x
0000C1r 1  E8                   INX
0000C2r 1  E0 0C                CPX     #12
0000C4r 1  90 F5                BCC     @copy
0000C6r 1  A9 00                LDA     #0
0000C8r 1               @zero:
0000C8r 1  9D rr rr             STA     comp_src_fcb,x
0000CBr 1  E8                   INX
0000CCr 1  E0 24                CPX     #36
0000CEr 1  90 F8                BCC     @zero
0000D0r 1  AD rr rr             LDA     comp_src_fcb+1
0000D3r 1  C9 20                CMP     #' '
0000D5r 1  F0 11                BEQ     @noname
0000D7r 1  A9 50                LDA     #'P'
0000D9r 1  8D rr rr             STA     comp_src_fcb+9
0000DCr 1  A9 41                LDA     #'A'
0000DEr 1  8D rr rr             STA     comp_src_fcb+10
0000E1r 1  A9 53                LDA     #'S'
0000E3r 1  8D rr rr             STA     comp_src_fcb+11
0000E6r 1  18                   CLC
0000E7r 1  60                   RTS
0000E8r 1               @noname:
0000E8r 1  38                   SEC
0000E9r 1  60                   RTS
0000EAr 1               
0000EAr 1               ; ---------------------------------------------------------------------------
0000EAr 1               ; build_out_fcb — copy filename from comp_src_fcb, change extension to "PCD"
0000EAr 1               ; ---------------------------------------------------------------------------
0000EAr 1               build_out_fcb:
0000EAr 1  A2 00                LDX     #0
0000ECr 1               @copy:
0000ECr 1  BD rr rr             LDA     comp_src_fcb,x
0000EFr 1  9D rr rr             STA     comp_out_fcb,x
0000F2r 1  E8                   INX
0000F3r 1  E0 24                CPX     #36
0000F5r 1  90 F5                BCC     @copy
0000F7r 1  A9 50                LDA     #'P'
0000F9r 1  8D rr rr             STA     comp_out_fcb+9
0000FCr 1  A9 43                LDA     #'C'
0000FEr 1  8D rr rr             STA     comp_out_fcb+10
000101r 1  A9 44                LDA     #'D'
000103r 1  8D rr rr             STA     comp_out_fcb+11
000106r 1  60                   RTS
000107r 1               
000107r 1               ; ---------------------------------------------------------------------------
000107r 1               ; compiler_init — zero-out compiler state
000107r 1               ; ---------------------------------------------------------------------------
000107r 1               error_count:
000107r 1  00 00                .WORD   0
000109r 1               
000109r 1               compiler_init:
000109r 1  A9 00                LDA     #0
00010Br 1  8D rr rr             STA     error_count
00010Er 1  8D rr rr             STA     error_count+1
000111r 1               ; IPC starts at 0 (offset into code buffer)
000111r 1  85 rr                STA     cg_pc
000113r 1  85 rr                STA     cg_pc+1
000115r 1               ; globals start at 0
000115r 1  85 rr                STA     cg_globals
000117r 1  85 rr                STA     cg_globals+1
000119r 1               ; scope depth 0 = global
000119r 1  85 rr                STA     scope_depth
00011Br 1               ; main entry-point patch slot — sentinel hi byte = $FF means "none/done"
00011Br 1  A9 FF                LDA     #$FF
00011Dr 1  8D rr rr             STA     main_jmp_patch+1
000120r 1               ; init lexer and prime first token
000120r 1  20 rr rr             JSR     lexer_init
000123r 1  20 rr rr             JSR     next_token
000126r 1  60                   RTS
000127r 1               
000127r 1               ; ---------------------------------------------------------------------------
000127r 1               ; compile_error — print error with line/col; increment error_count
000127r 1               ; tmp0 = pointer to error string
000127r 1               ; ---------------------------------------------------------------------------
000127r 1               compile_error:
000127r 1               ; save caller's message pointer (tmp0) into tmp3
000127r 1  A5 rr                LDA     tmp0
000129r 1  85 rr                STA     tmp3
00012Br 1  A5 rr                LDA     tmp0+1
00012Dr 1  85 rr                STA     tmp3+1
00012Fr 1               ; print "Line "
00012Fr 1  A9 rr                LDA     #<msg_line
000131r 1  85 rr                STA     tmp0
000133r 1  A9 rr                LDA     #>msg_line
000135r 1  85 rr                STA     tmp0+1
000137r 1  20 rr rr             JSR     console_print_sz
00013Ar 1               ; print line number
00013Ar 1  A5 rr                LDA     lex_line
00013Cr 1  85 rr                STA     tmp0
00013Er 1  A5 rr                LDA     lex_line+1
000140r 1  85 rr                STA     tmp0+1
000142r 1  20 rr rr             JSR     console_print_dec
000145r 1               ; print ": "
000145r 1  A9 3A                LDA     #':'
000147r 1  A2 02                LDX     #PEM_CONOUT
000149r 1  20 03 01             JSR     PEM_ENTRY
00014Cr 1  A9 20                LDA     #' '
00014Er 1  A2 02                LDX     #PEM_CONOUT
000150r 1  20 03 01             JSR     PEM_ENTRY
000153r 1               ; print the error message text
000153r 1  A5 rr                LDA     tmp3
000155r 1  85 rr                STA     tmp0
000157r 1  A5 rr                LDA     tmp3+1
000159r 1  85 rr                STA     tmp0+1
00015Br 1  20 rr rr             JSR     console_print_sz
00015Er 1  20 rr rr             JSR     console_newline
000161r 1               ; increment error count
000161r 1  EE rr rr             INC     error_count
000164r 1  D0 03                BNE     :+
000166r 1  EE rr rr             INC     error_count+1
000169r 1               :
000169r 1  60                   RTS
00016Ar 1               
00016Ar 1               ; ---------------------------------------------------------------------------
00016Ar 1               ; write_pcd — write .PCD header + entire code buffer to output file
00016Ar 1               ;   Sector 0:        12-byte header  + first 116 bytes of code  (padded)
00016Ar 1               ;   Sectors 1..N-1:  128 bytes of code each                     (last padded)
00016Ar 1               ;
00016Ar 1               ; Uses tmp0 = source pointer (into CODEBUF_BASE),
00016Ar 1               ;      tmp3 = bytes remaining to write,
00016Ar 1               ;      tmp1 = FCB pointer (re-loaded before each file_write_sector).
00016Ar 1               ; ---------------------------------------------------------------------------
00016Ar 1               write_pcd:
00016Ar 1               ; --- src_ptr = CODEBUF_BASE; remaining = cg_pc ---
00016Ar 1  A9 00                LDA     #<CODEBUF_BASE
00016Cr 1  85 rr                STA     tmp0
00016Er 1  A9 30                LDA     #>CODEBUF_BASE
000170r 1  85 rr                STA     tmp0+1
000172r 1  A5 rr                LDA     cg_pc
000174r 1  85 rr                STA     tmp3
000176r 1  A5 rr                LDA     cg_pc+1
000178r 1  85 rr                STA     tmp3+1
00017Ar 1               
00017Ar 1               ; --- header bytes 0..11 directly into DMA_BUF ---
00017Ar 1  A9 50                LDA     #PCD_MAGIC_0
00017Cr 1  8D 28 01             STA     DMA_BUF+0
00017Fr 1  A9 43                LDA     #PCD_MAGIC_1
000181r 1  8D 29 01             STA     DMA_BUF+1
000184r 1  A9 01                LDA     #PCD_VERSION
000186r 1  8D 2A 01             STA     DMA_BUF+2
000189r 1  A9 00                LDA     #0
00018Br 1  8D 2B 01             STA     DMA_BUF+3
00018Er 1  A5 rr                LDA     cg_pc
000190r 1  8D 2C 01             STA     DMA_BUF+PCD_CODESZ
000193r 1  A5 rr                LDA     cg_pc+1
000195r 1  8D 2D 01             STA     DMA_BUF+PCD_CODESZ+1
000198r 1  A5 rr                LDA     cg_globals
00019Ar 1  8D 2E 01             STA     DMA_BUF+PCD_GLOBSZ
00019Dr 1  A5 rr                LDA     cg_globals+1
00019Fr 1  8D 2F 01             STA     DMA_BUF+PCD_GLOBSZ+1
0001A2r 1  A9 00                LDA     #0
0001A4r 1  8D 30 01             STA     DMA_BUF+PCD_STRSZ
0001A7r 1  8D 31 01             STA     DMA_BUF+PCD_STRSZ+1
0001AAr 1  8D 32 01             STA     DMA_BUF+PCD_ENTRY
0001ADr 1  8D 33 01             STA     DMA_BUF+PCD_ENTRY+1
0001B0r 1               
0001B0r 1               ; --- first sector: copy code into DMA_BUF[12..127] ---
0001B0r 1  A0 00                LDY     #0              ; src offset within this batch
0001B2r 1  A2 0C                LDX     #PCD_HEADER_SZ  ; dest offset in DMA
0001B4r 1               @fill1:
0001B4r 1  E0 80                CPX     #128
0001B6r 1  B0 23                BCS     @write1
0001B8r 1  A5 rr                LDA     tmp3
0001BAr 1  05 rr                ORA     tmp3+1
0001BCr 1  F0 11                BEQ     @pad1
0001BEr 1  B1 rr                LDA     (tmp0),y
0001C0r 1  9D 28 01             STA     DMA_BUF,x
0001C3r 1  E8                   INX
0001C4r 1  C8                   INY
0001C5r 1               ; remaining--
0001C5r 1  A5 rr                LDA     tmp3
0001C7r 1  D0 02                BNE     :+
0001C9r 1  C6 rr                DEC     tmp3+1
0001CBr 1               :
0001CBr 1  C6 rr                DEC     tmp3
0001CDr 1  80 E5                BRA     @fill1
0001CFr 1               @pad1:
0001CFr 1  E0 80                CPX     #128
0001D1r 1  B0 08                BCS     @write1
0001D3r 1  A9 00                LDA     #0
0001D5r 1  9D 28 01             STA     DMA_BUF,x
0001D8r 1  E8                   INX
0001D9r 1  80 F4                BRA     @pad1
0001DBr 1               @write1:
0001DBr 1               ; advance src by Y (bytes consumed from this batch)
0001DBr 1  84 rr                STY     scratch
0001DDr 1  18                   CLC
0001DEr 1  A5 rr                LDA     tmp0
0001E0r 1  65 rr                ADC     scratch
0001E2r 1  85 rr                STA     tmp0
0001E4r 1  90 02                BCC     :+
0001E6r 1  E6 rr                INC     tmp0+1
0001E8r 1               :
0001E8r 1  A9 rr                LDA     #<comp_out_fcb
0001EAr 1  85 rr                STA     tmp1
0001ECr 1  A9 rr                LDA     #>comp_out_fcb
0001EEr 1  85 rr                STA     tmp1+1
0001F0r 1  20 rr rr             JSR     file_write_sector
0001F3r 1               
0001F3r 1               ; --- additional sectors (full 128 bytes each, last pad with 0) ---
0001F3r 1               @next_sec:
0001F3r 1  A5 rr                LDA     tmp3
0001F5r 1  05 rr                ORA     tmp3+1
0001F7r 1  F0 42                BEQ     @done
0001F9r 1  A0 00                LDY     #0
0001FBr 1               @fill2:
0001FBr 1  C0 80                CPY     #128
0001FDr 1  B0 22                BCS     @write2
0001FFr 1  A5 rr                LDA     tmp3
000201r 1  05 rr                ORA     tmp3+1
000203r 1  F0 10                BEQ     @pad2
000205r 1  B1 rr                LDA     (tmp0),y
000207r 1  99 28 01             STA     DMA_BUF,y
00020Ar 1  C8                   INY
00020Br 1  A5 rr                LDA     tmp3
00020Dr 1  D0 02                BNE     :+
00020Fr 1  C6 rr                DEC     tmp3+1
000211r 1               :
000211r 1  C6 rr                DEC     tmp3
000213r 1  80 E6                BRA     @fill2
000215r 1               @pad2:
000215r 1  C0 80                CPY     #128
000217r 1  B0 08                BCS     @write2
000219r 1  A9 00                LDA     #0
00021Br 1  99 28 01             STA     DMA_BUF,y
00021Er 1  C8                   INY
00021Fr 1  80 F4                BRA     @pad2
000221r 1               @write2:
000221r 1               ; advance src by 128 (Y is the count copied from src this sector;
000221r 1               ; padded bytes at the tail are not source bytes, but remaining is
000221r 1               ; already 0 in that case and the loop will exit).
000221r 1  84 rr                STY     scratch
000223r 1  18                   CLC
000224r 1  A5 rr                LDA     tmp0
000226r 1  65 rr                ADC     scratch
000228r 1  85 rr                STA     tmp0
00022Ar 1  90 02                BCC     :+
00022Cr 1  E6 rr                INC     tmp0+1
00022Er 1               :
00022Er 1  A9 rr                LDA     #<comp_out_fcb
000230r 1  85 rr                STA     tmp1
000232r 1  A9 rr                LDA     #>comp_out_fcb
000234r 1  85 rr                STA     tmp1+1
000236r 1  20 rr rr             JSR     file_write_sector
000239r 1  80 B8                BRA     @next_sec
00023Br 1               @done:
00023Br 1  60                   RTS
00023Cr 1               
00023Cr 1               ; ---------------------------------------------------------------------------
00023Cr 1               ; Include sub-modules (compiler phases)
00023Cr 1               ; ---------------------------------------------------------------------------
00023Cr 1                       .include        "LEXER.ASM"
00023Cr 2               .PC02
00023Cr 2               ; lexer.asm — Pascal tokenizer
00023Cr 2               ;
00023Cr 2               ; Reads source file through 128-byte sector buffer.
00023Cr 2               ; Produces token stream via next_token (sets tok_type + value vars in ZP).
00023Cr 2               
00023Cr 2               ; ---------------------------------------------------------------------------
00023Cr 2               ; Keyword table — each entry: length byte, ASCII chars, token code
00023Cr 2               ; Searched linearly; 18 keywords.
00023Cr 2               ; ---------------------------------------------------------------------------
00023Cr 2                       .segment        "CODE"
00023Cr 2               
00023Cr 2               keyword_table:
00023Cr 2               ; length, chars..., token
00023Cr 2  03 41 4E 44          .BYTE   3, "AND",       TOK_AND
000240r 2  40           
000241r 2  05 41 52 52          .BYTE   5, "ARRAY",     TOK_ARRAY
000245r 2  41 59 41     
000248r 2  05 42 45 47          .BYTE   5, "BEGIN",     TOK_BEGIN
00024Cr 2  49 4E 42     
00024Fr 2  04 43 41 53          .BYTE   4, "CASE",      TOK_CASE
000253r 2  45 43        
000255r 2  05 43 4F 4E          .BYTE   5, "CONST",     TOK_CONST
000259r 2  53 54 44     
00025Cr 2  03 44 49 56          .BYTE   3, "DIV",       TOK_DIV
000260r 2  45           
000261r 2  02 44 4F 46          .BYTE   2, "DO",        TOK_DO
000265r 2  06 44 4F 57          .BYTE   6, "DOWNTO",    TOK_DOWNTO
000269r 2  4E 54 4F 47  
00026Dr 2  04 45 4C 53          .BYTE   4, "ELSE",      TOK_ELSE
000271r 2  45 48        
000273r 2  03 45 4E 44          .BYTE   3, "END",       TOK_END
000277r 2  49           
000278r 2  03 46 4F 52          .BYTE   3, "FOR",       TOK_FOR
00027Cr 2  4A           
00027Dr 2  08 46 55 4E          .BYTE   8, "FUNCTION",  TOK_FUNCTION
000281r 2  43 54 49 4F  
000285r 2  4E 4B        
000287r 2  02 49 46 4C          .BYTE   2, "IF",        TOK_IF
00028Br 2  03 4D 4F 44          .BYTE   3, "MOD",       TOK_MOD_KW
00028Fr 2  4D           
000290r 2  03 4E 49 4C          .BYTE   3, "NIL",       TOK_NIL
000294r 2  4E           
000295r 2  03 4E 4F 54          .BYTE   3, "NOT",       TOK_NOT
000299r 2  4F           
00029Ar 2  02 4F 46 50          .BYTE   2, "OF",        TOK_OF
00029Er 2  02 4F 52 51          .BYTE   2, "OR",        TOK_OR
0002A2r 2  09 50 52 4F          .BYTE   9, "PROCEDURE", TOK_PROCEDURE
0002A6r 2  43 45 44 55  
0002AAr 2  52 45 52     
0002ADr 2  07 50 52 4F          .BYTE   7, "PROGRAM",   TOK_PROGRAM
0002B1r 2  47 52 41 4D  
0002B5r 2  53           
0002B6r 2  06 52 45 43          .BYTE   6, "RECORD",    TOK_RECORD
0002BAr 2  4F 52 44 54  
0002BEr 2  06 52 45 50          .BYTE   6, "REPEAT",    TOK_REPEAT
0002C2r 2  45 41 54 55  
0002C6r 2  04 54 48 45          .BYTE   4, "THEN",      TOK_THEN
0002CAr 2  4E 56        
0002CCr 2  02 54 4F 57          .BYTE   2, "TO",        TOK_TO
0002D0r 2  04 54 59 50          .BYTE   4, "TYPE",      TOK_TYPE
0002D4r 2  45 58        
0002D6r 2  05 55 4E 54          .BYTE   5, "UNTIL",     TOK_UNTIL
0002DAr 2  49 4C 59     
0002DDr 2  03 56 41 52          .BYTE   3, "VAR",       TOK_VAR
0002E1r 2  5A           
0002E2r 2  05 57 48 49          .BYTE   5, "WHILE",     TOK_WHILE
0002E6r 2  4C 45 5B     
0002E9r 2  04 57 49 54          .BYTE   4, "WITH",      TOK_WITH
0002EDr 2  48 5C        
0002EFr 2  00                   .BYTE   0               ; sentinel
0002F0r 2               
0002F0r 2               ; Identifier buffer (max 63 chars + length byte at [0])
0002F0r 2               ident_buf:
0002F0r 2  xx xx xx xx          .RES    64
0002F4r 2  xx xx xx xx  
0002F8r 2  xx xx xx xx  
000330r 2               
000330r 2               ; Saved-name buffer for parser (e.g. var-decl name preservation across
000330r 2               ; parse_type_spec which clobbers ident_buf).
000330r 2               save_name_buf:
000330r 2  xx xx xx xx          .RES    16
000334r 2  xx xx xx xx  
000338r 2  xx xx xx xx  
000340r 2               
000340r 2               ; Saved symbol info — used by parse_assign_or_call to preserve symbol
000340r 2               ; entry fields across next_token + parse_expression, which clobber tmp3.
000340r 2               sym_save_kind:
000340r 2  xx                   .RES    1
000341r 2               sym_save_type:
000341r 2  xx                   .RES    1               ; SYM entry offset 17 (data type: TY_*)
000342r 2               sym_save_scope:
000342r 2  xx                   .RES    1
000343r 2               sym_save_off:
000343r 2  xx xx                .RES    2
000345r 2               sym_save_pcount:
000345r 2  xx                   .RES    1                       ; SYM_PROC param count (entry offset 21)
000346r 2               sym_save_vmask:
000346r 2  xx                   .RES    1               ; SYM_PROC/SYM_FUNC VAR-param bitmap (entry offset 22)
000347r 2               sym_save_lsize:
000347r 2  xx                   .RES    1               ; SYM_PROC/SYM_FUNC total local-area size (entry offset 23)
000348r 2               
000348r 2               ; ARRAY type scratch — set by parse_type_spec when it parses an ARRAY type;
000348r 2               ; read by parse_var_decls to compute storage size and adjusted offset.
000348r 2               array_lo:
000348r 2  xx xx                .RES    2               ; lower bound (signed word)
00034Ar 2               array_hi:
00034Ar 2  xx xx                .RES    2               ; upper bound (signed word)
00034Cr 2               array_elem_ty:
00034Cr 2  xx                   .RES    1               ; element base type (TY_INT, TY_CHAR, TY_BOOL …)
00034Dr 2               
00034Dr 2               ; RECORD type scratch — set by parse_type_spec when it parses a RECORD type
00034Dr 2               ; (or resolves a TYPE alias of a RECORD).  Read by parse_var_decls and by
00034Dr 2               ; parse_type_decls to copy into the new SYM_VAR/SYM_TYPE entry.
00034Dr 2               record_size:
00034Dr 2  xx xx                .RES    2               ; total record size in bytes
00034Fr 2               record_first_field:
00034Fr 2  xx                   .RES    1               ; index of first field in field_table
000350r 2               record_field_count:
000350r 2  xx                   .RES    1               ; number of fields in this record
000351r 2               
000351r 2               ; Procedure-declaration scratch (parse_proc_decl; not nestable in this build).
000351r 2               proc_param_count:
000351r 2  xx                   .RES    1               ; running count while parsing param list
000352r 2               proc_entry_idx:
000352r 2  xx xx                .RES    2               ; symtab index of the proc entry (for backpatch)
000354r 2               param_var_mask:
000354r 2  xx                   .RES    1               ; bitmap of which params are VAR (bit i ↔ param i, max 8)
000355r 2               group_is_var:
000355r 2  xx                   .RES    1               ; 1 while parsing the names of a VAR-prefixed group
000356r 2               local_alloc_off:
000356r 2  xx                   .RES    1               ; next free local-AR offset; init = pcount*2 at proc entry
000357r 2               
000357r 2               ; Function-call scratch (parse_factor @sym_func_call; nested fn calls in args
000357r 2               ; not yet supported — see TODO).
000357r 2               fcall_pcount:
000357r 2  xx                   .RES    1
000358r 2               fcall_lo:
000358r 2  xx                   .RES    1
000359r 2               fcall_hi:
000359r 2  xx                   .RES    1
00035Ar 2               fcall_type:
00035Ar 2  xx                   .RES    1
00035Br 2               fcall_vmask:
00035Br 2  xx                   .RES    1               ; the called proc/func's VAR-param bitmap
00035Cr 2               fcall_lsize:
00035Cr 2  xx                   .RES    1               ; the called proc/func's total local-area size (params+locals)
00035Dr 2               
00035Dr 2               ; Main-program entry-point patch slot. compile_program emits a UJP at code
00035Dr 2               ; offset 0; parse_block patches it when it reaches the top-level BEGIN block
00035Dr 2               ; so the main body executes first (and proc bodies are reached only via CALL).
00035Dr 2               ; Hi byte = $FF means "already patched" (sentinel — never a valid patch addr
00035Dr 2               ; since cg_pc starts at 0).
00035Dr 2               main_jmp_patch:
00035Dr 2  xx xx                .RES    2
00035Fr 2               
00035Fr 2               ; ---------------------------------------------------------------------------
00035Fr 2               ; lexer_init — reset lexer state; call before compile_program
00035Fr 2               ; ---------------------------------------------------------------------------
00035Fr 2               lexer_init:
00035Fr 2  A9 01                LDA     #1
000361r 2  85 rr                STA     lex_line
000363r 2  A9 00                LDA     #0
000365r 2  85 rr                STA     lex_line+1
000367r 2  85 rr                STA     lex_col
000369r 2  85 rr                STA     src_buf_pos
00036Br 2  85 rr                STA     src_buf_end
00036Dr 2               ; prime lex_char
00036Dr 2  20 rr rr             JSR     lexer_getc
000370r 2  60                   RTS
000371r 2               
000371r 2               ; ---------------------------------------------------------------------------
000371r 2               ; next_token — advance to next token, set tok_type
000371r 2               ; On return:
000371r 2               ;   tok_type  = token code
000371r 2               ;   tok_ival  = integer value (if TOK_INT)
000371r 2               ;   ident_buf = identifier string (if TOK_IDENT)
000371r 2               ; ---------------------------------------------------------------------------
000371r 2               next_token:
000371r 2               ; skip whitespace and comments
000371r 2               @skip:
000371r 2  A5 rr                LDA     lex_char
000373r 2  F0 3B                BEQ     @eof
000375r 2  C9 20                CMP     #' '
000377r 2  F0 13                BEQ     @ws
000379r 2  C9 09                CMP     #$09            ; TAB
00037Br 2  F0 0F                BEQ     @ws
00037Dr 2  C9 0D                CMP     #$0D            ; CR — treat as whitespace, LF counts the line
00037Fr 2  F0 0B                BEQ     @ws
000381r 2  C9 0A                CMP     #$0A            ; LF
000383r 2  F0 0C                BEQ     @nl
000385r 2  C9 7B                CMP     #'{'            ; Pascal comment start
000387r 2  F0 17                BEQ     @comment
000389r 2  4C rr rr             JMP     @not_ws
00038Cr 2               @ws:
00038Cr 2  20 rr rr             JSR     lexer_getc
00038Fr 2  80 E0                BRA     @skip
000391r 2               @nl:
000391r 2  E6 rr                INC     lex_line
000393r 2  D0 02                BNE     :+
000395r 2  E6 rr                INC     lex_line+1
000397r 2               :
000397r 2  A9 00                LDA     #0
000399r 2  85 rr                STA     lex_col
00039Br 2  20 rr rr             JSR     lexer_getc
00039Er 2  80 D1                BRA     @skip
0003A0r 2               @comment:
0003A0r 2               ; skip { ... }
0003A0r 2               @cloop:
0003A0r 2  20 rr rr             JSR     lexer_getc
0003A3r 2  A5 rr                LDA     lex_char        ; PLY inside lexer_getc clobbers Z; reload to test EOF
0003A5r 2  F0 09                BEQ     @eof
0003A7r 2  C9 7D                CMP     #'}'
0003A9r 2  D0 F5                BNE     @cloop
0003ABr 2  20 rr rr             JSR     lexer_getc
0003AEr 2  80 C1                BRA     @skip
0003B0r 2               @eof:
0003B0r 2  A9 00                LDA     #TOK_EOF
0003B2r 2  85 rr                STA     tok_type
0003B4r 2  60                   RTS
0003B5r 2               
0003B5r 2               @not_ws:
0003B5r 2               ; letter → identifier or keyword
0003B5r 2  20 rr rr             JSR     is_letter
0003B8r 2  B0 0C                BCS     @ident
0003BAr 2               
0003BAr 2               ; digit → integer literal
0003BAr 2  20 rr rr             JSR     is_digit
0003BDr 2  B0 2F                BCS     @number
0003BFr 2               
0003BFr 2               ; string → string literal
0003BFr 2  C9 27                CMP     #$27            ; single quote
0003C1r 2  F0 48                BEQ     @string
0003C3r 2               
0003C3r 2               ; operators and punctuation
0003C3r 2  4C rr rr             JMP     @punct
0003C6r 2               
0003C6r 2               ; --- Identifier ---
0003C6r 2               @ident:
0003C6r 2  A0 00                LDY     #0
0003C8r 2               @id_loop:
0003C8r 2  A5 rr                LDA     lex_char
0003CAr 2  20 rr rr             JSR     to_upper
0003CDr 2  99 rr rr             STA     ident_buf+1,y
0003D0r 2  C8                   INY
0003D1r 2  C0 3F                CPY     #63
0003D3r 2  F0 0F                BEQ     @id_done
0003D5r 2  20 rr rr             JSR     lexer_getc
0003D8r 2  A5 rr                LDA     lex_char
0003DAr 2  20 rr rr             JSR     is_letter
0003DDr 2  B0 E9                BCS     @id_loop
0003DFr 2  20 rr rr             JSR     is_digit
0003E2r 2  B0 E4                BCS     @id_loop
0003E4r 2               @id_done:
0003E4r 2  98                   TYA
0003E5r 2  8D rr rr             STA     ident_buf       ; length
0003E8r 2               ; check against keyword table
0003E8r 2  20 rr rr             JSR     lookup_keyword
0003EBr 2  85 rr                STA     tok_type
0003EDr 2  60                   RTS
0003EEr 2               
0003EEr 2               ; --- Integer literal ---
0003EEr 2               @number:
0003EEr 2  A9 00                LDA     #0
0003F0r 2  85 rr                STA     tok_ival_lo
0003F2r 2  85 rr                STA     tok_ival_hi
0003F4r 2               @num_loop:
0003F4r 2  A5 rr                LDA     lex_char
0003F6r 2  38                   SEC
0003F7r 2  E9 30                SBC     #'0'
0003F9r 2  20 rr rr             JSR     mul10_tokval    ; tokval = tokval*10 + digit
0003FCr 2  20 rr rr             JSR     lexer_getc
0003FFr 2  A5 rr                LDA     lex_char
000401r 2  20 rr rr             JSR     is_digit
000404r 2  B0 EE                BCS     @num_loop
000406r 2  A9 02                LDA     #TOK_INT
000408r 2  85 rr                STA     tok_type
00040Ar 2  60                   RTS
00040Br 2               
00040Br 2               ; --- String literal ---
00040Br 2               @string:
00040Br 2  20 rr rr             JSR     lexer_getc      ; skip opening quote
00040Er 2  A0 00                LDY     #0
000410r 2               @str_loop:
000410r 2  A5 rr                LDA     lex_char
000412r 2  F0 21                BEQ     @str_done       ; EOF
000414r 2  C9 27                CMP     #$27
000416r 2  F0 09                BEQ     @str_close
000418r 2  99 rr rr             STA     ident_buf+1,y
00041Br 2  C8                   INY
00041Cr 2  20 rr rr             JSR     lexer_getc
00041Fr 2  80 EF                BRA     @str_loop
000421r 2               @str_close:
000421r 2  20 rr rr             JSR     lexer_getc      ; skip closing quote
000424r 2               ; check for '' (escaped quote)
000424r 2  A5 rr                LDA     lex_char
000426r 2  C9 27                CMP     #$27
000428r 2  D0 0B                BNE     @str_done
00042Ar 2  A9 27                LDA     #$27
00042Cr 2  99 rr rr             STA     ident_buf+1,y
00042Fr 2  C8                   INY
000430r 2  20 rr rr             JSR     lexer_getc
000433r 2  80 DB                BRA     @str_loop
000435r 2               @str_done:
000435r 2  98                   TYA
000436r 2  8D rr rr             STA     ident_buf
000439r 2  A9 03                LDA     #TOK_STRING
00043Br 2  85 rr                STA     tok_type
00043Dr 2  60                   RTS
00043Er 2               
00043Er 2               ; --- Punctuation / operators ---
00043Er 2               @punct:
00043Er 2  A2 00                LDX     #0
000440r 2  A5 rr                LDA     lex_char
000442r 2  C9 2B                CMP     #'+'
000444r 2  D0 02                BNE     :+
000446r 2  A2 10                LDX     #TOK_PLUS
000448r 2               :
000448r 2  C9 2D                CMP     #'-'
00044Ar 2  D0 02                BNE     :+
00044Cr 2  A2 11                LDX     #TOK_MINUS
00044Er 2               :
00044Er 2  C9 2A                CMP     #'*'
000450r 2  D0 02                BNE     :+
000452r 2  A2 12                LDX     #TOK_STAR
000454r 2               :
000454r 2  C9 2F                CMP     #'/'
000456r 2  D0 02                BNE     :+
000458r 2  A2 13                LDX     #TOK_SLASH
00045Ar 2               :
00045Ar 2  C9 3D                CMP     #'='
00045Cr 2  D0 02                BNE     :+
00045Er 2  A2 14                LDX     #TOK_EQ
000460r 2               :
000460r 2  C9 28                CMP     #'('
000462r 2  D0 02                BNE     :+
000464r 2  A2 1B                LDX     #TOK_LPAREN
000466r 2               :
000466r 2  C9 29                CMP     #')'
000468r 2  D0 02                BNE     :+
00046Ar 2  A2 1C                LDX     #TOK_RPAREN
00046Cr 2               :
00046Cr 2  C9 5B                CMP     #'['
00046Er 2  D0 02                BNE     :+
000470r 2  A2 1D                LDX     #TOK_LBRACK
000472r 2               :
000472r 2  C9 5D                CMP     #']'
000474r 2  D0 02                BNE     :+
000476r 2  A2 1E                LDX     #TOK_RBRACK
000478r 2               :
000478r 2  C9 2C                CMP     #','
00047Ar 2  D0 02                BNE     :+
00047Cr 2  A2 1F                LDX     #TOK_COMMA
00047Er 2               :
00047Er 2  C9 3B                CMP     #';'
000480r 2  D0 02                BNE     :+
000482r 2  A2 20                LDX     #TOK_SEMICOLON
000484r 2               :
000484r 2  C9 5E                CMP     #'^'
000486r 2  D0 02                BNE     :+
000488r 2  A2 24                LDX     #TOK_CARET
00048Ar 2               :
00048Ar 2  C9 3C                CMP     #'<'
00048Cr 2  D0 22                BNE     @not_lt
00048Er 2  20 rr rr             JSR     lexer_getc
000491r 2  A5 rr                LDA     lex_char
000493r 2  C9 3D                CMP     #'='
000495r 2  F0 09                BEQ     @leq
000497r 2  C9 3E                CMP     #'>'
000499r 2  F0 0D                BEQ     @neq
00049Br 2  A9 16                LDA     #TOK_LT
00049Dr 2  85 rr                STA     tok_type
00049Fr 2  60                   RTS
0004A0r 2               @leq:
0004A0r 2  20 rr rr             JSR     lexer_getc
0004A3r 2  A9 18                LDA     #TOK_LEQ
0004A5r 2  85 rr                STA     tok_type
0004A7r 2  60                   RTS
0004A8r 2               @neq:
0004A8r 2  20 rr rr             JSR     lexer_getc
0004ABr 2  A9 15                LDA     #TOK_NEQ
0004ADr 2  85 rr                STA     tok_type
0004AFr 2  60                   RTS
0004B0r 2               @not_lt:
0004B0r 2  C9 3E                CMP     #'>'
0004B2r 2  D0 16                BNE     @not_gt
0004B4r 2  20 rr rr             JSR     lexer_getc
0004B7r 2  A5 rr                LDA     lex_char
0004B9r 2  C9 3D                CMP     #'='
0004BBr 2  F0 05                BEQ     @geq
0004BDr 2  A9 17                LDA     #TOK_GT
0004BFr 2  85 rr                STA     tok_type
0004C1r 2  60                   RTS
0004C2r 2               @geq:
0004C2r 2  20 rr rr             JSR     lexer_getc
0004C5r 2  A9 19                LDA     #TOK_GEQ
0004C7r 2  85 rr                STA     tok_type
0004C9r 2  60                   RTS
0004CAr 2               @not_gt:
0004CAr 2  C9 3A                CMP     #':'
0004CCr 2  D0 16                BNE     @not_colon
0004CEr 2  20 rr rr             JSR     lexer_getc
0004D1r 2  A5 rr                LDA     lex_char
0004D3r 2  C9 3D                CMP     #'='
0004D5r 2  F0 05                BEQ     @assign
0004D7r 2  A9 21                LDA     #TOK_COLON
0004D9r 2  85 rr                STA     tok_type
0004DBr 2  60                   RTS
0004DCr 2               @assign:
0004DCr 2  20 rr rr             JSR     lexer_getc
0004DFr 2  A9 1A                LDA     #TOK_ASSIGN
0004E1r 2  85 rr                STA     tok_type
0004E3r 2  60                   RTS
0004E4r 2               @not_colon:
0004E4r 2  C9 2E                CMP     #'.'
0004E6r 2  D0 16                BNE     @not_dot
0004E8r 2  20 rr rr             JSR     lexer_getc
0004EBr 2  A5 rr                LDA     lex_char
0004EDr 2  C9 2E                CMP     #'.'
0004EFr 2  F0 05                BEQ     @dotdot
0004F1r 2  A9 22                LDA     #TOK_DOT
0004F3r 2  85 rr                STA     tok_type
0004F5r 2  60                   RTS
0004F6r 2               @dotdot:
0004F6r 2  20 rr rr             JSR     lexer_getc
0004F9r 2  A9 23                LDA     #TOK_DOTDOT
0004FBr 2  85 rr                STA     tok_type
0004FDr 2  60                   RTS
0004FEr 2               @not_dot:
0004FEr 2               ; If a single-byte operator matched above, X holds its TOK_* code.
0004FEr 2               ; Otherwise X=0 and the character is unknown — skip and retry.
0004FEr 2  E0 00                CPX     #0
000500r 2  F0 07                BEQ     @unknown
000502r 2  8A                   TXA
000503r 2  85 rr                STA     tok_type
000505r 2  20 rr rr             JSR     lexer_getc
000508r 2  60                   RTS
000509r 2               @unknown:
000509r 2  20 rr rr             JSR     lexer_getc
00050Cr 2  4C rr rr             JMP     next_token
00050Fr 2               
00050Fr 2               ; ---------------------------------------------------------------------------
00050Fr 2               ; lexer_getc — fetch next character into lex_char
00050Fr 2               ; Refills sector buffer via file_read_sector when empty
00050Fr 2               ; ---------------------------------------------------------------------------
00050Fr 2               lexer_getc:
00050Fr 2  5A                   PHY                     ; preserve caller's Y across refill + read
000510r 2  A5 rr                LDA     src_buf_pos
000512r 2  C5 rr                CMP     src_buf_end
000514r 2  90 17                BCC     @from_buf       ; still have data
000516r 2               ; refill buffer — set tmp1 to source FCB first
000516r 2               ; (other code paths leave tmp1 pointing at output FCB)
000516r 2  A5 rr                LDA     src_fcb
000518r 2  85 rr                STA     tmp1
00051Ar 2  A5 rr                LDA     src_fcb+1
00051Cr 2  85 rr                STA     tmp1+1
00051Er 2  20 rr rr             JSR     file_read_sector
000521r 2  C9 00                CMP     #0
000523r 2  D0 15                BNE     @eof_char
000525r 2  A9 80                LDA     #128
000527r 2  85 rr                STA     src_buf_end
000529r 2  A9 00                LDA     #0
00052Br 2  85 rr                STA     src_buf_pos
00052Dr 2               @from_buf:
00052Dr 2  A4 rr                LDY     src_buf_pos
00052Fr 2  B9 28 01             LDA     DMA_BUF,y
000532r 2  E6 rr                INC     src_buf_pos
000534r 2  85 rr                STA     lex_char
000536r 2  E6 rr                INC     lex_col
000538r 2  7A                   PLY
000539r 2  60                   RTS
00053Ar 2               @eof_char:
00053Ar 2  A9 00                LDA     #0
00053Cr 2  85 rr                STA     lex_char
00053Er 2  7A                   PLY
00053Fr 2  60                   RTS
000540r 2               
000540r 2               ; ---------------------------------------------------------------------------
000540r 2               ; lookup_keyword — check ident_buf against keyword_table
000540r 2               ; Returns: A = keyword token code, or TOK_IDENT if not found
000540r 2               ; ---------------------------------------------------------------------------
000540r 2               lookup_keyword:
000540r 2  A9 rr                LDA     #<keyword_table
000542r 2  85 rr                STA     tmp2
000544r 2  A9 rr                LDA     #>keyword_table
000546r 2  85 rr                STA     tmp2+1
000548r 2               @next_kw:
000548r 2  A0 00                LDY     #0
00054Ar 2  B1 rr                LDA     (tmp2),y        ; keyword length (0 = sentinel)
00054Cr 2  F0 2C                BEQ     @not_found
00054Er 2  CD rr rr             CMP     ident_buf       ; compare lengths first
000551r 2  D0 15                BNE     @advance
000553r 2  AA                   TAX                     ; X = length
000554r 2  A0 01                LDY     #1
000556r 2               @cmp_loop:
000556r 2  B1 rr                LDA     (tmp2),y
000558r 2  D9 rr rr             CMP     ident_buf,y
00055Br 2  D0 0B                BNE     @advance
00055Dr 2  C8                   INY
00055Er 2  CA                   DEX
00055Fr 2  D0 F5                BNE     @cmp_loop
000561r 2               ; match: token code is at offset length+1
000561r 2  AC rr rr             LDY     ident_buf
000564r 2  C8                   INY
000565r 2  B1 rr                LDA     (tmp2),y
000567r 2  60                   RTS
000568r 2               @advance:
000568r 2               ; skip to next entry: advance tmp2 by (length+2)
000568r 2               ; (Y may be >0 if we got here from @cmp_loop — reset to 0 first)
000568r 2  A0 00                LDY     #0
00056Ar 2  B1 rr                LDA     (tmp2),y        ; length byte
00056Cr 2  18                   CLC
00056Dr 2  69 02                ADC     #2              ; +1 for length byte, +1 for token byte
00056Fr 2  18                   CLC
000570r 2  65 rr                ADC     tmp2
000572r 2  85 rr                STA     tmp2
000574r 2  90 02                BCC     :+
000576r 2  E6 rr                INC     tmp2+1
000578r 2               :
000578r 2  80 CE                BRA     @next_kw
00057Ar 2               @not_found:
00057Ar 2  A9 01                LDA     #TOK_IDENT
00057Cr 2  60                   RTS
00057Dr 2               
00057Dr 2               ; ---------------------------------------------------------------------------
00057Dr 2               ; is_letter — test lex_char; carry set if A-Z or a-z
00057Dr 2               ; ---------------------------------------------------------------------------
00057Dr 2               is_letter:
00057Dr 2  A5 rr                LDA     lex_char
00057Fr 2  C9 41                CMP     #'A'
000581r 2  90 10                BCC     @no
000583r 2  C9 5B                CMP     #'Z'+1
000585r 2  90 0E                BCC     @yes
000587r 2  C9 61                CMP     #'a'
000589r 2  90 08                BCC     @no
00058Br 2  C9 7B                CMP     #'z'+1
00058Dr 2  90 06                BCC     @yes
00058Fr 2  C9 5F                CMP     #'_'
000591r 2  F0 02                BEQ     @yes
000593r 2               @no:
000593r 2  18                   CLC
000594r 2  60                   RTS
000595r 2               @yes:
000595r 2  38                   SEC
000596r 2  60                   RTS
000597r 2               
000597r 2               ; ---------------------------------------------------------------------------
000597r 2               ; is_digit — test lex_char; carry set if 0-9
000597r 2               ; ---------------------------------------------------------------------------
000597r 2               is_digit:
000597r 2  A5 rr                LDA     lex_char
000599r 2  C9 30                CMP     #'0'
00059Br 2  90 06                BCC     @no
00059Dr 2  C9 3A                CMP     #'9'+1
00059Fr 2  B0 02                BCS     @no
0005A1r 2  38                   SEC
0005A2r 2  60                   RTS
0005A3r 2               @no:
0005A3r 2  18                   CLC
0005A4r 2  60                   RTS
0005A5r 2               
0005A5r 2               ; ---------------------------------------------------------------------------
0005A5r 2               ; to_upper — convert A to uppercase (A-Z,a-z only, others pass through)
0005A5r 2               ; ---------------------------------------------------------------------------
0005A5r 2               to_upper:
0005A5r 2  C9 61                CMP     #'a'
0005A7r 2  90 06                BCC     @done
0005A9r 2  C9 7B                CMP     #'z'+1
0005ABr 2  B0 02                BCS     @done
0005ADr 2  29 DF                AND     #$DF
0005AFr 2               @done:
0005AFr 2  60                   RTS
0005B0r 2               
0005B0r 2               ; ---------------------------------------------------------------------------
0005B0r 2               ; mul10_tokval — tokval = tokval*10 + A  (A = digit 0-9)
0005B0r 2               ; ---------------------------------------------------------------------------
0005B0r 2               mul10_tokval:
0005B0r 2  48                   PHA
0005B1r 2               ; multiply tok_ival by 10: x10 = x*8 + x*2
0005B1r 2  A5 rr                LDA     tok_ival_lo
0005B3r 2  0A                   ASL                     ; *2
0005B4r 2  85 rr                STA     tmp2
0005B6r 2  A5 rr                LDA     tok_ival_hi
0005B8r 2  2A                   ROL
0005B9r 2  85 rr                STA     tmp2+1
0005BBr 2  A5 rr                LDA     tmp2            ; *4
0005BDr 2  0A                   ASL
0005BEr 2  85 rr                STA     tmp3
0005C0r 2  A5 rr                LDA     tmp2+1
0005C2r 2  2A                   ROL
0005C3r 2  85 rr                STA     tmp3+1
0005C5r 2  A5 rr                LDA     tmp3            ; *8
0005C7r 2  0A                   ASL
0005C8r 2  85 rr                STA     tmp3
0005CAr 2  A5 rr                LDA     tmp3+1
0005CCr 2  2A                   ROL
0005CDr 2  85 rr                STA     tmp3+1
0005CFr 2               ; *10 = *8 + *2
0005CFr 2  A5 rr                LDA     tmp3
0005D1r 2  18                   CLC
0005D2r 2  65 rr                ADC     tmp2
0005D4r 2  85 rr                STA     tok_ival_lo
0005D6r 2  A5 rr                LDA     tmp3+1
0005D8r 2  65 rr                ADC     tmp2+1
0005DAr 2  85 rr                STA     tok_ival_hi
0005DCr 2               ; add digit
0005DCr 2  68                   PLA
0005DDr 2  18                   CLC
0005DEr 2  65 rr                ADC     tok_ival_lo
0005E0r 2  85 rr                STA     tok_ival_lo
0005E2r 2  90 02                BCC     :+
0005E4r 2  E6 rr                INC     tok_ival_hi
0005E6r 2               :
0005E6r 2  60                   RTS
0005E7r 2               
0005E7r 1                       .include        "PARSER.ASM"
0005E7r 2               ; parser.asm — recursive-descent Pascal parser + single-pass code generator
0005E7r 2               ;
0005E7r 2               ; Entry point: compile_program (called from pascal_main)
0005E7r 2               ;
0005E7r 2               ; This is a skeleton. Each parse routine calls next_token and emits p-code
0005E7r 2               ; directly (no AST nodes). Phase 3 fleshes out the full grammar.
0005E7r 2               
0005E7r 2                       .segment        "CODE"
0005E7r 2               
0005E7r 2               ; ---------------------------------------------------------------------------
0005E7r 2               ; expect — verify current token is `expected_tok`, advance, error if not
0005E7r 2               ; expected_tok passed in X; error string pointer in tmp3 (lo) and A (hi)
0005E7r 2               ; ---------------------------------------------------------------------------
0005E7r 2               expect:
0005E7r 2  A5 rr                LDA     tok_type
0005E9r 2  E4 rr                CPX     tok_type
0005EBr 2  F0 18                BEQ     @ok
0005EDr 2               ; mismatch — report error using tmp3 as message pointer
0005EDr 2  A5 rr                LDA     tmp3
0005EFr 2  85 rr                STA     tmp0
0005F1r 2  A5 rr                LDA     tmp3+1
0005F3r 2  85 rr                STA     tmp0+1
0005F5r 2  20 rr rr             JSR     compile_error
0005F8r 2               ; attempt recovery: skip tokens until we see the expected one or EOF
0005F8r 2               @recover:
0005F8r 2  A5 rr                LDA     tok_type
0005FAr 2  F0 09                BEQ     @ok             ; EOF — stop recovery
0005FCr 2  E4 rr                CPX     tok_type
0005FEr 2  F0 05                BEQ     @ok
000600r 2  20 rr rr             JSR     next_token
000603r 2  80 F3                BRA     @recover
000605r 2               @ok:
000605r 2  20 rr rr             JSR     next_token
000608r 2  60                   RTS
000609r 2               
000609r 2               ; Helper macros — not ca65 .macros since they'd be complex; use inline calls.
000609r 2               
000609r 2               ; ---------------------------------------------------------------------------
000609r 2               ; compile_program — top-level: PROGRAM name ; block .
000609r 2               ; ---------------------------------------------------------------------------
000609r 2               compile_program:
000609r 2  20 rr rr             JSR     symtab_init
00060Cr 2               ; expect PROGRAM keyword
00060Cr 2  A5 rr                LDA     tok_type
00060Er 2  C9 53                CMP     #TOK_PROGRAM
000610r 2  D0 0F                BNE     @no_hdr         ; allow missing PROGRAM header (lenient)
000612r 2  20 rr rr             JSR     next_token
000615r 2               ; program name (identifier)
000615r 2  20 rr rr             JSR     next_token
000618r 2               ; semicolon
000618r 2  A5 rr                LDA     tok_type
00061Ar 2  C9 20                CMP     #TOK_SEMICOLON
00061Cr 2  D0 03                BNE     :+
00061Er 2  20 rr rr             JSR     next_token
000621r 2               :
000621r 2               @no_hdr:
000621r 2               ; Emit a forward UJP at code offset 0; parse_block patches it to point
000621r 2               ; to the main BEGIN block once all proc bodies have been emitted ahead
000621r 2               ; of it. The .PCD entry point stays at offset 0 (start of code = UJP).
000621r 2  20 rr rr             JSR     emit_UJP        ; A=patch_lo, scratch=patch_hi
000624r 2  8D rr rr             STA     main_jmp_patch
000627r 2  A5 rr                LDA     scratch
000629r 2  8D rr rr             STA     main_jmp_patch+1
00062Cr 2  20 rr rr             JSR     parse_block
00062Fr 2               ; Emit HALT at end of main program
00062Fr 2  20 rr rr             JSR     emit_HALT
000632r 2  60                   RTS
000633r 2               
000633r 2               ; ---------------------------------------------------------------------------
000633r 2               ; parse_block — { const_part } { type_part } { var_part } { proc_part } statement_part
000633r 2               ; ---------------------------------------------------------------------------
000633r 2               parse_block:
000633r 2               @again:
000633r 2  A5 rr                LDA     tok_type
000635r 2  C9 44                CMP     #TOK_CONST
000637r 2  F0 15                BEQ     @const
000639r 2  C9 58                CMP     #TOK_TYPE
00063Br 2  F0 19                BEQ     @type
00063Dr 2  C9 5A                CMP     #TOK_VAR
00063Fr 2  F0 1D                BEQ     @var
000641r 2  C9 52                CMP     #TOK_PROCEDURE
000643r 2  F0 21                BEQ     @proc
000645r 2  C9 4B                CMP     #TOK_FUNCTION
000647r 2  F0 25                BEQ     @func
000649r 2  C9 42                CMP     #TOK_BEGIN
00064Br 2  F0 29                BEQ     @body
00064Dr 2  60                   RTS                     ; nothing recognisable
00064Er 2               
00064Er 2               @const:
00064Er 2  20 rr rr             JSR     next_token
000651r 2  20 rr rr             JSR     parse_const_decls
000654r 2  80 DD                BRA     @again
000656r 2               @type:
000656r 2  20 rr rr             JSR     next_token
000659r 2  20 rr rr             JSR     parse_type_decls
00065Cr 2  80 D5                BRA     @again
00065Er 2               @var:
00065Er 2  20 rr rr             JSR     next_token
000661r 2  20 rr rr             JSR     parse_var_decls
000664r 2  80 CD                BRA     @again
000666r 2               @proc:
000666r 2  20 rr rr             JSR     next_token
000669r 2  20 rr rr             JSR     parse_proc_decl
00066Cr 2  80 C5                BRA     @again
00066Er 2               @func:
00066Er 2  20 rr rr             JSR     next_token
000671r 2  20 rr rr             JSR     parse_func_decl
000674r 2  80 BD                BRA     @again
000676r 2               @body:  ; If at global scope and the main UJP hasn't been patched yet, do so
000676r 2                       ; before emitting any main-body code. main_jmp_patch+1 = $FF means
000676r 2                       ; "already patched" (or no UJP emitted, e.g. early-error path).
000676r 2  A5 rr                LDA     scope_depth
000678r 2  D0 19                BNE     @body_emit
00067Ar 2  AD rr rr             LDA     main_jmp_patch+1
00067Dr 2  C9 FF                CMP     #$FF
00067Fr 2  F0 12                BEQ     @body_emit
000681r 2  AD rr rr             LDA     main_jmp_patch
000684r 2  85 rr                STA     tmp2
000686r 2  AD rr rr             LDA     main_jmp_patch+1
000689r 2  85 rr                STA     tmp2+1
00068Br 2  20 rr rr             JSR     patch_jump
00068Er 2  A9 FF                LDA     #$FF
000690r 2  8D rr rr             STA     main_jmp_patch+1
000693r 2               @body_emit:
000693r 2  20 rr rr             JSR     parse_compound_stmt
000696r 2  60                   RTS
000697r 2               
000697r 2               ; ---------------------------------------------------------------------------
000697r 2               ; parse_const_decls — name = [-]INT_LIT ;  { name = [-]INT_LIT ; }
000697r 2               ; Each constant goes into the symbol table as SYM_CONST with the literal
000697r 2               ; value stored at offsets 18-19; references emit LDCW with that value.
000697r 2               ; ---------------------------------------------------------------------------
000697r 2               parse_const_decls:
000697r 2               @loop:
000697r 2  A5 rr                LDA     tok_type
000699r 2  C9 01                CMP     #TOK_IDENT
00069Br 2  F0 01                BEQ     @have_ident
00069Dr 2  60                   RTS                     ; done — no more constants
00069Er 2               @have_ident:
00069Er 2               ; save const name into save_name_buf
00069Er 2  A0 0F                LDY     #15
0006A0r 2               @savename:
0006A0r 2  B9 rr rr             LDA     ident_buf,y
0006A3r 2  99 rr rr             STA     save_name_buf,y
0006A6r 2  88                   DEY
0006A7r 2  10 F7                BPL     @savename
0006A9r 2  20 rr rr             JSR     next_token      ; consume name
0006ACr 2               ; expect '='
0006ACr 2  A5 rr                LDA     tok_type
0006AEr 2  C9 14                CMP     #TOK_EQ
0006B0r 2  D0 03                BNE     :+
0006B2r 2  20 rr rr             JSR     next_token
0006B5r 2               :       ; optional unary minus — record in scratch (next_token preserves it)
0006B5r 2  A9 00                LDA     #0
0006B7r 2  85 rr                STA     scratch
0006B9r 2  A5 rr                LDA     tok_type
0006BBr 2  C9 11                CMP     #TOK_MINUS
0006BDr 2  D0 07                BNE     @no_minus
0006BFr 2  A9 FF                LDA     #$FF
0006C1r 2  85 rr                STA     scratch
0006C3r 2  20 rr rr             JSR     next_token
0006C6r 2               @no_minus:
0006C6r 2                       ; expect INT literal
0006C6r 2  A5 rr                LDA     tok_type
0006C8r 2  C9 02                CMP     #TOK_INT
0006CAr 2  F0 08                BEQ     @have_int
0006CCr 2                       ; bad value — store 0 and try to recover
0006CCr 2  A9 00                LDA     #0
0006CEr 2  85 rr                STA     tmp2
0006D0r 2  85 rr                STA     tmp2+1
0006D2r 2  80 0B                BRA     @add_const
0006D4r 2               @have_int:
0006D4r 2  A5 rr                LDA     tok_ival_lo
0006D6r 2  85 rr                STA     tmp2
0006D8r 2  A5 rr                LDA     tok_ival_hi
0006DAr 2  85 rr                STA     tmp2+1
0006DCr 2  20 rr rr             JSR     next_token      ; consume INT
0006DFr 2               @add_const:
0006DFr 2               ; apply negate flag if set
0006DFr 2  A5 rr                LDA     scratch
0006E1r 2  F0 0D                BEQ     @no_neg
0006E3r 2  38                   SEC
0006E4r 2  A9 00                LDA     #0
0006E6r 2  E5 rr                SBC     tmp2
0006E8r 2  85 rr                STA     tmp2
0006EAr 2  A9 00                LDA     #0
0006ECr 2  E5 rr                SBC     tmp2+1
0006EEr 2  85 rr                STA     tmp2+1
0006F0r 2               @no_neg:
0006F0r 2               ; install in symbol table — value lives at offsets 18-19
0006F0r 2  20 rr rr             JSR     swap_ident_save
0006F3r 2  A9 02                LDA     #SYM_CONST
0006F5r 2  A2 01                LDX     #TY_INT
0006F7r 2  20 rr rr             JSR     symtab_add
0006FAr 2  20 rr rr             JSR     swap_ident_save
0006FDr 2               ; expect ';'
0006FDr 2  A5 rr                LDA     tok_type
0006FFr 2  C9 20                CMP     #TOK_SEMICOLON
000701r 2  D0 94                BNE     @loop
000703r 2  20 rr rr             JSR     next_token
000706r 2  80 8F                BRA     @loop
000708r 2               
000708r 2               ; ---------------------------------------------------------------------------
000708r 2               ; parse_type_decls — name = type_spec ;  { ... }
000708r 2               ; Each binding registers a SYM_TYPE entry whose offset-17 byte holds the
000708r 2               ; base TY_* code.  parse_type_spec resolves later references back to this
000708r 2               ; base type via symtab_find.
000708r 2               ; ---------------------------------------------------------------------------
000708r 2               parse_type_decls:
000708r 2               @loop:
000708r 2  A5 rr                LDA     tok_type
00070Ar 2  C9 01                CMP     #TOK_IDENT
00070Cr 2  F0 01                BEQ     :+
00070Er 2  60                   RTS                     ; done — no more type decls
00070Fr 2               :       ; save type name into save_name_buf (parse_type_spec clobbers ident_buf)
00070Fr 2  A0 0F                LDY     #15
000711r 2               @savename:
000711r 2  B9 rr rr             LDA     ident_buf,y
000714r 2  99 rr rr             STA     save_name_buf,y
000717r 2  88                   DEY
000718r 2  10 F7                BPL     @savename
00071Ar 2  20 rr rr             JSR     next_token      ; consume name
00071Dr 2               ; expect '='
00071Dr 2  A5 rr                LDA     tok_type
00071Fr 2  C9 14                CMP     #TOK_EQ
000721r 2  D0 03                BNE     :+
000723r 2  20 rr rr             JSR     next_token
000726r 2               :       ; parse the type definition; A = TY_* code
000726r 2  20 rr rr             JSR     parse_type_spec
000729r 2  85 rr                STA     scratch         ; save base type code
00072Br 2               ; bring the saved name back into ident_buf for symtab_add
00072Br 2  20 rr rr             JSR     swap_ident_save
00072Er 2               ; SYM_TYPE has no storage; offset bytes are unused (overwritten below
00072Er 2               ; for record types, which need to remember size + field-table location).
00072Er 2  A9 00                LDA     #0
000730r 2  85 rr                STA     tmp2
000732r 2  85 rr                STA     tmp2+1
000734r 2  A9 05                LDA     #SYM_TYPE
000736r 2  A6 rr                LDX     scratch
000738r 2  20 rr rr             JSR     symtab_add
00073Br 2               ; If this is a RECORD alias, stash record_size in bytes 18-19 and
00073Br 2               ; first_field/field_count in bytes 22-23 so later var-decls and field
00073Br 2               ; lookups can recover it.
00073Br 2  A5 rr                LDA     scratch
00073Dr 2  C9 06                CMP     #TY_RECORD
00073Fr 2  D0 1C                BNE     @td_no_rec
000741r 2  AD rr rr             LDA     record_size
000744r 2  A0 12                LDY     #18
000746r 2  91 rr                STA     (tmp3),y
000748r 2  AD rr rr             LDA     record_size+1
00074Br 2  A0 13                LDY     #19
00074Dr 2  91 rr                STA     (tmp3),y
00074Fr 2  AD rr rr             LDA     record_first_field
000752r 2  A0 16                LDY     #22
000754r 2  91 rr                STA     (tmp3),y
000756r 2  AD rr rr             LDA     record_field_count
000759r 2  A0 17                LDY     #23
00075Br 2  91 rr                STA     (tmp3),y
00075Dr 2               @td_no_rec:
00075Dr 2               ; expect ';'
00075Dr 2  A5 rr                LDA     tok_type
00075Fr 2  C9 20                CMP     #TOK_SEMICOLON
000761r 2  D0 A5                BNE     @loop
000763r 2  20 rr rr             JSR     next_token
000766r 2  80 A0                BRA     @loop
000768r 2               
000768r 2               ; ---------------------------------------------------------------------------
000768r 2               ; parse_var_decls — name { , name } : type ;  { ... }
000768r 2               ; All names on one line share the same type, allocated in order.
000768r 2               ; ---------------------------------------------------------------------------
000768r 2               parse_var_decls:
000768r 2               @decl_loop:
000768r 2  A5 rr                LDA     tok_type
00076Ar 2  C9 01                CMP     #TOK_IDENT
00076Cr 2  F0 01                BEQ     :+
00076Er 2  60                   RTS                     ; done — no more var decls
00076Fr 2               :       ; --- collect comma-separated names into var_name_buf ---
00076Fr 2  A9 00                LDA     #0
000771r 2  8D rr rr             STA     var_name_count
000774r 2               @collect:
000774r 2  A5 rr                LDA     tok_type
000776r 2  C9 01                CMP     #TOK_IDENT
000778r 2  D0 31                BNE     @end_collect
00077Ar 2  AD rr rr             LDA     var_name_count
00077Dr 2  C9 08                CMP     #8
00077Fr 2  B0 1C                BCS     @skip_save
000781r 2                       ; tmp2 = var_name_buf + count*16   (count<8 → fits without manual carry)
000781r 2  0A                   ASL
000782r 2  0A                   ASL
000783r 2  0A                   ASL
000784r 2  0A                   ASL                     ; *16
000785r 2  18                   CLC
000786r 2  69 rr                ADC     #<var_name_buf
000788r 2  85 rr                STA     tmp2
00078Ar 2  A9 00                LDA     #0
00078Cr 2  69 rr                ADC     #>var_name_buf
00078Er 2  85 rr                STA     tmp2+1
000790r 2  A0 0F                LDY     #15
000792r 2               @cp_in:
000792r 2  B9 rr rr             LDA     ident_buf,y
000795r 2  91 rr                STA     (tmp2),y
000797r 2  88                   DEY
000798r 2  10 F8                BPL     @cp_in
00079Ar 2  EE rr rr             INC     var_name_count
00079Dr 2               @skip_save:
00079Dr 2  20 rr rr             JSR     next_token      ; consume name
0007A0r 2  A5 rr                LDA     tok_type
0007A2r 2  C9 1F                CMP     #TOK_COMMA
0007A4r 2  D0 05                BNE     @end_collect
0007A6r 2  20 rr rr             JSR     next_token      ; consume ','
0007A9r 2  80 C9                BRA     @collect
0007ABr 2               @end_collect:
0007ABr 2               ; expect ':'
0007ABr 2  A5 rr                LDA     tok_type
0007ADr 2  C9 21                CMP     #TOK_COLON
0007AFr 2  D0 03                BNE     :+
0007B1r 2  20 rr rr             JSR     next_token
0007B4r 2               :       ; parse type — A = TY_*
0007B4r 2  20 rr rr             JSR     parse_type_spec
0007B7r 2  85 rr                STA     scratch         ; stash type
0007B9r 2               ; --- add each collected name to symbol table ---
0007B9r 2               ; NOTE: consume ';' AFTER the add loop so next_token doesn't clobber
0007B9r 2               ; ident_buf before @cp_out restores the saved name.
0007B9r 2  A2 00                LDX     #0
0007BBr 2               @add_loop:
0007BBr 2  EC rr rr             CPX     var_name_count
0007BEr 2  90 03                BCC     :+
0007C0r 2  4C rr rr             JMP     @post_add       ; out-of-range branch — use jmp
0007C3r 2               :
0007C3r 2  DA                   PHX                     ; preserve loop counter across symtab_add
0007C4r 2               ; tmp2 = var_name_buf + X*16
0007C4r 2  8A                   TXA
0007C5r 2  0A                   ASL
0007C6r 2  0A                   ASL
0007C7r 2  0A                   ASL
0007C8r 2  0A                   ASL
0007C9r 2  18                   CLC
0007CAr 2  69 rr                ADC     #<var_name_buf
0007CCr 2  85 rr                STA     tmp2
0007CEr 2  A9 00                LDA     #0
0007D0r 2  69 rr                ADC     #>var_name_buf
0007D2r 2  85 rr                STA     tmp2+1
0007D4r 2               ; copy slot → ident_buf so symtab_add sees the right name
0007D4r 2  A0 0F                LDY     #15
0007D6r 2               @cp_out:
0007D6r 2  B1 rr                LDA     (tmp2),Y
0007D8r 2  99 rr rr             STA     ident_buf,y
0007DBr 2  88                   DEY
0007DCr 2  10 F8                BPL     @cp_out
0007DEr 2               ; allocate storage — global if at top level, else from proc local AR
0007DEr 2  A5 rr                LDA     scope_depth
0007E0r 2  F0 14                BEQ     @gv_alloc
0007E2r 2               ; local scalar: tmp2 = local_alloc_off; bump by 2
0007E2r 2  AD rr rr             LDA     local_alloc_off
0007E5r 2  85 rr                STA     tmp2
0007E7r 2  A9 00                LDA     #0
0007E9r 2  85 rr                STA     tmp2+1
0007EBr 2  18                   CLC
0007ECr 2  AD rr rr             LDA     local_alloc_off
0007EFr 2  69 02                ADC     #2
0007F1r 2  8D rr rr             STA     local_alloc_off
0007F4r 2  80 20                BRA     @do_va_add
0007F6r 2               @gv_alloc:
0007F6r 2  A5 rr                LDA     scratch
0007F8r 2  C9 05                CMP     #TY_ARRAY
0007FAr 2  F0 0D                BEQ     @gv_array
0007FCr 2  C9 06                CMP     #TY_RECORD
0007FEr 2  F0 0E                BEQ     @gv_record
000800r 2  C9 08                CMP     #TY_TEXT
000802r 2  F0 0F                BEQ     @gv_text
000804r 2  20 rr rr             JSR     codegen_alloc_global    ; scalar: 2 bytes, offset in tmp2
000807r 2  80 0D                BRA     @do_va_add
000809r 2               @gv_array:
000809r 2  20 rr rr             JSR     codegen_alloc_array_global  ; array: right size, adj offset in tmp2
00080Cr 2  80 08                BRA     @do_va_add
00080Er 2               @gv_record:
00080Er 2  20 rr rr             JSR     codegen_alloc_record_global ; record: record_size bytes, offset in tmp2
000811r 2  80 03                BRA     @do_va_add
000813r 2               @gv_text:
000813r 2  20 rr rr             JSR     codegen_alloc_text_global   ; TEXT file: 168 bytes, offset in tmp2
000816r 2               @do_va_add:
000816r 2  A5 rr                LDA     scratch         ; type code
000818r 2  AA                   TAX
000819r 2  A9 01                LDA     #SYM_VAR
00081Br 2  20 rr rr             JSR     symtab_add      ; tmp3 = pointer to new entry
00081Er 2               ; type-specific metadata in entry bytes 22-23
00081Er 2  A5 rr                LDA     scratch
000820r 2  C9 05                CMP     #TY_ARRAY
000822r 2  D0 0F                BNE     @va_chk_rec
000824r 2  AD rr rr             LDA     array_elem_ty
000827r 2  A0 16                LDY     #22
000829r 2  91 rr                STA     (tmp3),y
00082Br 2  A9 02                LDA     #2              ; elemsize = 2 (word)
00082Dr 2  A0 17                LDY     #23
00082Fr 2  91 rr                STA     (tmp3),y
000831r 2  80 12                BRA     @va_done
000833r 2               @va_chk_rec:
000833r 2  C9 06                CMP     #TY_RECORD
000835r 2  D0 0E                BNE     @va_done
000837r 2  AD rr rr             LDA     record_first_field
00083Ar 2  A0 16                LDY     #22
00083Cr 2  91 rr                STA     (tmp3),y
00083Er 2  AD rr rr             LDA     record_field_count
000841r 2  A0 17                LDY     #23
000843r 2  91 rr                STA     (tmp3),y
000845r 2               @va_done:
000845r 2  FA                   PLX
000846r 2  E8                   INX
000847r 2  4C rr rr             JMP     @add_loop       ; jmp — body grew past bra range
00084Ar 2               @post_add:
00084Ar 2               ; now safe to consume ';' — ident_buf already used
00084Ar 2  A5 rr                LDA     tok_type
00084Cr 2  C9 20                CMP     #TOK_SEMICOLON
00084Er 2  D0 03                BNE     @pva_next
000850r 2  20 rr rr             JSR     next_token
000853r 2               @pva_next:
000853r 2  4C rr rr             JMP     @decl_loop
000856r 2               
000856r 2               ; swap 16 bytes between ident_buf and save_name_buf
000856r 2               swap_ident_save:
000856r 2  A0 0F                LDY     #15
000858r 2               @sw:
000858r 2  B9 rr rr             LDA     ident_buf,y
00085Br 2  BE rr rr             LDX     save_name_buf,y
00085Er 2  99 rr rr             STA     save_name_buf,y
000861r 2  8A                   TXA
000862r 2  99 rr rr             STA     ident_buf,y
000865r 2  88                   DEY
000866r 2  10 F0                BPL     @sw
000868r 2  60                   RTS
000869r 2               
000869r 2               ; ---------------------------------------------------------------------------
000869r 2               ; parse_type_spec — consume type token(s), return TY_* code in A
000869r 2               ; ---------------------------------------------------------------------------
000869r 2               parse_type_spec:
000869r 2  A5 rr                LDA     tok_type
00086Br 2  C9 01                CMP     #TOK_IDENT
00086Dr 2  F0 03                BEQ     :+
00086Fr 2  4C rr rr             JMP     @not_ident
000872r 2               :
000872r 2               ; First check for a user-defined SYM_TYPE alias — built-ins like
000872r 2               ; INTEGER/CHAR/BOOLEAN aren't in the symtab so this lookup falls
000872r 2               ; through harmlessly when there's no user binding.
000872r 2  20 rr rr             JSR     symtab_find
000875r 2  90 34                BCC     @builtin
000877r 2  A0 10                LDY     #16
000879r 2  B1 rr                LDA     (tmp3),y
00087Br 2  C9 05                CMP     #SYM_TYPE
00087Dr 2  D0 2C                BNE     @builtin
00087Fr 2  A0 11                LDY     #17
000881r 2  B1 rr                LDA     (tmp3),y
000883r 2  85 rr                STA     scratch         ; preserve across next_token
000885r 2               ; If alias resolves to a RECORD, copy the record metadata back into the
000885r 2               ; record_* globals so the caller (parse_var_decls) sees it.
000885r 2  C9 06                CMP     #TY_RECORD
000887r 2  D0 1C                BNE     @sty_no_rec
000889r 2  A0 12                LDY     #18
00088Br 2  B1 rr                LDA     (tmp3),y
00088Dr 2  8D rr rr             STA     record_size
000890r 2  A0 13                LDY     #19
000892r 2  B1 rr                LDA     (tmp3),y
000894r 2  8D rr rr             STA     record_size+1
000897r 2  A0 16                LDY     #22
000899r 2  B1 rr                LDA     (tmp3),y
00089Br 2  8D rr rr             STA     record_first_field
00089Er 2  A0 17                LDY     #23
0008A0r 2  B1 rr                LDA     (tmp3),y
0008A2r 2  8D rr rr             STA     record_field_count
0008A5r 2               @sty_no_rec:
0008A5r 2  20 rr rr             JSR     next_token
0008A8r 2  A5 rr                LDA     scratch
0008AAr 2  60                   RTS
0008ABr 2               @builtin:
0008ABr 2               ; check for built-in type names
0008ABr 2  AD rr rr             LDA     ident_buf       ; length
0008AEr 2  C9 07                CMP     #7
0008B0r 2  D0 20                BNE     @chk3
0008B2r 2               ; "INTEGER" (7 chars)
0008B2r 2  AD rr rr             LDA     ident_buf+1
0008B5r 2  C9 49                CMP     #'I'
0008B7r 2  D0 06                BNE     @chk_bool
0008B9r 2  20 rr rr             JSR     next_token
0008BCr 2  A9 01                LDA     #TY_INT
0008BEr 2  60                   RTS
0008BFr 2               @chk_bool:
0008BFr 2  AD rr rr             LDA     ident_buf+1
0008C2r 2  C9 42                CMP     #'B'
0008C4r 2  D0 06                BNE     @chk_str
0008C6r 2  20 rr rr             JSR     next_token
0008C9r 2  A9 03                LDA     #TY_BOOL
0008CBr 2  60                   RTS
0008CCr 2               @chk_str:
0008CCr 2  20 rr rr             JSR     next_token
0008CFr 2  A9 01                LDA     #TY_INT         ; default
0008D1r 2  60                   RTS
0008D2r 2               @chk3:
0008D2r 2  C9 04                CMP     #4
0008D4r 2  D0 1D                BNE     @chk6
0008D6r 2               ; 4-char built-in types: "CHAR" or "TEXT"
0008D6r 2  AD rr rr             LDA     ident_buf+1
0008D9r 2  C9 43                CMP     #'C'
0008DBr 2  D0 06                BNE     @chk_text
0008DDr 2  20 rr rr             JSR     next_token
0008E0r 2  A9 02                LDA     #TY_CHAR
0008E2r 2  60                   RTS
0008E3r 2               @chk_text:
0008E3r 2  C9 54                CMP     #'T'
0008E5r 2  D0 06                BNE     @chk3b
0008E7r 2  20 rr rr             JSR     next_token
0008EAr 2  A9 08                LDA     #TY_TEXT
0008ECr 2  60                   RTS
0008EDr 2               @chk3b:
0008EDr 2  20 rr rr             JSR     next_token
0008F0r 2  A9 01                LDA     #TY_INT
0008F2r 2  60                   RTS
0008F3r 2               @chk6:
0008F3r 2  C9 06                CMP     #6
0008F5r 2  D0 06                BNE     @default_type
0008F7r 2               ; "STRING" (6)
0008F7r 2  20 rr rr             JSR     next_token
0008FAr 2  A9 04                LDA     #TY_STRING
0008FCr 2  60                   RTS
0008FDr 2               @default_type:
0008FDr 2  20 rr rr             JSR     next_token
000900r 2  A9 01                LDA     #TY_INT
000902r 2  60                   RTS
000903r 2               @not_ident:
000903r 2  A5 rr                LDA     tok_type
000905r 2  C9 41                CMP     #TOK_ARRAY
000907r 2  D0 56                BNE     @not_array
000909r 2               ; --- ARRAY [lo..hi] OF basetype ---
000909r 2  20 rr rr             JSR     next_token      ; consume ARRAY → expect '['
00090Cr 2  A5 rr                LDA     tok_type
00090Er 2  C9 1D                CMP     #TOK_LBRACK
000910r 2  D0 03                BNE     :+
000912r 2  20 rr rr             JSR     next_token      ; consume '['
000915r 2               :
000915r 2               ; parse lo bound (integer literal)
000915r 2  A5 rr                LDA     tok_ival_lo
000917r 2  8D rr rr             STA     array_lo
00091Ar 2  A5 rr                LDA     tok_ival_hi
00091Cr 2  8D rr rr             STA     array_lo+1
00091Fr 2  A5 rr                LDA     tok_type
000921r 2  C9 02                CMP     #TOK_INT
000923r 2  D0 03                BNE     :+
000925r 2  20 rr rr             JSR     next_token      ; consume lo
000928r 2               :
000928r 2               ; expect '..'
000928r 2  A5 rr                LDA     tok_type
00092Ar 2  C9 23                CMP     #TOK_DOTDOT
00092Cr 2  D0 03                BNE     :+
00092Er 2  20 rr rr             JSR     next_token      ; consume '..'
000931r 2               :
000931r 2               ; parse hi bound
000931r 2  A5 rr                LDA     tok_ival_lo
000933r 2  8D rr rr             STA     array_hi
000936r 2  A5 rr                LDA     tok_ival_hi
000938r 2  8D rr rr             STA     array_hi+1
00093Br 2  A5 rr                LDA     tok_type
00093Dr 2  C9 02                CMP     #TOK_INT
00093Fr 2  D0 03                BNE     :+
000941r 2  20 rr rr             JSR     next_token      ; consume hi
000944r 2               :
000944r 2               ; expect ']'
000944r 2  A5 rr                LDA     tok_type
000946r 2  C9 1E                CMP     #TOK_RBRACK
000948r 2  D0 03                BNE     :+
00094Ar 2  20 rr rr             JSR     next_token      ; consume ']'
00094Dr 2               :
00094Dr 2               ; expect 'OF'
00094Dr 2  A5 rr                LDA     tok_type
00094Fr 2  C9 50                CMP     #TOK_OF
000951r 2  D0 03                BNE     :+
000953r 2  20 rr rr             JSR     next_token      ; consume 'OF'
000956r 2               :
000956r 2               ; parse element type (recursive — handles named types, built-ins)
000956r 2  20 rr rr             JSR     parse_type_spec
000959r 2  8D rr rr             STA     array_elem_ty
00095Cr 2  A9 05                LDA     #TY_ARRAY
00095Er 2  60                   RTS
00095Fr 2               @not_array:
00095Fr 2  A5 rr                LDA     tok_type
000961r 2  C9 54                CMP     #TOK_RECORD
000963r 2  F0 03                BEQ     :+
000965r 2  4C rr rr             JMP     @not_record
000968r 2               :
000968r 2               ; --- RECORD field { ; field } END ---
000968r 2               ; Each field group: name { , name } : type
000968r 2               ; All fields are stored as 2-byte slots; offsets are 0, 2, 4, ...
000968r 2  20 rr rr             JSR     next_token              ; consume RECORD
00096Br 2  A9 00                LDA     #0
00096Dr 2  8D rr rr             STA     record_size
000970r 2  8D rr rr             STA     record_size+1
000973r 2  8D rr rr             STA     record_field_count
000976r 2  AD rr rr             LDA     field_table_count
000979r 2  8D rr rr             STA     record_first_field
00097Cr 2               @rec_loop:
00097Cr 2  A5 rr                LDA     tok_type
00097Er 2  C9 49                CMP     #TOK_END
000980r 2  D0 03                BNE     :+
000982r 2  4C rr rr             JMP     @rec_end
000985r 2               :
000985r 2  C9 01                CMP     #TOK_IDENT
000987r 2  F0 03                BEQ     :+
000989r 2  4C rr rr             JMP     @rec_end                ; safety — bail on unexpected token
00098Cr 2               :
00098Cr 2               ; --- collect comma-separated field names into var_name_buf ---
00098Cr 2  A9 00                LDA     #0
00098Er 2  8D rr rr             STA     var_name_count
000991r 2               @rec_collect:
000991r 2  A5 rr                LDA     tok_type
000993r 2  C9 01                CMP     #TOK_IDENT
000995r 2  D0 31                BNE     @rec_endcol
000997r 2  AD rr rr             LDA     var_name_count
00099Ar 2  C9 08                CMP     #8
00099Cr 2  B0 1C                BCS     @rec_skip_save
00099Er 2  0A                   ASL
00099Fr 2  0A                   ASL
0009A0r 2  0A                   ASL
0009A1r 2  0A                   ASL                             ; *16
0009A2r 2  18                   CLC
0009A3r 2  69 rr                ADC     #<var_name_buf
0009A5r 2  85 rr                STA     tmp2
0009A7r 2  A9 00                LDA     #0
0009A9r 2  69 rr                ADC     #>var_name_buf
0009ABr 2  85 rr                STA     tmp2+1
0009ADr 2  A0 0F                LDY     #15
0009AFr 2               @rec_cpin:
0009AFr 2  B9 rr rr             LDA     ident_buf,y
0009B2r 2  91 rr                STA     (tmp2),y
0009B4r 2  88                   DEY
0009B5r 2  10 F8                BPL     @rec_cpin
0009B7r 2  EE rr rr             INC     var_name_count
0009BAr 2               @rec_skip_save:
0009BAr 2  20 rr rr             JSR     next_token              ; consume name
0009BDr 2  A5 rr                LDA     tok_type
0009BFr 2  C9 1F                CMP     #TOK_COMMA
0009C1r 2  D0 05                BNE     @rec_endcol
0009C3r 2  20 rr rr             JSR     next_token              ; consume ','
0009C6r 2  80 C9                BRA     @rec_collect
0009C8r 2               @rec_endcol:
0009C8r 2               ; expect ':'
0009C8r 2  A5 rr                LDA     tok_type
0009CAr 2  C9 21                CMP     #TOK_COLON
0009CCr 2  D0 03                BNE     :+
0009CEr 2  20 rr rr             JSR     next_token
0009D1r 2               :       ; parse field type — recurse; result in A
0009D1r 2  20 rr rr             JSR     parse_type_spec
0009D4r 2  85 rr                STA     scratch                 ; field type code
0009D6r 2               ; --- add each collected name to field_table at current record_size ---
0009D6r 2  A2 00                LDX     #0
0009D8r 2               @rec_addf:
0009D8r 2  EC rr rr             CPX     var_name_count
0009DBr 2  B0 39                BCS     @rec_endf
0009DDr 2  DA                   PHX
0009DEr 2  8A                   TXA
0009DFr 2  0A                   ASL
0009E0r 2  0A                   ASL
0009E1r 2  0A                   ASL
0009E2r 2  0A                   ASL                             ; *16
0009E3r 2  18                   CLC
0009E4r 2  69 rr                ADC     #<var_name_buf
0009E6r 2  85 rr                STA     tmp2
0009E8r 2  A9 00                LDA     #0
0009EAr 2  69 rr                ADC     #>var_name_buf
0009ECr 2  85 rr                STA     tmp2+1
0009EEr 2  A0 0F                LDY     #15
0009F0r 2               @rec_cpout:
0009F0r 2  B1 rr                LDA     (tmp2),y
0009F2r 2  99 rr rr             STA     ident_buf,y
0009F5r 2  88                   DEY
0009F6r 2  10 F8                BPL     @rec_cpout
0009F8r 2               ; field_table_add: A=offset (record_size lo), X=type
0009F8r 2  AD rr rr             LDA     record_size
0009FBr 2  A6 rr                LDX     scratch
0009FDr 2  20 rr rr             JSR     field_table_add
000A00r 2  EE rr rr             INC     record_field_count
000A03r 2               ; advance record_size by 2
000A03r 2  18                   CLC
000A04r 2  AD rr rr             LDA     record_size
000A07r 2  69 02                ADC     #2
000A09r 2  8D rr rr             STA     record_size
000A0Cr 2  90 03                BCC     :+
000A0Er 2  EE rr rr             INC     record_size+1
000A11r 2               :
000A11r 2  FA                   PLX
000A12r 2  E8                   INX
000A13r 2  4C rr rr             JMP     @rec_addf
000A16r 2               @rec_endf:
000A16r 2               ; expect ';' between groups, or END
000A16r 2  A5 rr                LDA     tok_type
000A18r 2  C9 20                CMP     #TOK_SEMICOLON
000A1Ar 2  D0 06                BNE     @rec_check_end
000A1Cr 2  20 rr rr             JSR     next_token              ; consume ';'
000A1Fr 2  4C rr rr             JMP     @rec_loop
000A22r 2               @rec_check_end:
000A22r 2  A5 rr                LDA     tok_type
000A24r 2  C9 49                CMP     #TOK_END
000A26r 2  F0 03                BEQ     :+
000A28r 2  4C rr rr             JMP     @rec_loop               ; recover — try again
000A2Br 2               :
000A2Br 2               @rec_end:
000A2Br 2  20 rr rr             JSR     next_token              ; consume END
000A2Er 2  A9 06                LDA     #TY_RECORD
000A30r 2  60                   RTS
000A31r 2               @not_record:
000A31r 2  20 rr rr             JSR     next_token
000A34r 2  A9 01                LDA     #TY_INT
000A36r 2  60                   RTS
000A37r 2               
000A37r 2               ; ---------------------------------------------------------------------------
000A37r 2               ; parse_arg_lvalue — used for VAR-by-reference call arguments.  Expects the
000A37r 2               ; current token to be an IDENT naming a variable; consumes the ident and
000A37r 2               ; emits an opcode that pushes the variable's address.
000A37r 2               ;
000A37r 2               ;   SYM_VAR    global → OP_LDA_G <wordoff>
000A37r 2               ;   SYM_VAR    local  → OP_LDA_L <byteoff>
000A37r 2               ;   SYM_VARREF (passing a VAR param through) → OP_LDL <byteoff>   (the
000A37r 2               ;              local slot itself already holds the upstream address)
000A37r 2               ;
000A37r 2               ; Anything else (literal, function call, undefined name) is silently ignored
000A37r 2               ; — the argument slot will hold whatever was last on the stack.  Pascal
000A37r 2               ; semantics say it's a compile error, but we emit no diagnostic for now.
000A37r 2               ; ---------------------------------------------------------------------------
000A37r 2               parse_arg_lvalue:
000A37r 2  A5 rr                LDA     tok_type
000A39r 2  C9 01                CMP     #TOK_IDENT
000A3Br 2  F0 01                BEQ     :+
000A3Dr 2  60                   RTS
000A3Er 2               :
000A3Er 2  20 rr rr             JSR     symtab_find
000A41r 2  B0 01                BCS     :+
000A43r 2  60                   RTS                     ; undefined — emit nothing
000A44r 2               :       ; Snapshot kind, scope, offset before next_token clobbers tmp3.
000A44r 2  A0 10                LDY     #16
000A46r 2  B1 rr                LDA     (tmp3),y
000A48r 2  48                   PHA                     ; kind
000A49r 2  A0 14                LDY     #20
000A4Br 2  B1 rr                LDA     (tmp3),y
000A4Dr 2  48                   PHA                     ; scope
000A4Er 2  A0 13                LDY     #19
000A50r 2  B1 rr                LDA     (tmp3),y
000A52r 2  48                   PHA                     ; off hi
000A53r 2  A0 12                LDY     #18
000A55r 2  B1 rr                LDA     (tmp3),y
000A57r 2  48                   PHA                     ; off lo (top)
000A58r 2  20 rr rr             JSR     next_token      ; consume ident
000A5Br 2  68                   PLA                     ; off lo
000A5Cr 2  AA                   TAX
000A5Dr 2  68                   PLA                     ; off hi
000A5Er 2  85 rr                STA     scratch
000A60r 2  68                   PLA                     ; scope
000A61r 2  A8                   TAY
000A62r 2  68                   PLA                     ; kind
000A63r 2  C9 08                CMP     #SYM_VARREF
000A65r 2  F0 0C                BEQ     @lv_passthrough
000A67r 2  C0 00                CPY     #0
000A69r 2  D0 04                BNE     @lv_local
000A6Br 2  8A                   TXA
000A6Cr 2  4C rr rr             JMP     emit_LDA_G
000A6Fr 2               @lv_local:
000A6Fr 2  8A                   TXA
000A70r 2  4C rr rr             JMP     emit_LDA_L
000A73r 2               @lv_passthrough:
000A73r 2  8A                   TXA
000A74r 2  4C rr rr             JMP     emit_LDL        ; slot already holds caller's address
000A77r 2               
000A77r 2               ; ---------------------------------------------------------------------------
000A77r 2               ; parse_param_list — assumes '(' has already been consumed.  Parses zero or
000A77r 2               ; more comma/semicolon-separated parameter groups, then ')'.  Each parameter
000A77r 2               ; is added to symtab as SYM_VAR with offset = proc_param_count*2 and the
000A77r 2               ; group's type code.  proc_param_count is incremented per param.
000A77r 2               ;
000A77r 2               ; Pascal supports two separator forms:
000A77r 2               ;   ( A, B: INTEGER )            — names sharing one type, COMMA separated
000A77r 2               ;   ( A: INTEGER; B: CHAR )      — different types, SEMICOLON between groups
000A77r 2               ;   ( A, B: INTEGER; C: CHAR )   — both forms mixed
000A77r 2               ;
000A77r 2               ; Reuses var_name_buf (128 bytes / 8 names per group).  Safe because the
000A77r 2               ; param list is fully parsed before parse_block runs (which is what calls
000A77r 2               ; parse_var_decls).
000A77r 2               ; ---------------------------------------------------------------------------
000A77r 2               parse_param_list:
000A77r 2  A9 00                LDA     #0
000A79r 2  8D rr rr             STA     param_var_mask  ; reset bitmap (set by caller too — paranoia)
000A7Cr 2               @group_loop:
000A7Cr 2               ; A leading VAR keyword marks the entire group as by-reference.
000A7Cr 2  A9 00                LDA     #0
000A7Er 2  8D rr rr             STA     group_is_var
000A81r 2  A5 rr                LDA     tok_type
000A83r 2  C9 5A                CMP     #TOK_VAR
000A85r 2  D0 08                BNE     @no_var_kw
000A87r 2  A9 01                LDA     #1
000A89r 2  8D rr rr             STA     group_is_var
000A8Cr 2  20 rr rr             JSR     next_token      ; consume VAR
000A8Fr 2               @no_var_kw:
000A8Fr 2  A5 rr                LDA     tok_type
000A91r 2  C9 01                CMP     #TOK_IDENT
000A93r 2  F0 03                BEQ     @have_ident     ; jmp trampoline — body is too big for bra
000A95r 2  4C rr rr             JMP     @done_params
000A98r 2               @have_ident:
000A98r 2               ; --- collect comma-separated names of this group ---
000A98r 2  A9 00                LDA     #0
000A9Ar 2  8D rr rr             STA     var_name_count
000A9Dr 2               @gcollect:
000A9Dr 2  A5 rr                LDA     tok_type
000A9Fr 2  C9 01                CMP     #TOK_IDENT
000AA1r 2  D0 31                BNE     @gend
000AA3r 2  AD rr rr             LDA     var_name_count
000AA6r 2  C9 08                CMP     #8
000AA8r 2  B0 1C                BCS     @gskip          ; buffer full — silently drop name
000AAAr 2  0A                   ASL
000AABr 2  0A                   ASL
000AACr 2  0A                   ASL
000AADr 2  0A                   ASL
000AAEr 2  18                   CLC
000AAFr 2  69 rr                ADC     #<var_name_buf
000AB1r 2  85 rr                STA     tmp2
000AB3r 2  A9 00                LDA     #0
000AB5r 2  69 rr                ADC     #>var_name_buf
000AB7r 2  85 rr                STA     tmp2+1
000AB9r 2  A0 0F                LDY     #15
000ABBr 2               @gcp:
000ABBr 2  B9 rr rr             LDA     ident_buf,y
000ABEr 2  91 rr                STA     (tmp2),y
000AC0r 2  88                   DEY
000AC1r 2  10 F8                BPL     @gcp
000AC3r 2  EE rr rr             INC     var_name_count
000AC6r 2               @gskip:
000AC6r 2  20 rr rr             JSR     next_token      ; consume name
000AC9r 2  A5 rr                LDA     tok_type
000ACBr 2  C9 1F                CMP     #TOK_COMMA
000ACDr 2  D0 05                BNE     @gend
000ACFr 2  20 rr rr             JSR     next_token      ; consume ','
000AD2r 2  80 C9                BRA     @gcollect
000AD4r 2               @gend:
000AD4r 2               ; expect ':'
000AD4r 2  A5 rr                LDA     tok_type
000AD6r 2  C9 21                CMP     #TOK_COLON
000AD8r 2  D0 03                BNE     :+
000ADAr 2  20 rr rr             JSR     next_token
000ADDr 2               :
000ADDr 2  20 rr rr             JSR     parse_type_spec
000AE0r 2  85 rr                STA     scratch         ; stash type for this group
000AE2r 2               ; --- add each collected name as SYM_VAR ---
000AE2r 2  A2 00                LDX     #0
000AE4r 2               @addloop:
000AE4r 2  EC rr rr             CPX     var_name_count
000AE7r 2  B0 58                BCS     @groupdone
000AE9r 2  DA                   PHX
000AEAr 2               ; copy var_name_buf[X*16] → ident_buf
000AEAr 2  8A                   TXA
000AEBr 2  0A                   ASL
000AECr 2  0A                   ASL
000AEDr 2  0A                   ASL
000AEEr 2  0A                   ASL
000AEFr 2  18                   CLC
000AF0r 2  69 rr                ADC     #<var_name_buf
000AF2r 2  85 rr                STA     tmp2
000AF4r 2  A9 00                LDA     #0
000AF6r 2  69 rr                ADC     #>var_name_buf
000AF8r 2  85 rr                STA     tmp2+1
000AFAr 2  A0 0F                LDY     #15
000AFCr 2               @cpout:
000AFCr 2  B1 rr                LDA     (tmp2),y
000AFEr 2  99 rr rr             STA     ident_buf,y
000B01r 2  88                   DEY
000B02r 2  10 F8                BPL     @cpout
000B04r 2               ; offset for this param = proc_param_count * 2
000B04r 2  AD rr rr             LDA     proc_param_count
000B07r 2  0A                   ASL
000B08r 2  85 rr                STA     tmp2
000B0Ar 2  A9 00                LDA     #0
000B0Cr 2  85 rr                STA     tmp2+1
000B0Er 2               ; If this is a VAR group, set the matching bit in param_var_mask
000B0Er 2               ; and use SYM_VARREF instead of SYM_VAR.
000B0Er 2  AD rr rr             LDA     group_is_var
000B11r 2  F0 1E                BEQ     @use_var_kind
000B13r 2               ; set bit (1 << proc_param_count) in param_var_mask (max 8 params)
000B13r 2  AC rr rr             LDY     proc_param_count
000B16r 2  C0 08                CPY     #8
000B18r 2  B0 10                BCS     @skip_mask      ; >8 params: silently drop bit
000B1Ar 2  A9 01                LDA     #1
000B1Cr 2               @shl:
000B1Cr 2  C0 00                CPY     #0
000B1Er 2  F0 04                BEQ     @done_shl
000B20r 2  0A                   ASL
000B21r 2  88                   DEY
000B22r 2  80 F8                BRA     @shl
000B24r 2               @done_shl:
000B24r 2  0D rr rr             ORA     param_var_mask
000B27r 2  8D rr rr             STA     param_var_mask
000B2Ar 2               @skip_mask:
000B2Ar 2  A5 rr                LDA     scratch         ; type
000B2Cr 2  AA                   TAX
000B2Dr 2  A9 08                LDA     #SYM_VARREF
000B2Fr 2  80 05                BRA     @do_add
000B31r 2               @use_var_kind:
000B31r 2  A5 rr                LDA     scratch         ; type
000B33r 2  AA                   TAX
000B34r 2  A9 01                LDA     #SYM_VAR
000B36r 2               @do_add:
000B36r 2  20 rr rr             JSR     symtab_add
000B39r 2  EE rr rr             INC     proc_param_count
000B3Cr 2  FA                   PLX
000B3Dr 2  E8                   INX
000B3Er 2  4C rr rr             JMP     @addloop        ; bra would be out of range now
000B41r 2               @groupdone:
000B41r 2               ; SEMICOLON → another group; else fall through to ')'
000B41r 2  A5 rr                LDA     tok_type
000B43r 2  C9 20                CMP     #TOK_SEMICOLON
000B45r 2  D0 06                BNE     @done_params
000B47r 2  20 rr rr             JSR     next_token      ; consume ';'
000B4Ar 2  4C rr rr             JMP     @group_loop
000B4Dr 2               @done_params:
000B4Dr 2  A5 rr                LDA     tok_type
000B4Fr 2  C9 1C                CMP     #TOK_RPAREN
000B51r 2  D0 03                BNE     :+
000B53r 2  20 rr rr             JSR     next_token      ; consume ')'
000B56r 2               :
000B56r 2  60                   RTS
000B57r 2               
000B57r 2               ; ---------------------------------------------------------------------------
000B57r 2               ; parse_proc_decl — PROCEDURE name [ ( params ) ] ; <block> ;
000B57r 2               ; The PROCEDURE keyword has already been consumed by parse_block @proc.
000B57r 2               ;
000B57r 2               ; Phase B: value parameters supported.  Each parameter occupies 2 bytes in
000B57r 2               ; the AR at MP+AR_LOCALS+offset and is stored into the symbol table as
000B57r 2               ; SYM_VAR in the inner scope.  Param-count is recorded on the proc's symbol
000B57r 2               ; entry (offset 21) so callers know how many args to push.
000B57r 2               ; ---------------------------------------------------------------------------
000B57r 2               parse_proc_decl:
000B57r 2               ; expect identifier (proc name)
000B57r 2  A5 rr                LDA     tok_type
000B59r 2  C9 01                CMP     #TOK_IDENT
000B5Br 2  F0 01                BEQ     @have_name
000B5Dr 2  60                   RTS
000B5Er 2               @have_name:
000B5Er 2               ; Save outer local_alloc_off on 6502 stack — nested procs would
000B5Er 2               ; otherwise clobber the enclosing proc's allocator state.
000B5Er 2  AD rr rr             LDA     local_alloc_off
000B61r 2  48                   PHA
000B62r 2               
000B62r 2               ; save proc name into save_name_buf (ident_buf gets clobbered later)
000B62r 2  A0 0F                LDY     #15
000B64r 2               @savename:
000B64r 2  B9 rr rr             LDA     ident_buf,y
000B67r 2  99 rr rr             STA     save_name_buf,y
000B6Ar 2  88                   DEY
000B6Br 2  10 F7                BPL     @savename
000B6Dr 2               
000B6Dr 2  20 rr rr             JSR     next_token      ; consume name
000B70r 2               
000B70r 2               ; Register proc in symbol table NOW so we have an entry to update
000B70r 2               ; with the param count once the param list has been parsed.
000B70r 2               ; Offset (proc entry point) = current cg_pc.
000B70r 2               ; Remember the symbol-table index for backpatch.
000B70r 2  AD rr rr             LDA     symtab_count
000B73r 2  8D rr rr             STA     proc_entry_idx
000B76r 2  AD rr rr             LDA     symtab_count+1
000B79r 2  8D rr rr             STA     proc_entry_idx+1
000B7Cr 2  20 rr rr             JSR     swap_ident_save ; ident_buf <-> save_name_buf
000B7Fr 2  A5 rr                LDA     cg_pc
000B81r 2  85 rr                STA     tmp2
000B83r 2  A5 rr                LDA     cg_pc+1
000B85r 2  85 rr                STA     tmp2+1
000B87r 2  A9 03                LDA     #SYM_PROC
000B89r 2  A2 00                LDX     #TY_NONE
000B8Br 2  20 rr rr             JSR     symtab_add
000B8Er 2  20 rr rr             JSR     swap_ident_save
000B91r 2               
000B91r 2               ; Enter scope: params and any locals belong to the proc's frame.
000B91r 2  20 rr rr             JSR     symtab_enter_scope
000B94r 2               
000B94r 2               ; init param count and VAR-mask
000B94r 2  A9 00                LDA     #0
000B96r 2  8D rr rr             STA     proc_param_count
000B99r 2  8D rr rr             STA     param_var_mask
000B9Cr 2               
000B9Cr 2               ; Optional parameter list
000B9Cr 2  A5 rr                LDA     tok_type
000B9Er 2  C9 1B                CMP     #TOK_LPAREN
000BA0r 2  D0 06                BNE     @backpatch_pcount
000BA2r 2  20 rr rr             JSR     next_token      ; consume '('
000BA5r 2  20 rr rr             JSR     parse_param_list
000BA8r 2               
000BA8r 2               @backpatch_pcount:
000BA8r 2               ; Write param count into proc's symbol entry (offset 21).
000BA8r 2               ; entry addr = SYMTAB_BASE + proc_entry_idx * 32
000BA8r 2  AD rr rr             LDA     proc_entry_idx
000BABr 2  0A                   ASL
000BACr 2  0A                   ASL
000BADr 2  0A                   ASL
000BAEr 2  0A                   ASL
000BAFr 2  0A                   ASL                     ; *32 (low byte)
000BB0r 2  18                   CLC
000BB1r 2  69 00                ADC     #<SYMTAB_BASE
000BB3r 2  85 rr                STA     tmp3
000BB5r 2  AD rr rr             LDA     proc_entry_idx+1
000BB8r 2  2A                   ROL
000BB9r 2  69 80                ADC     #>SYMTAB_BASE
000BBBr 2  85 rr                STA     tmp3+1
000BBDr 2  A0 15                LDY     #21
000BBFr 2  AD rr rr             LDA     proc_param_count
000BC2r 2  91 rr                STA     (tmp3),y
000BC4r 2  A0 16                LDY     #22
000BC6r 2  AD rr rr             LDA     param_var_mask
000BC9r 2  91 rr                STA     (tmp3),y
000BCBr 2               
000BCBr 2               ; Initialize local_alloc_off to start right after the params.
000BCBr 2               ; VAR declarations inside the body extend this; final value is
000BCBr 2               ; backpatched into entry offset 23 below as the MRKSTK size.
000BCBr 2  AD rr rr             LDA     proc_param_count
000BCEr 2  0A                   ASL
000BCFr 2  8D rr rr             STA     local_alloc_off
000BD2r 2               
000BD2r 2               ; expect ';'
000BD2r 2  A5 rr                LDA     tok_type
000BD4r 2  C9 20                CMP     #TOK_SEMICOLON
000BD6r 2  D0 03                BNE     :+
000BD8r 2  20 rr rr             JSR     next_token
000BDBr 2               :
000BDBr 2               ; No callee prologue: the caller emits MRKSTK + arg-stores + CALL,
000BDBr 2               ; so by the time we land at the proc entry the activation record
000BDBr 2               ; (and its param slots) already exists.
000BDBr 2               
000BDBr 2               ; Recurse: proc body may have its own const/type/var/proc/begin block.
000BDBr 2  20 rr rr             JSR     parse_block
000BDEr 2               
000BDEr 2               ; Epilogue
000BDEr 2  20 rr rr             JSR     emit_RET
000BE1r 2               
000BE1r 2               ; Backpatch total local-area size (params + declared locals) into
000BE1r 2               ; the proc's symbol entry at offset 23.  The caller reads this and
000BE1r 2               ; emits MRKSTK <lsize> so the AR is large enough to hold all locals
000BE1r 2               ; below pm_sp (otherwise value-stack pushes corrupt local slots).
000BE1r 2  AD rr rr             LDA     proc_entry_idx
000BE4r 2  0A                   ASL
000BE5r 2  0A                   ASL
000BE6r 2  0A                   ASL
000BE7r 2  0A                   ASL
000BE8r 2  0A                   ASL
000BE9r 2  18                   CLC
000BEAr 2  69 00                ADC     #<SYMTAB_BASE
000BECr 2  85 rr                STA     tmp3
000BEEr 2  AD rr rr             LDA     proc_entry_idx+1
000BF1r 2  2A                   ROL
000BF2r 2  69 80                ADC     #>SYMTAB_BASE
000BF4r 2  85 rr                STA     tmp3+1
000BF6r 2  A0 17                LDY     #23
000BF8r 2  AD rr rr             LDA     local_alloc_off
000BFBr 2  91 rr                STA     (tmp3),y
000BFDr 2               
000BFDr 2  20 rr rr             JSR     symtab_leave_scope
000C00r 2               
000C00r 2               ; Consume trailing ';' after END
000C00r 2  A5 rr                LDA     tok_type
000C02r 2  C9 20                CMP     #TOK_SEMICOLON
000C04r 2  D0 03                BNE     :+
000C06r 2  20 rr rr             JSR     next_token
000C09r 2               :
000C09r 2  68                   PLA
000C0Ar 2  8D rr rr             STA     local_alloc_off ; restore outer allocator state
000C0Dr 2  60                   RTS
000C0Er 2               
000C0Er 2               ; ---------------------------------------------------------------------------
000C0Er 2               ; parse_func_decl — FUNCTION name [ ( params ) ] : RETURN_TYPE ; <block> ;
000C0Er 2               ; The FUNCTION keyword has already been consumed by parse_block @func.
000C0Er 2               ; Mirrors parse_proc_decl but registers SYM_FUNC, parses the return type,
000C0Er 2               ; adds a SYM_RETVAL inner-scope binding (so `name := expr` in the body
000C0Er 2               ; emits OP_STR), and emits OP_RETF as the epilogue.
000C0Er 2               ; ---------------------------------------------------------------------------
000C0Er 2               parse_func_decl:
000C0Er 2               ; expect identifier (func name)
000C0Er 2  A5 rr                LDA     tok_type
000C10r 2  C9 01                CMP     #TOK_IDENT
000C12r 2  F0 01                BEQ     @have_name
000C14r 2  60                   RTS
000C15r 2               @have_name:
000C15r 2               ; Save outer local_alloc_off on 6502 stack — nested func/proc would
000C15r 2               ; otherwise clobber the enclosing frame's allocator state.
000C15r 2  AD rr rr             LDA     local_alloc_off
000C18r 2  48                   PHA
000C19r 2               
000C19r 2               ; save func name into save_name_buf
000C19r 2  A0 0F                LDY     #15
000C1Br 2               @savename:
000C1Br 2  B9 rr rr             LDA     ident_buf,y
000C1Er 2  99 rr rr             STA     save_name_buf,y
000C21r 2  88                   DEY
000C22r 2  10 F7                BPL     @savename
000C24r 2               
000C24r 2  20 rr rr             JSR     next_token      ; consume name
000C27r 2               
000C27r 2               ; Register SYM_FUNC NOW so we have an entry to backpatch.
000C27r 2               ; Type backpatched after we parse `: RETURN_TYPE`.
000C27r 2  AD rr rr             LDA     symtab_count
000C2Ar 2  8D rr rr             STA     proc_entry_idx
000C2Dr 2  AD rr rr             LDA     symtab_count+1
000C30r 2  8D rr rr             STA     proc_entry_idx+1
000C33r 2  20 rr rr             JSR     swap_ident_save ; ident_buf <-> save_name_buf
000C36r 2  A5 rr                LDA     cg_pc
000C38r 2  85 rr                STA     tmp2
000C3Ar 2  A5 rr                LDA     cg_pc+1
000C3Cr 2  85 rr                STA     tmp2+1
000C3Er 2  A9 04                LDA     #SYM_FUNC
000C40r 2  A2 00                LDX     #TY_NONE        ; placeholder
000C42r 2  20 rr rr             JSR     symtab_add
000C45r 2  20 rr rr             JSR     swap_ident_save
000C48r 2               
000C48r 2               ; Enter scope: params, locals, and SYM_RETVAL belong to fn frame.
000C48r 2  20 rr rr             JSR     symtab_enter_scope
000C4Br 2               
000C4Br 2               ; init param count and VAR-mask
000C4Br 2  A9 00                LDA     #0
000C4Dr 2  8D rr rr             STA     proc_param_count
000C50r 2  8D rr rr             STA     param_var_mask
000C53r 2               
000C53r 2               ; Optional parameter list
000C53r 2  A5 rr                LDA     tok_type
000C55r 2  C9 1B                CMP     #TOK_LPAREN
000C57r 2  D0 06                BNE     @after_params
000C59r 2  20 rr rr             JSR     next_token      ; consume '('
000C5Cr 2  20 rr rr             JSR     parse_param_list
000C5Fr 2               
000C5Fr 2               @after_params:
000C5Fr 2               ; Expect ':' then return type
000C5Fr 2  A5 rr                LDA     tok_type
000C61r 2  C9 21                CMP     #TOK_COLON
000C63r 2  D0 03                BNE     :+
000C65r 2  20 rr rr             JSR     next_token
000C68r 2               :
000C68r 2  20 rr rr             JSR     parse_type_spec
000C6Br 2  85 rr                STA     scratch         ; save return type code
000C6Dr 2               
000C6Dr 2               ; Recompute SYM_FUNC entry pointer from proc_entry_idx and backpatch
000C6Dr 2               ; offset 17 (return type) and offset 21 (param count).
000C6Dr 2  AD rr rr             LDA     proc_entry_idx
000C70r 2  0A                   ASL
000C71r 2  0A                   ASL
000C72r 2  0A                   ASL
000C73r 2  0A                   ASL
000C74r 2  0A                   ASL
000C75r 2  18                   CLC
000C76r 2  69 00                ADC     #<SYMTAB_BASE
000C78r 2  85 rr                STA     tmp3
000C7Ar 2  AD rr rr             LDA     proc_entry_idx+1
000C7Dr 2  2A                   ROL
000C7Er 2  69 80                ADC     #>SYMTAB_BASE
000C80r 2  85 rr                STA     tmp3+1
000C82r 2  A0 11                LDY     #17
000C84r 2  A5 rr                LDA     scratch
000C86r 2  91 rr                STA     (tmp3),y
000C88r 2  A0 15                LDY     #21
000C8Ar 2  AD rr rr             LDA     proc_param_count
000C8Dr 2  91 rr                STA     (tmp3),y
000C8Fr 2  A0 16                LDY     #22
000C91r 2  AD rr rr             LDA     param_var_mask
000C94r 2  91 rr                STA     (tmp3),y
000C96r 2               
000C96r 2               ; Initialize local_alloc_off to start right after the params.
000C96r 2               ; VAR declarations in the body extend this; final value is
000C96r 2               ; backpatched into entry offset 23 as the MRKSTK size.
000C96r 2  AD rr rr             LDA     proc_param_count
000C99r 2  0A                   ASL
000C9Ar 2  8D rr rr             STA     local_alloc_off
000C9Dr 2               
000C9Dr 2               ; Add SYM_RETVAL binding: same name as function; assignments to
000C9Dr 2               ; this name in the body emit OP_STR (writes MP+AR_RET_VAL).
000C9Dr 2               ; save_name_buf still holds the function name (parse_param_list uses
000C9Dr 2               ; var_name_buf, not save_name_buf).  Swap it into ident_buf.
000C9Dr 2  20 rr rr             JSR     swap_ident_save
000CA0r 2  A9 00                LDA     #0
000CA2r 2  85 rr                STA     tmp2
000CA4r 2  85 rr                STA     tmp2+1
000CA6r 2  A9 07                LDA     #SYM_RETVAL
000CA8r 2  A2 00                LDX     #TY_NONE
000CAAr 2  20 rr rr             JSR     symtab_add
000CADr 2               
000CADr 2               ; Expect ';' before body
000CADr 2  A5 rr                LDA     tok_type
000CAFr 2  C9 20                CMP     #TOK_SEMICOLON
000CB1r 2  D0 03                BNE     :+
000CB3r 2  20 rr rr             JSR     next_token
000CB6r 2               :
000CB6r 2  20 rr rr             JSR     parse_block
000CB9r 2               
000CB9r 2  20 rr rr             JSR     emit_RETF
000CBCr 2               
000CBCr 2               ; Backpatch total local-area size into the func's symbol entry at
000CBCr 2               ; offset 23 (params + declared body locals).  Caller emits MRKSTK
000CBCr 2               ; with this value so the AR holds all locals below pm_sp.
000CBCr 2  AD rr rr             LDA     proc_entry_idx
000CBFr 2  0A                   ASL
000CC0r 2  0A                   ASL
000CC1r 2  0A                   ASL
000CC2r 2  0A                   ASL
000CC3r 2  0A                   ASL
000CC4r 2  18                   CLC
000CC5r 2  69 00                ADC     #<SYMTAB_BASE
000CC7r 2  85 rr                STA     tmp3
000CC9r 2  AD rr rr             LDA     proc_entry_idx+1
000CCCr 2  2A                   ROL
000CCDr 2  69 80                ADC     #>SYMTAB_BASE
000CCFr 2  85 rr                STA     tmp3+1
000CD1r 2  A0 17                LDY     #23
000CD3r 2  AD rr rr             LDA     local_alloc_off
000CD6r 2  91 rr                STA     (tmp3),y
000CD8r 2               
000CD8r 2  20 rr rr             JSR     symtab_leave_scope
000CDBr 2               
000CDBr 2               ; Consume trailing ';' after END
000CDBr 2  A5 rr                LDA     tok_type
000CDDr 2  C9 20                CMP     #TOK_SEMICOLON
000CDFr 2  D0 03                BNE     :+
000CE1r 2  20 rr rr             JSR     next_token
000CE4r 2               :
000CE4r 2  68                   PLA
000CE5r 2  8D rr rr             STA     local_alloc_off ; restore outer allocator state
000CE8r 2  60                   RTS
000CE9r 2               
000CE9r 2               ; ---------------------------------------------------------------------------
000CE9r 2               ; parse_compound_stmt — BEGIN { statement ; } END
000CE9r 2               ; ---------------------------------------------------------------------------
000CE9r 2               parse_compound_stmt:
000CE9r 2               ; consume BEGIN
000CE9r 2  A5 rr                LDA     tok_type
000CEBr 2  C9 42                CMP     #TOK_BEGIN
000CEDr 2  D0 31                BNE     @done
000CEFr 2  20 rr rr             JSR     next_token
000CF2r 2               @loop:
000CF2r 2  A5 rr                LDA     tok_type
000CF4r 2  C9 49                CMP     #TOK_END
000CF6r 2  F0 25                BEQ     @end
000CF8r 2  C9 00                CMP     #TOK_EOF
000CFAr 2  F0 24                BEQ     @done
000CFCr 2               ; remember tok before parse_statement to detect no-progress
000CFCr 2  85 rr                STA     tmp3
000CFEr 2  20 rr rr             JSR     parse_statement
000D01r 2  A5 rr                LDA     tok_type
000D03r 2  C9 20                CMP     #TOK_SEMICOLON
000D05r 2  F0 11                BEQ     @consume_semi
000D07r 2  C9 49                CMP     #TOK_END
000D09r 2  F0 12                BEQ     @end
000D0Br 2  C9 00                CMP     #TOK_EOF
000D0Dr 2  F0 11                BEQ     @done
000D0Fr 2               ; if parse_statement didn't consume anything, force-advance to avoid
000D0Fr 2               ; an infinite loop on an unrecognised token
000D0Fr 2  C5 rr                CMP     tmp3
000D11r 2  D0 DF                BNE     @loop
000D13r 2  20 rr rr             JSR     next_token
000D16r 2  80 DA                BRA     @loop
000D18r 2               @consume_semi:
000D18r 2  20 rr rr             JSR     next_token
000D1Br 2  80 D5                BRA     @loop
000D1Dr 2               @end:
000D1Dr 2  20 rr rr             JSR     next_token      ; consume END
000D20r 2               @done:
000D20r 2  60                   RTS
000D21r 2               
000D21r 2               ; ---------------------------------------------------------------------------
000D21r 2               ; parse_statement — dispatch based on current token
000D21r 2               ; ---------------------------------------------------------------------------
000D21r 2               parse_statement:
000D21r 2  A5 rr                LDA     tok_type
000D23r 2  C9 42                CMP     #TOK_BEGIN
000D25r 2  F0 15                BEQ     @compound
000D27r 2  C9 4C                CMP     #TOK_IF
000D29r 2  F0 18                BEQ     @if
000D2Br 2  C9 5B                CMP     #TOK_WHILE
000D2Dr 2  F0 18                BEQ     @while
000D2Fr 2  C9 4A                CMP     #TOK_FOR
000D31r 2  F0 18                BEQ     @for
000D33r 2  C9 55                CMP     #TOK_REPEAT
000D35r 2  F0 18                BEQ     @repeat
000D37r 2  C9 01                CMP     #TOK_IDENT
000D39r 2  F0 04                BEQ     @assign_or_call
000D3Br 2  60                   RTS                     ; empty statement
000D3Cr 2               
000D3Cr 2               @compound:
000D3Cr 2  4C rr rr             JMP     parse_compound_stmt
000D3Fr 2               
000D3Fr 2               @assign_or_call:
000D3Fr 2  20 rr rr             JSR     parse_assign_or_call
000D42r 2  60                   RTS
000D43r 2               
000D43r 2               @if:
000D43r 2  20 rr rr             JSR     parse_if
000D46r 2  60                   RTS
000D47r 2               
000D47r 2               @while:
000D47r 2  20 rr rr             JSR     parse_while
000D4Ar 2  60                   RTS
000D4Br 2               
000D4Br 2               @for:
000D4Br 2  20 rr rr             JSR     parse_for
000D4Er 2  60                   RTS
000D4Fr 2               
000D4Fr 2               @repeat:
000D4Fr 2  20 rr rr             JSR     parse_repeat
000D52r 2  60                   RTS
000D53r 2               
000D53r 2               ; ---------------------------------------------------------------------------
000D53r 2               ; parse_assign_or_call — identifier already consumed by caller (in ident_buf)
000D53r 2               ; If next is ':=' → assignment
000D53r 2               ; If next is '(' → procedure call
000D53r 2               ; If identifier is WRITE/WRITELN → built-in I/O
000D53r 2               ; ---------------------------------------------------------------------------
000D53r 2               parse_assign_or_call:
000D53r 2               ; Dispatch built-in I/O procedures by length+initial letter.  RECORD/REPEAT
000D53r 2               ; are reserved keywords so they never reach this dispatch as identifiers.
000D53r 2               ;   len 4 : READ
000D53r 2               ;   len 5 : WRITE  | RESET  | CLOSE
000D53r 2               ;   len 6 : READLN | ASSIGN
000D53r 2               ;   len 7 : WRITELN| REWRITE
000D53r 2  AD rr rr             LDA     ident_buf       ; length
000D56r 2  C9 04                CMP     #4
000D58r 2  F0 61                BEQ     @chk_read
000D5Ar 2  C9 05                CMP     #5
000D5Cr 2  F0 0B                BEQ     @chk_len5
000D5Er 2  C9 06                CMP     #6
000D60r 2  F0 19                BEQ     @chk_len6
000D62r 2  C9 07                CMP     #7
000D64r 2  F0 23                BEQ     @chk_len7
000D66r 2  4C rr rr             JMP     @lookup_sym
000D69r 2               
000D69r 2               @chk_len5:
000D69r 2  AD rr rr             LDA     ident_buf+1
000D6Cr 2  C9 57                CMP     #'W'
000D6Er 2  F0 27                BEQ     @chk_write
000D70r 2  C9 52                CMP     #'R'
000D72r 2  F0 73                BEQ     @chk_reset
000D74r 2  C9 43                CMP     #'C'
000D76r 2  F0 75                BEQ     @chk_close
000D78r 2  4C rr rr             JMP     @lookup_sym
000D7Br 2               
000D7Br 2               @chk_len6:
000D7Br 2  AD rr rr             LDA     ident_buf+1
000D7Er 2  C9 52                CMP     #'R'
000D80r 2  F0 4E                BEQ     @chk_readln
000D82r 2  C9 41                CMP     #'A'
000D84r 2  F0 5E                BEQ     @chk_assign
000D86r 2  4C rr rr             JMP     @lookup_sym
000D89r 2               
000D89r 2               @chk_len7:
000D89r 2  AD rr rr             LDA     ident_buf+1
000D8Cr 2  C9 57                CMP     #'W'
000D8Er 2  F0 15                BEQ     @chk_writeln
000D90r 2  C9 52                CMP     #'R'
000D92r 2  F0 56                BEQ     @chk_rewrite
000D94r 2  4C rr rr             JMP     @lookup_sym
000D97r 2               
000D97r 2               @chk_write:
000D97r 2               ; "WRITE" (5)
000D97r 2  20 rr rr             JSR     next_token
000D9Ar 2  20 rr rr             JSR     parse_write_args        ; X=0 console, X=1 file (file ptr left)
000D9Dr 2  E0 00                CPX     #0
000D9Fr 2  F0 03                BEQ     @w_done
000DA1r 2  20 rr rr             JSR     emit_POP                ; discard leftover file ptr
000DA4r 2               @w_done:
000DA4r 2  60                   RTS
000DA5r 2               
000DA5r 2               @chk_writeln:
000DA5r 2               ; "WRITELN" (7) — first ident_buf char already known 'W'
000DA5r 2  20 rr rr             JSR     next_token
000DA8r 2  A5 rr                LDA     tok_type
000DAAr 2  C9 1B                CMP     #TOK_LPAREN
000DACr 2  D0 0A                BNE     @just_nl
000DAEr 2  20 rr rr             JSR     parse_write_args
000DB1r 2  E0 00                CPX     #0
000DB3r 2  F0 03                BEQ     @just_nl
000DB5r 2  4C rr rr             JMP     emit_FWLN               ; file newline; consumes file ptr
000DB8r 2               @just_nl:
000DB8r 2  4C rr rr             JMP     emit_WRITLN
000DBBr 2               
000DBBr 2               @chk_read:
000DBBr 2               ; "READ" (4)
000DBBr 2  AD rr rr             LDA     ident_buf+1
000DBEr 2  C9 52                CMP     #'R'
000DC0r 2  D0 2E                BNE     @lookup_sym_jmp
000DC2r 2  20 rr rr             JSR     next_token
000DC5r 2  20 rr rr             JSR     parse_read_args
000DC8r 2  E0 00                CPX     #0
000DCAr 2  F0 03                BEQ     @r_done
000DCCr 2  20 rr rr             JSR     emit_POP                ; discard leftover file ptr
000DCFr 2               @r_done:
000DCFr 2  60                   RTS
000DD0r 2               
000DD0r 2               @chk_readln:
000DD0r 2               ; "READLN" (6).  Console: read each var.  File: read each var, then skip EOL.
000DD0r 2  20 rr rr             JSR     next_token
000DD3r 2  A5 rr                LDA     tok_type
000DD5r 2  C9 1B                CMP     #TOK_LPAREN
000DD7r 2  D0 0A                BNE     @rd_done
000DD9r 2  20 rr rr             JSR     parse_read_args
000DDCr 2  E0 00                CPX     #0
000DDEr 2  F0 03                BEQ     @rd_done
000DE0r 2  20 rr rr             JSR     emit_FRDLN              ; consumes file ptr, skips to EOL
000DE3r 2               @rd_done:
000DE3r 2  60                   RTS
000DE4r 2               
000DE4r 2               @chk_assign:
000DE4r 2               ; "ASSIGN" (6)
000DE4r 2  4C rr rr             JMP     parse_builtin_assign
000DE7r 2               @chk_reset:
000DE7r 2               ; "RESET" (5)
000DE7r 2  4C rr rr             JMP     parse_builtin_reset
000DEAr 2               @chk_rewrite:
000DEAr 2               ; "REWRITE" (7)
000DEAr 2  4C rr rr             JMP     parse_builtin_rewrite
000DEDr 2               @chk_close:
000DEDr 2               ; "CLOSE" (5)
000DEDr 2  4C rr rr             JMP     parse_builtin_close
000DF0r 2               
000DF0r 2               @lookup_sym_jmp:
000DF0r 2  4C rr rr             JMP     @lookup_sym
000DF3r 2               
000DF3r 2               @lookup_sym:
000DF3r 2               ; look up identifier in symbol table
000DF3r 2  20 rr rr             JSR     symtab_find
000DF6r 2  B0 0F                BCS     @found_sym
000DF8r 2               ; undefined — error
000DF8r 2  A9 rr                LDA     #<err_undef
000DFAr 2  85 rr                STA     tmp0
000DFCr 2  A9 rr                LDA     #>err_undef
000DFEr 2  85 rr                STA     tmp0+1
000E00r 2  20 rr rr             JSR     compile_error
000E03r 2               ; skip to semicolon / end
000E03r 2  20 rr rr             JSR     next_token
000E06r 2  60                   RTS
000E07r 2               
000E07r 2               @found_sym:
000E07r 2               ; tmp3 = symbol entry pointer. Snapshot the fields we need
000E07r 2               ; before any next_token / parse_expression call clobbers tmp3.
000E07r 2  A0 10                LDY     #16
000E09r 2  B1 rr                LDA     (tmp3),y
000E0Br 2  8D rr rr             STA     sym_save_kind
000E0Er 2  A0 11                LDY     #17
000E10r 2  B1 rr                LDA     (tmp3),y
000E12r 2  8D rr rr             STA     sym_save_type
000E15r 2  A0 14                LDY     #20
000E17r 2  B1 rr                LDA     (tmp3),y
000E19r 2  8D rr rr             STA     sym_save_scope
000E1Cr 2  A0 12                LDY     #18
000E1Er 2  B1 rr                LDA     (tmp3),y
000E20r 2  8D rr rr             STA     sym_save_off
000E23r 2  A0 13                LDY     #19
000E25r 2  B1 rr                LDA     (tmp3),y
000E27r 2  8D rr rr             STA     sym_save_off+1
000E2Ar 2  A0 15                LDY     #21
000E2Cr 2  B1 rr                LDA     (tmp3),y
000E2Er 2  8D rr rr             STA     sym_save_pcount
000E31r 2  A0 16                LDY     #22
000E33r 2  B1 rr                LDA     (tmp3),y
000E35r 2  8D rr rr             STA     sym_save_vmask
000E38r 2  A0 17                LDY     #23
000E3Ar 2  B1 rr                LDA     (tmp3),y
000E3Cr 2  8D rr rr             STA     sym_save_lsize
000E3Fr 2  AD rr rr             LDA     sym_save_kind
000E42r 2  C9 01                CMP     #SYM_VAR
000E44r 2  F0 3C                BEQ     @do_assign
000E46r 2  C9 03                CMP     #SYM_PROC
000E48r 2  D0 03                BNE     :+
000E4Ar 2  4C rr rr             JMP     @do_call
000E4Dr 2               :
000E4Dr 2  C9 07                CMP     #SYM_RETVAL
000E4Fr 2  F0 05                BEQ     @do_retval_assign
000E51r 2  C9 08                CMP     #SYM_VARREF
000E53r 2  F0 14                BEQ     @do_varref_assign
000E55r 2  60                   RTS
000E56r 2               
000E56r 2               @do_retval_assign:
000E56r 2               ; `funcname := expr` inside function body — emit OP_STR which writes
000E56r 2               ; the popped value to the current AR's AR_RET_VAL slot.
000E56r 2  20 rr rr             JSR     next_token      ; consume function name
000E59r 2  A5 rr                LDA     tok_type
000E5Br 2  C9 1A                CMP     #TOK_ASSIGN
000E5Dr 2  D0 03                BNE     :+
000E5Fr 2  20 rr rr             JSR     next_token      ; consume ':='
000E62r 2               :
000E62r 2  20 rr rr             JSR     parse_expression
000E65r 2  20 rr rr             JSR     emit_STR
000E68r 2  60                   RTS
000E69r 2               
000E69r 2               @do_varref_assign:
000E69r 2               ; VAR-by-reference param assignment: `paramname := expr` where the
000E69r 2               ; param's local slot holds an address.  Emit:
000E69r 2               ;   LDL <off>          ; push address (the value passed by caller)
000E69r 2               ;   <expr>             ; push value
000E69r 2               ;   STIND              ; pop val, pop addr, store
000E69r 2  20 rr rr             JSR     next_token      ; consume param name
000E6Cr 2  A5 rr                LDA     tok_type
000E6Er 2  C9 1A                CMP     #TOK_ASSIGN
000E70r 2  D0 03                BNE     :+
000E72r 2  20 rr rr             JSR     next_token      ; consume ':='
000E75r 2               :
000E75r 2  AD rr rr             LDA     sym_save_off
000E78r 2  20 rr rr             JSR     emit_LDL        ; push address from local slot
000E7Br 2  20 rr rr             JSR     parse_expression
000E7Er 2  20 rr rr             JSR     emit_STIND
000E81r 2  60                   RTS
000E82r 2               
000E82r 2               @do_assign:
000E82r 2  20 rr rr             JSR     next_token      ; consume variable name identifier
000E85r 2               ; check for compound-type access (array subscript or record field)
000E85r 2  AD rr rr             LDA     sym_save_type
000E88r 2  C9 05                CMP     #TY_ARRAY
000E8Ar 2  F0 2B                BEQ     @array_assign
000E8Cr 2  C9 06                CMP     #TY_RECORD
000E8Er 2  D0 03                BNE     :+
000E90r 2  4C rr rr             JMP     @record_assign
000E93r 2               :
000E93r 2               ; scalar assignment — expect ':='
000E93r 2  A5 rr                LDA     tok_type
000E95r 2  C9 1A                CMP     #TOK_ASSIGN
000E97r 2  D0 03                BNE     :+
000E99r 2  20 rr rr             JSR     next_token
000E9Cr 2  20 rr rr     :       JSR     parse_expression
000E9Fr 2  AD rr rr             LDA     sym_save_scope
000EA2r 2  D0 0C                BNE     @local_store
000EA4r 2  AD rr rr             LDA     sym_save_off+1
000EA7r 2  85 rr                STA     scratch
000EA9r 2  AD rr rr             LDA     sym_save_off
000EACr 2  20 rr rr             JSR     emit_STG
000EAFr 2  60                   RTS
000EB0r 2               @local_store:
000EB0r 2  AD rr rr             LDA     sym_save_off
000EB3r 2  20 rr rr             JSR     emit_STL
000EB6r 2  60                   RTS
000EB7r 2               
000EB7r 2               @array_assign:
000EB7r 2               ; a[i] := expr
000EB7r 2               ; emit base-address push
000EB7r 2  AD rr rr             LDA     sym_save_scope
000EBAr 2  D0 0D                BNE     @aarr_local
000EBCr 2  AD rr rr             LDA     sym_save_off+1
000EBFr 2  85 rr                STA     scratch
000EC1r 2  AD rr rr             LDA     sym_save_off
000EC4r 2  20 rr rr             JSR     emit_LDA_G
000EC7r 2  80 06                BRA     @aarr_idx
000EC9r 2               @aarr_local:
000EC9r 2  AD rr rr             LDA     sym_save_off
000ECCr 2  20 rr rr             JSR     emit_LDA_L
000ECFr 2               @aarr_idx:
000ECFr 2               ; consume '[', parse index expr, consume ']'
000ECFr 2  A5 rr                LDA     tok_type
000ED1r 2  C9 1D                CMP     #TOK_LBRACK
000ED3r 2  D0 03                BNE     :+
000ED5r 2  20 rr rr             JSR     next_token
000ED8r 2  20 rr rr     :       JSR     parse_expression
000EDBr 2  A5 rr                LDA     tok_type
000EDDr 2  C9 1E                CMP     #TOK_RBRACK
000EDFr 2  D0 03                BNE     :+
000EE1r 2  20 rr rr             JSR     next_token
000EE4r 2               :
000EE4r 2               ; emit INDEX 2 0  (elemsize = 2 words)
000EE4r 2  A9 00                LDA     #0
000EE6r 2  85 rr                STA     scratch
000EE8r 2  A9 02                LDA     #2
000EEAr 2  20 rr rr             JSR     emit_INDEX
000EEDr 2               ; consume ':='
000EEDr 2  A5 rr                LDA     tok_type
000EEFr 2  C9 1A                CMP     #TOK_ASSIGN
000EF1r 2  D0 03                BNE     :+
000EF3r 2  20 rr rr             JSR     next_token
000EF6r 2               :
000EF6r 2               ; parse and emit RHS expression
000EF6r 2  20 rr rr             JSR     parse_expression
000EF9r 2               ; store: NOS=element_addr TOS=value → STIND
000EF9r 2  20 rr rr             JSR     emit_STIND
000EFCr 2  60                   RTS
000EFDr 2               
000EFDr 2               @record_assign:
000EFDr 2               ; v.field := expr
000EFDr 2               ; emit base-address push
000EFDr 2  AD rr rr             LDA     sym_save_scope
000F00r 2  D0 0D                BNE     @rec_la_local
000F02r 2  AD rr rr             LDA     sym_save_off+1
000F05r 2  85 rr                STA     scratch
000F07r 2  AD rr rr             LDA     sym_save_off
000F0Ar 2  20 rr rr             JSR     emit_LDA_G
000F0Dr 2  80 06                BRA     @rec_la_dot
000F0Fr 2               @rec_la_local:
000F0Fr 2  AD rr rr             LDA     sym_save_off
000F12r 2  20 rr rr             JSR     emit_LDA_L
000F15r 2               @rec_la_dot:
000F15r 2               ; consume '.'
000F15r 2  A5 rr                LDA     tok_type
000F17r 2  C9 22                CMP     #TOK_DOT
000F19r 2  D0 03                BNE     :+
000F1Br 2  20 rr rr             JSR     next_token
000F1Er 2               :
000F1Er 2               ; field name now in ident_buf — look up
000F1Er 2  AD rr rr             LDA     sym_save_vmask  ; first_field_idx
000F21r 2  AE rr rr             LDX     sym_save_lsize  ; field_count
000F24r 2  20 rr rr             JSR     field_lookup_in_record
000F27r 2  B0 03                BCS     :+
000F29r 2  4C rr rr             JMP     @rec_la_undef
000F2Cr 2               :
000F2Cr 2               ; A=field offset (0..); X=field type (unused on LHS)
000F2Cr 2  F0 06                BEQ     @rec_la_no_off
000F2Er 2  20 rr rr             JSR     emit_LDCI
000F31r 2  20 rr rr             JSR     emit_ADI
000F34r 2               @rec_la_no_off:
000F34r 2  20 rr rr             JSR     next_token      ; consume field name
000F37r 2               ; expect ':='
000F37r 2  A5 rr                LDA     tok_type
000F39r 2  C9 1A                CMP     #TOK_ASSIGN
000F3Br 2  D0 03                BNE     :+
000F3Dr 2  20 rr rr             JSR     next_token
000F40r 2               :
000F40r 2  20 rr rr             JSR     parse_expression
000F43r 2  20 rr rr             JSR     emit_STIND
000F46r 2  60                   RTS
000F47r 2               @rec_la_undef:
000F47r 2  A9 rr                LDA     #<err_undef
000F49r 2  85 rr                STA     tmp0
000F4Br 2  A9 rr                LDA     #>err_undef
000F4Dr 2  85 rr                STA     tmp0+1
000F4Fr 2  20 rr rr             JSR     compile_error
000F52r 2  60                   RTS
000F53r 2               
000F53r 2               @do_call:
000F53r 2               ; Phase B: value parameters (INTEGER words, 2 bytes each).
000F53r 2               ; sym_save_off       = proc's code address
000F53r 2               ; sym_save_pcount    = declared parameter count
000F53r 2               ;
000F53r 2               ; Calling sequence emitted:
000F53r 2               ;   MRKSTK <pcount*2>            ; reserves AR + param slots
000F53r 2               ;   for each arg i:
000F53r 2               ;       <expr>                   ; pushes value to TOS
000F53r 2               ;       STL <i*2>                ; pop into local slot i
000F53r 2               ;   CALL <proc>                  ; jump (saves IPC into AR)
000F53r 2               ;
000F53r 2               ; The procedure body reads params via LDL because they were added
000F53r 2               ; to the symbol table as SYM_VAR with scope=inner (proc) at
000F53r 2               ; offsets 0, 2, 4, ...
000F53r 2  20 rr rr             JSR     next_token      ; consume the proc-name identifier
000F56r 2               ; emit MRKSTK with full local-area size (params + body locals).
000F56r 2               ; sym_save_lsize was captured at @found_sym from entry offset 23.
000F56r 2  AD rr rr             LDA     sym_save_lsize
000F59r 2  20 rr rr             JSR     emit_MRKSTK
000F5Cr 2               ; if no params, optionally consume "()" then emit CALL
000F5Cr 2  AD rr rr             LDA     sym_save_pcount
000F5Fr 2  F0 4A                BEQ     @no_args
000F61r 2               ; expect '(' for arg list
000F61r 2  A5 rr                LDA     tok_type
000F63r 2  C9 1B                CMP     #TOK_LPAREN
000F65r 2  D0 56                BNE     @emit_call      ; missing '(' — caller mistake; emit CALL anyway
000F67r 2  20 rr rr             JSR     next_token      ; consume '('
000F6Ar 2  A2 00                LDX     #0              ; X = current arg index
000F6Cr 2               @arg_loop:
000F6Cr 2               ; If sym_save_vmask bit X is set, this arg is VAR (push address).
000F6Cr 2               ; Otherwise parse_expression (push value).
000F6Cr 2  DA                   PHX
000F6Dr 2  A9 01                LDA     #1
000F6Fr 2               @vbit:
000F6Fr 2  E0 00                CPX     #0
000F71r 2  F0 04                BEQ     @vdone
000F73r 2  0A                   ASL
000F74r 2  CA                   DEX
000F75r 2  80 F8                BRA     @vbit
000F77r 2               @vdone:
000F77r 2  FA                   PLX                     ; restore loop counter
000F78r 2  2D rr rr             AND     sym_save_vmask
000F7Br 2  F0 07                BEQ     @arg_value
000F7Dr 2  DA                   PHX
000F7Er 2  20 rr rr             JSR     parse_arg_lvalue
000F81r 2  FA                   PLX
000F82r 2  80 05                BRA     @arg_stored
000F84r 2               @arg_value:
000F84r 2  DA                   PHX
000F85r 2  20 rr rr             JSR     parse_expression
000F88r 2  FA                   PLX
000F89r 2               @arg_stored:
000F89r 2               ; emit STL <X*2> — store popped value (or address) into local slot X
000F89r 2  8A                   TXA
000F8Ar 2  0A                   ASL
000F8Br 2  20 rr rr             JSR     emit_STL
000F8Er 2  E8                   INX
000F8Fr 2  EC rr rr             CPX     sym_save_pcount
000F92r 2  B0 0C                BCS     @done_args      ; X >= pcount — done
000F94r 2               ; expect comma between args
000F94r 2  A5 rr                LDA     tok_type
000F96r 2  C9 1F                CMP     #TOK_COMMA
000F98r 2  D0 06                BNE     @done_args
000F9Ar 2  20 rr rr             JSR     next_token      ; consume ','
000F9Dr 2  4C rr rr             JMP     @arg_loop       ; jmp — body grew past bra range
000FA0r 2               @done_args:
000FA0r 2  A5 rr                LDA     tok_type
000FA2r 2  C9 1C                CMP     #TOK_RPAREN
000FA4r 2  D0 17                BNE     @emit_call
000FA6r 2  20 rr rr             JSR     next_token      ; consume ')'
000FA9r 2  80 12                BRA     @emit_call
000FABr 2               @no_args:
000FABr 2               ; No declared params — accept and skip "()" if present.
000FABr 2  A5 rr                LDA     tok_type
000FADr 2  C9 1B                CMP     #TOK_LPAREN
000FAFr 2  D0 0C                BNE     @emit_call
000FB1r 2  20 rr rr             JSR     next_token      ; consume '('
000FB4r 2  A5 rr                LDA     tok_type
000FB6r 2  C9 1C                CMP     #TOK_RPAREN
000FB8r 2  D0 03                BNE     @emit_call
000FBAr 2  20 rr rr             JSR     next_token      ; consume ')'
000FBDr 2               @emit_call:
000FBDr 2               ; Emit CALL <delta>: A=target lo, scratch=target hi
000FBDr 2  AD rr rr             LDA     sym_save_off+1
000FC0r 2  85 rr                STA     scratch
000FC2r 2  AD rr rr             LDA     sym_save_off
000FC5r 2  20 rr rr             JSR     emit_CALL
000FC8r 2  60                   RTS
000FC9r 2               
000FC9r 2               ; ---------------------------------------------------------------------------
000FC9r 2               ; parse_write_args — WRITE/WRITELN argument list.
000FC9r 2               ;   Returns X=0 if console mode (caller emits WRITLN normally),
000FC9r 2               ;           X=1 if file mode (file ptr left on stack — caller emits FWLN
000FC9r 2               ;               or POP to consume it).
000FC9r 2               ; ---------------------------------------------------------------------------
000FC9r 2               parse_write_args:
000FC9r 2  A5 rr                LDA     tok_type
000FCBr 2  C9 1B                CMP     #TOK_LPAREN
000FCDr 2  D0 2F                BNE     @done_console
000FCFr 2  20 rr rr             JSR     next_token              ; consume '('
000FD2r 2  A5 rr                LDA     tok_type
000FD4r 2  C9 1C                CMP     #TOK_RPAREN
000FD6r 2  F0 1D                BEQ     @close_console
000FD8r 2  20 rr rr             JSR     parse_expression        ; parse first arg
000FDBr 2               ; If first arg is TY_TEXT, switch to file mode (leave file ptr on stack).
000FDBr 2  A5 rr                LDA     expr_type
000FDDr 2  C9 08                CMP     #TY_TEXT
000FDFr 2  F0 20                BEQ     @file_mode
000FE1r 2               ; Console mode — emit appropriate WRIT* for first arg, then loop.
000FE1r 2  20 rr rr             JSR     pw_emit_console
000FE4r 2               @cons_loop:
000FE4r 2  A5 rr                LDA     tok_type
000FE6r 2  C9 1F                CMP     #TOK_COMMA
000FE8r 2  D0 0B                BNE     @close_console
000FEAr 2  20 rr rr             JSR     next_token              ; consume ','
000FEDr 2  20 rr rr             JSR     parse_expression
000FF0r 2  20 rr rr             JSR     pw_emit_console
000FF3r 2  80 EF                BRA     @cons_loop
000FF5r 2               @close_console:
000FF5r 2  A5 rr                LDA     tok_type
000FF7r 2  C9 1C                CMP     #TOK_RPAREN
000FF9r 2  D0 03                BNE     :+
000FFBr 2  20 rr rr             JSR     next_token              ; consume ')'
000FFEr 2               :
000FFEr 2               @done_console:
000FFEr 2  A2 00                LDX     #0
001000r 2  60                   RTS
001001r 2               
001001r 2               @file_mode:
001001r 2               @file_loop:
001001r 2  A5 rr                LDA     tok_type
001003r 2  C9 1F                CMP     #TOK_COMMA
001005r 2  D0 0E                BNE     @close_file
001007r 2  20 rr rr             JSR     next_token              ; consume ','
00100Ar 2  20 rr rr             JSR     emit_DUP                ; dup file ptr (consumed by FWRX)
00100Dr 2  20 rr rr             JSR     parse_expression        ; arg on top of stack
001010r 2  20 rr rr             JSR     pw_emit_file
001013r 2  80 EC                BRA     @file_loop
001015r 2               @close_file:
001015r 2  A5 rr                LDA     tok_type
001017r 2  C9 1C                CMP     #TOK_RPAREN
001019r 2  D0 03                BNE     :+
00101Br 2  20 rr rr             JSR     next_token              ; consume ')'
00101Er 2               :
00101Er 2  A2 01                LDX     #1
001020r 2  60                   RTS
001021r 2               
001021r 2               ; pw_emit_console — emit WRITS/WRITC/WRITB/WRITI based on expr_type
001021r 2               pw_emit_console:
001021r 2  A5 rr                LDA     expr_type
001023r 2  C9 04                CMP     #TY_STRING
001025r 2  D0 03                BNE     :+
001027r 2  4C rr rr             JMP     emit_WRITS
00102Ar 2               :
00102Ar 2  C9 02                CMP     #TY_CHAR
00102Cr 2  D0 03                BNE     :+
00102Er 2  4C rr rr             JMP     emit_WRITC
001031r 2               :
001031r 2  C9 03                CMP     #TY_BOOL
001033r 2  D0 03                BNE     :+
001035r 2  4C rr rr             JMP     emit_WRITB
001038r 2               :
001038r 2  4C rr rr             JMP     emit_WRITI
00103Br 2               
00103Br 2               ; pw_emit_file — emit FWRS/FWRC/FWRB/FWRI based on expr_type
00103Br 2               pw_emit_file:
00103Br 2  A5 rr                LDA     expr_type
00103Dr 2  C9 04                CMP     #TY_STRING
00103Fr 2  D0 03                BNE     :+
001041r 2  4C rr rr             JMP     emit_FWRS
001044r 2               :
001044r 2  C9 02                CMP     #TY_CHAR
001046r 2  D0 03                BNE     :+
001048r 2  4C rr rr             JMP     emit_FWRC
00104Br 2               :
00104Br 2  C9 03                CMP     #TY_BOOL
00104Dr 2  D0 03                BNE     :+
00104Fr 2  4C rr rr             JMP     emit_FWRB
001052r 2               :
001052r 2  4C rr rr             JMP     emit_FWRI
001055r 2               
001055r 2               ; ---------------------------------------------------------------------------
001055r 2               ; parse_read_args — READ/READLN argument list.  Each argument must be a
001055r 2               ; variable identifier.  For each, push the variable's address (LDA_G /
001055r 2               ; LDA_L / LDL passthrough for VAR-ref params) then emit OP_READI which
001055r 2               ; pops the address, reads a line from the console, parses a decimal
001055r 2               ; integer, and stores it as a 16-bit word at that address.
001055r 2               ; ---------------------------------------------------------------------------
001055r 2               parse_read_args:
001055r 2  A5 rr                LDA     tok_type
001057r 2  C9 1B                CMP     #TOK_LPAREN
001059r 2  D0 40                BNE     @rdone_console
00105Br 2  20 rr rr             JSR     next_token              ; consume '('
00105Er 2  A5 rr                LDA     tok_type
001060r 2  C9 1C                CMP     #TOK_RPAREN
001062r 2  F0 2E                BEQ     @rclose_console
001064r 2  C9 01                CMP     #TOK_IDENT
001066r 2  D0 2A                BNE     @rclose_console
001068r 2               ; Peek: is the first ident a TY_TEXT variable?
001068r 2  20 rr rr             JSR     symtab_find
00106Br 2  90 08                BCC     @cons_first
00106Dr 2  A0 11                LDY     #17
00106Fr 2  B1 rr                LDA     (tmp3),y
001071r 2  C9 08                CMP     #TY_TEXT
001073r 2  F0 29                BEQ     @file_first
001075r 2               @cons_first:
001075r 2  20 rr rr             JSR     parse_arg_lvalue        ; push address of var
001078r 2  20 rr rr             JSR     emit_READI              ; pop addr, read int, store word
00107Br 2               @cons_loop:
00107Br 2  A5 rr                LDA     tok_type
00107Dr 2  C9 1F                CMP     #TOK_COMMA
00107Fr 2  D0 11                BNE     @rclose_console
001081r 2  20 rr rr             JSR     next_token
001084r 2  A5 rr                LDA     tok_type
001086r 2  C9 01                CMP     #TOK_IDENT
001088r 2  D0 08                BNE     @rclose_console
00108Ar 2  20 rr rr             JSR     parse_arg_lvalue
00108Dr 2  20 rr rr             JSR     emit_READI
001090r 2  80 E9                BRA     @cons_loop
001092r 2               @rclose_console:
001092r 2  A5 rr                LDA     tok_type
001094r 2  C9 1C                CMP     #TOK_RPAREN
001096r 2  D0 03                BNE     :+
001098r 2  20 rr rr             JSR     next_token              ; consume ')'
00109Br 2               :
00109Br 2               @rdone_console:
00109Br 2  A2 00                LDX     #0
00109Dr 2  60                   RTS
00109Er 2               
00109Er 2               @file_first:
00109Er 2               ; Push the file ptr (struct address) by parsing the ident as an expression —
00109Er 2               ; for TY_TEXT this emits LDA_G/LDA_L which pushes the struct's address.
00109Er 2  20 rr rr             JSR     parse_expression
0010A1r 2               @file_loop:
0010A1r 2  A5 rr                LDA     tok_type
0010A3r 2  C9 1F                CMP     #TOK_COMMA
0010A5r 2  D0 3B                BNE     @close_file
0010A7r 2  20 rr rr             JSR     next_token              ; consume ','
0010AAr 2  A5 rr                LDA     tok_type
0010ACr 2  C9 01                CMP     #TOK_IDENT
0010AEr 2  D0 32                BNE     @close_file
0010B0r 2               ; Peek var type so we know whether to emit FRDC, FRDS, or FRDI.
0010B0r 2  20 rr rr             JSR     symtab_find
0010B3r 2  90 22                BCC     @file_int_default
0010B5r 2  A0 11                LDY     #17
0010B7r 2  B1 rr                LDA     (tmp3),y
0010B9r 2  C9 02                CMP     #TY_CHAR
0010BBr 2  D0 0B                BNE     @file_chk_str
0010BDr 2  20 rr rr             JSR     emit_DUP                ; dup file ptr
0010C0r 2  20 rr rr             JSR     parse_arg_lvalue
0010C3r 2  20 rr rr             JSR     emit_FRDC
0010C6r 2  80 D9                BRA     @file_loop
0010C8r 2               @file_chk_str:
0010C8r 2  C9 04                CMP     #TY_STRING
0010CAr 2  D0 0B                BNE     @file_int_default
0010CCr 2  20 rr rr             JSR     emit_DUP                ; dup file ptr
0010CFr 2  20 rr rr             JSR     parse_arg_lvalue
0010D2r 2  20 rr rr             JSR     emit_FRDS
0010D5r 2  80 CA                BRA     @file_loop
0010D7r 2               @file_int_default:
0010D7r 2  20 rr rr             JSR     emit_DUP                ; dup file ptr
0010DAr 2  20 rr rr             JSR     parse_arg_lvalue
0010DDr 2  20 rr rr             JSR     emit_FRDI
0010E0r 2  80 BF                BRA     @file_loop
0010E2r 2               @close_file:
0010E2r 2  A5 rr                LDA     tok_type
0010E4r 2  C9 1C                CMP     #TOK_RPAREN
0010E6r 2  D0 03                BNE     :+
0010E8r 2  20 rr rr             JSR     next_token              ; consume ')'
0010EBr 2               :
0010EBr 2  A2 01                LDX     #1
0010EDr 2  60                   RTS
0010EEr 2               
0010EEr 2               ; ---------------------------------------------------------------------------
0010EEr 2               ; parse_if — IF expr THEN stmt [ ELSE stmt ]
0010EEr 2               ; ---------------------------------------------------------------------------
0010EEr 2               parse_if:
0010EEr 2  20 rr rr             JSR     next_token      ; consume IF
0010F1r 2  20 rr rr             JSR     parse_expression
0010F4r 2               ; emit FJP with placeholder; save patch addr on 6502 stack
0010F4r 2               ; (parse_statement will clobber tmp2 / scratch)
0010F4r 2  20 rr rr             JSR     emit_FJP        ; A=patch_lo, scratch=patch_hi
0010F7r 2  48                   PHA                     ; save FJP patch lo
0010F8r 2  A5 rr                LDA     scratch
0010FAr 2  48                   PHA                     ; save FJP patch hi
0010FBr 2               ; THEN
0010FBr 2  A5 rr                LDA     tok_type
0010FDr 2  C9 56                CMP     #TOK_THEN
0010FFr 2  D0 03                BNE     :+
001101r 2  20 rr rr             JSR     next_token
001104r 2               :
001104r 2  20 rr rr             JSR     parse_statement
001107r 2               ; check for ELSE
001107r 2  A5 rr                LDA     tok_type
001109r 2  C9 48                CMP     #TOK_ELSE
00110Br 2  D0 30                BNE     @patch_then
00110Dr 2               ; emit UJP over else branch
00110Dr 2  20 rr rr             JSR     emit_UJP        ; A=patch_lo, scratch=patch_hi
001110r 2  48                   PHA                     ; save UJP patch lo
001111r 2  A5 rr                LDA     scratch
001113r 2  48                   PHA                     ; save UJP patch hi
001114r 2               ; restore FJP patch addr into tmp2 and patch it to here
001114r 2               ; (need to dig under the UJP entries on the stack)
001114r 2               ; stack top → bottom: UJP_hi, UJP_lo, FJP_hi, FJP_lo
001114r 2  68                   PLA                     ; UJP hi
001115r 2  8D rr rr             STA     sym_save_off    ; reuse sym_save_off as temp byte
001118r 2  68                   PLA                     ; UJP lo
001119r 2  8D rr rr             STA     sym_save_off+1
00111Cr 2  68                   PLA                     ; FJP hi
00111Dr 2  85 rr                STA     tmp2+1
00111Fr 2  68                   PLA                     ; FJP lo
001120r 2  85 rr                STA     tmp2
001122r 2  20 rr rr             JSR     patch_jump      ; patch FJP → start of else branch
001125r 2               ; push UJP patch addr back for after-else patching
001125r 2  AD rr rr             LDA     sym_save_off+1  ; UJP lo
001128r 2  48                   PHA
001129r 2  AD rr rr             LDA     sym_save_off    ; UJP hi
00112Cr 2  48                   PHA
00112Dr 2  20 rr rr             JSR     next_token      ; consume ELSE
001130r 2  20 rr rr             JSR     parse_statement
001133r 2               ; patch UJP to here
001133r 2  68                   PLA                     ; UJP hi
001134r 2  85 rr                STA     tmp2+1
001136r 2  68                   PLA                     ; UJP lo
001137r 2  85 rr                STA     tmp2
001139r 2  20 rr rr             JSR     patch_jump
00113Cr 2  60                   RTS
00113Dr 2               @patch_then:
00113Dr 2               ; no ELSE — restore FJP patch addr and patch to here
00113Dr 2  68                   PLA                     ; FJP hi
00113Er 2  85 rr                STA     tmp2+1
001140r 2  68                   PLA                     ; FJP lo
001141r 2  85 rr                STA     tmp2
001143r 2  20 rr rr             JSR     patch_jump
001146r 2  60                   RTS
001147r 2               
001147r 2               ; ---------------------------------------------------------------------------
001147r 2               ; parse_while — WHILE expr DO stmt
001147r 2               ; ---------------------------------------------------------------------------
001147r 2               parse_while:
001147r 2  20 rr rr             JSR     next_token      ; consume WHILE
00114Ar 2               ; save loop top
00114Ar 2  A5 rr                LDA     cg_pc
00114Cr 2  85 rr                STA     tmp2
00114Er 2  A5 rr                LDA     cg_pc+1
001150r 2  85 rr                STA     tmp2+1
001152r 2               ; we'll need loop_top later; save on 6502 stack
001152r 2  A5 rr                LDA     tmp2+1
001154r 2  48                   PHA
001155r 2  A5 rr                LDA     tmp2
001157r 2  48                   PHA
001158r 2  20 rr rr             JSR     parse_expression
00115Br 2  20 rr rr             JSR     emit_FJP        ; exit if false
00115Er 2  48                   PHA
00115Fr 2  A5 rr                LDA     scratch
001161r 2  48                   PHA
001162r 2               ; DO
001162r 2  A5 rr                LDA     tok_type
001164r 2  C9 46                CMP     #TOK_DO
001166r 2  D0 03                BNE     :+
001168r 2  20 rr rr             JSR     next_token
00116Br 2               :
00116Br 2  20 rr rr             JSR     parse_statement
00116Er 2               ; emit UJP back to loop top
00116Er 2  A9 50                LDA     #OP_UJP
001170r 2  20 rr rr             JSR     emit_byte
001173r 2               ; offset = loop_top - (cg_pc + 2)
001173r 2  68                   PLA
001174r 2  85 rr                STA     tmp3            ; FJP patch hi
001176r 2  68                   PLA
001177r 2  85 rr                STA     tmp3+1          ; FJP patch lo — note: reversed from earlier push
001179r 2               ; compute back-edge offset
001179r 2  68                   PLA                     ; loop_top lo
00117Ar 2  85 rr                STA     tmp2
00117Cr 2  68                   PLA                     ; loop_top hi
00117Dr 2  85 rr                STA     tmp2+1
00117Fr 2               ; delta = loop_top - (cg_pc + 2)
00117Fr 2  38                   SEC
001180r 2  A5 rr                LDA     tmp2
001182r 2  E5 rr                SBC     cg_pc
001184r 2  85 rr                STA     scratch
001186r 2  A5 rr                LDA     tmp2+1
001188r 2  E5 rr                SBC     cg_pc+1
00118Ar 2  85 rr                STA     scratch+1
00118Cr 2  A5 rr                LDA     scratch
00118Er 2  38                   SEC
00118Fr 2  E9 02                SBC     #2
001191r 2  85 rr                STA     scratch
001193r 2  B0 02                BCS     :+
001195r 2  C6 rr                DEC     scratch+1
001197r 2               :
001197r 2  A5 rr                LDA     scratch
001199r 2  20 rr rr             JSR     emit_byte
00119Cr 2  A5 rr                LDA     scratch+1
00119Er 2  20 rr rr             JSR     emit_byte
0011A1r 2               ; patch FJP exit
0011A1r 2               ; tmp3+1:tmp3 holds FJP patch addr (note push order was lo,hi → pla gets hi first)
0011A1r 2               ; Rebuild properly:
0011A1r 2  A5 rr                LDA     tmp3+1
0011A3r 2  85 rr                STA     tmp2
0011A5r 2  A5 rr                LDA     tmp3
0011A7r 2  85 rr                STA     tmp2+1
0011A9r 2  20 rr rr             JSR     patch_jump
0011ACr 2  60                   RTS
0011ADr 2               
0011ADr 2               ; ---------------------------------------------------------------------------
0011ADr 2               ; parse_for — FOR id := expr TO|DOWNTO expr DO stmt
0011ADr 2               ;
0011ADr 2               ; Codegen layout:
0011ADr 2               ;   <init>:   parse expr1; STG/STL var
0011ADr 2               ;             parse expr2; STG hidden_global   (limit, evaluated once)
0011ADr 2               ;   loop_top: LDG/LDL var; LDG hidden_global
0011ADr 2               ;             LEQI (TO) | GEQI (DOWNTO)
0011ADr 2               ;             FJP exit
0011ADr 2               ;             <body>
0011ADr 2               ;             LDG/LDL var; LDCI 1; ADI|SBI; STG/STL var
0011ADr 2               ;             UJP loop_top
0011ADr 2               ;   exit:
0011ADr 2               ;
0011ADr 2               ; State on 6502 stack across body:
0011ADr 2               ;   var_off_lo, var_off_hi, var_scope, dir, lim_off_hi, lim_off_lo
0011ADr 2               ; for_loop_top / for_patch live in zp (FOR is not nestable in this build).
0011ADr 2               ; ---------------------------------------------------------------------------
0011ADr 2               parse_for:
0011ADr 2  20 rr rr             JSR     next_token      ; consume FOR
0011B0r 2               
0011B0r 2  A5 rr                LDA     tok_type
0011B2r 2  C9 01                CMP     #TOK_IDENT
0011B4r 2  F0 01                BEQ     :+
0011B6r 2  60                   RTS                     ; not an ident — silently bail
0011B7r 2               :
0011B7r 2  20 rr rr             JSR     symtab_find
0011BAr 2  B0 04                BCS     :+
0011BCr 2  20 rr rr             JSR     next_token      ; consume the bad ident
0011BFr 2  60                   RTS
0011C0r 2               :
0011C0r 2               ; snapshot var info into sym_save_*
0011C0r 2  A0 14                LDY     #20
0011C2r 2  B1 rr                LDA     (tmp3),y
0011C4r 2  8D rr rr             STA     sym_save_scope
0011C7r 2  A0 12                LDY     #18
0011C9r 2  B1 rr                LDA     (tmp3),y
0011CBr 2  8D rr rr             STA     sym_save_off
0011CEr 2  A0 13                LDY     #19
0011D0r 2  B1 rr                LDA     (tmp3),y
0011D2r 2  8D rr rr             STA     sym_save_off+1
0011D5r 2  20 rr rr             JSR     next_token      ; consume identifier
0011D8r 2               
0011D8r 2               ; push var info: scope, off_hi, off_lo (top)
0011D8r 2  AD rr rr             LDA     sym_save_scope
0011DBr 2  48                   PHA
0011DCr 2  AD rr rr             LDA     sym_save_off+1
0011DFr 2  48                   PHA
0011E0r 2  AD rr rr             LDA     sym_save_off
0011E3r 2  48                   PHA
0011E4r 2               
0011E4r 2               ; ':='
0011E4r 2  A5 rr                LDA     tok_type
0011E6r 2  C9 1A                CMP     #TOK_ASSIGN
0011E8r 2  D0 03                BNE     :+
0011EAr 2  20 rr rr             JSR     next_token
0011EDr 2               :
0011EDr 2  20 rr rr             JSR     parse_expression; initial value on TOS
0011F0r 2               
0011F0r 2               ; restore sym_save_* (parse_expression may have clobbered them)
0011F0r 2  68                   PLA
0011F1r 2  8D rr rr             STA     sym_save_off
0011F4r 2  68                   PLA
0011F5r 2  8D rr rr             STA     sym_save_off+1
0011F8r 2  68                   PLA
0011F9r 2  8D rr rr             STA     sym_save_scope
0011FCr 2  20 rr rr             JSR     for_emit_store_var
0011FFr 2               
0011FFr 2               ; re-push var info for use after loop
0011FFr 2  AD rr rr             LDA     sym_save_scope
001202r 2  48                   PHA
001203r 2  AD rr rr             LDA     sym_save_off+1
001206r 2  48                   PHA
001207r 2  AD rr rr             LDA     sym_save_off
00120Ar 2  48                   PHA
00120Br 2               
00120Br 2               ; direction byte: 0 = TO, 1 = DOWNTO
00120Br 2  A9 00                LDA     #0
00120Dr 2  A6 rr                LDX     tok_type
00120Fr 2  E0 47                CPX     #TOK_DOWNTO
001211r 2  D0 02                BNE     :+
001213r 2  A9 01                LDA     #1
001215r 2               :
001215r 2  48                   PHA                     ; push dir
001216r 2  20 rr rr             JSR     next_token      ; consume TO / DOWNTO
001219r 2               
001219r 2               ; parse limit expression and store to a hidden global
001219r 2  20 rr rr             JSR     parse_expression
00121Cr 2  20 rr rr             JSR     codegen_alloc_global; tmp2 = hidden offset
00121Fr 2               ; push the offset NOW — emit_STG will clobber tmp2
00121Fr 2  A5 rr                LDA     tmp2+1
001221r 2  48                   PHA                     ; lim_hi
001222r 2  A5 rr                LDA     tmp2
001224r 2  48                   PHA                     ; lim_lo (top)
001225r 2               ; reload from stack peek for emit_STG (A = lo, scratch = hi)
001225r 2  BA                   TSX
001226r 2  BD 02 01             LDA     $0102,x
001229r 2  85 rr                STA     scratch
00122Br 2  BD 01 01             LDA     $0101,x
00122Er 2  20 rr rr             JSR     emit_STG
001231r 2               
001231r 2               ; consume DO
001231r 2  A5 rr                LDA     tok_type
001233r 2  C9 46                CMP     #TOK_DO
001235r 2  D0 03                BNE     :+
001237r 2  20 rr rr             JSR     next_token
00123Ar 2               :
00123Ar 2               ; --- loop top ---
00123Ar 2  A5 rr                LDA     cg_pc
00123Cr 2  85 rr                STA     for_loop_top
00123Er 2  A5 rr                LDA     cg_pc+1
001240r 2  85 rr                STA     for_loop_top+1
001242r 2               
001242r 2               ; emit LDG/LDL var — restore sym_save_* via TSX peek
001242r 2               ; stack from top: lim_lo, lim_hi, dir, var_lo, var_hi, var_scope
001242r 2  BA                   TSX
001243r 2  BD 04 01             LDA     $0104,x         ; var_lo
001246r 2  8D rr rr             STA     sym_save_off
001249r 2  BD 05 01             LDA     $0105,x         ; var_hi
00124Cr 2  8D rr rr             STA     sym_save_off+1
00124Fr 2  BD 06 01             LDA     $0106,x         ; var_scope
001252r 2  8D rr rr             STA     sym_save_scope
001255r 2  20 rr rr             JSR     for_emit_load_var
001258r 2               
001258r 2               ; emit LDG limit — limit hi at $0102,x, lo at $0101,x
001258r 2  BA                   TSX
001259r 2  BD 02 01             LDA     $0102,x
00125Cr 2  85 rr                STA     scratch
00125Er 2  BD 01 01             LDA     $0101,x
001261r 2  20 rr rr             JSR     emit_LDG
001264r 2               
001264r 2               ; comparison: TO → LEQI (var <= limit), DOWNTO → GEQI
001264r 2  BA                   TSX
001265r 2  BD 03 01             LDA     $0103,x         ; dir
001268r 2  F0 05                BEQ     @cmp_to
00126Ar 2  20 rr rr             JSR     emit_GEQI
00126Dr 2  80 03                BRA     @cmp_done
00126Fr 2               @cmp_to:
00126Fr 2  20 rr rr             JSR     emit_LEQI
001272r 2               @cmp_done:
001272r 2               
001272r 2               ; FJP exit placeholder
001272r 2  20 rr rr             JSR     emit_FJP        ; A=patch_lo, scratch=patch_hi
001275r 2  85 rr                STA     for_patch
001277r 2  A5 rr                LDA     scratch
001279r 2  85 rr                STA     for_patch+1
00127Br 2               
00127Br 2               ; --- body ---
00127Br 2  20 rr rr             JSR     parse_statement
00127Er 2               
00127Er 2               ; --- pop state in reverse push order ---
00127Er 2  68                   PLA                     ; lim_lo (discard)
00127Fr 2  68                   PLA                     ; lim_hi (discard)
001280r 2  68                   PLA                     ; direction
001281r 2  8D rr rr             STA     sym_save_kind   ; reuse for direction storage
001284r 2  68                   PLA                     ; var_lo
001285r 2  8D rr rr             STA     sym_save_off
001288r 2  68                   PLA                     ; var_hi
001289r 2  8D rr rr             STA     sym_save_off+1
00128Cr 2  68                   PLA                     ; var_scope
00128Dr 2  8D rr rr             STA     sym_save_scope
001290r 2               
001290r 2               ; emit increment / decrement: LDG var, LDCI 1, ADI|SBI, STG var
001290r 2  20 rr rr             JSR     for_emit_load_var
001293r 2  A9 01                LDA     #1
001295r 2  20 rr rr             JSR     emit_LDCI
001298r 2  AD rr rr             LDA     sym_save_kind   ; direction
00129Br 2  F0 05                BEQ     @inc
00129Dr 2  20 rr rr             JSR     emit_SBI
0012A0r 2  80 03                BRA     @inc_done
0012A2r 2               @inc:
0012A2r 2  20 rr rr             JSR     emit_ADI
0012A5r 2               @inc_done:
0012A5r 2  20 rr rr             JSR     for_emit_store_var
0012A8r 2               
0012A8r 2               ; emit UJP back to loop_top
0012A8r 2               ; offset = for_loop_top - (cg_pc_after_opcode + 2)
0012A8r 2  A9 50                LDA     #OP_UJP
0012AAr 2  20 rr rr             JSR     emit_byte
0012ADr 2  38                   SEC
0012AEr 2  A5 rr                LDA     for_loop_top
0012B0r 2  E5 rr                SBC     cg_pc
0012B2r 2  85 rr                STA     scratch
0012B4r 2  A5 rr                LDA     for_loop_top+1
0012B6r 2  E5 rr                SBC     cg_pc+1
0012B8r 2  85 rr                STA     scratch+1
0012BAr 2  38                   SEC
0012BBr 2  A5 rr                LDA     scratch
0012BDr 2  E9 02                SBC     #2
0012BFr 2  85 rr                STA     scratch
0012C1r 2  B0 02                BCS     :+
0012C3r 2  C6 rr                DEC     scratch+1
0012C5r 2               :
0012C5r 2  A5 rr                LDA     scratch
0012C7r 2  20 rr rr             JSR     emit_byte
0012CAr 2  A5 rr                LDA     scratch+1
0012CCr 2  20 rr rr             JSR     emit_byte
0012CFr 2               
0012CFr 2               ; patch FJP exit
0012CFr 2  A5 rr                LDA     for_patch
0012D1r 2  85 rr                STA     tmp2
0012D3r 2  A5 rr                LDA     for_patch+1
0012D5r 2  85 rr                STA     tmp2+1
0012D7r 2  20 rr rr             JSR     patch_jump
0012DAr 2  60                   RTS
0012DBr 2               
0012DBr 2               ; ---------------------------------------------------------------------------
0012DBr 2               ; for_emit_load_var / for_emit_store_var — emit LDG/LDL or STG/STL based on
0012DBr 2               ; sym_save_scope (0 = global) and sym_save_off (offset).
0012DBr 2               ; ---------------------------------------------------------------------------
0012DBr 2               for_emit_load_var:
0012DBr 2  AD rr rr             LDA     sym_save_scope
0012DEr 2  D0 0B                BNE     @local
0012E0r 2  AD rr rr             LDA     sym_save_off+1
0012E3r 2  85 rr                STA     scratch
0012E5r 2  AD rr rr             LDA     sym_save_off
0012E8r 2  4C rr rr             JMP     emit_LDG
0012EBr 2               @local:
0012EBr 2  AD rr rr             LDA     sym_save_off
0012EEr 2  4C rr rr             JMP     emit_LDL
0012F1r 2               
0012F1r 2               for_emit_store_var:
0012F1r 2  AD rr rr             LDA     sym_save_scope
0012F4r 2  D0 0B                BNE     @local
0012F6r 2  AD rr rr             LDA     sym_save_off+1
0012F9r 2  85 rr                STA     scratch
0012FBr 2  AD rr rr             LDA     sym_save_off
0012FEr 2  4C rr rr             JMP     emit_STG
001301r 2               @local:
001301r 2  AD rr rr             LDA     sym_save_off
001304r 2  4C rr rr             JMP     emit_STL
001307r 2               
001307r 2               ; ---------------------------------------------------------------------------
001307r 2               ; parse_repeat — REPEAT stmt { ; stmt } UNTIL expr
001307r 2               ; ---------------------------------------------------------------------------
001307r 2               parse_repeat:
001307r 2  20 rr rr             JSR     next_token      ; consume REPEAT
00130Ar 2               ; save top
00130Ar 2  A5 rr                LDA     cg_pc
00130Cr 2  48                   PHA
00130Dr 2  A5 rr                LDA     cg_pc+1
00130Fr 2  48                   PHA
001310r 2               @loop:
001310r 2  A5 rr                LDA     tok_type
001312r 2  C9 59                CMP     #TOK_UNTIL
001314r 2  F0 12                BEQ     @until
001316r 2  C9 00                CMP     #TOK_EOF
001318r 2  F0 41                BEQ     @done
00131Ar 2  20 rr rr             JSR     parse_statement
00131Dr 2  A5 rr                LDA     tok_type
00131Fr 2  C9 20                CMP     #TOK_SEMICOLON
001321r 2  D0 ED                BNE     @loop
001323r 2  20 rr rr             JSR     next_token
001326r 2  80 E8                BRA     @loop
001328r 2               @until:
001328r 2  20 rr rr             JSR     next_token      ; consume UNTIL
00132Br 2  20 rr rr             JSR     parse_expression
00132Er 2               ; FJP back to top
00132Er 2  A9 51                LDA     #OP_FJP
001330r 2  20 rr rr             JSR     emit_byte
001333r 2  68                   PLA
001334r 2  85 rr                STA     tmp2+1
001336r 2  68                   PLA
001337r 2  85 rr                STA     tmp2
001339r 2  38                   SEC
00133Ar 2  A5 rr                LDA     tmp2
00133Cr 2  E5 rr                SBC     cg_pc
00133Er 2  85 rr                STA     scratch
001340r 2  A5 rr                LDA     tmp2+1
001342r 2  E5 rr                SBC     cg_pc+1
001344r 2  85 rr                STA     scratch+1
001346r 2  A5 rr                LDA     scratch
001348r 2  38                   SEC
001349r 2  E9 02                SBC     #2
00134Br 2  85 rr                STA     scratch
00134Dr 2  B0 02                BCS     :+
00134Fr 2  C6 rr                DEC     scratch+1
001351r 2               :
001351r 2  A5 rr                LDA     scratch
001353r 2  20 rr rr             JSR     emit_byte
001356r 2  A5 rr                LDA     scratch+1
001358r 2  20 rr rr             JSR     emit_byte
00135Br 2               @done:
00135Br 2  60                   RTS
00135Cr 2               
00135Cr 2               ; ---------------------------------------------------------------------------
00135Cr 2               ; parse_expression — full expression with operator precedence
00135Cr 2               ; Phase 1: simple additive + comparison; no precedence climbing yet
00135Cr 2               ; ---------------------------------------------------------------------------
00135Cr 2               parse_expression:
00135Cr 2  20 rr rr             JSR     parse_simple_expr
00135Fr 2               ; check for relational operator
00135Fr 2  A5 rr                LDA     tok_type
001361r 2  C9 14                CMP     #TOK_EQ
001363r 2  F0 15                BEQ     @rel_eq
001365r 2  C9 15                CMP     #TOK_NEQ
001367r 2  F0 1D                BEQ     @rel_neq
001369r 2  C9 16                CMP     #TOK_LT
00136Br 2  F0 25                BEQ     @rel_lt
00136Dr 2  C9 17                CMP     #TOK_GT
00136Fr 2  F0 2D                BEQ     @rel_gt
001371r 2  C9 18                CMP     #TOK_LEQ
001373r 2  F0 35                BEQ     @rel_leq
001375r 2  C9 19                CMP     #TOK_GEQ
001377r 2  F0 3D                BEQ     @rel_geq
001379r 2  60                   RTS                     ; expr_type set by parse_simple_expr
00137Ar 2               @rel_eq:
