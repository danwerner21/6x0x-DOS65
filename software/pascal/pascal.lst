0016B7r 2               ; 3-letter built-ins: POS, EOF
0016B7r 2  AD rr rr             LDA     ident_buf+1
0016BAr 2  C9 50                CMP     #'P'
0016BCr 2  F0 17                BEQ     @bi_chk_pos
0016BEr 2  C9 45                CMP     #'E'
0016C0r 2  F0 02                BEQ     @bi_chk_eof
0016C2r 2  80 6E                BRA     @do_lookup
0016C4r 2               @bi_chk_eof:
0016C4r 2  AD rr rr             LDA     ident_buf+2
0016C7r 2  C9 4F                CMP     #'O'
0016C9r 2  D0 67                BNE     @do_lookup
0016CBr 2  AD rr rr             LDA     ident_buf+3
0016CEr 2  C9 46                CMP     #'F'
0016D0r 2  D0 60                BNE     @do_lookup
0016D2r 2  4C rr rr             JMP     parse_builtin_eof
0016D5r 2               @bi_chk_pos:
0016D5r 2  AD rr rr             LDA     ident_buf+2
0016D8r 2  C9 4F                CMP     #'O'
0016DAr 2  D0 56                BNE     @do_lookup
0016DCr 2  AD rr rr             LDA     ident_buf+3
0016DFr 2  C9 53                CMP     #'S'
0016E1r 2  D0 4F                BNE     @do_lookup
0016E3r 2  4C rr rr             JMP     parse_builtin_pos
0016E6r 2               @bi_chk_copy:
0016E6r 2  AD rr rr             LDA     ident_buf+1
0016E9r 2  C9 43                CMP     #'C'
0016EBr 2  D0 45                BNE     @do_lookup
0016EDr 2  AD rr rr             LDA     ident_buf+2
0016F0r 2  C9 4F                CMP     #'O'
0016F2r 2  D0 3E                BNE     @do_lookup
0016F4r 2  AD rr rr             LDA     ident_buf+3
0016F7r 2  C9 50                CMP     #'P'
0016F9r 2  D0 37                BNE     @do_lookup
0016FBr 2  AD rr rr             LDA     ident_buf+4
0016FEr 2  C9 59                CMP     #'Y'
001700r 2  D0 30                BNE     @do_lookup
001702r 2  4C rr rr             JMP     parse_builtin_copy
001705r 2               @bi_chk_len_or_cat:
001705r 2  AD rr rr             LDA     ident_buf+1
001708r 2  C9 4C                CMP     #'L'
00170Ar 2  F0 15                BEQ     @bi_try_length
00170Cr 2  C9 43                CMP     #'C'
00170Er 2  D0 22                BNE     @do_lookup
001710r 2               ; CONCAT? check 'O','N','C','A','T'
001710r 2  AD rr rr             LDA     ident_buf+2
001713r 2  C9 4F                CMP     #'O'
001715r 2  D0 1B                BNE     @do_lookup
001717r 2  AD rr rr             LDA     ident_buf+3
00171Ar 2  C9 4E                CMP     #'N'
00171Cr 2  D0 14                BNE     @do_lookup
00171Er 2  4C rr rr             JMP     parse_builtin_concat
001721r 2               @bi_try_length:
001721r 2  AD rr rr             LDA     ident_buf+2
001724r 2  C9 45                CMP     #'E'
001726r 2  D0 0A                BNE     @do_lookup
001728r 2  AD rr rr             LDA     ident_buf+3
00172Br 2  C9 4E                CMP     #'N'
00172Dr 2  D0 03                BNE     @do_lookup
00172Fr 2  4C rr rr             JMP     parse_builtin_length
001732r 2               @do_lookup:
001732r 2               ; Look up BEFORE next_token — next_token may overwrite ident_buf
001732r 2               ; if the following token is an identifier or keyword (e.g. J THEN).
001732r 2  20 rr rr             JSR     symtab_find
001735r 2  B0 0F                BCS     @sym_ok
001737r 2  20 rr rr             JSR     next_token      ; consume ident
00173Ar 2  A9 00                LDA     #0
00173Cr 2  85 rr                STA     scratch
00173Er 2  20 rr rr             JSR     emit_LDCW       ; undefined: emit 0
001741r 2  A9 01                LDA     #TY_INT
001743r 2  85 rr                STA     expr_type
001745r 2  60                   RTS
001746r 2               @sym_ok:
001746r 2               ; Snapshot kind/type/scope/offset/pcount onto the 6502 stack —
001746r 2               ; sym_save_* would conflict with parse_assign_or_call when this
001746r 2               ; @ident_or_call runs inside a nested parse_expression.
001746r 2  A0 16                LDY     #22
001748r 2  B1 rr                LDA     (tmp3),y
00174Ar 2  8D rr rr             STA     fcall_vmask     ; (only meaningful for SYM_FUNC)
00174Dr 2  A0 17                LDY     #23
00174Fr 2  B1 rr                LDA     (tmp3),y
001751r 2  8D rr rr             STA     fcall_lsize     ; full local-area size for MRKSTK
001754r 2  A0 15                LDY     #21
001756r 2  B1 rr                LDA     (tmp3),y
001758r 2  48                   PHA                     ; pcount (deepest)
001759r 2  A0 10                LDY     #16
00175Br 2  B1 rr                LDA     (tmp3),y
00175Dr 2  48                   PHA                     ; kind
00175Er 2  A0 11                LDY     #17
001760r 2  B1 rr                LDA     (tmp3),y
001762r 2  85 rr                STA     expr_type       ; data type code
001764r 2  A0 14                LDY     #20
001766r 2  B1 rr                LDA     (tmp3),y
001768r 2  48                   PHA                     ; scope
001769r 2  A0 13                LDY     #19
00176Br 2  B1 rr                LDA     (tmp3),y
00176Dr 2  48                   PHA                     ; off hi
00176Er 2  A0 12                LDY     #18
001770r 2  B1 rr                LDA     (tmp3),y
001772r 2  48                   PHA                     ; off lo (top)
001773r 2  20 rr rr             JSR     next_token      ; consume ident (may overwrite ident_buf/tmp3)
001776r 2  68                   PLA                     ; off lo
001777r 2  AA                   TAX                     ; X = off lo
001778r 2  68                   PLA                     ; off hi
001779r 2  85 rr                STA     scratch         ; scratch = off hi
00177Br 2  68                   PLA                     ; scope
00177Cr 2  A8                   TAY                     ; Y = scope (preserved across kind test)
00177Dr 2  68                   PLA                     ; kind
00177Er 2  C9 04                CMP     #SYM_FUNC
001780r 2  D0 03                BNE     :+
001782r 2  4C rr rr             JMP     @sym_func_call
001785r 2               :
001785r 2  C9 02                CMP     #SYM_CONST
001787r 2  D0 03                BNE     :+
001789r 2  4C rr rr             JMP     @const_emit
00178Cr 2               :
00178Cr 2  C9 08                CMP     #SYM_VARREF
00178Er 2  D0 03                BNE     :+
001790r 2  4C rr rr             JMP     @varref_load
001793r 2               :
001793r 2               ; SYM_VAR (default; PROC also falls through here for now)
001793r 2  68                   PLA                     ; discard pcount
001794r 2  C0 00                CPY     #0
001796r 2  D0 25                BNE     @local_load
001798r 2               ; global SYM_VAR — check for array subscript, record field, or TEXT file
001798r 2  A5 rr                LDA     expr_type
00179Ar 2  C9 05                CMP     #TY_ARRAY
00179Cr 2  F0 13                BEQ     @arr_rhs_global
00179Er 2  C9 06                CMP     #TY_RECORD
0017A0r 2  F0 15                BEQ     @rec_rhs_global
0017A2r 2  C9 08                CMP     #TY_TEXT
0017A4r 2  F0 07                BEQ     @text_rhs_global
0017A6r 2  8A                   TXA
0017A7r 2  20 rr rr             JSR     emit_LDG
0017AAr 2  4C rr rr             JMP     @maybe_deref_ptr
0017ADr 2               @text_rhs_global:
0017ADr 2  8A                   TXA                     ; push struct address, leave expr_type=TY_TEXT
0017AEr 2  4C rr rr             JMP     emit_LDA_G
0017B1r 2               @arr_rhs_global:
0017B1r 2  8A                   TXA                     ; A=off_lo, scratch=off_hi still valid
0017B2r 2  20 rr rr             JSR     emit_LDA_G
0017B5r 2  80 37                BRA     @arr_rhs_index
0017B7r 2               @rec_rhs_global:
0017B7r 2  8A                   TXA                     ; A=off_lo, scratch=off_hi
0017B8r 2  20 rr rr             JSR     emit_LDA_G
0017BBr 2  80 5B                BRA     @rec_rhs_field
0017BDr 2               @local_load:
0017BDr 2  A5 rr                LDA     expr_type
0017BFr 2  C9 05                CMP     #TY_ARRAY
0017C1r 2  F0 27                BEQ     @arr_rhs_local
0017C3r 2  C9 06                CMP     #TY_RECORD
0017C5r 2  F0 4D                BEQ     @rec_rhs_local
0017C7r 2  C9 08                CMP     #TY_TEXT
0017C9r 2  F0 1B                BEQ     @text_rhs_local
0017CBr 2  8A                   TXA
0017CCr 2  20 rr rr             JSR     emit_LDL
0017CFr 2                       ; fall through to @maybe_deref_ptr
0017CFr 2               @maybe_deref_ptr:
0017CFr 2               ; If this load was a TY_PTR and the next token is '^', emit LDIND to
0017CFr 2               ; dereference. v1 only supports pointer-to-INTEGER, so the result type
0017CFr 2               ; is always TY_INT.
0017CFr 2  A5 rr                LDA     expr_type
0017D1r 2  C9 07                CMP     #TY_PTR
0017D3r 2  D0 10                BNE     @mdp_done
0017D5r 2  A5 rr                LDA     tok_type
0017D7r 2  C9 24                CMP     #TOK_CARET
0017D9r 2  D0 0A                BNE     @mdp_done
0017DBr 2  20 rr rr             JSR     next_token              ; consume '^'
0017DEr 2  20 rr rr             JSR     emit_LDIND
0017E1r 2  A9 01                LDA     #TY_INT
0017E3r 2  85 rr                STA     expr_type
0017E5r 2               @mdp_done:
0017E5r 2  60                   RTS
0017E6r 2               @text_rhs_local:
0017E6r 2  8A                   TXA
0017E7r 2  4C rr rr             JMP     emit_LDA_L
0017EAr 2               @arr_rhs_local:
0017EAr 2  8A                   TXA
0017EBr 2  20 rr rr             JSR     emit_LDA_L
0017EEr 2               @arr_rhs_index:
0017EEr 2               ; parse [index], emit INDEX, LDIND
0017EEr 2  A5 rr                LDA     tok_type
0017F0r 2  C9 1D                CMP     #TOK_LBRACK
0017F2r 2  D0 03                BNE     :+
0017F4r 2  20 rr rr             JSR     next_token
0017F7r 2  20 rr rr     :       JSR     parse_expression    ; clobbers expr_type, scratch, tmp*
0017FAr 2  A5 rr                LDA     tok_type
0017FCr 2  C9 1E                CMP     #TOK_RBRACK
0017FEr 2  D0 03                BNE     :+
001800r 2  20 rr rr             JSR     next_token
001803r 2  A9 00        :       LDA     #0
001805r 2  85 rr                STA     scratch
001807r 2  A9 02                LDA     #2
001809r 2  20 rr rr             JSR     emit_INDEX
00180Cr 2  20 rr rr             JSR     emit_LDIND
00180Fr 2  A9 01                LDA     #TY_INT
001811r 2  85 rr                STA     expr_type
001813r 2  60                   RTS
001814r 2               @rec_rhs_local:
001814r 2  8A                   TXA
001815r 2  20 rr rr             JSR     emit_LDA_L
001818r 2               @rec_rhs_field:
001818r 2               ; Chained field access loop: TOS holds &cur_record_base.
001818r 2               ; fcall_vmask = current record's first_field, fcall_lsize = its count.
001818r 2               ; Each iteration consumes ".name" and walks one level deeper.  When the
001818r 2               ; resolved field is itself a RECORD and another '.' follows, repeat;
001818r 2               ; otherwise emit LDIND on the final scalar address.
001818r 2               @rrf_chain:
001818r 2               ; consume '.'
001818r 2  A5 rr                LDA     tok_type
00181Ar 2  C9 22                CMP     #TOK_DOT
00181Cr 2  D0 03                BNE     :+
00181Er 2  20 rr rr             JSR     next_token
001821r 2               :
001821r 2               ; field name now in ident_buf — look up in current record
001821r 2  AD rr rr             LDA     fcall_vmask     ; first_field_idx
001824r 2  AE rr rr             LDX     fcall_lsize     ; field_count
001827r 2  20 rr rr             JSR     field_lookup_in_record
00182Ar 2  90 40                BCC     @rec_rhs_nf
00182Cr 2               ; A=offset, X=type, tmp3=matched index. Stash all three across emits.
00182Cr 2  48                   PHA                     ; save offset
00182Dr 2  8A                   TXA
00182Er 2  85 rr                STA     scratch         ; save field type
001830r 2  A5 rr                LDA     tmp3
001832r 2  8D rr rr             STA     fcall_lo        ; save matched field index
001835r 2  68                   PLA                     ; offset back; PLA sets Z
001836r 2  F0 06                BEQ     @rrf_no_off
001838r 2  20 rr rr             JSR     emit_LDCI
00183Br 2  20 rr rr             JSR     emit_ADI
00183Er 2               @rrf_no_off:
00183Er 2  20 rr rr             JSR     next_token              ; consume field name
001841r 2               ; If field type is RECORD AND next token is '.', chain into it.
001841r 2  A5 rr                LDA     scratch
001843r 2  C9 06                CMP     #TY_RECORD
001845r 2  D0 17                BNE     @rrf_done_chain
001847r 2  A5 rr                LDA     tok_type
001849r 2  C9 22                CMP     #TOK_DOT
00184Br 2  D0 11                BNE     @rrf_done_chain
00184Dr 2  AE rr rr             LDX     fcall_lo
001850r 2  BD rr rr             LDA     field_nested_first,x
001853r 2  8D rr rr             STA     fcall_vmask
001856r 2  BD rr rr             LDA     field_nested_count,x
001859r 2  8D rr rr             STA     fcall_lsize
00185Cr 2  80 BA                BRA     @rrf_chain
00185Er 2               @rrf_done_chain:
00185Er 2               ; Final step: scalar fields → LDIND value; record fields stay as
00185Er 2               ; addresses (so calling code sees them as TY_RECORD pointers).
00185Er 2  A5 rr                LDA     scratch
001860r 2  C9 06                CMP     #TY_RECORD
001862r 2  F0 03                BEQ     @rrf_no_load
001864r 2  20 rr rr             JSR     emit_LDIND
001867r 2               @rrf_no_load:
001867r 2  A5 rr                LDA     scratch
001869r 2  85 rr                STA     expr_type
00186Br 2  60                   RTS
00186Cr 2               @rec_rhs_nf:
00186Cr 2  A9 rr                LDA     #<err_undef
00186Er 2  85 rr                STA     tmp0
001870r 2  A9 rr                LDA     #>err_undef
001872r 2  85 rr                STA     tmp0+1
001874r 2  20 rr rr             JSR     compile_error
001877r 2  20 rr rr             JSR     next_token      ; consume bad field name
00187Ar 2  20 rr rr             JSR     emit_LDIND      ; keep stack balanced
00187Dr 2  A9 01                LDA     #TY_INT
00187Fr 2  85 rr                STA     expr_type
001881r 2  60                   RTS
001882r 2               @varref_load:
001882r 2               ; SYM_VARREF: local slot holds an address. Emit LDL then LDIND.
001882r 2  68                   PLA                     ; discard pcount
001883r 2  8A                   TXA
001884r 2  20 rr rr             JSR     emit_LDL        ; push address from slot
001887r 2  20 rr rr             JSR     emit_LDIND      ; deref → push word
00188Ar 2  60                   RTS
00188Br 2               @const_emit:
00188Br 2               ; CONST: offset bytes hold the literal value. X=lo, scratch=hi.
00188Br 2  68                   PLA                     ; discard pcount
00188Cr 2  8A                   TXA
00188Dr 2  20 rr rr             JSR     emit_LDCW
001890r 2  60                   RTS
001891r 2               @sym_func_call:
001891r 2               ; SYM_FUNC: emit MRKSTK + arg-stores + CALL.  Result is left on TOS
001891r 2               ; by op_RETF.  expr_type is the function's return type (already set).
001891r 2               ; X=off lo, scratch=off hi, top of 6502 stack = pcount.
001891r 2               ; NOTE: not nest-safe — calling a function inside another function
001891r 2               ; call's argument list will clobber fcall_*.  TODO: fix later.
001891r 2  8E rr rr             STX     fcall_lo
001894r 2  A5 rr                LDA     scratch
001896r 2  8D rr rr             STA     fcall_hi
001899r 2  A5 rr                LDA     expr_type
00189Br 2  8D rr rr             STA     fcall_type      ; preserve across parse_expression
00189Er 2  68                   PLA                     ; pcount
00189Fr 2  8D rr rr             STA     fcall_pcount
0018A2r 2               ; emit MRKSTK <full local-area size> (params + body locals).
0018A2r 2               ; fcall_lsize was captured at @sym_ok from entry offset 23.
0018A2r 2  AD rr rr             LDA     fcall_lsize
0018A5r 2  20 rr rr             JSR     emit_MRKSTK
0018A8r 2  AD rr rr             LDA     fcall_pcount
0018ABr 2  F0 4A                BEQ     @fc_no_args
0018ADr 2               ; expect '('
0018ADr 2  A5 rr                LDA     tok_type
0018AFr 2  C9 1B                CMP     #TOK_LPAREN
0018B1r 2  D0 56                BNE     @fc_emit_call
0018B3r 2  20 rr rr             JSR     next_token      ; consume '('
0018B6r 2  A2 00                LDX     #0              ; X = arg index
0018B8r 2               @fc_arg_loop:
0018B8r 2               ; Bit X of fcall_vmask → VAR (push address); else value.
0018B8r 2  DA                   PHX
0018B9r 2  A9 01                LDA     #1
0018BBr 2               @fcvbit:
0018BBr 2  E0 00                CPX     #0
0018BDr 2  F0 04                BEQ     @fcvdone
0018BFr 2  0A                   ASL
0018C0r 2  CA                   DEX
0018C1r 2  80 F8                BRA     @fcvbit
0018C3r 2               @fcvdone:
0018C3r 2  FA                   PLX
0018C4r 2  2D rr rr             AND     fcall_vmask
0018C7r 2  F0 07                BEQ     @fc_arg_value
0018C9r 2  DA                   PHX
0018CAr 2  20 rr rr             JSR     parse_arg_lvalue
0018CDr 2  FA                   PLX
0018CEr 2  80 05                BRA     @fc_arg_stored
0018D0r 2               @fc_arg_value:
0018D0r 2  DA                   PHX
0018D1r 2  20 rr rr             JSR     parse_expression
0018D4r 2  FA                   PLX
0018D5r 2               @fc_arg_stored:
0018D5r 2  8A                   TXA
0018D6r 2  0A                   ASL
0018D7r 2  20 rr rr             JSR     emit_STL        ; store popped value (or address) into local slot X
0018DAr 2  E8                   INX
0018DBr 2  EC rr rr             CPX     fcall_pcount
0018DEr 2  B0 0C                BCS     @fc_done_args
0018E0r 2  A5 rr                LDA     tok_type
0018E2r 2  C9 1F                CMP     #TOK_COMMA
0018E4r 2  D0 06                BNE     @fc_done_args
0018E6r 2  20 rr rr             JSR     next_token      ; consume ','
0018E9r 2  4C rr rr             JMP     @fc_arg_loop    ; jmp — body grew past bra range
0018ECr 2               @fc_done_args:
0018ECr 2  A5 rr                LDA     tok_type
0018EEr 2  C9 1C                CMP     #TOK_RPAREN
0018F0r 2  D0 17                BNE     @fc_emit_call
0018F2r 2  20 rr rr             JSR     next_token      ; consume ')'
0018F5r 2  80 12                BRA     @fc_emit_call
0018F7r 2               @fc_no_args:
0018F7r 2               ; Accept optional "()"
0018F7r 2  A5 rr                LDA     tok_type
0018F9r 2  C9 1B                CMP     #TOK_LPAREN
0018FBr 2  D0 0C                BNE     @fc_emit_call
0018FDr 2  20 rr rr             JSR     next_token
001900r 2  A5 rr                LDA     tok_type
001902r 2  C9 1C                CMP     #TOK_RPAREN
001904r 2  D0 03                BNE     @fc_emit_call
001906r 2  20 rr rr             JSR     next_token
001909r 2               @fc_emit_call:
001909r 2  AD rr rr             LDA     fcall_hi
00190Cr 2  85 rr                STA     scratch
00190Er 2  AD rr rr             LDA     fcall_lo
001911r 2  20 rr rr             JSR     emit_CALL
001914r 2               ; restore expr_type (parse_expression in args may have changed it)
001914r 2  AD rr rr             LDA     fcall_type
001917r 2  85 rr                STA     expr_type
001919r 2  60                   RTS
00191Ar 2               
00191Ar 2               @paren:
00191Ar 2  20 rr rr             JSR     next_token      ; consume '('
00191Dr 2  20 rr rr             JSR     parse_expression
001920r 2  A5 rr                LDA     tok_type
001922r 2  C9 1C                CMP     #TOK_RPAREN
001924r 2  D0 03                BNE     :+
001926r 2  20 rr rr             JSR     next_token
001929r 2               :
001929r 2  60                   RTS                     ; expr_type already set by parse_expression
00192Ar 2               
00192Ar 2               @not_expr:
00192Ar 2  20 rr rr             JSR     next_token
00192Dr 2  20 rr rr             JSR     parse_factor
001930r 2  20 rr rr             JSR     emit_LNOT
001933r 2  A9 03                LDA     #TY_BOOL
001935r 2  85 rr                STA     expr_type
001937r 2  60                   RTS
001938r 2               
001938r 2               @nil:
001938r 2  20 rr rr             JSR     emit_LDCN
00193Br 2  20 rr rr             JSR     next_token
00193Er 2  A9 07                LDA     #TY_PTR
001940r 2  85 rr                STA     expr_type
001942r 2  60                   RTS
001943r 2               
001943r 2               ; ---------------------------------------------------------------------------
001943r 2               ; String built-in helpers — entered from parse_factor's @ident_or_call.
001943r 2               ; The identifier is still the current token on entry.
001943r 2               ; ---------------------------------------------------------------------------
001943r 2               
001943r 2               ; Skip current token if it matches A; otherwise just fall through.
001943r 2               ; Used to consume optional punctuation like '(' / ')' / ',' without aborting
001943r 2               ; on a missing token (compile_error elsewhere will catch malformed code).
001943r 2               parse_eat_token:
001943r 2  C5 rr                CMP     tok_type
001945r 2  D0 03                BNE     :+
001947r 2  4C rr rr             JMP     next_token
00194Ar 2  60           :       RTS
00194Br 2               
00194Br 2               parse_builtin_length:
00194Br 2  20 rr rr             JSR     next_token              ; consume LENGTH
00194Er 2  A9 1B                LDA     #TOK_LPAREN
001950r 2  20 rr rr             JSR     parse_eat_token
001953r 2  20 rr rr             JSR     parse_expression        ; pushes string ptr
001956r 2  A9 1C                LDA     #TOK_RPAREN
001958r 2  20 rr rr             JSR     parse_eat_token
00195Br 2  20 rr rr             JSR     emit_LEN
00195Er 2  A9 01                LDA     #TY_INT
001960r 2  85 rr                STA     expr_type
001962r 2  60                   RTS
001963r 2               
001963r 2               parse_builtin_pos:
001963r 2  20 rr rr             JSR     next_token              ; consume POS
001966r 2  A9 1B                LDA     #TOK_LPAREN
001968r 2  20 rr rr             JSR     parse_eat_token
00196Br 2  20 rr rr             JSR     parse_expression        ; substr
00196Er 2  A9 1F                LDA     #TOK_COMMA
001970r 2  20 rr rr             JSR     parse_eat_token
001973r 2  20 rr rr             JSR     parse_expression        ; mainstr
001976r 2  A9 1C                LDA     #TOK_RPAREN
001978r 2  20 rr rr             JSR     parse_eat_token
00197Br 2  20 rr rr             JSR     emit_POS
00197Er 2  A9 01                LDA     #TY_INT
001980r 2  85 rr                STA     expr_type
001982r 2  60                   RTS
001983r 2               
001983r 2               parse_builtin_copy:
001983r 2  20 rr rr             JSR     next_token              ; consume COPY
001986r 2  A9 1B                LDA     #TOK_LPAREN
001988r 2  20 rr rr             JSR     parse_eat_token
00198Br 2  20 rr rr             JSR     parse_expression        ; src string
00198Er 2  A9 1F                LDA     #TOK_COMMA
001990r 2  20 rr rr             JSR     parse_eat_token
001993r 2  20 rr rr             JSR     parse_expression        ; index
001996r 2  A9 1F                LDA     #TOK_COMMA
001998r 2  20 rr rr             JSR     parse_eat_token
00199Br 2  20 rr rr             JSR     parse_expression        ; count
00199Er 2  A9 1C                LDA     #TOK_RPAREN
0019A0r 2  20 rr rr             JSR     parse_eat_token
0019A3r 2  20 rr rr             JSR     emit_COPY
0019A6r 2  A9 04                LDA     #TY_STRING
0019A8r 2  85 rr                STA     expr_type
0019AAr 2  60                   RTS
0019ABr 2               
0019ABr 2               ; CONCAT(s1, s2 [, s3, ...]) — emit chained CONCAT2.  Each pair-merge writes
0019ABr 2               ; into the next round-robin work buffer, so 3+ args work as long as the
0019ABr 2               ; intermediate buffer isn't recycled before being consumed.
0019ABr 2               parse_builtin_concat:
0019ABr 2  20 rr rr             JSR     next_token              ; consume CONCAT
0019AEr 2  A9 1B                LDA     #TOK_LPAREN
0019B0r 2  20 rr rr             JSR     parse_eat_token
0019B3r 2  20 rr rr             JSR     parse_expression        ; first arg on stack
0019B6r 2  A5 rr                LDA     tok_type
0019B8r 2  C9 1F                CMP     #TOK_COMMA
0019BAr 2  F0 0A                BEQ     @cat_more
0019BCr 2               ; Single-arg CONCAT — just leave the string on the stack (rare/edge case).
0019BCr 2  A9 1C                LDA     #TOK_RPAREN
0019BEr 2  20 rr rr             JSR     parse_eat_token
0019C1r 2  A9 04                LDA     #TY_STRING
0019C3r 2  85 rr                STA     expr_type
0019C5r 2  60                   RTS
0019C6r 2               @cat_more:
0019C6r 2  20 rr rr             JSR     next_token              ; consume ','
0019C9r 2  20 rr rr             JSR     parse_expression        ; next arg
0019CCr 2  20 rr rr             JSR     emit_CONCAT             ; merge previous + next
0019CFr 2  A5 rr                LDA     tok_type
0019D1r 2  C9 1F                CMP     #TOK_COMMA
0019D3r 2  F0 F1                BEQ     @cat_more
0019D5r 2  A9 1C                LDA     #TOK_RPAREN
0019D7r 2  20 rr rr             JSR     parse_eat_token
0019DAr 2  A9 04                LDA     #TY_STRING
0019DCr 2  85 rr                STA     expr_type
0019DEr 2  60                   RTS
0019DFr 2               
0019DFr 2               ; ---------------------------------------------------------------------------
0019DFr 2               ; File built-in helpers — entered from parse_assign_or_call (statement form)
0019DFr 2               ; or parse_factor's @ident_or_call (EOF as expression).
0019DFr 2               ; ---------------------------------------------------------------------------
0019DFr 2               
0019DFr 2               ; ASSIGN(filevar, namestring)
0019DFr 2               parse_builtin_assign:
0019DFr 2  20 rr rr             JSR     next_token              ; consume ASSIGN
0019E2r 2  A9 1B                LDA     #TOK_LPAREN
0019E4r 2  20 rr rr             JSR     parse_eat_token
0019E7r 2  20 rr rr             JSR     parse_expression        ; file ptr (TY_TEXT)
0019EAr 2  A9 1F                LDA     #TOK_COMMA
0019ECr 2  20 rr rr             JSR     parse_eat_token
0019EFr 2  20 rr rr             JSR     parse_expression        ; filename string
0019F2r 2  A9 1C                LDA     #TOK_RPAREN
0019F4r 2  20 rr rr             JSR     parse_eat_token
0019F7r 2  4C rr rr             JMP     emit_FASSGN
0019FAr 2               
0019FAr 2               parse_builtin_reset:
0019FAr 2  20 rr rr             JSR     next_token              ; consume RESET
0019FDr 2  A9 1B                LDA     #TOK_LPAREN
0019FFr 2  20 rr rr             JSR     parse_eat_token
001A02r 2  20 rr rr             JSR     parse_expression
001A05r 2  A9 1C                LDA     #TOK_RPAREN
001A07r 2  20 rr rr             JSR     parse_eat_token
001A0Ar 2  4C rr rr             JMP     emit_FRESET
001A0Dr 2               
001A0Dr 2               parse_builtin_rewrite:
001A0Dr 2  20 rr rr             JSR     next_token              ; consume REWRITE
001A10r 2  A9 1B                LDA     #TOK_LPAREN
001A12r 2  20 rr rr             JSR     parse_eat_token
001A15r 2  20 rr rr             JSR     parse_expression
001A18r 2  A9 1C                LDA     #TOK_RPAREN
001A1Ar 2  20 rr rr             JSR     parse_eat_token
001A1Dr 2  4C rr rr             JMP     emit_FREWRT
001A20r 2               
001A20r 2               parse_builtin_close:
001A20r 2  20 rr rr             JSR     next_token              ; consume CLOSE
001A23r 2  A9 1B                LDA     #TOK_LPAREN
001A25r 2  20 rr rr             JSR     parse_eat_token
001A28r 2  20 rr rr             JSR     parse_expression
001A2Br 2  A9 1C                LDA     #TOK_RPAREN
001A2Dr 2  20 rr rr             JSR     parse_eat_token
001A30r 2  4C rr rr             JMP     emit_FCLOSE
001A33r 2               
001A33r 2               parse_builtin_eof:
001A33r 2  20 rr rr             JSR     next_token              ; consume EOF
001A36r 2  A9 1B                LDA     #TOK_LPAREN
001A38r 2  20 rr rr             JSR     parse_eat_token
001A3Br 2  20 rr rr             JSR     parse_expression        ; file ptr (TY_TEXT)
001A3Er 2  A9 1C                LDA     #TOK_RPAREN
001A40r 2  20 rr rr             JSR     parse_eat_token
001A43r 2  20 rr rr             JSR     emit_FEOF
001A46r 2  A9 03                LDA     #TY_BOOL
001A48r 2  85 rr                STA     expr_type
001A4Ar 2  60                   RTS
001A4Br 2               
001A4Br 2               parse_builtin_eoln:
001A4Br 2  20 rr rr             JSR     next_token              ; consume EOLN
001A4Er 2  A9 1B                LDA     #TOK_LPAREN
001A50r 2  20 rr rr             JSR     parse_eat_token
001A53r 2  20 rr rr             JSR     parse_expression        ; file ptr (TY_TEXT)
001A56r 2  A9 1C                LDA     #TOK_RPAREN
001A58r 2  20 rr rr             JSR     parse_eat_token
001A5Br 2  20 rr rr             JSR     emit_FEOLN
001A5Er 2  A9 03                LDA     #TY_BOOL
001A60r 2  85 rr                STA     expr_type
001A62r 2  60                   RTS
001A63r 2               
001A63r 2               ; NEW(p) — bump-allocate 2 bytes (pointer-to-INTEGER, v1) and store the
001A63r 2               ; new heap address into pointer variable p.
001A63r 2               ;   parse_arg_lvalue pushes &p; emit_NEW pushes the fresh pointer; STIND
001A63r 2               ;   takes (NOS=addr, TOS=val) and writes val to addr.
001A63r 2               parse_builtin_new:
001A63r 2  20 rr rr             JSR     next_token              ; consume NEW
001A66r 2  A9 1B                LDA     #TOK_LPAREN
001A68r 2  20 rr rr             JSR     parse_eat_token
001A6Br 2  20 rr rr             JSR     parse_arg_lvalue        ; push &p
001A6Er 2  A9 1C                LDA     #TOK_RPAREN
001A70r 2  20 rr rr             JSR     parse_eat_token
001A73r 2  A9 00                LDA     #0
001A75r 2  85 rr                STA     scratch                 ; size hi = 0
001A77r 2  A9 02                LDA     #2                      ; v1: always allocate 2 bytes
001A79r 2  20 rr rr             JSR     emit_NEW
001A7Cr 2  4C rr rr             JMP     emit_STIND
001A7Fr 2               
001A7Fr 2               ; DISPOSE(p) — bump allocator can't free, so just discard the pointer.
001A7Fr 2               parse_builtin_dispose:
001A7Fr 2  20 rr rr             JSR     next_token              ; consume DISPOSE
001A82r 2  A9 1B                LDA     #TOK_LPAREN
001A84r 2  20 rr rr             JSR     parse_eat_token
001A87r 2  20 rr rr             JSR     parse_expression        ; push p (value)
001A8Ar 2  A9 1C                LDA     #TOK_RPAREN
001A8Cr 2  20 rr rr             JSR     parse_eat_token
001A8Fr 2  4C rr rr             JMP     emit_DISP
001A92r 2               
001A92r 2               ; TRUE / FALSE — predefined boolean constants.  Push 1/0 as TY_BOOL so
001A92r 2               ; pw_emit_file routes to FWRB ("TRUE"/"FALSE") and pw_emit_console to WRITB.
001A92r 2               parse_builtin_true:
001A92r 2  20 rr rr             JSR     next_token              ; consume TRUE
001A95r 2  A9 01                LDA     #1
001A97r 2  20 rr rr             JSR     emit_LDCB
001A9Ar 2  A9 03                LDA     #TY_BOOL
001A9Cr 2  85 rr                STA     expr_type
001A9Er 2  60                   RTS
001A9Fr 2               
001A9Fr 2               parse_builtin_false:
001A9Fr 2  20 rr rr             JSR     next_token              ; consume FALSE
001AA2r 2  A9 00                LDA     #0
001AA4r 2  20 rr rr             JSR     emit_LDCB
001AA7r 2  A9 03                LDA     #TY_BOOL
001AA9r 2  85 rr                STA     expr_type
001AABr 2  60                   RTS
001AACr 2               
001AACr 1                       .include        "SYMTAB.ASM"
001AACr 2               .PC02
001AACr 2               ; symtab.asm — symbol table for Pascal/65 compiler
001AACr 2               ;
001AACr 2               ; Each entry occupies 16 bytes in the SYMTAB_BASE area:
001AACr 2               ;   [0]    name length (1-15)
001AACr 2               ;   [1-15] name chars (uppercase, padded with spaces)
001AACr 2               ;   [16]   symbol kind: SYM_VAR, SYM_CONST, SYM_PROC, SYM_FUNC, SYM_TYPE, SYM_PARAM
001AACr 2               ;   [17]   data type:   TY_INT, TY_CHAR, TY_BOOL, TY_STRING, TY_ARRAY, TY_RECORD, TY_PTR
001AACr 2               ;   [18-19] value/offset (word): variable offset from BASE/MP; const value; proc address
001AACr 2               ;   [20]   scope depth (0=global)
001AACr 2               ;   [21]   parameter count (for SYM_PROC/SYM_FUNC)
001AACr 2               ;   [22-23] type info pointer (for array/record types)
001AACr 2               ;   [24-31] reserved
001AACr 2               
001AACr 2               SYM_ENTRY_SZ    = 32
001AACr 2               
001AACr 2               ; Symbol kinds
001AACr 2               SYM_VAR         = 1
001AACr 2               SYM_CONST       = 2
001AACr 2               SYM_PROC        = 3
001AACr 2               SYM_FUNC        = 4
001AACr 2               SYM_TYPE        = 5
001AACr 2               SYM_PARAM       = 6
001AACr 2               SYM_RETVAL      = 7             ; binding for `funcname := expr` in fn body
001AACr 2               SYM_VARREF      = 8             ; VAR (by-reference) parameter — local slot holds an address
001AACr 2               
001AACr 2               ; Data type codes
001AACr 2               TY_INT          = 1
001AACr 2               TY_CHAR         = 2
001AACr 2               TY_BOOL         = 3
001AACr 2               TY_STRING       = 4
001AACr 2               TY_ARRAY        = 5
001AACr 2               TY_RECORD       = 6
001AACr 2               TY_PTR          = 7
001AACr 2               TY_TEXT         = 8             ; TEXT file variable (168-byte struct)
001AACr 2               TY_NONE         = 0             ; for procedures
001AACr 2               
001AACr 2                       .segment        "CODE"
001AACr 2               
001AACr 2               ; Number of entries currently in symbol table
001AACr 2               symtab_count:
001AACr 2  00 00                .WORD   0
001AAEr 2               
001AAEr 2               ; ---------------------------------------------------------------------------
001AAEr 2               ; symtab_init — clear symbol table
001AAEr 2               ; ---------------------------------------------------------------------------
001AAEr 2               symtab_init:
001AAEr 2  A9 00                LDA     #0
001AB0r 2  8D rr rr             STA     symtab_count
001AB3r 2  8D rr rr             STA     symtab_count+1
001AB6r 2  8D rr rr             STA     field_table_count
001AB9r 2  60                   RTS
001ABAr 2               
001ABAr 2               ; ---------------------------------------------------------------------------
001ABAr 2               ; field_table_add — append a record-field entry
001ABAr 2               ; Inputs:
001ABAr 2               ;   ident_buf = field name (length at [0], chars at [1..])
001ABAr 2               ;   A         = byte offset within the record
001ABAr 2               ;   X         = field data type (TY_*)
001ABAr 2               ; Returns: A = newly-assigned field index (current count - 1)
001ABAr 2               ;          carry set if field table is full (entry not added)
001ABAr 2               ; Clobbers: tmp2, tmp3, Y
001ABAr 2               ; ---------------------------------------------------------------------------
001ABAr 2               field_table_add:
001ABAr 2  48                   PHA                     ; save offset
001ABBr 2  8A                   TXA
001ABCr 2  48                   PHA                     ; save type
001ABDr 2               ; capacity check (max 32 entries)
001ABDr 2  AD rr rr             LDA     field_table_count
001AC0r 2  C9 20                CMP     #32
001AC2r 2  90 04                BCC     :+
001AC4r 2  68                   PLA                     ; discard type
001AC5r 2  68                   PLA                     ; discard offset
001AC6r 2  38                   SEC
001AC7r 2  60                   RTS
001AC8r 2               :
001AC8r 2               ; compute entry address: field_table + count*16
001AC8r 2  AD rr rr             LDA     field_table_count
001ACBr 2  0A                   ASL
001ACCr 2  0A                   ASL
001ACDr 2  0A                   ASL
001ACEr 2  0A                   ASL                     ; *16 (count<64 fits in 10 bits, but we land in low byte; high carry becomes part of address)
001ACFr 2  85 rr                STA     tmp2
001AD1r 2  A9 00                LDA     #0
001AD3r 2  2A                   ROL                     ; capture carry into hi
001AD4r 2  18                   CLC
001AD5r 2  69 rr                ADC     #>field_table
001AD7r 2  85 rr                STA     tmp2+1
001AD9r 2  A5 rr                LDA     tmp2
001ADBr 2  18                   CLC
001ADCr 2  69 rr                ADC     #<field_table
001ADEr 2  85 rr                STA     tmp2
001AE0r 2  90 02                BCC     :+
001AE2r 2  E6 rr                INC     tmp2+1
001AE4r 2               :
001AE4r 2               ; copy name length + chars
001AE4r 2  A0 00                LDY     #0
001AE6r 2  AD rr rr             LDA     ident_buf
001AE9r 2  91 rr                STA     (tmp2),y
001AEBr 2  AA                   TAX                     ; X = length
001AECr 2  A0 01                LDY     #1
001AEEr 2               @nm:
001AEEr 2  C0 0D                CPY     #13
001AF0r 2  B0 0D                BCS     @padn
001AF2r 2  E0 00                CPX     #0
001AF4r 2  F0 09                BEQ     @padn
001AF6r 2  B9 rr rr             LDA     ident_buf,y
001AF9r 2  91 rr                STA     (tmp2),y
001AFBr 2  CA                   DEX
001AFCr 2  C8                   INY
001AFDr 2  80 EF                BRA     @nm
001AFFr 2               @padn:
001AFFr 2  C0 0D                CPY     #13
001B01r 2  B0 07                BCS     @done_nm
001B03r 2  A9 20                LDA     #' '
001B05r 2  91 rr                STA     (tmp2),y
001B07r 2  C8                   INY
001B08r 2  80 F5                BRA     @padn
001B0Ar 2               @done_nm:
001B0Ar 2               ; offset (was on stack first → second pull)
001B0Ar 2               ; type   (was on stack last  → first pull)
001B0Ar 2  68                   PLA                     ; type
001B0Br 2  A0 0E                LDY     #14
001B0Dr 2  91 rr                STA     (tmp2),y
001B0Fr 2  68                   PLA                     ; offset
001B10r 2  A0 0D                LDY     #13
001B12r 2  91 rr                STA     (tmp2),y
001B14r 2  A9 00                LDA     #0
001B16r 2  A0 0F                LDY     #15
001B18r 2  91 rr                STA     (tmp2),y
001B1Ar 2               ; bump count, return new index
001B1Ar 2  AD rr rr             LDA     field_table_count
001B1Dr 2  EE rr rr             INC     field_table_count
001B20r 2  18                   CLC
001B21r 2  60                   RTS
001B22r 2               
001B22r 2               ; ---------------------------------------------------------------------------
001B22r 2               ; field_lookup_in_record — find ident_buf among a contiguous range of fields
001B22r 2               ; Inputs:
001B22r 2               ;   ident_buf = field name to find
001B22r 2               ;   A         = first field index in field_table
001B22r 2               ;   X         = number of fields to scan
001B22r 2               ; Returns: carry set = found
001B22r 2               ;            A = byte offset within record
001B22r 2               ;            X = field data type
001B22r 2               ;          carry clear = not found
001B22r 2               ; Clobbers: tmp2, tmp3, Y
001B22r 2               ; ---------------------------------------------------------------------------
001B22r 2               field_lookup_in_record:
001B22r 2  85 rr                STA     tmp3            ; tmp3 = current field index
001B24r 2  86 rr                STX     tmp3+1          ; tmp3+1 = remaining count
001B26r 2               @scan:
001B26r 2  A5 rr                LDA     tmp3+1
001B28r 2  F0 43                BEQ     @nf
001B2Ar 2               ; compute entry addr: field_table + tmp3*16
001B2Ar 2  A5 rr                LDA     tmp3
001B2Cr 2  0A                   ASL
001B2Dr 2  0A                   ASL
001B2Er 2  0A                   ASL
001B2Fr 2  0A                   ASL                     ; *16 (low byte; carry → hi)
001B30r 2  85 rr                STA     tmp2
001B32r 2  A9 00                LDA     #0
001B34r 2  2A                   ROL
001B35r 2  18                   CLC
001B36r 2  69 rr                ADC     #>field_table
001B38r 2  85 rr                STA     tmp2+1
001B3Ar 2  A5 rr                LDA     tmp2
001B3Cr 2  18                   CLC
001B3Dr 2  69 rr                ADC     #<field_table
001B3Fr 2  85 rr                STA     tmp2
001B41r 2  90 02                BCC     :+
001B43r 2  E6 rr                INC     tmp2+1
001B45r 2               :
001B45r 2               ; compare name length
001B45r 2  A0 00                LDY     #0
001B47r 2  B1 rr                LDA     (tmp2),y
001B49r 2  CD rr rr             CMP     ident_buf
001B4Cr 2  D0 19                BNE     @next
001B4Er 2  AA                   TAX                     ; X = length
001B4Fr 2  A0 01                LDY     #1
001B51r 2               @cmpn:
001B51r 2  B1 rr                LDA     (tmp2),y
001B53r 2  D9 rr rr             CMP     ident_buf,y
001B56r 2  D0 0F                BNE     @next
001B58r 2  C8                   INY
001B59r 2  CA                   DEX
001B5Ar 2  D0 F5                BNE     @cmpn
001B5Cr 2               ; match — return offset and type
001B5Cr 2  A0 0E                LDY     #14
001B5Er 2  B1 rr                LDA     (tmp2),y        ; type
001B60r 2  AA                   TAX
001B61r 2  A0 0D                LDY     #13
001B63r 2  B1 rr                LDA     (tmp2),y        ; offset
001B65r 2  38                   SEC
001B66r 2  60                   RTS
001B67r 2               @next:
001B67r 2  E6 rr                INC     tmp3
001B69r 2  C6 rr                DEC     tmp3+1
001B6Br 2  80 B9                BRA     @scan
001B6Dr 2               @nf:
001B6Dr 2  18                   CLC
001B6Er 2  60                   RTS
001B6Fr 2               
001B6Fr 2               ; ---------------------------------------------------------------------------
001B6Fr 2               ; symtab_find — look up ident_buf in symbol table
001B6Fr 2               ; Returns: carry set = found (tmp3 = pointer to entry)
001B6Fr 2               ;          carry clear = not found
001B6Fr 2               ; Searches from newest (highest index) to oldest for proper scoping
001B6Fr 2               ; ---------------------------------------------------------------------------
001B6Fr 2               symtab_find:
001B6Fr 2  AD rr rr             LDA     symtab_count
001B72r 2  0D rr rr             ORA     symtab_count+1
001B75r 2  D0 02                BNE     :+
001B77r 2  18                   CLC
001B78r 2  60                   RTS                     ; empty table
001B79r 2               :
001B79r 2               ; start from last entry
001B79r 2  AD rr rr             LDA     symtab_count
001B7Cr 2  85 rr                STA     tmp2
001B7Er 2  AD rr rr             LDA     symtab_count+1
001B81r 2  85 rr                STA     tmp2+1
001B83r 2               @loop:
001B83r 2  A5 rr                LDA     tmp2
001B85r 2  05 rr                ORA     tmp2+1
001B87r 2  F0 34                BEQ     @not_found
001B89r 2               ; decrement tmp2
001B89r 2  A5 rr                LDA     tmp2
001B8Br 2  D0 02                BNE     :+
001B8Dr 2  C6 rr                DEC     tmp2+1
001B8Fr 2               :
001B8Fr 2  C6 rr                DEC     tmp2
001B91r 2               ; compute entry address: SYMTAB_BASE + tmp2 * SYM_ENTRY_SZ
001B91r 2               ; tmp2 * 32 = tmp2 << 5
001B91r 2  A5 rr                LDA     tmp2
001B93r 2  0A                   ASL
001B94r 2  0A                   ASL
001B95r 2  0A                   ASL
001B96r 2  0A                   ASL
001B97r 2  0A                   ASL                     ; *32
001B98r 2  18                   CLC
001B99r 2  69 00                ADC     #<SYMTAB_BASE
001B9Br 2  85 rr                STA     tmp3
001B9Dr 2  A5 rr                LDA     tmp2+1
001B9Fr 2  2A                   ROL
001BA0r 2  69 80                ADC     #>SYMTAB_BASE
001BA2r 2  85 rr                STA     tmp3+1
001BA4r 2               ; compare name length
001BA4r 2  A0 00                LDY     #0
001BA6r 2  B1 rr                LDA     (tmp3),y
001BA8r 2  CD rr rr             CMP     ident_buf
001BABr 2  D0 D6                BNE     @loop
001BADr 2               ; compare name chars
001BADr 2  AA                   TAX                     ; X = length
001BAEr 2  A0 00                LDY     #0
001BB0r 2               @cmp:
001BB0r 2  C8                   INY
001BB1r 2  B1 rr                LDA     (tmp3),y
001BB3r 2  D9 rr rr             CMP     ident_buf,y
001BB6r 2  D0 CB                BNE     @loop
001BB8r 2  CA                   DEX
001BB9r 2  D0 F5                BNE     @cmp
001BBBr 2  38                   SEC
001BBCr 2  60                   RTS
001BBDr 2               @not_found:
001BBDr 2  18                   CLC
001BBEr 2  60                   RTS
001BBFr 2               
001BBFr 2               ; ---------------------------------------------------------------------------
001BBFr 2               ; symtab_add — add entry to symbol table
001BBFr 2               ; Inputs:
001BBFr 2               ;   ident_buf = name
001BBFr 2               ;   A = kind (SYM_*)
001BBFr 2               ;   X = data type (TY_*)
001BBFr 2               ;   tmp2 = value/offset word (lo in tmp2, hi in tmp2+1)
001BBFr 2               ; Returns: tmp3 = pointer to new entry; carry set = table full
001BBFr 2               ; ---------------------------------------------------------------------------
001BBFr 2               symtab_add:
001BBFr 2  48                   PHA                     ; save kind (A) — the rest of this routine clobbers A
001BC0r 2  8A                   TXA
001BC1r 2  48                   PHA                     ; save data type (X)
001BC2r 2               ; check capacity
001BC2r 2  AD rr rr             LDA     symtab_count+1
001BC5r 2  C9 00                CMP     #(SYMTAB_MAXSZ / SYM_ENTRY_SZ) >> 8
001BC7r 2  90 0B                BCC     :+
001BC9r 2  AD rr rr             LDA     symtab_count
001BCCr 2  C9 C0                CMP     #(SYMTAB_MAXSZ / SYM_ENTRY_SZ) & $FF
001BCEr 2  90 04                BCC     :+
001BD0r 2  68                   PLA                     ; discard saved type
001BD1r 2  68                   PLA                     ; discard saved kind
001BD2r 2  38                   SEC
001BD3r 2  60                   RTS                     ; table full
001BD4r 2               
001BD4r 2               :       ; compute address of new entry
001BD4r 2  AD rr rr             LDA     symtab_count
001BD7r 2  0A                   ASL
001BD8r 2  0A                   ASL
001BD9r 2  0A                   ASL
001BDAr 2  0A                   ASL
001BDBr 2  0A                   ASL                     ; *32
001BDCr 2  18                   CLC
001BDDr 2  69 00                ADC     #<SYMTAB_BASE
001BDFr 2  85 rr                STA     tmp3
001BE1r 2  AD rr rr             LDA     symtab_count+1
001BE4r 2  2A                   ROL
001BE5r 2  69 80                ADC     #>SYMTAB_BASE
001BE7r 2  85 rr                STA     tmp3+1
001BE9r 2               
001BE9r 2               ; copy name
001BE9r 2  A0 00                LDY     #0
001BEBr 2  AD rr rr             LDA     ident_buf       ; length
001BEEr 2  91 rr                STA     (tmp3),y
001BF0r 2  AA                   TAX
001BF1r 2               @name_copy:
001BF1r 2  C8                   INY
001BF2r 2  B9 rr rr             LDA     ident_buf,y
001BF5r 2  91 rr                STA     (tmp3),y
001BF7r 2  CA                   DEX
001BF8r 2  D0 F7                BNE     @name_copy
001BFAr 2               
001BFAr 2               ; fill unused name bytes with space
001BFAr 2  C8                   INY
001BFBr 2               @pad:
001BFBr 2  C0 10                CPY     #16
001BFDr 2  B0 07                BCS     @done_pad
001BFFr 2  A9 20                LDA     #' '
001C01r 2  91 rr                STA     (tmp3),y
001C03r 2  C8                   INY
001C04r 2  80 F5                BRA     @pad
001C06r 2               @done_pad:
001C06r 2               
001C06r 2               ; data type (was saved on stack first)
001C06r 2  68                   PLA
001C07r 2  A0 11                LDY     #17
001C09r 2  91 rr                STA     (tmp3),y
001C0Br 2               
001C0Br 2               ; kind (was saved on stack second-to-last → on top first)
001C0Br 2  68                   PLA
001C0Cr 2  A0 10                LDY     #16
001C0Er 2  91 rr                STA     (tmp3),y
001C10r 2               
001C10r 2               ; value/offset
001C10r 2  A5 rr                LDA     tmp2
001C12r 2  A0 12                LDY     #18
001C14r 2  91 rr                STA     (tmp3),y
001C16r 2  A5 rr                LDA     tmp2+1
001C18r 2  A0 13                LDY     #19
001C1Ar 2  91 rr                STA     (tmp3),y
001C1Cr 2               
001C1Cr 2               ; scope depth
001C1Cr 2  A5 rr                LDA     scope_depth
001C1Er 2  A0 14                LDY     #20
001C20r 2  91 rr                STA     (tmp3),y
001C22r 2               
001C22r 2               ; zero rest
001C22r 2  A9 00                LDA     #0
001C24r 2  A0 15                LDY     #21
001C26r 2               @zero:
001C26r 2  91 rr                STA     (tmp3),y
001C28r 2  C8                   INY
001C29r 2  C0 20                CPY     #SYM_ENTRY_SZ
001C2Br 2  90 F9                BCC     @zero
001C2Dr 2               
001C2Dr 2               ; increment count
001C2Dr 2  EE rr rr             INC     symtab_count
001C30r 2  D0 03                BNE     :+
001C32r 2  EE rr rr             INC     symtab_count+1
001C35r 2               :
001C35r 2  18                   CLC
001C36r 2  60                   RTS
001C37r 2               
001C37r 2               ; ---------------------------------------------------------------------------
001C37r 2               ; symtab_enter_scope — increment scope depth
001C37r 2               ; ---------------------------------------------------------------------------
001C37r 2               symtab_enter_scope:
001C37r 2  E6 rr                INC     scope_depth
001C39r 2  60                   RTS
001C3Ar 2               
001C3Ar 2               ; ---------------------------------------------------------------------------
001C3Ar 2               ; symtab_leave_scope — remove all entries at current scope, decrement depth
001C3Ar 2               ; ---------------------------------------------------------------------------
001C3Ar 2               symtab_leave_scope:
001C3Ar 2               ; Remove all entries added at current scope depth, then decrement depth.
001C3Ar 2               ; Entries are appended in order, so trim from the end.
001C3Ar 2               @trim:
001C3Ar 2  AD rr rr             LDA     symtab_count
001C3Dr 2  0D rr rr             ORA     symtab_count+1
001C40r 2  F0 34                BEQ     @done           ; table empty
001C42r 2               ; compute address of last entry: SYMTAB_BASE + (count-1)*32
001C42r 2  AD rr rr             LDA     symtab_count
001C45r 2  38                   SEC
001C46r 2  E9 01                SBC     #1
001C48r 2  85 rr                STA     tmp2
001C4Ar 2  AD rr rr             LDA     symtab_count+1
001C4Dr 2  E9 00                SBC     #0
001C4Fr 2  85 rr                STA     tmp2+1
001C51r 2               ; tmp2 * 32 (shift left 5) → entry address
001C51r 2  A5 rr                LDA     tmp2
001C53r 2  0A                   ASL
001C54r 2  0A                   ASL
001C55r 2  0A                   ASL
001C56r 2  0A                   ASL
001C57r 2  0A                   ASL
001C58r 2  18                   CLC
001C59r 2  69 00                ADC     #<SYMTAB_BASE
001C5Br 2  85 rr                STA     tmp3
001C5Dr 2  A5 rr                LDA     tmp2+1
001C5Fr 2  2A                   ROL
001C60r 2  69 80                ADC     #>SYMTAB_BASE
001C62r 2  85 rr                STA     tmp3+1
001C64r 2               ; check scope depth field (offset 20 in entry)
001C64r 2  A0 14                LDY     #20
001C66r 2  B1 rr                LDA     (tmp3),y
001C68r 2  C5 rr                CMP     scope_depth
001C6Ar 2  D0 0A                BNE     @done           ; entry belongs to an outer scope — stop
001C6Cr 2               ; remove this entry
001C6Cr 2  CE rr rr             DEC     symtab_count
001C6Fr 2  D0 C9                BNE     @trim
001C71r 2  CE rr rr             DEC     symtab_count+1
001C74r 2  80 C4                BRA     @trim
001C76r 2               @done:
001C76r 2  C6 rr                DEC     scope_depth
001C78r 2  60                   RTS
001C79r 2               
001C79r 1                       .include        "CODEGEN.ASM"
001C79r 2               ; codegen.asm — p-code emitter for Pascal/65 compiler
001C79r 2               ;
001C79r 2               ; All generated p-code accumulates in CODEBUF_BASE.
001C79r 2               ; cg_pc (zero page) tracks the next write offset.
001C79r 2               
001C79r 2                       .segment        "CODE"
001C79r 2               
001C79r 2               ; ---------------------------------------------------------------------------
001C79r 2               ; emit_byte — append byte A to code buffer
001C79r 2               ; ---------------------------------------------------------------------------
001C79r 2               emit_byte:
001C79r 2  48                   PHA                     ; save byte to emit
001C7Ar 2               ; check buffer full
001C7Ar 2  A5 rr                LDA     cg_pc+1
001C7Cr 2  C9 80                CMP     #>CODEBUF_MAXSZ
001C7Er 2  90 13                BCC     :+
001C80r 2  A5 rr                LDA     cg_pc
001C82r 2  C9 00                CMP     #<CODEBUF_MAXSZ
001C84r 2  90 0D                BCC     :+
001C86r 2               ; error: p-code buffer full
001C86r 2  68                   PLA
001C87r 2  A9 rr                LDA     #<err_pcd_full
001C89r 2  85 rr                STA     tmp0
001C8Br 2  A9 rr                LDA     #>err_pcd_full
001C8Dr 2  85 rr                STA     tmp0+1
001C8Fr 2  20 rr rr             JSR     compile_error
001C92r 2  60                   RTS
001C93r 2               :
001C93r 2               ; store at CODEBUF_BASE + cg_pc
001C93r 2  A5 rr                LDA     cg_pc
001C95r 2  18                   CLC
001C96r 2  69 00                ADC     #<CODEBUF_BASE
001C98r 2  85 rr                STA     tmp2
001C9Ar 2  A5 rr                LDA     cg_pc+1
001C9Cr 2  69 30                ADC     #>CODEBUF_BASE
001C9Er 2  85 rr                STA     tmp2+1
001CA0r 2  68                   PLA
001CA1r 2  A0 00                LDY     #0
001CA3r 2  91 rr                STA     (tmp2),y
001CA5r 2               ; advance cg_pc
001CA5r 2  E6 rr                INC     cg_pc
001CA7r 2  D0 02                BNE     :+
001CA9r 2  E6 rr                INC     cg_pc+1
001CABr 2               :
001CABr 2  60                   RTS
001CACr 2               
001CACr 2               ; ---------------------------------------------------------------------------
001CACr 2               ; emit_word — append word (lo then hi) from tmp2 to code buffer
001CACr 2               ; ---------------------------------------------------------------------------
001CACr 2               emit_word:
001CACr 2  A5 rr                LDA     tmp2
001CAEr 2  20 rr rr             JSR     emit_byte
001CB1r 2  A5 rr                LDA     tmp2+1
001CB3r 2  20 rr rr             JSR     emit_byte
001CB6r 2  60                   RTS
001CB7r 2               
001CB7r 2               ; ---------------------------------------------------------------------------
001CB7r 2               ; emit_opcode — emit single opcode byte in A
001CB7r 2               ; ---------------------------------------------------------------------------
001CB7r 2               emit_opcode:
001CB7r 2  20 rr rr             JSR     emit_byte
001CBAr 2  60                   RTS
001CBBr 2               
001CBBr 2               ; --- Constant emitters ---
001CBBr 2               
001CBBr 2               emit_LDCI:                      ; push sign-extended byte in A
001CBBr 2  48                   PHA
001CBCr 2  A9 00                LDA     #OP_LDCI
001CBEr 2  20 rr rr             JSR     emit_byte
001CC1r 2  68                   PLA
001CC2r 2  20 rr rr             JSR     emit_byte
001CC5r 2  60                   RTS
001CC6r 2               
001CC6r 2               emit_LDCW:                      ; push word: lo in A, hi in scratch
001CC6r 2  48                   PHA
001CC7r 2  A9 01                LDA     #OP_LDCW
001CC9r 2  20 rr rr             JSR     emit_byte
001CCCr 2  68                   PLA
001CCDr 2  20 rr rr             JSR     emit_byte
001CD0r 2  A5 rr                LDA     scratch
001CD2r 2  20 rr rr             JSR     emit_byte
001CD5r 2  60                   RTS
001CD6r 2               
001CD6r 2               emit_LDCC:                      ; push char in A
001CD6r 2  48                   PHA
001CD7r 2  A9 02                LDA     #OP_LDCC
001CD9r 2  20 rr rr             JSR     emit_byte
001CDCr 2  68                   PLA
001CDDr 2  20 rr rr             JSR     emit_byte
001CE0r 2  60                   RTS
001CE1r 2               
001CE1r 2               emit_LDCB:                      ; push boolean in A (0=false, 1=true)
001CE1r 2  48                   PHA
001CE2r 2  A9 03                LDA     #OP_LDCB
001CE4r 2  20 rr rr             JSR     emit_byte
001CE7r 2  68                   PLA
001CE8r 2  20 rr rr             JSR     emit_byte
001CEBr 2  60                   RTS
001CECr 2               
001CECr 2               emit_LDCN:
001CECr 2  A9 05                LDA     #OP_LDCN
001CEEr 2  20 rr rr             JSR     emit_byte
001CF1r 2  60                   RTS
001CF2r 2               
001CF2r 2               ; emit_LDCS — emit OP_LDCS followed by length byte and string bytes.
001CF2r 2               ; Source string lives in ident_buf (length at [0], chars at [1..N]).
001CF2r 2               ; The runtime will inline-fetch length+chars and push the address of
001CF2r 2               ; the length byte as a Pascal-style string pointer.
001CF2r 2               emit_LDCS:
001CF2r 2  A9 04                LDA     #OP_LDCS
001CF4r 2  20 rr rr             JSR     emit_byte
001CF7r 2  AD rr rr             LDA     ident_buf       ; length
001CFAr 2  85 rr                STA     scratch         ; counter / length cache
001CFCr 2  20 rr rr             JSR     emit_byte       ; emit length byte
001CFFr 2  A2 00                LDX     #0
001D01r 2               @loop:
001D01r 2  E4 rr                CPX     scratch
001D03r 2  B0 0B                BCS     @done
001D05r 2  BD rr rr             LDA     ident_buf+1,x
001D08r 2  DA                   PHX
001D09r 2  20 rr rr             JSR     emit_byte       ; clobbers tmp2 only
001D0Cr 2  FA                   PLX
001D0Dr 2  E8                   INX
001D0Er 2  80 F1                BRA     @loop
001D10r 2               @done:
001D10r 2  60                   RTS
001D11r 2               
001D11r 2               ; --- Local variable emitters ---
001D11r 2               
001D11r 2               emit_LDL:                       ; byte offset in A
001D11r 2  48                   PHA
001D12r 2  A9 10                LDA     #OP_LDL
001D14r 2  20 rr rr             JSR     emit_byte
001D17r 2  68                   PLA
001D18r 2  20 rr rr             JSR     emit_byte
001D1Br 2  60                   RTS
001D1Cr 2               
001D1Cr 2               emit_STL:
001D1Cr 2  48                   PHA
001D1Dr 2  A9 11                LDA     #OP_STL
001D1Fr 2  20 rr rr             JSR     emit_byte
001D22r 2  68                   PLA
001D23r 2  20 rr rr             JSR     emit_byte
001D26r 2  60                   RTS
001D27r 2               
001D27r 2               emit_LDA_L:
001D27r 2  48                   PHA
001D28r 2  A9 12                LDA     #OP_LDA_L
001D2Ar 2  20 rr rr             JSR     emit_byte
001D2Dr 2  68                   PLA
001D2Er 2  20 rr rr             JSR     emit_byte
001D31r 2  60                   RTS
001D32r 2               
001D32r 2               ; --- Global variable emitters ---
001D32r 2               
001D32r 2               emit_LDG:                       ; word offset: lo in A, hi in scratch
001D32r 2  48                   PHA
001D33r 2  A9 18                LDA     #OP_LDG
001D35r 2  20 rr rr             JSR     emit_byte
001D38r 2  68                   PLA
001D39r 2  20 rr rr             JSR     emit_byte
001D3Cr 2  A5 rr                LDA     scratch
001D3Er 2  20 rr rr             JSR     emit_byte
001D41r 2  60                   RTS
001D42r 2               
001D42r 2               emit_STG:
001D42r 2  48                   PHA
001D43r 2  A9 19                LDA     #OP_STG
001D45r 2  20 rr rr             JSR     emit_byte
001D48r 2  68                   PLA
001D49r 2  20 rr rr             JSR     emit_byte
001D4Cr 2  A5 rr                LDA     scratch
001D4Er 2  20 rr rr             JSR     emit_byte
001D51r 2  60                   RTS
001D52r 2               
001D52r 2               emit_LDA_G:                     ; word offset: lo in A, hi in scratch
001D52r 2  48                   PHA
001D53r 2  A9 1A                LDA     #OP_LDA_G
001D55r 2  20 rr rr             JSR     emit_byte
001D58r 2  68                   PLA
001D59r 2  20 rr rr             JSR     emit_byte
001D5Cr 2  A5 rr                LDA     scratch
001D5Er 2  20 rr rr             JSR     emit_byte
001D61r 2  60                   RTS
001D62r 2               
001D62r 2               ; --- Indirect (VAR-param) emitters ---
001D62r 2               
001D62r 2               emit_LDIND:
001D62r 2  A9 20                LDA     #OP_LDIND
001D64r 2  4C rr rr             JMP     emit_byte
001D67r 2               
001D67r 2               emit_STIND:
001D67r 2  A9 21                LDA     #OP_STIND
001D69r 2  4C rr rr             JMP     emit_byte
001D6Cr 2               
001D6Cr 2               ; emit_INDEX — OP_INDEX + 2-byte element size word (lo in A, hi in scratch)
001D6Cr 2               emit_INDEX:
001D6Cr 2  48                   PHA
001D6Dr 2  A9 24                LDA     #OP_INDEX
001D6Fr 2  20 rr rr             JSR     emit_byte
001D72r 2  68                   PLA
001D73r 2  20 rr rr             JSR     emit_byte
001D76r 2  A5 rr                LDA     scratch
001D78r 2  20 rr rr             JSR     emit_byte
001D7Br 2  60                   RTS
001D7Cr 2               
001D7Cr 2               ; emit_NEW — OP_NEW + 2-byte allocation size (lo in A, hi in scratch)
001D7Cr 2               emit_NEW:
001D7Cr 2  48                   PHA
001D7Dr 2  A9 70                LDA     #OP_NEW
001D7Fr 2  20 rr rr             JSR     emit_byte
001D82r 2  68                   PLA
001D83r 2  20 rr rr             JSR     emit_byte
001D86r 2  A5 rr                LDA     scratch
001D88r 2  20 rr rr             JSR     emit_byte
001D8Br 2  60                   RTS
001D8Cr 2               
001D8Cr 2               ; emit_DISP — OP_DISP (no operand)
001D8Cr 2               emit_DISP:
001D8Cr 2  A9 71                LDA     #OP_DISP
001D8Er 2  4C rr rr             JMP     emit_byte
001D91r 2               
001D91r 2               ; ---------------------------------------------------------------------------
001D91r 2               ; codegen_alloc_array_global — allocate ARRAY [array_lo..array_hi] in globals
001D91r 2               ; Element size fixed at 2 (all scalars are word-sized).
001D91r 2               ; Returns: tmp2 = adjusted_offset = raw_base - lo*2
001D91r 2               ;          cg_globals advanced by (hi - lo + 1) * 2
001D91r 2               ; Clobbers: tmp2, tmp3
001D91r 2               ; ---------------------------------------------------------------------------
001D91r 2               codegen_alloc_array_global:
001D91r 2               ; count = hi - lo + 1  (16-bit)
001D91r 2  AD rr rr             LDA     array_hi
001D94r 2  38                   SEC
001D95r 2  ED rr rr             SBC     array_lo
001D98r 2  85 rr                STA     tmp2
001D9Ar 2  AD rr rr             LDA     array_hi+1
001D9Dr 2  ED rr rr             SBC     array_lo+1
001DA0r 2  85 rr                STA     tmp2+1
001DA2r 2  E6 rr                INC     tmp2
001DA4r 2  D0 02                BNE     :+
001DA6r 2  E6 rr                INC     tmp2+1
001DA8r 2               :
001DA8r 2               ; alloc_size = count * 2
001DA8r 2  06 rr                ASL     tmp2
001DAAr 2  26 rr                ROL     tmp2+1
001DACr 2               ; save raw_base = cg_globals before advancing
001DACr 2  A5 rr                LDA     cg_globals
001DAEr 2  85 rr                STA     tmp3
001DB0r 2  A5 rr                LDA     cg_globals+1
001DB2r 2  85 rr                STA     tmp3+1
001DB4r 2               ; advance cg_globals by alloc_size (tmp2)
001DB4r 2  A5 rr                LDA     cg_globals
001DB6r 2  18                   CLC
001DB7r 2  65 rr                ADC     tmp2
001DB9r 2  85 rr                STA     cg_globals
001DBBr 2  A5 rr                LDA     cg_globals+1
001DBDr 2  65 rr                ADC     tmp2+1
001DBFr 2  85 rr                STA     cg_globals+1
001DC1r 2               ; adjusted_offset = raw_base (tmp3) - lo*2 (tmp2 reused)
001DC1r 2  AD rr rr             LDA     array_lo
001DC4r 2  0A                   ASL
001DC5r 2  85 rr                STA     tmp2
001DC7r 2  AD rr rr             LDA     array_lo+1
001DCAr 2  2A                   ROL
001DCBr 2  85 rr                STA     tmp2+1
001DCDr 2  A5 rr                LDA     tmp3
001DCFr 2  38                   SEC
001DD0r 2  E5 rr                SBC     tmp2
001DD2r 2  85 rr                STA     tmp2
001DD4r 2  A5 rr                LDA     tmp3+1
001DD6r 2  E5 rr                SBC     tmp2+1
001DD8r 2  85 rr                STA     tmp2+1
001DDAr 2  60                   RTS
001DDBr 2               
001DDBr 2               ; ---------------------------------------------------------------------------
001DDBr 2               ; codegen_alloc_record_global — reserve record_size bytes in globals
001DDBr 2               ; Returns: tmp2 = offset of record's first byte
001DDBr 2               ;          cg_globals advanced by record_size
001DDBr 2               ; ---------------------------------------------------------------------------
001DDBr 2               codegen_alloc_record_global:
001DDBr 2  A5 rr                LDA     cg_globals
001DDDr 2  85 rr                STA     tmp2
001DDFr 2  A5 rr                LDA     cg_globals+1
001DE1r 2  85 rr                STA     tmp2+1
001DE3r 2  18                   CLC
001DE4r 2  A5 rr                LDA     cg_globals
001DE6r 2  6D rr rr             ADC     record_size
001DE9r 2  85 rr                STA     cg_globals
001DEBr 2  A5 rr                LDA     cg_globals+1
001DEDr 2  6D rr rr             ADC     record_size+1
001DF0r 2  85 rr                STA     cg_globals+1
001DF2r 2  60                   RTS
001DF3r 2               
001DF3r 2               ; ---------------------------------------------------------------------------
001DF3r 2               ; codegen_alloc_text_global — reserve FILE_STRUCT_SZ (168) bytes for a TEXT
001DF3r 2               ; variable.  Returns tmp2 = offset of struct's first byte; cg_globals bumped.
001DF3r 2               ; ---------------------------------------------------------------------------
001DF3r 2               codegen_alloc_text_global:
001DF3r 2  A5 rr                LDA     cg_globals
001DF5r 2  85 rr                STA     tmp2
001DF7r 2  A5 rr                LDA     cg_globals+1
001DF9r 2  85 rr                STA     tmp2+1
001DFBr 2  18                   CLC
001DFCr 2  A5 rr                LDA     cg_globals
001DFEr 2  69 A8                ADC     #FILE_STRUCT_SZ
001E00r 2  85 rr                STA     cg_globals
001E02r 2  A5 rr                LDA     cg_globals+1
001E04r 2  69 00                ADC     #0
001E06r 2  85 rr                STA     cg_globals+1
001E08r 2  60                   RTS
001E09r 2               
001E09r 2               ; --- Arithmetic emitters ---
001E09r 2               
001E09r 2               emit_ADI:
001E09r 2  A9 30                LDA     #OP_ADI
001E0Br 2  4C rr rr             JMP     emit_byte
001E0Er 2               
001E0Er 2               emit_SBI:
001E0Er 2  A9 31                LDA     #OP_SBI
001E10r 2  4C rr rr             JMP     emit_byte
001E13r 2               
