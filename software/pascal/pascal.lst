001611r 2  20 rr rr             JSR     next_token
001614r 2  A9 02                LDA     #TY_CHAR
001616r 2  85 rr                STA     expr_type
001618r 2  60                   RTS
001619r 2               
001619r 2               @str_lit:
001619r 2               ; Inline string: emit OP_LDCS + length + chars.  Runtime pushes the
001619r 2               ; address of the length byte as a Pascal-string pointer.
001619r 2  20 rr rr             JSR     emit_LDCS
00161Cr 2  20 rr rr             JSR     next_token
00161Fr 2  A9 04                LDA     #TY_STRING
001621r 2  85 rr                STA     expr_type
001623r 2  60                   RTS
001624r 2               
001624r 2               @ident_or_call:
001624r 2               ; First check for built-ins (LENGTH/POS/COPY/CONCAT/EOF/EOLN/TRUE/FALSE)
001624r 2               ; by length+initial.  These take precedence over user identifiers
001624r 2               ; (matching WRITE/READ handling in parse_assign_or_call).  All dispatch
001624r 2               ; branches use JMPs because the target blocks are scattered too far for
001624r 2               ; ±127 byte BEQ range.
001624r 2  AD rr rr             LDA     ident_buf
001627r 2  C9 03                CMP     #3
001629r 2  D0 03                BNE     @bi_dn3
00162Br 2  4C rr rr             JMP     @bi_chk3
00162Er 2               @bi_dn3:
00162Er 2  C9 04                CMP     #4
001630r 2  D0 03                BNE     @bi_dn4
001632r 2  4C rr rr             JMP     @bi_chk4
001635r 2               @bi_dn4:
001635r 2  C9 05                CMP     #5
001637r 2  D0 03                BNE     @bi_dn5
001639r 2  4C rr rr             JMP     @bi_chk5
00163Cr 2               @bi_dn5:
00163Cr 2  C9 06                CMP     #6
00163Er 2  D0 03                BNE     @bi_dn6
001640r 2  4C rr rr             JMP     @bi_chk_len_or_cat
001643r 2               @bi_dn6:
001643r 2  4C rr rr             JMP     @do_lookup
001646r 2               @bi_chk4:
001646r 2               ; 4-letter built-ins: COPY, EOLN, TRUE
001646r 2  AD rr rr             LDA     ident_buf+1
001649r 2  C9 43                CMP     #'C'
00164Br 2  D0 03                BNE     :+
00164Dr 2  4C rr rr             JMP     @bi_chk_copy
001650r 2               :
001650r 2  C9 45                CMP     #'E'
001652r 2  F0 07                BEQ     @bi_try_eoln
001654r 2  C9 54                CMP     #'T'
