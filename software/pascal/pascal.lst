001D18r 2  A9 82                LDA     #OP_WRITB
001D1Ar 2  4C rr rr             JMP     emit_byte
001D1Dr 2               
001D1Dr 2               emit_WRITS:
001D1Dr 2  A9 83                LDA     #OP_WRITS
001D1Fr 2  4C rr rr             JMP     emit_byte
001D22r 2               
001D22r 2               emit_WRITLN:
001D22r 2  A9 84                LDA     #OP_WRITLN
001D24r 2  4C rr rr             JMP     emit_byte
001D27r 2               
001D27r 2               emit_READI:
001D27r 2  A9 85                LDA     #OP_READI
001D29r 2  4C rr rr             JMP     emit_byte
001D2Cr 2               
001D2Cr 2               emit_READC:
001D2Cr 2  A9 86                LDA     #OP_READC
001D2Er 2  4C rr rr             JMP     emit_byte
001D31r 2               
