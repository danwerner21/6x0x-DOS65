001826r 2               @do_retval_assign:
001826r 2               ; `funcname := expr` inside function body — emit OP_STR which writes
001826r 2               ; the popped value to the current AR's AR_RET_VAL slot.
001826r 2  20 rr rr             JSR     next_token      ; consume function name
001829r 2  A5 rr                LDA     tok_type
00182Br 2  C9 1A                CMP     #TOK_ASSIGN
00182Dr 2  D0 03                BNE     :+
00182Fr 2  20 rr rr             JSR     next_token      ; consume ':='
001832r 2               :
001832r 2  20 rr rr             JSR     parse_expression
001835r 2  AD rr rr             LDA     sym_save_type
001838r 2  20 rr rr             JSR     coerce_expr_to_target_type
00183Br 2  20 rr rr             JSR     emit_STR
00183Er 2  60                   RTS
00183Fr 2               
00183Fr 2               @do_varref_assign:
00183Fr 2               ; VAR-by-reference param assignment: `paramname := expr` where the
00183Fr 2               ; param's local slot holds an address.  Emit:
00183Fr 2               ;   LDL <off>          ; push address (the value passed by caller)
00183Fr 2               ;   <expr>             ; push value
00183Fr 2               ;   STIND              ; pop val, pop addr, store
00183Fr 2  20 rr rr             JSR     next_token      ; consume param name
001842r 2  A5 rr                LDA     tok_type
001844r 2  C9 1A                CMP     #TOK_ASSIGN
001846r 2  D0 03                BNE     :+
001848r 2  20 rr rr             JSR     next_token      ; consume ':='
00184Br 2               :
00184Br 2  AD rr rr             LDA     sym_save_off
00184Er 2  20 rr rr             JSR     emit_LDL        ; push address from local slot
001851r 2  20 rr rr             JSR     parse_expression
001854r 2  AD rr rr             LDA     sym_save_type
001857r 2  20 rr rr             JSR     coerce_expr_to_target_type
00185Ar 2  20 rr rr             JSR     emit_STIND
