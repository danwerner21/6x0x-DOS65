001E0Er 2  20 rr rr             JSR     parse_factor
001E11r 2  20 rr rr             JSR     emit_DVI
001E14r 2  A9 01                LDA     #TY_INT
001E16r 2  85 rr                STA     expr_type
001E18r 2  80 BA                BRA     @mulop
001E1Ar 2               @mod:
