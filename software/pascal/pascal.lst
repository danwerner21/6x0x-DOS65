001AB0r 2  A0 14                LDY     #20
001AB2r 2  B1 rr                LDA     (tmp3),y
001AB4r 2  C5 rr                CMP     scope_depth
001AB6r 2  D0 0A                BNE     @done           ; entry belongs to an outer scope — stop
001AB8r 2               ; remove this entry
001AB8r 2  CE rr rr             DEC     symtab_count
001ABBr 2  D0 C9                BNE     @trim
