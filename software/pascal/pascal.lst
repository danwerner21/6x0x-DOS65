0021FCr 2  20 rr rr             JSR     emit_LDA_G
0021FFr 2  80 23                BRA     @arr_rhs_index
002201r 2               @rec_rhs_global:
002201r 2  8A                   TXA                     ; A=off_lo, scratch=off_hi
002202r 2  20 rr rr             JSR     emit_LDA_G
002205r 2  80 47                BRA     @rec_rhs_field
002207r 2               @local_load:
002207r 2  A5 rr                LDA     expr_type
