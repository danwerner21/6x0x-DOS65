001A64r 2  A0 13                LDY     #19
001A66r 2  91 rr                STA     (tmp3),y
001A68r 2               
001A68r 2               ; scope depth
001A68r 2  A5 rr                LDA     scope_depth
001A6Ar 2  A0 14                LDY     #20
001A6Cr 2  91 rr                STA     (tmp3),y
001A6Er 2               
001A6Er 2               ; zero rest
001A6Er 2  A9 00                LDA     #0
001A70r 2  A0 15                LDY     #21
