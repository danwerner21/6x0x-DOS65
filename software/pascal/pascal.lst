001B2Dr 2               emit_LDCB:                      ; push boolean in A (0=false, 1=true)
001B2Dr 2  48                   PHA
001B2Er 2  A9 03                LDA     #OP_LDCB
001B30r 2  20 rr rr             JSR     emit_byte
001B33r 2  68                   PLA
001B34r 2  20 rr rr             JSR     emit_byte
