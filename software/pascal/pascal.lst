0014BFr 2               emit_LDCB:                      ; push boolean in A (0=false, 1=true)
0014BFr 2  48                   PHA
0014C0r 2  A9 03                LDA     #OP_LDCB
0014C2r 2  20 rr rr             JSR     emit_byte
0014C5r 2  68                   PLA
