002840r 2               
002840r 2               ; --- Indirect (VAR-param) emitters ---
002840r 2               
002840r 2               emit_LDIND:
002840r 2  A9 20                LDA     #OP_LDIND
002842r 2  4C rr rr             JMP     emit_byte
002845r 2               
002845r 2               emit_STIND:
002845r 2  A9 21                LDA     #OP_STIND
002847r 2  4C rr rr             JMP     emit_byte
00284Ar 2               
00284Ar 2               ; emit_INDEX — OP_INDEX + 2-byte element size word (lo in A, hi in scratch)
00284Ar 2               emit_INDEX:
00284Ar 2  48                   PHA
00284Br 2  A9 24                LDA     #OP_INDEX
00284Dr 2  20 rr rr             JSR     emit_byte
002850r 2  68                   PLA
002851r 2  20 rr rr             JSR     emit_byte
002854r 2  A5 rr                LDA     scratch
002856r 2  20 rr rr             JSR     emit_byte
002859r 2  60                   RTS
00285Ar 2               
00285Ar 2               ; emit_NEW — OP_NEW + 2-byte allocation size (lo in A, hi in scratch)
00285Ar 2               emit_NEW:
00285Ar 2  48                   PHA
00285Br 2  A9 70                LDA     #OP_NEW
00285Dr 2  20 rr rr             JSR     emit_byte
002860r 2  68                   PLA
002861r 2  20 rr rr             JSR     emit_byte
002864r 2  A5 rr                LDA     scratch
002866r 2  20 rr rr             JSR     emit_byte
002869r 2  60                   RTS
