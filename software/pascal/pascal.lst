00196Er 2               ; ---------------------------------------------------------------------------
00196Er 2               ; field_lookup_in_record — find ident_buf among a contiguous range of fields
00196Er 2               ; Inputs:
00196Er 2               ;   ident_buf = field name to find
00196Er 2               ;   A         = first field index in field_table
00196Er 2               ;   X         = number of fields to scan
00196Er 2               ; Returns: carry set = found
00196Er 2               ;            A = byte offset within record
00196Er 2               ;            X = field data type
00196Er 2               ;          carry clear = not found
00196Er 2               ; Clobbers: tmp2, tmp3, Y
00196Er 2               ; ---------------------------------------------------------------------------
00196Er 2               field_lookup_in_record:
00196Er 2  85 rr                STA     tmp3            ; tmp3 = current field index
001970r 2  86 rr                STX     tmp3+1          ; tmp3+1 = remaining count
001972r 2               @scan:
001972r 2  A5 rr                LDA     tmp3+1
001974r 2  F0 43                BEQ     @nf
