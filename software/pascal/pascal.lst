0018AFr 2               
0018AFr 2               @do_call:
0018AFr 2               ; Phase B: value parameters (INTEGER words, 2 bytes each).
0018AFr 2               ; sym_save_off       = proc's code address
0018AFr 2               ; sym_save_pcount    = declared parameter count
0018AFr 2               ;
0018AFr 2               ; Calling sequence emitted:
0018AFr 2               ;   MRKSTK <pcount*2>            ; reserves AR + param slots
0018AFr 2               ;   for each arg i:
0018AFr 2               ;       <expr>                   ; pushes value to TOS
0018AFr 2               ;       STL <i*2>                ; pop into local slot i
0018AFr 2               ;   CALL <proc>                  ; jump (saves IPC into AR)
0018AFr 2               ;
0018AFr 2               ; The procedure body reads params via LDL because they were added
0018AFr 2               ; to the symbol table as SYM_VAR with scope=inner (proc) at
0018AFr 2               ; offsets 0, 2, 4, ...
0018AFr 2  20 rr rr             JSR     next_token      ; consume the proc-name identifier
0018B2r 2               ; emit MRKSTK with full local-area size (params + body locals).
0018B2r 2               ; sym_save_lsize was captured at @found_sym from entry offset 23.
0018B2r 2  AD rr rr             LDA     sym_save_lsize
0018B5r 2  20 rr rr             JSR     emit_MRKSTK
