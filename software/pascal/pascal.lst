001298r 2  A5 rr                LDA     expr_type
00129Ar 2  8D rr rr             STA     fcall_type      ; preserve across parse_expression
00129Dr 2  68                   PLA                     ; pcount
00129Er 2  8D rr rr             STA     fcall_pcount
0012A1r 2               ; emit MRKSTK <full local-area size> (params + body locals).
0012A1r 2               ; fcall_lsize was captured at @sym_ok from entry offset 23.
0012A1r 2  AD rr rr             LDA     fcall_lsize
0012A4r 2  20 rr rr             JSR     emit_MRKSTK
0012A7r 2  AD rr rr             LDA     fcall_pcount
0012AAr 2  F0 4A                BEQ     @fc_no_args
0012ACr 2               ; expect '('
0012ACr 2  A5 rr                LDA     tok_type
0012AEr 2  C9 1B                CMP     #TOK_LPAREN
0012B0r 2  D0 56                BNE     @fc_emit_call
0012B2r 2  20 rr rr             JSR     next_token      ; consume '('
0012B5r 2  A2 00                LDX     #0              ; X = arg index
0012B7r 2               @fc_arg_loop:
0012B7r 2               ; Bit X of fcall_vmask → VAR (push address); else value.
0012B7r 2  DA                   PHX
0012B8r 2  A9 01                LDA     #1
0012BAr 2               @fcvbit:
0012BAr 2  E0 00                CPX     #0
0012BCr 2  F0 04                BEQ     @fcvdone
0012BEr 2  0A                   ASL
0012BFr 2  CA                   DEX
0012C0r 2  80 F8                BRA     @fcvbit
0012C2r 2               @fcvdone:
0012C2r 2  FA                   PLX
0012C3r 2  2D rr rr             AND     fcall_vmask
0012C6r 2  F0 07                BEQ     @fc_arg_value
0012C8r 2  DA                   PHX
0012C9r 2  20 rr rr             JSR     parse_arg_lvalue
0012CCr 2  FA                   PLX
0012CDr 2  80 05                BRA     @fc_arg_stored
0012CFr 2               @fc_arg_value:
0012CFr 2  DA                   PHX
0012D0r 2  20 rr rr             JSR     parse_expression
0012D3r 2  FA                   PLX
0012D4r 2               @fc_arg_stored:
0012D4r 2  8A                   TXA
0012D5r 2  0A                   ASL
0012D6r 2  20 rr rr             JSR     emit_STL        ; store popped value (or address) into local slot X
0012D9r 2  E8                   INX
