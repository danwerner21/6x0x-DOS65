001DF1r 2  20 rr rr             JSR     parse_factor
001DF4r 2  68                   PLA
001DF5r 2  C9 09                CMP     #TY_SET
001DF7r 2  F0 09                BEQ     @mul_set
001DF9r 2  20 rr rr             JSR     emit_MPI
001DFCr 2  A9 01                LDA     #TY_INT
001DFEr 2  85 rr                STA     expr_type
001E00r 2  80 D2                BRA     @mulop
001E02r 2               @mul_set:
