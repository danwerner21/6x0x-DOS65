0018B8r 2  AD rr rr             LDA     sym_save_pcount
0018BBr 2  F0 4A                BEQ     @no_args
0018BDr 2               ; expect '(' for arg list
0018BDr 2  A5 rr                LDA     tok_type
0018BFr 2  C9 1B                CMP     #TOK_LPAREN
0018C1r 2  D0 56                BNE     @emit_call      ; missing '(' — caller mistake; emit CALL anyway
0018C3r 2  20 rr rr             JSR     next_token      ; consume '('
0018C6r 2  A2 00                LDX     #0              ; X = current arg index
0018C8r 2               @arg_loop:
0018C8r 2               ; If sym_save_vmask bit X is set, this arg is VAR (push address).
0018C8r 2               ; Otherwise parse_expression (push value).
0018C8r 2  DA                   PHX
0018C9r 2  A9 01                LDA     #1
0018CBr 2               @vbit:
0018CBr 2  E0 00                CPX     #0
0018CDr 2  F0 04                BEQ     @vdone
0018CFr 2  0A                   ASL
0018D0r 2  CA                   DEX
0018D1r 2  80 F8                BRA     @vbit
0018D3r 2               @vdone:
0018D3r 2  FA                   PLX                     ; restore loop counter
0018D4r 2  2D rr rr             AND     sym_save_vmask
0018D7r 2  F0 07                BEQ     @arg_value
0018D9r 2  DA                   PHX
0018DAr 2  20 rr rr             JSR     parse_arg_lvalue
0018DDr 2  FA                   PLX
0018DEr 2  80 05                BRA     @arg_stored
0018E0r 2               @arg_value:
0018E0r 2  DA                   PHX
0018E1r 2  20 rr rr             JSR     parse_expression
0018E4r 2  FA                   PLX
0018E5r 2               @arg_stored:
0018E5r 2               ; emit STL <X*2> — store popped value (or address) into local slot X
0018E5r 2  8A                   TXA
