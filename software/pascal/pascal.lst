0011ADr 2               TOK_DIV_KW      = TOK_DIV       ; alias
0011ADr 2               
0011ADr 2               ; ---------------------------------------------------------------------------
0011ADr 2               ; parse_factor — literal | variable | ( expr ) | NOT factor
0011ADr 2               ; ---------------------------------------------------------------------------
