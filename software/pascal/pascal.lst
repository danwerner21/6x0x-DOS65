001E31r 2  A9 42                LDA     #OP_LESI
001E33r 2  4C rr rr             JMP     emit_byte
001E36r 2               
001E36r 2               emit_LEQI:
001E36r 2  A9 43                LDA     #OP_LEQI
001E38r 2  4C rr rr             JMP     emit_byte
001E3Br 2               
001E3Br 2               emit_GTRI:
001E3Br 2  A9 44                LDA     #OP_GTRI
001E3Dr 2  4C rr rr             JMP     emit_byte
001E40r 2               
001E40r 2               emit_GEQI:
001E40r 2  A9 45                LDA     #OP_GEQI
001E42r 2  4C rr rr             JMP     emit_byte
001E45r 2               
001E45r 2               ; --- Logical ---
001E45r 2               
001E45r 2               emit_LAND:
001E45r 2  A9 38                LDA     #OP_LAND
001E47r 2  4C rr rr             JMP     emit_byte
001E4Ar 2               
001E4Ar 2               emit_LOR:
001E4Ar 2  A9 39                LDA     #OP_LOR
001E4Cr 2  4C rr rr             JMP     emit_byte
001E4Fr 2               
001E4Fr 2               emit_LNOT:
001E4Fr 2  A9 3A                LDA     #OP_LNOT
001E51r 2  4C rr rr             JMP     emit_byte
001E54r 2               
001E54r 2               ; --- Jump emitters ---
001E54r 2               ; Returns: A/scratch = offset of the word operand in code buffer
001E54r 2               ; (needed for backpatching)
001E54r 2               
001E54r 2               emit_UJP:                       ; emit UJP with placeholder offset
001E54r 2  A9 50                LDA     #OP_UJP
001E56r 2  20 rr rr             JSR     emit_byte
001E59r 2  A5 rr                LDA     cg_pc           ; save patch address
001E5Br 2  48                   PHA
001E5Cr 2  A5 rr                LDA     cg_pc+1
001E5Er 2  48                   PHA
001E5Fr 2  A9 00                LDA     #$00
001E61r 2  20 rr rr             JSR     emit_byte       ; placeholder lo
001E64r 2  A9 00                LDA     #$00
001E66r 2  20 rr rr             JSR     emit_byte       ; placeholder hi
001E69r 2  68                   PLA
001E6Ar 2  85 rr                STA     scratch
001E6Cr 2  68                   PLA                     ; lo of patch address
001E6Dr 2  60                   RTS                     ; caller: save A/scratch as patch point
001E6Er 2               
001E6Er 2               emit_FJP:
001E6Er 2  A9 51                LDA     #OP_FJP
001E70r 2  20 rr rr             JSR     emit_byte
001E73r 2  A5 rr                LDA     cg_pc
001E75r 2  48                   PHA
001E76r 2  A5 rr                LDA     cg_pc+1
001E78r 2  48                   PHA
001E79r 2  A9 00                LDA     #$00
001E7Br 2  20 rr rr             JSR     emit_byte
001E7Er 2  A9 00                LDA     #$00
001E80r 2  20 rr rr             JSR     emit_byte
001E83r 2  68                   PLA
001E84r 2  85 rr                STA     scratch
001E86r 2  68                   PLA
001E87r 2  60                   RTS
001E88r 2               
001E88r 2               emit_TJP:
001E88r 2  A9 52                LDA     #OP_TJP
001E8Ar 2  20 rr rr             JSR     emit_byte
001E8Dr 2  A5 rr                LDA     cg_pc
001E8Fr 2  48                   PHA
001E90r 2  A5 rr                LDA     cg_pc+1
001E92r 2  48                   PHA
001E93r 2  A9 00                LDA     #$00
001E95r 2  20 rr rr             JSR     emit_byte
001E98r 2  A9 00                LDA     #$00
001E9Ar 2  20 rr rr             JSR     emit_byte
001E9Dr 2  68                   PLA
001E9Er 2  85 rr                STA     scratch
001EA0r 2  68                   PLA
001EA1r 2  60                   RTS
001EA2r 2               
001EA2r 2               ; ---------------------------------------------------------------------------
001EA2r 2               ; patch_jump — fill in jump offset at patch address stored in tmp2 (word)
001EA2r 2               ; The offset is computed as: (current cg_pc) - (patch_addr + 2)
001EA2r 2               ; i.e. relative to instruction after the operand word
001EA2r 2               ; ---------------------------------------------------------------------------
001EA2r 2               patch_jump:
001EA2r 2               ; delta = cg_pc - (patch_addr + 2)
001EA2r 2               ;   compute (cg_pc - 2) first, then subtract patch_addr
001EA2r 2  A5 rr                LDA     cg_pc
001EA4r 2  38                   SEC
001EA5r 2  E9 02                SBC     #2
001EA7r 2  85 rr                STA     scratch         ; lo of (cg_pc - 2)
001EA9r 2  A5 rr                LDA     cg_pc+1
001EABr 2  E9 00                SBC     #0
001EADr 2  85 rr                STA     scratch+1       ; hi of (cg_pc - 2)
001EAFr 2  38                   SEC
001EB0r 2  A5 rr                LDA     scratch
001EB2r 2  E5 rr                SBC     tmp2
001EB4r 2  48                   PHA
001EB5r 2  A5 rr                LDA     scratch+1
001EB7r 2  E5 rr                SBC     tmp2+1
001EB9r 2  85 rr                STA     scratch+1       ; high byte of delta
001EBBr 2  68                   PLA
001EBCr 2  85 rr                STA     scratch         ; low byte of delta
001EBEr 2               ; write delta at patch address (CODEBUF_BASE + tmp2)
001EBEr 2  A5 rr                LDA     tmp2
001EC0r 2  18                   CLC
001EC1r 2  69 00                ADC     #<CODEBUF_BASE
001EC3r 2  85 rr                STA     tmp3
001EC5r 2  A5 rr                LDA     tmp2+1
001EC7r 2  69 30                ADC     #>CODEBUF_BASE
001EC9r 2  85 rr                STA     tmp3+1
001ECBr 2  A0 00                LDY     #0
001ECDr 2  A5 rr                LDA     scratch
001ECFr 2  91 rr                STA     (tmp3),y
001ED1r 2  C8                   INY
001ED2r 2  A5 rr                LDA     scratch+1
001ED4r 2  91 rr                STA     (tmp3),y
001ED6r 2  60                   RTS
001ED7r 2               
001ED7r 2               ; --- I/O emitters ---
001ED7r 2               
001ED7r 2               emit_WRITI:
001ED7r 2  A9 80                LDA     #OP_WRITI
001ED9r 2  4C rr rr             JMP     emit_byte
001EDCr 2               
001EDCr 2               emit_WRITC:
001EDCr 2  A9 81                LDA     #OP_WRITC
001EDEr 2  4C rr rr             JMP     emit_byte
001EE1r 2               
001EE1r 2               emit_WRITB:
001EE1r 2  A9 82                LDA     #OP_WRITB
001EE3r 2  4C rr rr             JMP     emit_byte
001EE6r 2               
001EE6r 2               emit_WRITS:
001EE6r 2  A9 83                LDA     #OP_WRITS
001EE8r 2  4C rr rr             JMP     emit_byte
001EEBr 2               
001EEBr 2               emit_WRITLN:
001EEBr 2  A9 84                LDA     #OP_WRITLN
001EEDr 2  4C rr rr             JMP     emit_byte
001EF0r 2               
001EF0r 2               emit_READI:
001EF0r 2  A9 85                LDA     #OP_READI
001EF2r 2  4C rr rr             JMP     emit_byte
001EF5r 2               
001EF5r 2               emit_READC:
001EF5r 2  A9 86                LDA     #OP_READC
001EF7r 2  4C rr rr             JMP     emit_byte
001EFAr 2               
001EFAr 2               ; --- Stack ---
001EFAr 2               
001EFAr 2               emit_DUP:
001EFAr 2  A9 90                LDA     #OP_DUP
001EFCr 2  4C rr rr             JMP     emit_byte
001EFFr 2               
001EFFr 2               emit_POP:
001EFFr 2  A9 91                LDA     #OP_POP
001F01r 2  4C rr rr             JMP     emit_byte
001F04r 2               
001F04r 2               ; --- Calls ---
001F04r 2               
001F04r 2               emit_MRKSTK:                    ; local size in A
001F04r 2  48                   PHA
001F05r 2  A9 64                LDA     #OP_MRKSTK
001F07r 2  20 rr rr             JSR     emit_byte
001F0Ar 2  68                   PLA
001F0Br 2  4C rr rr             JMP     emit_byte
001F0Er 2               
001F0Er 2               emit_RET:
001F0Er 2  A9 62                LDA     #OP_RET
001F10r 2  4C rr rr             JMP     emit_byte
001F13r 2               
001F13r 2               emit_RETF:
001F13r 2  A9 63                LDA     #OP_RETF
001F15r 2  4C rr rr             JMP     emit_byte
001F18r 2               
001F18r 2               emit_STR:
001F18r 2  A9 66                LDA     #OP_STR
001F1Ar 2  4C rr rr             JMP     emit_byte
001F1Dr 2               
001F1Dr 2               ; emit_CALL — A = target absolute code-buffer addr lo, scratch = hi
001F1Dr 2               ; Emits OP_CALL + signed 16-bit offset = target - (cg_pc_after_operand)
001F1Dr 2               emit_CALL:
001F1Dr 2  48                   PHA                     ; target lo
001F1Er 2  A5 rr                LDA     scratch
001F20r 2  48                   PHA                     ; target hi
001F21r 2  A9 60                LDA     #OP_CALL
001F23r 2  20 rr rr             JSR     emit_byte       ; clobbers tmp2; preserves scratch & 6502 stack
001F26r 2               ; compute offset = target - cg_pc - 2 (16-bit)
001F26r 2  68                   PLA                     ; target hi
001F27r 2  AA                   TAX
001F28r 2  68                   PLA                     ; target lo
001F29r 2  38                   SEC
001F2Ar 2  E9 02                SBC     #2
001F2Cr 2  48                   PHA                     ; partial lo
001F2Dr 2  8A                   TXA                     ; target hi
001F2Er 2  E9 00                SBC     #0
001F30r 2  85 rr                STA     scratch         ; partial hi
001F32r 2  68                   PLA                     ; partial lo
001F33r 2  38                   SEC
001F34r 2  E5 rr                SBC     cg_pc
001F36r 2  48                   PHA                     ; offset lo
001F37r 2  A5 rr                LDA     scratch
001F39r 2  E5 rr                SBC     cg_pc+1
001F3Br 2  85 rr                STA     scratch         ; offset hi
001F3Dr 2  68                   PLA
001F3Er 2  20 rr rr             JSR     emit_byte       ; emit offset lo
001F41r 2  A5 rr                LDA     scratch
001F43r 2  20 rr rr             JSR     emit_byte       ; emit offset hi
001F46r 2  60                   RTS
001F47r 2               
001F47r 2               emit_HALT:
001F47r 2  A9 FF                LDA     #OP_HALT
001F49r 2  4C rr rr             JMP     emit_byte
001F4Cr 2               
001F4Cr 2               ; --- String built-ins ---
001F4Cr 2               
001F4Cr 2               emit_LEN:
001F4Cr 2  A9 A0                LDA     #OP_LEN
001F4Er 2  4C rr rr             JMP     emit_byte
001F51r 2               
001F51r 2               emit_POS:
001F51r 2  A9 A1                LDA     #OP_POS
001F53r 2  4C rr rr             JMP     emit_byte
001F56r 2               
001F56r 2               emit_COPY:
001F56r 2  A9 A2                LDA     #OP_COPY
001F58r 2  4C rr rr             JMP     emit_byte
001F5Br 2               
001F5Br 2               emit_CONCAT:
001F5Br 2  A9 A3                LDA     #OP_CONCAT
001F5Dr 2  4C rr rr             JMP     emit_byte
001F60r 2               
001F60r 2               ; --- TEXT file I/O ---
001F60r 2               
001F60r 2               emit_FASSGN:
001F60r 2  A9 B0                LDA     #OP_FASSGN
001F62r 2  4C rr rr             JMP     emit_byte
001F65r 2               emit_FRESET:
001F65r 2  A9 B1                LDA     #OP_FRESET
001F67r 2  4C rr rr             JMP     emit_byte
001F6Ar 2               emit_FREWRT:
001F6Ar 2  A9 B2                LDA     #OP_FREWRT
001F6Cr 2  4C rr rr             JMP     emit_byte
001F6Fr 2               emit_FCLOSE:
001F6Fr 2  A9 B3                LDA     #OP_FCLOSE
001F71r 2  4C rr rr             JMP     emit_byte
001F74r 2               emit_FWRC:
001F74r 2  A9 B4                LDA     #OP_FWRC
001F76r 2  4C rr rr             JMP     emit_byte
001F79r 2               emit_FWRS:
001F79r 2  A9 B5                LDA     #OP_FWRS
001F7Br 2  4C rr rr             JMP     emit_byte
001F7Er 2               emit_FWRI:
001F7Er 2  A9 B6                LDA     #OP_FWRI
001F80r 2  4C rr rr             JMP     emit_byte
001F83r 2               emit_FWLN:
001F83r 2  A9 B7                LDA     #OP_FWLN
001F85r 2  4C rr rr             JMP     emit_byte
001F88r 2               emit_FRDC:
001F88r 2  A9 B8                LDA     #OP_FRDC
001F8Ar 2  4C rr rr             JMP     emit_byte
001F8Dr 2               emit_FRDI:
001F8Dr 2  A9 B9                LDA     #OP_FRDI
001F8Fr 2  4C rr rr             JMP     emit_byte
001F92r 2               emit_FRDLN:
001F92r 2  A9 BA                LDA     #OP_FRDLN
001F94r 2  4C rr rr             JMP     emit_byte
001F97r 2               emit_FEOF:
001F97r 2  A9 BB                LDA     #OP_FEOF
001F99r 2  4C rr rr             JMP     emit_byte
001F9Cr 2               emit_FRDS:
001F9Cr 2  A9 BD                LDA     #OP_FRDS
001F9Er 2  4C rr rr             JMP     emit_byte
001FA1r 2               emit_FWRB:
001FA1r 2  A9 BE                LDA     #OP_FWRB
001FA3r 2  4C rr rr             JMP     emit_byte
001FA6r 2               emit_FEOLN:
001FA6r 2  A9 BF                LDA     #OP_FEOLN
001FA8r 2  4C rr rr             JMP     emit_byte
001FABr 2               
001FABr 2               ; ---------------------------------------------------------------------------
001FABr 2               ; codegen_alloc_global — reserve N bytes in global area; return offset in tmp2
001FABr 2               ; N in A
001FABr 2               ; ---------------------------------------------------------------------------
001FABr 2               codegen_alloc_global:
001FABr 2  A5 rr                LDA     cg_globals
001FADr 2  85 rr                STA     tmp2
001FAFr 2  A5 rr                LDA     cg_globals+1
001FB1r 2  85 rr                STA     tmp2+1
001FB3r 2               ; advance by N (passed in A — caller puts size here)
001FB3r 2               ; For now allocate 2 bytes (word) per variable
001FB3r 2  A5 rr                LDA     cg_globals
001FB5r 2  18                   CLC
001FB6r 2  69 02                ADC     #2
001FB8r 2  85 rr                STA     cg_globals
001FBAr 2  90 02                BCC     :+
001FBCr 2  E6 rr                INC     cg_globals+1
001FBEr 2               :
001FBEr 2  60                   RTS
001FBFr 2               
001FBFr 1                       .include        "IOLIB.ASM"
001FBFr 2               .pc02
001FBFr 2               ; iolib.asm — console and file I/O wrappers for DOS/65
001FBFr 2               ;
001FBFr 2               ; Uses PEM function 2 (CONOUT) for character output.
001FBFr 2               ; This routes through DFT_CONSOLE and works on all platforms
001FBFr 2               ; (serial, ESP video, memory-mapped video) regardless of which
001FBFr 2               ; console driver is active.
001FBFr 2               
001FBFr 2                       .segment        "CODE"
001FBFr 2               
001FBFr 2               ; ---------------------------------------------------------------------------
001FBFr 2               ; console_putc — output character in A to console via PEM #2
001FBFr 2               ; ---------------------------------------------------------------------------
001FBFr 2               console_putc:
001FBFr 2  48                   PHA
001FC0r 2  A2 02                LDX     #PEM_CONOUT
001FC2r 2  20 03 01             JSR     PEM_ENTRY
001FC5r 2  68                   PLA
001FC6r 2  60                   RTS
001FC7r 2               
001FC7r 2               ; ---------------------------------------------------------------------------
001FC7r 2               ; console_newline — emit CR+LF
001FC7r 2               ; ---------------------------------------------------------------------------
001FC7r 2               console_newline:
001FC7r 2  A9 0D                LDA     #$0D
001FC9r 2  A2 02                LDX     #PEM_CONOUT
001FCBr 2  20 03 01             JSR     PEM_ENTRY
001FCEr 2  A9 0A                LDA     #$0A
001FD0r 2  A2 02                LDX     #PEM_CONOUT
001FD2r 2  20 03 01             JSR     PEM_ENTRY
001FD5r 2  60                   RTS
001FD6r 2               
001FD6r 2               ; ---------------------------------------------------------------------------
001FD6r 2               ; console_print_sz — print null-terminated string at tmp0
001FD6r 2               ; ---------------------------------------------------------------------------
001FD6r 2               console_print_sz:
001FD6r 2  A0 00                LDY     #0
001FD8r 2               @loop:
001FD8r 2  B1 rr                LDA     (tmp0),y
001FDAr 2  F0 08                BEQ     @done
001FDCr 2  A2 02                LDX     #PEM_CONOUT
001FDEr 2  20 03 01             JSR     PEM_ENTRY
001FE1r 2  C8                   INY
001FE2r 2  D0 F4                BNE     @loop
001FE4r 2               @done:
001FE4r 2  60                   RTS
001FE5r 2               
001FE5r 2               ; ---------------------------------------------------------------------------
001FE5r 2               ; console_print_pstr — print length-prefixed Pascal string at tmp0
001FE5r 2               ; ---------------------------------------------------------------------------
001FE5r 2               console_print_pstr:
001FE5r 2  A0 00                LDY     #0
001FE7r 2  B1 rr                LDA     (tmp0),y        ; length byte
001FE9r 2  F0 10                BEQ     @done
001FEBr 2  AA                   TAX                     ; X = remaining chars — but X used by PEM!
001FECr 2               ; save length, use tmp1 as counter
001FECr 2  85 rr                STA     tmp1
001FEEr 2  C8                   INY
001FEFr 2               @loop:
001FEFr 2  B1 rr                LDA     (tmp0),y
001FF1r 2  A2 02                LDX     #PEM_CONOUT
001FF3r 2  20 03 01             JSR     PEM_ENTRY
001FF6r 2  C8                   INY
001FF7r 2  C6 rr                DEC     tmp1
001FF9r 2  D0 F4                BNE     @loop
001FFBr 2               @done:
001FFBr 2  60                   RTS
001FFCr 2               
001FFCr 2               ; ---------------------------------------------------------------------------
001FFCr 2               ; console_print_dec — print signed 16-bit integer in tmp0:tmp0+1
001FFCr 2               ; ---------------------------------------------------------------------------
001FFCr 2               console_print_dec:
001FFCr 2  A5 rr                LDA     tmp0+1
001FFEr 2  10 14                BPL     @positive
002000r 2  A9 2D                LDA     #'-'
002002r 2  A2 02                LDX     #PEM_CONOUT
002004r 2  20 03 01             JSR     PEM_ENTRY
002007r 2  A9 00                LDA     #0
002009r 2  38                   SEC
00200Ar 2  E5 rr                SBC     tmp0
00200Cr 2  85 rr                STA     tmp0
00200Er 2  A9 00                LDA     #0
002010r 2  E5 rr                SBC     tmp0+1
002012r 2  85 rr                STA     tmp0+1
002014r 2               @positive:
002014r 2  A9 00                LDA     #0
002016r 2  48                   PHA                     ; sentinel
002017r 2               @div_loop:
002017r 2  20 rr rr             JSR     div16_by10      ; quotient→tmp0, remainder→scratch
00201Ar 2  A5 rr                LDA     scratch
00201Cr 2  18                   CLC
00201Dr 2  69 30                ADC     #'0'
00201Fr 2  48                   PHA
002020r 2  A5 rr                LDA     tmp0
002022r 2  05 rr                ORA     tmp0+1
002024r 2  D0 F1                BNE     @div_loop
002026r 2               @print_loop:
002026r 2  68                   PLA
002027r 2  F0 07                BEQ     @done2          ; sentinel
002029r 2  A2 02                LDX     #PEM_CONOUT
00202Br 2  20 03 01             JSR     PEM_ENTRY
00202Er 2  80 F6                BRA     @print_loop
002030r 2               @done2:
002030r 2  60                   RTS
002031r 2               
002031r 2               ; ---------------------------------------------------------------------------
002031r 2               ; div16_by10 — divide tmp0:tmp0+1 by 10
002031r 2               ; Result: quotient in tmp0:tmp0+1, remainder in scratch
002031r 2               ; ---------------------------------------------------------------------------
002031r 2               div16_by10:
002031r 2  A9 00                LDA     #0
002033r 2  85 rr                STA     scratch
002035r 2  A2 10                LDX     #16
002037r 2               @bit:
002037r 2  06 rr                ASL     tmp0
002039r 2  26 rr                ROL     tmp0+1
00203Br 2  26 rr                ROL     scratch
00203Dr 2  A5 rr                LDA     scratch
00203Fr 2  C9 0A                CMP     #10
002041r 2  90 06                BCC     @no_sub
002043r 2  E9 0A                SBC     #10
002045r 2  85 rr                STA     scratch
002047r 2  E6 rr                INC     tmp0
002049r 2               @no_sub:
002049r 2  CA                   DEX
00204Ar 2  D0 EB                BNE     @bit
00204Cr 2  60                   RTS
00204Dr 2               
00204Dr 2               ; ---------------------------------------------------------------------------
00204Dr 2               ; console_read_line — read a line into buffer at tmp0, max len in x_save
00204Dr 2               ; Returns: Y = length (not including CR)
00204Dr 2               ; ---------------------------------------------------------------------------
00204Dr 2               console_read_line:
00204Dr 2  8E rr rr             STX     x_save
002050r 2  A0 00                LDY     #0
002052r 2               @loop:
002052r 2  A2 01                LDX     #PEM_CONIN
002054r 2  20 03 01             JSR     PEM_ENTRY
002057r 2  C9 0D                CMP     #$0D
002059r 2  F0 28                BEQ     @done
00205Br 2  C9 08                CMP     #$08            ; backspace
00205Dr 2  D0 1C                BNE     @store
00205Fr 2  C0 00                CPY     #0
002061r 2  F0 EF                BEQ     @loop
002063r 2  88                   DEY
002064r 2  A9 08                LDA     #$08
002066r 2  A2 02                LDX     #PEM_CONOUT
002068r 2  20 03 01             JSR     PEM_ENTRY
00206Br 2  A9 20                LDA     #' '
00206Dr 2  A2 02                LDX     #PEM_CONOUT
00206Fr 2  20 03 01             JSR     PEM_ENTRY
002072r 2  A9 08                LDA     #$08
002074r 2  A2 02                LDX     #PEM_CONOUT
002076r 2  20 03 01             JSR     PEM_ENTRY
002079r 2  80 D7                BRA     @loop
00207Br 2               @store:
00207Br 2  91 rr                STA     (tmp0),y
00207Dr 2  C8                   INY
00207Er 2  CC rr rr             CPY     x_save
002081r 2  90 CF                BCC     @loop
002083r 2               @done:
002083r 2  60                   RTS
002084r 2               x_save:
002084r 2  00                   .BYTE   0
002085r 2               
002085r 2               ; ---------------------------------------------------------------------------
002085r 2               ; file_open — open file via FCB at tmp1; returns A=0 success, $FF=not found
002085r 2               ; PEM calling convention: X=function, A=FCB addr lo, Y=FCB addr hi
002085r 2               ; ---------------------------------------------------------------------------
002085r 2               file_open:
002085r 2  A5 rr                LDA     tmp1
002087r 2  A4 rr                LDY     tmp1+1
002089r 2  A2 0F                LDX     #PEM_OPEN
00208Br 2  20 03 01             JSR     PEM_ENTRY
00208Er 2  60                   RTS
00208Fr 2               
00208Fr 2               ; ---------------------------------------------------------------------------
00208Fr 2               ; file_make — create/truncate file via FCB at tmp1
00208Fr 2               ; ---------------------------------------------------------------------------
00208Fr 2               file_make:
00208Fr 2  A5 rr                LDA     tmp1
002091r 2  A4 rr                LDY     tmp1+1
002093r 2  A2 16                LDX     #PEM_MAKE
002095r 2  20 03 01             JSR     PEM_ENTRY
002098r 2  60                   RTS
002099r 2               
002099r 2               ; ---------------------------------------------------------------------------
002099r 2               ; file_read_sector — read 128 bytes into DMA_BUF; returns A=0 ok, A=1 EOF
002099r 2               ; ---------------------------------------------------------------------------
002099r 2               file_read_sector:
002099r 2  A5 rr                LDA     tmp1
00209Br 2  A4 rr                LDY     tmp1+1
00209Dr 2  A2 14                LDX     #PEM_READ
00209Fr 2  20 03 01             JSR     PEM_ENTRY
0020A2r 2  60                   RTS
0020A3r 2               
0020A3r 2               ; ---------------------------------------------------------------------------
0020A3r 2               ; file_write_sector — write 128 bytes from DMA_BUF
0020A3r 2               ; ---------------------------------------------------------------------------
0020A3r 2               file_write_sector:
0020A3r 2  A5 rr                LDA     tmp1
0020A5r 2  A4 rr                LDY     tmp1+1
0020A7r 2  A2 15                LDX     #PEM_WRITE
0020A9r 2  20 03 01             JSR     PEM_ENTRY
0020ACr 2  60                   RTS
0020ADr 2               
0020ADr 2               ; ---------------------------------------------------------------------------
0020ADr 2               ; file_close — close FCB at tmp1
0020ADr 2               ; ---------------------------------------------------------------------------
0020ADr 2               file_close:
0020ADr 2  A5 rr                LDA     tmp1
0020AFr 2  A4 rr                LDY     tmp1+1
0020B1r 2  A2 10                LDX     #PEM_CLOSE
0020B3r 2  20 03 01             JSR     PEM_ENTRY
0020B6r 2  60                   RTS
0020B7r 2               
0020B7r 2               ; ---------------------------------------------------------------------------
0020B7r 2               ; file_setdma — point PEM at the 128-byte buffer at (A:Y)
0020B7r 2               ; A = lo, Y = hi.  Trashes X.
0020B7r 2               ; ---------------------------------------------------------------------------
0020B7r 2               file_setdma:
0020B7r 2  A2 1A                LDX     #PEM_SETDMA
0020B9r 2  4C 03 01             JMP     PEM_ENTRY
0020BCr 2               
0020BCr 2               ; ---------------------------------------------------------------------------
0020BCr 2               ; file_setdma_default — restore PEM DMA pointer to system DMA_BUF
0020BCr 2               ; ---------------------------------------------------------------------------
0020BCr 2               file_setdma_default:
0020BCr 2  A9 28                LDA     #<DMA_BUF
0020BEr 2  A0 01                LDY     #>DMA_BUF
0020C0r 2  A2 1A                LDX     #PEM_SETDMA
0020C2r 2  4C 03 01             JMP     PEM_ENTRY
0020C5r 2               
