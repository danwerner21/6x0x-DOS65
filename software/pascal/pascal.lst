001A0Br 2               ; ---------------------------------------------------------------------------
001A0Br 2               ; symtab_add — add entry to symbol table
001A0Br 2               ; Inputs:
001A0Br 2               ;   ident_buf = name
001A0Br 2               ;   A = kind (SYM_*)
001A0Br 2               ;   X = data type (TY_*)
001A0Br 2               ;   tmp2 = value/offset word (lo in tmp2, hi in tmp2+1)
001A0Br 2               ; Returns: tmp3 = pointer to new entry; carry set = table full
001A0Br 2               ; ---------------------------------------------------------------------------
001A0Br 2               symtab_add:
001A0Br 2  48                   PHA                     ; save kind (A) — the rest of this routine clobbers A
001A0Cr 2  8A                   TXA
001A0Dr 2  48                   PHA                     ; save data type (X)
001A0Er 2               ; check capacity
001A0Er 2  AD rr rr             LDA     symtab_count+1
001A11r 2  C9 00                CMP     #(SYMTAB_MAXSZ / SYM_ENTRY_SZ) >> 8
001A13r 2  90 0B                BCC     :+
001A15r 2  AD rr rr             LDA     symtab_count
001A18r 2  C9 C0                CMP     #(SYMTAB_MAXSZ / SYM_ENTRY_SZ) & $FF
001A1Ar 2  90 04                BCC     :+
001A1Cr 2  68                   PLA                     ; discard saved type
001A1Dr 2  68                   PLA                     ; discard saved kind
001A1Er 2  38                   SEC
001A1Fr 2  60                   RTS                     ; table full
001A20r 2               
001A20r 2               :       ; compute address of new entry
001A20r 2  AD rr rr             LDA     symtab_count
001A23r 2  0A                   ASL
001A24r 2  0A                   ASL
001A25r 2  0A                   ASL
001A26r 2  0A                   ASL
001A27r 2  0A                   ASL                     ; *32
001A28r 2  18                   CLC
001A29r 2  69 00                ADC     #<SYMTAB_BASE
001A2Br 2  85 rr                STA     tmp3
001A2Dr 2  AD rr rr             LDA     symtab_count+1
001A30r 2  2A                   ROL
001A31r 2  69 80                ADC     #>SYMTAB_BASE
001A33r 2  85 rr                STA     tmp3+1
001A35r 2               
001A35r 2               ; copy name
001A35r 2  A0 00                LDY     #0
001A37r 2  AD rr rr             LDA     ident_buf       ; length
001A3Ar 2  91 rr                STA     (tmp3),y
001A3Cr 2  AA                   TAX
001A3Dr 2               @name_copy:
001A3Dr 2  C8                   INY
001A3Er 2  B9 rr rr             LDA     ident_buf,y
001A41r 2  91 rr                STA     (tmp3),y
001A43r 2  CA                   DEX
001A44r 2  D0 F7                BNE     @name_copy
001A46r 2               
001A46r 2               ; fill unused name bytes with space
001A46r 2  C8                   INY
