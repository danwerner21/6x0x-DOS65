001976r 2  A5 rr                LDA     tmp3
001978r 2  0A                   ASL
001979r 2  0A                   ASL
00197Ar 2  0A                   ASL
00197Br 2  0A                   ASL                     ; *16 (low byte; carry → hi)
00197Cr 2  85 rr                STA     tmp2
00197Er 2  A9 00                LDA     #0
001980r 2  2A                   ROL
001981r 2  18                   CLC
001982r 2  69 rr                ADC     #>field_table
001984r 2  85 rr                STA     tmp2+1
001986r 2  A5 rr                LDA     tmp2
001988r 2  18                   CLC
001989r 2  69 rr                ADC     #<field_table
00198Br 2  85 rr                STA     tmp2
00198Dr 2  90 02                BCC     :+
00198Fr 2  E6 rr                INC     tmp2+1
