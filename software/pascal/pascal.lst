001B46r 2  85 rr                STA     scratch         ; counter / length cache
001B48r 2  20 rr rr             JSR     emit_byte       ; emit length byte
001B4Br 2  A2 00                LDX     #0
001B4Dr 2               @loop:
001B4Dr 2  E4 rr                CPX     scratch
001B4Fr 2  B0 0B                BCS     @done
001B51r 2  BD rr rr             LDA     ident_buf+1,x
001B54r 2  DA                   PHX
001B55r 2  20 rr rr             JSR     emit_byte       ; clobbers tmp2 only
001B58r 2  FA                   PLX
001B59r 2  E8                   INX
001B5Ar 2  80 F1                BRA     @loop
001B5Cr 2               @done:
001B5Cr 2  60                   RTS
001B5Dr 2               
001B5Dr 2               ; --- Local variable emitters ---
001B5Dr 2               
001B5Dr 2               emit_LDL:                       ; byte offset in A
001B5Dr 2  48                   PHA
001B5Er 2  A9 10                LDA     #OP_LDL
001B60r 2  20 rr rr             JSR     emit_byte
001B63r 2  68                   PLA
001B64r 2  20 rr rr             JSR     emit_byte
001B67r 2  60                   RTS
001B68r 2               
001B68r 2               emit_STL:
001B68r 2  48                   PHA
001B69r 2  A9 11                LDA     #OP_STL
001B6Br 2  20 rr rr             JSR     emit_byte
