0015B6r 2  48                   PHA
0015B7r 2  A5 rr                LDA     cg_pc+1
0015B9r 2  48                   PHA
0015BAr 2  A9 00                LDA     #$00
0015BCr 2  20 rr rr             JSR     emit_byte
0015BFr 2  A9 00                LDA     #$00
0015C1r 2  20 rr rr             JSR     emit_byte
0015C4r 2  68                   PLA
0015C5r 2  85 rr                STA     scratch
0015C7r 2  68                   PLA
0015C8r 2  60                   RTS
