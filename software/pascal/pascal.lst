0015E3r 2               
0015E3r 2               ; ---------------------------------------------------------------------------
0015E3r 2               ; patch_jump — fill in jump offset at patch address stored in tmp2 (word)
0015E3r 2               ; The offset is computed as: (current cg_pc) - (patch_addr + 2)
0015E3r 2               ; i.e. relative to instruction after the operand word
0015E3r 2               ; ---------------------------------------------------------------------------
0015E3r 2               patch_jump:
0015E3r 2               ; delta = cg_pc - (patch_addr + 2)
0015E3r 2               ;   compute (cg_pc - 2) first, then subtract patch_addr
0015E3r 2  A5 rr                LDA     cg_pc
0015E5r 2  38                   SEC
0015E6r 2  E9 02                SBC     #2
0015E8r 2  85 rr                STA     scratch         ; lo of (cg_pc - 2)
0015EAr 2  A5 rr                LDA     cg_pc+1
0015ECr 2  E9 00                SBC     #0
0015EEr 2  85 rr                STA     scratch+1       ; hi of (cg_pc - 2)
0015F0r 2  38                   SEC
0015F1r 2  A5 rr                LDA     scratch
0015F3r 2  E5 rr                SBC     tmp2
0015F5r 2  48                   PHA
0015F6r 2  A5 rr                LDA     scratch+1
0015F8r 2  E5 rr                SBC     tmp2+1
0015FAr 2  85 rr                STA     scratch+1       ; high byte of delta
0015FCr 2  68                   PLA
0015FDr 2  85 rr                STA     scratch         ; low byte of delta
0015FFr 2               ; write delta at patch address (CODEBUF_BASE + tmp2)
0015FFr 2  A5 rr                LDA     tmp2
001601r 2  18                   CLC
001602r 2  69 00                ADC     #<CODEBUF_BASE
001604r 2  85 rr                STA     tmp3
001606r 2  A5 rr                LDA     tmp2+1
001608r 2  69 30                ADC     #>CODEBUF_BASE
00160Ar 2  85 rr                STA     tmp3+1
00160Cr 2  A0 00                LDY     #0
00160Er 2  A5 rr                LDA     scratch
001610r 2  91 rr                STA     (tmp3),y
001612r 2  C8                   INY
001613r 2  A5 rr                LDA     scratch+1
001615r 2  91 rr                STA     (tmp3),y
001617r 2  60                   RTS
001618r 2               
