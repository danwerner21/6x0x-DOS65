001608r 2  C9 57                CMP     #'W'
00160Ar 2  F0 03                BEQ     :+
00160Cr 2  4C rr rr             JMP     @lookup_sym
00160Fr 2               :
00160Fr 2  4C rr rr             JMP     parse_builtin_new
001612r 2               
001612r 2               @chk_len5:
001612r 2  AD rr rr             LDA     ident_buf+1
001615r 2  C9 57                CMP     #'W'
001617r 2  F0 5A                BEQ     @chk_write
001619r 2  C9 52                CMP     #'R'
