001AB3r 2  A9 82                LDA     #OP_WRITB
001AB5r 2  4C rr rr             JMP     emit_byte
001AB8r 2               
001AB8r 2               emit_WRITS:
001AB8r 2  A9 83                LDA     #OP_WRITS
001ABAr 2  4C rr rr             JMP     emit_byte
001ABDr 2               
001ABDr 2               emit_WRITLN:
001ABDr 2  A9 84                LDA     #OP_WRITLN
001ABFr 2  4C rr rr             JMP     emit_byte
001AC2r 2               
001AC2r 2               emit_READI:
001AC2r 2  A9 85                LDA     #OP_READI
001AC4r 2  4C rr rr             JMP     emit_byte
001AC7r 2               
001AC7r 2               emit_READC:
001AC7r 2  A9 86                LDA     #OP_READC
001AC9r 2  4C rr rr             JMP     emit_byte
001ACCr 2               
