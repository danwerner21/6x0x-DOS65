001751r 2               @do_varref_assign:
001751r 2               ; VAR-by-reference param assignment: `paramname := expr` where the
001751r 2               ; param's local slot holds an address.  Emit:
001751r 2               ;   LDL <off>          ; push address (the value passed by caller)
001751r 2               ;   <expr>             ; push value
001751r 2               ;   STIND              ; pop val, pop addr, store
001751r 2  20 rr rr             JSR     next_token      ; consume param name
001754r 2  A5 rr                LDA     tok_type
001756r 2  C9 1A                CMP     #TOK_ASSIGN
001758r 2  D0 03                BNE     :+
00175Ar 2  20 rr rr             JSR     next_token      ; consume ':='
00175Dr 2               :
00175Dr 2  AD rr rr             LDA     sym_save_off
