002089r 2               ; maybe_deref_loaded_ptr — a pointer value is already on the stack.
002089r 2               ; If the following token is '^', consume it and load the pointed-to word.
002089r 2               ; v1 pointer dereference still assumes pointer-to-INTEGER.
002089r 2               maybe_deref_loaded_ptr:
