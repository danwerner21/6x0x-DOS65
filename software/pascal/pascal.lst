001E1Dr 2  A9 34                LDA     #OP_MOD
001E1Fr 2  4C rr rr             JMP     emit_byte
001E22r 2               
001E22r 2               emit_NGI:
001E22r 2  A9 35                LDA     #OP_NGI
001E24r 2  4C rr rr             JMP     emit_byte
001E27r 2               
001E27r 2               ; --- Comparison emitters ---
001E27r 2               
001E27r 2               emit_EQUI:
001E27r 2  A9 40                LDA     #OP_EQUI
001E29r 2  4C rr rr             JMP     emit_byte
001E2Cr 2               
001E2Cr 2               emit_NEQI:
001E2Cr 2  A9 41                LDA     #OP_NEQI
001E2Er 2  4C rr rr             JMP     emit_byte
001E31r 2               
