00123Cr 2  A0 15                LDY     #21
00123Er 2  B1 rr                LDA     (tmp3),y
001240r 2  48                   PHA                     ; pcount (deepest)
001241r 2  A0 10                LDY     #16
001243r 2  B1 rr                LDA     (tmp3),y
001245r 2  48                   PHA                     ; kind
001246r 2  A0 11                LDY     #17
001248r 2  B1 rr                LDA     (tmp3),y
00124Ar 2  85 rr                STA     expr_type       ; data type code
00124Cr 2  A0 14                LDY     #20
00124Er 2  B1 rr                LDA     (tmp3),y
001250r 2  48                   PHA                     ; scope
001251r 2  A0 13                LDY     #19
001253r 2  B1 rr                LDA     (tmp3),y
001255r 2  48                   PHA                     ; off hi
001256r 2  A0 12                LDY     #18
001258r 2  B1 rr                LDA     (tmp3),y
