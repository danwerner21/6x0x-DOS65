001693r 2  D0 1F                BNE     @bi5_no
001695r 2  AD rr rr             LDA     ident_buf+2
001698r 2  C9 41                CMP     #'A'
00169Ar 2  D0 18                BNE     @bi5_no
00169Cr 2  AD rr rr             LDA     ident_buf+3
00169Fr 2  C9 4C                CMP     #'L'
0016A1r 2  D0 11                BNE     @bi5_no
0016A3r 2  AD rr rr             LDA     ident_buf+4
0016A6r 2  C9 53                CMP     #'S'
0016A8r 2  D0 0A                BNE     @bi5_no
0016AAr 2  AD rr rr             LDA     ident_buf+5
0016ADr 2  C9 45                CMP     #'E'
0016AFr 2  D0 03                BNE     @bi5_no
0016B1r 2  4C rr rr             JMP     parse_builtin_false
0016B4r 2               @bi5_no:
0016B4r 2  4C rr rr             JMP     @do_lookup
