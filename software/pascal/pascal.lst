001DE2r 2               
001DE2r 2               ; ---------------------------------------------------------------------------
001DE2r 2               ; codegen_alloc_global — reserve N bytes in global area; return offset in tmp2
001DE2r 2               ; N in A
001DE2r 2               ; ---------------------------------------------------------------------------
001DE2r 2               codegen_alloc_global:
001DE2r 2  A5 rr                LDA     cg_globals
001DE4r 2  85 rr                STA     tmp2
001DE6r 2  A5 rr                LDA     cg_globals+1
001DE8r 2  85 rr                STA     tmp2+1
001DEAr 2               ; advance by N (passed in A — caller puts size here)
001DEAr 2               ; For now allocate 2 bytes (word) per variable
001DEAr 2  A5 rr                LDA     cg_globals
001DECr 2  18                   CLC
001DEDr 2  69 02                ADC     #2
001DEFr 2  85 rr                STA     cg_globals
001DF1r 2  90 02                BCC     :+
001DF3r 2  E6 rr                INC     cg_globals+1
001DF5r 2               :
001DF5r 2  60                   RTS
001DF6r 2               
001DF6r 1                       .include        "IOLIB.ASM"
001DF6r 2               .pc02
001DF6r 2               ; iolib.asm — console and file I/O wrappers for DOS/65
001DF6r 2               ;
001DF6r 2               ; Uses PEM function 2 (CONOUT) for character output.
001DF6r 2               ; This routes through DFT_CONSOLE and works on all platforms
001DF6r 2               ; (serial, ESP video, memory-mapped video) regardless of which
001DF6r 2               ; console driver is active.
001DF6r 2               
001DF6r 2                       .segment        "CODE"
001DF6r 2               
001DF6r 2               ; ---------------------------------------------------------------------------
001DF6r 2               ; console_putc — output character in A to console via PEM #2
001DF6r 2               ; ---------------------------------------------------------------------------
001DF6r 2               console_putc:
001DF6r 2  48                   PHA
001DF7r 2  A2 02                LDX     #PEM_CONOUT
001DF9r 2  20 03 01             JSR     PEM_ENTRY
001DFCr 2  68                   PLA
001DFDr 2  60                   RTS
001DFEr 2               
001DFEr 2               ; ---------------------------------------------------------------------------
001DFEr 2               ; console_newline — emit CR+LF
001DFEr 2               ; ---------------------------------------------------------------------------
001DFEr 2               console_newline:
001DFEr 2  A9 0D                LDA     #$0D
001E00r 2  A2 02                LDX     #PEM_CONOUT
001E02r 2  20 03 01             JSR     PEM_ENTRY
001E05r 2  A9 0A                LDA     #$0A
001E07r 2  A2 02                LDX     #PEM_CONOUT
001E09r 2  20 03 01             JSR     PEM_ENTRY
001E0Cr 2  60                   RTS
001E0Dr 2               
001E0Dr 2               ; ---------------------------------------------------------------------------
001E0Dr 2               ; console_print_sz — print null-terminated string at tmp0
001E0Dr 2               ; ---------------------------------------------------------------------------
001E0Dr 2               console_print_sz:
001E0Dr 2  A0 00                LDY     #0
001E0Fr 2               @loop:
001E0Fr 2  B1 rr                LDA     (tmp0),y
001E11r 2  F0 08                BEQ     @done
001E13r 2  A2 02                LDX     #PEM_CONOUT
001E15r 2  20 03 01             JSR     PEM_ENTRY
001E18r 2  C8                   INY
001E19r 2  D0 F4                BNE     @loop
001E1Br 2               @done:
001E1Br 2  60                   RTS
001E1Cr 2               
001E1Cr 2               ; ---------------------------------------------------------------------------
001E1Cr 2               ; console_print_pstr — print length-prefixed Pascal string at tmp0
001E1Cr 2               ; ---------------------------------------------------------------------------
001E1Cr 2               console_print_pstr:
001E1Cr 2  A0 00                LDY     #0
001E1Er 2  B1 rr                LDA     (tmp0),y        ; length byte
001E20r 2  F0 10                BEQ     @done
001E22r 2  AA                   TAX                     ; X = remaining chars — but X used by PEM!
001E23r 2               ; save length, use tmp1 as counter
001E23r 2  85 rr                STA     tmp1
001E25r 2  C8                   INY
001E26r 2               @loop:
001E26r 2  B1 rr                LDA     (tmp0),y
001E28r 2  A2 02                LDX     #PEM_CONOUT
001E2Ar 2  20 03 01             JSR     PEM_ENTRY
001E2Dr 2  C8                   INY
001E2Er 2  C6 rr                DEC     tmp1
001E30r 2  D0 F4                BNE     @loop
001E32r 2               @done:
001E32r 2  60                   RTS
001E33r 2               
001E33r 2               ; ---------------------------------------------------------------------------
001E33r 2               ; console_print_dec — print signed 16-bit integer in tmp0:tmp0+1
001E33r 2               ; ---------------------------------------------------------------------------
001E33r 2               console_print_dec:
001E33r 2  A5 rr                LDA     tmp0+1
001E35r 2  10 14                BPL     @positive
001E37r 2  A9 2D                LDA     #'-'
001E39r 2  A2 02                LDX     #PEM_CONOUT
001E3Br 2  20 03 01             JSR     PEM_ENTRY
001E3Er 2  A9 00                LDA     #0
001E40r 2  38                   SEC
001E41r 2  E5 rr                SBC     tmp0
001E43r 2  85 rr                STA     tmp0
001E45r 2  A9 00                LDA     #0
001E47r 2  E5 rr                SBC     tmp0+1
001E49r 2  85 rr                STA     tmp0+1
001E4Br 2               @positive:
001E4Br 2  A9 00                LDA     #0
001E4Dr 2  48                   PHA                     ; sentinel
001E4Er 2               @div_loop:
001E4Er 2  20 rr rr             JSR     div16_by10      ; quotient→tmp0, remainder→scratch
001E51r 2  A5 rr                LDA     scratch
001E53r 2  18                   CLC
001E54r 2  69 30                ADC     #'0'
001E56r 2  48                   PHA
001E57r 2  A5 rr                LDA     tmp0
001E59r 2  05 rr                ORA     tmp0+1
001E5Br 2  D0 F1                BNE     @div_loop
001E5Dr 2               @print_loop:
001E5Dr 2  68                   PLA
001E5Er 2  F0 07                BEQ     @done2          ; sentinel
001E60r 2  A2 02                LDX     #PEM_CONOUT
001E62r 2  20 03 01             JSR     PEM_ENTRY
001E65r 2  80 F6                BRA     @print_loop
001E67r 2               @done2:
001E67r 2  60                   RTS
001E68r 2               
001E68r 2               ; ---------------------------------------------------------------------------
001E68r 2               ; div16_by10 — divide tmp0:tmp0+1 by 10
001E68r 2               ; Result: quotient in tmp0:tmp0+1, remainder in scratch
001E68r 2               ; ---------------------------------------------------------------------------
001E68r 2               div16_by10:
001E68r 2  A9 00                LDA     #0
001E6Ar 2  85 rr                STA     scratch
001E6Cr 2  A2 10                LDX     #16
001E6Er 2               @bit:
001E6Er 2  06 rr                ASL     tmp0
001E70r 2  26 rr                ROL     tmp0+1
001E72r 2  26 rr                ROL     scratch
001E74r 2  A5 rr                LDA     scratch
001E76r 2  C9 0A                CMP     #10
001E78r 2  90 06                BCC     @no_sub
001E7Ar 2  E9 0A                SBC     #10
001E7Cr 2  85 rr                STA     scratch
001E7Er 2  E6 rr                INC     tmp0
001E80r 2               @no_sub:
001E80r 2  CA                   DEX
001E81r 2  D0 EB                BNE     @bit
001E83r 2  60                   RTS
001E84r 2               
001E84r 2               ; ---------------------------------------------------------------------------
001E84r 2               ; console_read_line — read a line into buffer at tmp0, max len in x_save
001E84r 2               ; Returns: Y = length (not including CR)
001E84r 2               ; ---------------------------------------------------------------------------
001E84r 2               console_read_line:
001E84r 2  8E rr rr             STX     x_save
001E87r 2  A0 00                LDY     #0
001E89r 2               @loop:
001E89r 2  A2 01                LDX     #PEM_CONIN
001E8Br 2  20 03 01             JSR     PEM_ENTRY
001E8Er 2  C9 0D                CMP     #$0D
001E90r 2  F0 28                BEQ     @done
001E92r 2  C9 08                CMP     #$08            ; backspace
001E94r 2  D0 1C                BNE     @store
001E96r 2  C0 00                CPY     #0
001E98r 2  F0 EF                BEQ     @loop
001E9Ar 2  88                   DEY
001E9Br 2  A9 08                LDA     #$08
001E9Dr 2  A2 02                LDX     #PEM_CONOUT
001E9Fr 2  20 03 01             JSR     PEM_ENTRY
001EA2r 2  A9 20                LDA     #' '
001EA4r 2  A2 02                LDX     #PEM_CONOUT
001EA6r 2  20 03 01             JSR     PEM_ENTRY
001EA9r 2  A9 08                LDA     #$08
001EABr 2  A2 02                LDX     #PEM_CONOUT
001EADr 2  20 03 01             JSR     PEM_ENTRY
001EB0r 2  80 D7                BRA     @loop
001EB2r 2               @store:
001EB2r 2  91 rr                STA     (tmp0),y
001EB4r 2  C8                   INY
001EB5r 2  CC rr rr             CPY     x_save
001EB8r 2  90 CF                BCC     @loop
001EBAr 2               @done:
001EBAr 2  60                   RTS
001EBBr 2               x_save:
001EBBr 2  00                   .BYTE   0
001EBCr 2               
001EBCr 2               ; ---------------------------------------------------------------------------
001EBCr 2               ; file_open — open file via FCB at tmp1; returns A=0 success, $FF=not found
001EBCr 2               ; PEM calling convention: X=function, A=FCB addr lo, Y=FCB addr hi
001EBCr 2               ; ---------------------------------------------------------------------------
001EBCr 2               file_open:
001EBCr 2  A5 rr                LDA     tmp1
001EBEr 2  A4 rr                LDY     tmp1+1
001EC0r 2  A2 0F                LDX     #PEM_OPEN
001EC2r 2  20 03 01             JSR     PEM_ENTRY
001EC5r 2  60                   RTS
001EC6r 2               
001EC6r 2               ; ---------------------------------------------------------------------------
001EC6r 2               ; file_make — create/truncate file via FCB at tmp1
001EC6r 2               ; ---------------------------------------------------------------------------
001EC6r 2               file_make:
001EC6r 2  A5 rr                LDA     tmp1
001EC8r 2  A4 rr                LDY     tmp1+1
001ECAr 2  A2 16                LDX     #PEM_MAKE
001ECCr 2  20 03 01             JSR     PEM_ENTRY
001ECFr 2  60                   RTS
001ED0r 2               
001ED0r 2               ; ---------------------------------------------------------------------------
001ED0r 2               ; file_read_sector — read 128 bytes into DMA_BUF; returns A=0 ok, A=1 EOF
001ED0r 2               ; ---------------------------------------------------------------------------
001ED0r 2               file_read_sector:
001ED0r 2  A5 rr                LDA     tmp1
001ED2r 2  A4 rr                LDY     tmp1+1
001ED4r 2  A2 14                LDX     #PEM_READ
001ED6r 2  20 03 01             JSR     PEM_ENTRY
001ED9r 2  60                   RTS
001EDAr 2               
001EDAr 2               ; ---------------------------------------------------------------------------
001EDAr 2               ; file_write_sector — write 128 bytes from DMA_BUF
001EDAr 2               ; ---------------------------------------------------------------------------
001EDAr 2               file_write_sector:
001EDAr 2  A5 rr                LDA     tmp1
001EDCr 2  A4 rr                LDY     tmp1+1
001EDEr 2  A2 15                LDX     #PEM_WRITE
001EE0r 2  20 03 01             JSR     PEM_ENTRY
001EE3r 2  60                   RTS
001EE4r 2               
001EE4r 2               ; ---------------------------------------------------------------------------
001EE4r 2               ; file_close — close FCB at tmp1
001EE4r 2               ; ---------------------------------------------------------------------------
001EE4r 2               file_close:
001EE4r 2  A5 rr                LDA     tmp1
001EE6r 2  A4 rr                LDY     tmp1+1
001EE8r 2  A2 10                LDX     #PEM_CLOSE
001EEAr 2  20 03 01             JSR     PEM_ENTRY
001EEDr 2  60                   RTS
001EEEr 2               
001EEEr 2               ; ---------------------------------------------------------------------------
001EEEr 2               ; file_setdma — point PEM at the 128-byte buffer at (A:Y)
001EEEr 2               ; A = lo, Y = hi.  Trashes X.
001EEEr 2               ; ---------------------------------------------------------------------------
001EEEr 2               file_setdma:
001EEEr 2  A2 1A                LDX     #PEM_SETDMA
001EF0r 2  4C 03 01             JMP     PEM_ENTRY
001EF3r 2               
001EF3r 2               ; ---------------------------------------------------------------------------
001EF3r 2               ; file_setdma_default — restore PEM DMA pointer to system DMA_BUF
001EF3r 2               ; ---------------------------------------------------------------------------
001EF3r 2               file_setdma_default:
001EF3r 2  A9 28                LDA     #<DMA_BUF
001EF5r 2  A0 01                LDY     #>DMA_BUF
001EF7r 2  A2 1A                LDX     #PEM_SETDMA
001EF9r 2  4C 03 01             JMP     PEM_ENTRY
001EFCr 2               
