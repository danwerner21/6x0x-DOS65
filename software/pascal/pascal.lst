0012DDr 2  B0 0C                BCS     @fc_done_args
0012DFr 2  A5 rr                LDA     tok_type
0012E1r 2  C9 1F                CMP     #TOK_COMMA
0012E3r 2  D0 06                BNE     @fc_done_args
