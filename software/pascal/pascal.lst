001B2Fr 2  4C rr rr             JMP     emit_byte
001B32r 2               
001B32r 2               ; ---------------------------------------------------------------------------
001B32r 2               ; codegen_alloc_global — reserve N bytes in global area; return offset in tmp2
001B32r 2               ; N in A
001B32r 2               ; ---------------------------------------------------------------------------
001B32r 2               codegen_alloc_global:
001B32r 2  A5 rr                LDA     cg_globals
001B34r 2  85 rr                STA     tmp2
001B36r 2  A5 rr                LDA     cg_globals+1
001B38r 2  85 rr                STA     tmp2+1
001B3Ar 2               ; advance by N (passed in A — caller puts size here)
001B3Ar 2               ; For now allocate 2 bytes (word) per variable
001B3Ar 2  A5 rr                LDA     cg_globals
001B3Cr 2  18                   CLC
001B3Dr 2  69 02                ADC     #2
001B3Fr 2  85 rr                STA     cg_globals
001B41r 2  90 02                BCC     :+
001B43r 2  E6 rr                INC     cg_globals+1
001B45r 2               :
001B45r 2  60                   RTS
001B46r 2               
001B46r 1                       .include        "IOLIB.ASM"
001B46r 2               .pc02
001B46r 2               ; iolib.asm — console and file I/O wrappers for DOS/65
001B46r 2               ;
001B46r 2               ; Uses PEM function 2 (CONOUT) for character output.
001B46r 2               ; This routes through DFT_CONSOLE and works on all platforms
001B46r 2               ; (serial, ESP video, memory-mapped video) regardless of which
001B46r 2               ; console driver is active.
001B46r 2               
001B46r 2                       .segment        "CODE"
001B46r 2               
001B46r 2               ; ---------------------------------------------------------------------------
001B46r 2               ; console_putc — output character in A to console via PEM #2
001B46r 2               ; ---------------------------------------------------------------------------
001B46r 2               console_putc:
001B46r 2  48                   PHA
001B47r 2  A2 02                LDX     #PEM_CONOUT
001B49r 2  20 03 01             JSR     PEM_ENTRY
001B4Cr 2  68                   PLA
001B4Dr 2  60                   RTS
001B4Er 2               
001B4Er 2               ; ---------------------------------------------------------------------------
001B4Er 2               ; console_newline — emit CR+LF
001B4Er 2               ; ---------------------------------------------------------------------------
001B4Er 2               console_newline:
001B4Er 2  A9 0D                LDA     #$0D
001B50r 2  A2 02                LDX     #PEM_CONOUT
001B52r 2  20 03 01             JSR     PEM_ENTRY
001B55r 2  A9 0A                LDA     #$0A
001B57r 2  A2 02                LDX     #PEM_CONOUT
001B59r 2  20 03 01             JSR     PEM_ENTRY
001B5Cr 2  60                   RTS
001B5Dr 2               
001B5Dr 2               ; ---------------------------------------------------------------------------
001B5Dr 2               ; console_print_sz — print null-terminated string at tmp0
001B5Dr 2               ; ---------------------------------------------------------------------------
001B5Dr 2               console_print_sz:
001B5Dr 2  A0 00                LDY     #0
001B5Fr 2               @loop:
001B5Fr 2  B1 rr                LDA     (tmp0),y
001B61r 2  F0 08                BEQ     @done
001B63r 2  A2 02                LDX     #PEM_CONOUT
001B65r 2  20 03 01             JSR     PEM_ENTRY
001B68r 2  C8                   INY
001B69r 2  D0 F4                BNE     @loop
001B6Br 2               @done:
001B6Br 2  60                   RTS
001B6Cr 2               
001B6Cr 2               ; ---------------------------------------------------------------------------
001B6Cr 2               ; console_print_pstr — print length-prefixed Pascal string at tmp0
001B6Cr 2               ; ---------------------------------------------------------------------------
001B6Cr 2               console_print_pstr:
001B6Cr 2  A0 00                LDY     #0
001B6Er 2  B1 rr                LDA     (tmp0),y        ; length byte
001B70r 2  F0 10                BEQ     @done
001B72r 2  AA                   TAX                     ; X = remaining chars — but X used by PEM!
001B73r 2               ; save length, use tmp1 as counter
001B73r 2  85 rr                STA     tmp1
001B75r 2  C8                   INY
001B76r 2               @loop:
001B76r 2  B1 rr                LDA     (tmp0),y
001B78r 2  A2 02                LDX     #PEM_CONOUT
001B7Ar 2  20 03 01             JSR     PEM_ENTRY
001B7Dr 2  C8                   INY
001B7Er 2  C6 rr                DEC     tmp1
001B80r 2  D0 F4                BNE     @loop
001B82r 2               @done:
001B82r 2  60                   RTS
001B83r 2               
001B83r 2               ; ---------------------------------------------------------------------------
001B83r 2               ; console_print_dec — print signed 16-bit integer in tmp0:tmp0+1
001B83r 2               ; ---------------------------------------------------------------------------
001B83r 2               console_print_dec:
001B83r 2  A5 rr                LDA     tmp0+1
001B85r 2  10 14                BPL     @positive
001B87r 2  A9 2D                LDA     #'-'
001B89r 2  A2 02                LDX     #PEM_CONOUT
001B8Br 2  20 03 01             JSR     PEM_ENTRY
001B8Er 2  A9 00                LDA     #0
001B90r 2  38                   SEC
001B91r 2  E5 rr                SBC     tmp0
001B93r 2  85 rr                STA     tmp0
001B95r 2  A9 00                LDA     #0
001B97r 2  E5 rr                SBC     tmp0+1
001B99r 2  85 rr                STA     tmp0+1
001B9Br 2               @positive:
001B9Br 2  A9 00                LDA     #0
001B9Dr 2  48                   PHA                     ; sentinel
001B9Er 2               @div_loop:
001B9Er 2  20 rr rr             JSR     div16_by10      ; quotient→tmp0, remainder→scratch
001BA1r 2  A5 rr                LDA     scratch
001BA3r 2  18                   CLC
001BA4r 2  69 30                ADC     #'0'
001BA6r 2  48                   PHA
001BA7r 2  A5 rr                LDA     tmp0
001BA9r 2  05 rr                ORA     tmp0+1
001BABr 2  D0 F1                BNE     @div_loop
001BADr 2               @print_loop:
001BADr 2  68                   PLA
001BAEr 2  F0 07                BEQ     @done2          ; sentinel
001BB0r 2  A2 02                LDX     #PEM_CONOUT
001BB2r 2  20 03 01             JSR     PEM_ENTRY
001BB5r 2  80 F6                BRA     @print_loop
001BB7r 2               @done2:
001BB7r 2  60                   RTS
001BB8r 2               
001BB8r 2               ; ---------------------------------------------------------------------------
001BB8r 2               ; div16_by10 — divide tmp0:tmp0+1 by 10
001BB8r 2               ; Result: quotient in tmp0:tmp0+1, remainder in scratch
001BB8r 2               ; ---------------------------------------------------------------------------
001BB8r 2               div16_by10:
001BB8r 2  A9 00                LDA     #0
001BBAr 2  85 rr                STA     scratch
001BBCr 2  A2 10                LDX     #16
001BBEr 2               @bit:
001BBEr 2  06 rr                ASL     tmp0
001BC0r 2  26 rr                ROL     tmp0+1
001BC2r 2  26 rr                ROL     scratch
001BC4r 2  A5 rr                LDA     scratch
001BC6r 2  C9 0A                CMP     #10
001BC8r 2  90 06                BCC     @no_sub
001BCAr 2  E9 0A                SBC     #10
001BCCr 2  85 rr                STA     scratch
001BCEr 2  E6 rr                INC     tmp0
001BD0r 2               @no_sub:
001BD0r 2  CA                   DEX
001BD1r 2  D0 EB                BNE     @bit
001BD3r 2  60                   RTS
001BD4r 2               
001BD4r 2               ; ---------------------------------------------------------------------------
001BD4r 2               ; console_read_line — read a line into buffer at tmp0, max len in x_save
001BD4r 2               ; Returns: Y = length (not including CR)
001BD4r 2               ; ---------------------------------------------------------------------------
001BD4r 2               console_read_line:
001BD4r 2  8E rr rr             STX     x_save
001BD7r 2  A0 00                LDY     #0
001BD9r 2               @loop:
001BD9r 2  A2 01                LDX     #PEM_CONIN
001BDBr 2  20 03 01             JSR     PEM_ENTRY
001BDEr 2  C9 0D                CMP     #$0D
001BE0r 2  F0 28                BEQ     @done
001BE2r 2  C9 08                CMP     #$08            ; backspace
001BE4r 2  D0 1C                BNE     @store
001BE6r 2  C0 00                CPY     #0
001BE8r 2  F0 EF                BEQ     @loop
001BEAr 2  88                   DEY
001BEBr 2  A9 08                LDA     #$08
001BEDr 2  A2 02                LDX     #PEM_CONOUT
001BEFr 2  20 03 01             JSR     PEM_ENTRY
001BF2r 2  A9 20                LDA     #' '
001BF4r 2  A2 02                LDX     #PEM_CONOUT
001BF6r 2  20 03 01             JSR     PEM_ENTRY
001BF9r 2  A9 08                LDA     #$08
001BFBr 2  A2 02                LDX     #PEM_CONOUT
001BFDr 2  20 03 01             JSR     PEM_ENTRY
001C00r 2  80 D7                BRA     @loop
001C02r 2               @store:
001C02r 2  91 rr                STA     (tmp0),y
001C04r 2  C8                   INY
001C05r 2  CC rr rr             CPY     x_save
001C08r 2  90 CF                BCC     @loop
001C0Ar 2               @done:
001C0Ar 2  60                   RTS
001C0Br 2               x_save:
001C0Br 2  00                   .BYTE   0
001C0Cr 2               
001C0Cr 2               ; ---------------------------------------------------------------------------
001C0Cr 2               ; file_open — open file via FCB at tmp1; returns A=0 success, $FF=not found
001C0Cr 2               ; PEM calling convention: X=function, A=FCB addr lo, Y=FCB addr hi
001C0Cr 2               ; ---------------------------------------------------------------------------
001C0Cr 2               file_open:
001C0Cr 2  A5 rr                LDA     tmp1
001C0Er 2  A4 rr                LDY     tmp1+1
001C10r 2  A2 0F                LDX     #PEM_OPEN
001C12r 2  20 03 01             JSR     PEM_ENTRY
001C15r 2  60                   RTS
001C16r 2               
001C16r 2               ; ---------------------------------------------------------------------------
001C16r 2               ; file_make — create/truncate file via FCB at tmp1
001C16r 2               ; ---------------------------------------------------------------------------
001C16r 2               file_make:
001C16r 2  A5 rr                LDA     tmp1
001C18r 2  A4 rr                LDY     tmp1+1
001C1Ar 2  A2 16                LDX     #PEM_MAKE
001C1Cr 2  20 03 01             JSR     PEM_ENTRY
001C1Fr 2  60                   RTS
001C20r 2               
001C20r 2               ; ---------------------------------------------------------------------------
001C20r 2               ; file_read_sector — read 128 bytes into DMA_BUF; returns A=0 ok, A=1 EOF
001C20r 2               ; ---------------------------------------------------------------------------
001C20r 2               file_read_sector:
001C20r 2  A5 rr                LDA     tmp1
001C22r 2  A4 rr                LDY     tmp1+1
001C24r 2  A2 14                LDX     #PEM_READ
001C26r 2  20 03 01             JSR     PEM_ENTRY
001C29r 2  60                   RTS
001C2Ar 2               
001C2Ar 2               ; ---------------------------------------------------------------------------
001C2Ar 2               ; file_write_sector — write 128 bytes from DMA_BUF
001C2Ar 2               ; ---------------------------------------------------------------------------
001C2Ar 2               file_write_sector:
001C2Ar 2  A5 rr                LDA     tmp1
001C2Cr 2  A4 rr                LDY     tmp1+1
001C2Er 2  A2 15                LDX     #PEM_WRITE
001C30r 2  20 03 01             JSR     PEM_ENTRY
001C33r 2  60                   RTS
001C34r 2               
001C34r 2               ; ---------------------------------------------------------------------------
001C34r 2               ; file_close — close FCB at tmp1
001C34r 2               ; ---------------------------------------------------------------------------
001C34r 2               file_close:
001C34r 2  A5 rr                LDA     tmp1
001C36r 2  A4 rr                LDY     tmp1+1
001C38r 2  A2 10                LDX     #PEM_CLOSE
001C3Ar 2  20 03 01             JSR     PEM_ENTRY
001C3Dr 2  60                   RTS
