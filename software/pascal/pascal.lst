00220Br 2  F0 13                BEQ     @arr_rhs_local
00220Dr 2  C9 06                CMP     #TY_RECORD
00220Fr 2  F0 39                BEQ     @rec_rhs_local
002211r 2  C9 08                CMP     #TY_TEXT
002213r 2  F0 07                BEQ     @text_rhs_local
002215r 2  8A                   TXA
