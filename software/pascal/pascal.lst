0019BBr 2               ; ---------------------------------------------------------------------------
0019BBr 2               ; symtab_find — look up ident_buf in symbol table
0019BBr 2               ; Returns: carry set = found (tmp3 = pointer to entry)
0019BBr 2               ;          carry clear = not found
0019BBr 2               ; Searches from newest (highest index) to oldest for proper scoping
0019BBr 2               ; ---------------------------------------------------------------------------
0019BBr 2               symtab_find:
0019BBr 2  AD rr rr             LDA     symtab_count
0019BEr 2  0D rr rr             ORA     symtab_count+1
0019C1r 2  D0 02                BNE     :+
0019C3r 2  18                   CLC
0019C4r 2  60                   RTS                     ; empty table
0019C5r 2               :
0019C5r 2               ; start from last entry
0019C5r 2  AD rr rr             LDA     symtab_count
0019C8r 2  85 rr                STA     tmp2
0019CAr 2  AD rr rr             LDA     symtab_count+1
0019CDr 2  85 rr                STA     tmp2+1
0019CFr 2               @loop:
0019CFr 2  A5 rr                LDA     tmp2
0019D1r 2  05 rr                ORA     tmp2+1
0019D3r 2  F0 34                BEQ     @not_found
0019D5r 2               ; decrement tmp2
0019D5r 2  A5 rr                LDA     tmp2
0019D7r 2  D0 02                BNE     :+
0019D9r 2  C6 rr                DEC     tmp2+1
0019DBr 2               :
0019DBr 2  C6 rr                DEC     tmp2
0019DDr 2               ; compute entry address: SYMTAB_BASE + tmp2 * SYM_ENTRY_SZ
0019DDr 2               ; tmp2 * 32 = tmp2 << 5
0019DDr 2  A5 rr                LDA     tmp2
0019DFr 2  0A                   ASL
0019E0r 2  0A                   ASL
0019E1r 2  0A                   ASL
0019E2r 2  0A                   ASL
0019E3r 2  0A                   ASL                     ; *32
0019E4r 2  18                   CLC
0019E5r 2  69 00                ADC     #<SYMTAB_BASE
0019E7r 2  85 rr                STA     tmp3
0019E9r 2  A5 rr                LDA     tmp2+1
0019EBr 2  2A                   ROL
0019ECr 2  69 80                ADC     #>SYMTAB_BASE
0019EEr 2  85 rr                STA     tmp3+1
