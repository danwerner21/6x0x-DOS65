0023DFr 2               ; ---------------------------------------------------------------------------
0023DFr 2               ; String built-in helpers — entered from parse_factor's @ident_or_call.
0023DFr 2               ; The identifier is still the current token on entry.
0023DFr 2               ; ---------------------------------------------------------------------------
0023DFr 2               
0023DFr 2               ; Skip current token if it matches A; otherwise just fall through.
0023DFr 2               ; Used to consume optional punctuation like '(' / ')' / ',' without aborting
0023DFr 2               ; on a missing token (compile_error elsewhere will catch malformed code).
0023DFr 2               parse_eat_token:
0023DFr 2  C5 rr                CMP     tok_type
0023E1r 2  D0 03                BNE     :+
0023E3r 2  4C rr rr             JMP     next_token
0023E6r 2  60           :       RTS
0023E7r 2               
0023E7r 2               parse_builtin_length:
0023E7r 2  20 rr rr             JSR     next_token              ; consume LENGTH
0023EAr 2  A9 1B                LDA     #TOK_LPAREN
0023ECr 2  20 rr rr             JSR     parse_eat_token
