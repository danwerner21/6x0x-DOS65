0012E8r 2  4C rr rr             JMP     @fc_arg_loop    ; jmp — body grew past bra range
0012EBr 2               @fc_done_args:
0012EBr 2  A5 rr                LDA     tok_type
0012EDr 2  C9 1C                CMP     #TOK_RPAREN
0012EFr 2  D0 17                BNE     @fc_emit_call
0012F1r 2  20 rr rr             JSR     next_token      ; consume ')'
0012F4r 2  80 12                BRA     @fc_emit_call
0012F6r 2               @fc_no_args:
