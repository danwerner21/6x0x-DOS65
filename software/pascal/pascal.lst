002228r 2  D0 03                BNE     :+
00222Ar 2  20 rr rr             JSR     next_token
00222Dr 2  20 rr rr     :       JSR     parse_expression    ; clobbers expr_type, scratch, tmp*
002230r 2  A5 rr                LDA     tok_type
002232r 2  C9 1E                CMP     #TOK_RBRACK
002234r 2  D0 03                BNE     :+
002236r 2  20 rr rr             JSR     next_token
002239r 2  A9 00        :       LDA     #0
00223Br 2  85 rr                STA     scratch
00223Dr 2  A9 02                LDA     #2
00223Fr 2  20 rr rr             JSR     emit_INDEX
002242r 2  20 rr rr             JSR     emit_LDIND
002245r 2  A9 01                LDA     #TY_INT
002247r 2  85 rr                STA     expr_type
002249r 2  60                   RTS
00224Ar 2               @rec_rhs_local:
00224Ar 2  8A                   TXA
