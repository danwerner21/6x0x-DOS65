00125Er 2  68                   PLA                     ; off lo
00125Fr 2  AA                   TAX                     ; X = off lo
001260r 2  68                   PLA                     ; off hi
001261r 2  85 rr                STA     scratch         ; scratch = off hi
001263r 2  68                   PLA                     ; scope
001264r 2  A8                   TAY                     ; Y = scope (preserved across kind test)
001265r 2  68                   PLA                     ; kind
001266r 2  C9 04                CMP     #SYM_FUNC
