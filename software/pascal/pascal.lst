002432r 2  A9 1F                LDA     #TOK_COMMA
002434r 2  20 rr rr             JSR     parse_eat_token
002437r 2  20 rr rr             JSR     parse_expression        ; count
00243Ar 2  A9 1C                LDA     #TOK_RPAREN
