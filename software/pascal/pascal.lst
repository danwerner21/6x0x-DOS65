001ACCr 2               
001ACCr 2               emit_DUP:
001ACCr 2  A9 90                LDA     #OP_DUP
001ACEr 2  4C rr rr             JMP     emit_byte
001AD1r 2               
001AD1r 2               emit_POP:
001AD1r 2  A9 91                LDA     #OP_POP
001AD3r 2  4C rr rr             JMP     emit_byte
001AD6r 2               
001AD6r 2               ; --- Calls ---
001AD6r 2               
001AD6r 2               emit_MRKSTK:                    ; local size in A
001AD6r 2  48                   PHA
001AD7r 2  A9 64                LDA     #OP_MRKSTK
001AD9r 2  20 rr rr             JSR     emit_byte
001ADCr 2  68                   PLA
001ADDr 2  4C rr rr             JMP     emit_byte
001AE0r 2               
001AE0r 2               emit_RET:
001AE0r 2  A9 62                LDA     #OP_RET
001AE2r 2  4C rr rr             JMP     emit_byte
001AE5r 2               
001AE5r 2               emit_RETF:
001AE5r 2  A9 63                LDA     #OP_RETF
001AE7r 2  4C rr rr             JMP     emit_byte
001AEAr 2               
001AEAr 2               emit_STR:
001AEAr 2  A9 66                LDA     #OP_STR
001AECr 2  4C rr rr             JMP     emit_byte
001AEFr 2               
001AEFr 2               ; emit_CALL — A = target absolute code-buffer addr lo, scratch = hi
001AEFr 2               ; Emits OP_CALL + signed 16-bit offset = target - (cg_pc_after_operand)
001AEFr 2               emit_CALL:
001AEFr 2  48                   PHA                     ; target lo
001AF0r 2  A5 rr                LDA     scratch
001AF2r 2  48                   PHA                     ; target hi
001AF3r 2  A9 60                LDA     #OP_CALL
001AF5r 2  20 rr rr             JSR     emit_byte       ; clobbers tmp2; preserves scratch & 6502 stack
001AF8r 2               ; compute offset = target - cg_pc - 2 (16-bit)
001AF8r 2  68                   PLA                     ; target hi
001AF9r 2  AA                   TAX
001AFAr 2  68                   PLA                     ; target lo
001AFBr 2  38                   SEC
001AFCr 2  E9 02                SBC     #2
001AFEr 2  48                   PHA                     ; partial lo
001AFFr 2  8A                   TXA                     ; target hi
001B00r 2  E9 00                SBC     #0
001B02r 2  85 rr                STA     scratch         ; partial hi
001B04r 2  68                   PLA                     ; partial lo
001B05r 2  38                   SEC
001B06r 2  E5 rr                SBC     cg_pc
001B08r 2  48                   PHA                     ; offset lo
001B09r 2  A5 rr                LDA     scratch
001B0Br 2  E5 rr                SBC     cg_pc+1
001B0Dr 2  85 rr                STA     scratch         ; offset hi
001B0Fr 2  68                   PLA
001B10r 2  20 rr rr             JSR     emit_byte       ; emit offset lo
001B13r 2  A5 rr                LDA     scratch
001B15r 2  20 rr rr             JSR     emit_byte       ; emit offset hi
001B18r 2  60                   RTS
001B19r 2               
001B19r 2               emit_HALT:
001B19r 2  A9 FF                LDA     #OP_HALT
001B1Br 2  4C rr rr             JMP     emit_byte
001B1Er 2               
001B1Er 2               ; --- String built-ins ---
001B1Er 2               
001B1Er 2               emit_LEN:
001B1Er 2  A9 A0                LDA     #OP_LEN
001B20r 2  4C rr rr             JMP     emit_byte
001B23r 2               
001B23r 2               emit_POS:
001B23r 2  A9 A1                LDA     #OP_POS
001B25r 2  4C rr rr             JMP     emit_byte
001B28r 2               
001B28r 2               emit_COPY:
001B28r 2  A9 A2                LDA     #OP_COPY
001B2Ar 2  4C rr rr             JMP     emit_byte
001B2Dr 2               
001B2Dr 2               emit_CONCAT:
