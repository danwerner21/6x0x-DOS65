001E20r 2  20 rr rr             JSR     emit_MOD
001E23r 2  A9 01                LDA     #TY_INT
001E25r 2  85 rr                STA     expr_type
001E27r 2  80 AB                BRA     @mulop
001E29r 2               @and:
001E29r 2  20 rr rr             JSR     next_token
