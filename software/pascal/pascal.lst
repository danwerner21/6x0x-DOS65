0023F2r 2  A9 1C                LDA     #TOK_RPAREN
0023F4r 2  20 rr rr             JSR     parse_eat_token
0023F7r 2  20 rr rr             JSR     emit_LEN
0023FAr 2  A9 01                LDA     #TY_INT
0023FCr 2  85 rr                STA     expr_type
0023FEr 2  60                   RTS
0023FFr 2               
