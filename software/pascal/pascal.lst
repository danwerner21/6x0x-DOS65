001365r 2               
001365r 2               TOK_DIV_KW      = TOK_DIV       ; alias
001365r 2               
001365r 2               ; ---------------------------------------------------------------------------
001365r 2               ; parse_factor — literal | variable | ( expr ) | NOT factor
001365r 2               ; ---------------------------------------------------------------------------
001365r 2               parse_factor:
001365r 2  A5 rr                LDA     tok_type
001367r 2  C9 02                CMP     #TOK_INT
001369r 2  D0 03                BNE     :+
00136Br 2  4C rr rr             JMP     @int_lit
00136Er 2               :
00136Er 2  C9 04                CMP     #TOK_CHAR
001370r 2  D0 03                BNE     :+
001372r 2  4C rr rr             JMP     @char_lit
001375r 2               :
001375r 2  C9 03                CMP     #TOK_STRING
001377r 2  D0 03                BNE     :+
001379r 2  4C rr rr             JMP     @str_lit
00137Cr 2               :
00137Cr 2  C9 01                CMP     #TOK_IDENT
00137Er 2  D0 03                BNE     :+
001380r 2  4C rr rr             JMP     @ident_or_call
001383r 2               :
001383r 2  C9 1B                CMP     #TOK_LPAREN
001385r 2  D0 03                BNE     :+
001387r 2  4C rr rr             JMP     @paren
