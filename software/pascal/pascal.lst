0014D0r 2               
0014D0r 2               ; emit_LDCS — emit OP_LDCS followed by length byte and string bytes.
0014D0r 2               ; Source string lives in ident_buf (length at [0], chars at [1..N]).
0014D0r 2               ; The runtime will inline-fetch length+chars and push the address of
0014D0r 2               ; the length byte as a Pascal-style string pointer.
0014D0r 2               emit_LDCS:
0014D0r 2  A9 04                LDA     #OP_LDCS
0014D2r 2  20 rr rr             JSR     emit_byte
0014D5r 2  AD rr rr             LDA     ident_buf       ; length
0014D8r 2  85 rr                STA     scratch         ; counter / length cache
0014DAr 2  20 rr rr             JSR     emit_byte       ; emit length byte
0014DDr 2  A2 00                LDX     #0
0014DFr 2               @loop:
0014DFr 2  E4 rr                CPX     scratch
0014E1r 2  B0 0B                BCS     @done
0014E3r 2  BD rr rr             LDA     ident_buf+1,x
0014E6r 2  DA                   PHX
0014E7r 2  20 rr rr             JSR     emit_byte       ; clobbers tmp2 only
0014EAr 2  FA                   PLX
0014EBr 2  E8                   INX
0014ECr 2  80 F1                BRA     @loop
0014EEr 2               @done:
0014EEr 2  60                   RTS
0014EFr 2               
