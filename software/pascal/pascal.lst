001C68r 2  A9 42                LDA     #OP_LESI
001C6Ar 2  4C rr rr             JMP     emit_byte
001C6Dr 2               
001C6Dr 2               emit_LEQI:
001C6Dr 2  A9 43                LDA     #OP_LEQI
001C6Fr 2  4C rr rr             JMP     emit_byte
001C72r 2               
001C72r 2               emit_GTRI:
001C72r 2  A9 44                LDA     #OP_GTRI
001C74r 2  4C rr rr             JMP     emit_byte
001C77r 2               
001C77r 2               emit_GEQI:
001C77r 2  A9 45                LDA     #OP_GEQI
001C79r 2  4C rr rr             JMP     emit_byte
001C7Cr 2               
001C7Cr 2               ; --- Logical ---
001C7Cr 2               
001C7Cr 2               emit_LAND:
001C7Cr 2  A9 38                LDA     #OP_LAND
001C7Er 2  4C rr rr             JMP     emit_byte
001C81r 2               
001C81r 2               emit_LOR:
001C81r 2  A9 39                LDA     #OP_LOR
001C83r 2  4C rr rr             JMP     emit_byte
001C86r 2               
001C86r 2               emit_LNOT:
001C86r 2  A9 3A                LDA     #OP_LNOT
001C88r 2  4C rr rr             JMP     emit_byte
001C8Br 2               
001C8Br 2               ; --- Jump emitters ---
001C8Br 2               ; Returns: A/scratch = offset of the word operand in code buffer
001C8Br 2               ; (needed for backpatching)
001C8Br 2               
001C8Br 2               emit_UJP:                       ; emit UJP with placeholder offset
001C8Br 2  A9 50                LDA     #OP_UJP
001C8Dr 2  20 rr rr             JSR     emit_byte
001C90r 2  A5 rr                LDA     cg_pc           ; save patch address
001C92r 2  48                   PHA
001C93r 2  A5 rr                LDA     cg_pc+1
001C95r 2  48                   PHA
001C96r 2  A9 00                LDA     #$00
001C98r 2  20 rr rr             JSR     emit_byte       ; placeholder lo
001C9Br 2  A9 00                LDA     #$00
001C9Dr 2  20 rr rr             JSR     emit_byte       ; placeholder hi
001CA0r 2  68                   PLA
001CA1r 2  85 rr                STA     scratch
001CA3r 2  68                   PLA                     ; lo of patch address
001CA4r 2  60                   RTS                     ; caller: save A/scratch as patch point
001CA5r 2               
001CA5r 2               emit_FJP:
001CA5r 2  A9 51                LDA     #OP_FJP
001CA7r 2  20 rr rr             JSR     emit_byte
001CAAr 2  A5 rr                LDA     cg_pc
001CACr 2  48                   PHA
001CADr 2  A5 rr                LDA     cg_pc+1
001CAFr 2  48                   PHA
001CB0r 2  A9 00                LDA     #$00
001CB2r 2  20 rr rr             JSR     emit_byte
001CB5r 2  A9 00                LDA     #$00
001CB7r 2  20 rr rr             JSR     emit_byte
001CBAr 2  68                   PLA
001CBBr 2  85 rr                STA     scratch
001CBDr 2  68                   PLA
001CBEr 2  60                   RTS
001CBFr 2               
001CBFr 2               emit_TJP:
001CBFr 2  A9 52                LDA     #OP_TJP
001CC1r 2  20 rr rr             JSR     emit_byte
001CC4r 2  A5 rr                LDA     cg_pc
001CC6r 2  48                   PHA
001CC7r 2  A5 rr                LDA     cg_pc+1
001CC9r 2  48                   PHA
001CCAr 2  A9 00                LDA     #$00
001CCCr 2  20 rr rr             JSR     emit_byte
001CCFr 2  A9 00                LDA     #$00
001CD1r 2  20 rr rr             JSR     emit_byte
001CD4r 2  68                   PLA
001CD5r 2  85 rr                STA     scratch
001CD7r 2  68                   PLA
001CD8r 2  60                   RTS
001CD9r 2               
001CD9r 2               ; ---------------------------------------------------------------------------
001CD9r 2               ; patch_jump — fill in jump offset at patch address stored in tmp2 (word)
001CD9r 2               ; The offset is computed as: (current cg_pc) - (patch_addr + 2)
001CD9r 2               ; i.e. relative to instruction after the operand word
001CD9r 2               ; ---------------------------------------------------------------------------
001CD9r 2               patch_jump:
001CD9r 2               ; delta = cg_pc - (patch_addr + 2)
001CD9r 2               ;   compute (cg_pc - 2) first, then subtract patch_addr
001CD9r 2  A5 rr                LDA     cg_pc
001CDBr 2  38                   SEC
001CDCr 2  E9 02                SBC     #2
001CDEr 2  85 rr                STA     scratch         ; lo of (cg_pc - 2)
001CE0r 2  A5 rr                LDA     cg_pc+1
001CE2r 2  E9 00                SBC     #0
001CE4r 2  85 rr                STA     scratch+1       ; hi of (cg_pc - 2)
001CE6r 2  38                   SEC
001CE7r 2  A5 rr                LDA     scratch
001CE9r 2  E5 rr                SBC     tmp2
001CEBr 2  48                   PHA
001CECr 2  A5 rr                LDA     scratch+1
001CEEr 2  E5 rr                SBC     tmp2+1
001CF0r 2  85 rr                STA     scratch+1       ; high byte of delta
001CF2r 2  68                   PLA
001CF3r 2  85 rr                STA     scratch         ; low byte of delta
001CF5r 2               ; write delta at patch address (CODEBUF_BASE + tmp2)
001CF5r 2  A5 rr                LDA     tmp2
001CF7r 2  18                   CLC
001CF8r 2  69 00                ADC     #<CODEBUF_BASE
001CFAr 2  85 rr                STA     tmp3
001CFCr 2  A5 rr                LDA     tmp2+1
001CFEr 2  69 30                ADC     #>CODEBUF_BASE
001D00r 2  85 rr                STA     tmp3+1
001D02r 2  A0 00                LDY     #0
001D04r 2  A5 rr                LDA     scratch
001D06r 2  91 rr                STA     (tmp3),y
001D08r 2  C8                   INY
001D09r 2  A5 rr                LDA     scratch+1
001D0Br 2  91 rr                STA     (tmp3),y
001D0Dr 2  60                   RTS
001D0Er 2               
001D0Er 2               ; --- I/O emitters ---
001D0Er 2               
001D0Er 2               emit_WRITI:
001D0Er 2  A9 80                LDA     #OP_WRITI
001D10r 2  4C rr rr             JMP     emit_byte
001D13r 2               
