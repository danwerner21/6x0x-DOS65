00224Er 2               @rec_rhs_field:
00224Er 2               ; Chained field access loop: TOS holds &cur_record_base.
00224Er 2               ; fcall_vmask = current record's first_field, fcall_lsize = its count.
00224Er 2               ; Each iteration consumes ".name" and walks one level deeper.  When the
00224Er 2               ; resolved field is itself a RECORD and another '.' follows, repeat;
00224Er 2               ; otherwise emit LDIND on the final scalar address.
00224Er 2  A5 rr                LDA     tok_type
002250r 2  C9 22                CMP     #TOK_DOT
002252r 2  F0 0D                BEQ     @rrf_chain
002254r 2  AD rr rr             LDA     fcall_vmask
002257r 2  8D rr rr             STA     expr_record_first
00225Ar 2  AD rr rr             LDA     fcall_lsize
00225Dr 2  8D rr rr             STA     expr_record_count
002260r 2  60                   RTS
002261r 2               @rrf_chain:
002261r 2               ; consume '.'
002261r 2  A5 rr                LDA     tok_type
002263r 2  C9 22                CMP     #TOK_DOT
002265r 2  D0 03                BNE     :+
002267r 2  20 rr rr             JSR     next_token
00226Ar 2               :
00226Ar 2               ; field name now in ident_buf — look up in current record
00226Ar 2  AD rr rr             LDA     fcall_vmask     ; first_field_idx
00226Dr 2  AE rr rr             LDX     fcall_lsize     ; field_count
002270r 2  20 rr rr             JSR     field_lookup_in_record
002273r 2  90 5F                BCC     @rec_rhs_nf
002275r 2               ; A=offset, X=type, tmp3=matched index. Stash all three across emits.
002275r 2  48                   PHA                     ; save offset
002276r 2  8A                   TXA
002277r 2  8D rr rr             STA     field_chain_type
00227Ar 2  A5 rr                LDA     tmp3
00227Cr 2  AA                   TAX
00227Dr 2  BD rr rr             LDA     field_nested_first,x
002280r 2  8D rr rr             STA     field_chain_first
002283r 2  BD rr rr             LDA     field_nested_count,x
002286r 2  8D rr rr             STA     field_chain_count
002289r 2  68                   PLA                     ; offset back; PLA sets Z
00228Ar 2  F0 06                BEQ     @rrf_no_off
00228Cr 2  20 rr rr             JSR     emit_LDCI
00228Fr 2  20 rr rr             JSR     emit_ADI
002292r 2               @rrf_no_off:
002292r 2  20 rr rr             JSR     next_token              ; consume field name
002295r 2               ; If field type is RECORD AND next token is '.', chain into it.
002295r 2  AD rr rr             LDA     field_chain_type
002298r 2  C9 06                CMP     #TY_RECORD
00229Ar 2  D0 14                BNE     @rrf_done_chain
00229Cr 2  A5 rr                LDA     tok_type
00229Er 2  C9 22                CMP     #TOK_DOT
0022A0r 2  D0 0E                BNE     @rrf_done_chain
0022A2r 2  AD rr rr             LDA     field_chain_first
0022A5r 2  8D rr rr             STA     fcall_vmask
0022A8r 2  AD rr rr             LDA     field_chain_count
0022ABr 2  8D rr rr             STA     fcall_lsize
0022AEr 2  80 B1                BRA     @rrf_chain
0022B0r 2               @rrf_done_chain:
0022B0r 2               ; Final step: scalar fields → LDIND value; record fields stay as
0022B0r 2               ; addresses (so calling code sees them as TY_RECORD pointers).
0022B0r 2  AD rr rr             LDA     field_chain_type
0022B3r 2  C9 06                CMP     #TY_RECORD
0022B5r 2  F0 0B                BEQ     @rrf_rec_result
0022B7r 2  20 rr rr             JSR     emit_LDIND
0022BAr 2  AD rr rr             LDA     field_chain_type
0022BDr 2  85 rr                STA     expr_type
0022BFr 2  4C rr rr             JMP     maybe_deref_loaded_ptr
0022C2r 2               @rrf_rec_result:
0022C2r 2  AD rr rr             LDA     field_chain_first
0022C5r 2  8D rr rr             STA     expr_record_first
0022C8r 2  AD rr rr             LDA     field_chain_count
0022CBr 2  8D rr rr             STA     expr_record_count
0022CEr 2  AD rr rr             LDA     field_chain_type
0022D1r 2  85 rr                STA     expr_type
0022D3r 2  60                   RTS
0022D4r 2               @rec_rhs_nf:
0022D4r 2  A9 rr                LDA     #<err_undef
0022D6r 2  85 rr                STA     tmp0
0022D8r 2  A9 rr                LDA     #>err_undef
0022DAr 2  85 rr                STA     tmp0+1
0022DCr 2  20 rr rr             JSR     compile_error
0022DFr 2  20 rr rr             JSR     next_token      ; consume bad field name
0022E2r 2  20 rr rr             JSR     emit_LDIND      ; keep stack balanced
0022E5r 2  A9 01                LDA     #TY_INT
0022E7r 2  85 rr                STA     expr_type
0022E9r 2  60                   RTS
0022EAr 2               @varref_load:
0022EAr 2               ; SYM_VARREF: local slot holds an address. Compound types keep that
0022EAr 2               ; address as their expression result; scalars load through it.
0022EAr 2  68                   PLA                     ; discard pcount
0022EBr 2  8A                   TXA
0022ECr 2  20 rr rr             JSR     emit_LDL        ; push address from slot
0022EFr 2  A5 rr                LDA     expr_type
0022F1r 2  C9 06                CMP     #TY_RECORD
0022F3r 2  F0 0E                BEQ     @vrf_addr
0022F5r 2  C9 05                CMP     #TY_ARRAY
0022F7r 2  F0 0A                BEQ     @vrf_addr
0022F9r 2  C9 08                CMP     #TY_TEXT
0022FBr 2  F0 06                BEQ     @vrf_addr
0022FDr 2  20 rr rr             JSR     emit_LDIND      ; deref → push word
002300r 2  4C rr rr             JMP     maybe_deref_loaded_ptr
002303r 2               @vrf_addr:
002303r 2  C9 06                CMP     #TY_RECORD
002305r 2  D0 0C                BNE     :+
002307r 2  AD rr rr             LDA     fcall_vmask
00230Ar 2  8D rr rr             STA     expr_record_first
00230Dr 2  AD rr rr             LDA     fcall_lsize
002310r 2  8D rr rr             STA     expr_record_count
002313r 2  60           :       RTS
002314r 2               @const_emit:
002314r 2               ; CONST: offset bytes hold the literal value. X=lo, scratch=hi.
002314r 2  68                   PLA                     ; discard pcount
002315r 2  8A                   TXA
002316r 2  20 rr rr             JSR     emit_LDCW
002319r 2  60                   RTS
00231Ar 2               @sym_func_call:
00231Ar 2               ; SYM_FUNC: emit MRKSTK + arg-stores + CALL.  Result is left on TOS
00231Ar 2               ; by op_RETF.  expr_type is the function's return type (already set).
00231Ar 2               ; X=off lo, scratch=off hi, top of 6502 stack = pcount.
00231Ar 2               ; NOTE: not nest-safe — calling a function inside another function
00231Ar 2               ; call's argument list will clobber fcall_*.  TODO: fix later.
00231Ar 2  8E rr rr             STX     fcall_lo
00231Dr 2  A5 rr                LDA     scratch
00231Fr 2  8D rr rr             STA     fcall_hi
002322r 2  A5 rr                LDA     expr_type
002324r 2  8D rr rr             STA     fcall_type      ; preserve across parse_expression
002327r 2  68                   PLA                     ; pcount
002328r 2  8D rr rr             STA     fcall_pcount
00232Br 2               ; emit MRKSTK <full local-area size> (params + body locals).
00232Br 2               ; fcall_lsize was captured at @sym_ok from entry offset 23.
00232Br 2  AD rr rr             LDA     fcall_lsize
00232Er 2  20 rr rr             JSR     emit_MRKSTK
002331r 2  AD rr rr             LDA     fcall_pcount
002334r 2  F0 4A                BEQ     @fc_no_args
002336r 2               ; expect '('
002336r 2  A5 rr                LDA     tok_type
002338r 2  C9 1B                CMP     #TOK_LPAREN
00233Ar 2  D0 56                BNE     @fc_emit_call
00233Cr 2  20 rr rr             JSR     next_token      ; consume '('
00233Fr 2  A2 00                LDX     #0              ; X = arg index
002341r 2               @fc_arg_loop:
002341r 2               ; Bit X of fcall_vmask → VAR (push address); else value.
002341r 2  DA                   PHX
002342r 2  A9 01                LDA     #1
002344r 2               @fcvbit:
002344r 2  E0 00                CPX     #0
002346r 2  F0 04                BEQ     @fcvdone
002348r 2  0A                   ASL
002349r 2  CA                   DEX
00234Ar 2  80 F8                BRA     @fcvbit
00234Cr 2               @fcvdone:
00234Cr 2  FA                   PLX
00234Dr 2  2D rr rr             AND     fcall_vmask
002350r 2  F0 07                BEQ     @fc_arg_value
