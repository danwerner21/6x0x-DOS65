0018A6r 2               @array_assign:
0018A6r 2               ; a[i] := expr
0018A6r 2               ; emit base-address push
0018A6r 2  AD rr rr             LDA     sym_save_scope
0018A9r 2  D0 0D                BNE     @aarr_local
0018ABr 2  AD rr rr             LDA     sym_save_off+1
