001979r 2               ; ---------------------------------------------------------------------------
001979r 2               ; codegen_alloc_array_global — allocate ARRAY [array_lo..array_hi] in globals
001979r 2               ; Element size fixed at 2 (all scalars are word-sized).
001979r 2               ; Returns: tmp2 = adjusted_offset = raw_base - lo*2
001979r 2               ;          cg_globals advanced by (hi - lo + 1) * 2
001979r 2               ; Clobbers: tmp2, tmp3
001979r 2               ; ---------------------------------------------------------------------------
001979r 2               codegen_alloc_array_global:
001979r 2               ; count = hi - lo + 1  (16-bit)
001979r 2  AD rr rr             LDA     array_hi
00197Cr 2  38                   SEC
00197Dr 2  ED rr rr             SBC     array_lo
001980r 2  85 rr                STA     tmp2
001982r 2  AD rr rr             LDA     array_hi+1
001985r 2  ED rr rr             SBC     array_lo+1
001988r 2  85 rr                STA     tmp2+1
00198Ar 2  E6 rr                INC     tmp2
00198Cr 2  D0 02                BNE     :+
00198Er 2  E6 rr                INC     tmp2+1
001990r 2               :
001990r 2               ; alloc_size = count * 2
001990r 2  06 rr                ASL     tmp2
001992r 2  26 rr                ROL     tmp2+1
001994r 2               ; save raw_base = cg_globals before advancing
001994r 2  A5 rr                LDA     cg_globals
001996r 2  85 rr                STA     tmp3
001998r 2  A5 rr                LDA     cg_globals+1
00199Ar 2  85 rr                STA     tmp3+1
00199Cr 2               ; advance cg_globals by alloc_size (tmp2)
00199Cr 2  A5 rr                LDA     cg_globals
00199Er 2  18                   CLC
00199Fr 2  65 rr                ADC     tmp2
0019A1r 2  85 rr                STA     cg_globals
0019A3r 2  A5 rr                LDA     cg_globals+1
0019A5r 2  65 rr                ADC     tmp2+1
0019A7r 2  85 rr                STA     cg_globals+1
0019A9r 2               ; adjusted_offset = raw_base (tmp3) - lo*2 (tmp2 reused)
0019A9r 2  AD rr rr             LDA     array_lo
0019ACr 2  0A                   ASL
0019ADr 2  85 rr                STA     tmp2
0019AFr 2  AD rr rr             LDA     array_lo+1
0019B2r 2  2A                   ROL
0019B3r 2  85 rr                STA     tmp2+1
0019B5r 2  A5 rr                LDA     tmp3
0019B7r 2  38                   SEC
0019B8r 2  E5 rr                SBC     tmp2
0019BAr 2  85 rr                STA     tmp2
0019BCr 2  A5 rr                LDA     tmp3+1
0019BEr 2  E5 rr                SBC     tmp2+1
0019C0r 2  85 rr                STA     tmp2+1
0019C2r 2  60                   RTS
0019C3r 2               
0019C3r 2               ; ---------------------------------------------------------------------------
0019C3r 2               ; codegen_alloc_record_global — reserve record_size bytes in globals
0019C3r 2               ; Returns: tmp2 = offset of record's first byte
0019C3r 2               ;          cg_globals advanced by record_size
0019C3r 2               ; ---------------------------------------------------------------------------
0019C3r 2               codegen_alloc_record_global:
0019C3r 2  A5 rr                LDA     cg_globals
0019C5r 2  85 rr                STA     tmp2
0019C7r 2  A5 rr                LDA     cg_globals+1
0019C9r 2  85 rr                STA     tmp2+1
0019CBr 2  18                   CLC
0019CCr 2  A5 rr                LDA     cg_globals
0019CEr 2  6D rr rr             ADC     record_size
0019D1r 2  85 rr                STA     cg_globals
0019D3r 2  A5 rr                LDA     cg_globals+1
0019D5r 2  6D rr rr             ADC     record_size+1
0019D8r 2  85 rr                STA     cg_globals+1
0019DAr 2  60                   RTS
0019DBr 2               
0019DBr 2               ; --- Arithmetic emitters ---
0019DBr 2               
0019DBr 2               emit_ADI:
0019DBr 2  A9 30                LDA     #OP_ADI
0019DDr 2  4C rr rr             JMP     emit_byte
0019E0r 2               
