002219r 2                       ; fall through to @maybe_deref_ptr
002219r 2               @maybe_deref_ptr:
002219r 2  4C rr rr             JMP     maybe_deref_loaded_ptr
00221Cr 2               @text_rhs_local:
00221Cr 2  8A                   TXA
