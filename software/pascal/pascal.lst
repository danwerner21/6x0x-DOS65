0013C4r 2               ; ---------------------------------------------------------------------------
0013C4r 2               ; parse_simple_expr — term { (+|-|OR) term }
0013C4r 2               ; ---------------------------------------------------------------------------
0013C4r 2               parse_simple_expr:
0013C4r 2               ; check for unary minus
0013C4r 2  A5 rr                LDA     tok_type
0013C6r 2  C9 11                CMP     #TOK_MINUS
0013C8r 2  D0 0E                BNE     :+
0013CAr 2  20 rr rr             JSR     next_token
0013CDr 2  20 rr rr             JSR     parse_term
0013D0r 2  20 rr rr             JSR     emit_NGI
0013D3r 2  A9 01                LDA     #TY_INT
0013D5r 2  85 rr                STA     expr_type
0013D7r 2  60                   RTS
0013D8r 2               :
0013D8r 2  20 rr rr             JSR     parse_term
0013DBr 2               @addop:
0013DBr 2  A5 rr                LDA     tok_type
0013DDr 2  C9 10                CMP     #TOK_PLUS
0013DFr 2  F0 09                BEQ     @add
0013E1r 2  C9 11                CMP     #TOK_MINUS
0013E3r 2  F0 14                BEQ     @sub
0013E5r 2  C9 51                CMP     #TOK_OR
0013E7r 2  F0 1F                BEQ     @or
