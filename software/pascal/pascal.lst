001402r 2  A9 01                LDA     #TY_INT
001404r 2  85 rr                STA     expr_type
001406r 2  80 D3                BRA     @addop
001408r 2               @or:
001408r 2  20 rr rr             JSR     next_token
00140Br 2  20 rr rr             JSR     parse_term
00140Er 2  20 rr rr             JSR     emit_LOR
001411r 2  A9 03                LDA     #TY_BOOL
001413r 2  85 rr                STA     expr_type
001415r 2  80 C4                BRA     @addop
001417r 2               
001417r 2               ; ---------------------------------------------------------------------------
001417r 2               ; parse_term — factor { (*|DIV|MOD|AND) factor }
001417r 2               ; ---------------------------------------------------------------------------
001417r 2               parse_term:
001417r 2  20 rr rr             JSR     parse_factor
00141Ar 2               @mulop:
00141Ar 2  A5 rr                LDA     tok_type
00141Cr 2  C9 12                CMP     #TOK_STAR
00141Er 2  F0 11                BEQ     @mul
001420r 2  C9 45                CMP     #TOK_DIV
001422r 2  F0 1C                BEQ     @div
001424r 2  C9 45                CMP     #TOK_DIV_KW
001426r 2  F0 18                BEQ     @div
001428r 2  C9 4D                CMP     #TOK_MOD_KW
00142Ar 2  F0 23                BEQ     @mod
00142Cr 2  C9 40                CMP     #TOK_AND
00142Er 2  F0 2E                BEQ     @and
001430r 2  60                   RTS
001431r 2               @mul:
001431r 2  20 rr rr             JSR     next_token
001434r 2  20 rr rr             JSR     parse_factor
001437r 2  20 rr rr             JSR     emit_MPI
00143Ar 2  A9 01                LDA     #TY_INT
00143Cr 2  85 rr                STA     expr_type
00143Er 2  80 DA                BRA     @mulop
001440r 2               @div:
001440r 2  20 rr rr             JSR     next_token
001443r 2  20 rr rr             JSR     parse_factor
001446r 2  20 rr rr             JSR     emit_DVI
001449r 2  A9 01                LDA     #TY_INT
00144Br 2  85 rr                STA     expr_type
00144Dr 2  80 CB                BRA     @mulop
00144Fr 2               @mod:
00144Fr 2  20 rr rr             JSR     next_token
001452r 2  20 rr rr             JSR     parse_factor
001455r 2  20 rr rr             JSR     emit_MOD
001458r 2  A9 01                LDA     #TY_INT
00145Ar 2  85 rr                STA     expr_type
00145Cr 2  80 BC                BRA     @mulop
00145Er 2               @and:
