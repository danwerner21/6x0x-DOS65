002461r 2  60                   RTS
002462r 2               @cat_more:
002462r 2  20 rr rr             JSR     next_token              ; consume ','
002465r 2  20 rr rr             JSR     parse_expression        ; next arg
002468r 2  20 rr rr             JSR     emit_CONCAT             ; merge previous + next
00246Br 2  A5 rr                LDA     tok_type
00246Dr 2  C9 1F                CMP     #TOK_COMMA
00246Fr 2  F0 F1                BEQ     @cat_more
002471r 2  A9 1C                LDA     #TOK_RPAREN
002473r 2  20 rr rr             JSR     parse_eat_token
