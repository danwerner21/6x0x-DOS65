000000r 1               ; pascal.asm — Pascal/65 Compiler for DOS/65
000000r 1               ;
000000r 1               ; Usage: PASCAL <sourcename>
000000r 1               ;   Reads <sourcename>.PAS, writes <sourcename>.PCD
000000r 1               ;
000000r 1               ; Phase 1 entry point and top-level driver only.
000000r 1               ; Lexer, parser, symbol table, and code generator are in separate files
000000r 1               ; included at the bottom of this file.
000000r 1               
000000r 1               .PC02   ; enable 65C02 (bra/phx/plx) for write_pcd etc.
000000r 1                       ; lexer.asm also asserts this; included files
000000r 1                       ; pick it up after lexer.asm runs.
000000r 1               
000000r 1                       .include        "DEFINITIONS.ASM"
000000r 2               ; definitions.asm — constants, token codes, p-code opcodes, macros
000000r 2               
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               ; DOS/65 system entry points
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               PEM_ENTRY       = $0103         ; JSR here; function # in X
000000r 2               WARM_BOOT       = $0100
000000r 2               DEFAULT_FCB     = $0107         ; DOS/65 dflfcb (parsed argument FCB)
000000r 2               DMA_BUF         = $0128         ; DOS/65 dflbuf (default DMA buffer)
000000r 2               
000000r 2               ; PEM function numbers
000000r 2               PEM_CONIN       = 1             ; console input with echo (blocking)
000000r 2               PEM_CONOUT      = 2             ; console output (A=char)
000000r 2               PEM_DIRCON      = 6             ; direct console I/O (BLOCKING — use fn 11 first)
000000r 2               PEM_CONSTAT     = 11            ; console status (non-blocking)
000000r 2               PEM_OPEN        = 15
000000r 2               PEM_CLOSE       = 16
000000r 2               PEM_SEARCH      = 17
000000r 2               PEM_DELETE      = 19
000000r 2               PEM_READ        = 20
000000r 2               PEM_WRITE       = 21
000000r 2               PEM_MAKE        = 22
000000r 2               
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               ; P-code opcodes
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               
000000r 2               ; --- Constants ---
000000r 2               OP_LDCI         = $00           ; push sign-extended byte constant
000000r 2               OP_LDCW         = $01           ; push word constant (lo, hi)
000000r 2               OP_LDCC         = $02           ; push char constant
000000r 2               OP_LDCB         = $03           ; push boolean constant (0/1)
000000r 2               OP_LDCS         = $04           ; push string constant (len + bytes)
000000r 2               OP_LDCN         = $05           ; push NIL
000000r 2               
000000r 2               ; --- Local variable access ---
000000r 2               OP_LDL          = $10           ; push 16-bit local (byte offset from MP+8)
000000r 2               OP_STL          = $11           ; pop into 16-bit local
000000r 2               OP_LDA_L        = $12           ; push address of local
000000r 2               OP_LDB_L        = $13           ; push byte/char/bool local
000000r 2               OP_STB_L        = $14           ; pop byte into local
000000r 2               
000000r 2               ; --- Global variable access ---
000000r 2               OP_LDG          = $18           ; push 16-bit global (word offset from BASE)
000000r 2               OP_STG          = $19           ; pop into 16-bit global
000000r 2               OP_LDA_G        = $1A           ; push address of global
000000r 2               OP_LDB_G        = $1B           ; push byte global
000000r 2               OP_STB_G        = $1C           ; pop byte into global
000000r 2               
000000r 2               ; --- Indirect / array ---
000000r 2               OP_LDIND        = $20           ; TOS=addr → push word at addr
000000r 2               OP_STIND        = $21           ; NOS=addr, TOS=val → store
000000r 2               OP_LDB_IND      = $22           ; TOS=addr → push byte at addr
000000r 2               OP_STB_IND      = $23           ; NOS=addr, TOS=val → store byte
000000r 2               OP_INDEX        = $24           ; array index: addr=NOS+TOS*elemsize (word follows)
000000r 2               
000000r 2               ; --- Integer arithmetic ---
000000r 2               OP_ADI          = $30
000000r 2               OP_SBI          = $31
000000r 2               OP_MPI          = $32
000000r 2               OP_DVI          = $33
000000r 2               OP_MOD          = $34
000000r 2               OP_NGI          = $35           ; negate
000000r 2               OP_ABI          = $36           ; absolute value
000000r 2               OP_SQI          = $37           ; square
000000r 2               
000000r 2               ; --- Logical / bitwise ---
000000r 2               OP_LAND         = $38
000000r 2               OP_LOR          = $39
000000r 2               OP_LNOT         = $3A           ; logical NOT ($0000 ↔ $FFFF)
000000r 2               OP_BNOT         = $3B           ; bitwise complement
000000r 2               
000000r 2               ; --- Comparison (push $FFFF=true, $0000=false) ---
000000r 2               OP_EQUI         = $40
000000r 2               OP_NEQI         = $41
000000r 2               OP_LESI         = $42
000000r 2               OP_LEQI         = $43
000000r 2               OP_GTRI         = $44
000000r 2               OP_GEQI         = $45
000000r 2               OP_EQUB         = $46           ; byte equality
000000r 2               OP_EQUS         = $47           ; string equality
000000r 2               
000000r 2               ; --- Control flow ---
000000r 2               OP_UJP          = $50           ; unconditional jump (signed word offset)
000000r 2               OP_FJP          = $51           ; jump if false (pop TOS)
000000r 2               OP_TJP          = $52           ; jump if true  (pop TOS)
000000r 2               OP_IXPJP        = $53           ; case jump table
000000r 2               
000000r 2               ; --- Procedure/function calls ---
000000r 2               OP_CALL         = $60           ; call (signed word offset from current IPC)
000000r 2               OP_CALI         = $61           ; call absolute address (word)
000000r 2               OP_RET          = $62           ; return from procedure
000000r 2               OP_RETF         = $63           ; return from function (leave result on stack)
000000r 2               OP_MRKSTK       = $64           ; set up activation record (byte: local size)
000000r 2               OP_DEPSTK       = $65           ; tear down activation record
000000r 2               OP_STR          = $66           ; pop word, store at MP+AR_RET_VAL (function result)
000000r 2               
000000r 2               ; --- Heap ---
000000r 2               OP_NEW          = $70           ; allocate (word size follows); push pointer
000000r 2               OP_DISP         = $71           ; free pointer on TOS
000000r 2               
000000r 2               ; --- I/O ---
000000r 2               OP_WRITI        = $80           ; write integer
000000r 2               OP_WRITC        = $81           ; write character
000000r 2               OP_WRITB        = $82           ; write boolean
000000r 2               OP_WRITS        = $83           ; write string
000000r 2               OP_WRITLN       = $84           ; write newline
000000r 2               OP_READI        = $85           ; read integer
000000r 2               OP_READC        = $86           ; read character
000000r 2               OP_READS        = $87           ; read string
000000r 2               
000000r 2               ; --- Stack manipulation ---
000000r 2               OP_DUP          = $90
000000r 2               OP_POP          = $91
000000r 2               OP_SWAP         = $92
000000r 2               OP_MOVS         = $93           ; copy n bytes (byte count follows)
000000r 2               
000000r 2               ; --- Halt ---
000000r 2               OP_HALT         = $FF
000000r 2               
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               ; .PCD file magic / version
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               PCD_MAGIC_0     = $50           ; 'P'
000000r 2               PCD_MAGIC_1     = $43           ; 'C'
000000r 2               PCD_VERSION     = $01
000000r 2               
000000r 2               ; PCD header offsets
000000r 2               PCD_MAGIC       = 0
000000r 2               PCD_VER         = 2
000000r 2               PCD_CODESZ      = 4             ; word: code section size
000000r 2               PCD_GLOBSZ      = 6             ; word: global data size
000000r 2               PCD_STRSZ       = 8             ; word: string pool size
000000r 2               PCD_ENTRY       = 10            ; word: entry point offset into code
000000r 2               PCD_HEADER_SZ   = 12
000000r 2               
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               ; Token codes (used by compiler lexer/parser)
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               TOK_EOF         = 0
000000r 2               TOK_IDENT       = 1
000000r 2               TOK_INT         = 2
000000r 2               TOK_STRING      = 3
000000r 2               TOK_CHAR        = 4
000000r 2               
000000r 2               ; Operators / punctuation
000000r 2               TOK_PLUS        = $10           ; +
000000r 2               TOK_MINUS       = $11           ; -
000000r 2               TOK_STAR        = $12           ; *
000000r 2               TOK_SLASH       = $13           ; /
000000r 2               TOK_EQ          = $14           ; =
000000r 2               TOK_NEQ         = $15           ; <>
000000r 2               TOK_LT          = $16           ; <
000000r 2               TOK_GT          = $17           ; >
000000r 2               TOK_LEQ         = $18           ; <=
000000r 2               TOK_GEQ         = $19           ; >=
000000r 2               TOK_ASSIGN      = $1A           ; :=
000000r 2               TOK_LPAREN      = $1B           ; (
000000r 2               TOK_RPAREN      = $1C           ; )
000000r 2               TOK_LBRACK      = $1D           ; [
000000r 2               TOK_RBRACK      = $1E           ; ]
000000r 2               TOK_COMMA       = $1F           ; ,
000000r 2               TOK_SEMICOLON   = $20           ; ;
000000r 2               TOK_COLON       = $21           ; :
000000r 2               TOK_DOT         = $22           ; .
000000r 2               TOK_DOTDOT      = $23           ; ..
000000r 2               TOK_CARET       = $24           ; ^
000000r 2               
000000r 2               ; Keywords
000000r 2               TOK_AND         = $40
000000r 2               TOK_ARRAY       = $41
000000r 2               TOK_BEGIN       = $42
000000r 2               TOK_CASE        = $43
000000r 2               TOK_CONST       = $44
000000r 2               TOK_DIV         = $45
000000r 2               TOK_DO          = $46
000000r 2               TOK_DOWNTO      = $47
000000r 2               TOK_ELSE        = $48
000000r 2               TOK_END         = $49
000000r 2               TOK_FOR         = $4A
000000r 2               TOK_FUNCTION    = $4B
000000r 2               TOK_IF          = $4C
000000r 2               TOK_MOD_KW      = $4D
000000r 2               TOK_NIL         = $4E
000000r 2               TOK_NOT         = $4F
000000r 2               TOK_OF          = $50
000000r 2               TOK_OR          = $51
000000r 2               TOK_PROCEDURE   = $52
000000r 2               TOK_PROGRAM     = $53
000000r 2               TOK_RECORD      = $54
000000r 2               TOK_REPEAT      = $55
000000r 2               TOK_THEN        = $56
000000r 2               TOK_TO          = $57
000000r 2               TOK_TYPE        = $58
000000r 2               TOK_UNTIL       = $59
000000r 2               TOK_VAR         = $5A
000000r 2               TOK_WHILE       = $5B
000000r 2               TOK_WITH        = $5C
000000r 2               
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               ; Useful macros
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               
000000r 2               ; Call PEM with function number in X
000000r 2               .macro PEM func
000000r 2                       ldx     #func
000000r 2                       jsr     PEM_ENTRY
000000r 2               .endmacro
000000r 2               
000000r 1                       .include        "ZEROPAGE.ASM"
000000r 2               ; zeropage.asm — zero-page variable layout for PASCAL.COM and PRUN.COM
000000r 2               ;
000000r 2               ; Avoid $00-$2F (DOS/65 system), $32 (FARFUNCT), $39-$3A (DOS/65).
000000r 2               ; Safe range: $50-$EF
000000r 2               
000000r 2                       .segment        "ZEROPAGE"
000000r 2               
000000r 2  xx xx xx xx          .RES    $50             ; skip $00-$4F (DOS/65 system zero page)
000004r 2  xx xx xx xx  
000008r 2  xx xx xx xx  
000050r 2               
000050r 2               ; ---------------------------------------------------------------------------
000050r 2               ; P-machine registers — start at $50 as noted in comments below
000050r 2               ; ---------------------------------------------------------------------------
000050r 2               
000050r 2               pm_ipc:
000050r 2  xx xx                .RES    2               ; $50-$51  interpreter program counter
000052r 2               pm_sp:
000052r 2  xx xx                .RES    2               ; $52-$53  p-machine stack pointer
000054r 2               pm_mp:
000054r 2  xx xx                .RES    2               ; $54-$55  mark/frame pointer
000056r 2               pm_base:
000056r 2  xx xx                .RES    2               ; $56-$57  global variable base
000058r 2               pm_np:
000058r 2  xx xx                .RES    2               ; $58-$59  heap top (grows downward)
00005Ar 2               
00005Ar 2               ; General-purpose temporaries
00005Ar 2               tmp0:
00005Ar 2  xx xx                .RES    2               ; $5A-$5B
00005Cr 2               tmp1:
00005Cr 2  xx xx                .RES    2               ; $5C-$5D
00005Er 2               tmp2:
00005Er 2  xx xx                .RES    2               ; $5E-$5F
000060r 2               tmp3:
000060r 2  xx xx                .RES    2               ; $60-$61
000062r 2               
000062r 2               ; Byte-width scratch (often used by macros)
000062r 2               scratch:
000062r 2  xx                   .RES    1               ; $62
000063r 2               
000063r 2               ; ---------------------------------------------------------------------------
000063r 2               ; Compiler-specific zero-page variables (only used by PASCAL.COM)
000063r 2               ; ---------------------------------------------------------------------------
000063r 2               
000063r 2               ; Lexer state
000063r 2               lex_line:
000063r 2  xx xx                .RES    2               ; $63-$64  current source line number
000065r 2               lex_col:
000065r 2  xx                   .RES    1               ; $65      current column
000066r 2               lex_char:
000066r 2  xx                   .RES    1               ; $66      lookahead character
000067r 2               tok_type:
000067r 2  xx                   .RES    1               ; $67      current token type
000068r 2               tok_ival_lo:
000068r 2  xx                   .RES    1               ; $68      integer token value (lo)
000069r 2               tok_ival_hi:
000069r 2  xx                   .RES    1               ; $69      integer token value (hi)
00006Ar 2               
00006Ar 2               ; Parser / code generator state
00006Ar 2               cg_pc:
00006Ar 2  xx xx                .RES    2               ; $6A-$6B  current emit offset into code buffer
00006Cr 2               cg_globals:
00006Cr 2  xx xx                .RES    2               ; $6C-$6D  next available global variable offset
00006Er 2               scope_depth:
00006Er 2  xx                   .RES    1               ; $6E      current lexical nesting depth (0=global)
00006Fr 2               sym_chain:
00006Fr 2  xx xx                .RES    2               ; $6F-$70  pointer into symbol table chain
000071r 2               
000071r 2               ; FCB pointers (compiler I/O)
000071r 2               src_fcb:
000071r 2  xx xx                .RES    2               ; $71-$72  pointer to source FCB
000073r 2               out_fcb:
000073r 2  xx xx                .RES    2               ; $73-$74  pointer to output FCB
000075r 2               src_buf_pos:
000075r 2  xx                   .RES    1               ; $75      position within 128-byte sector buffer
000076r 2               src_buf_end:
000076r 2  xx                   .RES    1               ; $76      bytes valid in sector buffer
000077r 2               
000077r 2               ; FOR-loop scratch (parse_for; not nestable)
000077r 2               for_loop_top:
000077r 2  xx xx                .RES    2               ; $77-$78  cg_pc of loop test (back-jump target)
000079r 2               for_patch:
000079r 2  xx xx                .RES    2               ; $79-$7A  FJP exit patch address
00007Br 2               
00007Br 2               ; Result type of the most recently parsed expression (TY_INT/TY_CHAR/
00007Br 2               ; TY_BOOL/TY_STRING/etc.).  Used by parse_write_args to dispatch the
00007Br 2               ; right WRIT* opcode.  Set by parse_factor / parse_simple_expr /
00007Br 2               ; parse_expression as each rule produces its result.
00007Br 2               expr_type:
00007Br 2  xx                   .RES    1               ; $7B
00007Cr 2               
00007Cr 1               
00007Cr 1               ; ---------------------------------------------------------------------------
00007Cr 1               ; FCBs and file buffers
00007Cr 1               ; ---------------------------------------------------------------------------
00007Cr 1                       .segment        "CPMDATA"
000000r 1               
000000r 1               comp_src_fcb:
000000r 1  xx xx xx xx          .RES    36              ; source file FCB (.PAS)
000004r 1  xx xx xx xx  
000008r 1  xx xx xx xx  
000024r 1               comp_out_fcb:
000024r 1  xx xx xx xx          .RES    36              ; output file FCB (.PCD)
000028r 1  xx xx xx xx  
00002Cr 1  xx xx xx xx  
000048r 1               
000048r 1               ; 128-byte sector buffer for source reads
000048r 1               src_sector:
000048r 1  xx xx xx xx          .RES    128
00004Cr 1  xx xx xx xx  
000050r 1  xx xx xx xx  
0000C8r 1               
0000C8r 1               ; Comma-list buffer for parse_var_decls — collects names "A, B, C" before
0000C8r 1               ; the type is known so each can be added to the symbol table with the
0000C8r 1               ; same type code.  8 slots × 16 bytes; excess names are silently dropped.
0000C8r 1               var_name_count:
0000C8r 1  xx                   .RES    1
0000C9r 1               var_name_buf:
0000C9r 1  xx xx xx xx          .RES    128
0000CDr 1  xx xx xx xx  
0000D1r 1  xx xx xx xx  
000149r 1               
000149r 1               ; Code generation buffer — p-code accumulates here until file write
000149r 1               ; Overlaps the CPMDATA area above $2400 after FCBs.
000149r 1               ; This holds up to ~32KB of generated p-code.
000149r 1               CODEBUF_BASE    = $3000
000149r 1               CODEBUF_MAXSZ   = $8000         ; 32 KB
000149r 1               
000149r 1               ; Symbol table area
000149r 1               SYMTAB_BASE     = $8000
000149r 1               SYMTAB_MAXSZ    = $1800         ; 6 KB (≈200 entries at ~30 bytes each)
000149r 1               
000149r 1               ; String pool for identifier strings and string literals
000149r 1               STRPOOL_BASE    = $9800
000149r 1               STRPOOL_MAXSZ   = $0800         ; 2 KB
000149r 1               
000149r 1               ; ---------------------------------------------------------------------------
000149r 1               ; Entry point
000149r 1               ; ---------------------------------------------------------------------------
000149r 1                       .segment        "TEA"
000000r 1               
000000r 1  4C rr rr             JMP     pascal_main
000003r 1               
000003r 1                       .segment        "CODE"
000000r 1               
000000r 1               pascal_main:
000000r 1               ; print banner
000000r 1  A9 rr                LDA     #<msg_banner
000002r 1  85 rr                STA     tmp0
000004r 1  A9 rr                LDA     #>msg_banner
000006r 1  85 rr                STA     tmp0+1
000008r 1  20 rr rr             JSR     console_print_sz
00000Br 1               
00000Br 1               ; build source FCB from DEFAULT_FCB ($0107) argument
00000Br 1  20 rr rr             JSR     build_src_fcb
00000Er 1  90 03                BCC     :+
000010r 1  4C rr rr             JMP     @no_file
000013r 1               :
000013r 1               ; print "Compiling: <name>"
000013r 1  A9 rr                LDA     #<msg_compiling
000015r 1  85 rr                STA     tmp0
000017r 1  A9 rr                LDA     #>msg_compiling
000019r 1  85 rr                STA     tmp0+1
00001Br 1  20 rr rr             JSR     console_print_sz
00001Er 1               
00001Er 1               ; open source file
00001Er 1  A9 rr                LDA     #<comp_src_fcb
000020r 1  85 rr                STA     src_fcb
000022r 1  A9 rr                LDA     #>comp_src_fcb
000024r 1  85 rr                STA     src_fcb+1
000026r 1  A9 rr                LDA     #<comp_src_fcb
000028r 1  85 rr                STA     tmp1
00002Ar 1  A9 rr                LDA     #>comp_src_fcb
00002Cr 1  85 rr                STA     tmp1+1
00002Er 1  20 rr rr             JSR     file_open
000031r 1  C9 FF                CMP     #$FF            ; PEM open: $FF=not found, 0-3=dir entry
000033r 1  D0 03                BNE     :+
000035r 1  4C rr rr             JMP     @no_file
000038r 1               :
000038r 1  A9 31                LDA     #'1'            ; DBG: source file opened
00003Ar 1  20 rr rr             JSR     dbg_putc
00003Dr 1               
00003Dr 1               ; create output .PCD file
00003Dr 1  20 rr rr             JSR     build_out_fcb
000040r 1  A9 rr                LDA     #<comp_out_fcb
000042r 1  85 rr                STA     tmp1
000044r 1  A9 rr                LDA     #>comp_out_fcb
000046r 1  85 rr                STA     tmp1+1
000048r 1  20 rr rr             JSR     file_make
00004Br 1  C9 FF                CMP     #$FF            ; PEM make: $FF=dir full, 0-3=dir entry
00004Dr 1  D0 03                BNE     :+
00004Fr 1  4C rr rr             JMP     @out_err
000052r 1               :
000052r 1  A9 32                LDA     #'2'            ; DBG: output file made
000054r 1  20 rr rr             JSR     dbg_putc
000057r 1               
000057r 1               ; initialise compiler state
000057r 1  20 rr rr             JSR     compiler_init
00005Ar 1  A9 33                LDA     #'3'            ; DBG: compiler_init done
00005Cr 1  20 rr rr             JSR     dbg_putc
00005Fr 1               
00005Fr 1               ; run compilation
00005Fr 1  20 rr rr             JSR     compile_program
000062r 1  A9 34                LDA     #'4'            ; DBG: compile_program done
000064r 1  20 rr rr             JSR     dbg_putc
000067r 1               ; DBG: print cg_pc (bytes emitted)
000067r 1  A9 3D                LDA     #'='
000069r 1  20 rr rr             JSR     dbg_putc
00006Cr 1  A5 rr                LDA     cg_pc
00006Er 1  85 rr                STA     tmp0
000070r 1  A5 rr                LDA     cg_pc+1
000072r 1  85 rr                STA     tmp0+1
000074r 1  20 rr rr             JSR     console_print_dec
000077r 1  A9 20                LDA     #' '
000079r 1  20 rr rr             JSR     dbg_putc
00007Cr 1               
00007Cr 1               ; write .PCD file
00007Cr 1  20 rr rr             JSR     write_pcd
00007Fr 1  A9 35                LDA     #'5'            ; DBG: write_pcd done
000081r 1  20 rr rr             JSR     dbg_putc
000084r 1               
000084r 1               ; close files
000084r 1  A9 rr                LDA     #<comp_src_fcb
000086r 1  85 rr                STA     tmp1
000088r 1  A9 rr                LDA     #>comp_src_fcb
00008Ar 1  85 rr                STA     tmp1+1
00008Cr 1  20 rr rr             JSR     file_close
00008Fr 1  A9 rr                LDA     #<comp_out_fcb
000091r 1  85 rr                STA     tmp1
000093r 1  A9 rr                LDA     #>comp_out_fcb
000095r 1  85 rr                STA     tmp1+1
000097r 1  20 rr rr             JSR     file_close
00009Ar 1               
00009Ar 1               ; print result
00009Ar 1  AD rr rr             LDA     error_count
00009Dr 1  0D rr rr             ORA     error_count+1
0000A0r 1  D0 0E                BNE     @had_errors
0000A2r 1  A9 rr                LDA     #<msg_ok
0000A4r 1  85 rr                STA     tmp0
0000A6r 1  A9 rr                LDA     #>msg_ok
0000A8r 1  85 rr                STA     tmp0+1
0000AAr 1  20 rr rr             JSR     console_print_sz
0000ADr 1  4C 00 01             JMP     WARM_BOOT
0000B0r 1               
0000B0r 1               @had_errors:
0000B0r 1  AD rr rr             LDA     error_count
0000B3r 1  85 rr                STA     tmp0
0000B5r 1  AD rr rr             LDA     error_count+1
0000B8r 1  85 rr                STA     tmp0+1
0000BAr 1  20 rr rr             JSR     console_print_dec
0000BDr 1  A9 rr                LDA     #<msg_errors
0000BFr 1  85 rr                STA     tmp0
0000C1r 1  A9 rr                LDA     #>msg_errors
0000C3r 1  85 rr                STA     tmp0+1
0000C5r 1  20 rr rr             JSR     console_print_sz
0000C8r 1  4C 00 01             JMP     WARM_BOOT
0000CBr 1               
0000CBr 1               @no_file:
0000CBr 1  A9 rr                LDA     #<err_nofile
0000CDr 1  85 rr                STA     tmp0
0000CFr 1  A9 rr                LDA     #>err_nofile
0000D1r 1  85 rr                STA     tmp0+1
0000D3r 1  20 rr rr             JSR     console_print_sz
0000D6r 1  4C 00 01             JMP     WARM_BOOT
0000D9r 1               
0000D9r 1               @out_err:
0000D9r 1  A9 rr                LDA     #<err_outfile
0000DBr 1  85 rr                STA     tmp0
0000DDr 1  A9 rr                LDA     #>err_outfile
0000DFr 1  85 rr                STA     tmp0+1
0000E1r 1  20 rr rr             JSR     console_print_sz
0000E4r 1  4C 00 01             JMP     WARM_BOOT
0000E7r 1               
0000E7r 1               ; ---------------------------------------------------------------------------
0000E7r 1               ; build_src_fcb — populate comp_src_fcb from DEFAULT_FCB ($0107), force ".PAS"
0000E7r 1               ; DOS/65 CCM copies the parsed argument FCB to dflfcb=$0107, not $005C.
0000E7r 1               ; Returns: carry clear = ok, carry set = no filename
0000E7r 1               ; ---------------------------------------------------------------------------
0000E7r 1               build_src_fcb:
0000E7r 1  A2 00                LDX     #0
0000E9r 1               @copy:
0000E9r 1  BD 07 01             LDA     DEFAULT_FCB,x
0000ECr 1  9D rr rr             STA     comp_src_fcb,x
0000EFr 1  E8                   INX
0000F0r 1  E0 0C                CPX     #12
0000F2r 1  90 F5                BCC     @copy
0000F4r 1  A9 00                LDA     #0
0000F6r 1               @zero:
0000F6r 1  9D rr rr             STA     comp_src_fcb,x
0000F9r 1  E8                   INX
0000FAr 1  E0 24                CPX     #36
0000FCr 1  90 F8                BCC     @zero
0000FEr 1  AD rr rr             LDA     comp_src_fcb+1
000101r 1  C9 20                CMP     #' '
000103r 1  F0 11                BEQ     @noname
000105r 1  A9 50                LDA     #'P'
000107r 1  8D rr rr             STA     comp_src_fcb+9
00010Ar 1  A9 41                LDA     #'A'
00010Cr 1  8D rr rr             STA     comp_src_fcb+10
00010Fr 1  A9 53                LDA     #'S'
000111r 1  8D rr rr             STA     comp_src_fcb+11
000114r 1  18                   CLC
000115r 1  60                   RTS
000116r 1               @noname:
000116r 1  38                   SEC
000117r 1  60                   RTS
000118r 1               
000118r 1               ; ---------------------------------------------------------------------------
000118r 1               ; build_out_fcb — copy filename from comp_src_fcb, change extension to "PCD"
000118r 1               ; ---------------------------------------------------------------------------
000118r 1               build_out_fcb:
000118r 1  A2 00                LDX     #0
00011Ar 1               @copy:
00011Ar 1  BD rr rr             LDA     comp_src_fcb,x
00011Dr 1  9D rr rr             STA     comp_out_fcb,x
000120r 1  E8                   INX
000121r 1  E0 24                CPX     #36
000123r 1  90 F5                BCC     @copy
000125r 1  A9 50                LDA     #'P'
000127r 1  8D rr rr             STA     comp_out_fcb+9
00012Ar 1  A9 43                LDA     #'C'
00012Cr 1  8D rr rr             STA     comp_out_fcb+10
00012Fr 1  A9 44                LDA     #'D'
000131r 1  8D rr rr             STA     comp_out_fcb+11
000134r 1  60                   RTS
000135r 1               
000135r 1               ; ---------------------------------------------------------------------------
000135r 1               ; compiler_init — zero-out compiler state
000135r 1               ; ---------------------------------------------------------------------------
000135r 1               error_count:
000135r 1  00 00                .WORD   0
000137r 1               
000137r 1               compiler_init:
000137r 1  A9 00                LDA     #0
000139r 1  8D rr rr             STA     error_count
00013Cr 1  8D rr rr             STA     error_count+1
00013Fr 1               ; IPC starts at 0 (offset into code buffer)
00013Fr 1  85 rr                STA     cg_pc
000141r 1  85 rr                STA     cg_pc+1
000143r 1               ; globals start at 0
000143r 1  85 rr                STA     cg_globals
000145r 1  85 rr                STA     cg_globals+1
000147r 1               ; scope depth 0 = global
000147r 1  85 rr                STA     scope_depth
000149r 1               ; main entry-point patch slot — sentinel hi byte = $FF means "none/done"
000149r 1  A9 FF                LDA     #$FF
00014Br 1  8D rr rr             STA     main_jmp_patch+1
00014Er 1               ; init lexer and prime first token
00014Er 1  20 rr rr             JSR     lexer_init
000151r 1  20 rr rr             JSR     next_token
000154r 1  60                   RTS
000155r 1               
000155r 1               ; ---------------------------------------------------------------------------
000155r 1               ; compile_error — print error with line/col; increment error_count
000155r 1               ; tmp0 = pointer to error string
000155r 1               ; ---------------------------------------------------------------------------
000155r 1               compile_error:
000155r 1               ; save caller's message pointer (tmp0) into tmp3
000155r 1  A5 rr                LDA     tmp0
000157r 1  85 rr                STA     tmp3
000159r 1  A5 rr                LDA     tmp0+1
00015Br 1  85 rr                STA     tmp3+1
00015Dr 1               ; print "Line "
00015Dr 1  A9 rr                LDA     #<msg_line
00015Fr 1  85 rr                STA     tmp0
000161r 1  A9 rr                LDA     #>msg_line
000163r 1  85 rr                STA     tmp0+1
000165r 1  20 rr rr             JSR     console_print_sz
000168r 1               ; print line number
000168r 1  A5 rr                LDA     lex_line
00016Ar 1  85 rr                STA     tmp0
00016Cr 1  A5 rr                LDA     lex_line+1
00016Er 1  85 rr                STA     tmp0+1
000170r 1  20 rr rr             JSR     console_print_dec
000173r 1               ; print ": "
000173r 1  A9 3A                LDA     #':'
000175r 1  A2 02                LDX     #PEM_CONOUT
000177r 1  20 03 01             JSR     PEM_ENTRY
00017Ar 1  A9 20                LDA     #' '
00017Cr 1  A2 02                LDX     #PEM_CONOUT
00017Er 1  20 03 01             JSR     PEM_ENTRY
000181r 1               ; print the error message text
000181r 1  A5 rr                LDA     tmp3
000183r 1  85 rr                STA     tmp0
000185r 1  A5 rr                LDA     tmp3+1
000187r 1  85 rr                STA     tmp0+1
000189r 1  20 rr rr             JSR     console_print_sz
00018Cr 1  20 rr rr             JSR     console_newline
00018Fr 1               ; increment error count
00018Fr 1  EE rr rr             INC     error_count
000192r 1  D0 03                BNE     :+
000194r 1  EE rr rr             INC     error_count+1
000197r 1               :
000197r 1  60                   RTS
000198r 1               
000198r 1               ; ---------------------------------------------------------------------------
000198r 1               ; write_pcd — write .PCD header + entire code buffer to output file
000198r 1               ;   Sector 0:        12-byte header  + first 116 bytes of code  (padded)
000198r 1               ;   Sectors 1..N-1:  128 bytes of code each                     (last padded)
000198r 1               ;
000198r 1               ; Uses tmp0 = source pointer (into CODEBUF_BASE),
000198r 1               ;      tmp3 = bytes remaining to write,
000198r 1               ;      tmp1 = FCB pointer (re-loaded before each file_write_sector).
000198r 1               ; ---------------------------------------------------------------------------
000198r 1               write_pcd:
000198r 1               ; --- src_ptr = CODEBUF_BASE; remaining = cg_pc ---
000198r 1  A9 00                LDA     #<CODEBUF_BASE
00019Ar 1  85 rr                STA     tmp0
00019Cr 1  A9 30                LDA     #>CODEBUF_BASE
00019Er 1  85 rr                STA     tmp0+1
0001A0r 1  A5 rr                LDA     cg_pc
0001A2r 1  85 rr                STA     tmp3
0001A4r 1  A5 rr                LDA     cg_pc+1
0001A6r 1  85 rr                STA     tmp3+1
0001A8r 1               
0001A8r 1               ; --- header bytes 0..11 directly into DMA_BUF ---
0001A8r 1  A9 50                LDA     #PCD_MAGIC_0
0001AAr 1  8D 28 01             STA     DMA_BUF+0
0001ADr 1  A9 43                LDA     #PCD_MAGIC_1
0001AFr 1  8D 29 01             STA     DMA_BUF+1
0001B2r 1  A9 01                LDA     #PCD_VERSION
0001B4r 1  8D 2A 01             STA     DMA_BUF+2
0001B7r 1  A9 00                LDA     #0
0001B9r 1  8D 2B 01             STA     DMA_BUF+3
0001BCr 1  A5 rr                LDA     cg_pc
0001BEr 1  8D 2C 01             STA     DMA_BUF+PCD_CODESZ
0001C1r 1  A5 rr                LDA     cg_pc+1
0001C3r 1  8D 2D 01             STA     DMA_BUF+PCD_CODESZ+1
0001C6r 1  A5 rr                LDA     cg_globals
0001C8r 1  8D 2E 01             STA     DMA_BUF+PCD_GLOBSZ
0001CBr 1  A5 rr                LDA     cg_globals+1
0001CDr 1  8D 2F 01             STA     DMA_BUF+PCD_GLOBSZ+1
0001D0r 1  A9 00                LDA     #0
0001D2r 1  8D 30 01             STA     DMA_BUF+PCD_STRSZ
0001D5r 1  8D 31 01             STA     DMA_BUF+PCD_STRSZ+1
0001D8r 1  8D 32 01             STA     DMA_BUF+PCD_ENTRY
0001DBr 1  8D 33 01             STA     DMA_BUF+PCD_ENTRY+1
0001DEr 1               
0001DEr 1               ; --- first sector: copy code into DMA_BUF[12..127] ---
0001DEr 1  A0 00                LDY     #0              ; src offset within this batch
0001E0r 1  A2 0C                LDX     #PCD_HEADER_SZ  ; dest offset in DMA
0001E2r 1               @fill1:
0001E2r 1  E0 80                CPX     #128
0001E4r 1  B0 23                BCS     @write1
0001E6r 1  A5 rr                LDA     tmp3
0001E8r 1  05 rr                ORA     tmp3+1
0001EAr 1  F0 11                BEQ     @pad1
0001ECr 1  B1 rr                LDA     (tmp0),y
0001EEr 1  9D 28 01             STA     DMA_BUF,x
0001F1r 1  E8                   INX
0001F2r 1  C8                   INY
0001F3r 1               ; remaining--
0001F3r 1  A5 rr                LDA     tmp3
0001F5r 1  D0 02                BNE     :+
0001F7r 1  C6 rr                DEC     tmp3+1
0001F9r 1               :
0001F9r 1  C6 rr                DEC     tmp3
0001FBr 1  80 E5                BRA     @fill1
0001FDr 1               @pad1:
0001FDr 1  E0 80                CPX     #128
0001FFr 1  B0 08                BCS     @write1
000201r 1  A9 00                LDA     #0
000203r 1  9D 28 01             STA     DMA_BUF,x
000206r 1  E8                   INX
000207r 1  80 F4                BRA     @pad1
000209r 1               @write1:
000209r 1               ; advance src by Y (bytes consumed from this batch)
000209r 1  84 rr                STY     scratch
00020Br 1  18                   CLC
00020Cr 1  A5 rr                LDA     tmp0
00020Er 1  65 rr                ADC     scratch
000210r 1  85 rr                STA     tmp0
000212r 1  90 02                BCC     :+
000214r 1  E6 rr                INC     tmp0+1
000216r 1               :
000216r 1  A9 rr                LDA     #<comp_out_fcb
000218r 1  85 rr                STA     tmp1
00021Ar 1  A9 rr                LDA     #>comp_out_fcb
00021Cr 1  85 rr                STA     tmp1+1
00021Er 1  20 rr rr             JSR     file_write_sector
000221r 1               
000221r 1               ; --- additional sectors (full 128 bytes each, last pad with 0) ---
000221r 1               @next_sec:
000221r 1  A5 rr                LDA     tmp3
000223r 1  05 rr                ORA     tmp3+1
000225r 1  F0 42                BEQ     @done
000227r 1  A0 00                LDY     #0
000229r 1               @fill2:
000229r 1  C0 80                CPY     #128
00022Br 1  B0 22                BCS     @write2
00022Dr 1  A5 rr                LDA     tmp3
00022Fr 1  05 rr                ORA     tmp3+1
000231r 1  F0 10                BEQ     @pad2
000233r 1  B1 rr                LDA     (tmp0),y
000235r 1  99 28 01             STA     DMA_BUF,y
000238r 1  C8                   INY
000239r 1  A5 rr                LDA     tmp3
00023Br 1  D0 02                BNE     :+
00023Dr 1  C6 rr                DEC     tmp3+1
00023Fr 1               :
00023Fr 1  C6 rr                DEC     tmp3
000241r 1  80 E6                BRA     @fill2
000243r 1               @pad2:
000243r 1  C0 80                CPY     #128
000245r 1  B0 08                BCS     @write2
000247r 1  A9 00                LDA     #0
000249r 1  99 28 01             STA     DMA_BUF,y
00024Cr 1  C8                   INY
00024Dr 1  80 F4                BRA     @pad2
00024Fr 1               @write2:
00024Fr 1               ; advance src by 128 (Y is the count copied from src this sector;
00024Fr 1               ; padded bytes at the tail are not source bytes, but remaining is
00024Fr 1               ; already 0 in that case and the loop will exit).
00024Fr 1  84 rr                STY     scratch
000251r 1  18                   CLC
000252r 1  A5 rr                LDA     tmp0
000254r 1  65 rr                ADC     scratch
000256r 1  85 rr                STA     tmp0
000258r 1  90 02                BCC     :+
00025Ar 1  E6 rr                INC     tmp0+1
00025Cr 1               :
00025Cr 1  A9 rr                LDA     #<comp_out_fcb
00025Er 1  85 rr                STA     tmp1
000260r 1  A9 rr                LDA     #>comp_out_fcb
000262r 1  85 rr                STA     tmp1+1
000264r 1  20 rr rr             JSR     file_write_sector
000267r 1  80 B8                BRA     @next_sec
000269r 1               @done:
000269r 1  60                   RTS
00026Ar 1               
00026Ar 1               ; ---------------------------------------------------------------------------
00026Ar 1               ; dbg_putc — print A as a single character via PEM #2
00026Ar 1               ; ---------------------------------------------------------------------------
00026Ar 1               dbg_putc:
00026Ar 1  A2 02                LDX     #PEM_CONOUT
00026Cr 1  20 03 01             JSR     PEM_ENTRY
00026Fr 1  60                   RTS
000270r 1               
000270r 1               ; ---------------------------------------------------------------------------
000270r 1               ; Include sub-modules (compiler phases)
000270r 1               ; ---------------------------------------------------------------------------
000270r 1                       .include        "LEXER.ASM"
000270r 2               .PC02
000270r 2               ; lexer.asm — Pascal tokenizer
000270r 2               ;
000270r 2               ; Reads source file through 128-byte sector buffer.
000270r 2               ; Produces token stream via next_token (sets tok_type + value vars in ZP).
000270r 2               
000270r 2               ; ---------------------------------------------------------------------------
000270r 2               ; Keyword table — each entry: length byte, ASCII chars, token code
000270r 2               ; Searched linearly; 18 keywords.
000270r 2               ; ---------------------------------------------------------------------------
000270r 2                       .segment        "CODE"
000270r 2               
000270r 2               keyword_table:
000270r 2               ; length, chars..., token
000270r 2  03 41 4E 44          .BYTE   3, "AND",       TOK_AND
000274r 2  40           
000275r 2  05 41 52 52          .BYTE   5, "ARRAY",     TOK_ARRAY
000279r 2  41 59 41     
00027Cr 2  05 42 45 47          .BYTE   5, "BEGIN",     TOK_BEGIN
000280r 2  49 4E 42     
000283r 2  04 43 41 53          .BYTE   4, "CASE",      TOK_CASE
000287r 2  45 43        
000289r 2  05 43 4F 4E          .BYTE   5, "CONST",     TOK_CONST
00028Dr 2  53 54 44     
000290r 2  03 44 49 56          .BYTE   3, "DIV",       TOK_DIV
000294r 2  45           
000295r 2  02 44 4F 46          .BYTE   2, "DO",        TOK_DO
000299r 2  06 44 4F 57          .BYTE   6, "DOWNTO",    TOK_DOWNTO
00029Dr 2  4E 54 4F 47  
0002A1r 2  04 45 4C 53          .BYTE   4, "ELSE",      TOK_ELSE
0002A5r 2  45 48        
0002A7r 2  03 45 4E 44          .BYTE   3, "END",       TOK_END
0002ABr 2  49           
0002ACr 2  03 46 4F 52          .BYTE   3, "FOR",       TOK_FOR
0002B0r 2  4A           
0002B1r 2  08 46 55 4E          .BYTE   8, "FUNCTION",  TOK_FUNCTION
0002B5r 2  43 54 49 4F  
0002B9r 2  4E 4B        
0002BBr 2  02 49 46 4C          .BYTE   2, "IF",        TOK_IF
0002BFr 2  03 4D 4F 44          .BYTE   3, "MOD",       TOK_MOD_KW
0002C3r 2  4D           
0002C4r 2  03 4E 49 4C          .BYTE   3, "NIL",       TOK_NIL
0002C8r 2  4E           
0002C9r 2  03 4E 4F 54          .BYTE   3, "NOT",       TOK_NOT
0002CDr 2  4F           
0002CEr 2  02 4F 46 50          .BYTE   2, "OF",        TOK_OF
0002D2r 2  02 4F 52 51          .BYTE   2, "OR",        TOK_OR
0002D6r 2  09 50 52 4F          .BYTE   9, "PROCEDURE", TOK_PROCEDURE
0002DAr 2  43 45 44 55  
0002DEr 2  52 45 52     
0002E1r 2  07 50 52 4F          .BYTE   7, "PROGRAM",   TOK_PROGRAM
0002E5r 2  47 52 41 4D  
0002E9r 2  53           
0002EAr 2  06 52 45 43          .BYTE   6, "RECORD",    TOK_RECORD
0002EEr 2  4F 52 44 54  
0002F2r 2  06 52 45 50          .BYTE   6, "REPEAT",    TOK_REPEAT
0002F6r 2  45 41 54 55  
0002FAr 2  04 54 48 45          .BYTE   4, "THEN",      TOK_THEN
0002FEr 2  4E 56        
000300r 2  02 54 4F 57          .BYTE   2, "TO",        TOK_TO
000304r 2  04 54 59 50          .BYTE   4, "TYPE",      TOK_TYPE
000308r 2  45 58        
00030Ar 2  05 55 4E 54          .BYTE   5, "UNTIL",     TOK_UNTIL
00030Er 2  49 4C 59     
000311r 2  03 56 41 52          .BYTE   3, "VAR",       TOK_VAR
000315r 2  5A           
000316r 2  05 57 48 49          .BYTE   5, "WHILE",     TOK_WHILE
00031Ar 2  4C 45 5B     
00031Dr 2  04 57 49 54          .BYTE   4, "WITH",      TOK_WITH
000321r 2  48 5C        
000323r 2  00                   .BYTE   0               ; sentinel
000324r 2               
000324r 2               ; Identifier buffer (max 63 chars + length byte at [0])
000324r 2               ident_buf:
000324r 2  xx xx xx xx          .RES    64
000328r 2  xx xx xx xx  
00032Cr 2  xx xx xx xx  
000364r 2               
000364r 2               ; Saved-name buffer for parser (e.g. var-decl name preservation across
000364r 2               ; parse_type_spec which clobbers ident_buf).
000364r 2               save_name_buf:
000364r 2  xx xx xx xx          .RES    16
000368r 2  xx xx xx xx  
00036Cr 2  xx xx xx xx  
000374r 2               
000374r 2               ; Saved symbol info — used by parse_assign_or_call to preserve symbol
000374r 2               ; entry fields across next_token + parse_expression, which clobber tmp3.
000374r 2               sym_save_kind:
000374r 2  xx                   .RES    1
000375r 2               sym_save_scope:
000375r 2  xx                   .RES    1
000376r 2               sym_save_off:
000376r 2  xx xx                .RES    2
000378r 2               sym_save_pcount:
000378r 2  xx                   .RES    1                       ; SYM_PROC param count (entry offset 21)
000379r 2               sym_save_vmask:
000379r 2  xx                   .RES    1               ; SYM_PROC/SYM_FUNC VAR-param bitmap (entry offset 22)
00037Ar 2               sym_save_lsize:
00037Ar 2  xx                   .RES    1               ; SYM_PROC/SYM_FUNC total local-area size (entry offset 23)
00037Br 2               
00037Br 2               ; Procedure-declaration scratch (parse_proc_decl; not nestable in this build).
00037Br 2               proc_param_count:
00037Br 2  xx                   .RES    1               ; running count while parsing param list
00037Cr 2               proc_entry_idx:
00037Cr 2  xx xx                .RES    2               ; symtab index of the proc entry (for backpatch)
00037Er 2               param_var_mask:
00037Er 2  xx                   .RES    1               ; bitmap of which params are VAR (bit i ↔ param i, max 8)
00037Fr 2               group_is_var:
00037Fr 2  xx                   .RES    1               ; 1 while parsing the names of a VAR-prefixed group
000380r 2               local_alloc_off:
000380r 2  xx                   .RES    1               ; next free local-AR offset; init = pcount*2 at proc entry
000381r 2               
000381r 2               ; Function-call scratch (parse_factor @sym_func_call; nested fn calls in args
000381r 2               ; not yet supported — see TODO).
000381r 2               fcall_pcount:
000381r 2  xx                   .RES    1
000382r 2               fcall_lo:
000382r 2  xx                   .RES    1
000383r 2               fcall_hi:
000383r 2  xx                   .RES    1
000384r 2               fcall_type:
000384r 2  xx                   .RES    1
000385r 2               fcall_vmask:
000385r 2  xx                   .RES    1               ; the called proc/func's VAR-param bitmap
000386r 2               fcall_lsize:
000386r 2  xx                   .RES    1               ; the called proc/func's total local-area size (params+locals)
000387r 2               
000387r 2               ; Main-program entry-point patch slot. compile_program emits a UJP at code
000387r 2               ; offset 0; parse_block patches it when it reaches the top-level BEGIN block
000387r 2               ; so the main body executes first (and proc bodies are reached only via CALL).
000387r 2               ; Hi byte = $FF means "already patched" (sentinel — never a valid patch addr
000387r 2               ; since cg_pc starts at 0).
000387r 2               main_jmp_patch:
000387r 2  xx xx                .RES    2
000389r 2               
000389r 2               ; ---------------------------------------------------------------------------
000389r 2               ; lexer_init — reset lexer state; call before compile_program
000389r 2               ; ---------------------------------------------------------------------------
000389r 2               lexer_init:
000389r 2  A9 01                LDA     #1
00038Br 2  85 rr                STA     lex_line
00038Dr 2  A9 00                LDA     #0
00038Fr 2  85 rr                STA     lex_line+1
000391r 2  85 rr                STA     lex_col
000393r 2  85 rr                STA     src_buf_pos
000395r 2  85 rr                STA     src_buf_end
000397r 2               ; prime lex_char
000397r 2  20 rr rr             JSR     lexer_getc
00039Ar 2  60                   RTS
00039Br 2               
00039Br 2               ; ---------------------------------------------------------------------------
00039Br 2               ; next_token — advance to next token, set tok_type
00039Br 2               ; On return:
00039Br 2               ;   tok_type  = token code
00039Br 2               ;   tok_ival  = integer value (if TOK_INT)
00039Br 2               ;   ident_buf = identifier string (if TOK_IDENT)
00039Br 2               ; ---------------------------------------------------------------------------
00039Br 2               next_token:
00039Br 2               ; skip whitespace and comments
00039Br 2               @skip:
00039Br 2  A5 rr                LDA     lex_char
00039Dr 2  F0 39                BEQ     @eof
00039Fr 2  C9 20                CMP     #' '
0003A1r 2  F0 13                BEQ     @ws
0003A3r 2  C9 09                CMP     #$09            ; TAB
0003A5r 2  F0 0F                BEQ     @ws
0003A7r 2  C9 0D                CMP     #$0D            ; CR — treat as whitespace, LF counts the line
0003A9r 2  F0 0B                BEQ     @ws
0003ABr 2  C9 0A                CMP     #$0A            ; LF
0003ADr 2  F0 0C                BEQ     @nl
0003AFr 2  C9 7B                CMP     #'{'            ; Pascal comment start
0003B1r 2  F0 17                BEQ     @comment
0003B3r 2  4C rr rr             JMP     @not_ws
0003B6r 2               @ws:
0003B6r 2  20 rr rr             JSR     lexer_getc
0003B9r 2  80 E0                BRA     @skip
0003BBr 2               @nl:
0003BBr 2  E6 rr                INC     lex_line
0003BDr 2  D0 02                BNE     :+
0003BFr 2  E6 rr                INC     lex_line+1
0003C1r 2               :
0003C1r 2  A9 00                LDA     #0
0003C3r 2  85 rr                STA     lex_col
0003C5r 2  20 rr rr             JSR     lexer_getc
0003C8r 2  80 D1                BRA     @skip
0003CAr 2               @comment:
0003CAr 2               ; skip { ... }
0003CAr 2               @cloop:
0003CAr 2  20 rr rr             JSR     lexer_getc
0003CDr 2  F0 09                BEQ     @eof
0003CFr 2  C9 7D                CMP     #'}'
0003D1r 2  D0 F7                BNE     @cloop
0003D3r 2  20 rr rr             JSR     lexer_getc
0003D6r 2  80 C3                BRA     @skip
0003D8r 2               @eof:
0003D8r 2  A9 00                LDA     #TOK_EOF
0003DAr 2  85 rr                STA     tok_type
0003DCr 2  60                   RTS
0003DDr 2               
0003DDr 2               @not_ws:
0003DDr 2               ; letter → identifier or keyword
0003DDr 2  20 rr rr             JSR     is_letter
0003E0r 2  B0 0C                BCS     @ident
0003E2r 2               
0003E2r 2               ; digit → integer literal
0003E2r 2  20 rr rr             JSR     is_digit
0003E5r 2  B0 2F                BCS     @number
0003E7r 2               
0003E7r 2               ; string → string literal
0003E7r 2  C9 27                CMP     #$27            ; single quote
0003E9r 2  F0 48                BEQ     @string
0003EBr 2               
0003EBr 2               ; operators and punctuation
0003EBr 2  4C rr rr             JMP     @punct
0003EEr 2               
0003EEr 2               ; --- Identifier ---
0003EEr 2               @ident:
0003EEr 2  A0 00                LDY     #0
0003F0r 2               @id_loop:
0003F0r 2  A5 rr                LDA     lex_char
0003F2r 2  20 rr rr             JSR     to_upper
0003F5r 2  99 rr rr             STA     ident_buf+1,y
0003F8r 2  C8                   INY
0003F9r 2  C0 3F                CPY     #63
0003FBr 2  F0 0F                BEQ     @id_done
0003FDr 2  20 rr rr             JSR     lexer_getc
000400r 2  A5 rr                LDA     lex_char
000402r 2  20 rr rr             JSR     is_letter
000405r 2  B0 E9                BCS     @id_loop
000407r 2  20 rr rr             JSR     is_digit
00040Ar 2  B0 E4                BCS     @id_loop
00040Cr 2               @id_done:
00040Cr 2  98                   TYA
00040Dr 2  8D rr rr             STA     ident_buf       ; length
000410r 2               ; check against keyword table
000410r 2  20 rr rr             JSR     lookup_keyword
000413r 2  85 rr                STA     tok_type
000415r 2  60                   RTS
000416r 2               
000416r 2               ; --- Integer literal ---
000416r 2               @number:
000416r 2  A9 00                LDA     #0
000418r 2  85 rr                STA     tok_ival_lo
00041Ar 2  85 rr                STA     tok_ival_hi
00041Cr 2               @num_loop:
00041Cr 2  A5 rr                LDA     lex_char
00041Er 2  38                   SEC
00041Fr 2  E9 30                SBC     #'0'
000421r 2  20 rr rr             JSR     mul10_tokval    ; tokval = tokval*10 + digit
000424r 2  20 rr rr             JSR     lexer_getc
000427r 2  A5 rr                LDA     lex_char
000429r 2  20 rr rr             JSR     is_digit
00042Cr 2  B0 EE                BCS     @num_loop
00042Er 2  A9 02                LDA     #TOK_INT
000430r 2  85 rr                STA     tok_type
000432r 2  60                   RTS
000433r 2               
000433r 2               ; --- String literal ---
000433r 2               @string:
000433r 2  20 rr rr             JSR     lexer_getc      ; skip opening quote
000436r 2  A0 00                LDY     #0
000438r 2               @str_loop:
000438r 2  A5 rr                LDA     lex_char
00043Ar 2  F0 21                BEQ     @str_done       ; EOF
00043Cr 2  C9 27                CMP     #$27
00043Er 2  F0 09                BEQ     @str_close
000440r 2  99 rr rr             STA     ident_buf+1,y
000443r 2  C8                   INY
000444r 2  20 rr rr             JSR     lexer_getc
000447r 2  80 EF                BRA     @str_loop
000449r 2               @str_close:
000449r 2  20 rr rr             JSR     lexer_getc      ; skip closing quote
00044Cr 2               ; check for '' (escaped quote)
00044Cr 2  A5 rr                LDA     lex_char
00044Er 2  C9 27                CMP     #$27
000450r 2  D0 0B                BNE     @str_done
000452r 2  A9 27                LDA     #$27
000454r 2  99 rr rr             STA     ident_buf+1,y
000457r 2  C8                   INY
000458r 2  20 rr rr             JSR     lexer_getc
00045Br 2  80 DB                BRA     @str_loop
00045Dr 2               @str_done:
00045Dr 2  98                   TYA
00045Er 2  8D rr rr             STA     ident_buf
000461r 2  A9 03                LDA     #TOK_STRING
000463r 2  85 rr                STA     tok_type
000465r 2  60                   RTS
000466r 2               
000466r 2               ; --- Punctuation / operators ---
000466r 2               @punct:
000466r 2  A2 00                LDX     #0
000468r 2  A5 rr                LDA     lex_char
00046Ar 2  C9 2B                CMP     #'+'
00046Cr 2  D0 02                BNE     :+
00046Er 2  A2 10                LDX     #TOK_PLUS
000470r 2               :
000470r 2  C9 2D                CMP     #'-'
000472r 2  D0 02                BNE     :+
000474r 2  A2 11                LDX     #TOK_MINUS
000476r 2               :
000476r 2  C9 2A                CMP     #'*'
000478r 2  D0 02                BNE     :+
00047Ar 2  A2 12                LDX     #TOK_STAR
00047Cr 2               :
00047Cr 2  C9 2F                CMP     #'/'
00047Er 2  D0 02                BNE     :+
000480r 2  A2 13                LDX     #TOK_SLASH
000482r 2               :
000482r 2  C9 3D                CMP     #'='
000484r 2  D0 02                BNE     :+
000486r 2  A2 14                LDX     #TOK_EQ
000488r 2               :
000488r 2  C9 28                CMP     #'('
00048Ar 2  D0 02                BNE     :+
00048Cr 2  A2 1B                LDX     #TOK_LPAREN
00048Er 2               :
00048Er 2  C9 29                CMP     #')'
000490r 2  D0 02                BNE     :+
000492r 2  A2 1C                LDX     #TOK_RPAREN
000494r 2               :
000494r 2  C9 5B                CMP     #'['
000496r 2  D0 02                BNE     :+
000498r 2  A2 1D                LDX     #TOK_LBRACK
00049Ar 2               :
00049Ar 2  C9 5D                CMP     #']'
00049Cr 2  D0 02                BNE     :+
00049Er 2  A2 1E                LDX     #TOK_RBRACK
0004A0r 2               :
0004A0r 2  C9 2C                CMP     #','
0004A2r 2  D0 02                BNE     :+
0004A4r 2  A2 1F                LDX     #TOK_COMMA
0004A6r 2               :
0004A6r 2  C9 3B                CMP     #';'
0004A8r 2  D0 02                BNE     :+
0004AAr 2  A2 20                LDX     #TOK_SEMICOLON
0004ACr 2               :
0004ACr 2  C9 5E                CMP     #'^'
0004AEr 2  D0 02                BNE     :+
0004B0r 2  A2 24                LDX     #TOK_CARET
0004B2r 2               :
0004B2r 2  C9 3C                CMP     #'<'
0004B4r 2  D0 22                BNE     @not_lt
0004B6r 2  20 rr rr             JSR     lexer_getc
0004B9r 2  A5 rr                LDA     lex_char
0004BBr 2  C9 3D                CMP     #'='
0004BDr 2  F0 09                BEQ     @leq
0004BFr 2  C9 3E                CMP     #'>'
0004C1r 2  F0 0D                BEQ     @neq
0004C3r 2  A9 16                LDA     #TOK_LT
0004C5r 2  85 rr                STA     tok_type
0004C7r 2  60                   RTS
0004C8r 2               @leq:
0004C8r 2  20 rr rr             JSR     lexer_getc
0004CBr 2  A9 18                LDA     #TOK_LEQ
0004CDr 2  85 rr                STA     tok_type
0004CFr 2  60                   RTS
0004D0r 2               @neq:
0004D0r 2  20 rr rr             JSR     lexer_getc
0004D3r 2  A9 15                LDA     #TOK_NEQ
0004D5r 2  85 rr                STA     tok_type
0004D7r 2  60                   RTS
0004D8r 2               @not_lt:
0004D8r 2  C9 3E                CMP     #'>'
0004DAr 2  D0 16                BNE     @not_gt
0004DCr 2  20 rr rr             JSR     lexer_getc
0004DFr 2  A5 rr                LDA     lex_char
0004E1r 2  C9 3D                CMP     #'='
0004E3r 2  F0 05                BEQ     @geq
0004E5r 2  A9 17                LDA     #TOK_GT
0004E7r 2  85 rr                STA     tok_type
0004E9r 2  60                   RTS
0004EAr 2               @geq:
0004EAr 2  20 rr rr             JSR     lexer_getc
0004EDr 2  A9 19                LDA     #TOK_GEQ
0004EFr 2  85 rr                STA     tok_type
0004F1r 2  60                   RTS
0004F2r 2               @not_gt:
0004F2r 2  C9 3A                CMP     #':'
0004F4r 2  D0 16                BNE     @not_colon
0004F6r 2  20 rr rr             JSR     lexer_getc
0004F9r 2  A5 rr                LDA     lex_char
0004FBr 2  C9 3D                CMP     #'='
0004FDr 2  F0 05                BEQ     @assign
0004FFr 2  A9 21                LDA     #TOK_COLON
000501r 2  85 rr                STA     tok_type
000503r 2  60                   RTS
000504r 2               @assign:
000504r 2  20 rr rr             JSR     lexer_getc
000507r 2  A9 1A                LDA     #TOK_ASSIGN
000509r 2  85 rr                STA     tok_type
00050Br 2  60                   RTS
00050Cr 2               @not_colon:
00050Cr 2  C9 2E                CMP     #'.'
00050Er 2  D0 16                BNE     @not_dot
000510r 2  20 rr rr             JSR     lexer_getc
000513r 2  A5 rr                LDA     lex_char
000515r 2  C9 2E                CMP     #'.'
000517r 2  F0 05                BEQ     @dotdot
000519r 2  A9 22                LDA     #TOK_DOT
00051Br 2  85 rr                STA     tok_type
00051Dr 2  60                   RTS
00051Er 2               @dotdot:
00051Er 2  20 rr rr             JSR     lexer_getc
000521r 2  A9 23                LDA     #TOK_DOTDOT
000523r 2  85 rr                STA     tok_type
000525r 2  60                   RTS
000526r 2               @not_dot:
000526r 2               ; If a single-byte operator matched above, X holds its TOK_* code.
000526r 2               ; Otherwise X=0 and the character is unknown — skip and retry.
000526r 2  E0 00                CPX     #0
000528r 2  F0 07                BEQ     @unknown
00052Ar 2  8A                   TXA
00052Br 2  85 rr                STA     tok_type
00052Dr 2  20 rr rr             JSR     lexer_getc
000530r 2  60                   RTS
000531r 2               @unknown:
000531r 2  20 rr rr             JSR     lexer_getc
000534r 2  4C rr rr             JMP     next_token
000537r 2               
000537r 2               ; ---------------------------------------------------------------------------
000537r 2               ; lexer_getc — fetch next character into lex_char
000537r 2               ; Refills sector buffer via file_read_sector when empty
000537r 2               ; ---------------------------------------------------------------------------
000537r 2               lexer_getc:
000537r 2  5A                   PHY                     ; preserve caller's Y across refill + read
000538r 2  A5 rr                LDA     src_buf_pos
00053Ar 2  C5 rr                CMP     src_buf_end
00053Cr 2  90 17                BCC     @from_buf       ; still have data
00053Er 2               ; refill buffer — set tmp1 to source FCB first
00053Er 2               ; (other code paths leave tmp1 pointing at output FCB)
00053Er 2  A5 rr                LDA     src_fcb
000540r 2  85 rr                STA     tmp1
000542r 2  A5 rr                LDA     src_fcb+1
000544r 2  85 rr                STA     tmp1+1
000546r 2  20 rr rr             JSR     file_read_sector
000549r 2  C9 00                CMP     #0
00054Br 2  D0 15                BNE     @eof_char
00054Dr 2  A9 80                LDA     #128
00054Fr 2  85 rr                STA     src_buf_end
000551r 2  A9 00                LDA     #0
000553r 2  85 rr                STA     src_buf_pos
000555r 2               @from_buf:
000555r 2  A4 rr                LDY     src_buf_pos
000557r 2  B9 28 01             LDA     DMA_BUF,y
00055Ar 2  E6 rr                INC     src_buf_pos
00055Cr 2  85 rr                STA     lex_char
00055Er 2  E6 rr                INC     lex_col
000560r 2  7A                   PLY
000561r 2  60                   RTS
000562r 2               @eof_char:
000562r 2  A9 00                LDA     #0
000564r 2  85 rr                STA     lex_char
000566r 2  7A                   PLY
000567r 2  60                   RTS
000568r 2               
000568r 2               ; ---------------------------------------------------------------------------
000568r 2               ; lookup_keyword — check ident_buf against keyword_table
000568r 2               ; Returns: A = keyword token code, or TOK_IDENT if not found
000568r 2               ; ---------------------------------------------------------------------------
000568r 2               lookup_keyword:
000568r 2  A9 rr                LDA     #<keyword_table
00056Ar 2  85 rr                STA     tmp2
00056Cr 2  A9 rr                LDA     #>keyword_table
00056Er 2  85 rr                STA     tmp2+1
000570r 2               @next_kw:
000570r 2  A0 00                LDY     #0
000572r 2  B1 rr                LDA     (tmp2),y        ; keyword length (0 = sentinel)
000574r 2  F0 2C                BEQ     @not_found
000576r 2  CD rr rr             CMP     ident_buf       ; compare lengths first
000579r 2  D0 15                BNE     @advance
00057Br 2  AA                   TAX                     ; X = length
00057Cr 2  A0 01                LDY     #1
00057Er 2               @cmp_loop:
00057Er 2  B1 rr                LDA     (tmp2),y
000580r 2  D9 rr rr             CMP     ident_buf,y
000583r 2  D0 0B                BNE     @advance
000585r 2  C8                   INY
000586r 2  CA                   DEX
000587r 2  D0 F5                BNE     @cmp_loop
000589r 2               ; match: token code is at offset length+1
000589r 2  AC rr rr             LDY     ident_buf
00058Cr 2  C8                   INY
00058Dr 2  B1 rr                LDA     (tmp2),y
00058Fr 2  60                   RTS
000590r 2               @advance:
000590r 2               ; skip to next entry: advance tmp2 by (length+2)
000590r 2               ; (Y may be >0 if we got here from @cmp_loop — reset to 0 first)
000590r 2  A0 00                LDY     #0
000592r 2  B1 rr                LDA     (tmp2),y        ; length byte
000594r 2  18                   CLC
000595r 2  69 02                ADC     #2              ; +1 for length byte, +1 for token byte
000597r 2  18                   CLC
000598r 2  65 rr                ADC     tmp2
00059Ar 2  85 rr                STA     tmp2
00059Cr 2  90 02                BCC     :+
00059Er 2  E6 rr                INC     tmp2+1
0005A0r 2               :
0005A0r 2  80 CE                BRA     @next_kw
0005A2r 2               @not_found:
0005A2r 2  A9 01                LDA     #TOK_IDENT
0005A4r 2  60                   RTS
0005A5r 2               
0005A5r 2               ; ---------------------------------------------------------------------------
0005A5r 2               ; is_letter — test lex_char; carry set if A-Z or a-z
0005A5r 2               ; ---------------------------------------------------------------------------
0005A5r 2               is_letter:
0005A5r 2  A5 rr                LDA     lex_char
0005A7r 2  C9 41                CMP     #'A'
0005A9r 2  90 10                BCC     @no
0005ABr 2  C9 5B                CMP     #'Z'+1
0005ADr 2  90 0E                BCC     @yes
0005AFr 2  C9 61                CMP     #'a'
0005B1r 2  90 08                BCC     @no
0005B3r 2  C9 7B                CMP     #'z'+1
0005B5r 2  90 06                BCC     @yes
0005B7r 2  C9 5F                CMP     #'_'
0005B9r 2  F0 02                BEQ     @yes
0005BBr 2               @no:
0005BBr 2  18                   CLC
0005BCr 2  60                   RTS
0005BDr 2               @yes:
0005BDr 2  38                   SEC
0005BEr 2  60                   RTS
0005BFr 2               
0005BFr 2               ; ---------------------------------------------------------------------------
0005BFr 2               ; is_digit — test lex_char; carry set if 0-9
0005BFr 2               ; ---------------------------------------------------------------------------
0005BFr 2               is_digit:
0005BFr 2  A5 rr                LDA     lex_char
0005C1r 2  C9 30                CMP     #'0'
0005C3r 2  90 06                BCC     @no
0005C5r 2  C9 3A                CMP     #'9'+1
0005C7r 2  B0 02                BCS     @no
0005C9r 2  38                   SEC
0005CAr 2  60                   RTS
0005CBr 2               @no:
0005CBr 2  18                   CLC
0005CCr 2  60                   RTS
0005CDr 2               
0005CDr 2               ; ---------------------------------------------------------------------------
0005CDr 2               ; to_upper — convert A to uppercase (A-Z,a-z only, others pass through)
0005CDr 2               ; ---------------------------------------------------------------------------
0005CDr 2               to_upper:
0005CDr 2  C9 61                CMP     #'a'
0005CFr 2  90 06                BCC     @done
0005D1r 2  C9 7B                CMP     #'z'+1
0005D3r 2  B0 02                BCS     @done
0005D5r 2  29 DF                AND     #$DF
0005D7r 2               @done:
0005D7r 2  60                   RTS
0005D8r 2               
0005D8r 2               ; ---------------------------------------------------------------------------
0005D8r 2               ; mul10_tokval — tokval = tokval*10 + A  (A = digit 0-9)
0005D8r 2               ; ---------------------------------------------------------------------------
0005D8r 2               mul10_tokval:
0005D8r 2  48                   PHA
0005D9r 2               ; multiply tok_ival by 10: x10 = x*8 + x*2
0005D9r 2  A5 rr                LDA     tok_ival_lo
0005DBr 2  0A                   ASL                     ; *2
0005DCr 2  85 rr                STA     tmp2
0005DEr 2  A5 rr                LDA     tok_ival_hi
0005E0r 2  2A                   ROL
0005E1r 2  85 rr                STA     tmp2+1
0005E3r 2  A5 rr                LDA     tmp2            ; *4
0005E5r 2  0A                   ASL
0005E6r 2  85 rr                STA     tmp3
0005E8r 2  A5 rr                LDA     tmp2+1
0005EAr 2  2A                   ROL
0005EBr 2  85 rr                STA     tmp3+1
0005EDr 2  A5 rr                LDA     tmp3            ; *8
0005EFr 2  0A                   ASL
0005F0r 2  85 rr                STA     tmp3
0005F2r 2  A5 rr                LDA     tmp3+1
0005F4r 2  2A                   ROL
0005F5r 2  85 rr                STA     tmp3+1
0005F7r 2               ; *10 = *8 + *2
0005F7r 2  A5 rr                LDA     tmp3
0005F9r 2  18                   CLC
0005FAr 2  65 rr                ADC     tmp2
0005FCr 2  85 rr                STA     tok_ival_lo
0005FEr 2  A5 rr                LDA     tmp3+1
000600r 2  65 rr                ADC     tmp2+1
000602r 2  85 rr                STA     tok_ival_hi
000604r 2               ; add digit
000604r 2  68                   PLA
000605r 2  18                   CLC
000606r 2  65 rr                ADC     tok_ival_lo
000608r 2  85 rr                STA     tok_ival_lo
00060Ar 2  90 02                BCC     :+
00060Cr 2  E6 rr                INC     tok_ival_hi
00060Er 2               :
00060Er 2  60                   RTS
00060Fr 2               
00060Fr 1                       .include        "PARSER.ASM"
00060Fr 2               ; parser.asm — recursive-descent Pascal parser + single-pass code generator
00060Fr 2               ;
00060Fr 2               ; Entry point: compile_program (called from pascal_main)
00060Fr 2               ;
00060Fr 2               ; This is a skeleton. Each parse routine calls next_token and emits p-code
00060Fr 2               ; directly (no AST nodes). Phase 3 fleshes out the full grammar.
00060Fr 2               
00060Fr 2                       .segment        "CODE"
00060Fr 2               
00060Fr 2               ; ---------------------------------------------------------------------------
00060Fr 2               ; expect — verify current token is `expected_tok`, advance, error if not
00060Fr 2               ; expected_tok passed in X; error string pointer in tmp3 (lo) and A (hi)
00060Fr 2               ; ---------------------------------------------------------------------------
00060Fr 2               expect:
00060Fr 2  A5 rr                LDA     tok_type
000611r 2  E4 rr                CPX     tok_type
000613r 2  F0 18                BEQ     @ok
000615r 2               ; mismatch — report error using tmp3 as message pointer
000615r 2  A5 rr                LDA     tmp3
000617r 2  85 rr                STA     tmp0
000619r 2  A5 rr                LDA     tmp3+1
00061Br 2  85 rr                STA     tmp0+1
00061Dr 2  20 rr rr             JSR     compile_error
000620r 2               ; attempt recovery: skip tokens until we see the expected one or EOF
000620r 2               @recover:
000620r 2  A5 rr                LDA     tok_type
000622r 2  F0 09                BEQ     @ok             ; EOF — stop recovery
000624r 2  E4 rr                CPX     tok_type
000626r 2  F0 05                BEQ     @ok
000628r 2  20 rr rr             JSR     next_token
00062Br 2  80 F3                BRA     @recover
00062Dr 2               @ok:
00062Dr 2  20 rr rr             JSR     next_token
000630r 2  60                   RTS
000631r 2               
000631r 2               ; Helper macros — not ca65 .macros since they'd be complex; use inline calls.
000631r 2               
000631r 2               ; ---------------------------------------------------------------------------
000631r 2               ; compile_program — top-level: PROGRAM name ; block .
000631r 2               ; ---------------------------------------------------------------------------
000631r 2               compile_program:
000631r 2  20 rr rr             JSR     symtab_init
000634r 2               ; expect PROGRAM keyword
000634r 2  A5 rr                LDA     tok_type
000636r 2  C9 53                CMP     #TOK_PROGRAM
000638r 2  D0 0F                BNE     @no_hdr         ; allow missing PROGRAM header (lenient)
00063Ar 2  20 rr rr             JSR     next_token
00063Dr 2               ; program name (identifier)
00063Dr 2  20 rr rr             JSR     next_token
000640r 2               ; semicolon
000640r 2  A5 rr                LDA     tok_type
000642r 2  C9 20                CMP     #TOK_SEMICOLON
000644r 2  D0 03                BNE     :+
000646r 2  20 rr rr             JSR     next_token
000649r 2               :
000649r 2               @no_hdr:
000649r 2               ; Emit a forward UJP at code offset 0; parse_block patches it to point
000649r 2               ; to the main BEGIN block once all proc bodies have been emitted ahead
000649r 2               ; of it. The .PCD entry point stays at offset 0 (start of code = UJP).
000649r 2  20 rr rr             JSR     emit_UJP        ; A=patch_lo, scratch=patch_hi
00064Cr 2  8D rr rr             STA     main_jmp_patch
00064Fr 2  A5 rr                LDA     scratch
000651r 2  8D rr rr             STA     main_jmp_patch+1
000654r 2  20 rr rr             JSR     parse_block
000657r 2               ; Emit HALT at end of main program
000657r 2  20 rr rr             JSR     emit_HALT
00065Ar 2  60                   RTS
00065Br 2               
00065Br 2               ; ---------------------------------------------------------------------------
00065Br 2               ; parse_block — { const_part } { type_part } { var_part } { proc_part } statement_part
00065Br 2               ; ---------------------------------------------------------------------------
00065Br 2               parse_block:
00065Br 2               @again:
00065Br 2  A5 rr                LDA     tok_type
00065Dr 2  C9 44                CMP     #TOK_CONST
00065Fr 2  F0 15                BEQ     @const
000661r 2  C9 58                CMP     #TOK_TYPE
000663r 2  F0 19                BEQ     @type
000665r 2  C9 5A                CMP     #TOK_VAR
000667r 2  F0 1D                BEQ     @var
000669r 2  C9 52                CMP     #TOK_PROCEDURE
00066Br 2  F0 21                BEQ     @proc
00066Dr 2  C9 4B                CMP     #TOK_FUNCTION
00066Fr 2  F0 25                BEQ     @func
000671r 2  C9 42                CMP     #TOK_BEGIN
000673r 2  F0 29                BEQ     @body
000675r 2  60                   RTS                     ; nothing recognisable
000676r 2               
000676r 2               @const:
000676r 2  20 rr rr             JSR     next_token
000679r 2  20 rr rr             JSR     parse_const_decls
00067Cr 2  80 DD                BRA     @again
00067Er 2               @type:
00067Er 2  20 rr rr             JSR     next_token
000681r 2  20 rr rr             JSR     parse_type_decls
000684r 2  80 D5                BRA     @again
000686r 2               @var:
000686r 2  20 rr rr             JSR     next_token
000689r 2  20 rr rr             JSR     parse_var_decls
00068Cr 2  80 CD                BRA     @again
00068Er 2               @proc:
00068Er 2  20 rr rr             JSR     next_token
000691r 2  20 rr rr             JSR     parse_proc_decl
000694r 2  80 C5                BRA     @again
000696r 2               @func:
000696r 2  20 rr rr             JSR     next_token
000699r 2  20 rr rr             JSR     parse_func_decl
00069Cr 2  80 BD                BRA     @again
00069Er 2               @body:  ; If at global scope and the main UJP hasn't been patched yet, do so
00069Er 2                       ; before emitting any main-body code. main_jmp_patch+1 = $FF means
00069Er 2                       ; "already patched" (or no UJP emitted, e.g. early-error path).
00069Er 2  A5 rr                LDA     scope_depth
0006A0r 2  D0 19                BNE     @body_emit
0006A2r 2  AD rr rr             LDA     main_jmp_patch+1
0006A5r 2  C9 FF                CMP     #$FF
0006A7r 2  F0 12                BEQ     @body_emit
0006A9r 2  AD rr rr             LDA     main_jmp_patch
0006ACr 2  85 rr                STA     tmp2
0006AEr 2  AD rr rr             LDA     main_jmp_patch+1
0006B1r 2  85 rr                STA     tmp2+1
0006B3r 2  20 rr rr             JSR     patch_jump
0006B6r 2  A9 FF                LDA     #$FF
0006B8r 2  8D rr rr             STA     main_jmp_patch+1
0006BBr 2               @body_emit:
0006BBr 2  20 rr rr             JSR     parse_compound_stmt
0006BEr 2  60                   RTS
0006BFr 2               
0006BFr 2               ; ---------------------------------------------------------------------------
0006BFr 2               ; parse_const_decls — name = [-]INT_LIT ;  { name = [-]INT_LIT ; }
0006BFr 2               ; Each constant goes into the symbol table as SYM_CONST with the literal
0006BFr 2               ; value stored at offsets 18-19; references emit LDCW with that value.
0006BFr 2               ; ---------------------------------------------------------------------------
0006BFr 2               parse_const_decls:
0006BFr 2               @loop:
0006BFr 2  A5 rr                LDA     tok_type
0006C1r 2  C9 01                CMP     #TOK_IDENT
0006C3r 2  F0 01                BEQ     @have_ident
0006C5r 2  60                   RTS                     ; done — no more constants
0006C6r 2               @have_ident:
0006C6r 2               ; save const name into save_name_buf
0006C6r 2  A0 0F                LDY     #15
0006C8r 2               @savename:
0006C8r 2  B9 rr rr             LDA     ident_buf,y
0006CBr 2  99 rr rr             STA     save_name_buf,y
0006CEr 2  88                   DEY
0006CFr 2  10 F7                BPL     @savename
0006D1r 2  20 rr rr             JSR     next_token      ; consume name
0006D4r 2               ; expect '='
0006D4r 2  A5 rr                LDA     tok_type
0006D6r 2  C9 14                CMP     #TOK_EQ
0006D8r 2  D0 03                BNE     :+
0006DAr 2  20 rr rr             JSR     next_token
0006DDr 2               :       ; optional unary minus — record in scratch (next_token preserves it)
0006DDr 2  A9 00                LDA     #0
0006DFr 2  85 rr                STA     scratch
0006E1r 2  A5 rr                LDA     tok_type
0006E3r 2  C9 11                CMP     #TOK_MINUS
0006E5r 2  D0 07                BNE     @no_minus
0006E7r 2  A9 FF                LDA     #$FF
0006E9r 2  85 rr                STA     scratch
0006EBr 2  20 rr rr             JSR     next_token
0006EEr 2               @no_minus:
0006EEr 2                       ; expect INT literal
0006EEr 2  A5 rr                LDA     tok_type
0006F0r 2  C9 02                CMP     #TOK_INT
0006F2r 2  F0 08                BEQ     @have_int
0006F4r 2                       ; bad value — store 0 and try to recover
0006F4r 2  A9 00                LDA     #0
0006F6r 2  85 rr                STA     tmp2
0006F8r 2  85 rr                STA     tmp2+1
0006FAr 2  80 0B                BRA     @add_const
0006FCr 2               @have_int:
0006FCr 2  A5 rr                LDA     tok_ival_lo
0006FEr 2  85 rr                STA     tmp2
000700r 2  A5 rr                LDA     tok_ival_hi
000702r 2  85 rr                STA     tmp2+1
000704r 2  20 rr rr             JSR     next_token      ; consume INT
000707r 2               @add_const:
000707r 2               ; apply negate flag if set
000707r 2  A5 rr                LDA     scratch
000709r 2  F0 0D                BEQ     @no_neg
00070Br 2  38                   SEC
00070Cr 2  A9 00                LDA     #0
00070Er 2  E5 rr                SBC     tmp2
000710r 2  85 rr                STA     tmp2
000712r 2  A9 00                LDA     #0
000714r 2  E5 rr                SBC     tmp2+1
000716r 2  85 rr                STA     tmp2+1
000718r 2               @no_neg:
000718r 2               ; install in symbol table — value lives at offsets 18-19
000718r 2  20 rr rr             JSR     swap_ident_save
00071Br 2  A9 02                LDA     #SYM_CONST
00071Dr 2  A2 01                LDX     #TY_INT
00071Fr 2  20 rr rr             JSR     symtab_add
000722r 2  20 rr rr             JSR     swap_ident_save
000725r 2               ; expect ';'
000725r 2  A5 rr                LDA     tok_type
000727r 2  C9 20                CMP     #TOK_SEMICOLON
000729r 2  D0 94                BNE     @loop
00072Br 2  20 rr rr             JSR     next_token
00072Er 2  80 8F                BRA     @loop
000730r 2               
000730r 2               ; ---------------------------------------------------------------------------
000730r 2               ; parse_type_decls — name = type_spec ;  { ... }
000730r 2               ; Each binding registers a SYM_TYPE entry whose offset-17 byte holds the
000730r 2               ; base TY_* code.  parse_type_spec resolves later references back to this
000730r 2               ; base type via symtab_find.
000730r 2               ; ---------------------------------------------------------------------------
000730r 2               parse_type_decls:
000730r 2                       ; DEBUG: '<T>' on entry
000730r 2  A9 3C                LDA     #'<'
000732r 2  20 rr rr             JSR     dbg_putc
000735r 2  A9 54                LDA     #'T'
000737r 2  20 rr rr             JSR     dbg_putc
00073Ar 2  A9 3E                LDA     #'>'
00073Cr 2  20 rr rr             JSR     dbg_putc
00073Fr 2               @loop:
00073Fr 2  A5 rr                LDA     tok_type
000741r 2  C9 01                CMP     #TOK_IDENT
000743r 2  F0 01                BEQ     :+
000745r 2  60                   RTS                     ; done — no more type decls
000746r 2               :       ; save type name into save_name_buf (parse_type_spec clobbers ident_buf)
000746r 2  A0 0F                LDY     #15
000748r 2               @savename:
000748r 2  B9 rr rr             LDA     ident_buf,y
00074Br 2  99 rr rr             STA     save_name_buf,y
00074Er 2  88                   DEY
00074Fr 2  10 F7                BPL     @savename
000751r 2  20 rr rr             JSR     next_token      ; consume name
000754r 2               ; expect '='
000754r 2  A5 rr                LDA     tok_type
000756r 2  C9 14                CMP     #TOK_EQ
000758r 2  D0 03                BNE     :+
00075Ar 2  20 rr rr             JSR     next_token
00075Dr 2               :       ; parse the type definition; A = TY_* code
00075Dr 2  20 rr rr             JSR     parse_type_spec
000760r 2  85 rr                STA     scratch         ; save base type code
000762r 2               ; bring the saved name back into ident_buf for symtab_add
000762r 2  20 rr rr             JSR     swap_ident_save
000765r 2               ; SYM_TYPE has no storage; offset bytes are unused
000765r 2  A9 00                LDA     #0
000767r 2  85 rr                STA     tmp2
000769r 2  85 rr                STA     tmp2+1
00076Br 2  A9 05                LDA     #SYM_TYPE
00076Dr 2  A6 rr                LDX     scratch
00076Fr 2  20 rr rr             JSR     symtab_add
000772r 2                       ; DEBUG: 't' + first letter of name + count digit
000772r 2  A9 74                LDA     #'t'
000774r 2  20 rr rr             JSR     dbg_putc
000777r 2  AD rr rr             LDA     ident_buf+1
00077Ar 2  20 rr rr             JSR     dbg_putc
00077Dr 2  AD rr rr             LDA     symtab_count
000780r 2  18                   CLC
000781r 2  69 30                ADC     #'0'
000783r 2  20 rr rr             JSR     dbg_putc
000786r 2               ; expect ';'
000786r 2  A5 rr                LDA     tok_type
000788r 2  C9 20                CMP     #TOK_SEMICOLON
00078Ar 2  D0 B3                BNE     @loop
00078Cr 2  20 rr rr             JSR     next_token
00078Fr 2  80 AE                BRA     @loop
000791r 2               
000791r 2               ; ---------------------------------------------------------------------------
000791r 2               ; parse_var_decls — name { , name } : type ;  { ... }
000791r 2               ; All names on one line share the same type, allocated in order.
000791r 2               ; ---------------------------------------------------------------------------
000791r 2               parse_var_decls:
000791r 2               @decl_loop:
000791r 2  A5 rr                LDA     tok_type
000793r 2  C9 01                CMP     #TOK_IDENT
000795r 2  F0 01                BEQ     :+
000797r 2  60                   RTS                     ; done — no more var decls
000798r 2               :       ; --- collect comma-separated names into var_name_buf ---
000798r 2  A9 00                LDA     #0
00079Ar 2  8D rr rr             STA     var_name_count
00079Dr 2               @collect:
00079Dr 2  A5 rr                LDA     tok_type
00079Fr 2  C9 01                CMP     #TOK_IDENT
0007A1r 2  D0 31                BNE     @end_collect
0007A3r 2  AD rr rr             LDA     var_name_count
0007A6r 2  C9 08                CMP     #8
0007A8r 2  B0 1C                BCS     @skip_save
0007AAr 2                       ; tmp2 = var_name_buf + count*16   (count<8 → fits without manual carry)
0007AAr 2  0A                   ASL
0007ABr 2  0A                   ASL
0007ACr 2  0A                   ASL
0007ADr 2  0A                   ASL                     ; *16
0007AEr 2  18                   CLC
0007AFr 2  69 rr                ADC     #<var_name_buf
0007B1r 2  85 rr                STA     tmp2
0007B3r 2  A9 00                LDA     #0
0007B5r 2  69 rr                ADC     #>var_name_buf
0007B7r 2  85 rr                STA     tmp2+1
0007B9r 2  A0 0F                LDY     #15
0007BBr 2               @cp_in:
0007BBr 2  B9 rr rr             LDA     ident_buf,y
0007BEr 2  91 rr                STA     (tmp2),y
0007C0r 2  88                   DEY
0007C1r 2  10 F8                BPL     @cp_in
0007C3r 2  EE rr rr             INC     var_name_count
0007C6r 2               @skip_save:
0007C6r 2  20 rr rr             JSR     next_token      ; consume name
0007C9r 2  A5 rr                LDA     tok_type
0007CBr 2  C9 1F                CMP     #TOK_COMMA
0007CDr 2  D0 05                BNE     @end_collect
0007CFr 2  20 rr rr             JSR     next_token      ; consume ','
0007D2r 2  80 C9                BRA     @collect
0007D4r 2               @end_collect:
0007D4r 2               ; expect ':'
0007D4r 2  A5 rr                LDA     tok_type
0007D6r 2  C9 21                CMP     #TOK_COLON
0007D8r 2  D0 03                BNE     :+
0007DAr 2  20 rr rr             JSR     next_token
0007DDr 2               :       ; parse type — A = TY_*
0007DDr 2  20 rr rr             JSR     parse_type_spec
0007E0r 2  85 rr                STA     scratch         ; stash type (no next_token in the loop below)
0007E2r 2               ; expect ';'
0007E2r 2  A5 rr                LDA     tok_type
0007E4r 2  C9 20                CMP     #TOK_SEMICOLON
0007E6r 2  D0 03                BNE     :+
0007E8r 2  20 rr rr             JSR     next_token
0007EBr 2               :       ; --- add each collected name to symbol table ---
0007EBr 2  A2 00                LDX     #0
0007EDr 2               @add_loop:
0007EDr 2  EC rr rr             CPX     var_name_count
0007F0r 2  B0 9F                BCS     @decl_loop
0007F2r 2  DA                   PHX                     ; preserve loop counter across symtab_add
0007F3r 2               ; tmp2 = var_name_buf + X*16
0007F3r 2  8A                   TXA
0007F4r 2  0A                   ASL
0007F5r 2  0A                   ASL
0007F6r 2  0A                   ASL
0007F7r 2  0A                   ASL
0007F8r 2  18                   CLC
0007F9r 2  69 rr                ADC     #<var_name_buf
0007FBr 2  85 rr                STA     tmp2
0007FDr 2  A9 00                LDA     #0
0007FFr 2  69 rr                ADC     #>var_name_buf
000801r 2  85 rr                STA     tmp2+1
000803r 2               ; copy slot → ident_buf so symtab_add sees the right name
000803r 2  A0 0F                LDY     #15
000805r 2               @cp_out:
000805r 2  B1 rr                LDA     (tmp2),Y
000807r 2  99 rr rr             STA     ident_buf,y
00080Ar 2  88                   DEY
00080Br 2  10 F8                BPL     @cp_out
00080Dr 2               ; allocate storage — global if at top level, else from proc local AR
00080Dr 2  A5 rr                LDA     scope_depth
00080Fr 2  F0 14                BEQ     @gv_alloc
000811r 2               ; local: tmp2 = local_alloc_off (word, 0 hi); bump by 2
000811r 2  AD rr rr             LDA     local_alloc_off
000814r 2  85 rr                STA     tmp2
000816r 2  A9 00                LDA     #0
000818r 2  85 rr                STA     tmp2+1
00081Ar 2  18                   CLC
00081Br 2  AD rr rr             LDA     local_alloc_off
00081Er 2  69 02                ADC     #2
000820r 2  8D rr rr             STA     local_alloc_off
000823r 2  80 03                BRA     @do_va_add
000825r 2               @gv_alloc:
000825r 2  20 rr rr             JSR     codegen_alloc_global
000828r 2               @do_va_add:
000828r 2  A5 rr                LDA     scratch         ; type code
00082Ar 2  AA                   TAX
00082Br 2  A9 01                LDA     #SYM_VAR
00082Dr 2  20 rr rr             JSR     symtab_add
000830r 2                       ; DEBUG: 'v' + first letter of name + count digit
000830r 2  A9 76                LDA     #'v'
000832r 2  20 rr rr             JSR     dbg_putc
000835r 2  AD rr rr             LDA     ident_buf+1
000838r 2  20 rr rr             JSR     dbg_putc
00083Br 2  AD rr rr             LDA     symtab_count
00083Er 2  18                   CLC
00083Fr 2  69 30                ADC     #'0'
000841r 2  20 rr rr             JSR     dbg_putc
000844r 2  FA                   PLX
000845r 2  E8                   INX
000846r 2  4C rr rr             JMP     @add_loop       ; jmp — body grew past bra range
000849r 2               
000849r 2               ; swap 16 bytes between ident_buf and save_name_buf
000849r 2               swap_ident_save:
000849r 2  A0 0F                LDY     #15
00084Br 2               @sw:
00084Br 2  B9 rr rr             LDA     ident_buf,y
00084Er 2  BE rr rr             LDX     save_name_buf,y
000851r 2  99 rr rr             STA     save_name_buf,y
000854r 2  8A                   TXA
000855r 2  99 rr rr             STA     ident_buf,y
000858r 2  88                   DEY
000859r 2  10 F0                BPL     @sw
00085Br 2  60                   RTS
00085Cr 2               
00085Cr 2               ; ---------------------------------------------------------------------------
00085Cr 2               ; parse_type_spec — consume type token(s), return TY_* code in A
00085Cr 2               ; ---------------------------------------------------------------------------
00085Cr 2               parse_type_spec:
00085Cr 2  A5 rr                LDA     tok_type
00085Er 2  C9 01                CMP     #TOK_IDENT
000860r 2  D0 67                BNE     @not_ident
000862r 2               ; First check for a user-defined SYM_TYPE alias — built-ins like
000862r 2               ; INTEGER/CHAR/BOOLEAN aren't in the symtab so this lookup falls
000862r 2               ; through harmlessly when there's no user binding.
000862r 2  20 rr rr             JSR     symtab_find
000865r 2  90 14                BCC     @builtin
000867r 2  A0 10                LDY     #16
000869r 2  B1 rr                LDA     (tmp3),y
00086Br 2  C9 05                CMP     #SYM_TYPE
00086Dr 2  D0 0C                BNE     @builtin
00086Fr 2  A0 11                LDY     #17
000871r 2  B1 rr                LDA     (tmp3),y
000873r 2  85 rr                STA     scratch         ; preserve across next_token
000875r 2  20 rr rr             JSR     next_token
000878r 2  A5 rr                LDA     scratch
00087Ar 2  60                   RTS
00087Br 2               @builtin:
00087Br 2               ; check for built-in type names
00087Br 2  AD rr rr             LDA     ident_buf       ; length
00087Er 2  C9 07                CMP     #7
000880r 2  D0 20                BNE     @chk3
000882r 2               ; "INTEGER" (7 chars)
000882r 2  AD rr rr             LDA     ident_buf+1
000885r 2  C9 49                CMP     #'I'
000887r 2  D0 06                BNE     @chk_bool
000889r 2  20 rr rr             JSR     next_token
00088Cr 2  A9 01                LDA     #TY_INT
00088Er 2  60                   RTS
00088Fr 2               @chk_bool:
00088Fr 2  AD rr rr             LDA     ident_buf+1
000892r 2  C9 42                CMP     #'B'
000894r 2  D0 06                BNE     @chk_str
000896r 2  20 rr rr             JSR     next_token
000899r 2  A9 03                LDA     #TY_BOOL
00089Br 2  60                   RTS
00089Cr 2               @chk_str:
00089Cr 2  20 rr rr             JSR     next_token
00089Fr 2  A9 01                LDA     #TY_INT         ; default
0008A1r 2  60                   RTS
0008A2r 2               @chk3:
0008A2r 2  C9 04                CMP     #4
0008A4r 2  D0 13                BNE     @chk6
0008A6r 2               ; "CHAR" (4)
0008A6r 2  AD rr rr             LDA     ident_buf+1
0008A9r 2  C9 43                CMP     #'C'
0008ABr 2  D0 06                BNE     @chk3b
0008ADr 2  20 rr rr             JSR     next_token
0008B0r 2  A9 02                LDA     #TY_CHAR
0008B2r 2  60                   RTS
0008B3r 2               @chk3b:
0008B3r 2  20 rr rr             JSR     next_token
0008B6r 2  A9 01                LDA     #TY_INT
0008B8r 2  60                   RTS
0008B9r 2               @chk6:
0008B9r 2  C9 06                CMP     #6
0008BBr 2  D0 06                BNE     @default_type
0008BDr 2               ; "STRING" (6)
0008BDr 2  20 rr rr             JSR     next_token
0008C0r 2  A9 04                LDA     #TY_STRING
0008C2r 2  60                   RTS
0008C3r 2               @default_type:
0008C3r 2  20 rr rr             JSR     next_token
0008C6r 2  A9 01                LDA     #TY_INT
0008C8r 2  60                   RTS
0008C9r 2               @not_ident:
0008C9r 2               ; ARRAY or RECORD — skip for Phase 1
0008C9r 2  A5 rr                LDA     tok_type
0008CBr 2  C9 41                CMP     #TOK_ARRAY
0008CDr 2  D0 0C                BNE     :+
0008CFr 2  20 rr rr             JSR     next_token      ; 'OF'
0008D2r 2  20 rr rr             JSR     next_token      ; base type
0008D5r 2  20 rr rr             JSR     next_token
0008D8r 2  A9 05                LDA     #TY_ARRAY
0008DAr 2  60                   RTS
0008DBr 2               :
0008DBr 2  20 rr rr             JSR     next_token
0008DEr 2  A9 01                LDA     #TY_INT
0008E0r 2  60                   RTS
0008E1r 2               
0008E1r 2               ; ---------------------------------------------------------------------------
0008E1r 2               ; parse_arg_lvalue — used for VAR-by-reference call arguments.  Expects the
0008E1r 2               ; current token to be an IDENT naming a variable; consumes the ident and
0008E1r 2               ; emits an opcode that pushes the variable's address.
0008E1r 2               ;
0008E1r 2               ;   SYM_VAR    global → OP_LDA_G <wordoff>
0008E1r 2               ;   SYM_VAR    local  → OP_LDA_L <byteoff>
0008E1r 2               ;   SYM_VARREF (passing a VAR param through) → OP_LDL <byteoff>   (the
0008E1r 2               ;              local slot itself already holds the upstream address)
0008E1r 2               ;
0008E1r 2               ; Anything else (literal, function call, undefined name) is silently ignored
0008E1r 2               ; — the argument slot will hold whatever was last on the stack.  Pascal
0008E1r 2               ; semantics say it's a compile error, but we emit no diagnostic for now.
0008E1r 2               ; ---------------------------------------------------------------------------
0008E1r 2               parse_arg_lvalue:
0008E1r 2  A5 rr                LDA     tok_type
0008E3r 2  C9 01                CMP     #TOK_IDENT
0008E5r 2  F0 01                BEQ     :+
0008E7r 2  60                   RTS
0008E8r 2               :
0008E8r 2  20 rr rr             JSR     symtab_find
0008EBr 2  B0 01                BCS     :+
0008EDr 2  60                   RTS                     ; undefined — emit nothing
0008EEr 2               :       ; Snapshot kind, scope, offset before next_token clobbers tmp3.
0008EEr 2  A0 10                LDY     #16
0008F0r 2  B1 rr                LDA     (tmp3),y
0008F2r 2  48                   PHA                     ; kind
0008F3r 2  A0 14                LDY     #20
0008F5r 2  B1 rr                LDA     (tmp3),y
0008F7r 2  48                   PHA                     ; scope
0008F8r 2  A0 13                LDY     #19
0008FAr 2  B1 rr                LDA     (tmp3),y
0008FCr 2  48                   PHA                     ; off hi
0008FDr 2  A0 12                LDY     #18
0008FFr 2  B1 rr                LDA     (tmp3),y
000901r 2  48                   PHA                     ; off lo (top)
000902r 2  20 rr rr             JSR     next_token      ; consume ident
000905r 2  68                   PLA                     ; off lo
000906r 2  AA                   TAX
000907r 2  68                   PLA                     ; off hi
000908r 2  85 rr                STA     scratch
00090Ar 2  68                   PLA                     ; scope
00090Br 2  A8                   TAY
00090Cr 2  68                   PLA                     ; kind
00090Dr 2  C9 08                CMP     #SYM_VARREF
00090Fr 2  F0 0C                BEQ     @lv_passthrough
000911r 2  C0 00                CPY     #0
000913r 2  D0 04                BNE     @lv_local
000915r 2  8A                   TXA
000916r 2  4C rr rr             JMP     emit_LDA_G
000919r 2               @lv_local:
000919r 2  8A                   TXA
00091Ar 2  4C rr rr             JMP     emit_LDA_L
00091Dr 2               @lv_passthrough:
00091Dr 2  8A                   TXA
00091Er 2  4C rr rr             JMP     emit_LDL        ; slot already holds caller's address
000921r 2               
000921r 2               ; ---------------------------------------------------------------------------
000921r 2               ; parse_param_list — assumes '(' has already been consumed.  Parses zero or
000921r 2               ; more comma/semicolon-separated parameter groups, then ')'.  Each parameter
000921r 2               ; is added to symtab as SYM_VAR with offset = proc_param_count*2 and the
000921r 2               ; group's type code.  proc_param_count is incremented per param.
000921r 2               ;
000921r 2               ; Pascal supports two separator forms:
000921r 2               ;   ( A, B: INTEGER )            — names sharing one type, COMMA separated
000921r 2               ;   ( A: INTEGER; B: CHAR )      — different types, SEMICOLON between groups
000921r 2               ;   ( A, B: INTEGER; C: CHAR )   — both forms mixed
000921r 2               ;
000921r 2               ; Reuses var_name_buf (128 bytes / 8 names per group).  Safe because the
000921r 2               ; param list is fully parsed before parse_block runs (which is what calls
000921r 2               ; parse_var_decls).
000921r 2               ; ---------------------------------------------------------------------------
000921r 2               parse_param_list:
000921r 2  A9 00                LDA     #0
000923r 2  8D rr rr             STA     param_var_mask  ; reset bitmap (set by caller too — paranoia)
000926r 2               @group_loop:
000926r 2               ; A leading VAR keyword marks the entire group as by-reference.
000926r 2  A9 00                LDA     #0
000928r 2  8D rr rr             STA     group_is_var
00092Br 2  A5 rr                LDA     tok_type
00092Dr 2  C9 5A                CMP     #TOK_VAR
00092Fr 2  D0 08                BNE     @no_var_kw
000931r 2  A9 01                LDA     #1
000933r 2  8D rr rr             STA     group_is_var
000936r 2  20 rr rr             JSR     next_token      ; consume VAR
000939r 2               @no_var_kw:
000939r 2  A5 rr                LDA     tok_type
00093Br 2  C9 01                CMP     #TOK_IDENT
00093Dr 2  F0 03                BEQ     @have_ident     ; jmp trampoline — body is too big for bra
00093Fr 2  4C rr rr             JMP     @done_params
000942r 2               @have_ident:
000942r 2               ; --- collect comma-separated names of this group ---
000942r 2  A9 00                LDA     #0
000944r 2  8D rr rr             STA     var_name_count
000947r 2               @gcollect:
000947r 2  A5 rr                LDA     tok_type
000949r 2  C9 01                CMP     #TOK_IDENT
00094Br 2  D0 31                BNE     @gend
00094Dr 2  AD rr rr             LDA     var_name_count
000950r 2  C9 08                CMP     #8
000952r 2  B0 1C                BCS     @gskip          ; buffer full — silently drop name
000954r 2  0A                   ASL
000955r 2  0A                   ASL
000956r 2  0A                   ASL
000957r 2  0A                   ASL
000958r 2  18                   CLC
000959r 2  69 rr                ADC     #<var_name_buf
00095Br 2  85 rr                STA     tmp2
00095Dr 2  A9 00                LDA     #0
00095Fr 2  69 rr                ADC     #>var_name_buf
000961r 2  85 rr                STA     tmp2+1
000963r 2  A0 0F                LDY     #15
000965r 2               @gcp:
000965r 2  B9 rr rr             LDA     ident_buf,y
000968r 2  91 rr                STA     (tmp2),y
00096Ar 2  88                   DEY
00096Br 2  10 F8                BPL     @gcp
00096Dr 2  EE rr rr             INC     var_name_count
000970r 2               @gskip:
000970r 2  20 rr rr             JSR     next_token      ; consume name
000973r 2  A5 rr                LDA     tok_type
000975r 2  C9 1F                CMP     #TOK_COMMA
000977r 2  D0 05                BNE     @gend
000979r 2  20 rr rr             JSR     next_token      ; consume ','
00097Cr 2  80 C9                BRA     @gcollect
00097Er 2               @gend:
00097Er 2               ; expect ':'
00097Er 2  A5 rr                LDA     tok_type
000980r 2  C9 21                CMP     #TOK_COLON
000982r 2  D0 03                BNE     :+
000984r 2  20 rr rr             JSR     next_token
000987r 2               :
000987r 2  20 rr rr             JSR     parse_type_spec
00098Ar 2  85 rr                STA     scratch         ; stash type for this group
00098Cr 2               ; --- add each collected name as SYM_VAR ---
00098Cr 2  A2 00                LDX     #0
00098Er 2               @addloop:
00098Er 2  EC rr rr             CPX     var_name_count
000991r 2  B0 58                BCS     @groupdone
000993r 2  DA                   PHX
000994r 2               ; copy var_name_buf[X*16] → ident_buf
000994r 2  8A                   TXA
000995r 2  0A                   ASL
000996r 2  0A                   ASL
000997r 2  0A                   ASL
000998r 2  0A                   ASL
000999r 2  18                   CLC
00099Ar 2  69 rr                ADC     #<var_name_buf
00099Cr 2  85 rr                STA     tmp2
00099Er 2  A9 00                LDA     #0
0009A0r 2  69 rr                ADC     #>var_name_buf
0009A2r 2  85 rr                STA     tmp2+1
0009A4r 2  A0 0F                LDY     #15
0009A6r 2               @cpout:
0009A6r 2  B1 rr                LDA     (tmp2),y
0009A8r 2  99 rr rr             STA     ident_buf,y
0009ABr 2  88                   DEY
0009ACr 2  10 F8                BPL     @cpout
0009AEr 2               ; offset for this param = proc_param_count * 2
0009AEr 2  AD rr rr             LDA     proc_param_count
0009B1r 2  0A                   ASL
0009B2r 2  85 rr                STA     tmp2
0009B4r 2  A9 00                LDA     #0
0009B6r 2  85 rr                STA     tmp2+1
0009B8r 2               ; If this is a VAR group, set the matching bit in param_var_mask
0009B8r 2               ; and use SYM_VARREF instead of SYM_VAR.
0009B8r 2  AD rr rr             LDA     group_is_var
0009BBr 2  F0 1E                BEQ     @use_var_kind
0009BDr 2               ; set bit (1 << proc_param_count) in param_var_mask (max 8 params)
0009BDr 2  AC rr rr             LDY     proc_param_count
0009C0r 2  C0 08                CPY     #8
0009C2r 2  B0 10                BCS     @skip_mask      ; >8 params: silently drop bit
0009C4r 2  A9 01                LDA     #1
0009C6r 2               @shl:
0009C6r 2  C0 00                CPY     #0
0009C8r 2  F0 04                BEQ     @done_shl
0009CAr 2  0A                   ASL
0009CBr 2  88                   DEY
0009CCr 2  80 F8                BRA     @shl
0009CEr 2               @done_shl:
0009CEr 2  0D rr rr             ORA     param_var_mask
0009D1r 2  8D rr rr             STA     param_var_mask
0009D4r 2               @skip_mask:
0009D4r 2  A5 rr                LDA     scratch         ; type
0009D6r 2  AA                   TAX
0009D7r 2  A9 08                LDA     #SYM_VARREF
0009D9r 2  80 05                BRA     @do_add
0009DBr 2               @use_var_kind:
0009DBr 2  A5 rr                LDA     scratch         ; type
0009DDr 2  AA                   TAX
0009DEr 2  A9 01                LDA     #SYM_VAR
0009E0r 2               @do_add:
0009E0r 2  20 rr rr             JSR     symtab_add
0009E3r 2  EE rr rr             INC     proc_param_count
0009E6r 2  FA                   PLX
0009E7r 2  E8                   INX
0009E8r 2  4C rr rr             JMP     @addloop        ; bra would be out of range now
0009EBr 2               @groupdone:
0009EBr 2               ; SEMICOLON → another group; else fall through to ')'
0009EBr 2  A5 rr                LDA     tok_type
0009EDr 2  C9 20                CMP     #TOK_SEMICOLON
0009EFr 2  D0 06                BNE     @done_params
0009F1r 2  20 rr rr             JSR     next_token      ; consume ';'
0009F4r 2  4C rr rr             JMP     @group_loop
0009F7r 2               @done_params:
0009F7r 2  A5 rr                LDA     tok_type
0009F9r 2  C9 1C                CMP     #TOK_RPAREN
0009FBr 2  D0 03                BNE     :+
0009FDr 2  20 rr rr             JSR     next_token      ; consume ')'
000A00r 2               :
000A00r 2  60                   RTS
000A01r 2               
000A01r 2               ; ---------------------------------------------------------------------------
000A01r 2               ; parse_proc_decl — PROCEDURE name [ ( params ) ] ; <block> ;
000A01r 2               ; The PROCEDURE keyword has already been consumed by parse_block @proc.
000A01r 2               ;
000A01r 2               ; Phase B: value parameters supported.  Each parameter occupies 2 bytes in
000A01r 2               ; the AR at MP+AR_LOCALS+offset and is stored into the symbol table as
000A01r 2               ; SYM_VAR in the inner scope.  Param-count is recorded on the proc's symbol
000A01r 2               ; entry (offset 21) so callers know how many args to push.
000A01r 2               ; ---------------------------------------------------------------------------
000A01r 2               parse_proc_decl:
000A01r 2               ; expect identifier (proc name)
000A01r 2  A5 rr                LDA     tok_type
000A03r 2  C9 01                CMP     #TOK_IDENT
000A05r 2  F0 01                BEQ     @have_name
000A07r 2  60                   RTS
000A08r 2               @have_name:
000A08r 2               ; Save outer local_alloc_off on 6502 stack — nested procs would
000A08r 2               ; otherwise clobber the enclosing proc's allocator state.
000A08r 2  AD rr rr             LDA     local_alloc_off
000A0Br 2  48                   PHA
000A0Cr 2               
000A0Cr 2               ; save proc name into save_name_buf (ident_buf gets clobbered later)
000A0Cr 2  A0 0F                LDY     #15
000A0Er 2               @savename:
000A0Er 2  B9 rr rr             LDA     ident_buf,y
000A11r 2  99 rr rr             STA     save_name_buf,y
000A14r 2  88                   DEY
000A15r 2  10 F7                BPL     @savename
000A17r 2               
000A17r 2  20 rr rr             JSR     next_token      ; consume name
000A1Ar 2               
000A1Ar 2               ; Register proc in symbol table NOW so we have an entry to update
000A1Ar 2               ; with the param count once the param list has been parsed.
000A1Ar 2               ; Offset (proc entry point) = current cg_pc.
000A1Ar 2               ; Remember the symbol-table index for backpatch.
000A1Ar 2  AD rr rr             LDA     symtab_count
000A1Dr 2  8D rr rr             STA     proc_entry_idx
000A20r 2  AD rr rr             LDA     symtab_count+1
000A23r 2  8D rr rr             STA     proc_entry_idx+1
000A26r 2  20 rr rr             JSR     swap_ident_save ; ident_buf <-> save_name_buf
000A29r 2  A5 rr                LDA     cg_pc
000A2Br 2  85 rr                STA     tmp2
000A2Dr 2  A5 rr                LDA     cg_pc+1
000A2Fr 2  85 rr                STA     tmp2+1
000A31r 2  A9 03                LDA     #SYM_PROC
000A33r 2  A2 00                LDX     #TY_NONE
000A35r 2  20 rr rr             JSR     symtab_add
000A38r 2  20 rr rr             JSR     swap_ident_save
000A3Br 2               
000A3Br 2               ; Enter scope: params and any locals belong to the proc's frame.
000A3Br 2  20 rr rr             JSR     symtab_enter_scope
000A3Er 2               
000A3Er 2               ; init param count and VAR-mask
000A3Er 2  A9 00                LDA     #0
000A40r 2  8D rr rr             STA     proc_param_count
000A43r 2  8D rr rr             STA     param_var_mask
000A46r 2               
000A46r 2               ; Optional parameter list
000A46r 2  A5 rr                LDA     tok_type
000A48r 2  C9 1B                CMP     #TOK_LPAREN
000A4Ar 2  D0 06                BNE     @backpatch_pcount
000A4Cr 2  20 rr rr             JSR     next_token      ; consume '('
000A4Fr 2  20 rr rr             JSR     parse_param_list
000A52r 2               
000A52r 2               @backpatch_pcount:
000A52r 2               ; Write param count into proc's symbol entry (offset 21).
000A52r 2               ; entry addr = SYMTAB_BASE + proc_entry_idx * 32
000A52r 2  AD rr rr             LDA     proc_entry_idx
000A55r 2  0A                   ASL
000A56r 2  0A                   ASL
000A57r 2  0A                   ASL
000A58r 2  0A                   ASL
000A59r 2  0A                   ASL                     ; *32 (low byte)
000A5Ar 2  18                   CLC
000A5Br 2  69 00                ADC     #<SYMTAB_BASE
000A5Dr 2  85 rr                STA     tmp3
000A5Fr 2  AD rr rr             LDA     proc_entry_idx+1
000A62r 2  2A                   ROL
000A63r 2  69 80                ADC     #>SYMTAB_BASE
000A65r 2  85 rr                STA     tmp3+1
000A67r 2  A0 15                LDY     #21
000A69r 2  AD rr rr             LDA     proc_param_count
000A6Cr 2  91 rr                STA     (tmp3),y
000A6Er 2  A0 16                LDY     #22
000A70r 2  AD rr rr             LDA     param_var_mask
000A73r 2  91 rr                STA     (tmp3),y
000A75r 2               
000A75r 2               ; Initialize local_alloc_off to start right after the params.
000A75r 2               ; VAR declarations inside the body extend this; final value is
000A75r 2               ; backpatched into entry offset 23 below as the MRKSTK size.
000A75r 2  AD rr rr             LDA     proc_param_count
000A78r 2  0A                   ASL
000A79r 2  8D rr rr             STA     local_alloc_off
000A7Cr 2               
000A7Cr 2               ; expect ';'
000A7Cr 2  A5 rr                LDA     tok_type
000A7Er 2  C9 20                CMP     #TOK_SEMICOLON
000A80r 2  D0 03                BNE     :+
000A82r 2  20 rr rr             JSR     next_token
000A85r 2               :
000A85r 2               ; No callee prologue: the caller emits MRKSTK + arg-stores + CALL,
000A85r 2               ; so by the time we land at the proc entry the activation record
000A85r 2               ; (and its param slots) already exists.
000A85r 2               
000A85r 2               ; Recurse: proc body may have its own const/type/var/proc/begin block.
000A85r 2  20 rr rr             JSR     parse_block
000A88r 2               
000A88r 2               ; Epilogue
000A88r 2  20 rr rr             JSR     emit_RET
000A8Br 2               
000A8Br 2               ; Backpatch total local-area size (params + declared locals) into
000A8Br 2               ; the proc's symbol entry at offset 23.  The caller reads this and
000A8Br 2               ; emits MRKSTK <lsize> so the AR is large enough to hold all locals
000A8Br 2               ; below pm_sp (otherwise value-stack pushes corrupt local slots).
000A8Br 2  AD rr rr             LDA     proc_entry_idx
000A8Er 2  0A                   ASL
000A8Fr 2  0A                   ASL
000A90r 2  0A                   ASL
000A91r 2  0A                   ASL
000A92r 2  0A                   ASL
000A93r 2  18                   CLC
000A94r 2  69 00                ADC     #<SYMTAB_BASE
000A96r 2  85 rr                STA     tmp3
000A98r 2  AD rr rr             LDA     proc_entry_idx+1
000A9Br 2  2A                   ROL
000A9Cr 2  69 80                ADC     #>SYMTAB_BASE
000A9Er 2  85 rr                STA     tmp3+1
000AA0r 2  A0 17                LDY     #23
000AA2r 2  AD rr rr             LDA     local_alloc_off
000AA5r 2  91 rr                STA     (tmp3),y
000AA7r 2               
000AA7r 2  20 rr rr             JSR     symtab_leave_scope
000AAAr 2               
000AAAr 2               ; Consume trailing ';' after END
000AAAr 2  A5 rr                LDA     tok_type
000AACr 2  C9 20                CMP     #TOK_SEMICOLON
000AAEr 2  D0 03                BNE     :+
000AB0r 2  20 rr rr             JSR     next_token
000AB3r 2               :
000AB3r 2  68                   PLA
000AB4r 2  8D rr rr             STA     local_alloc_off ; restore outer allocator state
000AB7r 2  60                   RTS
000AB8r 2               
000AB8r 2               ; ---------------------------------------------------------------------------
000AB8r 2               ; parse_func_decl — FUNCTION name [ ( params ) ] : RETURN_TYPE ; <block> ;
000AB8r 2               ; The FUNCTION keyword has already been consumed by parse_block @func.
000AB8r 2               ; Mirrors parse_proc_decl but registers SYM_FUNC, parses the return type,
000AB8r 2               ; adds a SYM_RETVAL inner-scope binding (so `name := expr` in the body
000AB8r 2               ; emits OP_STR), and emits OP_RETF as the epilogue.
000AB8r 2               ; ---------------------------------------------------------------------------
000AB8r 2               parse_func_decl:
000AB8r 2               ; expect identifier (func name)
000AB8r 2  A5 rr                LDA     tok_type
000ABAr 2  C9 01                CMP     #TOK_IDENT
000ABCr 2  F0 01                BEQ     @have_name
000ABEr 2  60                   RTS
000ABFr 2               @have_name:
000ABFr 2               ; Save outer local_alloc_off on 6502 stack — nested func/proc would
000ABFr 2               ; otherwise clobber the enclosing frame's allocator state.
000ABFr 2  AD rr rr             LDA     local_alloc_off
000AC2r 2  48                   PHA
000AC3r 2               
000AC3r 2               ; save func name into save_name_buf
000AC3r 2  A0 0F                LDY     #15
000AC5r 2               @savename:
000AC5r 2  B9 rr rr             LDA     ident_buf,y
000AC8r 2  99 rr rr             STA     save_name_buf,y
000ACBr 2  88                   DEY
000ACCr 2  10 F7                BPL     @savename
000ACEr 2               
000ACEr 2  20 rr rr             JSR     next_token      ; consume name
000AD1r 2               
000AD1r 2               ; Register SYM_FUNC NOW so we have an entry to backpatch.
000AD1r 2               ; Type backpatched after we parse `: RETURN_TYPE`.
000AD1r 2  AD rr rr             LDA     symtab_count
000AD4r 2  8D rr rr             STA     proc_entry_idx
000AD7r 2  AD rr rr             LDA     symtab_count+1
000ADAr 2  8D rr rr             STA     proc_entry_idx+1
000ADDr 2  20 rr rr             JSR     swap_ident_save ; ident_buf <-> save_name_buf
000AE0r 2  A5 rr                LDA     cg_pc
000AE2r 2  85 rr                STA     tmp2
000AE4r 2  A5 rr                LDA     cg_pc+1
000AE6r 2  85 rr                STA     tmp2+1
000AE8r 2  A9 04                LDA     #SYM_FUNC
000AEAr 2  A2 00                LDX     #TY_NONE        ; placeholder
000AECr 2  20 rr rr             JSR     symtab_add
000AEFr 2  20 rr rr             JSR     swap_ident_save
000AF2r 2               
000AF2r 2               ; Enter scope: params, locals, and SYM_RETVAL belong to fn frame.
000AF2r 2  20 rr rr             JSR     symtab_enter_scope
000AF5r 2               
000AF5r 2               ; init param count and VAR-mask
000AF5r 2  A9 00                LDA     #0
000AF7r 2  8D rr rr             STA     proc_param_count
000AFAr 2  8D rr rr             STA     param_var_mask
000AFDr 2               
000AFDr 2               ; Optional parameter list
000AFDr 2  A5 rr                LDA     tok_type
000AFFr 2  C9 1B                CMP     #TOK_LPAREN
000B01r 2  D0 06                BNE     @after_params
000B03r 2  20 rr rr             JSR     next_token      ; consume '('
000B06r 2  20 rr rr             JSR     parse_param_list
000B09r 2               
000B09r 2               @after_params:
000B09r 2               ; Expect ':' then return type
000B09r 2  A5 rr                LDA     tok_type
000B0Br 2  C9 21                CMP     #TOK_COLON
000B0Dr 2  D0 03                BNE     :+
000B0Fr 2  20 rr rr             JSR     next_token
000B12r 2               :
000B12r 2  20 rr rr             JSR     parse_type_spec
000B15r 2  85 rr                STA     scratch         ; save return type code
000B17r 2               
000B17r 2               ; Recompute SYM_FUNC entry pointer from proc_entry_idx and backpatch
000B17r 2               ; offset 17 (return type) and offset 21 (param count).
000B17r 2  AD rr rr             LDA     proc_entry_idx
000B1Ar 2  0A                   ASL
000B1Br 2  0A                   ASL
000B1Cr 2  0A                   ASL
000B1Dr 2  0A                   ASL
000B1Er 2  0A                   ASL
000B1Fr 2  18                   CLC
000B20r 2  69 00                ADC     #<SYMTAB_BASE
000B22r 2  85 rr                STA     tmp3
000B24r 2  AD rr rr             LDA     proc_entry_idx+1
000B27r 2  2A                   ROL
000B28r 2  69 80                ADC     #>SYMTAB_BASE
000B2Ar 2  85 rr                STA     tmp3+1
000B2Cr 2  A0 11                LDY     #17
000B2Er 2  A5 rr                LDA     scratch
000B30r 2  91 rr                STA     (tmp3),y
000B32r 2  A0 15                LDY     #21
000B34r 2  AD rr rr             LDA     proc_param_count
000B37r 2  91 rr                STA     (tmp3),y
000B39r 2  A0 16                LDY     #22
000B3Br 2  AD rr rr             LDA     param_var_mask
000B3Er 2  91 rr                STA     (tmp3),y
000B40r 2               
000B40r 2               ; Initialize local_alloc_off to start right after the params.
000B40r 2               ; VAR declarations in the body extend this; final value is
000B40r 2               ; backpatched into entry offset 23 as the MRKSTK size.
000B40r 2  AD rr rr             LDA     proc_param_count
000B43r 2  0A                   ASL
000B44r 2  8D rr rr             STA     local_alloc_off
000B47r 2               
000B47r 2               ; Add SYM_RETVAL binding: same name as function; assignments to
000B47r 2               ; this name in the body emit OP_STR (writes MP+AR_RET_VAL).
000B47r 2               ; save_name_buf still holds the function name (parse_param_list uses
000B47r 2               ; var_name_buf, not save_name_buf).  Swap it into ident_buf.
000B47r 2  20 rr rr             JSR     swap_ident_save
000B4Ar 2  A9 00                LDA     #0
000B4Cr 2  85 rr                STA     tmp2
000B4Er 2  85 rr                STA     tmp2+1
000B50r 2  A9 07                LDA     #SYM_RETVAL
000B52r 2  A2 00                LDX     #TY_NONE
000B54r 2  20 rr rr             JSR     symtab_add
000B57r 2               
000B57r 2               ; Expect ';' before body
000B57r 2  A5 rr                LDA     tok_type
000B59r 2  C9 20                CMP     #TOK_SEMICOLON
000B5Br 2  D0 03                BNE     :+
000B5Dr 2  20 rr rr             JSR     next_token
000B60r 2               :
000B60r 2  20 rr rr             JSR     parse_block
000B63r 2               
000B63r 2  20 rr rr             JSR     emit_RETF
000B66r 2               
000B66r 2               ; Backpatch total local-area size into the func's symbol entry at
000B66r 2               ; offset 23 (params + declared body locals).  Caller emits MRKSTK
000B66r 2               ; with this value so the AR holds all locals below pm_sp.
000B66r 2  AD rr rr             LDA     proc_entry_idx
000B69r 2  0A                   ASL
000B6Ar 2  0A                   ASL
000B6Br 2  0A                   ASL
000B6Cr 2  0A                   ASL
000B6Dr 2  0A                   ASL
000B6Er 2  18                   CLC
000B6Fr 2  69 00                ADC     #<SYMTAB_BASE
000B71r 2  85 rr                STA     tmp3
000B73r 2  AD rr rr             LDA     proc_entry_idx+1
000B76r 2  2A                   ROL
000B77r 2  69 80                ADC     #>SYMTAB_BASE
000B79r 2  85 rr                STA     tmp3+1
000B7Br 2  A0 17                LDY     #23
000B7Dr 2  AD rr rr             LDA     local_alloc_off
000B80r 2  91 rr                STA     (tmp3),y
000B82r 2               
000B82r 2  20 rr rr             JSR     symtab_leave_scope
000B85r 2               
000B85r 2               ; Consume trailing ';' after END
000B85r 2  A5 rr                LDA     tok_type
000B87r 2  C9 20                CMP     #TOK_SEMICOLON
000B89r 2  D0 03                BNE     :+
000B8Br 2  20 rr rr             JSR     next_token
000B8Er 2               :
000B8Er 2  68                   PLA
000B8Fr 2  8D rr rr             STA     local_alloc_off ; restore outer allocator state
000B92r 2  60                   RTS
000B93r 2               
000B93r 2               ; ---------------------------------------------------------------------------
000B93r 2               ; parse_compound_stmt — BEGIN { statement ; } END
000B93r 2               ; ---------------------------------------------------------------------------
000B93r 2               parse_compound_stmt:
000B93r 2               ; consume BEGIN
000B93r 2  A5 rr                LDA     tok_type
000B95r 2  C9 42                CMP     #TOK_BEGIN
000B97r 2  D0 31                BNE     @done
000B99r 2  20 rr rr             JSR     next_token
000B9Cr 2               @loop:
000B9Cr 2  A5 rr                LDA     tok_type
000B9Er 2  C9 49                CMP     #TOK_END
000BA0r 2  F0 25                BEQ     @end
000BA2r 2  C9 00                CMP     #TOK_EOF
000BA4r 2  F0 24                BEQ     @done
000BA6r 2               ; remember tok before parse_statement to detect no-progress
000BA6r 2  85 rr                STA     tmp3
000BA8r 2  20 rr rr             JSR     parse_statement
000BABr 2  A5 rr                LDA     tok_type
000BADr 2  C9 20                CMP     #TOK_SEMICOLON
000BAFr 2  F0 11                BEQ     @consume_semi
000BB1r 2  C9 49                CMP     #TOK_END
000BB3r 2  F0 12                BEQ     @end
000BB5r 2  C9 00                CMP     #TOK_EOF
000BB7r 2  F0 11                BEQ     @done
000BB9r 2               ; if parse_statement didn't consume anything, force-advance to avoid
000BB9r 2               ; an infinite loop on an unrecognised token
000BB9r 2  C5 rr                CMP     tmp3
000BBBr 2  D0 DF                BNE     @loop
000BBDr 2  20 rr rr             JSR     next_token
000BC0r 2  80 DA                BRA     @loop
000BC2r 2               @consume_semi:
000BC2r 2  20 rr rr             JSR     next_token
000BC5r 2  80 D5                BRA     @loop
000BC7r 2               @end:
000BC7r 2  20 rr rr             JSR     next_token      ; consume END
000BCAr 2               @done:
000BCAr 2  60                   RTS
000BCBr 2               
000BCBr 2               ; ---------------------------------------------------------------------------
000BCBr 2               ; parse_statement — dispatch based on current token
000BCBr 2               ; ---------------------------------------------------------------------------
000BCBr 2               parse_statement:
000BCBr 2  A5 rr                LDA     tok_type
000BCDr 2  C9 42                CMP     #TOK_BEGIN
000BCFr 2  F0 15                BEQ     @compound
000BD1r 2  C9 4C                CMP     #TOK_IF
000BD3r 2  F0 18                BEQ     @if
000BD5r 2  C9 5B                CMP     #TOK_WHILE
000BD7r 2  F0 18                BEQ     @while
000BD9r 2  C9 4A                CMP     #TOK_FOR
000BDBr 2  F0 18                BEQ     @for
000BDDr 2  C9 55                CMP     #TOK_REPEAT
000BDFr 2  F0 18                BEQ     @repeat
000BE1r 2  C9 01                CMP     #TOK_IDENT
000BE3r 2  F0 04                BEQ     @assign_or_call
000BE5r 2  60                   RTS                     ; empty statement
000BE6r 2               
000BE6r 2               @compound:
000BE6r 2  4C rr rr             JMP     parse_compound_stmt
000BE9r 2               
000BE9r 2               @assign_or_call:
000BE9r 2  20 rr rr             JSR     parse_assign_or_call
000BECr 2  60                   RTS
000BEDr 2               
000BEDr 2               @if:
000BEDr 2  20 rr rr             JSR     parse_if
000BF0r 2  60                   RTS
000BF1r 2               
000BF1r 2               @while:
000BF1r 2  20 rr rr             JSR     parse_while
000BF4r 2  60                   RTS
000BF5r 2               
000BF5r 2               @for:
000BF5r 2  20 rr rr             JSR     parse_for
000BF8r 2  60                   RTS
000BF9r 2               
000BF9r 2               @repeat:
000BF9r 2  20 rr rr             JSR     parse_repeat
000BFCr 2  60                   RTS
000BFDr 2               
000BFDr 2               ; ---------------------------------------------------------------------------
000BFDr 2               ; parse_assign_or_call — identifier already consumed by caller (in ident_buf)
000BFDr 2               ; If next is ':=' → assignment
000BFDr 2               ; If next is '(' → procedure call
000BFDr 2               ; If identifier is WRITE/WRITELN → built-in I/O
000BFDr 2               ; ---------------------------------------------------------------------------
000BFDr 2               parse_assign_or_call:
000BFDr 2               ; check for built-in I/O names (WRITE/WRITELN/READ/READLN) by
000BFDr 2               ; length + first letter.  RECORD/REPEAT are reserved keywords so
000BFDr 2               ; they never reach this dispatch as identifiers.
000BFDr 2  AD rr rr             LDA     ident_buf       ; length
000C00r 2  C9 04                CMP     #4
000C02r 2  F0 33                BEQ     @chk_read
000C04r 2  C9 05                CMP     #5
000C06r 2  F0 0A                BEQ     @chk_write
000C08r 2  C9 06                CMP     #6
000C0Ar 2  F0 39                BEQ     @chk_readln
000C0Cr 2  C9 07                CMP     #7
000C0Er 2  F0 10                BEQ     @chk_writeln
000C10r 2  80 47                BRA     @lookup_sym
000C12r 2               
000C12r 2               @chk_write:
000C12r 2               ; "WRITE" (5)
000C12r 2  AD rr rr             LDA     ident_buf+1
000C15r 2  C9 57                CMP     #'W'
000C17r 2  D0 40                BNE     @lookup_sym
000C19r 2  20 rr rr             JSR     next_token
000C1Cr 2  20 rr rr             JSR     parse_write_args
000C1Fr 2  60                   RTS
000C20r 2               @chk_writeln:
000C20r 2               ; "WRITELN" (7)
000C20r 2  AD rr rr             LDA     ident_buf+1
000C23r 2  C9 57                CMP     #'W'
000C25r 2  D0 32                BNE     @lookup_sym
000C27r 2  20 rr rr             JSR     next_token
000C2Ar 2  A5 rr                LDA     tok_type
000C2Cr 2  C9 1B                CMP     #TOK_LPAREN
000C2Er 2  D0 03                BNE     @just_nl
000C30r 2  20 rr rr             JSR     parse_write_args
000C33r 2               @just_nl:
000C33r 2  20 rr rr             JSR     emit_WRITLN
000C36r 2  60                   RTS
000C37r 2               @chk_read:
000C37r 2               ; "READ" (4)
000C37r 2  AD rr rr             LDA     ident_buf+1
000C3Ar 2  C9 52                CMP     #'R'
000C3Cr 2  D0 1B                BNE     @lookup_sym
000C3Er 2  20 rr rr             JSR     next_token
000C41r 2  20 rr rr             JSR     parse_read_args
000C44r 2  60                   RTS
000C45r 2               @chk_readln:
000C45r 2               ; "READLN" (6).  With args: read each var.  Without args: no-op
000C45r 2               ; (TODO: read+discard a line so the program pauses for input).
000C45r 2  AD rr rr             LDA     ident_buf+1
000C48r 2  C9 52                CMP     #'R'
000C4Ar 2  D0 0D                BNE     @lookup_sym
000C4Cr 2  20 rr rr             JSR     next_token
000C4Fr 2  A5 rr                LDA     tok_type
000C51r 2  C9 1B                CMP     #TOK_LPAREN
000C53r 2  D0 03                BNE     @rd_done
000C55r 2  20 rr rr             JSR     parse_read_args
000C58r 2               @rd_done:
000C58r 2  60                   RTS
000C59r 2               
000C59r 2               @lookup_sym:
000C59r 2               ; DEBUG: print '#' + len(ident_buf) as digit + ident_buf+1 + '#'
000C59r 2               ; + '@' + symtab_count low + '@' BEFORE lookup
000C59r 2  A9 23                LDA     #'#'
000C5Br 2  20 rr rr             JSR     dbg_putc
000C5Er 2  AD rr rr             LDA     ident_buf
000C61r 2  18                   CLC
000C62r 2  69 30                ADC     #'0'
000C64r 2  20 rr rr             JSR     dbg_putc
000C67r 2  AD rr rr             LDA     ident_buf+1
000C6Ar 2  20 rr rr             JSR     dbg_putc
000C6Dr 2  A9 23                LDA     #'#'
000C6Fr 2  20 rr rr             JSR     dbg_putc
000C72r 2  A9 40                LDA     #'@'
000C74r 2  20 rr rr             JSR     dbg_putc
000C77r 2  AD rr rr             LDA     symtab_count
000C7Ar 2  18                   CLC
000C7Br 2  69 30                ADC     #'0'
000C7Dr 2  20 rr rr             JSR     dbg_putc
000C80r 2  A9 40                LDA     #'@'
000C82r 2  20 rr rr             JSR     dbg_putc
000C85r 2               ; look up identifier in symbol table
000C85r 2  20 rr rr             JSR     symtab_find
000C88r 2  B0 1F                BCS     @found_sym
000C8Ar 2               ; undefined — error
000C8Ar 2  A9 rr                LDA     #<err_undef
000C8Cr 2  85 rr                STA     tmp0
000C8Er 2  A9 rr                LDA     #>err_undef
000C90r 2  85 rr                STA     tmp0+1
000C92r 2  20 rr rr             JSR     compile_error
000C95r 2                       ; DEBUG: print '[' + first letter of undef ident + ']'
000C95r 2  A9 5B                LDA     #'['
000C97r 2  20 rr rr             JSR     dbg_putc
000C9Ar 2  AD rr rr             LDA     ident_buf+1
000C9Dr 2  20 rr rr             JSR     dbg_putc
000CA0r 2  A9 5D                LDA     #']'
000CA2r 2  20 rr rr             JSR     dbg_putc
000CA5r 2               ; skip to semicolon / end
000CA5r 2  20 rr rr             JSR     next_token
000CA8r 2  60                   RTS
000CA9r 2               
000CA9r 2               @found_sym:
000CA9r 2               ; tmp3 = symbol entry pointer. Snapshot the fields we need
000CA9r 2               ; before any next_token / parse_expression call clobbers tmp3.
000CA9r 2  A0 10                LDY     #16
000CABr 2  B1 rr                LDA     (tmp3),y
000CADr 2  8D rr rr             STA     sym_save_kind
000CB0r 2  A0 14                LDY     #20
000CB2r 2  B1 rr                LDA     (tmp3),y
000CB4r 2  8D rr rr             STA     sym_save_scope
000CB7r 2  A0 12                LDY     #18
000CB9r 2  B1 rr                LDA     (tmp3),y
000CBBr 2  8D rr rr             STA     sym_save_off
000CBEr 2  A0 13                LDY     #19
000CC0r 2  B1 rr                LDA     (tmp3),y
000CC2r 2  8D rr rr             STA     sym_save_off+1
000CC5r 2  A0 15                LDY     #21
000CC7r 2  B1 rr                LDA     (tmp3),y
000CC9r 2  8D rr rr             STA     sym_save_pcount
000CCCr 2  A0 16                LDY     #22
000CCEr 2  B1 rr                LDA     (tmp3),y
000CD0r 2  8D rr rr             STA     sym_save_vmask
000CD3r 2  A0 17                LDY     #23
000CD5r 2  B1 rr                LDA     (tmp3),y
000CD7r 2  8D rr rr             STA     sym_save_lsize
000CDAr 2  AD rr rr             LDA     sym_save_kind
000CDDr 2  C9 01                CMP     #SYM_VAR
000CDFr 2  F0 39                BEQ     @do_assign
000CE1r 2  C9 03                CMP     #SYM_PROC
000CE3r 2  F0 5C                BEQ     @do_call
000CE5r 2  C9 07                CMP     #SYM_RETVAL
000CE7r 2  F0 05                BEQ     @do_retval_assign
000CE9r 2  C9 08                CMP     #SYM_VARREF
000CEBr 2  F0 14                BEQ     @do_varref_assign
000CEDr 2  60                   RTS
000CEEr 2               
000CEEr 2               @do_retval_assign:
000CEEr 2               ; `funcname := expr` inside function body — emit OP_STR which writes
000CEEr 2               ; the popped value to the current AR's AR_RET_VAL slot.
000CEEr 2  20 rr rr             JSR     next_token      ; consume function name
000CF1r 2  A5 rr                LDA     tok_type
000CF3r 2  C9 1A                CMP     #TOK_ASSIGN
000CF5r 2  D0 03                BNE     :+
000CF7r 2  20 rr rr             JSR     next_token      ; consume ':='
000CFAr 2               :
000CFAr 2  20 rr rr             JSR     parse_expression
000CFDr 2  20 rr rr             JSR     emit_STR
000D00r 2  60                   RTS
000D01r 2               
000D01r 2               @do_varref_assign:
000D01r 2               ; VAR-by-reference param assignment: `paramname := expr` where the
000D01r 2               ; param's local slot holds an address.  Emit:
000D01r 2               ;   LDL <off>          ; push address (the value passed by caller)
000D01r 2               ;   <expr>             ; push value
000D01r 2               ;   STIND              ; pop val, pop addr, store
000D01r 2  20 rr rr             JSR     next_token      ; consume param name
000D04r 2  A5 rr                LDA     tok_type
000D06r 2  C9 1A                CMP     #TOK_ASSIGN
000D08r 2  D0 03                BNE     :+
000D0Ar 2  20 rr rr             JSR     next_token      ; consume ':='
000D0Dr 2               :
000D0Dr 2  AD rr rr             LDA     sym_save_off
000D10r 2  20 rr rr             JSR     emit_LDL        ; push address from local slot
000D13r 2  20 rr rr             JSR     parse_expression
000D16r 2  20 rr rr             JSR     emit_STIND
000D19r 2  60                   RTS
000D1Ar 2               
000D1Ar 2               @do_assign:
000D1Ar 2               ; expect ':='
000D1Ar 2  20 rr rr             JSR     next_token
000D1Dr 2  A5 rr                LDA     tok_type
000D1Fr 2  C9 1A                CMP     #TOK_ASSIGN
000D21r 2  D0 03                BNE     :+
000D23r 2  20 rr rr             JSR     next_token
000D26r 2               :       ; parse expression
000D26r 2  20 rr rr             JSR     parse_expression
000D29r 2                       ; emit STG or STL based on saved scope
000D29r 2  AD rr rr             LDA     sym_save_scope
000D2Cr 2  D0 0C                BNE     @local_store
000D2Er 2                       ; global store
000D2Er 2  AD rr rr             LDA     sym_save_off+1
000D31r 2  85 rr                STA     scratch
000D33r 2  AD rr rr             LDA     sym_save_off
000D36r 2  20 rr rr             JSR     emit_STG
000D39r 2  60                   RTS
000D3Ar 2               @local_store:
000D3Ar 2  AD rr rr             LDA     sym_save_off
000D3Dr 2  20 rr rr             JSR     emit_STL
000D40r 2  60                   RTS
000D41r 2               
000D41r 2               @do_call:
000D41r 2               ; Phase B: value parameters (INTEGER words, 2 bytes each).
000D41r 2               ; sym_save_off       = proc's code address
000D41r 2               ; sym_save_pcount    = declared parameter count
000D41r 2               ;
000D41r 2               ; Calling sequence emitted:
000D41r 2               ;   MRKSTK <pcount*2>            ; reserves AR + param slots
000D41r 2               ;   for each arg i:
000D41r 2               ;       <expr>                   ; pushes value to TOS
000D41r 2               ;       STL <i*2>                ; pop into local slot i
000D41r 2               ;   CALL <proc>                  ; jump (saves IPC into AR)
000D41r 2               ;
000D41r 2               ; The procedure body reads params via LDL because they were added
000D41r 2               ; to the symbol table as SYM_VAR with scope=inner (proc) at
000D41r 2               ; offsets 0, 2, 4, ...
000D41r 2  20 rr rr             JSR     next_token      ; consume the proc-name identifier
000D44r 2               ; emit MRKSTK with full local-area size (params + body locals).
000D44r 2               ; sym_save_lsize was captured at @found_sym from entry offset 23.
000D44r 2  AD rr rr             LDA     sym_save_lsize
000D47r 2  20 rr rr             JSR     emit_MRKSTK
000D4Ar 2               ; if no params, optionally consume "()" then emit CALL
000D4Ar 2  AD rr rr             LDA     sym_save_pcount
000D4Dr 2  F0 4A                BEQ     @no_args
000D4Fr 2               ; expect '(' for arg list
000D4Fr 2  A5 rr                LDA     tok_type
000D51r 2  C9 1B                CMP     #TOK_LPAREN
000D53r 2  D0 56                BNE     @emit_call      ; missing '(' — caller mistake; emit CALL anyway
000D55r 2  20 rr rr             JSR     next_token      ; consume '('
000D58r 2  A2 00                LDX     #0              ; X = current arg index
000D5Ar 2               @arg_loop:
000D5Ar 2               ; If sym_save_vmask bit X is set, this arg is VAR (push address).
000D5Ar 2               ; Otherwise parse_expression (push value).
000D5Ar 2  DA                   PHX
000D5Br 2  A9 01                LDA     #1
000D5Dr 2               @vbit:
000D5Dr 2  E0 00                CPX     #0
000D5Fr 2  F0 04                BEQ     @vdone
000D61r 2  0A                   ASL
000D62r 2  CA                   DEX
000D63r 2  80 F8                BRA     @vbit
000D65r 2               @vdone:
000D65r 2  FA                   PLX                     ; restore loop counter
000D66r 2  2D rr rr             AND     sym_save_vmask
000D69r 2  F0 07                BEQ     @arg_value
000D6Br 2  DA                   PHX
000D6Cr 2  20 rr rr             JSR     parse_arg_lvalue
000D6Fr 2  FA                   PLX
000D70r 2  80 05                BRA     @arg_stored
000D72r 2               @arg_value:
000D72r 2  DA                   PHX
000D73r 2  20 rr rr             JSR     parse_expression
000D76r 2  FA                   PLX
000D77r 2               @arg_stored:
000D77r 2               ; emit STL <X*2> — store popped value (or address) into local slot X
000D77r 2  8A                   TXA
000D78r 2  0A                   ASL
000D79r 2  20 rr rr             JSR     emit_STL
000D7Cr 2  E8                   INX
000D7Dr 2  EC rr rr             CPX     sym_save_pcount
000D80r 2  B0 0C                BCS     @done_args      ; X >= pcount — done
000D82r 2               ; expect comma between args
000D82r 2  A5 rr                LDA     tok_type
000D84r 2  C9 1F                CMP     #TOK_COMMA
000D86r 2  D0 06                BNE     @done_args
000D88r 2  20 rr rr             JSR     next_token      ; consume ','
000D8Br 2  4C rr rr             JMP     @arg_loop       ; jmp — body grew past bra range
000D8Er 2               @done_args:
000D8Er 2  A5 rr                LDA     tok_type
000D90r 2  C9 1C                CMP     #TOK_RPAREN
000D92r 2  D0 17                BNE     @emit_call
000D94r 2  20 rr rr             JSR     next_token      ; consume ')'
000D97r 2  80 12                BRA     @emit_call
000D99r 2               @no_args:
000D99r 2               ; No declared params — accept and skip "()" if present.
000D99r 2  A5 rr                LDA     tok_type
000D9Br 2  C9 1B                CMP     #TOK_LPAREN
000D9Dr 2  D0 0C                BNE     @emit_call
000D9Fr 2  20 rr rr             JSR     next_token      ; consume '('
000DA2r 2  A5 rr                LDA     tok_type
000DA4r 2  C9 1C                CMP     #TOK_RPAREN
000DA6r 2  D0 03                BNE     @emit_call
000DA8r 2  20 rr rr             JSR     next_token      ; consume ')'
000DABr 2               @emit_call:
000DABr 2               ; Emit CALL <delta>: A=target lo, scratch=target hi
000DABr 2  AD rr rr             LDA     sym_save_off+1
000DAEr 2  85 rr                STA     scratch
000DB0r 2  AD rr rr             LDA     sym_save_off
000DB3r 2  20 rr rr             JSR     emit_CALL
000DB6r 2  60                   RTS
000DB7r 2               
000DB7r 2               ; ---------------------------------------------------------------------------
000DB7r 2               ; parse_write_args — WRITE/WRITELN argument list
000DB7r 2               ; ---------------------------------------------------------------------------
000DB7r 2               parse_write_args:
000DB7r 2  A5 rr                LDA     tok_type
000DB9r 2  C9 1B                CMP     #TOK_LPAREN
000DBBr 2  D0 3E                BNE     @done
000DBDr 2  20 rr rr             JSR     next_token
000DC0r 2               @arg:
000DC0r 2  A5 rr                LDA     tok_type
000DC2r 2  C9 1C                CMP     #TOK_RPAREN
000DC4r 2  F0 32                BEQ     @close
000DC6r 2  C9 00                CMP     #TOK_EOF
000DC8r 2  F0 31                BEQ     @done
000DCAr 2  20 rr rr             JSR     parse_expression
000DCDr 2               ; Dispatch WRIT* based on expr_type set by parse_expression.
000DCDr 2  A5 rr                LDA     expr_type
000DCFr 2  C9 04                CMP     #TY_STRING
000DD1r 2  D0 05                BNE     :+
000DD3r 2  20 rr rr             JSR     emit_WRITS
000DD6r 2  80 15                BRA     @next
000DD8r 2               :
000DD8r 2  C9 02                CMP     #TY_CHAR
000DDAr 2  D0 05                BNE     :+
000DDCr 2  20 rr rr             JSR     emit_WRITC
000DDFr 2  80 0C                BRA     @next
000DE1r 2               :
000DE1r 2  C9 03                CMP     #TY_BOOL
000DE3r 2  D0 05                BNE     :+
000DE5r 2  20 rr rr             JSR     emit_WRITB
000DE8r 2  80 03                BRA     @next
000DEAr 2               :
000DEAr 2  20 rr rr             JSR     emit_WRITI      ; default: integer
000DEDr 2               @next:
000DEDr 2  A5 rr                LDA     tok_type
000DEFr 2  C9 1F                CMP     #TOK_COMMA
000DF1r 2  D0 05                BNE     @close
000DF3r 2  20 rr rr             JSR     next_token
000DF6r 2  80 C8                BRA     @arg
000DF8r 2               @close:
000DF8r 2  20 rr rr             JSR     next_token      ; consume ')'
000DFBr 2               @done:
000DFBr 2  60                   RTS
000DFCr 2               
000DFCr 2               ; ---------------------------------------------------------------------------
000DFCr 2               ; parse_read_args — READ/READLN argument list.  Each argument must be a
000DFCr 2               ; variable identifier.  For each, push the variable's address (LDA_G /
000DFCr 2               ; LDA_L / LDL passthrough for VAR-ref params) then emit OP_READI which
000DFCr 2               ; pops the address, reads a line from the console, parses a decimal
000DFCr 2               ; integer, and stores it as a 16-bit word at that address.
000DFCr 2               ; ---------------------------------------------------------------------------
000DFCr 2               parse_read_args:
000DFCr 2  A5 rr                LDA     tok_type
000DFEr 2  C9 1B                CMP     #TOK_LPAREN
000E00r 2  D0 2B                BNE     @rdone
000E02r 2  20 rr rr             JSR     next_token      ; consume '('
000E05r 2               @rarg:
000E05r 2  A5 rr                LDA     tok_type
000E07r 2  C9 1C                CMP     #TOK_RPAREN
000E09r 2  F0 19                BEQ     @rclose
000E0Br 2  C9 00                CMP     #TOK_EOF
000E0Dr 2  F0 1E                BEQ     @rdone
000E0Fr 2  C9 01                CMP     #TOK_IDENT
000E11r 2  D0 11                BNE     @rclose         ; not an ident — bail
000E13r 2  20 rr rr             JSR     parse_arg_lvalue; push address of var
000E16r 2  20 rr rr             JSR     emit_READI      ; pop addr, read int, store word
000E19r 2  A5 rr                LDA     tok_type
000E1Br 2  C9 1F                CMP     #TOK_COMMA
000E1Dr 2  D0 05                BNE     @rclose
000E1Fr 2  20 rr rr             JSR     next_token
000E22r 2  80 E1                BRA     @rarg
000E24r 2               @rclose:
000E24r 2  A5 rr                LDA     tok_type
000E26r 2  C9 1C                CMP     #TOK_RPAREN
000E28r 2  D0 03                BNE     @rdone
000E2Ar 2  20 rr rr             JSR     next_token      ; consume ')'
000E2Dr 2               @rdone:
000E2Dr 2  60                   RTS
000E2Er 2               
000E2Er 2               ; ---------------------------------------------------------------------------
000E2Er 2               ; parse_if — IF expr THEN stmt [ ELSE stmt ]
000E2Er 2               ; ---------------------------------------------------------------------------
000E2Er 2               parse_if:
000E2Er 2  20 rr rr             JSR     next_token      ; consume IF
000E31r 2  20 rr rr             JSR     parse_expression
000E34r 2               ; emit FJP with placeholder; save patch addr on 6502 stack
000E34r 2               ; (parse_statement will clobber tmp2 / scratch)
000E34r 2  20 rr rr             JSR     emit_FJP        ; A=patch_lo, scratch=patch_hi
000E37r 2  48                   PHA                     ; save FJP patch lo
000E38r 2  A5 rr                LDA     scratch
000E3Ar 2  48                   PHA                     ; save FJP patch hi
000E3Br 2               ; THEN
000E3Br 2  A5 rr                LDA     tok_type
000E3Dr 2  C9 56                CMP     #TOK_THEN
000E3Fr 2  D0 03                BNE     :+
000E41r 2  20 rr rr             JSR     next_token
000E44r 2               :
000E44r 2  20 rr rr             JSR     parse_statement
000E47r 2               ; check for ELSE
000E47r 2  A5 rr                LDA     tok_type
000E49r 2  C9 48                CMP     #TOK_ELSE
000E4Br 2  D0 30                BNE     @patch_then
000E4Dr 2               ; emit UJP over else branch
000E4Dr 2  20 rr rr             JSR     emit_UJP        ; A=patch_lo, scratch=patch_hi
000E50r 2  48                   PHA                     ; save UJP patch lo
000E51r 2  A5 rr                LDA     scratch
000E53r 2  48                   PHA                     ; save UJP patch hi
000E54r 2               ; restore FJP patch addr into tmp2 and patch it to here
000E54r 2               ; (need to dig under the UJP entries on the stack)
000E54r 2               ; stack top → bottom: UJP_hi, UJP_lo, FJP_hi, FJP_lo
000E54r 2  68                   PLA                     ; UJP hi
000E55r 2  8D rr rr             STA     sym_save_off    ; reuse sym_save_off as temp byte
000E58r 2  68                   PLA                     ; UJP lo
000E59r 2  8D rr rr             STA     sym_save_off+1
000E5Cr 2  68                   PLA                     ; FJP hi
000E5Dr 2  85 rr                STA     tmp2+1
000E5Fr 2  68                   PLA                     ; FJP lo
000E60r 2  85 rr                STA     tmp2
000E62r 2  20 rr rr             JSR     patch_jump      ; patch FJP → start of else branch
000E65r 2               ; push UJP patch addr back for after-else patching
000E65r 2  AD rr rr             LDA     sym_save_off+1  ; UJP lo
000E68r 2  48                   PHA
000E69r 2  AD rr rr             LDA     sym_save_off    ; UJP hi
000E6Cr 2  48                   PHA
000E6Dr 2  20 rr rr             JSR     next_token      ; consume ELSE
000E70r 2  20 rr rr             JSR     parse_statement
000E73r 2               ; patch UJP to here
000E73r 2  68                   PLA                     ; UJP hi
000E74r 2  85 rr                STA     tmp2+1
000E76r 2  68                   PLA                     ; UJP lo
000E77r 2  85 rr                STA     tmp2
000E79r 2  20 rr rr             JSR     patch_jump
000E7Cr 2  60                   RTS
000E7Dr 2               @patch_then:
000E7Dr 2               ; no ELSE — restore FJP patch addr and patch to here
000E7Dr 2  68                   PLA                     ; FJP hi
000E7Er 2  85 rr                STA     tmp2+1
000E80r 2  68                   PLA                     ; FJP lo
000E81r 2  85 rr                STA     tmp2
000E83r 2  20 rr rr             JSR     patch_jump
000E86r 2  60                   RTS
000E87r 2               
000E87r 2               ; ---------------------------------------------------------------------------
000E87r 2               ; parse_while — WHILE expr DO stmt
000E87r 2               ; ---------------------------------------------------------------------------
000E87r 2               parse_while:
000E87r 2  20 rr rr             JSR     next_token      ; consume WHILE
000E8Ar 2               ; save loop top
000E8Ar 2  A5 rr                LDA     cg_pc
000E8Cr 2  85 rr                STA     tmp2
000E8Er 2  A5 rr                LDA     cg_pc+1
000E90r 2  85 rr                STA     tmp2+1
000E92r 2               ; we'll need loop_top later; save on 6502 stack
000E92r 2  A5 rr                LDA     tmp2+1
000E94r 2  48                   PHA
000E95r 2  A5 rr                LDA     tmp2
000E97r 2  48                   PHA
000E98r 2  20 rr rr             JSR     parse_expression
000E9Br 2  20 rr rr             JSR     emit_FJP        ; exit if false
000E9Er 2  48                   PHA
000E9Fr 2  A5 rr                LDA     scratch
000EA1r 2  48                   PHA
000EA2r 2               ; DO
000EA2r 2  A5 rr                LDA     tok_type
000EA4r 2  C9 46                CMP     #TOK_DO
000EA6r 2  D0 03                BNE     :+
000EA8r 2  20 rr rr             JSR     next_token
000EABr 2               :
000EABr 2  20 rr rr             JSR     parse_statement
000EAEr 2               ; emit UJP back to loop top
000EAEr 2  A9 50                LDA     #OP_UJP
000EB0r 2  20 rr rr             JSR     emit_byte
000EB3r 2               ; offset = loop_top - (cg_pc + 2)
000EB3r 2  68                   PLA
000EB4r 2  85 rr                STA     tmp3            ; FJP patch hi
000EB6r 2  68                   PLA
000EB7r 2  85 rr                STA     tmp3+1          ; FJP patch lo — note: reversed from earlier push
000EB9r 2               ; compute back-edge offset
000EB9r 2  68                   PLA                     ; loop_top lo
000EBAr 2  85 rr                STA     tmp2
000EBCr 2  68                   PLA                     ; loop_top hi
000EBDr 2  85 rr                STA     tmp2+1
000EBFr 2               ; delta = loop_top - (cg_pc + 2)
000EBFr 2  38                   SEC
000EC0r 2  A5 rr                LDA     tmp2
000EC2r 2  E5 rr                SBC     cg_pc
000EC4r 2  85 rr                STA     scratch
000EC6r 2  A5 rr                LDA     tmp2+1
000EC8r 2  E5 rr                SBC     cg_pc+1
000ECAr 2  85 rr                STA     scratch+1
000ECCr 2  A5 rr                LDA     scratch
000ECEr 2  38                   SEC
000ECFr 2  E9 02                SBC     #2
000ED1r 2  85 rr                STA     scratch
000ED3r 2  B0 02                BCS     :+
000ED5r 2  C6 rr                DEC     scratch+1
000ED7r 2               :
000ED7r 2  A5 rr                LDA     scratch
000ED9r 2  20 rr rr             JSR     emit_byte
000EDCr 2  A5 rr                LDA     scratch+1
000EDEr 2  20 rr rr             JSR     emit_byte
000EE1r 2               ; patch FJP exit
000EE1r 2               ; tmp3+1:tmp3 holds FJP patch addr (note push order was lo,hi → pla gets hi first)
000EE1r 2               ; Rebuild properly:
000EE1r 2  A5 rr                LDA     tmp3+1
000EE3r 2  85 rr                STA     tmp2
000EE5r 2  A5 rr                LDA     tmp3
000EE7r 2  85 rr                STA     tmp2+1
000EE9r 2  20 rr rr             JSR     patch_jump
000EECr 2  60                   RTS
000EEDr 2               
000EEDr 2               ; ---------------------------------------------------------------------------
000EEDr 2               ; parse_for — FOR id := expr TO|DOWNTO expr DO stmt
000EEDr 2               ;
000EEDr 2               ; Codegen layout:
000EEDr 2               ;   <init>:   parse expr1; STG/STL var
000EEDr 2               ;             parse expr2; STG hidden_global   (limit, evaluated once)
000EEDr 2               ;   loop_top: LDG/LDL var; LDG hidden_global
000EEDr 2               ;             LEQI (TO) | GEQI (DOWNTO)
000EEDr 2               ;             FJP exit
000EEDr 2               ;             <body>
000EEDr 2               ;             LDG/LDL var; LDCI 1; ADI|SBI; STG/STL var
000EEDr 2               ;             UJP loop_top
000EEDr 2               ;   exit:
000EEDr 2               ;
000EEDr 2               ; State on 6502 stack across body:
000EEDr 2               ;   var_off_lo, var_off_hi, var_scope, dir, lim_off_hi, lim_off_lo
000EEDr 2               ; for_loop_top / for_patch live in zp (FOR is not nestable in this build).
000EEDr 2               ; ---------------------------------------------------------------------------
000EEDr 2               parse_for:
000EEDr 2  20 rr rr             JSR     next_token      ; consume FOR
000EF0r 2               
000EF0r 2  A5 rr                LDA     tok_type
000EF2r 2  C9 01                CMP     #TOK_IDENT
000EF4r 2  F0 01                BEQ     :+
000EF6r 2  60                   RTS                     ; not an ident — silently bail
000EF7r 2               :
000EF7r 2  20 rr rr             JSR     symtab_find
000EFAr 2  B0 04                BCS     :+
000EFCr 2  20 rr rr             JSR     next_token      ; consume the bad ident
000EFFr 2  60                   RTS
000F00r 2               :
000F00r 2               ; snapshot var info into sym_save_*
000F00r 2  A0 14                LDY     #20
000F02r 2  B1 rr                LDA     (tmp3),y
000F04r 2  8D rr rr             STA     sym_save_scope
000F07r 2  A0 12                LDY     #18
000F09r 2  B1 rr                LDA     (tmp3),y
000F0Br 2  8D rr rr             STA     sym_save_off
000F0Er 2  A0 13                LDY     #19
000F10r 2  B1 rr                LDA     (tmp3),y
000F12r 2  8D rr rr             STA     sym_save_off+1
000F15r 2  20 rr rr             JSR     next_token      ; consume identifier
000F18r 2               
000F18r 2               ; push var info: scope, off_hi, off_lo (top)
000F18r 2  AD rr rr             LDA     sym_save_scope
000F1Br 2  48                   PHA
000F1Cr 2  AD rr rr             LDA     sym_save_off+1
000F1Fr 2  48                   PHA
000F20r 2  AD rr rr             LDA     sym_save_off
000F23r 2  48                   PHA
000F24r 2               
000F24r 2               ; ':='
000F24r 2  A5 rr                LDA     tok_type
000F26r 2  C9 1A                CMP     #TOK_ASSIGN
000F28r 2  D0 03                BNE     :+
000F2Ar 2  20 rr rr             JSR     next_token
000F2Dr 2               :
000F2Dr 2  20 rr rr             JSR     parse_expression; initial value on TOS
000F30r 2               
000F30r 2               ; restore sym_save_* (parse_expression may have clobbered them)
000F30r 2  68                   PLA
000F31r 2  8D rr rr             STA     sym_save_off
000F34r 2  68                   PLA
000F35r 2  8D rr rr             STA     sym_save_off+1
000F38r 2  68                   PLA
000F39r 2  8D rr rr             STA     sym_save_scope
000F3Cr 2  20 rr rr             JSR     for_emit_store_var
000F3Fr 2               
000F3Fr 2               ; re-push var info for use after loop
000F3Fr 2  AD rr rr             LDA     sym_save_scope
000F42r 2  48                   PHA
000F43r 2  AD rr rr             LDA     sym_save_off+1
000F46r 2  48                   PHA
000F47r 2  AD rr rr             LDA     sym_save_off
000F4Ar 2  48                   PHA
000F4Br 2               
000F4Br 2               ; direction byte: 0 = TO, 1 = DOWNTO
000F4Br 2  A9 00                LDA     #0
000F4Dr 2  A6 rr                LDX     tok_type
000F4Fr 2  E0 47                CPX     #TOK_DOWNTO
000F51r 2  D0 02                BNE     :+
000F53r 2  A9 01                LDA     #1
000F55r 2               :
000F55r 2  48                   PHA                     ; push dir
000F56r 2  20 rr rr             JSR     next_token      ; consume TO / DOWNTO
000F59r 2               
000F59r 2               ; parse limit expression and store to a hidden global
000F59r 2  20 rr rr             JSR     parse_expression
000F5Cr 2  20 rr rr             JSR     codegen_alloc_global; tmp2 = hidden offset
000F5Fr 2               ; push the offset NOW — emit_STG will clobber tmp2
000F5Fr 2  A5 rr                LDA     tmp2+1
000F61r 2  48                   PHA                     ; lim_hi
000F62r 2  A5 rr                LDA     tmp2
000F64r 2  48                   PHA                     ; lim_lo (top)
000F65r 2               ; reload from stack peek for emit_STG (A = lo, scratch = hi)
000F65r 2  BA                   TSX
000F66r 2  BD 02 01             LDA     $0102,x
000F69r 2  85 rr                STA     scratch
000F6Br 2  BD 01 01             LDA     $0101,x
000F6Er 2  20 rr rr             JSR     emit_STG
000F71r 2               
000F71r 2               ; consume DO
000F71r 2  A5 rr                LDA     tok_type
000F73r 2  C9 46                CMP     #TOK_DO
000F75r 2  D0 03                BNE     :+
000F77r 2  20 rr rr             JSR     next_token
000F7Ar 2               :
000F7Ar 2               ; --- loop top ---
000F7Ar 2  A5 rr                LDA     cg_pc
000F7Cr 2  85 rr                STA     for_loop_top
000F7Er 2  A5 rr                LDA     cg_pc+1
000F80r 2  85 rr                STA     for_loop_top+1
000F82r 2               
000F82r 2               ; emit LDG/LDL var — restore sym_save_* via TSX peek
000F82r 2               ; stack from top: lim_lo, lim_hi, dir, var_lo, var_hi, var_scope
000F82r 2  BA                   TSX
000F83r 2  BD 04 01             LDA     $0104,x         ; var_lo
000F86r 2  8D rr rr             STA     sym_save_off
000F89r 2  BD 05 01             LDA     $0105,x         ; var_hi
000F8Cr 2  8D rr rr             STA     sym_save_off+1
000F8Fr 2  BD 06 01             LDA     $0106,x         ; var_scope
000F92r 2  8D rr rr             STA     sym_save_scope
000F95r 2  20 rr rr             JSR     for_emit_load_var
000F98r 2               
000F98r 2               ; emit LDG limit — limit hi at $0102,x, lo at $0101,x
000F98r 2  BA                   TSX
000F99r 2  BD 02 01             LDA     $0102,x
000F9Cr 2  85 rr                STA     scratch
000F9Er 2  BD 01 01             LDA     $0101,x
000FA1r 2  20 rr rr             JSR     emit_LDG
000FA4r 2               
000FA4r 2               ; comparison: TO → LEQI (var <= limit), DOWNTO → GEQI
000FA4r 2  BA                   TSX
000FA5r 2  BD 03 01             LDA     $0103,x         ; dir
000FA8r 2  F0 05                BEQ     @cmp_to
000FAAr 2  20 rr rr             JSR     emit_GEQI
000FADr 2  80 03                BRA     @cmp_done
000FAFr 2               @cmp_to:
000FAFr 2  20 rr rr             JSR     emit_LEQI
000FB2r 2               @cmp_done:
000FB2r 2               
000FB2r 2               ; FJP exit placeholder
000FB2r 2  20 rr rr             JSR     emit_FJP        ; A=patch_lo, scratch=patch_hi
000FB5r 2  85 rr                STA     for_patch
000FB7r 2  A5 rr                LDA     scratch
000FB9r 2  85 rr                STA     for_patch+1
000FBBr 2               
000FBBr 2               ; --- body ---
000FBBr 2  20 rr rr             JSR     parse_statement
000FBEr 2               
000FBEr 2               ; --- pop state in reverse push order ---
000FBEr 2  68                   PLA                     ; lim_lo (discard)
000FBFr 2  68                   PLA                     ; lim_hi (discard)
000FC0r 2  68                   PLA                     ; direction
000FC1r 2  8D rr rr             STA     sym_save_kind   ; reuse for direction storage
000FC4r 2  68                   PLA                     ; var_lo
000FC5r 2  8D rr rr             STA     sym_save_off
000FC8r 2  68                   PLA                     ; var_hi
000FC9r 2  8D rr rr             STA     sym_save_off+1
000FCCr 2  68                   PLA                     ; var_scope
000FCDr 2  8D rr rr             STA     sym_save_scope
000FD0r 2               
000FD0r 2               ; emit increment / decrement: LDG var, LDCI 1, ADI|SBI, STG var
000FD0r 2  20 rr rr             JSR     for_emit_load_var
000FD3r 2  A9 01                LDA     #1
000FD5r 2  20 rr rr             JSR     emit_LDCI
000FD8r 2  AD rr rr             LDA     sym_save_kind   ; direction
000FDBr 2  F0 05                BEQ     @inc
000FDDr 2  20 rr rr             JSR     emit_SBI
000FE0r 2  80 03                BRA     @inc_done
000FE2r 2               @inc:
000FE2r 2  20 rr rr             JSR     emit_ADI
000FE5r 2               @inc_done:
000FE5r 2  20 rr rr             JSR     for_emit_store_var
000FE8r 2               
000FE8r 2               ; emit UJP back to loop_top
000FE8r 2               ; offset = for_loop_top - (cg_pc_after_opcode + 2)
000FE8r 2  A9 50                LDA     #OP_UJP
000FEAr 2  20 rr rr             JSR     emit_byte
000FEDr 2  38                   SEC
000FEEr 2  A5 rr                LDA     for_loop_top
000FF0r 2  E5 rr                SBC     cg_pc
000FF2r 2  85 rr                STA     scratch
000FF4r 2  A5 rr                LDA     for_loop_top+1
000FF6r 2  E5 rr                SBC     cg_pc+1
000FF8r 2  85 rr                STA     scratch+1
000FFAr 2  38                   SEC
000FFBr 2  A5 rr                LDA     scratch
000FFDr 2  E9 02                SBC     #2
000FFFr 2  85 rr                STA     scratch
001001r 2  B0 02                BCS     :+
001003r 2  C6 rr                DEC     scratch+1
001005r 2               :
001005r 2  A5 rr                LDA     scratch
001007r 2  20 rr rr             JSR     emit_byte
00100Ar 2  A5 rr                LDA     scratch+1
00100Cr 2  20 rr rr             JSR     emit_byte
00100Fr 2               
00100Fr 2               ; patch FJP exit
00100Fr 2  A5 rr                LDA     for_patch
001011r 2  85 rr                STA     tmp2
001013r 2  A5 rr                LDA     for_patch+1
001015r 2  85 rr                STA     tmp2+1
001017r 2  20 rr rr             JSR     patch_jump
00101Ar 2  60                   RTS
00101Br 2               
00101Br 2               ; ---------------------------------------------------------------------------
00101Br 2               ; for_emit_load_var / for_emit_store_var — emit LDG/LDL or STG/STL based on
00101Br 2               ; sym_save_scope (0 = global) and sym_save_off (offset).
00101Br 2               ; ---------------------------------------------------------------------------
00101Br 2               for_emit_load_var:
00101Br 2  AD rr rr             LDA     sym_save_scope
00101Er 2  D0 0B                BNE     @local
001020r 2  AD rr rr             LDA     sym_save_off+1
001023r 2  85 rr                STA     scratch
001025r 2  AD rr rr             LDA     sym_save_off
001028r 2  4C rr rr             JMP     emit_LDG
00102Br 2               @local:
00102Br 2  AD rr rr             LDA     sym_save_off
00102Er 2  4C rr rr             JMP     emit_LDL
001031r 2               
001031r 2               for_emit_store_var:
001031r 2  AD rr rr             LDA     sym_save_scope
001034r 2  D0 0B                BNE     @local
001036r 2  AD rr rr             LDA     sym_save_off+1
001039r 2  85 rr                STA     scratch
00103Br 2  AD rr rr             LDA     sym_save_off
00103Er 2  4C rr rr             JMP     emit_STG
001041r 2               @local:
001041r 2  AD rr rr             LDA     sym_save_off
001044r 2  4C rr rr             JMP     emit_STL
001047r 2               
001047r 2               ; ---------------------------------------------------------------------------
001047r 2               ; parse_repeat — REPEAT stmt { ; stmt } UNTIL expr
001047r 2               ; ---------------------------------------------------------------------------
001047r 2               parse_repeat:
001047r 2  20 rr rr             JSR     next_token      ; consume REPEAT
00104Ar 2               ; save top
00104Ar 2  A5 rr                LDA     cg_pc
00104Cr 2  48                   PHA
00104Dr 2  A5 rr                LDA     cg_pc+1
00104Fr 2  48                   PHA
001050r 2               @loop:
001050r 2  A5 rr                LDA     tok_type
001052r 2  C9 59                CMP     #TOK_UNTIL
001054r 2  F0 12                BEQ     @until
001056r 2  C9 00                CMP     #TOK_EOF
001058r 2  F0 41                BEQ     @done
00105Ar 2  20 rr rr             JSR     parse_statement
00105Dr 2  A5 rr                LDA     tok_type
00105Fr 2  C9 20                CMP     #TOK_SEMICOLON
001061r 2  D0 ED                BNE     @loop
001063r 2  20 rr rr             JSR     next_token
001066r 2  80 E8                BRA     @loop
001068r 2               @until:
001068r 2  20 rr rr             JSR     next_token      ; consume UNTIL
00106Br 2  20 rr rr             JSR     parse_expression
00106Er 2               ; FJP back to top
00106Er 2  A9 51                LDA     #OP_FJP
001070r 2  20 rr rr             JSR     emit_byte
001073r 2  68                   PLA
001074r 2  85 rr                STA     tmp2+1
001076r 2  68                   PLA
001077r 2  85 rr                STA     tmp2
001079r 2  38                   SEC
00107Ar 2  A5 rr                LDA     tmp2
00107Cr 2  E5 rr                SBC     cg_pc
00107Er 2  85 rr                STA     scratch
001080r 2  A5 rr                LDA     tmp2+1
001082r 2  E5 rr                SBC     cg_pc+1
001084r 2  85 rr                STA     scratch+1
001086r 2  A5 rr                LDA     scratch
001088r 2  38                   SEC
001089r 2  E9 02                SBC     #2
00108Br 2  85 rr                STA     scratch
00108Dr 2  B0 02                BCS     :+
00108Fr 2  C6 rr                DEC     scratch+1
001091r 2               :
001091r 2  A5 rr                LDA     scratch
001093r 2  20 rr rr             JSR     emit_byte
001096r 2  A5 rr                LDA     scratch+1
001098r 2  20 rr rr             JSR     emit_byte
00109Br 2               @done:
00109Br 2  60                   RTS
00109Cr 2               
00109Cr 2               ; ---------------------------------------------------------------------------
00109Cr 2               ; parse_expression — full expression with operator precedence
00109Cr 2               ; Phase 1: simple additive + comparison; no precedence climbing yet
00109Cr 2               ; ---------------------------------------------------------------------------
00109Cr 2               parse_expression:
00109Cr 2  20 rr rr             JSR     parse_simple_expr
00109Fr 2               ; check for relational operator
00109Fr 2  A5 rr                LDA     tok_type
0010A1r 2  C9 14                CMP     #TOK_EQ
0010A3r 2  F0 15                BEQ     @rel_eq
0010A5r 2  C9 15                CMP     #TOK_NEQ
0010A7r 2  F0 1D                BEQ     @rel_neq
0010A9r 2  C9 16                CMP     #TOK_LT
0010ABr 2  F0 25                BEQ     @rel_lt
0010ADr 2  C9 17                CMP     #TOK_GT
0010AFr 2  F0 2D                BEQ     @rel_gt
0010B1r 2  C9 18                CMP     #TOK_LEQ
0010B3r 2  F0 35                BEQ     @rel_leq
0010B5r 2  C9 19                CMP     #TOK_GEQ
0010B7r 2  F0 3D                BEQ     @rel_geq
0010B9r 2  60                   RTS                     ; expr_type set by parse_simple_expr
0010BAr 2               @rel_eq:
0010BAr 2  20 rr rr             JSR     next_token
0010BDr 2  20 rr rr             JSR     parse_simple_expr
0010C0r 2  20 rr rr             JSR     emit_EQUI
0010C3r 2  4C rr rr             JMP     @rel_done
0010C6r 2               @rel_neq:
0010C6r 2  20 rr rr             JSR     next_token
0010C9r 2  20 rr rr             JSR     parse_simple_expr
0010CCr 2  20 rr rr             JSR     emit_NEQI
0010CFr 2  4C rr rr             JMP     @rel_done
0010D2r 2               @rel_lt:
0010D2r 2  20 rr rr             JSR     next_token
0010D5r 2  20 rr rr             JSR     parse_simple_expr
0010D8r 2  20 rr rr             JSR     emit_LESI
0010DBr 2  4C rr rr             JMP     @rel_done
0010DEr 2               @rel_gt:
0010DEr 2  20 rr rr             JSR     next_token
0010E1r 2  20 rr rr             JSR     parse_simple_expr
0010E4r 2  20 rr rr             JSR     emit_GTRI
0010E7r 2  4C rr rr             JMP     @rel_done
0010EAr 2               @rel_leq:
0010EAr 2  20 rr rr             JSR     next_token
0010EDr 2  20 rr rr             JSR     parse_simple_expr
0010F0r 2  20 rr rr             JSR     emit_LEQI
0010F3r 2  4C rr rr             JMP     @rel_done
0010F6r 2               @rel_geq:
0010F6r 2  20 rr rr             JSR     next_token
0010F9r 2  20 rr rr             JSR     parse_simple_expr
0010FCr 2  20 rr rr             JSR     emit_GEQI
0010FFr 2               @rel_done:
0010FFr 2  A9 03                LDA     #TY_BOOL
001101r 2  85 rr                STA     expr_type
001103r 2  60                   RTS
001104r 2               
001104r 2               ; ---------------------------------------------------------------------------
001104r 2               ; parse_simple_expr — term { (+|-|OR) term }
001104r 2               ; ---------------------------------------------------------------------------
001104r 2               parse_simple_expr:
001104r 2               ; check for unary minus
001104r 2  A5 rr                LDA     tok_type
001106r 2  C9 11                CMP     #TOK_MINUS
001108r 2  D0 0E                BNE     :+
00110Ar 2  20 rr rr             JSR     next_token
00110Dr 2  20 rr rr             JSR     parse_term
001110r 2  20 rr rr             JSR     emit_NGI
001113r 2  A9 01                LDA     #TY_INT
001115r 2  85 rr                STA     expr_type
001117r 2  60                   RTS
001118r 2               :
001118r 2  20 rr rr             JSR     parse_term
00111Br 2               @addop:
00111Br 2  A5 rr                LDA     tok_type
00111Dr 2  C9 10                CMP     #TOK_PLUS
00111Fr 2  F0 09                BEQ     @add
001121r 2  C9 11                CMP     #TOK_MINUS
001123r 2  F0 14                BEQ     @sub
001125r 2  C9 51                CMP     #TOK_OR
001127r 2  F0 1F                BEQ     @or
001129r 2  60                   RTS
00112Ar 2               @add:
00112Ar 2  20 rr rr             JSR     next_token
00112Dr 2  20 rr rr             JSR     parse_term
001130r 2  20 rr rr             JSR     emit_ADI
001133r 2  A9 01                LDA     #TY_INT
001135r 2  85 rr                STA     expr_type
001137r 2  80 E2                BRA     @addop
001139r 2               @sub:
001139r 2  20 rr rr             JSR     next_token
00113Cr 2  20 rr rr             JSR     parse_term
00113Fr 2  20 rr rr             JSR     emit_SBI
001142r 2  A9 01                LDA     #TY_INT
001144r 2  85 rr                STA     expr_type
001146r 2  80 D3                BRA     @addop
001148r 2               @or:
001148r 2  20 rr rr             JSR     next_token
00114Br 2  20 rr rr             JSR     parse_term
00114Er 2  20 rr rr             JSR     emit_LOR
