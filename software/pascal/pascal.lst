00298Ar 2               ; ---------------------------------------------------------------------------
00298Ar 2               ; patch_jump — fill in jump offset at patch address stored in tmp2 (word)
00298Ar 2               ; The offset is computed as: (current cg_pc) - (patch_addr + 2)
00298Ar 2               ; i.e. relative to instruction after the operand word
00298Ar 2               ; ---------------------------------------------------------------------------
00298Ar 2               patch_jump:
00298Ar 2               ; delta = cg_pc - (patch_addr + 2)
00298Ar 2               ;   compute (cg_pc - 2) first, then subtract patch_addr
00298Ar 2  A5 rr                LDA     cg_pc
00298Cr 2  38                   SEC
00298Dr 2  E9 02                SBC     #2
00298Fr 2  85 rr                STA     scratch         ; lo of (cg_pc - 2)
002991r 2  A5 rr                LDA     cg_pc+1
002993r 2  E9 00                SBC     #0
002995r 2  85 rr                STA     scratch+1       ; hi of (cg_pc - 2)
002997r 2  38                   SEC
002998r 2  A5 rr                LDA     scratch
00299Ar 2  E5 rr                SBC     tmp2
00299Cr 2  48                   PHA
00299Dr 2  A5 rr                LDA     scratch+1
00299Fr 2  E5 rr                SBC     tmp2+1
0029A1r 2  85 rr                STA     scratch+1       ; high byte of delta
0029A3r 2  68                   PLA
0029A4r 2  85 rr                STA     scratch         ; low byte of delta
0029A6r 2               ; write delta at patch address (CODEBUF_BASE + tmp2)
0029A6r 2  A5 rr                LDA     tmp2
0029A8r 2  18                   CLC
0029A9r 2  69 00                ADC     #<CODEBUF_BASE
0029ABr 2  85 rr                STA     tmp3
0029ADr 2  A5 rr                LDA     tmp2+1
0029AFr 2  69 45                ADC     #>CODEBUF_BASE
0029B1r 2  85 rr                STA     tmp3+1
0029B3r 2  A0 00                LDY     #0
0029B5r 2  A5 rr                LDA     scratch
0029B7r 2  91 rr                STA     (tmp3),y
0029B9r 2  C8                   INY
0029BAr 2  A5 rr                LDA     scratch+1
0029BCr 2  91 rr                STA     (tmp3),y
0029BEr 2  60                   RTS
0029BFr 2               
0029BFr 2               ; --- I/O emitters ---
0029BFr 2               
0029BFr 2               emit_WRITI:
0029BFr 2  A9 80                LDA     #OP_WRITI
0029C1r 2  4C rr rr             JMP     emit_byte
0029C4r 2               
0029C4r 2               emit_WRITC:
0029C4r 2  A9 81                LDA     #OP_WRITC
0029C6r 2  4C rr rr             JMP     emit_byte
0029C9r 2               
0029C9r 2               emit_WRITB:
0029C9r 2  A9 82                LDA     #OP_WRITB
0029CBr 2  4C rr rr             JMP     emit_byte
0029CEr 2               
0029CEr 2               emit_WRITS:
0029CEr 2  A9 83                LDA     #OP_WRITS
0029D0r 2  4C rr rr             JMP     emit_byte
0029D3r 2               
0029D3r 2               emit_WRITLN:
0029D3r 2  A9 84                LDA     #OP_WRITLN
0029D5r 2  4C rr rr             JMP     emit_byte
0029D8r 2               
0029D8r 2               emit_READI:
0029D8r 2  A9 85                LDA     #OP_READI
0029DAr 2  4C rr rr             JMP     emit_byte
0029DDr 2               
0029DDr 2               emit_READC:
0029DDr 2  A9 86                LDA     #OP_READC
0029DFr 2  4C rr rr             JMP     emit_byte
0029E2r 2               
0029E2r 2               ; --- Stack ---
0029E2r 2               
0029E2r 2               emit_DUP:
0029E2r 2  A9 90                LDA     #OP_DUP
0029E4r 2  4C rr rr             JMP     emit_byte
0029E7r 2               
0029E7r 2               emit_POP:
0029E7r 2  A9 91                LDA     #OP_POP
0029E9r 2  4C rr rr             JMP     emit_byte
0029ECr 2               
0029ECr 2               ; --- Calls ---
0029ECr 2               
0029ECr 2               emit_MRKSTK:                    ; local size in A
0029ECr 2  48                   PHA
0029EDr 2  A9 64                LDA     #OP_MRKSTK
0029EFr 2  20 rr rr             JSR     emit_byte
0029F2r 2  68                   PLA
0029F3r 2  4C rr rr             JMP     emit_byte
0029F6r 2               
0029F6r 2               emit_RET:
0029F6r 2  A9 62                LDA     #OP_RET
0029F8r 2  4C rr rr             JMP     emit_byte
0029FBr 2               
0029FBr 2               emit_RETF:
0029FBr 2  A9 63                LDA     #OP_RETF
0029FDr 2  4C rr rr             JMP     emit_byte
002A00r 2               
002A00r 2               emit_STR:
002A00r 2  A9 66                LDA     #OP_STR
002A02r 2  4C rr rr             JMP     emit_byte
002A05r 2               
002A05r 2               ; emit_CALL — A = target absolute code-buffer addr lo, scratch = hi
002A05r 2               ; Emits OP_CALL + signed 16-bit offset = target - (cg_pc_after_operand)
002A05r 2               emit_CALL:
002A05r 2  48                   PHA                     ; target lo
002A06r 2  A5 rr                LDA     scratch
002A08r 2  48                   PHA                     ; target hi
002A09r 2  A9 60                LDA     #OP_CALL
002A0Br 2  20 rr rr             JSR     emit_byte       ; clobbers tmp2; preserves scratch & 6502 stack
002A0Er 2               ; compute offset = target - cg_pc - 2 (16-bit)
002A0Er 2  68                   PLA                     ; target hi
002A0Fr 2  AA                   TAX
002A10r 2  68                   PLA                     ; target lo
002A11r 2  38                   SEC
002A12r 2  E9 02                SBC     #2
002A14r 2  48                   PHA                     ; partial lo
002A15r 2  8A                   TXA                     ; target hi
002A16r 2  E9 00                SBC     #0
002A18r 2  85 rr                STA     scratch         ; partial hi
002A1Ar 2  68                   PLA                     ; partial lo
002A1Br 2  38                   SEC
002A1Cr 2  E5 rr                SBC     cg_pc
002A1Er 2  48                   PHA                     ; offset lo
002A1Fr 2  A5 rr                LDA     scratch
002A21r 2  E5 rr                SBC     cg_pc+1
002A23r 2  85 rr                STA     scratch         ; offset hi
002A25r 2  68                   PLA
002A26r 2  20 rr rr             JSR     emit_byte       ; emit offset lo
002A29r 2  A5 rr                LDA     scratch
002A2Br 2  20 rr rr             JSR     emit_byte       ; emit offset hi
002A2Er 2  60                   RTS
002A2Fr 2               
002A2Fr 2               emit_HALT:
002A2Fr 2  A9 FF                LDA     #OP_HALT
002A31r 2  4C rr rr             JMP     emit_byte
002A34r 2               
002A34r 2               ; --- String built-ins ---
002A34r 2               
002A34r 2               emit_LEN:
002A34r 2  A9 A0                LDA     #OP_LEN
002A36r 2  4C rr rr             JMP     emit_byte
002A39r 2               
002A39r 2               emit_POS:
002A39r 2  A9 A1                LDA     #OP_POS
002A3Br 2  4C rr rr             JMP     emit_byte
002A3Er 2               
002A3Er 2               emit_COPY:
002A3Er 2  A9 A2                LDA     #OP_COPY
002A40r 2  4C rr rr             JMP     emit_byte
002A43r 2               
002A43r 2               emit_CONCAT:
002A43r 2  A9 A3                LDA     #OP_CONCAT
002A45r 2  4C rr rr             JMP     emit_byte
002A48r 2               
002A48r 2               ; --- TEXT file I/O ---
002A48r 2               
002A48r 2               emit_FASSGN:
002A48r 2  A9 B0                LDA     #OP_FASSGN
002A4Ar 2  4C rr rr             JMP     emit_byte
002A4Dr 2               emit_FRESET:
002A4Dr 2  A9 B1                LDA     #OP_FRESET
002A4Fr 2  4C rr rr             JMP     emit_byte
002A52r 2               emit_FREWRT:
002A52r 2  A9 B2                LDA     #OP_FREWRT
002A54r 2  4C rr rr             JMP     emit_byte
002A57r 2               emit_FCLOSE:
002A57r 2  A9 B3                LDA     #OP_FCLOSE
002A59r 2  4C rr rr             JMP     emit_byte
002A5Cr 2               emit_FWRC:
002A5Cr 2  A9 B4                LDA     #OP_FWRC
002A5Er 2  4C rr rr             JMP     emit_byte
002A61r 2               emit_FWRS:
002A61r 2  A9 B5                LDA     #OP_FWRS
002A63r 2  4C rr rr             JMP     emit_byte
002A66r 2               emit_FWRI:
002A66r 2  A9 B6                LDA     #OP_FWRI
002A68r 2  4C rr rr             JMP     emit_byte
002A6Br 2               emit_FWLN:
002A6Br 2  A9 B7                LDA     #OP_FWLN
002A6Dr 2  4C rr rr             JMP     emit_byte
002A70r 2               emit_FRDC:
002A70r 2  A9 B8                LDA     #OP_FRDC
002A72r 2  4C rr rr             JMP     emit_byte
002A75r 2               emit_FRDI:
002A75r 2  A9 B9                LDA     #OP_FRDI
002A77r 2  4C rr rr             JMP     emit_byte
002A7Ar 2               emit_FRDLN:
002A7Ar 2  A9 BA                LDA     #OP_FRDLN
002A7Cr 2  4C rr rr             JMP     emit_byte
002A7Fr 2               emit_FEOF:
002A7Fr 2  A9 BB                LDA     #OP_FEOF
002A81r 2  4C rr rr             JMP     emit_byte
002A84r 2               emit_FAPPND:
002A84r 2  A9 BC                LDA     #OP_FAPPND
002A86r 2  4C rr rr             JMP     emit_byte
002A89r 2               emit_FRDS:
002A89r 2  A9 BD                LDA     #OP_FRDS
002A8Br 2  4C rr rr             JMP     emit_byte
002A8Er 2               emit_FWRB:
002A8Er 2  A9 BE                LDA     #OP_FWRB
002A90r 2  4C rr rr             JMP     emit_byte
002A93r 2               emit_FEOLN:
002A93r 2  A9 BF                LDA     #OP_FEOLN
002A95r 2  4C rr rr             JMP     emit_byte
002A98r 2               
002A98r 2               ; ---------------------------------------------------------------------------
002A98r 2               ; codegen_alloc_global — reserve N bytes in global area; return offset in tmp2
002A98r 2               ; N in A
002A98r 2               ; ---------------------------------------------------------------------------
002A98r 2               codegen_alloc_global:
002A98r 2  A5 rr                LDA     cg_globals
002A9Ar 2  85 rr                STA     tmp2
002A9Cr 2  A5 rr                LDA     cg_globals+1
002A9Er 2  85 rr                STA     tmp2+1
002AA0r 2               ; advance by N (passed in A — caller puts size here)
002AA0r 2               ; For now allocate 2 bytes (word) per variable
002AA0r 2  A5 rr                LDA     cg_globals
002AA2r 2  18                   CLC
002AA3r 2  69 02                ADC     #2
002AA5r 2  85 rr                STA     cg_globals
002AA7r 2  90 02                BCC     :+
002AA9r 2  E6 rr                INC     cg_globals+1
002AABr 2               :
002AABr 2  60                   RTS
002AACr 2               
002AACr 1                       .include        "IOLIB.ASM"
002AACr 2               .pc02
002AACr 2               ; iolib.asm — console and file I/O wrappers for DOS/65
002AACr 2               ;
002AACr 2               ; Uses PEM function 2 (CONOUT) for character output.
002AACr 2               ; This routes through DFT_CONSOLE and works on all platforms
002AACr 2               ; (serial, ESP video, memory-mapped video) regardless of which
002AACr 2               ; console driver is active.
002AACr 2               
002AACr 2                       .segment        "CODE"
002AACr 2               
002AACr 2               ; ---------------------------------------------------------------------------
002AACr 2               ; console_putc — output character in A to console via PEM #2
002AACr 2               ; ---------------------------------------------------------------------------
002AACr 2               console_putc:
002AACr 2  48                   PHA
002AADr 2  A2 02                LDX     #PEM_CONOUT
002AAFr 2  20 03 01             JSR     PEM_ENTRY
002AB2r 2  68                   PLA
002AB3r 2  60                   RTS
002AB4r 2               
002AB4r 2               ; ---------------------------------------------------------------------------
002AB4r 2               ; console_newline — emit CR+LF
002AB4r 2               ; ---------------------------------------------------------------------------
002AB4r 2               console_newline:
002AB4r 2  A9 0D                LDA     #$0D
002AB6r 2  A2 02                LDX     #PEM_CONOUT
002AB8r 2  20 03 01             JSR     PEM_ENTRY
002ABBr 2  A9 0A                LDA     #$0A
002ABDr 2  A2 02                LDX     #PEM_CONOUT
002ABFr 2  20 03 01             JSR     PEM_ENTRY
002AC2r 2  60                   RTS
002AC3r 2               
002AC3r 2               ; ---------------------------------------------------------------------------
002AC3r 2               ; console_print_sz — print null-terminated string at tmp0
002AC3r 2               ; ---------------------------------------------------------------------------
002AC3r 2               console_print_sz:
002AC3r 2  A0 00                LDY     #0
002AC5r 2               @loop:
002AC5r 2  B1 rr                LDA     (tmp0),y
002AC7r 2  F0 08                BEQ     @done
002AC9r 2  A2 02                LDX     #PEM_CONOUT
002ACBr 2  20 03 01             JSR     PEM_ENTRY
002ACEr 2  C8                   INY
002ACFr 2  D0 F4                BNE     @loop
002AD1r 2               @done:
002AD1r 2  60                   RTS
002AD2r 2               
002AD2r 2               ; ---------------------------------------------------------------------------
002AD2r 2               ; console_print_pstr — print length-prefixed Pascal string at tmp0
002AD2r 2               ; ---------------------------------------------------------------------------
002AD2r 2               console_print_pstr:
002AD2r 2  A0 00                LDY     #0
002AD4r 2  B1 rr                LDA     (tmp0),y        ; length byte
002AD6r 2  F0 10                BEQ     @done
002AD8r 2  AA                   TAX                     ; X = remaining chars — but X used by PEM!
002AD9r 2               ; save length, use tmp1 as counter
002AD9r 2  85 rr                STA     tmp1
002ADBr 2  C8                   INY
002ADCr 2               @loop:
002ADCr 2  B1 rr                LDA     (tmp0),y
002ADEr 2  A2 02                LDX     #PEM_CONOUT
002AE0r 2  20 03 01             JSR     PEM_ENTRY
002AE3r 2  C8                   INY
002AE4r 2  C6 rr                DEC     tmp1
002AE6r 2  D0 F4                BNE     @loop
002AE8r 2               @done:
002AE8r 2  60                   RTS
002AE9r 2               
002AE9r 2               ; ---------------------------------------------------------------------------
002AE9r 2               ; console_print_dec — print signed 16-bit integer in tmp0:tmp0+1
002AE9r 2               ; ---------------------------------------------------------------------------
002AE9r 2               console_print_dec:
002AE9r 2  A5 rr                LDA     tmp0+1
002AEBr 2  10 14                BPL     @positive
002AEDr 2  A9 2D                LDA     #'-'
002AEFr 2  A2 02                LDX     #PEM_CONOUT
002AF1r 2  20 03 01             JSR     PEM_ENTRY
002AF4r 2  A9 00                LDA     #0
002AF6r 2  38                   SEC
002AF7r 2  E5 rr                SBC     tmp0
002AF9r 2  85 rr                STA     tmp0
002AFBr 2  A9 00                LDA     #0
002AFDr 2  E5 rr                SBC     tmp0+1
002AFFr 2  85 rr                STA     tmp0+1
002B01r 2               @positive:
002B01r 2  A9 00                LDA     #0
002B03r 2  48                   PHA                     ; sentinel
002B04r 2               @div_loop:
002B04r 2  20 rr rr             JSR     div16_by10      ; quotient→tmp0, remainder→scratch
002B07r 2  A5 rr                LDA     scratch
002B09r 2  18                   CLC
002B0Ar 2  69 30                ADC     #'0'
002B0Cr 2  48                   PHA
002B0Dr 2  A5 rr                LDA     tmp0
002B0Fr 2  05 rr                ORA     tmp0+1
002B11r 2  D0 F1                BNE     @div_loop
002B13r 2               @print_loop:
002B13r 2  68                   PLA
002B14r 2  F0 07                BEQ     @done2          ; sentinel
002B16r 2  A2 02                LDX     #PEM_CONOUT
002B18r 2  20 03 01             JSR     PEM_ENTRY
002B1Br 2  80 F6                BRA     @print_loop
002B1Dr 2               @done2:
002B1Dr 2  60                   RTS
002B1Er 2               
002B1Er 2               ; ---------------------------------------------------------------------------
002B1Er 2               ; div16_by10 — divide tmp0:tmp0+1 by 10
002B1Er 2               ; Result: quotient in tmp0:tmp0+1, remainder in scratch
002B1Er 2               ; ---------------------------------------------------------------------------
002B1Er 2               div16_by10:
002B1Er 2  A9 00                LDA     #0
002B20r 2  85 rr                STA     scratch
002B22r 2  A2 10                LDX     #16
002B24r 2               @bit:
002B24r 2  06 rr                ASL     tmp0
002B26r 2  26 rr                ROL     tmp0+1
002B28r 2  26 rr                ROL     scratch
002B2Ar 2  A5 rr                LDA     scratch
002B2Cr 2  C9 0A                CMP     #10
002B2Er 2  90 06                BCC     @no_sub
002B30r 2  E9 0A                SBC     #10
002B32r 2  85 rr                STA     scratch
002B34r 2  E6 rr                INC     tmp0
002B36r 2               @no_sub:
002B36r 2  CA                   DEX
002B37r 2  D0 EB                BNE     @bit
002B39r 2  60                   RTS
002B3Ar 2               
002B3Ar 2               ; ---------------------------------------------------------------------------
002B3Ar 2               ; console_read_line — read a line into buffer at tmp0, max len in x_save
002B3Ar 2               ; Returns: Y = length (not including CR)
002B3Ar 2               ; ---------------------------------------------------------------------------
002B3Ar 2               console_read_line:
002B3Ar 2  8E rr rr             STX     x_save
002B3Dr 2  A0 00                LDY     #0
002B3Fr 2               @loop:
002B3Fr 2  A2 01                LDX     #PEM_CONIN
002B41r 2  20 03 01             JSR     PEM_ENTRY
002B44r 2  C9 0D                CMP     #$0D
002B46r 2  F0 28                BEQ     @done
002B48r 2  C9 08                CMP     #$08            ; backspace
002B4Ar 2  D0 1C                BNE     @store
002B4Cr 2  C0 00                CPY     #0
002B4Er 2  F0 EF                BEQ     @loop
002B50r 2  88                   DEY
002B51r 2  A9 08                LDA     #$08
002B53r 2  A2 02                LDX     #PEM_CONOUT
002B55r 2  20 03 01             JSR     PEM_ENTRY
002B58r 2  A9 20                LDA     #' '
002B5Ar 2  A2 02                LDX     #PEM_CONOUT
002B5Cr 2  20 03 01             JSR     PEM_ENTRY
002B5Fr 2  A9 08                LDA     #$08
002B61r 2  A2 02                LDX     #PEM_CONOUT
002B63r 2  20 03 01             JSR     PEM_ENTRY
002B66r 2  80 D7                BRA     @loop
002B68r 2               @store:
002B68r 2  91 rr                STA     (tmp0),y
002B6Ar 2  C8                   INY
002B6Br 2  CC rr rr             CPY     x_save
002B6Er 2  90 CF                BCC     @loop
002B70r 2               @done:
002B70r 2  60                   RTS
002B71r 2               x_save:
002B71r 2  00                   .BYTE   0
002B72r 2               
002B72r 2               ; ---------------------------------------------------------------------------
002B72r 2               ; file_open — open file via FCB at tmp1; returns A=0 success, $FF=not found
002B72r 2               ; PEM calling convention: X=function, A=FCB addr lo, Y=FCB addr hi
002B72r 2               ; ---------------------------------------------------------------------------
002B72r 2               file_open:
002B72r 2  A5 rr                LDA     tmp1
002B74r 2  A4 rr                LDY     tmp1+1
002B76r 2  A2 0F                LDX     #PEM_OPEN
002B78r 2  20 03 01             JSR     PEM_ENTRY
002B7Br 2  60                   RTS
002B7Cr 2               
002B7Cr 2               ; ---------------------------------------------------------------------------
002B7Cr 2               ; file_make — create/truncate file via FCB at tmp1
002B7Cr 2               ; ---------------------------------------------------------------------------
002B7Cr 2               file_make:
002B7Cr 2  A5 rr                LDA     tmp1
002B7Er 2  A4 rr                LDY     tmp1+1
002B80r 2  A2 16                LDX     #PEM_MAKE
002B82r 2  20 03 01             JSR     PEM_ENTRY
002B85r 2  60                   RTS
002B86r 2               
002B86r 2               ; ---------------------------------------------------------------------------
002B86r 2               ; file_read_sector — read 128 bytes into DMA_BUF; returns A=0 ok, A=1 EOF
002B86r 2               ; ---------------------------------------------------------------------------
002B86r 2               file_read_sector:
002B86r 2  A5 rr                LDA     tmp1
002B88r 2  A4 rr                LDY     tmp1+1
002B8Ar 2  A2 14                LDX     #PEM_READ
002B8Cr 2  20 03 01             JSR     PEM_ENTRY
002B8Fr 2  60                   RTS
002B90r 2               
002B90r 2               ; ---------------------------------------------------------------------------
002B90r 2               ; file_write_sector — write 128 bytes from DMA_BUF
002B90r 2               ; ---------------------------------------------------------------------------
002B90r 2               file_write_sector:
002B90r 2  A5 rr                LDA     tmp1
002B92r 2  A4 rr                LDY     tmp1+1
002B94r 2  A2 15                LDX     #PEM_WRITE
002B96r 2  20 03 01             JSR     PEM_ENTRY
002B99r 2  60                   RTS
002B9Ar 2               
002B9Ar 2               ; ---------------------------------------------------------------------------
002B9Ar 2               ; file_close — close FCB at tmp1
002B9Ar 2               ; ---------------------------------------------------------------------------
002B9Ar 2               file_close:
002B9Ar 2  A5 rr                LDA     tmp1
002B9Cr 2  A4 rr                LDY     tmp1+1
002B9Er 2  A2 10                LDX     #PEM_CLOSE
002BA0r 2  20 03 01             JSR     PEM_ENTRY
002BA3r 2  60                   RTS
002BA4r 2               
002BA4r 2               ; ---------------------------------------------------------------------------
002BA4r 2               ; file_setdma — point PEM at the 128-byte buffer at (A:Y)
002BA4r 2               ; A = lo, Y = hi.  Trashes X.
002BA4r 2               ; ---------------------------------------------------------------------------
002BA4r 2               file_setdma:
002BA4r 2  A2 1A                LDX     #PEM_SETDMA
002BA6r 2  4C 03 01             JMP     PEM_ENTRY
002BA9r 2               
002BA9r 2               ; ---------------------------------------------------------------------------
002BA9r 2               ; file_setdma_default — restore PEM DMA pointer to system DMA_BUF
002BA9r 2               ; ---------------------------------------------------------------------------
002BA9r 2               file_setdma_default:
002BA9r 2  A9 28                LDA     #<DMA_BUF
002BABr 2  A0 01                LDY     #>DMA_BUF
002BADr 2  A2 1A                LDX     #PEM_SETDMA
002BAFr 2  4C 03 01             JMP     PEM_ENTRY
002BB2r 2               
002BB2r 1                       .include        "MESSAGES.ASM"
002BB2r 2               ; messages.asm — compiler error and status strings (null-terminated)
002BB2r 2               
002BB2r 2                       .segment  "CODE"
002BB2r 2               
002BB2r 2               msg_banner:
002BB2r 2  50 61 73 63          .BYTE   "Pascal/65 Compiler v0.1 for DOS/65",13,10,0
002BB6r 2  61 6C 2F 36  
002BBAr 2  35 20 43 6F  
002BD7r 2               msg_compiling:
002BD7r 2  43 6F 6D 70          .BYTE   "Compiling...",13,10,0
002BDBr 2  69 6C 69 6E  
002BDFr 2  67 2E 2E 2E  
002BE6r 2               msg_ok:
002BE6r 2  4F 4B 0D 0A          .BYTE   "OK",13,10,0
002BEAr 2  00           
002BEBr 2               msg_errors:
002BEBr 2  20 65 72 72          .BYTE   " error(s)",13,10,0
002BEFr 2  6F 72 28 73  
002BF3r 2  29 0D 0A 00  
002BF7r 2               msg_line:
002BF7r 2  20 4C 69 6E          .BYTE   " Line ",0
002BFBr 2  65 20 00     
002BFEr 2               msg_col:
002BFEr 2  20 43 6F 6C          .BYTE   " Col ",0
002C02r 2  20 00        
002C04r 2               
002C04r 2               ; Compiler errors
002C04r 2               err_unexpected:
002C04r 2  55 6E 65 78          .BYTE   "Unexpected token",0
002C08r 2  70 65 63 74  
002C0Cr 2  65 64 20 74  
002C15r 2               err_expected_id:
002C15r 2  49 44 45 4E          .byte   "IDENTIFIER expected",0
002C19r 2  54 49 46 49  
002C1Dr 2  45 52 20 65  
002C29r 2               err_expected_eq:
002C29r 2  27 3D 27 20          .byte   "'=' expected",0
002C2Dr 2  65 78 70 65  
002C31r 2  63 74 65 64  
002C36r 2               err_expected_sm:
002C36r 2  27 3B 27 20          .byte   "';' expected",0
002C3Ar 2  65 78 70 65  
002C3Er 2  63 74 65 64  
002C43r 2               err_expected_be:
002C43r 2  27 42 45 47          .byte   "'BEGIN' expected",0
002C47r 2  49 4E 27 20  
002C4Br 2  65 78 70 65  
002C54r 2               err_expected_en:
002C54r 2  27 45 4E 44          .byte "'END' expected",0
002C58r 2  27 20 65 78  
002C5Cr 2  70 65 63 74  
002C63r 2               err_expected_do:
002C63r 2  27 44 4F 27          .byte "'DO' expected",0
002C67r 2  20 65 78 70  
002C6Br 2  65 63 74 65  
002C71r 2               err_expected_of:
002C71r 2  27 4F 46 27          .byte "'OF' expected",0
002C75r 2  20 65 78 70  
002C79r 2  65 63 74 65  
