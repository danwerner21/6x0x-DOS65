001D48r 2  4C rr rr             JMP     @rel_done
001D4Br 2               @rel_geq:
001D4Br 2  20 rr rr             JSR     next_token
001D4Er 2  20 rr rr             JSR     parse_simple_expr
001D51r 2  20 rr rr             JSR     emit_GEQI
001D54r 2               @rel_done:
001D54r 2  A9 03                LDA     #TY_BOOL
001D56r 2  85 rr                STA     expr_type
001D58r 2  60                   RTS
001D59r 2               
001D59r 2               ; ---------------------------------------------------------------------------
001D59r 2               ; parse_simple_expr — term { (+|-|OR) term }
001D59r 2               ; ---------------------------------------------------------------------------
001D59r 2               parse_simple_expr:
001D59r 2               ; check for unary minus
001D59r 2  A5 rr                LDA     tok_type
001D5Br 2  C9 11                CMP     #TOK_MINUS
001D5Dr 2  D0 0E                BNE     :+
001D5Fr 2  20 rr rr             JSR     next_token
001D62r 2  20 rr rr             JSR     parse_term
001D65r 2  20 rr rr             JSR     emit_NGI
001D68r 2  A9 01                LDA     #TY_INT
001D6Ar 2  85 rr                STA     expr_type
001D6Cr 2  60                   RTS
001D6Dr 2               :
001D6Dr 2  20 rr rr             JSR     parse_term
001D70r 2               @addop:
001D70r 2  A5 rr                LDA     tok_type
001D72r 2  C9 10                CMP     #TOK_PLUS
001D74r 2  F0 09                BEQ     @add
001D76r 2  C9 11                CMP     #TOK_MINUS
001D78r 2  F0 25                BEQ     @sub
001D7Ar 2  C9 52                CMP     #TOK_OR
001D7Cr 2  F0 44                BEQ     @or
001D7Er 2  60                   RTS
001D7Fr 2               @add:
001D7Fr 2  A5 rr                LDA     expr_type
001D81r 2  48                   PHA
001D82r 2  20 rr rr             JSR     next_token
001D85r 2  20 rr rr             JSR     parse_term
001D88r 2  68                   PLA
001D89r 2  C9 09                CMP     #TY_SET
001D8Br 2  F0 09                BEQ     @add_set
001D8Dr 2  20 rr rr             JSR     emit_ADI
001D90r 2  A9 01                LDA     #TY_INT
001D92r 2  85 rr                STA     expr_type
001D94r 2  80 DA                BRA     @addop
001D96r 2               @add_set:
001D96r 2  20 rr rr             JSR     emit_LOR
001D99r 2  A9 09                LDA     #TY_SET
001D9Br 2  85 rr                STA     expr_type
001D9Dr 2  80 D1                BRA     @addop
001D9Fr 2               @sub:
001D9Fr 2  A5 rr                LDA     expr_type
001DA1r 2  48                   PHA
001DA2r 2  20 rr rr             JSR     next_token
001DA5r 2  20 rr rr             JSR     parse_term
001DA8r 2  68                   PLA
001DA9r 2  C9 09                CMP     #TY_SET
001DABr 2  F0 09                BEQ     @sub_set
001DADr 2  20 rr rr             JSR     emit_SBI
001DB0r 2  A9 01                LDA     #TY_INT
001DB2r 2  85 rr                STA     expr_type
001DB4r 2  80 BA                BRA     @addop
001DB6r 2               @sub_set:
001DB6r 2  20 rr rr             JSR     emit_BNOT
001DB9r 2  20 rr rr             JSR     emit_LAND
001DBCr 2  A9 09                LDA     #TY_SET
001DBEr 2  85 rr                STA     expr_type
001DC0r 2  80 AE                BRA     @addop
001DC2r 2               @or:
001DC2r 2  20 rr rr             JSR     next_token
001DC5r 2  20 rr rr             JSR     parse_term
001DC8r 2  20 rr rr             JSR     emit_LOR
001DCBr 2  A9 03                LDA     #TY_BOOL
001DCDr 2  85 rr                STA     expr_type
001DCFr 2  80 9F                BRA     @addop
001DD1r 2               
001DD1r 2               ; ---------------------------------------------------------------------------
001DD1r 2               ; parse_term — factor { (*|DIV|MOD|AND) factor }
001DD1r 2               ; ---------------------------------------------------------------------------
001DD1r 2               parse_term:
001DD1r 2  20 rr rr             JSR     parse_factor
001DD4r 2               @mulop:
001DD4r 2  A5 rr                LDA     tok_type
001DD6r 2  C9 12                CMP     #TOK_STAR
001DD8r 2  F0 11                BEQ     @mul
001DDAr 2  C9 45                CMP     #TOK_DIV
001DDCr 2  F0 2D                BEQ     @div
001DDEr 2  C9 45                CMP     #TOK_DIV_KW
001DE0r 2  F0 29                BEQ     @div
001DE2r 2  C9 4E                CMP     #TOK_MOD_KW
001DE4r 2  F0 34                BEQ     @mod
001DE6r 2  C9 40                CMP     #TOK_AND
001DE8r 2  F0 3F                BEQ     @and
