002452r 2  A5 rr                LDA     tok_type
002454r 2  C9 1F                CMP     #TOK_COMMA
002456r 2  F0 0A                BEQ     @cat_more
002458r 2               ; Single-arg CONCAT — just leave the string on the stack (rare/edge case).
002458r 2  A9 1C                LDA     #TOK_RPAREN
