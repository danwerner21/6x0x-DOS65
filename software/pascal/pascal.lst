00176Dr 2               @just_nl:
00176Dr 2  4C rr rr             JMP     emit_WRITLN
001770r 2               
001770r 2               @chk_read:
001770r 2               ; "READ" (4)
001770r 2  AD rr rr             LDA     ident_buf+1
001773r 2  C9 52                CMP     #'R'
001775r 2  D0 31                BNE     @lookup_sym_jmp
001777r 2  20 rr rr             JSR     next_token
00177Ar 2  20 rr rr             JSR     parse_read_args
00177Dr 2  E0 00                CPX     #0
00177Fr 2  F0 03                BEQ     @r_done
001781r 2  20 rr rr             JSR     emit_POP                ; discard leftover file ptr
001784r 2               @r_done:
001784r 2  60                   RTS
001785r 2               
001785r 2               @chk_readln:
001785r 2               ; "READLN" (6).  Console: read each var.  File: read each var, then skip EOL.
001785r 2  20 rr rr             JSR     next_token
001788r 2  A5 rr                LDA     tok_type
00178Ar 2  C9 1B                CMP     #TOK_LPAREN
00178Cr 2  D0 0A                BNE     @rd_done
00178Er 2  20 rr rr             JSR     parse_read_args
001791r 2  E0 00                CPX     #0
001793r 2  F0 03                BEQ     @rd_done
001795r 2  20 rr rr             JSR     emit_FRDLN              ; consumes file ptr, skips to EOL
001798r 2               @rd_done:
001798r 2  60                   RTS
001799r 2               
001799r 2               @chk_assign:
001799r 2               ; "ASSIGN" (6)
001799r 2  4C rr rr             JMP     parse_builtin_assign
00179Cr 2               @chk_append:
00179Cr 2               ; "APPEND" (6)
00179Cr 2  4C rr rr             JMP     parse_builtin_append
