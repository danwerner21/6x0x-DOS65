00187Er 2  C9 1A                CMP     #TOK_ASSIGN
001880r 2  D0 03                BNE     :+
001882r 2  20 rr rr             JSR     next_token
001885r 2  20 rr rr     :       JSR     parse_expression
001888r 2  AD rr rr             LDA     sym_save_type
00188Br 2  20 rr rr             JSR     coerce_expr_to_target_type
00188Er 2  AD rr rr             LDA     sym_save_scope
001891r 2  D0 0C                BNE     @local_store
