00190Cr 2               @rec_la_dot:
00190Cr 2               ; Chained LHS: TOS = &cur_record_base. Walk into nested records as long
00190Cr 2               ; as the field is RECORD-typed and another '.' follows; the final scalar
00190Cr 2               ; field becomes the STIND target.
00190Cr 2  AD rr rr             LDA     sym_save_vmask
00190Fr 2  8D rr rr             STA     fcall_vmask     ; cur first_field
001912r 2  AD rr rr             LDA     sym_save_lsize
001915r 2  8D rr rr             STA     fcall_lsize     ; cur field count
001918r 2               @rla_chain:
001918r 2               ; consume '.'
001918r 2  A5 rr                LDA     tok_type
00191Ar 2  C9 22                CMP     #TOK_DOT
00191Cr 2  D0 03                BNE     :+
00191Er 2  20 rr rr             JSR     next_token
001921r 2               :
001921r 2               ; look up field name in current record
001921r 2  AD rr rr             LDA     fcall_vmask
001924r 2  AE rr rr             LDX     fcall_lsize
001927r 2  20 rr rr             JSR     field_lookup_in_record
00192Ar 2  B0 03                BCS     :+
00192Cr 2  4C rr rr             JMP     @rec_la_undef
00192Fr 2               :
00192Fr 2               ; A=offset, X=type, tmp3=matched index
00192Fr 2  48                   PHA
001930r 2  8A                   TXA
001931r 2  8D rr rr             STA     field_chain_type
001934r 2  A5 rr                LDA     tmp3
001936r 2  AA                   TAX
001937r 2  BD rr rr             LDA     field_nested_first,x
00193Ar 2  8D rr rr             STA     field_chain_first
00193Dr 2  BD rr rr             LDA     field_nested_count,x
001940r 2  8D rr rr             STA     field_chain_count
001943r 2  68                   PLA
001944r 2  F0 06                BEQ     @rla_no_off
001946r 2  20 rr rr             JSR     emit_LDCI
001949r 2  20 rr rr             JSR     emit_ADI
00194Cr 2               @rla_no_off:
00194Cr 2  20 rr rr             JSR     next_token      ; consume field name
00194Fr 2               ; If field is RECORD and next is '.', chain another level
00194Fr 2  AD rr rr             LDA     field_chain_type
001952r 2  C9 06                CMP     #TY_RECORD
001954r 2  D0 14                BNE     @rla_leaf
001956r 2  A5 rr                LDA     tok_type
001958r 2  C9 22                CMP     #TOK_DOT
00195Ar 2  D0 0E                BNE     @rla_leaf
00195Cr 2  AD rr rr             LDA     field_chain_first
00195Fr 2  8D rr rr             STA     fcall_vmask
001962r 2  AD rr rr             LDA     field_chain_count
001965r 2  8D rr rr             STA     fcall_lsize
001968r 2  80 AE                BRA     @rla_chain
00196Ar 2               @rla_leaf:
00196Ar 2               ; expect ':='; TOS holds &leaf_field
00196Ar 2  A5 rr                LDA     tok_type
00196Cr 2  C9 1A                CMP     #TOK_ASSIGN
00196Er 2  D0 03                BNE     :+
001970r 2  20 rr rr             JSR     next_token
001973r 2               :
001973r 2  AD rr rr             LDA     field_chain_type
001976r 2  48                   PHA
001977r 2  20 rr rr             JSR     parse_expression
00197Ar 2  68                   PLA
00197Br 2  20 rr rr             JSR     coerce_expr_to_target_type
00197Er 2  20 rr rr             JSR     emit_STIND
001981r 2  60                   RTS
001982r 2               @rec_la_undef:
001982r 2  A9 rr                LDA     #<err_undef
001984r 2  85 rr                STA     tmp0
001986r 2  A9 rr                LDA     #>err_undef
001988r 2  85 rr                STA     tmp0+1
00198Ar 2  20 rr rr             JSR     compile_error
00198Dr 2  60                   RTS
00198Er 2               
00198Er 2               @ptr_deref_assign:
00198Er 2               ; p^ := expr  — push p's value (the heap address), parse RHS, then STIND.
00198Er 2               ; sym_save_scope/off identify the pointer variable.
00198Er 2  AD rr rr             LDA     sym_save_scope
001991r 2  D0 0D                BNE     @pda_local
001993r 2  AD rr rr             LDA     sym_save_off+1
001996r 2  85 rr                STA     scratch
001998r 2  AD rr rr             LDA     sym_save_off
00199Br 2  20 rr rr             JSR     emit_LDG                ; push pointer value (addr)
00199Er 2  80 06                BRA     @pda_after_load
0019A0r 2               @pda_local:
0019A0r 2  AD rr rr             LDA     sym_save_off
0019A3r 2  20 rr rr             JSR     emit_LDL                ; push pointer value (addr)
0019A6r 2               @pda_after_load:
0019A6r 2  20 rr rr             JSR     next_token              ; consume '^'
0019A9r 2  A5 rr                LDA     tok_type
0019ABr 2  C9 1A                CMP     #TOK_ASSIGN
0019ADr 2  D0 03                BNE     :+
0019AFr 2  20 rr rr             JSR     next_token              ; consume ':='
0019B2r 2  20 rr rr     :       JSR     parse_expression        ; push RHS value
0019B5r 2  20 rr rr             JSR     emit_STIND              ; *(addr) := value
0019B8r 2  60                   RTS
0019B9r 2               
0019B9r 2               @do_call:
0019B9r 2               ; Phase B: value parameters (INTEGER words, 2 bytes each).
0019B9r 2               ; sym_save_off       = proc's code address
0019B9r 2               ; sym_save_pcount    = declared parameter count
0019B9r 2               ;
0019B9r 2               ; Calling sequence emitted:
0019B9r 2               ;   for each arg i:
0019B9r 2               ;       <expr>                   ; pushes value to TOS (uses CALLER's MP)
0019B9r 2               ;   MRKA <pcount> <lsize_extra>  ; reframe + gather args into local slots
0019B9r 2               ;   CALL <proc>                  ; jump (saves IPC into AR)
0019B9r 2               ;
0019B9r 2               ; Args are evaluated BEFORE MRKA so any LDL/LDA_L inside arg expressions
0019B9r 2               ; reads the caller's frame.  MRKA then shifts the pcount values up by
0019B9r 2               ; AR_LOCALS so they land at local slots 0..pcount-1 of the new frame.
0019B9r 2               ; The procedure body reads params via LDL because they were added to the
0019B9r 2               ; symbol table as SYM_VAR with scope=inner (proc) at offsets 0, 2, 4, ...
0019B9r 2  20 rr rr             JSR     next_token      ; consume the proc-name identifier
0019BCr 2               ; if no params, optionally consume "()" then emit MRKA + CALL
0019BCr 2  AD rr rr             LDA     sym_save_pcount
0019BFr 2  F0 4B                BEQ     @no_args
0019C1r 2               ; expect '(' for arg list
0019C1r 2  A5 rr                LDA     tok_type
0019C3r 2  C9 1B                CMP     #TOK_LPAREN
0019C5r 2  D0 57                BNE     @emit_call      ; missing '(' — caller mistake; emit anyway
0019C7r 2  20 rr rr             JSR     next_token      ; consume '('
0019CAr 2  A2 00                LDX     #0              ; X = current arg index
0019CCr 2               @arg_loop:
0019CCr 2               ; If sym_save_vmask bit X is set, this arg is VAR (push address).
0019CCr 2               ; Otherwise parse_expression (push value).
0019CCr 2  DA                   PHX
0019CDr 2  A9 01                LDA     #1
0019CFr 2               @vbit:
0019CFr 2  E0 00                CPX     #0
0019D1r 2  F0 04                BEQ     @vdone
0019D3r 2  0A                   ASL
0019D4r 2  CA                   DEX
0019D5r 2  80 F8                BRA     @vbit
0019D7r 2               @vdone:
0019D7r 2  FA                   PLX                     ; restore loop counter
0019D8r 2  2D rr rr             AND     sym_save_vmask
0019DBr 2  F0 07                BEQ     @arg_value
0019DDr 2  DA                   PHX
0019DEr 2  20 rr rr             JSR     parse_arg_lvalue
0019E1r 2  FA                   PLX
0019E2r 2  80 0B                BRA     @arg_stored
0019E4r 2               @arg_value:
0019E4r 2  DA                   PHX
0019E5r 2  20 rr rr             JSR     parse_expression
0019E8r 2  FA                   PLX
0019E9r 2  BD rr rr             LDA     sym_param_types,x
0019ECr 2  20 rr rr             JSR     coerce_expr_to_target_type
0019EFr 2               @arg_stored:
0019EFr 2               ; Value (or address for VAR) left on stack — MRKA gathers later.
0019EFr 2  E8                   INX
0019F0r 2  EC rr rr             CPX     sym_save_pcount
0019F3r 2  B0 0C                BCS     @done_args      ; X >= pcount — done
0019F5r 2               ; expect comma between args
0019F5r 2  A5 rr                LDA     tok_type
0019F7r 2  C9 1F                CMP     #TOK_COMMA
0019F9r 2  D0 06                BNE     @done_args
0019FBr 2  20 rr rr             JSR     next_token      ; consume ','
0019FEr 2  4C rr rr             JMP     @arg_loop       ; jmp — body grew past bra range
001A01r 2               @done_args:
001A01r 2  A5 rr                LDA     tok_type
001A03r 2  C9 1C                CMP     #TOK_RPAREN
001A05r 2  D0 17                BNE     @emit_call
001A07r 2  20 rr rr             JSR     next_token      ; consume ')'
001A0Ar 2  80 12                BRA     @emit_call
001A0Cr 2               @no_args:
001A0Cr 2               ; No declared params — accept and skip "()" if present.
001A0Cr 2  A5 rr                LDA     tok_type
001A0Er 2  C9 1B                CMP     #TOK_LPAREN
001A10r 2  D0 0C                BNE     @emit_call
001A12r 2  20 rr rr             JSR     next_token      ; consume '('
001A15r 2  A5 rr                LDA     tok_type
001A17r 2  C9 1C                CMP     #TOK_RPAREN
001A19r 2  D0 03                BNE     @emit_call
001A1Br 2  20 rr rr             JSR     next_token      ; consume ')'
001A1Er 2               @emit_call:
001A1Er 2               ; Emit MRKA <pcount> <lsize_extra>; lsize_extra = sym_save_lsize - 2*pcount.
001A1Er 2  AD rr rr             LDA     sym_save_lsize
001A21r 2  38                   SEC
001A22r 2  ED rr rr             SBC     sym_save_pcount
001A25r 2  ED rr rr             SBC     sym_save_pcount
001A28r 2  AA                   TAX                     ; X = lsize_extra (body locals only)
001A29r 2  AD rr rr             LDA     sym_save_pcount ; A = pcount
001A2Cr 2  20 rr rr             JSR     emit_MRKA
001A2Fr 2               ; Emit CALL <delta>: A=target lo, scratch=target hi
001A2Fr 2  AD rr rr             LDA     sym_save_off
001A32r 2  0D rr rr             ORA     sym_save_off+1
001A35r 2  D0 0B                BNE     :+
001A37r 2  A9 rr                LDA     #<err_undef
001A39r 2  85 rr                STA     tmp0
001A3Br 2  A9 rr                LDA     #>err_undef
001A3Dr 2  85 rr                STA     tmp0+1
001A3Fr 2  20 rr rr             JSR     compile_error
001A42r 2  AD rr rr     :       LDA     sym_save_off+1
001A45r 2  85 rr                STA     scratch
001A47r 2  AD rr rr             LDA     sym_save_off
001A4Ar 2  20 rr rr             JSR     emit_CALL
001A4Dr 2  60                   RTS
001A4Er 2               
001A4Er 2               ; ---------------------------------------------------------------------------
001A4Er 2               ; parse_write_args — WRITE/WRITELN argument list.
001A4Er 2               ;   Returns X=0 if console mode (caller emits WRITLN normally),
001A4Er 2               ;           X=1 if file mode (file ptr left on stack — caller emits FWLN
001A4Er 2               ;               or POP to consume it).
001A4Er 2               ; ---------------------------------------------------------------------------
001A4Er 2               parse_write_args:
001A4Er 2  A5 rr                LDA     tok_type
001A50r 2  C9 1B                CMP     #TOK_LPAREN
001A52r 2  D0 2F                BNE     @done_console
001A54r 2  20 rr rr             JSR     next_token              ; consume '('
001A57r 2  A5 rr                LDA     tok_type
001A59r 2  C9 1C                CMP     #TOK_RPAREN
001A5Br 2  F0 1D                BEQ     @close_console
001A5Dr 2  20 rr rr             JSR     parse_expression        ; parse first arg
001A60r 2               ; If first arg is TY_TEXT, switch to file mode (leave file ptr on stack).
001A60r 2  A5 rr                LDA     expr_type
001A62r 2  C9 08                CMP     #TY_TEXT
001A64r 2  F0 20                BEQ     @file_mode
001A66r 2               ; Console mode — emit appropriate WRIT* for first arg, then loop.
001A66r 2  20 rr rr             JSR     pw_emit_console
001A69r 2               @cons_loop:
001A69r 2  A5 rr                LDA     tok_type
001A6Br 2  C9 1F                CMP     #TOK_COMMA
001A6Dr 2  D0 0B                BNE     @close_console
001A6Fr 2  20 rr rr             JSR     next_token              ; consume ','
001A72r 2  20 rr rr             JSR     parse_expression
001A75r 2  20 rr rr             JSR     pw_emit_console
001A78r 2  80 EF                BRA     @cons_loop
001A7Ar 2               @close_console:
001A7Ar 2  A5 rr                LDA     tok_type
001A7Cr 2  C9 1C                CMP     #TOK_RPAREN
001A7Er 2  D0 03                BNE     :+
001A80r 2  20 rr rr             JSR     next_token              ; consume ')'
001A83r 2               :
001A83r 2               @done_console:
001A83r 2  A2 00                LDX     #0
001A85r 2  60                   RTS
001A86r 2               
001A86r 2               @file_mode:
001A86r 2               @file_loop:
001A86r 2  A5 rr                LDA     tok_type
001A88r 2  C9 1F                CMP     #TOK_COMMA
001A8Ar 2  D0 0E                BNE     @close_file
001A8Cr 2  20 rr rr             JSR     next_token              ; consume ','
001A8Fr 2  20 rr rr             JSR     emit_DUP                ; dup file ptr (consumed by FWRX)
001A92r 2  20 rr rr             JSR     parse_expression        ; arg on top of stack
001A95r 2  20 rr rr             JSR     pw_emit_file
001A98r 2  80 EC                BRA     @file_loop
001A9Ar 2               @close_file:
001A9Ar 2  A5 rr                LDA     tok_type
001A9Cr 2  C9 1C                CMP     #TOK_RPAREN
001A9Er 2  D0 03                BNE     :+
001AA0r 2  20 rr rr             JSR     next_token              ; consume ')'
001AA3r 2               :
001AA3r 2  A2 01                LDX     #1
001AA5r 2  60                   RTS
001AA6r 2               
001AA6r 2               ; pw_emit_console — emit WRITS/WRITC/WRITB/WRITI based on expr_type
001AA6r 2               pw_emit_console:
001AA6r 2  A5 rr                LDA     expr_type
001AA8r 2  C9 04                CMP     #TY_STRING
001AAAr 2  D0 03                BNE     :+
001AACr 2  4C rr rr             JMP     emit_WRITS
001AAFr 2               :
001AAFr 2  C9 02                CMP     #TY_CHAR
001AB1r 2  D0 03                BNE     :+
001AB3r 2  4C rr rr             JMP     emit_WRITC
001AB6r 2               :
001AB6r 2  C9 03                CMP     #TY_BOOL
001AB8r 2  D0 03                BNE     :+
001ABAr 2  4C rr rr             JMP     emit_WRITB
001ABDr 2               :
001ABDr 2  C9 0A                CMP     #TY_REAL
001ABFr 2  D0 03                BNE     :+
001AC1r 2  4C rr rr             JMP     emit_WRITR
001AC4r 2               :
001AC4r 2  4C rr rr             JMP     emit_WRITI
001AC7r 2               
001AC7r 2               ; pw_emit_file — emit FWRS/FWRC/FWRB/FWRI based on expr_type
001AC7r 2               pw_emit_file:
001AC7r 2  A5 rr                LDA     expr_type
001AC9r 2  C9 04                CMP     #TY_STRING
001ACBr 2  D0 03                BNE     :+
001ACDr 2  4C rr rr             JMP     emit_FWRS
001AD0r 2               :
001AD0r 2  C9 02                CMP     #TY_CHAR
001AD2r 2  D0 03                BNE     :+
001AD4r 2  4C rr rr             JMP     emit_FWRC
001AD7r 2               :
001AD7r 2  C9 03                CMP     #TY_BOOL
001AD9r 2  D0 03                BNE     :+
001ADBr 2  4C rr rr             JMP     emit_FWRB
001ADEr 2               :
001ADEr 2  C9 0A                CMP     #TY_REAL
001AE0r 2  D0 03                BNE     :+
001AE2r 2  4C rr rr             JMP     emit_FWRR
001AE5r 2               :
001AE5r 2  4C rr rr             JMP     emit_FWRI
001AE8r 2               
001AE8r 2               ; emit_console_read_arg — current token must be an IDENT naming the target
001AE8r 2               ; variable. CHAR targets compile as:
001AE8r 2               ;   <addr> READC STIND
001AE8r 2               ; so the zero-extended character from OP_READC is stored into the variable's
001AE8r 2               ; 2-byte cell. Everything else currently uses READI.
001AE8r 2               emit_console_read_arg:
001AE8r 2  20 rr rr             JSR     symtab_find
001AEBr 2  90 1E                BCC     @cra_int
001AEDr 2  A0 11                LDY     #17
001AEFr 2  B1 rr                LDA     (tmp3),y
001AF1r 2  C9 0A                CMP     #TY_REAL
001AF3r 2  D0 09                BNE     :+
001AF5r 2  20 rr rr             JSR     parse_arg_lvalue
001AF8r 2  20 rr rr             JSR     emit_READR
001AFBr 2  4C rr rr             JMP     emit_STIND
001AFEr 2               :
001AFEr 2  C9 02                CMP     #TY_CHAR
001B00r 2  D0 09                BNE     @cra_int
001B02r 2  20 rr rr             JSR     parse_arg_lvalue
001B05r 2  20 rr rr             JSR     emit_READC
001B08r 2  4C rr rr             JMP     emit_STIND
001B0Br 2               @cra_int:
001B0Br 2  20 rr rr             JSR     parse_arg_lvalue
001B0Er 2  4C rr rr             JMP     emit_READI
001B11r 2               
001B11r 2               ; ---------------------------------------------------------------------------
001B11r 2               ; parse_read_args — READ/READLN argument list.  Each argument must be a
001B11r 2               ; variable identifier. Console mode dispatches by target type:
001B11r 2               ;   CHAR    -> READC + STIND
001B11r 2               ;   default -> READI
001B11r 2               ; File mode still routes through FRDC / FRDS / FRDI based on target type.
001B11r 2               ; ---------------------------------------------------------------------------
001B11r 2               parse_read_args:
001B11r 2  A5 rr                LDA     tok_type
001B13r 2  C9 1B                CMP     #TOK_LPAREN
001B15r 2  D0 3A                BNE     @rdone_console
001B17r 2  20 rr rr             JSR     next_token              ; consume '('
001B1Ar 2  A5 rr                LDA     tok_type
001B1Cr 2  C9 1C                CMP     #TOK_RPAREN
001B1Er 2  F0 28                BEQ     @rclose_console
001B20r 2  C9 01                CMP     #TOK_IDENT
001B22r 2  D0 24                BNE     @rclose_console
001B24r 2               ; Peek: is the first ident a TY_TEXT variable?
001B24r 2  20 rr rr             JSR     symtab_find
001B27r 2  90 08                BCC     @cons_first
001B29r 2  A0 11                LDY     #17
001B2Br 2  B1 rr                LDA     (tmp3),y
001B2Dr 2  C9 08                CMP     #TY_TEXT
001B2Fr 2  F0 23                BEQ     @file_first
001B31r 2               @cons_first:
001B31r 2  20 rr rr             JSR     emit_console_read_arg
001B34r 2               @cons_loop:
001B34r 2  A5 rr                LDA     tok_type
001B36r 2  C9 1F                CMP     #TOK_COMMA
001B38r 2  D0 0E                BNE     @rclose_console
001B3Ar 2  20 rr rr             JSR     next_token
001B3Dr 2  A5 rr                LDA     tok_type
001B3Fr 2  C9 01                CMP     #TOK_IDENT
001B41r 2  D0 05                BNE     @rclose_console
001B43r 2  20 rr rr             JSR     emit_console_read_arg
001B46r 2  80 EC                BRA     @cons_loop
001B48r 2               @rclose_console:
001B48r 2  A5 rr                LDA     tok_type
001B4Ar 2  C9 1C                CMP     #TOK_RPAREN
001B4Cr 2  D0 03                BNE     :+
001B4Er 2  20 rr rr             JSR     next_token              ; consume ')'
001B51r 2               :
001B51r 2               @rdone_console:
001B51r 2  A2 00                LDX     #0
001B53r 2  60                   RTS
001B54r 2               
001B54r 2               @file_first:
001B54r 2               ; Push the file ptr (struct address) by parsing the ident as an expression —
001B54r 2               ; for TY_TEXT this emits LDA_G/LDA_L which pushes the struct's address.
001B54r 2  20 rr rr             JSR     parse_expression
001B57r 2               @file_loop:
001B57r 2  A5 rr                LDA     tok_type
001B59r 2  C9 1F                CMP     #TOK_COMMA
001B5Br 2  D0 4A                BNE     @close_file
001B5Dr 2  20 rr rr             JSR     next_token              ; consume ','
001B60r 2  A5 rr                LDA     tok_type
001B62r 2  C9 01                CMP     #TOK_IDENT
001B64r 2  D0 41                BNE     @close_file
001B66r 2               ; Peek var type so we know whether to emit FRDC, FRDS, or FRDI.
001B66r 2  20 rr rr             JSR     symtab_find
001B69r 2  90 31                BCC     @file_int_default
001B6Br 2  A0 11                LDY     #17
001B6Dr 2  B1 rr                LDA     (tmp3),y
001B6Fr 2  C9 02                CMP     #TY_CHAR
001B71r 2  D0 0B                BNE     @file_chk_str
001B73r 2  20 rr rr             JSR     emit_DUP                ; dup file ptr
001B76r 2  20 rr rr             JSR     parse_arg_lvalue
001B79r 2  20 rr rr             JSR     emit_FRDC
001B7Cr 2  80 D9                BRA     @file_loop
001B7Er 2               @file_chk_str:
001B7Er 2  C9 04                CMP     #TY_STRING
001B80r 2  D0 0B                BNE     @file_chk_real
001B82r 2  20 rr rr             JSR     emit_DUP                ; dup file ptr
001B85r 2  20 rr rr             JSR     parse_arg_lvalue
001B88r 2  20 rr rr             JSR     emit_FRDS
001B8Br 2  80 CA                BRA     @file_loop
001B8Dr 2               @file_chk_real:
001B8Dr 2  C9 0A                CMP     #TY_REAL
001B8Fr 2  D0 0B                BNE     @file_int_default
001B91r 2  20 rr rr             JSR     emit_DUP                ; dup file ptr
001B94r 2  20 rr rr             JSR     parse_arg_lvalue
001B97r 2  20 rr rr             JSR     emit_FRDR
001B9Ar 2  80 BB                BRA     @file_loop
001B9Cr 2               @file_int_default:
001B9Cr 2  20 rr rr             JSR     emit_DUP                ; dup file ptr
001B9Fr 2  20 rr rr             JSR     parse_arg_lvalue
001BA2r 2  20 rr rr             JSR     emit_FRDI
001BA5r 2  80 B0                BRA     @file_loop
001BA7r 2               @close_file:
001BA7r 2  A5 rr                LDA     tok_type
001BA9r 2  C9 1C                CMP     #TOK_RPAREN
001BABr 2  D0 03                BNE     :+
001BADr 2  20 rr rr             JSR     next_token              ; consume ')'
001BB0r 2               :
001BB0r 2  A2 01                LDX     #1
001BB2r 2  60                   RTS
001BB3r 2               
001BB3r 2               ; ---------------------------------------------------------------------------
001BB3r 2               ; parse_if — IF expr THEN stmt [ ELSE stmt ]
001BB3r 2               ; ---------------------------------------------------------------------------
001BB3r 2               parse_if:
001BB3r 2  20 rr rr             JSR     next_token      ; consume IF
001BB6r 2  20 rr rr             JSR     parse_expression
001BB9r 2               ; emit FJP with placeholder; save patch addr on 6502 stack
001BB9r 2               ; (parse_statement will clobber tmp2 / scratch)
001BB9r 2  20 rr rr             JSR     emit_FJP        ; A=patch_lo, scratch=patch_hi
001BBCr 2  48                   PHA                     ; save FJP patch lo
001BBDr 2  A5 rr                LDA     scratch
001BBFr 2  48                   PHA                     ; save FJP patch hi
001BC0r 2               ; THEN
001BC0r 2  A5 rr                LDA     tok_type
001BC2r 2  C9 58                CMP     #TOK_THEN
001BC4r 2  D0 03                BNE     :+
001BC6r 2  20 rr rr             JSR     next_token
001BC9r 2               :
001BC9r 2  20 rr rr             JSR     parse_statement
001BCCr 2               ; check for ELSE
001BCCr 2  A5 rr                LDA     tok_type
001BCEr 2  C9 48                CMP     #TOK_ELSE
001BD0r 2  D0 28                BNE     @patch_then
001BD2r 2               ; emit UJP over else branch
001BD2r 2  20 rr rr             JSR     emit_UJP        ; A=patch_lo, scratch=patch_hi
001BD5r 2  48                   PHA                     ; save UJP patch lo
001BD6r 2  A5 rr                LDA     scratch
001BD8r 2  48                   PHA                     ; save UJP patch hi
001BD9r 2               ; restore FJP patch addr into tmp2 and patch it to here
001BD9r 2               ; (need to dig under the UJP entries on the stack)
001BD9r 2               ; stack top → bottom: UJP_hi, UJP_lo, FJP_hi, FJP_lo
001BD9r 2  68                   PLA                     ; UJP hi
001BDAr 2  AA                   TAX
001BDBr 2  68                   PLA                     ; UJP lo
001BDCr 2  A8                   TAY
001BDDr 2  68                   PLA                     ; FJP hi
001BDEr 2  85 rr                STA     tmp2+1
001BE0r 2  68                   PLA                     ; FJP lo
001BE1r 2  85 rr                STA     tmp2
001BE3r 2  20 rr rr             JSR     patch_jump      ; patch FJP → start of else branch
001BE6r 2               ; push UJP patch addr back for after-else patching
001BE6r 2  98                   TYA                     ; UJP lo
001BE7r 2  48                   PHA
001BE8r 2  8A                   TXA                     ; UJP hi
001BE9r 2  48                   PHA
001BEAr 2  20 rr rr             JSR     next_token      ; consume ELSE
001BEDr 2  20 rr rr             JSR     parse_statement
001BF0r 2               ; patch UJP to here
001BF0r 2  68                   PLA                     ; UJP hi
001BF1r 2  85 rr                STA     tmp2+1
001BF3r 2  68                   PLA                     ; UJP lo
001BF4r 2  85 rr                STA     tmp2
001BF6r 2  20 rr rr             JSR     patch_jump
001BF9r 2  60                   RTS
001BFAr 2               @patch_then:
001BFAr 2               ; no ELSE — restore FJP patch addr and patch to here
001BFAr 2  68                   PLA                     ; FJP hi
001BFBr 2  85 rr                STA     tmp2+1
001BFDr 2  68                   PLA                     ; FJP lo
001BFEr 2  85 rr                STA     tmp2
001C00r 2  20 rr rr             JSR     patch_jump
001C03r 2  60                   RTS
001C04r 2               
001C04r 2               ; ---------------------------------------------------------------------------
001C04r 2               ; parse_while — WHILE expr DO stmt
001C04r 2               ; ---------------------------------------------------------------------------
001C04r 2               parse_while:
001C04r 2  20 rr rr             JSR     next_token      ; consume WHILE
001C07r 2               ; save loop top
001C07r 2  A5 rr                LDA     cg_pc
001C09r 2  85 rr                STA     tmp2
001C0Br 2  A5 rr                LDA     cg_pc+1
001C0Dr 2  85 rr                STA     tmp2+1
001C0Fr 2               ; we'll need loop_top later; save on 6502 stack
001C0Fr 2  A5 rr                LDA     tmp2+1
001C11r 2  48                   PHA
001C12r 2  A5 rr                LDA     tmp2
001C14r 2  48                   PHA
001C15r 2  20 rr rr             JSR     parse_expression
001C18r 2  20 rr rr             JSR     emit_FJP        ; exit if false
001C1Br 2  48                   PHA
001C1Cr 2  A5 rr                LDA     scratch
001C1Er 2  48                   PHA
001C1Fr 2               ; DO
001C1Fr 2  A5 rr                LDA     tok_type
001C21r 2  C9 46                CMP     #TOK_DO
001C23r 2  D0 03                BNE     :+
001C25r 2  20 rr rr             JSR     next_token
001C28r 2               :
001C28r 2  20 rr rr             JSR     parse_statement
001C2Br 2               ; emit UJP back to loop top
001C2Br 2  A9 50                LDA     #OP_UJP
001C2Dr 2  20 rr rr             JSR     emit_byte
001C30r 2               ; offset = loop_top - (cg_pc + 2)
001C30r 2  68                   PLA
001C31r 2  85 rr                STA     tmp3            ; FJP patch hi
001C33r 2  68                   PLA
001C34r 2  85 rr                STA     tmp3+1          ; FJP patch lo — note: reversed from earlier push
001C36r 2               ; compute back-edge offset
001C36r 2  68                   PLA                     ; loop_top lo
001C37r 2  85 rr                STA     tmp2
001C39r 2  68                   PLA                     ; loop_top hi
001C3Ar 2  85 rr                STA     tmp2+1
001C3Cr 2               ; delta = loop_top - (cg_pc + 2)
001C3Cr 2  38                   SEC
001C3Dr 2  A5 rr                LDA     tmp2
001C3Fr 2  E5 rr                SBC     cg_pc
001C41r 2  85 rr                STA     scratch
001C43r 2  A5 rr                LDA     tmp2+1
001C45r 2  E5 rr                SBC     cg_pc+1
001C47r 2  85 rr                STA     scratch+1
001C49r 2  A5 rr                LDA     scratch
001C4Br 2  38                   SEC
001C4Cr 2  E9 02                SBC     #2
001C4Er 2  85 rr                STA     scratch
001C50r 2  B0 02                BCS     :+
001C52r 2  C6 rr                DEC     scratch+1
001C54r 2               :
001C54r 2  A5 rr                LDA     scratch
001C56r 2  20 rr rr             JSR     emit_byte
001C59r 2  A5 rr                LDA     scratch+1
001C5Br 2  20 rr rr             JSR     emit_byte
001C5Er 2               ; patch FJP exit
001C5Er 2               ; tmp3+1:tmp3 holds FJP patch addr (note push order was lo,hi → pla gets hi first)
001C5Er 2               ; Rebuild properly:
001C5Er 2  A5 rr                LDA     tmp3+1
001C60r 2  85 rr                STA     tmp2
001C62r 2  A5 rr                LDA     tmp3
001C64r 2  85 rr                STA     tmp2+1
001C66r 2  20 rr rr             JSR     patch_jump
001C69r 2  60                   RTS
001C6Ar 2               
001C6Ar 2               ; ---------------------------------------------------------------------------
001C6Ar 2               ; parse_for — FOR id := expr TO|DOWNTO expr DO stmt
001C6Ar 2               ;
001C6Ar 2               ; Codegen layout:
001C6Ar 2               ;   <init>:   parse expr1; STG/STL var
001C6Ar 2               ;             parse expr2; STG hidden_global   (limit, evaluated once)
001C6Ar 2               ;   loop_top: LDG/LDL var; LDG hidden_global
001C6Ar 2               ;             LEQI (TO) | GEQI (DOWNTO)
001C6Ar 2               ;             FJP exit
001C6Ar 2               ;             <body>
001C6Ar 2               ;             LDG/LDL var; LDCI 1; ADI|SBI; STG/STL var
001C6Ar 2               ;             UJP loop_top
001C6Ar 2               ;   exit:
001C6Ar 2               ;
001C6Ar 2               ; State on 6502 stack across body:
001C6Ar 2               ;   var_off_lo, var_off_hi, var_scope, dir, lim_off_hi, lim_off_lo
001C6Ar 2               ; for_loop_top / for_patch live in zp (FOR is not nestable in this build).
001C6Ar 2               ; ---------------------------------------------------------------------------
001C6Ar 2               parse_for:
001C6Ar 2  20 rr rr             JSR     next_token      ; consume FOR
001C6Dr 2               
001C6Dr 2  A5 rr                LDA     tok_type
001C6Fr 2  C9 01                CMP     #TOK_IDENT
001C71r 2  F0 01                BEQ     :+
001C73r 2  60                   RTS                     ; not an ident — silently bail
001C74r 2               :
001C74r 2  20 rr rr             JSR     symtab_find
001C77r 2  B0 04                BCS     :+
001C79r 2  20 rr rr             JSR     next_token      ; consume the bad ident
001C7Cr 2  60                   RTS
001C7Dr 2               :
001C7Dr 2               ; snapshot var info into sym_save_*
001C7Dr 2  A0 14                LDY     #20
001C7Fr 2  B1 rr                LDA     (tmp3),y
001C81r 2  8D rr rr             STA     sym_save_scope
001C84r 2  A0 12                LDY     #18
001C86r 2  B1 rr                LDA     (tmp3),y
001C88r 2  8D rr rr             STA     sym_save_off
001C8Br 2  A0 13                LDY     #19
001C8Dr 2  B1 rr                LDA     (tmp3),y
001C8Fr 2  8D rr rr             STA     sym_save_off+1
001C92r 2  20 rr rr             JSR     next_token      ; consume identifier
001C95r 2               
001C95r 2               ; push var info: scope, off_hi, off_lo (top)
001C95r 2  AD rr rr             LDA     sym_save_scope
001C98r 2  48                   PHA
001C99r 2  AD rr rr             LDA     sym_save_off+1
001C9Cr 2  48                   PHA
001C9Dr 2  AD rr rr             LDA     sym_save_off
001CA0r 2  48                   PHA
001CA1r 2               
001CA1r 2               ; ':='
001CA1r 2  A5 rr                LDA     tok_type
001CA3r 2  C9 1A                CMP     #TOK_ASSIGN
001CA5r 2  D0 03                BNE     :+
001CA7r 2  20 rr rr             JSR     next_token
001CAAr 2               :
001CAAr 2  20 rr rr             JSR     parse_expression; initial value on TOS
001CADr 2               
001CADr 2               ; restore sym_save_* (parse_expression may have clobbered them)
001CADr 2  68                   PLA
001CAEr 2  8D rr rr             STA     sym_save_off
001CB1r 2  68                   PLA
001CB2r 2  8D rr rr             STA     sym_save_off+1
001CB5r 2  68                   PLA
001CB6r 2  8D rr rr             STA     sym_save_scope
001CB9r 2  20 rr rr             JSR     for_emit_store_var
001CBCr 2               
001CBCr 2               ; re-push var info for use after loop
001CBCr 2  AD rr rr             LDA     sym_save_scope
001CBFr 2  48                   PHA
001CC0r 2  AD rr rr             LDA     sym_save_off+1
001CC3r 2  48                   PHA
001CC4r 2  AD rr rr             LDA     sym_save_off
001CC7r 2  48                   PHA
001CC8r 2               
001CC8r 2               ; direction byte: 0 = TO, 1 = DOWNTO
001CC8r 2  A9 00                LDA     #0
001CCAr 2  A6 rr                LDX     tok_type
001CCCr 2  E0 47                CPX     #TOK_DOWNTO
001CCEr 2  D0 02                BNE     :+
001CD0r 2  A9 01                LDA     #1
001CD2r 2               :
001CD2r 2  48                   PHA                     ; push dir
001CD3r 2  20 rr rr             JSR     next_token      ; consume TO / DOWNTO
001CD6r 2               
001CD6r 2               ; parse limit expression and store to a hidden global
001CD6r 2  20 rr rr             JSR     parse_expression
001CD9r 2  20 rr rr             JSR     codegen_alloc_global; tmp2 = hidden offset
001CDCr 2               ; push the offset NOW — emit_STG will clobber tmp2
001CDCr 2  A5 rr                LDA     tmp2+1
001CDEr 2  48                   PHA                     ; lim_hi
001CDFr 2  A5 rr                LDA     tmp2
001CE1r 2  48                   PHA                     ; lim_lo (top)
001CE2r 2               ; reload from stack peek for emit_STG (A = lo, scratch = hi)
001CE2r 2  BA                   TSX
001CE3r 2  BD 02 01             LDA     $0102,x
001CE6r 2  85 rr                STA     scratch
001CE8r 2  BD 01 01             LDA     $0101,x
001CEBr 2  20 rr rr             JSR     emit_STG
001CEEr 2               
001CEEr 2               ; consume DO
001CEEr 2  A5 rr                LDA     tok_type
001CF0r 2  C9 46                CMP     #TOK_DO
001CF2r 2  D0 03                BNE     :+
001CF4r 2  20 rr rr             JSR     next_token
001CF7r 2               :
001CF7r 2               ; --- loop top ---
001CF7r 2  A5 rr                LDA     cg_pc
001CF9r 2  85 rr                STA     for_loop_top
001CFBr 2  A5 rr                LDA     cg_pc+1
001CFDr 2  85 rr                STA     for_loop_top+1
001CFFr 2               
001CFFr 2               ; emit LDG/LDL var — restore sym_save_* via TSX peek
001CFFr 2               ; stack from top: lim_lo, lim_hi, dir, var_lo, var_hi, var_scope
001CFFr 2  BA                   TSX
001D00r 2  BD 04 01             LDA     $0104,x         ; var_lo
001D03r 2  8D rr rr             STA     sym_save_off
001D06r 2  BD 05 01             LDA     $0105,x         ; var_hi
001D09r 2  8D rr rr             STA     sym_save_off+1
001D0Cr 2  BD 06 01             LDA     $0106,x         ; var_scope
001D0Fr 2  8D rr rr             STA     sym_save_scope
001D12r 2  20 rr rr             JSR     for_emit_load_var
001D15r 2               
001D15r 2               ; emit LDG limit — limit hi at $0102,x, lo at $0101,x
001D15r 2  BA                   TSX
001D16r 2  BD 02 01             LDA     $0102,x
001D19r 2  85 rr                STA     scratch
001D1Br 2  BD 01 01             LDA     $0101,x
001D1Er 2  20 rr rr             JSR     emit_LDG
001D21r 2               
001D21r 2               ; comparison: TO → LEQI (var <= limit), DOWNTO → GEQI
001D21r 2  BA                   TSX
001D22r 2  BD 03 01             LDA     $0103,x         ; dir
001D25r 2  F0 05                BEQ     @cmp_to
001D27r 2  20 rr rr             JSR     emit_GEQI
001D2Ar 2  80 03                BRA     @cmp_done
001D2Cr 2               @cmp_to:
001D2Cr 2  20 rr rr             JSR     emit_LEQI
001D2Fr 2               @cmp_done:
001D2Fr 2               
001D2Fr 2               ; FJP exit placeholder
001D2Fr 2  20 rr rr             JSR     emit_FJP        ; A=patch_lo, scratch=patch_hi
001D32r 2  85 rr                STA     for_patch
001D34r 2  A5 rr                LDA     scratch
001D36r 2  85 rr                STA     for_patch+1
001D38r 2               
001D38r 2               ; --- body ---
001D38r 2  20 rr rr             JSR     parse_statement
001D3Br 2               
001D3Br 2               ; --- pop state in reverse push order ---
001D3Br 2  68                   PLA                     ; lim_lo (discard)
001D3Cr 2  68                   PLA                     ; lim_hi (discard)
001D3Dr 2  68                   PLA                     ; direction
001D3Er 2  8D rr rr             STA     sym_save_kind   ; reuse for direction storage
001D41r 2  68                   PLA                     ; var_lo
001D42r 2  8D rr rr             STA     sym_save_off
001D45r 2  68                   PLA                     ; var_hi
001D46r 2  8D rr rr             STA     sym_save_off+1
001D49r 2  68                   PLA                     ; var_scope
001D4Ar 2  8D rr rr             STA     sym_save_scope
001D4Dr 2               
001D4Dr 2               ; emit increment / decrement: LDG var, LDCI 1, ADI|SBI, STG var
001D4Dr 2  20 rr rr             JSR     for_emit_load_var
001D50r 2  A9 01                LDA     #1
001D52r 2  20 rr rr             JSR     emit_LDCI
001D55r 2  AD rr rr             LDA     sym_save_kind   ; direction
001D58r 2  F0 05                BEQ     @inc
001D5Ar 2  20 rr rr             JSR     emit_SBI
001D5Dr 2  80 03                BRA     @inc_done
001D5Fr 2               @inc:
001D5Fr 2  20 rr rr             JSR     emit_ADI
001D62r 2               @inc_done:
001D62r 2  20 rr rr             JSR     for_emit_store_var
001D65r 2               
001D65r 2               ; emit UJP back to loop_top
001D65r 2               ; offset = for_loop_top - (cg_pc_after_opcode + 2)
001D65r 2  A9 50                LDA     #OP_UJP
001D67r 2  20 rr rr             JSR     emit_byte
001D6Ar 2  38                   SEC
001D6Br 2  A5 rr                LDA     for_loop_top
001D6Dr 2  E5 rr                SBC     cg_pc
001D6Fr 2  85 rr                STA     scratch
001D71r 2  A5 rr                LDA     for_loop_top+1
001D73r 2  E5 rr                SBC     cg_pc+1
001D75r 2  85 rr                STA     scratch+1
001D77r 2  38                   SEC
001D78r 2  A5 rr                LDA     scratch
001D7Ar 2  E9 02                SBC     #2
001D7Cr 2  85 rr                STA     scratch
001D7Er 2  B0 02                BCS     :+
001D80r 2  C6 rr                DEC     scratch+1
001D82r 2               :
001D82r 2  A5 rr                LDA     scratch
001D84r 2  20 rr rr             JSR     emit_byte
001D87r 2  A5 rr                LDA     scratch+1
001D89r 2  20 rr rr             JSR     emit_byte
001D8Cr 2               
001D8Cr 2               ; patch FJP exit
001D8Cr 2  A5 rr                LDA     for_patch
001D8Er 2  85 rr                STA     tmp2
001D90r 2  A5 rr                LDA     for_patch+1
001D92r 2  85 rr                STA     tmp2+1
001D94r 2  20 rr rr             JSR     patch_jump
001D97r 2  60                   RTS
001D98r 2               
001D98r 2               ; ---------------------------------------------------------------------------
001D98r 2               ; for_emit_load_var / for_emit_store_var — emit LDG/LDL or STG/STL based on
001D98r 2               ; sym_save_scope (0 = global) and sym_save_off (offset).
001D98r 2               ; ---------------------------------------------------------------------------
001D98r 2               for_emit_load_var:
001D98r 2  AD rr rr             LDA     sym_save_scope
001D9Br 2  D0 0B                BNE     @local
001D9Dr 2  AD rr rr             LDA     sym_save_off+1
001DA0r 2  85 rr                STA     scratch
001DA2r 2  AD rr rr             LDA     sym_save_off
001DA5r 2  4C rr rr             JMP     emit_LDG
001DA8r 2               @local:
001DA8r 2  AD rr rr             LDA     sym_save_off
001DABr 2  4C rr rr             JMP     emit_LDL
001DAEr 2               
001DAEr 2               for_emit_store_var:
001DAEr 2  AD rr rr             LDA     sym_save_scope
001DB1r 2  D0 0B                BNE     @local
001DB3r 2  AD rr rr             LDA     sym_save_off+1
001DB6r 2  85 rr                STA     scratch
001DB8r 2  AD rr rr             LDA     sym_save_off
001DBBr 2  4C rr rr             JMP     emit_STG
001DBEr 2               @local:
001DBEr 2  AD rr rr             LDA     sym_save_off
001DC1r 2  4C rr rr             JMP     emit_STL
001DC4r 2               
001DC4r 2               ; ---------------------------------------------------------------------------
001DC4r 2               ; parse_repeat — REPEAT stmt { ; stmt } UNTIL expr
001DC4r 2               ; ---------------------------------------------------------------------------
001DC4r 2               parse_repeat:
001DC4r 2  20 rr rr             JSR     next_token      ; consume REPEAT
001DC7r 2               ; save top
001DC7r 2  A5 rr                LDA     cg_pc
001DC9r 2  48                   PHA
001DCAr 2  A5 rr                LDA     cg_pc+1
001DCCr 2  48                   PHA
001DCDr 2               @loop:
001DCDr 2  A5 rr                LDA     tok_type
001DCFr 2  C9 5B                CMP     #TOK_UNTIL
001DD1r 2  F0 12                BEQ     @until
001DD3r 2  C9 00                CMP     #TOK_EOF
001DD5r 2  F0 41                BEQ     @done
001DD7r 2  20 rr rr             JSR     parse_statement
001DDAr 2  A5 rr                LDA     tok_type
001DDCr 2  C9 20                CMP     #TOK_SEMICOLON
001DDEr 2  D0 ED                BNE     @loop
001DE0r 2  20 rr rr             JSR     next_token
001DE3r 2  80 E8                BRA     @loop
001DE5r 2               @until:
001DE5r 2  20 rr rr             JSR     next_token      ; consume UNTIL
001DE8r 2  20 rr rr             JSR     parse_expression
001DEBr 2               ; FJP back to top
001DEBr 2  A9 51                LDA     #OP_FJP
001DEDr 2  20 rr rr             JSR     emit_byte
001DF0r 2  68                   PLA
001DF1r 2  85 rr                STA     tmp2+1
001DF3r 2  68                   PLA
001DF4r 2  85 rr                STA     tmp2
001DF6r 2  38                   SEC
001DF7r 2  A5 rr                LDA     tmp2
001DF9r 2  E5 rr                SBC     cg_pc
001DFBr 2  85 rr                STA     scratch
001DFDr 2  A5 rr                LDA     tmp2+1
001DFFr 2  E5 rr                SBC     cg_pc+1
001E01r 2  85 rr                STA     scratch+1
001E03r 2  A5 rr                LDA     scratch
001E05r 2  38                   SEC
001E06r 2  E9 02                SBC     #2
001E08r 2  85 rr                STA     scratch
001E0Ar 2  B0 02                BCS     :+
001E0Cr 2  C6 rr                DEC     scratch+1
001E0Er 2               :
001E0Er 2  A5 rr                LDA     scratch
001E10r 2  20 rr rr             JSR     emit_byte
001E13r 2  A5 rr                LDA     scratch+1
001E15r 2  20 rr rr             JSR     emit_byte
001E18r 2               @done:
001E18r 2  60                   RTS
001E19r 2               
001E19r 2               ; ---------------------------------------------------------------------------
001E19r 2               ; REAL / INTEGER coercion helpers
001E19r 2               ; ---------------------------------------------------------------------------
001E19r 2               
001E19r 2               emit_promote_tos_int_to_real:
001E19r 2  A9 64                LDA     #100
001E1Br 2  20 rr rr             JSR     emit_LDCI
001E1Er 2  4C rr rr             JMP     emit_MPI
001E21r 2               
001E21r 2               emit_promote_tos_real_to_int:
001E21r 2  A9 64                LDA     #100
001E23r 2  20 rr rr             JSR     emit_LDCI
001E26r 2  4C rr rr             JMP     emit_DVI
001E29r 2               
001E29r 2               emit_promote_nos_int_to_real:
001E29r 2  20 rr rr             JSR     emit_SWAP
001E2Cr 2  20 rr rr             JSR     emit_promote_tos_int_to_real
001E2Fr 2  4C rr rr             JMP     emit_SWAP
001E32r 2               
001E32r 2               emit_promote_nos_real_to_int:
001E32r 2  20 rr rr             JSR     emit_SWAP
001E35r 2  20 rr rr             JSR     emit_promote_tos_real_to_int
001E38r 2  4C rr rr             JMP     emit_SWAP
001E3Br 2               
001E3Br 2               ; coerce_expr_to_target_type — A=target TY_*, expr_type=current TOS type.
001E3Br 2               ; Only INTEGER<->REAL coercions are performed; other combinations are left as-is.
001E3Br 2               coerce_expr_to_target_type:
001E3Br 2  AA                   TAX
001E3Cr 2  E0 0A                CPX     #TY_REAL
001E3Er 2  F0 05                BEQ     @cett_real
001E40r 2  E0 01                CPX     #TY_INT
001E42r 2  F0 0F                BEQ     @cett_int
001E44r 2  60                   RTS
001E45r 2               @cett_real:
001E45r 2  A5 rr                LDA     expr_type
001E47r 2  C9 01                CMP     #TY_INT
001E49r 2  D0 07                BNE     @cett_done
001E4Br 2  20 rr rr             JSR     emit_promote_tos_int_to_real
001E4Er 2  A9 0A                LDA     #TY_REAL
001E50r 2  85 rr                STA     expr_type
001E52r 2               @cett_done:
001E52r 2  60                   RTS
001E53r 2               @cett_int:
001E53r 2  A5 rr                LDA     expr_type
001E55r 2  C9 0A                CMP     #TY_REAL
001E57r 2  D0 07                BNE     @cett_done2
001E59r 2  20 rr rr             JSR     emit_promote_tos_real_to_int
001E5Cr 2  A9 01                LDA     #TY_INT
001E5Er 2  85 rr                STA     expr_type
001E60r 2               @cett_done2:
001E60r 2  60                   RTS
001E61r 2               
001E61r 2               ; coerce_binary_numeric_types — A=lhs type, expr_type=rhs type.
001E61r 2               ; Promotes one INTEGER operand to REAL when the other side is REAL.
001E61r 2               ; Returns A=result type (TY_INT or TY_REAL).
001E61r 2               coerce_binary_numeric_types:
001E61r 2  C9 0A                CMP     #TY_REAL
001E63r 2  F0 09                BEQ     @cbnt_lhs_real
