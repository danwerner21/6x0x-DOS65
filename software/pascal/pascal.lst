0015FCr 2  A9 00                LDA     #0
0015FEr 2               @big_int:
0015FEr 2  85 rr                STA     scratch
001600r 2  68                   PLA
001601r 2  20 rr rr             JSR     emit_LDCW
001604r 2  20 rr rr             JSR     next_token
001607r 2  A9 01                LDA     #TY_INT
001609r 2  85 rr                STA     expr_type
00160Br 2  60                   RTS
00160Cr 2               
00160Cr 2               @char_lit:
00160Cr 2  A5 rr                LDA     tok_ival_lo
