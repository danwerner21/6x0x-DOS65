0013CCr 2               @str_lit:
0013CCr 2               ; Inline string: emit OP_LDCS + length + chars.  Runtime pushes the
0013CCr 2               ; address of the length byte as a Pascal-string pointer.
0013CCr 2  20 rr rr             JSR     emit_LDCS
0013CFr 2  20 rr rr             JSR     next_token
0013D2r 2  A9 04                LDA     #TY_STRING
0013D4r 2  85 rr                STA     expr_type
0013D6r 2  60                   RTS
0013D7r 2               
0013D7r 2               @ident_or_call:
0013D7r 2               ; First check for string built-ins (LENGTH/POS/COPY/CONCAT) by length+initial.
0013D7r 2               ; These take precedence over user identifiers (matching WRITE/READ handling
0013D7r 2               ; in parse_assign_or_call).
0013D7r 2  AD rr rr             LDA     ident_buf
0013DAr 2  C9 03                CMP     #3
0013DCr 2  F0 0A                BEQ     @bi_chk_pos
0013DEr 2  C9 04                CMP     #4
0013E0r 2  F0 1E                BEQ     @bi_chk_copy
0013E2r 2  C9 06                CMP     #6
0013E4r 2  F0 39                BEQ     @bi_chk_len_or_cat
0013E6r 2  80 64                BRA     @do_lookup
0013E8r 2               @bi_chk_pos:
0013E8r 2  AD rr rr             LDA     ident_buf+1
0013EBr 2  C9 50                CMP     #'P'
0013EDr 2  D0 5D                BNE     @do_lookup
0013EFr 2  AD rr rr             LDA     ident_buf+2
0013F2r 2  C9 4F                CMP     #'O'
0013F4r 2  D0 56                BNE     @do_lookup
0013F6r 2  AD rr rr             LDA     ident_buf+3
0013F9r 2  C9 53                CMP     #'S'
0013FBr 2  D0 4F                BNE     @do_lookup
0013FDr 2  4C rr rr             JMP     parse_builtin_pos
001400r 2               @bi_chk_copy:
001400r 2  AD rr rr             LDA     ident_buf+1
001403r 2  C9 43                CMP     #'C'
001405r 2  D0 45                BNE     @do_lookup
001407r 2  AD rr rr             LDA     ident_buf+2
00140Ar 2  C9 4F                CMP     #'O'
00140Cr 2  D0 3E                BNE     @do_lookup
00140Er 2  AD rr rr             LDA     ident_buf+3
001411r 2  C9 50                CMP     #'P'
001413r 2  D0 37                BNE     @do_lookup
001415r 2  AD rr rr             LDA     ident_buf+4
001418r 2  C9 59                CMP     #'Y'
00141Ar 2  D0 30                BNE     @do_lookup
00141Cr 2  4C rr rr             JMP     parse_builtin_copy
00141Fr 2               @bi_chk_len_or_cat:
00141Fr 2  AD rr rr             LDA     ident_buf+1
001422r 2  C9 4C                CMP     #'L'
001424r 2  F0 15                BEQ     @bi_try_length
001426r 2  C9 43                CMP     #'C'
001428r 2  D0 22                BNE     @do_lookup
00142Ar 2               ; CONCAT? check 'O','N','C','A','T'
00142Ar 2  AD rr rr             LDA     ident_buf+2
00142Dr 2  C9 4F                CMP     #'O'
00142Fr 2  D0 1B                BNE     @do_lookup
001431r 2  AD rr rr             LDA     ident_buf+3
001434r 2  C9 4E                CMP     #'N'
001436r 2  D0 14                BNE     @do_lookup
001438r 2  4C rr rr             JMP     parse_builtin_concat
00143Br 2               @bi_try_length:
00143Br 2  AD rr rr             LDA     ident_buf+2
00143Er 2  C9 45                CMP     #'E'
001440r 2  D0 0A                BNE     @do_lookup
001442r 2  AD rr rr             LDA     ident_buf+3
001445r 2  C9 4E                CMP     #'N'
001447r 2  D0 03                BNE     @do_lookup
001449r 2  4C rr rr             JMP     parse_builtin_length
00144Cr 2               @do_lookup:
00144Cr 2               ; Look up BEFORE next_token — next_token may overwrite ident_buf
00144Cr 2               ; if the following token is an identifier or keyword (e.g. J THEN).
00144Cr 2  20 rr rr             JSR     symtab_find
00144Fr 2  B0 0F                BCS     @sym_ok
001451r 2  20 rr rr             JSR     next_token      ; consume ident
001454r 2  A9 00                LDA     #0
001456r 2  85 rr                STA     scratch
001458r 2  20 rr rr             JSR     emit_LDCW       ; undefined: emit 0
00145Br 2  A9 01                LDA     #TY_INT
00145Dr 2  85 rr                STA     expr_type
00145Fr 2  60                   RTS
001460r 2               @sym_ok:
001460r 2               ; Snapshot kind/type/scope/offset/pcount onto the 6502 stack —
001460r 2               ; sym_save_* would conflict with parse_assign_or_call when this
001460r 2               ; @ident_or_call runs inside a nested parse_expression.
001460r 2  A0 16                LDY     #22
001462r 2  B1 rr                LDA     (tmp3),y
001464r 2  8D rr rr             STA     fcall_vmask     ; (only meaningful for SYM_FUNC)
001467r 2  A0 17                LDY     #23
001469r 2  B1 rr                LDA     (tmp3),y
00146Br 2  8D rr rr             STA     fcall_lsize     ; full local-area size for MRKSTK
00146Er 2  A0 15                LDY     #21
001470r 2  B1 rr                LDA     (tmp3),y
001472r 2  48                   PHA                     ; pcount (deepest)
001473r 2  A0 10                LDY     #16
001475r 2  B1 rr                LDA     (tmp3),y
001477r 2  48                   PHA                     ; kind
001478r 2  A0 11                LDY     #17
00147Ar 2  B1 rr                LDA     (tmp3),y
00147Cr 2  85 rr                STA     expr_type       ; data type code
00147Er 2  A0 14                LDY     #20
001480r 2  B1 rr                LDA     (tmp3),y
001482r 2  48                   PHA                     ; scope
001483r 2  A0 13                LDY     #19
001485r 2  B1 rr                LDA     (tmp3),y
001487r 2  48                   PHA                     ; off hi
001488r 2  A0 12                LDY     #18
00148Ar 2  B1 rr                LDA     (tmp3),y
00148Cr 2  48                   PHA                     ; off lo (top)
00148Dr 2  20 rr rr             JSR     next_token      ; consume ident (may overwrite ident_buf/tmp3)
001490r 2  68                   PLA                     ; off lo
001491r 2  AA                   TAX                     ; X = off lo
001492r 2  68                   PLA                     ; off hi
001493r 2  85 rr                STA     scratch         ; scratch = off hi
001495r 2  68                   PLA                     ; scope
001496r 2  A8                   TAY                     ; Y = scope (preserved across kind test)
001497r 2  68                   PLA                     ; kind
001498r 2  C9 04                CMP     #SYM_FUNC
00149Ar 2  D0 03                BNE     :+
00149Cr 2  4C rr rr             JMP     @sym_func_call
00149Fr 2               :
00149Fr 2  C9 02                CMP     #SYM_CONST
0014A1r 2  D0 03                BNE     :+
0014A3r 2  4C rr rr             JMP     @const_emit
0014A6r 2               :
0014A6r 2  C9 08                CMP     #SYM_VARREF
0014A8r 2  D0 03                BNE     :+
0014AAr 2  4C rr rr             JMP     @varref_load
0014ADr 2               :
0014ADr 2               ; SYM_VAR (default; PROC also falls through here for now)
0014ADr 2  68                   PLA                     ; discard pcount
0014AEr 2  C0 00                CPY     #0
0014B0r 2  D0 1B                BNE     @local_load
0014B2r 2               ; global SYM_VAR — check for array subscript or record field
0014B2r 2  A5 rr                LDA     expr_type
0014B4r 2  C9 05                CMP     #TY_ARRAY
0014B6r 2  F0 09                BEQ     @arr_rhs_global
0014B8r 2  C9 06                CMP     #TY_RECORD
0014BAr 2  F0 0B                BEQ     @rec_rhs_global
0014BCr 2  8A                   TXA
0014BDr 2  20 rr rr             JSR     emit_LDG
0014C0r 2  60                   RTS
0014C1r 2               @arr_rhs_global:
0014C1r 2  8A                   TXA                     ; A=off_lo, scratch=off_hi still valid
0014C2r 2  20 rr rr             JSR     emit_LDA_G
0014C5r 2  80 19                BRA     @arr_rhs_index
0014C7r 2               @rec_rhs_global:
0014C7r 2  8A                   TXA                     ; A=off_lo, scratch=off_hi
0014C8r 2  20 rr rr             JSR     emit_LDA_G
0014CBr 2  80 3D                BRA     @rec_rhs_field
0014CDr 2               @local_load:
0014CDr 2  A5 rr                LDA     expr_type
0014CFr 2  C9 05                CMP     #TY_ARRAY
0014D1r 2  F0 09                BEQ     @arr_rhs_local
0014D3r 2  C9 06                CMP     #TY_RECORD
0014D5r 2  F0 2F                BEQ     @rec_rhs_local
0014D7r 2  8A                   TXA
0014D8r 2  20 rr rr             JSR     emit_LDL
0014DBr 2  60                   RTS
0014DCr 2               @arr_rhs_local:
0014DCr 2  8A                   TXA
0014DDr 2  20 rr rr             JSR     emit_LDA_L
0014E0r 2               @arr_rhs_index:
0014E0r 2               ; parse [index], emit INDEX, LDIND
0014E0r 2  A5 rr                LDA     tok_type
0014E2r 2  C9 1D                CMP     #TOK_LBRACK
0014E4r 2  D0 03                BNE     :+
0014E6r 2  20 rr rr             JSR     next_token
0014E9r 2  20 rr rr     :       JSR     parse_expression    ; clobbers expr_type, scratch, tmp*
0014ECr 2  A5 rr                LDA     tok_type
0014EEr 2  C9 1E                CMP     #TOK_RBRACK
0014F0r 2  D0 03                BNE     :+
0014F2r 2  20 rr rr             JSR     next_token
0014F5r 2  A9 00        :       LDA     #0
0014F7r 2  85 rr                STA     scratch
0014F9r 2  A9 02                LDA     #2
0014FBr 2  20 rr rr             JSR     emit_INDEX
0014FEr 2  20 rr rr             JSR     emit_LDIND
001501r 2  A9 01                LDA     #TY_INT
001503r 2  85 rr                STA     expr_type
001505r 2  60                   RTS
001506r 2               @rec_rhs_local:
001506r 2  8A                   TXA
001507r 2  20 rr rr             JSR     emit_LDA_L
00150Ar 2               @rec_rhs_field:
00150Ar 2               ; consume '.'
00150Ar 2  A5 rr                LDA     tok_type
00150Cr 2  C9 22                CMP     #TOK_DOT
00150Er 2  D0 03                BNE     :+
001510r 2  20 rr rr             JSR     next_token
001513r 2               :
001513r 2               ; field name now in ident_buf — look up
001513r 2  AD rr rr             LDA     fcall_vmask     ; first_field_idx (saved from byte 22)
001516r 2  AE rr rr             LDX     fcall_lsize     ; field_count (saved from byte 23)
001519r 2  20 rr rr             JSR     field_lookup_in_record
00151Cr 2  90 18                BCC     @rec_rhs_nf
00151Er 2  48                   PHA                     ; save offset
00151Fr 2  8A                   TXA
001520r 2  85 rr                STA     scratch         ; save field type (preserved across emits)
001522r 2  68                   PLA                     ; offset back; PLA sets Z for the BEQ below
001523r 2  F0 06                BEQ     @rec_rhs_no_off
001525r 2  20 rr rr             JSR     emit_LDCI
001528r 2  20 rr rr             JSR     emit_ADI
00152Br 2               @rec_rhs_no_off:
00152Br 2  20 rr rr             JSR     next_token      ; consume field name
00152Er 2  20 rr rr             JSR     emit_LDIND
001531r 2  A5 rr                LDA     scratch
001533r 2  85 rr                STA     expr_type       ; field's type drives WRITE dispatch
001535r 2  60                   RTS
001536r 2               @rec_rhs_nf:
001536r 2  A9 rr                LDA     #<err_undef
001538r 2  85 rr                STA     tmp0
00153Ar 2  A9 rr                LDA     #>err_undef
00153Cr 2  85 rr                STA     tmp0+1
00153Er 2  20 rr rr             JSR     compile_error
001541r 2  20 rr rr             JSR     next_token      ; consume bad field name
001544r 2  20 rr rr             JSR     emit_LDIND      ; keep stack balanced
001547r 2  A9 01                LDA     #TY_INT
001549r 2  85 rr                STA     expr_type
00154Br 2  60                   RTS
00154Cr 2               @varref_load:
00154Cr 2               ; SYM_VARREF: local slot holds an address. Emit LDL then LDIND.
00154Cr 2  68                   PLA                     ; discard pcount
00154Dr 2  8A                   TXA
00154Er 2  20 rr rr             JSR     emit_LDL        ; push address from slot
001551r 2  20 rr rr             JSR     emit_LDIND      ; deref → push word
001554r 2  60                   RTS
001555r 2               @const_emit:
001555r 2               ; CONST: offset bytes hold the literal value. X=lo, scratch=hi.
001555r 2  68                   PLA                     ; discard pcount
001556r 2  8A                   TXA
001557r 2  20 rr rr             JSR     emit_LDCW
00155Ar 2  60                   RTS
00155Br 2               @sym_func_call:
00155Br 2               ; SYM_FUNC: emit MRKSTK + arg-stores + CALL.  Result is left on TOS
00155Br 2               ; by op_RETF.  expr_type is the function's return type (already set).
00155Br 2               ; X=off lo, scratch=off hi, top of 6502 stack = pcount.
00155Br 2               ; NOTE: not nest-safe — calling a function inside another function
00155Br 2               ; call's argument list will clobber fcall_*.  TODO: fix later.
00155Br 2  8E rr rr             STX     fcall_lo
00155Er 2  A5 rr                LDA     scratch
001560r 2  8D rr rr             STA     fcall_hi
001563r 2  A5 rr                LDA     expr_type
001565r 2  8D rr rr             STA     fcall_type      ; preserve across parse_expression
001568r 2  68                   PLA                     ; pcount
001569r 2  8D rr rr             STA     fcall_pcount
00156Cr 2               ; emit MRKSTK <full local-area size> (params + body locals).
00156Cr 2               ; fcall_lsize was captured at @sym_ok from entry offset 23.
00156Cr 2  AD rr rr             LDA     fcall_lsize
00156Fr 2  20 rr rr             JSR     emit_MRKSTK
001572r 2  AD rr rr             LDA     fcall_pcount
001575r 2  F0 4A                BEQ     @fc_no_args
001577r 2               ; expect '('
001577r 2  A5 rr                LDA     tok_type
001579r 2  C9 1B                CMP     #TOK_LPAREN
00157Br 2  D0 56                BNE     @fc_emit_call
00157Dr 2  20 rr rr             JSR     next_token      ; consume '('
001580r 2  A2 00                LDX     #0              ; X = arg index
001582r 2               @fc_arg_loop:
001582r 2               ; Bit X of fcall_vmask → VAR (push address); else value.
001582r 2  DA                   PHX
001583r 2  A9 01                LDA     #1
001585r 2               @fcvbit:
001585r 2  E0 00                CPX     #0
001587r 2  F0 04                BEQ     @fcvdone
001589r 2  0A                   ASL
00158Ar 2  CA                   DEX
00158Br 2  80 F8                BRA     @fcvbit
00158Dr 2               @fcvdone:
00158Dr 2  FA                   PLX
00158Er 2  2D rr rr             AND     fcall_vmask
001591r 2  F0 07                BEQ     @fc_arg_value
001593r 2  DA                   PHX
001594r 2  20 rr rr             JSR     parse_arg_lvalue
001597r 2  FA                   PLX
001598r 2  80 05                BRA     @fc_arg_stored
00159Ar 2               @fc_arg_value:
00159Ar 2  DA                   PHX
00159Br 2  20 rr rr             JSR     parse_expression
00159Er 2  FA                   PLX
00159Fr 2               @fc_arg_stored:
00159Fr 2  8A                   TXA
0015A0r 2  0A                   ASL
0015A1r 2  20 rr rr             JSR     emit_STL        ; store popped value (or address) into local slot X
0015A4r 2  E8                   INX
0015A5r 2  EC rr rr             CPX     fcall_pcount
0015A8r 2  B0 0C                BCS     @fc_done_args
0015AAr 2  A5 rr                LDA     tok_type
0015ACr 2  C9 1F                CMP     #TOK_COMMA
0015AEr 2  D0 06                BNE     @fc_done_args
0015B0r 2  20 rr rr             JSR     next_token      ; consume ','
0015B3r 2  4C rr rr             JMP     @fc_arg_loop    ; jmp — body grew past bra range
0015B6r 2               @fc_done_args:
0015B6r 2  A5 rr                LDA     tok_type
0015B8r 2  C9 1C                CMP     #TOK_RPAREN
0015BAr 2  D0 17                BNE     @fc_emit_call
0015BCr 2  20 rr rr             JSR     next_token      ; consume ')'
0015BFr 2  80 12                BRA     @fc_emit_call
0015C1r 2               @fc_no_args:
0015C1r 2               ; Accept optional "()"
0015C1r 2  A5 rr                LDA     tok_type
0015C3r 2  C9 1B                CMP     #TOK_LPAREN
0015C5r 2  D0 0C                BNE     @fc_emit_call
0015C7r 2  20 rr rr             JSR     next_token
0015CAr 2  A5 rr                LDA     tok_type
0015CCr 2  C9 1C                CMP     #TOK_RPAREN
0015CEr 2  D0 03                BNE     @fc_emit_call
0015D0r 2  20 rr rr             JSR     next_token
0015D3r 2               @fc_emit_call:
0015D3r 2  AD rr rr             LDA     fcall_hi
0015D6r 2  85 rr                STA     scratch
0015D8r 2  AD rr rr             LDA     fcall_lo
0015DBr 2  20 rr rr             JSR     emit_CALL
0015DEr 2               ; restore expr_type (parse_expression in args may have changed it)
0015DEr 2  AD rr rr             LDA     fcall_type
0015E1r 2  85 rr                STA     expr_type
0015E3r 2  60                   RTS
0015E4r 2               
0015E4r 2               @paren:
0015E4r 2  20 rr rr             JSR     next_token      ; consume '('
0015E7r 2  20 rr rr             JSR     parse_expression
0015EAr 2  A5 rr                LDA     tok_type
0015ECr 2  C9 1C                CMP     #TOK_RPAREN
0015EEr 2  D0 03                BNE     :+
0015F0r 2  20 rr rr             JSR     next_token
0015F3r 2               :
0015F3r 2  60                   RTS                     ; expr_type already set by parse_expression
0015F4r 2               
0015F4r 2               @not_expr:
0015F4r 2  20 rr rr             JSR     next_token
0015F7r 2  20 rr rr             JSR     parse_factor
0015FAr 2  20 rr rr             JSR     emit_LNOT
0015FDr 2  A9 03                LDA     #TY_BOOL
0015FFr 2  85 rr                STA     expr_type
001601r 2  60                   RTS
001602r 2               
001602r 2               @nil:
001602r 2  20 rr rr             JSR     emit_LDCN
001605r 2  20 rr rr             JSR     next_token
001608r 2  A9 07                LDA     #TY_PTR
00160Ar 2  85 rr                STA     expr_type
00160Cr 2  60                   RTS
00160Dr 2               
00160Dr 2               ; ---------------------------------------------------------------------------
00160Dr 2               ; String built-in helpers — entered from parse_factor's @ident_or_call.
00160Dr 2               ; The identifier is still the current token on entry.
00160Dr 2               ; ---------------------------------------------------------------------------
00160Dr 2               
00160Dr 2               ; Skip current token if it matches A; otherwise just fall through.
00160Dr 2               ; Used to consume optional punctuation like '(' / ')' / ',' without aborting
00160Dr 2               ; on a missing token (compile_error elsewhere will catch malformed code).
00160Dr 2               parse_eat_token:
00160Dr 2  C5 rr                CMP     tok_type
00160Fr 2  D0 03                BNE     :+
001611r 2  4C rr rr             JMP     next_token
001614r 2  60           :       RTS
001615r 2               
001615r 2               parse_builtin_length:
001615r 2  20 rr rr             JSR     next_token              ; consume LENGTH
001618r 2  A9 1B                LDA     #TOK_LPAREN
00161Ar 2  20 rr rr             JSR     parse_eat_token
00161Dr 2  20 rr rr             JSR     parse_expression        ; pushes string ptr
001620r 2  A9 1C                LDA     #TOK_RPAREN
001622r 2  20 rr rr             JSR     parse_eat_token
001625r 2  20 rr rr             JSR     emit_LEN
001628r 2  A9 01                LDA     #TY_INT
00162Ar 2  85 rr                STA     expr_type
00162Cr 2  60                   RTS
00162Dr 2               
00162Dr 2               parse_builtin_pos:
00162Dr 2  20 rr rr             JSR     next_token              ; consume POS
001630r 2  A9 1B                LDA     #TOK_LPAREN
001632r 2  20 rr rr             JSR     parse_eat_token
001635r 2  20 rr rr             JSR     parse_expression        ; substr
001638r 2  A9 1F                LDA     #TOK_COMMA
00163Ar 2  20 rr rr             JSR     parse_eat_token
00163Dr 2  20 rr rr             JSR     parse_expression        ; mainstr
001640r 2  A9 1C                LDA     #TOK_RPAREN
001642r 2  20 rr rr             JSR     parse_eat_token
001645r 2  20 rr rr             JSR     emit_POS
001648r 2  A9 01                LDA     #TY_INT
00164Ar 2  85 rr                STA     expr_type
00164Cr 2  60                   RTS
00164Dr 2               
00164Dr 2               parse_builtin_copy:
00164Dr 2  20 rr rr             JSR     next_token              ; consume COPY
001650r 2  A9 1B                LDA     #TOK_LPAREN
001652r 2  20 rr rr             JSR     parse_eat_token
001655r 2  20 rr rr             JSR     parse_expression        ; src string
001658r 2  A9 1F                LDA     #TOK_COMMA
00165Ar 2  20 rr rr             JSR     parse_eat_token
00165Dr 2  20 rr rr             JSR     parse_expression        ; index
001660r 2  A9 1F                LDA     #TOK_COMMA
001662r 2  20 rr rr             JSR     parse_eat_token
001665r 2  20 rr rr             JSR     parse_expression        ; count
001668r 2  A9 1C                LDA     #TOK_RPAREN
00166Ar 2  20 rr rr             JSR     parse_eat_token
00166Dr 2  20 rr rr             JSR     emit_COPY
001670r 2  A9 04                LDA     #TY_STRING
001672r 2  85 rr                STA     expr_type
001674r 2  60                   RTS
001675r 2               
001675r 2               ; CONCAT(s1, s2 [, s3, ...]) — emit chained CONCAT2.  Each pair-merge writes
001675r 2               ; into the next round-robin work buffer, so 3+ args work as long as the
001675r 2               ; intermediate buffer isn't recycled before being consumed.
001675r 2               parse_builtin_concat:
001675r 2  20 rr rr             JSR     next_token              ; consume CONCAT
001678r 2  A9 1B                LDA     #TOK_LPAREN
00167Ar 2  20 rr rr             JSR     parse_eat_token
00167Dr 2  20 rr rr             JSR     parse_expression        ; first arg on stack
001680r 2  A5 rr                LDA     tok_type
001682r 2  C9 1F                CMP     #TOK_COMMA
001684r 2  F0 0A                BEQ     @cat_more
001686r 2               ; Single-arg CONCAT — just leave the string on the stack (rare/edge case).
001686r 2  A9 1C                LDA     #TOK_RPAREN
001688r 2  20 rr rr             JSR     parse_eat_token
00168Br 2  A9 04                LDA     #TY_STRING
00168Dr 2  85 rr                STA     expr_type
00168Fr 2  60                   RTS
001690r 2               @cat_more:
001690r 2  20 rr rr             JSR     next_token              ; consume ','
001693r 2  20 rr rr             JSR     parse_expression        ; next arg
001696r 2  20 rr rr             JSR     emit_CONCAT             ; merge previous + next
001699r 2  A5 rr                LDA     tok_type
00169Br 2  C9 1F                CMP     #TOK_COMMA
00169Dr 2  F0 F1                BEQ     @cat_more
00169Fr 2  A9 1C                LDA     #TOK_RPAREN
0016A1r 2  20 rr rr             JSR     parse_eat_token
0016A4r 2  A9 04                LDA     #TY_STRING
0016A6r 2  85 rr                STA     expr_type
0016A8r 2  60                   RTS
0016A9r 2               
0016A9r 1                       .include        "SYMTAB.ASM"
0016A9r 2               .PC02
0016A9r 2               ; symtab.asm — symbol table for Pascal/65 compiler
0016A9r 2               ;
0016A9r 2               ; Each entry occupies 16 bytes in the SYMTAB_BASE area:
0016A9r 2               ;   [0]    name length (1-15)
0016A9r 2               ;   [1-15] name chars (uppercase, padded with spaces)
0016A9r 2               ;   [16]   symbol kind: SYM_VAR, SYM_CONST, SYM_PROC, SYM_FUNC, SYM_TYPE, SYM_PARAM
0016A9r 2               ;   [17]   data type:   TY_INT, TY_CHAR, TY_BOOL, TY_STRING, TY_ARRAY, TY_RECORD, TY_PTR
0016A9r 2               ;   [18-19] value/offset (word): variable offset from BASE/MP; const value; proc address
0016A9r 2               ;   [20]   scope depth (0=global)
0016A9r 2               ;   [21]   parameter count (for SYM_PROC/SYM_FUNC)
0016A9r 2               ;   [22-23] type info pointer (for array/record types)
0016A9r 2               ;   [24-31] reserved
0016A9r 2               
0016A9r 2               SYM_ENTRY_SZ    = 32
0016A9r 2               
0016A9r 2               ; Symbol kinds
0016A9r 2               SYM_VAR         = 1
0016A9r 2               SYM_CONST       = 2
0016A9r 2               SYM_PROC        = 3
0016A9r 2               SYM_FUNC        = 4
0016A9r 2               SYM_TYPE        = 5
0016A9r 2               SYM_PARAM       = 6
0016A9r 2               SYM_RETVAL      = 7             ; binding for `funcname := expr` in fn body
0016A9r 2               SYM_VARREF      = 8             ; VAR (by-reference) parameter — local slot holds an address
0016A9r 2               
0016A9r 2               ; Data type codes
0016A9r 2               TY_INT          = 1
0016A9r 2               TY_CHAR         = 2
0016A9r 2               TY_BOOL         = 3
0016A9r 2               TY_STRING       = 4
0016A9r 2               TY_ARRAY        = 5
0016A9r 2               TY_RECORD       = 6
0016A9r 2               TY_PTR          = 7
0016A9r 2               TY_NONE         = 0             ; for procedures
0016A9r 2               
0016A9r 2                       .segment        "CODE"
0016A9r 2               
0016A9r 2               ; Number of entries currently in symbol table
0016A9r 2               symtab_count:
0016A9r 2  00 00                .WORD   0
0016ABr 2               
0016ABr 2               ; ---------------------------------------------------------------------------
0016ABr 2               ; symtab_init — clear symbol table
0016ABr 2               ; ---------------------------------------------------------------------------
0016ABr 2               symtab_init:
0016ABr 2  A9 00                LDA     #0
0016ADr 2  8D rr rr             STA     symtab_count
0016B0r 2  8D rr rr             STA     symtab_count+1
0016B3r 2  8D rr rr             STA     field_table_count
0016B6r 2  60                   RTS
0016B7r 2               
0016B7r 2               ; ---------------------------------------------------------------------------
0016B7r 2               ; field_table_add — append a record-field entry
0016B7r 2               ; Inputs:
0016B7r 2               ;   ident_buf = field name (length at [0], chars at [1..])
0016B7r 2               ;   A         = byte offset within the record
0016B7r 2               ;   X         = field data type (TY_*)
0016B7r 2               ; Returns: A = newly-assigned field index (current count - 1)
0016B7r 2               ;          carry set if field table is full (entry not added)
0016B7r 2               ; Clobbers: tmp2, tmp3, Y
0016B7r 2               ; ---------------------------------------------------------------------------
0016B7r 2               field_table_add:
0016B7r 2  48                   PHA                     ; save offset
0016B8r 2  8A                   TXA
0016B9r 2  48                   PHA                     ; save type
0016BAr 2               ; capacity check (max 32 entries)
0016BAr 2  AD rr rr             LDA     field_table_count
0016BDr 2  C9 20                CMP     #32
0016BFr 2  90 04                BCC     :+
0016C1r 2  68                   PLA                     ; discard type
0016C2r 2  68                   PLA                     ; discard offset
0016C3r 2  38                   SEC
0016C4r 2  60                   RTS
0016C5r 2               :
0016C5r 2               ; compute entry address: field_table + count*16
0016C5r 2  AD rr rr             LDA     field_table_count
0016C8r 2  0A                   ASL
0016C9r 2  0A                   ASL
0016CAr 2  0A                   ASL
0016CBr 2  0A                   ASL                     ; *16 (count<64 fits in 10 bits, but we land in low byte; high carry becomes part of address)
0016CCr 2  85 rr                STA     tmp2
0016CEr 2  A9 00                LDA     #0
0016D0r 2  2A                   ROL                     ; capture carry into hi
0016D1r 2  18                   CLC
0016D2r 2  69 rr                ADC     #>field_table
0016D4r 2  85 rr                STA     tmp2+1
0016D6r 2  A5 rr                LDA     tmp2
0016D8r 2  18                   CLC
0016D9r 2  69 rr                ADC     #<field_table
0016DBr 2  85 rr                STA     tmp2
0016DDr 2  90 02                BCC     :+
0016DFr 2  E6 rr                INC     tmp2+1
0016E1r 2               :
0016E1r 2               ; copy name length + chars
0016E1r 2  A0 00                LDY     #0
0016E3r 2  AD rr rr             LDA     ident_buf
0016E6r 2  91 rr                STA     (tmp2),y
0016E8r 2  AA                   TAX                     ; X = length
0016E9r 2  A0 01                LDY     #1
0016EBr 2               @nm:
0016EBr 2  C0 0D                CPY     #13
0016EDr 2  B0 0D                BCS     @padn
0016EFr 2  E0 00                CPX     #0
0016F1r 2  F0 09                BEQ     @padn
0016F3r 2  B9 rr rr             LDA     ident_buf,y
0016F6r 2  91 rr                STA     (tmp2),y
0016F8r 2  CA                   DEX
0016F9r 2  C8                   INY
0016FAr 2  80 EF                BRA     @nm
0016FCr 2               @padn:
0016FCr 2  C0 0D                CPY     #13
0016FEr 2  B0 07                BCS     @done_nm
001700r 2  A9 20                LDA     #' '
001702r 2  91 rr                STA     (tmp2),y
001704r 2  C8                   INY
001705r 2  80 F5                BRA     @padn
001707r 2               @done_nm:
001707r 2               ; offset (was on stack first → second pull)
001707r 2               ; type   (was on stack last  → first pull)
001707r 2  68                   PLA                     ; type
001708r 2  A0 0E                LDY     #14
00170Ar 2  91 rr                STA     (tmp2),y
00170Cr 2  68                   PLA                     ; offset
00170Dr 2  A0 0D                LDY     #13
00170Fr 2  91 rr                STA     (tmp2),y
001711r 2  A9 00                LDA     #0
001713r 2  A0 0F                LDY     #15
001715r 2  91 rr                STA     (tmp2),y
001717r 2               ; bump count, return new index
001717r 2  AD rr rr             LDA     field_table_count
00171Ar 2  EE rr rr             INC     field_table_count
00171Dr 2  18                   CLC
00171Er 2  60                   RTS
00171Fr 2               
00171Fr 2               ; ---------------------------------------------------------------------------
00171Fr 2               ; field_lookup_in_record — find ident_buf among a contiguous range of fields
00171Fr 2               ; Inputs:
00171Fr 2               ;   ident_buf = field name to find
00171Fr 2               ;   A         = first field index in field_table
00171Fr 2               ;   X         = number of fields to scan
00171Fr 2               ; Returns: carry set = found
00171Fr 2               ;            A = byte offset within record
00171Fr 2               ;            X = field data type
00171Fr 2               ;          carry clear = not found
00171Fr 2               ; Clobbers: tmp2, tmp3, Y
00171Fr 2               ; ---------------------------------------------------------------------------
00171Fr 2               field_lookup_in_record:
00171Fr 2  85 rr                STA     tmp3            ; tmp3 = current field index
001721r 2  86 rr                STX     tmp3+1          ; tmp3+1 = remaining count
001723r 2               @scan:
001723r 2  A5 rr                LDA     tmp3+1
001725r 2  F0 43                BEQ     @nf
001727r 2               ; compute entry addr: field_table + tmp3*16
001727r 2  A5 rr                LDA     tmp3
001729r 2  0A                   ASL
00172Ar 2  0A                   ASL
00172Br 2  0A                   ASL
00172Cr 2  0A                   ASL                     ; *16 (low byte; carry → hi)
00172Dr 2  85 rr                STA     tmp2
00172Fr 2  A9 00                LDA     #0
001731r 2  2A                   ROL
001732r 2  18                   CLC
001733r 2  69 rr                ADC     #>field_table
001735r 2  85 rr                STA     tmp2+1
001737r 2  A5 rr                LDA     tmp2
001739r 2  18                   CLC
00173Ar 2  69 rr                ADC     #<field_table
00173Cr 2  85 rr                STA     tmp2
00173Er 2  90 02                BCC     :+
001740r 2  E6 rr                INC     tmp2+1
001742r 2               :
001742r 2               ; compare name length
001742r 2  A0 00                LDY     #0
001744r 2  B1 rr                LDA     (tmp2),y
001746r 2  CD rr rr             CMP     ident_buf
001749r 2  D0 19                BNE     @next
00174Br 2  AA                   TAX                     ; X = length
00174Cr 2  A0 01                LDY     #1
00174Er 2               @cmpn:
00174Er 2  B1 rr                LDA     (tmp2),y
001750r 2  D9 rr rr             CMP     ident_buf,y
001753r 2  D0 0F                BNE     @next
001755r 2  C8                   INY
001756r 2  CA                   DEX
001757r 2  D0 F5                BNE     @cmpn
001759r 2               ; match — return offset and type
001759r 2  A0 0E                LDY     #14
00175Br 2  B1 rr                LDA     (tmp2),y        ; type
00175Dr 2  AA                   TAX
00175Er 2  A0 0D                LDY     #13
001760r 2  B1 rr                LDA     (tmp2),y        ; offset
001762r 2  38                   SEC
001763r 2  60                   RTS
001764r 2               @next:
001764r 2  E6 rr                INC     tmp3
001766r 2  C6 rr                DEC     tmp3+1
001768r 2  80 B9                BRA     @scan
00176Ar 2               @nf:
00176Ar 2  18                   CLC
00176Br 2  60                   RTS
00176Cr 2               
00176Cr 2               ; ---------------------------------------------------------------------------
00176Cr 2               ; symtab_find — look up ident_buf in symbol table
00176Cr 2               ; Returns: carry set = found (tmp3 = pointer to entry)
00176Cr 2               ;          carry clear = not found
00176Cr 2               ; Searches from newest (highest index) to oldest for proper scoping
00176Cr 2               ; ---------------------------------------------------------------------------
00176Cr 2               symtab_find:
00176Cr 2  AD rr rr             LDA     symtab_count
00176Fr 2  0D rr rr             ORA     symtab_count+1
001772r 2  D0 02                BNE     :+
001774r 2  18                   CLC
001775r 2  60                   RTS                     ; empty table
001776r 2               :
001776r 2               ; start from last entry
001776r 2  AD rr rr             LDA     symtab_count
001779r 2  85 rr                STA     tmp2
00177Br 2  AD rr rr             LDA     symtab_count+1
00177Er 2  85 rr                STA     tmp2+1
001780r 2               @loop:
001780r 2  A5 rr                LDA     tmp2
001782r 2  05 rr                ORA     tmp2+1
001784r 2  F0 34                BEQ     @not_found
001786r 2               ; decrement tmp2
001786r 2  A5 rr                LDA     tmp2
001788r 2  D0 02                BNE     :+
00178Ar 2  C6 rr                DEC     tmp2+1
00178Cr 2               :
00178Cr 2  C6 rr                DEC     tmp2
00178Er 2               ; compute entry address: SYMTAB_BASE + tmp2 * SYM_ENTRY_SZ
00178Er 2               ; tmp2 * 32 = tmp2 << 5
00178Er 2  A5 rr                LDA     tmp2
001790r 2  0A                   ASL
001791r 2  0A                   ASL
001792r 2  0A                   ASL
001793r 2  0A                   ASL
001794r 2  0A                   ASL                     ; *32
001795r 2  18                   CLC
001796r 2  69 00                ADC     #<SYMTAB_BASE
001798r 2  85 rr                STA     tmp3
00179Ar 2  A5 rr                LDA     tmp2+1
00179Cr 2  2A                   ROL
00179Dr 2  69 80                ADC     #>SYMTAB_BASE
00179Fr 2  85 rr                STA     tmp3+1
0017A1r 2               ; compare name length
0017A1r 2  A0 00                LDY     #0
0017A3r 2  B1 rr                LDA     (tmp3),y
0017A5r 2  CD rr rr             CMP     ident_buf
0017A8r 2  D0 D6                BNE     @loop
0017AAr 2               ; compare name chars
0017AAr 2  AA                   TAX                     ; X = length
0017ABr 2  A0 00                LDY     #0
0017ADr 2               @cmp:
0017ADr 2  C8                   INY
0017AEr 2  B1 rr                LDA     (tmp3),y
0017B0r 2  D9 rr rr             CMP     ident_buf,y
0017B3r 2  D0 CB                BNE     @loop
0017B5r 2  CA                   DEX
0017B6r 2  D0 F5                BNE     @cmp
0017B8r 2  38                   SEC
0017B9r 2  60                   RTS
0017BAr 2               @not_found:
0017BAr 2  18                   CLC
0017BBr 2  60                   RTS
0017BCr 2               
0017BCr 2               ; ---------------------------------------------------------------------------
0017BCr 2               ; symtab_add — add entry to symbol table
0017BCr 2               ; Inputs:
0017BCr 2               ;   ident_buf = name
0017BCr 2               ;   A = kind (SYM_*)
0017BCr 2               ;   X = data type (TY_*)
0017BCr 2               ;   tmp2 = value/offset word (lo in tmp2, hi in tmp2+1)
0017BCr 2               ; Returns: tmp3 = pointer to new entry; carry set = table full
0017BCr 2               ; ---------------------------------------------------------------------------
0017BCr 2               symtab_add:
0017BCr 2  48                   PHA                     ; save kind (A) — the rest of this routine clobbers A
0017BDr 2  8A                   TXA
0017BEr 2  48                   PHA                     ; save data type (X)
0017BFr 2               ; check capacity
0017BFr 2  AD rr rr             LDA     symtab_count+1
0017C2r 2  C9 00                CMP     #(SYMTAB_MAXSZ / SYM_ENTRY_SZ) >> 8
0017C4r 2  90 0B                BCC     :+
0017C6r 2  AD rr rr             LDA     symtab_count
0017C9r 2  C9 C0                CMP     #(SYMTAB_MAXSZ / SYM_ENTRY_SZ) & $FF
0017CBr 2  90 04                BCC     :+
0017CDr 2  68                   PLA                     ; discard saved type
0017CEr 2  68                   PLA                     ; discard saved kind
0017CFr 2  38                   SEC
0017D0r 2  60                   RTS                     ; table full
0017D1r 2               
0017D1r 2               :       ; compute address of new entry
0017D1r 2  AD rr rr             LDA     symtab_count
0017D4r 2  0A                   ASL
0017D5r 2  0A                   ASL
0017D6r 2  0A                   ASL
0017D7r 2  0A                   ASL
0017D8r 2  0A                   ASL                     ; *32
0017D9r 2  18                   CLC
0017DAr 2  69 00                ADC     #<SYMTAB_BASE
0017DCr 2  85 rr                STA     tmp3
0017DEr 2  AD rr rr             LDA     symtab_count+1
0017E1r 2  2A                   ROL
0017E2r 2  69 80                ADC     #>SYMTAB_BASE
0017E4r 2  85 rr                STA     tmp3+1
0017E6r 2               
0017E6r 2               ; copy name
0017E6r 2  A0 00                LDY     #0
0017E8r 2  AD rr rr             LDA     ident_buf       ; length
0017EBr 2  91 rr                STA     (tmp3),y
0017EDr 2  AA                   TAX
0017EEr 2               @name_copy:
0017EEr 2  C8                   INY
0017EFr 2  B9 rr rr             LDA     ident_buf,y
0017F2r 2  91 rr                STA     (tmp3),y
0017F4r 2  CA                   DEX
0017F5r 2  D0 F7                BNE     @name_copy
0017F7r 2               
0017F7r 2               ; fill unused name bytes with space
0017F7r 2  C8                   INY
0017F8r 2               @pad:
0017F8r 2  C0 10                CPY     #16
0017FAr 2  B0 07                BCS     @done_pad
0017FCr 2  A9 20                LDA     #' '
0017FEr 2  91 rr                STA     (tmp3),y
001800r 2  C8                   INY
001801r 2  80 F5                BRA     @pad
001803r 2               @done_pad:
001803r 2               
001803r 2               ; data type (was saved on stack first)
001803r 2  68                   PLA
001804r 2  A0 11                LDY     #17
001806r 2  91 rr                STA     (tmp3),y
001808r 2               
001808r 2               ; kind (was saved on stack second-to-last → on top first)
001808r 2  68                   PLA
001809r 2  A0 10                LDY     #16
00180Br 2  91 rr                STA     (tmp3),y
00180Dr 2               
00180Dr 2               ; value/offset
00180Dr 2  A5 rr                LDA     tmp2
00180Fr 2  A0 12                LDY     #18
001811r 2  91 rr                STA     (tmp3),y
001813r 2  A5 rr                LDA     tmp2+1
001815r 2  A0 13                LDY     #19
001817r 2  91 rr                STA     (tmp3),y
001819r 2               
001819r 2               ; scope depth
001819r 2  A5 rr                LDA     scope_depth
00181Br 2  A0 14                LDY     #20
00181Dr 2  91 rr                STA     (tmp3),y
00181Fr 2               
00181Fr 2               ; zero rest
00181Fr 2  A9 00                LDA     #0
001821r 2  A0 15                LDY     #21
001823r 2               @zero:
001823r 2  91 rr                STA     (tmp3),y
001825r 2  C8                   INY
001826r 2  C0 20                CPY     #SYM_ENTRY_SZ
001828r 2  90 F9                BCC     @zero
00182Ar 2               
00182Ar 2               ; increment count
00182Ar 2  EE rr rr             INC     symtab_count
00182Dr 2  D0 03                BNE     :+
00182Fr 2  EE rr rr             INC     symtab_count+1
001832r 2               :
001832r 2  18                   CLC
001833r 2  60                   RTS
001834r 2               
001834r 2               ; ---------------------------------------------------------------------------
001834r 2               ; symtab_enter_scope — increment scope depth
001834r 2               ; ---------------------------------------------------------------------------
001834r 2               symtab_enter_scope:
001834r 2  E6 rr                INC     scope_depth
001836r 2  60                   RTS
001837r 2               
001837r 2               ; ---------------------------------------------------------------------------
001837r 2               ; symtab_leave_scope — remove all entries at current scope, decrement depth
001837r 2               ; ---------------------------------------------------------------------------
001837r 2               symtab_leave_scope:
001837r 2               ; Remove all entries added at current scope depth, then decrement depth.
001837r 2               ; Entries are appended in order, so trim from the end.
001837r 2               @trim:
001837r 2  AD rr rr             LDA     symtab_count
00183Ar 2  0D rr rr             ORA     symtab_count+1
00183Dr 2  F0 34                BEQ     @done           ; table empty
00183Fr 2               ; compute address of last entry: SYMTAB_BASE + (count-1)*32
00183Fr 2  AD rr rr             LDA     symtab_count
001842r 2  38                   SEC
001843r 2  E9 01                SBC     #1
001845r 2  85 rr                STA     tmp2
001847r 2  AD rr rr             LDA     symtab_count+1
00184Ar 2  E9 00                SBC     #0
00184Cr 2  85 rr                STA     tmp2+1
00184Er 2               ; tmp2 * 32 (shift left 5) → entry address
00184Er 2  A5 rr                LDA     tmp2
001850r 2  0A                   ASL
001851r 2  0A                   ASL
001852r 2  0A                   ASL
001853r 2  0A                   ASL
001854r 2  0A                   ASL
001855r 2  18                   CLC
001856r 2  69 00                ADC     #<SYMTAB_BASE
001858r 2  85 rr                STA     tmp3
00185Ar 2  A5 rr                LDA     tmp2+1
00185Cr 2  2A                   ROL
00185Dr 2  69 80                ADC     #>SYMTAB_BASE
00185Fr 2  85 rr                STA     tmp3+1
001861r 2               ; check scope depth field (offset 20 in entry)
001861r 2  A0 14                LDY     #20
001863r 2  B1 rr                LDA     (tmp3),y
001865r 2  C5 rr                CMP     scope_depth
001867r 2  D0 0A                BNE     @done           ; entry belongs to an outer scope — stop
001869r 2               ; remove this entry
001869r 2  CE rr rr             DEC     symtab_count
00186Cr 2  D0 C9                BNE     @trim
00186Er 2  CE rr rr             DEC     symtab_count+1
001871r 2  80 C4                BRA     @trim
001873r 2               @done:
001873r 2  C6 rr                DEC     scope_depth
001875r 2  60                   RTS
001876r 2               
001876r 1                       .include        "CODEGEN.ASM"
001876r 2               ; codegen.asm — p-code emitter for Pascal/65 compiler
001876r 2               ;
001876r 2               ; All generated p-code accumulates in CODEBUF_BASE.
001876r 2               ; cg_pc (zero page) tracks the next write offset.
001876r 2               
001876r 2                       .segment        "CODE"
001876r 2               
001876r 2               ; ---------------------------------------------------------------------------
001876r 2               ; emit_byte — append byte A to code buffer
001876r 2               ; ---------------------------------------------------------------------------
001876r 2               emit_byte:
001876r 2  48                   PHA                     ; save byte to emit
001877r 2               ; check buffer full
001877r 2  A5 rr                LDA     cg_pc+1
001879r 2  C9 80                CMP     #>CODEBUF_MAXSZ
00187Br 2  90 13                BCC     :+
00187Dr 2  A5 rr                LDA     cg_pc
00187Fr 2  C9 00                CMP     #<CODEBUF_MAXSZ
001881r 2  90 0D                BCC     :+
001883r 2               ; error: p-code buffer full
001883r 2  68                   PLA
001884r 2  A9 rr                LDA     #<err_pcd_full
001886r 2  85 rr                STA     tmp0
001888r 2  A9 rr                LDA     #>err_pcd_full
00188Ar 2  85 rr                STA     tmp0+1
00188Cr 2  20 rr rr             JSR     compile_error
00188Fr 2  60                   RTS
001890r 2               :
001890r 2               ; store at CODEBUF_BASE + cg_pc
001890r 2  A5 rr                LDA     cg_pc
001892r 2  18                   CLC
001893r 2  69 00                ADC     #<CODEBUF_BASE
001895r 2  85 rr                STA     tmp2
001897r 2  A5 rr                LDA     cg_pc+1
001899r 2  69 30                ADC     #>CODEBUF_BASE
00189Br 2  85 rr                STA     tmp2+1
00189Dr 2  68                   PLA
00189Er 2  A0 00                LDY     #0
0018A0r 2  91 rr                STA     (tmp2),y
0018A2r 2               ; advance cg_pc
0018A2r 2  E6 rr                INC     cg_pc
0018A4r 2  D0 02                BNE     :+
0018A6r 2  E6 rr                INC     cg_pc+1
0018A8r 2               :
0018A8r 2  60                   RTS
0018A9r 2               
0018A9r 2               ; ---------------------------------------------------------------------------
0018A9r 2               ; emit_word — append word (lo then hi) from tmp2 to code buffer
0018A9r 2               ; ---------------------------------------------------------------------------
0018A9r 2               emit_word:
0018A9r 2  A5 rr                LDA     tmp2
0018ABr 2  20 rr rr             JSR     emit_byte
0018AEr 2  A5 rr                LDA     tmp2+1
0018B0r 2  20 rr rr             JSR     emit_byte
0018B3r 2  60                   RTS
0018B4r 2               
0018B4r 2               ; ---------------------------------------------------------------------------
0018B4r 2               ; emit_opcode — emit single opcode byte in A
0018B4r 2               ; ---------------------------------------------------------------------------
0018B4r 2               emit_opcode:
0018B4r 2  20 rr rr             JSR     emit_byte
0018B7r 2  60                   RTS
0018B8r 2               
0018B8r 2               ; --- Constant emitters ---
0018B8r 2               
0018B8r 2               emit_LDCI:                      ; push sign-extended byte in A
0018B8r 2  48                   PHA
0018B9r 2  A9 00                LDA     #OP_LDCI
0018BBr 2  20 rr rr             JSR     emit_byte
0018BEr 2  68                   PLA
0018BFr 2  20 rr rr             JSR     emit_byte
0018C2r 2  60                   RTS
0018C3r 2               
0018C3r 2               emit_LDCW:                      ; push word: lo in A, hi in scratch
0018C3r 2  48                   PHA
0018C4r 2  A9 01                LDA     #OP_LDCW
0018C6r 2  20 rr rr             JSR     emit_byte
0018C9r 2  68                   PLA
0018CAr 2  20 rr rr             JSR     emit_byte
0018CDr 2  A5 rr                LDA     scratch
0018CFr 2  20 rr rr             JSR     emit_byte
0018D2r 2  60                   RTS
0018D3r 2               
0018D3r 2               emit_LDCC:                      ; push char in A
0018D3r 2  48                   PHA
0018D4r 2  A9 02                LDA     #OP_LDCC
0018D6r 2  20 rr rr             JSR     emit_byte
0018D9r 2  68                   PLA
0018DAr 2  20 rr rr             JSR     emit_byte
0018DDr 2  60                   RTS
0018DEr 2               
0018DEr 2               emit_LDCB:                      ; push boolean in A (0=false, 1=true)
0018DEr 2  48                   PHA
0018DFr 2  A9 03                LDA     #OP_LDCB
0018E1r 2  20 rr rr             JSR     emit_byte
0018E4r 2  68                   PLA
0018E5r 2  20 rr rr             JSR     emit_byte
0018E8r 2  60                   RTS
0018E9r 2               
0018E9r 2               emit_LDCN:
0018E9r 2  A9 05                LDA     #OP_LDCN
0018EBr 2  20 rr rr             JSR     emit_byte
0018EEr 2  60                   RTS
0018EFr 2               
0018EFr 2               ; emit_LDCS — emit OP_LDCS followed by length byte and string bytes.
0018EFr 2               ; Source string lives in ident_buf (length at [0], chars at [1..N]).
0018EFr 2               ; The runtime will inline-fetch length+chars and push the address of
0018EFr 2               ; the length byte as a Pascal-style string pointer.
0018EFr 2               emit_LDCS:
0018EFr 2  A9 04                LDA     #OP_LDCS
0018F1r 2  20 rr rr             JSR     emit_byte
0018F4r 2  AD rr rr             LDA     ident_buf       ; length
0018F7r 2  85 rr                STA     scratch         ; counter / length cache
0018F9r 2  20 rr rr             JSR     emit_byte       ; emit length byte
0018FCr 2  A2 00                LDX     #0
0018FEr 2               @loop:
0018FEr 2  E4 rr                CPX     scratch
001900r 2  B0 0B                BCS     @done
001902r 2  BD rr rr             LDA     ident_buf+1,x
001905r 2  DA                   PHX
001906r 2  20 rr rr             JSR     emit_byte       ; clobbers tmp2 only
001909r 2  FA                   PLX
00190Ar 2  E8                   INX
00190Br 2  80 F1                BRA     @loop
00190Dr 2               @done:
00190Dr 2  60                   RTS
00190Er 2               
00190Er 2               ; --- Local variable emitters ---
00190Er 2               
00190Er 2               emit_LDL:                       ; byte offset in A
00190Er 2  48                   PHA
00190Fr 2  A9 10                LDA     #OP_LDL
001911r 2  20 rr rr             JSR     emit_byte
001914r 2  68                   PLA
001915r 2  20 rr rr             JSR     emit_byte
