001D36r 2  A9 91                LDA     #OP_POP
001D38r 2  4C rr rr             JMP     emit_byte
001D3Br 2               
001D3Br 2               ; --- Calls ---
001D3Br 2               
001D3Br 2               emit_MRKSTK:                    ; local size in A
001D3Br 2  48                   PHA
001D3Cr 2  A9 64                LDA     #OP_MRKSTK
001D3Er 2  20 rr rr             JSR     emit_byte
001D41r 2  68                   PLA
001D42r 2  4C rr rr             JMP     emit_byte
001D45r 2               
001D45r 2               emit_RET:
001D45r 2  A9 62                LDA     #OP_RET
001D47r 2  4C rr rr             JMP     emit_byte
001D4Ar 2               
001D4Ar 2               emit_RETF:
001D4Ar 2  A9 63                LDA     #OP_RETF
001D4Cr 2  4C rr rr             JMP     emit_byte
001D4Fr 2               
001D4Fr 2               emit_STR:
001D4Fr 2  A9 66                LDA     #OP_STR
001D51r 2  4C rr rr             JMP     emit_byte
001D54r 2               
001D54r 2               ; emit_CALL — A = target absolute code-buffer addr lo, scratch = hi
001D54r 2               ; Emits OP_CALL + signed 16-bit offset = target - (cg_pc_after_operand)
001D54r 2               emit_CALL:
001D54r 2  48                   PHA                     ; target lo
001D55r 2  A5 rr                LDA     scratch
001D57r 2  48                   PHA                     ; target hi
001D58r 2  A9 60                LDA     #OP_CALL
001D5Ar 2  20 rr rr             JSR     emit_byte       ; clobbers tmp2; preserves scratch & 6502 stack
001D5Dr 2               ; compute offset = target - cg_pc - 2 (16-bit)
001D5Dr 2  68                   PLA                     ; target hi
001D5Er 2  AA                   TAX
001D5Fr 2  68                   PLA                     ; target lo
001D60r 2  38                   SEC
001D61r 2  E9 02                SBC     #2
001D63r 2  48                   PHA                     ; partial lo
001D64r 2  8A                   TXA                     ; target hi
001D65r 2  E9 00                SBC     #0
001D67r 2  85 rr                STA     scratch         ; partial hi
001D69r 2  68                   PLA                     ; partial lo
001D6Ar 2  38                   SEC
001D6Br 2  E5 rr                SBC     cg_pc
001D6Dr 2  48                   PHA                     ; offset lo
001D6Er 2  A5 rr                LDA     scratch
001D70r 2  E5 rr                SBC     cg_pc+1
001D72r 2  85 rr                STA     scratch         ; offset hi
001D74r 2  68                   PLA
001D75r 2  20 rr rr             JSR     emit_byte       ; emit offset lo
001D78r 2  A5 rr                LDA     scratch
001D7Ar 2  20 rr rr             JSR     emit_byte       ; emit offset hi
001D7Dr 2  60                   RTS
001D7Er 2               
001D7Er 2               emit_HALT:
001D7Er 2  A9 FF                LDA     #OP_HALT
001D80r 2  4C rr rr             JMP     emit_byte
001D83r 2               
