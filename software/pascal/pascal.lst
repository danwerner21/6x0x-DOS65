00174Cr 2               @chk_write:
00174Cr 2               ; "WRITE" (5)
00174Cr 2  20 rr rr             JSR     next_token
00174Fr 2  20 rr rr             JSR     parse_write_args        ; X=0 console, X=1 file (file ptr left)
001752r 2  E0 00                CPX     #0
001754r 2  F0 03                BEQ     @w_done
001756r 2  20 rr rr             JSR     emit_POP                ; discard leftover file ptr
001759r 2               @w_done:
001759r 2  60                   RTS
00175Ar 2               
00175Ar 2               @chk_writeln:
00175Ar 2               ; "WRITELN" (7) — first ident_buf char already known 'W'
00175Ar 2  20 rr rr             JSR     next_token
