002447r 2               
002447r 2               ; CONCAT(s1, s2 [, s3, ...]) — emit chained CONCAT2.  Each pair-merge writes
002447r 2               ; into the next round-robin work buffer, so 3+ args work as long as the
002447r 2               ; intermediate buffer isn't recycled before being consumed.
002447r 2               parse_builtin_concat:
002447r 2  20 rr rr             JSR     next_token              ; consume CONCAT
00244Ar 2  A9 1B                LDA     #TOK_LPAREN
00244Cr 2  20 rr rr             JSR     parse_eat_token
