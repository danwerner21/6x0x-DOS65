00273Ar 2  20 rr rr             JSR     parse_expression
00273Dr 2  A9 1C                LDA     #TOK_RPAREN
00273Fr 2  20 rr rr             JSR     parse_eat_token
002742r 2  4C rr rr             JMP     emit_FREWRT
002745r 2               
