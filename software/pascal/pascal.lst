00165Er 2               
00165Er 2               ; emit_CALL — A = target absolute code-buffer addr lo, scratch = hi
00165Er 2               ; Emits OP_CALL + signed 16-bit offset = target - (cg_pc_after_operand)
00165Er 2               emit_CALL:
00165Er 2  48                   PHA                     ; target lo
00165Fr 2  A5 rr                LDA     scratch
001661r 2  48                   PHA                     ; target hi
001662r 2  A9 60                LDA     #OP_CALL
001664r 2  20 rr rr             JSR     emit_byte       ; clobbers tmp2; preserves scratch & 6502 stack
001667r 2               ; compute offset = target - cg_pc - 2 (16-bit)
001667r 2  68                   PLA                     ; target hi
001668r 2  AA                   TAX
001669r 2  68                   PLA                     ; target lo
00166Ar 2  38                   SEC
00166Br 2  E9 02                SBC     #2
00166Dr 2  48                   PHA                     ; partial lo
00166Er 2  8A                   TXA                     ; target hi
00166Fr 2  E9 00                SBC     #0
001671r 2  85 rr                STA     scratch         ; partial hi
001673r 2  68                   PLA                     ; partial lo
001674r 2  38                   SEC
001675r 2  E5 rr                SBC     cg_pc
001677r 2  48                   PHA                     ; offset lo
001678r 2  A5 rr                LDA     scratch
00167Ar 2  E5 rr                SBC     cg_pc+1
00167Cr 2  85 rr                STA     scratch         ; offset hi
00167Er 2  68                   PLA
00167Fr 2  20 rr rr             JSR     emit_byte       ; emit offset lo
001682r 2  A5 rr                LDA     scratch
001684r 2  20 rr rr             JSR     emit_byte       ; emit offset hi
001687r 2  60                   RTS
001688r 2               
001688r 2               emit_HALT:
001688r 2  A9 FF                LDA     #OP_HALT
00168Ar 2  4C rr rr             JMP     emit_byte
00168Dr 2               
00168Dr 2               ; ---------------------------------------------------------------------------
00168Dr 2               ; codegen_alloc_global — reserve N bytes in global area; return offset in tmp2
00168Dr 2               ; N in A
00168Dr 2               ; ---------------------------------------------------------------------------
00168Dr 2               codegen_alloc_global:
00168Dr 2  A5 rr                LDA     cg_globals
00168Fr 2  85 rr                STA     tmp2
001691r 2  A5 rr                LDA     cg_globals+1
001693r 2  85 rr                STA     tmp2+1
001695r 2               ; advance by N (passed in A — caller puts size here)
001695r 2               ; For now allocate 2 bytes (word) per variable
001695r 2  A5 rr                LDA     cg_globals
001697r 2  18                   CLC
001698r 2  69 02                ADC     #2
00169Ar 2  85 rr                STA     cg_globals
00169Cr 2  90 02                BCC     :+
00169Er 2  E6 rr                INC     cg_globals+1
0016A0r 2               :
0016A0r 2  60                   RTS
0016A1r 2               
0016A1r 1                       .include        "IOLIB.ASM"
0016A1r 2               .pc02
0016A1r 2               ; iolib.asm — console and file I/O wrappers for DOS/65
0016A1r 2               ;
0016A1r 2               ; Uses PEM function 2 (CONOUT) for character output.
0016A1r 2               ; This routes through DFT_CONSOLE and works on all platforms
0016A1r 2               ; (serial, ESP video, memory-mapped video) regardless of which
0016A1r 2               ; console driver is active.
0016A1r 2               
0016A1r 2                       .segment        "CODE"
0016A1r 2               
0016A1r 2               ; ---------------------------------------------------------------------------
0016A1r 2               ; console_putc — output character in A to console via PEM #2
0016A1r 2               ; ---------------------------------------------------------------------------
0016A1r 2               console_putc:
0016A1r 2  48                   PHA
0016A2r 2  A2 02                LDX     #PEM_CONOUT
0016A4r 2  20 03 01             JSR     PEM_ENTRY
0016A7r 2  68                   PLA
0016A8r 2  60                   RTS
0016A9r 2               
0016A9r 2               ; ---------------------------------------------------------------------------
0016A9r 2               ; console_newline — emit CR+LF
0016A9r 2               ; ---------------------------------------------------------------------------
0016A9r 2               console_newline:
0016A9r 2  A9 0D                LDA     #$0D
0016ABr 2  A2 02                LDX     #PEM_CONOUT
0016ADr 2  20 03 01             JSR     PEM_ENTRY
0016B0r 2  A9 0A                LDA     #$0A
0016B2r 2  A2 02                LDX     #PEM_CONOUT
0016B4r 2  20 03 01             JSR     PEM_ENTRY
0016B7r 2  60                   RTS
0016B8r 2               
0016B8r 2               ; ---------------------------------------------------------------------------
0016B8r 2               ; console_print_sz — print null-terminated string at tmp0
0016B8r 2               ; ---------------------------------------------------------------------------
0016B8r 2               console_print_sz:
0016B8r 2  A0 00                LDY     #0
0016BAr 2               @loop:
0016BAr 2  B1 rr                LDA     (tmp0),y
0016BCr 2  F0 08                BEQ     @done
0016BEr 2  A2 02                LDX     #PEM_CONOUT
0016C0r 2  20 03 01             JSR     PEM_ENTRY
0016C3r 2  C8                   INY
0016C4r 2  D0 F4                BNE     @loop
0016C6r 2               @done:
0016C6r 2  60                   RTS
0016C7r 2               
0016C7r 2               ; ---------------------------------------------------------------------------
0016C7r 2               ; console_print_pstr — print length-prefixed Pascal string at tmp0
0016C7r 2               ; ---------------------------------------------------------------------------
0016C7r 2               console_print_pstr:
0016C7r 2  A0 00                LDY     #0
0016C9r 2  B1 rr                LDA     (tmp0),y        ; length byte
0016CBr 2  F0 10                BEQ     @done
0016CDr 2  AA                   TAX                     ; X = remaining chars — but X used by PEM!
0016CEr 2               ; save length, use tmp1 as counter
0016CEr 2  85 rr                STA     tmp1
0016D0r 2  C8                   INY
0016D1r 2               @loop:
0016D1r 2  B1 rr                LDA     (tmp0),y
0016D3r 2  A2 02                LDX     #PEM_CONOUT
0016D5r 2  20 03 01             JSR     PEM_ENTRY
0016D8r 2  C8                   INY
0016D9r 2  C6 rr                DEC     tmp1
0016DBr 2  D0 F4                BNE     @loop
0016DDr 2               @done:
0016DDr 2  60                   RTS
0016DEr 2               
0016DEr 2               ; ---------------------------------------------------------------------------
0016DEr 2               ; console_print_dec — print signed 16-bit integer in tmp0:tmp0+1
0016DEr 2               ; ---------------------------------------------------------------------------
0016DEr 2               console_print_dec:
0016DEr 2  A5 rr                LDA     tmp0+1
0016E0r 2  10 14                BPL     @positive
0016E2r 2  A9 2D                LDA     #'-'
0016E4r 2  A2 02                LDX     #PEM_CONOUT
0016E6r 2  20 03 01             JSR     PEM_ENTRY
0016E9r 2  A9 00                LDA     #0
0016EBr 2  38                   SEC
0016ECr 2  E5 rr                SBC     tmp0
0016EEr 2  85 rr                STA     tmp0
0016F0r 2  A9 00                LDA     #0
0016F2r 2  E5 rr                SBC     tmp0+1
0016F4r 2  85 rr                STA     tmp0+1
0016F6r 2               @positive:
0016F6r 2  A9 00                LDA     #0
0016F8r 2  48                   PHA                     ; sentinel
0016F9r 2               @div_loop:
0016F9r 2  20 rr rr             JSR     div16_by10      ; quotient→tmp0, remainder→scratch
0016FCr 2  A5 rr                LDA     scratch
0016FEr 2  18                   CLC
0016FFr 2  69 30                ADC     #'0'
001701r 2  48                   PHA
001702r 2  A5 rr                LDA     tmp0
001704r 2  05 rr                ORA     tmp0+1
001706r 2  D0 F1                BNE     @div_loop
001708r 2               @print_loop:
001708r 2  68                   PLA
001709r 2  F0 07                BEQ     @done2          ; sentinel
00170Br 2  A2 02                LDX     #PEM_CONOUT
00170Dr 2  20 03 01             JSR     PEM_ENTRY
001710r 2  80 F6                BRA     @print_loop
001712r 2               @done2:
001712r 2  60                   RTS
001713r 2               
001713r 2               ; ---------------------------------------------------------------------------
001713r 2               ; div16_by10 — divide tmp0:tmp0+1 by 10
001713r 2               ; Result: quotient in tmp0:tmp0+1, remainder in scratch
001713r 2               ; ---------------------------------------------------------------------------
001713r 2               div16_by10:
001713r 2  A9 00                LDA     #0
001715r 2  85 rr                STA     scratch
001717r 2  A2 10                LDX     #16
001719r 2               @bit:
001719r 2  06 rr                ASL     tmp0
00171Br 2  26 rr                ROL     tmp0+1
00171Dr 2  26 rr                ROL     scratch
00171Fr 2  A5 rr                LDA     scratch
001721r 2  C9 0A                CMP     #10
001723r 2  90 06                BCC     @no_sub
001725r 2  E9 0A                SBC     #10
001727r 2  85 rr                STA     scratch
001729r 2  E6 rr                INC     tmp0
00172Br 2               @no_sub:
00172Br 2  CA                   DEX
00172Cr 2  D0 EB                BNE     @bit
00172Er 2  60                   RTS
00172Fr 2               
00172Fr 2               ; ---------------------------------------------------------------------------
00172Fr 2               ; console_read_line — read a line into buffer at tmp0, max len in x_save
00172Fr 2               ; Returns: Y = length (not including CR)
00172Fr 2               ; ---------------------------------------------------------------------------
00172Fr 2               console_read_line:
00172Fr 2  8E rr rr             STX     x_save
001732r 2  A0 00                LDY     #0
001734r 2               @loop:
001734r 2  A2 01                LDX     #PEM_CONIN
001736r 2  20 03 01             JSR     PEM_ENTRY
001739r 2  C9 0D                CMP     #$0D
00173Br 2  F0 28                BEQ     @done
00173Dr 2  C9 08                CMP     #$08            ; backspace
00173Fr 2  D0 1C                BNE     @store
001741r 2  C0 00                CPY     #0
001743r 2  F0 EF                BEQ     @loop
001745r 2  88                   DEY
001746r 2  A9 08                LDA     #$08
001748r 2  A2 02                LDX     #PEM_CONOUT
00174Ar 2  20 03 01             JSR     PEM_ENTRY
00174Dr 2  A9 20                LDA     #' '
00174Fr 2  A2 02                LDX     #PEM_CONOUT
001751r 2  20 03 01             JSR     PEM_ENTRY
001754r 2  A9 08                LDA     #$08
001756r 2  A2 02                LDX     #PEM_CONOUT
001758r 2  20 03 01             JSR     PEM_ENTRY
00175Br 2  80 D7                BRA     @loop
00175Dr 2               @store:
00175Dr 2  91 rr                STA     (tmp0),y
00175Fr 2  C8                   INY
001760r 2  CC rr rr             CPY     x_save
001763r 2  90 CF                BCC     @loop
001765r 2               @done:
001765r 2  60                   RTS
001766r 2               x_save:
001766r 2  00                   .BYTE   0
001767r 2               
001767r 2               ; ---------------------------------------------------------------------------
001767r 2               ; file_open — open file via FCB at tmp1; returns A=0 success, $FF=not found
001767r 2               ; PEM calling convention: X=function, A=FCB addr lo, Y=FCB addr hi
001767r 2               ; ---------------------------------------------------------------------------
001767r 2               file_open:
001767r 2  A5 rr                LDA     tmp1
001769r 2  A4 rr                LDY     tmp1+1
00176Br 2  A2 0F                LDX     #PEM_OPEN
00176Dr 2  20 03 01             JSR     PEM_ENTRY
001770r 2  60                   RTS
001771r 2               
001771r 2               ; ---------------------------------------------------------------------------
001771r 2               ; file_make — create/truncate file via FCB at tmp1
001771r 2               ; ---------------------------------------------------------------------------
001771r 2               file_make:
001771r 2  A5 rr                LDA     tmp1
001773r 2  A4 rr                LDY     tmp1+1
001775r 2  A2 16                LDX     #PEM_MAKE
001777r 2  20 03 01             JSR     PEM_ENTRY
00177Ar 2  60                   RTS
00177Br 2               
00177Br 2               ; ---------------------------------------------------------------------------
00177Br 2               ; file_read_sector — read 128 bytes into DMA_BUF; returns A=0 ok, A=1 EOF
00177Br 2               ; ---------------------------------------------------------------------------
00177Br 2               file_read_sector:
00177Br 2  A5 rr                LDA     tmp1
00177Dr 2  A4 rr                LDY     tmp1+1
00177Fr 2  A2 14                LDX     #PEM_READ
001781r 2  20 03 01             JSR     PEM_ENTRY
001784r 2  60                   RTS
001785r 2               
001785r 2               ; ---------------------------------------------------------------------------
001785r 2               ; file_write_sector — write 128 bytes from DMA_BUF
001785r 2               ; ---------------------------------------------------------------------------
001785r 2               file_write_sector:
001785r 2  A5 rr                LDA     tmp1
001787r 2  A4 rr                LDY     tmp1+1
001789r 2  A2 15                LDX     #PEM_WRITE
00178Br 2  20 03 01             JSR     PEM_ENTRY
00178Er 2  60                   RTS
00178Fr 2               
00178Fr 2               ; ---------------------------------------------------------------------------
00178Fr 2               ; file_close — close FCB at tmp1
00178Fr 2               ; ---------------------------------------------------------------------------
00178Fr 2               file_close:
00178Fr 2  A5 rr                LDA     tmp1
001791r 2  A4 rr                LDY     tmp1+1
001793r 2  A2 10                LDX     #PEM_CLOSE
001795r 2  20 03 01             JSR     PEM_ENTRY
001798r 2  60                   RTS
001799r 2               
