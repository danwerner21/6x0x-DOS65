002491r 2               @maybe_deref_ptr:
002491r 2  4C rr rr             JMP     maybe_deref_loaded_ptr
002494r 2               @text_rhs_local:
002494r 2  8A                   TXA
002495r 2  4C rr rr             JMP     emit_LDA_L
002498r 2               @arr_rhs_local:
002498r 2  8A                   TXA
002499r 2  20 rr rr             JSR     emit_LDA_L
00249Cr 2               @arr_rhs_index:
00249Cr 2               ; parse [index], emit INDEX, LDIND
00249Cr 2  AD rr rr             LDA     fcall_vmask
00249Fr 2  48                   PHA
0024A0r 2  A5 rr                LDA     tok_type
0024A2r 2  C9 1D                CMP     #TOK_LBRACK
0024A4r 2  D0 03                BNE     :+
0024A6r 2  20 rr rr             JSR     next_token
0024A9r 2  20 rr rr     :       JSR     parse_expression    ; clobbers expr_type, scratch, tmp*
0024ACr 2  A5 rr                LDA     tok_type
0024AEr 2  C9 1E                CMP     #TOK_RBRACK
0024B0r 2  D0 03                BNE     :+
0024B2r 2  20 rr rr             JSR     next_token
0024B5r 2  A9 00        :       LDA     #0
0024B7r 2  85 rr                STA     scratch
0024B9r 2  A9 02                LDA     #2
0024BBr 2  20 rr rr             JSR     emit_INDEX
0024BEr 2  20 rr rr             JSR     emit_LDIND
0024C1r 2  68                   PLA
0024C2r 2  85 rr                STA     expr_type
0024C4r 2  60                   RTS
0024C5r 2               @rec_rhs_local:
0024C5r 2  8A                   TXA
0024C6r 2  20 rr rr             JSR     emit_LDA_L
0024C9r 2               @rec_rhs_field:
0024C9r 2               ; Chained field access loop: TOS holds &cur_record_base.
0024C9r 2               ; fcall_vmask = current record's first_field, fcall_lsize = its count.
0024C9r 2               ; Each iteration consumes ".name" and walks one level deeper.  When the
0024C9r 2               ; resolved field is itself a RECORD and another '.' follows, repeat;
0024C9r 2               ; otherwise emit LDIND on the final scalar address.
0024C9r 2  A5 rr                LDA     tok_type
0024CBr 2  C9 22                CMP     #TOK_DOT
0024CDr 2  F0 0D                BEQ     @rrf_chain
0024CFr 2  AD rr rr             LDA     fcall_vmask
0024D2r 2  8D rr rr             STA     expr_record_first
0024D5r 2  AD rr rr             LDA     fcall_lsize
0024D8r 2  8D rr rr             STA     expr_record_count
0024DBr 2  60                   RTS
0024DCr 2               @rrf_chain:
0024DCr 2               ; consume '.'
0024DCr 2  A5 rr                LDA     tok_type
0024DEr 2  C9 22                CMP     #TOK_DOT
0024E0r 2  D0 03                BNE     :+
0024E2r 2  20 rr rr             JSR     next_token
0024E5r 2               :
0024E5r 2               ; field name now in ident_buf — look up in current record
0024E5r 2  AD rr rr             LDA     fcall_vmask     ; first_field_idx
0024E8r 2  AE rr rr             LDX     fcall_lsize     ; field_count
0024EBr 2  20 rr rr             JSR     field_lookup_in_record
0024EEr 2  90 5F                BCC     @rec_rhs_nf
0024F0r 2               ; A=offset, X=type, tmp3=matched index. Stash all three across emits.
0024F0r 2  48                   PHA                     ; save offset
0024F1r 2  8A                   TXA
0024F2r 2  8D rr rr             STA     field_chain_type
0024F5r 2  A5 rr                LDA     tmp3
0024F7r 2  AA                   TAX
0024F8r 2  BD rr rr             LDA     field_nested_first,x
0024FBr 2  8D rr rr             STA     field_chain_first
0024FEr 2  BD rr rr             LDA     field_nested_count,x
002501r 2  8D rr rr             STA     field_chain_count
002504r 2  68                   PLA                     ; offset back; PLA sets Z
002505r 2  F0 06                BEQ     @rrf_no_off
002507r 2  20 rr rr             JSR     emit_LDCI
00250Ar 2  20 rr rr             JSR     emit_ADI
00250Dr 2               @rrf_no_off:
00250Dr 2  20 rr rr             JSR     next_token              ; consume field name
002510r 2               ; If field type is RECORD AND next token is '.', chain into it.
002510r 2  AD rr rr             LDA     field_chain_type
002513r 2  C9 06                CMP     #TY_RECORD
002515r 2  D0 14                BNE     @rrf_done_chain
002517r 2  A5 rr                LDA     tok_type
002519r 2  C9 22                CMP     #TOK_DOT
00251Br 2  D0 0E                BNE     @rrf_done_chain
00251Dr 2  AD rr rr             LDA     field_chain_first
002520r 2  8D rr rr             STA     fcall_vmask
002523r 2  AD rr rr             LDA     field_chain_count
002526r 2  8D rr rr             STA     fcall_lsize
002529r 2  80 B1                BRA     @rrf_chain
00252Br 2               @rrf_done_chain:
00252Br 2               ; Final step: scalar fields → LDIND value; record fields stay as
00252Br 2               ; addresses (so calling code sees them as TY_RECORD pointers).
00252Br 2  AD rr rr             LDA     field_chain_type
00252Er 2  C9 06                CMP     #TY_RECORD
002530r 2  F0 0B                BEQ     @rrf_rec_result
002532r 2  20 rr rr             JSR     emit_LDIND
002535r 2  AD rr rr             LDA     field_chain_type
002538r 2  85 rr                STA     expr_type
00253Ar 2  4C rr rr             JMP     maybe_deref_loaded_ptr
00253Dr 2               @rrf_rec_result:
00253Dr 2  AD rr rr             LDA     field_chain_first
002540r 2  8D rr rr             STA     expr_record_first
002543r 2  AD rr rr             LDA     field_chain_count
002546r 2  8D rr rr             STA     expr_record_count
002549r 2  AD rr rr             LDA     field_chain_type
00254Cr 2  85 rr                STA     expr_type
00254Er 2  60                   RTS
00254Fr 2               @rec_rhs_nf:
00254Fr 2  A9 rr                LDA     #<err_undef
002551r 2  85 rr                STA     tmp0
002553r 2  A9 rr                LDA     #>err_undef
002555r 2  85 rr                STA     tmp0+1
002557r 2  20 rr rr             JSR     compile_error
00255Ar 2  20 rr rr             JSR     next_token      ; consume bad field name
00255Dr 2  20 rr rr             JSR     emit_LDIND      ; keep stack balanced
002560r 2  A9 01                LDA     #TY_INT
002562r 2  85 rr                STA     expr_type
002564r 2  60                   RTS
002565r 2               @varref_load:
002565r 2               ; SYM_VARREF: local slot holds an address. Compound types keep that
002565r 2               ; address as their expression result; scalars load through it.
002565r 2  68                   PLA                     ; discard pcount
002566r 2  8A                   TXA
002567r 2  20 rr rr             JSR     emit_LDL        ; push address from slot
00256Ar 2  A5 rr                LDA     expr_type
00256Cr 2  C9 06                CMP     #TY_RECORD
00256Er 2  F0 0E                BEQ     @vrf_addr
002570r 2  C9 05                CMP     #TY_ARRAY
002572r 2  F0 0A                BEQ     @vrf_addr
002574r 2  C9 08                CMP     #TY_TEXT
002576r 2  F0 06                BEQ     @vrf_addr
002578r 2  20 rr rr             JSR     emit_LDIND      ; deref → push word
00257Br 2  4C rr rr             JMP     maybe_deref_loaded_ptr
00257Er 2               @vrf_addr:
00257Er 2  C9 06                CMP     #TY_RECORD
002580r 2  D0 0C                BNE     :+
002582r 2  AD rr rr             LDA     fcall_vmask
002585r 2  8D rr rr             STA     expr_record_first
002588r 2  AD rr rr             LDA     fcall_lsize
00258Br 2  8D rr rr             STA     expr_record_count
00258Er 2  60           :       RTS
00258Fr 2               @const_emit:
00258Fr 2               ; CONST: offset bytes hold the literal value. X=lo, scratch=hi.
00258Fr 2  68                   PLA                     ; discard pcount
002590r 2  8A                   TXA
002591r 2  20 rr rr             JSR     emit_LDCW
002594r 2  60                   RTS
002595r 2               @sym_func_call:
002595r 2               ; SYM_FUNC: emit args, then MRKA + CALL.  Result is left on TOS by op_RETF.
002595r 2               ; expr_type is the function's return type (already set).
002595r 2               ; X=off lo, scratch=off hi, top of 6502 stack = pcount.
002595r 2               ; NOTE: still not nest-safe inside one arg expression — fcall_pcount and
002595r 2               ; fcall_vmask live in zero-page across the loop and a nested function-call
002595r 2               ; arg would clobber them.  Pre-existing limitation; tracked as TODO.
002595r 2               ;
002595r 2               ; Args are evaluated BEFORE MRKA so LDL/LDA_L inside arg expressions
002595r 2               ; addresses the caller's MP (not the callee's).  MRKA then shifts the
002595r 2               ; pcount pushed values up by AR_LOCALS into local slots 0..pcount-1.
002595r 2               ;
002595r 2               ; lsize_extra is computed up-front and stashed on the 6502 hw stack so
002595r 2               ; record-field lookup inside an arg (which scratches fcall_lsize) cannot
002595r 2               ; corrupt the MRKA operand we emit at the end.
002595r 2  8E rr rr             STX     fcall_lo
002598r 2  A5 rr                LDA     scratch
00259Ar 2  8D rr rr             STA     fcall_hi
00259Dr 2  A5 rr                LDA     expr_type
00259Fr 2  8D rr rr             STA     fcall_type      ; preserve across parse_expression
0025A2r 2  68                   PLA                     ; pcount
0025A3r 2  8D rr rr             STA     fcall_pcount
0025A6r 2               ; Compute lsize_extra now (before any parse_expression call may clobber
0025A6r 2               ; fcall_lsize) and push it onto the 6502 hw stack.
0025A6r 2  AD rr rr             LDA     fcall_lsize
0025A9r 2  38                   SEC
0025AAr 2  ED rr rr             SBC     fcall_pcount
0025ADr 2  ED rr rr             SBC     fcall_pcount
0025B0r 2  48                   PHA                     ; saved lsize_extra
0025B1r 2  AD rr rr             LDA     fcall_pcount
0025B4r 2  F0 4B                BEQ     @fc_no_args
0025B6r 2               ; expect '('
0025B6r 2  A5 rr                LDA     tok_type
0025B8r 2  C9 1B                CMP     #TOK_LPAREN
0025BAr 2  D0 57                BNE     @fc_emit_call
0025BCr 2  20 rr rr             JSR     next_token      ; consume '('
0025BFr 2  A2 00                LDX     #0              ; X = arg index
0025C1r 2               @fc_arg_loop:
0025C1r 2               ; Bit X of fcall_vmask → VAR (push address); else value.
0025C1r 2  DA                   PHX
0025C2r 2  A9 01                LDA     #1
0025C4r 2               @fcvbit:
0025C4r 2  E0 00                CPX     #0
0025C6r 2  F0 04                BEQ     @fcvdone
0025C8r 2  0A                   ASL
0025C9r 2  CA                   DEX
0025CAr 2  80 F8                BRA     @fcvbit
0025CCr 2               @fcvdone:
0025CCr 2  FA                   PLX
0025CDr 2  2D rr rr             AND     fcall_vmask
0025D0r 2  F0 07                BEQ     @fc_arg_value
0025D2r 2  DA                   PHX
0025D3r 2  20 rr rr             JSR     parse_arg_lvalue
0025D6r 2  FA                   PLX
0025D7r 2  80 0B                BRA     @fc_arg_stored
0025D9r 2               @fc_arg_value:
0025D9r 2  DA                   PHX
0025DAr 2  20 rr rr             JSR     parse_expression
0025DDr 2  FA                   PLX
0025DEr 2  BD rr rr             LDA     fcall_param_types,x
0025E1r 2  20 rr rr             JSR     coerce_expr_to_target_type
0025E4r 2               @fc_arg_stored:
0025E4r 2               ; Value (or address for VAR) left on stack — MRKA gathers them later.
0025E4r 2  E8                   INX
0025E5r 2  EC rr rr             CPX     fcall_pcount
0025E8r 2  B0 0C                BCS     @fc_done_args
0025EAr 2  A5 rr                LDA     tok_type
0025ECr 2  C9 1F                CMP     #TOK_COMMA
0025EEr 2  D0 06                BNE     @fc_done_args
0025F0r 2  20 rr rr             JSR     next_token      ; consume ','
0025F3r 2  4C rr rr             JMP     @fc_arg_loop    ; jmp — body grew past bra range
0025F6r 2               @fc_done_args:
0025F6r 2  A5 rr                LDA     tok_type
0025F8r 2  C9 1C                CMP     #TOK_RPAREN
0025FAr 2  D0 17                BNE     @fc_emit_call
0025FCr 2  20 rr rr             JSR     next_token      ; consume ')'
0025FFr 2  80 12                BRA     @fc_emit_call
002601r 2               @fc_no_args:
002601r 2               ; Accept optional "()"
002601r 2  A5 rr                LDA     tok_type
002603r 2  C9 1B                CMP     #TOK_LPAREN
002605r 2  D0 0C                BNE     @fc_emit_call
002607r 2  20 rr rr             JSR     next_token
00260Ar 2  A5 rr                LDA     tok_type
00260Cr 2  C9 1C                CMP     #TOK_RPAREN
00260Er 2  D0 03                BNE     @fc_emit_call
002610r 2  20 rr rr             JSR     next_token
002613r 2               @fc_emit_call:
002613r 2               ; Emit MRKA <pcount> <lsize_extra>; pop saved lsize_extra from hw stack
002613r 2               ; (fcall_lsize may have been clobbered by record-field lookup in args).
002613r 2  68                   PLA
002614r 2  AA                   TAX                     ; X = saved lsize_extra
002615r 2  AD rr rr             LDA     fcall_pcount    ; A = pcount
002618r 2  20 rr rr             JSR     emit_MRKA
00261Br 2               ; Emit CALL.
00261Br 2  AD rr rr             LDA     fcall_lo
00261Er 2  0D rr rr             ORA     fcall_hi
002621r 2  D0 0B                BNE     :+
002623r 2  A9 rr                LDA     #<err_undef
002625r 2  85 rr                STA     tmp0
002627r 2  A9 rr                LDA     #>err_undef
002629r 2  85 rr                STA     tmp0+1
00262Br 2  20 rr rr             JSR     compile_error
00262Er 2  AD rr rr     :       LDA     fcall_hi
002631r 2  85 rr                STA     scratch
002633r 2  AD rr rr             LDA     fcall_lo
002636r 2  20 rr rr             JSR     emit_CALL
002639r 2               ; restore expr_type (parse_expression in args may have changed it)
002639r 2  AD rr rr             LDA     fcall_type
00263Cr 2  85 rr                STA     expr_type
00263Er 2  60                   RTS
00263Fr 2               
00263Fr 2               @paren:
00263Fr 2  20 rr rr             JSR     next_token      ; consume '('
002642r 2  20 rr rr             JSR     parse_expression
002645r 2  A5 rr                LDA     tok_type
002647r 2  C9 1C                CMP     #TOK_RPAREN
002649r 2  D0 03                BNE     :+
00264Br 2  20 rr rr             JSR     next_token
00264Er 2               :
00264Er 2  60                   RTS                     ; expr_type already set by parse_expression
00264Fr 2               
00264Fr 2               @not_expr:
00264Fr 2  20 rr rr             JSR     next_token
002652r 2  20 rr rr             JSR     parse_factor
002655r 2  20 rr rr             JSR     emit_LNOT
002658r 2  A9 03                LDA     #TY_BOOL
00265Ar 2  85 rr                STA     expr_type
00265Cr 2  60                   RTS
00265Dr 2               
00265Dr 2               @nil:
00265Dr 2  20 rr rr             JSR     emit_LDCN
002660r 2  20 rr rr             JSR     next_token
002663r 2  A9 07                LDA     #TY_PTR
002665r 2  85 rr                STA     expr_type
002667r 2  60                   RTS
002668r 2               
002668r 2               ; ---------------------------------------------------------------------------
002668r 2               ; String built-in helpers — entered from parse_factor's @ident_or_call.
002668r 2               ; The identifier is still the current token on entry.
002668r 2               ; ---------------------------------------------------------------------------
002668r 2               
002668r 2               ; Skip current token if it matches A; otherwise just fall through.
002668r 2               ; Used to consume optional punctuation like '(' / ')' / ',' without aborting
002668r 2               ; on a missing token (compile_error elsewhere will catch malformed code).
002668r 2               parse_eat_token:
002668r 2  C5 rr                CMP     tok_type
00266Ar 2  D0 03                BNE     :+
00266Cr 2  4C rr rr             JMP     next_token
00266Fr 2  60           :       RTS
002670r 2               
002670r 2               parse_builtin_length:
002670r 2  20 rr rr             JSR     next_token              ; consume LENGTH
002673r 2  A9 1B                LDA     #TOK_LPAREN
002675r 2  20 rr rr             JSR     parse_eat_token
002678r 2  20 rr rr             JSR     parse_expression        ; pushes string ptr
00267Br 2  A9 1C                LDA     #TOK_RPAREN
00267Dr 2  20 rr rr             JSR     parse_eat_token
002680r 2  20 rr rr             JSR     emit_LEN
002683r 2  A9 01                LDA     #TY_INT
002685r 2  85 rr                STA     expr_type
002687r 2  60                   RTS
002688r 2               
002688r 2               parse_builtin_pos:
002688r 2  20 rr rr             JSR     next_token              ; consume POS
00268Br 2  A9 1B                LDA     #TOK_LPAREN
00268Dr 2  20 rr rr             JSR     parse_eat_token
002690r 2  20 rr rr             JSR     parse_expression        ; substr
002693r 2  A9 1F                LDA     #TOK_COMMA
002695r 2  20 rr rr             JSR     parse_eat_token
002698r 2  20 rr rr             JSR     parse_expression        ; mainstr
00269Br 2  A9 1C                LDA     #TOK_RPAREN
00269Dr 2  20 rr rr             JSR     parse_eat_token
0026A0r 2  20 rr rr             JSR     emit_POS
0026A3r 2  A9 01                LDA     #TY_INT
0026A5r 2  85 rr                STA     expr_type
0026A7r 2  60                   RTS
0026A8r 2               
0026A8r 2               parse_builtin_copy:
0026A8r 2  20 rr rr             JSR     next_token              ; consume COPY
0026ABr 2  A9 1B                LDA     #TOK_LPAREN
0026ADr 2  20 rr rr             JSR     parse_eat_token
0026B0r 2  20 rr rr             JSR     parse_expression        ; src string
0026B3r 2  A9 1F                LDA     #TOK_COMMA
0026B5r 2  20 rr rr             JSR     parse_eat_token
0026B8r 2  20 rr rr             JSR     parse_expression        ; index
0026BBr 2  A9 1F                LDA     #TOK_COMMA
0026BDr 2  20 rr rr             JSR     parse_eat_token
0026C0r 2  20 rr rr             JSR     parse_expression        ; count
0026C3r 2  A9 1C                LDA     #TOK_RPAREN
0026C5r 2  20 rr rr             JSR     parse_eat_token
0026C8r 2  20 rr rr             JSR     emit_COPY
0026CBr 2  A9 04                LDA     #TY_STRING
0026CDr 2  85 rr                STA     expr_type
0026CFr 2  60                   RTS
0026D0r 2               
0026D0r 2               ; CONCAT(s1, s2 [, s3, ...]) — emit chained CONCAT2.  Each pair-merge writes
0026D0r 2               ; into the next round-robin work buffer, so 3+ args work as long as the
0026D0r 2               ; intermediate buffer isn't recycled before being consumed.
0026D0r 2               parse_builtin_concat:
0026D0r 2  20 rr rr             JSR     next_token              ; consume CONCAT
0026D3r 2  A9 1B                LDA     #TOK_LPAREN
0026D5r 2  20 rr rr             JSR     parse_eat_token
0026D8r 2  20 rr rr             JSR     parse_expression        ; first arg on stack
0026DBr 2  A5 rr                LDA     tok_type
0026DDr 2  C9 1F                CMP     #TOK_COMMA
0026DFr 2  F0 0A                BEQ     @cat_more
0026E1r 2               ; Single-arg CONCAT — just leave the string on the stack (rare/edge case).
0026E1r 2  A9 1C                LDA     #TOK_RPAREN
0026E3r 2  20 rr rr             JSR     parse_eat_token
0026E6r 2  A9 04                LDA     #TY_STRING
0026E8r 2  85 rr                STA     expr_type
0026EAr 2  60                   RTS
0026EBr 2               @cat_more:
0026EBr 2  20 rr rr             JSR     next_token              ; consume ','
0026EEr 2  20 rr rr             JSR     parse_expression        ; next arg
0026F1r 2  20 rr rr             JSR     emit_CONCAT             ; merge previous + next
0026F4r 2  A5 rr                LDA     tok_type
0026F6r 2  C9 1F                CMP     #TOK_COMMA
0026F8r 2  F0 F1                BEQ     @cat_more
0026FAr 2  A9 1C                LDA     #TOK_RPAREN
0026FCr 2  20 rr rr             JSR     parse_eat_token
0026FFr 2  A9 04                LDA     #TY_STRING
002701r 2  85 rr                STA     expr_type
002703r 2  60                   RTS
002704r 2               
002704r 2               ; ---------------------------------------------------------------------------
002704r 2               ; File built-in helpers — entered from parse_assign_or_call (statement form)
002704r 2               ; or parse_factor's @ident_or_call (EOF as expression).
002704r 2               ; ---------------------------------------------------------------------------
002704r 2               
