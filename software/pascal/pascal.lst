00286Fr 2               ; ---------------------------------------------------------------------------
00286Fr 2               ; codegen_alloc_array_global — allocate ARRAY [array_lo..array_hi] in globals
00286Fr 2               ; Element size fixed at 2 (all scalars are word-sized).
00286Fr 2               ; Returns: tmp2 = adjusted_offset = raw_base - lo*2
00286Fr 2               ;          cg_globals advanced by (hi - lo + 1) * 2
00286Fr 2               ; Clobbers: tmp2, tmp3
00286Fr 2               ; ---------------------------------------------------------------------------
00286Fr 2               codegen_alloc_array_global:
00286Fr 2               ; count = hi - lo + 1  (16-bit)
00286Fr 2  AD rr rr             LDA     array_hi
002872r 2  38                   SEC
002873r 2  ED rr rr             SBC     array_lo
002876r 2  85 rr                STA     tmp2
002878r 2  AD rr rr             LDA     array_hi+1
00287Br 2  ED rr rr             SBC     array_lo+1
00287Er 2  85 rr                STA     tmp2+1
002880r 2  E6 rr                INC     tmp2
002882r 2  D0 02                BNE     :+
002884r 2  E6 rr                INC     tmp2+1
002886r 2               :
002886r 2               ; alloc_size = count * 2
002886r 2  06 rr                ASL     tmp2
002888r 2  26 rr                ROL     tmp2+1
00288Ar 2               ; save raw_base = cg_globals before advancing
00288Ar 2  A5 rr                LDA     cg_globals
00288Cr 2  85 rr                STA     tmp3
00288Er 2  A5 rr                LDA     cg_globals+1
002890r 2  85 rr                STA     tmp3+1
002892r 2               ; advance cg_globals by alloc_size (tmp2)
002892r 2  A5 rr                LDA     cg_globals
002894r 2  18                   CLC
002895r 2  65 rr                ADC     tmp2
002897r 2  85 rr                STA     cg_globals
002899r 2  A5 rr                LDA     cg_globals+1
00289Br 2  65 rr                ADC     tmp2+1
00289Dr 2  85 rr                STA     cg_globals+1
00289Fr 2               ; adjusted_offset = raw_base (tmp3) - lo*2 (tmp2 reused)
00289Fr 2  AD rr rr             LDA     array_lo
0028A2r 2  0A                   ASL
0028A3r 2  85 rr                STA     tmp2
0028A5r 2  AD rr rr             LDA     array_lo+1
0028A8r 2  2A                   ROL
0028A9r 2  85 rr                STA     tmp2+1
0028ABr 2  A5 rr                LDA     tmp3
0028ADr 2  38                   SEC
0028AEr 2  E5 rr                SBC     tmp2
0028B0r 2  85 rr                STA     tmp2
0028B2r 2  A5 rr                LDA     tmp3+1
0028B4r 2  E5 rr                SBC     tmp2+1
0028B6r 2  85 rr                STA     tmp2+1
0028B8r 2  60                   RTS
0028B9r 2               
0028B9r 2               ; ---------------------------------------------------------------------------
0028B9r 2               ; codegen_alloc_record_global — reserve record_size bytes in globals
0028B9r 2               ; Returns: tmp2 = offset of record's first byte
0028B9r 2               ;          cg_globals advanced by record_size
0028B9r 2               ; ---------------------------------------------------------------------------
0028B9r 2               codegen_alloc_record_global:
0028B9r 2  A5 rr                LDA     cg_globals
0028BBr 2  85 rr                STA     tmp2
0028BDr 2  A5 rr                LDA     cg_globals+1
0028BFr 2  85 rr                STA     tmp2+1
0028C1r 2  18                   CLC
0028C2r 2  A5 rr                LDA     cg_globals
0028C4r 2  6D rr rr             ADC     record_size
0028C7r 2  85 rr                STA     cg_globals
0028C9r 2  A5 rr                LDA     cg_globals+1
0028CBr 2  6D rr rr             ADC     record_size+1
0028CEr 2  85 rr                STA     cg_globals+1
0028D0r 2  60                   RTS
0028D1r 2               
0028D1r 2               ; ---------------------------------------------------------------------------
0028D1r 2               ; codegen_alloc_text_global — reserve FILE_STRUCT_SZ (168) bytes for a TEXT
0028D1r 2               ; variable.  Returns tmp2 = offset of struct's first byte; cg_globals bumped.
0028D1r 2               ; ---------------------------------------------------------------------------
0028D1r 2               codegen_alloc_text_global:
0028D1r 2  A5 rr                LDA     cg_globals
0028D3r 2  85 rr                STA     tmp2
0028D5r 2  A5 rr                LDA     cg_globals+1
0028D7r 2  85 rr                STA     tmp2+1
0028D9r 2  18                   CLC
0028DAr 2  A5 rr                LDA     cg_globals
0028DCr 2  69 A8                ADC     #FILE_STRUCT_SZ
0028DEr 2  85 rr                STA     cg_globals
0028E0r 2  A5 rr                LDA     cg_globals+1
0028E2r 2  69 00                ADC     #0
0028E4r 2  85 rr                STA     cg_globals+1
0028E6r 2  60                   RTS
