0014D4r 2               @str_lit:
0014D4r 2               ; Inline string: emit OP_LDCS + length + chars.  Runtime pushes the
0014D4r 2               ; address of the length byte as a Pascal-string pointer.
0014D4r 2  20 rr rr             JSR     emit_LDCS
0014D7r 2  20 rr rr             JSR     next_token
0014DAr 2  A9 04                LDA     #TY_STRING
0014DCr 2  85 rr                STA     expr_type
0014DEr 2  60                   RTS
0014DFr 2               
0014DFr 2               @ident_or_call:
0014DFr 2               ; First check for built-ins (LENGTH/POS/COPY/CONCAT/EOF/EOLN/TRUE/FALSE)
0014DFr 2               ; by length+initial.  These take precedence over user identifiers
0014DFr 2               ; (matching WRITE/READ handling in parse_assign_or_call).  All dispatch
0014DFr 2               ; branches use JMPs because the target blocks are scattered too far for
0014DFr 2               ; ±127 byte BEQ range.
0014DFr 2  AD rr rr             LDA     ident_buf
0014E2r 2  C9 03                CMP     #3
0014E4r 2  D0 03                BNE     @bi_dn3
0014E6r 2  4C rr rr             JMP     @bi_chk3
0014E9r 2               @bi_dn3:
0014E9r 2  C9 04                CMP     #4
0014EBr 2  D0 03                BNE     @bi_dn4
0014EDr 2  4C rr rr             JMP     @bi_chk4
0014F0r 2               @bi_dn4:
0014F0r 2  C9 05                CMP     #5
0014F2r 2  D0 03                BNE     @bi_dn5
0014F4r 2  4C rr rr             JMP     @bi_chk5
0014F7r 2               @bi_dn5:
0014F7r 2  C9 06                CMP     #6
0014F9r 2  D0 03                BNE     @bi_dn6
0014FBr 2  4C rr rr             JMP     @bi_chk_len_or_cat
0014FEr 2               @bi_dn6:
0014FEr 2  4C rr rr             JMP     @do_lookup
001501r 2               @bi_chk4:
001501r 2               ; 4-letter built-ins: COPY, EOLN, TRUE
001501r 2  AD rr rr             LDA     ident_buf+1
001504r 2  C9 43                CMP     #'C'
001506r 2  D0 03                BNE     :+
001508r 2  4C rr rr             JMP     @bi_chk_copy
00150Br 2               :
00150Br 2  C9 45                CMP     #'E'
00150Dr 2  F0 07                BEQ     @bi_try_eoln
00150Fr 2  C9 54                CMP     #'T'
001511r 2  F0 1B                BEQ     @bi_try_true
001513r 2  4C rr rr             JMP     @do_lookup
001516r 2               @bi_try_eoln:
001516r 2  AD rr rr             LDA     ident_buf+2
001519r 2  C9 4F                CMP     #'O'
00151Br 2  D0 29                BNE     @bi4_no
00151Dr 2  AD rr rr             LDA     ident_buf+3
001520r 2  C9 4C                CMP     #'L'
001522r 2  D0 22                BNE     @bi4_no
001524r 2  AD rr rr             LDA     ident_buf+4
001527r 2  C9 4E                CMP     #'N'
001529r 2  D0 1B                BNE     @bi4_no
00152Br 2  4C rr rr             JMP     parse_builtin_eoln
00152Er 2               @bi_try_true:
00152Er 2  AD rr rr             LDA     ident_buf+2
001531r 2  C9 52                CMP     #'R'
001533r 2  D0 11                BNE     @bi4_no
001535r 2  AD rr rr             LDA     ident_buf+3
001538r 2  C9 55                CMP     #'U'
00153Ar 2  D0 0A                BNE     @bi4_no
00153Cr 2  AD rr rr             LDA     ident_buf+4
00153Fr 2  C9 45                CMP     #'E'
001541r 2  D0 03                BNE     @bi4_no
001543r 2  4C rr rr             JMP     parse_builtin_true
001546r 2               @bi4_no:
001546r 2  4C rr rr             JMP     @do_lookup
001549r 2               @bi_chk5:
001549r 2               ; 5-letter built-ins: FALSE
001549r 2  AD rr rr             LDA     ident_buf+1
00154Cr 2  C9 46                CMP     #'F'
00154Er 2  D0 1F                BNE     @bi5_no
001550r 2  AD rr rr             LDA     ident_buf+2
001553r 2  C9 41                CMP     #'A'
001555r 2  D0 18                BNE     @bi5_no
001557r 2  AD rr rr             LDA     ident_buf+3
00155Ar 2  C9 4C                CMP     #'L'
00155Cr 2  D0 11                BNE     @bi5_no
00155Er 2  AD rr rr             LDA     ident_buf+4
001561r 2  C9 53                CMP     #'S'
001563r 2  D0 0A                BNE     @bi5_no
001565r 2  AD rr rr             LDA     ident_buf+5
001568r 2  C9 45                CMP     #'E'
00156Ar 2  D0 03                BNE     @bi5_no
00156Cr 2  4C rr rr             JMP     parse_builtin_false
00156Fr 2               @bi5_no:
00156Fr 2  4C rr rr             JMP     @do_lookup
001572r 2               @bi_chk3:
001572r 2               ; 3-letter built-ins: POS, EOF
001572r 2  AD rr rr             LDA     ident_buf+1
001575r 2  C9 50                CMP     #'P'
001577r 2  F0 17                BEQ     @bi_chk_pos
001579r 2  C9 45                CMP     #'E'
00157Br 2  F0 02                BEQ     @bi_chk_eof
00157Dr 2  80 6E                BRA     @do_lookup
00157Fr 2               @bi_chk_eof:
00157Fr 2  AD rr rr             LDA     ident_buf+2
001582r 2  C9 4F                CMP     #'O'
001584r 2  D0 67                BNE     @do_lookup
001586r 2  AD rr rr             LDA     ident_buf+3
001589r 2  C9 46                CMP     #'F'
00158Br 2  D0 60                BNE     @do_lookup
00158Dr 2  4C rr rr             JMP     parse_builtin_eof
001590r 2               @bi_chk_pos:
001590r 2  AD rr rr             LDA     ident_buf+2
001593r 2  C9 4F                CMP     #'O'
001595r 2  D0 56                BNE     @do_lookup
001597r 2  AD rr rr             LDA     ident_buf+3
00159Ar 2  C9 53                CMP     #'S'
00159Cr 2  D0 4F                BNE     @do_lookup
00159Er 2  4C rr rr             JMP     parse_builtin_pos
0015A1r 2               @bi_chk_copy:
0015A1r 2  AD rr rr             LDA     ident_buf+1
0015A4r 2  C9 43                CMP     #'C'
0015A6r 2  D0 45                BNE     @do_lookup
0015A8r 2  AD rr rr             LDA     ident_buf+2
0015ABr 2  C9 4F                CMP     #'O'
0015ADr 2  D0 3E                BNE     @do_lookup
0015AFr 2  AD rr rr             LDA     ident_buf+3
0015B2r 2  C9 50                CMP     #'P'
0015B4r 2  D0 37                BNE     @do_lookup
0015B6r 2  AD rr rr             LDA     ident_buf+4
0015B9r 2  C9 59                CMP     #'Y'
0015BBr 2  D0 30                BNE     @do_lookup
0015BDr 2  4C rr rr             JMP     parse_builtin_copy
0015C0r 2               @bi_chk_len_or_cat:
0015C0r 2  AD rr rr             LDA     ident_buf+1
0015C3r 2  C9 4C                CMP     #'L'
0015C5r 2  F0 15                BEQ     @bi_try_length
0015C7r 2  C9 43                CMP     #'C'
0015C9r 2  D0 22                BNE     @do_lookup
0015CBr 2               ; CONCAT? check 'O','N','C','A','T'
0015CBr 2  AD rr rr             LDA     ident_buf+2
0015CEr 2  C9 4F                CMP     #'O'
0015D0r 2  D0 1B                BNE     @do_lookup
0015D2r 2  AD rr rr             LDA     ident_buf+3
0015D5r 2  C9 4E                CMP     #'N'
0015D7r 2  D0 14                BNE     @do_lookup
0015D9r 2  4C rr rr             JMP     parse_builtin_concat
0015DCr 2               @bi_try_length:
0015DCr 2  AD rr rr             LDA     ident_buf+2
0015DFr 2  C9 45                CMP     #'E'
0015E1r 2  D0 0A                BNE     @do_lookup
0015E3r 2  AD rr rr             LDA     ident_buf+3
0015E6r 2  C9 4E                CMP     #'N'
0015E8r 2  D0 03                BNE     @do_lookup
0015EAr 2  4C rr rr             JMP     parse_builtin_length
0015EDr 2               @do_lookup:
0015EDr 2               ; Look up BEFORE next_token — next_token may overwrite ident_buf
0015EDr 2               ; if the following token is an identifier or keyword (e.g. J THEN).
0015EDr 2  20 rr rr             JSR     symtab_find
0015F0r 2  B0 0F                BCS     @sym_ok
0015F2r 2  20 rr rr             JSR     next_token      ; consume ident
0015F5r 2  A9 00                LDA     #0
0015F7r 2  85 rr                STA     scratch
0015F9r 2  20 rr rr             JSR     emit_LDCW       ; undefined: emit 0
0015FCr 2  A9 01                LDA     #TY_INT
0015FEr 2  85 rr                STA     expr_type
001600r 2  60                   RTS
001601r 2               @sym_ok:
001601r 2               ; Snapshot kind/type/scope/offset/pcount onto the 6502 stack —
001601r 2               ; sym_save_* would conflict with parse_assign_or_call when this
001601r 2               ; @ident_or_call runs inside a nested parse_expression.
001601r 2  A0 16                LDY     #22
001603r 2  B1 rr                LDA     (tmp3),y
001605r 2  8D rr rr             STA     fcall_vmask     ; (only meaningful for SYM_FUNC)
001608r 2  A0 17                LDY     #23
00160Ar 2  B1 rr                LDA     (tmp3),y
00160Cr 2  8D rr rr             STA     fcall_lsize     ; full local-area size for MRKSTK
00160Fr 2  A0 15                LDY     #21
001611r 2  B1 rr                LDA     (tmp3),y
001613r 2  48                   PHA                     ; pcount (deepest)
001614r 2  A0 10                LDY     #16
001616r 2  B1 rr                LDA     (tmp3),y
001618r 2  48                   PHA                     ; kind
001619r 2  A0 11                LDY     #17
00161Br 2  B1 rr                LDA     (tmp3),y
00161Dr 2  85 rr                STA     expr_type       ; data type code
00161Fr 2  A0 14                LDY     #20
001621r 2  B1 rr                LDA     (tmp3),y
001623r 2  48                   PHA                     ; scope
001624r 2  A0 13                LDY     #19
001626r 2  B1 rr                LDA     (tmp3),y
001628r 2  48                   PHA                     ; off hi
001629r 2  A0 12                LDY     #18
00162Br 2  B1 rr                LDA     (tmp3),y
00162Dr 2  48                   PHA                     ; off lo (top)
00162Er 2  20 rr rr             JSR     next_token      ; consume ident (may overwrite ident_buf/tmp3)
001631r 2  68                   PLA                     ; off lo
001632r 2  AA                   TAX                     ; X = off lo
001633r 2  68                   PLA                     ; off hi
001634r 2  85 rr                STA     scratch         ; scratch = off hi
001636r 2  68                   PLA                     ; scope
001637r 2  A8                   TAY                     ; Y = scope (preserved across kind test)
001638r 2  68                   PLA                     ; kind
001639r 2  C9 04                CMP     #SYM_FUNC
00163Br 2  D0 03                BNE     :+
00163Dr 2  4C rr rr             JMP     @sym_func_call
001640r 2               :
001640r 2  C9 02                CMP     #SYM_CONST
001642r 2  D0 03                BNE     :+
001644r 2  4C rr rr             JMP     @const_emit
001647r 2               :
001647r 2  C9 08                CMP     #SYM_VARREF
001649r 2  D0 03                BNE     :+
00164Br 2  4C rr rr             JMP     @varref_load
00164Er 2               :
00164Er 2               ; SYM_VAR (default; PROC also falls through here for now)
00164Er 2  68                   PLA                     ; discard pcount
00164Fr 2  C0 00                CPY     #0
001651r 2  D0 23                BNE     @local_load
001653r 2               ; global SYM_VAR — check for array subscript, record field, or TEXT file
001653r 2  A5 rr                LDA     expr_type
001655r 2  C9 05                CMP     #TY_ARRAY
001657r 2  F0 11                BEQ     @arr_rhs_global
001659r 2  C9 06                CMP     #TY_RECORD
00165Br 2  F0 13                BEQ     @rec_rhs_global
00165Dr 2  C9 08                CMP     #TY_TEXT
00165Fr 2  F0 05                BEQ     @text_rhs_global
001661r 2  8A                   TXA
001662r 2  20 rr rr             JSR     emit_LDG
001665r 2  60                   RTS
001666r 2               @text_rhs_global:
001666r 2  8A                   TXA                     ; push struct address, leave expr_type=TY_TEXT
001667r 2  4C rr rr             JMP     emit_LDA_G
00166Ar 2               @arr_rhs_global:
00166Ar 2  8A                   TXA                     ; A=off_lo, scratch=off_hi still valid
00166Br 2  20 rr rr             JSR     emit_LDA_G
00166Er 2  80 21                BRA     @arr_rhs_index
001670r 2               @rec_rhs_global:
001670r 2  8A                   TXA                     ; A=off_lo, scratch=off_hi
001671r 2  20 rr rr             JSR     emit_LDA_G
001674r 2  80 45                BRA     @rec_rhs_field
001676r 2               @local_load:
001676r 2  A5 rr                LDA     expr_type
001678r 2  C9 05                CMP     #TY_ARRAY
00167Ar 2  F0 11                BEQ     @arr_rhs_local
00167Cr 2  C9 06                CMP     #TY_RECORD
00167Er 2  F0 37                BEQ     @rec_rhs_local
001680r 2  C9 08                CMP     #TY_TEXT
001682r 2  F0 05                BEQ     @text_rhs_local
001684r 2  8A                   TXA
001685r 2  20 rr rr             JSR     emit_LDL
001688r 2  60                   RTS
001689r 2               @text_rhs_local:
001689r 2  8A                   TXA
00168Ar 2  4C rr rr             JMP     emit_LDA_L
00168Dr 2               @arr_rhs_local:
00168Dr 2  8A                   TXA
00168Er 2  20 rr rr             JSR     emit_LDA_L
001691r 2               @arr_rhs_index:
001691r 2               ; parse [index], emit INDEX, LDIND
001691r 2  A5 rr                LDA     tok_type
001693r 2  C9 1D                CMP     #TOK_LBRACK
001695r 2  D0 03                BNE     :+
001697r 2  20 rr rr             JSR     next_token
00169Ar 2  20 rr rr     :       JSR     parse_expression    ; clobbers expr_type, scratch, tmp*
00169Dr 2  A5 rr                LDA     tok_type
00169Fr 2  C9 1E                CMP     #TOK_RBRACK
0016A1r 2  D0 03                BNE     :+
0016A3r 2  20 rr rr             JSR     next_token
0016A6r 2  A9 00        :       LDA     #0
0016A8r 2  85 rr                STA     scratch
0016AAr 2  A9 02                LDA     #2
0016ACr 2  20 rr rr             JSR     emit_INDEX
0016AFr 2  20 rr rr             JSR     emit_LDIND
0016B2r 2  A9 01                LDA     #TY_INT
0016B4r 2  85 rr                STA     expr_type
0016B6r 2  60                   RTS
0016B7r 2               @rec_rhs_local:
0016B7r 2  8A                   TXA
0016B8r 2  20 rr rr             JSR     emit_LDA_L
0016BBr 2               @rec_rhs_field:
0016BBr 2               ; consume '.'
0016BBr 2  A5 rr                LDA     tok_type
0016BDr 2  C9 22                CMP     #TOK_DOT
0016BFr 2  D0 03                BNE     :+
0016C1r 2  20 rr rr             JSR     next_token
0016C4r 2               :
0016C4r 2               ; field name now in ident_buf — look up
0016C4r 2  AD rr rr             LDA     fcall_vmask     ; first_field_idx (saved from byte 22)
0016C7r 2  AE rr rr             LDX     fcall_lsize     ; field_count (saved from byte 23)
0016CAr 2  20 rr rr             JSR     field_lookup_in_record
0016CDr 2  90 18                BCC     @rec_rhs_nf
0016CFr 2  48                   PHA                     ; save offset
0016D0r 2  8A                   TXA
0016D1r 2  85 rr                STA     scratch         ; save field type (preserved across emits)
0016D3r 2  68                   PLA                     ; offset back; PLA sets Z for the BEQ below
0016D4r 2  F0 06                BEQ     @rec_rhs_no_off
0016D6r 2  20 rr rr             JSR     emit_LDCI
0016D9r 2  20 rr rr             JSR     emit_ADI
0016DCr 2               @rec_rhs_no_off:
0016DCr 2  20 rr rr             JSR     next_token      ; consume field name
0016DFr 2  20 rr rr             JSR     emit_LDIND
0016E2r 2  A5 rr                LDA     scratch
0016E4r 2  85 rr                STA     expr_type       ; field's type drives WRITE dispatch
0016E6r 2  60                   RTS
0016E7r 2               @rec_rhs_nf:
0016E7r 2  A9 rr                LDA     #<err_undef
0016E9r 2  85 rr                STA     tmp0
0016EBr 2  A9 rr                LDA     #>err_undef
0016EDr 2  85 rr                STA     tmp0+1
0016EFr 2  20 rr rr             JSR     compile_error
0016F2r 2  20 rr rr             JSR     next_token      ; consume bad field name
0016F5r 2  20 rr rr             JSR     emit_LDIND      ; keep stack balanced
0016F8r 2  A9 01                LDA     #TY_INT
0016FAr 2  85 rr                STA     expr_type
0016FCr 2  60                   RTS
0016FDr 2               @varref_load:
0016FDr 2               ; SYM_VARREF: local slot holds an address. Emit LDL then LDIND.
0016FDr 2  68                   PLA                     ; discard pcount
0016FEr 2  8A                   TXA
0016FFr 2  20 rr rr             JSR     emit_LDL        ; push address from slot
001702r 2  20 rr rr             JSR     emit_LDIND      ; deref → push word
001705r 2  60                   RTS
001706r 2               @const_emit:
001706r 2               ; CONST: offset bytes hold the literal value. X=lo, scratch=hi.
001706r 2  68                   PLA                     ; discard pcount
001707r 2  8A                   TXA
001708r 2  20 rr rr             JSR     emit_LDCW
00170Br 2  60                   RTS
00170Cr 2               @sym_func_call:
00170Cr 2               ; SYM_FUNC: emit MRKSTK + arg-stores + CALL.  Result is left on TOS
00170Cr 2               ; by op_RETF.  expr_type is the function's return type (already set).
00170Cr 2               ; X=off lo, scratch=off hi, top of 6502 stack = pcount.
00170Cr 2               ; NOTE: not nest-safe — calling a function inside another function
00170Cr 2               ; call's argument list will clobber fcall_*.  TODO: fix later.
00170Cr 2  8E rr rr             STX     fcall_lo
00170Fr 2  A5 rr                LDA     scratch
001711r 2  8D rr rr             STA     fcall_hi
001714r 2  A5 rr                LDA     expr_type
001716r 2  8D rr rr             STA     fcall_type      ; preserve across parse_expression
001719r 2  68                   PLA                     ; pcount
00171Ar 2  8D rr rr             STA     fcall_pcount
00171Dr 2               ; emit MRKSTK <full local-area size> (params + body locals).
00171Dr 2               ; fcall_lsize was captured at @sym_ok from entry offset 23.
00171Dr 2  AD rr rr             LDA     fcall_lsize
001720r 2  20 rr rr             JSR     emit_MRKSTK
001723r 2  AD rr rr             LDA     fcall_pcount
001726r 2  F0 4A                BEQ     @fc_no_args
001728r 2               ; expect '('
001728r 2  A5 rr                LDA     tok_type
00172Ar 2  C9 1B                CMP     #TOK_LPAREN
00172Cr 2  D0 56                BNE     @fc_emit_call
00172Er 2  20 rr rr             JSR     next_token      ; consume '('
001731r 2  A2 00                LDX     #0              ; X = arg index
001733r 2               @fc_arg_loop:
001733r 2               ; Bit X of fcall_vmask → VAR (push address); else value.
001733r 2  DA                   PHX
001734r 2  A9 01                LDA     #1
001736r 2               @fcvbit:
001736r 2  E0 00                CPX     #0
001738r 2  F0 04                BEQ     @fcvdone
00173Ar 2  0A                   ASL
00173Br 2  CA                   DEX
00173Cr 2  80 F8                BRA     @fcvbit
00173Er 2               @fcvdone:
00173Er 2  FA                   PLX
00173Fr 2  2D rr rr             AND     fcall_vmask
001742r 2  F0 07                BEQ     @fc_arg_value
001744r 2  DA                   PHX
001745r 2  20 rr rr             JSR     parse_arg_lvalue
001748r 2  FA                   PLX
001749r 2  80 05                BRA     @fc_arg_stored
00174Br 2               @fc_arg_value:
00174Br 2  DA                   PHX
00174Cr 2  20 rr rr             JSR     parse_expression
00174Fr 2  FA                   PLX
001750r 2               @fc_arg_stored:
001750r 2  8A                   TXA
001751r 2  0A                   ASL
001752r 2  20 rr rr             JSR     emit_STL        ; store popped value (or address) into local slot X
001755r 2  E8                   INX
001756r 2  EC rr rr             CPX     fcall_pcount
001759r 2  B0 0C                BCS     @fc_done_args
00175Br 2  A5 rr                LDA     tok_type
00175Dr 2  C9 1F                CMP     #TOK_COMMA
00175Fr 2  D0 06                BNE     @fc_done_args
001761r 2  20 rr rr             JSR     next_token      ; consume ','
001764r 2  4C rr rr             JMP     @fc_arg_loop    ; jmp — body grew past bra range
001767r 2               @fc_done_args:
001767r 2  A5 rr                LDA     tok_type
001769r 2  C9 1C                CMP     #TOK_RPAREN
00176Br 2  D0 17                BNE     @fc_emit_call
00176Dr 2  20 rr rr             JSR     next_token      ; consume ')'
001770r 2  80 12                BRA     @fc_emit_call
001772r 2               @fc_no_args:
001772r 2               ; Accept optional "()"
001772r 2  A5 rr                LDA     tok_type
001774r 2  C9 1B                CMP     #TOK_LPAREN
001776r 2  D0 0C                BNE     @fc_emit_call
001778r 2  20 rr rr             JSR     next_token
00177Br 2  A5 rr                LDA     tok_type
00177Dr 2  C9 1C                CMP     #TOK_RPAREN
00177Fr 2  D0 03                BNE     @fc_emit_call
001781r 2  20 rr rr             JSR     next_token
001784r 2               @fc_emit_call:
001784r 2  AD rr rr             LDA     fcall_hi
001787r 2  85 rr                STA     scratch
001789r 2  AD rr rr             LDA     fcall_lo
00178Cr 2  20 rr rr             JSR     emit_CALL
00178Fr 2               ; restore expr_type (parse_expression in args may have changed it)
00178Fr 2  AD rr rr             LDA     fcall_type
001792r 2  85 rr                STA     expr_type
001794r 2  60                   RTS
001795r 2               
001795r 2               @paren:
001795r 2  20 rr rr             JSR     next_token      ; consume '('
001798r 2  20 rr rr             JSR     parse_expression
00179Br 2  A5 rr                LDA     tok_type
00179Dr 2  C9 1C                CMP     #TOK_RPAREN
00179Fr 2  D0 03                BNE     :+
0017A1r 2  20 rr rr             JSR     next_token
0017A4r 2               :
0017A4r 2  60                   RTS                     ; expr_type already set by parse_expression
0017A5r 2               
0017A5r 2               @not_expr:
0017A5r 2  20 rr rr             JSR     next_token
0017A8r 2  20 rr rr             JSR     parse_factor
0017ABr 2  20 rr rr             JSR     emit_LNOT
0017AEr 2  A9 03                LDA     #TY_BOOL
0017B0r 2  85 rr                STA     expr_type
0017B2r 2  60                   RTS
0017B3r 2               
0017B3r 2               @nil:
0017B3r 2  20 rr rr             JSR     emit_LDCN
0017B6r 2  20 rr rr             JSR     next_token
0017B9r 2  A9 07                LDA     #TY_PTR
0017BBr 2  85 rr                STA     expr_type
0017BDr 2  60                   RTS
0017BEr 2               
0017BEr 2               ; ---------------------------------------------------------------------------
0017BEr 2               ; String built-in helpers — entered from parse_factor's @ident_or_call.
0017BEr 2               ; The identifier is still the current token on entry.
0017BEr 2               ; ---------------------------------------------------------------------------
0017BEr 2               
0017BEr 2               ; Skip current token if it matches A; otherwise just fall through.
0017BEr 2               ; Used to consume optional punctuation like '(' / ')' / ',' without aborting
0017BEr 2               ; on a missing token (compile_error elsewhere will catch malformed code).
0017BEr 2               parse_eat_token:
0017BEr 2  C5 rr                CMP     tok_type
0017C0r 2  D0 03                BNE     :+
0017C2r 2  4C rr rr             JMP     next_token
0017C5r 2  60           :       RTS
0017C6r 2               
0017C6r 2               parse_builtin_length:
0017C6r 2  20 rr rr             JSR     next_token              ; consume LENGTH
0017C9r 2  A9 1B                LDA     #TOK_LPAREN
0017CBr 2  20 rr rr             JSR     parse_eat_token
0017CEr 2  20 rr rr             JSR     parse_expression        ; pushes string ptr
0017D1r 2  A9 1C                LDA     #TOK_RPAREN
0017D3r 2  20 rr rr             JSR     parse_eat_token
0017D6r 2  20 rr rr             JSR     emit_LEN
0017D9r 2  A9 01                LDA     #TY_INT
0017DBr 2  85 rr                STA     expr_type
0017DDr 2  60                   RTS
0017DEr 2               
0017DEr 2               parse_builtin_pos:
0017DEr 2  20 rr rr             JSR     next_token              ; consume POS
0017E1r 2  A9 1B                LDA     #TOK_LPAREN
0017E3r 2  20 rr rr             JSR     parse_eat_token
0017E6r 2  20 rr rr             JSR     parse_expression        ; substr
0017E9r 2  A9 1F                LDA     #TOK_COMMA
0017EBr 2  20 rr rr             JSR     parse_eat_token
0017EEr 2  20 rr rr             JSR     parse_expression        ; mainstr
0017F1r 2  A9 1C                LDA     #TOK_RPAREN
0017F3r 2  20 rr rr             JSR     parse_eat_token
0017F6r 2  20 rr rr             JSR     emit_POS
0017F9r 2  A9 01                LDA     #TY_INT
0017FBr 2  85 rr                STA     expr_type
0017FDr 2  60                   RTS
0017FEr 2               
0017FEr 2               parse_builtin_copy:
0017FEr 2  20 rr rr             JSR     next_token              ; consume COPY
001801r 2  A9 1B                LDA     #TOK_LPAREN
001803r 2  20 rr rr             JSR     parse_eat_token
001806r 2  20 rr rr             JSR     parse_expression        ; src string
001809r 2  A9 1F                LDA     #TOK_COMMA
00180Br 2  20 rr rr             JSR     parse_eat_token
00180Er 2  20 rr rr             JSR     parse_expression        ; index
001811r 2  A9 1F                LDA     #TOK_COMMA
001813r 2  20 rr rr             JSR     parse_eat_token
001816r 2  20 rr rr             JSR     parse_expression        ; count
001819r 2  A9 1C                LDA     #TOK_RPAREN
00181Br 2  20 rr rr             JSR     parse_eat_token
00181Er 2  20 rr rr             JSR     emit_COPY
001821r 2  A9 04                LDA     #TY_STRING
001823r 2  85 rr                STA     expr_type
001825r 2  60                   RTS
001826r 2               
001826r 2               ; CONCAT(s1, s2 [, s3, ...]) — emit chained CONCAT2.  Each pair-merge writes
001826r 2               ; into the next round-robin work buffer, so 3+ args work as long as the
001826r 2               ; intermediate buffer isn't recycled before being consumed.
001826r 2               parse_builtin_concat:
001826r 2  20 rr rr             JSR     next_token              ; consume CONCAT
001829r 2  A9 1B                LDA     #TOK_LPAREN
00182Br 2  20 rr rr             JSR     parse_eat_token
00182Er 2  20 rr rr             JSR     parse_expression        ; first arg on stack
001831r 2  A5 rr                LDA     tok_type
001833r 2  C9 1F                CMP     #TOK_COMMA
001835r 2  F0 0A                BEQ     @cat_more
001837r 2               ; Single-arg CONCAT — just leave the string on the stack (rare/edge case).
001837r 2  A9 1C                LDA     #TOK_RPAREN
001839r 2  20 rr rr             JSR     parse_eat_token
00183Cr 2  A9 04                LDA     #TY_STRING
00183Er 2  85 rr                STA     expr_type
001840r 2  60                   RTS
001841r 2               @cat_more:
001841r 2  20 rr rr             JSR     next_token              ; consume ','
001844r 2  20 rr rr             JSR     parse_expression        ; next arg
001847r 2  20 rr rr             JSR     emit_CONCAT             ; merge previous + next
00184Ar 2  A5 rr                LDA     tok_type
00184Cr 2  C9 1F                CMP     #TOK_COMMA
00184Er 2  F0 F1                BEQ     @cat_more
001850r 2  A9 1C                LDA     #TOK_RPAREN
001852r 2  20 rr rr             JSR     parse_eat_token
001855r 2  A9 04                LDA     #TY_STRING
001857r 2  85 rr                STA     expr_type
001859r 2  60                   RTS
00185Ar 2               
00185Ar 2               ; ---------------------------------------------------------------------------
00185Ar 2               ; File built-in helpers — entered from parse_assign_or_call (statement form)
00185Ar 2               ; or parse_factor's @ident_or_call (EOF as expression).
00185Ar 2               ; ---------------------------------------------------------------------------
00185Ar 2               
00185Ar 2               ; ASSIGN(filevar, namestring)
00185Ar 2               parse_builtin_assign:
00185Ar 2  20 rr rr             JSR     next_token              ; consume ASSIGN
00185Dr 2  A9 1B                LDA     #TOK_LPAREN
00185Fr 2  20 rr rr             JSR     parse_eat_token
001862r 2  20 rr rr             JSR     parse_expression        ; file ptr (TY_TEXT)
001865r 2  A9 1F                LDA     #TOK_COMMA
001867r 2  20 rr rr             JSR     parse_eat_token
00186Ar 2  20 rr rr             JSR     parse_expression        ; filename string
00186Dr 2  A9 1C                LDA     #TOK_RPAREN
00186Fr 2  20 rr rr             JSR     parse_eat_token
001872r 2  4C rr rr             JMP     emit_FASSGN
001875r 2               
001875r 2               parse_builtin_reset:
001875r 2  20 rr rr             JSR     next_token              ; consume RESET
001878r 2  A9 1B                LDA     #TOK_LPAREN
00187Ar 2  20 rr rr             JSR     parse_eat_token
00187Dr 2  20 rr rr             JSR     parse_expression
001880r 2  A9 1C                LDA     #TOK_RPAREN
001882r 2  20 rr rr             JSR     parse_eat_token
001885r 2  4C rr rr             JMP     emit_FRESET
001888r 2               
001888r 2               parse_builtin_rewrite:
001888r 2  20 rr rr             JSR     next_token              ; consume REWRITE
00188Br 2  A9 1B                LDA     #TOK_LPAREN
00188Dr 2  20 rr rr             JSR     parse_eat_token
001890r 2  20 rr rr             JSR     parse_expression
001893r 2  A9 1C                LDA     #TOK_RPAREN
001895r 2  20 rr rr             JSR     parse_eat_token
001898r 2  4C rr rr             JMP     emit_FREWRT
00189Br 2               
00189Br 2               parse_builtin_close:
00189Br 2  20 rr rr             JSR     next_token              ; consume CLOSE
00189Er 2  A9 1B                LDA     #TOK_LPAREN
0018A0r 2  20 rr rr             JSR     parse_eat_token
0018A3r 2  20 rr rr             JSR     parse_expression
0018A6r 2  A9 1C                LDA     #TOK_RPAREN
0018A8r 2  20 rr rr             JSR     parse_eat_token
0018ABr 2  4C rr rr             JMP     emit_FCLOSE
0018AEr 2               
0018AEr 2               parse_builtin_eof:
0018AEr 2  20 rr rr             JSR     next_token              ; consume EOF
0018B1r 2  A9 1B                LDA     #TOK_LPAREN
0018B3r 2  20 rr rr             JSR     parse_eat_token
0018B6r 2  20 rr rr             JSR     parse_expression        ; file ptr (TY_TEXT)
0018B9r 2  A9 1C                LDA     #TOK_RPAREN
0018BBr 2  20 rr rr             JSR     parse_eat_token
0018BEr 2  20 rr rr             JSR     emit_FEOF
0018C1r 2  A9 03                LDA     #TY_BOOL
0018C3r 2  85 rr                STA     expr_type
0018C5r 2  60                   RTS
0018C6r 2               
0018C6r 2               parse_builtin_eoln:
0018C6r 2  20 rr rr             JSR     next_token              ; consume EOLN
0018C9r 2  A9 1B                LDA     #TOK_LPAREN
0018CBr 2  20 rr rr             JSR     parse_eat_token
0018CEr 2  20 rr rr             JSR     parse_expression        ; file ptr (TY_TEXT)
0018D1r 2  A9 1C                LDA     #TOK_RPAREN
0018D3r 2  20 rr rr             JSR     parse_eat_token
0018D6r 2  20 rr rr             JSR     emit_FEOLN
0018D9r 2  A9 03                LDA     #TY_BOOL
0018DBr 2  85 rr                STA     expr_type
0018DDr 2  60                   RTS
0018DEr 2               
0018DEr 2               ; TRUE / FALSE — predefined boolean constants.  Push 1/0 as TY_BOOL so
0018DEr 2               ; pw_emit_file routes to FWRB ("TRUE"/"FALSE") and pw_emit_console to WRITB.
0018DEr 2               parse_builtin_true:
0018DEr 2  20 rr rr             JSR     next_token              ; consume TRUE
0018E1r 2  A9 01                LDA     #1
0018E3r 2  20 rr rr             JSR     emit_LDCB
0018E6r 2  A9 03                LDA     #TY_BOOL
0018E8r 2  85 rr                STA     expr_type
0018EAr 2  60                   RTS
0018EBr 2               
0018EBr 2               parse_builtin_false:
0018EBr 2  20 rr rr             JSR     next_token              ; consume FALSE
0018EEr 2  A9 00                LDA     #0
0018F0r 2  20 rr rr             JSR     emit_LDCB
