001A52r 2               
001A52r 2               ; data type (was saved on stack first)
001A52r 2  68                   PLA
001A53r 2  A0 11                LDY     #17
001A55r 2  91 rr                STA     (tmp3),y
001A57r 2               
001A57r 2               ; kind (was saved on stack second-to-last → on top first)
001A57r 2  68                   PLA
001A58r 2  A0 10                LDY     #16
001A5Ar 2  91 rr                STA     (tmp3),y
