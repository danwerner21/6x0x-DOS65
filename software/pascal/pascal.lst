002402r 2  A9 1B                LDA     #TOK_LPAREN
002404r 2  20 rr rr             JSR     parse_eat_token
002407r 2  20 rr rr             JSR     parse_expression        ; substr
00240Ar 2  A9 1F                LDA     #TOK_COMMA
00240Cr 2  20 rr rr             JSR     parse_eat_token
00240Fr 2  20 rr rr             JSR     parse_expression        ; mainstr
002412r 2  A9 1C                LDA     #TOK_RPAREN
002414r 2  20 rr rr             JSR     parse_eat_token
002417r 2  20 rr rr             JSR     emit_POS
00241Ar 2  A9 01                LDA     #TY_INT
00241Cr 2  85 rr                STA     expr_type
00241Er 2  60                   RTS
00241Fr 2               
00241Fr 2               parse_builtin_copy:
