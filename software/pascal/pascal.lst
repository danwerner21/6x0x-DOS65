001658r 2  4C rr rr             JMP     @do_lookup
00165Br 2               @bi_try_eoln:
00165Br 2  AD rr rr             LDA     ident_buf+2
00165Er 2  C9 4F                CMP     #'O'
001660r 2  D0 29                BNE     @bi4_no
001662r 2  AD rr rr             LDA     ident_buf+3
001665r 2  C9 4C                CMP     #'L'
001667r 2  D0 22                BNE     @bi4_no
001669r 2  AD rr rr             LDA     ident_buf+4
00166Cr 2  C9 4E                CMP     #'N'
00166Er 2  D0 1B                BNE     @bi4_no
001670r 2  4C rr rr             JMP     parse_builtin_eoln
001673r 2               @bi_try_true:
001673r 2  AD rr rr             LDA     ident_buf+2
001676r 2  C9 52                CMP     #'R'
001678r 2  D0 11                BNE     @bi4_no
00167Ar 2  AD rr rr             LDA     ident_buf+3
00167Dr 2  C9 55                CMP     #'U'
00167Fr 2  D0 0A                BNE     @bi4_no
001681r 2  AD rr rr             LDA     ident_buf+4
001684r 2  C9 45                CMP     #'E'
001686r 2  D0 03                BNE     @bi4_no
001688r 2  4C rr rr             JMP     parse_builtin_true
00168Br 2               @bi4_no:
00168Br 2  4C rr rr             JMP     @do_lookup
