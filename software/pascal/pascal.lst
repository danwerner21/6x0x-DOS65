0018C7r 2  20 rr rr     :       JSR     parse_expression
0018CAr 2  A5 rr                LDA     tok_type
0018CCr 2  C9 1E                CMP     #TOK_RBRACK
0018CEr 2  D0 03                BNE     :+
0018D0r 2  20 rr rr             JSR     next_token
0018D3r 2               :
0018D3r 2               ; emit INDEX 2 0  (elemsize = 2 words)
0018D3r 2  A9 00                LDA     #0
0018D5r 2  85 rr                STA     scratch
0018D7r 2  A9 02                LDA     #2
0018D9r 2  20 rr rr             JSR     emit_INDEX
0018DCr 2               ; consume ':='
0018DCr 2  A5 rr                LDA     tok_type
0018DEr 2  C9 1A                CMP     #TOK_ASSIGN
