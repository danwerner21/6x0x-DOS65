0019F0r 2  A0 00                LDY     #0
0019F2r 2  B1 rr                LDA     (tmp3),y
0019F4r 2  CD rr rr             CMP     ident_buf
0019F7r 2  D0 D6                BNE     @loop
0019F9r 2               ; compare name chars
0019F9r 2  AA                   TAX                     ; X = length
0019FAr 2  A0 00                LDY     #0
