0017B4r 2               @lookup_symtab:
0017B4r 2               ; look up identifier in symbol table
0017B4r 2  20 rr rr             JSR     symtab_find
0017B7r 2  B0 0F                BCS     @found_sym
0017B9r 2               ; undefined — error
0017B9r 2  A9 rr                LDA     #<err_undef
0017BBr 2  85 rr                STA     tmp0
0017BDr 2  A9 rr                LDA     #>err_undef
0017BFr 2  85 rr                STA     tmp0+1
