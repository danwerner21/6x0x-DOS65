000000r 1               ; pascal.asm — Pascal/65 Compiler for DOS/65
000000r 1               ;
000000r 1               ; Usage: PASCAL <sourcename>
000000r 1               ;   Reads <sourcename>.PAS, writes <sourcename>.PCD
000000r 1               ;
000000r 1               ; Phase 1 entry point and top-level driver only.
000000r 1               ; Lexer, parser, symbol table, and code generator are in separate files
000000r 1               ; included at the bottom of this file.
000000r 1               
000000r 1               .PC02   ; enable 65C02 (bra/phx/plx) for write_pcd etc.
000000r 1                       ; lexer.asm also asserts this; included files
000000r 1                       ; pick it up after lexer.asm runs.
000000r 1               
000000r 1                       .include        "DEFINITIONS.ASM"
000000r 2               ; definitions.asm — constants, token codes, p-code opcodes, macros
000000r 2               
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               ; DOS/65 system entry points
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               PEM_ENTRY       = $0103         ; JSR here; function # in X
000000r 2               WARM_BOOT       = $0100
000000r 2               DEFAULT_FCB     = $0107         ; DOS/65 dflfcb (parsed argument FCB)
000000r 2               DMA_BUF         = $0128         ; DOS/65 dflbuf (default DMA buffer)
000000r 2               
000000r 2               ; PEM function numbers
000000r 2               PEM_CONIN       = 1             ; console input with echo (blocking)
000000r 2               PEM_CONOUT      = 2             ; console output (A=char)
000000r 2               PEM_DIRCON      = 6             ; direct console I/O (BLOCKING — use fn 11 first)
000000r 2               PEM_CONSTAT     = 11            ; console status (non-blocking)
000000r 2               PEM_OPEN        = 15
000000r 2               PEM_CLOSE       = 16
000000r 2               PEM_SEARCH      = 17
000000r 2               PEM_DELETE      = 19
000000r 2               PEM_READ        = 20
000000r 2               PEM_WRITE       = 21
000000r 2               PEM_MAKE        = 22
000000r 2               PEM_SETDMA      = 26            ; set DMA buffer address (A=lo, Y=hi)
000000r 2               
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               ; P-code opcodes
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               
000000r 2               ; --- Constants ---
000000r 2               OP_LDCI         = $00           ; push sign-extended byte constant
000000r 2               OP_LDCW         = $01           ; push word constant (lo, hi)
000000r 2               OP_LDCC         = $02           ; push char constant
000000r 2               OP_LDCB         = $03           ; push boolean constant (0/1)
000000r 2               OP_LDCS         = $04           ; push string constant (len + bytes)
000000r 2               OP_LDCN         = $05           ; push NIL
000000r 2               
000000r 2               ; --- Local variable access ---
000000r 2               OP_LDL          = $10           ; push 16-bit local (byte offset from MP+8)
000000r 2               OP_STL          = $11           ; pop into 16-bit local
000000r 2               OP_LDA_L        = $12           ; push address of local
000000r 2               OP_LDB_L        = $13           ; push byte/char/bool local
000000r 2               OP_STB_L        = $14           ; pop byte into local
000000r 2               
000000r 2               ; --- Global variable access ---
000000r 2               OP_LDG          = $18           ; push 16-bit global (word offset from BASE)
000000r 2               OP_STG          = $19           ; pop into 16-bit global
000000r 2               OP_LDA_G        = $1A           ; push address of global
000000r 2               OP_LDB_G        = $1B           ; push byte global
000000r 2               OP_STB_G        = $1C           ; pop byte into global
000000r 2               
000000r 2               ; --- Indirect / array ---
000000r 2               OP_LDIND        = $20           ; TOS=addr → push word at addr
000000r 2               OP_STIND        = $21           ; NOS=addr, TOS=val → store
000000r 2               OP_LDB_IND      = $22           ; TOS=addr → push byte at addr
000000r 2               OP_STB_IND      = $23           ; NOS=addr, TOS=val → store byte
000000r 2               OP_INDEX        = $24           ; array index: addr=NOS+TOS*elemsize (word follows)
000000r 2               
000000r 2               ; --- Integer arithmetic ---
000000r 2               OP_ADI          = $30
000000r 2               OP_SBI          = $31
000000r 2               OP_MPI          = $32
000000r 2               OP_DVI          = $33
000000r 2               OP_MOD          = $34
000000r 2               OP_NGI          = $35           ; negate
000000r 2               OP_ABI          = $36           ; absolute value
000000r 2               OP_SQI          = $37           ; square
000000r 2               
000000r 2               ; --- Logical / bitwise ---
000000r 2               OP_LAND         = $38
000000r 2               OP_LOR          = $39
000000r 2               OP_LNOT         = $3A           ; logical NOT ($0000 ↔ $FFFF)
000000r 2               OP_BNOT         = $3B           ; bitwise complement
000000r 2               
000000r 2               ; --- Comparison (push $FFFF=true, $0000=false) ---
000000r 2               OP_EQUI         = $40
000000r 2               OP_NEQI         = $41
000000r 2               OP_LESI         = $42
000000r 2               OP_LEQI         = $43
000000r 2               OP_GTRI         = $44
000000r 2               OP_GEQI         = $45
000000r 2               OP_EQUB         = $46           ; byte equality
000000r 2               OP_EQUS         = $47           ; string equality
000000r 2               
000000r 2               ; --- Control flow ---
000000r 2               OP_UJP          = $50           ; unconditional jump (signed word offset)
000000r 2               OP_FJP          = $51           ; jump if false (pop TOS)
000000r 2               OP_TJP          = $52           ; jump if true  (pop TOS)
000000r 2               OP_IXPJP        = $53           ; case jump table
000000r 2               
000000r 2               ; --- Procedure/function calls ---
000000r 2               OP_CALL         = $60           ; call (signed word offset from current IPC)
000000r 2               OP_CALI         = $61           ; call absolute address (word)
000000r 2               OP_RET          = $62           ; return from procedure
000000r 2               OP_RETF         = $63           ; return from function (leave result on stack)
000000r 2               OP_MRKSTK       = $64           ; set up activation record (byte: local size)
000000r 2               OP_DEPSTK       = $65           ; tear down activation record
000000r 2               OP_STR          = $66           ; pop word, store at MP+AR_RET_VAL (function result)
000000r 2               
000000r 2               ; --- Heap ---
000000r 2               OP_NEW          = $70           ; allocate (word size follows); push pointer
000000r 2               OP_DISP         = $71           ; free pointer on TOS
000000r 2               
000000r 2               ; --- I/O ---
000000r 2               OP_WRITI        = $80           ; write integer
000000r 2               OP_WRITC        = $81           ; write character
000000r 2               OP_WRITB        = $82           ; write boolean
000000r 2               OP_WRITS        = $83           ; write string
000000r 2               OP_WRITLN       = $84           ; write newline
000000r 2               OP_READI        = $85           ; read integer
000000r 2               OP_READC        = $86           ; read character
000000r 2               OP_READS        = $87           ; read string
000000r 2               
000000r 2               ; --- Stack manipulation ---
000000r 2               OP_DUP          = $90
000000r 2               OP_POP          = $91
000000r 2               OP_SWAP         = $92
000000r 2               OP_MOVS         = $93           ; copy n bytes (byte count follows)
000000r 2               
000000r 2               ; --- String built-ins ---
000000r 2               OP_LEN          = $A0           ; TOS=strptr -> TOS=length (int)
000000r 2               OP_POS          = $A1           ; NOS=substr, TOS=str -> TOS=1-based pos (0=not found)
000000r 2               OP_COPY         = $A2           ; NNOS=str, NOS=index, TOS=count -> TOS=result strptr
000000r 2               OP_CONCAT       = $A3           ; NOS=s1, TOS=s2 -> TOS=result strptr
000000r 2               OP_INSET        = $A4           ; NOS=elem, TOS=setmask -> TOS=membership bool
000000r 2               
000000r 2               ; --- TEXT file I/O ---
000000r 2               ; All file ops take a file-struct pointer (NOS / TOS).
000000r 2               OP_FASSGN       = $B0           ; NOS=fileptr, TOS=strptr (filename) -> set FCB
000000r 2               OP_FRESET       = $B1           ; TOS=fileptr -> open existing for reading
000000r 2               OP_FREWRT       = $B2           ; TOS=fileptr -> create/truncate for writing
000000r 2               OP_FCLOSE       = $B3           ; TOS=fileptr -> flush and close
000000r 2               OP_FWRC         = $B4           ; NOS=fileptr, TOS=char -> append char
000000r 2               OP_FWRS         = $B5           ; NOS=fileptr, TOS=strptr -> append string
000000r 2               OP_FWRI         = $B6           ; NOS=fileptr, TOS=int   -> append decimal
000000r 2               OP_FWLN         = $B7           ; TOS=fileptr -> append CR+LF
000000r 2               OP_FRDC         = $B8           ; NOS=fileptr, TOS=charvar addr -> read char
000000r 2               OP_FRDI         = $B9           ; NOS=fileptr, TOS=intvar  addr -> read decimal int
000000r 2               OP_FRDLN        = $BA           ; TOS=fileptr -> skip remaining chars to end-of-line
000000r 2               OP_FEOF         = $BB           ; TOS=fileptr -> push EOF flag (0=false, $FFFF=true)
000000r 2               OP_FAPPND       = $BC           ; TOS=fileptr -> open/create for append at EOF
000000r 2               OP_FRDS         = $BD           ; NOS=fileptr, TOS=strvar addr -> read string to EOL
000000r 2               OP_FWRB         = $BE           ; NOS=fileptr, TOS=bool -> append "TRUE"/"FALSE"
000000r 2               OP_FEOLN        = $BF           ; TOS=fileptr -> push EOLN flag (true if at CR/LF/EOF)
000000r 2               
000000r 2               ; TEXT-file struct layout (168 bytes per variable)
000000r 2               F_FCB           = 0             ; 36 bytes
000000r 2               F_BUF           = 36            ; 128 bytes
000000r 2               F_MODE          = 164           ; 0=closed, 1=read, 2=write
000000r 2               F_POS           = 165           ; 0..127 buffer position
000000r 2               F_EOF           = 166           ; 0=more data, 1=EOF reached
000000r 2               F_SPARE         = 167
000000r 2               FILE_STRUCT_SZ  = 168
000000r 2               
000000r 2               F_MODE_CLOSED   = 0
000000r 2               F_MODE_READ     = 1
000000r 2               F_MODE_WRITE    = 2
000000r 2               
000000r 2               CTRL_Z          = $1A           ; CP/M text-file end-of-data marker
000000r 2               
000000r 2               ; --- Halt ---
000000r 2               OP_HALT         = $FF
000000r 2               
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               ; .PCD file magic / version
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               PCD_MAGIC_0     = $50           ; 'P'
000000r 2               PCD_MAGIC_1     = $43           ; 'C'
000000r 2               PCD_VERSION     = $01
000000r 2               
000000r 2               ; PCD header offsets
000000r 2               PCD_MAGIC       = 0
000000r 2               PCD_VER         = 2
000000r 2               PCD_CODESZ      = 4             ; word: code section size
000000r 2               PCD_GLOBSZ      = 6             ; word: global data size
000000r 2               PCD_STRSZ       = 8             ; word: string pool size
000000r 2               PCD_ENTRY       = 10            ; word: entry point offset into code
000000r 2               PCD_HEADER_SZ   = 12
000000r 2               
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               ; Token codes (used by compiler lexer/parser)
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               TOK_EOF         = 0
000000r 2               TOK_IDENT       = 1
000000r 2               TOK_INT         = 2
000000r 2               TOK_STRING      = 3
000000r 2               TOK_CHAR        = 4
000000r 2               
000000r 2               ; Operators / punctuation
000000r 2               TOK_PLUS        = $10           ; +
000000r 2               TOK_MINUS       = $11           ; -
000000r 2               TOK_STAR        = $12           ; *
000000r 2               TOK_SLASH       = $13           ; /
000000r 2               TOK_EQ          = $14           ; =
000000r 2               TOK_NEQ         = $15           ; <>
000000r 2               TOK_LT          = $16           ; <
000000r 2               TOK_GT          = $17           ; >
000000r 2               TOK_LEQ         = $18           ; <=
000000r 2               TOK_GEQ         = $19           ; >=
000000r 2               TOK_ASSIGN      = $1A           ; :=
000000r 2               TOK_LPAREN      = $1B           ; (
000000r 2               TOK_RPAREN      = $1C           ; )
000000r 2               TOK_LBRACK      = $1D           ; [
000000r 2               TOK_RBRACK      = $1E           ; ]
000000r 2               TOK_COMMA       = $1F           ; ,
000000r 2               TOK_SEMICOLON   = $20           ; ;
000000r 2               TOK_COLON       = $21           ; :
000000r 2               TOK_DOT         = $22           ; .
000000r 2               TOK_DOTDOT      = $23           ; ..
000000r 2               TOK_CARET       = $24           ; ^
000000r 2               
000000r 2               ; Keywords
000000r 2               TOK_AND         = $40
000000r 2               TOK_ARRAY       = $41
000000r 2               TOK_BEGIN       = $42
000000r 2               TOK_CASE        = $43
000000r 2               TOK_CONST       = $44
000000r 2               TOK_DIV         = $45
000000r 2               TOK_DO          = $46
000000r 2               TOK_DOWNTO      = $47
000000r 2               TOK_ELSE        = $48
000000r 2               TOK_END         = $49
000000r 2               TOK_FOR         = $4A
000000r 2               TOK_FUNCTION    = $4B
000000r 2               TOK_IF          = $4C
000000r 2               TOK_IN          = $4D
000000r 2               TOK_MOD_KW      = $4E
000000r 2               TOK_NIL         = $4F
000000r 2               TOK_NOT         = $50
000000r 2               TOK_OF          = $51
000000r 2               TOK_OR          = $52
000000r 2               TOK_PROCEDURE   = $53
000000r 2               TOK_PROGRAM     = $54
000000r 2               TOK_RECORD      = $55
000000r 2               TOK_REPEAT      = $56
000000r 2               TOK_SET         = $57
000000r 2               TOK_THEN        = $58
000000r 2               TOK_TO          = $59
000000r 2               TOK_TYPE        = $5A
000000r 2               TOK_UNTIL       = $5B
000000r 2               TOK_VAR         = $5C
000000r 2               TOK_WHILE       = $5D
000000r 2               TOK_WITH        = $5E
000000r 2               TOK_IMPLEMENTATION = $5F
000000r 2               TOK_INTERFACE   = $60
000000r 2               TOK_UNIT        = $61
000000r 2               TOK_USES        = $62
000000r 2               
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               ; Useful macros
000000r 2               ; ---------------------------------------------------------------------------
000000r 2               
000000r 2               ; Call PEM with function number in X
000000r 2               .macro PEM func
000000r 2                       ldx     #func
000000r 2                       jsr     PEM_ENTRY
000000r 2               .endmacro
000000r 2               
000000r 1                       .include        "ZEROPAGE.ASM"
000000r 2               ; zeropage.asm — zero-page variable layout for PASCAL.COM and PRUN.COM
000000r 2               ;
000000r 2               ; Avoid $00-$2F (DOS/65 system), $32 (FARFUNCT), $39-$3A (DOS/65).
000000r 2               ; Safe range: $50-$EF
000000r 2               
000000r 2                       .segment        "ZEROPAGE"
000000r 2               
000000r 2  xx xx xx xx          .RES    $50             ; skip $00-$4F (DOS/65 system zero page)
000004r 2  xx xx xx xx  
000008r 2  xx xx xx xx  
000050r 2               
000050r 2               ; ---------------------------------------------------------------------------
000050r 2               ; P-machine registers — start at $50 as noted in comments below
000050r 2               ; ---------------------------------------------------------------------------
000050r 2               
000050r 2               pm_ipc:
000050r 2  xx xx                .RES    2               ; $50-$51  interpreter program counter
000052r 2               pm_sp:
000052r 2  xx xx                .RES    2               ; $52-$53  p-machine stack pointer
000054r 2               pm_mp:
000054r 2  xx xx                .RES    2               ; $54-$55  mark/frame pointer
000056r 2               pm_base:
000056r 2  xx xx                .RES    2               ; $56-$57  global variable base
000058r 2               pm_np:
000058r 2  xx xx                .RES    2               ; $58-$59  heap top (grows downward)
00005Ar 2               
00005Ar 2               ; General-purpose temporaries
00005Ar 2               tmp0:
00005Ar 2  xx xx                .RES    2               ; $5A-$5B
00005Cr 2               tmp1:
00005Cr 2  xx xx                .RES    2               ; $5C-$5D
00005Er 2               tmp2:
00005Er 2  xx xx                .RES    2               ; $5E-$5F
000060r 2               tmp3:
000060r 2  xx xx                .RES    2               ; $60-$61
000062r 2               
000062r 2               ; Byte-width scratch (often used by macros)
000062r 2               scratch:
000062r 2  xx                   .RES    1               ; $62
000063r 2               
000063r 2               ; ---------------------------------------------------------------------------
000063r 2               ; Compiler-specific zero-page variables (only used by PASCAL.COM)
000063r 2               ; ---------------------------------------------------------------------------
000063r 2               
000063r 2               ; Lexer state
000063r 2               lex_line:
000063r 2  xx xx                .RES    2               ; $63-$64  current source line number
000065r 2               lex_col:
000065r 2  xx                   .RES    1               ; $65      current column
000066r 2               lex_char:
000066r 2  xx                   .RES    1               ; $66      lookahead character
000067r 2               tok_type:
000067r 2  xx                   .RES    1               ; $67      current token type
000068r 2               tok_ival_lo:
000068r 2  xx                   .RES    1               ; $68      integer token value (lo)
000069r 2               tok_ival_hi:
000069r 2  xx                   .RES    1               ; $69      integer token value (hi)
00006Ar 2               
00006Ar 2               ; Parser / code generator state
00006Ar 2               cg_pc:
00006Ar 2  xx xx                .RES    2               ; $6A-$6B  current emit offset into code buffer
00006Cr 2               cg_globals:
00006Cr 2  xx xx                .RES    2               ; $6C-$6D  next available global variable offset
00006Er 2               scope_depth:
00006Er 2  xx                   .RES    1               ; $6E      current lexical nesting depth (0=global)
00006Fr 2               sym_chain:
00006Fr 2  xx xx                .RES    2               ; $6F-$70  pointer into symbol table chain
000071r 2               
000071r 2               ; FCB pointers (compiler I/O)
000071r 2               src_fcb:
000071r 2  xx xx                .RES    2               ; $71-$72  pointer to source FCB
000073r 2               out_fcb:
000073r 2  xx xx                .RES    2               ; $73-$74  pointer to output FCB
000075r 2               src_buf_pos:
000075r 2  xx                   .RES    1               ; $75      position within 128-byte sector buffer
000076r 2               src_buf_end:
000076r 2  xx                   .RES    1               ; $76      bytes valid in sector buffer
000077r 2               
000077r 2               ; FOR-loop scratch (parse_for; not nestable)
000077r 2               for_loop_top:
000077r 2  xx xx                .RES    2               ; $77-$78  cg_pc of loop test (back-jump target)
000079r 2               for_patch:
000079r 2  xx xx                .RES    2               ; $79-$7A  FJP exit patch address
00007Br 2               
00007Br 2               ; Result type of the most recently parsed expression (TY_INT/TY_CHAR/
00007Br 2               ; TY_BOOL/TY_STRING/etc.).  Used by parse_write_args to dispatch the
00007Br 2               ; right WRIT* opcode.  Set by parse_factor / parse_simple_expr /
00007Br 2               ; parse_expression as each rule produces its result.
00007Br 2               expr_type:
00007Br 2  xx                   .RES    1               ; $7B
00007Cr 2               
00007Cr 1               
00007Cr 1               ; ---------------------------------------------------------------------------
00007Cr 1               ; FCBs and file buffers
00007Cr 1               ; ---------------------------------------------------------------------------
00007Cr 1                       .segment        "CPMDATA"
000000r 1               
000000r 1               comp_src_fcb:
000000r 1  xx xx xx xx          .RES    36              ; source file FCB (.PAS)
000004r 1  xx xx xx xx  
000008r 1  xx xx xx xx  
000024r 1               comp_out_fcb:
000024r 1  xx xx xx xx          .RES    36              ; output file FCB (.PCD)
000028r 1  xx xx xx xx  
00002Cr 1  xx xx xx xx  
000048r 1               
000048r 1               ; 128-byte sector buffer for source reads
000048r 1               src_sector:
000048r 1  xx xx xx xx          .RES    128
00004Cr 1  xx xx xx xx  
000050r 1  xx xx xx xx  
0000C8r 1               
0000C8r 1               ; Comma-list buffer for parse_var_decls — collects names "A, B, C" before
0000C8r 1               ; the type is known so each can be added to the symbol table with the
0000C8r 1               ; same type code.  8 slots × 16 bytes; excess names are silently dropped.
0000C8r 1               var_name_count:
0000C8r 1  xx                   .RES    1
0000C9r 1               var_name_buf:
0000C9r 1  xx xx xx xx          .RES    128
0000CDr 1  xx xx xx xx  
0000D1r 1  xx xx xx xx  
000149r 1               
000149r 1               ; Field table for RECORD types.  32 entries × 16 bytes each:
000149r 1               ;   [0]    field name length (1-12)
000149r 1               ;   [1-12] field name chars (uppercase, padded with spaces)
000149r 1               ;   [13]   byte offset within the record
000149r 1               ;   [14]   field data type (TY_INT/TY_CHAR/TY_BOOL)
000149r 1               ;   [15]   reserved
000149r 1               field_table_count:
000149r 1  xx                   .RES    1
00014Ar 1               field_table:
00014Ar 1  xx xx xx xx          .RES    512             ; 32 entries × 16 bytes
00014Er 1  xx xx xx xx  
000152r 1  xx xx xx xx  
00034Ar 1               
00034Ar 1               ; Per-field "nested" metadata, parallel to field_table.  Only meaningful
00034Ar 1               ; when the field's type is TY_RECORD: holds the nested record's
00034Ar 1               ; first_field index and field count so chained access (`a.outer.inner`)
00034Ar 1               ; can traverse into the inner record.  Anonymous and named nested
00034Ar 1               ; records are both supported here.
00034Ar 1               field_nested_first:
00034Ar 1  xx xx xx xx          .RES    32
00034Er 1  xx xx xx xx  
000352r 1  xx xx xx xx  
00036Ar 1               field_nested_count:
00036Ar 1  xx xx xx xx          .RES    32
00036Er 1  xx xx xx xx  
000372r 1  xx xx xx xx  
00038Ar 1               
00038Ar 1               ; Separate buffer for collecting field names inside a RECORD declaration.
00038Ar 1               ; Distinct from var_name_buf so inline `VAR x: RECORD ... END` doesn't
00038Ar 1               ; lose the outer "x" while the field group is being parsed. Each active
00038Ar 1               ; RECORD nesting depth gets its own slice so an inner anonymous RECORD
00038Ar 1               ; doesn't overwrite the outer field names that still need to be added.
00038Ar 1               FIELD_NAME_DEPTHS = 8
00038Ar 1               field_name_count:
00038Ar 1  xx xx xx xx          .RES    FIELD_NAME_DEPTHS
00038Er 1  xx xx xx xx  
000392r 1               field_name_buf:
000392r 1  xx xx xx xx          .RES    128 * FIELD_NAME_DEPTHS
000396r 1  xx xx xx xx  
00039Ar 1  xx xx xx xx  
000792r 1               
000792r 1               ; Scratch slots used by @rec_addf to remember the most recently-parsed
000792r 1               ; field's nested-record metadata.  Populated by the wrapper around the
000792r 1               ; recursive parse_type_spec call when the field type is TY_RECORD.
000792r 1               nest_save_first:
000792r 1  xx                   .RES    1
000793r 1               nest_save_count:
000793r 1  xx                   .RES    1
000794r 1               nest_save_size:
000794r 1  xx xx                .RES    2
000796r 1               
000796r 1               ; Nesting depth tracked by parse_type_spec @rec_loop. 0 = outside any
000796r 1               ; RECORD; bumped on entry, decremented on exit. Stored into byte 15 of
000796r 1               ; each field_table entry by field_table_add so field_lookup_in_record
000796r 1               ; can skip slots that belong to a deeper inline record. Without this
000796r 1               ; an outer record whose later fields follow an inline RECORD would
000796r 1               ; have an interleaved layout that count-based scan can't navigate.
000796r 1               field_depth:
000796r 1  xx                   .RES    1
000797r 1               field_lookup_depth:
000797r 1  xx                   .RES    1
000798r 1               
000798r 1               ; Active WITH contexts. Each entry stores a hidden global word that holds
000798r 1               ; the selected record's runtime base address, plus that record's first-field
000798r 1               ; index/count so unqualified identifiers can resolve as fields.
000798r 1               WITH_DEPTHS = 8
000798r 1               with_depth:
000798r 1  xx                   .RES    1
000799r 1               with_base_lo:
000799r 1  xx xx xx xx          .RES    WITH_DEPTHS
00079Dr 1  xx xx xx xx  
0007A1r 1               with_base_hi:
0007A1r 1  xx xx xx xx          .RES    WITH_DEPTHS
0007A5r 1  xx xx xx xx  
0007A9r 1               with_first_field:
0007A9r 1  xx xx xx xx          .RES    WITH_DEPTHS
0007ADr 1  xx xx xx xx  
0007B1r 1               with_field_count:
0007B1r 1  xx xx xx xx          .RES    WITH_DEPTHS
0007B5r 1  xx xx xx xx  
0007B9r 1               
0007B9r 1               ; Record-valued expressions leave an address on the stack and publish the
0007B9r 1               ; matching field-table span here so WITH selectors can reuse it.
0007B9r 1               expr_record_first:
0007B9r 1  xx                   .RES    1
0007BAr 1               expr_record_count:
0007BAr 1  xx                   .RES    1
0007BBr 1               
0007BBr 1               ; Scratch filled by with_lookup_field before parse_with_field_{load,assign}.
0007BBr 1               with_lookup_off:
0007BBr 1  xx                   .RES    1
0007BCr 1               with_lookup_type:
0007BCr 1  xx                   .RES    1
0007BDr 1               with_lookup_base_lo:
0007BDr 1  xx                   .RES    1
0007BEr 1               with_lookup_base_hi:
0007BEr 1  xx                   .RES    1
0007BFr 1               with_lookup_first:
0007BFr 1  xx                   .RES    1
0007C0r 1               with_lookup_count:
0007C0r 1  xx                   .RES    1
0007C1r 1               
0007C1r 1               ; Top-level source mode: 0=plain program, 1=UNIT interface, 2=UNIT
0007C1r 1               ; implementation. Used so interface routine headings can be rebound to
0007C1r 1               ; their later implementation bodies without creating duplicate globals.
0007C1r 1               unit_section:
0007C1r 1  xx                   .RES    1
0007C2r 1               unit_import_mode:
0007C2r 1  xx                   .RES    1               ; 0=standalone source, nonzero=USES-import nesting depth
0007C3r 1               
0007C3r 1               ; Names collected from a single top-level USES clause. Separate from
0007C3r 1               ; var_name_buf because imported unit compilation reuses var_name_buf.
0007C3r 1               USES_NAME_SLOTS = 8
0007C3r 1               uses_name_count:
0007C3r 1  xx                   .RES    1
0007C4r 1               uses_name_buf:
0007C4r 1  xx xx xx xx          .RES    16 * USES_NAME_SLOTS
0007C8r 1  xx xx xx xx  
0007CCr 1  xx xx xx xx  
000844r 1               
000844r 1               ; Imported-unit de-duplication table. Names are stored in uppercase
000844r 1               ; ident_buf layout (length byte + 15 chars) so nested/repeated USES
000844r 1               ; clauses compile a unit at most once.
000844r 1               USED_UNIT_SLOTS = 8
000844r 1               used_unit_count:
000844r 1  xx                   .RES    1
000845r 1               used_unit_buf:
000845r 1  xx xx xx xx          .RES    16 * USED_UNIT_SLOTS
000849r 1  xx xx xx xx  
00084Dr 1  xx xx xx xx  
0008C5r 1               
0008C5r 1               ; Source-context stack for nested USES imports. Each entry saves the
0008C5r 1               ; current source FCB, buffered DMA sector, and lexer position so the
0008C5r 1               ; compiler can suspend one file, compile another, then resume cleanly.
0008C5r 1               SRC_CTX_DEPTHS = 4
0008C5r 1               src_ctx_depth:
0008C5r 1  xx                   .RES    1
0008C6r 1               src_ctx_buf_pos:
0008C6r 1  xx xx xx xx          .RES    SRC_CTX_DEPTHS
0008CAr 1               src_ctx_buf_end:
0008CAr 1  xx xx xx xx          .RES    SRC_CTX_DEPTHS
0008CEr 1               src_ctx_line_lo:
0008CEr 1  xx xx xx xx          .RES    SRC_CTX_DEPTHS
0008D2r 1               src_ctx_line_hi:
0008D2r 1  xx xx xx xx          .RES    SRC_CTX_DEPTHS
0008D6r 1               src_ctx_col:
0008D6r 1  xx xx xx xx          .RES    SRC_CTX_DEPTHS
0008DAr 1               src_ctx_char:
0008DAr 1  xx xx xx xx          .RES    SRC_CTX_DEPTHS
0008DEr 1               src_ctx_fcb:
0008DEr 1  xx xx xx xx          .RES    36 * SRC_CTX_DEPTHS
0008E2r 1  xx xx xx xx  
0008E6r 1  xx xx xx xx  
00096Er 1               src_ctx_dma:
00096Er 1  xx xx xx xx          .RES    128 * SRC_CTX_DEPTHS
000972r 1  xx xx xx xx  
000976r 1  xx xx xx xx  
000B6Er 1               
000B6Er 1               ; Code generation buffer — p-code accumulates here until file write.
000B6Er 1               ; Keep this above the live CPMDATA working set used by the parser.
000B6Er 1               ; This holds up to ~32KB of generated p-code.
000B6Er 1               CODEBUF_BASE    = $4500
000B6Er 1               CODEBUF_MAXSZ   = $8000         ; 32 KB
000B6Er 1               
000B6Er 1               ; Symbol table area
000B6Er 1               SYMTAB_BASE     = $8000
000B6Er 1               SYMTAB_MAXSZ    = $1800         ; 6 KB (≈200 entries at ~30 bytes each)
000B6Er 1               
000B6Er 1               ; String pool for identifier strings and string literals
000B6Er 1               STRPOOL_BASE    = $9800
000B6Er 1               STRPOOL_MAXSZ   = $0800         ; 2 KB
000B6Er 1               
000B6Er 1               ; ---------------------------------------------------------------------------
000B6Er 1               ; Entry point
000B6Er 1               ; ---------------------------------------------------------------------------
000B6Er 1                       .segment        "TEA"
000000r 1               
000000r 1  4C rr rr             JMP     pascal_main
000003r 1               
000003r 1                       .segment        "CODE"
000000r 1               
000000r 1               pascal_main:
000000r 1               ; print banner
000000r 1  A9 rr                LDA     #<msg_banner
000002r 1  85 rr                STA     tmp0
000004r 1  A9 rr                LDA     #>msg_banner
000006r 1  85 rr                STA     tmp0+1
000008r 1  20 rr rr             JSR     console_print_sz
00000Br 1               
00000Br 1               ; build source FCB from DEFAULT_FCB ($0107) argument
00000Br 1  20 rr rr             JSR     build_src_fcb
00000Er 1  90 03                BCC     :+
000010r 1  4C rr rr             JMP     @no_file
000013r 1               :
000013r 1               ; print "Compiling: <name>"
000013r 1  A9 rr                LDA     #<msg_compiling
000015r 1  85 rr                STA     tmp0
000017r 1  A9 rr                LDA     #>msg_compiling
000019r 1  85 rr                STA     tmp0+1
00001Br 1  20 rr rr             JSR     console_print_sz
00001Er 1               
00001Er 1               ; open source file
00001Er 1  A9 rr                LDA     #<comp_src_fcb
000020r 1  85 rr                STA     src_fcb
000022r 1  A9 rr                LDA     #>comp_src_fcb
000024r 1  85 rr                STA     src_fcb+1
000026r 1  A9 rr                LDA     #<comp_src_fcb
000028r 1  85 rr                STA     tmp1
00002Ar 1  A9 rr                LDA     #>comp_src_fcb
00002Cr 1  85 rr                STA     tmp1+1
00002Er 1  20 rr rr             JSR     file_open
000031r 1  C9 FF                CMP     #$FF            ; PEM open: $FF=not found, 0-3=dir entry
000033r 1  D0 03                BNE     :+
000035r 1  4C rr rr             JMP     @no_file
000038r 1               :
000038r 1               
000038r 1               ; create output .PCD file
000038r 1  20 rr rr             JSR     build_out_fcb
00003Br 1  A9 rr                LDA     #<comp_out_fcb
00003Dr 1  85 rr                STA     tmp1
00003Fr 1  A9 rr                LDA     #>comp_out_fcb
000041r 1  85 rr                STA     tmp1+1
000043r 1  20 rr rr             JSR     file_make
000046r 1  C9 FF                CMP     #$FF            ; PEM make: $FF=dir full, 0-3=dir entry
000048r 1  D0 03                BNE     :+
00004Ar 1  4C rr rr             JMP     @out_err
00004Dr 1               :
00004Dr 1               
00004Dr 1               ; initialise compiler state
00004Dr 1  20 rr rr             JSR     compiler_init
000050r 1               
000050r 1               ; run compilation
000050r 1  20 rr rr             JSR     compile_program
000053r 1               
000053r 1               ; write .PCD file
000053r 1  20 rr rr             JSR     write_pcd
000056r 1               
000056r 1               ; close files
000056r 1  A9 rr                LDA     #<comp_src_fcb
000058r 1  85 rr                STA     tmp1
00005Ar 1  A9 rr                LDA     #>comp_src_fcb
00005Cr 1  85 rr                STA     tmp1+1
00005Er 1  20 rr rr             JSR     file_close
000061r 1  A9 rr                LDA     #<comp_out_fcb
000063r 1  85 rr                STA     tmp1
000065r 1  A9 rr                LDA     #>comp_out_fcb
000067r 1  85 rr                STA     tmp1+1
000069r 1  20 rr rr             JSR     file_close
00006Cr 1               
00006Cr 1               ; print result
00006Cr 1  AD rr rr             LDA     error_count
00006Fr 1  0D rr rr             ORA     error_count+1
000072r 1  D0 0E                BNE     @had_errors
000074r 1  A9 rr                LDA     #<msg_ok
000076r 1  85 rr                STA     tmp0
000078r 1  A9 rr                LDA     #>msg_ok
00007Ar 1  85 rr                STA     tmp0+1
00007Cr 1  20 rr rr             JSR     console_print_sz
00007Fr 1  4C 00 01             JMP     WARM_BOOT
000082r 1               
000082r 1               @had_errors:
000082r 1  AD rr rr             LDA     error_count
000085r 1  85 rr                STA     tmp0
000087r 1  AD rr rr             LDA     error_count+1
00008Ar 1  85 rr                STA     tmp0+1
00008Cr 1  20 rr rr             JSR     console_print_dec
00008Fr 1  A9 rr                LDA     #<msg_errors
000091r 1  85 rr                STA     tmp0
000093r 1  A9 rr                LDA     #>msg_errors
000095r 1  85 rr                STA     tmp0+1
000097r 1  20 rr rr             JSR     console_print_sz
00009Ar 1  4C 00 01             JMP     WARM_BOOT
00009Dr 1               
00009Dr 1               @no_file:
00009Dr 1  A9 rr                LDA     #<err_nofile
00009Fr 1  85 rr                STA     tmp0
0000A1r 1  A9 rr                LDA     #>err_nofile
0000A3r 1  85 rr                STA     tmp0+1
0000A5r 1  20 rr rr             JSR     console_print_sz
0000A8r 1  4C 00 01             JMP     WARM_BOOT
0000ABr 1               
0000ABr 1               @out_err:
0000ABr 1  A9 rr                LDA     #<err_outfile
0000ADr 1  85 rr                STA     tmp0
0000AFr 1  A9 rr                LDA     #>err_outfile
0000B1r 1  85 rr                STA     tmp0+1
0000B3r 1  20 rr rr             JSR     console_print_sz
0000B6r 1  4C 00 01             JMP     WARM_BOOT
0000B9r 1               
0000B9r 1               ; ---------------------------------------------------------------------------
0000B9r 1               ; build_src_fcb — populate comp_src_fcb from DEFAULT_FCB ($0107), force ".PAS"
0000B9r 1               ; DOS/65 CCM copies the parsed argument FCB to dflfcb=$0107, not $005C.
0000B9r 1               ; Returns: carry clear = ok, carry set = no filename
0000B9r 1               ; ---------------------------------------------------------------------------
0000B9r 1               build_src_fcb:
0000B9r 1  A2 00                LDX     #0
0000BBr 1               @copy:
0000BBr 1  BD 07 01             LDA     DEFAULT_FCB,x
0000BEr 1  9D rr rr             STA     comp_src_fcb,x
0000C1r 1  E8                   INX
0000C2r 1  E0 0C                CPX     #12
0000C4r 1  90 F5                BCC     @copy
0000C6r 1  A9 00                LDA     #0
0000C8r 1               @zero:
0000C8r 1  9D rr rr             STA     comp_src_fcb,x
0000CBr 1  E8                   INX
0000CCr 1  E0 24                CPX     #36
0000CEr 1  90 F8                BCC     @zero
0000D0r 1  AD rr rr             LDA     comp_src_fcb+1
0000D3r 1  C9 20                CMP     #' '
0000D5r 1  F0 11                BEQ     @noname
0000D7r 1  A9 50                LDA     #'P'
0000D9r 1  8D rr rr             STA     comp_src_fcb+9
0000DCr 1  A9 41                LDA     #'A'
0000DEr 1  8D rr rr             STA     comp_src_fcb+10
0000E1r 1  A9 53                LDA     #'S'
0000E3r 1  8D rr rr             STA     comp_src_fcb+11
0000E6r 1  18                   CLC
0000E7r 1  60                   RTS
0000E8r 1               @noname:
0000E8r 1  38                   SEC
0000E9r 1  60                   RTS
0000EAr 1               
0000EAr 1               ; ---------------------------------------------------------------------------
0000EAr 1               ; build_out_fcb — copy filename from comp_src_fcb, change extension to "PCD"
0000EAr 1               ; ---------------------------------------------------------------------------
0000EAr 1               build_out_fcb:
0000EAr 1  A2 00                LDX     #0
0000ECr 1               @copy:
0000ECr 1  BD rr rr             LDA     comp_src_fcb,x
0000EFr 1  9D rr rr             STA     comp_out_fcb,x
0000F2r 1  E8                   INX
0000F3r 1  E0 24                CPX     #36
0000F5r 1  90 F5                BCC     @copy
0000F7r 1  A9 50                LDA     #'P'
0000F9r 1  8D rr rr             STA     comp_out_fcb+9
0000FCr 1  A9 43                LDA     #'C'
0000FEr 1  8D rr rr             STA     comp_out_fcb+10
000101r 1  A9 44                LDA     #'D'
000103r 1  8D rr rr             STA     comp_out_fcb+11
000106r 1  60                   RTS
000107r 1               
000107r 1               ; ---------------------------------------------------------------------------
000107r 1               ; build_named_src_fcb — populate comp_src_fcb from ident_buf, force ".PAS"
000107r 1               ; The identifier is uppercased already by the lexer. Names longer than 8
000107r 1               ; chars are truncated to fit the FCB filename field.
000107r 1               ; Returns: carry clear = ok, carry set = empty name
000107r 1               ; ---------------------------------------------------------------------------
000107r 1               build_named_src_fcb:
000107r 1  AD rr rr             LDA     ident_buf
00010Ar 1  D0 02                BNE     :+
00010Cr 1  38                   SEC
00010Dr 1  60                   RTS
00010Er 1  A2 00        :       LDX     #0
000110r 1  A9 00                LDA     #0
000112r 1               @zero:
000112r 1  9D rr rr             STA     comp_src_fcb,x
000115r 1  E8                   INX
000116r 1  E0 24                CPX     #36
000118r 1  90 F8                BCC     @zero
00011Ar 1  A2 01                LDX     #1
00011Cr 1  A9 20                LDA     #' '
00011Er 1               @pad_name:
00011Er 1  9D rr rr             STA     comp_src_fcb,x
000121r 1  E8                   INX
000122r 1  E0 0C                CPX     #12
000124r 1  90 F8                BCC     @pad_name
000126r 1  A2 00                LDX     #0
000128r 1               @copy_name:
000128r 1  EC rr rr             CPX     ident_buf
00012Br 1  B0 0D                BCS     @set_ext
00012Dr 1  E0 08                CPX     #8
00012Fr 1  B0 09                BCS     @set_ext
000131r 1  BD rr rr             LDA     ident_buf+1,x
000134r 1  9D rr rr             STA     comp_src_fcb+1,x
000137r 1  E8                   INX
000138r 1  80 EE                BRA     @copy_name
00013Ar 1               @set_ext:
00013Ar 1  A9 50                LDA     #'P'
00013Cr 1  8D rr rr             STA     comp_src_fcb+9
00013Fr 1  A9 41                LDA     #'A'
000141r 1  8D rr rr             STA     comp_src_fcb+10
000144r 1  A9 53                LDA     #'S'
000146r 1  8D rr rr             STA     comp_src_fcb+11
000149r 1  18                   CLC
00014Ar 1  60                   RTS
00014Br 1               
00014Br 1               ; source_ctx_fcb_ptr — A=stack index, returns tmp0 -> saved FCB slot
00014Br 1               source_ctx_fcb_ptr:
00014Br 1  85 rr                STA     scratch
00014Dr 1  A9 rr                LDA     #<src_ctx_fcb
00014Fr 1  85 rr                STA     tmp0
000151r 1  A9 rr                LDA     #>src_ctx_fcb
000153r 1  85 rr                STA     tmp0+1
000155r 1               @scfp_loop:
000155r 1  A5 rr                LDA     scratch
000157r 1  F0 0F                BEQ     @scfp_done
000159r 1  18                   CLC
00015Ar 1  A5 rr                LDA     tmp0
00015Cr 1  69 24                ADC     #36
00015Er 1  85 rr                STA     tmp0
000160r 1  90 02                BCC     :+
000162r 1  E6 rr                INC     tmp0+1
000164r 1  C6 rr        :       DEC     scratch
000166r 1  80 ED                BRA     @scfp_loop
000168r 1               @scfp_done:
000168r 1  60                   RTS
000169r 1               
000169r 1               ; source_ctx_dma_ptr — A=stack index, returns tmp0 -> saved DMA slot
000169r 1               source_ctx_dma_ptr:
000169r 1  85 rr                STA     scratch
00016Br 1  A9 rr                LDA     #<src_ctx_dma
00016Dr 1  85 rr                STA     tmp0
00016Fr 1  A9 rr                LDA     #>src_ctx_dma
000171r 1  85 rr                STA     tmp0+1
000173r 1               @scdp_loop:
000173r 1  A5 rr                LDA     scratch
000175r 1  F0 0F                BEQ     @scdp_done
000177r 1  18                   CLC
000178r 1  A5 rr                LDA     tmp0
00017Ar 1  69 80                ADC     #$80
00017Cr 1  85 rr                STA     tmp0
00017Er 1  90 02                BCC     :+
000180r 1  E6 rr                INC     tmp0+1
000182r 1  C6 rr        :       DEC     scratch
000184r 1  80 ED                BRA     @scdp_loop
000186r 1               @scdp_done:
000186r 1  60                   RTS
000187r 1               
000187r 1               ; ---------------------------------------------------------------------------
000187r 1               ; source_push_current / source_pop_current — save and restore the active
000187r 1               ; source-file context around USES-imported unit compilation.
000187r 1               ; source_push_current returns carry set if the context stack is full.
000187r 1               ; ---------------------------------------------------------------------------
000187r 1               source_push_current:
000187r 1  AE rr rr             LDX     src_ctx_depth
00018Ar 1  E0 04                CPX     #SRC_CTX_DEPTHS
00018Cr 1  90 02                BCC     @spc_room
00018Er 1  38                   SEC
00018Fr 1  60                   RTS
000190r 1               @spc_room:
000190r 1  A5 rr                LDA     src_buf_pos
000192r 1  9D rr rr             STA     src_ctx_buf_pos,x
000195r 1  A5 rr                LDA     src_buf_end
000197r 1  9D rr rr             STA     src_ctx_buf_end,x
00019Ar 1  A5 rr                LDA     lex_line
00019Cr 1  9D rr rr             STA     src_ctx_line_lo,x
00019Fr 1  A5 rr                LDA     lex_line+1
0001A1r 1  9D rr rr             STA     src_ctx_line_hi,x
0001A4r 1  A5 rr                LDA     lex_col
0001A6r 1  9D rr rr             STA     src_ctx_col,x
0001A9r 1  A5 rr                LDA     lex_char
0001ABr 1  9D rr rr             STA     src_ctx_char,x
0001AEr 1  8A                   TXA
0001AFr 1  20 rr rr             JSR     source_ctx_fcb_ptr
0001B2r 1  A0 00                LDY     #0
0001B4r 1               @spc_fcb_copy:
0001B4r 1  B9 rr rr             LDA     comp_src_fcb,y
0001B7r 1  91 rr                STA     (tmp0),y
0001B9r 1  C8                   INY
0001BAr 1  C0 24                CPY     #36
0001BCr 1  90 F6                BCC     @spc_fcb_copy
0001BEr 1  8A                   TXA
0001BFr 1  20 rr rr             JSR     source_ctx_dma_ptr
0001C2r 1  A0 00                LDY     #0
0001C4r 1               @spc_dma_copy:
0001C4r 1  B9 28 01             LDA     DMA_BUF,y
0001C7r 1  91 rr                STA     (tmp0),y
0001C9r 1  C8                   INY
0001CAr 1  C0 80                CPY     #128
0001CCr 1  90 F6                BCC     @spc_dma_copy
0001CEr 1  EE rr rr             INC     src_ctx_depth
0001D1r 1  18                   CLC
0001D2r 1  60                   RTS
0001D3r 1               
0001D3r 1               source_pop_current:
0001D3r 1  AD rr rr             LDA     src_ctx_depth
0001D6r 1  F0 4C                BEQ     @spop_done
0001D8r 1  CE rr rr             DEC     src_ctx_depth
0001DBr 1  AE rr rr             LDX     src_ctx_depth
0001DEr 1  BD rr rr             LDA     src_ctx_buf_pos,x
0001E1r 1  85 rr                STA     src_buf_pos
0001E3r 1  BD rr rr             LDA     src_ctx_buf_end,x
0001E6r 1  85 rr                STA     src_buf_end
0001E8r 1  BD rr rr             LDA     src_ctx_line_lo,x
0001EBr 1  85 rr                STA     lex_line
0001EDr 1  BD rr rr             LDA     src_ctx_line_hi,x
0001F0r 1  85 rr                STA     lex_line+1
0001F2r 1  BD rr rr             LDA     src_ctx_col,x
0001F5r 1  85 rr                STA     lex_col
0001F7r 1  BD rr rr             LDA     src_ctx_char,x
0001FAr 1  85 rr                STA     lex_char
0001FCr 1  8A                   TXA
0001FDr 1  20 rr rr             JSR     source_ctx_fcb_ptr
000200r 1  A0 00                LDY     #0
000202r 1               @spop_fcb_copy:
000202r 1  B1 rr                LDA     (tmp0),y
000204r 1  99 rr rr             STA     comp_src_fcb,y
000207r 1  C8                   INY
000208r 1  C0 24                CPY     #36
00020Ar 1  90 F6                BCC     @spop_fcb_copy
00020Cr 1  8A                   TXA
00020Dr 1  20 rr rr             JSR     source_ctx_dma_ptr
000210r 1  A0 00                LDY     #0
000212r 1               @spop_dma_copy:
000212r 1  B1 rr                LDA     (tmp0),y
000214r 1  99 28 01             STA     DMA_BUF,y
000217r 1  C8                   INY
000218r 1  C0 80                CPY     #128
00021Ar 1  90 F6                BCC     @spop_dma_copy
00021Cr 1  A9 rr                LDA     #<comp_src_fcb
00021Er 1  85 rr                STA     src_fcb
000220r 1  A9 rr                LDA     #>comp_src_fcb
000222r 1  85 rr                STA     src_fcb+1
000224r 1               @spop_done:
000224r 1  60                   RTS
000225r 1               
000225r 1               ; ---------------------------------------------------------------------------
000225r 1               ; compiler_init — zero-out compiler state
000225r 1               ; ---------------------------------------------------------------------------
000225r 1               error_count:
000225r 1  00 00                .WORD   0
000227r 1               
000227r 1               compiler_init:
000227r 1  A9 00                LDA     #0
000229r 1  8D rr rr             STA     error_count
00022Cr 1  8D rr rr             STA     error_count+1
00022Fr 1               ; IPC starts at 0 (offset into code buffer)
00022Fr 1  85 rr                STA     cg_pc
000231r 1  85 rr                STA     cg_pc+1
000233r 1               ; globals start at 0
000233r 1  85 rr                STA     cg_globals
000235r 1  85 rr                STA     cg_globals+1
000237r 1               ; scope depth 0 = global
000237r 1  85 rr                STA     scope_depth
000239r 1  8D rr rr             STA     with_depth
00023Cr 1  8D rr rr             STA     expr_record_first
00023Fr 1  8D rr rr             STA     expr_record_count
000242r 1  8D rr rr             STA     unit_section
000245r 1  8D rr rr             STA     unit_import_mode
000248r 1  8D rr rr             STA     uses_name_count
00024Br 1  8D rr rr             STA     used_unit_count
00024Er 1  8D rr rr             STA     src_ctx_depth
000251r 1               ; main entry-point patch slot — sentinel hi byte = $FF means "none/done"
000251r 1  A9 FF                LDA     #$FF
000253r 1  8D rr rr             STA     main_jmp_patch+1
000256r 1  8D rr rr             STA     body_chain_patch+1
000259r 1               ; init lexer and prime first token
000259r 1  20 rr rr             JSR     lexer_init
00025Cr 1  20 rr rr             JSR     next_token
00025Fr 1  60                   RTS
000260r 1               
000260r 1               ; ---------------------------------------------------------------------------
000260r 1               ; compile_error — print error with line/col; increment error_count
000260r 1               ; tmp0 = pointer to error string
000260r 1               ; ---------------------------------------------------------------------------
000260r 1               compile_error:
000260r 1               ; save caller's message pointer (tmp0) into tmp3
000260r 1  A5 rr                LDA     tmp0
000262r 1  85 rr                STA     tmp3
000264r 1  A5 rr                LDA     tmp0+1
000266r 1  85 rr                STA     tmp3+1
000268r 1               ; print "Line "
000268r 1  A9 rr                LDA     #<msg_line
00026Ar 1  85 rr                STA     tmp0
00026Cr 1  A9 rr                LDA     #>msg_line
00026Er 1  85 rr                STA     tmp0+1
000270r 1  20 rr rr             JSR     console_print_sz
000273r 1               ; print line number
000273r 1  A5 rr                LDA     lex_line
000275r 1  85 rr                STA     tmp0
000277r 1  A5 rr                LDA     lex_line+1
000279r 1  85 rr                STA     tmp0+1
00027Br 1  20 rr rr             JSR     console_print_dec
00027Er 1               ; print ": "
00027Er 1  A9 3A                LDA     #':'
000280r 1  A2 02                LDX     #PEM_CONOUT
000282r 1  20 03 01             JSR     PEM_ENTRY
000285r 1  A9 20                LDA     #' '
000287r 1  A2 02                LDX     #PEM_CONOUT
000289r 1  20 03 01             JSR     PEM_ENTRY
00028Cr 1               ; print the error message text
00028Cr 1  A5 rr                LDA     tmp3
00028Er 1  85 rr                STA     tmp0
000290r 1  A5 rr                LDA     tmp3+1
000292r 1  85 rr                STA     tmp0+1
000294r 1  20 rr rr             JSR     console_print_sz
000297r 1  20 rr rr             JSR     console_newline
00029Ar 1               ; increment error count
00029Ar 1  EE rr rr             INC     error_count
00029Dr 1  D0 03                BNE     :+
00029Fr 1  EE rr rr             INC     error_count+1
0002A2r 1               :
0002A2r 1  60                   RTS
0002A3r 1               
0002A3r 1               ; ---------------------------------------------------------------------------
0002A3r 1               ; write_pcd — write .PCD header + entire code buffer to output file
0002A3r 1               ;   Sector 0:        12-byte header  + first 116 bytes of code  (padded)
0002A3r 1               ;   Sectors 1..N-1:  128 bytes of code each                     (last padded)
0002A3r 1               ;
0002A3r 1               ; Uses tmp0 = source pointer (into CODEBUF_BASE),
0002A3r 1               ;      tmp3 = bytes remaining to write,
0002A3r 1               ;      tmp1 = FCB pointer (re-loaded before each file_write_sector).
0002A3r 1               ; ---------------------------------------------------------------------------
0002A3r 1               write_pcd:
0002A3r 1               ; --- src_ptr = CODEBUF_BASE; remaining = cg_pc ---
0002A3r 1  A9 00                LDA     #<CODEBUF_BASE
0002A5r 1  85 rr                STA     tmp0
0002A7r 1  A9 45                LDA     #>CODEBUF_BASE
0002A9r 1  85 rr                STA     tmp0+1
0002ABr 1  A5 rr                LDA     cg_pc
0002ADr 1  85 rr                STA     tmp3
0002AFr 1  A5 rr                LDA     cg_pc+1
0002B1r 1  85 rr                STA     tmp3+1
0002B3r 1               
0002B3r 1               ; --- header bytes 0..11 directly into DMA_BUF ---
0002B3r 1  A9 50                LDA     #PCD_MAGIC_0
0002B5r 1  8D 28 01             STA     DMA_BUF+0
0002B8r 1  A9 43                LDA     #PCD_MAGIC_1
0002BAr 1  8D 29 01             STA     DMA_BUF+1
0002BDr 1  A9 01                LDA     #PCD_VERSION
0002BFr 1  8D 2A 01             STA     DMA_BUF+2
0002C2r 1  A9 00                LDA     #0
0002C4r 1  8D 2B 01             STA     DMA_BUF+3
0002C7r 1  A5 rr                LDA     cg_pc
0002C9r 1  8D 2C 01             STA     DMA_BUF+PCD_CODESZ
0002CCr 1  A5 rr                LDA     cg_pc+1
0002CEr 1  8D 2D 01             STA     DMA_BUF+PCD_CODESZ+1
0002D1r 1  A5 rr                LDA     cg_globals
0002D3r 1  8D 2E 01             STA     DMA_BUF+PCD_GLOBSZ
0002D6r 1  A5 rr                LDA     cg_globals+1
0002D8r 1  8D 2F 01             STA     DMA_BUF+PCD_GLOBSZ+1
0002DBr 1  A9 00                LDA     #0
0002DDr 1  8D 30 01             STA     DMA_BUF+PCD_STRSZ
0002E0r 1  8D 31 01             STA     DMA_BUF+PCD_STRSZ+1
0002E3r 1  8D 32 01             STA     DMA_BUF+PCD_ENTRY
0002E6r 1  8D 33 01             STA     DMA_BUF+PCD_ENTRY+1
0002E9r 1               
0002E9r 1               ; --- first sector: copy code into DMA_BUF[12..127] ---
0002E9r 1  A0 00                LDY     #0              ; src offset within this batch
0002EBr 1  A2 0C                LDX     #PCD_HEADER_SZ  ; dest offset in DMA
0002EDr 1               @fill1:
0002EDr 1  E0 80                CPX     #128
0002EFr 1  B0 23                BCS     @write1
0002F1r 1  A5 rr                LDA     tmp3
0002F3r 1  05 rr                ORA     tmp3+1
0002F5r 1  F0 11                BEQ     @pad1
0002F7r 1  B1 rr                LDA     (tmp0),y
0002F9r 1  9D 28 01             STA     DMA_BUF,x
0002FCr 1  E8                   INX
0002FDr 1  C8                   INY
0002FEr 1               ; remaining--
0002FEr 1  A5 rr                LDA     tmp3
000300r 1  D0 02                BNE     :+
000302r 1  C6 rr                DEC     tmp3+1
000304r 1               :
000304r 1  C6 rr                DEC     tmp3
000306r 1  80 E5                BRA     @fill1
000308r 1               @pad1:
000308r 1  E0 80                CPX     #128
00030Ar 1  B0 08                BCS     @write1
00030Cr 1  A9 00                LDA     #0
00030Er 1  9D 28 01             STA     DMA_BUF,x
000311r 1  E8                   INX
000312r 1  80 F4                BRA     @pad1
000314r 1               @write1:
000314r 1               ; advance src by Y (bytes consumed from this batch)
000314r 1  84 rr                STY     scratch
000316r 1  18                   CLC
000317r 1  A5 rr                LDA     tmp0
000319r 1  65 rr                ADC     scratch
00031Br 1  85 rr                STA     tmp0
00031Dr 1  90 02                BCC     :+
00031Fr 1  E6 rr                INC     tmp0+1
000321r 1               :
000321r 1  A9 rr                LDA     #<comp_out_fcb
000323r 1  85 rr                STA     tmp1
000325r 1  A9 rr                LDA     #>comp_out_fcb
000327r 1  85 rr                STA     tmp1+1
000329r 1  20 rr rr             JSR     file_write_sector
00032Cr 1               
00032Cr 1               ; --- additional sectors (full 128 bytes each, last pad with 0) ---
00032Cr 1               @next_sec:
00032Cr 1  A5 rr                LDA     tmp3
00032Er 1  05 rr                ORA     tmp3+1
000330r 1  F0 42                BEQ     @done
000332r 1  A0 00                LDY     #0
000334r 1               @fill2:
000334r 1  C0 80                CPY     #128
000336r 1  B0 22                BCS     @write2
000338r 1  A5 rr                LDA     tmp3
00033Ar 1  05 rr                ORA     tmp3+1
00033Cr 1  F0 10                BEQ     @pad2
00033Er 1  B1 rr                LDA     (tmp0),y
000340r 1  99 28 01             STA     DMA_BUF,y
000343r 1  C8                   INY
000344r 1  A5 rr                LDA     tmp3
000346r 1  D0 02                BNE     :+
000348r 1  C6 rr                DEC     tmp3+1
00034Ar 1               :
00034Ar 1  C6 rr                DEC     tmp3
00034Cr 1  80 E6                BRA     @fill2
00034Er 1               @pad2:
00034Er 1  C0 80                CPY     #128
000350r 1  B0 08                BCS     @write2
000352r 1  A9 00                LDA     #0
000354r 1  99 28 01             STA     DMA_BUF,y
000357r 1  C8                   INY
000358r 1  80 F4                BRA     @pad2
00035Ar 1               @write2:
00035Ar 1               ; advance src by 128 (Y is the count copied from src this sector;
00035Ar 1               ; padded bytes at the tail are not source bytes, but remaining is
00035Ar 1               ; already 0 in that case and the loop will exit).
00035Ar 1  84 rr                STY     scratch
00035Cr 1  18                   CLC
00035Dr 1  A5 rr                LDA     tmp0
00035Fr 1  65 rr                ADC     scratch
000361r 1  85 rr                STA     tmp0
000363r 1  90 02                BCC     :+
000365r 1  E6 rr                INC     tmp0+1
000367r 1               :
000367r 1  A9 rr                LDA     #<comp_out_fcb
000369r 1  85 rr                STA     tmp1
00036Br 1  A9 rr                LDA     #>comp_out_fcb
00036Dr 1  85 rr                STA     tmp1+1
00036Fr 1  20 rr rr             JSR     file_write_sector
000372r 1  80 B8                BRA     @next_sec
000374r 1               @done:
000374r 1  60                   RTS
000375r 1               
000375r 1               ; ---------------------------------------------------------------------------
000375r 1               ; Include sub-modules (compiler phases)
000375r 1               ; ---------------------------------------------------------------------------
000375r 1                       .include        "LEXER.ASM"
000375r 2               .PC02
000375r 2               ; lexer.asm — Pascal tokenizer
000375r 2               ;
000375r 2               ; Reads source file through 128-byte sector buffer.
000375r 2               ; Produces token stream via next_token (sets tok_type + value vars in ZP).
000375r 2               
000375r 2               ; ---------------------------------------------------------------------------
000375r 2               ; Keyword table — each entry: length byte, ASCII chars, token code
000375r 2               ; Searched linearly; 18 keywords.
000375r 2               ; ---------------------------------------------------------------------------
000375r 2                       .segment        "CODE"
000375r 2               
000375r 2               keyword_table:
000375r 2               ; length, chars..., token
000375r 2  03 41 4E 44          .BYTE   3, "AND",       TOK_AND
000379r 2  40           
00037Ar 2  05 41 52 52          .BYTE   5, "ARRAY",     TOK_ARRAY
00037Er 2  41 59 41     
000381r 2  05 42 45 47          .BYTE   5, "BEGIN",     TOK_BEGIN
000385r 2  49 4E 42     
000388r 2  04 43 41 53          .BYTE   4, "CASE",      TOK_CASE
00038Cr 2  45 43        
00038Er 2  05 43 4F 4E          .BYTE   5, "CONST",     TOK_CONST
000392r 2  53 54 44     
000395r 2  03 44 49 56          .BYTE   3, "DIV",       TOK_DIV
000399r 2  45           
00039Ar 2  02 44 4F 46          .BYTE   2, "DO",        TOK_DO
00039Er 2  06 44 4F 57          .BYTE   6, "DOWNTO",    TOK_DOWNTO
0003A2r 2  4E 54 4F 47  
0003A6r 2  04 45 4C 53          .BYTE   4, "ELSE",      TOK_ELSE
0003AAr 2  45 48        
0003ACr 2  03 45 4E 44          .BYTE   3, "END",       TOK_END
0003B0r 2  49           
0003B1r 2  03 46 4F 52          .BYTE   3, "FOR",       TOK_FOR
0003B5r 2  4A           
0003B6r 2  08 46 55 4E          .BYTE   8, "FUNCTION",  TOK_FUNCTION
0003BAr 2  43 54 49 4F  
0003BEr 2  4E 4B        
0003C0r 2  02 49 46 4C          .BYTE   2, "IF",        TOK_IF
0003C4r 2  0E 49 4D 50          .BYTE   14, "IMPLEMENTATION", TOK_IMPLEMENTATION
0003C8r 2  4C 45 4D 45  
0003CCr 2  4E 54 41 54  
0003D4r 2  02 49 4E 4D          .BYTE   2, "IN",        TOK_IN
0003D8r 2  09 49 4E 54          .BYTE   9, "INTERFACE", TOK_INTERFACE
0003DCr 2  45 52 46 41  
0003E0r 2  43 45 60     
0003E3r 2  03 4D 4F 44          .BYTE   3, "MOD",       TOK_MOD_KW
0003E7r 2  4E           
0003E8r 2  03 4E 49 4C          .BYTE   3, "NIL",       TOK_NIL
0003ECr 2  4F           
0003EDr 2  03 4E 4F 54          .BYTE   3, "NOT",       TOK_NOT
0003F1r 2  50           
0003F2r 2  02 4F 46 51          .BYTE   2, "OF",        TOK_OF
0003F6r 2  02 4F 52 52          .BYTE   2, "OR",        TOK_OR
0003FAr 2  09 50 52 4F          .BYTE   9, "PROCEDURE", TOK_PROCEDURE
0003FEr 2  43 45 44 55  
000402r 2  52 45 53     
000405r 2  07 50 52 4F          .BYTE   7, "PROGRAM",   TOK_PROGRAM
000409r 2  47 52 41 4D  
00040Dr 2  54           
00040Er 2  06 52 45 43          .BYTE   6, "RECORD",    TOK_RECORD
000412r 2  4F 52 44 55  
000416r 2  06 52 45 50          .BYTE   6, "REPEAT",    TOK_REPEAT
00041Ar 2  45 41 54 56  
00041Er 2  03 53 45 54          .BYTE   3, "SET",       TOK_SET
000422r 2  57           
000423r 2  04 54 48 45          .BYTE   4, "THEN",      TOK_THEN
000427r 2  4E 58        
000429r 2  02 54 4F 59          .BYTE   2, "TO",        TOK_TO
00042Dr 2  04 54 59 50          .BYTE   4, "TYPE",      TOK_TYPE
000431r 2  45 5A        
000433r 2  04 55 4E 49          .BYTE   4, "UNIT",      TOK_UNIT
000437r 2  54 61        
000439r 2  05 55 4E 54          .BYTE   5, "UNTIL",     TOK_UNTIL
00043Dr 2  49 4C 5B     
000440r 2  04 55 53 45          .BYTE   4, "USES",      TOK_USES
000444r 2  53 62        
000446r 2  03 56 41 52          .BYTE   3, "VAR",       TOK_VAR
00044Ar 2  5C           
00044Br 2  05 57 48 49          .BYTE   5, "WHILE",     TOK_WHILE
00044Fr 2  4C 45 5D     
000452r 2  04 57 49 54          .BYTE   4, "WITH",      TOK_WITH
000456r 2  48 5E        
000458r 2  00                   .BYTE   0               ; sentinel
000459r 2               
000459r 2               ; Identifier buffer (max 63 chars + length byte at [0])
000459r 2               ident_buf:
000459r 2  xx xx xx xx          .RES    64
00045Dr 2  xx xx xx xx  
000461r 2  xx xx xx xx  
000499r 2               
000499r 2               ; Saved-name buffer for parser (e.g. var-decl name preservation across
000499r 2               ; parse_type_spec which clobbers ident_buf).
000499r 2               save_name_buf:
000499r 2  xx xx xx xx          .RES    16
00049Dr 2  xx xx xx xx  
0004A1r 2  xx xx xx xx  
0004A9r 2               
0004A9r 2               ; Saved symbol info — used by parse_assign_or_call to preserve symbol
0004A9r 2               ; entry fields across next_token + parse_expression, which clobber tmp3.
0004A9r 2               sym_save_kind:
0004A9r 2  xx                   .RES    1
0004AAr 2               sym_save_type:
0004AAr 2  xx                   .RES    1               ; SYM entry offset 17 (data type: TY_*)
0004ABr 2               sym_save_scope:
0004ABr 2  xx                   .RES    1
0004ACr 2               sym_save_off:
0004ACr 2  xx xx                .RES    2
0004AEr 2               sym_save_pcount:
0004AEr 2  xx                   .RES    1                       ; SYM_PROC param count (entry offset 21)
0004AFr 2               sym_save_vmask:
0004AFr 2  xx                   .RES    1               ; SYM_PROC/SYM_FUNC VAR-param bitmap (entry offset 22)
0004B0r 2               sym_save_lsize:
0004B0r 2  xx                   .RES    1               ; SYM_PROC/SYM_FUNC total local-area size (entry offset 23)
0004B1r 2               
0004B1r 2               ; ARRAY type scratch — set by parse_type_spec when it parses an ARRAY type;
0004B1r 2               ; read by parse_var_decls to compute storage size and adjusted offset.
0004B1r 2               array_lo:
0004B1r 2  xx xx                .RES    2               ; lower bound (signed word)
0004B3r 2               array_hi:
0004B3r 2  xx xx                .RES    2               ; upper bound (signed word)
0004B5r 2               array_elem_ty:
0004B5r 2  xx                   .RES    1               ; element base type (TY_INT, TY_CHAR, TY_BOOL …)
0004B6r 2               
0004B6r 2               ; RECORD type scratch — set by parse_type_spec when it parses a RECORD type
0004B6r 2               ; (or resolves a TYPE alias of a RECORD).  Read by parse_var_decls and by
0004B6r 2               ; parse_type_decls to copy into the new SYM_VAR/SYM_TYPE entry.
0004B6r 2               record_size:
0004B6r 2  xx xx                .RES    2               ; total record size in bytes
0004B8r 2               record_first_field:
0004B8r 2  xx                   .RES    1               ; index of first field in field_table
0004B9r 2               record_field_count:
0004B9r 2  xx                   .RES    1               ; number of fields in this record
0004BAr 2               
0004BAr 2               ; Procedure-declaration scratch (parse_proc_decl; not nestable in this build).
0004BAr 2               proc_param_count:
0004BAr 2  xx                   .RES    1               ; running count while parsing param list
0004BBr 2               proc_entry_idx:
0004BBr 2  xx xx                .RES    2               ; symtab entry pointer (legacy name; for backpatch)
0004BDr 2               param_var_mask:
0004BDr 2  xx                   .RES    1               ; bitmap of which params are VAR (bit i ↔ param i, max 8)
0004BEr 2               group_is_var:
0004BEr 2  xx                   .RES    1               ; 1 while parsing the names of a VAR-prefixed group
0004BFr 2               local_alloc_off:
0004BFr 2  xx                   .RES    1               ; next free local-AR offset; init = pcount*2 at proc entry
0004C0r 2               uses_saved_tok:
0004C0r 2  xx                   .RES    1               ; saved top-level lookahead token while USES imports other source files
0004C1r 2               
0004C1r 2               ; Function-call scratch (parse_factor @sym_func_call; nested fn calls in args
0004C1r 2               ; not yet supported — see TODO).
0004C1r 2               fcall_pcount:
0004C1r 2  xx                   .RES    1
0004C2r 2               fcall_lo:
0004C2r 2  xx                   .RES    1
0004C3r 2               fcall_hi:
0004C3r 2  xx                   .RES    1
0004C4r 2               fcall_type:
0004C4r 2  xx                   .RES    1
0004C5r 2               fcall_vmask:
0004C5r 2  xx                   .RES    1               ; the called proc/func's VAR-param bitmap
0004C6r 2               fcall_lsize:
0004C6r 2  xx                   .RES    1               ; the called proc/func's total local-area size (params+locals)
0004C7r 2               
0004C7r 2               ; Record-chain scratch (parse_statement / parse_factor). Used while walking
0004C7r 2               ; dotted field access through nested RECORD values.
0004C7r 2               field_chain_type:
0004C7r 2  xx                   .RES    1
0004C8r 2               field_chain_first:
0004C8r 2  xx                   .RES    1
0004C9r 2               field_chain_count:
0004C9r 2  xx                   .RES    1
0004CAr 2               
0004CAr 2               ; SET literal scratch (compile-time only). SET values are 16-bit masks over
0004CAr 2               ; element values 0..15 in this build.
0004CAr 2               set_lit_mask:
0004CAr 2  xx xx                .RES    2
0004CCr 2               set_lit_lo:
0004CCr 2  xx                   .RES    1
0004CDr 2               set_lit_hi:
0004CDr 2  xx                   .RES    1
0004CEr 2               set_lit_cur:
0004CEr 2  xx                   .RES    1
0004CFr 2               
0004CFr 2               ; Main-program entry-point patch slot. compile_program emits a UJP at code
0004CFr 2               ; offset 0; top-level BEGIN/init blocks patch it to the first startup body
0004CFr 2               ; that should run. Hi byte = $FF means "already patched / none pending"
0004CFr 2               ; (sentinel — never a valid patch addr since cg_pc starts at 0).
0004CFr 2               main_jmp_patch:
0004CFr 2  xx xx                .RES    2
0004D1r 2               
0004D1r 2               ; Pending tail-jump patch for the most recently emitted top-level body.
0004D1r 2               ; Each startup body (unit init or main BEGIN) ends with a UJP placeholder so
0004D1r 2               ; later top-level bodies can be chained together without falling through into
0004D1r 2               ; intervening procedure/function code.
0004D1r 2               body_chain_patch:
0004D1r 2  xx xx                .RES    2
0004D3r 2               
0004D3r 2               ; ---------------------------------------------------------------------------
0004D3r 2               ; lexer_init — reset lexer state; call before compile_program
0004D3r 2               ; ---------------------------------------------------------------------------
0004D3r 2               lexer_init:
0004D3r 2  A9 01                LDA     #1
0004D5r 2  85 rr                STA     lex_line
0004D7r 2  A9 00                LDA     #0
0004D9r 2  85 rr                STA     lex_line+1
0004DBr 2  85 rr                STA     lex_col
0004DDr 2  85 rr                STA     src_buf_pos
0004DFr 2  85 rr                STA     src_buf_end
0004E1r 2               ; prime lex_char
0004E1r 2  20 rr rr             JSR     lexer_getc
0004E4r 2  60                   RTS
0004E5r 2               
0004E5r 2               ; ---------------------------------------------------------------------------
0004E5r 2               ; next_token — advance to next token, set tok_type
0004E5r 2               ; On return:
0004E5r 2               ;   tok_type  = token code
0004E5r 2               ;   tok_ival  = integer value (if TOK_INT)
0004E5r 2               ;   ident_buf = identifier string (if TOK_IDENT)
0004E5r 2               ; ---------------------------------------------------------------------------
0004E5r 2               next_token:
0004E5r 2               ; skip whitespace and comments
0004E5r 2               @skip:
0004E5r 2  A5 rr                LDA     lex_char
0004E7r 2  F0 3B                BEQ     @eof
0004E9r 2  C9 20                CMP     #' '
0004EBr 2  F0 13                BEQ     @ws
0004EDr 2  C9 09                CMP     #$09            ; TAB
0004EFr 2  F0 0F                BEQ     @ws
0004F1r 2  C9 0D                CMP     #$0D            ; CR — treat as whitespace, LF counts the line
0004F3r 2  F0 0B                BEQ     @ws
0004F5r 2  C9 0A                CMP     #$0A            ; LF
0004F7r 2  F0 0C                BEQ     @nl
0004F9r 2  C9 7B                CMP     #'{'            ; Pascal comment start
0004FBr 2  F0 17                BEQ     @comment
0004FDr 2  4C rr rr             JMP     @not_ws
000500r 2               @ws:
000500r 2  20 rr rr             JSR     lexer_getc
000503r 2  80 E0                BRA     @skip
000505r 2               @nl:
000505r 2  E6 rr                INC     lex_line
000507r 2  D0 02                BNE     :+
000509r 2  E6 rr                INC     lex_line+1
00050Br 2               :
00050Br 2  A9 00                LDA     #0
00050Dr 2  85 rr                STA     lex_col
00050Fr 2  20 rr rr             JSR     lexer_getc
000512r 2  80 D1                BRA     @skip
000514r 2               @comment:
000514r 2               ; skip { ... }
000514r 2               @cloop:
000514r 2  20 rr rr             JSR     lexer_getc
000517r 2  A5 rr                LDA     lex_char        ; PLY inside lexer_getc clobbers Z; reload to test EOF
000519r 2  F0 09                BEQ     @eof
00051Br 2  C9 7D                CMP     #'}'
00051Dr 2  D0 F5                BNE     @cloop
00051Fr 2  20 rr rr             JSR     lexer_getc
000522r 2  80 C1                BRA     @skip
000524r 2               @eof:
000524r 2  A9 00                LDA     #TOK_EOF
000526r 2  85 rr                STA     tok_type
000528r 2  60                   RTS
000529r 2               
000529r 2               @not_ws:
000529r 2               ; letter → identifier or keyword
000529r 2  20 rr rr             JSR     is_letter
00052Cr 2  B0 0C                BCS     @ident
00052Er 2               
00052Er 2               ; digit → integer literal
00052Er 2  20 rr rr             JSR     is_digit
000531r 2  B0 2F                BCS     @number
000533r 2               
000533r 2               ; string → string literal
000533r 2  C9 27                CMP     #$27            ; single quote
000535r 2  F0 48                BEQ     @string
000537r 2               
000537r 2               ; operators and punctuation
000537r 2  4C rr rr             JMP     @punct
00053Ar 2               
00053Ar 2               ; --- Identifier ---
00053Ar 2               @ident:
00053Ar 2  A0 00                LDY     #0
00053Cr 2               @id_loop:
00053Cr 2  A5 rr                LDA     lex_char
00053Er 2  20 rr rr             JSR     to_upper
000541r 2  99 rr rr             STA     ident_buf+1,y
000544r 2  C8                   INY
000545r 2  C0 3F                CPY     #63
000547r 2  F0 0F                BEQ     @id_done
000549r 2  20 rr rr             JSR     lexer_getc
00054Cr 2  A5 rr                LDA     lex_char
00054Er 2  20 rr rr             JSR     is_letter
000551r 2  B0 E9                BCS     @id_loop
000553r 2  20 rr rr             JSR     is_digit
000556r 2  B0 E4                BCS     @id_loop
000558r 2               @id_done:
000558r 2  98                   TYA
000559r 2  8D rr rr             STA     ident_buf       ; length
00055Cr 2               ; check against keyword table
00055Cr 2  20 rr rr             JSR     lookup_keyword
00055Fr 2  85 rr                STA     tok_type
000561r 2  60                   RTS
000562r 2               
000562r 2               ; --- Integer literal ---
000562r 2               @number:
000562r 2  A9 00                LDA     #0
000564r 2  85 rr                STA     tok_ival_lo
000566r 2  85 rr                STA     tok_ival_hi
000568r 2               @num_loop:
000568r 2  A5 rr                LDA     lex_char
00056Ar 2  38                   SEC
00056Br 2  E9 30                SBC     #'0'
00056Dr 2  20 rr rr             JSR     mul10_tokval    ; tokval = tokval*10 + digit
000570r 2  20 rr rr             JSR     lexer_getc
000573r 2  A5 rr                LDA     lex_char
000575r 2  20 rr rr             JSR     is_digit
000578r 2  B0 EE                BCS     @num_loop
00057Ar 2  A9 02                LDA     #TOK_INT
00057Cr 2  85 rr                STA     tok_type
00057Er 2  60                   RTS
00057Fr 2               
00057Fr 2               ; --- String literal ---
00057Fr 2               @string:
00057Fr 2  20 rr rr             JSR     lexer_getc      ; skip opening quote
000582r 2  A0 00                LDY     #0
000584r 2               @str_loop:
000584r 2  A5 rr                LDA     lex_char
000586r 2  F0 21                BEQ     @str_done       ; EOF
000588r 2  C9 27                CMP     #$27
00058Ar 2  F0 09                BEQ     @str_close
00058Cr 2  99 rr rr             STA     ident_buf+1,y
00058Fr 2  C8                   INY
000590r 2  20 rr rr             JSR     lexer_getc
000593r 2  80 EF                BRA     @str_loop
000595r 2               @str_close:
000595r 2  20 rr rr             JSR     lexer_getc      ; skip closing quote
000598r 2               ; check for '' (escaped quote)
000598r 2  A5 rr                LDA     lex_char
00059Ar 2  C9 27                CMP     #$27
00059Cr 2  D0 0B                BNE     @str_done
00059Er 2  A9 27                LDA     #$27
0005A0r 2  99 rr rr             STA     ident_buf+1,y
0005A3r 2  C8                   INY
0005A4r 2  20 rr rr             JSR     lexer_getc
0005A7r 2  80 DB                BRA     @str_loop
0005A9r 2               @str_done:
0005A9r 2  98                   TYA
0005AAr 2  8D rr rr             STA     ident_buf
0005ADr 2  A9 03                LDA     #TOK_STRING
0005AFr 2  85 rr                STA     tok_type
0005B1r 2  60                   RTS
0005B2r 2               
0005B2r 2               ; --- Punctuation / operators ---
0005B2r 2               @punct:
0005B2r 2  A2 00                LDX     #0
0005B4r 2  A5 rr                LDA     lex_char
0005B6r 2  C9 2B                CMP     #'+'
0005B8r 2  D0 02                BNE     :+
0005BAr 2  A2 10                LDX     #TOK_PLUS
0005BCr 2               :
0005BCr 2  C9 2D                CMP     #'-'
0005BEr 2  D0 02                BNE     :+
0005C0r 2  A2 11                LDX     #TOK_MINUS
0005C2r 2               :
0005C2r 2  C9 2A                CMP     #'*'
0005C4r 2  D0 02                BNE     :+
0005C6r 2  A2 12                LDX     #TOK_STAR
0005C8r 2               :
0005C8r 2  C9 2F                CMP     #'/'
0005CAr 2  D0 02                BNE     :+
0005CCr 2  A2 13                LDX     #TOK_SLASH
0005CEr 2               :
0005CEr 2  C9 3D                CMP     #'='
0005D0r 2  D0 02                BNE     :+
0005D2r 2  A2 14                LDX     #TOK_EQ
0005D4r 2               :
0005D4r 2  C9 28                CMP     #'('
0005D6r 2  D0 02                BNE     :+
0005D8r 2  A2 1B                LDX     #TOK_LPAREN
0005DAr 2               :
0005DAr 2  C9 29                CMP     #')'
0005DCr 2  D0 02                BNE     :+
0005DEr 2  A2 1C                LDX     #TOK_RPAREN
0005E0r 2               :
0005E0r 2  C9 5B                CMP     #'['
0005E2r 2  D0 02                BNE     :+
0005E4r 2  A2 1D                LDX     #TOK_LBRACK
0005E6r 2               :
0005E6r 2  C9 5D                CMP     #']'
0005E8r 2  D0 02                BNE     :+
0005EAr 2  A2 1E                LDX     #TOK_RBRACK
0005ECr 2               :
0005ECr 2  C9 2C                CMP     #','
0005EEr 2  D0 02                BNE     :+
0005F0r 2  A2 1F                LDX     #TOK_COMMA
0005F2r 2               :
0005F2r 2  C9 3B                CMP     #';'
0005F4r 2  D0 02                BNE     :+
0005F6r 2  A2 20                LDX     #TOK_SEMICOLON
0005F8r 2               :
0005F8r 2  C9 5E                CMP     #'^'
0005FAr 2  D0 02                BNE     :+
0005FCr 2  A2 24                LDX     #TOK_CARET
0005FEr 2               :
0005FEr 2  C9 3C                CMP     #'<'
000600r 2  D0 22                BNE     @not_lt
000602r 2  20 rr rr             JSR     lexer_getc
000605r 2  A5 rr                LDA     lex_char
000607r 2  C9 3D                CMP     #'='
000609r 2  F0 09                BEQ     @leq
00060Br 2  C9 3E                CMP     #'>'
00060Dr 2  F0 0D                BEQ     @neq
00060Fr 2  A9 16                LDA     #TOK_LT
000611r 2  85 rr                STA     tok_type
000613r 2  60                   RTS
000614r 2               @leq:
000614r 2  20 rr rr             JSR     lexer_getc
000617r 2  A9 18                LDA     #TOK_LEQ
000619r 2  85 rr                STA     tok_type
00061Br 2  60                   RTS
00061Cr 2               @neq:
00061Cr 2  20 rr rr             JSR     lexer_getc
00061Fr 2  A9 15                LDA     #TOK_NEQ
000621r 2  85 rr                STA     tok_type
000623r 2  60                   RTS
000624r 2               @not_lt:
000624r 2  C9 3E                CMP     #'>'
000626r 2  D0 16                BNE     @not_gt
000628r 2  20 rr rr             JSR     lexer_getc
00062Br 2  A5 rr                LDA     lex_char
00062Dr 2  C9 3D                CMP     #'='
00062Fr 2  F0 05                BEQ     @geq
000631r 2  A9 17                LDA     #TOK_GT
000633r 2  85 rr                STA     tok_type
000635r 2  60                   RTS
000636r 2               @geq:
000636r 2  20 rr rr             JSR     lexer_getc
000639r 2  A9 19                LDA     #TOK_GEQ
00063Br 2  85 rr                STA     tok_type
00063Dr 2  60                   RTS
00063Er 2               @not_gt:
00063Er 2  C9 3A                CMP     #':'
000640r 2  D0 16                BNE     @not_colon
000642r 2  20 rr rr             JSR     lexer_getc
000645r 2  A5 rr                LDA     lex_char
000647r 2  C9 3D                CMP     #'='
000649r 2  F0 05                BEQ     @assign
00064Br 2  A9 21                LDA     #TOK_COLON
00064Dr 2  85 rr                STA     tok_type
00064Fr 2  60                   RTS
000650r 2               @assign:
000650r 2  20 rr rr             JSR     lexer_getc
000653r 2  A9 1A                LDA     #TOK_ASSIGN
000655r 2  85 rr                STA     tok_type
000657r 2  60                   RTS
000658r 2               @not_colon:
000658r 2  C9 2E                CMP     #'.'
00065Ar 2  D0 16                BNE     @not_dot
00065Cr 2  20 rr rr             JSR     lexer_getc
00065Fr 2  A5 rr                LDA     lex_char
000661r 2  C9 2E                CMP     #'.'
000663r 2  F0 05                BEQ     @dotdot
000665r 2  A9 22                LDA     #TOK_DOT
000667r 2  85 rr                STA     tok_type
000669r 2  60                   RTS
00066Ar 2               @dotdot:
00066Ar 2  20 rr rr             JSR     lexer_getc
00066Dr 2  A9 23                LDA     #TOK_DOTDOT
00066Fr 2  85 rr                STA     tok_type
000671r 2  60                   RTS
000672r 2               @not_dot:
000672r 2               ; If a single-byte operator matched above, X holds its TOK_* code.
000672r 2               ; Otherwise X=0 and the character is unknown — skip and retry.
000672r 2  E0 00                CPX     #0
000674r 2  F0 07                BEQ     @unknown
000676r 2  8A                   TXA
000677r 2  85 rr                STA     tok_type
000679r 2  20 rr rr             JSR     lexer_getc
00067Cr 2  60                   RTS
00067Dr 2               @unknown:
00067Dr 2  20 rr rr             JSR     lexer_getc
000680r 2  4C rr rr             JMP     next_token
000683r 2               
000683r 2               ; ---------------------------------------------------------------------------
000683r 2               ; lexer_getc — fetch next character into lex_char
000683r 2               ; Refills sector buffer via file_read_sector when empty
000683r 2               ; ---------------------------------------------------------------------------
000683r 2               lexer_getc:
000683r 2  5A                   PHY                     ; preserve caller's Y across refill + read
000684r 2  A5 rr                LDA     src_buf_pos
000686r 2  C5 rr                CMP     src_buf_end
000688r 2  90 17                BCC     @from_buf       ; still have data
00068Ar 2               ; refill buffer — set tmp1 to source FCB first
00068Ar 2               ; (other code paths leave tmp1 pointing at output FCB)
00068Ar 2  A5 rr                LDA     src_fcb
00068Cr 2  85 rr                STA     tmp1
00068Er 2  A5 rr                LDA     src_fcb+1
000690r 2  85 rr                STA     tmp1+1
000692r 2  20 rr rr             JSR     file_read_sector
000695r 2  C9 00                CMP     #0
000697r 2  D0 15                BNE     @eof_char
000699r 2  A9 80                LDA     #128
00069Br 2  85 rr                STA     src_buf_end
00069Dr 2  A9 00                LDA     #0
00069Fr 2  85 rr                STA     src_buf_pos
0006A1r 2               @from_buf:
0006A1r 2  A4 rr                LDY     src_buf_pos
0006A3r 2  B9 28 01             LDA     DMA_BUF,y
0006A6r 2  E6 rr                INC     src_buf_pos
0006A8r 2  85 rr                STA     lex_char
0006AAr 2  E6 rr                INC     lex_col
0006ACr 2  7A                   PLY
0006ADr 2  60                   RTS
0006AEr 2               @eof_char:
0006AEr 2  A9 00                LDA     #0
0006B0r 2  85 rr                STA     lex_char
0006B2r 2  7A                   PLY
0006B3r 2  60                   RTS
0006B4r 2               
0006B4r 2               ; ---------------------------------------------------------------------------
0006B4r 2               ; lookup_keyword — check ident_buf against keyword_table
0006B4r 2               ; Returns: A = keyword token code, or TOK_IDENT if not found
0006B4r 2               ; ---------------------------------------------------------------------------
0006B4r 2               lookup_keyword:
0006B4r 2  A9 rr                LDA     #<keyword_table
0006B6r 2  85 rr                STA     tmp2
0006B8r 2  A9 rr                LDA     #>keyword_table
0006BAr 2  85 rr                STA     tmp2+1
0006BCr 2               @next_kw:
0006BCr 2  A0 00                LDY     #0
0006BEr 2  B1 rr                LDA     (tmp2),y        ; keyword length (0 = sentinel)
0006C0r 2  F0 2C                BEQ     @not_found
0006C2r 2  CD rr rr             CMP     ident_buf       ; compare lengths first
0006C5r 2  D0 15                BNE     @advance
0006C7r 2  AA                   TAX                     ; X = length
0006C8r 2  A0 01                LDY     #1
0006CAr 2               @cmp_loop:
0006CAr 2  B1 rr                LDA     (tmp2),y
0006CCr 2  D9 rr rr             CMP     ident_buf,y
0006CFr 2  D0 0B                BNE     @advance
0006D1r 2  C8                   INY
0006D2r 2  CA                   DEX
0006D3r 2  D0 F5                BNE     @cmp_loop
0006D5r 2               ; match: token code is at offset length+1
0006D5r 2  AC rr rr             LDY     ident_buf
0006D8r 2  C8                   INY
0006D9r 2  B1 rr                LDA     (tmp2),y
0006DBr 2  60                   RTS
0006DCr 2               @advance:
0006DCr 2               ; skip to next entry: advance tmp2 by (length+2)
0006DCr 2               ; (Y may be >0 if we got here from @cmp_loop — reset to 0 first)
0006DCr 2  A0 00                LDY     #0
0006DEr 2  B1 rr                LDA     (tmp2),y        ; length byte
0006E0r 2  18                   CLC
0006E1r 2  69 02                ADC     #2              ; +1 for length byte, +1 for token byte
0006E3r 2  18                   CLC
0006E4r 2  65 rr                ADC     tmp2
0006E6r 2  85 rr                STA     tmp2
0006E8r 2  90 02                BCC     :+
0006EAr 2  E6 rr                INC     tmp2+1
0006ECr 2               :
0006ECr 2  80 CE                BRA     @next_kw
0006EEr 2               @not_found:
0006EEr 2  A9 01                LDA     #TOK_IDENT
0006F0r 2  60                   RTS
0006F1r 2               
0006F1r 2               ; ---------------------------------------------------------------------------
0006F1r 2               ; is_letter — test lex_char; carry set if A-Z or a-z
0006F1r 2               ; ---------------------------------------------------------------------------
0006F1r 2               is_letter:
0006F1r 2  A5 rr                LDA     lex_char
0006F3r 2  C9 41                CMP     #'A'
0006F5r 2  90 10                BCC     @no
0006F7r 2  C9 5B                CMP     #'Z'+1
0006F9r 2  90 0E                BCC     @yes
0006FBr 2  C9 61                CMP     #'a'
0006FDr 2  90 08                BCC     @no
0006FFr 2  C9 7B                CMP     #'z'+1
000701r 2  90 06                BCC     @yes
000703r 2  C9 5F                CMP     #'_'
000705r 2  F0 02                BEQ     @yes
000707r 2               @no:
000707r 2  18                   CLC
000708r 2  60                   RTS
000709r 2               @yes:
000709r 2  38                   SEC
00070Ar 2  60                   RTS
00070Br 2               
00070Br 2               ; ---------------------------------------------------------------------------
00070Br 2               ; is_digit — test lex_char; carry set if 0-9
00070Br 2               ; ---------------------------------------------------------------------------
00070Br 2               is_digit:
00070Br 2  A5 rr                LDA     lex_char
00070Dr 2  C9 30                CMP     #'0'
00070Fr 2  90 06                BCC     @no
000711r 2  C9 3A                CMP     #'9'+1
000713r 2  B0 02                BCS     @no
000715r 2  38                   SEC
000716r 2  60                   RTS
000717r 2               @no:
000717r 2  18                   CLC
000718r 2  60                   RTS
000719r 2               
000719r 2               ; ---------------------------------------------------------------------------
000719r 2               ; to_upper — convert A to uppercase (A-Z,a-z only, others pass through)
000719r 2               ; ---------------------------------------------------------------------------
000719r 2               to_upper:
000719r 2  C9 61                CMP     #'a'
00071Br 2  90 06                BCC     @done
00071Dr 2  C9 7B                CMP     #'z'+1
00071Fr 2  B0 02                BCS     @done
000721r 2  29 DF                AND     #$DF
000723r 2               @done:
000723r 2  60                   RTS
000724r 2               
000724r 2               ; ---------------------------------------------------------------------------
000724r 2               ; mul10_tokval — tokval = tokval*10 + A  (A = digit 0-9)
000724r 2               ; ---------------------------------------------------------------------------
000724r 2               mul10_tokval:
000724r 2  48                   PHA
000725r 2               ; multiply tok_ival by 10: x10 = x*8 + x*2
000725r 2  A5 rr                LDA     tok_ival_lo
000727r 2  0A                   ASL                     ; *2
000728r 2  85 rr                STA     tmp2
00072Ar 2  A5 rr                LDA     tok_ival_hi
00072Cr 2  2A                   ROL
00072Dr 2  85 rr                STA     tmp2+1
00072Fr 2  A5 rr                LDA     tmp2            ; *4
000731r 2  0A                   ASL
000732r 2  85 rr                STA     tmp3
000734r 2  A5 rr                LDA     tmp2+1
000736r 2  2A                   ROL
000737r 2  85 rr                STA     tmp3+1
000739r 2  A5 rr                LDA     tmp3            ; *8
00073Br 2  0A                   ASL
00073Cr 2  85 rr                STA     tmp3
00073Er 2  A5 rr                LDA     tmp3+1
000740r 2  2A                   ROL
000741r 2  85 rr                STA     tmp3+1
000743r 2               ; *10 = *8 + *2
000743r 2  A5 rr                LDA     tmp3
000745r 2  18                   CLC
000746r 2  65 rr                ADC     tmp2
000748r 2  85 rr                STA     tok_ival_lo
00074Ar 2  A5 rr                LDA     tmp3+1
00074Cr 2  65 rr                ADC     tmp2+1
00074Er 2  85 rr                STA     tok_ival_hi
000750r 2               ; add digit
000750r 2  68                   PLA
000751r 2  18                   CLC
000752r 2  65 rr                ADC     tok_ival_lo
000754r 2  85 rr                STA     tok_ival_lo
000756r 2  90 02                BCC     :+
000758r 2  E6 rr                INC     tok_ival_hi
00075Ar 2               :
00075Ar 2  60                   RTS
00075Br 2               
00075Br 1                       .include        "PARSER.ASM"
00075Br 2               ; parser.asm — recursive-descent Pascal parser + single-pass code generator
00075Br 2               ;
00075Br 2               ; Entry point: compile_program (called from pascal_main)
00075Br 2               ;
00075Br 2               ; This is a skeleton. Each parse routine calls next_token and emits p-code
00075Br 2               ; directly (no AST nodes). Phase 3 fleshes out the full grammar.
00075Br 2               
00075Br 2                       .segment        "CODE"
00075Br 2               
00075Br 2               ; ---------------------------------------------------------------------------
00075Br 2               ; expect — verify current token is `expected_tok`, advance, error if not
00075Br 2               ; expected_tok passed in X; error string pointer in tmp3 (lo) and A (hi)
00075Br 2               ; ---------------------------------------------------------------------------
00075Br 2               expect:
00075Br 2  A5 rr                LDA     tok_type
00075Dr 2  E4 rr                CPX     tok_type
00075Fr 2  F0 18                BEQ     @ok
000761r 2               ; mismatch — report error using tmp3 as message pointer
000761r 2  A5 rr                LDA     tmp3
000763r 2  85 rr                STA     tmp0
000765r 2  A5 rr                LDA     tmp3+1
000767r 2  85 rr                STA     tmp0+1
000769r 2  20 rr rr             JSR     compile_error
00076Cr 2               ; attempt recovery: skip tokens until we see the expected one or EOF
00076Cr 2               @recover:
00076Cr 2  A5 rr                LDA     tok_type
00076Er 2  F0 09                BEQ     @ok             ; EOF — stop recovery
000770r 2  E4 rr                CPX     tok_type
000772r 2  F0 05                BEQ     @ok
000774r 2  20 rr rr             JSR     next_token
000777r 2  80 F3                BRA     @recover
000779r 2               @ok:
000779r 2  20 rr rr             JSR     next_token
00077Cr 2  60                   RTS
00077Dr 2               
00077Dr 2               ; Helper macros — not ca65 .macros since they'd be complex; use inline calls.
00077Dr 2               
00077Dr 2               ; ---------------------------------------------------------------------------
00077Dr 2               ; compile_program — top-level dispatcher for PROGRAM or UNIT sources.
00077Dr 2               ; ---------------------------------------------------------------------------
00077Dr 2               compile_program:
00077Dr 2  20 rr rr             JSR     symtab_init
000780r 2  A9 00                LDA     #0
000782r 2  8D rr rr             STA     unit_section
000785r 2  A5 rr                LDA     tok_type
000787r 2  C9 61                CMP     #TOK_UNIT
000789r 2  F0 03                BEQ     @unit_src
00078Br 2  4C rr rr             JMP     @program_src
00078Er 2               @unit_src:
00078Er 2  4C rr rr             JMP     compile_unit
000791r 2               @program_src:
000791r 2               ; expect PROGRAM keyword
000791r 2  A5 rr                LDA     tok_type
000793r 2  C9 54                CMP     #TOK_PROGRAM
000795r 2  D0 0F                BNE     @no_hdr         ; allow missing PROGRAM header (lenient)
000797r 2  20 rr rr             JSR     next_token
00079Ar 2               ; program name (identifier)
00079Ar 2  20 rr rr             JSR     next_token
00079Dr 2               ; semicolon
00079Dr 2  A5 rr                LDA     tok_type
00079Fr 2  C9 20                CMP     #TOK_SEMICOLON
0007A1r 2  D0 03                BNE     :+
0007A3r 2  20 rr rr             JSR     next_token
0007A6r 2               :
0007A6r 2               @no_hdr:
0007A6r 2               ; Emit a forward UJP at code offset 0; parse_block patches it to point
0007A6r 2               ; to the main BEGIN block once all proc bodies have been emitted ahead
0007A6r 2               ; of it. The .PCD entry point stays at offset 0 (start of code = UJP).
0007A6r 2  20 rr rr             JSR     emit_UJP        ; A=patch_lo, scratch=patch_hi
0007A9r 2  8D rr rr             STA     main_jmp_patch
0007ACr 2  A5 rr                LDA     scratch
0007AEr 2  8D rr rr             STA     main_jmp_patch+1
0007B1r 2  20 rr rr             JSR     parse_block
0007B4r 2               ; Emit HALT at end of main program
0007B4r 2  20 rr rr             JSR     patch_startup_chain_if_needed
0007B7r 2  20 rr rr             JSR     emit_HALT
0007BAr 2  60                   RTS
0007BBr 2               
0007BBr 2               ; patch_startup_chain_if_needed — patch any pending top-level startup jumps
0007BBr 2               ; to the current cg_pc. This handles both the entry UJP (jump to the first
0007BBr 2               ; unit-init/main body) and the tail UJP emitted after each prior top-level
0007BBr 2               ; body (jump to the next one, or eventually HALT).
0007BBr 2               patch_startup_chain_if_needed:
0007BBr 2  AD rr rr             LDA     main_jmp_patch+1
0007BEr 2  C9 FF                CMP     #$FF
0007C0r 2  F0 12                BEQ     @pscii_tail
0007C2r 2  AD rr rr             LDA     main_jmp_patch
0007C5r 2  85 rr                STA     tmp2
0007C7r 2  AD rr rr             LDA     main_jmp_patch+1
0007CAr 2  85 rr                STA     tmp2+1
0007CCr 2  20 rr rr             JSR     patch_jump
0007CFr 2  A9 FF                LDA     #$FF
0007D1r 2  8D rr rr             STA     main_jmp_patch+1
0007D4r 2               @pscii_tail:
0007D4r 2  AD rr rr             LDA     body_chain_patch+1
0007D7r 2  C9 FF                CMP     #$FF
0007D9r 2  F0 12                BEQ     @pscii_done
0007DBr 2  AD rr rr             LDA     body_chain_patch
0007DEr 2  85 rr                STA     tmp2
0007E0r 2  AD rr rr             LDA     body_chain_patch+1
0007E3r 2  85 rr                STA     tmp2+1
0007E5r 2  20 rr rr             JSR     patch_jump
0007E8r 2  A9 FF                LDA     #$FF
0007EAr 2  8D rr rr             STA     body_chain_patch+1
0007EDr 2               @pscii_done:
0007EDr 2  60                   RTS
0007EEr 2               
0007EEr 2               ; ---------------------------------------------------------------------------
0007EEr 2               ; compile_unit — UNIT name ; INTERFACE ... IMPLEMENTATION ... [BEGIN ...] END.
0007EEr 2               ; UNIT sources may be standalone roots or USES-imported. The INTERFACE
0007EEr 2               ; section registers globals and routine headings; IMPLEMENTATION provides the
0007EEr 2               ; bodies plus an optional init block. Imported units compile inline into the
0007EEr 2               ; current .PCD while the startup jump chain preserves init order.
0007EEr 2               ; ---------------------------------------------------------------------------
0007EEr 2               compile_unit:
0007EEr 2  20 rr rr             JSR     next_token              ; consume UNIT
0007F1r 2  A5 rr                LDA     tok_type
0007F3r 2  C9 01                CMP     #TOK_IDENT
0007F5r 2  D0 21                BNE     :+
0007F7r 2  AD rr rr             LDA     unit_import_mode
0007FAr 2  D0 19                BNE     @cu_name_done
0007FCr 2  AE rr rr             LDX     used_unit_count
0007FFr 2  E0 08                CPX     #USED_UNIT_SLOTS
000801r 2  B0 12                BCS     @cu_name_done
000803r 2  DA                   PHX
000804r 2  20 rr rr             JSR     used_unit_slot_ptr
000807r 2  A0 0F                LDY     #15
000809r 2               @cu_root_name_copy:
000809r 2  B9 rr rr             LDA     ident_buf,y
00080Cr 2  91 rr                STA     (tmp2),y
00080Er 2  88                   DEY
00080Fr 2  10 F8                BPL     @cu_root_name_copy
000811r 2  FA                   PLX
000812r 2  EE rr rr             INC     used_unit_count
000815r 2               @cu_name_done:
000815r 2  20 rr rr             JSR     next_token              ; consume unit name
000818r 2  A5 rr        :       LDA     tok_type
00081Ar 2  C9 20                CMP     #TOK_SEMICOLON
00081Cr 2  D0 03                BNE     :+
00081Er 2  20 rr rr             JSR     next_token
000821r 2  A5 rr        :       LDA     tok_type
000823r 2  C9 60                CMP     #TOK_INTERFACE
000825r 2  F0 0D                BEQ     @cu_have_iface
000827r 2  A9 rr                LDA     #<err_unexpected
000829r 2  85 rr                STA     tmp0
00082Br 2  A9 rr                LDA     #>err_unexpected
00082Dr 2  85 rr                STA     tmp0+1
00082Fr 2  20 rr rr             JSR     compile_error
000832r 2  80 03                BRA     @cu_after_iface_kw
000834r 2               @cu_have_iface:
000834r 2  20 rr rr             JSR     next_token              ; consume INTERFACE
000837r 2               @cu_after_iface_kw:
000837r 2  AD rr rr             LDA     unit_import_mode
00083Ar 2  D0 0B                BNE     @cu_iface_ready
00083Cr 2  20 rr rr             JSR     emit_UJP
00083Fr 2  8D rr rr             STA     main_jmp_patch
000842r 2  A5 rr                LDA     scratch
000844r 2  8D rr rr             STA     main_jmp_patch+1
000847r 2               @cu_iface_ready:
000847r 2  A9 01                LDA     #1
000849r 2  8D rr rr             STA     unit_section
00084Cr 2  20 rr rr             JSR     parse_interface_block
00084Fr 2  A5 rr                LDA     tok_type
000851r 2  C9 5F                CMP     #TOK_IMPLEMENTATION
000853r 2  F0 0D                BEQ     @cu_have_impl
000855r 2  A9 rr                LDA     #<err_unexpected
000857r 2  85 rr                STA     tmp0
000859r 2  A9 rr                LDA     #>err_unexpected
00085Br 2  85 rr                STA     tmp0+1
00085Dr 2  20 rr rr             JSR     compile_error
000860r 2  80 03                BRA     @cu_impl_start
000862r 2               @cu_have_impl:
000862r 2  20 rr rr             JSR     next_token              ; consume IMPLEMENTATION
000865r 2               @cu_impl_start:
000865r 2  A9 02                LDA     #2
000867r 2  8D rr rr             STA     unit_section
00086Ar 2  20 rr rr             JSR     parse_block
00086Dr 2  AD rr rr             LDA     unit_import_mode
000870r 2  D0 06                BNE     @cu_done
000872r 2  20 rr rr             JSR     patch_startup_chain_if_needed
000875r 2  20 rr rr             JSR     emit_HALT
000878r 2               @cu_done:
000878r 2  A9 00                LDA     #0
00087Ar 2  8D rr rr             STA     unit_section
00087Dr 2  60                   RTS
00087Er 2               
00087Er 2               ; ---------------------------------------------------------------------------
00087Er 2               ; parse_interface_block — top-level INTERFACE declarations only.
00087Er 2               ; Mirrors parse_block but PROCEDURE/FUNCTION consume headings without bodies.
00087Er 2               ; Stops when IMPLEMENTATION (or anything unrecognised) is reached.
00087Er 2               ; ---------------------------------------------------------------------------
00087Er 2               parse_interface_block:
00087Er 2               @pib_again:
00087Er 2  A5 rr                LDA     tok_type
000880r 2  C9 62                CMP     #TOK_USES
000882r 2  F0 15                BEQ     @pib_uses
000884r 2  C9 44                CMP     #TOK_CONST
000886r 2  F0 16                BEQ     @pib_const
000888r 2  C9 5A                CMP     #TOK_TYPE
00088Ar 2  F0 1A                BEQ     @pib_type
00088Cr 2  C9 5C                CMP     #TOK_VAR
00088Er 2  F0 1E                BEQ     @pib_var
000890r 2  C9 53                CMP     #TOK_PROCEDURE
000892r 2  F0 22                BEQ     @pib_proc
000894r 2  C9 4B                CMP     #TOK_FUNCTION
000896r 2  F0 26                BEQ     @pib_func
000898r 2  60                   RTS
000899r 2               @pib_uses:
000899r 2  20 rr rr             JSR     parse_uses_clause
00089Cr 2  80 E0                BRA     @pib_again
00089Er 2               @pib_const:
00089Er 2  20 rr rr             JSR     next_token
0008A1r 2  20 rr rr             JSR     parse_const_decls
0008A4r 2  80 D8                BRA     @pib_again
0008A6r 2               @pib_type:
0008A6r 2  20 rr rr             JSR     next_token
0008A9r 2  20 rr rr             JSR     parse_type_decls
0008ACr 2  80 D0                BRA     @pib_again
0008AEr 2               @pib_var:
0008AEr 2  20 rr rr             JSR     next_token
0008B1r 2  20 rr rr             JSR     parse_var_decls
0008B4r 2  80 C8                BRA     @pib_again
0008B6r 2               @pib_proc:
0008B6r 2  20 rr rr             JSR     next_token
0008B9r 2  20 rr rr             JSR     parse_proc_iface_decl
0008BCr 2  80 C0                BRA     @pib_again
0008BEr 2               @pib_func:
0008BEr 2  20 rr rr             JSR     next_token
0008C1r 2  20 rr rr             JSR     parse_func_iface_decl
0008C4r 2  80 B8                BRA     @pib_again
0008C6r 2               
0008C6r 2               ; ---------------------------------------------------------------------------
0008C6r 2               ; import_unit_by_name — ident_buf names a UNIT source file to compile into the
0008C6r 2               ; current output. Repeated/nested imports are de-duplicated globally.
0008C6r 2               ; ---------------------------------------------------------------------------
0008C6r 2               import_unit_by_name:
0008C6r 2  A2 00                LDX     #0
0008C8r 2               @iun_scan:
0008C8r 2  EC rr rr             CPX     used_unit_count
0008CBr 2  B0 25                BCS     @iun_add
0008CDr 2  DA                   PHX
0008CEr 2  20 rr rr             JSR     used_unit_slot_ptr
0008D1r 2  A0 00                LDY     #0
0008D3r 2  B1 rr                LDA     (tmp2),y
0008D5r 2  CD rr rr             CMP     ident_buf
0008D8r 2  D0 12                BNE     @iun_next
0008DAr 2  85 rr                STA     scratch
0008DCr 2  A0 01                LDY     #1
0008DEr 2               @iun_cmp:
0008DEr 2  B1 rr                LDA     (tmp2),y
0008E0r 2  D9 rr rr             CMP     ident_buf,y
0008E3r 2  D0 07                BNE     @iun_next
0008E5r 2  C6 rr                DEC     scratch
0008E7r 2  F0 07                BEQ     @iun_found
0008E9r 2  C8                   INY
0008EAr 2  80 F2                BRA     @iun_cmp
0008ECr 2               @iun_next:
0008ECr 2  FA                   PLX
0008EDr 2  E8                   INX
0008EEr 2  80 D8                BRA     @iun_scan
0008F0r 2               @iun_found:
0008F0r 2  FA                   PLX
0008F1r 2  60                   RTS
0008F2r 2               @iun_add:
0008F2r 2  E0 08                CPX     #USED_UNIT_SLOTS
0008F4r 2  90 0C                BCC     :+
0008F6r 2  A9 rr                LDA     #<err_too_many
0008F8r 2  85 rr                STA     tmp0
0008FAr 2  A9 rr                LDA     #>err_too_many
0008FCr 2  85 rr                STA     tmp0+1
0008FEr 2  20 rr rr             JSR     compile_error
000901r 2  60                   RTS
000902r 2  DA           :       PHX
000903r 2  20 rr rr             JSR     used_unit_slot_ptr
000906r 2  A0 0F                LDY     #15
000908r 2               @iun_copy_name:
000908r 2  B9 rr rr             LDA     ident_buf,y
00090Br 2  91 rr                STA     (tmp2),y
00090Dr 2  88                   DEY
00090Er 2  10 F8                BPL     @iun_copy_name
000910r 2  FA                   PLX
000911r 2  EE rr rr             INC     used_unit_count
000914r 2  20 rr rr             JSR     source_push_current
000917r 2  90 0C                BCC     @iun_pushed
000919r 2  A9 rr                LDA     #<err_too_many
00091Br 2  85 rr                STA     tmp0
00091Dr 2  A9 rr                LDA     #>err_too_many
00091Fr 2  85 rr                STA     tmp0+1
000921r 2  20 rr rr             JSR     compile_error
000924r 2  60                   RTS
000925r 2               @iun_pushed:
000925r 2  20 rr rr             JSR     build_named_src_fcb
000928r 2  90 04                BCC     :+
00092Ar 2  20 rr rr             JSR     source_pop_current
00092Dr 2  60                   RTS
00092Er 2  A9 rr        :       LDA     #<comp_src_fcb
000930r 2  85 rr                STA     src_fcb
000932r 2  85 rr                STA     tmp1
000934r 2  A9 rr                LDA     #>comp_src_fcb
000936r 2  85 rr                STA     src_fcb+1
000938r 2  85 rr                STA     tmp1+1
00093Ar 2  20 rr rr             JSR     file_open
00093Dr 2  C9 FF                CMP     #$FF
00093Fr 2  D0 0F                BNE     @iun_open_ok
000941r 2  A9 rr                LDA     #<err_nofile
000943r 2  85 rr                STA     tmp0
000945r 2  A9 rr                LDA     #>err_nofile
000947r 2  85 rr                STA     tmp0+1
000949r 2  20 rr rr             JSR     compile_error
00094Cr 2  20 rr rr             JSR     source_pop_current
00094Fr 2  60                   RTS
000950r 2               @iun_open_ok:
000950r 2  EE rr rr             INC     unit_import_mode
000953r 2  20 rr rr             JSR     lexer_init
000956r 2  20 rr rr             JSR     next_token
000959r 2  20 rr rr             JSR     compile_unit
00095Cr 2  CE rr rr             DEC     unit_import_mode
00095Fr 2  A9 rr                LDA     #<comp_src_fcb
000961r 2  85 rr                STA     tmp1
000963r 2  A9 rr                LDA     #>comp_src_fcb
000965r 2  85 rr                STA     tmp1+1
000967r 2  20 rr rr             JSR     file_close
00096Ar 2  20 rr rr             JSR     source_pop_current
00096Dr 2  60                   RTS
00096Er 2               
00096Er 2               ; ---------------------------------------------------------------------------
00096Er 2               ; parse_uses_clause — top-level USES unit1, unit2, ... ;
00096Er 2               ; Collects the unit names from the current source first, then compiles each
00096Er 2               ; imported UNIT source while the current file context is suspended.
00096Er 2               ; ---------------------------------------------------------------------------
00096Er 2               parse_uses_clause:
00096Er 2  20 rr rr             JSR     next_token              ; consume USES
000971r 2  A9 00                LDA     #0
000973r 2  8D rr rr             STA     uses_name_count
000976r 2               @puc_collect:
000976r 2  A5 rr                LDA     tok_type
000978r 2  C9 01                CMP     #TOK_IDENT
00097Ar 2  D0 34                BNE     @puc_done_collect
00097Cr 2  AE rr rr             LDX     uses_name_count
00097Fr 2  E0 08                CPX     #USES_NAME_SLOTS
000981r 2  B0 14                BCS     @puc_skip_store
000983r 2  DA                   PHX
000984r 2  20 rr rr             JSR     uses_name_slot_ptr
000987r 2  A0 0F                LDY     #15
000989r 2               @puc_store:
000989r 2  B9 rr rr             LDA     ident_buf,y
00098Cr 2  91 rr                STA     (tmp2),y
00098Er 2  88                   DEY
00098Fr 2  10 F8                BPL     @puc_store
000991r 2  FA                   PLX
000992r 2  EE rr rr             INC     uses_name_count
000995r 2  80 0B                BRA     @puc_after_store
000997r 2               @puc_skip_store:
000997r 2  A9 rr                LDA     #<err_too_many
000999r 2  85 rr                STA     tmp0
00099Br 2  A9 rr                LDA     #>err_too_many
00099Dr 2  85 rr                STA     tmp0+1
00099Fr 2  20 rr rr             JSR     compile_error
0009A2r 2               @puc_after_store:
0009A2r 2  20 rr rr             JSR     next_token              ; consume unit name
0009A5r 2  A5 rr                LDA     tok_type
0009A7r 2  C9 1F                CMP     #TOK_COMMA
0009A9r 2  D0 05                BNE     @puc_done_collect
0009ABr 2  20 rr rr             JSR     next_token
0009AEr 2  80 C6                BRA     @puc_collect
0009B0r 2               @puc_done_collect:
0009B0r 2  A5 rr                LDA     tok_type
0009B2r 2  48                   PHA
0009B3r 2  A2 00                LDX     #0
0009B5r 2               @puc_import_loop:
0009B5r 2  EC rr rr             CPX     uses_name_count
0009B8r 2  B0 16                BCS     @puc_resume
0009BAr 2  DA                   PHX
0009BBr 2  20 rr rr             JSR     uses_name_slot_ptr
0009BEr 2  A0 0F                LDY     #15
0009C0r 2               @puc_restore_name:
0009C0r 2  B1 rr                LDA     (tmp2),y
0009C2r 2  99 rr rr             STA     ident_buf,y
0009C5r 2  88                   DEY
0009C6r 2  10 F8                BPL     @puc_restore_name
0009C8r 2  20 rr rr             JSR     import_unit_by_name
0009CBr 2  FA                   PLX
0009CCr 2  E8                   INX
0009CDr 2  4C rr rr             JMP     @puc_import_loop
0009D0r 2               @puc_resume:
0009D0r 2  68                   PLA
0009D1r 2  C9 20                CMP     #TOK_SEMICOLON
0009D3r 2  D0 04                BNE     @puc_no_semi
0009D5r 2  20 rr rr             JSR     next_token
0009D8r 2  60                   RTS
0009D9r 2               @puc_no_semi:
0009D9r 2  85 rr                STA     tok_type
0009DBr 2  60                   RTS
0009DCr 2               
0009DCr 2               ; ---------------------------------------------------------------------------
0009DCr 2               ; parse_block — { const_part } { type_part } { var_part } { proc_part } statement_part
0009DCr 2               ; ---------------------------------------------------------------------------
0009DCr 2               parse_block:
0009DCr 2               @again:
0009DCr 2  A5 rr                LDA     tok_type
0009DEr 2  C9 62                CMP     #TOK_USES
0009E0r 2  D0 09                BNE     @blk_chk_const
0009E2r 2  A5 rr                LDA     scope_depth
0009E4r 2  D0 05                BNE     @blk_chk_const
0009E6r 2  20 rr rr             JSR     parse_uses_clause
0009E9r 2  80 F1                BRA     @again
0009EBr 2               @blk_chk_const:
0009EBr 2  C9 44                CMP     #TOK_CONST
0009EDr 2  F0 15                BEQ     @const
0009EFr 2  C9 5A                CMP     #TOK_TYPE
0009F1r 2  F0 19                BEQ     @type
0009F3r 2  C9 5C                CMP     #TOK_VAR
0009F5r 2  F0 1D                BEQ     @var
0009F7r 2  C9 53                CMP     #TOK_PROCEDURE
0009F9r 2  F0 21                BEQ     @proc
0009FBr 2  C9 4B                CMP     #TOK_FUNCTION
0009FDr 2  F0 25                BEQ     @func
0009FFr 2  C9 42                CMP     #TOK_BEGIN
000A01r 2  F0 29                BEQ     @body
000A03r 2  60                   RTS                     ; nothing recognisable
000A04r 2               
000A04r 2               @const:
000A04r 2  20 rr rr             JSR     next_token
000A07r 2  20 rr rr             JSR     parse_const_decls
000A0Ar 2  80 D0                BRA     @again
000A0Cr 2               @type:
000A0Cr 2  20 rr rr             JSR     next_token
000A0Fr 2  20 rr rr             JSR     parse_type_decls
000A12r 2  80 C8                BRA     @again
000A14r 2               @var:
000A14r 2  20 rr rr             JSR     next_token
000A17r 2  20 rr rr             JSR     parse_var_decls
000A1Ar 2  80 C0                BRA     @again
000A1Cr 2               @proc:
000A1Cr 2  20 rr rr             JSR     next_token
000A1Fr 2  20 rr rr             JSR     parse_proc_decl
000A22r 2  80 B8                BRA     @again
000A24r 2               @func:
000A24r 2  20 rr rr             JSR     next_token
000A27r 2  20 rr rr             JSR     parse_func_decl
000A2Ar 2  80 B0                BRA     @again
000A2Cr 2               @body:  ; If at global scope, patch the startup chain to this body's start
000A2Cr 2                       ; before emitting any top-level init/main code.
000A2Cr 2  A5 rr                LDA     scope_depth
000A2Er 2  D0 03                BNE     @body_emit
000A30r 2  20 rr rr             JSR     patch_startup_chain_if_needed
000A33r 2               @body_emit:
000A33r 2  20 rr rr             JSR     parse_compound_stmt
000A36r 2  A5 rr                LDA     scope_depth
000A38r 2  D0 0B                BNE     @body_done
000A3Ar 2  20 rr rr             JSR     emit_UJP
000A3Dr 2  8D rr rr             STA     body_chain_patch
000A40r 2  A5 rr                LDA     scratch
000A42r 2  8D rr rr             STA     body_chain_patch+1
000A45r 2               @body_done:
000A45r 2  60                   RTS
000A46r 2               
000A46r 2               ; ---------------------------------------------------------------------------
000A46r 2               ; parse_const_decls — name = [-]INT_LIT ;  { name = [-]INT_LIT ; }
000A46r 2               ; Each constant goes into the symbol table as SYM_CONST with the literal
000A46r 2               ; value stored at offsets 18-19; references emit LDCW with that value.
000A46r 2               ; ---------------------------------------------------------------------------
000A46r 2               parse_const_decls:
000A46r 2               @loop:
000A46r 2  A5 rr                LDA     tok_type
000A48r 2  C9 01                CMP     #TOK_IDENT
000A4Ar 2  F0 01                BEQ     @have_ident
000A4Cr 2  60                   RTS                     ; done — no more constants
000A4Dr 2               @have_ident:
000A4Dr 2               ; save const name into save_name_buf
000A4Dr 2  A0 0F                LDY     #15
000A4Fr 2               @savename:
000A4Fr 2  B9 rr rr             LDA     ident_buf,y
000A52r 2  99 rr rr             STA     save_name_buf,y
000A55r 2  88                   DEY
000A56r 2  10 F7                BPL     @savename
000A58r 2  20 rr rr             JSR     next_token      ; consume name
000A5Br 2               ; expect '='
000A5Br 2  A5 rr                LDA     tok_type
000A5Dr 2  C9 14                CMP     #TOK_EQ
000A5Fr 2  D0 03                BNE     :+
000A61r 2  20 rr rr             JSR     next_token
000A64r 2               :       ; optional unary minus — record in scratch (next_token preserves it)
000A64r 2  A9 00                LDA     #0
000A66r 2  85 rr                STA     scratch
000A68r 2  A5 rr                LDA     tok_type
000A6Ar 2  C9 11                CMP     #TOK_MINUS
000A6Cr 2  D0 07                BNE     @no_minus
000A6Er 2  A9 FF                LDA     #$FF
000A70r 2  85 rr                STA     scratch
000A72r 2  20 rr rr             JSR     next_token
000A75r 2               @no_minus:
000A75r 2                       ; expect INT literal
000A75r 2  A5 rr                LDA     tok_type
000A77r 2  C9 02                CMP     #TOK_INT
000A79r 2  F0 08                BEQ     @have_int
000A7Br 2                       ; bad value — store 0 and try to recover
000A7Br 2  A9 00                LDA     #0
000A7Dr 2  85 rr                STA     tmp2
000A7Fr 2  85 rr                STA     tmp2+1
000A81r 2  80 0B                BRA     @add_const
000A83r 2               @have_int:
000A83r 2  A5 rr                LDA     tok_ival_lo
000A85r 2  85 rr                STA     tmp2
000A87r 2  A5 rr                LDA     tok_ival_hi
000A89r 2  85 rr                STA     tmp2+1
000A8Br 2  20 rr rr             JSR     next_token      ; consume INT
000A8Er 2               @add_const:
000A8Er 2               ; apply negate flag if set
000A8Er 2  A5 rr                LDA     scratch
000A90r 2  F0 0D                BEQ     @no_neg
000A92r 2  38                   SEC
000A93r 2  A9 00                LDA     #0
000A95r 2  E5 rr                SBC     tmp2
000A97r 2  85 rr                STA     tmp2
000A99r 2  A9 00                LDA     #0
000A9Br 2  E5 rr                SBC     tmp2+1
000A9Dr 2  85 rr                STA     tmp2+1
000A9Fr 2               @no_neg:
000A9Fr 2               ; install in symbol table — value lives at offsets 18-19
000A9Fr 2  20 rr rr             JSR     swap_ident_save
000AA2r 2  A9 02                LDA     #SYM_CONST
000AA4r 2  A2 01                LDX     #TY_INT
000AA6r 2  20 rr rr             JSR     symtab_add
000AA9r 2  20 rr rr             JSR     swap_ident_save
000AACr 2               ; expect ';'
000AACr 2  A5 rr                LDA     tok_type
000AAEr 2  C9 20                CMP     #TOK_SEMICOLON
000AB0r 2  D0 94                BNE     @loop
000AB2r 2  20 rr rr             JSR     next_token
000AB5r 2  80 8F                BRA     @loop
000AB7r 2               
000AB7r 2               ; ---------------------------------------------------------------------------
000AB7r 2               ; parse_type_decls — name = type_spec ;  { ... }
000AB7r 2               ; Each binding registers a SYM_TYPE entry whose offset-17 byte holds the
000AB7r 2               ; base TY_* code.  parse_type_spec resolves later references back to this
000AB7r 2               ; base type via symtab_find.
000AB7r 2               ; ---------------------------------------------------------------------------
000AB7r 2               parse_type_decls:
000AB7r 2               @loop:
000AB7r 2  A5 rr                LDA     tok_type
000AB9r 2  C9 01                CMP     #TOK_IDENT
000ABBr 2  F0 01                BEQ     :+
000ABDr 2  60                   RTS                     ; done — no more type decls
000ABEr 2               :       ; save type name into save_name_buf (parse_type_spec clobbers ident_buf)
000ABEr 2  A0 0F                LDY     #15
000AC0r 2               @savename:
000AC0r 2  B9 rr rr             LDA     ident_buf,y
000AC3r 2  99 rr rr             STA     save_name_buf,y
000AC6r 2  88                   DEY
000AC7r 2  10 F7                BPL     @savename
000AC9r 2  20 rr rr             JSR     next_token      ; consume name
000ACCr 2               ; expect '='
000ACCr 2  A5 rr                LDA     tok_type
000ACEr 2  C9 14                CMP     #TOK_EQ
000AD0r 2  D0 03                BNE     :+
000AD2r 2  20 rr rr             JSR     next_token
000AD5r 2               :       ; parse the type definition; A = TY_* code
000AD5r 2  20 rr rr             JSR     parse_type_spec
000AD8r 2  85 rr                STA     scratch         ; save base type code
000ADAr 2               ; bring the saved name back into ident_buf for symtab_add
000ADAr 2  20 rr rr             JSR     swap_ident_save
000ADDr 2               ; SYM_TYPE has no storage; offset bytes are unused (overwritten below
000ADDr 2               ; for record types, which need to remember size + field-table location).
000ADDr 2  A9 00                LDA     #0
000ADFr 2  85 rr                STA     tmp2
000AE1r 2  85 rr                STA     tmp2+1
000AE3r 2  A9 05                LDA     #SYM_TYPE
000AE5r 2  A6 rr                LDX     scratch
000AE7r 2  20 rr rr             JSR     symtab_add
000AEAr 2               ; If this is a RECORD alias, stash record_size in bytes 18-19 and
000AEAr 2               ; first_field/field_count in bytes 22-23 so later var-decls and field
000AEAr 2               ; lookups can recover it.
000AEAr 2  A5 rr                LDA     scratch
000AECr 2  C9 06                CMP     #TY_RECORD
000AEEr 2  D0 1C                BNE     @td_no_rec
000AF0r 2  AD rr rr             LDA     record_size
000AF3r 2  A0 12                LDY     #18
000AF5r 2  91 rr                STA     (tmp3),y
000AF7r 2  AD rr rr             LDA     record_size+1
000AFAr 2  A0 13                LDY     #19
000AFCr 2  91 rr                STA     (tmp3),y
000AFEr 2  AD rr rr             LDA     record_first_field
000B01r 2  A0 16                LDY     #22
000B03r 2  91 rr                STA     (tmp3),y
000B05r 2  AD rr rr             LDA     record_field_count
000B08r 2  A0 17                LDY     #23
000B0Ar 2  91 rr                STA     (tmp3),y
000B0Cr 2               @td_no_rec:
000B0Cr 2               ; expect ';'
000B0Cr 2  A5 rr                LDA     tok_type
000B0Er 2  C9 20                CMP     #TOK_SEMICOLON
000B10r 2  D0 A5                BNE     @loop
000B12r 2  20 rr rr             JSR     next_token
000B15r 2  80 A0                BRA     @loop
000B17r 2               
000B17r 2               ; ---------------------------------------------------------------------------
000B17r 2               ; parse_var_decls — name { , name } : type ;  { ... }
000B17r 2               ; All names on one line share the same type, allocated in order.
000B17r 2               ; ---------------------------------------------------------------------------
000B17r 2               parse_var_decls:
000B17r 2               @decl_loop:
000B17r 2  A5 rr                LDA     tok_type
000B19r 2  C9 01                CMP     #TOK_IDENT
000B1Br 2  F0 01                BEQ     :+
000B1Dr 2  60                   RTS                     ; done — no more var decls
000B1Er 2               :       ; --- collect comma-separated names into var_name_buf ---
000B1Er 2  A9 00                LDA     #0
000B20r 2  8D rr rr             STA     var_name_count
000B23r 2               @collect:
000B23r 2  A5 rr                LDA     tok_type
000B25r 2  C9 01                CMP     #TOK_IDENT
000B27r 2  D0 31                BNE     @end_collect
000B29r 2  AD rr rr             LDA     var_name_count
000B2Cr 2  C9 08                CMP     #8
000B2Er 2  B0 1C                BCS     @skip_save
000B30r 2                       ; tmp2 = var_name_buf + count*16   (count<8 → fits without manual carry)
000B30r 2  0A                   ASL
000B31r 2  0A                   ASL
000B32r 2  0A                   ASL
000B33r 2  0A                   ASL                     ; *16
000B34r 2  18                   CLC
000B35r 2  69 rr                ADC     #<var_name_buf
000B37r 2  85 rr                STA     tmp2
000B39r 2  A9 00                LDA     #0
000B3Br 2  69 rr                ADC     #>var_name_buf
000B3Dr 2  85 rr                STA     tmp2+1
000B3Fr 2  A0 0F                LDY     #15
000B41r 2               @cp_in:
000B41r 2  B9 rr rr             LDA     ident_buf,y
000B44r 2  91 rr                STA     (tmp2),y
000B46r 2  88                   DEY
000B47r 2  10 F8                BPL     @cp_in
000B49r 2  EE rr rr             INC     var_name_count
000B4Cr 2               @skip_save:
000B4Cr 2  20 rr rr             JSR     next_token      ; consume name
000B4Fr 2  A5 rr                LDA     tok_type
000B51r 2  C9 1F                CMP     #TOK_COMMA
000B53r 2  D0 05                BNE     @end_collect
000B55r 2  20 rr rr             JSR     next_token      ; consume ','
000B58r 2  80 C9                BRA     @collect
000B5Ar 2               @end_collect:
000B5Ar 2               ; expect ':'
000B5Ar 2  A5 rr                LDA     tok_type
000B5Cr 2  C9 21                CMP     #TOK_COLON
000B5Er 2  D0 03                BNE     :+
000B60r 2  20 rr rr             JSR     next_token
000B63r 2               :       ; parse type — A = TY_*
000B63r 2  20 rr rr             JSR     parse_type_spec
000B66r 2  85 rr                STA     scratch         ; stash type
000B68r 2               ; --- add each collected name to symbol table ---
000B68r 2               ; NOTE: consume ';' AFTER the add loop so next_token doesn't clobber
000B68r 2               ; ident_buf before @cp_out restores the saved name.
000B68r 2  A2 00                LDX     #0
000B6Ar 2               @add_loop:
000B6Ar 2  EC rr rr             CPX     var_name_count
000B6Dr 2  90 03                BCC     :+
000B6Fr 2  4C rr rr             JMP     @post_add       ; out-of-range branch — use jmp
000B72r 2               :
000B72r 2  DA                   PHX                     ; preserve loop counter across symtab_add
000B73r 2               ; tmp2 = var_name_buf + X*16
000B73r 2  8A                   TXA
000B74r 2  0A                   ASL
000B75r 2  0A                   ASL
000B76r 2  0A                   ASL
000B77r 2  0A                   ASL
000B78r 2  18                   CLC
000B79r 2  69 rr                ADC     #<var_name_buf
000B7Br 2  85 rr                STA     tmp2
000B7Dr 2  A9 00                LDA     #0
000B7Fr 2  69 rr                ADC     #>var_name_buf
000B81r 2  85 rr                STA     tmp2+1
000B83r 2               ; copy slot → ident_buf so symtab_add sees the right name
000B83r 2  A0 0F                LDY     #15
000B85r 2               @cp_out:
000B85r 2  B1 rr                LDA     (tmp2),Y
000B87r 2  99 rr rr             STA     ident_buf,y
000B8Ar 2  88                   DEY
000B8Br 2  10 F8                BPL     @cp_out
000B8Dr 2               ; allocate storage — global if at top level, else from proc local AR
000B8Dr 2  A5 rr                LDA     scope_depth
000B8Fr 2  F0 2D                BEQ     @gv_alloc
000B91r 2               ; local: tmp2 = local_alloc_off; bump by per-type size
000B91r 2  AD rr rr             LDA     local_alloc_off
000B94r 2  85 rr                STA     tmp2
000B96r 2  A9 00                LDA     #0
000B98r 2  85 rr                STA     tmp2+1
000B9Ar 2  A5 rr                LDA     scratch                 ; type code
000B9Cr 2  C9 06                CMP     #TY_RECORD
000B9Er 2  F0 0B                BEQ     @lv_rec
000BA0r 2               ; default scalar / pointer / etc — 2 bytes
000BA0r 2  18                   CLC
000BA1r 2  AD rr rr             LDA     local_alloc_off
000BA4r 2  69 02                ADC     #2
000BA6r 2  8D rr rr             STA     local_alloc_off
000BA9r 2  80 33                BRA     @do_va_add
000BABr 2               @lv_rec:
000BABr 2  18                   CLC
000BACr 2  AD rr rr             LDA     local_alloc_off
000BAFr 2  6D rr rr             ADC     record_size
000BB2r 2  8D rr rr             STA     local_alloc_off
000BB5r 2                       ; record_size+1 is normally 0 (records < 256 bytes) but
000BB5r 2                       ; propagate the carry to be safe.
000BB5r 2  A9 00                LDA     #0
000BB7r 2  6D rr rr             ADC     record_size+1
000BBAr 2  F0 22                BEQ     @do_va_add              ; no high-byte growth
000BBCr 2                       ; would overflow byte counter; not handled — abort cleanly
000BBCr 2  80 20                BRA     @do_va_add
000BBEr 2               @gv_alloc:
000BBEr 2  A5 rr                LDA     scratch
000BC0r 2  C9 05                CMP     #TY_ARRAY
000BC2r 2  F0 0D                BEQ     @gv_array
000BC4r 2  C9 06                CMP     #TY_RECORD
000BC6r 2  F0 0E                BEQ     @gv_record
000BC8r 2  C9 08                CMP     #TY_TEXT
000BCAr 2  F0 0F                BEQ     @gv_text
000BCCr 2  20 rr rr             JSR     codegen_alloc_global    ; scalar: 2 bytes, offset in tmp2
000BCFr 2  80 0D                BRA     @do_va_add
000BD1r 2               @gv_array:
000BD1r 2  20 rr rr             JSR     codegen_alloc_array_global  ; array: right size, adj offset in tmp2
000BD4r 2  80 08                BRA     @do_va_add
000BD6r 2               @gv_record:
000BD6r 2  20 rr rr             JSR     codegen_alloc_record_global ; record: record_size bytes, offset in tmp2
000BD9r 2  80 03                BRA     @do_va_add
000BDBr 2               @gv_text:
000BDBr 2  20 rr rr             JSR     codegen_alloc_text_global   ; TEXT file: 168 bytes, offset in tmp2
000BDEr 2               @do_va_add:
000BDEr 2  A5 rr                LDA     scratch         ; type code
000BE0r 2  AA                   TAX
000BE1r 2  A9 01                LDA     #SYM_VAR
000BE3r 2  20 rr rr             JSR     symtab_add      ; tmp3 = pointer to new entry
000BE6r 2               ; type-specific metadata in entry bytes 22-23
000BE6r 2  A5 rr                LDA     scratch
000BE8r 2  C9 05                CMP     #TY_ARRAY
000BEAr 2  D0 0F                BNE     @va_chk_rec
000BECr 2  AD rr rr             LDA     array_elem_ty
000BEFr 2  A0 16                LDY     #22
000BF1r 2  91 rr                STA     (tmp3),y
000BF3r 2  A9 02                LDA     #2              ; elemsize = 2 (word)
000BF5r 2  A0 17                LDY     #23
000BF7r 2  91 rr                STA     (tmp3),y
000BF9r 2  80 12                BRA     @va_done
000BFBr 2               @va_chk_rec:
000BFBr 2  C9 06                CMP     #TY_RECORD
000BFDr 2  D0 0E                BNE     @va_done
000BFFr 2  AD rr rr             LDA     record_first_field
000C02r 2  A0 16                LDY     #22
000C04r 2  91 rr                STA     (tmp3),y
000C06r 2  AD rr rr             LDA     record_field_count
000C09r 2  A0 17                LDY     #23
000C0Br 2  91 rr                STA     (tmp3),y
000C0Dr 2               @va_done:
000C0Dr 2  FA                   PLX
000C0Er 2  E8                   INX
000C0Fr 2  4C rr rr             JMP     @add_loop       ; jmp — body grew past bra range
000C12r 2               @post_add:
000C12r 2               ; now safe to consume ';' — ident_buf already used
000C12r 2  A5 rr                LDA     tok_type
000C14r 2  C9 20                CMP     #TOK_SEMICOLON
000C16r 2  D0 03                BNE     @pva_next
000C18r 2  20 rr rr             JSR     next_token
000C1Br 2               @pva_next:
000C1Br 2  4C rr rr             JMP     @decl_loop
000C1Er 2               
000C1Er 2               ; swap 16 bytes between ident_buf and save_name_buf
000C1Er 2               swap_ident_save:
000C1Er 2  A0 0F                LDY     #15
000C20r 2               @sw:
000C20r 2  B9 rr rr             LDA     ident_buf,y
000C23r 2  BE rr rr             LDX     save_name_buf,y
000C26r 2  99 rr rr             STA     save_name_buf,y
000C29r 2  8A                   TXA
000C2Ar 2  99 rr rr             STA     ident_buf,y
000C2Dr 2  88                   DEY
000C2Er 2  10 F0                BPL     @sw
000C30r 2  60                   RTS
000C31r 2               
000C31r 2               ; field_name_slot_ptr â€” tmp2 = pointer to the current RECORD depth's
000C31r 2               ; field-name slot. A = slot index (0..7).
000C31r 2               field_name_slot_ptr:
000C31r 2  0A                   ASL
000C32r 2  0A                   ASL
000C33r 2  0A                   ASL
000C34r 2  0A                   ASL                             ; slot * 16
000C35r 2  85 rr                STA     tmp2
000C37r 2  A9 00                LDA     #0
000C39r 2  85 rr                STA     tmp2+1
000C3Br 2  AE rr rr             LDX     field_depth
000C3Er 2  CA                   DEX                             ; 1-based depth -> 0-based slice index
000C3Fr 2               @fnsp_depth:
000C3Fr 2  E0 00                CPX     #0
000C41r 2  F0 0E                BEQ     @fnsp_base
000C43r 2  18                   CLC
000C44r 2  A5 rr                LDA     tmp2
000C46r 2  69 80                ADC     #$80
000C48r 2  85 rr                STA     tmp2
000C4Ar 2  90 02                BCC     :+
000C4Cr 2  E6 rr                INC     tmp2+1
000C4Er 2  CA           :       DEX
000C4Fr 2  80 EE                BRA     @fnsp_depth
000C51r 2               @fnsp_base:
000C51r 2  18                   CLC
000C52r 2  A5 rr                LDA     tmp2
000C54r 2  69 rr                ADC     #<field_name_buf
000C56r 2  85 rr                STA     tmp2
000C58r 2  A5 rr                LDA     tmp2+1
000C5Ar 2  69 rr                ADC     #>field_name_buf
000C5Cr 2  85 rr                STA     tmp2+1
000C5Er 2  60                   RTS
000C5Fr 2               
000C5Fr 2               ; uses_name_slot_ptr — tmp2 = pointer to USES-name slot X (0..7)
000C5Fr 2               uses_name_slot_ptr:
000C5Fr 2  8A                   TXA
000C60r 2  0A                   ASL
000C61r 2  0A                   ASL
000C62r 2  0A                   ASL
000C63r 2  0A                   ASL
000C64r 2  18                   CLC
000C65r 2  69 rr                ADC     #<uses_name_buf
000C67r 2  85 rr                STA     tmp2
000C69r 2  A9 00                LDA     #0
000C6Br 2  69 rr                ADC     #>uses_name_buf
000C6Dr 2  85 rr                STA     tmp2+1
000C6Fr 2  60                   RTS
000C70r 2               
000C70r 2               ; used_unit_slot_ptr — tmp2 = pointer to imported-unit slot X (0..7)
000C70r 2               used_unit_slot_ptr:
000C70r 2  8A                   TXA
000C71r 2  0A                   ASL
000C72r 2  0A                   ASL
000C73r 2  0A                   ASL
000C74r 2  0A                   ASL
000C75r 2  18                   CLC
000C76r 2  69 rr                ADC     #<used_unit_buf
000C78r 2  85 rr                STA     tmp2
000C7Ar 2  A9 00                LDA     #0
000C7Cr 2  69 rr                ADC     #>used_unit_buf
000C7Er 2  85 rr                STA     tmp2+1
000C80r 2  60                   RTS
000C81r 2               
000C81r 2               ; ---------------------------------------------------------------------------
000C81r 2               ; parse_type_spec — consume type token(s), return TY_* code in A
000C81r 2               ; ---------------------------------------------------------------------------
000C81r 2               parse_type_spec:
000C81r 2  A5 rr                LDA     tok_type
000C83r 2  C9 01                CMP     #TOK_IDENT
000C85r 2  F0 03                BEQ     :+
000C87r 2  4C rr rr             JMP     @not_ident
000C8Ar 2               :
000C8Ar 2               ; First check for a user-defined SYM_TYPE alias — built-ins like
000C8Ar 2               ; INTEGER/CHAR/BOOLEAN aren't in the symtab so this lookup falls
000C8Ar 2               ; through harmlessly when there's no user binding.
000C8Ar 2  20 rr rr             JSR     symtab_find
000C8Dr 2  90 34                BCC     @builtin
000C8Fr 2  A0 10                LDY     #16
000C91r 2  B1 rr                LDA     (tmp3),y
000C93r 2  C9 05                CMP     #SYM_TYPE
000C95r 2  D0 2C                BNE     @builtin
000C97r 2  A0 11                LDY     #17
000C99r 2  B1 rr                LDA     (tmp3),y
000C9Br 2  85 rr                STA     scratch         ; preserve across next_token
000C9Dr 2               ; If alias resolves to a RECORD, copy the record metadata back into the
000C9Dr 2               ; record_* globals so the caller (parse_var_decls) sees it.
000C9Dr 2  C9 06                CMP     #TY_RECORD
000C9Fr 2  D0 1C                BNE     @sty_no_rec
000CA1r 2  A0 12                LDY     #18
000CA3r 2  B1 rr                LDA     (tmp3),y
000CA5r 2  8D rr rr             STA     record_size
000CA8r 2  A0 13                LDY     #19
000CAAr 2  B1 rr                LDA     (tmp3),y
000CACr 2  8D rr rr             STA     record_size+1
000CAFr 2  A0 16                LDY     #22
000CB1r 2  B1 rr                LDA     (tmp3),y
000CB3r 2  8D rr rr             STA     record_first_field
000CB6r 2  A0 17                LDY     #23
000CB8r 2  B1 rr                LDA     (tmp3),y
000CBAr 2  8D rr rr             STA     record_field_count
000CBDr 2               @sty_no_rec:
000CBDr 2  20 rr rr             JSR     next_token
000CC0r 2  A5 rr                LDA     scratch
000CC2r 2  60                   RTS
000CC3r 2               @builtin:
000CC3r 2               ; check for built-in type names
000CC3r 2  AD rr rr             LDA     ident_buf       ; length
000CC6r 2  C9 07                CMP     #7
000CC8r 2  D0 20                BNE     @chk3
000CCAr 2               ; "INTEGER" (7 chars)
000CCAr 2  AD rr rr             LDA     ident_buf+1
000CCDr 2  C9 49                CMP     #'I'
000CCFr 2  D0 06                BNE     @chk_bool
000CD1r 2  20 rr rr             JSR     next_token
000CD4r 2  A9 01                LDA     #TY_INT
000CD6r 2  60                   RTS
000CD7r 2               @chk_bool:
000CD7r 2  AD rr rr             LDA     ident_buf+1
000CDAr 2  C9 42                CMP     #'B'
000CDCr 2  D0 06                BNE     @chk_str
000CDEr 2  20 rr rr             JSR     next_token
000CE1r 2  A9 03                LDA     #TY_BOOL
000CE3r 2  60                   RTS
000CE4r 2               @chk_str:
000CE4r 2  20 rr rr             JSR     next_token
000CE7r 2  A9 01                LDA     #TY_INT         ; default
000CE9r 2  60                   RTS
000CEAr 2               @chk3:
000CEAr 2  C9 04                CMP     #4
000CECr 2  D0 1D                BNE     @chk6
000CEEr 2               ; 4-char built-in types: "CHAR" or "TEXT"
000CEEr 2  AD rr rr             LDA     ident_buf+1
000CF1r 2  C9 43                CMP     #'C'
000CF3r 2  D0 06                BNE     @chk_text
000CF5r 2  20 rr rr             JSR     next_token
000CF8r 2  A9 02                LDA     #TY_CHAR
000CFAr 2  60                   RTS
000CFBr 2               @chk_text:
000CFBr 2  C9 54                CMP     #'T'
000CFDr 2  D0 06                BNE     @chk3b
000CFFr 2  20 rr rr             JSR     next_token
000D02r 2  A9 08                LDA     #TY_TEXT
000D04r 2  60                   RTS
000D05r 2               @chk3b:
000D05r 2  20 rr rr             JSR     next_token
000D08r 2  A9 01                LDA     #TY_INT
000D0Ar 2  60                   RTS
000D0Br 2               @chk6:
000D0Br 2  C9 06                CMP     #6
000D0Dr 2  D0 06                BNE     @default_type
000D0Fr 2               ; "STRING" (6)
000D0Fr 2  20 rr rr             JSR     next_token
000D12r 2  A9 04                LDA     #TY_STRING
000D14r 2  60                   RTS
000D15r 2               @default_type:
000D15r 2  20 rr rr             JSR     next_token
000D18r 2  A9 01                LDA     #TY_INT
000D1Ar 2  60                   RTS
000D1Br 2               @not_ident:
000D1Br 2  A5 rr                LDA     tok_type
000D1Dr 2  C9 41                CMP     #TOK_ARRAY
000D1Fr 2  D0 56                BNE     @not_array
000D21r 2               ; --- ARRAY [lo..hi] OF basetype ---
000D21r 2  20 rr rr             JSR     next_token      ; consume ARRAY → expect '['
000D24r 2  A5 rr                LDA     tok_type
000D26r 2  C9 1D                CMP     #TOK_LBRACK
000D28r 2  D0 03                BNE     :+
000D2Ar 2  20 rr rr             JSR     next_token      ; consume '['
000D2Dr 2               :
000D2Dr 2               ; parse lo bound (integer literal)
000D2Dr 2  A5 rr                LDA     tok_ival_lo
000D2Fr 2  8D rr rr             STA     array_lo
000D32r 2  A5 rr                LDA     tok_ival_hi
000D34r 2  8D rr rr             STA     array_lo+1
000D37r 2  A5 rr                LDA     tok_type
000D39r 2  C9 02                CMP     #TOK_INT
000D3Br 2  D0 03                BNE     :+
000D3Dr 2  20 rr rr             JSR     next_token      ; consume lo
000D40r 2               :
000D40r 2               ; expect '..'
000D40r 2  A5 rr                LDA     tok_type
000D42r 2  C9 23                CMP     #TOK_DOTDOT
000D44r 2  D0 03                BNE     :+
000D46r 2  20 rr rr             JSR     next_token      ; consume '..'
000D49r 2               :
000D49r 2               ; parse hi bound
000D49r 2  A5 rr                LDA     tok_ival_lo
000D4Br 2  8D rr rr             STA     array_hi
000D4Er 2  A5 rr                LDA     tok_ival_hi
000D50r 2  8D rr rr             STA     array_hi+1
000D53r 2  A5 rr                LDA     tok_type
000D55r 2  C9 02                CMP     #TOK_INT
000D57r 2  D0 03                BNE     :+
000D59r 2  20 rr rr             JSR     next_token      ; consume hi
000D5Cr 2               :
000D5Cr 2               ; expect ']'
000D5Cr 2  A5 rr                LDA     tok_type
000D5Er 2  C9 1E                CMP     #TOK_RBRACK
000D60r 2  D0 03                BNE     :+
000D62r 2  20 rr rr             JSR     next_token      ; consume ']'
000D65r 2               :
000D65r 2               ; expect 'OF'
000D65r 2  A5 rr                LDA     tok_type
000D67r 2  C9 51                CMP     #TOK_OF
000D69r 2  D0 03                BNE     :+
000D6Br 2  20 rr rr             JSR     next_token      ; consume 'OF'
000D6Er 2               :
000D6Er 2               ; parse element type (recursive — handles named types, built-ins)
000D6Er 2  20 rr rr             JSR     parse_type_spec
000D71r 2  8D rr rr             STA     array_elem_ty
000D74r 2  A9 05                LDA     #TY_ARRAY
000D76r 2  60                   RTS
000D77r 2               @not_array:
000D77r 2  A5 rr                LDA     tok_type
000D79r 2  C9 57                CMP     #TOK_SET
000D7Br 2  F0 03                BEQ     :+
000D7Dr 2  4C rr rr             JMP     @not_set
000D80r 2               :
000D80r 2               ; --- SET OF lo..hi ---
000D80r 2               ; v1 stores sets as 16-bit masks over element values 0..15, so the
000D80r 2               ; declared bounds must fit within that range. The bounds are validated
000D80r 2               ; here but not otherwise retained for later type-checking.
000D80r 2  20 rr rr             JSR     next_token              ; consume SET
000D83r 2  A5 rr                LDA     tok_type
000D85r 2  C9 51                CMP     #TOK_OF
000D87r 2  D0 03                BNE     :+
000D89r 2  20 rr rr             JSR     next_token              ; consume OF
000D8Cr 2               :
000D8Cr 2  A5 rr                LDA     tok_type
000D8Er 2  C9 02                CMP     #TOK_INT
000D90r 2  D0 37                BNE     @set_bad
000D92r 2  A5 rr                LDA     tok_ival_hi
000D94r 2  D0 33                BNE     @set_bad
000D96r 2  A5 rr                LDA     tok_ival_lo
000D98r 2  8D rr rr             STA     set_lit_lo
000D9Br 2  C9 10                CMP     #16
000D9Dr 2  B0 2A                BCS     @set_bad
000D9Fr 2  20 rr rr             JSR     next_token
000DA2r 2  A5 rr                LDA     tok_type
000DA4r 2  C9 23                CMP     #TOK_DOTDOT
000DA6r 2  D0 21                BNE     @set_bad
000DA8r 2  20 rr rr             JSR     next_token
000DABr 2  A5 rr                LDA     tok_type
000DADr 2  C9 02                CMP     #TOK_INT
000DAFr 2  D0 18                BNE     @set_bad
000DB1r 2  A5 rr                LDA     tok_ival_hi
000DB3r 2  D0 14                BNE     @set_bad
000DB5r 2  A5 rr                LDA     tok_ival_lo
000DB7r 2  8D rr rr             STA     set_lit_hi
000DBAr 2  C9 10                CMP     #16
000DBCr 2  B0 0B                BCS     @set_bad
000DBEr 2  CD rr rr             CMP     set_lit_lo
000DC1r 2  90 06                BCC     @set_bad
000DC3r 2  20 rr rr             JSR     next_token
000DC6r 2  A9 09                LDA     #TY_SET
000DC8r 2  60                   RTS
000DC9r 2               @set_bad:
000DC9r 2  A9 rr                LDA     #<err_type
000DCBr 2  85 rr                STA     tmp0
000DCDr 2  A9 rr                LDA     #>err_type
000DCFr 2  85 rr                STA     tmp0+1
000DD1r 2  20 rr rr             JSR     compile_error
000DD4r 2  A5 rr                LDA     tok_type
000DD6r 2  C9 02                CMP     #TOK_INT
000DD8r 2  D0 03                BNE     :+
000DDAr 2  20 rr rr             JSR     next_token
000DDDr 2  A9 09        :       LDA     #TY_SET
000DDFr 2  60                   RTS
000DE0r 2               @not_set:
000DE0r 2  A5 rr                LDA     tok_type
000DE2r 2  C9 55                CMP     #TOK_RECORD
000DE4r 2  F0 03                BEQ     :+
000DE6r 2  4C rr rr             JMP     @not_record
000DE9r 2               :
000DE9r 2               ; --- RECORD field { ; field } END ---
000DE9r 2               ; Each field group: name { , name } : type
000DE9r 2               ; All fields are stored as 2-byte slots; offsets are 0, 2, 4, ...
000DE9r 2  20 rr rr             JSR     next_token              ; consume RECORD
000DECr 2  EE rr rr             INC     field_depth             ; mark new fields as belonging
000DEFr 2                                                       ; to this nesting level
000DEFr 2  A9 00                LDA     #0
000DF1r 2  8D rr rr             STA     record_size
000DF4r 2  8D rr rr             STA     record_size+1
000DF7r 2  8D rr rr             STA     record_field_count
000DFAr 2  AD rr rr             LDA     field_table_count
000DFDr 2  8D rr rr             STA     record_first_field
000E00r 2               @rec_loop:
000E00r 2  A5 rr                LDA     tok_type
000E02r 2  C9 49                CMP     #TOK_END
000E04r 2  D0 03                BNE     :+
000E06r 2  4C rr rr             JMP     @rec_end
000E09r 2               :
000E09r 2  C9 01                CMP     #TOK_IDENT
000E0Br 2  F0 03                BEQ     :+
000E0Dr 2  4C rr rr             JMP     @rec_end                ; safety — bail on unexpected token
000E10r 2               :
000E10r 2               ; --- collect comma-separated field names into field_name_buf ---
000E10r 2               ;     (separate from var_name_buf so an inline RECORD inside a VAR
000E10r 2               ;      decl doesn't clobber the outer variable names being collected)
000E10r 2  AE rr rr             LDX     field_depth
000E13r 2  CA                   DEX
000E14r 2  A9 00                LDA     #0
000E16r 2  9D rr rr             STA     field_name_count,x
000E19r 2               @rec_collect:
000E19r 2  A5 rr                LDA     tok_type
000E1Br 2  C9 01                CMP     #TOK_IDENT
000E1Dr 2  D0 2D                BNE     @rec_endcol
000E1Fr 2  AE rr rr             LDX     field_depth
000E22r 2  CA                   DEX
000E23r 2  BD rr rr             LDA     field_name_count,x
000E26r 2  C9 08                CMP     #8
000E28r 2  B0 14                BCS     @rec_skip_save
000E2Ar 2  20 rr rr             JSR     field_name_slot_ptr
000E2Dr 2  A0 0F                LDY     #15
000E2Fr 2               @rec_cpin:
000E2Fr 2  B9 rr rr             LDA     ident_buf,y
000E32r 2  91 rr                STA     (tmp2),y
000E34r 2  88                   DEY
000E35r 2  10 F8                BPL     @rec_cpin
000E37r 2  AE rr rr             LDX     field_depth
000E3Ar 2  CA                   DEX
000E3Br 2  FE rr rr             INC     field_name_count,x
000E3Er 2               @rec_skip_save:
000E3Er 2  20 rr rr             JSR     next_token              ; consume name
000E41r 2  A5 rr                LDA     tok_type
000E43r 2  C9 1F                CMP     #TOK_COMMA
000E45r 2  D0 05                BNE     @rec_endcol
000E47r 2  20 rr rr             JSR     next_token              ; consume ','
000E4Ar 2  80 CD                BRA     @rec_collect
000E4Cr 2               @rec_endcol:
000E4Cr 2               ; expect ':'
000E4Cr 2  A5 rr                LDA     tok_type
000E4Er 2  C9 21                CMP     #TOK_COLON
000E50r 2  D0 03                BNE     :+
000E52r 2  20 rr rr             JSR     next_token
000E55r 2               :       ; parse field type — recurse; result in A.  Save outer record
000E55r 2               ; bookkeeping (size + first_field + field_count) so a nested RECORD
000E55r 2               ; can use the same globals without losing our state.  After the inner
000E55r 2               ; parse, capture the inner's metadata into nest_save_* and restore.
000E55r 2  AD rr rr             LDA     record_size
000E58r 2  48                   PHA
000E59r 2  AD rr rr             LDA     record_size+1
000E5Cr 2  48                   PHA
000E5Dr 2  AD rr rr             LDA     record_first_field
000E60r 2  48                   PHA
000E61r 2  AD rr rr             LDA     record_field_count
000E64r 2  48                   PHA
000E65r 2  20 rr rr             JSR     parse_type_spec         ; may recurse into RECORD
000E68r 2  85 rr                STA     scratch                 ; field type code
000E6Ar 2               ; capture inner's metadata for @rec_addf (only meaningful for TY_RECORD)
000E6Ar 2  AD rr rr             LDA     record_size
000E6Dr 2  8D rr rr             STA     nest_save_size
000E70r 2  AD rr rr             LDA     record_size+1
000E73r 2  8D rr rr             STA     nest_save_size+1
000E76r 2  AD rr rr             LDA     record_first_field
000E79r 2  8D rr rr             STA     nest_save_first
000E7Cr 2  AD rr rr             LDA     record_field_count
000E7Fr 2  8D rr rr             STA     nest_save_count
000E82r 2               ; restore outer record bookkeeping
000E82r 2  68                   PLA
000E83r 2  8D rr rr             STA     record_field_count
000E86r 2  68                   PLA
000E87r 2  8D rr rr             STA     record_first_field
000E8Ar 2  68                   PLA
000E8Br 2  8D rr rr             STA     record_size+1
000E8Er 2  68                   PLA
000E8Fr 2  8D rr rr             STA     record_size
000E92r 2               ; --- add each collected name to field_table at current record_size ---
000E92r 2  A2 00                LDX     #0
000E94r 2               @rec_addf:
000E94r 2  8A                   TXA
000E95r 2  AC rr rr             LDY     field_depth
000E98r 2  88                   DEY
000E99r 2  D9 rr rr             CMP     field_name_count,y
000E9Cr 2  B0 68                BCS     @rec_endf
000E9Er 2  DA                   PHX
000E9Fr 2  8A                   TXA
000EA0r 2  20 rr rr             JSR     field_name_slot_ptr
000EA3r 2  A0 0F                LDY     #15
000EA5r 2               @rec_cpout:
000EA5r 2  B1 rr                LDA     (tmp2),y
000EA7r 2  99 rr rr             STA     ident_buf,y
000EAAr 2  88                   DEY
000EABr 2  10 F8                BPL     @rec_cpout
000EADr 2               ; If the previous field group's type was an inline RECORD, its fields
000EADr 2               ; got appended to field_table BEFORE this outer field. Bump
000EADr 2               ; record_first_field past those leading slots so the lookup-scan starts
000EADr 2               ; at the first outer-depth field instead of an inner one. Only applies
000EADr 2               ; when no outer fields have been recorded yet.
000EADr 2  AD rr rr             LDA     record_field_count
000EB0r 2  D0 06                BNE     :+
000EB2r 2  AD rr rr             LDA     field_table_count
000EB5r 2  8D rr rr             STA     record_first_field
000EB8r 2               :
000EB8r 2               ; field_table_add: A=offset (record_size lo), X=type
000EB8r 2               ;   Returns: A = newly-assigned field index
000EB8r 2  AD rr rr             LDA     record_size
000EBBr 2  A6 rr                LDX     scratch
000EBDr 2  20 rr rr             JSR     field_table_add
000EC0r 2               ; If this field's type is TY_RECORD, fold the inner record's
000EC0r 2               ; first_field/count (saved in nest_save_*) into the parallel
000EC0r 2               ; nested arrays so chained access can traverse it.
000EC0r 2  48                   PHA                             ; save field index
000EC1r 2  A6 rr                LDX     scratch                 ; field type
000EC3r 2  E0 06                CPX     #TY_RECORD
000EC5r 2  D0 0D                BNE     @rec_no_nest
000EC7r 2  AA                   TAX                             ; X = field index (A still holds it)
000EC8r 2  AD rr rr             LDA     nest_save_first
000ECBr 2  9D rr rr             STA     field_nested_first,x
000ECEr 2  AD rr rr             LDA     nest_save_count
000ED1r 2  9D rr rr             STA     field_nested_count,x
000ED4r 2               @rec_no_nest:
000ED4r 2  68                   PLA                             ; restore (no longer needed)
000ED5r 2  EE rr rr             INC     record_field_count
000ED8r 2               ; advance record_size by this field's size:
000ED8r 2               ;   record fields → nest_save_size (set by inner parse)
000ED8r 2               ;   anything else → 2 (all scalars are word-sized)
000ED8r 2  A6 rr                LDX     scratch
000EDAr 2  E0 06                CPX     #TY_RECORD
000EDCr 2  F0 10                BEQ     @rec_adv_rec
000EDEr 2  18                   CLC
000EDFr 2  AD rr rr             LDA     record_size
000EE2r 2  69 02                ADC     #2
000EE4r 2  8D rr rr             STA     record_size
000EE7r 2  90 03                BCC     :+
000EE9r 2  EE rr rr             INC     record_size+1
000EECr 2  80 13        :       BRA     @rec_advanced
000EEEr 2               @rec_adv_rec:
000EEEr 2  18                   CLC
000EEFr 2  AD rr rr             LDA     record_size
000EF2r 2  6D rr rr             ADC     nest_save_size
000EF5r 2  8D rr rr             STA     record_size
000EF8r 2  AD rr rr             LDA     record_size+1
000EFBr 2  6D rr rr             ADC     nest_save_size+1
000EFEr 2  8D rr rr             STA     record_size+1
000F01r 2               @rec_advanced:
000F01r 2  FA                   PLX
000F02r 2  E8                   INX
000F03r 2  4C rr rr             JMP     @rec_addf
000F06r 2               @rec_endf:
000F06r 2               ; expect ';' between groups, or END
000F06r 2  A5 rr                LDA     tok_type
000F08r 2  C9 20                CMP     #TOK_SEMICOLON
000F0Ar 2  D0 06                BNE     @rec_check_end
000F0Cr 2  20 rr rr             JSR     next_token              ; consume ';'
000F0Fr 2  4C rr rr             JMP     @rec_loop
000F12r 2               @rec_check_end:
000F12r 2  A5 rr                LDA     tok_type
000F14r 2  C9 49                CMP     #TOK_END
000F16r 2  F0 03                BEQ     :+
000F18r 2  4C rr rr             JMP     @rec_loop               ; recover — try again
000F1Br 2               :
000F1Br 2               @rec_end:
000F1Br 2  20 rr rr             JSR     next_token              ; consume END
000F1Er 2  CE rr rr             DEC     field_depth             ; leaving this nesting level
000F21r 2               ; record_field_count was per-named-field; recompute as the slot span so
000F21r 2               ; field_lookup_in_record covers any inline-record sub-fields that got
000F21r 2               ; physically interleaved between this record's named fields.
000F21r 2  38                   SEC
000F22r 2  AD rr rr             LDA     field_table_count
000F25r 2  ED rr rr             SBC     record_first_field
000F28r 2  8D rr rr             STA     record_field_count
000F2Br 2  A9 06                LDA     #TY_RECORD
000F2Dr 2  60                   RTS
000F2Er 2               @not_record:
000F2Er 2  A5 rr                LDA     tok_type
000F30r 2  C9 24                CMP     #TOK_CARET
000F32r 2  D0 09                BNE     @not_caret
000F34r 2               ; --- ^BASETYPE — pointer type. Element type recorded but not yet
000F34r 2               ; type-checked; v1 only supports pointer-to-INTEGER (2-byte cell).
000F34r 2  20 rr rr             JSR     next_token              ; consume '^'
000F37r 2  20 rr rr             JSR     parse_type_spec         ; consume base type, result in A
000F3Ar 2                       ; (base type code intentionally discarded — bump allocator
000F3Ar 2                       ;  always grants 2 bytes per NEW; revisit when records land)
000F3Ar 2  A9 07                LDA     #TY_PTR
000F3Cr 2  60                   RTS
000F3Dr 2               @not_caret:
000F3Dr 2  20 rr rr             JSR     next_token
000F40r 2  A9 01                LDA     #TY_INT
000F42r 2  60                   RTS
000F43r 2               
000F43r 2               ; ---------------------------------------------------------------------------
000F43r 2               ; parse_arg_lvalue — used for VAR-by-reference call arguments.  Expects the
000F43r 2               ; current token to be an IDENT naming a variable; consumes the ident and
000F43r 2               ; emits an opcode that pushes the variable's address.
000F43r 2               ;
000F43r 2               ;   SYM_VAR    global → OP_LDA_G <wordoff>
000F43r 2               ;   SYM_VAR    local  → OP_LDA_L <byteoff>
000F43r 2               ;   SYM_VARREF (passing a VAR param through) → OP_LDL <byteoff>   (the
000F43r 2               ;              local slot itself already holds the upstream address)
000F43r 2               ;
000F43r 2               ; Anything else (literal, function call, undefined name) is silently ignored
000F43r 2               ; — the argument slot will hold whatever was last on the stack.  Pascal
000F43r 2               ; semantics say it's a compile error, but we emit no diagnostic for now.
000F43r 2               ; ---------------------------------------------------------------------------
000F43r 2               parse_arg_lvalue:
000F43r 2  A5 rr                LDA     tok_type
000F45r 2  C9 01                CMP     #TOK_IDENT
000F47r 2  F0 01                BEQ     :+
000F49r 2  60                   RTS
000F4Ar 2               :
000F4Ar 2  20 rr rr             JSR     symtab_find
000F4Dr 2  B0 01                BCS     :+
000F4Fr 2  60                   RTS                     ; undefined — emit nothing
000F50r 2               :       ; Snapshot kind, scope, offset before next_token clobbers tmp3.
000F50r 2  A0 10                LDY     #16
000F52r 2  B1 rr                LDA     (tmp3),y
000F54r 2  48                   PHA                     ; kind
000F55r 2  A0 14                LDY     #20
000F57r 2  B1 rr                LDA     (tmp3),y
000F59r 2  48                   PHA                     ; scope
000F5Ar 2  A0 13                LDY     #19
000F5Cr 2  B1 rr                LDA     (tmp3),y
000F5Er 2  48                   PHA                     ; off hi
000F5Fr 2  A0 12                LDY     #18
000F61r 2  B1 rr                LDA     (tmp3),y
000F63r 2  48                   PHA                     ; off lo (top)
000F64r 2  20 rr rr             JSR     next_token      ; consume ident
000F67r 2  68                   PLA                     ; off lo
000F68r 2  AA                   TAX
000F69r 2  68                   PLA                     ; off hi
000F6Ar 2  85 rr                STA     scratch
000F6Cr 2  68                   PLA                     ; scope
000F6Dr 2  A8                   TAY
000F6Er 2  68                   PLA                     ; kind
000F6Fr 2  C9 08                CMP     #SYM_VARREF
000F71r 2  F0 0C                BEQ     @lv_passthrough
000F73r 2  C0 00                CPY     #0
000F75r 2  D0 04                BNE     @lv_local
000F77r 2  8A                   TXA
000F78r 2  4C rr rr             JMP     emit_LDA_G
000F7Br 2               @lv_local:
000F7Br 2  8A                   TXA
000F7Cr 2  4C rr rr             JMP     emit_LDA_L
000F7Fr 2               @lv_passthrough:
000F7Fr 2  8A                   TXA
000F80r 2  4C rr rr             JMP     emit_LDL        ; slot already holds caller's address
000F83r 2               
000F83r 2               ; ---------------------------------------------------------------------------
000F83r 2               ; with_lookup_field — search active WITH contexts for ident_buf as an
000F83r 2               ; unqualified field name. Innermost WITH wins.
000F83r 2               ; Returns: carry set if found, A=field offset, X=field type
000F83r 2               ;          carry clear if not found
000F83r 2               ; Side effects on hit:
000F83r 2               ;   with_lookup_off/type      = matched field offset/type
000F83r 2               ;   with_lookup_base_lo/hi    = hidden global holding the WITH base address
000F83r 2               ;   with_lookup_first/count   = nested-record metadata for this field
000F83r 2               ; ---------------------------------------------------------------------------
000F83r 2               with_lookup_field:
000F83r 2  AD rr rr             LDA     with_depth
000F86r 2  D0 02                BNE     :+
000F88r 2  18                   CLC
000F89r 2  60                   RTS
000F8Ar 2  AE rr rr     :       LDX     with_depth
000F8Dr 2  CA                   DEX
000F8Er 2               @wlf_ctx:
000F8Er 2  86 rr                STX     tmp1
000F90r 2  BC rr rr             LDY     with_field_count,x
000F93r 2  BD rr rr             LDA     with_first_field,x
000F96r 2  84 rr                STY     scratch
000F98r 2  A6 rr                LDX     scratch
000F9Ar 2  20 rr rr             JSR     field_lookup_in_record
000F9Dr 2  90 2B                BCC     @wlf_next
000F9Fr 2  8D rr rr             STA     with_lookup_off
000FA2r 2  8A                   TXA
000FA3r 2  8D rr rr             STA     with_lookup_type
000FA6r 2  A6 rr                LDX     tmp3
000FA8r 2  BD rr rr             LDA     field_nested_first,x
000FABr 2  8D rr rr             STA     with_lookup_first
000FAEr 2  BD rr rr             LDA     field_nested_count,x
000FB1r 2  8D rr rr             STA     with_lookup_count
000FB4r 2  A6 rr                LDX     tmp1
000FB6r 2  BD rr rr             LDA     with_base_lo,x
000FB9r 2  8D rr rr             STA     with_lookup_base_lo
000FBCr 2  BD rr rr             LDA     with_base_hi,x
000FBFr 2  8D rr rr             STA     with_lookup_base_hi
000FC2r 2  AD rr rr             LDA     with_lookup_off
000FC5r 2  AE rr rr             LDX     with_lookup_type
000FC8r 2  38                   SEC
000FC9r 2  60                   RTS
000FCAr 2               @wlf_next:
000FCAr 2  A6 rr                LDX     tmp1
000FCCr 2  E0 00                CPX     #0
000FCEr 2  F0 03                BEQ     @wlf_nf
000FD0r 2  CA                   DEX
000FD1r 2  80 BB                BRA     @wlf_ctx
000FD3r 2               @wlf_nf:
000FD3r 2  18                   CLC
000FD4r 2  60                   RTS
000FD5r 2               
000FD5r 2               ; emit_with_field_base — push the selected WITH record's base address, then
000FD5r 2               ; add the matched field offset (with_lookup_off) if nonzero.
000FD5r 2               emit_with_field_base:
000FD5r 2  AD rr rr             LDA     with_lookup_base_hi
000FD8r 2  85 rr                STA     scratch
000FDAr 2  AD rr rr             LDA     with_lookup_base_lo
000FDDr 2  20 rr rr             JSR     emit_LDG
000FE0r 2  AD rr rr             LDA     with_lookup_off
000FE3r 2  F0 06                BEQ     @ewfb_done
000FE5r 2  20 rr rr             JSR     emit_LDCI
000FE8r 2  20 rr rr             JSR     emit_ADI
000FEBr 2               @ewfb_done:
000FEBr 2  60                   RTS
000FECr 2               
000FECr 2               ; ---------------------------------------------------------------------------
000FECr 2               ; parse_param_list — assumes '(' has already been consumed.  Parses zero or
000FECr 2               ; more comma/semicolon-separated parameter groups, then ')'.  Each parameter
000FECr 2               ; is added to symtab as SYM_VAR with offset = proc_param_count*2 and the
000FECr 2               ; group's type code.  proc_param_count is incremented per param.
000FECr 2               ;
000FECr 2               ; Pascal supports two separator forms:
000FECr 2               ;   ( A, B: INTEGER )            — names sharing one type, COMMA separated
000FECr 2               ;   ( A: INTEGER; B: CHAR )      — different types, SEMICOLON between groups
000FECr 2               ;   ( A, B: INTEGER; C: CHAR )   — both forms mixed
000FECr 2               ;
000FECr 2               ; Reuses var_name_buf (128 bytes / 8 names per group).  Safe because the
000FECr 2               ; param list is fully parsed before parse_block runs (which is what calls
000FECr 2               ; parse_var_decls).
000FECr 2               ; ---------------------------------------------------------------------------
000FECr 2               parse_param_list:
000FECr 2  A9 00                LDA     #0
000FEEr 2  8D rr rr             STA     param_var_mask  ; reset bitmap (set by caller too — paranoia)
000FF1r 2               @group_loop:
000FF1r 2               ; A leading VAR keyword marks the entire group as by-reference.
000FF1r 2  A9 00                LDA     #0
000FF3r 2  8D rr rr             STA     group_is_var
000FF6r 2  A5 rr                LDA     tok_type
000FF8r 2  C9 5C                CMP     #TOK_VAR
000FFAr 2  D0 08                BNE     @no_var_kw
000FFCr 2  A9 01                LDA     #1
000FFEr 2  8D rr rr             STA     group_is_var
001001r 2  20 rr rr             JSR     next_token      ; consume VAR
001004r 2               @no_var_kw:
001004r 2  A5 rr                LDA     tok_type
001006r 2  C9 01                CMP     #TOK_IDENT
001008r 2  F0 03                BEQ     @have_ident     ; jmp trampoline — body is too big for bra
00100Ar 2  4C rr rr             JMP     @done_params
00100Dr 2               @have_ident:
00100Dr 2               ; --- collect comma-separated names of this group ---
00100Dr 2  A9 00                LDA     #0
00100Fr 2  8D rr rr             STA     var_name_count
001012r 2               @gcollect:
001012r 2  A5 rr                LDA     tok_type
001014r 2  C9 01                CMP     #TOK_IDENT
001016r 2  D0 31                BNE     @gend
001018r 2  AD rr rr             LDA     var_name_count
00101Br 2  C9 08                CMP     #8
00101Dr 2  B0 1C                BCS     @gskip          ; buffer full — silently drop name
00101Fr 2  0A                   ASL
001020r 2  0A                   ASL
001021r 2  0A                   ASL
001022r 2  0A                   ASL
001023r 2  18                   CLC
001024r 2  69 rr                ADC     #<var_name_buf
001026r 2  85 rr                STA     tmp2
001028r 2  A9 00                LDA     #0
00102Ar 2  69 rr                ADC     #>var_name_buf
00102Cr 2  85 rr                STA     tmp2+1
00102Er 2  A0 0F                LDY     #15
001030r 2               @gcp:
001030r 2  B9 rr rr             LDA     ident_buf,y
001033r 2  91 rr                STA     (tmp2),y
001035r 2  88                   DEY
001036r 2  10 F8                BPL     @gcp
001038r 2  EE rr rr             INC     var_name_count
00103Br 2               @gskip:
00103Br 2  20 rr rr             JSR     next_token      ; consume name
00103Er 2  A5 rr                LDA     tok_type
001040r 2  C9 1F                CMP     #TOK_COMMA
001042r 2  D0 05                BNE     @gend
001044r 2  20 rr rr             JSR     next_token      ; consume ','
001047r 2  80 C9                BRA     @gcollect
001049r 2               @gend:
001049r 2               ; expect ':'
001049r 2  A5 rr                LDA     tok_type
00104Br 2  C9 21                CMP     #TOK_COLON
00104Dr 2  D0 03                BNE     :+
00104Fr 2  20 rr rr             JSR     next_token
001052r 2               :
001052r 2  20 rr rr             JSR     parse_type_spec
001055r 2  85 rr                STA     scratch         ; stash type for this group
001057r 2               ; --- add each collected name as SYM_VAR ---
001057r 2  A2 00                LDX     #0
001059r 2               @addloop:
001059r 2  EC rr rr             CPX     var_name_count
00105Cr 2  B0 7F                BCS     @groupdone
00105Er 2  DA                   PHX
00105Fr 2               ; copy var_name_buf[X*16] → ident_buf
00105Fr 2  8A                   TXA
001060r 2  0A                   ASL
001061r 2  0A                   ASL
001062r 2  0A                   ASL
001063r 2  0A                   ASL
001064r 2  18                   CLC
001065r 2  69 rr                ADC     #<var_name_buf
001067r 2  85 rr                STA     tmp2
001069r 2  A9 00                LDA     #0
00106Br 2  69 rr                ADC     #>var_name_buf
00106Dr 2  85 rr                STA     tmp2+1
00106Fr 2  A0 0F                LDY     #15
001071r 2               @cpout:
001071r 2  B1 rr                LDA     (tmp2),y
001073r 2  99 rr rr             STA     ident_buf,y
001076r 2  88                   DEY
001077r 2  10 F8                BPL     @cpout
001079r 2               ; offset for this param = proc_param_count * 2
001079r 2  AD rr rr             LDA     proc_param_count
00107Cr 2  0A                   ASL
00107Dr 2  85 rr                STA     tmp2
00107Fr 2  A9 00                LDA     #0
001081r 2  85 rr                STA     tmp2+1
001083r 2               ; If this is a VAR group, set the matching bit in param_var_mask
001083r 2               ; and use SYM_VARREF instead of SYM_VAR.
001083r 2  AD rr rr             LDA     group_is_var
001086r 2  F0 1E                BEQ     @use_var_kind
001088r 2               ; set bit (1 << proc_param_count) in param_var_mask (max 8 params)
001088r 2  AC rr rr             LDY     proc_param_count
00108Br 2  C0 08                CPY     #8
00108Dr 2  B0 10                BCS     @skip_mask      ; >8 params: silently drop bit
00108Fr 2  A9 01                LDA     #1
001091r 2               @shl:
001091r 2  C0 00                CPY     #0
001093r 2  F0 04                BEQ     @done_shl
001095r 2  0A                   ASL
001096r 2  88                   DEY
001097r 2  80 F8                BRA     @shl
001099r 2               @done_shl:
001099r 2  0D rr rr             ORA     param_var_mask
00109Cr 2  8D rr rr             STA     param_var_mask
00109Fr 2               @skip_mask:
00109Fr 2  A5 rr                LDA     scratch         ; type
0010A1r 2  AA                   TAX
0010A2r 2  A9 08                LDA     #SYM_VARREF
0010A4r 2  80 05                BRA     @do_add
0010A6r 2               @use_var_kind:
0010A6r 2  A5 rr                LDA     scratch         ; type
0010A8r 2  AA                   TAX
0010A9r 2  A9 01                LDA     #SYM_VAR
0010ABr 2               @do_add:
0010ABr 2  20 rr rr             JSR     symtab_add
0010AEr 2  A5 rr                LDA     scratch
0010B0r 2  C9 05                CMP     #TY_ARRAY
0010B2r 2  D0 0F                BNE     @pl_chk_rec
0010B4r 2  AD rr rr             LDA     array_elem_ty
0010B7r 2  A0 16                LDY     #22
0010B9r 2  91 rr                STA     (tmp3),y
0010BBr 2  A9 02                LDA     #2
0010BDr 2  A0 17                LDY     #23
0010BFr 2  91 rr                STA     (tmp3),y
0010C1r 2  80 12                BRA     @pl_meta_done
0010C3r 2               @pl_chk_rec:
0010C3r 2  C9 06                CMP     #TY_RECORD
0010C5r 2  D0 0E                BNE     @pl_meta_done
0010C7r 2  AD rr rr             LDA     record_first_field
0010CAr 2  A0 16                LDY     #22
0010CCr 2  91 rr                STA     (tmp3),y
0010CEr 2  AD rr rr             LDA     record_field_count
0010D1r 2  A0 17                LDY     #23
0010D3r 2  91 rr                STA     (tmp3),y
0010D5r 2               @pl_meta_done:
0010D5r 2  EE rr rr             INC     proc_param_count
0010D8r 2  FA                   PLX
0010D9r 2  E8                   INX
0010DAr 2  4C rr rr             JMP     @addloop        ; bra would be out of range now
0010DDr 2               @groupdone:
0010DDr 2               ; SEMICOLON → another group; else fall through to ')'
0010DDr 2  A5 rr                LDA     tok_type
0010DFr 2  C9 20                CMP     #TOK_SEMICOLON
0010E1r 2  D0 06                BNE     @done_params
0010E3r 2  20 rr rr             JSR     next_token      ; consume ';'
0010E6r 2  4C rr rr             JMP     @group_loop
0010E9r 2               @done_params:
0010E9r 2  A5 rr                LDA     tok_type
0010EBr 2  C9 1C                CMP     #TOK_RPAREN
0010EDr 2  D0 03                BNE     :+
0010EFr 2  20 rr rr             JSR     next_token      ; consume ')'
0010F2r 2               :
0010F2r 2  60                   RTS
0010F3r 2               
0010F3r 2               ; ---------------------------------------------------------------------------
0010F3r 2               ; parse_param_sig_list — parse a PROCEDURE/FUNCTION signature parameter list
0010F3r 2               ; without creating SYM_VAR entries. Used by UNIT interface headings so the
0010F3r 2               ; exported routine can record only param-count / VAR-mask metadata.
0010F3r 2               ; ---------------------------------------------------------------------------
0010F3r 2               parse_param_sig_list:
0010F3r 2  A9 00                LDA     #0
0010F5r 2  8D rr rr             STA     param_var_mask
0010F8r 2               @psig_group:
0010F8r 2  A9 00                LDA     #0
0010FAr 2  8D rr rr             STA     group_is_var
0010FDr 2  A5 rr                LDA     tok_type
0010FFr 2  C9 5C                CMP     #TOK_VAR
001101r 2  D0 08                BNE     @psig_no_var
001103r 2  A9 01                LDA     #1
001105r 2  8D rr rr             STA     group_is_var
001108r 2  20 rr rr             JSR     next_token
00110Br 2               @psig_no_var:
00110Br 2  A5 rr                LDA     tok_type
00110Dr 2  C9 01                CMP     #TOK_IDENT
00110Fr 2  F0 03                BEQ     @psig_have_ident
001111r 2  4C rr rr             JMP     @psig_done
001114r 2               @psig_have_ident:
001114r 2  A9 00                LDA     #0
001116r 2  8D rr rr             STA     var_name_count
001119r 2               @psig_collect:
001119r 2  A5 rr                LDA     tok_type
00111Br 2  C9 01                CMP     #TOK_IDENT
00111Dr 2  D0 11                BNE     @psig_end_names
00111Fr 2  EE rr rr             INC     var_name_count
001122r 2  20 rr rr             JSR     next_token
001125r 2  A5 rr                LDA     tok_type
001127r 2  C9 1F                CMP     #TOK_COMMA
001129r 2  D0 05                BNE     @psig_end_names
00112Br 2  20 rr rr             JSR     next_token
00112Er 2  80 E9                BRA     @psig_collect
001130r 2               @psig_end_names:
001130r 2  A5 rr                LDA     tok_type
001132r 2  C9 21                CMP     #TOK_COLON
001134r 2  D0 03                BNE     :+
001136r 2  20 rr rr             JSR     next_token
001139r 2  20 rr rr     :       JSR     parse_type_spec
00113Cr 2  A2 00                LDX     #0
00113Er 2               @psig_add:
00113Er 2  EC rr rr             CPX     var_name_count
001141r 2  B0 22                BCS     @psig_group_done
001143r 2  AD rr rr             LDA     group_is_var
001146r 2  F0 17                BEQ     @psig_inc
001148r 2  AC rr rr             LDY     proc_param_count
00114Br 2  C0 08                CPY     #8
00114Dr 2  B0 10                BCS     @psig_inc
00114Fr 2  A9 01                LDA     #1
001151r 2               @psig_shl:
001151r 2  C0 00                CPY     #0
001153r 2  F0 04                BEQ     @psig_shl_done
001155r 2  0A                   ASL
001156r 2  88                   DEY
001157r 2  80 F8                BRA     @psig_shl
001159r 2               @psig_shl_done:
001159r 2  0D rr rr             ORA     param_var_mask
00115Cr 2  8D rr rr             STA     param_var_mask
00115Fr 2               @psig_inc:
00115Fr 2  EE rr rr             INC     proc_param_count
001162r 2  E8                   INX
001163r 2  80 D9                BRA     @psig_add
001165r 2               @psig_group_done:
001165r 2  A5 rr                LDA     tok_type
001167r 2  C9 20                CMP     #TOK_SEMICOLON
001169r 2  D0 06                BNE     @psig_done
00116Br 2  20 rr rr             JSR     next_token
00116Er 2  4C rr rr             JMP     @psig_group
001171r 2               @psig_done:
001171r 2  A5 rr                LDA     tok_type
001173r 2  C9 1C                CMP     #TOK_RPAREN
001175r 2  D0 03                BNE     :+
001177r 2  20 rr rr             JSR     next_token
00117Ar 2  60           :       RTS
00117Br 2               
00117Br 2               ; ---------------------------------------------------------------------------
00117Br 2               ; parse_proc_iface_decl — PROCEDURE heading in a UNIT INTERFACE section.
00117Br 2               ; Registers a global SYM_PROC with placeholder code offset 0 and fills
00117Br 2               ; param-count / VAR-mask metadata for later callers and implementation.
00117Br 2               ; ---------------------------------------------------------------------------
00117Br 2               parse_proc_iface_decl:
00117Br 2  A5 rr                LDA     tok_type
00117Dr 2  C9 01                CMP     #TOK_IDENT
00117Fr 2  F0 01                BEQ     :+
001181r 2  60                   RTS
001182r 2  A9 00        :       LDA     #0
001184r 2  8D rr rr             STA     proc_param_count
001187r 2  8D rr rr             STA     param_var_mask
00118Ar 2  85 rr                STA     tmp2
00118Cr 2  85 rr                STA     tmp2+1
00118Er 2  A9 03                LDA     #SYM_PROC
001190r 2  A2 00                LDX     #TY_NONE
001192r 2  20 rr rr             JSR     symtab_add
001195r 2  A5 rr                LDA     tmp3
001197r 2  8D rr rr             STA     proc_entry_idx
00119Ar 2  A5 rr                LDA     tmp3+1
00119Cr 2  8D rr rr             STA     proc_entry_idx+1
00119Fr 2  20 rr rr             JSR     next_token              ; consume name
0011A2r 2  A5 rr                LDA     tok_type
0011A4r 2  C9 1B                CMP     #TOK_LPAREN
0011A6r 2  D0 06                BNE     @ppid_patch
0011A8r 2  20 rr rr             JSR     next_token
0011ABr 2  20 rr rr             JSR     parse_param_sig_list
0011AEr 2               @ppid_patch:
0011AEr 2  AD rr rr             LDA     proc_entry_idx
0011B1r 2  85 rr                STA     tmp3
0011B3r 2  AD rr rr             LDA     proc_entry_idx+1
0011B6r 2  85 rr                STA     tmp3+1
0011B8r 2  A0 15                LDY     #21
0011BAr 2  AD rr rr             LDA     proc_param_count
0011BDr 2  91 rr                STA     (tmp3),y
0011BFr 2  A0 16                LDY     #22
0011C1r 2  AD rr rr             LDA     param_var_mask
0011C4r 2  91 rr                STA     (tmp3),y
0011C6r 2  A5 rr                LDA     tok_type
0011C8r 2  C9 20                CMP     #TOK_SEMICOLON
0011CAr 2  D0 03                BNE     :+
0011CCr 2  20 rr rr             JSR     next_token
0011CFr 2  60           :       RTS
0011D0r 2               
0011D0r 2               ; ---------------------------------------------------------------------------
0011D0r 2               ; parse_func_iface_decl — FUNCTION heading in a UNIT INTERFACE section.
0011D0r 2               ; Registers a global SYM_FUNC with placeholder code offset 0 and patches
0011D0r 2               ; the return type plus param-count / VAR-mask metadata.
0011D0r 2               ; ---------------------------------------------------------------------------
0011D0r 2               parse_func_iface_decl:
0011D0r 2  A5 rr                LDA     tok_type
0011D2r 2  C9 01                CMP     #TOK_IDENT
0011D4r 2  F0 01                BEQ     :+
0011D6r 2  60                   RTS
0011D7r 2  A9 00        :       LDA     #0
0011D9r 2  8D rr rr             STA     proc_param_count
0011DCr 2  8D rr rr             STA     param_var_mask
0011DFr 2  85 rr                STA     tmp2
0011E1r 2  85 rr                STA     tmp2+1
0011E3r 2  A9 04                LDA     #SYM_FUNC
0011E5r 2  A2 00                LDX     #TY_NONE
0011E7r 2  20 rr rr             JSR     symtab_add
0011EAr 2  A5 rr                LDA     tmp3
0011ECr 2  8D rr rr             STA     proc_entry_idx
0011EFr 2  A5 rr                LDA     tmp3+1
0011F1r 2  8D rr rr             STA     proc_entry_idx+1
0011F4r 2  20 rr rr             JSR     next_token              ; consume name
0011F7r 2  A5 rr                LDA     tok_type
0011F9r 2  C9 1B                CMP     #TOK_LPAREN
0011FBr 2  D0 06                BNE     @pfid_after_params
0011FDr 2  20 rr rr             JSR     next_token
001200r 2  20 rr rr             JSR     parse_param_sig_list
001203r 2               @pfid_after_params:
001203r 2  A5 rr                LDA     tok_type
001205r 2  C9 21                CMP     #TOK_COLON
001207r 2  D0 03                BNE     :+
001209r 2  20 rr rr             JSR     next_token
00120Cr 2  20 rr rr     :       JSR     parse_type_spec
00120Fr 2  85 rr                STA     scratch
001211r 2  AD rr rr             LDA     proc_entry_idx
001214r 2  85 rr                STA     tmp3
001216r 2  AD rr rr             LDA     proc_entry_idx+1
001219r 2  85 rr                STA     tmp3+1
00121Br 2  A0 11                LDY     #17
00121Dr 2  A5 rr                LDA     scratch
00121Fr 2  91 rr                STA     (tmp3),y
001221r 2  A0 15                LDY     #21
001223r 2  AD rr rr             LDA     proc_param_count
001226r 2  91 rr                STA     (tmp3),y
001228r 2  A0 16                LDY     #22
00122Ar 2  AD rr rr             LDA     param_var_mask
00122Dr 2  91 rr                STA     (tmp3),y
00122Fr 2  A5 rr                LDA     tok_type
001231r 2  C9 20                CMP     #TOK_SEMICOLON
001233r 2  D0 03                BNE     :+
001235r 2  20 rr rr             JSR     next_token
001238r 2  60           :       RTS
001239r 2               
001239r 2               ; ---------------------------------------------------------------------------
001239r 2               ; parse_proc_decl — PROCEDURE name [ ( params ) ] ; <block> ;
001239r 2               ; The PROCEDURE keyword has already been consumed by parse_block @proc.
001239r 2               ;
001239r 2               ; Phase B: value parameters supported.  Each parameter occupies 2 bytes in
001239r 2               ; the AR at MP+AR_LOCALS+offset and is stored into the symbol table as
001239r 2               ; SYM_VAR in the inner scope.  Param-count is recorded on the proc's symbol
001239r 2               ; entry (offset 21) so callers know how many args to push.
001239r 2               ; ---------------------------------------------------------------------------
001239r 2               parse_proc_decl:
001239r 2               ; expect identifier (proc name)
001239r 2  A5 rr                LDA     tok_type
00123Br 2  C9 01                CMP     #TOK_IDENT
00123Dr 2  F0 01                BEQ     @have_name
00123Fr 2  60                   RTS
001240r 2               @have_name:
001240r 2               ; Save outer local_alloc_off on 6502 stack — nested procs would
001240r 2               ; otherwise clobber the enclosing proc's allocator state.
001240r 2  AD rr rr             LDA     local_alloc_off
001243r 2  48                   PHA
001244r 2               
001244r 2               ; save proc name into save_name_buf (ident_buf gets clobbered later)
001244r 2  A0 0F                LDY     #15
001246r 2               @savename:
001246r 2  B9 rr rr             LDA     ident_buf,y
001249r 2  99 rr rr             STA     save_name_buf,y
00124Cr 2  88                   DEY
00124Dr 2  10 F7                BPL     @savename
00124Fr 2               
00124Fr 2               ; UNIT implementation bodies may be preceded by an INTERFACE heading.
00124Fr 2               ; Reuse that global SYM_PROC entry instead of creating a duplicate.
00124Fr 2  A5 rr                LDA     scope_depth
001251r 2  D0 2A                BNE     @new_entry
001253r 2  AD rr rr             LDA     unit_section
001256r 2  C9 02                CMP     #2
001258r 2  D0 23                BNE     @new_entry
00125Ar 2  20 rr rr             JSR     symtab_find
00125Dr 2  90 1E                BCC     @new_entry
00125Fr 2  A0 10                LDY     #16
001261r 2  B1 rr                LDA     (tmp3),y
001263r 2  C9 03                CMP     #SYM_PROC
001265r 2  D0 16                BNE     @new_entry
001267r 2  A0 14                LDY     #20
001269r 2  B1 rr                LDA     (tmp3),y
00126Br 2  D0 10                BNE     @new_entry
00126Dr 2  A5 rr                LDA     tmp3
00126Fr 2  8D rr rr             STA     proc_entry_idx
001272r 2  A5 rr                LDA     tmp3+1
001274r 2  8D rr rr             STA     proc_entry_idx+1
001277r 2  20 rr rr             JSR     next_token
00127Ar 2  4C rr rr             JMP     @enter_scope
00127Dr 2               @new_entry:
00127Dr 2               
00127Dr 2  20 rr rr             JSR     next_token      ; consume name
001280r 2               
001280r 2               ; Register proc in symbol table NOW so we have an entry to update
001280r 2               ; with the param count once the param list has been parsed.
001280r 2               ; Offset (proc entry point) = current cg_pc.
001280r 2  20 rr rr             JSR     swap_ident_save ; ident_buf <-> save_name_buf
001283r 2  A5 rr                LDA     cg_pc
001285r 2  85 rr                STA     tmp2
001287r 2  A5 rr                LDA     cg_pc+1
001289r 2  85 rr                STA     tmp2+1
00128Br 2  A9 03                LDA     #SYM_PROC
00128Dr 2  A2 00                LDX     #TY_NONE
00128Fr 2  20 rr rr             JSR     symtab_add
001292r 2  A5 rr                LDA     tmp3
001294r 2  8D rr rr             STA     proc_entry_idx
001297r 2  A5 rr                LDA     tmp3+1
001299r 2  8D rr rr             STA     proc_entry_idx+1
00129Cr 2  20 rr rr             JSR     swap_ident_save
00129Fr 2               
00129Fr 2               ; Enter scope: params and any locals belong to the proc's frame.
00129Fr 2               @enter_scope:
00129Fr 2  20 rr rr             JSR     symtab_enter_scope
0012A2r 2               
0012A2r 2               ; init param count and VAR-mask
0012A2r 2  A9 00                LDA     #0
0012A4r 2  8D rr rr             STA     proc_param_count
0012A7r 2  8D rr rr             STA     param_var_mask
0012AAr 2               
0012AAr 2               ; Optional parameter list
0012AAr 2  A5 rr                LDA     tok_type
0012ACr 2  C9 1B                CMP     #TOK_LPAREN
0012AEr 2  D0 06                BNE     @backpatch_pcount
0012B0r 2  20 rr rr             JSR     next_token      ; consume '('
0012B3r 2  20 rr rr             JSR     parse_param_list
0012B6r 2               
0012B6r 2               @backpatch_pcount:
0012B6r 2               ; Write param count into proc's symbol entry (offset 21).
0012B6r 2  AD rr rr             LDA     proc_entry_idx
0012B9r 2  85 rr                STA     tmp3
0012BBr 2  AD rr rr             LDA     proc_entry_idx+1
0012BEr 2  85 rr                STA     tmp3+1
0012C0r 2  A0 12                LDY     #18
0012C2r 2  A5 rr                LDA     cg_pc
0012C4r 2  91 rr                STA     (tmp3),y
0012C6r 2  C8                   INY
0012C7r 2  A5 rr                LDA     cg_pc+1
0012C9r 2  91 rr                STA     (tmp3),y
0012CBr 2  A0 15                LDY     #21
0012CDr 2  AD rr rr             LDA     proc_param_count
0012D0r 2  91 rr                STA     (tmp3),y
0012D2r 2  A0 16                LDY     #22
0012D4r 2  AD rr rr             LDA     param_var_mask
0012D7r 2  91 rr                STA     (tmp3),y
0012D9r 2               
0012D9r 2               ; Initialize local_alloc_off to start right after the params.
0012D9r 2               ; VAR declarations inside the body extend this; final value is
0012D9r 2               ; backpatched into entry offset 23 below as the MRKSTK size.
0012D9r 2  AD rr rr             LDA     proc_param_count
0012DCr 2  0A                   ASL
0012DDr 2  8D rr rr             STA     local_alloc_off
0012E0r 2               
0012E0r 2               ; expect ';'
0012E0r 2  A5 rr                LDA     tok_type
0012E2r 2  C9 20                CMP     #TOK_SEMICOLON
0012E4r 2  D0 03                BNE     :+
0012E6r 2  20 rr rr             JSR     next_token
0012E9r 2               :
0012E9r 2               ; No callee prologue: the caller emits MRKSTK + arg-stores + CALL,
0012E9r 2               ; so by the time we land at the proc entry the activation record
0012E9r 2               ; (and its param slots) already exists.
0012E9r 2               
0012E9r 2               ; Recurse: proc body may have its own const/type/var/proc/begin block.
0012E9r 2  20 rr rr             JSR     parse_block
0012ECr 2               
0012ECr 2               ; Epilogue
0012ECr 2  20 rr rr             JSR     emit_RET
0012EFr 2               
0012EFr 2               ; Backpatch total local-area size (params + declared locals) into
0012EFr 2               ; the proc's symbol entry at offset 23.  The caller reads this and
0012EFr 2               ; emits MRKSTK <lsize> so the AR is large enough to hold all locals
0012EFr 2               ; below pm_sp (otherwise value-stack pushes corrupt local slots).
0012EFr 2  AD rr rr             LDA     proc_entry_idx
0012F2r 2  85 rr                STA     tmp3
0012F4r 2  AD rr rr             LDA     proc_entry_idx+1
0012F7r 2  85 rr                STA     tmp3+1
0012F9r 2  A0 17                LDY     #23
0012FBr 2  AD rr rr             LDA     local_alloc_off
0012FEr 2  91 rr                STA     (tmp3),y
001300r 2               
001300r 2  20 rr rr             JSR     symtab_leave_scope
001303r 2               
001303r 2               ; Consume trailing ';' after END
001303r 2  A5 rr                LDA     tok_type
001305r 2  C9 20                CMP     #TOK_SEMICOLON
001307r 2  D0 03                BNE     :+
001309r 2  20 rr rr             JSR     next_token
00130Cr 2               :
00130Cr 2  68                   PLA
00130Dr 2  8D rr rr             STA     local_alloc_off ; restore outer allocator state
001310r 2  60                   RTS
001311r 2               
001311r 2               ; ---------------------------------------------------------------------------
001311r 2               ; parse_func_decl — FUNCTION name [ ( params ) ] : RETURN_TYPE ; <block> ;
001311r 2               ; The FUNCTION keyword has already been consumed by parse_block @func.
001311r 2               ; Mirrors parse_proc_decl but registers SYM_FUNC, parses the return type,
001311r 2               ; adds a SYM_RETVAL inner-scope binding (so `name := expr` in the body
001311r 2               ; emits OP_STR), and emits OP_RETF as the epilogue.
001311r 2               ; ---------------------------------------------------------------------------
001311r 2               parse_func_decl:
001311r 2               ; expect identifier (func name)
001311r 2  A5 rr                LDA     tok_type
001313r 2  C9 01                CMP     #TOK_IDENT
001315r 2  F0 01                BEQ     @have_name
001317r 2  60                   RTS
001318r 2               @have_name:
001318r 2               ; Save outer local_alloc_off on 6502 stack — nested func/proc would
001318r 2               ; otherwise clobber the enclosing frame's allocator state.
001318r 2  AD rr rr             LDA     local_alloc_off
00131Br 2  48                   PHA
00131Cr 2               
00131Cr 2               ; save func name into save_name_buf
00131Cr 2  A0 0F                LDY     #15
00131Er 2               @savename:
00131Er 2  B9 rr rr             LDA     ident_buf,y
001321r 2  99 rr rr             STA     save_name_buf,y
001324r 2  88                   DEY
001325r 2  10 F7                BPL     @savename
001327r 2               
001327r 2               ; UNIT implementation bodies may bind to an INTERFACE-declared SYM_FUNC.
001327r 2  A5 rr                LDA     scope_depth
001329r 2  D0 2A                BNE     @new_entry
00132Br 2  AD rr rr             LDA     unit_section
00132Er 2  C9 02                CMP     #2
