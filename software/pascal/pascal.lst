001AA0r 2  0A                   ASL
001AA1r 2  0A                   ASL
001AA2r 2  0A                   ASL
001AA3r 2  0A                   ASL
001AA4r 2  18                   CLC
001AA5r 2  69 00                ADC     #<SYMTAB_BASE
001AA7r 2  85 rr                STA     tmp3
001AA9r 2  A5 rr                LDA     tmp2+1
001AABr 2  2A                   ROL
001AACr 2  69 80                ADC     #>SYMTAB_BASE
001AAEr 2  85 rr                STA     tmp3+1
