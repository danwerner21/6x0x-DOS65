001595r 2               ; --- Jump emitters ---
001595r 2               ; Returns: A/scratch = offset of the word operand in code buffer
001595r 2               ; (needed for backpatching)
001595r 2               
001595r 2               emit_UJP:                       ; emit UJP with placeholder offset
001595r 2  A9 50                LDA     #OP_UJP
