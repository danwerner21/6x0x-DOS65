0017F2r 2  A0 16                LDY     #22
0017F4r 2  B1 rr                LDA     (tmp3),y
0017F6r 2  8D rr rr             STA     sym_save_vmask
0017F9r 2  A0 17                LDY     #23
0017FBr 2  B1 rr                LDA     (tmp3),y
