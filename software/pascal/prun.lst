001144r 1  rr rr rr rr          .BYTE   <op_GTRI,  <op_GEQI,  <op_UNIMP, <op_UNIMP
001148r 1  rr rr rr rr          .REPEAT 8
00114Cr 1  rr rr rr rr  
001150r 1                               .BYTE   <op_UNIMP
001150r 1                       .ENDREPEAT
