000345r 1  85 rr                sta     tmp1+1
000347r 1  20 rr rr             jsr     pm_pop          ; a → tmp2
00034Ar 1  85 rr                sta     tmp2
00034Cr 1  A5 rr                lda     scratch
00034Er 1  85 rr                sta     tmp2+1
