0008FFr 1                       ; $FF
0008FFr 1  rr                   .byte >op_HALT
000900r 1               
000900r 1               ; ---------------------------------------------------------------------------
000900r 1               ; FCB for the .PCD file (placed in CODE segment, well below STACK_BASE)
000900r 1               ; ---------------------------------------------------------------------------
000900r 1  xx xx xx xx  pcd_fcb:        .res 36         ; FCB (36 bytes as per CP/M/DOS65)
000904r 1  xx xx xx xx  
000908r 1  xx xx xx xx  
000924r 1               
000924r 1               ; ---------------------------------------------------------------------------
000924r 1               ; Include shared I/O library
000924r 1               ; ---------------------------------------------------------------------------
000924r 1               .include "iolib.asm"
000924r 2               .pc02
000924r 2               ; iolib.asm — console and file I/O wrappers for DOS/65
000924r 2               ;
000924r 2               ; Uses PEM function 2 (CONOUT) for character output.
000924r 2               ; This routes through DFT_CONSOLE and works on all platforms
000924r 2               ; (serial, ESP video, memory-mapped video) regardless of which
000924r 2               ; console driver is active.
000924r 2               
000924r 2               .segment "CODE"
000924r 2               
000924r 2               ; ---------------------------------------------------------------------------
000924r 2               ; console_putc — output character in A to console via PEM #2
000924r 2               ; ---------------------------------------------------------------------------
000924r 2               console_putc:
000924r 2  48                   pha
000925r 2  A2 02                ldx     #PEM_CONOUT
000927r 2  20 03 01             jsr     PEM_ENTRY
00092Ar 2  68                   pla
00092Br 2  60                   rts
00092Cr 2               
00092Cr 2               ; ---------------------------------------------------------------------------
00092Cr 2               ; console_newline — emit CR+LF
00092Cr 2               ; ---------------------------------------------------------------------------
00092Cr 2               console_newline:
00092Cr 2  A9 0D                lda     #$0D
00092Er 2  A2 02                ldx     #PEM_CONOUT
000930r 2  20 03 01             jsr     PEM_ENTRY
000933r 2  A9 0A                lda     #$0A
000935r 2  A2 02                ldx     #PEM_CONOUT
000937r 2  20 03 01             jsr     PEM_ENTRY
00093Ar 2  60                   rts
00093Br 2               
00093Br 2               ; ---------------------------------------------------------------------------
00093Br 2               ; console_print_sz — print null-terminated string at tmp0
00093Br 2               ; ---------------------------------------------------------------------------
00093Br 2               console_print_sz:
00093Br 2  A0 00                ldy     #0
00093Dr 2  B1 rr        @loop:  lda     (tmp0),y
00093Fr 2  F0 08                beq     @done
000941r 2  A2 02                ldx     #PEM_CONOUT
000943r 2  20 03 01             jsr     PEM_ENTRY
000946r 2  C8                   iny
000947r 2  D0 F4                bne     @loop
000949r 2  60           @done:  rts
00094Ar 2               
00094Ar 2               ; ---------------------------------------------------------------------------
00094Ar 2               ; console_print_pstr — print length-prefixed Pascal string at tmp0
00094Ar 2               ; ---------------------------------------------------------------------------
00094Ar 2               console_print_pstr:
00094Ar 2  A0 00                ldy     #0
00094Cr 2  B1 rr                lda     (tmp0),y        ; length byte
00094Er 2  F0 10                beq     @done
000950r 2  AA                   tax                     ; X = remaining chars — but X used by PEM!
000951r 2                       ; save length, use tmp1 as counter
000951r 2  85 rr                sta     tmp1
000953r 2  C8                   iny
000954r 2  B1 rr        @loop:  lda     (tmp0),y
000956r 2  A2 02                ldx     #PEM_CONOUT
000958r 2  20 03 01             jsr     PEM_ENTRY
00095Br 2  C8                   iny
00095Cr 2  C6 rr                dec     tmp1
00095Er 2  D0 F4                bne     @loop
000960r 2  60           @done:  rts
000961r 2               
000961r 2               ; ---------------------------------------------------------------------------
000961r 2               ; console_print_dec — print signed 16-bit integer in tmp0:tmp0+1
000961r 2               ; ---------------------------------------------------------------------------
000961r 2               console_print_dec:
000961r 2  A5 rr                lda     tmp0+1
000963r 2  10 14                bpl     @positive
000965r 2  A9 2D                lda     #'-'
000967r 2  A2 02                ldx     #PEM_CONOUT
000969r 2  20 03 01             jsr     PEM_ENTRY
00096Cr 2  A9 00                lda     #0
00096Er 2  38                   sec
00096Fr 2  E5 rr                sbc     tmp0
000971r 2  85 rr                sta     tmp0
000973r 2  A9 00                lda     #0
000975r 2  E5 rr                sbc     tmp0+1
000977r 2  85 rr                sta     tmp0+1
000979r 2               @positive:
000979r 2  A9 00                lda     #0
00097Br 2  48                   pha                     ; sentinel
00097Cr 2               @div_loop:
00097Cr 2  20 rr rr             jsr     div16_by10      ; quotient→tmp0, remainder→scratch
00097Fr 2  A5 rr                lda     scratch
000981r 2  18                   clc
000982r 2  69 30                adc     #'0'
000984r 2  48                   pha
000985r 2  A5 rr                lda     tmp0
000987r 2  05 rr                ora     tmp0+1
000989r 2  D0 F1                bne     @div_loop
00098Br 2               @print_loop:
00098Br 2  68                   pla
00098Cr 2  F0 07                beq     @done2          ; sentinel
00098Er 2  A2 02                ldx     #PEM_CONOUT
000990r 2  20 03 01             jsr     PEM_ENTRY
000993r 2  80 F6                bra     @print_loop
000995r 2  60           @done2: rts
000996r 2               
000996r 2               ; ---------------------------------------------------------------------------
000996r 2               ; div16_by10 — divide tmp0:tmp0+1 by 10
000996r 2               ; Result: quotient in tmp0:tmp0+1, remainder in scratch
000996r 2               ; ---------------------------------------------------------------------------
000996r 2               div16_by10:
000996r 2  A9 00                lda     #0
000998r 2  85 rr                sta     scratch
00099Ar 2  A2 10                ldx     #16
00099Cr 2  06 rr        @bit:   asl     tmp0
00099Er 2  26 rr                rol     tmp0+1
0009A0r 2  26 rr                rol     scratch
0009A2r 2  A5 rr                lda     scratch
0009A4r 2  C9 0A                cmp     #10
0009A6r 2  90 06                bcc     @no_sub
0009A8r 2  E9 0A                sbc     #10
0009AAr 2  85 rr                sta     scratch
0009ACr 2  E6 rr                inc     tmp0
0009AEr 2               @no_sub:
0009AEr 2  CA                   dex
0009AFr 2  D0 EB                bne     @bit
0009B1r 2  60                   rts
0009B2r 2               
0009B2r 2               ; ---------------------------------------------------------------------------
0009B2r 2               ; console_read_line — read a line into buffer at tmp0, max len in x_save
0009B2r 2               ; Returns: Y = length (not including CR)
0009B2r 2               ; ---------------------------------------------------------------------------
0009B2r 2               console_read_line:
0009B2r 2  8E rr rr             stx     x_save
0009B5r 2  A0 00                ldy     #0
0009B7r 2  A2 01        @loop:  ldx     #PEM_CONIN
0009B9r 2  20 03 01             jsr     PEM_ENTRY
0009BCr 2  C9 0D                cmp     #$0D
0009BEr 2  F0 28                beq     @done
0009C0r 2  C9 08                cmp     #$08            ; backspace
0009C2r 2  D0 1C                bne     @store
0009C4r 2  C0 00                cpy     #0
0009C6r 2  F0 EF                beq     @loop
0009C8r 2  88                   dey
0009C9r 2  A9 08                lda     #$08
0009CBr 2  A2 02                ldx     #PEM_CONOUT
0009CDr 2  20 03 01             jsr     PEM_ENTRY
0009D0r 2  A9 20                lda     #' '
0009D2r 2  A2 02                ldx     #PEM_CONOUT
0009D4r 2  20 03 01             jsr     PEM_ENTRY
0009D7r 2  A9 08                lda     #$08
0009D9r 2  A2 02                ldx     #PEM_CONOUT
0009DBr 2  20 03 01             jsr     PEM_ENTRY
0009DEr 2  80 D7                bra     @loop
0009E0r 2  91 rr        @store: sta     (tmp0),y
0009E2r 2  C8                   iny
0009E3r 2  CC rr rr             cpy     x_save
0009E6r 2  90 CF                bcc     @loop
0009E8r 2  60           @done:  rts
0009E9r 2  00           x_save: .byte   0
0009EAr 2               
0009EAr 2               ; ---------------------------------------------------------------------------
0009EAr 2               ; file_open — open file via FCB at tmp1; returns A=0 success, $FF=not found
0009EAr 2               ; PEM calling convention: X=function, A=FCB addr lo, Y=FCB addr hi
0009EAr 2               ; ---------------------------------------------------------------------------
0009EAr 2               file_open:
0009EAr 2  A5 rr                lda     tmp1
0009ECr 2  A4 rr                ldy     tmp1+1
0009EEr 2  A2 0F                ldx     #PEM_OPEN
0009F0r 2  20 03 01             jsr     PEM_ENTRY
0009F3r 2  60                   rts
0009F4r 2               
0009F4r 2               ; ---------------------------------------------------------------------------
0009F4r 2               ; file_make — create/truncate file via FCB at tmp1
0009F4r 2               ; ---------------------------------------------------------------------------
0009F4r 2               file_make:
0009F4r 2  A5 rr                lda     tmp1
0009F6r 2  A4 rr                ldy     tmp1+1
0009F8r 2  A2 16                ldx     #PEM_MAKE
0009FAr 2  20 03 01             jsr     PEM_ENTRY
0009FDr 2  60                   rts
0009FEr 2               
0009FEr 2               ; ---------------------------------------------------------------------------
0009FEr 2               ; file_read_sector — read 128 bytes into DMA_BUF; returns A=0 ok, A=1 EOF
0009FEr 2               ; ---------------------------------------------------------------------------
0009FEr 2               file_read_sector:
0009FEr 2  A5 rr                lda     tmp1
000A00r 2  A4 rr                ldy     tmp1+1
000A02r 2  A2 14                ldx     #PEM_READ
000A04r 2  20 03 01             jsr     PEM_ENTRY
000A07r 2  60                   rts
000A08r 2               
000A08r 2               ; ---------------------------------------------------------------------------
000A08r 2               ; file_write_sector — write 128 bytes from DMA_BUF
000A08r 2               ; ---------------------------------------------------------------------------
000A08r 2               file_write_sector:
000A08r 2  A5 rr                lda     tmp1
000A0Ar 2  A4 rr                ldy     tmp1+1
000A0Cr 2  A2 15                ldx     #PEM_WRITE
000A0Er 2  20 03 01             jsr     PEM_ENTRY
000A11r 2  60                   rts
000A12r 2               
000A12r 2               ; ---------------------------------------------------------------------------
000A12r 2               ; file_close — close FCB at tmp1
000A12r 2               ; ---------------------------------------------------------------------------
000A12r 2               file_close:
000A12r 2  A5 rr                lda     tmp1
000A14r 2  A4 rr                ldy     tmp1+1
000A16r 2  A2 10                ldx     #PEM_CLOSE
000A18r 2  20 03 01             jsr     PEM_ENTRY
000A1Br 2  60                   rts
000A1Cr 2               
000A1Cr 1               .include "messages.asm"
