000235r 1  A0 00                ldy     #0
000237r 1  91 rr                sta     (tmp1),y
000239r 1  C8                   iny
00023Ar 1  A5 rr                lda     scratch
00023Cr 1  91 rr                sta     (tmp1),y
00023Er 1  4C rr rr             jmp     prun_loop
000241r 1               
000241r 1               ; OP_LDG ($18) — push 16-bit global var (word offset from pm_base)
000241r 1               op_LDG:
