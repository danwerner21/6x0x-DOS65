0003A5r 1               ; OP_MOD ($34) — signed modulo: a MOD b = a - (a DIV b)*b
0003A5r 1               op_MOD:
0003A5r 1  20 rr rr             jsr     pm_pop          ; b → tmp1
0003A8r 1  85 rr                sta     tmp1
