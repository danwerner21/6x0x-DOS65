001134r 1  rr rr rr rr          .BYTE   <op_MOD,   <op_NGI,   <op_UNIMP, <op_UNIMP   ; $36 ABI, $37 SQI
001138r 1  rr rr rr rr          .BYTE   <op_LAND,  <op_LOR,   <op_LNOT,  <op_BNOT    ; $38-$3B
