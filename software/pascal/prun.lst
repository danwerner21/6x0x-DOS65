00052Dr 1  05 rr                ora     scratch         ; zero?
00052Fr 1  D0 12                bne     @no_jump        ; not zero = true, no jump
000531r 1  68                   pla                     ; hi offset
000532r 1  85 rr                sta     scratch
000534r 1  68                   pla                     ; lo offset
000535r 1  18                   clc
000536r 1  65 rr                adc     pm_ipc
