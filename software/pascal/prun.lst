0002BCr 1  A5 rr                lda     scratch
0002BEr 1  85 rr                sta     tmp2+1
0002C0r 1  A9 00                lda     #0
0002C2r 1  38                   sec
0002C3r 1  E5 rr                sbc     tmp2            ; negate lo
0002C5r 1  48                   pha
0002C6r 1  A9 00                lda     #0
0002C8r 1  E5 rr                sbc     tmp2+1          ; negate hi
0002CAr 1  85 rr                sta     scratch
