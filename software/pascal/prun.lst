000C40r 1  91 rr                STA     (tmp1),y
000C42r 1  4C rr rr             JMP     prun_loop
000C45r 1               
000C45r 1               ; OP_FRESET ($B1) — TOS=fileptr → open existing for reading, prefill buffer
000C45r 1               op_FRESET:
000C45r 1  20 rr rr             JSR     pm_pop
000C48r 1  85 rr                STA     tmp1
000C4Ar 1  A5 rr                LDA     scratch
000C4Cr 1  85 rr                STA     tmp1+1
000C4Er 1  A5 rr                LDA     tmp1
000C50r 1  A4 rr                LDY     tmp1+1
000C52r 1  A2 0F                LDX     #PEM_OPEN
000C54r 1  20 03 01             JSR     PEM_ENTRY
000C57r 1  C9 FF                CMP     #$FF
000C59r 1  D0 15                BNE     @fre_open_ok
000C5Br 1               ; open failed — leave file in EOF/closed state
000C5Br 1  A9 00                LDA     #F_MODE_CLOSED
000C5Dr 1  A0 A4                LDY     #F_MODE
000C5Fr 1  91 rr                STA     (tmp1),y
000C61r 1  A9 01                LDA     #1
000C63r 1  A0 A6                LDY     #F_EOF
000C65r 1  91 rr                STA     (tmp1),y
000C67r 1  A9 80                LDA     #128
000C69r 1  A0 A5                LDY     #F_POS
000C6Br 1  91 rr                STA     (tmp1),y
000C6Dr 1  4C rr rr             JMP     prun_loop
000C70r 1               @fre_open_ok:
000C70r 1               ; set DMA to file's internal buffer
000C70r 1  18                   CLC
000C71r 1  A5 rr                LDA     tmp1
000C73r 1  69 24                ADC     #F_BUF
000C75r 1  48                   PHA
000C76r 1  A5 rr                LDA     tmp1+1
000C78r 1  69 00                ADC     #0
000C7Ar 1  A8                   TAY
000C7Br 1  68                   PLA
000C7Cr 1  20 rr rr             JSR     file_setdma
000C7Fr 1               ; pre-read first sector to detect immediate EOF
000C7Fr 1  A5 rr                LDA     tmp1
