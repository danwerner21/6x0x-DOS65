001082r 1  54 52 55 45          .BYTE   "TRUE",0
001086r 1  00           
001087r 1               str_false:
001087r 1  46 41 4C 53          .BYTE   "FALSE",0
00108Br 1  45 00        
00108Dr 1               msg_rt_banner:
00108Dr 1  50 52 55 4E          .BYTE   "PRUN v0.1 - Pascal P-Code Runtime for DOS/65",13,10,0
001091r 1  20 76 30 2E  
001095r 1  31 20 2D 20  
