001055r 1               ; Unimplemented opcode handler
001055r 1               ; ---------------------------------------------------------------------------
001055r 1               op_UNIMP:
001055r 1               ; X still holds the offending opcode at dispatch time
001055r 1  86 rr                STX     tmp0
001057r 1  A9 00                LDA     #0
001059r 1  85 rr                STA     tmp0+1
00105Br 1  DA                   PHX                     ; preserve for after banner
00105Cr 1  A9 rr                LDA     #<err_rt_opcode
00105Er 1  85 rr                STA     tmp0
001060r 1  A9 rr                LDA     #>err_rt_opcode
001062r 1  85 rr                STA     tmp0+1
001064r 1  20 rr rr             JSR     console_print_sz
001067r 1  FA                   PLX
001068r 1  86 rr                STX     tmp0
00106Ar 1  A9 00                LDA     #0
00106Cr 1  85 rr                STA     tmp0+1
00106Er 1  20 rr rr             JSR     console_print_dec
001071r 1  A9 0D                LDA     #13
001073r 1  A2 02                LDX     #PEM_CONOUT
001075r 1  20 03 01             JSR     PEM_ENTRY
001078r 1  A9 0A                LDA     #10
00107Ar 1  A2 02                LDX     #PEM_CONOUT
00107Cr 1  20 03 01             JSR     PEM_ENTRY
00107Fr 1  4C 00 01             JMP     WARM_BOOT
001082r 1               
