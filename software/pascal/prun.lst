0003B7r 1  A5 rr                lda     tmp2+1
0003B9r 1  29 80                and     #$80
0003BBr 1  48                   pha
0003BCr 1  24 rr                bit     tmp2+1
0003BEr 1  10 03                bpl     :+
0003C0r 1  20 rr rr             jsr     neg_tmp2
