000D00r 1               ; ---------------------------------------------------------------------------
000D00r 1               ; FCB for the .PCD file (placed in CODE segment, well below STACK_BASE)
000D00r 1               ; ---------------------------------------------------------------------------
000D00r 1               pcd_fcb:
000D00r 1  xx xx xx xx          .RES    36              ; FCB (36 bytes as per CP/M/DOS65)
000D04r 1  xx xx xx xx  
000D08r 1  xx xx xx xx  
000D24r 1               
000D24r 1               ; ---------------------------------------------------------------------------
000D24r 1               ; Include shared I/O library
000D24r 1               ; ---------------------------------------------------------------------------
000D24r 1               .include    "IOLIB.ASM"
000D24r 2               .pc02
000D24r 2               ; iolib.asm — console and file I/O wrappers for DOS/65
000D24r 2               ;
000D24r 2               ; Uses PEM function 2 (CONOUT) for character output.
000D24r 2               ; This routes through DFT_CONSOLE and works on all platforms
000D24r 2               ; (serial, ESP video, memory-mapped video) regardless of which
000D24r 2               ; console driver is active.
000D24r 2               
000D24r 2                       .segment        "CODE"
000D24r 2               
000D24r 2               ; ---------------------------------------------------------------------------
000D24r 2               ; console_putc — output character in A to console via PEM #2
000D24r 2               ; ---------------------------------------------------------------------------
000D24r 2               console_putc:
000D24r 2  48                   PHA
000D25r 2  A2 02                LDX     #PEM_CONOUT
000D27r 2  20 03 01             JSR     PEM_ENTRY
000D2Ar 2  68                   PLA
000D2Br 2  60                   RTS
000D2Cr 2               
000D2Cr 2               ; ---------------------------------------------------------------------------
000D2Cr 2               ; console_newline — emit CR+LF
000D2Cr 2               ; ---------------------------------------------------------------------------
000D2Cr 2               console_newline:
000D2Cr 2  A9 0D                LDA     #$0D
000D2Er 2  A2 02                LDX     #PEM_CONOUT
000D30r 2  20 03 01             JSR     PEM_ENTRY
000D33r 2  A9 0A                LDA     #$0A
000D35r 2  A2 02                LDX     #PEM_CONOUT
000D37r 2  20 03 01             JSR     PEM_ENTRY
000D3Ar 2  60                   RTS
000D3Br 2               
000D3Br 2               ; ---------------------------------------------------------------------------
000D3Br 2               ; console_print_sz — print null-terminated string at tmp0
000D3Br 2               ; ---------------------------------------------------------------------------
000D3Br 2               console_print_sz:
000D3Br 2  A0 00                LDY     #0
000D3Dr 2               @loop:
000D3Dr 2  B1 rr                LDA     (tmp0),y
000D3Fr 2  F0 08                BEQ     @done
000D41r 2  A2 02                LDX     #PEM_CONOUT
000D43r 2  20 03 01             JSR     PEM_ENTRY
000D46r 2  C8                   INY
000D47r 2  D0 F4                BNE     @loop
000D49r 2               @done:
000D49r 2  60                   RTS
000D4Ar 2               
000D4Ar 2               ; ---------------------------------------------------------------------------
000D4Ar 2               ; console_print_pstr — print length-prefixed Pascal string at tmp0
000D4Ar 2               ; ---------------------------------------------------------------------------
000D4Ar 2               console_print_pstr:
000D4Ar 2  A0 00                LDY     #0
000D4Cr 2  B1 rr                LDA     (tmp0),y        ; length byte
000D4Er 2  F0 10                BEQ     @done
000D50r 2  AA                   TAX                     ; X = remaining chars — but X used by PEM!
000D51r 2               ; save length, use tmp1 as counter
000D51r 2  85 rr                STA     tmp1
000D53r 2  C8                   INY
000D54r 2               @loop:
000D54r 2  B1 rr                LDA     (tmp0),y
000D56r 2  A2 02                LDX     #PEM_CONOUT
000D58r 2  20 03 01             JSR     PEM_ENTRY
000D5Br 2  C8                   INY
000D5Cr 2  C6 rr                DEC     tmp1
000D5Er 2  D0 F4                BNE     @loop
000D60r 2               @done:
000D60r 2  60                   RTS
000D61r 2               
000D61r 2               ; ---------------------------------------------------------------------------
000D61r 2               ; console_print_dec — print signed 16-bit integer in tmp0:tmp0+1
000D61r 2               ; ---------------------------------------------------------------------------
000D61r 2               console_print_dec:
000D61r 2  A5 rr                LDA     tmp0+1
000D63r 2  10 14                BPL     @positive
000D65r 2  A9 2D                LDA     #'-'
000D67r 2  A2 02                LDX     #PEM_CONOUT
000D69r 2  20 03 01             JSR     PEM_ENTRY
000D6Cr 2  A9 00                LDA     #0
000D6Er 2  38                   SEC
000D6Fr 2  E5 rr                SBC     tmp0
000D71r 2  85 rr                STA     tmp0
000D73r 2  A9 00                LDA     #0
000D75r 2  E5 rr                SBC     tmp0+1
000D77r 2  85 rr                STA     tmp0+1
000D79r 2               @positive:
000D79r 2  A9 00                LDA     #0
000D7Br 2  48                   PHA                     ; sentinel
000D7Cr 2               @div_loop:
000D7Cr 2  20 rr rr             JSR     div16_by10      ; quotient→tmp0, remainder→scratch
000D7Fr 2  A5 rr                LDA     scratch
000D81r 2  18                   CLC
000D82r 2  69 30                ADC     #'0'
000D84r 2  48                   PHA
000D85r 2  A5 rr                LDA     tmp0
000D87r 2  05 rr                ORA     tmp0+1
000D89r 2  D0 F1                BNE     @div_loop
000D8Br 2               @print_loop:
000D8Br 2  68                   PLA
000D8Cr 2  F0 07                BEQ     @done2          ; sentinel
000D8Er 2  A2 02                LDX     #PEM_CONOUT
000D90r 2  20 03 01             JSR     PEM_ENTRY
000D93r 2  80 F6                BRA     @print_loop
000D95r 2               @done2:
000D95r 2  60                   RTS
000D96r 2               
000D96r 2               ; ---------------------------------------------------------------------------
000D96r 2               ; div16_by10 — divide tmp0:tmp0+1 by 10
000D96r 2               ; Result: quotient in tmp0:tmp0+1, remainder in scratch
000D96r 2               ; ---------------------------------------------------------------------------
000D96r 2               div16_by10:
000D96r 2  A9 00                LDA     #0
000D98r 2  85 rr                STA     scratch
000D9Ar 2  A2 10                LDX     #16
000D9Cr 2               @bit:
000D9Cr 2  06 rr                ASL     tmp0
000D9Er 2  26 rr                ROL     tmp0+1
000DA0r 2  26 rr                ROL     scratch
000DA2r 2  A5 rr                LDA     scratch
000DA4r 2  C9 0A                CMP     #10
000DA6r 2  90 06                BCC     @no_sub
000DA8r 2  E9 0A                SBC     #10
000DAAr 2  85 rr                STA     scratch
000DACr 2  E6 rr                INC     tmp0
000DAEr 2               @no_sub:
000DAEr 2  CA                   DEX
000DAFr 2  D0 EB                BNE     @bit
000DB1r 2  60                   RTS
000DB2r 2               
000DB2r 2               ; ---------------------------------------------------------------------------
000DB2r 2               ; console_read_line — read a line into buffer at tmp0, max len in x_save
000DB2r 2               ; Returns: Y = length (not including CR)
000DB2r 2               ; ---------------------------------------------------------------------------
000DB2r 2               console_read_line:
000DB2r 2  8E rr rr             STX     x_save
000DB5r 2  A0 00                LDY     #0
000DB7r 2               @loop:
000DB7r 2  A2 01                LDX     #PEM_CONIN
000DB9r 2  20 03 01             JSR     PEM_ENTRY
000DBCr 2  C9 0D                CMP     #$0D
000DBEr 2  F0 28                BEQ     @done
000DC0r 2  C9 08                CMP     #$08            ; backspace
000DC2r 2  D0 1C                BNE     @store
000DC4r 2  C0 00                CPY     #0
000DC6r 2  F0 EF                BEQ     @loop
000DC8r 2  88                   DEY
000DC9r 2  A9 08                LDA     #$08
000DCBr 2  A2 02                LDX     #PEM_CONOUT
000DCDr 2  20 03 01             JSR     PEM_ENTRY
000DD0r 2  A9 20                LDA     #' '
000DD2r 2  A2 02                LDX     #PEM_CONOUT
000DD4r 2  20 03 01             JSR     PEM_ENTRY
000DD7r 2  A9 08                LDA     #$08
000DD9r 2  A2 02                LDX     #PEM_CONOUT
000DDBr 2  20 03 01             JSR     PEM_ENTRY
000DDEr 2  80 D7                BRA     @loop
000DE0r 2               @store:
000DE0r 2  91 rr                STA     (tmp0),y
000DE2r 2  C8                   INY
000DE3r 2  CC rr rr             CPY     x_save
000DE6r 2  90 CF                BCC     @loop
000DE8r 2               @done:
000DE8r 2  60                   RTS
000DE9r 2               x_save:
000DE9r 2  00                   .BYTE   0
000DEAr 2               
000DEAr 2               ; ---------------------------------------------------------------------------
000DEAr 2               ; file_open — open file via FCB at tmp1; returns A=0 success, $FF=not found
000DEAr 2               ; PEM calling convention: X=function, A=FCB addr lo, Y=FCB addr hi
000DEAr 2               ; ---------------------------------------------------------------------------
000DEAr 2               file_open:
000DEAr 2  A5 rr                LDA     tmp1
000DECr 2  A4 rr                LDY     tmp1+1
000DEEr 2  A2 0F                LDX     #PEM_OPEN
000DF0r 2  20 03 01             JSR     PEM_ENTRY
000DF3r 2  60                   RTS
000DF4r 2               
000DF4r 2               ; ---------------------------------------------------------------------------
000DF4r 2               ; file_make — create/truncate file via FCB at tmp1
000DF4r 2               ; ---------------------------------------------------------------------------
000DF4r 2               file_make:
000DF4r 2  A5 rr                LDA     tmp1
000DF6r 2  A4 rr                LDY     tmp1+1
000DF8r 2  A2 16                LDX     #PEM_MAKE
000DFAr 2  20 03 01             JSR     PEM_ENTRY
000DFDr 2  60                   RTS
000DFEr 2               
000DFEr 2               ; ---------------------------------------------------------------------------
000DFEr 2               ; file_read_sector — read 128 bytes into DMA_BUF; returns A=0 ok, A=1 EOF
000DFEr 2               ; ---------------------------------------------------------------------------
000DFEr 2               file_read_sector:
000DFEr 2  A5 rr                LDA     tmp1
000E00r 2  A4 rr                LDY     tmp1+1
000E02r 2  A2 14                LDX     #PEM_READ
000E04r 2  20 03 01             JSR     PEM_ENTRY
000E07r 2  60                   RTS
000E08r 2               
000E08r 2               ; ---------------------------------------------------------------------------
000E08r 2               ; file_write_sector — write 128 bytes from DMA_BUF
000E08r 2               ; ---------------------------------------------------------------------------
000E08r 2               file_write_sector:
000E08r 2  A5 rr                LDA     tmp1
000E0Ar 2  A4 rr                LDY     tmp1+1
000E0Cr 2  A2 15                LDX     #PEM_WRITE
000E0Er 2  20 03 01             JSR     PEM_ENTRY
000E11r 2  60                   RTS
000E12r 2               
000E12r 2               ; ---------------------------------------------------------------------------
000E12r 2               ; file_close — close FCB at tmp1
000E12r 2               ; ---------------------------------------------------------------------------
000E12r 2               file_close:
000E12r 2  A5 rr                LDA     tmp1
000E14r 2  A4 rr                LDY     tmp1+1
000E16r 2  A2 10                LDX     #PEM_CLOSE
000E18r 2  20 03 01             JSR     PEM_ENTRY
000E1Br 2  60                   RTS
