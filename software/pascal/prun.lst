0005F3r 1               ; OP_MRKSTK ($64) — reserve activation record on the value stack
0005F3r 1               ; Operand: 1 byte = size of local area in bytes (excluding AR header)
0005F3r 1               ;
0005F3r 1               ; Layout written: at new MP (= old SP):
0005F3r 1               ;   +0  saved MP (dynamic link)
0005F3r 1               ;   +2  return IPC (set by CALL, not here)
0005F3r 1               ;   +4  static link (unused for now)
0005F3r 1               ;   +6  return value slot
0005F3r 1               ;   +8.. locals
0005F3r 1               ; New MP = old SP; new SP = old SP + AR_LOCALS + local_size.
0005F3r 1               op_MRKSTK:
0005F3r 1  20 rr rr             JSR     pm_fetch_byte   ; A = local size
