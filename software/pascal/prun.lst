00066Er 1               ; OP_RETF ($63) — return from function: capture AR_RET_VAL, collapse frame,
00066Er 1               ; restore IPC/MP, then push the captured value onto caller's stack.
00066Er 1               op_RETF:
00066Er 1               ; capture return value into tmp0 BEFORE collapsing
00066Er 1  A0 06                LDY     #AR_RET_VAL
000670r 1  B1 rr                LDA     (pm_mp),y
