000377r 1  48                   pha                     ; save result sign on 6502 stack
000378r 1                       ; abs(a)
000378r 1  24 rr                bit     tmp2+1
00037Ar 1  10 03                bpl     :+
00037Cr 1  20 rr rr             jsr     neg_tmp2
00037Fr 1               :       ; abs(b) — temporarily move tmp1 to tmp2 area? simpler: inline negate of tmp1
00037Fr 1  24 rr                bit     tmp1+1
000381r 1  10 0D                bpl     :+
000383r 1  38                   sec
000384r 1  A9 00                lda     #0
000386r 1  E5 rr                sbc     tmp1
000388r 1  85 rr                sta     tmp1
00038Ar 1  A9 00                lda     #0
00038Cr 1  E5 rr                sbc     tmp1+1
00038Er 1  85 rr                sta     tmp1+1
