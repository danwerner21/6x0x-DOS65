000C1Br 1  90 06                BCC     @fas_store_e
000C1Dr 1  C9 7B                CMP     #'{'
000C1Fr 1  B0 02                BCS     @fas_store_e
000C21r 1  29 DF                AND     #$DF
000C23r 1               @fas_store_e:
000C23r 1  AE rr rr             LDX     fas_di
000C26r 1  E0 0C                CPX     #12
000C28r 1  B0 DF                BCS     @fas_ext_loop
000C2Ar 1  AC rr rr             LDY     fas_di
000C2Dr 1  91 rr                STA     (tmp1),y
000C2Fr 1  EE rr rr             INC     fas_di
000C32r 1  80 D5                BRA     @fas_ext_loop
000C34r 1               @fas_zero:
000C34r 1  A9 00                LDA     #0
000C36r 1  A0 A4                LDY     #F_MODE
000C38r 1  91 rr                STA     (tmp1),y
000C3Ar 1  A0 A5                LDY     #F_POS
000C3Cr 1  91 rr                STA     (tmp1),y
