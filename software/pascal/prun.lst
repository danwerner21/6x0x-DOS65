0004B4r 1  20 rr rr             jsr     pm_pop          ; a
0004B7r 1                       ; compute b - a  (i.e. swap operands of LESI)
0004B7r 1                       ; flip via: result_true if a > b, i.e. (a - b) > 0
0004B7r 1  38                   sec
0004B8r 1  E5 rr                sbc     tmp2            ; lo
0004BAr 1  AA                   tax
0004BBr 1  A5 rr                lda     scratch
0004BDr 1  E5 rr                sbc     tmp2+1          ; hi with borrow
0004BFr 1  70 0B                bvs     @ov
0004C1r 1  30 15                bmi     @false4         ; a < b
0004C3r 1  D0 09                bne     @true           ; positive non-zero hi → a > b
0004C5r 1  E0 00                cpx     #0
0004C7r 1  F0 0F                beq     @false4         ; a == b
0004C9r 1  4C rr rr             jmp     @true
