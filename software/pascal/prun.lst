000C9Er 1  91 rr                STA     (tmp1),y
000CA0r 1  A0 A5                LDY     #F_POS
000CA2r 1  91 rr                STA     (tmp1),y
000CA4r 1               ; lookahead: set F_EOF immediately if buf[0] is CTRL-Z
000CA4r 1  20 rr rr             JSR     file_check_eof_helper
000CA7r 1               @fre_set_mode:
