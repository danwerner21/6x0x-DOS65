000C34r 1  rr rr rr rr          .BYTE   >op_MOD,   >op_NGI,   >op_UNIMP, >op_UNIMP
000C38r 1  rr rr rr rr          .REPEAT 8
000C3Cr 1  rr rr rr rr  
000C40r 1                               .BYTE   >op_UNIMP
000C40r 1                       .ENDREPEAT
000C40r 1               ; $40-$4F
000C40r 1  rr rr rr rr          .BYTE   >op_EQUI,  >op_NEQI,  >op_LESI,  >op_LEQI
000C44r 1  rr rr rr rr          .BYTE   >op_GTRI,  >op_GEQI,  >op_UNIMP, >op_UNIMP
000C48r 1  rr rr rr rr          .REPEAT 8
000C4Cr 1  rr rr rr rr  
000C50r 1                           .BYTE   >op_UNIMP
000C50r 1                       .ENDREPEAT
000C50r 1               ; $50-$5F
000C50r 1  rr rr rr rr          .BYTE   >op_UJP,   >op_FJP,   >op_TJP,   >op_UNIMP
000C54r 1  rr rr rr rr          .REPEAT 12
000C58r 1  rr rr rr rr  
000C5Cr 1  rr rr rr rr  
000C60r 1                               .BYTE   >op_UNIMP
000C60r 1                       .ENDREPEAT
000C60r 1               ; $60-$6F
000C60r 1  rr rr rr rr          .BYTE   >op_CALL,  >op_UNIMP, >op_RET,   >op_RETF
