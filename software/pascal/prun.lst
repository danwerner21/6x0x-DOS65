000642r 1               ; OP_RET ($62) — return from procedure
000642r 1               ;   pm_sp ← pm_mp           (collapse frame; discards locals + any junk above)
000642r 1               ;   pm_ipc ← MP+AR_RET_ADDR
000642r 1               ;   pm_mp  ← MP+AR_DYN_LINK  (saved old MP)
