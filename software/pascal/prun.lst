000254r 1  C8                   iny
000255r 1  B1 rr                lda     (tmp1),y
000257r 1  85 rr                sta     scratch
000259r 1  68                   pla
00025Ar 1  20 rr rr             jsr     pm_push
00025Dr 1  4C rr rr             jmp     prun_loop
000260r 1               
000260r 1               ; OP_STG ($19) — pop into 16-bit global var
000260r 1               op_STG:
000260r 1  20 rr rr             jsr     pm_fetch_word   ; A=lo offset, scratch=hi offset
000263r 1  18                   clc
000264r 1  65 rr                adc     pm_base
000266r 1  85 rr                sta     tmp1
000268r 1  A5 rr                lda     scratch
00026Ar 1  65 rr                adc     pm_base+1
00026Cr 1  85 rr                sta     tmp1+1
00026Er 1  20 rr rr             jsr     pm_pop          ; A=lo, scratch=hi
000271r 1  A0 00                ldy     #0
000273r 1  91 rr                sta     (tmp1),y
000275r 1  C8                   iny
000276r 1  A5 rr                lda     scratch
000278r 1  91 rr                sta     (tmp1),y
00027Ar 1  4C rr rr             jmp     prun_loop
00027Dr 1               
00027Dr 1               ; OP_ADI ($30) — integer add
00027Dr 1               op_ADI:
