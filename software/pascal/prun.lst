000543r 1               @no_jump:
000543r 1  68                   pla
000544r 1  68                   pla
000545r 1  4C rr rr             jmp     prun_loop
000548r 1               
000548r 1               ; OP_TJP ($52) — jump if TOS is true (≠0)
