00065Ar 1               ; OP_UJP ($50) — unconditional jump (signed word offset from current IPC)
00065Ar 1               op_UJP:
00065Ar 1  20 rr rr             JSR     pm_fetch_word   ; A=lo, scratch=hi (signed offset)
00065Dr 1  18                   CLC
00065Er 1  65 rr                ADC     pm_ipc
000660r 1  85 rr                STA     pm_ipc
000662r 1  A5 rr                LDA     scratch
000664r 1  65 rr                ADC     pm_ipc+1
000666r 1  85 rr                STA     pm_ipc+1
000668r 1  4C rr rr             JMP     prun_loop
00066Br 1               
00066Br 1               ; OP_FJP ($51) — jump if TOS is false (0)
00066Br 1               op_FJP:
00066Br 1  20 rr rr             JSR     pm_fetch_word
00066Er 1  48                   PHA
00066Fr 1  A5 rr                LDA     scratch
000671r 1  48                   PHA
000672r 1  20 rr rr             JSR     pm_pop          ; condition
000675r 1  05 rr                ORA     scratch         ; zero?
000677r 1  D0 12                BNE     @no_jump        ; not zero = true, no jump
000679r 1  68                   PLA                     ; hi offset
00067Ar 1  85 rr                STA     scratch
00067Cr 1  68                   PLA                     ; lo offset
00067Dr 1  18                   CLC
00067Er 1  65 rr                ADC     pm_ipc
000680r 1  85 rr                STA     pm_ipc
000682r 1  A5 rr                LDA     scratch
000684r 1  65 rr                ADC     pm_ipc+1
000686r 1  85 rr                STA     pm_ipc+1
000688r 1  4C rr rr             JMP     prun_loop
00068Br 1               @no_jump:
00068Br 1  68                   PLA
00068Cr 1  68                   PLA
00068Dr 1  4C rr rr             JMP     prun_loop
000690r 1               
000690r 1               ; OP_TJP ($52) — jump if TOS is true (≠0)
000690r 1               op_TJP:
000690r 1  20 rr rr             JSR     pm_fetch_word
000693r 1  48                   PHA
000694r 1  A5 rr                LDA     scratch
000696r 1  48                   PHA
000697r 1  20 rr rr             JSR     pm_pop
00069Ar 1  05 rr                ORA     scratch
00069Cr 1  F0 12                BEQ     @no_jump2
00069Er 1  68                   PLA
00069Fr 1  85 rr                STA     scratch
0006A1r 1  68                   PLA
0006A2r 1  18                   CLC
0006A3r 1  65 rr                ADC     pm_ipc
0006A5r 1  85 rr                STA     pm_ipc
0006A7r 1  A5 rr                LDA     scratch
0006A9r 1  65 rr                ADC     pm_ipc+1
0006ABr 1  85 rr                STA     pm_ipc+1
0006ADr 1  4C rr rr             JMP     prun_loop
0006B0r 1               @no_jump2:
0006B0r 1  68                   PLA
0006B1r 1  68                   PLA
0006B2r 1  4C rr rr             JMP     prun_loop
0006B5r 1               
0006B5r 1               ; OP_MRKSTK ($64) — reserve activation record on the value stack
0006B5r 1               ; Operand: 1 byte = size of local area in bytes (excluding AR header)
0006B5r 1               ;
0006B5r 1               ; Layout written: at new MP (= old SP):
0006B5r 1               ;   +0  saved MP (dynamic link)
0006B5r 1               ;   +2  return IPC (set by CALL, not here)
0006B5r 1               ;   +4  static link (unused for now)
0006B5r 1               ;   +6  return value slot
0006B5r 1               ;   +8.. locals
0006B5r 1               ; New MP = old SP; new SP = old SP + AR_LOCALS + local_size.
0006B5r 1               op_MRKSTK:
0006B5r 1  20 rr rr             JSR     pm_fetch_byte   ; A = local size
0006B8r 1  85 rr                STA     tmp2
0006BAr 1               
0006BAr 1               ; save old MP at (SP)+AR_DYN_LINK
0006BAr 1  A0 00                LDY     #AR_DYN_LINK
0006BCr 1  A5 rr                LDA     pm_mp
0006BEr 1  91 rr                STA     (pm_sp),y
0006C0r 1  C8                   INY
0006C1r 1  A5 rr                LDA     pm_mp+1
0006C3r 1  91 rr                STA     (pm_sp),y
0006C5r 1               
0006C5r 1               ; new MP = current SP
0006C5r 1  A5 rr                LDA     pm_sp
0006C7r 1  85 rr                STA     pm_mp
0006C9r 1  A5 rr                LDA     pm_sp+1
0006CBr 1  85 rr                STA     pm_mp+1
0006CDr 1               
0006CDr 1               ; new SP = SP + AR_LOCALS + local_size
0006CDr 1  A5 rr                LDA     pm_sp
0006CFr 1  18                   CLC
0006D0r 1  69 08                ADC     #AR_LOCALS
0006D2r 1  85 rr                STA     pm_sp
0006D4r 1  90 02                BCC     :+
0006D6r 1  E6 rr                INC     pm_sp+1
0006D8r 1               :
0006D8r 1  A5 rr                LDA     pm_sp
0006DAr 1  18                   CLC
0006DBr 1  65 rr                ADC     tmp2
0006DDr 1  85 rr                STA     pm_sp
0006DFr 1  90 02                BCC     :+
0006E1r 1  E6 rr                INC     pm_sp+1
0006E3r 1               :
0006E3r 1  4C rr rr             JMP     prun_loop
0006E6r 1               
0006E6r 1               ; OP_CALL ($60) — call procedure: signed 16-bit offset relative to IPC after operand
0006E6r 1               ; Saves return IPC into the new frame's AR_RET_ADDR slot, then jumps.
0006E6r 1               op_CALL:
0006E6r 1  20 rr rr             JSR     pm_fetch_word   ; A = offset lo, scratch = offset hi
0006E9r 1  48                   PHA                     ; save offset lo
0006EAr 1               ; save current IPC (= return address) into MP+AR_RET_ADDR
0006EAr 1  A0 02                LDY     #AR_RET_ADDR
0006ECr 1  A5 rr                LDA     pm_ipc
0006EEr 1  91 rr                STA     (pm_mp),y
0006F0r 1  C8                   INY
0006F1r 1  A5 rr                LDA     pm_ipc+1
0006F3r 1  91 rr                STA     (pm_mp),y
0006F5r 1               ; pm_ipc += offset (signed)
0006F5r 1  68                   PLA                     ; offset lo
0006F6r 1  18                   CLC
0006F7r 1  65 rr                ADC     pm_ipc
0006F9r 1  85 rr                STA     pm_ipc
0006FBr 1  A5 rr                LDA     scratch
0006FDr 1  65 rr                ADC     pm_ipc+1
0006FFr 1  85 rr                STA     pm_ipc+1
000701r 1  4C rr rr             JMP     prun_loop
000704r 1               
000704r 1               ; OP_RET ($62) — return from procedure
000704r 1               ;   pm_sp ← pm_mp           (collapse frame; discards locals + any junk above)
000704r 1               ;   pm_ipc ← MP+AR_RET_ADDR
000704r 1               ;   pm_mp  ← MP+AR_DYN_LINK  (saved old MP)
000704r 1               op_RET:
000704r 1               ; collapse stack first (preserves AR header — still readable via pm_mp)
000704r 1  A5 rr                LDA     pm_mp
000706r 1  85 rr                STA     pm_sp
000708r 1  A5 rr                LDA     pm_mp+1
00070Ar 1  85 rr                STA     pm_sp+1
00070Cr 1               ; restore IPC into tmp1 before clobbering MP
00070Cr 1  A0 02                LDY     #AR_RET_ADDR
00070Er 1  B1 rr                LDA     (pm_mp),y
000710r 1  85 rr                STA     tmp1
000712r 1  C8                   INY
000713r 1  B1 rr                LDA     (pm_mp),y
000715r 1  85 rr                STA     tmp1+1
000717r 1               ; restore old MP from AR_DYN_LINK
000717r 1  A0 01                LDY     #AR_DYN_LINK+1
000719r 1  B1 rr                LDA     (pm_mp),y
00071Br 1  48                   PHA                     ; old MP hi
00071Cr 1  A0 00                LDY     #AR_DYN_LINK
00071Er 1  B1 rr                LDA     (pm_mp),y
000720r 1  85 rr                STA     pm_mp
000722r 1  68                   PLA
000723r 1  85 rr                STA     pm_mp+1
000725r 1               ; install IPC
000725r 1  A5 rr                LDA     tmp1
000727r 1  85 rr                STA     pm_ipc
000729r 1  A5 rr                LDA     tmp1+1
00072Br 1  85 rr                STA     pm_ipc+1
00072Dr 1  4C rr rr             JMP     prun_loop
000730r 1               
000730r 1               ; OP_RETF ($63) — return from function: capture AR_RET_VAL, collapse frame,
000730r 1               ; restore IPC/MP, then push the captured value onto caller's stack.
000730r 1               op_RETF:
000730r 1               ; capture return value into tmp0 BEFORE collapsing
000730r 1  A0 06                LDY     #AR_RET_VAL
000732r 1  B1 rr                LDA     (pm_mp),y
000734r 1  85 rr                STA     tmp0
000736r 1  C8                   INY
000737r 1  B1 rr                LDA     (pm_mp),y
000739r 1  85 rr                STA     tmp0+1
00073Br 1               ; collapse stack to MP
00073Br 1  A5 rr                LDA     pm_mp
00073Dr 1  85 rr                STA     pm_sp
00073Fr 1  A5 rr                LDA     pm_mp+1
000741r 1  85 rr                STA     pm_sp+1
000743r 1               ; restore IPC into tmp1
000743r 1  A0 02                LDY     #AR_RET_ADDR
000745r 1  B1 rr                LDA     (pm_mp),y
000747r 1  85 rr                STA     tmp1
000749r 1  C8                   INY
00074Ar 1  B1 rr                LDA     (pm_mp),y
00074Cr 1  85 rr                STA     tmp1+1
00074Er 1               ; restore old MP from AR_DYN_LINK
00074Er 1  A0 01                LDY     #AR_DYN_LINK+1
000750r 1  B1 rr                LDA     (pm_mp),y
000752r 1  48                   PHA
000753r 1  A0 00                LDY     #AR_DYN_LINK
000755r 1  B1 rr                LDA     (pm_mp),y
000757r 1  85 rr                STA     pm_mp
000759r 1  68                   PLA
00075Ar 1  85 rr                STA     pm_mp+1
00075Cr 1               ; install IPC
00075Cr 1  A5 rr                LDA     tmp1
00075Er 1  85 rr                STA     pm_ipc
000760r 1  A5 rr                LDA     tmp1+1
000762r 1  85 rr                STA     pm_ipc+1
000764r 1               ; push captured return value (lo in A, hi in scratch)
000764r 1  A5 rr                LDA     tmp0+1
000766r 1  85 rr                STA     scratch
000768r 1  A5 rr                LDA     tmp0
00076Ar 1  20 rr rr             JSR     pm_push
00076Dr 1  4C rr rr             JMP     prun_loop
000770r 1               
000770r 1               ; OP_STR ($66) — pop word, store at MP+AR_RET_VAL (function result slot)
000770r 1               op_STR:
000770r 1  20 rr rr             JSR     pm_pop          ; A=lo, scratch=hi
000773r 1  A0 06                LDY     #AR_RET_VAL
000775r 1  91 rr                STA     (pm_mp),y
000777r 1  C8                   INY
000778r 1  A5 rr                LDA     scratch
00077Ar 1  91 rr                STA     (pm_mp),y
00077Cr 1  4C rr rr             JMP     prun_loop
00077Fr 1               
00077Fr 1               ; OP_WRITI ($80) — pop integer, print decimal
00077Fr 1               op_WRITI:
00077Fr 1  20 rr rr             JSR     pm_pop          ; A=lo, scratch=hi
000782r 1  85 rr                STA     tmp0
000784r 1  A5 rr                LDA     scratch
000786r 1  85 rr                STA     tmp0+1
000788r 1  20 rr rr             JSR     console_print_dec
00078Br 1  4C rr rr             JMP     prun_loop
00078Er 1               
00078Er 1               ; OP_WRITC ($81) — pop char, print
00078Er 1               op_WRITC:
00078Er 1  20 rr rr             JSR     pm_pop
000791r 1  20 rr rr             JSR     console_putc
000794r 1  4C rr rr             JMP     prun_loop
000797r 1               
000797r 1               ; OP_WRITB ($82) — pop boolean, print TRUE/FALSE
000797r 1               op_WRITB:
000797r 1  20 rr rr             JSR     pm_pop
00079Ar 1  05 rr                ORA     scratch
00079Cr 1  F0 0E                BEQ     @false3
00079Er 1  A9 rr                LDA     #<str_true
0007A0r 1  85 rr                STA     tmp0
0007A2r 1  A9 rr                LDA     #>str_true
0007A4r 1  85 rr                STA     tmp0+1
0007A6r 1  20 rr rr             JSR     console_print_sz
0007A9r 1  4C rr rr             JMP     prun_loop
0007ACr 1               @false3:
0007ACr 1  A9 rr                LDA     #<str_false
0007AEr 1  85 rr                STA     tmp0
0007B0r 1  A9 rr                LDA     #>str_false
0007B2r 1  85 rr                STA     tmp0+1
0007B4r 1  20 rr rr             JSR     console_print_sz
0007B7r 1  4C rr rr             JMP     prun_loop
0007BAr 1               
0007BAr 1               ; OP_WRITS ($83) — TOS = address of length-prefixed string, print it
0007BAr 1               op_WRITS:
0007BAr 1  20 rr rr             JSR     pm_pop
0007BDr 1  85 rr                STA     tmp0
0007BFr 1  A5 rr                LDA     scratch
0007C1r 1  85 rr                STA     tmp0+1
0007C3r 1  20 rr rr             JSR     console_print_pstr
0007C6r 1  4C rr rr             JMP     prun_loop
0007C9r 1               
0007C9r 1               ; OP_WRITLN ($84) — newline
0007C9r 1               op_WRITLN:
0007C9r 1  20 rr rr             JSR     console_newline
0007CCr 1  4C rr rr             JMP     prun_loop
0007CFr 1               
0007CFr 1               ; OP_READI ($85) — TOS = address of INTEGER variable.  Read a line from
0007CFr 1               ; the console, parse a signed decimal integer, store as a 16-bit word at
0007CFr 1               ; the popped address.
0007CFr 1               op_READI:
0007CFr 1  20 rr rr             JSR     pm_pop          ; A=lo addr, scratch=hi addr
0007D2r 1  85 rr                STA     tmp1            ; (zero-page) destination pointer
0007D4r 1  A5 rr                LDA     scratch
0007D6r 1  85 rr                STA     tmp1+1
0007D8r 1               ; read one line into read_line_buf
0007D8r 1  A9 rr                LDA     #<read_line_buf
0007DAr 1  85 rr                STA     tmp0
0007DCr 1  A9 rr                LDA     #>read_line_buf
0007DEr 1  85 rr                STA     tmp0+1
0007E0r 1  A2 1F                LDX     #31             ; max line length
0007E2r 1  20 rr rr             JSR     console_read_line; Y = length on return
0007E5r 1  8C rr rr             STY     read_len
0007E8r 1  20 rr rr             JSR     console_newline ; PEM CONIN echoes CR but no LF
0007EBr 1               ; parse signed decimal from read_line_buf into tmp2:tmp2+1
0007EBr 1  A9 00                LDA     #0
0007EDr 1  85 rr                STA     tmp2
0007EFr 1  85 rr                STA     tmp2+1
0007F1r 1  8D rr rr             STA     read_neg
0007F4r 1  A0 00                LDY     #0
0007F6r 1               @rd_skip:
0007F6r 1  CC rr rr             CPY     read_len
0007F9r 1  B0 67                BCS     @rd_apply_sign  ; empty / all-space → 0
0007FBr 1  B9 rr rr             LDA     read_line_buf,y
0007FEr 1  C9 20                CMP     #' '
000800r 1  D0 04                BNE     @rd_chk_sign
000802r 1  C8                   INY
000803r 1  4C rr rr             JMP     @rd_skip
000806r 1               @rd_chk_sign:
000806r 1  C9 2D                CMP     #'-'
000808r 1  D0 09                BNE     @rd_chk_plus
00080Ar 1  A9 01                LDA     #1
00080Cr 1  8D rr rr             STA     read_neg
00080Fr 1  C8                   INY
000810r 1  4C rr rr             JMP     @rd_digits
000813r 1               @rd_chk_plus:
000813r 1  C9 2B                CMP     #'+'
000815r 1  D0 01                BNE     @rd_digits
000817r 1  C8                   INY
000818r 1               @rd_digits:
000818r 1  CC rr rr             CPY     read_len
00081Br 1  B0 45                BCS     @rd_apply_sign
00081Dr 1  B9 rr rr             LDA     read_line_buf,y
000820r 1  C9 30                CMP     #'0'
000822r 1  90 3E                BCC     @rd_apply_sign
000824r 1  C9 3A                CMP     #'9'+1
000826r 1  B0 3A                BCS     @rd_apply_sign
000828r 1               ; tmp2 *= 10  (using temp = tmp2*2; tmp2 = (tmp2*2)*4 + temp)
000828r 1  06 rr                ASL     tmp2
00082Ar 1  26 rr                ROL     tmp2+1
00082Cr 1  A5 rr                LDA     tmp2
00082Er 1  8D rr rr             STA     read_save2
000831r 1  A5 rr                LDA     tmp2+1
000833r 1  8D rr rr             STA     read_save2+1
000836r 1  06 rr                ASL     tmp2
000838r 1  26 rr                ROL     tmp2+1
00083Ar 1  06 rr                ASL     tmp2
00083Cr 1  26 rr                ROL     tmp2+1
00083Er 1  18                   CLC
00083Fr 1  A5 rr                LDA     tmp2
000841r 1  6D rr rr             ADC     read_save2
000844r 1  85 rr                STA     tmp2
000846r 1  A5 rr                LDA     tmp2+1
000848r 1  6D rr rr             ADC     read_save2+1
00084Br 1  85 rr                STA     tmp2+1
00084Dr 1               ; tmp2 += digit
00084Dr 1  B9 rr rr             LDA     read_line_buf,y
000850r 1  38                   SEC
000851r 1  E9 30                SBC     #'0'
000853r 1  18                   CLC
000854r 1  65 rr                ADC     tmp2
000856r 1  85 rr                STA     tmp2
000858r 1  A9 00                LDA     #0
00085Ar 1  65 rr                ADC     tmp2+1
00085Cr 1  85 rr                STA     tmp2+1
00085Er 1  C8                   INY
00085Fr 1  4C rr rr             JMP     @rd_digits
000862r 1               @rd_apply_sign:
000862r 1  AD rr rr             LDA     read_neg
000865r 1  F0 0D                BEQ     @rd_store
000867r 1  38                   SEC
000868r 1  A9 00                LDA     #0
00086Ar 1  E5 rr                SBC     tmp2
00086Cr 1  85 rr                STA     tmp2
00086Er 1  A9 00                LDA     #0
000870r 1  E5 rr                SBC     tmp2+1
000872r 1  85 rr                STA     tmp2+1
000874r 1               @rd_store:
000874r 1  A0 00                LDY     #0
000876r 1  A5 rr                LDA     tmp2
000878r 1  91 rr                STA     (tmp1),y
00087Ar 1  C8                   INY
00087Br 1  A5 rr                LDA     tmp2+1
00087Dr 1  91 rr                STA     (tmp1),y
00087Fr 1  4C rr rr             JMP     prun_loop
000882r 1               
000882r 1               read_line_buf:
000882r 1  xx xx xx xx          .RES    32
000886r 1  xx xx xx xx  
00088Ar 1  xx xx xx xx  
0008A2r 1               read_len:
0008A2r 1  xx                   .RES    1
0008A3r 1               read_neg:
0008A3r 1  xx                   .RES    1
0008A4r 1               read_save2:
0008A4r 1  xx xx                .RES    2
0008A6r 1               
0008A6r 1               ; OP_READC ($86) — read char from console, push
0008A6r 1               op_READC:
0008A6r 1  A2 01 20 03          PEM     PEM_CONIN
0008AAr 1  01           
0008ABr 1  48                   PHA
0008ACr 1  A9 00                LDA     #0
0008AEr 1  85 rr                STA     scratch
0008B0r 1  68                   PLA
0008B1r 1  20 rr rr             JSR     pm_push
0008B4r 1  4C rr rr             JMP     prun_loop
0008B7r 1               
0008B7r 1               ; OP_DUP ($90) — duplicate TOS
0008B7r 1               op_DUP:
0008B7r 1  20 rr rr             JSR     pm_peek
