000480r 1  38                   sec
000481r 1  E5 rr                sbc     tmp2            ; A = a_lo - b_lo
000483r 1  AA                   tax                     ; preserve low result for zero-test
000484r 1  A5 rr                lda     scratch
000486r 1  E5 rr                sbc     tmp2+1          ; A = a_hi - b_hi (with borrow)
000488r 1                       ; if a < b → N XOR V == 1
000488r 1  70 0B                bvs     @ov
00048Ar 1  30 15                bmi     @true
00048Cr 1  D0 09                bne     @false3         ; positive non-zero hi → a > b
00048Er 1  E0 00                cpx     #0
000490r 1  F0 0F                beq     @true           ; a == b
000492r 1  4C rr rr             jmp     @false3
000495r 1  10 0A        @ov:    bpl     @true           ; a < b under overflow
000497r 1               @false3:
000497r 1  A9 00                lda     #0
000499r 1  85 rr                sta     scratch
00049Br 1  20 rr rr             jsr     pm_push
00049Er 1  4C rr rr             jmp     prun_loop
