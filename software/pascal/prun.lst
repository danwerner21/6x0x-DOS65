000669r 1               ; Dispatch table — 256 entries of (lo, hi) pointer pairs
000669r 1               ; ---------------------------------------------------------------------------
000669r 1  xx xx xx xx  .align 256
00066Dr 1  xx xx xx xx  
000671r 1  xx xx xx xx  
