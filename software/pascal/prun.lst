0004ABr 1               ; OP_GTRI ($44) — a > b  (signed) ; equivalent to b < a
0004ABr 1               op_GTRI:
0004ABr 1  20 rr rr             jsr     pm_pop          ; b
0004AEr 1  85 rr                sta     tmp2
0004B0r 1  A5 rr                lda     scratch
