0002D3r 1               ; ---------------------------------------------------------------------------
0002D3r 1               ; mul/div helpers — operate on tmp2 (a) and tmp1 (b), result in tmp2
0002D3r 1               ; ---------------------------------------------------------------------------
0002D3r 1               
0002D3r 1               ; mul16: tmp2 = tmp2 * tmp1 (low 16 bits, unsigned)
0002D3r 1               mul16:
0002D3r 1  A9 00                lda     #0
0002D5r 1  85 rr                sta     scratch         ; result lo
0002D7r 1  85 rr                sta     scratch+1       ; result hi
0002D9r 1  A2 10                ldx     #16
0002DBr 1  46 rr        @bit:   lsr     tmp1+1
0002DDr 1  66 rr                ror     tmp1
0002DFr 1  90 0D                bcc     @no_add
0002E1r 1  18                   clc
0002E2r 1  A5 rr                lda     scratch
0002E4r 1  65 rr                adc     tmp2
0002E6r 1  85 rr                sta     scratch
0002E8r 1  A5 rr                lda     scratch+1
0002EAr 1  65 rr                adc     tmp2+1
0002ECr 1  85 rr                sta     scratch+1
0002EEr 1               @no_add:
0002EEr 1  06 rr                asl     tmp2
0002F0r 1  26 rr                rol     tmp2+1
0002F2r 1  CA                   dex
0002F3r 1  D0 E6                bne     @bit
0002F5r 1  A5 rr                lda     scratch
0002F7r 1  85 rr                sta     tmp2
0002F9r 1  A5 rr                lda     scratch+1
0002FBr 1  85 rr                sta     tmp2+1
0002FDr 1  60                   rts
0002FEr 1               
0002FEr 1               ; udiv16: tmp2 = tmp2 / tmp1, scratch = tmp2 mod tmp1 (unsigned)
0002FEr 1               udiv16:
0002FEr 1  A9 00                lda     #0
000300r 1  85 rr                sta     scratch         ; remainder lo
000302r 1  85 rr                sta     scratch+1       ; remainder hi
000304r 1  A2 10                ldx     #16
000306r 1  06 rr        @bit:   asl     tmp2            ; shift dividend left, top bit into rem
000308r 1  26 rr                rol     tmp2+1
00030Ar 1  26 rr                rol     scratch
00030Cr 1  26 rr                rol     scratch+1
00030Er 1                       ; try subtract divisor from remainder
00030Er 1  A5 rr                lda     scratch
000310r 1  38                   sec
000311r 1  E5 rr                sbc     tmp1
000313r 1  A8                   tay
000314r 1  A5 rr                lda     scratch+1
000316r 1  E5 rr                sbc     tmp1+1
000318r 1  90 06                bcc     @no_sub
00031Ar 1  85 rr                sta     scratch+1
00031Cr 1  84 rr                sty     scratch
