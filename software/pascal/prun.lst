0008BDr 1  4C rr rr             JMP     prun_loop
0008C0r 1               
0008C0r 1               ; OP_POP ($91) — discard TOS
0008C0r 1               op_POP:
0008C0r 1  20 rr rr             JSR     pm_pop
0008C3r 1  4C rr rr             JMP     prun_loop
0008C6r 1               
0008C6r 1               ; OP_NEW ($70) — allocate inline-size bytes from heap, push pointer
0008C6r 1               ; Bump allocator: pm_np grows down from HEAP_TOP. DISPOSE is a no-op.
0008C6r 1               op_NEW:
0008C6r 1  20 rr rr             JSR     pm_fetch_word   ; A=size lo, scratch=size hi
0008C9r 1  85 rr                STA     tmp0
0008CBr 1  A5 rr                LDA     scratch
0008CDr 1  85 rr                STA     tmp0+1
0008CFr 1  38                   SEC
0008D0r 1  A5 rr                LDA     pm_np
0008D2r 1  E5 rr                SBC     tmp0
0008D4r 1  85 rr                STA     pm_np
0008D6r 1  A5 rr                LDA     pm_np+1
0008D8r 1  E5 rr                SBC     tmp0+1
0008DAr 1  85 rr                STA     pm_np+1
0008DCr 1  A5 rr                LDA     pm_np+1
0008DEr 1  85 rr                STA     scratch
0008E0r 1  A5 rr                LDA     pm_np
0008E2r 1  20 rr rr             JSR     pm_push
0008E5r 1  4C rr rr             JMP     prun_loop
0008E8r 1               
0008E8r 1               ; OP_DISP ($71) — discard pointer (bump allocator cannot free)
0008E8r 1               op_DISP:
0008E8r 1  20 rr rr             JSR     pm_pop
0008EBr 1  4C rr rr             JMP     prun_loop
0008EEr 1               
0008EEr 1               ; ---------------------------------------------------------------------------
0008EEr 1               ; String built-in support
0008EEr 1               ;
0008EEr 1               ; Pascal-style strings: length byte at offset 0, characters at offsets 1..N.
0008EEr 1               ; COPY/CONCAT results live in one of three rotating 256-byte work buffers
0008EEr 1               ; placed in unused heap-area memory.  Round-robin allocation lets simple
0008EEr 1               ; nested expressions like CONCAT(COPY(s,1,3), 'x') work; deeper nesting
0008EEr 1               ; eventually recycles a buffer and corrupts an earlier result.
0008EEr 1               ; ---------------------------------------------------------------------------
0008EEr 1               STR_WORK_BASE   = $AD00
0008EEr 1               STR_WORK_COUNT  = 3
0008EEr 1               
0008EEr 1               str_work_idx:
0008EEr 1  xx                   .RES    1
0008EFr 1               
0008EFr 1               ; next_work_buf — return current work-buffer addr in tmp1, advance idx
0008EFr 1               next_work_buf:
0008EFr 1  AD rr rr             LDA     str_work_idx
0008F2r 1  18                   CLC
0008F3r 1  69 AD                ADC     #>STR_WORK_BASE
0008F5r 1  85 rr                STA     tmp1+1
0008F7r 1  A9 00                LDA     #0
0008F9r 1  85 rr                STA     tmp1
0008FBr 1  EE rr rr             INC     str_work_idx
0008FEr 1  AD rr rr             LDA     str_work_idx
000901r 1  C9 03                CMP     #STR_WORK_COUNT
000903r 1  90 05                BCC     :+
000905r 1  A9 00                LDA     #0
000907r 1  8D rr rr             STA     str_work_idx
00090Ar 1  60           :       RTS
00090Br 1               
00090Br 1               ; OP_LEN ($A0) — TOS = string ptr → TOS = length (int)
00090Br 1               op_LEN:
00090Br 1  20 rr rr             JSR     pm_pop          ; A=lo, scratch=hi
00090Er 1  85 rr                STA     tmp1
000910r 1  A5 rr                LDA     scratch
000912r 1  85 rr                STA     tmp1+1
000914r 1  A0 00                LDY     #0
000916r 1  B1 rr                LDA     (tmp1),y        ; length byte
000918r 1  48                   PHA
000919r 1  A9 00                LDA     #0
00091Br 1  85 rr                STA     scratch
00091Dr 1  68                   PLA
00091Er 1  20 rr rr             JSR     pm_push
000921r 1  4C rr rr             JMP     prun_loop
000924r 1               
000924r 1               ; OP_POS ($A1) — NOS=substr ptr, TOS=mainstr ptr → TOS=1-based position
000924r 1               op_POS:
000924r 1  20 rr rr             JSR     pm_pop          ; mainstr → tmp2
000927r 1  85 rr                STA     tmp2
000929r 1  A5 rr                LDA     scratch
00092Br 1  85 rr                STA     tmp2+1
00092Dr 1  20 rr rr             JSR     pm_pop          ; substr → tmp1
000930r 1  85 rr                STA     tmp1
000932r 1  A5 rr                LDA     scratch
000934r 1  85 rr                STA     tmp1+1
000936r 1               ; If substr length is 0, return 0
000936r 1  A0 00                LDY     #0
000938r 1  B1 rr                LDA     (tmp1),y
00093Ar 1  D0 03                BNE     :+
00093Cr 1  4C rr rr             JMP     @pos_zero
00093Fr 1               :
00093Fr 1               ; sublen in pos_sublen, mainlen in pos_mainlen
00093Fr 1  8D rr rr             STA     pos_sublen
000942r 1  A0 00                LDY     #0
000944r 1  B1 rr                LDA     (tmp2),y
000946r 1  8D rr rr             STA     pos_mainlen
000949r 1               ; If sublen > mainlen, return 0
000949r 1  AD rr rr             LDA     pos_sublen
00094Cr 1  CD rr rr             CMP     pos_mainlen
00094Fr 1  F0 02                BEQ     :+
000951r 1  B0 4D                BCS     @pos_zero
000953r 1               :
000953r 1               ; pos_start = 1; loop while (pos_start + sublen - 1) <= mainlen
000953r 1  A9 01                LDA     #1
000955r 1  8D rr rr             STA     pos_start
000958r 1               @pos_outer:
000958r 1               ; max_start = mainlen - sublen + 1
000958r 1  AD rr rr             LDA     pos_mainlen
00095Br 1  38                   SEC
00095Cr 1  ED rr rr             SBC     pos_sublen
00095Fr 1  18                   CLC
000960r 1  69 01                ADC     #1              ; A = max valid start
000962r 1  CD rr rr             CMP     pos_start
000965r 1  90 39                BCC     @pos_zero       ; pos_start > max_start → not found
000967r 1               ; compare sublen bytes at main[pos_start..] vs sub[1..]
000967r 1  A2 00                LDX     #0              ; substr offset (0..sublen-1, +1 to skip len byte)
000969r 1               @pos_cmp:
000969r 1  EC rr rr             CPX     pos_sublen
00096Cr 1  F0 1F                BEQ     @pos_found
00096Er 1  8A                   TXA
00096Fr 1  18                   CLC
000970r 1  6D rr rr             ADC     pos_start       ; main index = pos_start + X
000973r 1  A8                   TAY
000974r 1  B1 rr                LDA     (tmp2),y        ; main[pos_start+X]
000976r 1  8D rr rr             STA     pos_save
000979r 1  8A                   TXA
00097Ar 1  18                   CLC
00097Br 1  69 01                ADC     #1              ; sub index = X + 1
00097Dr 1  A8                   TAY
00097Er 1  B1 rr                LDA     (tmp1),y        ; sub[X+1]
000980r 1  CD rr rr             CMP     pos_save
000983r 1  D0 03                BNE     @pos_next
000985r 1  E8                   INX
000986r 1  80 E1                BRA     @pos_cmp
000988r 1               @pos_next:
000988r 1  EE rr rr             INC     pos_start
00098Br 1  80 CB                BRA     @pos_outer
00098Dr 1               @pos_found:
00098Dr 1  AD rr rr             LDA     pos_start
000990r 1  8D rr rr             STA     pos_save
000993r 1  A9 00                LDA     #0
000995r 1  85 rr                STA     scratch
000997r 1  AD rr rr             LDA     pos_save
00099Ar 1  20 rr rr             JSR     pm_push
00099Dr 1  4C rr rr             JMP     prun_loop
0009A0r 1               @pos_zero:
0009A0r 1  A9 00                LDA     #0
0009A2r 1  85 rr                STA     scratch
0009A4r 1  20 rr rr             JSR     pm_push
0009A7r 1  4C rr rr             JMP     prun_loop
0009AAr 1               
0009AAr 1  xx           pos_sublen:    .RES 1
0009ABr 1  xx           pos_mainlen:   .RES 1
0009ACr 1  xx           pos_start:     .RES 1
0009ADr 1  xx           pos_save:      .RES 1
0009AEr 1               
0009AEr 1               ; OP_COPY ($A2) — NNOS=str, NOS=index (1-based), TOS=count → TOS=result strptr
0009AEr 1               op_COPY:
0009AEr 1  20 rr rr             JSR     pm_pop          ; count
0009B1r 1  8D rr rr             STA     copy_count
0009B4r 1  20 rr rr             JSR     pm_pop          ; index
0009B7r 1  8D rr rr             STA     copy_index
0009BAr 1  20 rr rr             JSR     pm_pop          ; source ptr
0009BDr 1  85 rr                STA     tmp2
0009BFr 1  A5 rr                LDA     scratch
0009C1r 1  85 rr                STA     tmp2+1
0009C3r 1  20 rr rr             JSR     next_work_buf   ; tmp1 = dest buffer
0009C6r 1               ; clamp index: if index < 1 or index > srclen, result is empty
0009C6r 1  A0 00                LDY     #0
0009C8r 1  B1 rr                LDA     (tmp2),y
0009CAr 1  8D rr rr             STA     copy_srclen
0009CDr 1  AD rr rr             LDA     copy_index
0009D0r 1  F0 4A                BEQ     @copy_empty
0009D2r 1  CD rr rr             CMP     copy_srclen
0009D5r 1  F0 02                BEQ     :+
0009D7r 1  B0 43                BCS     @copy_empty
0009D9r 1               :
0009D9r 1               ; available = srclen - index + 1
0009D9r 1  AD rr rr             LDA     copy_srclen
0009DCr 1  38                   SEC
0009DDr 1  ED rr rr             SBC     copy_index
0009E0r 1  18                   CLC
0009E1r 1  69 01                ADC     #1
0009E3r 1  8D rr rr             STA     copy_avail
0009E6r 1               ; actual = min(count, available)
0009E6r 1  AD rr rr             LDA     copy_count
0009E9r 1  CD rr rr             CMP     copy_avail
0009ECr 1  90 03                BCC     :+
0009EEr 1  AD rr rr             LDA     copy_avail
0009F1r 1  8D rr rr     :       STA     copy_actual
0009F4r 1               ; copy actual bytes from src[index..] into dest[1..]
0009F4r 1  A2 00                LDX     #0
0009F6r 1               @copy_loop:
0009F6r 1  EC rr rr             CPX     copy_actual
0009F9r 1  F0 18                BEQ     @copy_done
0009FBr 1  8A                   TXA
0009FCr 1  18                   CLC
0009FDr 1  6D rr rr             ADC     copy_index      ; src offset = X + index
000A00r 1  A8                   TAY
000A01r 1  B1 rr                LDA     (tmp2),y
000A03r 1  8D rr rr             STA     copy_save
000A06r 1  8A                   TXA
000A07r 1  18                   CLC
000A08r 1  69 01                ADC     #1              ; dest offset = X + 1
000A0Ar 1  A8                   TAY
000A0Br 1  AD rr rr             LDA     copy_save
000A0Er 1  91 rr                STA     (tmp1),y
000A10r 1  E8                   INX
000A11r 1  80 E3                BRA     @copy_loop
000A13r 1               @copy_done:
000A13r 1  AD rr rr             LDA     copy_actual
000A16r 1  A0 00                LDY     #0
000A18r 1  91 rr                STA     (tmp1),y        ; write length byte
000A1Ar 1  80 06                BRA     @copy_push
000A1Cr 1               @copy_empty:
000A1Cr 1  A9 00                LDA     #0
000A1Er 1  A0 00                LDY     #0
000A20r 1  91 rr                STA     (tmp1),y
000A22r 1               @copy_push:
000A22r 1  A5 rr                LDA     tmp1+1
000A24r 1  85 rr                STA     scratch
000A26r 1  A5 rr                LDA     tmp1
000A28r 1  20 rr rr             JSR     pm_push
000A2Br 1  4C rr rr             JMP     prun_loop
000A2Er 1               
000A2Er 1  xx           copy_count:    .RES 1
000A2Fr 1  xx           copy_index:    .RES 1
000A30r 1  xx           copy_srclen:   .RES 1
000A31r 1  xx           copy_avail:    .RES 1
000A32r 1  xx           copy_actual:   .RES 1
000A33r 1  xx           copy_save:     .RES 1
000A34r 1               
000A34r 1               ; OP_CONCAT ($A3) — NOS=s1, TOS=s2 → TOS=result strptr (s1 then s2)
000A34r 1               op_CONCAT:
000A34r 1  20 rr rr             JSR     pm_pop          ; s2 → tmp2
000A37r 1  85 rr                STA     tmp2
000A39r 1  A5 rr                LDA     scratch
000A3Br 1  85 rr                STA     tmp2+1
000A3Dr 1               ; stash s2 ptr in cat_s2 because next_work_buf and pm_pop touch tmp1
000A3Dr 1  A5 rr                LDA     tmp2
000A3Fr 1  8D rr rr             STA     cat_s2
000A42r 1  A5 rr                LDA     tmp2+1
000A44r 1  8D rr rr             STA     cat_s2+1
000A47r 1  20 rr rr             JSR     pm_pop          ; s1 → tmp2
000A4Ar 1  85 rr                STA     tmp2
000A4Cr 1  A5 rr                LDA     scratch
000A4Er 1  85 rr                STA     tmp2+1
000A50r 1  A5 rr                LDA     tmp2
000A52r 1  8D rr rr             STA     cat_s1
000A55r 1  A5 rr                LDA     tmp2+1
000A57r 1  8D rr rr             STA     cat_s1+1
000A5Ar 1  20 rr rr             JSR     next_work_buf   ; tmp1 = dest
000A5Dr 1               ; copy s1 chars
000A5Dr 1  AD rr rr             LDA     cat_s1
000A60r 1  85 rr                STA     tmp2
000A62r 1  AD rr rr             LDA     cat_s1+1
000A65r 1  85 rr                STA     tmp2+1
000A67r 1  A0 00                LDY     #0
000A69r 1  B1 rr                LDA     (tmp2),y
000A6Br 1  8D rr rr             STA     cat_s1len
000A6Er 1  AA                   TAX                     ; X = remaining
000A6Fr 1  A0 01                LDY     #1              ; src offset
000A71r 1  A9 01                LDA     #1
000A73r 1  8D rr rr             STA     cat_dstoff
000A76r 1               @cat_s1_loop:
000A76r 1  E0 00                CPX     #0
000A78r 1  F0 18                BEQ     @cat_s2_start
000A7Ar 1  B1 rr                LDA     (tmp2),y
000A7Cr 1  8D rr rr             STA     cat_save
000A7Fr 1  DA                   PHX
000A80r 1  5A                   PHY
000A81r 1  AC rr rr             LDY     cat_dstoff
000A84r 1  AD rr rr             LDA     cat_save
000A87r 1  91 rr                STA     (tmp1),y
000A89r 1  EE rr rr             INC     cat_dstoff
000A8Cr 1  7A                   PLY
000A8Dr 1  FA                   PLX
000A8Er 1  C8                   INY
000A8Fr 1  CA                   DEX
000A90r 1  80 E4                BRA     @cat_s1_loop
000A92r 1               @cat_s2_start:
000A92r 1  AD rr rr             LDA     cat_s2
000A95r 1  85 rr                STA     tmp2
000A97r 1  AD rr rr             LDA     cat_s2+1
000A9Ar 1  85 rr                STA     tmp2+1
000A9Cr 1  A0 00                LDY     #0
000A9Er 1  B1 rr                LDA     (tmp2),y
000AA0r 1  8D rr rr             STA     cat_s2len
000AA3r 1  AA                   TAX
000AA4r 1  A0 01                LDY     #1
000AA6r 1               @cat_s2_loop:
000AA6r 1  E0 00                CPX     #0
000AA8r 1  F0 18                BEQ     @cat_done
000AAAr 1  B1 rr                LDA     (tmp2),y
000AACr 1  8D rr rr             STA     cat_save
000AAFr 1  DA                   PHX
000AB0r 1  5A                   PHY
000AB1r 1  AC rr rr             LDY     cat_dstoff
000AB4r 1  AD rr rr             LDA     cat_save
000AB7r 1  91 rr                STA     (tmp1),y
000AB9r 1  EE rr rr             INC     cat_dstoff
000ABCr 1  7A                   PLY
000ABDr 1  FA                   PLX
000ABEr 1  C8                   INY
000ABFr 1  CA                   DEX
000AC0r 1  80 E4                BRA     @cat_s2_loop
000AC2r 1               @cat_done:
000AC2r 1               ; total length = s1len + s2len (capped at 255)
000AC2r 1  18                   CLC
000AC3r 1  AD rr rr             LDA     cat_s1len
000AC6r 1  6D rr rr             ADC     cat_s2len
000AC9r 1  90 02                BCC     :+
000ACBr 1  A9 FF                LDA     #255
000ACDr 1  A0 00        :       LDY     #0
000ACFr 1  91 rr                STA     (tmp1),y
000AD1r 1  A5 rr                LDA     tmp1+1
000AD3r 1  85 rr                STA     scratch
000AD5r 1  A5 rr                LDA     tmp1
000AD7r 1  20 rr rr             JSR     pm_push
000ADAr 1  4C rr rr             JMP     prun_loop
000ADDr 1               
000ADDr 1  xx xx        cat_s1:        .RES 2
000ADFr 1  xx xx        cat_s2:        .RES 2
000AE1r 1  xx           cat_s1len:     .RES 1
000AE2r 1  xx           cat_s2len:     .RES 1
000AE3r 1  xx           cat_dstoff:    .RES 1
000AE4r 1  xx           cat_save:      .RES 1
000AE5r 1               
000AE5r 1               ; ---------------------------------------------------------------------------
000AE5r 1               ; TEXT file I/O handlers
000AE5r 1               ;
000AE5r 1               ; A TEXT variable is a 168-byte struct in globals:
000AE5r 1               ;   F_FCB   (0..35)   FCB used by PEM
000AE5r 1               ;   F_BUF   (36..163) 128-byte sector buffer
000AE5r 1               ;   F_MODE  (164)     0=closed, 1=read, 2=write
000AE5r 1               ;   F_POS   (165)     next byte index in F_BUF (0..128)
000AE5r 1               ;   F_EOF   (166)     non-zero once EOF / CTRL-Z encountered
000AE5r 1               ;
000AE5r 1               ; The file ptr passed on the p-machine stack is the struct base address.
000AE5r 1               ; The PEM DMA pointer is set to (struct + F_BUF) before each sector I/O,
000AE5r 1               ; so multiple open files don't trample each other's buffers.
000AE5r 1               ; ---------------------------------------------------------------------------
000AE5r 1               
000AE5r 1               ; Helper: write one char (in A) to file whose struct ptr is in tmp1.
000AE5r 1               ; Trashes tmp2, X, Y. Preserves tmp1, tmp3, scratch.
000AE5r 1               file_write_char_helper:
000AE5r 1  8D rr rr             STA     fwrc_char
000AE8r 1  18                   CLC
000AE9r 1  A5 rr                LDA     tmp1
000AEBr 1  69 24                ADC     #F_BUF
000AEDr 1  85 rr                STA     tmp2
000AEFr 1  A5 rr                LDA     tmp1+1
000AF1r 1  69 00                ADC     #0
000AF3r 1  85 rr                STA     tmp2+1
000AF5r 1  A0 A5                LDY     #F_POS
000AF7r 1  B1 rr                LDA     (tmp1),y
000AF9r 1  A8                   TAY
000AFAr 1  AD rr rr             LDA     fwrc_char
000AFDr 1  91 rr                STA     (tmp2),y
000AFFr 1  C8                   INY
000B00r 1  98                   TYA
000B01r 1  A0 A5                LDY     #F_POS
000B03r 1  91 rr                STA     (tmp1),y
000B05r 1  C9 80                CMP     #128
000B07r 1  D0 16                BNE     @fwch_done
000B09r 1  A5 rr                LDA     tmp2
000B0Br 1  A4 rr                LDY     tmp2+1
000B0Dr 1  20 rr rr             JSR     file_setdma
000B10r 1  A5 rr                LDA     tmp1
000B12r 1  A4 rr                LDY     tmp1+1
000B14r 1  A2 15                LDX     #PEM_WRITE
000B16r 1  20 03 01             JSR     PEM_ENTRY
000B19r 1  A9 00                LDA     #0
000B1Br 1  A0 A5                LDY     #F_POS
000B1Dr 1  91 rr                STA     (tmp1),y
000B1Fr 1               @fwch_done:
000B1Fr 1  60                   RTS
000B20r 1               
000B20r 1               ; Helper: read one char from file in tmp1, returns it in A (0 if F_EOF set).
000B20r 1               ; Then peeks the next char (loading next sector if needed) and sets F_EOF
000B20r 1               ; when no more data is available — so EOF(F) reflects the correct state
000B20r 1               ; *before* the next READ.  Trashes tmp2, X, Y.  Preserves tmp1, tmp3.
000B20r 1               file_read_char_helper:
000B20r 1  A0 A6                LDY     #F_EOF
000B22r 1  B1 rr                LDA     (tmp1),y
000B24r 1  F0 03                BEQ     :+
000B26r 1  A9 00                LDA     #0
000B28r 1  60                   RTS
000B29r 1               :
000B29r 1               ; Read current char at buf[F_POS] (RESET pre-loaded sector 0; this routine
000B29r 1               ; is responsible for the post-read peek that triggers any future refill).
000B29r 1  18                   CLC
000B2Ar 1  A5 rr                LDA     tmp1
000B2Cr 1  69 24                ADC     #F_BUF
000B2Er 1  85 rr                STA     tmp2
000B30r 1  A5 rr                LDA     tmp1+1
000B32r 1  69 00                ADC     #0
000B34r 1  85 rr                STA     tmp2+1
000B36r 1  A0 A5                LDY     #F_POS
000B38r 1  B1 rr                LDA     (tmp1),y
000B3Ar 1  A8                   TAY
000B3Br 1  B1 rr                LDA     (tmp2),y
000B3Dr 1  8D rr rr             STA     frch_char
000B40r 1  C8                   INY
000B41r 1  98                   TYA
000B42r 1  A0 A5                LDY     #F_POS
000B44r 1  91 rr                STA     (tmp1),y
000B46r 1  20 rr rr             JSR     file_check_eof_helper
000B49r 1  AD rr rr             LDA     frch_char
000B4Cr 1  60                   RTS
000B4Dr 1               
000B4Dr 1               ; Helper: peek buf[F_POS], refilling the sector first if F_POS == 128.
000B4Dr 1               ; Sets F_EOF if no more data is available or peeked byte is CTRL-Z.
000B4Dr 1               ; Does not advance F_POS.  Trashes tmp2, X, Y.  Preserves tmp1, tmp3.
000B4Dr 1               file_check_eof_helper:
000B4Dr 1  A0 A5                LDY     #F_POS
000B4Fr 1  B1 rr                LDA     (tmp1),y
000B51r 1  C9 80                CMP     #128
000B53r 1  90 29                BCC     @fce_peek
000B55r 1               ; sector exhausted — try to load next one
000B55r 1  18                   CLC
000B56r 1  A5 rr                LDA     tmp1
000B58r 1  69 24                ADC     #F_BUF
000B5Ar 1  48                   PHA
000B5Br 1  A5 rr                LDA     tmp1+1
000B5Dr 1  69 00                ADC     #0
000B5Fr 1  A8                   TAY
000B60r 1  68                   PLA
000B61r 1  20 rr rr             JSR     file_setdma
000B64r 1  A5 rr                LDA     tmp1
000B66r 1  A4 rr                LDY     tmp1+1
000B68r 1  A2 14                LDX     #PEM_READ
000B6Ar 1  20 03 01             JSR     PEM_ENTRY
000B6Dr 1  C9 00                CMP     #0
000B6Fr 1  F0 07                BEQ     @fce_pos0
000B71r 1  A9 01                LDA     #1
000B73r 1  A0 A6                LDY     #F_EOF
000B75r 1  91 rr                STA     (tmp1),y
000B77r 1  60                   RTS
000B78r 1               @fce_pos0:
000B78r 1  A9 00                LDA     #0
000B7Ar 1  A0 A5                LDY     #F_POS
000B7Cr 1  91 rr                STA     (tmp1),y
000B7Er 1               @fce_peek:
000B7Er 1  18                   CLC
000B7Fr 1  A5 rr                LDA     tmp1
000B81r 1  69 24                ADC     #F_BUF
000B83r 1  85 rr                STA     tmp2
000B85r 1  A5 rr                LDA     tmp1+1
000B87r 1  69 00                ADC     #0
000B89r 1  85 rr                STA     tmp2+1
000B8Br 1  A0 A5                LDY     #F_POS
000B8Dr 1  B1 rr                LDA     (tmp1),y
000B8Fr 1  A8                   TAY
000B90r 1  B1 rr                LDA     (tmp2),y
000B92r 1  C9 1A                CMP     #CTRL_Z
000B94r 1  D0 06                BNE     @fce_done
000B96r 1  A9 01                LDA     #1
000B98r 1  A0 A6                LDY     #F_EOF
000B9Ar 1  91 rr                STA     (tmp1),y
000B9Cr 1               @fce_done:
000B9Cr 1  60                   RTS
000B9Dr 1               
000B9Dr 1               ; OP_FASSGN ($B0) — NOS=fileptr, TOS=strptr → set FCB
000B9Dr 1               op_FASSGN:
000B9Dr 1  20 rr rr             JSR     pm_pop                  ; filename strptr → tmp3
000BA0r 1  85 rr                STA     tmp3
000BA2r 1  A5 rr                LDA     scratch
000BA4r 1  85 rr                STA     tmp3+1
000BA6r 1  20 rr rr             JSR     pm_pop                  ; file ptr → tmp1
000BA9r 1  85 rr                STA     tmp1
000BABr 1  A5 rr                LDA     scratch
000BADr 1  85 rr                STA     tmp1+1
000BAFr 1               ; clear FCB[0..35]
000BAFr 1  A0 00                LDY     #0
000BB1r 1  98                   TYA
000BB2r 1               @fas_clr:
000BB2r 1  91 rr                STA     (tmp1),y
000BB4r 1  C8                   INY
000BB5r 1  C0 24                CPY     #36
000BB7r 1  90 F9                BCC     @fas_clr
000BB9r 1               ; pad name+ext (FCB[1..11]) with spaces
000BB9r 1  A9 20                LDA     #' '
000BBBr 1  A0 01                LDY     #1
000BBDr 1               @fas_pad:
000BBDr 1  91 rr                STA     (tmp1),y
000BBFr 1  C8                   INY
000BC0r 1  C0 0C                CPY     #12
000BC2r 1  90 F9                BCC     @fas_pad
000BC4r 1               ; walk source string
000BC4r 1  A0 00                LDY     #0
000BC6r 1  B1 rr                LDA     (tmp3),y                ; length
000BC8r 1  8D rr rr             STA     fas_remain
000BCBr 1  A9 01                LDA     #1
000BCDr 1  8D rr rr             STA     fas_si
000BD0r 1  A9 01                LDA     #1
000BD2r 1  8D rr rr             STA     fas_di
000BD5r 1               @fas_name_loop:
000BD5r 1  AD rr rr             LDA     fas_remain
000BD8r 1  F0 5A                BEQ     @fas_zero
000BDAr 1  AC rr rr             LDY     fas_si
000BDDr 1  B1 rr                LDA     (tmp3),y
000BDFr 1  EE rr rr             INC     fas_si
000BE2r 1  CE rr rr             DEC     fas_remain
000BE5r 1  C9 2E                CMP     #'.'
000BE7r 1  F0 1B                BEQ     @fas_to_ext
000BE9r 1  C9 61                CMP     #'a'
000BEBr 1  90 06                BCC     @fas_store_n
000BEDr 1  C9 7B                CMP     #'{'
000BEFr 1  B0 02                BCS     @fas_store_n
000BF1r 1  29 DF                AND     #$DF
000BF3r 1               @fas_store_n:
000BF3r 1  AE rr rr             LDX     fas_di
000BF6r 1  E0 09                CPX     #9
000BF8r 1  B0 DB                BCS     @fas_name_loop
000BFAr 1  AC rr rr             LDY     fas_di
000BFDr 1  91 rr                STA     (tmp1),y
000BFFr 1  EE rr rr             INC     fas_di
000C02r 1  80 D1                BRA     @fas_name_loop
000C04r 1               @fas_to_ext:
000C04r 1  A9 09                LDA     #9
000C06r 1  8D rr rr             STA     fas_di
000C09r 1               @fas_ext_loop:
000C09r 1  AD rr rr             LDA     fas_remain
000C0Cr 1  F0 26                BEQ     @fas_zero
