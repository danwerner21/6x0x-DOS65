000474r 1               ; OP_LEQI ($43) — a <= b  (signed)
000474r 1               op_LEQI:
000474r 1  20 rr rr             jsr     pm_pop          ; b → tmp2
000477r 1  85 rr                sta     tmp2
000479r 1  A5 rr                lda     scratch
