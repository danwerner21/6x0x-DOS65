000C18r 1  rr rr rr rr          .BYTE   >op_LDG,   >op_STG,   >op_LDA_G, >op_UNIMP   ; $18-$1B
000C1Cr 1  rr rr rr rr          .BYTE   >op_UNIMP, >op_UNIMP, >op_UNIMP, >op_UNIMP   ; $1C-$1F
000C20r 1  rr rr rr rr          .BYTE   >op_LDIND, >op_STIND, >op_UNIMP, >op_UNIMP   ; $20-$23
