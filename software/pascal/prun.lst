0014FBr 2  4E 27 20 65  
0014FFr 2  78 70 65 63  
001507r 2               err_expected_to:
001507r 2  27 54 4F 27          .byte "'TO' or 'DOWNTO' expected",0
00150Br 2  20 6F 72 20  
00150Fr 2  27 44 4F 57  
001521r 2               err_expected_un:
001521r 2  27 55 4E 54          .byte "'UNTIL' expected",0
001525r 2  49 4C 27 20  
001529r 2  65 78 70 65  
