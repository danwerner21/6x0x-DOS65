00032Fr 1  60                   rts
000330r 1               
000330r 1               ; neg_tmp2: tmp2 = -tmp2 (16-bit two's complement)
000330r 1               neg_tmp2:
000330r 1  38                   sec
000331r 1  A9 00                lda     #0
000333r 1  E5 rr                sbc     tmp2
