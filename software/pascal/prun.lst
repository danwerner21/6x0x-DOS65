00067Cr 1               ; Saves return IPC into the new frame's AR_RET_ADDR slot, then jumps.
00067Cr 1               op_CALL:
00067Cr 1  20 rr rr             JSR     pm_fetch_word   ; A = offset lo, scratch = offset hi
00067Fr 1  48                   PHA                     ; save offset lo
000680r 1               ; save current IPC (= return address) into MP+AR_RET_ADDR
000680r 1  A0 02                LDY     #AR_RET_ADDR
000682r 1  A5 rr                LDA     pm_ipc
000684r 1  91 rr                STA     (pm_mp),y
000686r 1  C8                   INY
000687r 1  A5 rr                LDA     pm_ipc+1
000689r 1  91 rr                STA     (pm_mp),y
00068Br 1               ; pm_ipc += offset (signed)
00068Br 1  68                   PLA                     ; offset lo
00068Cr 1  18                   CLC
00068Dr 1  65 rr                ADC     pm_ipc
00068Fr 1  85 rr                STA     pm_ipc
000691r 1  A5 rr                LDA     scratch
000693r 1  65 rr                ADC     pm_ipc+1
000695r 1  85 rr                STA     pm_ipc+1
000697r 1  4C rr rr             JMP     prun_loop
00069Ar 1               
00069Ar 1               ; OP_RET ($62) — return from procedure
00069Ar 1               ;   pm_sp ← pm_mp           (collapse frame; discards locals + any junk above)
00069Ar 1               ;   pm_ipc ← MP+AR_RET_ADDR
00069Ar 1               ;   pm_mp  ← MP+AR_DYN_LINK  (saved old MP)
00069Ar 1               op_RET:
00069Ar 1               ; collapse stack first (preserves AR header — still readable via pm_mp)
00069Ar 1  A5 rr                LDA     pm_mp
00069Cr 1  85 rr                STA     pm_sp
00069Er 1  A5 rr                LDA     pm_mp+1
0006A0r 1  85 rr                STA     pm_sp+1
0006A2r 1               ; restore IPC into tmp1 before clobbering MP
0006A2r 1  A0 02                LDY     #AR_RET_ADDR
0006A4r 1  B1 rr                LDA     (pm_mp),y
0006A6r 1  85 rr                STA     tmp1
0006A8r 1  C8                   INY
0006A9r 1  B1 rr                LDA     (pm_mp),y
0006ABr 1  85 rr                STA     tmp1+1
0006ADr 1               ; restore old MP from AR_DYN_LINK
0006ADr 1  A0 01                LDY     #AR_DYN_LINK+1
0006AFr 1  B1 rr                LDA     (pm_mp),y
0006B1r 1  48                   PHA                     ; old MP hi
0006B2r 1  A0 00                LDY     #AR_DYN_LINK
0006B4r 1  B1 rr                LDA     (pm_mp),y
0006B6r 1  85 rr                STA     pm_mp
0006B8r 1  68                   PLA
0006B9r 1  85 rr                STA     pm_mp+1
0006BBr 1               ; install IPC
0006BBr 1  A5 rr                LDA     tmp1
0006BDr 1  85 rr                STA     pm_ipc
0006BFr 1  A5 rr                LDA     tmp1+1
0006C1r 1  85 rr                STA     pm_ipc+1
0006C3r 1  4C rr rr             JMP     prun_loop
0006C6r 1               
0006C6r 1               ; OP_RETF ($63) — return from function: capture AR_RET_VAL, collapse frame,
0006C6r 1               ; restore IPC/MP, then push the captured value onto caller's stack.
0006C6r 1               op_RETF:
0006C6r 1               ; capture return value into tmp0 BEFORE collapsing
0006C6r 1  A0 06                LDY     #AR_RET_VAL
0006C8r 1  B1 rr                LDA     (pm_mp),y
0006CAr 1  85 rr                STA     tmp0
0006CCr 1  C8                   INY
0006CDr 1  B1 rr                LDA     (pm_mp),y
0006CFr 1  85 rr                STA     tmp0+1
0006D1r 1               ; collapse stack to MP
0006D1r 1  A5 rr                LDA     pm_mp
0006D3r 1  85 rr                STA     pm_sp
0006D5r 1  A5 rr                LDA     pm_mp+1
0006D7r 1  85 rr                STA     pm_sp+1
0006D9r 1               ; restore IPC into tmp1
0006D9r 1  A0 02                LDY     #AR_RET_ADDR
0006DBr 1  B1 rr                LDA     (pm_mp),y
0006DDr 1  85 rr                STA     tmp1
0006DFr 1  C8                   INY
0006E0r 1  B1 rr                LDA     (pm_mp),y
0006E2r 1  85 rr                STA     tmp1+1
0006E4r 1               ; restore old MP from AR_DYN_LINK
0006E4r 1  A0 01                LDY     #AR_DYN_LINK+1
0006E6r 1  B1 rr                LDA     (pm_mp),y
0006E8r 1  48                   PHA
0006E9r 1  A0 00                LDY     #AR_DYN_LINK
0006EBr 1  B1 rr                LDA     (pm_mp),y
0006EDr 1  85 rr                STA     pm_mp
0006EFr 1  68                   PLA
0006F0r 1  85 rr                STA     pm_mp+1
0006F2r 1               ; install IPC
0006F2r 1  A5 rr                LDA     tmp1
0006F4r 1  85 rr                STA     pm_ipc
0006F6r 1  A5 rr                LDA     tmp1+1
0006F8r 1  85 rr                STA     pm_ipc+1
0006FAr 1               ; push captured return value (lo in A, hi in scratch)
0006FAr 1  A5 rr                LDA     tmp0+1
0006FCr 1  85 rr                STA     scratch
0006FEr 1  A5 rr                LDA     tmp0
000700r 1  20 rr rr             JSR     pm_push
000703r 1  4C rr rr             JMP     prun_loop
000706r 1               
000706r 1               ; OP_STR ($66) — pop word, store at MP+AR_RET_VAL (function result slot)
000706r 1               op_STR:
000706r 1  20 rr rr             JSR     pm_pop          ; A=lo, scratch=hi
000709r 1  A0 06                LDY     #AR_RET_VAL
00070Br 1  91 rr                STA     (pm_mp),y
00070Dr 1  C8                   INY
00070Er 1  A5 rr                LDA     scratch
000710r 1  91 rr                STA     (pm_mp),y
000712r 1  4C rr rr             JMP     prun_loop
000715r 1               
000715r 1               ; OP_WRITI ($80) — pop integer, print decimal
000715r 1               op_WRITI:
000715r 1  20 rr rr             JSR     pm_pop          ; A=lo, scratch=hi
000718r 1  85 rr                STA     tmp0
00071Ar 1  A5 rr                LDA     scratch
00071Cr 1  85 rr                STA     tmp0+1
00071Er 1  20 rr rr             JSR     console_print_dec
000721r 1  4C rr rr             JMP     prun_loop
000724r 1               
000724r 1               ; OP_WRITC ($81) — pop char, print
000724r 1               op_WRITC:
000724r 1  20 rr rr             JSR     pm_pop
000727r 1  20 rr rr             JSR     console_putc
00072Ar 1  4C rr rr             JMP     prun_loop
00072Dr 1               
00072Dr 1               ; OP_WRITB ($82) — pop boolean, print TRUE/FALSE
00072Dr 1               op_WRITB:
00072Dr 1  20 rr rr             JSR     pm_pop
000730r 1  05 rr                ORA     scratch
000732r 1  F0 0E                BEQ     @false3
000734r 1  A9 rr                LDA     #<str_true
000736r 1  85 rr                STA     tmp0
000738r 1  A9 rr                LDA     #>str_true
00073Ar 1  85 rr                STA     tmp0+1
00073Cr 1  20 rr rr             JSR     console_print_sz
00073Fr 1  4C rr rr             JMP     prun_loop
000742r 1               @false3:
000742r 1  A9 rr                LDA     #<str_false
000744r 1  85 rr                STA     tmp0
000746r 1  A9 rr                LDA     #>str_false
000748r 1  85 rr                STA     tmp0+1
00074Ar 1  20 rr rr             JSR     console_print_sz
00074Dr 1  4C rr rr             JMP     prun_loop
000750r 1               
000750r 1               ; OP_WRITS ($83) — TOS = address of length-prefixed string, print it
000750r 1               op_WRITS:
000750r 1  20 rr rr             JSR     pm_pop
000753r 1  85 rr                STA     tmp0
000755r 1  A5 rr                LDA     scratch
000757r 1  85 rr                STA     tmp0+1
000759r 1  20 rr rr             JSR     console_print_pstr
00075Cr 1  4C rr rr             JMP     prun_loop
00075Fr 1               
00075Fr 1               ; OP_WRITLN ($84) — newline
00075Fr 1               op_WRITLN:
00075Fr 1  20 rr rr             JSR     console_newline
000762r 1  4C rr rr             JMP     prun_loop
000765r 1               
000765r 1               ; OP_READI ($85) — TOS = address of INTEGER variable.  Read a line from
000765r 1               ; the console, parse a signed decimal integer, store as a 16-bit word at
000765r 1               ; the popped address.
000765r 1               op_READI:
000765r 1  20 rr rr             JSR     pm_pop          ; A=lo addr, scratch=hi addr
000768r 1  85 rr                STA     tmp1            ; (zero-page) destination pointer
00076Ar 1  A5 rr                LDA     scratch
00076Cr 1  85 rr                STA     tmp1+1
00076Er 1               ; read one line into read_line_buf
00076Er 1  A9 rr                LDA     #<read_line_buf
000770r 1  85 rr                STA     tmp0
000772r 1  A9 rr                LDA     #>read_line_buf
000774r 1  85 rr                STA     tmp0+1
000776r 1  A2 1F                LDX     #31             ; max line length
000778r 1  20 rr rr             JSR     console_read_line; Y = length on return
00077Br 1  8C rr rr             STY     read_len
00077Er 1  20 rr rr             JSR     console_newline ; PEM CONIN echoes CR but no LF
000781r 1               ; parse signed decimal from read_line_buf into tmp2:tmp2+1
000781r 1  A9 00                LDA     #0
000783r 1  85 rr                STA     tmp2
000785r 1  85 rr                STA     tmp2+1
000787r 1  8D rr rr             STA     read_neg
00078Ar 1  A0 00                LDY     #0
00078Cr 1               @rd_skip:
00078Cr 1  CC rr rr             CPY     read_len
00078Fr 1  B0 67                BCS     @rd_apply_sign  ; empty / all-space → 0
000791r 1  B9 rr rr             LDA     read_line_buf,y
000794r 1  C9 20                CMP     #' '
000796r 1  D0 04                BNE     @rd_chk_sign
000798r 1  C8                   INY
000799r 1  4C rr rr             JMP     @rd_skip
00079Cr 1               @rd_chk_sign:
00079Cr 1  C9 2D                CMP     #'-'
00079Er 1  D0 09                BNE     @rd_chk_plus
0007A0r 1  A9 01                LDA     #1
0007A2r 1  8D rr rr             STA     read_neg
0007A5r 1  C8                   INY
0007A6r 1  4C rr rr             JMP     @rd_digits
0007A9r 1               @rd_chk_plus:
0007A9r 1  C9 2B                CMP     #'+'
0007ABr 1  D0 01                BNE     @rd_digits
0007ADr 1  C8                   INY
0007AEr 1               @rd_digits:
0007AEr 1  CC rr rr             CPY     read_len
0007B1r 1  B0 45                BCS     @rd_apply_sign
0007B3r 1  B9 rr rr             LDA     read_line_buf,y
0007B6r 1  C9 30                CMP     #'0'
0007B8r 1  90 3E                BCC     @rd_apply_sign
0007BAr 1  C9 3A                CMP     #'9'+1
0007BCr 1  B0 3A                BCS     @rd_apply_sign
0007BEr 1               ; tmp2 *= 10  (using temp = tmp2*2; tmp2 = (tmp2*2)*4 + temp)
0007BEr 1  06 rr                ASL     tmp2
0007C0r 1  26 rr                ROL     tmp2+1
0007C2r 1  A5 rr                LDA     tmp2
0007C4r 1  8D rr rr             STA     read_save2
0007C7r 1  A5 rr                LDA     tmp2+1
0007C9r 1  8D rr rr             STA     read_save2+1
0007CCr 1  06 rr                ASL     tmp2
0007CEr 1  26 rr                ROL     tmp2+1
0007D0r 1  06 rr                ASL     tmp2
0007D2r 1  26 rr                ROL     tmp2+1
0007D4r 1  18                   CLC
0007D5r 1  A5 rr                LDA     tmp2
0007D7r 1  6D rr rr             ADC     read_save2
0007DAr 1  85 rr                STA     tmp2
0007DCr 1  A5 rr                LDA     tmp2+1
0007DEr 1  6D rr rr             ADC     read_save2+1
0007E1r 1  85 rr                STA     tmp2+1
0007E3r 1               ; tmp2 += digit
0007E3r 1  B9 rr rr             LDA     read_line_buf,y
0007E6r 1  38                   SEC
0007E7r 1  E9 30                SBC     #'0'
0007E9r 1  18                   CLC
0007EAr 1  65 rr                ADC     tmp2
0007ECr 1  85 rr                STA     tmp2
0007EEr 1  A9 00                LDA     #0
0007F0r 1  65 rr                ADC     tmp2+1
0007F2r 1  85 rr                STA     tmp2+1
0007F4r 1  C8                   INY
0007F5r 1  4C rr rr             JMP     @rd_digits
0007F8r 1               @rd_apply_sign:
0007F8r 1  AD rr rr             LDA     read_neg
0007FBr 1  F0 0D                BEQ     @rd_store
0007FDr 1  38                   SEC
0007FEr 1  A9 00                LDA     #0
000800r 1  E5 rr                SBC     tmp2
000802r 1  85 rr                STA     tmp2
000804r 1  A9 00                LDA     #0
000806r 1  E5 rr                SBC     tmp2+1
000808r 1  85 rr                STA     tmp2+1
00080Ar 1               @rd_store:
00080Ar 1  A0 00                LDY     #0
00080Cr 1  A5 rr                LDA     tmp2
00080Er 1  91 rr                STA     (tmp1),y
000810r 1  C8                   INY
000811r 1  A5 rr                LDA     tmp2+1
000813r 1  91 rr                STA     (tmp1),y
000815r 1  4C rr rr             JMP     prun_loop
000818r 1               
000818r 1               read_line_buf:
000818r 1  xx xx xx xx          .RES    32
00081Cr 1  xx xx xx xx  
000820r 1  xx xx xx xx  
000838r 1               read_len:
000838r 1  xx                   .RES    1
000839r 1               read_neg:
000839r 1  xx                   .RES    1
00083Ar 1               read_save2:
00083Ar 1  xx xx                .RES    2
00083Cr 1               
00083Cr 1               ; OP_READC ($86) — read char from console, push
00083Cr 1               op_READC:
00083Cr 1  A2 01 20 03          PEM     PEM_CONIN
000840r 1  01           
000841r 1  48                   PHA
000842r 1  A9 00                LDA     #0
000844r 1  85 rr                STA     scratch
000846r 1  68                   PLA
000847r 1  20 rr rr             JSR     pm_push
00084Ar 1  4C rr rr             JMP     prun_loop
00084Dr 1               
00084Dr 1               ; OP_DUP ($90) — duplicate TOS
00084Dr 1               op_DUP:
00084Dr 1  20 rr rr             JSR     pm_peek
000850r 1  20 rr rr             JSR     pm_push
000853r 1  4C rr rr             JMP     prun_loop
000856r 1               
000856r 1               ; OP_POP ($91) — discard TOS
000856r 1               op_POP:
000856r 1  20 rr rr             JSR     pm_pop
000859r 1  4C rr rr             JMP     prun_loop
00085Cr 1               
00085Cr 1               ; ---------------------------------------------------------------------------
00085Cr 1               ; String built-in support
00085Cr 1               ;
00085Cr 1               ; Pascal-style strings: length byte at offset 0, characters at offsets 1..N.
00085Cr 1               ; COPY/CONCAT results live in one of three rotating 256-byte work buffers
00085Cr 1               ; placed in unused heap-area memory.  Round-robin allocation lets simple
00085Cr 1               ; nested expressions like CONCAT(COPY(s,1,3), 'x') work; deeper nesting
00085Cr 1               ; eventually recycles a buffer and corrupts an earlier result.
00085Cr 1               ; ---------------------------------------------------------------------------
00085Cr 1               STR_WORK_BASE   = $AD00
00085Cr 1               STR_WORK_COUNT  = 3
00085Cr 1               
00085Cr 1               str_work_idx:
00085Cr 1  xx                   .RES    1
00085Dr 1               
00085Dr 1               ; next_work_buf — return current work-buffer addr in tmp1, advance idx
00085Dr 1               next_work_buf:
00085Dr 1  AD rr rr             LDA     str_work_idx
000860r 1  18                   CLC
000861r 1  69 AD                ADC     #>STR_WORK_BASE
000863r 1  85 rr                STA     tmp1+1
000865r 1  A9 00                LDA     #0
000867r 1  85 rr                STA     tmp1
000869r 1  EE rr rr             INC     str_work_idx
00086Cr 1  AD rr rr             LDA     str_work_idx
00086Fr 1  C9 03                CMP     #STR_WORK_COUNT
000871r 1  90 05                BCC     :+
000873r 1  A9 00                LDA     #0
000875r 1  8D rr rr             STA     str_work_idx
000878r 1  60           :       RTS
000879r 1               
000879r 1               ; OP_LEN ($A0) — TOS = string ptr → TOS = length (int)
000879r 1               op_LEN:
000879r 1  20 rr rr             JSR     pm_pop          ; A=lo, scratch=hi
00087Cr 1  85 rr                STA     tmp1
00087Er 1  A5 rr                LDA     scratch
000880r 1  85 rr                STA     tmp1+1
000882r 1  A0 00                LDY     #0
000884r 1  B1 rr                LDA     (tmp1),y        ; length byte
000886r 1  48                   PHA
000887r 1  A9 00                LDA     #0
000889r 1  85 rr                STA     scratch
00088Br 1  68                   PLA
00088Cr 1  20 rr rr             JSR     pm_push
00088Fr 1  4C rr rr             JMP     prun_loop
000892r 1               
000892r 1               ; OP_POS ($A1) — NOS=substr ptr, TOS=mainstr ptr → TOS=1-based position
000892r 1               op_POS:
000892r 1  20 rr rr             JSR     pm_pop          ; mainstr → tmp2
000895r 1  85 rr                STA     tmp2
000897r 1  A5 rr                LDA     scratch
000899r 1  85 rr                STA     tmp2+1
00089Br 1  20 rr rr             JSR     pm_pop          ; substr → tmp1
00089Er 1  85 rr                STA     tmp1
0008A0r 1  A5 rr                LDA     scratch
0008A2r 1  85 rr                STA     tmp1+1
0008A4r 1               ; If substr length is 0, return 0
0008A4r 1  A0 00                LDY     #0
0008A6r 1  B1 rr                LDA     (tmp1),y
0008A8r 1  D0 03                BNE     :+
0008AAr 1  4C rr rr             JMP     @pos_zero
0008ADr 1               :
0008ADr 1               ; sublen in pos_sublen, mainlen in pos_mainlen
0008ADr 1  8D rr rr             STA     pos_sublen
0008B0r 1  A0 00                LDY     #0
0008B2r 1  B1 rr                LDA     (tmp2),y
0008B4r 1  8D rr rr             STA     pos_mainlen
0008B7r 1               ; If sublen > mainlen, return 0
0008B7r 1  AD rr rr             LDA     pos_sublen
0008BAr 1  CD rr rr             CMP     pos_mainlen
0008BDr 1  F0 02                BEQ     :+
0008BFr 1  B0 4D                BCS     @pos_zero
0008C1r 1               :
0008C1r 1               ; pos_start = 1; loop while (pos_start + sublen - 1) <= mainlen
0008C1r 1  A9 01                LDA     #1
0008C3r 1  8D rr rr             STA     pos_start
0008C6r 1               @pos_outer:
0008C6r 1               ; max_start = mainlen - sublen + 1
0008C6r 1  AD rr rr             LDA     pos_mainlen
0008C9r 1  38                   SEC
0008CAr 1  ED rr rr             SBC     pos_sublen
0008CDr 1  18                   CLC
0008CEr 1  69 01                ADC     #1              ; A = max valid start
0008D0r 1  CD rr rr             CMP     pos_start
0008D3r 1  90 39                BCC     @pos_zero       ; pos_start > max_start → not found
0008D5r 1               ; compare sublen bytes at main[pos_start..] vs sub[1..]
0008D5r 1  A2 00                LDX     #0              ; substr offset (0..sublen-1, +1 to skip len byte)
0008D7r 1               @pos_cmp:
0008D7r 1  EC rr rr             CPX     pos_sublen
0008DAr 1  F0 1F                BEQ     @pos_found
0008DCr 1  8A                   TXA
0008DDr 1  18                   CLC
0008DEr 1  6D rr rr             ADC     pos_start       ; main index = pos_start + X
0008E1r 1  A8                   TAY
0008E2r 1  B1 rr                LDA     (tmp2),y        ; main[pos_start+X]
0008E4r 1  8D rr rr             STA     pos_save
0008E7r 1  8A                   TXA
0008E8r 1  18                   CLC
0008E9r 1  69 01                ADC     #1              ; sub index = X + 1
0008EBr 1  A8                   TAY
0008ECr 1  B1 rr                LDA     (tmp1),y        ; sub[X+1]
0008EEr 1  CD rr rr             CMP     pos_save
0008F1r 1  D0 03                BNE     @pos_next
0008F3r 1  E8                   INX
0008F4r 1  80 E1                BRA     @pos_cmp
0008F6r 1               @pos_next:
0008F6r 1  EE rr rr             INC     pos_start
0008F9r 1  80 CB                BRA     @pos_outer
0008FBr 1               @pos_found:
0008FBr 1  AD rr rr             LDA     pos_start
0008FEr 1  8D rr rr             STA     pos_save
000901r 1  A9 00                LDA     #0
000903r 1  85 rr                STA     scratch
000905r 1  AD rr rr             LDA     pos_save
000908r 1  20 rr rr             JSR     pm_push
00090Br 1  4C rr rr             JMP     prun_loop
00090Er 1               @pos_zero:
00090Er 1  A9 00                LDA     #0
000910r 1  85 rr                STA     scratch
000912r 1  20 rr rr             JSR     pm_push
000915r 1  4C rr rr             JMP     prun_loop
000918r 1               
000918r 1  xx           pos_sublen:    .RES 1
000919r 1  xx           pos_mainlen:   .RES 1
00091Ar 1  xx           pos_start:     .RES 1
00091Br 1  xx           pos_save:      .RES 1
00091Cr 1               
00091Cr 1               ; OP_COPY ($A2) — NNOS=str, NOS=index (1-based), TOS=count → TOS=result strptr
00091Cr 1               op_COPY:
00091Cr 1  20 rr rr             JSR     pm_pop          ; count
00091Fr 1  8D rr rr             STA     copy_count
000922r 1  20 rr rr             JSR     pm_pop          ; index
000925r 1  8D rr rr             STA     copy_index
000928r 1  20 rr rr             JSR     pm_pop          ; source ptr
00092Br 1  85 rr                STA     tmp2
00092Dr 1  A5 rr                LDA     scratch
00092Fr 1  85 rr                STA     tmp2+1
000931r 1  20 rr rr             JSR     next_work_buf   ; tmp1 = dest buffer
000934r 1               ; clamp index: if index < 1 or index > srclen, result is empty
000934r 1  A0 00                LDY     #0
000936r 1  B1 rr                LDA     (tmp2),y
000938r 1  8D rr rr             STA     copy_srclen
00093Br 1  AD rr rr             LDA     copy_index
00093Er 1  F0 4A                BEQ     @copy_empty
000940r 1  CD rr rr             CMP     copy_srclen
000943r 1  F0 02                BEQ     :+
000945r 1  B0 43                BCS     @copy_empty
000947r 1               :
000947r 1               ; available = srclen - index + 1
000947r 1  AD rr rr             LDA     copy_srclen
00094Ar 1  38                   SEC
00094Br 1  ED rr rr             SBC     copy_index
00094Er 1  18                   CLC
00094Fr 1  69 01                ADC     #1
000951r 1  8D rr rr             STA     copy_avail
000954r 1               ; actual = min(count, available)
000954r 1  AD rr rr             LDA     copy_count
000957r 1  CD rr rr             CMP     copy_avail
00095Ar 1  90 03                BCC     :+
00095Cr 1  AD rr rr             LDA     copy_avail
00095Fr 1  8D rr rr     :       STA     copy_actual
000962r 1               ; copy actual bytes from src[index..] into dest[1..]
000962r 1  A2 00                LDX     #0
000964r 1               @copy_loop:
000964r 1  EC rr rr             CPX     copy_actual
000967r 1  F0 18                BEQ     @copy_done
000969r 1  8A                   TXA
00096Ar 1  18                   CLC
00096Br 1  6D rr rr             ADC     copy_index      ; src offset = X + index
00096Er 1  A8                   TAY
00096Fr 1  B1 rr                LDA     (tmp2),y
000971r 1  8D rr rr             STA     copy_save
000974r 1  8A                   TXA
000975r 1  18                   CLC
000976r 1  69 01                ADC     #1              ; dest offset = X + 1
000978r 1  A8                   TAY
000979r 1  AD rr rr             LDA     copy_save
00097Cr 1  91 rr                STA     (tmp1),y
00097Er 1  E8                   INX
00097Fr 1  80 E3                BRA     @copy_loop
000981r 1               @copy_done:
000981r 1  AD rr rr             LDA     copy_actual
000984r 1  A0 00                LDY     #0
000986r 1  91 rr                STA     (tmp1),y        ; write length byte
000988r 1  80 06                BRA     @copy_push
00098Ar 1               @copy_empty:
00098Ar 1  A9 00                LDA     #0
00098Cr 1  A0 00                LDY     #0
00098Er 1  91 rr                STA     (tmp1),y
000990r 1               @copy_push:
000990r 1  A5 rr                LDA     tmp1+1
000992r 1  85 rr                STA     scratch
000994r 1  A5 rr                LDA     tmp1
000996r 1  20 rr rr             JSR     pm_push
000999r 1  4C rr rr             JMP     prun_loop
00099Cr 1               
00099Cr 1  xx           copy_count:    .RES 1
00099Dr 1  xx           copy_index:    .RES 1
00099Er 1  xx           copy_srclen:   .RES 1
00099Fr 1  xx           copy_avail:    .RES 1
0009A0r 1  xx           copy_actual:   .RES 1
0009A1r 1  xx           copy_save:     .RES 1
0009A2r 1               
0009A2r 1               ; OP_CONCAT ($A3) — NOS=s1, TOS=s2 → TOS=result strptr (s1 then s2)
0009A2r 1               op_CONCAT:
0009A2r 1  20 rr rr             JSR     pm_pop          ; s2 → tmp2
0009A5r 1  85 rr                STA     tmp2
0009A7r 1  A5 rr                LDA     scratch
0009A9r 1  85 rr                STA     tmp2+1
0009ABr 1               ; stash s2 ptr in cat_s2 because next_work_buf and pm_pop touch tmp1
0009ABr 1  A5 rr                LDA     tmp2
0009ADr 1  8D rr rr             STA     cat_s2
0009B0r 1  A5 rr                LDA     tmp2+1
0009B2r 1  8D rr rr             STA     cat_s2+1
0009B5r 1  20 rr rr             JSR     pm_pop          ; s1 → tmp2
0009B8r 1  85 rr                STA     tmp2
0009BAr 1  A5 rr                LDA     scratch
0009BCr 1  85 rr                STA     tmp2+1
0009BEr 1  A5 rr                LDA     tmp2
0009C0r 1  8D rr rr             STA     cat_s1
0009C3r 1  A5 rr                LDA     tmp2+1
0009C5r 1  8D rr rr             STA     cat_s1+1
0009C8r 1  20 rr rr             JSR     next_work_buf   ; tmp1 = dest
0009CBr 1               ; copy s1 chars
0009CBr 1  AD rr rr             LDA     cat_s1
0009CEr 1  85 rr                STA     tmp2
0009D0r 1  AD rr rr             LDA     cat_s1+1
0009D3r 1  85 rr                STA     tmp2+1
0009D5r 1  A0 00                LDY     #0
0009D7r 1  B1 rr                LDA     (tmp2),y
0009D9r 1  8D rr rr             STA     cat_s1len
0009DCr 1  AA                   TAX                     ; X = remaining
0009DDr 1  A0 01                LDY     #1              ; src offset
0009DFr 1  A9 01                LDA     #1
0009E1r 1  8D rr rr             STA     cat_dstoff
0009E4r 1               @cat_s1_loop:
0009E4r 1  E0 00                CPX     #0
0009E6r 1  F0 18                BEQ     @cat_s2_start
0009E8r 1  B1 rr                LDA     (tmp2),y
0009EAr 1  8D rr rr             STA     cat_save
0009EDr 1  DA                   PHX
0009EEr 1  5A                   PHY
0009EFr 1  AC rr rr             LDY     cat_dstoff
0009F2r 1  AD rr rr             LDA     cat_save
0009F5r 1  91 rr                STA     (tmp1),y
0009F7r 1  EE rr rr             INC     cat_dstoff
0009FAr 1  7A                   PLY
0009FBr 1  FA                   PLX
0009FCr 1  C8                   INY
0009FDr 1  CA                   DEX
0009FEr 1  80 E4                BRA     @cat_s1_loop
000A00r 1               @cat_s2_start:
000A00r 1  AD rr rr             LDA     cat_s2
000A03r 1  85 rr                STA     tmp2
000A05r 1  AD rr rr             LDA     cat_s2+1
000A08r 1  85 rr                STA     tmp2+1
000A0Ar 1  A0 00                LDY     #0
000A0Cr 1  B1 rr                LDA     (tmp2),y
000A0Er 1  8D rr rr             STA     cat_s2len
000A11r 1  AA                   TAX
000A12r 1  A0 01                LDY     #1
000A14r 1               @cat_s2_loop:
000A14r 1  E0 00                CPX     #0
000A16r 1  F0 18                BEQ     @cat_done
000A18r 1  B1 rr                LDA     (tmp2),y
000A1Ar 1  8D rr rr             STA     cat_save
000A1Dr 1  DA                   PHX
000A1Er 1  5A                   PHY
000A1Fr 1  AC rr rr             LDY     cat_dstoff
000A22r 1  AD rr rr             LDA     cat_save
000A25r 1  91 rr                STA     (tmp1),y
000A27r 1  EE rr rr             INC     cat_dstoff
000A2Ar 1  7A                   PLY
000A2Br 1  FA                   PLX
000A2Cr 1  C8                   INY
000A2Dr 1  CA                   DEX
000A2Er 1  80 E4                BRA     @cat_s2_loop
000A30r 1               @cat_done:
000A30r 1               ; total length = s1len + s2len (capped at 255)
000A30r 1  18                   CLC
000A31r 1  AD rr rr             LDA     cat_s1len
000A34r 1  6D rr rr             ADC     cat_s2len
000A37r 1  90 02                BCC     :+
000A39r 1  A9 FF                LDA     #255
000A3Br 1  A0 00        :       LDY     #0
000A3Dr 1  91 rr                STA     (tmp1),y
000A3Fr 1  A5 rr                LDA     tmp1+1
000A41r 1  85 rr                STA     scratch
000A43r 1  A5 rr                LDA     tmp1
000A45r 1  20 rr rr             JSR     pm_push
000A48r 1  4C rr rr             JMP     prun_loop
000A4Br 1               
000A4Br 1  xx xx        cat_s1:        .RES 2
000A4Dr 1  xx xx        cat_s2:        .RES 2
000A4Fr 1  xx           cat_s1len:     .RES 1
000A50r 1  xx           cat_s2len:     .RES 1
000A51r 1  xx           cat_dstoff:    .RES 1
000A52r 1  xx           cat_save:      .RES 1
000A53r 1               
000A53r 1               ; ---------------------------------------------------------------------------
000A53r 1               ; Unimplemented opcode handler
000A53r 1               ; ---------------------------------------------------------------------------
000A53r 1               op_UNIMP:
000A53r 1  A9 rr                LDA     #<err_rt_opcode
000A55r 1  85 rr                STA     tmp0
000A57r 1  A9 rr                LDA     #>err_rt_opcode
000A59r 1  85 rr                STA     tmp0+1
000A5Br 1  20 rr rr             JSR     rt_error
000A5Er 1               ; rt_error does not return (jumps to warm boot)
000A5Er 1               
000A5Er 1               ; ---------------------------------------------------------------------------
000A5Er 1               ; String literals for boolean output
000A5Er 1               ; ---------------------------------------------------------------------------
000A5Er 1               str_true:
000A5Er 1  54 52 55 45          .BYTE   "TRUE",0
000A62r 1  00           
000A63r 1               str_false:
000A63r 1  46 41 4C 53          .BYTE   "FALSE",0
000A67r 1  45 00        
000A69r 1               msg_rt_banner:
000A69r 1  50 52 55 4E          .BYTE   "PRUN v0.1 - Pascal P-Code Runtime for DOS/65",13,10,0
000A6Dr 1  20 76 30 2E  
000A71r 1  31 20 2D 20  
000A98r 1               
000A98r 1               ; ---------------------------------------------------------------------------
000A98r 1               ; Dispatch table — 256 entries of (lo, hi) pointer pairs
000A98r 1               ; ---------------------------------------------------------------------------
000A98r 1  xx xx xx xx          .align  256
000A9Cr 1  xx xx xx xx  
000AA0r 1  xx xx xx xx  
000B00r 1               dispatch_lo:
000B00r 1               ; $00-$07
000B00r 1  rr rr rr rr          .BYTE   <op_LDCI,  <op_LDCW,  <op_LDCC,  <op_LDCB
000B04r 1  rr rr rr rr          .BYTE   <op_LDCS,  <op_LDCN,  <op_UNIMP, <op_UNIMP
000B08r 1               ; $08-$0F
000B08r 1  rr rr rr rr          .REPEAT 8
000B0Cr 1  rr rr rr rr  
000B10r 1                               .BYTE   <op_UNIMP
000B10r 1                       .ENDREPEAT
000B10r 1               ; $10-$17
000B10r 1  rr rr rr rr          .BYTE   <op_LDL,   <op_STL,   <op_LDA_L, <op_UNIMP
000B14r 1  rr rr rr rr          .REPEAT 4
000B18r 1                               .BYTE   <op_UNIMP
000B18r 1                       .ENDREPEAT
000B18r 1               ; $18-$2F
000B18r 1  rr rr rr rr          .BYTE   <op_LDG,   <op_STG,   <op_LDA_G, <op_UNIMP   ; $18-$1B
000B1Cr 1  rr rr rr rr          .BYTE   <op_UNIMP, <op_UNIMP, <op_UNIMP, <op_UNIMP   ; $1C-$1F
000B20r 1  rr rr rr rr          .BYTE   <op_LDIND, <op_STIND, <op_UNIMP, <op_UNIMP   ; $20-$23
000B24r 1  rr                   .BYTE   <op_INDEX                                      ; $24
000B25r 1  rr rr rr rr          .REPEAT 11
000B29r 1  rr rr rr rr  
000B2Dr 1  rr rr rr     
000B30r 1                               .BYTE   <op_UNIMP
000B30r 1                       .ENDREPEAT
000B30r 1               ; $30-$3F
000B30r 1  rr rr rr rr          .BYTE   <op_ADI,   <op_SBI,   <op_MPI,   <op_DVI
000B34r 1  rr rr rr rr          .BYTE   <op_MOD,   <op_NGI,   <op_UNIMP, <op_UNIMP
000B38r 1  rr rr rr rr          .REPEAT 8
000B3Cr 1  rr rr rr rr  
000B40r 1                               .BYTE   <op_UNIMP
000B40r 1                       .ENDREPEAT
000B40r 1               ; $40-$4F
