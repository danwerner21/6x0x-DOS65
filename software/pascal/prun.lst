000770r 1  rr rr rr rr          .repeat 16
000774r 1  rr rr rr rr  
000778r 1  rr rr rr rr  
000780r 1                       .byte <op_UNIMP
000780r 1                       .endrepeat
000780r 1                       ; $80-$8F
000780r 1  rr rr rr rr          .byte <op_WRITI, <op_WRITC, <op_WRITB, <op_WRITS
000784r 1  rr rr rr rr          .byte <op_WRITLN,<op_READI, <op_READC, <op_UNIMP
000788r 1  rr rr rr rr          .repeat 8
00078Cr 1  rr rr rr rr  
000790r 1                       .byte <op_UNIMP
000790r 1                       .endrepeat
000790r 1                       ; $90-$FE
000790r 1  rr rr rr rr          .byte <op_DUP,   <op_POP,   <op_UNIMP, <op_UNIMP
000794r 1  rr rr rr rr          .repeat 107
000798r 1  rr rr rr rr  
00079Cr 1  rr rr rr rr  
0007FFr 1                       .byte <op_UNIMP
0007FFr 1                       .endrepeat
0007FFr 1                       ; $FF
0007FFr 1  rr                   .byte <op_HALT
000800r 1               
000800r 1               dispatch_hi:
000800r 1                       ; $00-$07
000800r 1  rr rr rr rr          .byte >op_LDCI,  >op_LDCW,  >op_LDCC,  >op_LDCB
000804r 1  rr rr rr rr          .byte >op_UNIMP, >op_LDCN,  >op_UNIMP, >op_UNIMP
000808r 1                       ; $08-$0F
000808r 1  rr rr rr rr          .repeat 8
00080Cr 1  rr rr rr rr  
000810r 1                       .byte >op_UNIMP
000810r 1                       .endrepeat
000810r 1                       ; $10-$17
000810r 1  rr rr rr rr          .byte >op_LDL,   >op_STL,   >op_UNIMP, >op_UNIMP
000814r 1  rr rr rr rr          .repeat 4
000818r 1                       .byte >op_UNIMP
000818r 1                       .endrepeat
000818r 1                       ; $18-$2F
000818r 1  rr rr                .byte >op_LDG,   >op_STG
00081Ar 1  rr rr rr rr          .repeat 22
00081Er 1  rr rr rr rr  
000822r 1  rr rr rr rr  
000830r 1                       .byte >op_UNIMP
000830r 1                       .endrepeat
000830r 1                       ; $30-$3F
000830r 1  rr rr rr rr          .byte >op_ADI,   >op_SBI,   >op_MPI,   >op_DVI
000834r 1  rr rr rr rr          .byte >op_MOD,   >op_NGI,   >op_UNIMP, >op_UNIMP
000838r 1  rr rr rr rr          .repeat 8
00083Cr 1  rr rr rr rr  
000840r 1                       .byte >op_UNIMP
000840r 1                       .endrepeat
000840r 1                       ; $40-$4F
000840r 1  rr rr rr rr          .byte >op_EQUI,  >op_NEQI,  >op_LESI,  >op_LEQI
000844r 1  rr rr rr rr          .byte >op_GTRI,  >op_GEQI,  >op_UNIMP, >op_UNIMP
000848r 1  rr rr rr rr          .repeat 8
00084Cr 1  rr rr rr rr  
000850r 1                       .byte >op_UNIMP
000850r 1                       .endrepeat
000850r 1                       ; $50-$5F
000850r 1  rr rr rr rr          .byte >op_UJP,   >op_FJP,   >op_TJP,   >op_UNIMP
000854r 1  rr rr rr rr          .repeat 12
000858r 1  rr rr rr rr  
00085Cr 1  rr rr rr rr  
000860r 1                       .byte >op_UNIMP
000860r 1                       .endrepeat
000860r 1                       ; $60-$6F
000860r 1  rr rr rr rr          .byte >op_CALL,  >op_UNIMP, >op_RET,   >op_UNIMP
000864r 1  rr rr rr rr          .byte >op_MRKSTK,>op_UNIMP, >op_UNIMP, >op_UNIMP
000868r 1  rr rr rr rr          .repeat 8
00086Cr 1  rr rr rr rr  
000870r 1                       .byte >op_UNIMP
000870r 1                       .endrepeat
000870r 1                       ; $70-$7F
000870r 1  rr rr rr rr          .repeat 16
000874r 1  rr rr rr rr  
000878r 1  rr rr rr rr  
000880r 1                       .byte >op_UNIMP
000880r 1                       .endrepeat
000880r 1                       ; $80-$8F
000880r 1  rr rr rr rr          .byte >op_WRITI, >op_WRITC, >op_WRITB, >op_WRITS
000884r 1  rr rr rr rr          .byte >op_WRITLN,>op_READI, >op_READC, >op_UNIMP
000888r 1  rr rr rr rr          .repeat 8
00088Cr 1  rr rr rr rr  
000890r 1                       .byte >op_UNIMP
000890r 1                       .endrepeat
000890r 1                       ; $90-$FE
000890r 1  rr rr rr rr          .byte >op_DUP,   >op_POP,   >op_UNIMP, >op_UNIMP
000894r 1  rr rr rr rr          .repeat 107
000898r 1  rr rr rr rr  
00089Cr 1  rr rr rr rr  
