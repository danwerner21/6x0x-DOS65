000291r 1  85 rr                sta     scratch
000293r 1  68                   pla
000294r 1  20 rr rr             jsr     pm_push
000297r 1  4C rr rr             jmp     prun_loop
00029Ar 1               
00029Ar 1               ; OP_SBI ($31) — integer subtract
00029Ar 1               op_SBI:
00029Ar 1  20 rr rr             jsr     pm_pop          ; b: A=lo, scratch=hi
00029Dr 1  85 rr                sta     tmp2
00029Fr 1  A5 rr                lda     scratch
0002A1r 1  85 rr                sta     tmp2+1
0002A3r 1  20 rr rr             jsr     pm_pop          ; a: A=lo, scratch=hi
0002A6r 1  38                   sec
0002A7r 1  E5 rr                sbc     tmp2            ; a.lo - b.lo
0002A9r 1  48                   pha
0002AAr 1  A5 rr                lda     scratch
0002ACr 1  E5 rr                sbc     tmp2+1          ; a.hi - b.hi - borrow
0002AEr 1  85 rr                sta     scratch
0002B0r 1  68                   pla
0002B1r 1  20 rr rr             jsr     pm_push
0002B4r 1  4C rr rr             jmp     prun_loop
0002B7r 1               
0002B7r 1               ; OP_NGI ($35) — negate TOS
0002B7r 1               op_NGI:
0002B7r 1  20 rr rr             jsr     pm_pop          ; A=lo, scratch=hi
