000D00r 1  85 rr                STA     tmp2
000D02r 1  A5 rr                LDA     tmp1+1
000D04r 1  69 00                ADC     #0
000D06r 1  85 rr                STA     tmp2+1
000D08r 1  A0 A5                LDY     #F_POS
000D0Ar 1  B1 rr                LDA     (tmp1),y
000D0Cr 1  A8                   TAY
000D0Dr 1               @fclo_pad:
