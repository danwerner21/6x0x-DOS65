000212r 1  B1 rr                lda     (tmp1),y
000214r 1  48                   pha
000215r 1  C8                   iny
000216r 1  B1 rr                lda     (tmp1),y
000218r 1  85 rr                sta     scratch
00021Ar 1  68                   pla
00021Br 1  20 rr rr             jsr     pm_push
00021Er 1  4C rr rr             jmp     prun_loop
000221r 1               
000221r 1               ; OP_STL ($11) — pop into 16-bit local var
000221r 1               op_STL:
