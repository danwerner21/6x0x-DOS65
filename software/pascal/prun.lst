000B44r 1  rr rr rr rr          .BYTE   <op_GTRI,  <op_GEQI,  <op_UNIMP, <op_UNIMP
000B48r 1  rr rr rr rr          .REPEAT 8
000B4Cr 1  rr rr rr rr  
000B50r 1                               .BYTE   <op_UNIMP
000B50r 1                       .ENDREPEAT
000B50r 1               ; $50-$5F
000B50r 1  rr rr rr rr          .BYTE   <op_UJP,   <op_FJP,   <op_TJP,   <op_UNIMP
000B54r 1  rr rr rr rr          .REPEAT 12
000B58r 1  rr rr rr rr  
000B5Cr 1  rr rr rr rr  
000B60r 1                               .BYTE   <op_UNIMP
000B60r 1                       .ENDREPEAT
000B60r 1               ; $60-$6F
000B60r 1  rr rr rr rr          .BYTE   <op_CALL,  <op_UNIMP, <op_RET,   <op_RETF
000B64r 1  rr rr rr rr          .BYTE   <op_MRKSTK,<op_UNIMP, <op_STR,   <op_UNIMP
000B68r 1  rr rr rr rr          .REPEAT 8
000B6Cr 1  rr rr rr rr  
000B70r 1                               .BYTE   <op_UNIMP
000B70r 1                       .ENDREPEAT
000B70r 1               ; $70-$7F
000B70r 1  rr rr rr rr          .REPEAT 16
000B74r 1  rr rr rr rr  
000B78r 1  rr rr rr rr  
000B80r 1                               .BYTE   <op_UNIMP
000B80r 1                       .ENDREPEAT
000B80r 1               ; $80-$8F
000B80r 1  rr rr rr rr          .BYTE   <op_WRITI, <op_WRITC, <op_WRITB, <op_WRITS
000B84r 1  rr rr rr rr          .BYTE   <op_WRITLN,<op_READI, <op_READC, <op_UNIMP
000B88r 1  rr rr rr rr          .REPEAT 8
000B8Cr 1  rr rr rr rr  
000B90r 1                               .BYTE   <op_UNIMP
000B90r 1                       .ENDREPEAT
000B90r 1               ; $90-$9F
000B90r 1  rr rr rr rr          .BYTE   <op_DUP,   <op_POP,   <op_UNIMP, <op_UNIMP
000B94r 1  rr rr rr rr          .REPEAT 12
000B98r 1  rr rr rr rr  
000B9Cr 1  rr rr rr rr  
000BA0r 1                               .BYTE   <op_UNIMP
000BA0r 1                       .ENDREPEAT
000BA0r 1               ; $A0-$A3 string built-ins
000BA0r 1  rr rr rr rr          .BYTE   <op_LEN,   <op_POS,   <op_COPY,  <op_CONCAT
000BA4r 1               ; $A4-$FE
000BA4r 1  rr rr rr rr          .REPEAT 91
000BA8r 1  rr rr rr rr  
000BACr 1  rr rr rr rr  
000BFFr 1                               .BYTE   <op_UNIMP
000BFFr 1                       .ENDREPEAT
000BFFr 1               ; $FF
000BFFr 1  rr                   .BYTE   <op_HALT
000C00r 1               
