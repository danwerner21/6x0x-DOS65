001125r 1  rr rr rr rr          .REPEAT 11
001129r 1  rr rr rr rr  
00112Dr 1  rr rr rr     
001130r 1                               .BYTE   <op_UNIMP
001130r 1                       .ENDREPEAT
001130r 1               ; $30-$3F
