001324r 1               .include    "IOLIB.ASM"
001324r 2               .pc02
001324r 2               ; iolib.asm — console and file I/O wrappers for DOS/65
001324r 2               ;
001324r 2               ; Uses PEM function 2 (CONOUT) for character output.
001324r 2               ; This routes through DFT_CONSOLE and works on all platforms
001324r 2               ; (serial, ESP video, memory-mapped video) regardless of which
001324r 2               ; console driver is active.
001324r 2               
001324r 2                       .segment        "CODE"
001324r 2               
001324r 2               ; ---------------------------------------------------------------------------
001324r 2               ; console_putc — output character in A to console via PEM #2
001324r 2               ; ---------------------------------------------------------------------------
001324r 2               console_putc:
001324r 2  48                   PHA
001325r 2  A2 02                LDX     #PEM_CONOUT
001327r 2  20 03 01             JSR     PEM_ENTRY
00132Ar 2  68                   PLA
00132Br 2  60                   RTS
00132Cr 2               
00132Cr 2               ; ---------------------------------------------------------------------------
00132Cr 2               ; console_newline — emit CR+LF
00132Cr 2               ; ---------------------------------------------------------------------------
00132Cr 2               console_newline:
00132Cr 2  A9 0D                LDA     #$0D
00132Er 2  A2 02                LDX     #PEM_CONOUT
001330r 2  20 03 01             JSR     PEM_ENTRY
001333r 2  A9 0A                LDA     #$0A
001335r 2  A2 02                LDX     #PEM_CONOUT
001337r 2  20 03 01             JSR     PEM_ENTRY
00133Ar 2  60                   RTS
00133Br 2               
00133Br 2               ; ---------------------------------------------------------------------------
00133Br 2               ; console_print_sz — print null-terminated string at tmp0
00133Br 2               ; ---------------------------------------------------------------------------
00133Br 2               console_print_sz:
00133Br 2  A0 00                LDY     #0
00133Dr 2               @loop:
00133Dr 2  B1 rr                LDA     (tmp0),y
00133Fr 2  F0 08                BEQ     @done
001341r 2  A2 02                LDX     #PEM_CONOUT
001343r 2  20 03 01             JSR     PEM_ENTRY
001346r 2  C8                   INY
001347r 2  D0 F4                BNE     @loop
001349r 2               @done:
001349r 2  60                   RTS
00134Ar 2               
00134Ar 2               ; ---------------------------------------------------------------------------
00134Ar 2               ; console_print_pstr — print length-prefixed Pascal string at tmp0
00134Ar 2               ; ---------------------------------------------------------------------------
00134Ar 2               console_print_pstr:
00134Ar 2  A0 00                LDY     #0
00134Cr 2  B1 rr                LDA     (tmp0),y        ; length byte
00134Er 2  F0 10                BEQ     @done
001350r 2  AA                   TAX                     ; X = remaining chars — but X used by PEM!
001351r 2               ; save length, use tmp1 as counter
001351r 2  85 rr                STA     tmp1
001353r 2  C8                   INY
001354r 2               @loop:
001354r 2  B1 rr                LDA     (tmp0),y
001356r 2  A2 02                LDX     #PEM_CONOUT
001358r 2  20 03 01             JSR     PEM_ENTRY
00135Br 2  C8                   INY
00135Cr 2  C6 rr                DEC     tmp1
00135Er 2  D0 F4                BNE     @loop
001360r 2               @done:
001360r 2  60                   RTS
001361r 2               
001361r 2               ; ---------------------------------------------------------------------------
001361r 2               ; console_print_dec — print signed 16-bit integer in tmp0:tmp0+1
001361r 2               ; ---------------------------------------------------------------------------
001361r 2               console_print_dec:
001361r 2  A5 rr                LDA     tmp0+1
001363r 2  10 14                BPL     @positive
001365r 2  A9 2D                LDA     #'-'
001367r 2  A2 02                LDX     #PEM_CONOUT
001369r 2  20 03 01             JSR     PEM_ENTRY
00136Cr 2  A9 00                LDA     #0
00136Er 2  38                   SEC
00136Fr 2  E5 rr                SBC     tmp0
001371r 2  85 rr                STA     tmp0
001373r 2  A9 00                LDA     #0
001375r 2  E5 rr                SBC     tmp0+1
001377r 2  85 rr                STA     tmp0+1
001379r 2               @positive:
001379r 2  A9 00                LDA     #0
00137Br 2  48                   PHA                     ; sentinel
00137Cr 2               @div_loop:
00137Cr 2  20 rr rr             JSR     div16_by10      ; quotient→tmp0, remainder→scratch
00137Fr 2  A5 rr                LDA     scratch
001381r 2  18                   CLC
001382r 2  69 30                ADC     #'0'
001384r 2  48                   PHA
001385r 2  A5 rr                LDA     tmp0
001387r 2  05 rr                ORA     tmp0+1
001389r 2  D0 F1                BNE     @div_loop
00138Br 2               @print_loop:
00138Br 2  68                   PLA
00138Cr 2  F0 07                BEQ     @done2          ; sentinel
00138Er 2  A2 02                LDX     #PEM_CONOUT
001390r 2  20 03 01             JSR     PEM_ENTRY
001393r 2  80 F6                BRA     @print_loop
001395r 2               @done2:
001395r 2  60                   RTS
001396r 2               
001396r 2               ; ---------------------------------------------------------------------------
001396r 2               ; div16_by10 — divide tmp0:tmp0+1 by 10
001396r 2               ; Result: quotient in tmp0:tmp0+1, remainder in scratch
001396r 2               ; ---------------------------------------------------------------------------
001396r 2               div16_by10:
001396r 2  A9 00                LDA     #0
001398r 2  85 rr                STA     scratch
00139Ar 2  A2 10                LDX     #16
00139Cr 2               @bit:
00139Cr 2  06 rr                ASL     tmp0
00139Er 2  26 rr                ROL     tmp0+1
0013A0r 2  26 rr                ROL     scratch
0013A2r 2  A5 rr                LDA     scratch
0013A4r 2  C9 0A                CMP     #10
0013A6r 2  90 06                BCC     @no_sub
0013A8r 2  E9 0A                SBC     #10
0013AAr 2  85 rr                STA     scratch
0013ACr 2  E6 rr                INC     tmp0
0013AEr 2               @no_sub:
0013AEr 2  CA                   DEX
0013AFr 2  D0 EB                BNE     @bit
0013B1r 2  60                   RTS
0013B2r 2               
0013B2r 2               ; ---------------------------------------------------------------------------
0013B2r 2               ; console_read_line — read a line into buffer at tmp0, max len in x_save
0013B2r 2               ; Returns: Y = length (not including CR)
0013B2r 2               ; ---------------------------------------------------------------------------
0013B2r 2               console_read_line:
0013B2r 2  8E rr rr             STX     x_save
0013B5r 2  A0 00                LDY     #0
0013B7r 2               @loop:
0013B7r 2  A2 01                LDX     #PEM_CONIN
0013B9r 2  20 03 01             JSR     PEM_ENTRY
0013BCr 2  C9 0D                CMP     #$0D
0013BEr 2  F0 28                BEQ     @done
0013C0r 2  C9 08                CMP     #$08            ; backspace
0013C2r 2  D0 1C                BNE     @store
0013C4r 2  C0 00                CPY     #0
0013C6r 2  F0 EF                BEQ     @loop
0013C8r 2  88                   DEY
0013C9r 2  A9 08                LDA     #$08
0013CBr 2  A2 02                LDX     #PEM_CONOUT
0013CDr 2  20 03 01             JSR     PEM_ENTRY
0013D0r 2  A9 20                LDA     #' '
0013D2r 2  A2 02                LDX     #PEM_CONOUT
0013D4r 2  20 03 01             JSR     PEM_ENTRY
0013D7r 2  A9 08                LDA     #$08
0013D9r 2  A2 02                LDX     #PEM_CONOUT
0013DBr 2  20 03 01             JSR     PEM_ENTRY
0013DEr 2  80 D7                BRA     @loop
0013E0r 2               @store:
0013E0r 2  91 rr                STA     (tmp0),y
0013E2r 2  C8                   INY
0013E3r 2  CC rr rr             CPY     x_save
0013E6r 2  90 CF                BCC     @loop
0013E8r 2               @done:
0013E8r 2  60                   RTS
0013E9r 2               x_save:
0013E9r 2  00                   .BYTE   0
0013EAr 2               
0013EAr 2               ; ---------------------------------------------------------------------------
0013EAr 2               ; file_open — open file via FCB at tmp1; returns A=0 success, $FF=not found
0013EAr 2               ; PEM calling convention: X=function, A=FCB addr lo, Y=FCB addr hi
0013EAr 2               ; ---------------------------------------------------------------------------
0013EAr 2               file_open:
0013EAr 2  A5 rr                LDA     tmp1
0013ECr 2  A4 rr                LDY     tmp1+1
0013EEr 2  A2 0F                LDX     #PEM_OPEN
0013F0r 2  20 03 01             JSR     PEM_ENTRY
0013F3r 2  60                   RTS
0013F4r 2               
0013F4r 2               ; ---------------------------------------------------------------------------
0013F4r 2               ; file_make — create/truncate file via FCB at tmp1
0013F4r 2               ; ---------------------------------------------------------------------------
0013F4r 2               file_make:
0013F4r 2  A5 rr                LDA     tmp1
0013F6r 2  A4 rr                LDY     tmp1+1
0013F8r 2  A2 16                LDX     #PEM_MAKE
0013FAr 2  20 03 01             JSR     PEM_ENTRY
0013FDr 2  60                   RTS
0013FEr 2               
0013FEr 2               ; ---------------------------------------------------------------------------
0013FEr 2               ; file_read_sector — read 128 bytes into DMA_BUF; returns A=0 ok, A=1 EOF
0013FEr 2               ; ---------------------------------------------------------------------------
0013FEr 2               file_read_sector:
0013FEr 2  A5 rr                LDA     tmp1
001400r 2  A4 rr                LDY     tmp1+1
001402r 2  A2 14                LDX     #PEM_READ
001404r 2  20 03 01             JSR     PEM_ENTRY
001407r 2  60                   RTS
001408r 2               
001408r 2               ; ---------------------------------------------------------------------------
001408r 2               ; file_write_sector — write 128 bytes from DMA_BUF
001408r 2               ; ---------------------------------------------------------------------------
001408r 2               file_write_sector:
001408r 2  A5 rr                LDA     tmp1
00140Ar 2  A4 rr                LDY     tmp1+1
00140Cr 2  A2 15                LDX     #PEM_WRITE
00140Er 2  20 03 01             JSR     PEM_ENTRY
001411r 2  60                   RTS
001412r 2               
001412r 2               ; ---------------------------------------------------------------------------
001412r 2               ; file_close — close FCB at tmp1
001412r 2               ; ---------------------------------------------------------------------------
001412r 2               file_close:
001412r 2  A5 rr                LDA     tmp1
001414r 2  A4 rr                LDY     tmp1+1
001416r 2  A2 10                LDX     #PEM_CLOSE
001418r 2  20 03 01             JSR     PEM_ENTRY
00141Br 2  60                   RTS
00141Cr 2               
00141Cr 2               ; ---------------------------------------------------------------------------
00141Cr 2               ; file_setdma — point PEM at the 128-byte buffer at (A:Y)
00141Cr 2               ; A = lo, Y = hi.  Trashes X.
00141Cr 2               ; ---------------------------------------------------------------------------
00141Cr 2               file_setdma:
00141Cr 2  A2 1A                LDX     #PEM_SETDMA
00141Er 2  4C 03 01             JMP     PEM_ENTRY
001421r 2               
001421r 2               ; ---------------------------------------------------------------------------
001421r 2               ; file_setdma_default — restore PEM DMA pointer to system DMA_BUF
001421r 2               ; ---------------------------------------------------------------------------
001421r 2               file_setdma_default:
001421r 2  A9 28                LDA     #<DMA_BUF
001423r 2  A0 01                LDY     #>DMA_BUF
001425r 2  A2 1A                LDX     #PEM_SETDMA
001427r 2  4C 03 01             JMP     PEM_ENTRY
00142Ar 2               
00142Ar 1               .include    "MESSAGES.ASM"
00142Ar 2               ; messages.asm — compiler error and status strings (null-terminated)
00142Ar 2               
00142Ar 2                       .segment  "CODE"
00142Ar 2               
00142Ar 2               msg_banner:
00142Ar 2  50 61 73 63          .BYTE   "Pascal/65 Compiler v0.1 for DOS/65",13,10,0
00142Er 2  61 6C 2F 36  
001432r 2  35 20 43 6F  
00144Fr 2               msg_compiling:
00144Fr 2  43 6F 6D 70          .BYTE   "Compiling...",13,10,0
001453r 2  69 6C 69 6E  
001457r 2  67 2E 2E 2E  
00145Er 2               msg_ok:
00145Er 2  4F 4B 0D 0A          .BYTE   "OK",13,10,0
001462r 2  00           
001463r 2               msg_errors:
001463r 2  20 65 72 72          .BYTE   " error(s)",13,10,0
001467r 2  6F 72 28 73  
00146Br 2  29 0D 0A 00  
00146Fr 2               msg_line:
00146Fr 2  20 4C 69 6E          .BYTE   " Line ",0
001473r 2  65 20 00     
001476r 2               msg_col:
001476r 2  20 43 6F 6C          .BYTE   " Col ",0
00147Ar 2  20 00        
00147Cr 2               
00147Cr 2               ; Compiler errors
00147Cr 2               err_unexpected:
00147Cr 2  55 6E 65 78          .BYTE   "Unexpected token",0
001480r 2  70 65 63 74  
001484r 2  65 64 20 74  
00148Dr 2               err_expected_id:
00148Dr 2  49 44 45 4E          .byte   "IDENTIFIER expected",0
001491r 2  54 49 46 49  
001495r 2  45 52 20 65  
