000679r 1  A5 rr                LDA     pm_mp
00067Br 1  85 rr                STA     pm_sp
00067Dr 1  A5 rr                LDA     pm_mp+1
00067Fr 1  85 rr                STA     pm_sp+1
000681r 1               ; restore IPC into tmp1
000681r 1  A0 02                LDY     #AR_RET_ADDR
000683r 1  B1 rr                LDA     (pm_mp),y
000685r 1  85 rr                STA     tmp1
000687r 1  C8                   INY
000688r 1  B1 rr                LDA     (pm_mp),y
00068Ar 1  85 rr                STA     tmp1+1
00068Cr 1               ; restore old MP from AR_DYN_LINK
00068Cr 1  A0 01                LDY     #AR_DYN_LINK+1
00068Er 1  B1 rr                LDA     (pm_mp),y
000690r 1  48                   PHA
000691r 1  A0 00                LDY     #AR_DYN_LINK
000693r 1  B1 rr                LDA     (pm_mp),y
000695r 1  85 rr                STA     pm_mp
000697r 1  68                   PLA
000698r 1  85 rr                STA     pm_mp+1
00069Ar 1               ; install IPC
00069Ar 1  A5 rr                LDA     tmp1
00069Cr 1  85 rr                STA     pm_ipc
00069Er 1  A5 rr                LDA     tmp1+1
0006A0r 1  85 rr                STA     pm_ipc+1
0006A2r 1               ; push captured return value (lo in A, hi in scratch)
0006A2r 1  A5 rr                LDA     tmp0+1
0006A4r 1  85 rr                STA     scratch
0006A6r 1  A5 rr                LDA     tmp0
0006A8r 1  20 rr rr             JSR     pm_push
0006ABr 1  4C rr rr             JMP     prun_loop
0006AEr 1               
0006AEr 1               ; OP_STR ($66) — pop word, store at MP+AR_RET_VAL (function result slot)
0006AEr 1               op_STR:
0006AEr 1  20 rr rr             JSR     pm_pop          ; A=lo, scratch=hi
0006B1r 1  A0 06                LDY     #AR_RET_VAL
0006B3r 1  91 rr                STA     (pm_mp),y
0006B5r 1  C8                   INY
0006B6r 1  A5 rr                LDA     scratch
0006B8r 1  91 rr                STA     (pm_mp),y
0006BAr 1  4C rr rr             JMP     prun_loop
0006BDr 1               
0006BDr 1               ; OP_WRITI ($80) — pop integer, print decimal
0006BDr 1               op_WRITI:
0006BDr 1  20 rr rr             JSR     pm_pop          ; A=lo, scratch=hi
0006C0r 1  85 rr                STA     tmp0
0006C2r 1  A5 rr                LDA     scratch
0006C4r 1  85 rr                STA     tmp0+1
0006C6r 1  20 rr rr             JSR     console_print_dec
0006C9r 1  4C rr rr             JMP     prun_loop
0006CCr 1               
0006CCr 1               ; OP_WRITC ($81) — pop char, print
0006CCr 1               op_WRITC:
0006CCr 1  20 rr rr             JSR     pm_pop
0006CFr 1  20 rr rr             JSR     console_putc
0006D2r 1  4C rr rr             JMP     prun_loop
0006D5r 1               
0006D5r 1               ; OP_WRITB ($82) — pop boolean, print TRUE/FALSE
0006D5r 1               op_WRITB:
0006D5r 1  20 rr rr             JSR     pm_pop
0006D8r 1  05 rr                ORA     scratch
0006DAr 1  F0 0E                BEQ     @false3
0006DCr 1  A9 rr                LDA     #<str_true
0006DEr 1  85 rr                STA     tmp0
0006E0r 1  A9 rr                LDA     #>str_true
0006E2r 1  85 rr                STA     tmp0+1
0006E4r 1  20 rr rr             JSR     console_print_sz
0006E7r 1  4C rr rr             JMP     prun_loop
0006EAr 1               @false3:
0006EAr 1  A9 rr                LDA     #<str_false
0006ECr 1  85 rr                STA     tmp0
0006EEr 1  A9 rr                LDA     #>str_false
0006F0r 1  85 rr                STA     tmp0+1
0006F2r 1  20 rr rr             JSR     console_print_sz
0006F5r 1  4C rr rr             JMP     prun_loop
0006F8r 1               
0006F8r 1               ; OP_WRITS ($83) — TOS = address of length-prefixed string, print it
0006F8r 1               op_WRITS:
0006F8r 1  20 rr rr             JSR     pm_pop
0006FBr 1  85 rr                STA     tmp0
0006FDr 1  A5 rr                LDA     scratch
0006FFr 1  85 rr                STA     tmp0+1
000701r 1  20 rr rr             JSR     console_print_pstr
000704r 1  4C rr rr             JMP     prun_loop
000707r 1               
000707r 1               ; OP_WRITLN ($84) — newline
000707r 1               op_WRITLN:
000707r 1  20 rr rr             JSR     console_newline
00070Ar 1  4C rr rr             JMP     prun_loop
00070Dr 1               
00070Dr 1               ; OP_READI ($85) — TOS = address of INTEGER variable.  Read a line from
00070Dr 1               ; the console, parse a signed decimal integer, store as a 16-bit word at
00070Dr 1               ; the popped address.
00070Dr 1               op_READI:
00070Dr 1  20 rr rr             JSR     pm_pop          ; A=lo addr, scratch=hi addr
000710r 1  85 rr                STA     tmp1            ; (zero-page) destination pointer
000712r 1  A5 rr                LDA     scratch
000714r 1  85 rr                STA     tmp1+1
000716r 1               ; read one line into read_line_buf
000716r 1  A9 rr                LDA     #<read_line_buf
000718r 1  85 rr                STA     tmp0
00071Ar 1  A9 rr                LDA     #>read_line_buf
00071Cr 1  85 rr                STA     tmp0+1
00071Er 1  A2 1F                LDX     #31             ; max line length
000720r 1  20 rr rr             JSR     console_read_line; Y = length on return
000723r 1  8C rr rr             STY     read_len
000726r 1  20 rr rr             JSR     console_newline ; PEM CONIN echoes CR but no LF
000729r 1               ; parse signed decimal from read_line_buf into tmp2:tmp2+1
000729r 1  A9 00                LDA     #0
00072Br 1  85 rr                STA     tmp2
00072Dr 1  85 rr                STA     tmp2+1
00072Fr 1  8D rr rr             STA     read_neg
000732r 1  A0 00                LDY     #0
000734r 1               @rd_skip:
000734r 1  CC rr rr             CPY     read_len
000737r 1  B0 67                BCS     @rd_apply_sign  ; empty / all-space → 0
000739r 1  B9 rr rr             LDA     read_line_buf,y
00073Cr 1  C9 20                CMP     #' '
00073Er 1  D0 04                BNE     @rd_chk_sign
000740r 1  C8                   INY
000741r 1  4C rr rr             JMP     @rd_skip
000744r 1               @rd_chk_sign:
000744r 1  C9 2D                CMP     #'-'
000746r 1  D0 09                BNE     @rd_chk_plus
000748r 1  A9 01                LDA     #1
00074Ar 1  8D rr rr             STA     read_neg
00074Dr 1  C8                   INY
00074Er 1  4C rr rr             JMP     @rd_digits
000751r 1               @rd_chk_plus:
000751r 1  C9 2B                CMP     #'+'
000753r 1  D0 01                BNE     @rd_digits
000755r 1  C8                   INY
000756r 1               @rd_digits:
000756r 1  CC rr rr             CPY     read_len
000759r 1  B0 45                BCS     @rd_apply_sign
00075Br 1  B9 rr rr             LDA     read_line_buf,y
00075Er 1  C9 30                CMP     #'0'
000760r 1  90 3E                BCC     @rd_apply_sign
000762r 1  C9 3A                CMP     #'9'+1
000764r 1  B0 3A                BCS     @rd_apply_sign
000766r 1               ; tmp2 *= 10  (using temp = tmp2*2; tmp2 = (tmp2*2)*4 + temp)
000766r 1  06 rr                ASL     tmp2
000768r 1  26 rr                ROL     tmp2+1
00076Ar 1  A5 rr                LDA     tmp2
00076Cr 1  8D rr rr             STA     read_save2
00076Fr 1  A5 rr                LDA     tmp2+1
000771r 1  8D rr rr             STA     read_save2+1
000774r 1  06 rr                ASL     tmp2
000776r 1  26 rr                ROL     tmp2+1
000778r 1  06 rr                ASL     tmp2
00077Ar 1  26 rr                ROL     tmp2+1
00077Cr 1  18                   CLC
00077Dr 1  A5 rr                LDA     tmp2
00077Fr 1  6D rr rr             ADC     read_save2
000782r 1  85 rr                STA     tmp2
000784r 1  A5 rr                LDA     tmp2+1
000786r 1  6D rr rr             ADC     read_save2+1
000789r 1  85 rr                STA     tmp2+1
00078Br 1               ; tmp2 += digit
00078Br 1  B9 rr rr             LDA     read_line_buf,y
00078Er 1  38                   SEC
00078Fr 1  E9 30                SBC     #'0'
000791r 1  18                   CLC
000792r 1  65 rr                ADC     tmp2
000794r 1  85 rr                STA     tmp2
000796r 1  A9 00                LDA     #0
000798r 1  65 rr                ADC     tmp2+1
00079Ar 1  85 rr                STA     tmp2+1
00079Cr 1  C8                   INY
00079Dr 1  4C rr rr             JMP     @rd_digits
0007A0r 1               @rd_apply_sign:
0007A0r 1  AD rr rr             LDA     read_neg
0007A3r 1  F0 0D                BEQ     @rd_store
0007A5r 1  38                   SEC
0007A6r 1  A9 00                LDA     #0
0007A8r 1  E5 rr                SBC     tmp2
0007AAr 1  85 rr                STA     tmp2
0007ACr 1  A9 00                LDA     #0
0007AEr 1  E5 rr                SBC     tmp2+1
0007B0r 1  85 rr                STA     tmp2+1
0007B2r 1               @rd_store:
0007B2r 1  A0 00                LDY     #0
0007B4r 1  A5 rr                LDA     tmp2
0007B6r 1  91 rr                STA     (tmp1),y
0007B8r 1  C8                   INY
0007B9r 1  A5 rr                LDA     tmp2+1
0007BBr 1  91 rr                STA     (tmp1),y
0007BDr 1  4C rr rr             JMP     prun_loop
0007C0r 1               
0007C0r 1               read_line_buf:
0007C0r 1  xx xx xx xx          .RES    32
0007C4r 1  xx xx xx xx  
0007C8r 1  xx xx xx xx  
0007E0r 1               read_len:
0007E0r 1  xx                   .RES    1
0007E1r 1               read_neg:
0007E1r 1  xx                   .RES    1
0007E2r 1               read_save2:
0007E2r 1  xx xx                .RES    2
0007E4r 1               
0007E4r 1               ; OP_READC ($86) — read char from console, push
0007E4r 1               op_READC:
0007E4r 1  A2 01 20 03          PEM     PEM_CONIN
0007E8r 1  01           
0007E9r 1  48                   PHA
0007EAr 1  A9 00                LDA     #0
0007ECr 1  85 rr                STA     scratch
0007EEr 1  68                   PLA
0007EFr 1  20 rr rr             JSR     pm_push
0007F2r 1  4C rr rr             JMP     prun_loop
0007F5r 1               
0007F5r 1               ; OP_DUP ($90) — duplicate TOS
0007F5r 1               op_DUP:
0007F5r 1  20 rr rr             JSR     pm_peek
0007F8r 1  20 rr rr             JSR     pm_push
0007FBr 1  4C rr rr             JMP     prun_loop
0007FEr 1               
0007FEr 1               ; OP_POP ($91) — discard TOS
0007FEr 1               op_POP:
0007FEr 1  20 rr rr             JSR     pm_pop
000801r 1  4C rr rr             JMP     prun_loop
000804r 1               
000804r 1               ; ---------------------------------------------------------------------------
000804r 1               ; Unimplemented opcode handler
000804r 1               ; ---------------------------------------------------------------------------
000804r 1               op_UNIMP:
000804r 1  A9 rr                LDA     #<err_rt_opcode
000806r 1  85 rr                STA     tmp0
000808r 1  A9 rr                LDA     #>err_rt_opcode
00080Ar 1  85 rr                STA     tmp0+1
00080Cr 1  20 rr rr             JSR     rt_error
00080Fr 1               ; rt_error does not return (jumps to warm boot)
00080Fr 1               
00080Fr 1               ; ---------------------------------------------------------------------------
00080Fr 1               ; String literals for boolean output
00080Fr 1               ; ---------------------------------------------------------------------------
00080Fr 1               str_true:
00080Fr 1  54 52 55 45          .BYTE   "TRUE",0
000813r 1  00           
000814r 1               str_false:
000814r 1  46 41 4C 53          .BYTE   "FALSE",0
000818r 1  45 00        
00081Ar 1               msg_rt_banner:
00081Ar 1  50 52 55 4E          .BYTE   "PRUN v0.1 - Pascal P-Code Runtime for DOS/65",13,10,0
00081Er 1  20 76 30 2E  
000822r 1  31 20 2D 20  
000849r 1               
000849r 1               ; ---------------------------------------------------------------------------
000849r 1               ; Dispatch table — 256 entries of (lo, hi) pointer pairs
000849r 1               ; ---------------------------------------------------------------------------
000849r 1  xx xx xx xx          .align  256
00084Dr 1  xx xx xx xx  
000851r 1  xx xx xx xx  
000900r 1               dispatch_lo:
000900r 1               ; $00-$07
000900r 1  rr rr rr rr          .BYTE   <op_LDCI,  <op_LDCW,  <op_LDCC,  <op_LDCB
000904r 1  rr rr rr rr          .BYTE   <op_LDCS,  <op_LDCN,  <op_UNIMP, <op_UNIMP
000908r 1               ; $08-$0F
000908r 1  rr rr rr rr          .REPEAT 8
00090Cr 1  rr rr rr rr  
000910r 1                               .BYTE   <op_UNIMP
000910r 1                       .ENDREPEAT
000910r 1               ; $10-$17
000910r 1  rr rr rr rr          .BYTE   <op_LDL,   <op_STL,   <op_LDA_L, <op_UNIMP
000914r 1  rr rr rr rr          .REPEAT 4
000918r 1                               .BYTE   <op_UNIMP
000918r 1                       .ENDREPEAT
000918r 1               ; $18-$2F
000918r 1  rr rr rr rr          .BYTE   <op_LDG,   <op_STG,   <op_LDA_G, <op_UNIMP
00091Cr 1  rr rr rr rr          .BYTE   <op_UNIMP, <op_UNIMP, <op_UNIMP, <op_UNIMP
000920r 1  rr rr                .BYTE   <op_LDIND, <op_STIND
000922r 1  rr rr rr rr          .REPEAT 14
000926r 1  rr rr rr rr  
00092Ar 1  rr rr rr rr  
000930r 1                               .BYTE   <op_UNIMP
000930r 1                       .ENDREPEAT
000930r 1               ; $30-$3F
000930r 1  rr rr rr rr          .BYTE   <op_ADI,   <op_SBI,   <op_MPI,   <op_DVI
000934r 1  rr rr rr rr          .BYTE   <op_MOD,   <op_NGI,   <op_UNIMP, <op_UNIMP
000938r 1  rr rr rr rr          .REPEAT 8
00093Cr 1  rr rr rr rr  
000940r 1                               .BYTE   <op_UNIMP
000940r 1                       .ENDREPEAT
000940r 1               ; $40-$4F
000940r 1  rr rr rr rr          .BYTE   <op_EQUI,  <op_NEQI,  <op_LESI,  <op_LEQI
000944r 1  rr rr rr rr          .BYTE   <op_GTRI,  <op_GEQI,  <op_UNIMP, <op_UNIMP
000948r 1  rr rr rr rr          .REPEAT 8
00094Cr 1  rr rr rr rr  
000950r 1                               .BYTE   <op_UNIMP
000950r 1                       .ENDREPEAT
000950r 1               ; $50-$5F
000950r 1  rr rr rr rr          .BYTE   <op_UJP,   <op_FJP,   <op_TJP,   <op_UNIMP
000954r 1  rr rr rr rr          .REPEAT 12
000958r 1  rr rr rr rr  
00095Cr 1  rr rr rr rr  
000960r 1                               .BYTE   <op_UNIMP
000960r 1                       .ENDREPEAT
000960r 1               ; $60-$6F
000960r 1  rr rr rr rr          .BYTE   <op_CALL,  <op_UNIMP, <op_RET,   <op_RETF
000964r 1  rr rr rr rr          .BYTE   <op_MRKSTK,<op_UNIMP, <op_STR,   <op_UNIMP
000968r 1  rr rr rr rr          .REPEAT 8
00096Cr 1  rr rr rr rr  
000970r 1                               .BYTE   <op_UNIMP
000970r 1                       .ENDREPEAT
000970r 1               ; $70-$7F
000970r 1  rr rr rr rr          .REPEAT 16
000974r 1  rr rr rr rr  
000978r 1  rr rr rr rr  
000980r 1                               .BYTE   <op_UNIMP
000980r 1                       .ENDREPEAT
000980r 1               ; $80-$8F
000980r 1  rr rr rr rr          .BYTE   <op_WRITI, <op_WRITC, <op_WRITB, <op_WRITS
000984r 1  rr rr rr rr          .BYTE   <op_WRITLN,<op_READI, <op_READC, <op_UNIMP
000988r 1  rr rr rr rr          .REPEAT 8
00098Cr 1  rr rr rr rr  
000990r 1                               .BYTE   <op_UNIMP
000990r 1                       .ENDREPEAT
000990r 1               ; $90-$FE
000990r 1  rr rr rr rr          .BYTE   <op_DUP,   <op_POP,   <op_UNIMP, <op_UNIMP
000994r 1  rr rr rr rr          .REPEAT 107
000998r 1  rr rr rr rr  
00099Cr 1  rr rr rr rr  
0009FFr 1                               .BYTE   <op_UNIMP
0009FFr 1                       .ENDREPEAT
0009FFr 1               ; $FF
0009FFr 1  rr                   .BYTE   <op_HALT
000A00r 1               
000A00r 1               dispatch_hi:
000A00r 1               ; $00-$07
000A00r 1  rr rr rr rr          .BYTE   >op_LDCI,  >op_LDCW,  >op_LDCC,  >op_LDCB
000A04r 1  rr rr rr rr          .BYTE   >op_LDCS,  >op_LDCN,  >op_UNIMP, >op_UNIMP
000A08r 1               ; $08-$0F
000A08r 1  rr rr rr rr          .REPEAT 8
000A0Cr 1  rr rr rr rr  
000A10r 1                               .BYTE   >op_UNIMP
000A10r 1                       .ENDREPEAT
000A10r 1               ; $10-$17
000A10r 1  rr rr rr rr          .BYTE   >op_LDL,   >op_STL,   >op_LDA_L, >op_UNIMP
000A14r 1  rr rr rr rr          .REPEAT 4
000A18r 1                               .BYTE   >op_UNIMP
000A18r 1                       .ENDREPEAT
000A18r 1               ; $18-$2F
000A18r 1  rr rr rr rr          .BYTE   >op_LDG,   >op_STG,   >op_LDA_G, >op_UNIMP
000A1Cr 1  rr rr rr rr          .BYTE   >op_UNIMP, >op_UNIMP, >op_UNIMP, >op_UNIMP
000A20r 1  rr rr                .BYTE   >op_LDIND, >op_STIND
000A22r 1  rr rr rr rr          .REPEAT 14
000A26r 1  rr rr rr rr  
000A2Ar 1  rr rr rr rr  
000A30r 1                          .BYTE   >op_UNIMP
000A30r 1                       .ENDREPEAT
000A30r 1               ; $30-$3F
000A30r 1  rr rr rr rr          .BYTE   >op_ADI,   >op_SBI,   >op_MPI,   >op_DVI
000A34r 1  rr rr rr rr          .BYTE   >op_MOD,   >op_NGI,   >op_UNIMP, >op_UNIMP
000A38r 1  rr rr rr rr          .REPEAT 8
000A3Cr 1  rr rr rr rr  
000A40r 1                               .BYTE   >op_UNIMP
000A40r 1                       .ENDREPEAT
000A40r 1               ; $40-$4F
000A40r 1  rr rr rr rr          .BYTE   >op_EQUI,  >op_NEQI,  >op_LESI,  >op_LEQI
000A44r 1  rr rr rr rr          .BYTE   >op_GTRI,  >op_GEQI,  >op_UNIMP, >op_UNIMP
000A48r 1  rr rr rr rr          .REPEAT 8
000A4Cr 1  rr rr rr rr  
000A50r 1                           .BYTE   >op_UNIMP
000A50r 1                       .ENDREPEAT
000A50r 1               ; $50-$5F
000A50r 1  rr rr rr rr          .BYTE   >op_UJP,   >op_FJP,   >op_TJP,   >op_UNIMP
000A54r 1  rr rr rr rr          .REPEAT 12
000A58r 1  rr rr rr rr  
000A5Cr 1  rr rr rr rr  
000A60r 1                               .BYTE   >op_UNIMP
000A60r 1                       .ENDREPEAT
000A60r 1               ; $60-$6F
000A60r 1  rr rr rr rr          .BYTE   >op_CALL,  >op_UNIMP, >op_RET,   >op_RETF
000A64r 1  rr rr rr rr          .BYTE   >op_MRKSTK,>op_UNIMP, >op_STR,   >op_UNIMP
000A68r 1  rr rr rr rr          .REPEAT 8
000A6Cr 1  rr rr rr rr  
000A70r 1                               .BYTE   >op_UNIMP
000A70r 1                       .ENDREPEAT
000A70r 1               ; $70-$7F
000A70r 1  rr rr rr rr          .REPEAT 16
000A74r 1  rr rr rr rr  
000A78r 1  rr rr rr rr  
000A80r 1                               .BYTE   >op_UNIMP
000A80r 1                       .ENDREPEAT
000A80r 1               ; $80-$8F
000A80r 1  rr rr rr rr          .BYTE   >op_WRITI, >op_WRITC, >op_WRITB, >op_WRITS
000A84r 1  rr rr rr rr          .BYTE   >op_WRITLN,>op_READI, >op_READC, >op_UNIMP
000A88r 1  rr rr rr rr          .REPEAT 8
000A8Cr 1  rr rr rr rr  
000A90r 1                               .BYTE   >op_UNIMP
000A90r 1                       .ENDREPEAT
000A90r 1               ; $90-$FE
000A90r 1  rr rr rr rr          .BYTE   >op_DUP,   >op_POP,   >op_UNIMP, >op_UNIMP
000A94r 1  rr rr rr rr          .REPEAT 107
000A98r 1  rr rr rr rr  
000A9Cr 1  rr rr rr rr  
000AFFr 1                               .BYTE   >op_UNIMP
000AFFr 1                       .ENDREPEAT
000AFFr 1               ; $FF
000AFFr 1  rr                   .BYTE   >op_HALT
000B00r 1               
000B00r 1               ; ---------------------------------------------------------------------------
000B00r 1               ; FCB for the .PCD file (placed in CODE segment, well below STACK_BASE)
000B00r 1               ; ---------------------------------------------------------------------------
000B00r 1               pcd_fcb:
000B00r 1  xx xx xx xx          .RES    36              ; FCB (36 bytes as per CP/M/DOS65)
000B04r 1  xx xx xx xx  
000B08r 1  xx xx xx xx  
000B24r 1               
000B24r 1               ; ---------------------------------------------------------------------------
000B24r 1               ; Include shared I/O library
000B24r 1               ; ---------------------------------------------------------------------------
000B24r 1               .include    "IOLIB.ASM"
000B24r 2               .pc02
000B24r 2               ; iolib.asm — console and file I/O wrappers for DOS/65
000B24r 2               ;
000B24r 2               ; Uses PEM function 2 (CONOUT) for character output.
000B24r 2               ; This routes through DFT_CONSOLE and works on all platforms
000B24r 2               ; (serial, ESP video, memory-mapped video) regardless of which
000B24r 2               ; console driver is active.
000B24r 2               
000B24r 2                       .segment        "CODE"
000B24r 2               
000B24r 2               ; ---------------------------------------------------------------------------
000B24r 2               ; console_putc — output character in A to console via PEM #2
000B24r 2               ; ---------------------------------------------------------------------------
000B24r 2               console_putc:
000B24r 2  48                   PHA
000B25r 2  A2 02                LDX     #PEM_CONOUT
000B27r 2  20 03 01             JSR     PEM_ENTRY
000B2Ar 2  68                   PLA
000B2Br 2  60                   RTS
000B2Cr 2               
000B2Cr 2               ; ---------------------------------------------------------------------------
000B2Cr 2               ; console_newline — emit CR+LF
000B2Cr 2               ; ---------------------------------------------------------------------------
000B2Cr 2               console_newline:
000B2Cr 2  A9 0D                LDA     #$0D
000B2Er 2  A2 02                LDX     #PEM_CONOUT
000B30r 2  20 03 01             JSR     PEM_ENTRY
000B33r 2  A9 0A                LDA     #$0A
000B35r 2  A2 02                LDX     #PEM_CONOUT
000B37r 2  20 03 01             JSR     PEM_ENTRY
000B3Ar 2  60                   RTS
000B3Br 2               
000B3Br 2               ; ---------------------------------------------------------------------------
000B3Br 2               ; console_print_sz — print null-terminated string at tmp0
000B3Br 2               ; ---------------------------------------------------------------------------
000B3Br 2               console_print_sz:
000B3Br 2  A0 00                LDY     #0
000B3Dr 2               @loop:
000B3Dr 2  B1 rr                LDA     (tmp0),y
000B3Fr 2  F0 08                BEQ     @done
000B41r 2  A2 02                LDX     #PEM_CONOUT
000B43r 2  20 03 01             JSR     PEM_ENTRY
000B46r 2  C8                   INY
000B47r 2  D0 F4                BNE     @loop
000B49r 2               @done:
000B49r 2  60                   RTS
000B4Ar 2               
000B4Ar 2               ; ---------------------------------------------------------------------------
000B4Ar 2               ; console_print_pstr — print length-prefixed Pascal string at tmp0
000B4Ar 2               ; ---------------------------------------------------------------------------
000B4Ar 2               console_print_pstr:
000B4Ar 2  A0 00                LDY     #0
000B4Cr 2  B1 rr                LDA     (tmp0),y        ; length byte
000B4Er 2  F0 10                BEQ     @done
000B50r 2  AA                   TAX                     ; X = remaining chars — but X used by PEM!
000B51r 2               ; save length, use tmp1 as counter
000B51r 2  85 rr                STA     tmp1
000B53r 2  C8                   INY
000B54r 2               @loop:
000B54r 2  B1 rr                LDA     (tmp0),y
000B56r 2  A2 02                LDX     #PEM_CONOUT
000B58r 2  20 03 01             JSR     PEM_ENTRY
000B5Br 2  C8                   INY
000B5Cr 2  C6 rr                DEC     tmp1
000B5Er 2  D0 F4                BNE     @loop
000B60r 2               @done:
000B60r 2  60                   RTS
000B61r 2               
000B61r 2               ; ---------------------------------------------------------------------------
000B61r 2               ; console_print_dec — print signed 16-bit integer in tmp0:tmp0+1
000B61r 2               ; ---------------------------------------------------------------------------
000B61r 2               console_print_dec:
000B61r 2  A5 rr                LDA     tmp0+1
000B63r 2  10 14                BPL     @positive
000B65r 2  A9 2D                LDA     #'-'
000B67r 2  A2 02                LDX     #PEM_CONOUT
000B69r 2  20 03 01             JSR     PEM_ENTRY
000B6Cr 2  A9 00                LDA     #0
000B6Er 2  38                   SEC
000B6Fr 2  E5 rr                SBC     tmp0
000B71r 2  85 rr                STA     tmp0
000B73r 2  A9 00                LDA     #0
000B75r 2  E5 rr                SBC     tmp0+1
000B77r 2  85 rr                STA     tmp0+1
000B79r 2               @positive:
000B79r 2  A9 00                LDA     #0
000B7Br 2  48                   PHA                     ; sentinel
000B7Cr 2               @div_loop:
000B7Cr 2  20 rr rr             JSR     div16_by10      ; quotient→tmp0, remainder→scratch
000B7Fr 2  A5 rr                LDA     scratch
000B81r 2  18                   CLC
000B82r 2  69 30                ADC     #'0'
000B84r 2  48                   PHA
000B85r 2  A5 rr                LDA     tmp0
000B87r 2  05 rr                ORA     tmp0+1
000B89r 2  D0 F1                BNE     @div_loop
000B8Br 2               @print_loop:
000B8Br 2  68                   PLA
000B8Cr 2  F0 07                BEQ     @done2          ; sentinel
000B8Er 2  A2 02                LDX     #PEM_CONOUT
000B90r 2  20 03 01             JSR     PEM_ENTRY
000B93r 2  80 F6                BRA     @print_loop
000B95r 2               @done2:
000B95r 2  60                   RTS
000B96r 2               
000B96r 2               ; ---------------------------------------------------------------------------
000B96r 2               ; div16_by10 — divide tmp0:tmp0+1 by 10
000B96r 2               ; Result: quotient in tmp0:tmp0+1, remainder in scratch
000B96r 2               ; ---------------------------------------------------------------------------
000B96r 2               div16_by10:
000B96r 2  A9 00                LDA     #0
000B98r 2  85 rr                STA     scratch
000B9Ar 2  A2 10                LDX     #16
000B9Cr 2               @bit:
000B9Cr 2  06 rr                ASL     tmp0
000B9Er 2  26 rr                ROL     tmp0+1
000BA0r 2  26 rr                ROL     scratch
000BA2r 2  A5 rr                LDA     scratch
000BA4r 2  C9 0A                CMP     #10
000BA6r 2  90 06                BCC     @no_sub
000BA8r 2  E9 0A                SBC     #10
000BAAr 2  85 rr                STA     scratch
000BACr 2  E6 rr                INC     tmp0
000BAEr 2               @no_sub:
000BAEr 2  CA                   DEX
000BAFr 2  D0 EB                BNE     @bit
000BB1r 2  60                   RTS
000BB2r 2               
000BB2r 2               ; ---------------------------------------------------------------------------
000BB2r 2               ; console_read_line — read a line into buffer at tmp0, max len in x_save
000BB2r 2               ; Returns: Y = length (not including CR)
000BB2r 2               ; ---------------------------------------------------------------------------
000BB2r 2               console_read_line:
000BB2r 2  8E rr rr             STX     x_save
000BB5r 2  A0 00                LDY     #0
000BB7r 2               @loop:
000BB7r 2  A2 01                LDX     #PEM_CONIN
000BB9r 2  20 03 01             JSR     PEM_ENTRY
000BBCr 2  C9 0D                CMP     #$0D
000BBEr 2  F0 28                BEQ     @done
000BC0r 2  C9 08                CMP     #$08            ; backspace
000BC2r 2  D0 1C                BNE     @store
000BC4r 2  C0 00                CPY     #0
000BC6r 2  F0 EF                BEQ     @loop
000BC8r 2  88                   DEY
000BC9r 2  A9 08                LDA     #$08
000BCBr 2  A2 02                LDX     #PEM_CONOUT
000BCDr 2  20 03 01             JSR     PEM_ENTRY
000BD0r 2  A9 20                LDA     #' '
000BD2r 2  A2 02                LDX     #PEM_CONOUT
000BD4r 2  20 03 01             JSR     PEM_ENTRY
000BD7r 2  A9 08                LDA     #$08
000BD9r 2  A2 02                LDX     #PEM_CONOUT
000BDBr 2  20 03 01             JSR     PEM_ENTRY
000BDEr 2  80 D7                BRA     @loop
000BE0r 2               @store:
000BE0r 2  91 rr                STA     (tmp0),y
000BE2r 2  C8                   INY
000BE3r 2  CC rr rr             CPY     x_save
000BE6r 2  90 CF                BCC     @loop
000BE8r 2               @done:
000BE8r 2  60                   RTS
000BE9r 2               x_save:
000BE9r 2  00                   .BYTE   0
000BEAr 2               
000BEAr 2               ; ---------------------------------------------------------------------------
000BEAr 2               ; file_open — open file via FCB at tmp1; returns A=0 success, $FF=not found
000BEAr 2               ; PEM calling convention: X=function, A=FCB addr lo, Y=FCB addr hi
000BEAr 2               ; ---------------------------------------------------------------------------
000BEAr 2               file_open:
000BEAr 2  A5 rr                LDA     tmp1
000BECr 2  A4 rr                LDY     tmp1+1
000BEEr 2  A2 0F                LDX     #PEM_OPEN
000BF0r 2  20 03 01             JSR     PEM_ENTRY
000BF3r 2  60                   RTS
000BF4r 2               
000BF4r 2               ; ---------------------------------------------------------------------------
000BF4r 2               ; file_make — create/truncate file via FCB at tmp1
000BF4r 2               ; ---------------------------------------------------------------------------
000BF4r 2               file_make:
000BF4r 2  A5 rr                LDA     tmp1
000BF6r 2  A4 rr                LDY     tmp1+1
000BF8r 2  A2 16                LDX     #PEM_MAKE
000BFAr 2  20 03 01             JSR     PEM_ENTRY
000BFDr 2  60                   RTS
000BFEr 2               
000BFEr 2               ; ---------------------------------------------------------------------------
000BFEr 2               ; file_read_sector — read 128 bytes into DMA_BUF; returns A=0 ok, A=1 EOF
000BFEr 2               ; ---------------------------------------------------------------------------
000BFEr 2               file_read_sector:
000BFEr 2  A5 rr                LDA     tmp1
000C00r 2  A4 rr                LDY     tmp1+1
000C02r 2  A2 14                LDX     #PEM_READ
000C04r 2  20 03 01             JSR     PEM_ENTRY
000C07r 2  60                   RTS
000C08r 2               
000C08r 2               ; ---------------------------------------------------------------------------
000C08r 2               ; file_write_sector — write 128 bytes from DMA_BUF
000C08r 2               ; ---------------------------------------------------------------------------
000C08r 2               file_write_sector:
000C08r 2  A5 rr                LDA     tmp1
000C0Ar 2  A4 rr                LDY     tmp1+1
000C0Cr 2  A2 15                LDX     #PEM_WRITE
000C0Er 2  20 03 01             JSR     PEM_ENTRY
000C11r 2  60                   RTS
000C12r 2               
000C12r 2               ; ---------------------------------------------------------------------------
000C12r 2               ; file_close — close FCB at tmp1
000C12r 2               ; ---------------------------------------------------------------------------
000C12r 2               file_close:
000C12r 2  A5 rr                LDA     tmp1
000C14r 2  A4 rr                LDY     tmp1+1
000C16r 2  A2 10                LDX     #PEM_CLOSE
000C18r 2  20 03 01             JSR     PEM_ENTRY
000C1Br 2  60                   RTS
000C1Cr 2               
