000C83r 1  A2 14                LDX     #PEM_READ
000C85r 1  20 03 01             JSR     PEM_ENTRY
000C88r 1  C9 00                CMP     #0
000C8Ar 1  F0 0E                BEQ     @fre_have
000C8Cr 1  A9 01                LDA     #1
000C8Er 1  A0 A6                LDY     #F_EOF
000C90r 1  91 rr                STA     (tmp1),y
000C92r 1  A9 80                LDA     #128
000C94r 1  A0 A5                LDY     #F_POS
000C96r 1  91 rr                STA     (tmp1),y
000C98r 1  80 0D                BRA     @fre_set_mode
