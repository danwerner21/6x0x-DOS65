0001A6r 1               ; ---------------------------------------------------------------------------
0001A6r 1               ; Opcode handlers
0001A6r 1               ; ---------------------------------------------------------------------------
0001A6r 1               
0001A6r 1               ; OP_HALT ($FF) — stop execution
0001A6r 1               op_HALT:
0001A6r 1  60                   rts                     ; return to prun_main
0001A7r 1               
0001A7r 1               ; OP_LDCI ($00) — push sign-extended byte constant
0001A7r 1               op_LDCI:
0001A7r 1  20 rr rr             jsr     pm_fetch_byte
0001AAr 1  48                   pha
0001ABr 1                       ; sign-extend: if bit 7 set, high byte = $FF else $00
0001ABr 1  29 80                and     #$80
0001ADr 1  F0 04                beq     :+
0001AFr 1  A9 FF                lda     #$FF
0001B1r 1  D0 02                bne     :++
0001B3r 1  A9 00        :       lda     #$00
0001B5r 1  85 rr        :       sta     scratch
0001B7r 1  68                   pla
0001B8r 1  20 rr rr             jsr     pm_push
0001BBr 1  4C rr rr             jmp     prun_loop
0001BEr 1               
0001BEr 1               ; OP_LDCW ($01) — push word constant
0001BEr 1               op_LDCW:
0001BEr 1  20 rr rr             jsr     pm_fetch_word   ; A=lo, scratch=hi
0001C1r 1  20 rr rr             jsr     pm_push
