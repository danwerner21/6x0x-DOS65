001041r 1  xx           fas_si:        .RES 1
001042r 1  xx           fas_di:        .RES 1
001043r 1  xx           fwrc_char:     .RES 1
001044r 1  xx           fws_remain:    .RES 1
001045r 1  xx           fws_idx:       .RES 1
001046r 1  xx xx        fwi_val:       .RES 2
001048r 1  xx xx xx xx  fwi_buf:       .RES 6
