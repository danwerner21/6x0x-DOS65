0003E2r 1  20 rr rr             jsr     neg_tmp2
0003E5r 1  A5 rr        :       lda     tmp2
0003E7r 1  A6 rr                ldx     tmp2+1
0003E9r 1  86 rr                stx     scratch
0003EBr 1  20 rr rr             jsr     pm_push
0003EEr 1  4C rr rr             jmp     prun_loop
