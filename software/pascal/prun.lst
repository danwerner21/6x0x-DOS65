000F38r 1  85 rr                STA     scratch
000F3Ar 1  A9 FF                LDA     #$FF
000F3Cr 1  20 rr rr             JSR     pm_push
000F3Fr 1  4C rr rr             JMP     prun_loop
000F42r 1               @feof_false:
000F42r 1  A9 00                LDA     #0
000F44r 1  85 rr                STA     scratch
000F46r 1  20 rr rr             JSR     pm_push
000F49r 1  4C rr rr             JMP     prun_loop
000F4Cr 1               
000F4Cr 1               ; OP_FRDS ($BD) — NOS=fileptr, TOS=strvar addr → read line into a work buffer;
000F4Cr 1               ; store the buffer pointer at strvar.  Skips CR, stops on LF/EOF.
000F4Cr 1               ; STRING vars hold a 16-bit pointer (matching LDCS / CONCAT semantics).
000F4Cr 1               FRDS_BUF        = $AC00                  ; dedicated 256-byte buffer below STR_WORK_BASE
000F4Cr 1               op_FRDS:
000F4Cr 1  20 rr rr             JSR     pm_pop                  ; strvar addr → tmp3
000F4Fr 1  85 rr                STA     tmp3
000F51r 1  A5 rr                LDA     scratch
000F53r 1  85 rr                STA     tmp3+1
000F55r 1  20 rr rr             JSR     pm_pop                  ; file ptr → tmp1
000F58r 1  85 rr                STA     tmp1
000F5Ar 1  A5 rr                LDA     scratch
000F5Cr 1  85 rr                STA     tmp1+1
000F5Er 1  A9 00                LDA     #0
000F60r 1  8D rr rr             STA     frs_idx
000F63r 1               @frs_loop:
000F63r 1  A0 A6                LDY     #F_EOF
000F65r 1  B1 rr                LDA     (tmp1),y
000F67r 1  D0 37                BNE     @frs_done
000F69r 1               ; peek char at buf[F_POS] without consuming
000F69r 1  18                   CLC
000F6Ar 1  A5 rr                LDA     tmp1
000F6Cr 1  69 24                ADC     #F_BUF
000F6Er 1  85 rr                STA     tmp2
000F70r 1  A5 rr                LDA     tmp1+1
000F72r 1  69 00                ADC     #0
000F74r 1  85 rr                STA     tmp2+1
000F76r 1  A0 A5                LDY     #F_POS
000F78r 1  B1 rr                LDA     (tmp1),y
000F7Ar 1  A8                   TAY
000F7Br 1  B1 rr                LDA     (tmp2),y
000F7Dr 1  C9 0D                CMP     #$0D
000F7Fr 1  F0 1F                BEQ     @frs_done               ; leave CR for READLN
000F81r 1  C9 0A                CMP     #$0A
000F83r 1  F0 1B                BEQ     @frs_done               ; leave LF for READLN
000F85r 1               ; not at EOL — consume and append
000F85r 1  20 rr rr             JSR     file_read_char_helper
000F88r 1  8D rr rr             STA     frs_char
000F8Br 1  AD rr rr             LDA     frs_idx
000F8Er 1  C9 FF                CMP     #255
000F90r 1  B0 D1                BCS     @frs_loop               ; clamp (drop char)
000F92r 1  EE rr rr             INC     frs_idx
000F95r 1  AC rr rr             LDY     frs_idx
000F98r 1  AD rr rr             LDA     frs_char
000F9Br 1  99 00 AC             STA     FRDS_BUF,y
000F9Er 1  80 C3                BRA     @frs_loop
000FA0r 1               @frs_done:
000FA0r 1  AD rr rr             LDA     frs_idx
000FA3r 1  8D 00 AC             STA     FRDS_BUF                ; length byte at offset 0
000FA6r 1               ; store buffer ptr ($AC00) into strvar at tmp3
000FA6r 1  A9 00                LDA     #<FRDS_BUF
000FA8r 1  A0 00                LDY     #0
000FAAr 1  91 rr                STA     (tmp3),y
000FACr 1  C8                   INY
000FADr 1  A9 AC                LDA     #>FRDS_BUF
000FAFr 1  91 rr                STA     (tmp3),y
000FB1r 1  4C rr rr             JMP     prun_loop
000FB4r 1               
000FB4r 1               ; OP_FWRB ($BE) — NOS=fileptr, TOS=bool → append "TRUE"/"FALSE"
000FB4r 1               op_FWRB:
000FB4r 1  20 rr rr             JSR     pm_pop                  ; bool value
000FB7r 1  85 rr                STA     tmp2
000FB9r 1  A5 rr                LDA     scratch
000FBBr 1  05 rr                ORA     tmp2
000FBDr 1  85 rr                STA     tmp2                    ; tmp2 = nonzero if true
000FBFr 1  20 rr rr             JSR     pm_pop                  ; file ptr
000FC2r 1  85 rr                STA     tmp1
000FC4r 1  A5 rr                LDA     scratch
000FC6r 1  85 rr                STA     tmp1+1
000FC8r 1  A5 rr                LDA     tmp2
000FCAr 1  F0 17                BEQ     @fwb_false
000FCCr 1               ; "TRUE"
000FCCr 1  A9 54                LDA     #'T'
000FCEr 1  20 rr rr             JSR     file_write_char_helper
000FD1r 1  A9 52                LDA     #'R'
000FD3r 1  20 rr rr             JSR     file_write_char_helper
000FD6r 1  A9 55                LDA     #'U'
000FD8r 1  20 rr rr             JSR     file_write_char_helper
000FDBr 1  A9 45                LDA     #'E'
000FDDr 1  20 rr rr             JSR     file_write_char_helper
000FE0r 1  4C rr rr             JMP     prun_loop
000FE3r 1               @fwb_false:
000FE3r 1  A9 46                LDA     #'F'
000FE5r 1  20 rr rr             JSR     file_write_char_helper
000FE8r 1  A9 41                LDA     #'A'
000FEAr 1  20 rr rr             JSR     file_write_char_helper
000FEDr 1  A9 4C                LDA     #'L'
000FEFr 1  20 rr rr             JSR     file_write_char_helper
000FF2r 1  A9 53                LDA     #'S'
000FF4r 1  20 rr rr             JSR     file_write_char_helper
000FF7r 1  A9 45                LDA     #'E'
000FF9r 1  20 rr rr             JSR     file_write_char_helper
000FFCr 1  4C rr rr             JMP     prun_loop
000FFFr 1               
000FFFr 1               ; OP_FEOLN ($BF) — TOS=fileptr → push BOOL: true if EOF, CR, or LF is next
000FFFr 1               op_FEOLN:
000FFFr 1  20 rr rr             JSR     pm_pop
001002r 1  85 rr                STA     tmp1
001004r 1  A5 rr                LDA     scratch
001006r 1  85 rr                STA     tmp1+1
001008r 1  A0 A6                LDY     #F_EOF
00100Ar 1  B1 rr                LDA     (tmp1),y
00100Cr 1  D0 26                BNE     @feol_true
00100Er 1               ; peek current char without consuming
00100Er 1  18                   CLC
00100Fr 1  A5 rr                LDA     tmp1
001011r 1  69 24                ADC     #F_BUF
001013r 1  85 rr                STA     tmp2
001015r 1  A5 rr                LDA     tmp1+1
001017r 1  69 00                ADC     #0
001019r 1  85 rr                STA     tmp2+1
00101Br 1  A0 A5                LDY     #F_POS
00101Dr 1  B1 rr                LDA     (tmp1),y
00101Fr 1  A8                   TAY
001020r 1  B1 rr                LDA     (tmp2),y
001022r 1  C9 0D                CMP     #$0D
001024r 1  F0 0E                BEQ     @feol_true
001026r 1  C9 0A                CMP     #$0A
001028r 1  F0 0A                BEQ     @feol_true
00102Ar 1  A9 00                LDA     #0
00102Cr 1  85 rr                STA     scratch
00102Er 1  20 rr rr             JSR     pm_push
001031r 1  4C rr rr             JMP     prun_loop
001034r 1               @feol_true:
001034r 1  A9 FF                LDA     #$FF
001036r 1  85 rr                STA     scratch
001038r 1  A9 FF                LDA     #$FF
00103Ar 1  20 rr rr             JSR     pm_push
00103Dr 1  4C rr rr             JMP     prun_loop
001040r 1               
