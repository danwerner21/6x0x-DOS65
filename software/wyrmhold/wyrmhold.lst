003604  2               
003604  1                       .INCLUDE "video.asm"
003604  2               ;______________________________________________________________________________
003604  2               ;  video.asm - memory-mapped video: paging, framing, viewport, UI text
003604  2               ;
003604  2               ;  Direct VRAM access (the fast path used by SpeedScript): map video
003604  2               ;  sub-page $F9 into CPU bank $A.  Then:
003604  2               ;     text  char at  $A000 + row*80 + col
003604  2               ;     color cell at  $A800 + row*80 + col
003604  2               ;  Color byte = (bg<<4)|fg.
003604  2               ;
003604  2               ;  All direct-write routines must be bracketed by vid_enter / vid_exit.
003604  2               ;  UI text via the firmware (prmsg / putxy) does NOT page; it uses
003604  2               ;  FARCALL chrout/locate and must be used while in task 0.
003604  2               ;______________________________________________________________________________
003604  2               
003604  2               ;----------------------------------------------------------------
003604  2               ; vid_enter - map video text/color page into $A000-$AFFF (task 1)
003604  2               ;             trashes A,X ; preserves Y
003604  2               ;----------------------------------------------------------------
003604  2               vid_enter:
003604  2  A9 01                LDA     #$01            ; configure task 01
003606  2  A2 0A                LDX     #$0A            ; CPU bank $A ($A000-$AFFF)
003608  2  A0 F9                LDY     #VIDTEXT_PAGE   ; physical video page $F9
00360A  2  20 F6 FF             JSR     SETPAGE
00360D  2  A9 01                LDA     #$01
00360F  2  8D E0 EF             STA     PC6502_ACT_TASK ; activate task 01
003612  2  60                   RTS
003613  2               
003613  2               ;----------------------------------------------------------------
003613  2               ; vid_exit - restore normal memory at $A000 (task 0)
003613  2               ;----------------------------------------------------------------
003613  2               vid_exit:
003613  2  A9 00                LDA     #$00
003615  2  8D E0 EF             STA     PC6502_ACT_TASK
003618  2  60                   RTS
003619  2               
003619  2               ;----------------------------------------------------------------
003619  2               ; rowbase - compute VRAM pointers for the start of a screen row.
003619  2               ;   IN : A = row (0..23)
003619  2               ;   OUT: vptr -> $A000 + row*80   (text)
003619  2               ;        cptr -> $A800 + row*80   (color)
003619  2               ;   row*80 = row*64 + row*16 = (row<<6)+(row<<4)
003619  2               ;----------------------------------------------------------------
003619  2               rowbase:
003619  2  85 20                STA     tmp0            ; row
00361B  2               ; row*16 -> ptr2
00361B  2  A9 00                LDA     #0
00361D  2  85 13                STA     ptr2+1
00361F  2  A5 20                LDA     tmp0
003621  2  0A                   ASL     A               ; *2
003622  2  0A                   ASL     A               ; *4
003623  2  0A                   ASL     A               ; *8
003624  2  0A                   ASL     A               ; *16 (row<=23 so <=368, may set carry)
003625  2  85 12                STA     ptr2
003627  2  A9 00                LDA     #0
003629  2  2A                   ROL     A
00362A  2  85 13                STA     ptr2+1          ; high bits of row*16
00362C  2               ; row*64 -> ptr
00362C  2  A5 20                LDA     tmp0
00362E  2  85 10                STA     ptr
003630  2  A9 00                LDA     #0
003632  2  85 11                STA     ptr+1
003634  2  06 10                ASL     ptr
003636  2  26 11                ROL     ptr+1           ; *2
003638  2  06 10                ASL     ptr
00363A  2  26 11                ROL     ptr+1           ; *4
00363C  2  06 10                ASL     ptr
00363E  2  26 11                ROL     ptr+1           ; *8
003640  2  06 10                ASL     ptr
003642  2  26 11                ROL     ptr+1           ; *16
003644  2  06 10                ASL     ptr
003646  2  26 11                ROL     ptr+1           ; *32
003648  2  06 10                ASL     ptr
00364A  2  26 11                ROL     ptr+1           ; *64
00364C  2               ; ptr = ptr + ptr2 = row*80
00364C  2  18                   CLC
00364D  2  A5 10                LDA     ptr
00364F  2  65 12                ADC     ptr2
003651  2  85 10                STA     ptr
003653  2  A5 11                LDA     ptr+1
003655  2  65 13                ADC     ptr2+1
003657  2  85 11                STA     ptr+1
003659  2               ; vptr = $A000 + ptr
003659  2  18                   CLC
00365A  2  A5 10                LDA     ptr
00365C  2  85 14                STA     vptr
00365E  2  A5 11                LDA     ptr+1
003660  2  69 A0                ADC     #>VRAM_TEXT
003662  2  85 15                STA     vptr+1
003664  2               ; cptr = $A800 + ptr
003664  2  18                   CLC
003665  2  A5 10                LDA     ptr
003667  2  85 16                STA     cptr
003669  2  A5 11                LDA     ptr+1
00366B  2  69 A8                ADC     #>VRAM_COLOR
00366D  2  85 17                STA     cptr+1
00366F  2  60                   RTS
003670  2               
003670  2               ;----------------------------------------------------------------
003670  2               ; putcell - write one char+color cell directly to VRAM.
003670  2               ;   MUST be called between vid_enter / vid_exit.
003670  2               ;   IN : tmp1 = row, tmp2 = col, tmp3 = char, colidx = color
003670  2               ;   trashes A,Y
003670  2               ;----------------------------------------------------------------
003670  2               putcell:
003670  2  A5 21                LDA     tmp1
003672  2  20 19 36             JSR     rowbase
003675  2  A4 22                LDY     tmp2
003677  2  A5 23                LDA     tmp3
003679  2  91 14                STA     (vptr),Y
00367B  2  A5 26                LDA     colidx
00367D  2  91 16                STA     (cptr),Y
00367F  2  60                   RTS
003680  2               
003680  2               ;----------------------------------------------------------------
003680  2               ; cls_vram - fill the whole screen with spaces in C_BLANK.
003680  2               ;----------------------------------------------------------------
003680  2               cls_vram:
003680  2  20 04 36             JSR     vid_enter
003683  2  A9 00                LDA     #0
003685  2  85 27                STA     rowidx
003687  2               @row:
003687  2  A5 27                LDA     rowidx
003689  2  20 19 36             JSR     rowbase
00368C  2  A0 00                LDY     #0
00368E  2               @col:
00368E  2  A9 20                LDA     #space
003690  2  91 14                STA     (vptr),Y
003692  2  A9 08                LDA     #C_BLANK
003694  2  91 16                STA     (cptr),Y
003696  2  C8                   INY
003697  2  C0 50                CPY     #SCRW
003699  2  D0 F3                BNE     @col
00369B  2  E6 27                INC     rowidx
00369D  2  A5 27                LDA     rowidx
00369F  2  C9 18                CMP     #SCRH
0036A1  2  D0 E4                BNE     @row
0036A3  2  4C 13 36             JMP     vid_exit
0036A6  2               
0036A6  2               ;----------------------------------------------------------------
0036A6  2               ; fillrow_vram - fill one row [colA..colB) with char/color.
0036A6  2               ;   IN: tmp1=row, tmp2=start col, tmp3=char, colidx=color, cnt0=count
0036A6  2               ;   MUST be inside vid_enter/vid_exit.
0036A6  2               ;----------------------------------------------------------------
0036A6  2               fillrow_vram:
0036A6  2  A5 21                LDA     tmp1
0036A8  2  20 19 36             JSR     rowbase
0036AB  2  A4 22                LDY     tmp2
0036AD  2  A6 24                LDX     cnt0
0036AF  2               @fl:
0036AF  2  A5 23                LDA     tmp3
0036B1  2  91 14                STA     (vptr),Y
0036B3  2  A5 26                LDA     colidx
0036B5  2  91 16                STA     (cptr),Y
0036B7  2  C8                   INY
0036B8  2  CA                   DEX
0036B9  2  D0 F4                BNE     @fl
0036BB  2  60                   RTS
0036BC  2               
0036BC  2               ;----------------------------------------------------------------
0036BC  2               ; draw_frame - draw the static game UI: title bar, viewport frame,
0036BC  2               ;              stat panel frame, and message area divider.
0036BC  2               ;              Done once at game start (and after returning from
0036BC  2               ;              full-screen menus).
0036BC  2               ;----------------------------------------------------------------
0036BC  2               draw_frame:
0036BC  2  20 80 36             JSR     cls_vram
0036BF  2  20 04 36             JSR     vid_enter
0036C2  2               
0036C2  2               ; --- top title bar (row 0) ---
0036C2  2  A9 00                LDA     #0
0036C4  2  85 21                STA     tmp1
0036C6  2  A9 00                LDA     #0
0036C8  2  85 22                STA     tmp2
0036CA  2  A9 20                LDA     #space
0036CC  2  85 23                STA     tmp3
0036CE  2  A9 0E                LDA     #C_TITLE
0036D0  2  85 26                STA     colidx
0036D2  2  A9 50                LDA     #SCRW
0036D4  2  85 24                STA     cnt0
0036D6  2  20 A6 36             JSR     fillrow_vram
0036D9  2               ; centered title text written below via vid_exit path
0036D9  2               
0036D9  2               ; --- viewport top/bottom horizontal borders ---
0036D9  2               ; top border at row 0 already part of title; we frame the
0036D9  2               ; viewport with vertical bars and a bottom rule at VPY0+VPH.
0036D9  2               ; vertical left/right bars for viewport rows
0036D9  2  A2 01                LDX     #VPY0
0036DB  2               @vbar:
0036DB  2  8A                   TXA
0036DC  2  85 21                STA     tmp1
0036DE  2  20 19 36             JSR     rowbase
0036E1  2  A0 00                LDY     #0              ; left edge col 0
0036E3  2  A9 7C                LDA     #'|'
0036E5  2  91 14                STA     (vptr),Y
0036E7  2  A9 0B                LDA     #C_BORDER
0036E9  2  91 16                STA     (cptr),Y
0036EB  2  A0 2D                LDY     #(VPW+1)        ; right edge of viewport
0036ED  2  A9 7C                LDA     #'|'
0036EF  2  91 14                STA     (vptr),Y
0036F1  2  A9 0B                LDA     #C_BORDER
0036F3  2  91 16                STA     (cptr),Y
0036F5  2  E8                   INX
0036F6  2  E0 15                CPX     #(VPY0+VPH)
0036F8  2  D0 E1                BNE     @vbar
0036FA  2               
0036FA  2               ; viewport bottom rule + message divider share row VPY0+VPH
0036FA  2               ; (= MSGY0-1).  Draw it full-width.
0036FA  2  A9 15                LDA     #(VPY0+VPH)
0036FC  2  85 21                STA     tmp1
0036FE  2  A9 00                LDA     #0
003700  2  85 22                STA     tmp2
003702  2  A9 3D                LDA     #'='
003704  2  85 23                STA     tmp3
003706  2  A9 0B                LDA     #C_BORDER
003708  2  85 26                STA     colidx
00370A  2  A9 50                LDA     #SCRW
00370C  2  85 24                STA     cnt0
00370E  2  20 A6 36             JSR     fillrow_vram
003711  2               
003711  2               ; panel header row (row 1) background highlight
003711  2  A9 01                LDA     #1
003713  2  85 21                STA     tmp1
003715  2  A9 2E                LDA     #(VPW+2)
003717  2  85 22                STA     tmp2
003719  2  A9 20                LDA     #space
00371B  2  85 23                STA     tmp3
00371D  2  A9 1E                LDA     #C_PANELHDR
00371F  2  85 26                STA     colidx
003721  2  A9 22                LDA     #(SCRW-(VPW+2))
003723  2  85 24                STA     cnt0
003725  2  20 A6 36             JSR     fillrow_vram
003728  2               
003728  2  20 13 36             JSR     vid_exit
00372B  2               
00372B  2               ; write the title bar + panel header text via firmware
00372B  2  A2 1E                LDX     #30
00372D  2  A0 00                LDY     #0
00372F  2  20 52 37             JSR     locate
003732  2  A9 0E                LDA     #C_TITLE
003734  2  8D 4A 06             STA     CURCOLOR
003737  2  A9 F2 A0 38          PRINTMSG titlebar
00373B  2  20 64 37     
00373E  2               
00373E  2  A2 30                LDX     #(VPW+4)
003740  2  A0 01                LDY     #1
003742  2  20 52 37             JSR     locate
003745  2  A9 1E                LDA     #C_PANELHDR
003747  2  8D 4A 06             STA     CURCOLOR
00374A  2  A9 06 A0 39          PRINTMSG panelhdr
00374E  2  20 64 37     
003751  2  60                   RTS
003752  2               
003752  2               ;----------------------------------------------------------------
003752  2               ; locate - position the firmware text cursor.  X=col, Y=row.
003752  2               ;----------------------------------------------------------------
003752  2               locate:
003752  2  A9 25 85 32          FARCALL FC_LOCATE
003756  2  20 F0 FF     
003759  2  60                   RTS
00375A  2               
00375A  2               ;----------------------------------------------------------------
00375A  2               ; putc - output one char via firmware (A=char), honoring CURCOLOR.
00375A  2               ;        (Cannot use the FARCALL macro - it would clobber the char
00375A  2               ;         in A.  Set farfunct, then restore A before the call.)
00375A  2               ;----------------------------------------------------------------
00375A  2               putc:
00375A  2  48                   PHA
00375B  2  A9 13                LDA     #FC_CHROUT
00375D  2  85 32                STA     farfunct
00375F  2  68                   PLA
003760  2  20 F0 FF             JSR     DO_FARCALL
003763  2  60                   RTS
003764  2               
003764  2               ;----------------------------------------------------------------
003764  2               ; prmsg - print a 0-terminated string via firmware chrout.
003764  2               ;   IN: A=lo, Y=hi of string address.  Uses CURCOLOR for color.
003764  2               ;----------------------------------------------------------------
003764  2               prmsg:
003764  2  85 1C                STA     strp
003766  2  84 1D                STY     strp+1
003768  2  A0 00                LDY     #0
00376A  2               @pl:
00376A  2  B1 1C                LDA     (strp),Y
00376C  2  F0 08                BEQ     @done
00376E  2  5A                   PHY
00376F  2  20 5A 37             JSR     putc
003772  2  7A                   PLY
003773  2  C8                   INY
003774  2  D0 F4                BNE     @pl
003776  2               @done:
003776  2  60                   RTS
003777  2               
003777  2               ;----------------------------------------------------------------
003777  2               ; putxy - position cursor (X=col,Y=row), set color (A=color),
003777  2               ;         then print string at strp.  Helper for panel fields.
003777  2               ;   IN: tmp2=col, tmp1=row, colidx=color, strp=string ptr
003777  2               ;----------------------------------------------------------------
003777  2               putxy:
003777  2  A6 22                LDX     tmp2
003779  2  A4 21                LDY     tmp1
00377B  2  20 52 37             JSR     locate
00377E  2  A5 26                LDA     colidx
003780  2  8D 4A 06             STA     CURCOLOR
003783  2  A5 1C                LDA     strp
003785  2  A4 1D                LDY     strp+1
003787  2  20 64 37             JSR     prmsg
00378A  2  60                   RTS
00378B  2               
00378B  2               ;----------------------------------------------------------------
00378B  2               ; clear_panel_value - blank a panel field area before redraw.
00378B  2               ;   IN: X=col, Y=row, A=width
00378B  2               ;----------------------------------------------------------------
00378B  2               clear_panel_value:
00378B  2  85 25                STA     cnt1            ; width
00378D  2  20 52 37             JSR     locate
003790  2  A9 0F                LDA     #C_PANEL
003792  2  8D 4A 06             STA     CURCOLOR
003795  2               @cpv:
003795  2  A9 20                LDA     #space
003797  2  20 5A 37             JSR     putc
00379A  2  C6 25                DEC     cnt1
00379C  2  D0 F7                BNE     @cpv
00379E  2  60                   RTS
00379F  2               
00379F  2               ;----------------------------------------------------------------
00379F  2               ; render_view - draw the scrolling map viewport centered on the
00379F  2               ; player. Each world tile is a 2x2 character-cell metatile.
00379F  2               ;
00379F  2               ;   uses: px,py (player world coords), loc (active map)
00379F  2               ;   The top-left WORLD cell shown is (px-VPCX, py-VPCY).
00379F  2               ;----------------------------------------------------------------
00379F  2               render_view:
00379F  2  20 04 36             JSR     vid_enter
0037A2  2               ; world-tile row = 0..VPTH-1
0037A2  2  A9 00                LDA     #0
0037A4  2  85 27                STA     rowidx
0037A6  2               @vrow:
0037A6  2               ; world y for this row = py - VPCY + rowidx
0037A6  2  38                   SEC
0037A7  2  AD 6C 4D             LDA     py
0037AA  2  E9 05                SBC     #VPCY
0037AC  2  18                   CLC
0037AD  2  65 27                ADC     rowidx
0037AF  2  85 2D                STA     tgty
0037B1  2               ; world-tile column loop
0037B1  2  A9 00                LDA     #0
0037B3  2  85 26                STA     colidx
0037B5  2               @vcol:
0037B5  2               ; world x = px - VPCX + colidx
0037B5  2  38                   SEC
0037B6  2  AD 6B 4D             LDA     px
0037B9  2  E9 0B                SBC     #VPCX
0037BB  2  18                   CLC
0037BC  2  65 26                ADC     colidx
0037BE  2  85 2C                STA     tgtx
0037C0  2               ; fetch tile (returns tgttile)
0037C0  2  20 CF 19             JSR     tileat
0037C3  2               ; metatile base glyph = MG_TERRAIN_BASE + tile_code*4
0037C3  2  A5 2E                LDA     tgttile
0037C5  2  0A                   ASL     A
0037C6  2  0A                   ASL     A
0037C7  2  18                   CLC
0037C8  2  69 80                ADC     #MG_TERRAIN_BASE
0037CA  2  85 24                STA     cnt0
0037CC  2  A6 2E                LDX     tgttile
0037CE  2  BD 67 18             LDA     tile_color,X
0037D1  2  85 25                STA     cnt1
0037D3  2               ; pick an alternate art variant for some cells so large regions of
0037D3  2               ; one terrain don't show an obvious repeating grid. A terrain has a
0037D3  2               ; variant iff tile_variant[code] != 0; we use it when the cheap
0037D3  2               ; position hash (tgtx ^ tgty) bit0 is set.
0037D3  2  BD 78 18             LDA     tile_variant,X
0037D6  2  F0 0D                BEQ     @novar          ; this terrain has no variant
0037D8  2  A5 2C                LDA     tgtx
0037DA  2  45 2D                EOR     tgty
0037DC  2  29 01                AND     #$01
0037DE  2  F0 05                BEQ     @novar          ; hash says keep the base art
0037E0  2  BD 78 18             LDA     tile_variant,X  ; swap in the variant metatile base
0037E3  2  85 24                STA     cnt0
0037E5  2               @novar:
0037E5  2               ; screen column = VPX0 + colidx*2
0037E5  2  A5 26                LDA     colidx
0037E7  2  0A                   ASL     A
0037E8  2  18                   CLC
0037E9  2  69 01                ADC     #VPX0
0037EB  2  85 22                STA     tmp2
0037ED  2               ; screen row = VPY0 + rowidx*2
0037ED  2  A5 27                LDA     rowidx
0037EF  2  0A                   ASL     A
0037F0  2  18                   CLC
0037F1  2  69 01                ADC     #VPY0
0037F3  2  85 23                STA     tmp3
0037F5  2  20 3F 38             JSR     blit_metatile_vram
0037F8  2               ; next column
0037F8  2  E6 26                INC     colidx
0037FA  2  A5 26                LDA     colidx
0037FC  2  C9 16                CMP     #VPTW
0037FE  2  D0 B5                BNE     @vcol
003800  2               ; next row
003800  2  E6 27                INC     rowidx
003802  2  A5 27                LDA     rowidx
003804  2  C9 0A                CMP     #VPTH
003806  2  D0 9E                BNE     @vrow
003808  2               
003808  2               ; --- overlay monsters that fall within the viewport ---
003808  2  20 10 3E             JSR     draw_monsters_vram
00380B  2               
00380B  2               ; --- overlay fixed location characters ---
00380B  2  20 24 38             JSR     draw_castle_ruler_vram
00380E  2               
00380E  2               ; --- overlay the player at the fixed center metatile ---
00380E  2  A9 C4                LDA     #MG_PLAYER
003810  2  85 24                STA     cnt0
003812  2  A9 0F                LDA     #C_PLAYER
003814  2  85 25                STA     cnt1
003816  2  A9 17                LDA     #(VPX0+(VPCX*2))
003818  2  85 22                STA     tmp2
00381A  2  A9 0B                LDA     #(VPY0+(VPCY*2))
00381C  2  85 23                STA     tmp3
00381E  2  20 7C 38             JSR     blit_entity_vram
003821  2               
003821  2  4C 13 36             JMP     vid_exit
003824  2               
003824  2               ;----------------------------------------------------------------
003824  2               ; draw_castle_ruler_vram - draw the ruler over the audience-room
003824  2               ; throne using the player silhouette in royal colors.
003824  2               ;----------------------------------------------------------------
003824  2               draw_castle_ruler_vram:
003824  2  AD 78 4D             LDA     loc
003827  2  C9 03                CMP     #LOC_CASTLE
003829  2  D0 13                BNE     @done
00382B  2  A9 0F                LDA     #CASTLE_RULER_X
00382D  2  85 2C                STA     tgtx
00382F  2  A9 04                LDA     #CASTLE_RULER_Y
003831  2  85 2D                STA     tgty
003833  2  A9 C4                LDA     #MG_PLAYER
003835  2  85 24                STA     cnt0
003837  2  A9 4E                LDA     #COLOR(CO_BRYELLOW,CO_RED)
003839  2  85 25                STA     cnt1
00383B  2  4C C4 38             JMP     plot_view_cell
00383E  2               @done:
00383E  2  60                   RTS
00383F  2               
00383F  2               ;----------------------------------------------------------------
00383F  2               ; blit_metatile_vram - draw a 2x2 terrain metatile with one color.
00383F  2               ;   IN: cnt0=base glyph, cnt1=color, tmp2=screen col, tmp3=screen row
00383F  2               ;   MUST be called inside vid_enter/vid_exit.
00383F  2               ;----------------------------------------------------------------
00383F  2               blit_metatile_vram:
00383F  2  A5 23                LDA     tmp3
003841  2  20 19 36             JSR     rowbase
003844  2  A4 22                LDY     tmp2
003846  2  A5 24                LDA     cnt0
003848  2  91 14                STA     (vptr),Y
00384A  2  A5 25                LDA     cnt1
00384C  2  91 16                STA     (cptr),Y
00384E  2  C8                   INY
00384F  2  A5 24                LDA     cnt0
003851  2  18                   CLC
003852  2  69 01                ADC     #1
003854  2  91 14                STA     (vptr),Y
003856  2  A5 25                LDA     cnt1
003858  2  91 16                STA     (cptr),Y
00385A  2               
00385A  2  A5 23                LDA     tmp3
00385C  2  18                   CLC
00385D  2  69 01                ADC     #1
00385F  2  20 19 36             JSR     rowbase
003862  2  A4 22                LDY     tmp2
003864  2  A5 24                LDA     cnt0
003866  2  18                   CLC
003867  2  69 02                ADC     #2
003869  2  91 14                STA     (vptr),Y
00386B  2  A5 25                LDA     cnt1
00386D  2  91 16                STA     (cptr),Y
00386F  2  C8                   INY
003870  2  A5 24                LDA     cnt0
003872  2  18                   CLC
003873  2  69 03                ADC     #3
003875  2  91 14                STA     (vptr),Y
003877  2  A5 25                LDA     cnt1
003879  2  91 16                STA     (cptr),Y
00387B  2  60                   RTS
00387C  2               
00387C  2               ;----------------------------------------------------------------
00387C  2               ; blit_entity_vram - overlay a 2x2 entity metatile while preserving
00387C  2               ; each terrain cell's background color.
00387C  2               ;   IN: cnt0=base glyph, cnt1=entity color, tmp2=screen col,
00387C  2               ;       tmp3=screen row
00387C  2               ;   MUST be called inside vid_enter/vid_exit.
00387C  2               ;----------------------------------------------------------------
00387C  2               blit_entity_vram:
00387C  2  A5 23                LDA     tmp3
00387E  2  20 19 36             JSR     rowbase
003881  2  A4 22                LDY     tmp2
003883  2  A5 24                LDA     cnt0
003885  2  91 14                STA     (vptr),Y
003887  2  20 B5 38             JSR     entity_color_at_y
00388A  2  C8                   INY
00388B  2  A5 24                LDA     cnt0
00388D  2  18                   CLC
00388E  2  69 01                ADC     #1
003890  2  91 14                STA     (vptr),Y
003892  2  20 B5 38             JSR     entity_color_at_y
003895  2               
003895  2  A5 23                LDA     tmp3
003897  2  18                   CLC
003898  2  69 01                ADC     #1
00389A  2  20 19 36             JSR     rowbase
00389D  2  A4 22                LDY     tmp2
00389F  2  A5 24                LDA     cnt0
0038A1  2  18                   CLC
0038A2  2  69 02                ADC     #2
0038A4  2  91 14                STA     (vptr),Y
0038A6  2  20 B5 38             JSR     entity_color_at_y
0038A9  2  C8                   INY
0038AA  2  A5 24                LDA     cnt0
0038AC  2  18                   CLC
0038AD  2  69 03                ADC     #3
0038AF  2  91 14                STA     (vptr),Y
0038B1  2  20 B5 38             JSR     entity_color_at_y
0038B4  2  60                   RTS
0038B5  2               
0038B5  2               ; preserve background nibble at the current cptr,Y; apply cnt1 foreground
0038B5  2               entity_color_at_y:
0038B5  2  B1 16                LDA     (cptr),Y
0038B7  2  29 F0                AND     #$F0
0038B9  2  85 20                STA     tmp0
0038BB  2  A5 25                LDA     cnt1
0038BD  2  29 0F                AND     #$0F
0038BF  2  05 20                ORA     tmp0
0038C1  2  91 16                STA     (cptr),Y
0038C3  2  60                   RTS
0038C4  2               
0038C4  2               ;----------------------------------------------------------------
0038C4  2               ; plot_view_cell - overlay an entity metatile at WORLD coords
0038C4  2               ; (tgtx,tgty) if it is visible.
0038C4  2               ;   IN: tgtx,tgty=world coords, cnt0=base glyph, cnt1=color
0038C4  2               ;   MUST be called inside vid_enter/vid_exit.
0038C4  2               ;----------------------------------------------------------------
0038C4  2               plot_view_cell:
0038C4  2               ; viewport tile column = tgtx - px + VPCX
0038C4  2  38                   SEC
0038C5  2  A5 2C                LDA     tgtx
0038C7  2  ED 6B 4D             SBC     px
0038CA  2  18                   CLC
0038CB  2  69 0B                ADC     #VPCX
0038CD  2               ; must be 0..VPTW-1
0038CD  2  30 22                BMI     @no             ; (signed underflow check via N flag)
0038CF  2  C9 16                CMP     #VPTW
0038D1  2  B0 1E                BCS     @no
0038D3  2  0A                   ASL     A
0038D4  2  18                   CLC
0038D5  2  69 01                ADC     #VPX0
0038D7  2  85 22                STA     tmp2            ; screen column
0038D9  2               ; viewport tile row = tgty - py + VPCY
0038D9  2  38                   SEC
0038DA  2  A5 2D                LDA     tgty
0038DC  2  ED 6C 4D             SBC     py
0038DF  2  18                   CLC
0038E0  2  69 05                ADC     #VPCY
0038E2  2  30 0D                BMI     @no
0038E4  2  C9 0A                CMP     #VPTH
0038E6  2  B0 09                BCS     @no
0038E8  2  0A                   ASL     A
0038E9  2  18                   CLC
0038EA  2  69 01                ADC     #VPY0
0038EC  2  85 23                STA     tmp3            ; screen row
0038EE  2  4C 7C 38             JMP     blit_entity_vram
0038F1  2               @no:
0038F1  2  60                   RTS
0038F2  2               
0038F2  2               ;----------------------------------------------------------------
0038F2  2               ; Static UI strings
0038F2  2               ;----------------------------------------------------------------
0038F2  2               titlebar:
0038F2  2  3D 20 57 20          .BYTE   "= W Y R M H O L D =",0
0038F6  2  59 20 52 20  
0038FA  2  4D 20 48 20  
003906  2               panelhdr:
003906  2  41 44 56 45          .BYTE   "ADVENTURER",0
00390A  2  4E 54 55 52  
00390E  2  45 52 00     
003911  2               
003911  1                       .INCLUDE "ui.asm"
003911  2               ;______________________________________________________________________________
003911  2               ;  ui.asm - message log, stat panel, prompts, decimal output
003911  2               ;______________________________________________________________________________
003911  2               
003911  2               ;----------------------------------------------------------------
003911  2               ; displaynum - print the 16-bit value in numarg as decimal using
003911  2               ;              the firmware (honours CURCOLOR).  No leading spaces.
003911  2               ;              (adapted from speedscript displaynum)
003911  2               ;----------------------------------------------------------------
003911  2               displaynum:
003911  2  A0 08                LDY     #8              ; index into nums (5 entries x2 bytes)
003913  2               @find:
003913  2  A5 1F                LDA     numarg+1
003915  2  D9 5B 39             CMP     nums+1,Y
003918  2  90 09                BCC     @next
00391A  2  D0 0B                BNE     @start
00391C  2  A5 1E                LDA     numarg
00391E  2  D9 5A 39             CMP     nums,Y
003921  2  B0 04                BCS     @start
003923  2               @next:
003923  2  88                   DEY
003924  2  88                   DEY
003925  2  D0 EC                BNE     @find
003927  2               @start:
003927  2  A9 30                LDA     #'0'
003929  2  85 28                STA     numspace
00392B  2               @dig:
00392B  2  A5 1F                LDA     numarg+1
00392D  2  D9 5B 39             CMP     nums+1,Y
003930  2  90 1E                BCC     @out
003932  2  D0 09                BNE     @nocmp
003934  2  A5 1E                LDA     numarg
003936  2  F9 5A 39             SBC     nums,Y          ; carry set
003939  2  90 15                BCC     @out
00393B  2  B0 05                BCS     @sub
00393D  2               @nocmp:
00393D  2  A5 1E                LDA     numarg
00393F  2  F9 5A 39             SBC     nums,Y          ; carry set
003942  2               @sub:
003942  2  E6 28                INC     numspace
003944  2  85 1E                STA     numarg
003946  2  A5 1F                LDA     numarg+1
003948  2  F9 5B 39             SBC     nums+1,Y
00394B  2  85 1F                STA     numarg+1
00394D  2  4C 2B 39             JMP     @dig
003950  2               @out:
003950  2  A5 28                LDA     numspace
003952  2  20 5A 37             JSR     putc
003955  2  88                   DEY
003956  2  88                   DEY
003957  2  10 CE                BPL     @start
003959  2  60                   RTS
00395A  2               
00395A  2               ; place value table (1,10,100,1000,10000) as 16-bit LE words
00395A  2               nums:
00395A  2  01 00                .WORD   1
00395C  2  0A 00                .WORD   10
00395E  2  64 00                .WORD   100
003960  2  E8 03                .WORD   1000
003962  2  10 27                .WORD   10000
003964  2               
003964  2               ;----------------------------------------------------------------
003964  2               ; print a single 8-bit value (in A) as decimal.
003964  2               ;----------------------------------------------------------------
003964  2               print_byte:
003964  2  85 1E                STA     numarg
003966  2  A9 00                LDA     #0
003968  2  85 1F                STA     numarg+1
00396A  2  4C 11 39             JMP     displaynum
00396D  2               
00396D  2               ;----------------------------------------------------------------
00396D  2               ; Message log: two lines at rows MSGY0 and MSGY0+1.
00396D  2               ; msg_print scrolls the bottom line up and prints a new line.
00396D  2               ;
00396D  2               ;   msg_print:  IN A=lo,Y=hi of 0-terminated string
00396D  2               ;----------------------------------------------------------------
00396D  2               msg_print:
00396D  2  85 1C                STA     strp
00396F  2  84 1D                STY     strp+1
003971  2               ; copy current bottom line (msgbuf1) up to (msgbuf0)
003971  2  A2 00                LDX     #0
003973  2               @up:
003973  2  BD E0 4D             LDA     msgbuf1,X
003976  2  9D 90 4D             STA     msgbuf0,X
003979  2  E8                   INX
00397A  2  E0 50                CPX     #SCRW
00397C  2  D0 F5                BNE     @up
00397E  2               ; copy new string into msgbuf1 (truncate/pad to SCRW)
00397E  2  A0 00                LDY     #0
003980  2               @cp:
003980  2  B1 1C                LDA     (strp),Y
003982  2  F0 0B                BEQ     @padb
003984  2  99 E0 4D             STA     msgbuf1,Y
003987  2  C8                   INY
003988  2  C0 50                CPY     #SCRW
00398A  2  D0 F4                BNE     @cp
00398C  2  4C 99 39             JMP     @draw
00398F  2               @padb:
00398F  2  A9 20                LDA     #space
003991  2               @pad:
003991  2  99 E0 4D             STA     msgbuf1,Y
003994  2  C8                   INY
003995  2  C0 50                CPY     #SCRW
003997  2  D0 F8                BNE     @pad
003999  2               @draw:
003999  2  4C 9C 39             JMP     msg_redraw
00399C  2               
00399C  2               ;----------------------------------------------------------------
00399C  2               ; msg_redraw - blit both message buffers to the message rows via
00399C  2               ;              direct VRAM (so it does not disturb the text cursor).
00399C  2               ;----------------------------------------------------------------
00399C  2               msg_redraw:
00399C  2  20 04 36             JSR     vid_enter
00399F  2               ; row MSGY0 <- msgbuf0
00399F  2  A9 16                LDA     #MSGY0
0039A1  2  20 19 36             JSR     rowbase
0039A4  2  A0 00                LDY     #0
0039A6  2               @r0:
0039A6  2  B9 90 4D             LDA     msgbuf0,Y
0039A9  2  91 14                STA     (vptr),Y
0039AB  2  A9 0F                LDA     #C_MSG
0039AD  2  91 16                STA     (cptr),Y
0039AF  2  C8                   INY
0039B0  2  C0 50                CPY     #SCRW
0039B2  2  D0 F2                BNE     @r0
0039B4  2               ; row MSGY0+1 <- msgbuf1
0039B4  2  A9 17                LDA     #MSGY0+1
0039B6  2  20 19 36             JSR     rowbase
0039B9  2  A0 00                LDY     #0
0039BB  2               @r1:
0039BB  2  B9 E0 4D             LDA     msgbuf1,Y
0039BE  2  91 14                STA     (vptr),Y
0039C0  2  A9 0F                LDA     #C_MSG
0039C2  2  91 16                STA     (cptr),Y
0039C4  2  C8                   INY
0039C5  2  C0 50                CPY     #SCRW
0039C7  2  D0 F2                BNE     @r1
0039C9  2  4C 13 36             JMP     vid_exit
0039CC  2               
0039CC  2               ;----------------------------------------------------------------
0039CC  2               ; msg_clear - blank both message buffers and redraw.
0039CC  2               ;----------------------------------------------------------------
0039CC  2               msg_clear:
0039CC  2  A2 00                LDX     #0
0039CE  2  A9 20                LDA     #space
0039D0  2               @mc:
0039D0  2  9D 90 4D             STA     msgbuf0,X
0039D3  2  9D E0 4D             STA     msgbuf1,X
0039D6  2  E8                   INX
0039D7  2  E0 50                CPX     #SCRW
0039D9  2  D0 F5                BNE     @mc
0039DB  2  4C 9C 39             JMP     msg_redraw
0039DE  2               
0039DE  2               ;----------------------------------------------------------------
0039DE  2               ; Stat panel.  Drawn on the right side using firmware text output.
0039DE  2               ; Labels are static; values are redrawn each turn.
0039DE  2               ;----------------------------------------------------------------
0039DE  2               draw_panel:
0039DE  2               ; HP line:  "HP   : nn/nn"
0039DE  2  A2 30                LDX     #PANX
0039E0  2  A0 03                LDY     #3
0039E2  2  20 52 37             JSR     locate
0039E5  2  A9 0F                LDA     #C_PANEL
0039E7  2  8D 4A 06             STA     CURCOLOR
0039EA  2  A9 83 A0 3B          PRINTMSG lbl_hp
0039EE  2  20 64 37     
0039F1  2  AD 6D 4D             LDA     phealth
0039F4  2  20 64 39             JSR     print_byte
0039F7  2  A9 2F                LDA     #'/'
0039F9  2  20 5A 37             JSR     putc
0039FC  2  AD 6E 4D             LDA     pmaxhp
0039FF  2  20 64 39             JSR     print_byte
003A02  2  20 FD 3A             JSR     pad_clear       ; clear trailing junk
003A05  2               
003A05  2               ; Level / XP
003A05  2  A2 30                LDX     #PANX
003A07  2  A0 05                LDY     #5
003A09  2  20 52 37             JSR     locate
003A0C  2  A9 8B A0 3B          PRINTMSG lbl_lvl
003A10  2  20 64 37     
003A13  2  AD 6F 4D             LDA     plevel
003A16  2  20 64 39             JSR     print_byte
003A19  2  A2 3C                LDX     #PANX+12
003A1B  2  A0 05                LDY     #5
003A1D  2  20 52 37             JSR     locate
003A20  2  A9 91 A0 3B          PRINTMSG lbl_xp
003A24  2  20 64 37     
003A27  2  AD 70 4D 85          COPY16  pxp, numarg
003A2B  2  1E AD 71 4D  
003A2F  2  85 1F        
003A31  2  20 11 39             JSR     displaynum
003A34  2  20 FD 3A             JSR     pad_clear
003A37  2               
003A37  2               ; Gold / Food
003A37  2  A2 30                LDX     #PANX
003A39  2  A0 07                LDY     #7
003A3B  2  20 52 37             JSR     locate
003A3E  2  A9 96 A0 3B          PRINTMSG lbl_gold
003A42  2  20 64 37     
003A45  2  AD 72 4D 85          COPY16  pgold, numarg
003A49  2  1E AD 73 4D  
003A4D  2  85 1F        
003A4F  2  20 11 39             JSR     displaynum
003A52  2  A2 3C                LDX     #PANX+12
003A54  2  A0 07                LDY     #7
003A56  2  20 52 37             JSR     locate
003A59  2  A9 9D A0 3B          PRINTMSG lbl_food
003A5D  2  20 64 37     
003A60  2  AD 74 4D 85          COPY16  pfood, numarg
003A64  2  1E AD 75 4D  
003A68  2  85 1F        
003A6A  2  20 11 39             JSR     displaynum
003A6D  2  20 FD 3A             JSR     pad_clear
003A70  2               
003A70  2               ; Weapon
003A70  2  A2 30                LDX     #PANX
003A72  2  A0 09                LDY     #9
003A74  2  20 52 37             JSR     locate
003A77  2  A9 A4 A0 3B          PRINTMSG lbl_wpn
003A7B  2  20 64 37     
003A7E  2  AD 76 4D             LDA     pweapon
003A81  2  20 0D 3B             JSR     name_weapon     ; strp -> name
003A84  2  A5 1C                LDA     strp
003A86  2  A4 1D                LDY     strp+1
003A88  2  20 64 37             JSR     prmsg
003A8B  2  20 FD 3A             JSR     pad_clear
003A8E  2               
003A8E  2               ; Armor
003A8E  2  A2 30                LDX     #PANX
003A90  2  A0 0A                LDY     #10
003A92  2  20 52 37             JSR     locate
003A95  2  A9 AD A0 3B          PRINTMSG lbl_arm
003A99  2  20 64 37     
003A9C  2  AD 77 4D             LDA     parmor
003A9F  2  20 1A 3B             JSR     name_armor
003AA2  2  A5 1C                LDA     strp
003AA4  2  A4 1D                LDY     strp+1
003AA6  2  20 64 37             JSR     prmsg
003AA9  2  20 FD 3A             JSR     pad_clear
003AAC  2               
003AAC  2               ; Location
003AAC  2  A2 30                LDX     #PANX
003AAE  2  A0 0C                LDY     #12
003AB0  2  20 52 37             JSR     locate
003AB3  2  A9 B6 A0 3B          PRINTMSG lbl_loc
003AB7  2  20 64 37     
003ABA  2  AD 78 4D             LDA     loc
003ABD  2  20 27 3B             JSR     name_loc
003AC0  2  A5 1C                LDA     strp
003AC2  2  A4 1D                LDY     strp+1
003AC4  2  20 64 37             JSR     prmsg
003AC7  2  20 FD 3A             JSR     pad_clear
003ACA  2               
003ACA  2               ; Current objective
003ACA  2  A2 30                LDX     #PANX
003ACC  2  A0 0E                LDY     #14
003ACE  2  20 52 37             JSR     locate
003AD1  2  A9 1E                LDA     #C_PANELHDR
003AD3  2  8D 4A 06             STA     CURCOLOR
003AD6  2  A9 BF A0 3B          PRINTMSG lbl_obj
003ADA  2  20 64 37     
003ADD  2  20 FD 3A             JSR     pad_clear
003AE0  2  A2 30                LDX     #PANX
003AE2  2  A0 0F                LDY     #15
003AE4  2  20 52 37             JSR     locate
003AE7  2  A9 0F                LDA     #C_PANEL
003AE9  2  8D 4A 06             STA     CURCOLOR
003AEC  2  AD 7E 4D             LDA     queststate
003AEF  2  20 34 3B             JSR     name_objective
003AF2  2  A5 1C                LDA     strp
003AF4  2  A4 1D                LDY     strp+1
003AF6  2  20 64 37             JSR     prmsg
003AF9  2  20 FD 3A             JSR     pad_clear
003AFC  2  60                   RTS
003AFD  2               
003AFD  2               ; pad_clear - print spaces out to the right screen edge to erase
003AFD  2               ;             any leftover characters from a previous longer value.
003AFD  2               ;             Stops at the last column to avoid auto-scroll.
003AFD  2               pad_clear:
003AFD  2               @pc:
003AFD  2  AD 47 06             LDA     CURX
003B00  2  C9 4F                CMP     #SCRW-1
003B02  2  B0 08                BCS     @done
003B04  2  A9 20                LDA     #space
003B06  2  20 5A 37             JSR     putc
003B09  2  4C FD 3A             JMP     @pc
003B0C  2               @done:
003B0C  2  60                   RTS
003B0D  2               
003B0D  2               ;----------------------------------------------------------------
003B0D  2               ; name_weapon / name_armor / name_loc - set strp to a name string
003B0D  2               ;   IN: A = index
003B0D  2               ;----------------------------------------------------------------
003B0D  2               name_weapon:
003B0D  2  0A                   ASL     A
003B0E  2  AA                   TAX
003B0F  2  BD C9 3B             LDA     wpn_names,X
003B12  2  85 1C                STA     strp
003B14  2  BD CA 3B             LDA     wpn_names+1,X
003B17  2  85 1D                STA     strp+1
003B19  2  60                   RTS
003B1A  2               name_armor:
003B1A  2  0A                   ASL     A
003B1B  2  AA                   TAX
003B1C  2  BD E8 3B             LDA     arm_names,X
003B1F  2  85 1C                STA     strp
003B21  2  BD E9 3B             LDA     arm_names+1,X
003B24  2  85 1D                STA     strp+1
003B26  2  60                   RTS
003B27  2               name_loc:
003B27  2  0A                   ASL     A
003B28  2  AA                   TAX
003B29  2  BD 0C 3C             LDA     loc_names,X
003B2C  2  85 1C                STA     strp
003B2E  2  BD 0D 3C             LDA     loc_names+1,X
003B31  2  85 1D                STA     strp+1
003B33  2  60                   RTS
003B34  2               name_objective:
003B34  2  0A                   ASL     A
003B35  2  AA                   TAX
003B36  2  BD 4A 3C             LDA     objective_names,X
003B39  2  85 1C                STA     strp
003B3B  2  BD 4B 3C             LDA     objective_names+1,X
003B3E  2  85 1D                STA     strp+1
003B40  2  60                   RTS
003B41  2               
003B41  2               ;----------------------------------------------------------------
003B41  2               ; yorn - wait for a Y/N keypress.  Returns Z=1 if Yes (A='Y').
003B41  2               ;----------------------------------------------------------------
003B41  2               yorn:
003B41  2               @wait:
003B41  2  20 5D 3B             JSR     getkey_block
003B44  2  C9 59                CMP     #'Y'
003B46  2  F0 0F                BEQ     @yes
003B48  2  C9 79                CMP     #'y'
003B4A  2  F0 0B                BEQ     @yes
003B4C  2  C9 4E                CMP     #'N'
003B4E  2  F0 0A                BEQ     @no
003B50  2  C9 6E                CMP     #'n'
003B52  2  F0 06                BEQ     @no
003B54  2  4C 41 3B             JMP     @wait
003B57  2               @yes:
003B57  2  A9 00                LDA     #0              ; Z=1
003B59  2  60                   RTS
003B5A  2               @no:
003B5A  2  A9 01                LDA     #1              ; Z=0
003B5C  2  60                   RTS
003B5D  2               
003B5D  2               ;----------------------------------------------------------------
003B5D  2               ; getkey_block - block until a key is pressed; return it in A.
003B5D  2               ;----------------------------------------------------------------
003B5D  2               getkey_block:
003B5D  2               @gk:
003B5D  2  A9 14 85 32          FARCALL FC_CHRIN
003B61  2  20 F0 FF     
003B64  2  C9 FF                CMP     #$FF
003B66  2  F0 F5                BEQ     @gk
003B68  2  60                   RTS
003B69  2               
003B69  2               ;----------------------------------------------------------------
003B69  2               ; getkey - non-blocking read; A=key or 0 if none.
003B69  2               ;----------------------------------------------------------------
003B69  2               getkey:
003B69  2  A9 14 85 32          FARCALL FC_CHRIN
003B6D  2  20 F0 FF     
003B70  2  C9 FF                CMP     #$FF
003B72  2  D0 02                BNE     @got
003B74  2  A9 00                LDA     #0
003B76  2               @got:
003B76  2  60                   RTS
003B77  2               
003B77  2               ;----------------------------------------------------------------
003B77  2               ; drainkeys - consume and discard all buffered keystrokes.
003B77  2               ;----------------------------------------------------------------
003B77  2               drainkeys:
003B77  2               @dk:
003B77  2  A9 14 85 32          FARCALL FC_CHRIN
003B7B  2  20 F0 FF     
003B7E  2  C9 FF                CMP     #$FF
003B80  2  D0 F5                BNE     @dk             ; got a key - keep draining
003B82  2  60                   RTS
003B83  2               
003B83  2               ;----------------------------------------------------------------
003B83  2               ; Panel labels and name tables
003B83  2               ;----------------------------------------------------------------
003B83  2               lbl_hp:
003B83  2  48 50 20 20          .BYTE   "HP   : ",0
003B87  2  20 3A 20 00  
003B8B  2               lbl_lvl:
003B8B  2  4C 76 6C 3A          .BYTE   "Lvl: ",0
003B8F  2  20 00        
003B91  2               lbl_xp:
003B91  2  58 50 3A 20          .BYTE   "XP: ",0
003B95  2  00           
003B96  2               lbl_gold:
003B96  2  47 6F 6C 64          .BYTE   "Gold: ",0
003B9A  2  3A 20 00     
003B9D  2               lbl_food:
003B9D  2  46 6F 6F 64          .BYTE   "Food: ",0
003BA1  2  3A 20 00     
003BA4  2               lbl_wpn:
003BA4  2  57 65 61 70          .BYTE   "Weapon: ",0
003BA8  2  6F 6E 3A 20  
003BAC  2  00           
003BAD  2               lbl_arm:
003BAD  2  41 72 6D 6F          .BYTE   "Armor : ",0
003BB1  2  72 20 3A 20  
003BB5  2  00           
003BB6  2               lbl_loc:
003BB6  2  57 68 65 72          .BYTE   "Where : ",0
003BBA  2  65 20 3A 20  
003BBE  2  00           
003BBF  2               lbl_obj:
003BBF  2  4F 42 4A 45          .BYTE   "OBJECTIVE",0
003BC3  2  43 54 49 56  
003BC7  2  45 00        
003BC9  2               
003BC9  2               wpn_names:
003BC9  2  D1 3B D7 3B          .WORD   wn0, wn1, wn2, wn3
003BCD  2  DE 3B E4 3B  
003BD1  2               wn0:
003BD1  2  46 69 73 74          .BYTE   "Fists",0
003BD5  2  73 00        
003BD7  2               wn1:
003BD7  2  44 61 67 67          .BYTE   "Dagger",0
003BDB  2  65 72 00     
003BDE  2               wn2:
003BDE  2  53 77 6F 72          .BYTE   "Sword",0
003BE2  2  64 00        
003BE4  2               wn3:
003BE4  2  41 78 65 00          .BYTE   "Axe",0
003BE8  2               
003BE8  2               arm_names:
003BE8  2  F0 3B F8 3B          .WORD   an0, an1, an2, an3
003BEC  2  00 3C 06 3C  
003BF0  2               an0:
003BF0  2  43 6C 6F 74          .BYTE   "Clothes",0
003BF4  2  68 65 73 00  
003BF8  2               an1:
003BF8  2  4C 65 61 74          .BYTE   "Leather",0
003BFC  2  68 65 72 00  
003C00  2               an2:
003C00  2  43 68 61 69          .BYTE   "Chain",0
003C04  2  6E 00        
003C06  2               an3:
003C06  2  50 6C 61 74          .BYTE   "Plate",0
003C0A  2  65 00        
003C0C  2               
003C0C  2               loc_names:
003C0C  2  16 3C 1F 3C          .WORD   ln0, ln1, ln2, ln3, ln4
003C10  2  24 3C 2C 3C  
003C14  2  3C 3C        
003C16  2               ln0:
003C16  2  57 79 72 6D          .BYTE   "Wyrmhold",0
003C1A  2  68 6F 6C 64  
003C1E  2  00           
003C1F  2               ln1:
003C1F  2  54 6F 77 6E          .BYTE   "Town",0
003C23  2  00           
003C24  2               ln2:
003C24  2  44 75 6E 67          .BYTE   "Dungeon",0
003C28  2  65 6F 6E 00  
003C2C  2               ln3:
003C2C  2  57 79 72 6D          .BYTE   "Wyrmhold Castle",0
003C30  2  68 6F 6C 64  
003C34  2  20 43 61 73  
003C3C  2               ln4:
003C3C  2  53 75 6E 6B          .BYTE   "Sunken Shrine",0
003C40  2  65 6E 20 53  
003C44  2  68 72 69 6E  
003C4A  2               
003C4A  2               objective_names:
003C4A  2  52 3C 67 3C          .WORD   obj0, obj1, obj2, obj3
003C4E  2  79 3C 8D 3C  
003C52  2               obj0:
003C52  2  53 65 65 6B          .BYTE   "Seek Wyrmhold Castle",0
003C56  2  20 57 79 72  
003C5A  2  6D 68 6F 6C  
003C67  2               obj1:
003C67  2  46 69 6E 64          .BYTE   "Find the Wyrm Key",0
003C6B  2  20 74 68 65  
003C6F  2  20 57 79 72  
