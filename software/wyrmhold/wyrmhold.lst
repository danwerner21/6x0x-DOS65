001602  3  EC 08 14 22          .BYTE   MGV_MOUNT+0, %00001000,%00010100,%00100010,%01000001,%10000010,%00000100,%00001000,%00010000
001606  3  41 82 04 08  
00160A  3  10           
00160B  3  ED 00 00 C0          .BYTE   MGV_MOUNT+1, %00000000,%00000000,%11000000,%00100000,%00010000,%00001000,%00000100,%00000010
00160F  3  20 10 08 04  
