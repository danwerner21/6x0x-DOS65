004083  2               ;----------------------------------------------------------------
004083  2               ; In-game help panel. Opening and closing it consumes no game turn.
004083  2               ;----------------------------------------------------------------
004083  2               HELP_X0         = 3
004083  2               HELP_X1         = 42
004083  2               HELP_Y0         = 3
004083  2               HELP_Y1         = 17
004083  2               
004083  2               help_menu:
004083  2  20 8D 40             JSR     help_draw
004086  2  20 93 41             JSR     drainkeys       ; do not close on a buffered '?' repeat
004089  2  20 79 41             JSR     getkey_block
00408C  2  60                   RTS
00408D  2               
00408D  2               help_draw:
00408D  2               ; Paint a bordered overlay inside the viewport.
00408D  2  20 8D 3A             JSR     vid_enter
004090  2  A9 03                LDA     #HELP_Y0
004092  2  85 27                STA     rowidx
004094  2               @bgrow:
004094  2  A5 27                LDA     rowidx
004096  2  20 A2 3A             JSR     rowbase
004099  2  A0 03                LDY     #HELP_X0
00409B  2               @bgcol:
00409B  2  C0 03                CPY     #HELP_X0
00409D  2  F0 19                BEQ     @edge
00409F  2  C0 2A                CPY     #HELP_X1
0040A1  2  F0 15                BEQ     @edge
0040A3  2  A5 27                LDA     rowidx
0040A5  2  C9 03                CMP     #HELP_Y0
0040A7  2  F0 0F                BEQ     @edge
0040A9  2  C9 11                CMP     #HELP_Y1
0040AB  2  F0 0B                BEQ     @edge
0040AD  2  A9 20                LDA     #space
0040AF  2  91 14                STA     (vptr),Y
0040B1  2  A9 1F                LDA     #C_SHOPBG
0040B3  2  91 16                STA     (cptr),Y
0040B5  2  4C C0 40             JMP     @bgnext
0040B8  2               @edge:
0040B8  2  A9 20                LDA     #space
0040BA  2  91 14                STA     (vptr),Y
0040BC  2  A9 1B                LDA     #C_SHOPBRD
0040BE  2  91 16                STA     (cptr),Y
0040C0  2               @bgnext:
0040C0  2  C8                   INY
0040C1  2  C0 2B                CPY     #HELP_X1+1
0040C3  2  D0 D6                BNE     @bgcol
0040C5  2  E6 27                INC     rowidx
0040C7  2  A5 27                LDA     rowidx
0040C9  2  C9 12                CMP     #HELP_Y1+1
0040CB  2  D0 C7                BNE     @bgrow
0040CD  2  20 9C 3A             JSR     vid_exit
0040D0  2               
0040D0  2  A9 1E                LDA     #C_SHOPTTL
0040D2  2  8D 4A 06             STA     CURCOLOR
