004CB3  2  8D 7C 51             STA     bosskilled
004CB6  2  20 2A 0E             JSR     sfx_levelup
004CB9  2  A9 E7 A0 4E          PRINTMSG_MSG c_finale1
004CBD  2  20 F4 39     
004CC0  2  A9 22 A0 4F          PRINTMSG_MSG c_finale2
004CC4  2  20 F4 39     
004CC7  2  60                   RTS
