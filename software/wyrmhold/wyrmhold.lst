005D6A  2               ;----------------------------------------------------------------
005D6A  2               ; ruler_adjacent - C=1 if player is orthogonally adjacent to the
005D6A  2               ; ruler's throne. The throne itself is a wall and cannot be entered.
005D6A  2               ;----------------------------------------------------------------
005D6A  2               ruler_adjacent:
005D6A  2  AD 0C 62             LDA     px
005D6D  2  C9 0F                CMP     #CASTLE_RULER_X
005D6F  2  D0 0D                BNE     @side
005D71  2  AD 0D 62             LDA     py
005D74  2  C9 03                CMP     #CASTLE_RULER_Y-1
005D76  2  F0 1A                BEQ     @yes
005D78  2  C9 05                CMP     #CASTLE_RULER_Y+1
005D7A  2  F0 16                BEQ     @yes
005D7C  2  18                   CLC
005D7D  2  60                   RTS
005D7E  2               @side:
005D7E  2  AD 0D 62             LDA     py
005D81  2  C9 04                CMP     #CASTLE_RULER_Y
005D83  2  D0 0B                BNE     @no
005D85  2  AD 0C 62             LDA     px
005D88  2  C9 0E                CMP     #CASTLE_RULER_X-1
005D8A  2  F0 06                BEQ     @yes
005D8C  2  C9 10                CMP     #CASTLE_RULER_X+1
005D8E  2  F0 02                BEQ     @yes
005D90  2               @no:
005D90  2  18                   CLC
005D91  2  60                   RTS
005D92  2               @yes:
005D92  2  38                   SEC
005D93  2  60                   RTS
