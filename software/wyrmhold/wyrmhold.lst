005964  2  A9 00                LDA     #SHOPTXT_HEADER
005966  2  20 00 59             JSR     shop_print_line
005969  2               
005969  2  A9 1F                LDA     #C_SHOPTXT
00596B  2  8D 4A 06             STA     CURCOLOR
00596E  2  A2 06                LDX     #SHOP_X0+3
005970  2  A0 06                LDY     #SHOP_Y0+2
005972  2  20 DB 3B             JSR     locate
005975  2  A9 01                LDA     #SHOPTXT_HEAL
005977  2  20 00 59             JSR     shop_print_line
00597A  2  A2 06                LDX     #SHOP_X0+3
00597C  2  A0 07                LDY     #SHOP_Y0+3
00597E  2  20 DB 3B             JSR     locate
005981  2  A9 02                LDA     #SHOPTXT_FOOD
005983  2  20 00 59             JSR     shop_print_line
005986  2  A2 06                LDX     #SHOP_X0+3
005988  2  A0 08                LDY     #SHOP_Y0+4
00598A  2  20 DB 3B             JSR     locate
00598D  2  A9 03                LDA     #SHOPTXT_WEAPON
00598F  2  20 00 59             JSR     shop_print_line
005992  2  A2 06                LDX     #SHOP_X0+3
005994  2  A0 09                LDY     #SHOP_Y0+5
005996  2  20 DB 3B             JSR     locate
005999  2  A9 04                LDA     #SHOPTXT_ARMOR
00599B  2  20 00 59             JSR     shop_print_line
00599E  2  A2 06                LDX     #SHOP_X0+3
0059A0  2  A0 0A                LDY     #SHOP_Y0+6
0059A2  2  20 DB 3B             JSR     locate
0059A5  2  A9 1E A0 5B          PRINTMSG t_optx
0059A9  2  20 ED 3B     
0059AC  2  A2 06                LDX     #SHOP_X0+3
0059AE  2  A0 0B                LDY     #SHOP_Y0+7
0059B0  2  20 DB 3B             JSR     locate
0059B3  2  A9 30 A0 5B          PRINTMSG t_weapon_hint
0059B7  2  20 ED 3B     
0059BA  2               
0059BA  2               ; gold line
0059BA  2  A2 06                LDX     #SHOP_X0+3
0059BC  2  A0 0C                LDY     #SHOP_Y0+8
0059BE  2  20 DB 3B             JSR     locate
0059C1  2  A9 1F                LDA     #C_SHOPTXT
0059C3  2  8D 4A 06             STA     CURCOLOR
0059C6  2  A9 54 A0 5B          PRINTMSG t_gold
0059CA  2  20 ED 3B     
0059CD  2  AD 13 62 85          COPY16  pgold, numarg
0059D1  2  1E AD 14 62  
0059D5  2  85 1F        
0059D7  2  20 9D 3D             JSR     displaynum
0059DA  2  A2 06                LDX     #SHOP_X0+3
0059DC  2  A0 0D                LDY     #SHOP_Y0+9
0059DE  2  20 DB 3B             JSR     locate
0059E1  2  A9 5F A0 5B          PRINTMSG t_armor_hint
0059E5  2  20 ED 3B     
