000C2C  1  54 48 4F 55  
000C30  1  20 48 41 53  
000C41  1               go_hp:
000C41  1  54 68 79 20          .BYTE   "Thy wounds were too grave.",0
000C45  1  77 6F 75 6E  
000C49  1  64 73 20 77  
000C5C  1               go_food:
000C5C  1  54 68 6F 75          .BYTE   "Thou hast starved in the wilds.",0
000C60  1  20 68 61 73  
000C64  1  74 20 73 74  
000C7C  1               anykey:
