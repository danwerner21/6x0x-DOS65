003066  2               
003066  1                       .INCLUDE "video.asm"
003066  2               ;______________________________________________________________________________
003066  2               ;  video.asm - memory-mapped video: paging, framing, viewport, UI text
003066  2               ;
003066  2               ;  Direct VRAM access (the fast path used by SpeedScript): map video
003066  2               ;  sub-page $F9 into CPU bank $A.  Then:
003066  2               ;     text  char at  $A000 + row*80 + col
003066  2               ;     color cell at  $A800 + row*80 + col
003066  2               ;  Color byte = (bg<<4)|fg.
003066  2               ;
003066  2               ;  All direct-write routines must be bracketed by vid_enter / vid_exit.
003066  2               ;  UI text via the firmware (prmsg / putxy) does NOT page; it uses
003066  2               ;  FARCALL chrout/locate and must be used while in task 0.
003066  2               ;______________________________________________________________________________
003066  2               
003066  2               ;----------------------------------------------------------------
003066  2               ; vid_enter - map video text/color page into $A000-$AFFF (task 1)
003066  2               ;             trashes A,X ; preserves Y
003066  2               ;----------------------------------------------------------------
003066  2               vid_enter:
003066  2  A9 01                LDA     #$01            ; configure task 01
003068  2  A2 0A                LDX     #$0A            ; CPU bank $A ($A000-$AFFF)
00306A  2  A0 F9                LDY     #VIDTEXT_PAGE   ; physical video page $F9
00306C  2  20 F6 FF             JSR     SETPAGE
00306F  2  A9 01                LDA     #$01
003071  2  8D E0 EF             STA     PC6502_ACT_TASK ; activate task 01
003074  2  60                   RTS
003075  2               
003075  2               ;----------------------------------------------------------------
003075  2               ; vid_exit - restore normal memory at $A000 (task 0)
003075  2               ;----------------------------------------------------------------
003075  2               vid_exit:
003075  2  A9 00                LDA     #$00
003077  2  8D E0 EF             STA     PC6502_ACT_TASK
00307A  2  60                   RTS
00307B  2               
00307B  2               ;----------------------------------------------------------------
00307B  2               ; rowbase - compute VRAM pointers for the start of a screen row.
00307B  2               ;   IN : A = row (0..23)
00307B  2               ;   OUT: vptr -> $A000 + row*80   (text)
00307B  2               ;        cptr -> $A800 + row*80   (color)
00307B  2               ;   row*80 = row*64 + row*16 = (row<<6)+(row<<4)
00307B  2               ;----------------------------------------------------------------
00307B  2               rowbase:
00307B  2  85 20                STA     tmp0            ; row
00307D  2               ; row*16 -> ptr2
00307D  2  A9 00                LDA     #0
00307F  2  85 13                STA     ptr2+1
003081  2  A5 20                LDA     tmp0
003083  2  0A                   ASL     A               ; *2
003084  2  0A                   ASL     A               ; *4
003085  2  0A                   ASL     A               ; *8
003086  2  0A                   ASL     A               ; *16 (row<=23 so <=368, may set carry)
003087  2  85 12                STA     ptr2
003089  2  A9 00                LDA     #0
00308B  2  2A                   ROL     A
00308C  2  85 13                STA     ptr2+1          ; high bits of row*16
00308E  2               ; row*64 -> ptr
00308E  2  A5 20                LDA     tmp0
003090  2  85 10                STA     ptr
003092  2  A9 00                LDA     #0
003094  2  85 11                STA     ptr+1
003096  2  06 10                ASL     ptr
003098  2  26 11                ROL     ptr+1           ; *2
00309A  2  06 10                ASL     ptr
00309C  2  26 11                ROL     ptr+1           ; *4
00309E  2  06 10                ASL     ptr
0030A0  2  26 11                ROL     ptr+1           ; *8
0030A2  2  06 10                ASL     ptr
0030A4  2  26 11                ROL     ptr+1           ; *16
0030A6  2  06 10                ASL     ptr
0030A8  2  26 11                ROL     ptr+1           ; *32
0030AA  2  06 10                ASL     ptr
0030AC  2  26 11                ROL     ptr+1           ; *64
0030AE  2               ; ptr = ptr + ptr2 = row*80
0030AE  2  18                   CLC
0030AF  2  A5 10                LDA     ptr
0030B1  2  65 12                ADC     ptr2
0030B3  2  85 10                STA     ptr
0030B5  2  A5 11                LDA     ptr+1
0030B7  2  65 13                ADC     ptr2+1
0030B9  2  85 11                STA     ptr+1
0030BB  2               ; vptr = $A000 + ptr
0030BB  2  18                   CLC
0030BC  2  A5 10                LDA     ptr
0030BE  2  85 14                STA     vptr
0030C0  2  A5 11                LDA     ptr+1
0030C2  2  69 A0                ADC     #>VRAM_TEXT
0030C4  2  85 15                STA     vptr+1
0030C6  2               ; cptr = $A800 + ptr
0030C6  2  18                   CLC
0030C7  2  A5 10                LDA     ptr
0030C9  2  85 16                STA     cptr
0030CB  2  A5 11                LDA     ptr+1
0030CD  2  69 A8                ADC     #>VRAM_COLOR
0030CF  2  85 17                STA     cptr+1
0030D1  2  60                   RTS
0030D2  2               
0030D2  2               ;----------------------------------------------------------------
0030D2  2               ; putcell - write one char+color cell directly to VRAM.
0030D2  2               ;   MUST be called between vid_enter / vid_exit.
0030D2  2               ;   IN : tmp1 = row, tmp2 = col, tmp3 = char, colidx = color
0030D2  2               ;   trashes A,Y
0030D2  2               ;----------------------------------------------------------------
0030D2  2               putcell:
0030D2  2  A5 21                LDA     tmp1
0030D4  2  20 7B 30             JSR     rowbase
0030D7  2  A4 22                LDY     tmp2
0030D9  2  A5 23                LDA     tmp3
0030DB  2  91 14                STA     (vptr),Y
0030DD  2  A5 26                LDA     colidx
0030DF  2  91 16                STA     (cptr),Y
0030E1  2  60                   RTS
0030E2  2               
0030E2  2               ;----------------------------------------------------------------
0030E2  2               ; cls_vram - fill the whole screen with spaces in C_BLANK.
0030E2  2               ;----------------------------------------------------------------
0030E2  2               cls_vram:
0030E2  2  20 66 30             JSR     vid_enter
0030E5  2  A9 00                LDA     #0
0030E7  2  85 27                STA     rowidx
0030E9  2               @row:
0030E9  2  A5 27                LDA     rowidx
0030EB  2  20 7B 30             JSR     rowbase
0030EE  2  A0 00                LDY     #0
0030F0  2               @col:
0030F0  2  A9 20                LDA     #space
0030F2  2  91 14                STA     (vptr),Y
0030F4  2  A9 07                LDA     #C_BLANK
0030F6  2  91 16                STA     (cptr),Y
0030F8  2  C8                   INY
0030F9  2  C0 50                CPY     #SCRW
0030FB  2  D0 F3                BNE     @col
0030FD  2  E6 27                INC     rowidx
0030FF  2  A5 27                LDA     rowidx
003101  2  C9 18                CMP     #SCRH
003103  2  D0 E4                BNE     @row
003105  2  4C 75 30             JMP     vid_exit
003108  2               
003108  2               ;----------------------------------------------------------------
003108  2               ; fillrow_vram - fill one row [colA..colB) with char/color.
003108  2               ;   IN: tmp1=row, tmp2=start col, tmp3=char, colidx=color, cnt0=count
003108  2               ;   MUST be inside vid_enter/vid_exit.
003108  2               ;----------------------------------------------------------------
003108  2               fillrow_vram:
003108  2  A5 21                LDA     tmp1
00310A  2  20 7B 30             JSR     rowbase
00310D  2  A4 22                LDY     tmp2
00310F  2  A6 24                LDX     cnt0
003111  2               @fl:
003111  2  A5 23                LDA     tmp3
003113  2  91 14                STA     (vptr),Y
003115  2  A5 26                LDA     colidx
003117  2  91 16                STA     (cptr),Y
003119  2  C8                   INY
00311A  2  CA                   DEX
00311B  2  D0 F4                BNE     @fl
00311D  2  60                   RTS
00311E  2               
00311E  2               ;----------------------------------------------------------------
00311E  2               ; draw_frame - draw the static game UI: title bar, viewport frame,
00311E  2               ;              stat panel frame, and message area divider.
00311E  2               ;              Done once at game start (and after returning from
00311E  2               ;              full-screen menus).
00311E  2               ;----------------------------------------------------------------
00311E  2               draw_frame:
00311E  2  20 E2 30             JSR     cls_vram
003121  2  20 66 30             JSR     vid_enter
003124  2               
003124  2               ; --- top title bar (row 0) ---
003124  2  A9 00                LDA     #0
003126  2  85 21                STA     tmp1
003128  2  A9 00                LDA     #0
00312A  2  85 22                STA     tmp2
00312C  2  A9 20                LDA     #space
00312E  2  85 23                STA     tmp3
003130  2  A9 0B                LDA     #C_TITLE
003132  2  85 26                STA     colidx
003134  2  A9 50                LDA     #SCRW
003136  2  85 24                STA     cnt0
003138  2  20 08 31             JSR     fillrow_vram
00313B  2               ; centered title text written below via vid_exit path
00313B  2               
00313B  2               ; --- viewport top/bottom horizontal borders ---
00313B  2               ; top border at row 0 already part of title; we frame the
00313B  2               ; viewport with vertical bars and a bottom rule at VPY0+VPH.
00313B  2               ; vertical left/right bars for viewport rows
00313B  2  A2 01                LDX     #VPY0
00313D  2               @vbar:
00313D  2  8A                   TXA
00313E  2  85 21                STA     tmp1
003140  2  20 7B 30             JSR     rowbase
003143  2  A0 00                LDY     #0              ; left edge col 0
003145  2  A9 7C                LDA     #'|'
003147  2  91 14                STA     (vptr),Y
003149  2  A9 0E                LDA     #C_BORDER
00314B  2  91 16                STA     (cptr),Y
00314D  2  A0 2D                LDY     #(VPW+1)        ; right edge of viewport
00314F  2  A9 7C                LDA     #'|'
003151  2  91 14                STA     (vptr),Y
003153  2  A9 0E                LDA     #C_BORDER
003155  2  91 16                STA     (cptr),Y
003157  2  E8                   INX
003158  2  E0 15                CPX     #(VPY0+VPH)
00315A  2  D0 E1                BNE     @vbar
00315C  2               
00315C  2               ; viewport bottom rule + message divider share row VPY0+VPH
00315C  2               ; (= MSGY0-1).  Draw it full-width.
00315C  2  A9 15                LDA     #(VPY0+VPH)
00315E  2  85 21                STA     tmp1
003160  2  A9 00                LDA     #0
003162  2  85 22                STA     tmp2
003164  2  A9 3D                LDA     #'='
003166  2  85 23                STA     tmp3
003168  2  A9 0E                LDA     #C_BORDER
00316A  2  85 26                STA     colidx
00316C  2  A9 50                LDA     #SCRW
00316E  2  85 24                STA     cnt0
003170  2  20 08 31             JSR     fillrow_vram
003173  2               
003173  2               ; panel header row (row 1) background highlight
003173  2  A9 01                LDA     #1
003175  2  85 21                STA     tmp1
003177  2  A9 2E                LDA     #(VPW+2)
003179  2  85 22                STA     tmp2
00317B  2  A9 20                LDA     #space
00317D  2  85 23                STA     tmp3
00317F  2  A9 4B                LDA     #C_PANELHDR
003181  2  85 26                STA     colidx
003183  2  A9 22                LDA     #(SCRW-(VPW+2))
003185  2  85 24                STA     cnt0
003187  2  20 08 31             JSR     fillrow_vram
00318A  2               
00318A  2  20 75 30             JSR     vid_exit
00318D  2               
00318D  2               ; write the title bar + panel header text via firmware
00318D  2  A2 1E                LDX     #30
00318F  2  A0 00                LDY     #0
003191  2  20 B4 31             JSR     locate
003194  2  A9 0B                LDA     #C_TITLE
003196  2  8D 4A 06             STA     CURCOLOR
003199  2  A9 36 A0 33          PRINTMSG titlebar
00319D  2  20 C6 31     
0031A0  2               
0031A0  2  A2 30                LDX     #(VPW+4)
0031A2  2  A0 01                LDY     #1
0031A4  2  20 B4 31             JSR     locate
0031A7  2  A9 4B                LDA     #C_PANELHDR
0031A9  2  8D 4A 06             STA     CURCOLOR
0031AC  2  A9 4A A0 33          PRINTMSG panelhdr
0031B0  2  20 C6 31     
0031B3  2  60                   RTS
0031B4  2               
0031B4  2               ;----------------------------------------------------------------
0031B4  2               ; locate - position the firmware text cursor.  X=col, Y=row.
0031B4  2               ;----------------------------------------------------------------
0031B4  2               locate:
0031B4  2  A9 25 85 32          FARCALL FC_LOCATE
0031B8  2  20 F0 FF     
0031BB  2  60                   RTS
0031BC  2               
0031BC  2               ;----------------------------------------------------------------
0031BC  2               ; putc - output one char via firmware (A=char), honoring CURCOLOR.
0031BC  2               ;        (Cannot use the FARCALL macro - it would clobber the char
0031BC  2               ;         in A.  Set farfunct, then restore A before the call.)
0031BC  2               ;----------------------------------------------------------------
0031BC  2               putc:
0031BC  2  48                   PHA
0031BD  2  A9 13                LDA     #FC_CHROUT
0031BF  2  85 32                STA     farfunct
0031C1  2  68                   PLA
0031C2  2  20 F0 FF             JSR     DO_FARCALL
0031C5  2  60                   RTS
0031C6  2               
0031C6  2               ;----------------------------------------------------------------
0031C6  2               ; prmsg - print a 0-terminated string via firmware chrout.
0031C6  2               ;   IN: A=lo, Y=hi of string address.  Uses CURCOLOR for color.
0031C6  2               ;----------------------------------------------------------------
0031C6  2               prmsg:
0031C6  2  85 1C                STA     strp
0031C8  2  84 1D                STY     strp+1
0031CA  2  A0 00                LDY     #0
0031CC  2               @pl:
0031CC  2  B1 1C                LDA     (strp),Y
0031CE  2  F0 08                BEQ     @done
0031D0  2  5A                   PHY
0031D1  2  20 BC 31             JSR     putc
0031D4  2  7A                   PLY
0031D5  2  C8                   INY
0031D6  2  D0 F4                BNE     @pl
0031D8  2               @done:
0031D8  2  60                   RTS
0031D9  2               
0031D9  2               ;----------------------------------------------------------------
0031D9  2               ; putxy - position cursor (X=col,Y=row), set color (A=color),
0031D9  2               ;         then print string at strp.  Helper for panel fields.
0031D9  2               ;   IN: tmp2=col, tmp1=row, colidx=color, strp=string ptr
0031D9  2               ;----------------------------------------------------------------
0031D9  2               putxy:
0031D9  2  A6 22                LDX     tmp2
0031DB  2  A4 21                LDY     tmp1
0031DD  2  20 B4 31             JSR     locate
0031E0  2  A5 26                LDA     colidx
0031E2  2  8D 4A 06             STA     CURCOLOR
0031E5  2  A5 1C                LDA     strp
0031E7  2  A4 1D                LDY     strp+1
0031E9  2  20 C6 31             JSR     prmsg
0031EC  2  60                   RTS
0031ED  2               
0031ED  2               ;----------------------------------------------------------------
0031ED  2               ; clear_panel_value - blank a panel field area before redraw.
0031ED  2               ;   IN: X=col, Y=row, A=width
0031ED  2               ;----------------------------------------------------------------
0031ED  2               clear_panel_value:
0031ED  2  85 25                STA     cnt1            ; width
0031EF  2  20 B4 31             JSR     locate
0031F2  2  A9 0F                LDA     #C_PANEL
0031F4  2  8D 4A 06             STA     CURCOLOR
0031F7  2               @cpv:
0031F7  2  A9 20                LDA     #space
0031F9  2  20 BC 31             JSR     putc
0031FC  2  C6 25                DEC     cnt1
0031FE  2  D0 F7                BNE     @cpv
003200  2  60                   RTS
003201  2               
003201  2               ;----------------------------------------------------------------
003201  2               ; render_view - draw the scrolling map viewport centered on the
003201  2               ; player. Each world tile is a 2x2 character-cell metatile.
003201  2               ;
003201  2               ;   uses: px,py (player world coords), loc (active map)
003201  2               ;   The top-left WORLD cell shown is (px-VPCX, py-VPCY).
003201  2               ;----------------------------------------------------------------
003201  2               render_view:
003201  2  20 66 30             JSR     vid_enter
003204  2               ; world-tile row = 0..VPTH-1
003204  2  A9 00                LDA     #0
003206  2  85 27                STA     rowidx
003208  2               @vrow:
003208  2               ; world y for this row = py - VPCY + rowidx
003208  2  38                   SEC
003209  2  AD 46 41             LDA     py
00320C  2  E9 05                SBC     #VPCY
00320E  2  18                   CLC
00320F  2  65 27                ADC     rowidx
003211  2  85 2D                STA     tgty
003213  2               ; world-tile column loop
003213  2  A9 00                LDA     #0
003215  2  85 26                STA     colidx
003217  2               @vcol:
003217  2               ; world x = px - VPCX + colidx
003217  2  38                   SEC
003218  2  AD 45 41             LDA     px
00321B  2  E9 0B                SBC     #VPCX
00321D  2  18                   CLC
00321E  2  65 26                ADC     colidx
003220  2  85 2C                STA     tgtx
003222  2               ; fetch tile (returns tgttile)
003222  2  20 5B 19             JSR     tileat
003225  2               ; metatile base glyph = MG_TERRAIN_BASE + tile_code*4
003225  2  A5 2E                LDA     tgttile
003227  2  0A                   ASL     A
003228  2  0A                   ASL     A
003229  2  18                   CLC
00322A  2  69 80                ADC     #MG_TERRAIN_BASE
00322C  2  85 24                STA     cnt0
00322E  2  A6 2E                LDX     tgttile
003230  2  BD 31 18             LDA     tile_color,X
003233  2  85 25                STA     cnt1
003235  2               ; pick an alternate art variant for some cells so large regions of
003235  2               ; one terrain don't show an obvious repeating grid. A terrain has a
003235  2               ; variant iff tile_variant[code] != 0; we use it when the cheap
003235  2               ; position hash (tgtx ^ tgty) bit0 is set.
003235  2  BD 42 18             LDA     tile_variant,X
003238  2  F0 0D                BEQ     @novar          ; this terrain has no variant
00323A  2  A5 2C                LDA     tgtx
00323C  2  45 2D                EOR     tgty
00323E  2  29 01                AND     #$01
003240  2  F0 05                BEQ     @novar          ; hash says keep the base art
003242  2  BD 42 18             LDA     tile_variant,X  ; swap in the variant metatile base
003245  2  85 24                STA     cnt0
003247  2               @novar:
003247  2               ; screen column = VPX0 + colidx*2
003247  2  A5 26                LDA     colidx
003249  2  0A                   ASL     A
00324A  2  18                   CLC
00324B  2  69 01                ADC     #VPX0
00324D  2  85 22                STA     tmp2
00324F  2               ; screen row = VPY0 + rowidx*2
00324F  2  A5 27                LDA     rowidx
003251  2  0A                   ASL     A
003252  2  18                   CLC
003253  2  69 01                ADC     #VPY0
003255  2  85 23                STA     tmp3
003257  2  20 83 32             JSR     blit_metatile_vram
00325A  2               ; next column
00325A  2  E6 26                INC     colidx
00325C  2  A5 26                LDA     colidx
00325E  2  C9 16                CMP     #VPTW
003260  2  D0 B5                BNE     @vcol
003262  2               ; next row
003262  2  E6 27                INC     rowidx
003264  2  A5 27                LDA     rowidx
003266  2  C9 0A                CMP     #VPTH
003268  2  D0 9E                BNE     @vrow
00326A  2               
00326A  2               ; --- overlay monsters that fall within the viewport ---
00326A  2  20 70 37             JSR     draw_monsters_vram
00326D  2               
00326D  2               ; --- overlay the player at the fixed center metatile ---
00326D  2  A9 C4                LDA     #MG_PLAYER
00326F  2  85 24                STA     cnt0
003271  2  A9 0F                LDA     #C_PLAYER
003273  2  85 25                STA     cnt1
003275  2  A9 17                LDA     #(VPX0+(VPCX*2))
003277  2  85 22                STA     tmp2
003279  2  A9 0B                LDA     #(VPY0+(VPCY*2))
00327B  2  85 23                STA     tmp3
00327D  2  20 C0 32             JSR     blit_entity_vram
003280  2               
003280  2  4C 75 30             JMP     vid_exit
003283  2               
003283  2               ;----------------------------------------------------------------
003283  2               ; blit_metatile_vram - draw a 2x2 terrain metatile with one color.
003283  2               ;   IN: cnt0=base glyph, cnt1=color, tmp2=screen col, tmp3=screen row
003283  2               ;   MUST be called inside vid_enter/vid_exit.
003283  2               ;----------------------------------------------------------------
003283  2               blit_metatile_vram:
003283  2  A5 23                LDA     tmp3
003285  2  20 7B 30             JSR     rowbase
003288  2  A4 22                LDY     tmp2
00328A  2  A5 24                LDA     cnt0
00328C  2  91 14                STA     (vptr),Y
00328E  2  A5 25                LDA     cnt1
003290  2  91 16                STA     (cptr),Y
003292  2  C8                   INY
003293  2  A5 24                LDA     cnt0
003295  2  18                   CLC
003296  2  69 01                ADC     #1
003298  2  91 14                STA     (vptr),Y
00329A  2  A5 25                LDA     cnt1
00329C  2  91 16                STA     (cptr),Y
00329E  2               
00329E  2  A5 23                LDA     tmp3
0032A0  2  18                   CLC
0032A1  2  69 01                ADC     #1
0032A3  2  20 7B 30             JSR     rowbase
0032A6  2  A4 22                LDY     tmp2
0032A8  2  A5 24                LDA     cnt0
0032AA  2  18                   CLC
0032AB  2  69 02                ADC     #2
0032AD  2  91 14                STA     (vptr),Y
0032AF  2  A5 25                LDA     cnt1
0032B1  2  91 16                STA     (cptr),Y
0032B3  2  C8                   INY
0032B4  2  A5 24                LDA     cnt0
0032B6  2  18                   CLC
0032B7  2  69 03                ADC     #3
0032B9  2  91 14                STA     (vptr),Y
0032BB  2  A5 25                LDA     cnt1
0032BD  2  91 16                STA     (cptr),Y
0032BF  2  60                   RTS
0032C0  2               
0032C0  2               ;----------------------------------------------------------------
0032C0  2               ; blit_entity_vram - overlay a 2x2 entity metatile while preserving
0032C0  2               ; each terrain cell's background color.
0032C0  2               ;   IN: cnt0=base glyph, cnt1=entity color, tmp2=screen col,
0032C0  2               ;       tmp3=screen row
0032C0  2               ;   MUST be called inside vid_enter/vid_exit.
0032C0  2               ;----------------------------------------------------------------
0032C0  2               blit_entity_vram:
0032C0  2  A5 23                LDA     tmp3
0032C2  2  20 7B 30             JSR     rowbase
0032C5  2  A4 22                LDY     tmp2
0032C7  2  A5 24                LDA     cnt0
0032C9  2  91 14                STA     (vptr),Y
0032CB  2  20 F9 32             JSR     entity_color_at_y
0032CE  2  C8                   INY
0032CF  2  A5 24                LDA     cnt0
0032D1  2  18                   CLC
0032D2  2  69 01                ADC     #1
0032D4  2  91 14                STA     (vptr),Y
0032D6  2  20 F9 32             JSR     entity_color_at_y
0032D9  2               
0032D9  2  A5 23                LDA     tmp3
0032DB  2  18                   CLC
0032DC  2  69 01                ADC     #1
0032DE  2  20 7B 30             JSR     rowbase
0032E1  2  A4 22                LDY     tmp2
0032E3  2  A5 24                LDA     cnt0
0032E5  2  18                   CLC
0032E6  2  69 02                ADC     #2
0032E8  2  91 14                STA     (vptr),Y
0032EA  2  20 F9 32             JSR     entity_color_at_y
0032ED  2  C8                   INY
0032EE  2  A5 24                LDA     cnt0
0032F0  2  18                   CLC
0032F1  2  69 03                ADC     #3
0032F3  2  91 14                STA     (vptr),Y
0032F5  2  20 F9 32             JSR     entity_color_at_y
0032F8  2  60                   RTS
0032F9  2               
0032F9  2               ; preserve background nibble at the current cptr,Y; apply cnt1 foreground
0032F9  2               entity_color_at_y:
0032F9  2  B1 16                LDA     (cptr),Y
0032FB  2  29 F0                AND     #$F0
0032FD  2  85 20                STA     tmp0
0032FF  2  A5 25                LDA     cnt1
003301  2  29 0F                AND     #$0F
003303  2  05 20                ORA     tmp0
003305  2  91 16                STA     (cptr),Y
003307  2  60                   RTS
003308  2               
003308  2               ;----------------------------------------------------------------
003308  2               ; plot_view_cell - overlay an entity metatile at WORLD coords
003308  2               ; (tgtx,tgty) if it is visible.
003308  2               ;   IN: tgtx,tgty=world coords, cnt0=base glyph, cnt1=color
003308  2               ;   MUST be called inside vid_enter/vid_exit.
003308  2               ;----------------------------------------------------------------
003308  2               plot_view_cell:
003308  2               ; viewport tile column = tgtx - px + VPCX
003308  2  38                   SEC
003309  2  A5 2C                LDA     tgtx
00330B  2  ED 45 41             SBC     px
00330E  2  18                   CLC
00330F  2  69 0B                ADC     #VPCX
003311  2               ; must be 0..VPTW-1
003311  2  30 22                BMI     @no             ; (signed underflow check via N flag)
003313  2  C9 16                CMP     #VPTW
003315  2  B0 1E                BCS     @no
003317  2  0A                   ASL     A
003318  2  18                   CLC
003319  2  69 01                ADC     #VPX0
00331B  2  85 22                STA     tmp2            ; screen column
00331D  2               ; viewport tile row = tgty - py + VPCY
00331D  2  38                   SEC
00331E  2  A5 2D                LDA     tgty
003320  2  ED 46 41             SBC     py
003323  2  18                   CLC
003324  2  69 05                ADC     #VPCY
003326  2  30 0D                BMI     @no
003328  2  C9 0A                CMP     #VPTH
00332A  2  B0 09                BCS     @no
00332C  2  0A                   ASL     A
00332D  2  18                   CLC
00332E  2  69 01                ADC     #VPY0
003330  2  85 23                STA     tmp3            ; screen row
003332  2  4C C0 32             JMP     blit_entity_vram
003335  2               @no:
003335  2  60                   RTS
003336  2               
003336  2               ;----------------------------------------------------------------
003336  2               ; Static UI strings
003336  2               ;----------------------------------------------------------------
003336  2               titlebar:
003336  2  3D 20 57 20          .BYTE   "= W Y R M H O L D =",0
00333A  2  59 20 52 20  
00333E  2  4D 20 48 20  
00334A  2               panelhdr:
00334A  2  41 44 56 45          .BYTE   "ADVENTURER",0
00334E  2  4E 54 55 52  
003352  2  45 52 00     
003355  2               
003355  1                       .INCLUDE "ui.asm"
003355  2               ;______________________________________________________________________________
003355  2               ;  ui.asm - message log, stat panel, prompts, decimal output
003355  2               ;______________________________________________________________________________
003355  2               
003355  2               ;----------------------------------------------------------------
003355  2               ; displaynum - print the 16-bit value in numarg as decimal using
003355  2               ;              the firmware (honours CURCOLOR).  No leading spaces.
003355  2               ;              (adapted from speedscript displaynum)
003355  2               ;----------------------------------------------------------------
003355  2               displaynum:
003355  2  A0 08                LDY     #8              ; index into nums (5 entries x2 bytes)
003357  2               @find:
003357  2  A5 1F                LDA     numarg+1
003359  2  D9 9F 33             CMP     nums+1,Y
00335C  2  90 09                BCC     @next
00335E  2  D0 0B                BNE     @start
003360  2  A5 1E                LDA     numarg
003362  2  D9 9E 33             CMP     nums,Y
003365  2  B0 04                BCS     @start
003367  2               @next:
003367  2  88                   DEY
003368  2  88                   DEY
003369  2  D0 EC                BNE     @find
00336B  2               @start:
00336B  2  A9 30                LDA     #'0'
00336D  2  85 28                STA     numspace
00336F  2               @dig:
00336F  2  A5 1F                LDA     numarg+1
003371  2  D9 9F 33             CMP     nums+1,Y
003374  2  90 1E                BCC     @out
003376  2  D0 09                BNE     @nocmp
003378  2  A5 1E                LDA     numarg
00337A  2  F9 9E 33             SBC     nums,Y          ; carry set
00337D  2  90 15                BCC     @out
00337F  2  B0 05                BCS     @sub
003381  2               @nocmp:
003381  2  A5 1E                LDA     numarg
003383  2  F9 9E 33             SBC     nums,Y          ; carry set
003386  2               @sub:
003386  2  E6 28                INC     numspace
003388  2  85 1E                STA     numarg
00338A  2  A5 1F                LDA     numarg+1
00338C  2  F9 9F 33             SBC     nums+1,Y
00338F  2  85 1F                STA     numarg+1
003391  2  4C 6F 33             JMP     @dig
003394  2               @out:
003394  2  A5 28                LDA     numspace
003396  2  20 BC 31             JSR     putc
003399  2  88                   DEY
00339A  2  88                   DEY
00339B  2  10 CE                BPL     @start
00339D  2  60                   RTS
00339E  2               
00339E  2               ; place value table (1,10,100,1000,10000) as 16-bit LE words
00339E  2               nums:
00339E  2  01 00                .WORD   1
0033A0  2  0A 00                .WORD   10
0033A2  2  64 00                .WORD   100
0033A4  2  E8 03                .WORD   1000
0033A6  2  10 27                .WORD   10000
0033A8  2               
0033A8  2               ;----------------------------------------------------------------
0033A8  2               ; print a single 8-bit value (in A) as decimal.
0033A8  2               ;----------------------------------------------------------------
0033A8  2               print_byte:
0033A8  2  85 1E                STA     numarg
0033AA  2  A9 00                LDA     #0
0033AC  2  85 1F                STA     numarg+1
0033AE  2  4C 55 33             JMP     displaynum
0033B1  2               
0033B1  2               ;----------------------------------------------------------------
0033B1  2               ; Message log: two lines at rows MSGY0 and MSGY0+1.
0033B1  2               ; msg_print scrolls the bottom line up and prints a new line.
0033B1  2               ;
0033B1  2               ;   msg_print:  IN A=lo,Y=hi of 0-terminated string
0033B1  2               ;----------------------------------------------------------------
0033B1  2               msg_print:
0033B1  2  85 1C                STA     strp
0033B3  2  84 1D                STY     strp+1
0033B5  2               ; copy current bottom line (msgbuf1) up to (msgbuf0)
0033B5  2  A2 00                LDX     #0
0033B7  2               @up:
0033B7  2  BD B9 41             LDA     msgbuf1,X
0033BA  2  9D 69 41             STA     msgbuf0,X
0033BD  2  E8                   INX
0033BE  2  E0 50                CPX     #SCRW
0033C0  2  D0 F5                BNE     @up
0033C2  2               ; copy new string into msgbuf1 (truncate/pad to SCRW)
0033C2  2  A0 00                LDY     #0
0033C4  2               @cp:
0033C4  2  B1 1C                LDA     (strp),Y
0033C6  2  F0 0B                BEQ     @padb
0033C8  2  99 B9 41             STA     msgbuf1,Y
0033CB  2  C8                   INY
0033CC  2  C0 50                CPY     #SCRW
0033CE  2  D0 F4                BNE     @cp
0033D0  2  4C DD 33             JMP     @draw
0033D3  2               @padb:
0033D3  2  A9 20                LDA     #space
0033D5  2               @pad:
0033D5  2  99 B9 41             STA     msgbuf1,Y
0033D8  2  C8                   INY
0033D9  2  C0 50                CPY     #SCRW
0033DB  2  D0 F8                BNE     @pad
0033DD  2               @draw:
0033DD  2  4C E0 33             JMP     msg_redraw
0033E0  2               
0033E0  2               ;----------------------------------------------------------------
0033E0  2               ; msg_redraw - blit both message buffers to the message rows via
0033E0  2               ;              direct VRAM (so it does not disturb the text cursor).
0033E0  2               ;----------------------------------------------------------------
0033E0  2               msg_redraw:
0033E0  2  20 66 30             JSR     vid_enter
0033E3  2               ; row MSGY0 <- msgbuf0
0033E3  2  A9 16                LDA     #MSGY0
0033E5  2  20 7B 30             JSR     rowbase
0033E8  2  A0 00                LDY     #0
0033EA  2               @r0:
0033EA  2  B9 69 41             LDA     msgbuf0,Y
0033ED  2  91 14                STA     (vptr),Y
0033EF  2  A9 0F                LDA     #C_MSG
0033F1  2  91 16                STA     (cptr),Y
0033F3  2  C8                   INY
0033F4  2  C0 50                CPY     #SCRW
0033F6  2  D0 F2                BNE     @r0
0033F8  2               ; row MSGY0+1 <- msgbuf1
0033F8  2  A9 17                LDA     #MSGY0+1
0033FA  2  20 7B 30             JSR     rowbase
0033FD  2  A0 00                LDY     #0
0033FF  2               @r1:
0033FF  2  B9 B9 41             LDA     msgbuf1,Y
003402  2  91 14                STA     (vptr),Y
003404  2  A9 0F                LDA     #C_MSG
003406  2  91 16                STA     (cptr),Y
003408  2  C8                   INY
003409  2  C0 50                CPY     #SCRW
00340B  2  D0 F2                BNE     @r1
00340D  2  4C 75 30             JMP     vid_exit
003410  2               
003410  2               ;----------------------------------------------------------------
003410  2               ; msg_clear - blank both message buffers and redraw.
003410  2               ;----------------------------------------------------------------
003410  2               msg_clear:
003410  2  A2 00                LDX     #0
003412  2  A9 20                LDA     #space
003414  2               @mc:
003414  2  9D 69 41             STA     msgbuf0,X
003417  2  9D B9 41             STA     msgbuf1,X
00341A  2  E8                   INX
00341B  2  E0 50                CPX     #SCRW
00341D  2  D0 F5                BNE     @mc
00341F  2  4C E0 33             JMP     msg_redraw
003422  2               
003422  2               ;----------------------------------------------------------------
003422  2               ; Stat panel.  Drawn on the right side using firmware text output.
003422  2               ; Labels are static; values are redrawn each turn.
003422  2               ;----------------------------------------------------------------
003422  2               draw_panel:
003422  2               ; HP line:  "HP   : nn/nn"
003422  2  A2 30                LDX     #PANX
003424  2  A0 03                LDY     #3
003426  2  20 B4 31             JSR     locate
003429  2  A9 0F                LDA     #C_PANEL
00342B  2  8D 4A 06             STA     CURCOLOR
00342E  2  A9 88 A0 35          PRINTMSG lbl_hp
003432  2  20 C6 31     
003435  2  AD 47 41             LDA     phealth
003438  2  20 A8 33             JSR     print_byte
00343B  2  A9 2F                LDA     #'/'
00343D  2  20 BC 31             JSR     putc
003440  2  AD 48 41             LDA     pmaxhp
003443  2  20 A8 33             JSR     print_byte
003446  2  20 0F 35             JSR     pad_clear       ; clear trailing junk
003449  2               
003449  2               ; Level / XP
003449  2  A2 30                LDX     #PANX
00344B  2  A0 05                LDY     #5
00344D  2  20 B4 31             JSR     locate
003450  2  A9 90 A0 35          PRINTMSG lbl_lvl
003454  2  20 C6 31     
003457  2  AD 49 41             LDA     plevel
00345A  2  20 A8 33             JSR     print_byte
00345D  2  A2 3C                LDX     #PANX+12
00345F  2  A0 05                LDY     #5
003461  2  20 B4 31             JSR     locate
003464  2  A9 96 A0 35          PRINTMSG lbl_xp
003468  2  20 C6 31     
00346B  2  AD 4A 41 85          COPY16  pxp, numarg
00346F  2  1E AD 4B 41  
003473  2  85 1F        
003475  2  20 55 33             JSR     displaynum
003478  2  20 0F 35             JSR     pad_clear
00347B  2               
00347B  2               ; Gold / Food
00347B  2  A2 30                LDX     #PANX
00347D  2  A0 07                LDY     #7
00347F  2  20 B4 31             JSR     locate
003482  2  A9 9B A0 35          PRINTMSG lbl_gold
003486  2  20 C6 31     
003489  2  AD 4C 41 85          COPY16  pgold, numarg
00348D  2  1E AD 4D 41  
003491  2  85 1F        
003493  2  20 55 33             JSR     displaynum
003496  2  A2 3C                LDX     #PANX+12
003498  2  A0 07                LDY     #7
00349A  2  20 B4 31             JSR     locate
00349D  2  A9 A2 A0 35          PRINTMSG lbl_food
0034A1  2  20 C6 31     
0034A4  2  AD 4E 41 85          COPY16  pfood, numarg
0034A8  2  1E AD 4F 41  
0034AC  2  85 1F        
0034AE  2  20 55 33             JSR     displaynum
0034B1  2  20 0F 35             JSR     pad_clear
0034B4  2               
0034B4  2               ; Weapon
0034B4  2  A2 30                LDX     #PANX
0034B6  2  A0 09                LDY     #9
0034B8  2  20 B4 31             JSR     locate
0034BB  2  A9 A9 A0 35          PRINTMSG lbl_wpn
0034BF  2  20 C6 31     
0034C2  2  AD 50 41             LDA     pweapon
0034C5  2  20 1F 35             JSR     name_weapon     ; strp -> name
0034C8  2  A5 1C                LDA     strp
0034CA  2  A4 1D                LDY     strp+1
0034CC  2  20 C6 31             JSR     prmsg
0034CF  2  20 0F 35             JSR     pad_clear
0034D2  2               
0034D2  2               ; Armor
0034D2  2  A2 30                LDX     #PANX
0034D4  2  A0 0A                LDY     #10
0034D6  2  20 B4 31             JSR     locate
0034D9  2  A9 B2 A0 35          PRINTMSG lbl_arm
0034DD  2  20 C6 31     
0034E0  2  AD 51 41             LDA     parmor
0034E3  2  20 2C 35             JSR     name_armor
0034E6  2  A5 1C                LDA     strp
0034E8  2  A4 1D                LDY     strp+1
0034EA  2  20 C6 31             JSR     prmsg
0034ED  2  20 0F 35             JSR     pad_clear
0034F0  2               
0034F0  2               ; Location
0034F0  2  A2 30                LDX     #PANX
0034F2  2  A0 0C                LDY     #12
0034F4  2  20 B4 31             JSR     locate
0034F7  2  A9 BB A0 35          PRINTMSG lbl_loc
0034FB  2  20 C6 31     
0034FE  2  AD 52 41             LDA     loc
003501  2  20 39 35             JSR     name_loc
003504  2  A5 1C                LDA     strp
003506  2  A4 1D                LDY     strp+1
003508  2  20 C6 31             JSR     prmsg
00350B  2  20 0F 35             JSR     pad_clear
00350E  2  60                   RTS
00350F  2               
00350F  2               ; pad_clear - print spaces out to the right screen edge to erase
00350F  2               ;             any leftover characters from a previous longer value.
00350F  2               ;             Stops at the last column to avoid auto-scroll.
00350F  2               pad_clear:
00350F  2               @pc:
00350F  2  AD 47 06             LDA     CURX
003512  2  C9 4F                CMP     #SCRW-1
003514  2  B0 08                BCS     @done
003516  2  A9 20                LDA     #space
003518  2  20 BC 31             JSR     putc
00351B  2  4C 0F 35             JMP     @pc
00351E  2               @done:
00351E  2  60                   RTS
00351F  2               
00351F  2               ;----------------------------------------------------------------
00351F  2               ; name_weapon / name_armor / name_loc - set strp to a name string
00351F  2               ;   IN: A = index
00351F  2               ;----------------------------------------------------------------
00351F  2               name_weapon:
00351F  2  0A                   ASL     A
003520  2  AA                   TAX
003521  2  BD C4 35             LDA     wpn_names,X
003524  2  85 1C                STA     strp
003526  2  BD C5 35             LDA     wpn_names+1,X
003529  2  85 1D                STA     strp+1
00352B  2  60                   RTS
00352C  2               name_armor:
00352C  2  0A                   ASL     A
00352D  2  AA                   TAX
00352E  2  BD E3 35             LDA     arm_names,X
003531  2  85 1C                STA     strp
003533  2  BD E4 35             LDA     arm_names+1,X
003536  2  85 1D                STA     strp+1
003538  2  60                   RTS
003539  2               name_loc:
003539  2  0A                   ASL     A
00353A  2  AA                   TAX
00353B  2  BD 07 36             LDA     loc_names,X
00353E  2  85 1C                STA     strp
003540  2  BD 08 36             LDA     loc_names+1,X
003543  2  85 1D                STA     strp+1
003545  2  60                   RTS
003546  2               
003546  2               ;----------------------------------------------------------------
003546  2               ; yorn - wait for a Y/N keypress.  Returns Z=1 if Yes (A='Y').
003546  2               ;----------------------------------------------------------------
003546  2               yorn:
003546  2               @wait:
003546  2  20 62 35             JSR     getkey_block
003549  2  C9 59                CMP     #'Y'
00354B  2  F0 0F                BEQ     @yes
00354D  2  C9 79                CMP     #'y'
00354F  2  F0 0B                BEQ     @yes
003551  2  C9 4E                CMP     #'N'
003553  2  F0 0A                BEQ     @no
003555  2  C9 6E                CMP     #'n'
003557  2  F0 06                BEQ     @no
003559  2  4C 46 35             JMP     @wait
00355C  2               @yes:
00355C  2  A9 00                LDA     #0              ; Z=1
00355E  2  60                   RTS
00355F  2               @no:
00355F  2  A9 01                LDA     #1              ; Z=0
003561  2  60                   RTS
003562  2               
003562  2               ;----------------------------------------------------------------
003562  2               ; getkey_block - block until a key is pressed; return it in A.
003562  2               ;----------------------------------------------------------------
003562  2               getkey_block:
003562  2               @gk:
003562  2  A9 14 85 32          FARCALL FC_CHRIN
003566  2  20 F0 FF     
003569  2  C9 FF                CMP     #$FF
00356B  2  F0 F5                BEQ     @gk
00356D  2  60                   RTS
00356E  2               
00356E  2               ;----------------------------------------------------------------
00356E  2               ; getkey - non-blocking read; A=key or 0 if none.
00356E  2               ;----------------------------------------------------------------
00356E  2               getkey:
00356E  2  A9 14 85 32          FARCALL FC_CHRIN
003572  2  20 F0 FF     
003575  2  C9 FF                CMP     #$FF
003577  2  D0 02                BNE     @got
003579  2  A9 00                LDA     #0
00357B  2               @got:
00357B  2  60                   RTS
00357C  2               
00357C  2               ;----------------------------------------------------------------
00357C  2               ; drainkeys - consume and discard all buffered keystrokes.
00357C  2               ;----------------------------------------------------------------
00357C  2               drainkeys:
00357C  2               @dk:
00357C  2  A9 14 85 32          FARCALL FC_CHRIN
003580  2  20 F0 FF     
003583  2  C9 FF                CMP     #$FF
003585  2  D0 F5                BNE     @dk             ; got a key - keep draining
003587  2  60                   RTS
003588  2               
003588  2               ;----------------------------------------------------------------
003588  2               ; Panel labels and name tables
003588  2               ;----------------------------------------------------------------
003588  2               lbl_hp:
003588  2  48 50 20 20          .BYTE   "HP   : ",0
00358C  2  20 3A 20 00  
003590  2               lbl_lvl:
003590  2  4C 76 6C 3A          .BYTE   "Lvl: ",0
003594  2  20 00        
003596  2               lbl_xp:
003596  2  58 50 3A 20          .BYTE   "XP: ",0
00359A  2  00           
00359B  2               lbl_gold:
00359B  2  47 6F 6C 64          .BYTE   "Gold: ",0
00359F  2  3A 20 00     
0035A2  2               lbl_food:
0035A2  2  46 6F 6F 64          .BYTE   "Food: ",0
0035A6  2  3A 20 00     
0035A9  2               lbl_wpn:
0035A9  2  57 65 61 70          .BYTE   "Weapon: ",0
0035AD  2  6F 6E 3A 20  
0035B1  2  00           
0035B2  2               lbl_arm:
0035B2  2  41 72 6D 6F          .BYTE   "Armor : ",0
0035B6  2  72 20 3A 20  
0035BA  2  00           
0035BB  2               lbl_loc:
0035BB  2  57 68 65 72          .BYTE   "Where : ",0
0035BF  2  65 20 3A 20  
0035C3  2  00           
0035C4  2               
0035C4  2               wpn_names:
0035C4  2  CC 35 D2 35          .WORD   wn0, wn1, wn2, wn3
0035C8  2  D9 35 DF 35  
0035CC  2               wn0:
0035CC  2  46 69 73 74          .BYTE   "Fists",0
0035D0  2  73 00        
0035D2  2               wn1:
0035D2  2  44 61 67 67          .BYTE   "Dagger",0
0035D6  2  65 72 00     
0035D9  2               wn2:
0035D9  2  53 77 6F 72          .BYTE   "Sword",0
0035DD  2  64 00        
0035DF  2               wn3:
0035DF  2  41 78 65 00          .BYTE   "Axe",0
0035E3  2               
0035E3  2               arm_names:
0035E3  2  EB 35 F3 35          .WORD   an0, an1, an2, an3
0035E7  2  FB 35 01 36  
0035EB  2               an0:
0035EB  2  43 6C 6F 74          .BYTE   "Clothes",0
0035EF  2  68 65 73 00  
0035F3  2               an1:
0035F3  2  4C 65 61 74          .BYTE   "Leather",0
0035F7  2  68 65 72 00  
0035FB  2               an2:
0035FB  2  43 68 61 69          .BYTE   "Chain",0
0035FF  2  6E 00        
003601  2               an3:
003601  2  50 6C 61 74          .BYTE   "Plate",0
003605  2  65 00        
003607  2               
003607  2               loc_names:
003607  2  0D 36 16 36          .WORD   ln0, ln1, ln2
00360B  2  1B 36        
00360D  2               ln0:
00360D  2  57 79 72 6D          .BYTE   "Wyrmhold",0
003611  2  68 6F 6C 64  
003615  2  00           
003616  2               ln1:
003616  2  54 6F 77 6E          .BYTE   "Town",0
00361A  2  00           
00361B  2               ln2:
00361B  2  44 75 6E 67          .BYTE   "Dungeon",0
00361F  2  65 6F 6E 00  
003623  2               
003623  1                       .INCLUDE "entity.asm"
003623  2               ;______________________________________________________________________________
003623  2               ;  entity.asm - monsters: table, spawning, simple AI, rendering
003623  2               ;
003623  2               ;  Parallel arrays of MAXMON slots.  A slot with mon_type == M_NONE
003623  2               ;  is empty.  Monsters live on the currently active map (overworld
003623  2               ;  or dungeon).  Towns have no monsters.
003623  2               ;______________________________________________________________________________
003623  2               
003623  2               ;----------------------------------------------------------------
003623  2               ; Per-monster-type stat tables (indexed by M_* id)
003623  2               ;   mtype_glyph : 2x2 metatile base glyph
003623  2               ;   mtype_color : color cell
003623  2               ;   mtype_hp    : starting HP
003623  2               ;   mtype_atk   : attack dice sides (damage 1..atk)
003623  2               ;   mtype_xp    : XP awarded on kill
003623  2               ;   mtype_gold  : gold dropped (max; rolled 0..gold)
003623  2               ;----------------------------------------------------------------
003623  2               mtype_glyph:
003623  2  20                   .BYTE   ' '             ; 0 none
003624  2  C8                   .BYTE   MG_ORC          ; 1 orc
003625  2  CC                   .BYTE   MG_SNAKE        ; 2 snake
003626  2  D0                   .BYTE   MG_SKELETON     ; 3 skeleton
003627  2  D4                   .BYTE   MG_THIEF        ; 4 thief
003628  2  D8                   .BYTE   MG_TROLL        ; 5 troll
003629  2  DC                   .BYTE   MG_BOSS         ; 6 boss (dragon)
00362A  2               mtype_color:
00362A  2  09                   .BYTE   C_MONST         ; 0
00362B  2  09                   .BYTE   COLOR(CO_BRRED, CO_BLACK); orc
00362C  2  0B                   .BYTE   COLOR(CO_BRYELLOW,CO_BLACK); snake
00362D  2  0F                   .BYTE   COLOR(CO_BRWHITE,CO_BLACK); skeleton
00362E  2  0D                   .BYTE   COLOR(CO_BRMAGENTA,CO_BLACK); thief
00362F  2  0E                   .BYTE   COLOR(CO_BRCYAN,CO_BLACK); troll
003630  2  19                   .BYTE   C_BOSS          ; boss
003631  2               mtype_hp:
003631  2  00 06 04 08          .BYTE   0, 6, 4, 8, 5, 14, 40
003635  2  05 0E 28     
003638  2               mtype_atk:
003638  2  00 04 03 05          .BYTE   0, 4, 3, 5, 3, 7, 12
00363C  2  03 07 0C     
00363F  2               mtype_xp:
00363F  2  00 03 02 05          .BYTE   0, 3, 2, 5, 4, 10, 50
003643  2  04 0A 32     
003646  2               mtype_gold:
003646  2  00 04 01 03          .BYTE   0, 4, 1, 3, 12, 8, 40
00364A  2  0C 08 28     
00364D  2               
00364D  2               ;----------------------------------------------------------------
00364D  2               ; mon_clear_all - empty every monster slot.
00364D  2               ;----------------------------------------------------------------
00364D  2               mon_clear_all:
00364D  2  A2 00                LDX     #0
00364F  2  A9 00                LDA     #M_NONE
003651  2               @c:
003651  2  9D 6A 42             STA     mon_type,X
003654  2  E8                   INX
003655  2  E0 0C                CPX     #MAXMON
003657  2  D0 F8                BNE     @c
003659  2  60                   RTS
00365A  2               
00365A  2               ;----------------------------------------------------------------
00365A  2               ; mon_find_free - find an empty slot.  Returns X = slot, C=1 ok,
00365A  2               ;                 C=0 if table full.
00365A  2               ;----------------------------------------------------------------
00365A  2               mon_find_free:
00365A  2  A2 00                LDX     #0
00365C  2               @f:
00365C  2  BD 6A 42             LDA     mon_type,X
00365F  2  C9 00                CMP     #M_NONE
003661  2  F0 07                BEQ     @found
003663  2  E8                   INX
003664  2  E0 0C                CPX     #MAXMON
003666  2  D0 F4                BNE     @f
003668  2  18                   CLC
003669  2  60                   RTS
00366A  2               @found:
00366A  2  38                   SEC
00366B  2  60                   RTS
00366C  2               
00366C  2               ;----------------------------------------------------------------
00366C  2               ; mon_spawn - create a monster.
00366C  2               ;   IN: A=type, tgtx=x, tgty=y
00366C  2               ;   Sets hp from the type table.  No-op if table full.
00366C  2               ;----------------------------------------------------------------
00366C  2               mon_spawn:
00366C  2  85 20                STA     tmp0            ; type
00366E  2  20 5A 36             JSR     mon_find_free
003671  2  90 17                BCC     @full
003673  2  A5 20                LDA     tmp0
003675  2  9D 6A 42             STA     mon_type,X
003678  2  A5 2C                LDA     tgtx
00367A  2  9D 76 42             STA     mon_x,X
00367D  2  A5 2D                LDA     tgty
00367F  2  9D 82 42             STA     mon_y,X
003682  2  A4 20                LDY     tmp0
003684  2  B9 31 36             LDA     mtype_hp,Y
003687  2  9D 8E 42             STA     mon_hp,X
00368A  2               @full:
00368A  2  60                   RTS
00368B  2               
00368B  2               ;----------------------------------------------------------------
00368B  2               ; mon_at - is there a live monster at (tgtx,tgty)?
00368B  2               ;          Returns X = slot and C=1 if found, else C=0.
00368B  2               ;----------------------------------------------------------------
00368B  2               mon_at:
00368B  2  A2 00                LDX     #0
00368D  2               @a:
00368D  2  BD 6A 42             LDA     mon_type,X
003690  2  C9 00                CMP     #M_NONE
003692  2  F0 10                BEQ     @nextslot
003694  2  BD 76 42             LDA     mon_x,X
003697  2  C5 2C                CMP     tgtx
003699  2  D0 09                BNE     @nextslot
00369B  2  BD 82 42             LDA     mon_y,X
00369E  2  C5 2D                CMP     tgty
0036A0  2  D0 02                BNE     @nextslot
0036A2  2  38                   SEC
0036A3  2  60                   RTS
0036A4  2               @nextslot:
0036A4  2  E8                   INX
0036A5  2  E0 0C                CPX     #MAXMON
0036A7  2  D0 E4                BNE     @a
0036A9  2  18                   CLC
0036AA  2  60                   RTS
0036AB  2               
0036AB  2               ;----------------------------------------------------------------
0036AB  2               ; mon_kill - remove monster in slot X.
0036AB  2               ;----------------------------------------------------------------
0036AB  2               mon_kill:
0036AB  2  A9 00                LDA     #M_NONE
0036AD  2  9D 6A 42             STA     mon_type,X
0036B0  2  60                   RTS
0036B1  2               
0036B1  2               ;----------------------------------------------------------------
0036B1  2               ; spawn_overworld_monsters - scatter a handful of monsters on the
0036B1  2               ; overworld at random passable land tiles near the centre.
0036B1  2               ;----------------------------------------------------------------
0036B1  2               spawn_overworld_monsters:
0036B1  2  20 4D 36             JSR     mon_clear_all
0036B4  2  A9 04                LDA     #4              ; only a few roaming monsters at a time
0036B6  2  85 24                STA     cnt0
0036B8  2               @loop:
0036B8  2               ; place in a ring roughly 6..21 tiles from the player: far
0036B8  2               ; enough not to crowd you, near enough to be encountered.
0036B8  2               ; offset = (rand(0..15) + 6), sign random per axis.
0036B8  2  A9 10                LDA     #16
0036BA  2  20 04 0C             JSR     rng_mod
0036BD  2  18                   CLC
0036BE  2  69 06                ADC     #6              ; 6..21
0036C0  2  85 21                STA     tmp1            ; magnitude
0036C2  2  20 E4 0B             JSR     rng_next        ; random sign bit
0036C5  2  29 01                AND     #1
0036C7  2  F0 09                BEQ     @xplus
0036C9  2  AD 45 41             LDA     px
0036CC  2  38                   SEC
0036CD  2  E5 21                SBC     tmp1
0036CF  2  4C D8 36             JMP     @setx
0036D2  2               @xplus:
0036D2  2  AD 45 41             LDA     px
0036D5  2  18                   CLC
0036D6  2  65 21                ADC     tmp1
0036D8  2               @setx:
0036D8  2  85 2C                STA     tgtx
0036DA  2  A9 10                LDA     #16
0036DC  2  20 04 0C             JSR     rng_mod
0036DF  2  18                   CLC
0036E0  2  69 06                ADC     #6
0036E2  2  85 21                STA     tmp1
0036E4  2  20 E4 0B             JSR     rng_next
0036E7  2  29 01                AND     #1
0036E9  2  F0 09                BEQ     @yplus
0036EB  2  AD 46 41             LDA     py
0036EE  2  38                   SEC
0036EF  2  E5 21                SBC     tmp1
0036F1  2  4C FA 36             JMP     @sety
0036F4  2               @yplus:
0036F4  2  AD 46 41             LDA     py
0036F7  2  18                   CLC
0036F8  2  65 21                ADC     tmp1
0036FA  2               @sety:
0036FA  2  85 2D                STA     tgty
0036FC  2               ; reject the player's own tile (don't spawn on top of you)
0036FC  2  A5 2C                LDA     tgtx
0036FE  2  CD 45 41             CMP     px
003701  2  D0 07                BNE     @okpos
003703  2  A5 2D                LDA     tgty
003705  2  CD 46 41             CMP     py
003708  2  F0 20                BEQ     @skip
00370A  2               @okpos:
00370A  2               ; must be passable grass/forest (not water/mountain/town...)
00370A  2  20 5B 19             JSR     tileat
00370D  2  A6 2E                LDX     tgttile
00370F  2  BD 53 18             LDA     tile_prop,X
003712  2  29 01                AND     #P_PASS
003714  2  F0 14                BEQ     @skip
003716  2  BD 53 18             LDA     tile_prop,X
003719  2  29 0C                AND     #(P_TOWN|P_DUNG)
00371B  2  D0 0D                BNE     @skip           ; don't sit on a town/dungeon tile
00371D  2               ; not already occupied by a monster?
00371D  2  20 8B 36             JSR     mon_at
003720  2  B0 08                BCS     @skip
003722  2               ; pick a random monster type 1..5
003722  2  A9 05                LDA     #5
003724  2  20 14 0C             JSR     rng_d           ; 1..5
003727  2  20 6C 36             JSR     mon_spawn
00372A  2               @skip:
00372A  2  C6 24                DEC     cnt0
00372C  2  D0 8A                BNE     @loop
00372E  2  60                   RTS
00372F  2               
00372F  2               ;----------------------------------------------------------------
00372F  2               ; spawn_dungeon_monsters - place a few monsters and the boss.
00372F  2               ;----------------------------------------------------------------
00372F  2               spawn_dungeon_monsters:
00372F  2  20 4D 36             JSR     mon_clear_all
003732  2               ; the boss waits at the far corner treasure room (bottom-right)
003732  2  A9 1D                LDA     #29
003734  2  85 2C                STA     tgtx
003736  2  A9 12                LDA     #18
003738  2  85 2D                STA     tgty
00373A  2  A9 06                LDA     #M_BOSS
00373C  2  20 6C 36             JSR     mon_spawn
00373F  2               ; a couple of guards on floor tiles
00373F  2  A9 04                LDA     #4
003741  2  85 24                STA     cnt0
003743  2               @loop:
003743  2  A9 1C                LDA     #28
003745  2  20 04 0C             JSR     rng_mod
003748  2  18                   CLC
003749  2  69 02                ADC     #2
00374B  2  85 2C                STA     tgtx
00374D  2  A9 10                LDA     #16
00374F  2  20 04 0C             JSR     rng_mod
003752  2  18                   CLC
003753  2  69 02                ADC     #2
003755  2  85 2D                STA     tgty
003757  2  20 5B 19             JSR     tileat
00375A  2  A6 2E                LDX     tgttile
00375C  2  E0 09                CPX     #T_FLOOR
00375E  2  D0 0B                BNE     @skip
003760  2  A9 02                LDA     #2              ; orc or skeleton
003762  2  20 14 0C             JSR     rng_d
003765  2  18                   CLC
003766  2  69 02                ADC     #2              ; 3..4 -> skeleton/thief mix
003768  2  20 6C 36             JSR     mon_spawn
00376B  2               @skip:
00376B  2  C6 24                DEC     cnt0
00376D  2  D0 D4                BNE     @loop
00376F  2  60                   RTS
003770  2               
003770  2               ;----------------------------------------------------------------
003770  2               ; draw_monsters_vram - overlay all visible monsters in the viewport.
003770  2               ; Called by render_view while video is paged in.
003770  2               ;----------------------------------------------------------------
003770  2               draw_monsters_vram:
003770  2  A2 00                LDX     #0
003772  2  86 2F                STX     monidx
003774  2               @dm:
003774  2  A6 2F                LDX     monidx
003776  2  BD 6A 42             LDA     mon_type,X
003779  2  C9 00                CMP     #M_NONE
00377B  2  F0 1A                BEQ     @next
00377D  2               ; set world coords + glyph/color, then plot if visible
00377D  2  BD 76 42             LDA     mon_x,X
003780  2  85 2C                STA     tgtx
003782  2  BD 82 42             LDA     mon_y,X
003785  2  85 2D                STA     tgty
003787  2  BC 6A 42             LDY     mon_type,X
00378A  2  B9 23 36             LDA     mtype_glyph,Y
00378D  2  85 24                STA     cnt0            ; glyph (cnt0/cnt1 survive rowbase)
00378F  2  B9 2A 36             LDA     mtype_color,Y
003792  2  85 25                STA     cnt1            ; color
003794  2  20 08 33             JSR     plot_view_cell
003797  2               @next:
003797  2  E6 2F                INC     monidx
003799  2  A5 2F                LDA     monidx
00379B  2  C9 0C                CMP     #MAXMON
00379D  2  D0 D5                BNE     @dm
00379F  2  60                   RTS
0037A0  2               
0037A0  2               ;----------------------------------------------------------------
0037A0  2               ; mon_act - move/attack for every monster (called once per turn).
0037A0  2               ; Monsters in LOC_TOWN never act (towns are safe).
0037A0  2               ;   A monster adjacent to the player attacks; otherwise it steps
0037A0  2               ;   one tile toward the player if the destination is passable and
0037A0  2               ;   unoccupied.
0037A0  2               ;----------------------------------------------------------------
0037A0  2               mon_act:
0037A0  2  AD 52 41             LDA     loc
0037A3  2  C9 01                CMP     #LOC_TOWN
0037A5  2  F0 18                BEQ     @ret            ; safe in town
0037A7  2  A2 00                LDX     #0
0037A9  2  86 2F                STX     monidx
0037AB  2               @ma:
0037AB  2  A6 2F                LDX     monidx
0037AD  2  BD 6A 42             LDA     mon_type,X
0037B0  2  C9 00                CMP     #M_NONE
0037B2  2  F0 03                BEQ     @next
0037B4  2               ; distance to player: dxv = px - mon_x ; dyv = py - mon_y
0037B4  2               ; adjacency test (|dx|<=1 && |dy|<=1 && not both 0)
0037B4  2  20 C0 37             JSR     mon_step_or_attack
0037B7  2               @next:
0037B7  2  E6 2F                INC     monidx
0037B9  2  A5 2F                LDA     monidx
0037BB  2  C9 0C                CMP     #MAXMON
0037BD  2  D0 EC                BNE     @ma
0037BF  2               @ret:
0037BF  2  60                   RTS
0037C0  2               
0037C0  2               ; mon_step_or_attack - for monster in slot monidx (X on entry).
0037C0  2               mon_step_or_attack:
0037C0  2               ; compute signed dx = px - mon_x  -> tmp0 ; dy -> tmp1
0037C0  2  A6 2F                LDX     monidx
0037C2  2  38                   SEC
0037C3  2  AD 45 41             LDA     px
0037C6  2  FD 76 42             SBC     mon_x,X
0037C9  2  85 20                STA     tmp0            ; dx (signed)
0037CB  2  38                   SEC
0037CC  2  AD 46 41             LDA     py
0037CF  2  FD 82 42             SBC     mon_y,X
0037D2  2  85 21                STA     tmp1            ; dy (signed)
0037D4  2               ; |dx| <= 1 ?
0037D4  2  A5 20                LDA     tmp0
0037D6  2  20 4C 38             JSR     abs_a
0037D9  2  85 22                STA     tmp2            ; |dx|
0037DB  2  A5 21                LDA     tmp1
0037DD  2  20 4C 38             JSR     abs_a
0037E0  2  85 23                STA     tmp3            ; |dy|
0037E2  2               ; adjacency: |dx|<=1 and |dy|<=1
0037E2  2  A5 22                LDA     tmp2
0037E4  2  C9 02                CMP     #2
0037E6  2  B0 09                BCS     @move
0037E8  2  A5 23                LDA     tmp3
0037EA  2  C9 02                CMP     #2
0037EC  2  B0 03                BCS     @move
0037EE  2               ; adjacent (and since one of them is the player, not same cell)
0037EE  2               ; -> attack the player
0037EE  2  4C 7F 3B             JMP     monster_attacks_player; in combat.asm
0037F1  2               @move:
0037F1  2               ; step one tile toward player along the larger axis
0037F1  2               ; choose step in x: sign of dx
0037F1  2  A6 2F                LDX     monidx
0037F3  2  BD 76 42             LDA     mon_x,X
0037F6  2  85 2C                STA     tgtx
0037F8  2  BD 82 42             LDA     mon_y,X
0037FB  2  85 2D                STA     tgty
0037FD  2               ; prefer horizontal if |dx|>=|dy|
0037FD  2  A5 22                LDA     tmp2
0037FF  2  C5 23                CMP     tmp3
003801  2  90 10                BCC     @vert
003803  2               ; horizontal step
003803  2  A5 20                LDA     tmp0
003805  2  F0 0C                BEQ     @vert           ; dx==0 -> try vertical
003807  2  30 05                BMI     @left
003809  2  E6 2C                INC     tgtx
00380B  2  4C 20 38             JMP     @trymove
00380E  2               @left:
00380E  2  C6 2C                DEC     tgtx
003810  2  4C 20 38             JMP     @trymove
003813  2               @vert:
003813  2  A5 21                LDA     tmp1
003815  2  F0 34                BEQ     @done           ; dy==0 too -> no move
003817  2  30 05                BMI     @up
003819  2  E6 2D                INC     tgty
00381B  2  4C 20 38             JMP     @trymove
00381E  2               @up:
00381E  2  C6 2D                DEC     tgty
003820  2               @trymove:
003820  2               ; passable terrain?
003820  2  20 5B 19             JSR     tileat
003823  2  A6 2E                LDX     tgttile
003825  2  BD 53 18             LDA     tile_prop,X
003828  2  29 01                AND     #P_PASS
00382A  2  F0 1F                BEQ     @done           ; blocked terrain
00382C  2               ; not onto the player?
00382C  2  A5 2C                LDA     tgtx
00382E  2  CD 45 41             CMP     px
003831  2  D0 07                BNE     @okcell
003833  2  A5 2D                LDA     tgty
003835  2  CD 46 41             CMP     py
003838  2  F0 11                BEQ     @done           ; would land on player (shouldn't: adjacency handled)
00383A  2               @okcell:
00383A  2               ; not onto another monster?
00383A  2  20 8B 36             JSR     mon_at
00383D  2  B0 0C                BCS     @done           ; occupied
00383F  2               ; commit move
00383F  2  A6 2F                LDX     monidx
003841  2  A5 2C                LDA     tgtx
003843  2  9D 76 42             STA     mon_x,X
003846  2  A5 2D                LDA     tgty
003848  2  9D 82 42             STA     mon_y,X
00384B  2               @done:
00384B  2  60                   RTS
00384C  2               
00384C  2               ;----------------------------------------------------------------
00384C  2               ; abs_a - A = |A| treating A as signed 8-bit.
00384C  2               ;----------------------------------------------------------------
00384C  2               abs_a:
00384C  2  C9 80                CMP     #$80
00384E  2  90 05                BCC     @pos
003850  2  49 FF                EOR     #$FF
003852  2  18                   CLC
003853  2  69 01                ADC     #1
003855  2               @pos:
003855  2  60                   RTS
003856  2               
003856  1                       .INCLUDE "player.asm"
003856  2               ;______________________________________________________________________________
003856  2               ;  player.asm - player movement, map transitions, treasure
003856  2               ;______________________________________________________________________________
003856  2               
003856  2               ;----------------------------------------------------------------
003856  2               ; Player starting state on the overworld.
003856  2               ;----------------------------------------------------------------
003856  2               PLAYER_START_X  = 20
003856  2               PLAYER_START_Y  = 9
003856  2               
003856  2               player_init:
003856  2  A9 14                LDA     #PLAYER_START_X
003858  2  8D 45 41             STA     px
00385B  2  A9 09                LDA     #PLAYER_START_Y
00385D  2  8D 46 41             STA     py
003860  2  A9 1E                LDA     #30
003862  2  8D 47 41             STA     phealth
003865  2  8D 48 41             STA     pmaxhp
003868  2  A9 01                LDA     #1
00386A  2  8D 49 41             STA     plevel
00386D  2  A9 00                LDA     #0
00386F  2  8D 4A 41             STA     pxp
003872  2  8D 4B 41             STA     pxp+1
003875  2  A9 32                LDA     #50
003877  2  8D 4C 41             STA     pgold
00387A  2  A9 00                LDA     #0
00387C  2  8D 4D 41             STA     pgold+1
00387F  2  A9 FA 8D 4E          SETW16  pfood, 250
003883  2  41 A9 00 8D  
003887  2  4F 41        
003889  2  A9 01                LDA     #1
00388B  2  8D 50 41             STA     pweapon         ; dagger
00388E  2  A9 00                LDA     #0
003890  2  8D 51 41             STA     parmor          ; clothes
003893  2  A9 00                LDA     #LOC_WORLD
003895  2  8D 52 41             STA     loc
003898  2  A9 00                LDA     #0
00389A  2  8D 57 41             STA     bosskilled
00389D  2  60                   RTS
00389E  2               
00389E  2               ;----------------------------------------------------------------
00389E  2               ; try_move - attempt to move the player by (dx,dy).
00389E  2               ;   IN: dx, dy = signed -1/0/+1 deltas
00389E  2               ;   Effects: combat on bump, terrain block, town/dungeon entry,
00389E  2               ;   treasure pickup, exit interiors, food cost.  Monsters act after
00389E  2               ;   a successful step (handled by caller via did_move flag).
00389E  2               ;   OUT: did_move (game var) = 1 if a turn was consumed.
00389E  2               ;----------------------------------------------------------------
00389E  2               try_move:
00389E  2  A9 00                LDA     #0
0038A0  2  8D 58 41             STA     did_move
0038A3  2               ; target = (px+dx, py+dy)
0038A3  2  18                   CLC
0038A4  2  AD 45 41             LDA     px
0038A7  2  65 2A                ADC     dx
0038A9  2  85 2C                STA     tgtx
0038AB  2  18                   CLC
0038AC  2  AD 46 41             LDA     py
0038AF  2  65 2B                ADC     dy
0038B1  2  85 2D                STA     tgty
0038B3  2               
0038B3  2               ; monster there? -> attack (consumes the turn)
0038B3  2  20 8B 36             JSR     mon_at
0038B6  2  90 09                BCC     @noenemy
0038B8  2               ; X = monster slot ; resolve combat
0038B8  2  20 77 3A             JSR     player_attacks_monster
0038BB  2  A9 01                LDA     #1
0038BD  2  8D 58 41             STA     did_move
0038C0  2  60                   RTS
0038C1  2               @noenemy:
0038C1  2               ; look at the terrain
0038C1  2  20 5B 19             JSR     tileat          ; -> tgttile
0038C4  2  A6 2E                LDX     tgttile
0038C6  2  BD 53 18             LDA     tile_prop,X
0038C9  2  85 20                STA     tmp0            ; property bits
0038CB  2  29 01                AND     #P_PASS
0038CD  2  D0 0B                BNE     @passable
0038CF  2               ; blocked
0038CF  2  20 1C 0D             JSR     sfx_blocked
0038D2  2  A9 60 A0 3C          PRINTMSG_MSG m_blocked
0038D6  2  20 B1 33     
0038D9  2  60                   RTS                     ; no turn consumed on a wall bump
0038DA  2               @passable:
0038DA  2               ; check special tiles
0038DA  2  A5 20                LDA     tmp0
0038DC  2  29 04                AND     #P_TOWN
0038DE  2  F0 03                BEQ     @ck_dung
0038E0  2  4C 4E 39             JMP     enter_town
0038E3  2               @ck_dung:
0038E3  2  A5 20                LDA     tmp0
0038E5  2  29 08                AND     #P_DUNG
0038E7  2  F0 03                BEQ     @ck_exit
0038E9  2  4C 89 39             JMP     enter_dungeon
0038EC  2               @ck_exit:
0038EC  2  A5 20                LDA     tmp0
0038EE  2  29 10                AND     #P_EXIT
0038F0  2  F0 03                BEQ     @ck_treas
0038F2  2  4C C4 39             JMP     leave_interior
0038F5  2               @ck_treas:
0038F5  2               ; commit the move first
0038F5  2  A5 2C                LDA     tgtx
0038F7  2  8D 45 41             STA     px
0038FA  2  A5 2D                LDA     tgty
0038FC  2  8D 46 41             STA     py
0038FF  2  A9 01                LDA     #1
003901  2  8D 58 41             STA     did_move
003904  2               ; treasure?
003904  2  A5 20                LDA     tmp0
003906  2  29 20                AND     #P_TREAS
003908  2  F0 03                BEQ     @food
00390A  2  20 27 39             JSR     collect_treasure
00390D  2               @food:
00390D  2               ; consume a unit of food per step
00390D  2  AD 4E 41             LDA     pfood
003910  2  0D 4F 41             ORA     pfood+1
003913  2  F0 11                BEQ     @nofood
003915  2  38                   SEC
003916  2  AD 4E 41             LDA     pfood
003919  2  E9 01                SBC     #1
00391B  2  8D 4E 41             STA     pfood
00391E  2  AD 4F 41             LDA     pfood+1
003921  2  E9 00                SBC     #0
003923  2  8D 4F 41             STA     pfood+1
003926  2               @nofood:
003926  2  60                   RTS
003927  2               
003927  2               ;----------------------------------------------------------------
003927  2               ; collect_treasure - pick up a chest at (tgtx,tgty): gold + maybe
003927  2               ; XP, then clear the tile to floor.
003927  2               ;----------------------------------------------------------------
003927  2               collect_treasure:
003927  2               ; gold 5..20
003927  2  A9 10                LDA     #16
003929  2  20 14 0C             JSR     rng_d
00392C  2  18                   CLC
00392D  2  69 04                ADC     #4
00392F  2               ; add to gold (16-bit)
00392F  2  18                   CLC
003930  2  6D 4C 41             ADC     pgold
003933  2  8D 4C 41             STA     pgold
003936  2  AD 4D 41             LDA     pgold+1
003939  2  69 00                ADC     #0
00393B  2  8D 4D 41             STA     pgold+1
00393E  2               ; clear the chest tile -> floor
00393E  2  A9 09                LDA     #T_FLOOR
003940  2  20 02 1A             JSR     settile
003943  2  20 81 0D             JSR     sfx_treasure
003946  2  A9 69 A0 3C          PRINTMSG_MSG m_treasure
00394A  2  20 B1 33     
00394D  2  60                   RTS
00394E  2               
00394E  2               ;----------------------------------------------------------------
00394E  2               ; enter_town - switch to the town interior map.
00394E  2               ;----------------------------------------------------------------
00394E  2               enter_town:
00394E  2  20 EF 0D             JSR     sfx_door
003951  2  20 1D 19             JSR     decode_town
003954  2  A9 01                LDA     #LOC_TOWN
003956  2  8D 52 41             STA     loc
003959  2  A9 20                LDA     #TOWNW
00395B  2  8D 53 41             STA     locw
00395E  2  A9 14                LDA     #TOWNH
003960  2  8D 54 41             STA     loch
003963  2               ; remember overworld position to restore on exit
003963  2  AD 45 41             LDA     px
003966  2  8D 55 41             STA     owretx
003969  2  AD 46 41             LDA     py
00396C  2  8D 56 41             STA     owrety
00396F  2               ; place player just inside, one tile NORTH of the door so the
00396F  2               ; exit '+' is visible directly south of the player on entry.
00396F  2  A9 0E                LDA     #14
003971  2  8D 45 41             STA     px
003974  2  A9 11                LDA     #TOWNH-3
003976  2  8D 46 41             STA     py
003979  2               ; towns have no monsters
003979  2  20 4D 36             JSR     mon_clear_all
00397C  2  A9 01                LDA     #1
00397E  2  8D 58 41             STA     did_move
003981  2  A9 84 A0 3C          PRINTMSG_MSG m_town
003985  2  20 B1 33     
003988  2  60                   RTS
003989  2               
003989  2               ;----------------------------------------------------------------
003989  2               ; enter_dungeon - switch to the dungeon map and spawn its monsters.
003989  2               ;----------------------------------------------------------------
003989  2               enter_dungeon:
003989  2  20 EF 0D             JSR     sfx_door
00398C  2  20 3C 19             JSR     decode_dung
00398F  2  A9 02                LDA     #LOC_DUNG
003991  2  8D 52 41             STA     loc
003994  2  A9 20                LDA     #DUNGW
003996  2  8D 53 41             STA     locw
003999  2  A9 14                LDA     #DUNGH
00399B  2  8D 54 41             STA     loch
00399E  2  AD 45 41             LDA     px
0039A1  2  8D 55 41             STA     owretx
0039A4  2  AD 46 41             LDA     py
0039A7  2  8D 56 41             STA     owrety
0039AA  2               ; start just east of the stairs-up '<' (at 1,1) so the exit
0039AA  2               ; is visible immediately to the west of the player.
0039AA  2  A9 02                LDA     #2
0039AC  2  8D 45 41             STA     px
0039AF  2  A9 01                LDA     #1
0039B1  2  8D 46 41             STA     py
0039B4  2  20 2F 37             JSR     spawn_dungeon_monsters
0039B7  2  A9 01                LDA     #1
0039B9  2  8D 58 41             STA     did_move
0039BC  2  A9 C3 A0 3C          PRINTMSG_MSG m_dungeon
0039C0  2  20 B1 33     
0039C3  2  60                   RTS
0039C4  2               
0039C4  2               ;----------------------------------------------------------------
0039C4  2               ; leave_interior - return to the overworld at the saved position.
0039C4  2               ;----------------------------------------------------------------
0039C4  2               leave_interior:
0039C4  2  20 EF 0D             JSR     sfx_door
0039C7  2  20 FE 18             JSR     decode_world
0039CA  2  A9 00                LDA     #LOC_WORLD
0039CC  2  8D 52 41             STA     loc
0039CF  2  AD 55 41             LDA     owretx
0039D2  2  8D 45 41             STA     px
0039D5  2  AD 56 41             LDA     owrety
0039D8  2  8D 46 41             STA     py
0039DB  2  20 B1 36             JSR     spawn_overworld_monsters
0039DE  2  A9 01                LDA     #1
0039E0  2  8D 58 41             STA     did_move
0039E3  2  A9 F6 A0 3C          PRINTMSG_MSG m_world
0039E7  2  20 B1 33     
0039EA  2  60                   RTS
0039EB  2               
0039EB  1                       .INCLUDE "combat.asm"
0039EB  2               ;______________________________________________________________________________
0039EB  2               ;  combat.asm - bump combat resolution, leveling, message builder
0039EB  2               ;______________________________________________________________________________
0039EB  2               
0039EB  2               ;----------------------------------------------------------------
0039EB  2               ; Message builder.  Compose a line in mbuf then push to the log.
0039EB  2               ;   mb_reset            - start a new line
0039EB  2               ;   mb_str  (A=lo,Y=hi) - append a 0-terminated string
0039EB  2               ;   mb_num  (A=byte)    - append a 0..255 value in decimal
0039EB  2               ;   mb_mname(A=type)    - append a monster type name
0039EB  2               ;   mb_flush            - push mbuf into the scrolling log
0039EB  2               ;----------------------------------------------------------------
0039EB  2               mb_reset:
0039EB  2  A9 00                LDA     #0
0039ED  2  8D 69 42             STA     mblen
0039F0  2  60                   RTS
0039F1  2               
0039F1  2               mb_str:
0039F1  2  85 1C                STA     strp
0039F3  2  84 1D                STY     strp+1
0039F5  2  A0 00                LDY     #0
0039F7  2               @s:
0039F7  2  B1 1C                LDA     (strp),Y
0039F9  2  F0 0C                BEQ     @done
0039FB  2  AE 69 42             LDX     mblen
0039FE  2  9D 09 42             STA     mbuf,X
003A01  2  EE 69 42             INC     mblen
003A04  2  C8                   INY
003A05  2  D0 F0                BNE     @s
003A07  2               @done:
003A07  2  60                   RTS
003A08  2               
003A08  2               ; append A (0..255) as decimal
003A08  2               mb_num:
003A08  2  85 1E                STA     numarg
003A0A  2  A9 00                LDA     #0
003A0C  2  85 1F                STA     numarg+1
003A0E  2               mb_num16:
003A0E  2               ; find highest place
003A0E  2  A0 08                LDY     #8
003A10  2               @find:
003A10  2  A5 1F                LDA     numarg+1
003A12  2  D9 9F 33             CMP     nums+1,Y
003A15  2  90 09                BCC     @nx
003A17  2  D0 0B                BNE     @start
003A19  2  A5 1E                LDA     numarg
003A1B  2  D9 9E 33             CMP     nums,Y
003A1E  2  B0 04                BCS     @start
003A20  2               @nx:
003A20  2  88                   DEY
003A21  2  88                   DEY
003A22  2  D0 EC                BNE     @find
003A24  2               @start:
003A24  2  A9 30                LDA     #'0'
003A26  2  85 28                STA     numspace
003A28  2               @dig:
003A28  2  A5 1F                LDA     numarg+1
003A2A  2  D9 9F 33             CMP     nums+1,Y
003A2D  2  90 1E                BCC     @out
003A2F  2  D0 09                BNE     @noc
003A31  2  A5 1E                LDA     numarg
003A33  2  F9 9E 33             SBC     nums,Y
003A36  2  90 15                BCC     @out
003A38  2  B0 05                BCS     @sub
003A3A  2               @noc:
003A3A  2  A5 1E                LDA     numarg
003A3C  2  F9 9E 33             SBC     nums,Y
003A3F  2               @sub:
003A3F  2  E6 28                INC     numspace
003A41  2  85 1E                STA     numarg
003A43  2  A5 1F                LDA     numarg+1
003A45  2  F9 9F 33             SBC     nums+1,Y
003A48  2  85 1F                STA     numarg+1
003A4A  2  4C 28 3A             JMP     @dig
003A4D  2               @out:
003A4D  2  A5 28                LDA     numspace
003A4F  2  AE 69 42             LDX     mblen
003A52  2  9D 09 42             STA     mbuf,X
003A55  2  EE 69 42             INC     mblen
003A58  2  88                   DEY
003A59  2  88                   DEY
003A5A  2  10 C8                BPL     @start
003A5C  2  60                   RTS
003A5D  2               
003A5D  2               ; append a monster type name (A = type id)
003A5D  2               mb_mname:
003A5D  2  0A                   ASL     A
003A5E  2  AA                   TAX
003A5F  2  BD E4 3B             LDA     mon_names,X
003A62  2  BC E5 3B             LDY     mon_names+1,X
003A65  2  4C F1 39             JMP     mb_str
003A68  2               
003A68  2               mb_flush:
003A68  2  AE 69 42             LDX     mblen
003A6B  2  A9 00                LDA     #0
003A6D  2  9D 09 42             STA     mbuf,X          ; NUL terminate
003A70  2  A9 09                LDA     #<mbuf
003A72  2  A0 42                LDY     #>mbuf
003A74  2  4C B1 33             JMP     msg_print
003A77  2               
003A77  2               ;----------------------------------------------------------------
003A77  2               ; player_attacks_monster - X = monster slot.
003A77  2               ;   Damage = 1..(weapon_power) + small bonus.  Apply, possibly kill.
003A77  2               ;----------------------------------------------------------------
003A77  2               player_attacks_monster:
003A77  2  86 2F                STX     monidx
003A79  2               ; damage roll: base from weapon
003A79  2  AE 50 41             LDX     pweapon
003A7C  2  BD DC 3B             LDA     wpn_power,X
003A7F  2  20 14 0C             JSR     rng_d           ; 1..power
003A82  2  85 20                STA     tmp0            ; damage
003A84  2               ; subtract from monster hp
003A84  2  A6 2F                LDX     monidx
003A86  2  38                   SEC
003A87  2  BD 8E 42             LDA     mon_hp,X
003A8A  2  E5 20                SBC     tmp0
003A8C  2  9D 8E 42             STA     mon_hp,X
003A8F  2               ; build "You hit the Orc for N!"
003A8F  2  20 EB 39             JSR     mb_reset
003A92  2  A9 1E                LDA     #<c_youhit
003A94  2  A0 3C                LDY     #>c_youhit
003A96  2  20 F1 39             JSR     mb_str
003A99  2  A6 2F                LDX     monidx
003A9B  2  BD 6A 42             LDA     mon_type,X
003A9E  2  20 5D 3A             JSR     mb_mname
003AA1  2  A9 2B                LDA     #<c_for
003AA3  2  A0 3C                LDY     #>c_for
003AA5  2  20 F1 39             JSR     mb_str
003AA8  2  A5 20                LDA     tmp0
003AAA  2  20 08 3A             JSR     mb_num
003AAD  2  A9 31                LDA     #<c_bang
003AAF  2  A0 3C                LDY     #>c_bang
003AB1  2  20 F1 39             JSR     mb_str
003AB4  2  20 68 3A             JSR     mb_flush
003AB7  2  20 39 0D             JSR     sfx_hit
003ABA  2               ; dead?  (hp <= 0 i.e. hp was <= damage -> result negative/zero)
003ABA  2  A6 2F                LDX     monidx
003ABC  2  BD 8E 42             LDA     mon_hp,X
003ABF  2  F0 03                BEQ     @dead
003AC1  2  30 01                BMI     @dead
003AC3  2  60                   RTS
003AC4  2               @dead:
003AC4  2  4C C7 3A             JMP     monster_dies
003AC7  2               
003AC7  2               ;----------------------------------------------------------------
003AC7  2               ; monster_dies - award XP/gold, drop the slot, maybe win, maybe
003AC7  2               ; level up.  Slot in monidx.
003AC7  2               ;----------------------------------------------------------------
003AC7  2               monster_dies:
003AC7  2  A6 2F                LDX     monidx
003AC9  2  BD 6A 42             LDA     mon_type,X
003ACC  2  85 21                STA     tmp1            ; type
003ACE  2               ; XP
003ACE  2  A8                   TAY
003ACF  2  B9 3F 36             LDA     mtype_xp,Y
003AD2  2  18                   CLC
003AD3  2  6D 4A 41             ADC     pxp
003AD6  2  8D 4A 41             STA     pxp
003AD9  2  AD 4B 41             LDA     pxp+1
003ADC  2  69 00                ADC     #0
003ADE  2  8D 4B 41             STA     pxp+1
003AE1  2               ; gold drop 0..mtype_gold
003AE1  2  A4 21                LDY     tmp1
003AE3  2  B9 46 36             LDA     mtype_gold,Y
003AE6  2  F0 12                BEQ     @nogold
003AE8  2  20 04 0C             JSR     rng_mod         ; 0..gold-1
003AEB  2  18                   CLC
003AEC  2  6D 4C 41             ADC     pgold
003AEF  2  8D 4C 41             STA     pgold
003AF2  2  AD 4D 41             LDA     pgold+1
003AF5  2  69 00                ADC     #0
003AF7  2  8D 4D 41             STA     pgold+1
003AFA  2               @nogold:
003AFA  2               ; message "The Orc dies!"
003AFA  2  20 EB 39             JSR     mb_reset
003AFD  2  A9 33                LDA     #<c_the
003AFF  2  A0 3C                LDY     #>c_the
003B01  2  20 F1 39             JSR     mb_str
003B04  2  A5 21                LDA     tmp1
003B06  2  20 5D 3A             JSR     mb_mname
003B09  2  A9 38                LDA     #<c_dies
003B0B  2  A0 3C                LDY     #>c_dies
003B0D  2  20 F1 39             JSR     mb_str
003B10  2  20 68 3A             JSR     mb_flush
003B13  2  20 64 0D             JSR     sfx_killed
003B16  2               ; remove monster
003B16  2  A6 2F                LDX     monidx
003B18  2  20 AB 36             JSR     mon_kill
003B1B  2               ; boss?
003B1B  2  A5 21                LDA     tmp1
003B1D  2  C9 06                CMP     #M_BOSS
003B1F  2  D0 05                BNE     @lvl
003B21  2  A9 01                LDA     #1
003B23  2  8D 57 41             STA     bosskilled
003B26  2               @lvl:
003B26  2  20 2A 3B             JSR     check_levelup
003B29  2  60                   RTS
003B2A  2               
003B2A  2               ;----------------------------------------------------------------
003B2A  2               ; check_levelup - if xp >= level*20, level up (raise maxhp, heal).
003B2A  2               ;----------------------------------------------------------------
003B2A  2               check_levelup:
003B2A  2               ; threshold = plevel * 20  (8-bit is enough up to lvl 12)
003B2A  2  AD 49 41             LDA     plevel
003B2D  2  85 20                STA     tmp0
003B2F  2  A9 00                LDA     #0
003B31  2  85 21                STA     tmp1
003B33  2               ; tmp = level*20 = level*16 + level*4
003B33  2  AD 49 41             LDA     plevel
003B36  2  0A                   ASL     A
003B37  2  0A                   ASL     A               ; *4
003B38  2  85 22                STA     tmp2
003B3A  2  AD 49 41             LDA     plevel
003B3D  2  0A                   ASL     A
003B3E  2  0A                   ASL     A
003B3F  2  0A                   ASL     A
003B40  2  0A                   ASL     A               ; *16
003B41  2  18                   CLC
003B42  2  65 22                ADC     tmp2
003B44  2  85 22                STA     tmp2            ; level*20 (low); ignore >255 (caps fine)
003B46  2               ; compare xp (16-bit) >= tmp2
003B46  2  AD 4B 41             LDA     pxp+1
003B49  2  D0 07                BNE     @levelup        ; xp >= 256 definitely past early thresholds
003B4B  2  AD 4A 41             LDA     pxp
003B4E  2  C5 22                CMP     tmp2
003B50  2  90 2C                BCC     @done
003B52  2               @levelup:
003B52  2  EE 49 41             INC     plevel
003B55  2               ; maxhp += 8, full heal
003B55  2  AD 48 41             LDA     pmaxhp
003B58  2  18                   CLC
003B59  2  69 08                ADC     #8
003B5B  2  8D 48 41             STA     pmaxhp
003B5E  2  8D 47 41             STA     phealth
003B61  2  20 B8 0D             JSR     sfx_levelup
003B64  2  20 EB 39             JSR     mb_reset
003B67  2  A9 4E                LDA     #<c_levelup
003B69  2  A0 3C                LDY     #>c_levelup
003B6B  2  20 F1 39             JSR     mb_str
003B6E  2  AD 49 41             LDA     plevel
003B71  2  20 08 3A             JSR     mb_num
003B74  2  A9 31                LDA     #<c_bang
003B76  2  A0 3C                LDY     #>c_bang
003B78  2  20 F1 39             JSR     mb_str
003B7B  2  20 68 3A             JSR     mb_flush
003B7E  2               @done:
003B7E  2  60                   RTS
003B7F  2               
003B7F  2               ;----------------------------------------------------------------
003B7F  2               ; monster_attacks_player - monster in slot monidx strikes.
003B7F  2               ;   Damage = 1..mtype_atk, reduced by armor.  Apply to phealth.
003B7F  2               ;----------------------------------------------------------------
003B7F  2               monster_attacks_player:
003B7F  2  A6 2F                LDX     monidx
003B81  2  BD 6A 42             LDA     mon_type,X
003B84  2  85 21                STA     tmp1            ; type
003B86  2  A8                   TAY
003B87  2  B9 38 36             LDA     mtype_atk,Y
003B8A  2  20 14 0C             JSR     rng_d           ; 1..atk
003B8D  2  85 20                STA     tmp0            ; raw damage
003B8F  2               ; armor reduces by armor index (0..3)
003B8F  2  AE 51 41             LDX     parmor
003B92  2  BD E0 3B             LDA     arm_def,X
003B95  2  85 22                STA     tmp2
003B97  2  38                   SEC
003B98  2  A5 20                LDA     tmp0
003B9A  2  E5 22                SBC     tmp2
003B9C  2  10 02                BPL     @ok
003B9E  2  A9 01                LDA     #1              ; minimum 1 damage
003BA0  2               @ok:
003BA0  2  D0 02                BNE     @apply
003BA2  2  A9 01                LDA     #1
003BA4  2               @apply:
003BA4  2  85 20                STA     tmp0
003BA6  2               ; subtract from phealth (floor at 0)
003BA6  2  38                   SEC
003BA7  2  AD 47 41             LDA     phealth
003BAA  2  E5 20                SBC     tmp0
003BAC  2  B0 02                BCS     @sethp
003BAE  2  A9 00                LDA     #0
003BB0  2               @sethp:
003BB0  2  8D 47 41             STA     phealth
003BB3  2               ; message "Orc hits you for N!"
003BB3  2  20 EB 39             JSR     mb_reset
003BB6  2  A9 33                LDA     #<c_the
003BB8  2  A0 3C                LDY     #>c_the
003BBA  2  20 F1 39             JSR     mb_str
003BBD  2  A5 21                LDA     tmp1
003BBF  2  20 5D 3A             JSR     mb_mname
003BC2  2  A9 3F                LDA     #<c_hitsyou
003BC4  2  A0 3C                LDY     #>c_hitsyou
003BC6  2  20 F1 39             JSR     mb_str
003BC9  2  A5 20                LDA     tmp0
003BCB  2  20 08 3A             JSR     mb_num
003BCE  2  A9 31                LDA     #<c_bang
003BD0  2  A0 3C                LDY     #>c_bang
003BD2  2  20 F1 39             JSR     mb_str
003BD5  2  20 68 3A             JSR     mb_flush
003BD8  2  20 39 0D             JSR     sfx_hit
003BDB  2  60                   RTS
003BDC  2               
003BDC  2               ;----------------------------------------------------------------
003BDC  2               ; Weapon power (damage sides) and armor defense tables
003BDC  2               ;----------------------------------------------------------------
003BDC  2               wpn_power:
003BDC  2  02                   .BYTE   2               ; 0 fists
003BDD  2  04                   .BYTE   4               ; 1 dagger
003BDE  2  07                   .BYTE   7               ; 2 sword
003BDF  2  0A                   .BYTE   10              ; 3 axe
003BE0  2               arm_def:
003BE0  2  00                   .BYTE   0               ; 0 clothes
003BE1  2  01                   .BYTE   1               ; 1 leather
003BE2  2  02                   .BYTE   2               ; 2 chain
003BE3  2  04                   .BYTE   4               ; 3 plate
003BE4  2               
003BE4  2               ;----------------------------------------------------------------
003BE4  2               ; Monster name table (for messages), indexed by type id
003BE4  2               ;----------------------------------------------------------------
003BE4  2               mon_names:
003BE4  2  F2 3B F8 3B          .WORD   mn_none, mn_orc, mn_snake, mn_skel, mn_thief, mn_troll, mn_boss
003BE8  2  FC 3B 02 3C  
003BEC  2  0B 3C 11 3C  
003BF2  2               mn_none:
003BF2  2  74 68 69 6E          .BYTE   "thing",0
003BF6  2  67 00        
003BF8  2               mn_orc:
003BF8  2  4F 72 63 00          .BYTE   "Orc",0
003BFC  2               mn_snake:
003BFC  2  53 6E 61 6B          .BYTE   "Snake",0
003C00  2  65 00        
003C02  2               mn_skel:
003C02  2  53 6B 65 6C          .BYTE   "Skeleton",0
003C06  2  65 74 6F 6E  
003C0A  2  00           
003C0B  2               mn_thief:
003C0B  2  54 68 69 65          .BYTE   "Thief",0
003C0F  2  66 00        
003C11  2               mn_troll:
003C11  2  54 72 6F 6C          .BYTE   "Troll",0
003C15  2  6C 00        
003C17  2               mn_boss:
003C17  2  44 72 61 67          .BYTE   "Dragon",0
003C1B  2  6F 6E 00     
003C1E  2               
003C1E  2               ;----------------------------------------------------------------
003C1E  2               ; Combat / event message fragments
003C1E  2               ;----------------------------------------------------------------
003C1E  2               c_youhit:
003C1E  2  59 6F 75 20          .BYTE   "You hit the ",0
003C22  2  68 69 74 20  
003C26  2  74 68 65 20  
003C2B  2               c_for:
003C2B  2  20 66 6F 72          .BYTE   " for ",0
003C2F  2  20 00        
003C31  2               c_bang:
003C31  2  21 00                .BYTE   "!",0
003C33  2               c_the:
003C33  2  54 68 65 20          .BYTE   "The ",0
003C37  2  00           
003C38  2               c_dies:
003C38  2  20 64 69 65          .BYTE   " dies!",0
003C3C  2  73 21 00     
003C3F  2               c_hitsyou:
003C3F  2  20 68 69 74          .BYTE   " hits you for ",0
003C43  2  73 20 79 6F  
003C47  2  75 20 66 6F  
003C4E  2               c_levelup:
003C4E  2  57 65 6C 63          .BYTE   "Welcome to level ",0
003C52  2  6F 6D 65 20  
003C56  2  74 6F 20 6C  
003C60  2               
003C60  2               ;----------------------------------------------------------------
003C60  2               ; Map / event messages (shared with player.asm)
003C60  2               ;----------------------------------------------------------------
003C60  2               m_blocked:
003C60  2  42 6C 6F 63          .BYTE   "Blocked!",0
003C64  2  6B 65 64 21  
003C68  2  00           
003C69  2               m_treasure:
003C69  2  59 6F 75 20          .BYTE   "You found gold in a chest!",0
003C6D  2  66 6F 75 6E  
003C71  2  64 20 67 6F  
003C84  2               m_town:
003C84  2  54 6F 77 6E          .BYTE   "Town. Step on the door '+' (south) to leave. T at 'S' to shop.",0
003C88  2  2E 20 53 74  
003C8C  2  65 70 20 6F  
003CC3  2               m_dungeon:
003CC3  2  44 75 6E 67          .BYTE   "Dungeon! Step on the stairs '<' to climb back out.",0
003CC7  2  65 6F 6E 21  
003CCB  2  20 53 74 65  
003CF6  2               m_world:
003CF6  2  59 6F 75 20          .BYTE   "You return to the land of Wyrmhold.",0
003CFA  2  72 65 74 75  
003CFE  2  72 6E 20 74  
003D1A  2               
003D1A  1                       .INCLUDE "town.asm"
003D1A  2               ;______________________________________________________________________________
003D1A  2               ;  town.asm - shop interaction inside towns
003D1A  2               ;
003D1A  2               ;  When the player presses USE ('T') in a town while adjacent to a
003D1A  2               ;  shop counter ('S' tile), the shop menu opens.  The menu is drawn
003D1A  2               ;  over the message rows; the player picks an option, gold is spent,
003D1A  2               ;  and the menu returns to the map.
003D1A  2               ;______________________________________________________________________________
003D1A  2               
003D1A  2               PRICE_HEAL      = 10            ; gold per visit (full heal)
003D1A  2               PRICE_FOOD      = 20            ; gold for +100 food
003D1A  2               PRICE_WEAPON    = 60            ; gold to upgrade weapon one tier
003D1A  2               PRICE_ARMOR     = 50            ; gold to upgrade armor one tier
003D1A  2               
003D1A  2               ;----------------------------------------------------------------
003D1A  2               ; use_action - bound to the USE key ('T').  Only meaningful in a
003D1A  2               ; town next to a shop counter.
003D1A  2               ;----------------------------------------------------------------
003D1A  2               use_action:
003D1A  2  AD 52 41             LDA     loc
003D1D  2  C9 01                CMP     #LOC_TOWN
003D1F  2  F0 08                BEQ     @intown
003D21  2  A9 35 A0 40          PRINTMSG_MSG t_nothing
003D25  2  20 B1 33     
003D28  2  60                   RTS
003D29  2               @intown:
003D29  2               ; is a shop tile adjacent (4-neighbour) or under us?
003D29  2  20 39 3D             JSR     shop_adjacent
003D2C  2  B0 08                BCS     @open
003D2E  2  A9 46 A0 40          PRINTMSG_MSG t_noshop
003D32  2  20 B1 33     
003D35  2  60                   RTS
003D36  2               @open:
003D36  2  4C A3 3D             JMP     shop_menu
003D39  2               
003D39  2               ;----------------------------------------------------------------
003D39  2               ; shop_adjacent - C=1 if a T_SHOP tile is at or next to the player.
003D39  2               ;----------------------------------------------------------------
003D39  2               shop_adjacent:
003D39  2               ; center
003D39  2  AD 45 41             LDA     px
003D3C  2  85 2C                STA     tgtx
003D3E  2  AD 46 41             LDA     py
003D41  2  85 2D                STA     tgty
003D43  2  20 5B 19             JSR     tileat
003D46  2  A5 2E                LDA     tgttile
003D48  2  C9 0E                CMP     #T_SHOP
003D4A  2  F0 55                BEQ     @yes
003D4C  2               ; up
003D4C  2  AD 45 41             LDA     px
003D4F  2  85 2C                STA     tgtx
003D51  2  AD 46 41             LDA     py
003D54  2  38                   SEC
003D55  2  E9 01                SBC     #1
003D57  2  85 2D                STA     tgty
003D59  2  20 5B 19             JSR     tileat
003D5C  2  A5 2E                LDA     tgttile
003D5E  2  C9 0E                CMP     #T_SHOP
003D60  2  F0 3F                BEQ     @yes
003D62  2               ; down
003D62  2  AD 46 41             LDA     py
003D65  2  18                   CLC
003D66  2  69 01                ADC     #1
003D68  2  85 2D                STA     tgty
003D6A  2  AD 45 41             LDA     px
003D6D  2  85 2C                STA     tgtx
003D6F  2  20 5B 19             JSR     tileat
003D72  2  A5 2E                LDA     tgttile
003D74  2  C9 0E                CMP     #T_SHOP
003D76  2  F0 29                BEQ     @yes
003D78  2               ; left
003D78  2  AD 46 41             LDA     py
003D7B  2  85 2D                STA     tgty
003D7D  2  AD 45 41             LDA     px
003D80  2  38                   SEC
003D81  2  E9 01                SBC     #1
003D83  2  85 2C                STA     tgtx
003D85  2  20 5B 19             JSR     tileat
003D88  2  A5 2E                LDA     tgttile
003D8A  2  C9 0E                CMP     #T_SHOP
003D8C  2  F0 13                BEQ     @yes
003D8E  2               ; right
003D8E  2  AD 45 41             LDA     px
003D91  2  18                   CLC
003D92  2  69 01                ADC     #1
003D94  2  85 2C                STA     tgtx
003D96  2  20 5B 19             JSR     tileat
003D99  2  A5 2E                LDA     tgttile
003D9B  2  C9 0E                CMP     #T_SHOP
003D9D  2  F0 02                BEQ     @yes
003D9F  2  18                   CLC
003DA0  2  60                   RTS
003DA1  2               @yes:
003DA1  2  38                   SEC
003DA2  2  60                   RTS
003DA3  2               
003DA3  2               ;----------------------------------------------------------------
003DA3  2               ; shop_menu - draw the shop menu over the message area and loop
003DA3  2               ; processing purchases until the player presses X.
003DA3  2               ;----------------------------------------------------------------
003DA3  2               shop_menu:
003DA3  2  20 EF 0D             JSR     sfx_door
003DA6  2               ; start with the greeting as the status line
003DA6  2  A9 17                LDA     #<t_greet
003DA8  2  8D 62 41             STA     shopstat
003DAB  2  A9 40                LDA     #>t_greet
003DAD  2  8D 63 41             STA     shopstat+1
003DB0  2               @redraw:
003DB0  2  20 AA 3E             JSR     shop_draw
003DB3  2               @key:
003DB3  2  20 62 35             JSR     getkey_block
003DB6  2  C9 31                CMP     #'1'
003DB8  2  F0 1A                BEQ     @heal
003DBA  2  C9 32                CMP     #'2'
003DBC  2  F0 33                BEQ     @food
003DBE  2  C9 33                CMP     #'3'
003DC0  2  F0 54                BEQ     @weapon
003DC2  2  C9 34                CMP     #'4'
003DC4  2  F0 7B                BEQ     @armor
003DC6  2  C9 58                CMP     #'X'
003DC8  2  F0 07                BEQ     @goleave
003DCA  2  C9 78                CMP     #'x'
003DCC  2  F0 03                BEQ     @goleave
003DCE  2  4C B3 3D             JMP     @key
003DD1  2               @goleave:
003DD1  2  4C 79 3E             JMP     @leave
003DD4  2               @heal:
003DD4  2  A9 0A                LDA     #PRICE_HEAL
003DD6  2  20 87 3E             JSR     spend_gold
003DD9  2  B0 03                BCS     :+
003DDB  2  4C 6C 3E             JMP     @poor
003DDE  2               :
003DDE  2  AD 48 41             LDA     pmaxhp
003DE1  2  8D 47 41             STA     phealth
003DE4  2  A9 73 8D 62          SETSTAT t_healed
003DE8  2  41 A9 40 8D  
003DEC  2  63 41        
003DEE  2  4C B0 3D             JMP     @redraw
003DF1  2               @food:
003DF1  2  A9 14                LDA     #PRICE_FOOD
003DF3  2  20 87 3E             JSR     spend_gold
003DF6  2  90 74                BCC     @poor
003DF8  2  18                   CLC
003DF9  2  AD 4E 41             LDA     pfood
003DFC  2  69 64                ADC     #100
003DFE  2  8D 4E 41             STA     pfood
003E01  2  AD 4F 41             LDA     pfood+1
003E04  2  69 00                ADC     #0
003E06  2  8D 4F 41             STA     pfood+1
003E09  2  A9 92 8D 62          SETSTAT t_fed
003E0D  2  41 A9 40 8D  
003E11  2  63 41        
003E13  2  4C B0 3D             JMP     @redraw
003E16  2               @weapon:
003E16  2  AD 50 41             LDA     pweapon
003E19  2  C9 03                CMP     #3
003E1B  2  B0 17                BCS     @maxwpn
003E1D  2  A9 3C                LDA     #PRICE_WEAPON
003E1F  2  20 87 3E             JSR     spend_gold
003E22  2  90 48                BCC     @poor
003E24  2  EE 50 41             INC     pweapon
003E27  2  A9 B1 8D 62          SETSTAT t_boughtw
003E2B  2  41 A9 40 8D  
003E2F  2  63 41        
003E31  2  4C B0 3D             JMP     @redraw
003E34  2               @maxwpn:
003E34  2  A9 EF 8D 62          SETSTAT t_maxed
003E38  2  41 A9 40 8D  
003E3C  2  63 41        
003E3E  2  4C B0 3D             JMP     @redraw
003E41  2               @armor:
003E41  2  AD 51 41             LDA     parmor
003E44  2  C9 03                CMP     #3
003E46  2  B0 17                BCS     @maxarm
003E48  2  A9 32                LDA     #PRICE_ARMOR
003E4A  2  20 87 3E             JSR     spend_gold
003E4D  2  90 1D                BCC     @poor
003E4F  2  EE 51 41             INC     parmor
003E52  2  A9 D0 8D 62          SETSTAT t_boughta
003E56  2  41 A9 40 8D  
003E5A  2  63 41        
003E5C  2  4C B0 3D             JMP     @redraw
003E5F  2               @maxarm:
003E5F  2  A9 EF 8D 62          SETSTAT t_maxed
003E63  2  41 A9 40 8D  
003E67  2  63 41        
003E69  2  4C B0 3D             JMP     @redraw
003E6C  2               @poor:
003E6C  2  A9 0E 8D 62          SETSTAT t_poor
003E70  2  41 A9 41 8D  
003E74  2  63 41        
003E76  2  4C B0 3D             JMP     @redraw
003E79  2               @leave:
003E79  2               ; fully restore the game screen, then report leaving
003E79  2  20 65 08             JSR     full_redraw
003E7C  2  20 E0 33             JSR     msg_redraw
003E7F  2  A9 2D A0 41          PRINTMSG_MSG t_bye
003E83  2  20 B1 33     
003E86  2  60                   RTS
003E87  2               
003E87  2               ;----------------------------------------------------------------
003E87  2               ; spend_gold - try to spend A gold.  C=1 success (gold deducted),
003E87  2               ;              C=0 if not enough.
003E87  2               ;----------------------------------------------------------------
003E87  2               spend_gold:
003E87  2  85 20                STA     tmp0
003E89  2               ; gold >= tmp0 ?  (16-bit gold, 8-bit cost)
003E89  2  AD 4D 41             LDA     pgold+1
003E8C  2  D0 07                BNE     @ok             ; high byte nonzero -> plenty
003E8E  2  AD 4C 41             LDA     pgold
003E91  2  C5 20                CMP     tmp0
003E93  2  90 13                BCC     @no
003E95  2               @ok:
003E95  2  38                   SEC
003E96  2  AD 4C 41             LDA     pgold
003E99  2  E5 20                SBC     tmp0
003E9B  2  8D 4C 41             STA     pgold
003E9E  2  AD 4D 41             LDA     pgold+1
003EA1  2  E9 00                SBC     #0
003EA3  2  8D 4D 41             STA     pgold+1
003EA6  2  38                   SEC
003EA7  2  60                   RTS
003EA8  2               @no:
003EA8  2  18                   CLC
003EA9  2  60                   RTS
003EAA  2               
003EAA  2               ;----------------------------------------------------------------
003EAA  2               ; Shop box geometry - a clean panel drawn inside the viewport,
003EAA  2               ; well clear of the bottom-right auto-scroll cell.
003EAA  2               ;----------------------------------------------------------------
003EAA  2               SHOP_X0         = 3             ; left column of box
003EAA  2               SHOP_X1         = 42            ; right column of box
003EAA  2               SHOP_Y0         = 4             ; top row of box
003EAA  2               SHOP_Y1         = 15            ; bottom row of box
003EAA  2               SHOP_W          = SHOP_X1-SHOP_X0+1
003EAA  2               
003EAA  2               ;----------------------------------------------------------------
003EAA  2               ; shop_draw - render the shop as a self-contained bordered panel.
003EAA  2               ; The whole box is repainted each call (background + border via
003EAA  2               ; direct VRAM, then text via firmware) so it is always clean.
003EAA  2               ;----------------------------------------------------------------
003EAA  2               shop_draw:
003EAA  2               ; --- paint box background + border directly to VRAM ---
003EAA  2  20 66 30             JSR     vid_enter
003EAD  2  A9 04                LDA     #SHOP_Y0
003EAF  2  85 27                STA     rowidx
003EB1  2               @bgrow:
003EB1  2  A5 27                LDA     rowidx
003EB3  2  20 7B 30             JSR     rowbase
003EB6  2  A0 03                LDY     #SHOP_X0
003EB8  2               @bgcol:
003EB8  2               ; border on edges, blank interior
003EB8  2  C0 03                CPY     #SHOP_X0
003EBA  2  F0 19                BEQ     @edge
003EBC  2  C0 2A                CPY     #SHOP_X1
003EBE  2  F0 15                BEQ     @edge
003EC0  2  A5 27                LDA     rowidx
003EC2  2  C9 04                CMP     #SHOP_Y0
003EC4  2  F0 0F                BEQ     @edge
003EC6  2  C9 0F                CMP     #SHOP_Y1
003EC8  2  F0 0B                BEQ     @edge
003ECA  2               ; interior cell
003ECA  2  A9 20                LDA     #space
003ECC  2  91 14                STA     (vptr),Y
003ECE  2  A9 4F                LDA     #C_SHOPBG
003ED0  2  91 16                STA     (cptr),Y
003ED2  2  4C DD 3E             JMP     @bgnext
003ED5  2               @edge:
003ED5  2  A9 20                LDA     #' '
003ED7  2  91 14                STA     (vptr),Y
003ED9  2  A9 4E                LDA     #C_SHOPBRD
003EDB  2  91 16                STA     (cptr),Y
003EDD  2               @bgnext:
003EDD  2  C8                   INY
003EDE  2  C0 2B                CPY     #SHOP_X1+1
003EE0  2  D0 D6                BNE     @bgcol
003EE2  2  E6 27                INC     rowidx
003EE4  2  A5 27                LDA     rowidx
003EE6  2  C9 10                CMP     #SHOP_Y1+1
003EE8  2  D0 C7                BNE     @bgrow
003EEA  2  20 75 30             JSR     vid_exit
003EED  2               
003EED  2               ; --- text lines via firmware (interior color C_SHOPBG) ---
003EED  2  A9 4B                LDA     #C_SHOPTTL
003EEF  2  8D 4A 06             STA     CURCOLOR
003EF2  2  A2 0B                LDX     #SHOP_X0+8
003EF4  2  A0 04                LDY     #SHOP_Y0
003EF6  2  20 B4 31             JSR     locate
003EF9  2  A9 81 A0 3F          PRINTMSG t_header
003EFD  2  20 C6 31     
003F00  2               
003F00  2  A9 4F                LDA     #C_SHOPTXT
003F02  2  8D 4A 06             STA     CURCOLOR
003F05  2  A2 06                LDX     #SHOP_X0+3
003F07  2  A0 06                LDY     #SHOP_Y0+2
003F09  2  20 B4 31             JSR     locate
003F0C  2  A9 8A A0 3F          PRINTMSG t_opt1
003F10  2  20 C6 31     
003F13  2  A2 06                LDX     #SHOP_X0+3
003F15  2  A0 07                LDY     #SHOP_Y0+3
003F17  2  20 B4 31             JSR     locate
003F1A  2  A9 A6 A0 3F          PRINTMSG t_opt2
003F1E  2  20 C6 31     
003F21  2  A2 06                LDX     #SHOP_X0+3
003F23  2  A0 08                LDY     #SHOP_Y0+4
003F25  2  20 B4 31             JSR     locate
003F28  2  A9 C2 A0 3F          PRINTMSG t_opt3
003F2C  2  20 C6 31     
003F2F  2  A2 06                LDX     #SHOP_X0+3
003F31  2  A0 09                LDY     #SHOP_Y0+5
003F33  2  20 B4 31             JSR     locate
003F36  2  A9 DE A0 3F          PRINTMSG t_opt4
003F3A  2  20 C6 31     
003F3D  2  A2 06                LDX     #SHOP_X0+3
003F3F  2  A0 0A                LDY     #SHOP_Y0+6
003F41  2  20 B4 31             JSR     locate
003F44  2  A9 FA A0 3F          PRINTMSG t_optx
003F48  2  20 C6 31     
003F4B  2               
003F4B  2               ; gold line
003F4B  2  A2 06                LDX     #SHOP_X0+3
003F4D  2  A0 0C                LDY     #SHOP_Y0+8
003F4F  2  20 B4 31             JSR     locate
003F52  2  A9 4F                LDA     #C_SHOPTXT
003F54  2  8D 4A 06             STA     CURCOLOR
003F57  2  A9 0C A0 40          PRINTMSG t_gold
003F5B  2  20 C6 31     
003F5E  2  AD 4C 41 85          COPY16  pgold, numarg
003F62  2  1E AD 4D 41  
003F66  2  85 1F        
003F68  2  20 55 33             JSR     displaynum
003F6B  2               
003F6B  2               ; status line (last action / greeting)
003F6B  2  A2 06                LDX     #SHOP_X0+3
003F6D  2  A0 0E                LDY     #SHOP_Y1-1
003F6F  2  20 B4 31             JSR     locate
003F72  2  A9 4A                LDA     #C_SHOPST
003F74  2  8D 4A 06             STA     CURCOLOR
003F77  2  AD 62 41             LDA     shopstat
003F7A  2  AC 63 41             LDY     shopstat+1
003F7D  2  20 C6 31             JSR     prmsg
003F80  2  60                   RTS
003F81  2               
