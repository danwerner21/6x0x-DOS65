006001  2               enter_shrine:
006001  2  20 AF 0F             JSR     sfx_door
006004  2  20 94 1B             JSR     decode_shrine
006007  2  A9 04                LDA     #LOC_SHRINE
006009  2  8D 19 62             STA     loc
00600C  2  A9 20                LDA     #SHRINEW
