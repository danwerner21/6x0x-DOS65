00400D  2  20 ED 3B     
004010  2               @status_done:
004010  2  20 14 40             JSR     pad_clear
004013  2  60                   RTS
004014  2               
004014  2               ; pad_clear - print spaces out to the right screen edge to erase
004014  2               ;             any leftover characters from a previous longer value.
004014  2               ;             Stops at the last column to avoid auto-scroll.
004014  2               pad_clear:
004014  2               @pc:
004014  2  AD 47 06             LDA     CURX
004017  2  C9 4F                CMP     #SCRW-1
004019  2  B0 08                BCS     @done
00401B  2  A9 20                LDA     #space
00401D  2  20 E3 3B             JSR     putc
004020  2  4C 14 40             JMP     @pc
004023  2               @done:
004023  2  60                   RTS
004024  2               
004024  2               ;----------------------------------------------------------------
004024  2               ; name_weapon / name_armor / name_loc - set strp to a name string
004024  2               ;   IN: A = index
004024  2               ;----------------------------------------------------------------
004024  2               name_weapon:
004024  2  0A                   ASL     A
004025  2  AA                   TAX
004026  2  BD 3A 42             LDA     wpn_names,X
004029  2  85 1C                STA     strp
00402B  2  BD 3B 42             LDA     wpn_names+1,X
00402E  2  85 1D                STA     strp+1
004030  2  60                   RTS
004031  2               name_armor:
004031  2  0A                   ASL     A
004032  2  AA                   TAX
004033  2  BD 59 42             LDA     arm_names,X
004036  2  85 1C                STA     strp
004038  2  BD 5A 42             LDA     arm_names+1,X
00403B  2  85 1D                STA     strp+1
00403D  2  60                   RTS
00403E  2               name_loc:
00403E  2  C9 00                CMP     #LOC_WORLD
004040  2  D0 13                BNE     @not_world
004042  2  AD 0D 62             LDA     py
004045  2  20 B3 1B             JSR     region_from_y
004048  2  0A                   ASL     A
004049  2  AA                   TAX
00404A  2  BD BB 42             LDA     region_names,X
00404D  2  85 1C                STA     strp
00404F  2  BD BC 42             LDA     region_names+1,X
004052  2  85 1D                STA     strp+1
004054  2  60                   RTS
004055  2               @not_world:
004055  2  C9 01                CMP     #LOC_TOWN
004057  2  D0 10                BNE     @interior
004059  2  AD 1A 62             LDA     town_id
00405C  2  0A                   ASL     A
00405D  2  AA                   TAX
00405E  2  BD E7 42             LDA     town_names,X
004061  2  85 1C                STA     strp
004063  2  BD E8 42             LDA     town_names+1,X
004066  2  85 1D                STA     strp+1
004068  2  60                   RTS
004069  2               @interior:
004069  2  0A                   ASL     A
00406A  2  AA                   TAX
00406B  2  BD 7D 42             LDA     loc_names,X
00406E  2  85 1C                STA     strp
004070  2  BD 7E 42             LDA     loc_names+1,X
004073  2  85 1D                STA     strp+1
004075  2  60                   RTS
004076  2               name_objective:
004076  2  0A                   ASL     A
004077  2  AA                   TAX
004078  2  BD FE 42             LDA     objective_names,X
00407B  2  85 1C                STA     strp
00407D  2  BD FF 42             LDA     objective_names+1,X
004080  2  85 1D                STA     strp+1
004082  2  60                   RTS
