004CEF  2               ;----------------------------------------------------------------
004CEF  2               ; collect_treasure - pick up a chest at (tgtx,tgty): gold + maybe
004CEF  2               ; XP, then clear the tile to floor.
004CEF  2               ;----------------------------------------------------------------
004CEF  2               collect_treasure:
004CEF  2               ; gold 5..20
004CEF  2  A9 10                LDA     #16
004CF1  2  20 F8 0C             JSR     rng_d
004CF4  2  18                   CLC
004CF5  2  69 04                ADC     #4
004CF7  2               ; add to gold (16-bit)
004CF7  2  18                   CLC
004CF8  2  6D 13 62             ADC     pgold
004CFB  2  8D 13 62             STA     pgold
004CFE  2  AD 14 62             LDA     pgold+1
004D01  2  69 00                ADC     #0
004D03  2  8D 14 62             STA     pgold+1
004D06  2               ; clear the chest tile -> floor
004D06  2  A9 09                LDA     #T_FLOOR
004D08  2  20 6B 1C             JSR     settile
004D0B  2  20 41 0F             JSR     sfx_treasure
004D0E  2  A9 BE A0 52          PRINTMSG_MSG m_treasure
004D12  2  20 F9 3D     
004D15  2  60                   RTS
004D16  2               
004D16  2               ;----------------------------------------------------------------
004D16  2               ; enter_town - switch to the town interior map.
004D16  2               ;----------------------------------------------------------------
004D16  2               enter_town:
004D16  2               ; identify the landmark before effects or map decoding use scratch state
004D16  2  A9 00                LDA     #TOWN_EASTMERE
004D18  2  A6 2D                LDX     tgty
004D1A  2  E0 27                CPX     #VALEHAVEN_Y
004D1C  2  D0 02                BNE     @town_selected
004D1E  2  A9 01                LDA     #TOWN_VALEHAVEN
004D20  2               @town_selected:
004D20  2  8D 1A 62             STA     town_id
004D23  2  20 AF 0F             JSR     sfx_door
004D26  2  20 25 1B             JSR     decode_town
004D29  2  A9 01                LDA     #LOC_TOWN
004D2B  2  8D 19 62             STA     loc
004D2E  2  A9 20                LDA     #TOWNW
004D30  2  8D 1C 62             STA     locw
004D33  2  A9 14                LDA     #TOWNH
004D35  2  8D 1D 62             STA     loch
004D38  2               ; remember overworld position to restore on exit
004D38  2  AD 0C 62             LDA     px
004D3B  2  8D 1E 62             STA     owretx
004D3E  2  AD 0D 62             LDA     py
004D41  2  8D 1F 62             STA     owrety
004D44  2               ; place player just inside, one tile NORTH of the door so the
004D44  2               ; exit '+' is visible directly south of the player on entry.
004D44  2  A9 0E                LDA     #14
004D46  2  8D 0C 62             STA     px
004D49  2  A9 11                LDA     #TOWNH-3
004D4B  2  8D 0D 62             STA     py
004D4E  2               ; towns have no monsters
004D4E  2  20 B9 44             JSR     mon_clear_all
004D51  2  A9 01                LDA     #1
004D53  2  8D 27 62             STA     did_move
004D56  2  AD 1A 62             LDA     town_id
004D59  2  F0 08                BEQ     @eastmere_msg
004D5B  2  A9 14 A0 53          PRINTMSG_MSG m_valehaven
004D5F  2  20 F9 3D     
004D62  2  60                   RTS
004D63  2               @eastmere_msg:
004D63  2  A9 D9 A0 52          PRINTMSG_MSG m_eastmere
004D67  2  20 F9 3D     
004D6A  2  60                   RTS
004D6B  2               
004D6B  2               ;----------------------------------------------------------------
004D6B  2               ; enter_castle - switch to Wyrmhold Castle's audience chamber.
004D6B  2               ;----------------------------------------------------------------
004D6B  2               enter_castle:
004D6B  2  20 AF 0F             JSR     sfx_door
004D6E  2  20 75 1B             JSR     decode_castle
004D71  2  A9 03                LDA     #LOC_CASTLE
004D73  2  8D 19 62             STA     loc
004D76  2  A9 20                LDA     #CASTLEW
004D78  2  8D 1C 62             STA     locw
004D7B  2  A9 14                LDA     #CASTLEH
004D7D  2  8D 1D 62             STA     loch
004D80  2  AD 0C 62             LDA     px
004D83  2  8D 1E 62             STA     owretx
004D86  2  AD 0D 62             LDA     py
004D89  2  8D 1F 62             STA     owrety
004D8C  2               ; enter on the carpet, immediately north of the exit
004D8C  2  A9 0F                LDA     #15
004D8E  2  8D 0C 62             STA     px
004D91  2  A9 11                LDA     #CASTLEH-3
004D93  2  8D 0D 62             STA     py
004D96  2  20 B9 44             JSR     mon_clear_all
004D99  2  A9 01                LDA     #1
004D9B  2  8D 27 62             STA     did_move
004D9E  2  A9 94 A0 5D          PRINTMSG_MSG m_castle
004DA2  2  20 F9 3D     
004DA5  2  60                   RTS
004DA6  2               
004DA6  2               ;----------------------------------------------------------------
004DA6  2               ; enter_dungeon - dispatch cave landmarks. The southern-marsh cave
004DA6  2               ; is the Sunken Shrine; the dragon's lair stays sealed until the
004DA6  2               ; Wyrm Key has been returned to King Aldren.
004DA6  2               ;----------------------------------------------------------------
004DA6  2               enter_dungeon:
004DA6  2  A5 2C                LDA     tgtx
004DA8  2  C9 14                CMP     #KEY_SITE_X
004DAA  2  D0 1B                BNE     @dragon
004DAC  2  A5 2D                LDA     tgty
004DAE  2  C9 3A                CMP     #KEY_SITE_Y
004DB0  2  D0 15                BNE     @dragon
004DB2  2  AD 21 62             LDA     queststate
004DB5  2  C9 01                CMP     #QUEST_FIND_KEY
004DB7  2  90 03                BCC     @shrine_dormant
004DB9  2  4C 01 60             JMP     enter_shrine
004DBC  2               @shrine_dormant:
004DBC  2  20 00 0E             JSR     sfx_blocked
004DBF  2  A9 70 A0 60          PRINTMSG_MSG m_shrine_dormant
004DC3  2  20 F9 3D     
004DC6  2  60                   RTS
004DC7  2               @dragon:
004DC7  2  AD 21 62             LDA     queststate
004DCA  2  C9 03                CMP     #QUEST_DUNG_OPEN
004DCC  2  B0 0B                BCS     @enter
004DCE  2  20 00 0E             JSR     sfx_blocked
004DD1  2  A9 B6 A0 60          PRINTMSG_MSG m_dung_sealed
004DD5  2  20 F9 3D     
004DD8  2  60                   RTS
004DD9  2               @enter:
004DD9  2  20 AF 0F             JSR     sfx_door
004DDC  2  20 56 1B             JSR     decode_dung
004DDF  2  A9 02                LDA     #LOC_DUNG
004DE1  2  8D 19 62             STA     loc
004DE4  2  A9 20                LDA     #DUNGW
004DE6  2  8D 1C 62             STA     locw
004DE9  2  A9 14                LDA     #DUNGH
004DEB  2  8D 1D 62             STA     loch
004DEE  2  AD 0C 62             LDA     px
004DF1  2  8D 1E 62             STA     owretx
004DF4  2  AD 0D 62             LDA     py
004DF7  2  8D 1F 62             STA     owrety
004DFA  2               ; start just east of the stairs-up '<' (at 1,1) so the exit
004DFA  2               ; is visible immediately to the west of the player.
004DFA  2  A9 02                LDA     #2
004DFC  2  8D 0C 62             STA     px
004DFF  2  A9 01                LDA     #1
004E01  2  8D 0D 62             STA     py
004E04  2  20 37 46             JSR     spawn_dungeon_monsters
004E07  2  A9 01                LDA     #1
004E09  2  8D 27 62             STA     did_move
004E0C  2  AD 21 62             LDA     queststate
004E0F  2  C9 04                CMP     #QUEST_DRAGON_DEAD
004E11  2  B0 0F                BCS     @silent_lair
004E13  2  A9 4F A0 53          PRINTMSG_MSG m_dungeon
004E17  2  20 F9 3D     
004E1A  2  A9 8C A0 53          PRINTMSG_MSG m_dragon_wakes
004E1E  2  20 F9 3D     
004E21  2  60                   RTS
004E22  2               @silent_lair:
004E22  2  A9 BC A0 53          PRINTMSG_MSG m_dungeon_empty
004E26  2  20 F9 3D     
004E29  2  60                   RTS
004E2A  2               
004E2A  2               ;----------------------------------------------------------------
004E2A  2               ; leave_interior - return to the overworld at the saved position.
004E2A  2               ;----------------------------------------------------------------
004E2A  2               leave_interior:
004E2A  2  20 AF 0F             JSR     sfx_door
004E2D  2  A9 00                LDA     #BREATH_NONE
004E2F  2  8D 22 62             STA     boss_breath_dir
004E32  2  20 06 1B             JSR     decode_world
004E35  2  A9 00                LDA     #LOC_WORLD
004E37  2  8D 19 62             STA     loc
004E3A  2  AD 1E 62             LDA     owretx
004E3D  2  8D 0C 62             STA     px
004E40  2  AD 1F 62             LDA     owrety
004E43  2  8D 0D 62             STA     py
004E46  2  20 4E 45             JSR     restore_overworld_monsters
004E49  2  A9 01                LDA     #1
004E4B  2  8D 27 62             STA     did_move
004E4E  2  A9 F8 A0 53          PRINTMSG_MSG m_world
004E52  2  20 F9 3D     
004E55  2  60                   RTS
004E56  2               
004E56  1                       .INCLUDE "combat.asm"
004E56  2               ;______________________________________________________________________________
004E56  2               ;  combat.asm - bump combat resolution, leveling, message builder
004E56  2               ;______________________________________________________________________________
004E56  2               
004E56  2               ;----------------------------------------------------------------
004E56  2               ; Message builder.  Compose a line in mbuf then push to the log.
004E56  2               ;   mb_reset            - start a new line
004E56  2               ;   mb_str  (A=lo,Y=hi) - append a 0-terminated string
004E56  2               ;   mb_num  (A=byte)    - append a 0..255 value in decimal
004E56  2               ;   mb_mname(A=type)    - append a monster type name
004E56  2               ;   mb_flush            - push mbuf into the scrolling log
004E56  2               ;----------------------------------------------------------------
004E56  2               mb_reset:
004E56  2  A9 00                LDA     #0
004E58  2  8D 38 63             STA     mblen
004E5B  2  60                   RTS
004E5C  2               
004E5C  2               mb_str:
004E5C  2  85 1C                STA     strp
004E5E  2  84 1D                STY     strp+1
004E60  2  A0 00                LDY     #0
004E62  2               @s:
004E62  2  B1 1C                LDA     (strp),Y
004E64  2  F0 0C                BEQ     @done
004E66  2  AE 38 63             LDX     mblen
004E69  2  9D D8 62             STA     mbuf,X
004E6C  2  EE 38 63             INC     mblen
004E6F  2  C8                   INY
004E70  2  D0 F0                BNE     @s
004E72  2               @done:
004E72  2  60                   RTS
004E73  2               
004E73  2               ; append A (0..255) as decimal
004E73  2               mb_num:
004E73  2  85 1E                STA     numarg
004E75  2  A9 00                LDA     #0
004E77  2  85 1F                STA     numarg+1
004E79  2               mb_num16:
004E79  2               ; find highest place
004E79  2  A0 08                LDY     #8
004E7B  2               @find:
004E7B  2  A5 1F                LDA     numarg+1
004E7D  2  D9 E7 3D             CMP     nums+1,Y
004E80  2  90 09                BCC     @nx
004E82  2  D0 0B                BNE     @start
004E84  2  A5 1E                LDA     numarg
004E86  2  D9 E6 3D             CMP     nums,Y
004E89  2  B0 04                BCS     @start
004E8B  2               @nx:
004E8B  2  88                   DEY
004E8C  2  88                   DEY
004E8D  2  D0 EC                BNE     @find
004E8F  2               @start:
004E8F  2  A9 30                LDA     #'0'
004E91  2  85 28                STA     numspace
004E93  2               @dig:
004E93  2  A5 1F                LDA     numarg+1
004E95  2  D9 E7 3D             CMP     nums+1,Y
004E98  2  90 1E                BCC     @out
004E9A  2  D0 09                BNE     @noc
004E9C  2  A5 1E                LDA     numarg
004E9E  2  F9 E6 3D             SBC     nums,Y
004EA1  2  90 15                BCC     @out
004EA3  2  B0 05                BCS     @sub
004EA5  2               @noc:
004EA5  2  A5 1E                LDA     numarg
004EA7  2  F9 E6 3D             SBC     nums,Y
004EAA  2               @sub:
004EAA  2  E6 28                INC     numspace
004EAC  2  85 1E                STA     numarg
004EAE  2  A5 1F                LDA     numarg+1
004EB0  2  F9 E7 3D             SBC     nums+1,Y
004EB3  2  85 1F                STA     numarg+1
004EB5  2  4C 93 4E             JMP     @dig
004EB8  2               @out:
004EB8  2  A5 28                LDA     numspace
004EBA  2  AE 38 63             LDX     mblen
004EBD  2  9D D8 62             STA     mbuf,X
004EC0  2  EE 38 63             INC     mblen
004EC3  2  88                   DEY
004EC4  2  88                   DEY
004EC5  2  10 C8                BPL     @start
004EC7  2  60                   RTS
004EC8  2               
004EC8  2               ; append a monster type name (A = type id)
004EC8  2               mb_mname:
004EC8  2  0A                   ASL     A
004EC9  2  AA                   TAX
004ECA  2  BD ED 51             LDA     mon_names,X
004ECD  2  BC EE 51             LDY     mon_names+1,X
004ED0  2  4C 5C 4E             JMP     mb_str
004ED3  2               
004ED3  2               mb_flush:
004ED3  2  AE 38 63             LDX     mblen
004ED6  2  A9 00                LDA     #0
004ED8  2  9D D8 62             STA     mbuf,X          ; NUL terminate
004EDB  2  A9 D8                LDA     #<mbuf
004EDD  2  A0 62                LDY     #>mbuf
004EDF  2  4C F9 3D             JMP     msg_print
004EE2  2               
004EE2  2               ;----------------------------------------------------------------
004EE2  2               ; player_attacks_monster - X = monster slot.
004EE2  2               ;   Fists are weak, daggers can critically strike, swords are
004EE2  2               ;   reliable, and axes have the widest damage range.
004EE2  2               ;----------------------------------------------------------------
004EE2  2               player_attacks_monster:
004EE2  2  86 2F                STX     monidx
004EE4  2  A9 00                LDA     #0
004EE6  2  8D 26 62             STA     attack_flags
004EE9  2  AE 17 62             LDX     pweapon
004EEC  2  E0 01                CPX     #1
004EEE  2  F0 10                BEQ     @dagger
004EF0  2  E0 02                CPX     #2
004EF2  2  F0 2E                BEQ     @sword
004EF4  2  E0 03                CPX     #3
004EF6  2  F0 35                BEQ     @axe
004EF8  2               ; fists: 1..2
004EF8  2  A9 02                LDA     #2
004EFA  2  20 F8 0C             JSR     rng_d
004EFD  2  4C 32 4F             JMP     @rolled
004F00  2               @dagger:
004F00  2               ; dagger: 1..4, with a one-in-four critical strike for +4
004F00  2  A9 04                LDA     #4
004F02  2  20 F8 0C             JSR     rng_d
004F05  2  85 20                STA     tmp0
004F07  2  A9 04                LDA     #4
004F09  2  20 F8 0C             JSR     rng_d
004F0C  2  C9 01                CMP     #1
004F0E  2  D0 0D                BNE     @dagger_normal
004F10  2  A9 01                LDA     #ATTACK_CRITICAL
004F12  2  8D 26 62             STA     attack_flags
004F15  2  A5 20                LDA     tmp0
004F17  2  18                   CLC
004F18  2  69 04                ADC     #4
004F1A  2  4C 32 4F             JMP     @rolled
004F1D  2               @dagger_normal:
004F1D  2  A5 20                LDA     tmp0
004F1F  2  4C 32 4F             JMP     @rolled
004F22  2               @sword:
004F22  2               ; sword: reliable 4..7
004F22  2  A9 04                LDA     #4
004F24  2  20 F8 0C             JSR     rng_d
004F27  2  18                   CLC
004F28  2  69 03                ADC     #3
004F2A  2  4C 32 4F             JMP     @rolled
004F2D  2               @axe:
004F2D  2               ; axe: volatile 1..12
004F2D  2  A9 0C                LDA     #12
004F2F  2  20 F8 0C             JSR     rng_d
004F32  2               @rolled:
004F32  2  85 24                STA     cnt0            ; preserve damage while checking terrain
004F34  2  AD 19 62             LDA     loc
004F37  2  D0 22                BNE     @damage_ready
004F39  2  AD 0C 62             LDA     px
004F3C  2  85 2C                STA     tgtx
004F3E  2  AD 0D 62             LDA     py
004F41  2  85 2D                STA     tgty
004F43  2  20 C4 1B             JSR     tileat
004F46  2  A5 2E                LDA     tgttile
004F48  2  C9 0F                CMP     #T_HILLS
004F4A  2  D0 0F                BNE     @damage_ready
004F4C  2  18                   CLC
004F4D  2  A5 24                LDA     cnt0
004F4F  2  69 02                ADC     #2
004F51  2  85 24                STA     cnt0
004F53  2  AD 26 62             LDA     attack_flags
004F56  2  09 02                ORA     #ATTACK_HIGH
004F58  2  8D 26 62             STA     attack_flags
004F5B  2               @damage_ready:
004F5B  2  A5 24                LDA     cnt0
004F5D  2  85 20                STA     tmp0            ; final damage
004F5F  2               ; subtract from monster hp
004F5F  2  A6 2F                LDX     monidx
004F61  2  38                   SEC
004F62  2  BD 5D 63             LDA     mon_hp,X
004F65  2  E5 20                SBC     tmp0
004F67  2  9D 5D 63             STA     mon_hp,X
004F6A  2               ; build "You hit the Orc for N!"
004F6A  2  20 56 4E             JSR     mb_reset
004F6D  2  A9 35                LDA     #<c_youhit
004F6F  2  A0 52                LDY     #>c_youhit
004F71  2  20 5C 4E             JSR     mb_str
004F74  2  A6 2F                LDX     monidx
004F76  2  BD 39 63             LDA     mon_type,X
004F79  2  20 C8 4E             JSR     mb_mname
004F7C  2  A9 42                LDA     #<c_for
004F7E  2  A0 52                LDY     #>c_for
004F80  2  20 5C 4E             JSR     mb_str
004F83  2  A5 20                LDA     tmp0
004F85  2  20 73 4E             JSR     mb_num
004F88  2  A9 48                LDA     #<c_bang
004F8A  2  A0 52                LDY     #>c_bang
004F8C  2  20 5C 4E             JSR     mb_str
004F8F  2  20 D3 4E             JSR     mb_flush
004F92  2  AD 26 62             LDA     attack_flags
004F95  2  29 01                AND     #ATTACK_CRITICAL
004F97  2  F0 0D                BEQ     @normal_hit
004F99  2  20 79 0E             JSR     sfx_critical
004F9C  2  A9 AE A0 55          PRINTMSG_MSG m_critical
004FA0  2  20 F9 3D     
004FA3  2  4C A9 4F             JMP     @terrain_feedback
004FA6  2               @normal_hit:
004FA6  2  20 1D 0E             JSR     sfx_hit
004FA9  2               @terrain_feedback:
004FA9  2  AD 26 62             LDA     attack_flags
004FAC  2  29 02                AND     #ATTACK_HIGH
004FAE  2  F0 07                BEQ     @deadcheck
004FB0  2  A9 BF A0 55          PRINTMSG_MSG m_high_ground
004FB4  2  20 F9 3D     
004FB7  2               @deadcheck:
004FB7  2               ; dead?  (hp <= 0 i.e. hp was <= damage -> result negative/zero)
004FB7  2  A6 2F                LDX     monidx
004FB9  2  BD 5D 63             LDA     mon_hp,X
004FBC  2  F0 03                BEQ     @dead
004FBE  2  30 01                BMI     @dead
004FC0  2  60                   RTS
004FC1  2               @dead:
004FC1  2  4C C4 4F             JMP     monster_dies
004FC4  2               
004FC4  2               ;----------------------------------------------------------------
004FC4  2               ; monster_dies - award XP/gold, drop the slot, maybe win, maybe
004FC4  2               ; level up.  Slot in monidx.
004FC4  2               ;----------------------------------------------------------------
004FC4  2               monster_dies:
004FC4  2  A6 2F                LDX     monidx
004FC6  2  BD 39 63             LDA     mon_type,X
004FC9  2  85 21                STA     tmp1            ; type
004FCB  2               ; XP
004FCB  2  A8                   TAY
004FCC  2  B9 79 44             LDA     mtype_xp,Y
004FCF  2  18                   CLC
004FD0  2  6D 11 62             ADC     pxp
004FD3  2  8D 11 62             STA     pxp
004FD6  2  AD 12 62             LDA     pxp+1
004FD9  2  69 00                ADC     #0
004FDB  2  8D 12 62             STA     pxp+1
004FDE  2               ; gold drop 0..mtype_gold
004FDE  2  A4 21                LDY     tmp1
004FE0  2  B9 81 44             LDA     mtype_gold,Y
004FE3  2  F0 12                BEQ     @nogold
004FE5  2  20 E8 0C             JSR     rng_mod         ; 0..gold-1
004FE8  2  18                   CLC
004FE9  2  6D 13 62             ADC     pgold
004FEC  2  8D 13 62             STA     pgold
004FEF  2  AD 14 62             LDA     pgold+1
004FF2  2  69 00                ADC     #0
004FF4  2  8D 14 62             STA     pgold+1
004FF7  2               @nogold:
004FF7  2               ; message "The Orc dies!"
004FF7  2  20 56 4E             JSR     mb_reset
004FFA  2  A9 4A                LDA     #<c_the
004FFC  2  A0 52                LDY     #>c_the
004FFE  2  20 5C 4E             JSR     mb_str
005001  2  A5 21                LDA     tmp1
005003  2  20 C8 4E             JSR     mb_mname
005006  2  A9 4F                LDA     #<c_dies
005008  2  A0 52                LDY     #>c_dies
00500A  2  20 5C 4E             JSR     mb_str
00500D  2  20 D3 4E             JSR     mb_flush
005010  2  20 24 0F             JSR     sfx_killed
005013  2               ; remove monster
005013  2  A6 2F                LDX     monidx
005015  2  20 1F 45             JSR     mon_kill
005018  2               ; quest miniboss?
005018  2  A5 21                LDA     tmp1
00501A  2  C9 07                CMP     #M_WARDEN
00501C  2  D0 06                BNE     @boss
00501E  2  20 52 60             JSR     award_wyrm_key
005021  2  4C 3B 50             JMP     @lvl
005024  2               ; final boss?
005024  2               @boss:
005024  2  A5 21                LDA     tmp1
005026  2  C9 06                CMP     #M_BOSS
005028  2  D0 11                BNE     @lvl
00502A  2  A9 00                LDA     #BREATH_NONE
00502C  2  8D 22 62             STA     boss_breath_dir
00502F  2  A9 04                LDA     #QUEST_DRAGON_DEAD
005031  2  8D 21 62             STA     queststate
005034  2  A9 1C A0 54          PRINTMSG_MSG m_dragon_fallen
005038  2  20 F9 3D     
00503B  2               @lvl:
00503B  2  20 3F 50             JSR     check_levelup
00503E  2  60                   RTS
00503F  2               
00503F  2               ;----------------------------------------------------------------
00503F  2               ; check_levelup - if xp >= level*20, level up (raise maxhp, heal).
00503F  2               ;----------------------------------------------------------------
00503F  2               check_levelup:
00503F  2               ; threshold = plevel * 20  (8-bit is enough up to lvl 12)
00503F  2  AD 10 62             LDA     plevel
005042  2  85 20                STA     tmp0
005044  2  A9 00                LDA     #0
005046  2  85 21                STA     tmp1
005048  2               ; tmp = level*20 = level*16 + level*4
005048  2  AD 10 62             LDA     plevel
00504B  2  0A                   ASL     A
00504C  2  0A                   ASL     A               ; *4
00504D  2  85 22                STA     tmp2
00504F  2  AD 10 62             LDA     plevel
005052  2  0A                   ASL     A
005053  2  0A                   ASL     A
005054  2  0A                   ASL     A
005055  2  0A                   ASL     A               ; *16
005056  2  18                   CLC
005057  2  65 22                ADC     tmp2
005059  2  85 22                STA     tmp2            ; level*20 (low); ignore >255 (caps fine)
00505B  2               ; compare xp (16-bit) >= tmp2
00505B  2  AD 12 62             LDA     pxp+1
00505E  2  D0 07                BNE     @levelup        ; xp >= 256 definitely past early thresholds
005060  2  AD 11 62             LDA     pxp
005063  2  C5 22                CMP     tmp2
005065  2  90 31                BCC     @done
005067  2               @levelup:
005067  2  EE 10 62             INC     plevel
00506A  2               ; maxhp += 8, full heal
00506A  2  AD 0F 62             LDA     pmaxhp
00506D  2  18                   CLC
00506E  2  69 08                ADC     #8
005070  2  8D 0F 62             STA     pmaxhp
005073  2  8D 0E 62             STA     phealth
005076  2  A9 00                LDA     #0
005078  2  8D 23 62             STA     poison_turns
00507B  2  20 78 0F             JSR     sfx_levelup
00507E  2  20 56 4E             JSR     mb_reset
005081  2  A9 A3                LDA     #<c_levelup
005083  2  A0 52                LDY     #>c_levelup
005085  2  20 5C 4E             JSR     mb_str
005088  2  AD 10 62             LDA     plevel
00508B  2  20 73 4E             JSR     mb_num
00508E  2  A9 48                LDA     #<c_bang
005090  2  A0 52                LDY     #>c_bang
005092  2  20 5C 4E             JSR     mb_str
005095  2  20 D3 4E             JSR     mb_flush
005098  2               @done:
005098  2  60                   RTS
005099  2               
005099  2               ;----------------------------------------------------------------
005099  2               ; monster_attacks_player - monster in slot monidx strikes.
005099  2               ;   Damage = 1..mtype_atk, reduced by armor.  Apply to phealth.
005099  2               ;----------------------------------------------------------------
005099  2               monster_attacks_player:
005099  2  A6 2F                LDX     monidx
00509B  2  BD 39 63             LDA     mon_type,X
00509E  2  85 21                STA     tmp1            ; type
0050A0  2  A8                   TAY
0050A1  2  B9 71 44             LDA     mtype_atk,Y
0050A4  2  20 F8 0C             JSR     rng_d           ; 1..atk
0050A7  2  85 20                STA     tmp0            ; raw damage
0050A9  2               ; armor reduces by armor index (0..3)
0050A9  2  AE 18 62             LDX     parmor
0050AC  2  BD E9 51             LDA     arm_def,X
0050AF  2  85 22                STA     tmp2
0050B1  2  38                   SEC
0050B2  2  A5 20                LDA     tmp0
0050B4  2  E5 22                SBC     tmp2
0050B6  2  10 02                BPL     @ok
0050B8  2  A9 01                LDA     #1              ; minimum 1 damage
0050BA  2               @ok:
0050BA  2  D0 02                BNE     @guard
0050BC  2  A9 01                LDA     #1
0050BE  2               @guard:
0050BE  2  AE 25 62             LDX     guard_active
0050C1  2  F0 0B                BEQ     @apply
0050C3  2  38                   SEC
0050C4  2  E9 02                SBC     #2
0050C6  2  10 02                BPL     :+
0050C8  2  A9 01                LDA     #1
0050CA  2               :
0050CA  2  D0 02                BNE     @apply
0050CC  2  A9 01                LDA     #1
0050CE  2               @apply:
0050CE  2  85 20                STA     tmp0
0050D0  2               ; subtract from phealth (floor at 0)
0050D0  2  38                   SEC
0050D1  2  AD 0E 62             LDA     phealth
0050D4  2  E5 20                SBC     tmp0
0050D6  2  B0 02                BCS     @sethp
0050D8  2  A9 00                LDA     #0
0050DA  2               @sethp:
0050DA  2  8D 0E 62             STA     phealth
0050DD  2               ; message "Orc hits you for N!"
0050DD  2  20 56 4E             JSR     mb_reset
0050E0  2  A9 4A                LDA     #<c_the
0050E2  2  A0 52                LDY     #>c_the
0050E4  2  20 5C 4E             JSR     mb_str
0050E7  2  A5 21                LDA     tmp1
0050E9  2  20 C8 4E             JSR     mb_mname
0050EC  2  A9 56                LDA     #<c_hitsyou
0050EE  2  A0 52                LDY     #>c_hitsyou
0050F0  2  20 5C 4E             JSR     mb_str
0050F3  2  A5 20                LDA     tmp0
0050F5  2  20 73 4E             JSR     mb_num
0050F8  2  A9 48                LDA     #<c_bang
0050FA  2  A0 52                LDY     #>c_bang
0050FC  2  20 5C 4E             JSR     mb_str
0050FF  2  20 D3 4E             JSR     mb_flush
005102  2               ; snake bites may inflict four turns of poison
005102  2  A5 21                LDA     tmp1
005104  2  C9 02                CMP     #M_SNAKE
005106  2  D0 31                BNE     @normal_sfx
005108  2  AE 18 62             LDX     parmor
00510B  2  E0 01                CPX     #1
00510D  2  D0 04                BNE     @normal_venom
00510F  2               ; leather armor reduces the poison chance from one-in-three to one-in-six
00510F  2  A9 06                LDA     #6
005111  2  D0 02                BNE     @roll_venom
005113  2               @normal_venom:
005113  2  A9 03                LDA     #3
005115  2               @roll_venom:
005115  2  20 F8 0C             JSR     rng_d
005118  2  C9 01                CMP     #1
00511A  2  D0 1D                BNE     @normal_sfx
00511C  2  AD 23 62             LDA     poison_turns
00511F  2  D0 08                BNE     @refresh_poison
005121  2  A9 84                LDA     #$84            ; high bit skips the immediate status tick
005123  2  8D 23 62             STA     poison_turns
005126  2  4C 2E 51             JMP     @poisoned
005129  2               @refresh_poison:
005129  2  A9 04                LDA     #4              ; refreshed poison still ticks this turn
00512B  2  8D 23 62             STA     poison_turns
00512E  2               @poisoned:
00512E  2  20 A0 0E             JSR     sfx_poison
005131  2  A9 CA A0 54          PRINTMSG_MSG m_poisoned
005135  2  20 F9 3D     
005138  2  60                   RTS
005139  2               @normal_sfx:
005139  2  20 48 0E             JSR     sfx_hurt
00513C  2  60                   RTS
00513D  2               
00513D  2               ;----------------------------------------------------------------
00513D  2               ; thief_steals_player - steal up to eight gold, then mark this
00513D  2               ; thief as fleeing. If the player is broke, attack normally.
00513D  2               ;----------------------------------------------------------------
00513D  2               thief_steals_player:
00513D  2  AD 13 62             LDA     pgold
005140  2  0D 14 62             ORA     pgold+1
005143  2  D0 03                BNE     @hasgold
005145  2  4C 99 50             JMP     monster_attacks_player
005148  2               @hasgold:
005148  2  A9 08                LDA     #8
00514A  2  20 F8 0C             JSR     rng_d
00514D  2  85 20                STA     tmp0
00514F  2  AD 14 62             LDA     pgold+1
005152  2  D0 09                BNE     @subtract
005154  2  AD 13 62             LDA     pgold
005157  2  C5 20                CMP     tmp0
005159  2  B0 02                BCS     @subtract
00515B  2  85 20                STA     tmp0
00515D  2               @subtract:
00515D  2  38                   SEC
00515E  2  AD 13 62             LDA     pgold
005161  2  E5 20                SBC     tmp0
005163  2  8D 13 62             STA     pgold
005166  2  AD 14 62             LDA     pgold+1
005169  2  E9 00                SBC     #0
00516B  2  8D 14 62             STA     pgold+1
00516E  2  A6 2F                LDX     monidx
005170  2  A9 01                LDA     #1
005172  2  9D 69 63             STA     mon_state,X
005175  2  20 56 4E             JSR     mb_reset
005178  2  A9 80                LDA     #<c_thiefsteals
00517A  2  A0 52                LDY     #>c_thiefsteals
00517C  2  20 5C 4E             JSR     mb_str
00517F  2  A5 20                LDA     tmp0
005181  2  20 73 4E             JSR     mb_num
005184  2  A9 92                LDA     #<c_goldflees
005186  2  A0 52                LDY     #>c_goldflees
005188  2  20 5C 4E             JSR     mb_str
00518B  2  20 D3 4E             JSR     mb_flush
00518E  2  20 00 0E             JSR     sfx_blocked
005191  2  60                   RTS
005192  2               
005192  2               ;----------------------------------------------------------------
005192  2               ; process_status - apply player status effects after a consumed turn.
005192  2               ;----------------------------------------------------------------
005192  2               process_status:
005192  2  AD 23 62             LDA     poison_turns
005195  2  F0 1D                BEQ     @done
005197  2  30 16                BMI     @fresh
005199  2  CE 23 62             DEC     poison_turns
00519C  2  AD 0E 62             LDA     phealth
00519F  2  F0 13                BEQ     @done
0051A1  2  CE 0E 62             DEC     phealth
0051A4  2  20 A0 0E             JSR     sfx_poison
0051A7  2  A9 F8 A0 54          PRINTMSG_MSG m_poison_tick
0051AB  2  20 F9 3D     
0051AE  2  60                   RTS
0051AF  2               @fresh:
0051AF  2  29 7F                AND     #$7F
0051B1  2  8D 23 62             STA     poison_turns
0051B4  2               @done:
0051B4  2  60                   RTS
0051B5  2               
0051B5  2               ;----------------------------------------------------------------
0051B5  2               ; dragon_fire_player - apply the dragon's telegraphed breath attack.
0051B5  2               ; Fire ignores armor but is avoidable by leaving the warned lane.
0051B5  2               ;----------------------------------------------------------------
0051B5  2               dragon_fire_player:
0051B5  2  A9 07                LDA     #7
0051B7  2  20 F8 0C             JSR     rng_d           ; 1..7
0051BA  2  18                   CLC
0051BB  2  69 05                ADC     #5              ; 6..12 damage
0051BD  2  85 20                STA     tmp0
0051BF  2  38                   SEC
0051C0  2  AD 0E 62             LDA     phealth
0051C3  2  E5 20                SBC     tmp0
0051C5  2  B0 02                BCS     @sethp
0051C7  2  A9 00                LDA     #0
0051C9  2               @sethp:
0051C9  2  8D 0E 62             STA     phealth
0051CC  2  20 56 4E             JSR     mb_reset
0051CF  2  A9 65                LDA     #<c_dragonfire
0051D1  2  A0 52                LDY     #>c_dragonfire
0051D3  2  20 5C 4E             JSR     mb_str
0051D6  2  A5 20                LDA     tmp0
0051D8  2  20 73 4E             JSR     mb_num
0051DB  2  A9 48                LDA     #<c_bang
0051DD  2  A0 52                LDY     #>c_bang
0051DF  2  20 5C 4E             JSR     mb_str
0051E2  2  20 D3 4E             JSR     mb_flush
0051E5  2  20 F4 0E             JSR     sfx_breath
0051E8  2  60                   RTS
