0011AC  2  03                   .BYTE   G_MOUNT
0011AD  2  18                   .BYTE   %00011000
0011AE  2  3C                   .BYTE   %00111100
0011AF  2  24                   .BYTE   %00100100
0011B0  2  7E                   .BYTE   %01111110
0011B1  2  5A                   .BYTE   %01011010
0011B2  2  FF                   .BYTE   %11111111
0011B3  2  A5                   .BYTE   %10100101
0011B4  2  FF                   .BYTE   %11111111
0011B5  2               
