004B60  2               ;______________________________________________________________________________
004B60  2               ;  shrine.asm - Sunken Shrine transition and Wyrm Key reward
004B60  2               ;______________________________________________________________________________
004B60  2               
004B60  2               ;----------------------------------------------------------------
004B60  2               ; enter_shrine - enter the southern-marsh quest location.
004B60  2               ;----------------------------------------------------------------
004B60  2               enter_shrine:
004B60  2  20 01 0E             JSR     sfx_door
004B63  2  20 B0 19             JSR     decode_shrine
004B66  2  A9 04                LDA     #LOC_SHRINE
004B68  2  8D 78 4D             STA     loc
004B6B  2  A9 20                LDA     #SHRINEW
004B6D  2  8D 79 4D             STA     locw
004B70  2  A9 14                LDA     #SHRINEH
004B72  2  8D 7A 4D             STA     loch
004B75  2  AD 6B 4D             LDA     px
004B78  2  8D 7B 4D             STA     owretx
004B7B  2  AD 6C 4D             LDA     py
004B7E  2  8D 7C 4D             STA     owrety
004B81  2               ; begin just east of the stairs-up tile
004B81  2  A9 02                LDA     #2
004B83  2  8D 6B 4D             STA     px
004B86  2  A9 01                LDA     #1
004B88  2  8D 6C 4D             STA     py
004B8B  2  20 F8 3D             JSR     spawn_shrine_monsters
004B8E  2  A9 01                LDA     #1
004B90  2  8D 7F 4D             STA     did_move
004B93  2  AD 7E 4D             LDA     queststate
004B96  2  C9 01                CMP     #QUEST_FIND_KEY
004B98  2  D0 0F                BNE     @quiet
004B9A  2  A9 54 A0 4C          PRINTMSG_MSG m_shrine1
004B9E  2  20 6D 39     
004BA1  2  A9 90 A0 4C          PRINTMSG_MSG m_shrine2
004BA5  2  20 6D 39     
004BA8  2  60                   RTS
004BA9  2               @quiet:
004BA9  2  A9 C5 A0 4C          PRINTMSG_MSG m_shrine_empty
004BAD  2  20 6D 39     
004BB0  2  60                   RTS
004BB1  2               
004BB1  2               ;----------------------------------------------------------------
004BB1  2               ; award_wyrm_key - called when the Wyrm Warden dies.
004BB1  2               ;----------------------------------------------------------------
004BB1  2               award_wyrm_key:
004BB1  2  AD 7E 4D             LDA     queststate
004BB4  2  C9 01                CMP     #QUEST_FIND_KEY
004BB6  2  D0 16                BNE     @done
004BB8  2  A9 02                LDA     #QUEST_HAVE_KEY
004BBA  2  8D 7E 4D             STA     queststate
004BBD  2  20 93 0D             JSR     sfx_treasure
004BC0  2  A9 01 A0 4D          PRINTMSG_MSG m_key1
004BC4  2  20 6D 39     
004BC7  2  A9 34 A0 4D          PRINTMSG_MSG m_key2
004BCB  2  20 6D 39     
004BCE  2               @done:
004BCE  2  60                   RTS
004BCF  2               
