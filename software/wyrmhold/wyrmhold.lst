00496E  2  20 F4 39     
004971  2  60                   RTS
004972  2               
004972  2               ;----------------------------------------------------------------
004972  2               ; spend_gold - try to spend A gold.  C=1 success (gold deducted),
004972  2               ;              C=0 if not enough.
004972  2               ;----------------------------------------------------------------
004972  2               spend_gold:
004972  2  85 20                STA     tmp0
004974  2               ; gold >= tmp0 ?  (16-bit gold, 8-bit cost)
004974  2  AD 72 51             LDA     pgold+1
004977  2  D0 07                BNE     @ok             ; high byte nonzero -> plenty
004979  2  AD 71 51             LDA     pgold
00497C  2  C5 20                CMP     tmp0
00497E  2  90 13                BCC     @no
004980  2               @ok:
004980  2  38                   SEC
004981  2  AD 71 51             LDA     pgold
004984  2  E5 20                SBC     tmp0
004986  2  8D 71 51             STA     pgold
004989  2  AD 72 51             LDA     pgold+1
00498C  2  E9 00                SBC     #0
00498E  2  8D 72 51             STA     pgold+1
004991  2  38                   SEC
004992  2  60                   RTS
004993  2               @no:
004993  2  18                   CLC
004994  2  60                   RTS
004995  2               
004995  2               ;----------------------------------------------------------------
004995  2               ; Shop box geometry - a clean panel drawn inside the viewport,
004995  2               ; well clear of the bottom-right auto-scroll cell.
004995  2               ;----------------------------------------------------------------
004995  2               SHOP_X0         = 3             ; left column of box
004995  2               SHOP_X1         = 42            ; right column of box
004995  2               SHOP_Y0         = 4             ; top row of box
004995  2               SHOP_Y1         = 15            ; bottom row of box
004995  2               SHOP_W          = SHOP_X1-SHOP_X0+1
004995  2               
004995  2               ;----------------------------------------------------------------
004995  2               ; shop_draw - render the shop as a self-contained bordered panel.
004995  2               ; The whole box is repainted each call (background + border via
004995  2               ; direct VRAM, then text via firmware) so it is always clean.
004995  2               ;----------------------------------------------------------------
004995  2               shop_draw:
004995  2               ; --- paint box background + border directly to VRAM ---
004995  2  20 88 36             JSR     vid_enter
004998  2  A9 04                LDA     #SHOP_Y0
00499A  2  85 27                STA     rowidx
00499C  2               @bgrow:
00499C  2  A5 27                LDA     rowidx
00499E  2  20 9D 36             JSR     rowbase
0049A1  2  A0 03                LDY     #SHOP_X0
0049A3  2               @bgcol:
0049A3  2               ; border on edges, blank interior
0049A3  2  C0 03                CPY     #SHOP_X0
0049A5  2  F0 19                BEQ     @edge
0049A7  2  C0 2A                CPY     #SHOP_X1
0049A9  2  F0 15                BEQ     @edge
0049AB  2  A5 27                LDA     rowidx
0049AD  2  C9 04                CMP     #SHOP_Y0
0049AF  2  F0 0F                BEQ     @edge
0049B1  2  C9 0F                CMP     #SHOP_Y1
0049B3  2  F0 0B                BEQ     @edge
0049B5  2               ; interior cell
0049B5  2  A9 20                LDA     #space
0049B7  2  91 14                STA     (vptr),Y
0049B9  2  A9 1F                LDA     #C_SHOPBG
0049BB  2  91 16                STA     (cptr),Y
0049BD  2  4C C8 49             JMP     @bgnext
0049C0  2               @edge:
0049C0  2  A9 20                LDA     #' '
0049C2  2  91 14                STA     (vptr),Y
0049C4  2  A9 1B                LDA     #C_SHOPBRD
0049C6  2  91 16                STA     (cptr),Y
0049C8  2               @bgnext:
0049C8  2  C8                   INY
0049C9  2  C0 2B                CPY     #SHOP_X1+1
0049CB  2  D0 D6                BNE     @bgcol
0049CD  2  E6 27                INC     rowidx
0049CF  2  A5 27                LDA     rowidx
0049D1  2  C9 10                CMP     #SHOP_Y1+1
0049D3  2  D0 C7                BNE     @bgrow
0049D5  2  20 97 36             JSR     vid_exit
0049D8  2               
0049D8  2               ; --- text lines via firmware (interior color C_SHOPBG) ---
0049D8  2  A9 1E                LDA     #C_SHOPTTL
0049DA  2  8D 4A 06             STA     CURCOLOR
0049DD  2  A2 0B                LDX     #SHOP_X0+8
0049DF  2  A0 04                LDY     #SHOP_Y0
0049E1  2  20 D6 37             JSR     locate
0049E4  2  A9 6C A0 4A          PRINTMSG t_header
0049E8  2  20 E8 37     
0049EB  2               
0049EB  2  A9 1F                LDA     #C_SHOPTXT
0049ED  2  8D 4A 06             STA     CURCOLOR
0049F0  2  A2 06                LDX     #SHOP_X0+3
0049F2  2  A0 06                LDY     #SHOP_Y0+2
0049F4  2  20 D6 37             JSR     locate
0049F7  2  A9 75 A0 4A          PRINTMSG t_opt1
0049FB  2  20 E8 37     
0049FE  2  A2 06                LDX     #SHOP_X0+3
004A00  2  A0 07                LDY     #SHOP_Y0+3
004A02  2  20 D6 37             JSR     locate
004A05  2  A9 91 A0 4A          PRINTMSG t_opt2
004A09  2  20 E8 37     
004A0C  2  A2 06                LDX     #SHOP_X0+3
004A0E  2  A0 08                LDY     #SHOP_Y0+4
004A10  2  20 D6 37             JSR     locate
004A13  2  A9 AD A0 4A          PRINTMSG t_opt3
004A17  2  20 E8 37     
004A1A  2  A2 06                LDX     #SHOP_X0+3
004A1C  2  A0 09                LDY     #SHOP_Y0+5
004A1E  2  20 D6 37             JSR     locate
004A21  2  A9 C9 A0 4A          PRINTMSG t_opt4
004A25  2  20 E8 37     
004A28  2  A2 06                LDX     #SHOP_X0+3
004A2A  2  A0 0A                LDY     #SHOP_Y0+6
004A2C  2  20 D6 37             JSR     locate
004A2F  2  A9 E5 A0 4A          PRINTMSG t_optx
004A33  2  20 E8 37     
004A36  2               
004A36  2               ; gold line
004A36  2  A2 06                LDX     #SHOP_X0+3
004A38  2  A0 0C                LDY     #SHOP_Y0+8
004A3A  2  20 D6 37             JSR     locate
004A3D  2  A9 1F                LDA     #C_SHOPTXT
004A3F  2  8D 4A 06             STA     CURCOLOR
004A42  2  A9 F7 A0 4A          PRINTMSG t_gold
004A46  2  20 E8 37     
004A49  2  AD 71 51 85          COPY16  pgold, numarg
004A4D  2  1E AD 72 51  
004A51  2  85 1F        
004A53  2  20 98 39             JSR     displaynum
004A56  2               
004A56  2               ; status line (last action / greeting)
004A56  2  A2 06                LDX     #SHOP_X0+3
004A58  2  A0 0E                LDY     #SHOP_Y1-1
004A5A  2  20 D6 37             JSR     locate
004A5D  2  A9 1A                LDA     #C_SHOPST
004A5F  2  8D 4A 06             STA     CURCOLOR
004A62  2  AD 89 51             LDA     shopstat
004A65  2  AC 8A 51             LDY     shopstat+1
004A68  2  20 E8 37             JSR     prmsg
004A6B  2  60                   RTS
