000A2E  1               exit_to_dos:
000A2E  1  20 BE 0C             JSR     psg_silence
000A31  1                       ; restore a normal console: 80-col, default colors, cursor on
000A31  1  A9 39                LDA     #FC_SETMODE
000A33  1  85 32                STA     farfunct
000A35  1  A9 01                LDA     #1
000A37  1  20 F0 FF             JSR     DO_FARCALL
000A3A  1  A2 07                LDX     #C_BLANK
000A3C  1  A0 E1                LDY     #CSRCOLOR_DEF
000A3E  1  A9 27 85 32          FARCALL FC_COLOR
000A42  1  20 F0 FF     
000A45  1  A9 26 85 32          FARCALL FC_SCNCLR
000A49  1  20 F0 FF     
000A4C  1  A9 01                LDA     #1
000A4E  1  8D 49 06             STA     SHOWCRSR
000A51  1  4C 00 01             JMP     BOOT            ; back to DOS/65
000A54  1               
000A54  1               CSRCOLOR_DEF    = $E1
