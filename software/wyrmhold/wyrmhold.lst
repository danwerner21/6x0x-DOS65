003247  2  23 2E 2E 2E          .BYTE   "#....#####..........#####......#",0
00324B  2  2E 23 23 23  
00324F  2  23 23 2E 2E  
003268  2  23 2E 2E 2E          .BYTE   "#..............................#",0
00326C  2  2E 2E 2E 2E  
003270  2  2E 2E 2E 2E  
003289  2  23 2E 2E 2E          .BYTE   "#..............................#",0
