003FA0  2  A0 12                LDY     #18
003FA2  2  20 DB 3B             JSR     locate
003FA5  2  A9 0F                LDA     #C_PANEL
003FA7  2  8D 4A 06             STA     CURCOLOR
003FAA  2  AD 23 62             LDA     poison_turns
003FAD  2  F0 0A                BEQ     @healthy
003FAF  2  A9 F4 A0 41          PRINTMSG status_poison
003FB3  2  20 ED 3B     
