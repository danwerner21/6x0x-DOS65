001867  2               
001867  1                       .INCLUDE "world.asm"
001867  2               ;______________________________________________________________________________
001867  2               ;  world.asm - map data, tile property tables and lookup helpers
001867  2               ;
001867  2               ;  Maps are authored as ASCII rows for readability and converted to
001867  2               ;  tile codes once at startup (map_decode).  The decoded tile grids
001867  2               ;  live in RAM (owmap / locmap).  Authoring characters:
001867  2               ;     . grass   & forest  ^ mountain  ~ water   h hills   % marsh
001867  2               ;     T town    O dungeon C castle    : road    = bridge
001867  2               ;     space->grass
001867  2               ;  For interiors (town/dungeon/castle/shrine):
001867  2               ;     . floor   # wall     + door(exit)  $ treasure  < stairs up
001867  2               ;     S shop    ~ water
001867  2               ;______________________________________________________________________________
001867  2               
001867  2               ;----------------------------------------------------------------
001867  2               ; Tile color table  (tile code -> color byte)
001867  2               ;----------------------------------------------------------------
001867  2               tile_color:
001867  2  2A                   .BYTE   C_GRASS         ; 0
001868  2  0A                   .BYTE   C_FOREST        ; 1
001869  2  8F                   .BYTE   C_MOUNT         ; 2
00186A  2  1B                   .BYTE   C_WATER         ; 3
00186B  2  4E                   .BYTE   C_TOWN          ; 4
00186C  2  0B                   .BYTE   C_DUNG          ; 5
00186D  2  8F                   .BYTE   C_CASTLE        ; 6
00186E  2  4E                   .BYTE   C_ROAD          ; 7
00186F  2  1E                   .BYTE   C_BRIDGE        ; 8
001870  2  08                   .BYTE   C_FLOOR         ; 9
001871  2  8F                   .BYTE   C_WALL          ; 10
001872  2  A0                   .BYTE   C_EXIT          ; 11 door (bright = exit)
001873  2  0E                   .BYTE   C_TREAS         ; 12
001874  2  A0                   .BYTE   C_EXIT          ; 13 stairs (bright = exit)
001875  2  4E                   .BYTE   C_TOWN          ; 14 shop
001876  2  2E                   .BYTE   C_HILLS         ; 15
001877  2  1A                   .BYTE   C_MARSH         ; 16
001878  2               
001878  2               ;----------------------------------------------------------------
001878  2               ; Tile variant table  (tile code -> alternate metatile base, or 0)
001878  2               ; A non-zero entry means this terrain has a 2nd art variant; the
001878  2               ; renderer may use it instead of the MG_* base for some map cells
001878  2               ; to break up the repeating-grid look. 0 = no variant (use base).
001878  2               ;----------------------------------------------------------------
001878  2               tile_variant:
001878  2  E0                   .BYTE   MGV_GRASS       ; 0  grass
001879  2  E4                   .BYTE   MGV_FOREST      ; 1  forest
00187A  2  EC                   .BYTE   MGV_MOUNT       ; 2  mountain
00187B  2  E8                   .BYTE   MGV_WATER       ; 3  water
00187C  2  00                   .BYTE   0               ; 4  town
00187D  2  00                   .BYTE   0               ; 5  dungeon
00187E  2  00                   .BYTE   0               ; 6  castle
00187F  2  00                   .BYTE   0               ; 7  road
001880  2  00                   .BYTE   0               ; 8  bridge
001881  2  00                   .BYTE   0               ; 9  floor
001882  2  00                   .BYTE   0               ; 10 wall
001883  2  00                   .BYTE   0               ; 11 door
001884  2  00                   .BYTE   0               ; 12 treasure
001885  2  00                   .BYTE   0               ; 13 stairs
001886  2  00                   .BYTE   0               ; 14 shop
001887  2  00                   .BYTE   0               ; 15 hills
001888  2  00                   .BYTE   0               ; 16 marsh
001889  2               
001889  2               ;----------------------------------------------------------------
001889  2               ; Tile property table  (tile code -> property bits)
001889  2               ;   bit0 PASS    passable on foot
001889  2               ;   bit1 WATER   water (impassable without ship)
001889  2               ;   bit2 TOWN    stepping here enters a town
001889  2               ;   bit3 DUNG    stepping here enters the dungeon
001889  2               ;   bit4 EXIT    stepping here leaves the interior (town/dungeon)
001889  2               ;   bit5 TREAS   treasure to collect
001889  2               ;   bit6 SHOP    shop counter (open shop when adjacent/entering)
001889  2               ;   bit7 CASTLE  stepping here enters Wyrmhold Castle
001889  2               ;----------------------------------------------------------------
001889  2               P_PASS          = $01
001889  2               P_WATER         = $02
001889  2               P_TOWN          = $04
001889  2               P_DUNG          = $08
001889  2               P_EXIT          = $10
001889  2               P_TREAS         = $20
001889  2               P_SHOP          = $40
001889  2               P_CASTLE        = $80
001889  2               
001889  2               tile_prop:
001889  2  01                   .BYTE   P_PASS          ; 0 grass
00188A  2  01                   .BYTE   P_PASS          ; 1 forest (passable, slow flavor)
00188B  2  00                   .BYTE   $00             ; 2 mountain (blocked)
00188C  2  02                   .BYTE   P_WATER         ; 3 water (blocked on foot)
00188D  2  05                   .BYTE   P_PASS|P_TOWN   ; 4 town
00188E  2  09                   .BYTE   P_PASS|P_DUNG   ; 5 dungeon
00188F  2  81                   .BYTE   P_PASS|P_CASTLE ; 6 castle
001890  2  01                   .BYTE   P_PASS          ; 7 road
001891  2  01                   .BYTE   P_PASS          ; 8 bridge
001892  2  01                   .BYTE   P_PASS          ; 9 floor
001893  2  00                   .BYTE   $00             ; 10 wall
001894  2  11                   .BYTE   P_PASS|P_EXIT   ; 11 door (exit interior)
001895  2  21                   .BYTE   P_PASS|P_TREAS  ; 12 treasure
001896  2  11                   .BYTE   P_PASS|P_EXIT   ; 13 stairs up (exit dungeon)
001897  2  41                   .BYTE   P_PASS|P_SHOP   ; 14 shop
001898  2  01                   .BYTE   P_PASS          ; 15 hills
001899  2  01                   .BYTE   P_PASS          ; 16 marsh
00189A  2               
00189A  2               ;----------------------------------------------------------------
00189A  2               ; Authoring char -> tile code translation (used by map_decode).
00189A  2               ; Two parallel tables: chars[] and codes[], terminated by $00.
00189A  2               ; The current decoder supplies the map-specific default tile:
00189A  2               ; grass outdoors and floor indoors. Thus '.' and unknown/space
00189A  2               ; characters become the appropriate default without a table entry.
00189A  2               ;----------------------------------------------------------------
00189A  2               dec_chars:
00189A  2  26 5E 7E 54          .BYTE   "&^~TOC:=#+$<Sh%", $00
00189E  2  4F 43 3A 3D  
0018A2  2  23 2B 24 3C  
0018AA  2               dec_codes:
0018AA  2  01                   .BYTE   T_FOREST        ; &
0018AB  2  02                   .BYTE   T_MOUNT         ; ^
0018AC  2  03                   .BYTE   T_WATER         ; ~
0018AD  2  04                   .BYTE   T_TOWN          ; T
0018AE  2  05                   .BYTE   T_DUNG          ; O
0018AF  2  06                   .BYTE   T_CASTLE        ; C
0018B0  2  07                   .BYTE   T_ROAD          ; :
0018B1  2  08                   .BYTE   T_BRIDGE        ; =
0018B2  2  0A                   .BYTE   T_WALL          ; #
0018B3  2  0B                   .BYTE   T_DOOR          ; +
0018B4  2  0C                   .BYTE   T_TREAS         ; $
0018B5  2  0D                   .BYTE   T_UPSTAIR       ; <
0018B6  2  0E                   .BYTE   T_SHOP          ; S
0018B7  2  0F                   .BYTE   T_HILLS         ; h
0018B8  2  10                   .BYTE   T_MARSH         ; %
0018B9  2               
0018B9  2               ; map a single authoring char (A) to a tile code -> A
0018B9  2               xlate_char:
0018B9  2  85 20                STA     tmp0
0018BB  2  A2 00                LDX     #0
0018BD  2               @f:
0018BD  2  BD 9A 18             LDA     dec_chars,X
0018C0  2  F0 07                BEQ     @nf
0018C2  2  C5 20                CMP     tmp0
0018C4  2  F0 06                BEQ     @ok
0018C6  2  E8                   INX
0018C7  2  D0 F4                BNE     @f
0018C9  2               @nf:
0018C9  2  A5 25                LDA     cnt1            ; map-specific default tile
0018CB  2  60                   RTS
0018CC  2               @ok:
0018CC  2  BD AA 18             LDA     dec_codes,X
0018CF  2  60                   RTS
0018D0  2               
0018D0  2               ;----------------------------------------------------------------
0018D0  2               ; map_decode - translate an authored ASCII map into a tile grid,
0018D0  2               ; row by row.  Each source row is a NUL-terminated string.  Rows
0018D0  2               ; shorter than the map width are padded with the map default; longer
0018D0  2               ; rows are truncated.  This makes exact source-row width unimportant.
0018D0  2               ;
0018D0  2               ;   IN : srcp -> first source row (rows packed back-to-back, each
0018D0  2               ;                NUL-terminated)
0018D0  2               ;        dstp -> destination tile-code buffer (width*height bytes)
0018D0  2               ;        tmp2 =  map width   (<=255)
0018D0  2               ;        tmp3 =  map height  (<=255)
0018D0  2               ;        cnt1 = default tile (grass outdoors, floor indoors)
0018D0  2               ;----------------------------------------------------------------
0018D0  2               ; NOTE: the column counter is kept in cnt0 (memory), NOT in X,
0018D0  2               ; because xlate_char clobbers X (it uses X as a search index).
0018D0  2               map_decode:
0018D0  2  A9 00                LDA     #0
0018D2  2  85 27                STA     rowidx          ; row counter
0018D4  2               @nextrow:
0018D4  2  A5 27                LDA     rowidx
0018D6  2  C5 23                CMP     tmp3
0018D8  2  B0 59                BCS     @done
0018DA  2  A9 00                LDA     #0
0018DC  2  85 24                STA     cnt0            ; column within row
0018DE  2               @col:
0018DE  2  A5 24                LDA     cnt0
0018E0  2  C5 22                CMP     tmp2
0018E2  2  B0 1E                BCS     @rowfull
0018E4  2               ; cnt0 tracks column for width logic; srcp is the read head.
0018E4  2  A0 00                LDY     #0
0018E6  2  B1 18                LDA     (srcp),Y
0018E8  2  F0 27                BEQ     @padrow         ; early NUL -> pad rest with grass
0018EA  2  20 B9 18             JSR     xlate_char      ; A=tile code (clobbers X)
0018ED  2  A0 00                LDY     #0
0018EF  2  91 1A                STA     (dstp),Y
0018F1  2               ; advance read head and dest
0018F1  2  E6 18                INC     srcp
0018F3  2  D0 02                BNE     :+
0018F5  2  E6 19                INC     srcp+1
0018F7  2               :
0018F7  2  E6 1A                INC     dstp
0018F9  2  D0 02                BNE     :+
0018FB  2  E6 1B                INC     dstp+1
0018FD  2               :
0018FD  2  E6 24                INC     cnt0
0018FF  2  4C DE 18             JMP     @col
001902  2               @rowfull:
001902  2               ; consume any extra source chars up to the terminating NUL
001902  2               @skip:
001902  2  A0 00                LDY     #0
001904  2  B1 18                LDA     (srcp),Y
001906  2  F0 20                BEQ     @aftrow
001908  2  E6 18                INC     srcp
00190A  2  D0 F6                BNE     @skip
00190C  2  E6 19                INC     srcp+1
00190E  2  4C 02 19             JMP     @skip
001911  2               @padrow:
001911  2               ; fill remaining columns (cnt0..width-1) with the map default
001911  2               @pad:
001911  2  A5 24                LDA     cnt0
001913  2  C5 22                CMP     tmp2
001915  2  B0 11                BCS     @aftrow
001917  2  A5 25                LDA     cnt1
001919  2  A0 00                LDY     #0
00191B  2  91 1A                STA     (dstp),Y
00191D  2  E6 1A                INC     dstp
00191F  2  D0 02                BNE     :+
001921  2  E6 1B                INC     dstp+1
001923  2               :
001923  2  E6 24                INC     cnt0
001925  2  4C 11 19             JMP     @pad
001928  2               @aftrow:
001928  2               ; step srcp past the row terminator NUL
001928  2  E6 18                INC     srcp
00192A  2  D0 02                BNE     :+
00192C  2  E6 19                INC     srcp+1
00192E  2               :
00192E  2  E6 27                INC     rowidx
001930  2  4C D4 18             JMP     @nextrow
001933  2               @done:
001933  2  60                   RTS
001934  2               
001934  2               ;----------------------------------------------------------------
001934  2               ; decode_world / decode_town / decode_dung / decode_castle / decode_shrine
001934  2               ;----------------------------------------------------------------
001934  2               decode_world:
001934  2  A9 F9 85 18          SETW16  srcp, ow_src
001938  2  A9 1A 85 19  
00193C  2  A9 C1 85 1A          SETW16  dstp, owmap
001940  2  A9 4E 85 1B  
001944  2  A9 00                LDA     #T_GRASS
001946  2  85 25                STA     cnt1
001948  2  A9 40                LDA     #OWW
00194A  2  85 22                STA     tmp2
00194C  2  A9 40                LDA     #OWH
00194E  2  85 23                STA     tmp3
001950  2  4C D0 18             JMP     map_decode
001953  2               
001953  2               decode_town:
001953  2  A9 B4 85 18          SETW16  srcp, town_src
001957  2  A9 2B 85 19  
00195B  2  A9 C1 85 1A          SETW16  dstp, locmap
00195F  2  A9 5E 85 1B  
001963  2  A9 09                LDA     #T_FLOOR
001965  2  85 25                STA     cnt1
001967  2  A9 20                LDA     #TOWNW
001969  2  85 22                STA     tmp2
00196B  2  A9 14                LDA     #TOWNH
00196D  2  85 23                STA     tmp3
00196F  2  4C D0 18             JMP     map_decode
001972  2               
001972  2               decode_dung:
001972  2  A9 48 85 18          SETW16  srcp, dung_src
001976  2  A9 2E 85 19  
00197A  2  A9 C1 85 1A          SETW16  dstp, locmap
00197E  2  A9 5E 85 1B  
001982  2  A9 09                LDA     #T_FLOOR
001984  2  85 25                STA     cnt1
001986  2  A9 20                LDA     #DUNGW
001988  2  85 22                STA     tmp2
00198A  2  A9 14                LDA     #DUNGH
00198C  2  85 23                STA     tmp3
00198E  2  4C D0 18             JMP     map_decode
001991  2               
001991  2               decode_castle:
001991  2  A9 DC 85 18          SETW16  srcp, castle_src
001995  2  A9 30 85 19  
001999  2  A9 C1 85 1A          SETW16  dstp, locmap
00199D  2  A9 5E 85 1B  
0019A1  2  A9 09                LDA     #T_FLOOR
0019A3  2  85 25                STA     cnt1
0019A5  2  A9 20                LDA     #CASTLEW
0019A7  2  85 22                STA     tmp2
0019A9  2  A9 14                LDA     #CASTLEH
0019AB  2  85 23                STA     tmp3
0019AD  2  4C D0 18             JMP     map_decode
0019B0  2               
0019B0  2               decode_shrine:
0019B0  2  A9 70 85 18          SETW16  srcp, shrine_src
0019B4  2  A9 33 85 19  
0019B8  2  A9 C1 85 1A          SETW16  dstp, locmap
0019BC  2  A9 5E 85 1B  
0019C0  2  A9 09                LDA     #T_FLOOR
0019C2  2  85 25                STA     cnt1
0019C4  2  A9 20                LDA     #SHRINEW
0019C6  2  85 22                STA     tmp2
0019C8  2  A9 14                LDA     #SHRINEH
0019CA  2  85 23                STA     tmp3
0019CC  2  4C D0 18             JMP     map_decode
0019CF  2               
0019CF  2               ;----------------------------------------------------------------
0019CF  2               ; tileat - read the tile code at (tgtx,tgty) from the ACTIVE map.
0019CF  2               ;   IN : tgtx, tgty ; loc (LOC_*) selects map + width
0019CF  2               ;   OUT: A = tile code, also stored in tgttile
0019CF  2               ;        if out of bounds -> returns T_WATER (overworld) / T_WALL (int)
0019CF  2               ;   Trashes ptr, tmp0, tmp1
0019CF  2               ;----------------------------------------------------------------
0019CF  2               tileat:
0019CF  2  AD 78 4D             LDA     loc
0019D2  2  D0 52                BNE     @interior
0019D4  2               ;--- overworld ---
0019D4  2               ; bounds check 0..OWW-1 / 0..OWH-1
0019D4  2  A5 2C                LDA     tgtx
0019D6  2  C9 40                CMP     #OWW
0019D8  2  B0 47                BCS     @oob_world
0019DA  2  A5 2D                LDA     tgty
0019DC  2  C9 40                CMP     #OWH
0019DE  2  B0 41                BCS     @oob_world
0019E0  2               ; offset = tgty*OWW + tgtx  (OWW=64 -> *64)
0019E0  2  A5 2D                LDA     tgty
0019E2  2  85 10                STA     ptr
0019E4  2  A9 00                LDA     #0
0019E6  2  85 11                STA     ptr+1
0019E8  2  06 10                ASL     ptr
0019EA  2  26 11                ROL     ptr+1           ; *2
0019EC  2  06 10                ASL     ptr
0019EE  2  26 11                ROL     ptr+1           ; *4
0019F0  2  06 10                ASL     ptr
0019F2  2  26 11                ROL     ptr+1           ; *8
0019F4  2  06 10                ASL     ptr
0019F6  2  26 11                ROL     ptr+1           ; *16
0019F8  2  06 10                ASL     ptr
0019FA  2  26 11                ROL     ptr+1           ; *32
0019FC  2  06 10                ASL     ptr
0019FE  2  26 11                ROL     ptr+1           ; *64
001A00  2  18                   CLC
001A01  2  A5 10                LDA     ptr
001A03  2  65 2C                ADC     tgtx
001A05  2  85 10                STA     ptr
001A07  2  A5 11                LDA     ptr+1
001A09  2  69 00                ADC     #0
001A0B  2  85 11                STA     ptr+1
001A0D  2               ; ptr += owmap base
001A0D  2  18                   CLC
001A0E  2  A5 10                LDA     ptr
001A10  2  69 C1                ADC     #<owmap
001A12  2  85 10                STA     ptr
001A14  2  A5 11                LDA     ptr+1
001A16  2  69 4E                ADC     #>owmap
001A18  2  85 11                STA     ptr+1
001A1A  2  A0 00                LDY     #0
001A1C  2  B1 10                LDA     (ptr),Y
001A1E  2  85 2E                STA     tgttile
001A20  2  60                   RTS
001A21  2               @oob_world:
001A21  2  A9 03                LDA     #T_WATER
001A23  2  85 2E                STA     tgttile
001A25  2  60                   RTS
001A26  2               ;--- interior (town/dungeon): width = locw, height = loch ---
001A26  2               @interior:
001A26  2  A5 2C                LDA     tgtx
001A28  2  CD 79 4D             CMP     locw
001A2B  2  B0 44                BCS     @oob_int
001A2D  2  A5 2D                LDA     tgty
001A2F  2  CD 7A 4D             CMP     loch
001A32  2  B0 3D                BCS     @oob_int
001A34  2               ; offset = tgty*locw + tgtx  (locw is 32)
001A34  2  A5 2D                LDA     tgty
001A36  2  85 10                STA     ptr
001A38  2  A9 00                LDA     #0
001A3A  2  85 11                STA     ptr+1
001A3C  2  06 10                ASL     ptr
001A3E  2  26 11                ROL     ptr+1           ; *2
001A40  2  06 10                ASL     ptr
001A42  2  26 11                ROL     ptr+1           ; *4
001A44  2  06 10                ASL     ptr
001A46  2  26 11                ROL     ptr+1           ; *8
001A48  2  06 10                ASL     ptr
001A4A  2  26 11                ROL     ptr+1           ; *16
001A4C  2  06 10                ASL     ptr
001A4E  2  26 11                ROL     ptr+1           ; *32  (locw assumed 32)
001A50  2  18                   CLC
001A51  2  A5 10                LDA     ptr
001A53  2  65 2C                ADC     tgtx
001A55  2  85 10                STA     ptr
001A57  2  A5 11                LDA     ptr+1
001A59  2  69 00                ADC     #0
001A5B  2  85 11                STA     ptr+1
001A5D  2  18                   CLC
001A5E  2  A5 10                LDA     ptr
001A60  2  69 C1                ADC     #<locmap
001A62  2  85 10                STA     ptr
001A64  2  A5 11                LDA     ptr+1
001A66  2  69 5E                ADC     #>locmap
001A68  2  85 11                STA     ptr+1
001A6A  2  A0 00                LDY     #0
001A6C  2  B1 10                LDA     (ptr),Y
001A6E  2  85 2E                STA     tgttile
001A70  2  60                   RTS
001A71  2               @oob_int:
001A71  2  A9 0A                LDA     #T_WALL
001A73  2  85 2E                STA     tgttile
001A75  2  60                   RTS
001A76  2               
001A76  2               ;----------------------------------------------------------------
001A76  2               ; settile - write tile code A at (tgtx,tgty) in the active map.
001A76  2               ;   Used to clear treasure chests once collected, etc.
001A76  2               ;   Recomputes the address exactly like tileat.
001A76  2               ;----------------------------------------------------------------
001A76  2               settile:
001A76  2  85 21                STA     tmp1            ; new tile
001A78  2  20 82 1A             JSR     tile_addr       ; ptr -> cell
001A7B  2  A0 00                LDY     #0
001A7D  2  A5 21                LDA     tmp1
001A7F  2  91 10                STA     (ptr),Y
001A81  2  60                   RTS
001A82  2               
001A82  2               ; tile_addr - compute ptr -> active-map cell for (tgtx,tgty).
001A82  2               ; (assumes in-bounds; callers that might be OOB use tileat first)
001A82  2               tile_addr:
001A82  2  AD 78 4D             LDA     loc
001A85  2  D0 3B                BNE     @int
001A87  2  A5 2D                LDA     tgty
001A89  2  85 10                STA     ptr
001A8B  2  A9 00                LDA     #0
001A8D  2  85 11                STA     ptr+1
001A8F  2  06 10                ASL     ptr
001A91  2  26 11                ROL     ptr+1
001A93  2  06 10                ASL     ptr
