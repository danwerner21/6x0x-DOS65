00356F  2               mon_names:
00356F  2  7D 35 83 35          .WORD   mn_none, mn_orc, mn_snake, mn_skel, mn_thief, mn_troll, mn_boss
003573  2  87 35 8D 35  
003577  2  96 35 9C 35  
00357D  2  74 68 69 6E  mn_none:  .BYTE "thing",0
003581  2  67 00        
