003688  2               
003688  1                       .INCLUDE "video.asm"
003688  2               ;______________________________________________________________________________
003688  2               ;  video.asm - memory-mapped video: paging, framing, viewport, UI text
003688  2               ;
003688  2               ;  Direct VRAM access (the fast path used by SpeedScript): map video
003688  2               ;  sub-page $F9 into CPU bank $A.  Then:
003688  2               ;     text  char at  $A000 + row*80 + col
003688  2               ;     color cell at  $A800 + row*80 + col
003688  2               ;  Color byte = (bg<<4)|fg.
003688  2               ;
003688  2               ;  All direct-write routines must be bracketed by vid_enter / vid_exit.
003688  2               ;  UI text via the firmware (prmsg / putxy) does NOT page; it uses
003688  2               ;  FARCALL chrout/locate and must be used while in task 0.
003688  2               ;______________________________________________________________________________
003688  2               
003688  2               ;----------------------------------------------------------------
003688  2               ; vid_enter - map video text/color page into $A000-$AFFF (task 1)
003688  2               ;             trashes A,X ; preserves Y
003688  2               ;----------------------------------------------------------------
003688  2               vid_enter:
003688  2  A9 01                LDA     #$01            ; configure task 01
00368A  2  A2 0A                LDX     #$0A            ; CPU bank $A ($A000-$AFFF)
00368C  2  A0 F9                LDY     #VIDTEXT_PAGE   ; physical video page $F9
00368E  2  20 F6 FF             JSR     SETPAGE
003691  2  A9 01                LDA     #$01
003693  2  8D E0 EF             STA     PC6502_ACT_TASK ; activate task 01
003696  2  60                   RTS
003697  2               
003697  2               ;----------------------------------------------------------------
003697  2               ; vid_exit - restore normal memory at $A000 (task 0)
003697  2               ;----------------------------------------------------------------
003697  2               vid_exit:
003697  2  A9 00                LDA     #$00
003699  2  8D E0 EF             STA     PC6502_ACT_TASK
00369C  2  60                   RTS
00369D  2               
00369D  2               ;----------------------------------------------------------------
00369D  2               ; rowbase - compute VRAM pointers for the start of a screen row.
00369D  2               ;   IN : A = row (0..23)
00369D  2               ;   OUT: vptr -> $A000 + row*80   (text)
00369D  2               ;        cptr -> $A800 + row*80   (color)
00369D  2               ;   row*80 = row*64 + row*16 = (row<<6)+(row<<4)
00369D  2               ;----------------------------------------------------------------
00369D  2               rowbase:
00369D  2  85 20                STA     tmp0            ; row
00369F  2               ; row*16 -> ptr2
00369F  2  A9 00                LDA     #0
0036A1  2  85 13                STA     ptr2+1
0036A3  2  A5 20                LDA     tmp0
0036A5  2  0A                   ASL     A               ; *2
0036A6  2  0A                   ASL     A               ; *4
0036A7  2  0A                   ASL     A               ; *8
0036A8  2  0A                   ASL     A               ; *16 (row<=23 so <=368, may set carry)
0036A9  2  85 12                STA     ptr2
0036AB  2  A9 00                LDA     #0
0036AD  2  2A                   ROL     A
0036AE  2  85 13                STA     ptr2+1          ; high bits of row*16
0036B0  2               ; row*64 -> ptr
0036B0  2  A5 20                LDA     tmp0
0036B2  2  85 10                STA     ptr
0036B4  2  A9 00                LDA     #0
0036B6  2  85 11                STA     ptr+1
0036B8  2  06 10                ASL     ptr
0036BA  2  26 11                ROL     ptr+1           ; *2
0036BC  2  06 10                ASL     ptr
0036BE  2  26 11                ROL     ptr+1           ; *4
0036C0  2  06 10                ASL     ptr
0036C2  2  26 11                ROL     ptr+1           ; *8
0036C4  2  06 10                ASL     ptr
0036C6  2  26 11                ROL     ptr+1           ; *16
0036C8  2  06 10                ASL     ptr
0036CA  2  26 11                ROL     ptr+1           ; *32
0036CC  2  06 10                ASL     ptr
0036CE  2  26 11                ROL     ptr+1           ; *64
0036D0  2               ; ptr = ptr + ptr2 = row*80
0036D0  2  18                   CLC
0036D1  2  A5 10                LDA     ptr
0036D3  2  65 12                ADC     ptr2
0036D5  2  85 10                STA     ptr
0036D7  2  A5 11                LDA     ptr+1
0036D9  2  65 13                ADC     ptr2+1
0036DB  2  85 11                STA     ptr+1
0036DD  2               ; vptr = $A000 + ptr
0036DD  2  18                   CLC
0036DE  2  A5 10                LDA     ptr
0036E0  2  85 14                STA     vptr
0036E2  2  A5 11                LDA     ptr+1
0036E4  2  69 A0                ADC     #>VRAM_TEXT
0036E6  2  85 15                STA     vptr+1
0036E8  2               ; cptr = $A800 + ptr
0036E8  2  18                   CLC
0036E9  2  A5 10                LDA     ptr
0036EB  2  85 16                STA     cptr
0036ED  2  A5 11                LDA     ptr+1
0036EF  2  69 A8                ADC     #>VRAM_COLOR
0036F1  2  85 17                STA     cptr+1
0036F3  2  60                   RTS
0036F4  2               
0036F4  2               ;----------------------------------------------------------------
0036F4  2               ; putcell - write one char+color cell directly to VRAM.
0036F4  2               ;   MUST be called between vid_enter / vid_exit.
0036F4  2               ;   IN : tmp1 = row, tmp2 = col, tmp3 = char, colidx = color
0036F4  2               ;   trashes A,Y
0036F4  2               ;----------------------------------------------------------------
0036F4  2               putcell:
0036F4  2  A5 21                LDA     tmp1
0036F6  2  20 9D 36             JSR     rowbase
0036F9  2  A4 22                LDY     tmp2
0036FB  2  A5 23                LDA     tmp3
0036FD  2  91 14                STA     (vptr),Y
0036FF  2  A5 26                LDA     colidx
003701  2  91 16                STA     (cptr),Y
003703  2  60                   RTS
003704  2               
003704  2               ;----------------------------------------------------------------
003704  2               ; cls_vram - fill the whole screen with spaces in C_BLANK.
003704  2               ;----------------------------------------------------------------
003704  2               cls_vram:
003704  2  20 88 36             JSR     vid_enter
003707  2  A9 00                LDA     #0
003709  2  85 27                STA     rowidx
00370B  2               @row:
00370B  2  A5 27                LDA     rowidx
00370D  2  20 9D 36             JSR     rowbase
003710  2  A0 00                LDY     #0
003712  2               @col:
003712  2  A9 20                LDA     #space
003714  2  91 14                STA     (vptr),Y
003716  2  A9 08                LDA     #C_BLANK
003718  2  91 16                STA     (cptr),Y
00371A  2  C8                   INY
00371B  2  C0 50                CPY     #SCRW
00371D  2  D0 F3                BNE     @col
00371F  2  E6 27                INC     rowidx
003721  2  A5 27                LDA     rowidx
003723  2  C9 18                CMP     #SCRH
003725  2  D0 E4                BNE     @row
003727  2  4C 97 36             JMP     vid_exit
00372A  2               
00372A  2               ;----------------------------------------------------------------
00372A  2               ; fillrow_vram - fill one row [colA..colB) with char/color.
00372A  2               ;   IN: tmp1=row, tmp2=start col, tmp3=char, colidx=color, cnt0=count
00372A  2               ;   MUST be inside vid_enter/vid_exit.
00372A  2               ;----------------------------------------------------------------
00372A  2               fillrow_vram:
00372A  2  A5 21                LDA     tmp1
00372C  2  20 9D 36             JSR     rowbase
00372F  2  A4 22                LDY     tmp2
003731  2  A6 24                LDX     cnt0
003733  2               @fl:
003733  2  A5 23                LDA     tmp3
003735  2  91 14                STA     (vptr),Y
003737  2  A5 26                LDA     colidx
003739  2  91 16                STA     (cptr),Y
00373B  2  C8                   INY
00373C  2  CA                   DEX
00373D  2  D0 F4                BNE     @fl
00373F  2  60                   RTS
003740  2               
003740  2               ;----------------------------------------------------------------
003740  2               ; draw_frame - draw the static game UI: title bar, viewport frame,
003740  2               ;              stat panel frame, and message area divider.
003740  2               ;              Done once at game start (and after returning from
003740  2               ;              full-screen menus).
003740  2               ;----------------------------------------------------------------
003740  2               draw_frame:
003740  2  20 04 37             JSR     cls_vram
003743  2  20 88 36             JSR     vid_enter
003746  2               
003746  2               ; --- top title bar (row 0) ---
003746  2  A9 00                LDA     #0
003748  2  85 21                STA     tmp1
00374A  2  A9 00                LDA     #0
00374C  2  85 22                STA     tmp2
00374E  2  A9 20                LDA     #space
003750  2  85 23                STA     tmp3
003752  2  A9 0E                LDA     #C_TITLE
003754  2  85 26                STA     colidx
003756  2  A9 50                LDA     #SCRW
003758  2  85 24                STA     cnt0
00375A  2  20 2A 37             JSR     fillrow_vram
00375D  2               ; centered title text written below via vid_exit path
00375D  2               
00375D  2               ; --- viewport top/bottom horizontal borders ---
00375D  2               ; top border at row 0 already part of title; we frame the
00375D  2               ; viewport with vertical bars and a bottom rule at VPY0+VPH.
00375D  2               ; vertical left/right bars for viewport rows
00375D  2  A2 01                LDX     #VPY0
00375F  2               @vbar:
00375F  2  8A                   TXA
003760  2  85 21                STA     tmp1
003762  2  20 9D 36             JSR     rowbase
003765  2  A0 00                LDY     #0              ; left edge col 0
003767  2  A9 7C                LDA     #'|'
003769  2  91 14                STA     (vptr),Y
00376B  2  A9 0B                LDA     #C_BORDER
00376D  2  91 16                STA     (cptr),Y
00376F  2  A0 2D                LDY     #(VPW+1)        ; right edge of viewport
003771  2  A9 7C                LDA     #'|'
003773  2  91 14                STA     (vptr),Y
003775  2  A9 0B                LDA     #C_BORDER
003777  2  91 16                STA     (cptr),Y
003779  2  E8                   INX
00377A  2  E0 15                CPX     #(VPY0+VPH)
00377C  2  D0 E1                BNE     @vbar
00377E  2               
00377E  2               ; viewport bottom rule + message divider share row VPY0+VPH
00377E  2               ; (= MSGY0-1).  Draw it full-width.
00377E  2  A9 15                LDA     #(VPY0+VPH)
003780  2  85 21                STA     tmp1
003782  2  A9 00                LDA     #0
003784  2  85 22                STA     tmp2
003786  2  A9 3D                LDA     #'='
003788  2  85 23                STA     tmp3
00378A  2  A9 0B                LDA     #C_BORDER
00378C  2  85 26                STA     colidx
00378E  2  A9 50                LDA     #SCRW
003790  2  85 24                STA     cnt0
003792  2  20 2A 37             JSR     fillrow_vram
003795  2               
003795  2               ; panel header row (row 1) background highlight
003795  2  A9 01                LDA     #1
003797  2  85 21                STA     tmp1
003799  2  A9 2E                LDA     #(VPW+2)
00379B  2  85 22                STA     tmp2
00379D  2  A9 20                LDA     #space
00379F  2  85 23                STA     tmp3
0037A1  2  A9 1E                LDA     #C_PANELHDR
0037A3  2  85 26                STA     colidx
0037A5  2  A9 22                LDA     #(SCRW-(VPW+2))
0037A7  2  85 24                STA     cnt0
0037A9  2  20 2A 37             JSR     fillrow_vram
0037AC  2               
0037AC  2  20 97 36             JSR     vid_exit
0037AF  2               
0037AF  2               ; write the title bar + panel header text via firmware
0037AF  2  A2 1E                LDX     #30
0037B1  2  A0 00                LDY     #0
0037B3  2  20 D6 37             JSR     locate
0037B6  2  A9 0E                LDA     #C_TITLE
0037B8  2  8D 4A 06             STA     CURCOLOR
0037BB  2  A9 79 A0 39          PRINTMSG titlebar
0037BF  2  20 E8 37     
0037C2  2               
0037C2  2  A2 30                LDX     #(VPW+4)
0037C4  2  A0 01                LDY     #1
0037C6  2  20 D6 37             JSR     locate
0037C9  2  A9 1E                LDA     #C_PANELHDR
0037CB  2  8D 4A 06             STA     CURCOLOR
0037CE  2  A9 8D A0 39          PRINTMSG panelhdr
0037D2  2  20 E8 37     
0037D5  2  60                   RTS
0037D6  2               
0037D6  2               ;----------------------------------------------------------------
0037D6  2               ; locate - position the firmware text cursor.  X=col, Y=row.
0037D6  2               ;----------------------------------------------------------------
0037D6  2               locate:
0037D6  2  A9 25 85 32          FARCALL FC_LOCATE
0037DA  2  20 F0 FF     
0037DD  2  60                   RTS
0037DE  2               
0037DE  2               ;----------------------------------------------------------------
0037DE  2               ; putc - output one char via firmware (A=char), honoring CURCOLOR.
0037DE  2               ;        (Cannot use the FARCALL macro - it would clobber the char
0037DE  2               ;         in A.  Set farfunct, then restore A before the call.)
0037DE  2               ;----------------------------------------------------------------
0037DE  2               putc:
0037DE  2  48                   PHA
0037DF  2  A9 13                LDA     #FC_CHROUT
0037E1  2  85 32                STA     farfunct
0037E3  2  68                   PLA
0037E4  2  20 F0 FF             JSR     DO_FARCALL
0037E7  2  60                   RTS
0037E8  2               
0037E8  2               ;----------------------------------------------------------------
0037E8  2               ; prmsg - print a 0-terminated string via firmware chrout.
0037E8  2               ;   IN: A=lo, Y=hi of string address.  Uses CURCOLOR for color.
0037E8  2               ;----------------------------------------------------------------
0037E8  2               prmsg:
0037E8  2  85 1C                STA     strp
0037EA  2  84 1D                STY     strp+1
0037EC  2  A0 00                LDY     #0
0037EE  2               @pl:
0037EE  2  B1 1C                LDA     (strp),Y
0037F0  2  F0 08                BEQ     @done
0037F2  2  5A                   PHY
0037F3  2  20 DE 37             JSR     putc
0037F6  2  7A                   PLY
0037F7  2  C8                   INY
0037F8  2  D0 F4                BNE     @pl
0037FA  2               @done:
0037FA  2  60                   RTS
0037FB  2               
0037FB  2               ;----------------------------------------------------------------
0037FB  2               ; putxy - position cursor (X=col,Y=row), set color (A=color),
0037FB  2               ;         then print string at strp.  Helper for panel fields.
0037FB  2               ;   IN: tmp2=col, tmp1=row, colidx=color, strp=string ptr
0037FB  2               ;----------------------------------------------------------------
0037FB  2               putxy:
0037FB  2  A6 22                LDX     tmp2
0037FD  2  A4 21                LDY     tmp1
0037FF  2  20 D6 37             JSR     locate
003802  2  A5 26                LDA     colidx
003804  2  8D 4A 06             STA     CURCOLOR
003807  2  A5 1C                LDA     strp
003809  2  A4 1D                LDY     strp+1
00380B  2  20 E8 37             JSR     prmsg
00380E  2  60                   RTS
00380F  2               
00380F  2               ;----------------------------------------------------------------
00380F  2               ; clear_panel_value - blank a panel field area before redraw.
00380F  2               ;   IN: X=col, Y=row, A=width
00380F  2               ;----------------------------------------------------------------
00380F  2               clear_panel_value:
00380F  2  85 25                STA     cnt1            ; width
003811  2  20 D6 37             JSR     locate
003814  2  A9 0F                LDA     #C_PANEL
003816  2  8D 4A 06             STA     CURCOLOR
003819  2               @cpv:
003819  2  A9 20                LDA     #space
00381B  2  20 DE 37             JSR     putc
00381E  2  C6 25                DEC     cnt1
003820  2  D0 F7                BNE     @cpv
003822  2  60                   RTS
003823  2               
003823  2               ;----------------------------------------------------------------
003823  2               ; render_view - draw the scrolling map viewport centered on the
003823  2               ; player. Each world tile is a 2x2 character-cell metatile.
003823  2               ;
003823  2               ;   uses: px,py (player world coords), loc (active map)
003823  2               ;   The top-left WORLD cell shown is (px-VPCX, py-VPCY).
003823  2               ;----------------------------------------------------------------
003823  2               render_view:
003823  2  20 88 36             JSR     vid_enter
003826  2               ; world-tile row = 0..VPTH-1
003826  2  A9 00                LDA     #0
003828  2  85 27                STA     rowidx
00382A  2               @vrow:
00382A  2               ; world y for this row = py - VPCY + rowidx
00382A  2  38                   SEC
00382B  2  AD 6B 51             LDA     py
00382E  2  E9 05                SBC     #VPCY
003830  2  18                   CLC
003831  2  65 27                ADC     rowidx
003833  2  85 2D                STA     tgty
003835  2               ; world-tile column loop
003835  2  A9 00                LDA     #0
003837  2  85 26                STA     colidx
003839  2               @vcol:
003839  2               ; world x = px - VPCX + colidx
003839  2  38                   SEC
00383A  2  AD 6A 51             LDA     px
00383D  2  E9 0B                SBC     #VPCX
00383F  2  18                   CLC
003840  2  65 26                ADC     colidx
003842  2  85 2C                STA     tgtx
003844  2               ; fetch tile (returns tgttile)
003844  2  20 53 1A             JSR     tileat
003847  2               ; metatile base glyph = MG_TERRAIN_BASE + tile_code*4
003847  2  A5 2E                LDA     tgttile
003849  2  0A                   ASL     A
00384A  2  0A                   ASL     A
00384B  2  18                   CLC
00384C  2  69 80                ADC     #MG_TERRAIN_BASE
00384E  2  85 24                STA     cnt0
003850  2  A6 2E                LDX     tgttile
003852  2  BD EB 18             LDA     tile_color,X
003855  2  85 25                STA     cnt1
003857  2               ; pick an alternate art variant for some cells so large regions of
003857  2               ; one terrain don't show an obvious repeating grid. A terrain has a
003857  2               ; variant iff tile_variant[code] != 0; we use it when the cheap
003857  2               ; position hash (tgtx ^ tgty) bit0 is set.
003857  2  BD FC 18             LDA     tile_variant,X
00385A  2  F0 0D                BEQ     @novar          ; this terrain has no variant
00385C  2  A5 2C                LDA     tgtx
00385E  2  45 2D                EOR     tgty
003860  2  29 01                AND     #$01
003862  2  F0 05                BEQ     @novar          ; hash says keep the base art
003864  2  BD FC 18             LDA     tile_variant,X  ; swap in the variant metatile base
003867  2  85 24                STA     cnt0
003869  2               @novar:
003869  2               ; screen column = VPX0 + colidx*2
003869  2  A5 26                LDA     colidx
00386B  2  0A                   ASL     A
00386C  2  18                   CLC
00386D  2  69 01                ADC     #VPX0
00386F  2  85 22                STA     tmp2
003871  2               ; screen row = VPY0 + rowidx*2
003871  2  A5 27                LDA     rowidx
003873  2  0A                   ASL     A
003874  2  18                   CLC
003875  2  69 01                ADC     #VPY0
003877  2  85 23                STA     tmp3
003879  2  20 C6 38             JSR     blit_metatile_vram
00387C  2               ; next column
00387C  2  E6 26                INC     colidx
00387E  2  A5 26                LDA     colidx
003880  2  C9 16                CMP     #VPTW
003882  2  D0 B5                BNE     @vcol
003884  2               ; next row
003884  2  E6 27                INC     rowidx
003886  2  A5 27                LDA     rowidx
003888  2  C9 0A                CMP     #VPTH
00388A  2  D0 9E                BNE     @vrow
00388C  2               
00388C  2               ; --- overlay monsters that fall within the viewport ---
00388C  2  20 C7 3E             JSR     draw_monsters_vram
00388F  2               
00388F  2               ; --- overlay the dragon's warned fire lane ---
00388F  2  20 F7 3E             JSR     draw_dragon_telegraph_vram
003892  2               
003892  2               ; --- overlay fixed location characters ---
003892  2  20 AB 38             JSR     draw_castle_ruler_vram
003895  2               
003895  2               ; --- overlay the player at the fixed center metatile ---
003895  2  A9 C4                LDA     #MG_PLAYER
003897  2  85 24                STA     cnt0
003899  2  A9 0F                LDA     #C_PLAYER
00389B  2  85 25                STA     cnt1
00389D  2  A9 17                LDA     #(VPX0+(VPCX*2))
00389F  2  85 22                STA     tmp2
0038A1  2  A9 0B                LDA     #(VPY0+(VPCY*2))
0038A3  2  85 23                STA     tmp3
0038A5  2  20 03 39             JSR     blit_entity_vram
0038A8  2               
0038A8  2  4C 97 36             JMP     vid_exit
0038AB  2               
0038AB  2               ;----------------------------------------------------------------
0038AB  2               ; draw_castle_ruler_vram - draw the ruler over the audience-room
0038AB  2               ; throne using the player silhouette in royal colors.
0038AB  2               ;----------------------------------------------------------------
0038AB  2               draw_castle_ruler_vram:
0038AB  2  AD 77 51             LDA     loc
0038AE  2  C9 03                CMP     #LOC_CASTLE
0038B0  2  D0 13                BNE     @done
0038B2  2  A9 0F                LDA     #CASTLE_RULER_X
0038B4  2  85 2C                STA     tgtx
0038B6  2  A9 04                LDA     #CASTLE_RULER_Y
0038B8  2  85 2D                STA     tgty
0038BA  2  A9 C4                LDA     #MG_PLAYER
0038BC  2  85 24                STA     cnt0
0038BE  2  A9 4E                LDA     #COLOR(CO_BRYELLOW,CO_RED)
0038C0  2  85 25                STA     cnt1
0038C2  2  4C 4B 39             JMP     plot_view_cell
0038C5  2               @done:
0038C5  2  60                   RTS
0038C6  2               
0038C6  2               ;----------------------------------------------------------------
0038C6  2               ; blit_metatile_vram - draw a 2x2 terrain metatile with one color.
0038C6  2               ;   IN: cnt0=base glyph, cnt1=color, tmp2=screen col, tmp3=screen row
0038C6  2               ;   MUST be called inside vid_enter/vid_exit.
0038C6  2               ;----------------------------------------------------------------
0038C6  2               blit_metatile_vram:
0038C6  2  A5 23                LDA     tmp3
0038C8  2  20 9D 36             JSR     rowbase
0038CB  2  A4 22                LDY     tmp2
0038CD  2  A5 24                LDA     cnt0
0038CF  2  91 14                STA     (vptr),Y
0038D1  2  A5 25                LDA     cnt1
0038D3  2  91 16                STA     (cptr),Y
0038D5  2  C8                   INY
0038D6  2  A5 24                LDA     cnt0
0038D8  2  18                   CLC
0038D9  2  69 01                ADC     #1
0038DB  2  91 14                STA     (vptr),Y
0038DD  2  A5 25                LDA     cnt1
0038DF  2  91 16                STA     (cptr),Y
0038E1  2               
0038E1  2  A5 23                LDA     tmp3
0038E3  2  18                   CLC
0038E4  2  69 01                ADC     #1
0038E6  2  20 9D 36             JSR     rowbase
0038E9  2  A4 22                LDY     tmp2
0038EB  2  A5 24                LDA     cnt0
0038ED  2  18                   CLC
0038EE  2  69 02                ADC     #2
0038F0  2  91 14                STA     (vptr),Y
0038F2  2  A5 25                LDA     cnt1
0038F4  2  91 16                STA     (cptr),Y
0038F6  2  C8                   INY
0038F7  2  A5 24                LDA     cnt0
0038F9  2  18                   CLC
0038FA  2  69 03                ADC     #3
0038FC  2  91 14                STA     (vptr),Y
0038FE  2  A5 25                LDA     cnt1
003900  2  91 16                STA     (cptr),Y
003902  2  60                   RTS
003903  2               
003903  2               ;----------------------------------------------------------------
003903  2               ; blit_entity_vram - overlay a 2x2 entity metatile while preserving
003903  2               ; each terrain cell's background color.
003903  2               ;   IN: cnt0=base glyph, cnt1=entity color, tmp2=screen col,
003903  2               ;       tmp3=screen row
003903  2               ;   MUST be called inside vid_enter/vid_exit.
003903  2               ;----------------------------------------------------------------
003903  2               blit_entity_vram:
003903  2  A5 23                LDA     tmp3
003905  2  20 9D 36             JSR     rowbase
003908  2  A4 22                LDY     tmp2
00390A  2  A5 24                LDA     cnt0
00390C  2  91 14                STA     (vptr),Y
00390E  2  20 3C 39             JSR     entity_color_at_y
003911  2  C8                   INY
003912  2  A5 24                LDA     cnt0
003914  2  18                   CLC
003915  2  69 01                ADC     #1
003917  2  91 14                STA     (vptr),Y
003919  2  20 3C 39             JSR     entity_color_at_y
00391C  2               
00391C  2  A5 23                LDA     tmp3
00391E  2  18                   CLC
00391F  2  69 01                ADC     #1
003921  2  20 9D 36             JSR     rowbase
003924  2  A4 22                LDY     tmp2
003926  2  A5 24                LDA     cnt0
003928  2  18                   CLC
003929  2  69 02                ADC     #2
00392B  2  91 14                STA     (vptr),Y
00392D  2  20 3C 39             JSR     entity_color_at_y
003930  2  C8                   INY
003931  2  A5 24                LDA     cnt0
003933  2  18                   CLC
003934  2  69 03                ADC     #3
003936  2  91 14                STA     (vptr),Y
003938  2  20 3C 39             JSR     entity_color_at_y
00393B  2  60                   RTS
00393C  2               
00393C  2               ; preserve background nibble at the current cptr,Y; apply cnt1 foreground
00393C  2               entity_color_at_y:
00393C  2  B1 16                LDA     (cptr),Y
00393E  2  29 F0                AND     #$F0
003940  2  85 20                STA     tmp0
003942  2  A5 25                LDA     cnt1
003944  2  29 0F                AND     #$0F
003946  2  05 20                ORA     tmp0
003948  2  91 16                STA     (cptr),Y
00394A  2  60                   RTS
00394B  2               
00394B  2               ;----------------------------------------------------------------
00394B  2               ; plot_view_cell - overlay an entity metatile at WORLD coords
00394B  2               ; (tgtx,tgty) if it is visible.
00394B  2               ;   IN: tgtx,tgty=world coords, cnt0=base glyph, cnt1=color
00394B  2               ;   MUST be called inside vid_enter/vid_exit.
00394B  2               ;----------------------------------------------------------------
00394B  2               plot_view_cell:
00394B  2               ; viewport tile column = tgtx - px + VPCX
00394B  2  38                   SEC
00394C  2  A5 2C                LDA     tgtx
00394E  2  ED 6A 51             SBC     px
003951  2  18                   CLC
003952  2  69 0B                ADC     #VPCX
003954  2               ; must be 0..VPTW-1
003954  2  30 22                BMI     @no             ; (signed underflow check via N flag)
003956  2  C9 16                CMP     #VPTW
003958  2  B0 1E                BCS     @no
00395A  2  0A                   ASL     A
00395B  2  18                   CLC
00395C  2  69 01                ADC     #VPX0
00395E  2  85 22                STA     tmp2            ; screen column
003960  2               ; viewport tile row = tgty - py + VPCY
003960  2  38                   SEC
003961  2  A5 2D                LDA     tgty
003963  2  ED 6B 51             SBC     py
003966  2  18                   CLC
003967  2  69 05                ADC     #VPCY
003969  2  30 0D                BMI     @no
00396B  2  C9 0A                CMP     #VPTH
00396D  2  B0 09                BCS     @no
00396F  2  0A                   ASL     A
003970  2  18                   CLC
003971  2  69 01                ADC     #VPY0
003973  2  85 23                STA     tmp3            ; screen row
003975  2  4C 03 39             JMP     blit_entity_vram
003978  2               @no:
003978  2  60                   RTS
003979  2               
003979  2               ;----------------------------------------------------------------
003979  2               ; Static UI strings
003979  2               ;----------------------------------------------------------------
003979  2               titlebar:
003979  2  3D 20 57 20          .BYTE   "= W Y R M H O L D =",0
00397D  2  59 20 52 20  
003981  2  4D 20 48 20  
00398D  2               panelhdr:
00398D  2  41 44 56 45          .BYTE   "ADVENTURER",0
003991  2  4E 54 55 52  
003995  2  45 52 00     
003998  2               
003998  1                       .INCLUDE "ui.asm"
003998  2               ;______________________________________________________________________________
003998  2               ;  ui.asm - message log, stat panel, prompts, decimal output
003998  2               ;______________________________________________________________________________
003998  2               
003998  2               ;----------------------------------------------------------------
003998  2               ; displaynum - print the 16-bit value in numarg as decimal using
003998  2               ;              the firmware (honours CURCOLOR).  No leading spaces.
003998  2               ;              (adapted from speedscript displaynum)
003998  2               ;----------------------------------------------------------------
003998  2               displaynum:
003998  2  A0 08                LDY     #8              ; index into nums (5 entries x2 bytes)
00399A  2               @find:
00399A  2  A5 1F                LDA     numarg+1
00399C  2  D9 E2 39             CMP     nums+1,Y
00399F  2  90 09                BCC     @next
0039A1  2  D0 0B                BNE     @start
0039A3  2  A5 1E                LDA     numarg
0039A5  2  D9 E1 39             CMP     nums,Y
0039A8  2  B0 04                BCS     @start
0039AA  2               @next:
0039AA  2  88                   DEY
0039AB  2  88                   DEY
0039AC  2  D0 EC                BNE     @find
0039AE  2               @start:
0039AE  2  A9 30                LDA     #'0'
0039B0  2  85 28                STA     numspace
0039B2  2               @dig:
0039B2  2  A5 1F                LDA     numarg+1
0039B4  2  D9 E2 39             CMP     nums+1,Y
0039B7  2  90 1E                BCC     @out
0039B9  2  D0 09                BNE     @nocmp
0039BB  2  A5 1E                LDA     numarg
0039BD  2  F9 E1 39             SBC     nums,Y          ; carry set
0039C0  2  90 15                BCC     @out
0039C2  2  B0 05                BCS     @sub
0039C4  2               @nocmp:
0039C4  2  A5 1E                LDA     numarg
0039C6  2  F9 E1 39             SBC     nums,Y          ; carry set
0039C9  2               @sub:
0039C9  2  E6 28                INC     numspace
0039CB  2  85 1E                STA     numarg
0039CD  2  A5 1F                LDA     numarg+1
0039CF  2  F9 E2 39             SBC     nums+1,Y
0039D2  2  85 1F                STA     numarg+1
0039D4  2  4C B2 39             JMP     @dig
0039D7  2               @out:
0039D7  2  A5 28                LDA     numspace
0039D9  2  20 DE 37             JSR     putc
0039DC  2  88                   DEY
0039DD  2  88                   DEY
0039DE  2  10 CE                BPL     @start
0039E0  2  60                   RTS
0039E1  2               
0039E1  2               ; place value table (1,10,100,1000,10000) as 16-bit LE words
0039E1  2               nums:
0039E1  2  01 00                .WORD   1
0039E3  2  0A 00                .WORD   10
0039E5  2  64 00                .WORD   100
0039E7  2  E8 03                .WORD   1000
0039E9  2  10 27                .WORD   10000
0039EB  2               
0039EB  2               ;----------------------------------------------------------------
0039EB  2               ; print a single 8-bit value (in A) as decimal.
0039EB  2               ;----------------------------------------------------------------
0039EB  2               print_byte:
0039EB  2  85 1E                STA     numarg
0039ED  2  A9 00                LDA     #0
0039EF  2  85 1F                STA     numarg+1
0039F1  2  4C 98 39             JMP     displaynum
0039F4  2               
0039F4  2               ;----------------------------------------------------------------
0039F4  2               ; Message log: two lines at rows MSGY0 and MSGY0+1.
0039F4  2               ; msg_print scrolls the bottom line up and prints a new line.
0039F4  2               ;
0039F4  2               ;   msg_print:  IN A=lo,Y=hi of 0-terminated string
0039F4  2               ;----------------------------------------------------------------
0039F4  2               msg_print:
0039F4  2  85 1C                STA     strp
0039F6  2  84 1D                STY     strp+1
0039F8  2               ; copy current bottom line (msgbuf1) up to (msgbuf0)
0039F8  2  A2 00                LDX     #0
0039FA  2               @up:
0039FA  2  BD E0 51             LDA     msgbuf1,X
0039FD  2  9D 90 51             STA     msgbuf0,X
003A00  2  E8                   INX
003A01  2  E0 50                CPX     #SCRW
003A03  2  D0 F5                BNE     @up
003A05  2               ; copy new string into msgbuf1 (truncate/pad to SCRW)
003A05  2  A0 00                LDY     #0
003A07  2               @cp:
003A07  2  B1 1C                LDA     (strp),Y
003A09  2  F0 0B                BEQ     @padb
003A0B  2  99 E0 51             STA     msgbuf1,Y
003A0E  2  C8                   INY
003A0F  2  C0 50                CPY     #SCRW
003A11  2  D0 F4                BNE     @cp
003A13  2  4C 20 3A             JMP     @draw
003A16  2               @padb:
003A16  2  A9 20                LDA     #space
003A18  2               @pad:
003A18  2  99 E0 51             STA     msgbuf1,Y
003A1B  2  C8                   INY
003A1C  2  C0 50                CPY     #SCRW
003A1E  2  D0 F8                BNE     @pad
003A20  2               @draw:
003A20  2  4C 23 3A             JMP     msg_redraw
003A23  2               
003A23  2               ;----------------------------------------------------------------
003A23  2               ; msg_redraw - blit both message buffers to the message rows via
003A23  2               ;              direct VRAM (so it does not disturb the text cursor).
003A23  2               ;----------------------------------------------------------------
003A23  2               msg_redraw:
003A23  2  20 88 36             JSR     vid_enter
003A26  2               ; row MSGY0 <- msgbuf0
003A26  2  A9 16                LDA     #MSGY0
003A28  2  20 9D 36             JSR     rowbase
003A2B  2  A0 00                LDY     #0
003A2D  2               @r0:
003A2D  2  B9 90 51             LDA     msgbuf0,Y
003A30  2  91 14                STA     (vptr),Y
003A32  2  A9 0F                LDA     #C_MSG
003A34  2  91 16                STA     (cptr),Y
003A36  2  C8                   INY
003A37  2  C0 50                CPY     #SCRW
003A39  2  D0 F2                BNE     @r0
003A3B  2               ; row MSGY0+1 <- msgbuf1
003A3B  2  A9 17                LDA     #MSGY0+1
003A3D  2  20 9D 36             JSR     rowbase
003A40  2  A0 00                LDY     #0
003A42  2               @r1:
003A42  2  B9 E0 51             LDA     msgbuf1,Y
003A45  2  91 14                STA     (vptr),Y
003A47  2  A9 0F                LDA     #C_MSG
003A49  2  91 16                STA     (cptr),Y
003A4B  2  C8                   INY
003A4C  2  C0 50                CPY     #SCRW
003A4E  2  D0 F2                BNE     @r1
003A50  2  4C 97 36             JMP     vid_exit
003A53  2               
003A53  2               ;----------------------------------------------------------------
003A53  2               ; msg_clear - blank both message buffers and redraw.
003A53  2               ;----------------------------------------------------------------
003A53  2               msg_clear:
003A53  2  A2 00                LDX     #0
003A55  2  A9 20                LDA     #space
003A57  2               @mc:
003A57  2  9D 90 51             STA     msgbuf0,X
003A5A  2  9D E0 51             STA     msgbuf1,X
003A5D  2  E8                   INX
003A5E  2  E0 50                CPX     #SCRW
003A60  2  D0 F5                BNE     @mc
003A62  2  4C 23 3A             JMP     msg_redraw
003A65  2               
003A65  2               ;----------------------------------------------------------------
003A65  2               ; Stat panel.  Drawn on the right side using firmware text output.
003A65  2               ; Labels are static; values are redrawn each turn.
003A65  2               ;----------------------------------------------------------------
003A65  2               draw_panel:
003A65  2               ; HP line:  "HP   : nn/nn"
003A65  2  A2 30                LDX     #PANX
003A67  2  A0 03                LDY     #3
003A69  2  20 D6 37             JSR     locate
003A6C  2  A9 0F                LDA     #C_PANEL
003A6E  2  8D 4A 06             STA     CURCOLOR
003A71  2  A9 0A A0 3C          PRINTMSG lbl_hp
003A75  2  20 E8 37     
003A78  2  AD 6C 51             LDA     phealth
003A7B  2  20 EB 39             JSR     print_byte
003A7E  2  A9 2F                LDA     #'/'
003A80  2  20 DE 37             JSR     putc
003A83  2  AD 6D 51             LDA     pmaxhp
003A86  2  20 EB 39             JSR     print_byte
003A89  2  20 84 3B             JSR     pad_clear       ; clear trailing junk
003A8C  2               
003A8C  2               ; Level / XP
003A8C  2  A2 30                LDX     #PANX
003A8E  2  A0 05                LDY     #5
003A90  2  20 D6 37             JSR     locate
003A93  2  A9 12 A0 3C          PRINTMSG lbl_lvl
003A97  2  20 E8 37     
003A9A  2  AD 6E 51             LDA     plevel
003A9D  2  20 EB 39             JSR     print_byte
003AA0  2  A2 3C                LDX     #PANX+12
003AA2  2  A0 05                LDY     #5
003AA4  2  20 D6 37             JSR     locate
003AA7  2  A9 18 A0 3C          PRINTMSG lbl_xp
003AAB  2  20 E8 37     
003AAE  2  AD 6F 51 85          COPY16  pxp, numarg
003AB2  2  1E AD 70 51  
003AB6  2  85 1F        
003AB8  2  20 98 39             JSR     displaynum
003ABB  2  20 84 3B             JSR     pad_clear
003ABE  2               
003ABE  2               ; Gold / Food
003ABE  2  A2 30                LDX     #PANX
003AC0  2  A0 07                LDY     #7
003AC2  2  20 D6 37             JSR     locate
003AC5  2  A9 1D A0 3C          PRINTMSG lbl_gold
003AC9  2  20 E8 37     
003ACC  2  AD 71 51 85          COPY16  pgold, numarg
003AD0  2  1E AD 72 51  
003AD4  2  85 1F        
003AD6  2  20 98 39             JSR     displaynum
003AD9  2  A2 3C                LDX     #PANX+12
003ADB  2  A0 07                LDY     #7
003ADD  2  20 D6 37             JSR     locate
003AE0  2  A9 24 A0 3C          PRINTMSG lbl_food
003AE4  2  20 E8 37     
003AE7  2  AD 73 51 85          COPY16  pfood, numarg
003AEB  2  1E AD 74 51  
003AEF  2  85 1F        
003AF1  2  20 98 39             JSR     displaynum
003AF4  2  20 84 3B             JSR     pad_clear
003AF7  2               
003AF7  2               ; Weapon
003AF7  2  A2 30                LDX     #PANX
003AF9  2  A0 09                LDY     #9
003AFB  2  20 D6 37             JSR     locate
003AFE  2  A9 2B A0 3C          PRINTMSG lbl_wpn
003B02  2  20 E8 37     
003B05  2  AD 75 51             LDA     pweapon
003B08  2  20 94 3B             JSR     name_weapon     ; strp -> name
003B0B  2  A5 1C                LDA     strp
003B0D  2  A4 1D                LDY     strp+1
003B0F  2  20 E8 37             JSR     prmsg
003B12  2  20 84 3B             JSR     pad_clear
003B15  2               
003B15  2               ; Armor
003B15  2  A2 30                LDX     #PANX
003B17  2  A0 0A                LDY     #10
003B19  2  20 D6 37             JSR     locate
003B1C  2  A9 34 A0 3C          PRINTMSG lbl_arm
003B20  2  20 E8 37     
003B23  2  AD 76 51             LDA     parmor
003B26  2  20 A1 3B             JSR     name_armor
003B29  2  A5 1C                LDA     strp
003B2B  2  A4 1D                LDY     strp+1
003B2D  2  20 E8 37             JSR     prmsg
003B30  2  20 84 3B             JSR     pad_clear
003B33  2               
003B33  2               ; Location
003B33  2  A2 30                LDX     #PANX
003B35  2  A0 0C                LDY     #12
003B37  2  20 D6 37             JSR     locate
003B3A  2  A9 3D A0 3C          PRINTMSG lbl_loc
003B3E  2  20 E8 37     
003B41  2  AD 77 51             LDA     loc
003B44  2  20 AE 3B             JSR     name_loc
003B47  2  A5 1C                LDA     strp
003B49  2  A4 1D                LDY     strp+1
003B4B  2  20 E8 37             JSR     prmsg
003B4E  2  20 84 3B             JSR     pad_clear
003B51  2               
003B51  2               ; Current objective
003B51  2  A2 30                LDX     #PANX
003B53  2  A0 0E                LDY     #14
003B55  2  20 D6 37             JSR     locate
003B58  2  A9 1E                LDA     #C_PANELHDR
003B5A  2  8D 4A 06             STA     CURCOLOR
003B5D  2  A9 46 A0 3C          PRINTMSG lbl_obj
003B61  2  20 E8 37     
003B64  2  20 84 3B             JSR     pad_clear
003B67  2  A2 30                LDX     #PANX
003B69  2  A0 0F                LDY     #15
003B6B  2  20 D6 37             JSR     locate
003B6E  2  A9 0F                LDA     #C_PANEL
003B70  2  8D 4A 06             STA     CURCOLOR
003B73  2  AD 7D 51             LDA     queststate
003B76  2  20 BB 3B             JSR     name_objective
003B79  2  A5 1C                LDA     strp
003B7B  2  A4 1D                LDY     strp+1
003B7D  2  20 E8 37             JSR     prmsg
003B80  2  20 84 3B             JSR     pad_clear
003B83  2  60                   RTS
003B84  2               
003B84  2               ; pad_clear - print spaces out to the right screen edge to erase
003B84  2               ;             any leftover characters from a previous longer value.
003B84  2               ;             Stops at the last column to avoid auto-scroll.
003B84  2               pad_clear:
003B84  2               @pc:
003B84  2  AD 47 06             LDA     CURX
003B87  2  C9 4F                CMP     #SCRW-1
003B89  2  B0 08                BCS     @done
003B8B  2  A9 20                LDA     #space
003B8D  2  20 DE 37             JSR     putc
003B90  2  4C 84 3B             JMP     @pc
003B93  2               @done:
003B93  2  60                   RTS
003B94  2               
003B94  2               ;----------------------------------------------------------------
003B94  2               ; name_weapon / name_armor / name_loc - set strp to a name string
003B94  2               ;   IN: A = index
003B94  2               ;----------------------------------------------------------------
003B94  2               name_weapon:
003B94  2  0A                   ASL     A
003B95  2  AA                   TAX
003B96  2  BD 50 3C             LDA     wpn_names,X
003B99  2  85 1C                STA     strp
003B9B  2  BD 51 3C             LDA     wpn_names+1,X
003B9E  2  85 1D                STA     strp+1
003BA0  2  60                   RTS
003BA1  2               name_armor:
003BA1  2  0A                   ASL     A
003BA2  2  AA                   TAX
003BA3  2  BD 6F 3C             LDA     arm_names,X
003BA6  2  85 1C                STA     strp
003BA8  2  BD 70 3C             LDA     arm_names+1,X
003BAB  2  85 1D                STA     strp+1
003BAD  2  60                   RTS
003BAE  2               name_loc:
003BAE  2  0A                   ASL     A
003BAF  2  AA                   TAX
003BB0  2  BD 93 3C             LDA     loc_names,X
003BB3  2  85 1C                STA     strp
003BB5  2  BD 94 3C             LDA     loc_names+1,X
003BB8  2  85 1D                STA     strp+1
003BBA  2  60                   RTS
003BBB  2               name_objective:
003BBB  2  0A                   ASL     A
003BBC  2  AA                   TAX
003BBD  2  BD D1 3C             LDA     objective_names,X
003BC0  2  85 1C                STA     strp
003BC2  2  BD D2 3C             LDA     objective_names+1,X
003BC5  2  85 1D                STA     strp+1
003BC7  2  60                   RTS
003BC8  2               
003BC8  2               ;----------------------------------------------------------------
003BC8  2               ; yorn - wait for a Y/N keypress.  Returns Z=1 if Yes (A='Y').
003BC8  2               ;----------------------------------------------------------------
003BC8  2               yorn:
003BC8  2               @wait:
003BC8  2  20 E4 3B             JSR     getkey_block
003BCB  2  C9 59                CMP     #'Y'
003BCD  2  F0 0F                BEQ     @yes
003BCF  2  C9 79                CMP     #'y'
003BD1  2  F0 0B                BEQ     @yes
003BD3  2  C9 4E                CMP     #'N'
003BD5  2  F0 0A                BEQ     @no
003BD7  2  C9 6E                CMP     #'n'
003BD9  2  F0 06                BEQ     @no
003BDB  2  4C C8 3B             JMP     @wait
003BDE  2               @yes:
003BDE  2  A9 00                LDA     #0              ; Z=1
003BE0  2  60                   RTS
003BE1  2               @no:
003BE1  2  A9 01                LDA     #1              ; Z=0
003BE3  2  60                   RTS
003BE4  2               
003BE4  2               ;----------------------------------------------------------------
003BE4  2               ; getkey_block - block until a key is pressed; return it in A.
003BE4  2               ;----------------------------------------------------------------
003BE4  2               getkey_block:
003BE4  2               @gk:
003BE4  2  A9 14 85 32          FARCALL FC_CHRIN
003BE8  2  20 F0 FF     
003BEB  2  C9 FF                CMP     #$FF
003BED  2  F0 F5                BEQ     @gk
003BEF  2  60                   RTS
003BF0  2               
003BF0  2               ;----------------------------------------------------------------
003BF0  2               ; getkey - non-blocking read; A=key or 0 if none.
003BF0  2               ;----------------------------------------------------------------
003BF0  2               getkey:
003BF0  2  A9 14 85 32          FARCALL FC_CHRIN
003BF4  2  20 F0 FF     
003BF7  2  C9 FF                CMP     #$FF
003BF9  2  D0 02                BNE     @got
003BFB  2  A9 00                LDA     #0
003BFD  2               @got:
003BFD  2  60                   RTS
003BFE  2               
003BFE  2               ;----------------------------------------------------------------
003BFE  2               ; drainkeys - consume and discard all buffered keystrokes.
003BFE  2               ;----------------------------------------------------------------
003BFE  2               drainkeys:
003BFE  2               @dk:
003BFE  2  A9 14 85 32          FARCALL FC_CHRIN
003C02  2  20 F0 FF     
003C05  2  C9 FF                CMP     #$FF
003C07  2  D0 F5                BNE     @dk             ; got a key - keep draining
003C09  2  60                   RTS
003C0A  2               
003C0A  2               ;----------------------------------------------------------------
003C0A  2               ; Panel labels and name tables
003C0A  2               ;----------------------------------------------------------------
003C0A  2               lbl_hp:
003C0A  2  48 50 20 20          .BYTE   "HP   : ",0
003C0E  2  20 3A 20 00  
003C12  2               lbl_lvl:
003C12  2  4C 76 6C 3A          .BYTE   "Lvl: ",0
003C16  2  20 00        
003C18  2               lbl_xp:
003C18  2  58 50 3A 20          .BYTE   "XP: ",0
003C1C  2  00           
003C1D  2               lbl_gold:
003C1D  2  47 6F 6C 64          .BYTE   "Gold: ",0
003C21  2  3A 20 00     
003C24  2               lbl_food:
003C24  2  46 6F 6F 64          .BYTE   "Food: ",0
003C28  2  3A 20 00     
003C2B  2               lbl_wpn:
003C2B  2  57 65 61 70          .BYTE   "Weapon: ",0
003C2F  2  6F 6E 3A 20  
003C33  2  00           
003C34  2               lbl_arm:
003C34  2  41 72 6D 6F          .BYTE   "Armor : ",0
003C38  2  72 20 3A 20  
003C3C  2  00           
003C3D  2               lbl_loc:
003C3D  2  57 68 65 72          .BYTE   "Where : ",0
003C41  2  65 20 3A 20  
003C45  2  00           
003C46  2               lbl_obj:
003C46  2  4F 42 4A 45          .BYTE   "OBJECTIVE",0
003C4A  2  43 54 49 56  
003C4E  2  45 00        
003C50  2               
003C50  2               wpn_names:
003C50  2  58 3C 5E 3C          .WORD   wn0, wn1, wn2, wn3
003C54  2  65 3C 6B 3C  
003C58  2               wn0:
003C58  2  46 69 73 74          .BYTE   "Fists",0
003C5C  2  73 00        
003C5E  2               wn1:
003C5E  2  44 61 67 67          .BYTE   "Dagger",0
003C62  2  65 72 00     
003C65  2               wn2:
003C65  2  53 77 6F 72          .BYTE   "Sword",0
003C69  2  64 00        
003C6B  2               wn3:
003C6B  2  41 78 65 00          .BYTE   "Axe",0
003C6F  2               
003C6F  2               arm_names:
003C6F  2  77 3C 7F 3C          .WORD   an0, an1, an2, an3
003C73  2  87 3C 8D 3C  
003C77  2               an0:
003C77  2  43 6C 6F 74          .BYTE   "Clothes",0
003C7B  2  68 65 73 00  
003C7F  2               an1:
003C7F  2  4C 65 61 74          .BYTE   "Leather",0
003C83  2  68 65 72 00  
003C87  2               an2:
003C87  2  43 68 61 69          .BYTE   "Chain",0
003C8B  2  6E 00        
003C8D  2               an3:
003C8D  2  50 6C 61 74          .BYTE   "Plate",0
003C91  2  65 00        
003C93  2               
003C93  2               loc_names:
003C93  2  9D 3C A6 3C          .WORD   ln0, ln1, ln2, ln3, ln4
003C97  2  AB 3C B3 3C  
003C9B  2  C3 3C        
003C9D  2               ln0:
003C9D  2  57 79 72 6D          .BYTE   "Wyrmhold",0
003CA1  2  68 6F 6C 64  
003CA5  2  00           
