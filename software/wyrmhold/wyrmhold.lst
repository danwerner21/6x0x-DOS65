000C8D  1               
000C8D  1               ;==============================================================================
000C8D  1               ; Include the rest of the engine
000C8D  1               ;==============================================================================
000C8D  1                       .INCLUDE "rng.asm"
000C8D  2               ;______________________________________________________________________________
000C8D  2               ;  rng.asm - 16-bit xorshift pseudo-random generator
000C8D  2               ;______________________________________________________________________________
000C8D  2               
000C8D  2               ;----------------------------------------------------------------
000C8D  2               ; rng_seed - initialise the generator (avoid all-zero state).
000C8D  2               ;----------------------------------------------------------------
000C8D  2               rng_seed:
000C8D  2  A9 A3                LDA     #$A3
000C8F  2  85 30                STA     seedlo
000C91  2  A9 1C                LDA     #$1C
000C93  2  85 31                STA     seedhi
000C95  2  A9 00                LDA     #0
000C97  2  85 33                STA     seed2lo
000C99  2  85 34                STA     seed2hi
000C9B  2  60                   RTS
000C9C  2               
000C9C  2               ;----------------------------------------------------------------
000C9C  2               ; rng_timing_tick - increment the title-screen timing counter.
000C9C  2               ;----------------------------------------------------------------
000C9C  2               rng_timing_tick:
000C9C  2  E6 33                INC     seed2lo
000C9E  2  D0 02                BNE     @done
000CA0  2  E6 34                INC     seed2hi
000CA2  2               @done:
000CA2  2  60                   RTS
000CA3  2               
000CA3  2               ;----------------------------------------------------------------
000CA3  2               ; rng_mix_timing - mix title wait time and accepted key into the
000CA3  2               ;                  generator, then diffuse the new state.
000CA3  2               ;                  IN: keych = accepted title-screen key
000CA3  2               ;----------------------------------------------------------------
000CA3  2               rng_mix_timing:
000CA3  2  A5 30                LDA     seedlo
000CA5  2  45 33                EOR     seed2lo
000CA7  2  45 29                EOR     keych
000CA9  2  85 30                STA     seedlo
000CAB  2               
000CAB  2  A5 29                LDA     keych
000CAD  2  0A                   ASL     A
000CAE  2  45 31                EOR     seedhi
000CB0  2  45 34                EOR     seed2hi
000CB2  2  85 31                STA     seedhi
000CB4  2               
000CB4  2               ; The xorshift generator must never enter its all-zero lockup state.
000CB4  2  A5 30                LDA     seedlo
000CB6  2  05 31                ORA     seedhi
000CB8  2  D0 08                BNE     @diffuse
000CBA  2  A9 A3                LDA     #$A3
000CBC  2  85 30                STA     seedlo
000CBE  2  A9 1C                LDA     #$1C
000CC0  2  85 31                STA     seedhi
000CC2  2               @diffuse:
000CC2  2  20 C8 0C             JSR     rng_next
000CC5  2  4C C8 0C             JMP     rng_next
000CC8  2               
000CC8  2               ;----------------------------------------------------------------
000CC8  2               ; rng_next - advance the 16-bit xorshift state, return low byte
000CC8  2               ;            in A.  (xorshift: x ^= x<<7; x ^= x>>9; x ^= x<<8)
000CC8  2               ;----------------------------------------------------------------
000CC8  2               rng_next:
000CC8  2               ; x ^= x << 7
000CC8  2  A5 31                LDA     seedhi
000CCA  2  4A                   LSR     A               ; carry = bit7 of hi after some shifts...
000CCB  2               ; Implement x<<7 via: shift left 7 = shift right 1 then swap?
000CCB  2               ; Simpler: do a byte-wise xorshift that is "good enough".
000CCB  2               ; x ^= x << 7
000CCB  2  A5 30                LDA     seedlo
000CCD  2  0A                   ASL     A
000CCE  2  0A                   ASL     A
000CCF  2  0A                   ASL     A
000CD0  2  0A                   ASL     A
000CD1  2  0A                   ASL     A
000CD2  2  0A                   ASL     A
000CD3  2  0A                   ASL     A               ; lo << 7 (only bit0 survives into bit7)
000CD4  2  45 31                EOR     seedhi
000CD6  2  85 31                STA     seedhi
000CD8  2               ; x ^= x >> 9  (>>9 of 16-bit = hi >> 1 into lo)
000CD8  2  A5 31                LDA     seedhi
000CDA  2  4A                   LSR     A
000CDB  2  45 30                EOR     seedlo
000CDD  2  85 30                STA     seedlo
000CDF  2               ; x ^= x << 8  (swap bytes contribution: lo ^ into hi)
000CDF  2  A5 30                LDA     seedlo
000CE1  2  45 31                EOR     seedhi
000CE3  2  85 31                STA     seedhi
000CE5  2  A5 30                LDA     seedlo
000CE7  2  60                   RTS
000CE8  2               
000CE8  2               ;----------------------------------------------------------------
000CE8  2               ; rng_mod - return a value 0..A-1 in A.  IN: A = modulus (1..255)
000CE8  2               ;           (uses repeated subtraction mask via AND for powers of
000CE8  2               ;            two is faster, but generic mod via subtract loop here)
000CE8  2               ;----------------------------------------------------------------
000CE8  2               rng_mod:
000CE8  2  85 23                STA     tmp3            ; modulus
000CEA  2  20 C8 0C             JSR     rng_next        ; A = random byte
000CED  2               ; reduce A mod tmp3 by subtraction
000CED  2               @rm:
000CED  2  C5 23                CMP     tmp3
000CEF  2  90 06                BCC     @done
000CF1  2  38                   SEC
000CF2  2  E5 23                SBC     tmp3
000CF4  2  4C ED 0C             JMP     @rm
000CF7  2               @done:
000CF7  2  60                   RTS
000CF8  2               
000CF8  2               ;----------------------------------------------------------------
000CF8  2               ; rng_d - roll a die: return 1..A in A.  IN: A = sides (1..255)
000CF8  2               ;----------------------------------------------------------------
000CF8  2               rng_d:
000CF8  2  20 E8 0C             JSR     rng_mod
000CFB  2  18                   CLC
000CFC  2  69 01                ADC     #1
000CFE  2  60                   RTS
000CFF  2               
000CFF  1                       .INCLUDE "sound.asm"
000CFF  2               ;______________________________________________________________________________
000CFF  2               ;  sound.asm - AY-3-8910 PSG sound effects and cooperative music player
000CFF  2               ;
000CFF  2               ;  PSG access ported from software/dbasic/ay38910.asm (PPI at $E230).
000CFF  2               ;  psgwr: A=register, Y=value        psgrd: A=register -> Y=value
000CFF  2               ;
000CFF  2               ;  AY register map:
000CFF  2               ;    0/1  ch A tone period (lo / hi 4 bits)
000CFF  2               ;    2/3  ch B tone period
000CFF  2               ;    4/5  ch C tone period
000CFF  2               ;    6    noise period (5 bits)
000CFF  2               ;    7    mixer: bit clear = enabled. 0-2 tone A/B/C, 3-5 noise A/B/C
000CFF  2               ;    8/9/10 ch A/B/C volume (0-15, bit4 = use envelope)
000CFF  2               ;    11/12 envelope period
000CFF  2               ;    13   envelope shape
000CFF  2               ;______________________________________________________________________________
000CFF  2               
000CFF  2               PPI_BASE        = $E230
000CFF  2               ppiPortA        = PPI_BASE+0
000CFF  2               ppiPortB        = PPI_BASE+1
000CFF  2               ppiPortC        = PPI_BASE+2
000CFF  2               ppiControl      = PPI_BASE+3
000CFF  2               
000CFF  2               ;----------------------------------------------------------------
000CFF  2               ; psg_init - put the PSG into a known, silent state
000CFF  2               ;----------------------------------------------------------------
000CFF  2               psg_init:
000CFF  2  A9 80                LDA     #%10000000
000D01  2  8D 33 E2             STA     ppiControl
000D04  2  A9 10                LDA     #%00010000
000D06  2  8D 32 E2             STA     ppiPortC
000D09  2  A9 00                LDA     #$00
000D0B  2  8D 31 E2             STA     ppiPortB
000D0E  2  20 12 0D             JSR     clrpsg
000D11  2  60                   RTS
000D12  2               
000D12  2               ;----------------------------------------------------------------
000D12  2               ; clrpsg - zero all 16 registers, then disable all channels
000D12  2               ;----------------------------------------------------------------
000D12  2               clrpsg:
000D12  2  A2 00                LDX     #00
000D14  2  A0 00                LDY     #00
000D16  2               @cp1:
000D16  2  8A                   TXA
000D17  2  20 44 0D             JSR     psgwr
000D1A  2  E8                   INX
000D1B  2  E0 10                CPX     #16
000D1D  2  D0 F7                BNE     @cp1
000D1F  2  A9 07                LDA     #07
000D21  2  A0 3F                LDY     #%00111111      ; all tone + noise disabled
000D23  2  20 44 0D             JSR     psgwr
000D26  2  60                   RTS
000D27  2               
000D27  2               ;----------------------------------------------------------------
000D27  2               ; psg_silence - silence all three channels (volumes -> 0)
000D27  2               ;----------------------------------------------------------------
000D27  2               psg_silence:
000D27  2  A9 08                LDA     #8
000D29  2  A0 00                LDY     #0
000D2B  2  20 44 0D             JSR     psgwr
000D2E  2  A9 09                LDA     #9
000D30  2  A0 00                LDY     #0
000D32  2  20 44 0D             JSR     psgwr
000D35  2  A9 0A                LDA     #10
000D37  2  A0 00                LDY     #0
000D39  2  20 44 0D             JSR     psgwr
000D3C  2  A9 07                LDA     #07
000D3E  2  A0 3F                LDY     #%00111111
000D40  2  20 44 0D             JSR     psgwr
000D43  2  60                   RTS
000D44  2               
000D44  2               ;----------------------------------------------------------------
000D44  2               ; psgwr - write Y into PSG register A     (trashes A)
000D44  2               ;----------------------------------------------------------------
000D44  2               psgwr:
000D44  2  8D 31 E2             STA     ppiPortB        ; select register
000D47  2  A9 1C                LDA     #%00011100      ; latch address
000D49  2  8D 32 E2             STA     ppiPortC
000D4C  2  8D 32 E2             STA     ppiPortC
000D4F  2  8D 32 E2             STA     ppiPortC
000D52  2  A9 10                LDA     #%00010000      ; inactive
000D54  2  8D 32 E2             STA     ppiPortC
000D57  2  8D 32 E2             STA     ppiPortC
000D5A  2  8D 32 E2             STA     ppiPortC
000D5D  2  98                   TYA
000D5E  2  8D 31 E2             STA     ppiPortB        ; store data
000D61  2  8D 31 E2             STA     ppiPortB
000D64  2  8D 31 E2             STA     ppiPortB
000D67  2  A9 14                LDA     #%00010100      ; latch data
000D69  2  8D 32 E2             STA     ppiPortC
000D6C  2  8D 32 E2             STA     ppiPortC
000D6F  2  8D 32 E2             STA     ppiPortC
000D72  2  A9 10                LDA     #%00010000      ; inactive
000D74  2  8D 32 E2             STA     ppiPortC
000D77  2  60                   RTS
000D78  2               
000D78  2               ;----------------------------------------------------------------
000D78  2               ; psgrd - read PSG register A into Y      (trashes A)
000D78  2               ;----------------------------------------------------------------
000D78  2               psgrd:
000D78  2  8D 31 E2             STA     ppiPortB        ; select register
000D7B  2  A9 1C                LDA     #%00011100      ; latch address
000D7D  2  8D 32 E2             STA     ppiPortC
000D80  2  8D 32 E2             STA     ppiPortC
000D83  2  8D 32 E2             STA     ppiPortC
000D86  2  A9 10                LDA     #%00010000      ; inactive
000D88  2  8D 32 E2             STA     ppiPortC
000D8B  2  8D 32 E2             STA     ppiPortC
000D8E  2  A9 82                LDA     #%10000010
000D90  2  8D 33 E2             STA     ppiControl
000D93  2  A9 18                LDA     #%00011000      ; latch data
000D95  2  8D 32 E2             STA     ppiPortC
000D98  2  8D 32 E2             STA     ppiPortC
000D9B  2  8D 32 E2             STA     ppiPortC
000D9E  2  AD 31 E2             LDA     ppiPortB        ; read data
000DA1  2  A8                   TAY
000DA2  2  A9 80                LDA     #%10000000
000DA4  2  8D 33 E2             STA     ppiControl
000DA7  2  A9 10                LDA     #%00010000      ; inactive
000DA9  2  8D 32 E2             STA     ppiPortC
000DAC  2  60                   RTS
000DAD  2               
000DAD  2               ;----------------------------------------------------------------
000DAD  2               ; tone_on - start a tone on channel A.
000DAD  2               ;   ptr (16-bit) = 12-bit tone period (lo in ptr, hi in ptr+1)
000DAD  2               ;   tmp0         = volume (0-15)
000DAD  2               ;----------------------------------------------------------------
000DAD  2               tone_on:
000DAD  2  A9 00                LDA     #0              ; ch A period low
000DAF  2  A4 10                LDY     ptr
000DB1  2  20 44 0D             JSR     psgwr
000DB4  2  A9 01                LDA     #1              ; ch A period high
000DB6  2  A4 11                LDY     ptr+1
000DB8  2  20 44 0D             JSR     psgwr
000DBB  2  A9 07                LDA     #07             ; mixer: enable tone A only
000DBD  2  A0 3E                LDY     #%00111110
000DBF  2  20 44 0D             JSR     psgwr
000DC2  2  A9 08                LDA     #8              ; ch A volume
000DC4  2  A4 20                LDY     tmp0
000DC6  2  20 44 0D             JSR     psgwr
000DC9  2  60                   RTS
000DCA  2               
000DCA  2               ;----------------------------------------------------------------
000DCA  2               ; busywait - crude delay.  X = outer count.
000DCA  2               ;----------------------------------------------------------------
000DCA  2               busywait:
000DCA  2               @bw0:
000DCA  2  A0 00                LDY     #0
000DCC  2               @bw1:
000DCC  2  A9 00                LDA     #0
000DCE  2               @bw2:
000DCE  2  18                   CLC
000DCF  2  69 01                ADC     #1
000DD1  2  C9 28                CMP     #40
000DD3  2  D0 F9                BNE     @bw2
000DD5  2  C8                   INY
000DD6  2  D0 F4                BNE     @bw1
000DD8  2  CA                   DEX
000DD9  2  D0 EF                BNE     @bw0
000DDB  2  60                   RTS
000DDC  2               
000DDC  2               ;----------------------------------------------------------------
000DDC  2               ; mus_finewait - a short, fine-grained delay for tempo trimming.
000DDC  2               ; Spins MUS_FINEDELAY outer times, 256 inner each.  Much smaller
000DDC  2               ; than one busywait pass, so it gives sub-step tempo control.
000DDC  2               ;----------------------------------------------------------------
000DDC  2               mus_finewait:
000DDC  2  A2 46                LDX     #MUS_FINEDELAY
000DDE  2  F0 08                BEQ     @done
000DE0  2               @fw0:
000DE0  2  A0 00                LDY     #0
000DE2  2               @fw1:
000DE2  2  C8                   INY
000DE3  2  D0 FD                BNE     @fw1
000DE5  2  CA                   DEX
000DE6  2  D0 F8                BNE     @fw0
000DE8  2               @done:
000DE8  2  60                   RTS
000DE9  2               
000DE9  2               ;----------------------------------------------------------------
000DE9  2               ; SFX helpers.  Each plays a short, self-contained sound and
000DE9  2               ; silences the PSG afterwards.  All preserve nothing - callers
000DE9  2               ; must save anything they need.
000DE9  2               ;----------------------------------------------------------------
000DE9  2               
000DE9  2               ; sfx_move - very short low blip
000DE9  2               sfx_move:
000DE9  2  A9 40 85 10          SETW16  ptr, $0240
000DED  2  A9 02 85 11  
000DF1  2  A9 06                LDA     #6
000DF3  2  85 20                STA     tmp0
000DF5  2  20 AD 0D             JSR     tone_on
000DF8  2  A2 02                LDX     #2
000DFA  2  20 CA 0D             JSR     busywait
000DFD  2  4C 27 0D             JMP     psg_silence
000E00  2               
000E00  2               ; sfx_blocked - low buzz (use noise)
000E00  2               sfx_blocked:
000E00  2  A9 06                LDA     #6              ; noise period
000E02  2  A0 14                LDY     #20
000E04  2  20 44 0D             JSR     psgwr
000E07  2  A9 07                LDA     #07             ; enable noise A
000E09  2  A0 37                LDY     #%00110111
000E0B  2  20 44 0D             JSR     psgwr
000E0E  2  A9 08                LDA     #8
000E10  2  A0 0A                LDY     #10
000E12  2  20 44 0D             JSR     psgwr
000E15  2  A2 03                LDX     #3
000E17  2  20 CA 0D             JSR     busywait
000E1A  2  4C 27 0D             JMP     psg_silence
000E1D  2               
000E1D  2               ; sfx_hit - quick high zap
000E1D  2               sfx_hit:
000E1D  2  A9 C0 85 10          SETW16  ptr, $00C0
000E21  2  A9 00 85 11  
000E25  2  A9 0C                LDA     #12
000E27  2  85 20                STA     tmp0
000E29  2  20 AD 0D             JSR     tone_on
000E2C  2  A2 02                LDX     #2
000E2E  2  20 CA 0D             JSR     busywait
000E31  2  A9 40 85 10          SETW16  ptr, $0140
000E35  2  A9 01 85 11  
000E39  2  A9 0A                LDA     #10
000E3B  2  85 20                STA     tmp0
000E3D  2  20 AD 0D             JSR     tone_on
000E40  2  A2 02                LDX     #2
000E42  2  20 CA 0D             JSR     busywait
000E45  2  4C 27 0D             JMP     psg_silence
000E48  2               
000E48  2               ; sfx_hurt - low impact when the player takes melee damage
000E48  2               sfx_hurt:
000E48  2  A9 80 85 10          SETW16  ptr, $0280
000E4C  2  A9 02 85 11  
000E50  2  A9 0B                LDA     #11
000E52  2  85 20                STA     tmp0
000E54  2  20 AD 0D             JSR     tone_on
000E57  2  A2 03                LDX     #3
000E59  2  20 CA 0D             JSR     busywait
000E5C  2  A9 06                LDA     #6
000E5E  2  A0 0E                LDY     #14
000E60  2  20 44 0D             JSR     psgwr
000E63  2  A9 07                LDA     #7
000E65  2  A0 37                LDY     #%00110111
000E67  2  20 44 0D             JSR     psgwr
000E6A  2  A9 08                LDA     #8
000E6C  2  A0 08                LDY     #8
000E6E  2  20 44 0D             JSR     psgwr
000E71  2  A2 02                LDX     #2
000E73  2  20 CA 0D             JSR     busywait
000E76  2  4C 27 0D             JMP     psg_silence
000E79  2               
000E79  2               ; sfx_critical - bright double strike
000E79  2               sfx_critical:
000E79  2  A9 80 85 10          SETW16  ptr, $0080
000E7D  2  A9 00 85 11  
000E81  2  A9 0F                LDA     #15
000E83  2  85 20                STA     tmp0
000E85  2  20 AD 0D             JSR     tone_on
000E88  2  A2 02                LDX     #2
000E8A  2  20 CA 0D             JSR     busywait
000E8D  2  A9 50 85 10          SETW16  ptr, $0050
000E91  2  A9 00 85 11  
000E95  2  20 AD 0D             JSR     tone_on
000E98  2  A2 03                LDX     #3
000E9A  2  20 CA 0D             JSR     busywait
000E9D  2  4C 27 0D             JMP     psg_silence
000EA0  2               
000EA0  2               ; sfx_poison - short, uneasy descending hiss
000EA0  2               sfx_poison:
000EA0  2  A9 06                LDA     #6
000EA2  2  A0 08                LDY     #8
000EA4  2  20 44 0D             JSR     psgwr
000EA7  2  A9 07                LDA     #7
000EA9  2  A0 37                LDY     #%00110111
000EAB  2  20 44 0D             JSR     psgwr
000EAE  2  A9 08                LDA     #8
000EB0  2  A0 09                LDY     #9
000EB2  2  20 44 0D             JSR     psgwr
000EB5  2  A2 03                LDX     #3
000EB7  2  20 CA 0D             JSR     busywait
000EBA  2  A9 06                LDA     #6
000EBC  2  A0 12                LDY     #18
000EBE  2  20 44 0D             JSR     psgwr
000EC1  2  A2 02                LDX     #2
000EC3  2  20 CA 0D             JSR     busywait
000EC6  2  4C 27 0D             JMP     psg_silence
000EC9  2               
000EC9  2               ; sfx_breath_warn - rising intake before the dragon breathes
000EC9  2               sfx_breath_warn:
000EC9  2  A9 20 85 10          SETW16  ptr, $0320
000ECD  2  A9 03 85 11  
000ED1  2  A9 09                LDA     #9
000ED3  2  85 20                STA     tmp0
000ED5  2  20 AD 0D             JSR     tone_on
000ED8  2  A2 02                LDX     #2
000EDA  2  20 CA 0D             JSR     busywait
000EDD  2  A9 20 85 10          SETW16  ptr, $0220
000EE1  2  A9 02 85 11  
000EE5  2  A9 0C                LDA     #12
000EE7  2  85 20                STA     tmp0
000EE9  2  20 AD 0D             JSR     tone_on
000EEC  2  A2 03                LDX     #3
000EEE  2  20 CA 0D             JSR     busywait
000EF1  2  4C 27 0D             JMP     psg_silence
000EF4  2               
000EF4  2               ; sfx_breath - forceful noise burst for dragon fire
000EF4  2               sfx_breath:
000EF4  2  A9 06                LDA     #6
000EF6  2  A0 03                LDY     #3
000EF8  2  20 44 0D             JSR     psgwr
000EFB  2  A9 07                LDA     #7
000EFD  2  A0 37                LDY     #%00110111
000EFF  2  20 44 0D             JSR     psgwr
000F02  2  A9 08                LDA     #8
000F04  2  A0 0F                LDY     #15
000F06  2  20 44 0D             JSR     psgwr
000F09  2  A2 05                LDX     #5
000F0B  2  20 CA 0D             JSR     busywait
000F0E  2  A9 06                LDA     #6
000F10  2  A0 0A                LDY     #10
000F12  2  20 44 0D             JSR     psgwr
000F15  2  A9 08                LDA     #8
000F17  2  A0 0B                LDY     #11
000F19  2  20 44 0D             JSR     psgwr
000F1C  2  A2 04                LDX     #4
000F1E  2  20 CA 0D             JSR     busywait
000F21  2  4C 27 0D             JMP     psg_silence
000F24  2               
000F24  2               ; sfx_killed - falling tone + noise
000F24  2               sfx_killed:
000F24  2  A9 06                LDA     #6
000F26  2  A0 10                LDY     #16
000F28  2  20 44 0D             JSR     psgwr
000F2B  2  A9 07                LDA     #07
000F2D  2  A0 37                LDY     #%00110111
000F2F  2  20 44 0D             JSR     psgwr
000F32  2  A9 08                LDA     #8
000F34  2  A0 0D                LDY     #13
000F36  2  20 44 0D             JSR     psgwr
000F39  2  A2 05                LDX     #5
000F3B  2  20 CA 0D             JSR     busywait
000F3E  2  4C 27 0D             JMP     psg_silence
000F41  2               
000F41  2               ; sfx_treasure - bright rising arpeggio
000F41  2               sfx_treasure:
000F41  2  A9 50 85 10          SETW16  ptr, $0150
000F45  2  A9 01 85 11  
000F49  2  A9 0D                LDA     #13
000F4B  2  85 20                STA     tmp0
000F4D  2  20 AD 0D             JSR     tone_on
000F50  2  A2 02                LDX     #2
000F52  2  20 CA 0D             JSR     busywait
000F55  2  A9 FC 85 10          SETW16  ptr, $00FC
000F59  2  A9 00 85 11  
000F5D  2  20 AD 0D             JSR     tone_on
000F60  2  A2 02                LDX     #2
000F62  2  20 CA 0D             JSR     busywait
000F65  2  A9 A8 85 10          SETW16  ptr, $00A8
000F69  2  A9 00 85 11  
000F6D  2  20 AD 0D             JSR     tone_on
000F70  2  A2 03                LDX     #3
000F72  2  20 CA 0D             JSR     busywait
000F75  2  4C 27 0D             JMP     psg_silence
000F78  2               
000F78  2               ; sfx_levelup - three ascending happy notes
000F78  2               sfx_levelup:
000F78  2  A9 FC 85 10          SETW16  ptr, $00FC
000F7C  2  A9 00 85 11  
000F80  2  A9 0E                LDA     #14
000F82  2  85 20                STA     tmp0
000F84  2  20 AD 0D             JSR     tone_on
000F87  2  A2 03                LDX     #3
000F89  2  20 CA 0D             JSR     busywait
000F8C  2  A9 C8 85 10          SETW16  ptr, $00C8
000F90  2  A9 00 85 11  
000F94  2  20 AD 0D             JSR     tone_on
000F97  2  A2 03                LDX     #3
000F99  2  20 CA 0D             JSR     busywait
000F9C  2  A9 A8 85 10          SETW16  ptr, $00A8
000FA0  2  A9 00 85 11  
000FA4  2  20 AD 0D             JSR     tone_on
000FA7  2  A2 04                LDX     #4
000FA9  2  20 CA 0D             JSR     busywait
000FAC  2  4C 27 0D             JMP     psg_silence
000FAF  2               
000FAF  2               ; sfx_door - short two-tone chime
000FAF  2               sfx_door:
000FAF  2  A9 80 85 10          SETW16  ptr, $0180
000FB3  2  A9 01 85 11  
000FB7  2  A9 0B                LDA     #11
000FB9  2  85 20                STA     tmp0
000FBB  2  20 AD 0D             JSR     tone_on
000FBE  2  A2 02                LDX     #2
000FC0  2  20 CA 0D             JSR     busywait
000FC3  2  A9 20 85 10          SETW16  ptr, $0120
000FC7  2  A9 01 85 11  
000FCB  2  20 AD 0D             JSR     tone_on
000FCE  2  A2 03                LDX     #3
000FD0  2  20 CA 0D             JSR     busywait
000FD3  2  4C 27 0D             JMP     psg_silence
000FD6  2               
000FD6  2               ; sfx_lose - long descending sad tone
000FD6  2               sfx_lose:
000FD6  2  A9 20 85 10          SETW16  ptr, $0120
000FDA  2  A9 01 85 11  
000FDE  2  A9 0D                LDA     #13
000FE0  2  85 20                STA     tmp0
000FE2  2  20 AD 0D             JSR     tone_on
000FE5  2  A2 06                LDX     #6
000FE7  2  20 CA 0D             JSR     busywait
000FEA  2  A9 C0 85 10          SETW16  ptr, $01C0
000FEE  2  A9 01 85 11  
000FF2  2  20 AD 0D             JSR     tone_on
000FF5  2  A2 06                LDX     #6
000FF7  2  20 CA 0D             JSR     busywait
000FFA  2  A9 80 85 10          SETW16  ptr, $0280
000FFE  2  A9 02 85 11  
001002  2  20 AD 0D             JSR     tone_on
001005  2  A2 0A                LDX     #10
001007  2  20 CA 0D             JSR     busywait
00100A  2  4C 27 0D             JMP     psg_silence
00100D  2               
00100D  2               ; sfx_win - triumphant fanfare
00100D  2               sfx_win:
00100D  2  A9 FC 85 10          SETW16  ptr, $00FC
001011  2  A9 00 85 11  
001015  2  A9 0F                LDA     #15
001017  2  85 20                STA     tmp0
001019  2  20 AD 0D             JSR     tone_on
00101C  2  A2 04                LDX     #4
00101E  2  20 CA 0D             JSR     busywait
001021  2  A9 C8 85 10          SETW16  ptr, $00C8
001025  2  A9 00 85 11  
001029  2  20 AD 0D             JSR     tone_on
00102C  2  A2 04                LDX     #4
00102E  2  20 CA 0D             JSR     busywait
001031  2  A9 A8 85 10          SETW16  ptr, $00A8
001035  2  A9 00 85 11  
001039  2  20 AD 0D             JSR     tone_on
00103C  2  A2 04                LDX     #4
00103E  2  20 CA 0D             JSR     busywait
001041  2  A9 7E 85 10          SETW16  ptr, $007E
001045  2  A9 00 85 11  
001049  2  20 AD 0D             JSR     tone_on
00104C  2  A2 0C                LDX     #12
00104E  2  20 CA 0D             JSR     busywait
001051  2  4C 27 0D             JMP     psg_silence
001054  2               
001054  2               ;==============================================================================
001054  2               ;  Cooperative 3-channel title music player with hardware envelope.
001054  2               ;
001054  2               ;  Three independent voice tracks play simultaneously:
001054  2               ;     channel A = lead melody   (uses the AY envelope generator so each
001054  2               ;                                note has a soft attack/decay shape)
001054  2               ;     channel B = counter/harmony (fixed mid volume)
001054  2               ;     channel C = bass line       (fixed mid volume)
001054  2               ;
001054  2               ;  Each track is a list of events: (note, duration) byte pairs.
001054  2               ;     note 0      = rest (silence this channel for the duration)
001054  2               ;     note 1..47  = index into note_lo/note_hi period tables
001054  2               ;     note $FF    = end marker -> loop the track from its start
001054  2               ;     duration    = number of music ticks to hold (1..254)
001054  2               ;
001054  2               ;  music_tick is called once per title spin-loop iteration.  It paces
001054  2               ;  itself with a short delay, then advances all three voices.
001054  2               ;==============================================================================
001054  2               
001054  2               ; Tempo: each music tick waits busywait(1) plus an extra fine spin of
001054  2               ; MUS_FINEDELAY * 256 loops.  delay=1 alone (FINE=0) was a little fast;
001054  2               ; FINE=128 is about 1.5x slower.  Raise/lower MUS_FINEDELAY to taste.
001054  2               MUS_TICKDELAY   = 1             ; busywait outer count per music tick
001054  2               MUS_FINEDELAY   = 70            ; extra fine delay (0..255), tempo trim
001054  2               
001054  2               ; envelope shape values (reg 13)
001054  2               ENV_DECAY       = %00000000     ; \____  single decay then off (plucky)
001054  2               ENV_RAMP        = %00001000     ; \\\\   repeating saw (sustained pulse)
001054  2               ENV_PERIOD      = $1800         ; 16-bit envelope period (attack/decay len)
001054  2               MUS_VOL_B       = 8             ; harmony volume (gentle, under the lead)
001054  2               MUS_VOL_C       = 13            ; bass volume (strong, so it is audible)
001054  2               
001054  2               ;----------------------------------------------------------------
001054  2               ; music_start - reset all three voice cursors and program the AY
001054  2               ; for music: all three tone channels enabled, envelope set up for
001054  2               ; the lead.
001054  2               ;----------------------------------------------------------------
001054  2               music_start:
001054  2               ; voice cursors -> track starts
001054  2  A9 1D 8D 28          SETW16  mvA_ptr, trackA
001058  2  62 A9 12 8D  
00105C  2  29 62        
00105E  2  A9 5A 8D 2B          SETW16  mvB_ptr, trackB
001062  2  62 A9 12 8D  
001066  2  2C 62        
001068  2  A9 6D 8D 2E          SETW16  mvC_ptr, trackC
00106C  2  62 A9 12 8D  
001070  2  2F 62        
001072  2               ; all hold-counters = 0 so every voice fetches on the first tick.
001072  2               ; (must load #0 fresh each time - SETW16 above left A non-zero,
001072  2               ;  which is why B/C previously got garbage counts and went silent)
001072  2  A9 00                LDA     #0
001074  2  8D 2A 62             STA     mvA_cnt
001077  2  8D 2D 62             STA     mvB_cnt
00107A  2  8D 30 62             STA     mvC_cnt
00107D  2               
00107D  2               ; mixer: enable tone on A, B, C (noise off)  -> bits 0..2 clear
00107D  2  A9 07                LDA     #07
00107F  2  A0 38                LDY     #%00111000
001081  2  20 44 0D             JSR     psgwr
001084  2               ; envelope period (regs 11/12) - sets attack/decay length.
001084  2               ; longer = the plucked lead note rings out for more of its
001084  2               ; duration before fading.  Tune ENV_PERIOD to taste.
001084  2  A9 0B                LDA     #11
001086  2  A0 00                LDY     #<ENV_PERIOD
001088  2  20 44 0D             JSR     psgwr
00108B  2  A9 0C                LDA     #12
00108D  2  A0 18                LDY     #>ENV_PERIOD
00108F  2  20 44 0D             JSR     psgwr
001092  2               ; channel A volume register = use envelope (bit4 set)
001092  2  A9 08                LDA     #8
001094  2  A0 10                LDY     #%00010000
001096  2  20 44 0D             JSR     psgwr
001099  2               ; channel B: gentle harmony pad ; channel C: strong bass
001099  2  A9 09                LDA     #9
00109B  2  A0 08                LDY     #MUS_VOL_B
00109D  2  20 44 0D             JSR     psgwr
0010A0  2  A9 0A                LDA     #10
0010A2  2  A0 0D                LDY     #MUS_VOL_C
0010A4  2  20 44 0D             JSR     psgwr
0010A7  2  60                   RTS
0010A8  2               
0010A8  2               ;----------------------------------------------------------------
0010A8  2               ; music_tick - advance all three voices by one tick.
0010A8  2               ;----------------------------------------------------------------
0010A8  2               music_tick:
0010A8  2  A2 01                LDX     #MUS_TICKDELAY
0010AA  2  20 CA 0D             JSR     busywait
0010AD  2  20 DC 0D             JSR     mus_finewait    ; fine tempo trim
0010B0  2               
0010B0  2               ; --- voice A (lead, envelope) ---
0010B0  2  AD 2A 62             LDA     mvA_cnt
0010B3  2  F0 06                BEQ     @nextA
0010B5  2  CE 2A 62             DEC     mvA_cnt
0010B8  2  4C 10 11             JMP     @doB
0010BB  2               @nextA:
0010BB  2  A9 1D 85 18          SETW16  srcp, trackA    ; (loop base, used if end marker hit)
0010BF  2  A9 12 85 19  
0010C3  2  AD 28 62             LDA     mvA_ptr
0010C6  2  85 12                STA     ptr2
0010C8  2  AD 29 62             LDA     mvA_ptr+1
0010CB  2  85 13                STA     ptr2+1
0010CD  2  20 B9 11             JSR     mus_fetch       ; -> tmp0=note, tmp1=dur, ptr2 advanced
0010D0  2               ; program channel A tone (regs 0/1) from the note
0010D0  2  A6 20                LDX     tmp0
0010D2  2  F0 1B                BEQ     @restA          ; rest
0010D4  2  20 E5 11             JSR     note_period     ; -> ptr = period for note X
0010D7  2  A9 00                LDA     #0
0010D9  2  A4 10                LDY     ptr
0010DB  2  20 44 0D             JSR     psgwr
0010DE  2  A9 01                LDA     #1
0010E0  2  A4 11                LDY     ptr+1
0010E2  2  20 44 0D             JSR     psgwr
0010E5  2               ; (re)trigger the envelope by rewriting the shape register
0010E5  2  A9 0D                LDA     #13
0010E7  2  A0 00                LDY     #ENV_DECAY
0010E9  2  20 44 0D             JSR     psgwr
0010EC  2  4C F6 10             JMP     @setA
0010EF  2               @restA:
0010EF  2               ; silence A for the rest: drop its volume to 0 (no envelope)
0010EF  2  A9 08                LDA     #8
0010F1  2  A0 00                LDY     #0
0010F3  2  20 44 0D             JSR     psgwr
0010F6  2               @setA:
0010F6  2               ; for a non-rest, make sure A uses the envelope again
0010F6  2  A5 20                LDA     tmp0
0010F8  2  F0 07                BEQ     @cntA
0010FA  2  A9 08                LDA     #8
0010FC  2  A0 10                LDY     #%00010000
0010FE  2  20 44 0D             JSR     psgwr
001101  2               @cntA:
001101  2  A5 21                LDA     tmp1
001103  2  8D 2A 62             STA     mvA_cnt
001106  2  A5 12                LDA     ptr2
001108  2  8D 28 62             STA     mvA_ptr
00110B  2  A5 13                LDA     ptr2+1
00110D  2  8D 29 62             STA     mvA_ptr+1
001110  2               
001110  2               @doB:
001110  2               ; --- voice B (harmony, fixed volume on channel B) ---
001110  2  AD 2D 62             LDA     mvB_cnt
001113  2  F0 06                BEQ     @nextB
001115  2  CE 2D 62             DEC     mvB_cnt
001118  2  4C 65 11             JMP     @doC
00111B  2               @nextB:
00111B  2  A9 5A 85 18          SETW16  srcp, trackB
00111F  2  A9 12 85 19  
001123  2  AD 2B 62             LDA     mvB_ptr
001126  2  85 12                STA     ptr2
001128  2  AD 2C 62             LDA     mvB_ptr+1
00112B  2  85 13                STA     ptr2+1
00112D  2  20 B9 11             JSR     mus_fetch
001130  2  A6 20                LDX     tmp0
001132  2  F0 1B                BEQ     @restB
001134  2  20 E5 11             JSR     note_period
001137  2  A9 02                LDA     #2
001139  2  A4 10                LDY     ptr
00113B  2  20 44 0D             JSR     psgwr
00113E  2  A9 03                LDA     #3
001140  2  A4 11                LDY     ptr+1
001142  2  20 44 0D             JSR     psgwr
001145  2  A9 09                LDA     #9              ; restore B volume
001147  2  A0 08                LDY     #MUS_VOL_B
001149  2  20 44 0D             JSR     psgwr
00114C  2  4C 56 11             JMP     @cntB
00114F  2               @restB:
00114F  2  A9 09                LDA     #9
001151  2  A0 00                LDY     #0
001153  2  20 44 0D             JSR     psgwr
001156  2               @cntB:
001156  2  A5 21                LDA     tmp1
001158  2  8D 2D 62             STA     mvB_cnt
00115B  2  A5 12                LDA     ptr2
00115D  2  8D 2B 62             STA     mvB_ptr
001160  2  A5 13                LDA     ptr2+1
001162  2  8D 2C 62             STA     mvB_ptr+1
001165  2               
001165  2               @doC:
001165  2               ; --- voice C (bass, fixed volume on channel C) ---
001165  2  AD 30 62             LDA     mvC_cnt
001168  2  F0 04                BEQ     @nextC
00116A  2  CE 30 62             DEC     mvC_cnt
00116D  2  60                   RTS
00116E  2               @nextC:
00116E  2  A9 6D 85 18          SETW16  srcp, trackC
001172  2  A9 12 85 19  
001176  2  AD 2E 62             LDA     mvC_ptr
001179  2  85 12                STA     ptr2
00117B  2  AD 2F 62             LDA     mvC_ptr+1
00117E  2  85 13                STA     ptr2+1
001180  2  20 B9 11             JSR     mus_fetch
001183  2  A6 20                LDX     tmp0
001185  2  F0 1B                BEQ     @restC
001187  2  20 E5 11             JSR     note_period
00118A  2  A9 04                LDA     #4
00118C  2  A4 10                LDY     ptr
00118E  2  20 44 0D             JSR     psgwr
001191  2  A9 05                LDA     #5
001193  2  A4 11                LDY     ptr+1
001195  2  20 44 0D             JSR     psgwr
001198  2  A9 0A                LDA     #10             ; restore C volume
00119A  2  A0 0D                LDY     #MUS_VOL_C
00119C  2  20 44 0D             JSR     psgwr
00119F  2  4C A9 11             JMP     @cntC
0011A2  2               @restC:
0011A2  2  A9 0A                LDA     #10
0011A4  2  A0 00                LDY     #0
0011A6  2  20 44 0D             JSR     psgwr
0011A9  2               @cntC:
0011A9  2  A5 21                LDA     tmp1
0011AB  2  8D 30 62             STA     mvC_cnt
0011AE  2  A5 12                LDA     ptr2
0011B0  2  8D 2E 62             STA     mvC_ptr
0011B3  2  A5 13                LDA     ptr2+1
0011B5  2  8D 2F 62             STA     mvC_ptr+1
0011B8  2  60                   RTS
0011B9  2               
0011B9  2               ;----------------------------------------------------------------
0011B9  2               ; mus_fetch - read one (note,dur) event from the track at ptr2.
0011B9  2               ;   IN : ptr2 -> current event ; srcp -> track loop base
0011B9  2               ;   OUT: tmp0 = note, tmp1 = duration, ptr2 advanced past the event.
0011B9  2               ;        On an $FF end marker, ptr2 is reset to srcp and the first
0011B9  2               ;        event of the track is returned.
0011B9  2               ;----------------------------------------------------------------
0011B9  2               mus_fetch:
0011B9  2  A0 00                LDY     #0
0011BB  2  B1 12                LDA     (ptr2),Y
0011BD  2  C9 FF                CMP     #$FF
0011BF  2  D0 0C                BNE     @ok
0011C1  2               ; loop: reset ptr2 to track base (srcp)
0011C1  2  A5 18                LDA     srcp
0011C3  2  85 12                STA     ptr2
0011C5  2  A5 19                LDA     srcp+1
0011C7  2  85 13                STA     ptr2+1
0011C9  2  A0 00                LDY     #0
0011CB  2  B1 12                LDA     (ptr2),Y
0011CD  2               @ok:
0011CD  2  85 20                STA     tmp0            ; note
0011CF  2  C8                   INY
0011D0  2  B1 12                LDA     (ptr2),Y
0011D2  2               ; The voice loops "fetch when counter hits 0", and the fetch
0011D2  2               ; tick itself is the first tick of the note.  So a note must
0011D2  2               ; hold for (dur-1) MORE ticks after the fetch tick to last
0011D2  2               ; exactly dur ticks.  Subtract 1 here.  (All durations are >=2,
0011D2  2               ; so no underflow.)  This keeps voices with different note
0011D2  2               ; counts the same real length - otherwise B/C drift away from
0011D2  2               ; the lead because they have fewer/more notes per loop.
0011D2  2  38                   SEC
0011D3  2  E9 01                SBC     #1
0011D5  2  85 21                STA     tmp1            ; duration - 1
0011D7  2               ; advance ptr2 by 2
0011D7  2  18                   CLC
0011D8  2  A5 12                LDA     ptr2
0011DA  2  69 02                ADC     #2
0011DC  2  85 12                STA     ptr2
0011DE  2  A5 13                LDA     ptr2+1
0011E0  2  69 00                ADC     #0
0011E2  2  85 13                STA     ptr2+1
0011E4  2  60                   RTS
0011E5  2               
0011E5  2               ;----------------------------------------------------------------
0011E5  2               ; note_period - look up the 16-bit AY tone period for note X (1..N)
0011E5  2               ;   OUT: ptr = period (lo/hi).  Note index is 1-based.
0011E5  2               ;----------------------------------------------------------------
0011E5  2               note_period:
0011E5  2  CA                   DEX                     ; tables are 0-based
0011E6  2  BD F1 11             LDA     note_lo,X
0011E9  2  85 10                STA     ptr
0011EB  2  BD 07 12             LDA     note_hi,X
0011EE  2  85 11                STA     ptr+1
0011F0  2  60                   RTS
0011F1  2               
0011F1  2               ;----------------------------------------------------------------
0011F1  2               ; Note period tables (16-bit AY tone periods), two+ octaves.
0011F1  2               ; Note numbers (1-based) used by the tracks:
0011F1  2               ;   1=C3  2=D3 3=E3 4=F3 5=G3 6=A3 7=B3
0011F1  2               ;   8=C4  9=D4 10=E4 11=F4 12=G4 13=A4 14=B4
0011F1  2               ;  15=C5 16=D5 17=E5 18=F5 19=G5 20=A5 21=B5
0011F1  2               ;  22=C6
0011F1  2               ; (a diatonic C-major set is plenty for a heroic theme)
0011F1  2               ;----------------------------------------------------------------
0011F1  2               note_lo:
0011F1  2  F0 82 20 F4          .BYTE   <1008, <898, <800, <756, <672, <600, <534; C3..B3
0011F5  2  A0 58 16     
0011F8  2  F8 C2 90 7A          .BYTE   <504,  <450, <400, <378, <336, <300, <267; C4..B4
0011FC  2  50 2C 0B     
0011FF  2  FC E1 C8 BD          .BYTE   <252,  <225, <200, <189, <168, <150, <133; C5..B5
001203  2  A8 96 85     
001206  2  7E                   .BYTE   <126            ; C6
001207  2               note_hi:
001207  2  03 03 03 02          .BYTE   >1008, >898, >800, >756, >672, >600, >534
00120B  2  02 02 02     
00120E  2  01 01 01 01          .BYTE   >504,  >450, >400, >378, >336, >300, >267
001212  2  01 01 01     
001215  2  00 00 00 00          .BYTE   >252,  >225, >200, >189, >168, >150, >133
001219  2  00 00 00     
00121C  2  00                   .BYTE   >126
00121D  2               
00121D  2               ; note name -> index defines for readable tracks
00121D  2               N_REST          = 0
00121D  2               C3              = 1
00121D  2               D3              = 2
00121D  2               E3              = 3
00121D  2               F3              = 4
00121D  2               G3              = 5
00121D  2               A3              = 6
00121D  2               B3              = 7
00121D  2               C4              = 8
00121D  2               D4              = 9
00121D  2               E4              = 10
00121D  2               F4              = 11
00121D  2               G4              = 12
00121D  2               A4              = 13
00121D  2               B4              = 14
00121D  2               C5              = 15
00121D  2               D5              = 16
00121D  2               E5              = 17
00121D  2               F5              = 18
00121D  2               G5              = 19
00121D  2               A5              = 20
00121D  2               B5              = 21
00121D  2               C6              = 22
00121D  2               
00121D  2               ;----------------------------------------------------------------
00121D  2               ; The theme: a stately heroic tune in C major, 3 voices.
00121D  2               ; Durations are in ticks; the three tracks are written so their
00121D  2               ; total lengths line up over each phrase.
00121D  2               ;----------------------------------------------------------------
00121D  2               
00121D  2               ; --- Channel A : lead melody ---
00121D  2               ; Every phrase line totals 16 ticks so the lead stays locked in step
00121D  2               ; with the 16-tick harmony (B) and bass (C) lines.  (Line 1 was 20
00121D  2               ; ticks before, which drifted B/C out of phase each loop.)
00121D  2               trackA:
00121D  2  0C 04 0F 04          .BYTE   G4,4,  C5,4,  E5,4,  G5,2,  E5,2; 16
001221  2  11 04 13 02  
001225  2  11 02        
001227  2  12 04 11 04          .BYTE   F5,4,  E5,4,  D5,8; 16
00122B  2  10 08        
00122D  2  11 04 13 04          .BYTE   E5,4,  G5,4,  C6,6,  B5,2; 16
001231  2  16 06 15 02  
001235  2  14 04 13 04          .BYTE   A5,4,  G5,4,  E5,8; 16
001239  2  11 08        
00123B  2  12 04 14 04          .BYTE   F5,4,  A5,4,  G5,4,  E5,4; 16
00123F  2  13 04 11 04  
001243  2  10 04 12 04          .BYTE   D5,4,  F5,4,  E5,8; 16
001247  2  11 08        
001249  2  0F 04 11 04          .BYTE   C5,4,  E5,4,  G5,4,  C6,4; 16
00124D  2  13 04 16 04  
001251  2  13 04 11 04          .BYTE   G5,4,  E5,4,  C5,8; 16
001255  2  0F 08        
001257  2  00 04                .BYTE   N_REST,4
001259  2  FF                   .BYTE   $FF
00125A  2               
00125A  2               ; --- Channel B : sustained harmony, one note per phrase line.
00125A  2               ;     To stay consonant under a diatonic melody we use the FIFTH of
00125A  2               ;     each chord (perfect fifths never clash), in octave 4.
00125A  2               ;     Chords per line:  C  G  C  Am  F  G  C  C
00125A  2               ;     Fifths:           G  D  G  E   C  D  G  G
00125A  2               trackB:
00125A  2  0C 10                .BYTE   G4,16           ; C chord  (5th = G)
00125C  2  09 10                .BYTE   D4,16           ; G chord  (5th = D)
00125E  2  0C 10                .BYTE   G4,16           ; C chord
001260  2  0A 10                .BYTE   E4,16           ; Am chord (5th = E)
001262  2  08 10                .BYTE   C4,16           ; F chord  (5th = C)
001264  2  09 10                .BYTE   D4,16           ; G chord
001266  2  0C 10                .BYTE   G4,16           ; C chord
001268  2  0C 10                .BYTE   G4,16           ; C chord
00126A  2  00 04                .BYTE   N_REST,4
00126C  2  FF                   .BYTE   $FF
00126D  2               
00126D  2               ; --- Channel C : bass - the ROOT of each chord, re-struck halfway
00126D  2               ;     for a gentle pulse.  Same progression: C G C Am F G C C
00126D  2               trackC:
00126D  2  01 08 01 08          .BYTE   C3,8,  C3,8     ; C
001271  2  05 08 05 08          .BYTE   G3,8,  G3,8     ; G
001275  2  01 08 01 08          .BYTE   C3,8,  C3,8     ; C
001279  2  06 08 06 08          .BYTE   A3,8,  A3,8     ; Am
00127D  2  04 08 04 08          .BYTE   F3,8,  F3,8     ; F
001281  2  05 08 05 08          .BYTE   G3,8,  G3,8     ; G
001285  2  01 08 01 08          .BYTE   C3,8,  C3,8     ; C
001289  2  01 08 01 08          .BYTE   C3,8,  C3,8     ; C
00128D  2  00 04                .BYTE   N_REST,4
00128F  2  FF                   .BYTE   $FF
001290  2               
001290  1                       .INCLUDE "tiles.asm"
001290  2               ;______________________________________________________________________________
001290  2               ;  tiles.asm - custom 8x8 character bitmaps for terrain, items, monsters
001290  2               ;
001290  2               ;  The memory-mapped video card has a writable character generator.
001290  2               ;  To redefine character N (see V_PATTERN in dbasic/screencmds.asm):
001290  2               ;     1. map video sub-page $F8 (VIDEOBANK) into CPU bank $A
001290  2               ;     2. write N to VideoCharGenOffset ($A002)
001290  2               ;     3. write 8 scanline bytes to VideoCharGenData ($A003)
001290  2               ;        (the hardware auto-advances through the 8 rows of the glyph)
001290  2               ;
001290  2               ;  Each bitmap is authored as 8 bytes, top row first, with bit7 as
001290  2               ;  the leftmost pixel. The video character generator displays bit0
001290  2               ;  on the left, so chargen_init reverses each scanline before upload.
001290  2               ;  Small title glyphs use control codes 1..31. Gameplay metatiles
001290  2               ;  use $80..$DF. Printable ASCII used by the UI remains intact.
001290  2               ;______________________________________________________________________________
001290  2               
001290  2               VideoCharGenOffset = $A002
001290  2               VideoCharGenData = $A003
001290  2               
001290  2               ;----------------------------------------------------------------
001290  2               ; cg_enter / cg_exit - map the character-generator RAM (page $F8)
001290  2               ; into bank $A and select task 1 (mirrors PAGE_ENTER/PAGE_EXIT).
001290  2               ;----------------------------------------------------------------
001290  2               cg_enter:
001290  2  A9 01                LDA     #$01            ; task 01 (driver)
001292  2  A2 0A                LDX     #$0A            ; CPU bank $A
001294  2  A0 F8                LDY     #VIDEOBANK      ; physical page $F8 (char generator)
001296  2  20 F6 FF             JSR     SETPAGE
001299  2  A9 01                LDA     #$01
00129B  2  8D E0 EF             STA     PC6502_ACT_TASK
00129E  2  60                   RTS
00129F  2               cg_exit:
00129F  2  A9 00                LDA     #$00
0012A1  2  8D E0 EF             STA     PC6502_ACT_TASK
0012A4  2  60                   RTS
0012A5  2               
0012A5  2               ;----------------------------------------------------------------
0012A5  2               ; reverse_glyph_byte - convert authored bit7-left rows to the
0012A5  2               ; character generator's bit0-left display order.
0012A5  2               ;   IN/OUT: A = scanline byte
0012A5  2               ;   trashes X,tmp0; preserves Y
0012A5  2               ;----------------------------------------------------------------
0012A5  2               reverse_glyph_byte:
0012A5  2  85 20                STA     tmp0
0012A7  2  A9 00                LDA     #0
0012A9  2  A2 08                LDX     #8
0012AB  2               @bit:
0012AB  2  46 20                LSR     tmp0
0012AD  2  2A                   ROL     A
0012AE  2  CA                   DEX
0012AF  2  D0 FA                BNE     @bit
0012B1  2  60                   RTS
0012B2  2               
0012B2  2               ;----------------------------------------------------------------
0012B2  2               ; chargen_init - upload every custom glyph bitmap.
0012B2  2               ;
0012B2  2               ; Driven by a table of (charcode, 8 bytes) records.  The table ends
0012B2  2               ; with a $00 charcode marker (code 0 is never one of ours).
0012B2  2               ;----------------------------------------------------------------
0012B2  2               chargen_init:
0012B2  2  20 90 12             JSR     cg_enter
0012B5  2  A9 E8 85 18          SETW16  srcp, glyphtab
0012B9  2  A9 12 85 19  
0012BD  2               @rec:
0012BD  2  A0 00                LDY     #0
0012BF  2  B1 18                LDA     (srcp),Y        ; char code
0012C1  2  F0 22                BEQ     @done           ; 0 = end of table
0012C3  2  8D 02 A0             STA     VideoCharGenOffset
0012C6  2               ; write the 8 scanline bytes
0012C6  2  A0 01                LDY     #1
0012C8  2               @row:
0012C8  2  B1 18                LDA     (srcp),Y
0012CA  2  20 A5 12             JSR     reverse_glyph_byte
0012CD  2  8D 03 A0             STA     VideoCharGenData
0012D0  2  C8                   INY
0012D1  2  C0 09                CPY     #9
0012D3  2  D0 F3                BNE     @row
0012D5  2               ; advance srcp by 9 (1 code + 8 data)
0012D5  2  18                   CLC
0012D6  2  A5 18                LDA     srcp
0012D8  2  69 09                ADC     #9
0012DA  2  85 18                STA     srcp
0012DC  2  A5 19                LDA     srcp+1
0012DE  2  69 00                ADC     #0
0012E0  2  85 19                STA     srcp+1
0012E2  2  4C BD 12             JMP     @rec
0012E5  2               @done:
0012E5  2  4C 9F 12             JMP     cg_exit
0012E8  2               
0012E8  2               ;----------------------------------------------------------------
