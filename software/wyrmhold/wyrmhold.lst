0017F9  1                       .INCLUDE "title.asm"
0017F9  2               ;______________________________________________________________________________
0017F9  2               ;  title.asm - graphical title screen
0017F9  2               ;
0017F9  2               ;  Composes a colorful scene with direct-VRAM fills, the custom terrain
0017F9  2               ;  tiles, a big block-letter "WYRMHOLD" logo, and a dragon, rather than
0017F9  2               ;  plain ASCII text.
0017F9  2               ;______________________________________________________________________________
0017F9  2               
0017F9  2               ; big-letter logo geometry
0017F9  2               BL_W            = 5             ; cells per letter (incl. 1 col gap handled by caller)
0017F9  2               BL_H            = 5             ; rows per letter
0017F9  2               BL_ROW          = 3             ; top screen row of the logo
0017F9  2               BL_COL          = 8             ; left screen col of the logo
0017F9  2               
0017F9  2               ;----------------------------------------------------------------
0017F9  2               ; draw_title_scene - paint the whole title screen.
0017F9  2               ;----------------------------------------------------------------
0017F9  2               draw_title_scene:
0017F9  2  20 09 3B             JSR     cls_vram
0017FC  2  20 8D 3A             JSR     vid_enter
0017FF  2               
0017FF  2                       ; --- sky band (rows 0..9) : deep blue background ---
0017FF  2  A9 00                LDA     #0
001801  2  85 27                STA     rowidx
001803  2               @sky:
001803  2  A5 27                LDA     rowidx
001805  2  85 21                STA     tmp1
001807  2  A9 00                LDA     #0
001809  2  85 22                STA     tmp2
00180B  2  A9 20                LDA     #space
00180D  2  85 23                STA     tmp3
00180F  2  A9 1F                LDA     #COLOR(CO_BRWHITE, CO_BLUE)
001811  2  85 26                STA     colidx
001813  2  A9 50                LDA     #SCRW
001815  2  85 24                STA     cnt0
001817  2  20 2F 3B             JSR     fillrow_vram
00181A  2  E6 27                INC     rowidx
00181C  2  A5 27                LDA     rowidx
00181E  2  C9 0A                CMP     #10
001820  2  D0 E1                BNE     @sky
001822  2               
001822  2                       ; sprinkle a few "stars" in the sky (asterisks)
001822  2  A9 2E                LDA     #'.'
001824  2  85 23                STA     tmp3
001826  2  A9 1F                LDA     #COLOR(CO_BRWHITE, CO_BLUE)
001828  2  85 26                STA     colidx
00182A  2  A2 00                LDX     #0
00182C  2               @stars:
00182C  2  BD 13 1A             LDA     star_row,X
00182F  2  85 21                STA     tmp1
001831  2  BD 1D 1A             LDA     star_col,X
001834  2  85 22                STA     tmp2
001836  2  DA                   PHX
001837  2  20 F9 3A             JSR     putcell
00183A  2  FA                   PLX
00183B  2  E8                   INX
00183C  2  E0 0A                CPX     #NSTARS
00183E  2  D0 EC                BNE     @stars
001840  2               
001840  2                       ; --- ground band (rows 16..23) : green ---
001840  2  A9 10                LDA     #16
001842  2  85 27                STA     rowidx
001844  2               @grnd:
001844  2  A5 27                LDA     rowidx
001846  2  85 21                STA     tmp1
001848  2  A9 00                LDA     #0
00184A  2  85 22                STA     tmp2
00184C  2  A9 01                LDA     #G_GRASS
00184E  2  85 23                STA     tmp3
001850  2  A9 2A                LDA     #C_GRASS
001852  2  85 26                STA     colidx
001854  2  A9 50                LDA     #SCRW
001856  2  85 24                STA     cnt0
001858  2  20 2F 3B             JSR     fillrow_vram
00185B  2  E6 27                INC     rowidx
00185D  2  A5 27                LDA     rowidx
00185F  2  C9 18                CMP     #24
001861  2  D0 E1                BNE     @grnd
001863  2               
001863  2                       ; --- a mountain range across the horizon (row 15) ---
001863  2  A9 0F                LDA     #15
001865  2  85 21                STA     tmp1
001867  2  A9 00                LDA     #0
001869  2  85 22                STA     tmp2
00186B  2  A9 03                LDA     #G_MOUNT
00186D  2  85 23                STA     tmp3
00186F  2  A9 8F                LDA     #C_MOUNT
001871  2  85 26                STA     colidx
001873  2  A9 50                LDA     #SCRW
001875  2  85 24                STA     cnt0
001877  2  20 2F 3B             JSR     fillrow_vram
00187A  2               
00187A  2  20 9C 3A             JSR     vid_exit
00187D  2               
00187D  2                       ; --- scenery objects (single tiles) via putcell helper ---
00187D  2  20 CB 18             JSR     draw_scenery
001880  2               
001880  2                       ; --- the big block-letter logo ---
001880  2  20 4A 19             JSR     draw_logo
001883  2               
001883  2                       ; --- text: subtitle, prompt, controls (colored) ---
001883  2  A2 1A                LDX     #26
001885  2  A0 0A                LDY     #10
001887  2  20 DB 3B             JSR     locate
00188A  2  A9 0B                LDA     #COLOR(CO_BRTURQ, CO_BLACK)
00188C  2  8D 4A 06             STA     CURCOLOR
00188F  2  A9 EB A0 0A          PRINTMSG ttl_by
001893  2  20 ED 3B     
001896  2               
001896  2  A2 17                LDX     #23
001898  2  A0 12                LDY     #18
00189A  2  20 DB 3B             JSR     locate
00189D  2  A9 0E                LDA     #COLOR(CO_BRYELLOW, CO_BLACK)
00189F  2  8D 4A 06             STA     CURCOLOR
0018A2  2  A9 11 A0 0B          PRINTMSG ttl_prompt
0018A6  2  20 ED 3B     
0018A9  2               
0018A9  2  A2 14                LDX     #20
0018AB  2  A0 15                LDY     #21
0018AD  2  20 DB 3B             JSR     locate
0018B0  2  A9 0F                LDA     #COLOR(CO_BRWHITE, CO_BLACK)
0018B2  2  8D 4A 06             STA     CURCOLOR
0018B5  2  A9 32 A0 0B          PRINTMSG ttl_keys1
0018B9  2  20 ED 3B     
0018BC  2  A2 14                LDX     #20
0018BE  2  A0 16                LDY     #22
0018C0  2  20 DB 3B             JSR     locate
0018C3  2  A9 66 A0 0B          PRINTMSG ttl_keys2
0018C7  2  20 ED 3B     
0018CA  2  60                   RTS
0018CB  2               
0018CB  2               ;----------------------------------------------------------------
0018CB  2               ; draw_scenery - place tile objects on the landscape: forests, a
0018CB  2               ; castle, a lake, and a big dragon (boss glyph) menacing the scene.
0018CB  2               ;----------------------------------------------------------------
0018CB  2               draw_scenery:
0018CB  2  20 8D 3A             JSR     vid_enter
0018CE  2                       ; forests dotted along the ground (row 16/17)
0018CE  2  A2 00                LDX     #0
0018D0  2               @trees:
0018D0  2  BD 27 1A             LDA     tree_row,X
0018D3  2  85 21                STA     tmp1
0018D5  2  BD 30 1A             LDA     tree_col,X
0018D8  2  85 22                STA     tmp2
0018DA  2  A9 02                LDA     #G_FOREST
0018DC  2  85 23                STA     tmp3
0018DE  2  A9 0A                LDA     #C_FOREST
0018E0  2  85 26                STA     colidx
0018E2  2  DA                   PHX
0018E3  2  20 F9 3A             JSR     putcell
0018E6  2  FA                   PLX
0018E7  2  E8                   INX
0018E8  2  E0 09                CPX     #NTREES
0018EA  2  D0 E4                BNE     @trees
0018EC  2               
0018EC  2                       ; a castle on the left hill (row 14-15 area)
0018EC  2  A9 0E                LDA     #14
0018EE  2  85 21                STA     tmp1
0018F0  2  A9 06                LDA     #6
0018F2  2  85 22                STA     tmp2
0018F4  2  A9 07                LDA     #G_CASTLE
0018F6  2  85 23                STA     tmp3
0018F8  2  A9 8F                LDA     #C_CASTLE
0018FA  2  85 26                STA     colidx
0018FC  2  20 F9 3A             JSR     putcell
0018FF  2  A9 0E                LDA     #14
001901  2  85 21                STA     tmp1
001903  2  A9 07                LDA     #7
001905  2  85 22                STA     tmp2
001907  2  20 F9 3A             JSR     putcell
00190A  2               
00190A  2                       ; a small lake on the right (row 17)
00190A  2  A9 11                LDA     #17
00190C  2  85 21                STA     tmp1
00190E  2  A9 3E                LDA     #62
001910  2  85 22                STA     tmp2
001912  2  A9 04                LDA     #G_WATER
001914  2  85 23                STA     tmp3
001916  2  A9 1B                LDA     #C_WATER
001918  2  85 26                STA     colidx
00191A  2  A9 0A                LDA     #10
00191C  2  85 24                STA     cnt0
00191E  2  20 2F 3B             JSR     fillrow_vram
001921  2               
001921  2                       ; the DRAGON - big and red, hovering at the right of the sky
001921  2  A9 0C                LDA     #12
001923  2  85 21                STA     tmp1
001925  2  A9 3C                LDA     #60
001927  2  85 22                STA     tmp2
001929  2  A9 16                LDA     #G_BOSS
00192B  2  85 23                STA     tmp3
00192D  2  A9 1C                LDA     #COLOR(CO_BRRED, CO_BLUE)
00192F  2  85 26                STA     colidx
001931  2  20 F9 3A             JSR     putcell
001934  2                       ; a second dragon, smaller/left, different color
001934  2  A9 06                LDA     #6
001936  2  85 21                STA     tmp1
001938  2  A9 42                LDA     #66
00193A  2  85 22                STA     tmp2
00193C  2  A9 16                LDA     #G_BOSS
00193E  2  85 23                STA     tmp3
001940  2  A9 1E                LDA     #COLOR(CO_BRYELLOW, CO_BLUE)
001942  2  85 26                STA     colidx
001944  2  20 F9 3A             JSR     putcell
001947  2               
001947  2  4C 9C 3A             JMP     vid_exit
00194A  2               
00194A  2               ;----------------------------------------------------------------
00194A  2               ; draw_logo - stamp the big block-letter "WYRMHOLD" logo using
00194A  2               ; solid wall tiles in bright gold.  Each letter is a 5x5 bitmap
00194A  2               ; (5 bytes, top bit = leftmost of 5 columns).  Letters are spaced
00194A  2               ; BL_W+1 columns apart.
00194A  2               ;----------------------------------------------------------------
00194A  2               draw_logo:
00194A  2  20 8D 3A             JSR     vid_enter
00194D  2  A9 00                LDA     #0
00194F  2  8D 33 62             STA     logo_li         ; letter index
001952  2               @letter:
001952  2  AD 33 62             LDA     logo_li
001955  2  C9 08                CMP     #8              ; 8 letters
001957  2  90 03                BCC     :+
001959  2  4C E8 19             JMP     @done
00195C  2               :
00195C  2                       ; pointer to this letter's 5 bytes:  logo_font + li*5
00195C  2  AD 33 62             LDA     logo_li
00195F  2  85 20                STA     tmp0
001961  2  0A                   ASL     A               ; *2
001962  2  0A                   ASL     A               ; *4
001963  2  18                   CLC
001964  2  65 20                ADC     tmp0            ; *5
001966  2  A8                   TAY                     ; Y = li*5 offset into logo_font
001967  2                       ; left screen column for this letter = BL_COL + li*(BL_W+1)
001967  2  AD 33 62             LDA     logo_li
00196A  2  85 20                STA     tmp0
00196C  2  0A                   ASL     A               ; *2
00196D  2  0A                   ASL     A               ; *4
00196E  2  18                   CLC
00196F  2  65 20                ADC     tmp0            ; *5
001971  2  18                   CLC
001972  2  6D 33 62             ADC     logo_li         ; + li  -> li*6
001975  2  18                   CLC
001976  2  69 08                ADC     #BL_COL
001978  2  8D 34 62             STA     logo_lx         ; base column
00197B  2                       ; draw 5 rows
00197B  2  A9 00                LDA     #0
00197D  2  8D 35 62             STA     logo_ry
001980  2               @row:
001980  2  AD 35 62             LDA     logo_ry
001983  2  C9 05                CMP     #BL_H
001985  2  B0 5B                BCS     @nextletter
001987  2                       ; fetch the bitmap byte for (li,row): logo_font[li*5 + row]
001987  2  98                   TYA
001988  2  18                   CLC
001989  2  6D 35 62             ADC     logo_ry
00198C  2  AA                   TAX
00198D  2  BD EB 19             LDA     logo_font,X
001990  2  8D 37 62             STA     logo_bits       ; 5 bits, bit4..bit0 = cols 0..4
001993  2                       ; draw 5 columns
001993  2  A9 00                LDA     #0
001995  2  8D 36 62             STA     logo_cx
001998  2               @col:
001998  2  AD 36 62             LDA     logo_cx
00199B  2  C9 05                CMP     #BL_W
00199D  2  B0 32                BCS     @nextrow
00199F  2                       ; test bit (4 - cx) of logo_bits
00199F  2  A9 10                LDA     #%00010000      ; bit4 mask
0019A1  2  AE 36 62             LDX     logo_cx
0019A4  2  F0 04                BEQ     @havemask
0019A6  2               @shr:
0019A6  2  4A                   LSR     A
0019A7  2  CA                   DEX
0019A8  2  D0 FC                BNE     @shr
0019AA  2               @havemask:
0019AA  2  2D 37 62             AND     logo_bits
0019AD  2  F0 1C                BEQ     @blank
0019AF  2                       ; set pixel -> solid gold block
0019AF  2  AD 35 62             LDA     logo_ry
0019B2  2  18                   CLC
0019B3  2  69 03                ADC     #BL_ROW
0019B5  2  85 21                STA     tmp1            ; screen row
0019B7  2  AD 34 62             LDA     logo_lx
0019BA  2  18                   CLC
0019BB  2  6D 36 62             ADC     logo_cx
0019BE  2  85 22                STA     tmp2            ; screen col
0019C0  2  A9 0B                LDA     #G_WALL
0019C2  2  85 23                STA     tmp3
0019C4  2  A9 4E                LDA     #COLOR(CO_BRYELLOW, CO_RED)
0019C6  2  85 26                STA     colidx
0019C8  2  20 F9 3A             JSR     putcell
0019CB  2               @blank:
0019CB  2  EE 36 62             INC     logo_cx
0019CE  2  4C 98 19             JMP     @col
0019D1  2               @nextrow:
0019D1  2  EE 35 62             INC     logo_ry
0019D4  2                       ; Y must be reloaded (clobbered above): recompute li*5
0019D4  2  AD 33 62             LDA     logo_li
0019D7  2  85 20                STA     tmp0
0019D9  2  0A                   ASL     A
0019DA  2  0A                   ASL     A
0019DB  2  18                   CLC
0019DC  2  65 20                ADC     tmp0
0019DE  2  A8                   TAY
0019DF  2  4C 80 19             JMP     @row
0019E2  2               @nextletter:
0019E2  2  EE 33 62             INC     logo_li
0019E5  2  4C 52 19             JMP     @letter
0019E8  2               @done:
0019E8  2  4C 9C 3A             JMP     vid_exit
0019EB  2               
0019EB  2               ;----------------------------------------------------------------
0019EB  2               ; Big-letter 5x5 font for  W Y R M H O L D  (bit4..bit0 = 5 cols)
0019EB  2               ;----------------------------------------------------------------
0019EB  2               logo_font:
0019EB  2                       ; W
0019EB  2  11                   .BYTE   %10001
0019EC  2  11                   .BYTE   %10001
0019ED  2  15                   .BYTE   %10101
0019EE  2  1B                   .BYTE   %11011
0019EF  2  11                   .BYTE   %10001
0019F0  2                       ; Y
0019F0  2  11                   .BYTE   %10001
0019F1  2  0A                   .BYTE   %01010
0019F2  2  04                   .BYTE   %00100
0019F3  2  04                   .BYTE   %00100
0019F4  2  04                   .BYTE   %00100
0019F5  2                       ; R
0019F5  2  1E                   .BYTE   %11110
0019F6  2  11                   .BYTE   %10001
0019F7  2  1E                   .BYTE   %11110
0019F8  2  12                   .BYTE   %10010
0019F9  2  11                   .BYTE   %10001
0019FA  2                       ; M
0019FA  2  11                   .BYTE   %10001
0019FB  2  1B                   .BYTE   %11011
0019FC  2  15                   .BYTE   %10101
0019FD  2  11                   .BYTE   %10001
0019FE  2  11                   .BYTE   %10001
0019FF  2                       ; H
0019FF  2  11                   .BYTE   %10001
001A00  2  11                   .BYTE   %10001
001A01  2  1F                   .BYTE   %11111
001A02  2  11                   .BYTE   %10001
001A03  2  11                   .BYTE   %10001
001A04  2                       ; O
001A04  2  0E                   .BYTE   %01110
001A05  2  11                   .BYTE   %10001
001A06  2  11                   .BYTE   %10001
001A07  2  11                   .BYTE   %10001
001A08  2  0E                   .BYTE   %01110
001A09  2                       ; L
001A09  2  10                   .BYTE   %10000
001A0A  2  10                   .BYTE   %10000
001A0B  2  10                   .BYTE   %10000
001A0C  2  10                   .BYTE   %10000
001A0D  2  1F                   .BYTE   %11111
001A0E  2                       ; D
001A0E  2  1E                   .BYTE   %11110
001A0F  2  11                   .BYTE   %10001
001A10  2  11                   .BYTE   %10001
001A11  2  11                   .BYTE   %10001
001A12  2  1E                   .BYTE   %11110
001A13  2               
001A13  2               ;----------------------------------------------------------------
001A13  2               ; decorative element positions
001A13  2               ;----------------------------------------------------------------
001A13  2               NSTARS  = 10
001A13  2               star_row:
001A13  2  01 02 00 03          .BYTE   1, 2, 0, 3, 1, 2, 0, 4, 1, 3
001A17  2  01 02 00 04  
001A1B  2  01 03        
001A1D  2               star_col:
001A1D  2  04 0C 16 1E          .BYTE   4, 12, 22, 30, 44, 52, 58, 16, 70, 74
001A21  2  2C 34 3A 10  
001A25  2  46 4A        
001A27  2               
001A27  2               NTREES  = 9
001A27  2               tree_row:
001A27  2  10 11 10 10          .BYTE   16, 17, 16, 16, 17, 16, 17, 16, 16
001A2B  2  11 10 11 10  
001A2F  2  10           
001A30  2               tree_col:
001A30  2  12 18 1E 26          .BYTE   18, 24, 30, 38, 44, 50, 14, 56, 34
001A34  2  2C 32 0E 38  
001A38  2  22           
001A39  2               
001A39  1                       .INCLUDE "world.asm"
001A39  2               ;______________________________________________________________________________
001A39  2               ;  world.asm - map data, tile property tables and lookup helpers
001A39  2               ;
001A39  2               ;  Maps are authored as ASCII rows for readability and converted to
001A39  2               ;  tile codes once at startup (map_decode).  The decoded tile grids
001A39  2               ;  live in RAM (owmap / locmap).  Authoring characters:
001A39  2               ;     . grass   & forest  ^ mountain  ~ water   h hills   % marsh
001A39  2               ;     T town    O dungeon C castle    : road    = bridge
001A39  2               ;     space->grass
001A39  2               ;  For interiors (town/dungeon/castle/shrine):
001A39  2               ;     . floor   # wall     + door(exit)  $ treasure  < stairs up
001A39  2               ;     S shop    ~ water
001A39  2               ;______________________________________________________________________________
001A39  2               
001A39  2               ;----------------------------------------------------------------
001A39  2               ; Tile color table  (tile code -> color byte)
001A39  2               ;----------------------------------------------------------------
001A39  2               tile_color:
001A39  2  2A                   .BYTE   C_GRASS         ; 0
001A3A  2  0A                   .BYTE   C_FOREST        ; 1
001A3B  2  8F                   .BYTE   C_MOUNT         ; 2
001A3C  2  1B                   .BYTE   C_WATER         ; 3
001A3D  2  4E                   .BYTE   C_TOWN          ; 4
001A3E  2  0B                   .BYTE   C_DUNG          ; 5
001A3F  2  8F                   .BYTE   C_CASTLE        ; 6
001A40  2  4E                   .BYTE   C_ROAD          ; 7
001A41  2  1E                   .BYTE   C_BRIDGE        ; 8
001A42  2  08                   .BYTE   C_FLOOR         ; 9
001A43  2  8F                   .BYTE   C_WALL          ; 10
001A44  2  A0                   .BYTE   C_EXIT          ; 11 door (bright = exit)
001A45  2  0E                   .BYTE   C_TREAS         ; 12
001A46  2  A0                   .BYTE   C_EXIT          ; 13 stairs (bright = exit)
001A47  2  4E                   .BYTE   C_TOWN          ; 14 shop
001A48  2  2E                   .BYTE   C_HILLS         ; 15
001A49  2  1A                   .BYTE   C_MARSH         ; 16
001A4A  2               
001A4A  2               ;----------------------------------------------------------------
001A4A  2               ; Tile variant table  (tile code -> alternate metatile base, or 0)
001A4A  2               ; A non-zero entry means this terrain has a 2nd art variant; the
001A4A  2               ; renderer may use it instead of the MG_* base for some map cells
001A4A  2               ; to break up the repeating-grid look. 0 = no variant (use base).
001A4A  2               ;----------------------------------------------------------------
001A4A  2               tile_variant:
001A4A  2  E0                   .BYTE   MGV_GRASS       ; 0  grass
001A4B  2  E4                   .BYTE   MGV_FOREST      ; 1  forest
001A4C  2  EC                   .BYTE   MGV_MOUNT       ; 2  mountain
001A4D  2  E8                   .BYTE   MGV_WATER       ; 3  water
001A4E  2  00                   .BYTE   0               ; 4  town
001A4F  2  00                   .BYTE   0               ; 5  dungeon
001A50  2  00                   .BYTE   0               ; 6  castle
001A51  2  00                   .BYTE   0               ; 7  road
001A52  2  00                   .BYTE   0               ; 8  bridge
001A53  2  00                   .BYTE   0               ; 9  floor
001A54  2  00                   .BYTE   0               ; 10 wall
001A55  2  00                   .BYTE   0               ; 11 door
001A56  2  00                   .BYTE   0               ; 12 treasure
001A57  2  00                   .BYTE   0               ; 13 stairs
001A58  2  00                   .BYTE   0               ; 14 shop
001A59  2  00                   .BYTE   0               ; 15 hills
001A5A  2  00                   .BYTE   0               ; 16 marsh
001A5B  2               
001A5B  2               ;----------------------------------------------------------------
001A5B  2               ; Tile property table  (tile code -> property bits)
001A5B  2               ;   bit0 PASS    passable on foot
001A5B  2               ;   bit1 WATER   water (impassable without ship)
001A5B  2               ;   bit2 TOWN    stepping here enters a town
001A5B  2               ;   bit3 DUNG    stepping here enters the dungeon
001A5B  2               ;   bit4 EXIT    stepping here leaves the interior (town/dungeon)
001A5B  2               ;   bit5 TREAS   treasure to collect
001A5B  2               ;   bit6 SHOP    shop counter (open shop when adjacent/entering)
001A5B  2               ;   bit7 CASTLE  stepping here enters Wyrmhold Castle
001A5B  2               ;----------------------------------------------------------------
001A5B  2               P_PASS          = $01
001A5B  2               P_WATER         = $02
001A5B  2               P_TOWN          = $04
001A5B  2               P_DUNG          = $08
001A5B  2               P_EXIT          = $10
001A5B  2               P_TREAS         = $20
001A5B  2               P_SHOP          = $40
001A5B  2               P_CASTLE        = $80
001A5B  2               
001A5B  2               tile_prop:
001A5B  2  01                   .BYTE   P_PASS          ; 0 grass
001A5C  2  01                   .BYTE   P_PASS          ; 1 forest (passable, slow flavor)
001A5D  2  00                   .BYTE   $00             ; 2 mountain (blocked)
001A5E  2  02                   .BYTE   P_WATER         ; 3 water (blocked on foot)
001A5F  2  05                   .BYTE   P_PASS|P_TOWN   ; 4 town
001A60  2  09                   .BYTE   P_PASS|P_DUNG   ; 5 dungeon
001A61  2  81                   .BYTE   P_PASS|P_CASTLE ; 6 castle
001A62  2  01                   .BYTE   P_PASS          ; 7 road
001A63  2  01                   .BYTE   P_PASS          ; 8 bridge
001A64  2  01                   .BYTE   P_PASS          ; 9 floor
001A65  2  00                   .BYTE   $00             ; 10 wall
001A66  2  11                   .BYTE   P_PASS|P_EXIT   ; 11 door (exit interior)
001A67  2  21                   .BYTE   P_PASS|P_TREAS  ; 12 treasure
001A68  2  11                   .BYTE   P_PASS|P_EXIT   ; 13 stairs up (exit dungeon)
001A69  2  41                   .BYTE   P_PASS|P_SHOP   ; 14 shop
001A6A  2  01                   .BYTE   P_PASS          ; 15 hills
001A6B  2  01                   .BYTE   P_PASS          ; 16 marsh
001A6C  2               
001A6C  2               ;----------------------------------------------------------------
001A6C  2               ; Authoring char -> tile code translation (used by map_decode).
001A6C  2               ; Two parallel tables: chars[] and codes[], terminated by $00.
001A6C  2               ; The current decoder supplies the map-specific default tile:
001A6C  2               ; grass outdoors and floor indoors. Thus '.' and unknown/space
001A6C  2               ; characters become the appropriate default without a table entry.
001A6C  2               ;----------------------------------------------------------------
001A6C  2               dec_chars:
001A6C  2  26 5E 7E 54          .BYTE   "&^~TOC:=#+$<Sh%", $00
001A70  2  4F 43 3A 3D  
001A74  2  23 2B 24 3C  
001A7C  2               dec_codes:
001A7C  2  01                   .BYTE   T_FOREST        ; &
001A7D  2  02                   .BYTE   T_MOUNT         ; ^
001A7E  2  03                   .BYTE   T_WATER         ; ~
001A7F  2  04                   .BYTE   T_TOWN          ; T
001A80  2  05                   .BYTE   T_DUNG          ; O
001A81  2  06                   .BYTE   T_CASTLE        ; C
001A82  2  07                   .BYTE   T_ROAD          ; :
001A83  2  08                   .BYTE   T_BRIDGE        ; =
001A84  2  0A                   .BYTE   T_WALL          ; #
001A85  2  0B                   .BYTE   T_DOOR          ; +
001A86  2  0C                   .BYTE   T_TREAS         ; $
001A87  2  0D                   .BYTE   T_UPSTAIR       ; <
001A88  2  0E                   .BYTE   T_SHOP          ; S
001A89  2  0F                   .BYTE   T_HILLS         ; h
001A8A  2  10                   .BYTE   T_MARSH         ; %
001A8B  2               
001A8B  2               ; map a single authoring char (A) to a tile code -> A
001A8B  2               xlate_char:
001A8B  2  85 20                STA     tmp0
001A8D  2  A2 00                LDX     #0
001A8F  2               @f:
001A8F  2  BD 6C 1A             LDA     dec_chars,X
001A92  2  F0 07                BEQ     @nf
001A94  2  C5 20                CMP     tmp0
001A96  2  F0 06                BEQ     @ok
001A98  2  E8                   INX
001A99  2  D0 F4                BNE     @f
001A9B  2               @nf:
001A9B  2  A5 25                LDA     cnt1            ; map-specific default tile
001A9D  2  60                   RTS
001A9E  2               @ok:
001A9E  2  BD 7C 1A             LDA     dec_codes,X
001AA1  2  60                   RTS
001AA2  2               
001AA2  2               ;----------------------------------------------------------------
001AA2  2               ; map_decode - translate an authored ASCII map into a tile grid,
001AA2  2               ; row by row.  Each source row is a NUL-terminated string.  Rows
001AA2  2               ; shorter than the map width are padded with the map default; longer
001AA2  2               ; rows are truncated.  This makes exact source-row width unimportant.
001AA2  2               ;
001AA2  2               ;   IN : srcp -> first source row (rows packed back-to-back, each
001AA2  2               ;                NUL-terminated)
001AA2  2               ;        dstp -> destination tile-code buffer (width*height bytes)
001AA2  2               ;        tmp2 =  map width   (<=255)
001AA2  2               ;        tmp3 =  map height  (<=255)
001AA2  2               ;        cnt1 = default tile (grass outdoors, floor indoors)
001AA2  2               ;----------------------------------------------------------------
001AA2  2               ; NOTE: the column counter is kept in cnt0 (memory), NOT in X,
001AA2  2               ; because xlate_char clobbers X (it uses X as a search index).
001AA2  2               map_decode:
001AA2  2  A9 00                LDA     #0
001AA4  2  85 27                STA     rowidx          ; row counter
001AA6  2               @nextrow:
001AA6  2  A5 27                LDA     rowidx
001AA8  2  C5 23                CMP     tmp3
001AAA  2  B0 59                BCS     @done
001AAC  2  A9 00                LDA     #0
001AAE  2  85 24                STA     cnt0            ; column within row
001AB0  2               @col:
001AB0  2  A5 24                LDA     cnt0
001AB2  2  C5 22                CMP     tmp2
001AB4  2  B0 1E                BCS     @rowfull
001AB6  2               ; cnt0 tracks column for width logic; srcp is the read head.
001AB6  2  A0 00                LDY     #0
001AB8  2  B1 18                LDA     (srcp),Y
001ABA  2  F0 27                BEQ     @padrow         ; early NUL -> pad rest with grass
001ABC  2  20 8B 1A             JSR     xlate_char      ; A=tile code (clobbers X)
001ABF  2  A0 00                LDY     #0
001AC1  2  91 1A                STA     (dstp),Y
001AC3  2               ; advance read head and dest
001AC3  2  E6 18                INC     srcp
001AC5  2  D0 02                BNE     :+
001AC7  2  E6 19                INC     srcp+1
001AC9  2               :
001AC9  2  E6 1A                INC     dstp
001ACB  2  D0 02                BNE     :+
001ACD  2  E6 1B                INC     dstp+1
001ACF  2               :
001ACF  2  E6 24                INC     cnt0
001AD1  2  4C B0 1A             JMP     @col
001AD4  2               @rowfull:
001AD4  2               ; consume any extra source chars up to the terminating NUL
001AD4  2               @skip:
001AD4  2  A0 00                LDY     #0
001AD6  2  B1 18                LDA     (srcp),Y
001AD8  2  F0 20                BEQ     @aftrow
001ADA  2  E6 18                INC     srcp
001ADC  2  D0 F6                BNE     @skip
001ADE  2  E6 19                INC     srcp+1
001AE0  2  4C D4 1A             JMP     @skip
001AE3  2               @padrow:
001AE3  2               ; fill remaining columns (cnt0..width-1) with the map default
001AE3  2               @pad:
001AE3  2  A5 24                LDA     cnt0
001AE5  2  C5 22                CMP     tmp2
001AE7  2  B0 11                BCS     @aftrow
001AE9  2  A5 25                LDA     cnt1
001AEB  2  A0 00                LDY     #0
001AED  2  91 1A                STA     (dstp),Y
001AEF  2  E6 1A                INC     dstp
001AF1  2  D0 02                BNE     :+
001AF3  2  E6 1B                INC     dstp+1
001AF5  2               :
001AF5  2  E6 24                INC     cnt0
001AF7  2  4C E3 1A             JMP     @pad
001AFA  2               @aftrow:
001AFA  2               ; step srcp past the row terminator NUL
001AFA  2  E6 18                INC     srcp
001AFC  2  D0 02                BNE     :+
001AFE  2  E6 19                INC     srcp+1
001B00  2               :
001B00  2  E6 27                INC     rowidx
001B02  2  4C A6 1A             JMP     @nextrow
001B05  2               @done:
001B05  2  60                   RTS
001B06  2               
001B06  2               ;----------------------------------------------------------------
001B06  2               ; decode_world / decode_town / decode_dung / decode_castle / decode_shrine
001B06  2               ;----------------------------------------------------------------
001B06  2               decode_world:
001B06  2  A9 EE 85 18          SETW16  srcp, ow_src
001B0A  2  A9 1C 85 19  
001B0E  2  A9 B1 85 1A          SETW16  dstp, owmap
001B12  2  A9 63 85 1B  
001B16  2  A9 00                LDA     #T_GRASS
001B18  2  85 25                STA     cnt1
001B1A  2  A9 40                LDA     #OWW
001B1C  2  85 22                STA     tmp2
001B1E  2  A9 40                LDA     #OWH
001B20  2  85 23                STA     tmp3
001B22  2  4C A2 1A             JMP     map_decode
001B25  2               
001B25  2               decode_town:
001B25  2  AD 1A 62             LDA     town_id
001B28  2  C9 01                CMP     #TOWN_VALEHAVEN
001B2A  2  F0 0B                BEQ     @valehaven
001B2C  2  A9 A9 85 18          SETW16  srcp, eastmere_src
001B30  2  A9 2D 85 19  
001B34  2  4C 3F 1B             JMP     @decode
001B37  2               @valehaven:
001B37  2  A9 3D 85 18          SETW16  srcp, valehaven_src
001B3B  2  A9 30 85 19  
001B3F  2               @decode:
001B3F  2  A9 B1 85 1A          SETW16  dstp, locmap
001B43  2  A9 73 85 1B  
001B47  2  A9 09                LDA     #T_FLOOR
001B49  2  85 25                STA     cnt1
001B4B  2  A9 20                LDA     #TOWNW
001B4D  2  85 22                STA     tmp2
001B4F  2  A9 14                LDA     #TOWNH
001B51  2  85 23                STA     tmp3
001B53  2  4C A2 1A             JMP     map_decode
001B56  2               
001B56  2               decode_dung:
001B56  2  A9 D1 85 18          SETW16  srcp, dung_src
001B5A  2  A9 32 85 19  
001B5E  2  A9 B1 85 1A          SETW16  dstp, locmap
001B62  2  A9 73 85 1B  
001B66  2  A9 09                LDA     #T_FLOOR
001B68  2  85 25                STA     cnt1
001B6A  2  A9 20                LDA     #DUNGW
001B6C  2  85 22                STA     tmp2
001B6E  2  A9 14                LDA     #DUNGH
001B70  2  85 23                STA     tmp3
001B72  2  4C A2 1A             JMP     map_decode
001B75  2               
001B75  2               decode_castle:
001B75  2  A9 65 85 18          SETW16  srcp, castle_src
001B79  2  A9 35 85 19  
001B7D  2  A9 B1 85 1A          SETW16  dstp, locmap
001B81  2  A9 73 85 1B  
001B85  2  A9 09                LDA     #T_FLOOR
001B87  2  85 25                STA     cnt1
001B89  2  A9 20                LDA     #CASTLEW
001B8B  2  85 22                STA     tmp2
001B8D  2  A9 14                LDA     #CASTLEH
001B8F  2  85 23                STA     tmp3
001B91  2  4C A2 1A             JMP     map_decode
001B94  2               
001B94  2               decode_shrine:
001B94  2  A9 F9 85 18          SETW16  srcp, shrine_src
001B98  2  A9 37 85 19  
001B9C  2  A9 B1 85 1A          SETW16  dstp, locmap
001BA0  2  A9 73 85 1B  
001BA4  2  A9 09                LDA     #T_FLOOR
001BA6  2  85 25                STA     cnt1
001BA8  2  A9 20                LDA     #SHRINEW
001BAA  2  85 22                STA     tmp2
001BAC  2  A9 14                LDA     #SHRINEH
001BAE  2  85 23                STA     tmp3
001BB0  2  4C A2 1A             JMP     map_decode
001BB3  2               
001BB3  2               ;----------------------------------------------------------------
001BB3  2               ; region_from_y - classify an overworld latitude.
001BB3  2               ;   IN : A = overworld y coordinate
001BB3  2               ;   OUT: A = REGION_* id
001BB3  2               ;----------------------------------------------------------------
001BB3  2               region_from_y:
001BB3  2  C9 15                CMP     #REGION_ROW_VALE
001BB5  2  90 0A                BCC     @northreach
001BB7  2  C9 2C                CMP     #REGION_ROW_SUNKEN
001BB9  2  90 03                BCC     @vale
001BBB  2  A9 02                LDA     #REGION_SUNKEN
001BBD  2  60                   RTS
001BBE  2               @vale:
001BBE  2  A9 01                LDA     #REGION_VALE
001BC0  2  60                   RTS
001BC1  2               @northreach:
001BC1  2  A9 00                LDA     #REGION_NORTHREACH
001BC3  2  60                   RTS
001BC4  2               
001BC4  2               ;----------------------------------------------------------------
001BC4  2               ; tileat - read the tile code at (tgtx,tgty) from the ACTIVE map.
001BC4  2               ;   IN : tgtx, tgty ; loc (LOC_*) selects map + width
001BC4  2               ;   OUT: A = tile code, also stored in tgttile
001BC4  2               ;        if out of bounds -> returns T_WATER (overworld) / T_WALL (int)
001BC4  2               ;   Trashes ptr, tmp0, tmp1
001BC4  2               ;----------------------------------------------------------------
001BC4  2               tileat:
001BC4  2  AD 19 62             LDA     loc
001BC7  2  D0 52                BNE     @interior
001BC9  2               ;--- overworld ---
001BC9  2               ; bounds check 0..OWW-1 / 0..OWH-1
001BC9  2  A5 2C                LDA     tgtx
001BCB  2  C9 40                CMP     #OWW
001BCD  2  B0 47                BCS     @oob_world
001BCF  2  A5 2D                LDA     tgty
001BD1  2  C9 40                CMP     #OWH
001BD3  2  B0 41                BCS     @oob_world
001BD5  2               ; offset = tgty*OWW + tgtx  (OWW=64 -> *64)
001BD5  2  A5 2D                LDA     tgty
001BD7  2  85 10                STA     ptr
001BD9  2  A9 00                LDA     #0
001BDB  2  85 11                STA     ptr+1
001BDD  2  06 10                ASL     ptr
001BDF  2  26 11                ROL     ptr+1           ; *2
001BE1  2  06 10                ASL     ptr
001BE3  2  26 11                ROL     ptr+1           ; *4
001BE5  2  06 10                ASL     ptr
001BE7  2  26 11                ROL     ptr+1           ; *8
001BE9  2  06 10                ASL     ptr
001BEB  2  26 11                ROL     ptr+1           ; *16
001BED  2  06 10                ASL     ptr
001BEF  2  26 11                ROL     ptr+1           ; *32
001BF1  2  06 10                ASL     ptr
001BF3  2  26 11                ROL     ptr+1           ; *64
001BF5  2  18                   CLC
001BF6  2  A5 10                LDA     ptr
001BF8  2  65 2C                ADC     tgtx
001BFA  2  85 10                STA     ptr
001BFC  2  A5 11                LDA     ptr+1
001BFE  2  69 00                ADC     #0
001C00  2  85 11                STA     ptr+1
001C02  2               ; ptr += owmap base
001C02  2  18                   CLC
001C03  2  A5 10                LDA     ptr
001C05  2  69 B1                ADC     #<owmap
001C07  2  85 10                STA     ptr
001C09  2  A5 11                LDA     ptr+1
001C0B  2  69 63                ADC     #>owmap
001C0D  2  85 11                STA     ptr+1
001C0F  2  A0 00                LDY     #0
001C11  2  B1 10                LDA     (ptr),Y
001C13  2  85 2E                STA     tgttile
001C15  2  60                   RTS
001C16  2               @oob_world:
001C16  2  A9 03                LDA     #T_WATER
001C18  2  85 2E                STA     tgttile
001C1A  2  60                   RTS
001C1B  2               ;--- interior (town/dungeon): width = locw, height = loch ---
001C1B  2               @interior:
001C1B  2  A5 2C                LDA     tgtx
001C1D  2  CD 1C 62             CMP     locw
001C20  2  B0 44                BCS     @oob_int
001C22  2  A5 2D                LDA     tgty
001C24  2  CD 1D 62             CMP     loch
001C27  2  B0 3D                BCS     @oob_int
001C29  2               ; offset = tgty*locw + tgtx  (locw is 32)
001C29  2  A5 2D                LDA     tgty
001C2B  2  85 10                STA     ptr
001C2D  2  A9 00                LDA     #0
001C2F  2  85 11                STA     ptr+1
001C31  2  06 10                ASL     ptr
001C33  2  26 11                ROL     ptr+1           ; *2
001C35  2  06 10                ASL     ptr
001C37  2  26 11                ROL     ptr+1           ; *4
001C39  2  06 10                ASL     ptr
001C3B  2  26 11                ROL     ptr+1           ; *8
001C3D  2  06 10                ASL     ptr
001C3F  2  26 11                ROL     ptr+1           ; *16
001C41  2  06 10                ASL     ptr
001C43  2  26 11                ROL     ptr+1           ; *32  (locw assumed 32)
001C45  2  18                   CLC
001C46  2  A5 10                LDA     ptr
001C48  2  65 2C                ADC     tgtx
001C4A  2  85 10                STA     ptr
001C4C  2  A5 11                LDA     ptr+1
001C4E  2  69 00                ADC     #0
001C50  2  85 11                STA     ptr+1
001C52  2  18                   CLC
001C53  2  A5 10                LDA     ptr
001C55  2  69 B1                ADC     #<locmap
001C57  2  85 10                STA     ptr
001C59  2  A5 11                LDA     ptr+1
001C5B  2  69 73                ADC     #>locmap
001C5D  2  85 11                STA     ptr+1
001C5F  2  A0 00                LDY     #0
001C61  2  B1 10                LDA     (ptr),Y
001C63  2  85 2E                STA     tgttile
001C65  2  60                   RTS
001C66  2               @oob_int:
001C66  2  A9 0A                LDA     #T_WALL
001C68  2  85 2E                STA     tgttile
001C6A  2  60                   RTS
001C6B  2               
001C6B  2               ;----------------------------------------------------------------
001C6B  2               ; settile - write tile code A at (tgtx,tgty) in the active map.
001C6B  2               ;   Used to clear treasure chests once collected, etc.
001C6B  2               ;   Recomputes the address exactly like tileat.
001C6B  2               ;----------------------------------------------------------------
001C6B  2               settile:
001C6B  2  85 21                STA     tmp1            ; new tile
001C6D  2  20 77 1C             JSR     tile_addr       ; ptr -> cell
001C70  2  A0 00                LDY     #0
001C72  2  A5 21                LDA     tmp1
001C74  2  91 10                STA     (ptr),Y
001C76  2  60                   RTS
001C77  2               
001C77  2               ; tile_addr - compute ptr -> active-map cell for (tgtx,tgty).
001C77  2               ; (assumes in-bounds; callers that might be OOB use tileat first)
001C77  2               tile_addr:
001C77  2  AD 19 62             LDA     loc
001C7A  2  D0 3B                BNE     @int
001C7C  2  A5 2D                LDA     tgty
001C7E  2  85 10                STA     ptr
001C80  2  A9 00                LDA     #0
001C82  2  85 11                STA     ptr+1
001C84  2  06 10                ASL     ptr
001C86  2  26 11                ROL     ptr+1
001C88  2  06 10                ASL     ptr
001C8A  2  26 11                ROL     ptr+1
001C8C  2  06 10                ASL     ptr
001C8E  2  26 11                ROL     ptr+1
001C90  2  06 10                ASL     ptr
001C92  2  26 11                ROL     ptr+1
001C94  2  06 10                ASL     ptr
001C96  2  26 11                ROL     ptr+1
001C98  2  06 10                ASL     ptr
001C9A  2  26 11                ROL     ptr+1           ; *64
001C9C  2  18                   CLC
001C9D  2  A5 10                LDA     ptr
001C9F  2  65 2C                ADC     tgtx
001CA1  2  85 10                STA     ptr
001CA3  2  A5 11                LDA     ptr+1
001CA5  2  69 00                ADC     #0
001CA7  2  85 11                STA     ptr+1
001CA9  2  18                   CLC
001CAA  2  A5 10                LDA     ptr
001CAC  2  69 B1                ADC     #<owmap
001CAE  2  85 10                STA     ptr
001CB0  2  A5 11                LDA     ptr+1
001CB2  2  69 63                ADC     #>owmap
001CB4  2  85 11                STA     ptr+1
001CB6  2  60                   RTS
001CB7  2               @int:
001CB7  2  A5 2D                LDA     tgty
001CB9  2  85 10                STA     ptr
001CBB  2  A9 00                LDA     #0
001CBD  2  85 11                STA     ptr+1
001CBF  2  06 10                ASL     ptr
001CC1  2  26 11                ROL     ptr+1
001CC3  2  06 10                ASL     ptr
001CC5  2  26 11                ROL     ptr+1
001CC7  2  06 10                ASL     ptr
001CC9  2  26 11                ROL     ptr+1
001CCB  2  06 10                ASL     ptr
001CCD  2  26 11                ROL     ptr+1
001CCF  2  06 10                ASL     ptr
001CD1  2  26 11                ROL     ptr+1           ; *32
001CD3  2  18                   CLC
001CD4  2  A5 10                LDA     ptr
001CD6  2  65 2C                ADC     tgtx
001CD8  2  85 10                STA     ptr
001CDA  2  A5 11                LDA     ptr+1
001CDC  2  69 00                ADC     #0
001CDE  2  85 11                STA     ptr+1
001CE0  2  18                   CLC
001CE1  2  A5 10                LDA     ptr
001CE3  2  69 B1                ADC     #<locmap
001CE5  2  85 10                STA     ptr
001CE7  2  A5 11                LDA     ptr+1
001CE9  2  69 73                ADC     #>locmap
001CEB  2  85 11                STA     ptr+1
001CED  2  60                   RTS
001CEE  2               
001CEE  2               ;----------------------------------------------------------------
001CEE  2               ; Authored overworld map (64 x 64).
001CEE  2               ; Surrounded by water; a central continent with two towns, a
001CEE  2               ; castle, the dungeon entrance, forests, mountains and a river
001CEE  2               ; crossed by a bridge.
001CEE  2               ;----------------------------------------------------------------
001CEE  2               ; Maps are stored as NUL-terminated rows.  The decoder pads short
001CEE  2               ; rows with the map default and truncates long ones, so the exact
001CEE  2               ; authored width of each row is not critical (target widths shown
001CEE  2               ; in the header rulers for readability).
001CEE  2               ow_src:
001CEE  2               ;        0         1         2         3         4         5         6
001CEE  2               ;        0123456789012345678901234567890123456789012345678901234567890123
001CEE  2  7E 7E 7E 7E          .BYTE   "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~",0
