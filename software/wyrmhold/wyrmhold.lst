000BED  1               
000BED  1               ;==============================================================================
000BED  1               ; Include the rest of the engine
000BED  1               ;==============================================================================
000BED  1                       .INCLUDE "rng.asm"
000BED  2               ;______________________________________________________________________________
000BED  2               ;  rng.asm - 16-bit xorshift pseudo-random generator
000BED  2               ;______________________________________________________________________________
000BED  2               
000BED  2               ;----------------------------------------------------------------
000BED  2               ; rng_seed - initialise the generator (avoid all-zero state).
000BED  2               ;----------------------------------------------------------------
000BED  2               rng_seed:
000BED  2  A9 A3                LDA     #$A3
000BEF  2  85 30                STA     seedlo
000BF1  2  A9 1C                LDA     #$1C
000BF3  2  85 31                STA     seedhi
000BF5  2  60                   RTS
000BF6  2               
000BF6  2               ;----------------------------------------------------------------
000BF6  2               ; rng_next - advance the 16-bit xorshift state, return low byte
000BF6  2               ;            in A.  (xorshift: x ^= x<<7; x ^= x>>9; x ^= x<<8)
000BF6  2               ;----------------------------------------------------------------
000BF6  2               rng_next:
000BF6  2               ; x ^= x << 7
000BF6  2  A5 31                LDA     seedhi
000BF8  2  4A                   LSR     A               ; carry = bit7 of hi after some shifts...
000BF9  2               ; Implement x<<7 via: shift left 7 = shift right 1 then swap?
000BF9  2               ; Simpler: do a byte-wise xorshift that is "good enough".
000BF9  2               ; x ^= x << 7
000BF9  2  A5 30                LDA     seedlo
000BFB  2  0A                   ASL     A
000BFC  2  0A                   ASL     A
000BFD  2  0A                   ASL     A
000BFE  2  0A                   ASL     A
000BFF  2  0A                   ASL     A
000C00  2  0A                   ASL     A
000C01  2  0A                   ASL     A               ; lo << 7 (only bit0 survives into bit7)
000C02  2  45 31                EOR     seedhi
000C04  2  85 31                STA     seedhi
000C06  2               ; x ^= x >> 9  (>>9 of 16-bit = hi >> 1 into lo)
000C06  2  A5 31                LDA     seedhi
000C08  2  4A                   LSR     A
000C09  2  45 30                EOR     seedlo
000C0B  2  85 30                STA     seedlo
000C0D  2               ; x ^= x << 8  (swap bytes contribution: lo ^ into hi)
000C0D  2  A5 30                LDA     seedlo
000C0F  2  45 31                EOR     seedhi
000C11  2  85 31                STA     seedhi
000C13  2  A5 30                LDA     seedlo
000C15  2  60                   RTS
000C16  2               
000C16  2               ;----------------------------------------------------------------
000C16  2               ; rng_mod - return a value 0..A-1 in A.  IN: A = modulus (1..255)
000C16  2               ;           (uses repeated subtraction mask via AND for powers of
000C16  2               ;            two is faster, but generic mod via subtract loop here)
000C16  2               ;----------------------------------------------------------------
000C16  2               rng_mod:
000C16  2  85 23                STA     tmp3            ; modulus
000C18  2  20 F6 0B             JSR     rng_next        ; A = random byte
000C1B  2               ; reduce A mod tmp3 by subtraction
000C1B  2               @rm:
000C1B  2  C5 23                CMP     tmp3
000C1D  2  90 06                BCC     @done
000C1F  2  38                   SEC
000C20  2  E5 23                SBC     tmp3
000C22  2  4C 1B 0C             JMP     @rm
000C25  2               @done:
000C25  2  60                   RTS
000C26  2               
000C26  2               ;----------------------------------------------------------------
000C26  2               ; rng_d - roll a die: return 1..A in A.  IN: A = sides (1..255)
000C26  2               ;----------------------------------------------------------------
000C26  2               rng_d:
000C26  2  20 16 0C             JSR     rng_mod
000C29  2  18                   CLC
000C2A  2  69 01                ADC     #1
000C2C  2  60                   RTS
000C2D  2               
000C2D  1                       .INCLUDE "sound.asm"
000C2D  2               ;______________________________________________________________________________
000C2D  2               ;  sound.asm - AY-3-8910 PSG sound effects and cooperative music player
000C2D  2               ;
000C2D  2               ;  PSG access ported from software/dbasic/ay38910.asm (PPI at $E230).
000C2D  2               ;  psgwr: A=register, Y=value        psgrd: A=register -> Y=value
000C2D  2               ;
000C2D  2               ;  AY register map:
000C2D  2               ;    0/1  ch A tone period (lo / hi 4 bits)
000C2D  2               ;    2/3  ch B tone period
000C2D  2               ;    4/5  ch C tone period
000C2D  2               ;    6    noise period (5 bits)
000C2D  2               ;    7    mixer: bit clear = enabled. 0-2 tone A/B/C, 3-5 noise A/B/C
000C2D  2               ;    8/9/10 ch A/B/C volume (0-15, bit4 = use envelope)
000C2D  2               ;    11/12 envelope period
000C2D  2               ;    13   envelope shape
000C2D  2               ;______________________________________________________________________________
000C2D  2               
000C2D  2               PPI_BASE        = $E230
000C2D  2               ppiPortA        = PPI_BASE+0
000C2D  2               ppiPortB        = PPI_BASE+1
000C2D  2               ppiPortC        = PPI_BASE+2
000C2D  2               ppiControl      = PPI_BASE+3
000C2D  2               
000C2D  2               ;----------------------------------------------------------------
000C2D  2               ; psg_init - put the PSG into a known, silent state
000C2D  2               ;----------------------------------------------------------------
000C2D  2               psg_init:
000C2D  2  A9 80                LDA     #%10000000
000C2F  2  8D 33 E2             STA     ppiControl
000C32  2  A9 10                LDA     #%00010000
000C34  2  8D 32 E2             STA     ppiPortC
000C37  2  A9 00                LDA     #$00
000C39  2  8D 31 E2             STA     ppiPortB
000C3C  2  20 40 0C             JSR     clrpsg
000C3F  2  60                   RTS
000C40  2               
000C40  2               ;----------------------------------------------------------------
000C40  2               ; clrpsg - zero all 16 registers, then disable all channels
000C40  2               ;----------------------------------------------------------------
000C40  2               clrpsg:
000C40  2  A2 00                LDX     #00
000C42  2  A0 00                LDY     #00
000C44  2               @cp1:
000C44  2  8A                   TXA
000C45  2  20 72 0C             JSR     psgwr
000C48  2  E8                   INX
000C49  2  E0 10                CPX     #16
000C4B  2  D0 F7                BNE     @cp1
000C4D  2  A9 07                LDA     #07
000C4F  2  A0 3F                LDY     #%00111111      ; all tone + noise disabled
000C51  2  20 72 0C             JSR     psgwr
000C54  2  60                   RTS
000C55  2               
000C55  2               ;----------------------------------------------------------------
000C55  2               ; psg_silence - silence all three channels (volumes -> 0)
000C55  2               ;----------------------------------------------------------------
000C55  2               psg_silence:
000C55  2  A9 08                LDA     #8
000C57  2  A0 00                LDY     #0
000C59  2  20 72 0C             JSR     psgwr
000C5C  2  A9 09                LDA     #9
000C5E  2  A0 00                LDY     #0
000C60  2  20 72 0C             JSR     psgwr
000C63  2  A9 0A                LDA     #10
000C65  2  A0 00                LDY     #0
000C67  2  20 72 0C             JSR     psgwr
000C6A  2  A9 07                LDA     #07
000C6C  2  A0 3F                LDY     #%00111111
000C6E  2  20 72 0C             JSR     psgwr
000C71  2  60                   RTS
000C72  2               
000C72  2               ;----------------------------------------------------------------
000C72  2               ; psgwr - write Y into PSG register A     (trashes A)
000C72  2               ;----------------------------------------------------------------
000C72  2               psgwr:
000C72  2  8D 31 E2             STA     ppiPortB        ; select register
000C75  2  A9 1C                LDA     #%00011100      ; latch address
000C77  2  8D 32 E2             STA     ppiPortC
000C7A  2  8D 32 E2             STA     ppiPortC
000C7D  2  8D 32 E2             STA     ppiPortC
000C80  2  A9 10                LDA     #%00010000      ; inactive
000C82  2  8D 32 E2             STA     ppiPortC
000C85  2  8D 32 E2             STA     ppiPortC
000C88  2  8D 32 E2             STA     ppiPortC
000C8B  2  98                   TYA
000C8C  2  8D 31 E2             STA     ppiPortB        ; store data
000C8F  2  8D 31 E2             STA     ppiPortB
000C92  2  8D 31 E2             STA     ppiPortB
000C95  2  A9 14                LDA     #%00010100      ; latch data
000C97  2  8D 32 E2             STA     ppiPortC
000C9A  2  8D 32 E2             STA     ppiPortC
000C9D  2  8D 32 E2             STA     ppiPortC
000CA0  2  A9 10                LDA     #%00010000      ; inactive
000CA2  2  8D 32 E2             STA     ppiPortC
000CA5  2  60                   RTS
000CA6  2               
000CA6  2               ;----------------------------------------------------------------
000CA6  2               ; psgrd - read PSG register A into Y      (trashes A)
000CA6  2               ;----------------------------------------------------------------
000CA6  2               psgrd:
000CA6  2  8D 31 E2             STA     ppiPortB        ; select register
000CA9  2  A9 1C                LDA     #%00011100      ; latch address
000CAB  2  8D 32 E2             STA     ppiPortC
000CAE  2  8D 32 E2             STA     ppiPortC
000CB1  2  8D 32 E2             STA     ppiPortC
000CB4  2  A9 10                LDA     #%00010000      ; inactive
000CB6  2  8D 32 E2             STA     ppiPortC
000CB9  2  8D 32 E2             STA     ppiPortC
000CBC  2  A9 82                LDA     #%10000010
000CBE  2  8D 33 E2             STA     ppiControl
000CC1  2  A9 18                LDA     #%00011000      ; latch data
000CC3  2  8D 32 E2             STA     ppiPortC
000CC6  2  8D 32 E2             STA     ppiPortC
000CC9  2  8D 32 E2             STA     ppiPortC
000CCC  2  AD 31 E2             LDA     ppiPortB        ; read data
000CCF  2  A8                   TAY
000CD0  2  A9 80                LDA     #%10000000
000CD2  2  8D 33 E2             STA     ppiControl
000CD5  2  A9 10                LDA     #%00010000      ; inactive
000CD7  2  8D 32 E2             STA     ppiPortC
000CDA  2  60                   RTS
000CDB  2               
000CDB  2               ;----------------------------------------------------------------
000CDB  2               ; tone_on - start a tone on channel A.
000CDB  2               ;   ptr (16-bit) = 12-bit tone period (lo in ptr, hi in ptr+1)
000CDB  2               ;   tmp0         = volume (0-15)
000CDB  2               ;----------------------------------------------------------------
000CDB  2               tone_on:
000CDB  2  A9 00                LDA     #0              ; ch A period low
000CDD  2  A4 10                LDY     ptr
000CDF  2  20 72 0C             JSR     psgwr
000CE2  2  A9 01                LDA     #1              ; ch A period high
000CE4  2  A4 11                LDY     ptr+1
000CE6  2  20 72 0C             JSR     psgwr
000CE9  2  A9 07                LDA     #07             ; mixer: enable tone A only
000CEB  2  A0 3E                LDY     #%00111110
000CED  2  20 72 0C             JSR     psgwr
000CF0  2  A9 08                LDA     #8              ; ch A volume
000CF2  2  A4 20                LDY     tmp0
000CF4  2  20 72 0C             JSR     psgwr
000CF7  2  60                   RTS
000CF8  2               
000CF8  2               ;----------------------------------------------------------------
000CF8  2               ; busywait - crude delay.  X = outer count.
000CF8  2               ;----------------------------------------------------------------
000CF8  2               busywait:
000CF8  2               @bw0:
000CF8  2  A0 00                LDY     #0
000CFA  2               @bw1:
000CFA  2  A9 00                LDA     #0
000CFC  2               @bw2:
000CFC  2  18                   CLC
000CFD  2  69 01                ADC     #1
000CFF  2  C9 28                CMP     #40
000D01  2  D0 F9                BNE     @bw2
000D03  2  C8                   INY
000D04  2  D0 F4                BNE     @bw1
000D06  2  CA                   DEX
000D07  2  D0 EF                BNE     @bw0
000D09  2  60                   RTS
000D0A  2               
000D0A  2               ;----------------------------------------------------------------
000D0A  2               ; mus_finewait - a short, fine-grained delay for tempo trimming.
000D0A  2               ; Spins MUS_FINEDELAY outer times, 256 inner each.  Much smaller
000D0A  2               ; than one busywait pass, so it gives sub-step tempo control.
000D0A  2               ;----------------------------------------------------------------
000D0A  2               mus_finewait:
000D0A  2  A2 46                LDX     #MUS_FINEDELAY
000D0C  2  F0 08                BEQ     @done
000D0E  2               @fw0:
000D0E  2  A0 00                LDY     #0
000D10  2               @fw1:
000D10  2  C8                   INY
000D11  2  D0 FD                BNE     @fw1
000D13  2  CA                   DEX
000D14  2  D0 F8                BNE     @fw0
000D16  2               @done:
000D16  2  60                   RTS
000D17  2               
000D17  2               ;----------------------------------------------------------------
000D17  2               ; SFX helpers.  Each plays a short, self-contained sound and
000D17  2               ; silences the PSG afterwards.  All preserve nothing - callers
000D17  2               ; must save anything they need.
000D17  2               ;----------------------------------------------------------------
000D17  2               
000D17  2               ; sfx_move - very short low blip
000D17  2               sfx_move:
000D17  2  A9 40 85 10          SETW16  ptr, $0240
000D1B  2  A9 02 85 11  
000D1F  2  A9 06                LDA     #6
000D21  2  85 20                STA     tmp0
000D23  2  20 DB 0C             JSR     tone_on
000D26  2  A2 02                LDX     #2
000D28  2  20 F8 0C             JSR     busywait
000D2B  2  4C 55 0C             JMP     psg_silence
000D2E  2               
000D2E  2               ; sfx_blocked - low buzz (use noise)
000D2E  2               sfx_blocked:
000D2E  2  A9 06                LDA     #6              ; noise period
000D30  2  A0 14                LDY     #20
000D32  2  20 72 0C             JSR     psgwr
000D35  2  A9 07                LDA     #07             ; enable noise A
000D37  2  A0 37                LDY     #%00110111
000D39  2  20 72 0C             JSR     psgwr
000D3C  2  A9 08                LDA     #8
000D3E  2  A0 0A                LDY     #10
000D40  2  20 72 0C             JSR     psgwr
000D43  2  A2 03                LDX     #3
000D45  2  20 F8 0C             JSR     busywait
000D48  2  4C 55 0C             JMP     psg_silence
000D4B  2               
000D4B  2               ; sfx_hit - quick high zap
000D4B  2               sfx_hit:
000D4B  2  A9 C0 85 10          SETW16  ptr, $00C0
000D4F  2  A9 00 85 11  
000D53  2  A9 0C                LDA     #12
000D55  2  85 20                STA     tmp0
000D57  2  20 DB 0C             JSR     tone_on
000D5A  2  A2 02                LDX     #2
000D5C  2  20 F8 0C             JSR     busywait
000D5F  2  A9 40 85 10          SETW16  ptr, $0140
000D63  2  A9 01 85 11  
000D67  2  A9 0A                LDA     #10
000D69  2  85 20                STA     tmp0
000D6B  2  20 DB 0C             JSR     tone_on
000D6E  2  A2 02                LDX     #2
000D70  2  20 F8 0C             JSR     busywait
000D73  2  4C 55 0C             JMP     psg_silence
000D76  2               
000D76  2               ; sfx_killed - falling tone + noise
000D76  2               sfx_killed:
000D76  2  A9 06                LDA     #6
000D78  2  A0 10                LDY     #16
000D7A  2  20 72 0C             JSR     psgwr
000D7D  2  A9 07                LDA     #07
000D7F  2  A0 37                LDY     #%00110111
000D81  2  20 72 0C             JSR     psgwr
000D84  2  A9 08                LDA     #8
000D86  2  A0 0D                LDY     #13
000D88  2  20 72 0C             JSR     psgwr
000D8B  2  A2 05                LDX     #5
000D8D  2  20 F8 0C             JSR     busywait
000D90  2  4C 55 0C             JMP     psg_silence
000D93  2               
000D93  2               ; sfx_treasure - bright rising arpeggio
000D93  2               sfx_treasure:
000D93  2  A9 50 85 10          SETW16  ptr, $0150
000D97  2  A9 01 85 11  
000D9B  2  A9 0D                LDA     #13
000D9D  2  85 20                STA     tmp0
000D9F  2  20 DB 0C             JSR     tone_on
000DA2  2  A2 02                LDX     #2
000DA4  2  20 F8 0C             JSR     busywait
000DA7  2  A9 FC 85 10          SETW16  ptr, $00FC
000DAB  2  A9 00 85 11  
000DAF  2  20 DB 0C             JSR     tone_on
000DB2  2  A2 02                LDX     #2
000DB4  2  20 F8 0C             JSR     busywait
000DB7  2  A9 A8 85 10          SETW16  ptr, $00A8
000DBB  2  A9 00 85 11  
000DBF  2  20 DB 0C             JSR     tone_on
000DC2  2  A2 03                LDX     #3
000DC4  2  20 F8 0C             JSR     busywait
000DC7  2  4C 55 0C             JMP     psg_silence
000DCA  2               
000DCA  2               ; sfx_levelup - three ascending happy notes
000DCA  2               sfx_levelup:
000DCA  2  A9 FC 85 10          SETW16  ptr, $00FC
000DCE  2  A9 00 85 11  
000DD2  2  A9 0E                LDA     #14
000DD4  2  85 20                STA     tmp0
000DD6  2  20 DB 0C             JSR     tone_on
000DD9  2  A2 03                LDX     #3
000DDB  2  20 F8 0C             JSR     busywait
000DDE  2  A9 C8 85 10          SETW16  ptr, $00C8
000DE2  2  A9 00 85 11  
000DE6  2  20 DB 0C             JSR     tone_on
000DE9  2  A2 03                LDX     #3
000DEB  2  20 F8 0C             JSR     busywait
000DEE  2  A9 A8 85 10          SETW16  ptr, $00A8
000DF2  2  A9 00 85 11  
000DF6  2  20 DB 0C             JSR     tone_on
000DF9  2  A2 04                LDX     #4
000DFB  2  20 F8 0C             JSR     busywait
000DFE  2  4C 55 0C             JMP     psg_silence
000E01  2               
000E01  2               ; sfx_door - short two-tone chime
000E01  2               sfx_door:
000E01  2  A9 80 85 10          SETW16  ptr, $0180
000E05  2  A9 01 85 11  
000E09  2  A9 0B                LDA     #11
000E0B  2  85 20                STA     tmp0
000E0D  2  20 DB 0C             JSR     tone_on
000E10  2  A2 02                LDX     #2
000E12  2  20 F8 0C             JSR     busywait
000E15  2  A9 20 85 10          SETW16  ptr, $0120
000E19  2  A9 01 85 11  
000E1D  2  20 DB 0C             JSR     tone_on
000E20  2  A2 03                LDX     #3
000E22  2  20 F8 0C             JSR     busywait
000E25  2  4C 55 0C             JMP     psg_silence
000E28  2               
000E28  2               ; sfx_lose - long descending sad tone
000E28  2               sfx_lose:
000E28  2  A9 20 85 10          SETW16  ptr, $0120
000E2C  2  A9 01 85 11  
000E30  2  A9 0D                LDA     #13
000E32  2  85 20                STA     tmp0
000E34  2  20 DB 0C             JSR     tone_on
000E37  2  A2 06                LDX     #6
000E39  2  20 F8 0C             JSR     busywait
000E3C  2  A9 C0 85 10          SETW16  ptr, $01C0
000E40  2  A9 01 85 11  
000E44  2  20 DB 0C             JSR     tone_on
000E47  2  A2 06                LDX     #6
000E49  2  20 F8 0C             JSR     busywait
000E4C  2  A9 80 85 10          SETW16  ptr, $0280
000E50  2  A9 02 85 11  
000E54  2  20 DB 0C             JSR     tone_on
000E57  2  A2 0A                LDX     #10
000E59  2  20 F8 0C             JSR     busywait
000E5C  2  4C 55 0C             JMP     psg_silence
000E5F  2               
000E5F  2               ; sfx_win - triumphant fanfare
000E5F  2               sfx_win:
000E5F  2  A9 FC 85 10          SETW16  ptr, $00FC
000E63  2  A9 00 85 11  
000E67  2  A9 0F                LDA     #15
000E69  2  85 20                STA     tmp0
000E6B  2  20 DB 0C             JSR     tone_on
000E6E  2  A2 04                LDX     #4
000E70  2  20 F8 0C             JSR     busywait
000E73  2  A9 C8 85 10          SETW16  ptr, $00C8
000E77  2  A9 00 85 11  
000E7B  2  20 DB 0C             JSR     tone_on
000E7E  2  A2 04                LDX     #4
000E80  2  20 F8 0C             JSR     busywait
000E83  2  A9 A8 85 10          SETW16  ptr, $00A8
000E87  2  A9 00 85 11  
000E8B  2  20 DB 0C             JSR     tone_on
000E8E  2  A2 04                LDX     #4
000E90  2  20 F8 0C             JSR     busywait
000E93  2  A9 7E 85 10          SETW16  ptr, $007E
000E97  2  A9 00 85 11  
000E9B  2  20 DB 0C             JSR     tone_on
000E9E  2  A2 0C                LDX     #12
000EA0  2  20 F8 0C             JSR     busywait
000EA3  2  4C 55 0C             JMP     psg_silence
000EA6  2               
000EA6  2               ;==============================================================================
000EA6  2               ;  Cooperative 3-channel title music player with hardware envelope.
000EA6  2               ;
000EA6  2               ;  Three independent voice tracks play simultaneously:
000EA6  2               ;     channel A = lead melody   (uses the AY envelope generator so each
000EA6  2               ;                                note has a soft attack/decay shape)
000EA6  2               ;     channel B = counter/harmony (fixed mid volume)
000EA6  2               ;     channel C = bass line       (fixed mid volume)
000EA6  2               ;
000EA6  2               ;  Each track is a list of events: (note, duration) byte pairs.
000EA6  2               ;     note 0      = rest (silence this channel for the duration)
000EA6  2               ;     note 1..47  = index into note_lo/note_hi period tables
000EA6  2               ;     note $FF    = end marker -> loop the track from its start
000EA6  2               ;     duration    = number of music ticks to hold (1..254)
000EA6  2               ;
000EA6  2               ;  music_tick is called once per title spin-loop iteration.  It paces
000EA6  2               ;  itself with a short delay, then advances all three voices.
000EA6  2               ;==============================================================================
000EA6  2               
000EA6  2               ; Tempo: each music tick waits busywait(1) plus an extra fine spin of
000EA6  2               ; MUS_FINEDELAY * 256 loops.  delay=1 alone (FINE=0) was a little fast;
000EA6  2               ; FINE=128 is about 1.5x slower.  Raise/lower MUS_FINEDELAY to taste.
000EA6  2               MUS_TICKDELAY   = 1             ; busywait outer count per music tick
000EA6  2               MUS_FINEDELAY   = 70            ; extra fine delay (0..255), tempo trim
000EA6  2               
000EA6  2               ; envelope shape values (reg 13)
000EA6  2               ENV_DECAY       = %00000000     ; \____  single decay then off (plucky)
000EA6  2               ENV_RAMP        = %00001000     ; \\\\   repeating saw (sustained pulse)
000EA6  2               ENV_PERIOD      = $1800         ; 16-bit envelope period (attack/decay len)
000EA6  2               MUS_VOL_B       = 8             ; harmony volume (gentle, under the lead)
000EA6  2               MUS_VOL_C       = 13            ; bass volume (strong, so it is audible)
000EA6  2               
000EA6  2               ;----------------------------------------------------------------
000EA6  2               ; music_start - reset all three voice cursors and program the AY
000EA6  2               ; for music: all three tone channels enabled, envelope set up for
000EA6  2               ; the lead.
000EA6  2               ;----------------------------------------------------------------
000EA6  2               music_start:
000EA6  2               ; voice cursors -> track starts
000EA6  2  A9 6F 8D 80          SETW16  mvA_ptr, trackA
000EAA  2  4D A9 10 8D  
000EAE  2  81 4D        
000EB0  2  A9 AC 8D 83          SETW16  mvB_ptr, trackB
000EB4  2  4D A9 10 8D  
000EB8  2  84 4D        
000EBA  2  A9 BF 8D 86          SETW16  mvC_ptr, trackC
000EBE  2  4D A9 10 8D  
000EC2  2  87 4D        
000EC4  2               ; all hold-counters = 0 so every voice fetches on the first tick.
000EC4  2               ; (must load #0 fresh each time - SETW16 above left A non-zero,
000EC4  2               ;  which is why B/C previously got garbage counts and went silent)
000EC4  2  A9 00                LDA     #0
000EC6  2  8D 82 4D             STA     mvA_cnt
000EC9  2  8D 85 4D             STA     mvB_cnt
000ECC  2  8D 88 4D             STA     mvC_cnt
000ECF  2               
000ECF  2               ; mixer: enable tone on A, B, C (noise off)  -> bits 0..2 clear
000ECF  2  A9 07                LDA     #07
000ED1  2  A0 38                LDY     #%00111000
000ED3  2  20 72 0C             JSR     psgwr
000ED6  2               ; envelope period (regs 11/12) - sets attack/decay length.
000ED6  2               ; longer = the plucked lead note rings out for more of its
000ED6  2               ; duration before fading.  Tune ENV_PERIOD to taste.
000ED6  2  A9 0B                LDA     #11
000ED8  2  A0 00                LDY     #<ENV_PERIOD
000EDA  2  20 72 0C             JSR     psgwr
000EDD  2  A9 0C                LDA     #12
000EDF  2  A0 18                LDY     #>ENV_PERIOD
000EE1  2  20 72 0C             JSR     psgwr
000EE4  2               ; channel A volume register = use envelope (bit4 set)
000EE4  2  A9 08                LDA     #8
000EE6  2  A0 10                LDY     #%00010000
000EE8  2  20 72 0C             JSR     psgwr
000EEB  2               ; channel B: gentle harmony pad ; channel C: strong bass
000EEB  2  A9 09                LDA     #9
000EED  2  A0 08                LDY     #MUS_VOL_B
000EEF  2  20 72 0C             JSR     psgwr
000EF2  2  A9 0A                LDA     #10
000EF4  2  A0 0D                LDY     #MUS_VOL_C
000EF6  2  20 72 0C             JSR     psgwr
000EF9  2  60                   RTS
000EFA  2               
000EFA  2               ;----------------------------------------------------------------
000EFA  2               ; music_tick - advance all three voices by one tick.
000EFA  2               ;----------------------------------------------------------------
000EFA  2               music_tick:
000EFA  2  A2 01                LDX     #MUS_TICKDELAY
000EFC  2  20 F8 0C             JSR     busywait
000EFF  2  20 0A 0D             JSR     mus_finewait    ; fine tempo trim
000F02  2               
000F02  2               ; --- voice A (lead, envelope) ---
000F02  2  AD 82 4D             LDA     mvA_cnt
000F05  2  F0 06                BEQ     @nextA
000F07  2  CE 82 4D             DEC     mvA_cnt
000F0A  2  4C 62 0F             JMP     @doB
000F0D  2               @nextA:
000F0D  2  A9 6F 85 18          SETW16  srcp, trackA    ; (loop base, used if end marker hit)
000F11  2  A9 10 85 19  
000F15  2  AD 80 4D             LDA     mvA_ptr
000F18  2  85 12                STA     ptr2
000F1A  2  AD 81 4D             LDA     mvA_ptr+1
000F1D  2  85 13                STA     ptr2+1
000F1F  2  20 0B 10             JSR     mus_fetch       ; -> tmp0=note, tmp1=dur, ptr2 advanced
000F22  2               ; program channel A tone (regs 0/1) from the note
000F22  2  A6 20                LDX     tmp0
000F24  2  F0 1B                BEQ     @restA          ; rest
000F26  2  20 37 10             JSR     note_period     ; -> ptr = period for note X
000F29  2  A9 00                LDA     #0
000F2B  2  A4 10                LDY     ptr
000F2D  2  20 72 0C             JSR     psgwr
000F30  2  A9 01                LDA     #1
000F32  2  A4 11                LDY     ptr+1
000F34  2  20 72 0C             JSR     psgwr
000F37  2               ; (re)trigger the envelope by rewriting the shape register
000F37  2  A9 0D                LDA     #13
000F39  2  A0 00                LDY     #ENV_DECAY
000F3B  2  20 72 0C             JSR     psgwr
000F3E  2  4C 48 0F             JMP     @setA
000F41  2               @restA:
000F41  2               ; silence A for the rest: drop its volume to 0 (no envelope)
000F41  2  A9 08                LDA     #8
000F43  2  A0 00                LDY     #0
000F45  2  20 72 0C             JSR     psgwr
000F48  2               @setA:
000F48  2               ; for a non-rest, make sure A uses the envelope again
000F48  2  A5 20                LDA     tmp0
000F4A  2  F0 07                BEQ     @cntA
000F4C  2  A9 08                LDA     #8
000F4E  2  A0 10                LDY     #%00010000
000F50  2  20 72 0C             JSR     psgwr
000F53  2               @cntA:
000F53  2  A5 21                LDA     tmp1
000F55  2  8D 82 4D             STA     mvA_cnt
000F58  2  A5 12                LDA     ptr2
000F5A  2  8D 80 4D             STA     mvA_ptr
000F5D  2  A5 13                LDA     ptr2+1
000F5F  2  8D 81 4D             STA     mvA_ptr+1
000F62  2               
000F62  2               @doB:
000F62  2               ; --- voice B (harmony, fixed volume on channel B) ---
000F62  2  AD 85 4D             LDA     mvB_cnt
000F65  2  F0 06                BEQ     @nextB
000F67  2  CE 85 4D             DEC     mvB_cnt
000F6A  2  4C B7 0F             JMP     @doC
000F6D  2               @nextB:
000F6D  2  A9 AC 85 18          SETW16  srcp, trackB
000F71  2  A9 10 85 19  
000F75  2  AD 83 4D             LDA     mvB_ptr
000F78  2  85 12                STA     ptr2
000F7A  2  AD 84 4D             LDA     mvB_ptr+1
000F7D  2  85 13                STA     ptr2+1
000F7F  2  20 0B 10             JSR     mus_fetch
000F82  2  A6 20                LDX     tmp0
000F84  2  F0 1B                BEQ     @restB
000F86  2  20 37 10             JSR     note_period
000F89  2  A9 02                LDA     #2
000F8B  2  A4 10                LDY     ptr
000F8D  2  20 72 0C             JSR     psgwr
000F90  2  A9 03                LDA     #3
000F92  2  A4 11                LDY     ptr+1
000F94  2  20 72 0C             JSR     psgwr
000F97  2  A9 09                LDA     #9              ; restore B volume
000F99  2  A0 08                LDY     #MUS_VOL_B
000F9B  2  20 72 0C             JSR     psgwr
000F9E  2  4C A8 0F             JMP     @cntB
000FA1  2               @restB:
000FA1  2  A9 09                LDA     #9
000FA3  2  A0 00                LDY     #0
000FA5  2  20 72 0C             JSR     psgwr
000FA8  2               @cntB:
000FA8  2  A5 21                LDA     tmp1
000FAA  2  8D 85 4D             STA     mvB_cnt
000FAD  2  A5 12                LDA     ptr2
000FAF  2  8D 83 4D             STA     mvB_ptr
000FB2  2  A5 13                LDA     ptr2+1
000FB4  2  8D 84 4D             STA     mvB_ptr+1
000FB7  2               
000FB7  2               @doC:
000FB7  2               ; --- voice C (bass, fixed volume on channel C) ---
000FB7  2  AD 88 4D             LDA     mvC_cnt
000FBA  2  F0 04                BEQ     @nextC
000FBC  2  CE 88 4D             DEC     mvC_cnt
000FBF  2  60                   RTS
000FC0  2               @nextC:
000FC0  2  A9 BF 85 18          SETW16  srcp, trackC
000FC4  2  A9 10 85 19  
000FC8  2  AD 86 4D             LDA     mvC_ptr
000FCB  2  85 12                STA     ptr2
000FCD  2  AD 87 4D             LDA     mvC_ptr+1
000FD0  2  85 13                STA     ptr2+1
000FD2  2  20 0B 10             JSR     mus_fetch
000FD5  2  A6 20                LDX     tmp0
000FD7  2  F0 1B                BEQ     @restC
000FD9  2  20 37 10             JSR     note_period
000FDC  2  A9 04                LDA     #4
000FDE  2  A4 10                LDY     ptr
000FE0  2  20 72 0C             JSR     psgwr
000FE3  2  A9 05                LDA     #5
000FE5  2  A4 11                LDY     ptr+1
000FE7  2  20 72 0C             JSR     psgwr
000FEA  2  A9 0A                LDA     #10             ; restore C volume
000FEC  2  A0 0D                LDY     #MUS_VOL_C
000FEE  2  20 72 0C             JSR     psgwr
000FF1  2  4C FB 0F             JMP     @cntC
000FF4  2               @restC:
000FF4  2  A9 0A                LDA     #10
000FF6  2  A0 00                LDY     #0
000FF8  2  20 72 0C             JSR     psgwr
000FFB  2               @cntC:
000FFB  2  A5 21                LDA     tmp1
000FFD  2  8D 88 4D             STA     mvC_cnt
001000  2  A5 12                LDA     ptr2
001002  2  8D 86 4D             STA     mvC_ptr
001005  2  A5 13                LDA     ptr2+1
001007  2  8D 87 4D             STA     mvC_ptr+1
00100A  2  60                   RTS
00100B  2               
00100B  2               ;----------------------------------------------------------------
00100B  2               ; mus_fetch - read one (note,dur) event from the track at ptr2.
00100B  2               ;   IN : ptr2 -> current event ; srcp -> track loop base
00100B  2               ;   OUT: tmp0 = note, tmp1 = duration, ptr2 advanced past the event.
00100B  2               ;        On an $FF end marker, ptr2 is reset to srcp and the first
00100B  2               ;        event of the track is returned.
00100B  2               ;----------------------------------------------------------------
00100B  2               mus_fetch:
00100B  2  A0 00                LDY     #0
00100D  2  B1 12                LDA     (ptr2),Y
00100F  2  C9 FF                CMP     #$FF
001011  2  D0 0C                BNE     @ok
001013  2               ; loop: reset ptr2 to track base (srcp)
001013  2  A5 18                LDA     srcp
001015  2  85 12                STA     ptr2
001017  2  A5 19                LDA     srcp+1
001019  2  85 13                STA     ptr2+1
00101B  2  A0 00                LDY     #0
00101D  2  B1 12                LDA     (ptr2),Y
00101F  2               @ok:
00101F  2  85 20                STA     tmp0            ; note
001021  2  C8                   INY
001022  2  B1 12                LDA     (ptr2),Y
001024  2               ; The voice loops "fetch when counter hits 0", and the fetch
001024  2               ; tick itself is the first tick of the note.  So a note must
001024  2               ; hold for (dur-1) MORE ticks after the fetch tick to last
001024  2               ; exactly dur ticks.  Subtract 1 here.  (All durations are >=2,
001024  2               ; so no underflow.)  This keeps voices with different note
001024  2               ; counts the same real length - otherwise B/C drift away from
001024  2               ; the lead because they have fewer/more notes per loop.
001024  2  38                   SEC
001025  2  E9 01                SBC     #1
001027  2  85 21                STA     tmp1            ; duration - 1
001029  2               ; advance ptr2 by 2
001029  2  18                   CLC
00102A  2  A5 12                LDA     ptr2
00102C  2  69 02                ADC     #2
00102E  2  85 12                STA     ptr2
001030  2  A5 13                LDA     ptr2+1
001032  2  69 00                ADC     #0
001034  2  85 13                STA     ptr2+1
001036  2  60                   RTS
001037  2               
001037  2               ;----------------------------------------------------------------
001037  2               ; note_period - look up the 16-bit AY tone period for note X (1..N)
001037  2               ;   OUT: ptr = period (lo/hi).  Note index is 1-based.
001037  2               ;----------------------------------------------------------------
001037  2               note_period:
001037  2  CA                   DEX                     ; tables are 0-based
001038  2  BD 43 10             LDA     note_lo,X
00103B  2  85 10                STA     ptr
00103D  2  BD 59 10             LDA     note_hi,X
001040  2  85 11                STA     ptr+1
001042  2  60                   RTS
001043  2               
001043  2               ;----------------------------------------------------------------
001043  2               ; Note period tables (16-bit AY tone periods), two+ octaves.
001043  2               ; Note numbers (1-based) used by the tracks:
001043  2               ;   1=C3  2=D3 3=E3 4=F3 5=G3 6=A3 7=B3
001043  2               ;   8=C4  9=D4 10=E4 11=F4 12=G4 13=A4 14=B4
001043  2               ;  15=C5 16=D5 17=E5 18=F5 19=G5 20=A5 21=B5
001043  2               ;  22=C6
001043  2               ; (a diatonic C-major set is plenty for a heroic theme)
001043  2               ;----------------------------------------------------------------
001043  2               note_lo:
001043  2  F0 82 20 F4          .BYTE   <1008, <898, <800, <756, <672, <600, <534; C3..B3
001047  2  A0 58 16     
00104A  2  F8 C2 90 7A          .BYTE   <504,  <450, <400, <378, <336, <300, <267; C4..B4
00104E  2  50 2C 0B     
001051  2  FC E1 C8 BD          .BYTE   <252,  <225, <200, <189, <168, <150, <133; C5..B5
001055  2  A8 96 85     
001058  2  7E                   .BYTE   <126            ; C6
001059  2               note_hi:
001059  2  03 03 03 02          .BYTE   >1008, >898, >800, >756, >672, >600, >534
00105D  2  02 02 02     
001060  2  01 01 01 01          .BYTE   >504,  >450, >400, >378, >336, >300, >267
001064  2  01 01 01     
001067  2  00 00 00 00          .BYTE   >252,  >225, >200, >189, >168, >150, >133
00106B  2  00 00 00     
00106E  2  00                   .BYTE   >126
00106F  2               
00106F  2               ; note name -> index defines for readable tracks
00106F  2               N_REST          = 0
00106F  2               C3              = 1
00106F  2               D3              = 2
00106F  2               E3              = 3
00106F  2               F3              = 4
00106F  2               G3              = 5
00106F  2               A3              = 6
00106F  2               B3              = 7
00106F  2               C4              = 8
00106F  2               D4              = 9
00106F  2               E4              = 10
00106F  2               F4              = 11
00106F  2               G4              = 12
00106F  2               A4              = 13
00106F  2               B4              = 14
00106F  2               C5              = 15
00106F  2               D5              = 16
00106F  2               E5              = 17
00106F  2               F5              = 18
00106F  2               G5              = 19
00106F  2               A5              = 20
00106F  2               B5              = 21
00106F  2               C6              = 22
00106F  2               
00106F  2               ;----------------------------------------------------------------
00106F  2               ; The theme: a stately heroic tune in C major, 3 voices.
00106F  2               ; Durations are in ticks; the three tracks are written so their
00106F  2               ; total lengths line up over each phrase.
00106F  2               ;----------------------------------------------------------------
00106F  2               
00106F  2               ; --- Channel A : lead melody ---
00106F  2               ; Every phrase line totals 16 ticks so the lead stays locked in step
00106F  2               ; with the 16-tick harmony (B) and bass (C) lines.  (Line 1 was 20
00106F  2               ; ticks before, which drifted B/C out of phase each loop.)
00106F  2               trackA:
00106F  2  0C 04 0F 04          .BYTE   G4,4,  C5,4,  E5,4,  G5,2,  E5,2; 16
001073  2  11 04 13 02  
001077  2  11 02        
001079  2  12 04 11 04          .BYTE   F5,4,  E5,4,  D5,8; 16
00107D  2  10 08        
00107F  2  11 04 13 04          .BYTE   E5,4,  G5,4,  C6,6,  B5,2; 16
001083  2  16 06 15 02  
001087  2  14 04 13 04          .BYTE   A5,4,  G5,4,  E5,8; 16
00108B  2  11 08        
00108D  2  12 04 14 04          .BYTE   F5,4,  A5,4,  G5,4,  E5,4; 16
001091  2  13 04 11 04  
001095  2  10 04 12 04          .BYTE   D5,4,  F5,4,  E5,8; 16
001099  2  11 08        
00109B  2  0F 04 11 04          .BYTE   C5,4,  E5,4,  G5,4,  C6,4; 16
00109F  2  13 04 16 04  
0010A3  2  13 04 11 04          .BYTE   G5,4,  E5,4,  C5,8; 16
0010A7  2  0F 08        
0010A9  2  00 04                .BYTE   N_REST,4
0010AB  2  FF                   .BYTE   $FF
0010AC  2               
0010AC  2               ; --- Channel B : sustained harmony, one note per phrase line.
0010AC  2               ;     To stay consonant under a diatonic melody we use the FIFTH of
0010AC  2               ;     each chord (perfect fifths never clash), in octave 4.
0010AC  2               ;     Chords per line:  C  G  C  Am  F  G  C  C
0010AC  2               ;     Fifths:           G  D  G  E   C  D  G  G
0010AC  2               trackB:
0010AC  2  0C 10                .BYTE   G4,16           ; C chord  (5th = G)
0010AE  2  09 10                .BYTE   D4,16           ; G chord  (5th = D)
0010B0  2  0C 10                .BYTE   G4,16           ; C chord
0010B2  2  0A 10                .BYTE   E4,16           ; Am chord (5th = E)
0010B4  2  08 10                .BYTE   C4,16           ; F chord  (5th = C)
0010B6  2  09 10                .BYTE   D4,16           ; G chord
0010B8  2  0C 10                .BYTE   G4,16           ; C chord
0010BA  2  0C 10                .BYTE   G4,16           ; C chord
0010BC  2  00 04                .BYTE   N_REST,4
0010BE  2  FF                   .BYTE   $FF
0010BF  2               
0010BF  2               ; --- Channel C : bass - the ROOT of each chord, re-struck halfway
0010BF  2               ;     for a gentle pulse.  Same progression: C G C Am F G C C
0010BF  2               trackC:
0010BF  2  01 08 01 08          .BYTE   C3,8,  C3,8     ; C
0010C3  2  05 08 05 08          .BYTE   G3,8,  G3,8     ; G
0010C7  2  01 08 01 08          .BYTE   C3,8,  C3,8     ; C
0010CB  2  06 08 06 08          .BYTE   A3,8,  A3,8     ; Am
0010CF  2  04 08 04 08          .BYTE   F3,8,  F3,8     ; F
0010D3  2  05 08 05 08          .BYTE   G3,8,  G3,8     ; G
0010D7  2  01 08 01 08          .BYTE   C3,8,  C3,8     ; C
0010DB  2  01 08 01 08          .BYTE   C3,8,  C3,8     ; C
0010DF  2  00 04                .BYTE   N_REST,4
0010E1  2  FF                   .BYTE   $FF
0010E2  2               
0010E2  1                       .INCLUDE "tiles.asm"
0010E2  2               ;______________________________________________________________________________
0010E2  2               ;  tiles.asm - custom 8x8 character bitmaps for terrain, items, monsters
0010E2  2               ;
0010E2  2               ;  The memory-mapped video card has a writable character generator.
0010E2  2               ;  To redefine character N (see V_PATTERN in dbasic/screencmds.asm):
0010E2  2               ;     1. map video sub-page $F8 (VIDEOBANK) into CPU bank $A
0010E2  2               ;     2. write N to VideoCharGenOffset ($A002)
0010E2  2               ;     3. write 8 scanline bytes to VideoCharGenData ($A003)
0010E2  2               ;        (the hardware auto-advances through the 8 rows of the glyph)
0010E2  2               ;
0010E2  2               ;  Each bitmap is authored as 8 bytes, top row first, with bit7 as
0010E2  2               ;  the leftmost pixel. The video character generator displays bit0
0010E2  2               ;  on the left, so chargen_init reverses each scanline before upload.
0010E2  2               ;  Small title glyphs use control codes 1..31. Gameplay metatiles
0010E2  2               ;  use $80..$DF. Printable ASCII used by the UI remains intact.
0010E2  2               ;______________________________________________________________________________
0010E2  2               
0010E2  2               VideoCharGenOffset = $A002
0010E2  2               VideoCharGenData = $A003
0010E2  2               
0010E2  2               ;----------------------------------------------------------------
0010E2  2               ; cg_enter / cg_exit - map the character-generator RAM (page $F8)
0010E2  2               ; into bank $A and select task 1 (mirrors PAGE_ENTER/PAGE_EXIT).
0010E2  2               ;----------------------------------------------------------------
0010E2  2               cg_enter:
0010E2  2  A9 01                LDA     #$01            ; task 01 (driver)
0010E4  2  A2 0A                LDX     #$0A            ; CPU bank $A
0010E6  2  A0 F8                LDY     #VIDEOBANK      ; physical page $F8 (char generator)
0010E8  2  20 F6 FF             JSR     SETPAGE
0010EB  2  A9 01                LDA     #$01
0010ED  2  8D E0 EF             STA     PC6502_ACT_TASK
0010F0  2  60                   RTS
0010F1  2               cg_exit:
0010F1  2  A9 00                LDA     #$00
0010F3  2  8D E0 EF             STA     PC6502_ACT_TASK
0010F6  2  60                   RTS
0010F7  2               
0010F7  2               ;----------------------------------------------------------------
0010F7  2               ; reverse_glyph_byte - convert authored bit7-left rows to the
0010F7  2               ; character generator's bit0-left display order.
0010F7  2               ;   IN/OUT: A = scanline byte
0010F7  2               ;   trashes X,tmp0; preserves Y
0010F7  2               ;----------------------------------------------------------------
0010F7  2               reverse_glyph_byte:
0010F7  2  85 20                STA     tmp0
0010F9  2  A9 00                LDA     #0
0010FB  2  A2 08                LDX     #8
0010FD  2               @bit:
0010FD  2  46 20                LSR     tmp0
0010FF  2  2A                   ROL     A
001100  2  CA                   DEX
001101  2  D0 FA                BNE     @bit
001103  2  60                   RTS
001104  2               
001104  2               ;----------------------------------------------------------------
001104  2               ; chargen_init - upload every custom glyph bitmap.
001104  2               ;
001104  2               ; Driven by a table of (charcode, 8 bytes) records.  The table ends
001104  2               ; with a $00 charcode marker (code 0 is never one of ours).
001104  2               ;----------------------------------------------------------------
001104  2               chargen_init:
001104  2  20 E2 10             JSR     cg_enter
001107  2  A9 3A 85 18          SETW16  srcp, glyphtab
00110B  2  A9 11 85 19  
00110F  2               @rec:
00110F  2  A0 00                LDY     #0
001111  2  B1 18                LDA     (srcp),Y        ; char code
001113  2  F0 22                BEQ     @done           ; 0 = end of table
001115  2  8D 02 A0             STA     VideoCharGenOffset
001118  2               ; write the 8 scanline bytes
001118  2  A0 01                LDY     #1
00111A  2               @row:
00111A  2  B1 18                LDA     (srcp),Y
00111C  2  20 F7 10             JSR     reverse_glyph_byte
00111F  2  8D 03 A0             STA     VideoCharGenData
001122  2  C8                   INY
001123  2  C0 09                CPY     #9
001125  2  D0 F3                BNE     @row
001127  2               ; advance srcp by 9 (1 code + 8 data)
001127  2  18                   CLC
001128  2  A5 18                LDA     srcp
00112A  2  69 09                ADC     #9
00112C  2  85 18                STA     srcp
00112E  2  A5 19                LDA     srcp+1
001130  2  69 00                ADC     #0
001132  2  85 19                STA     srcp+1
001134  2  4C 0F 11             JMP     @rec
001137  2               @done:
001137  2  4C F1 10             JMP     cg_exit
00113A  2               
00113A  2               ;----------------------------------------------------------------
00113A  2               ; Glyph bitmap table: each row is  code, b0..b7
00113A  2               ;----------------------------------------------------------------
00113A  2               glyphtab:
00113A  2               
00113A  2               ; --- terrain ---------------------------------------------------
