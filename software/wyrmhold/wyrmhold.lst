006022  2  A9 02                LDA     #2
006024  2  8D 0C 62             STA     px
006027  2  A9 01                LDA     #1
006029  2  8D 0D 62             STA     py
00602C  2  20 7B 46             JSR     spawn_shrine_monsters
00602F  2  A9 01                LDA     #1
006031  2  8D 27 62             STA     did_move
