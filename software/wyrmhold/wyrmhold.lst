004459  1                       .INCLUDE "entity.asm"
004459  2               ;______________________________________________________________________________
004459  2               ;  entity.asm - monsters: table, spawning, simple AI, rendering
004459  2               ;
004459  2               ;  Parallel arrays of MAXMON slots.  A slot with mon_type == M_NONE
004459  2               ;  is empty.  Monsters live on the currently active map (overworld
004459  2               ;  or dungeon).  Towns have no monsters.
004459  2               ;______________________________________________________________________________
004459  2               
004459  2               ;----------------------------------------------------------------
004459  2               ; Per-monster-type stat tables (indexed by M_* id)
004459  2               ;   mtype_glyph : 2x2 metatile base glyph
004459  2               ;   mtype_color : color cell
004459  2               ;   mtype_hp    : starting HP
004459  2               ;   mtype_atk   : attack dice sides (damage 1..atk)
004459  2               ;   mtype_xp    : XP awarded on kill
004459  2               ;   mtype_gold  : gold dropped (max; rolled 0..gold)
004459  2               ;----------------------------------------------------------------
004459  2               mtype_glyph:
004459  2  20                   .BYTE   ' '             ; 0 none
00445A  2  C8                   .BYTE   MG_ORC          ; 1 orc
00445B  2  CC                   .BYTE   MG_SNAKE        ; 2 snake
00445C  2  D0                   .BYTE   MG_SKELETON     ; 3 skeleton
00445D  2  D4                   .BYTE   MG_THIEF        ; 4 thief
00445E  2  D8                   .BYTE   MG_TROLL        ; 5 troll
00445F  2  DC                   .BYTE   MG_BOSS         ; 6 boss (dragon)
004460  2  F0                   .BYTE   MG_WARDEN       ; 7 Wyrm Warden
004461  2               mtype_color:
004461  2  0C                   .BYTE   C_MONST         ; 0
004462  2  0C                   .BYTE   COLOR(CO_BRRED, CO_BLACK); orc
004463  2  0E                   .BYTE   COLOR(CO_BRYELLOW,CO_BLACK); snake
004464  2  0F                   .BYTE   COLOR(CO_BRWHITE,CO_BLACK); skeleton
004465  2  05                   .BYTE   COLOR(CO_VIOLET,CO_BLACK); thief
004466  2  0B                   .BYTE   COLOR(CO_BRTURQ,CO_BLACK); troll
004467  2  4C                   .BYTE   C_BOSS          ; boss
004468  2  0D                   .BYTE   COLOR(CO_BRPURPLE,CO_BLACK); Wyrm Warden
004469  2               mtype_hp:
004469  2  00 06 04 08          .BYTE   0, 6, 4, 8, 5, 14, 40, 24
00446D  2  05 0E 28 18  
004471  2               mtype_atk:
004471  2  00 04 03 05          .BYTE   0, 4, 3, 5, 3, 7, 12, 8
004475  2  03 07 0C 08  
004479  2               mtype_xp:
004479  2  00 03 02 05          .BYTE   0, 3, 2, 5, 4, 10, 50, 25
00447D  2  04 0A 32 19  
004481  2               mtype_gold:
004481  2  00 04 01 03          .BYTE   0, 4, 1, 3, 12, 8, 40, 0
004485  2  0C 08 28 00  
004489  2               
004489  2               ; Weighted overworld encounters: eight entries per region. The
004489  2               ; second set is used after the dragon's lair is unlocked.
004489  2               region_encounters:
004489  2               ; early Northreach, Wyrmhold Vale, Sunken March
004489  2  01 01 01 03          .BYTE   M_ORC, M_ORC, M_ORC, M_SKELETON
00448D  2  03 03 04 05          .BYTE   M_SKELETON, M_SKELETON, M_THIEF, M_TROLL
004491  2  01 01 02 02          .BYTE   M_ORC, M_ORC, M_SNAKE, M_SNAKE
004495  2  03 04 04 05          .BYTE   M_SKELETON, M_THIEF, M_THIEF, M_TROLL
004499  2  02 02 02 04          .BYTE   M_SNAKE, M_SNAKE, M_SNAKE, M_THIEF
00449D  2  04 05 05 03          .BYTE   M_THIEF, M_TROLL, M_TROLL, M_SKELETON
0044A1  2               ; late Northreach, Wyrmhold Vale, Sunken March
0044A1  2  01 01 03 03          .BYTE   M_ORC, M_ORC, M_SKELETON, M_SKELETON
0044A5  2  03 05 05 04          .BYTE   M_SKELETON, M_TROLL, M_TROLL, M_THIEF
0044A9  2  01 02 03 04          .BYTE   M_ORC, M_SNAKE, M_SKELETON, M_THIEF
0044AD  2  04 05 05 05          .BYTE   M_THIEF, M_TROLL, M_TROLL, M_TROLL
0044B1  2  02 02 04 03          .BYTE   M_SNAKE, M_SNAKE, M_THIEF, M_SKELETON
0044B5  2  05 05 05 05          .BYTE   M_TROLL, M_TROLL, M_TROLL, M_TROLL
0044B9  2               
0044B9  2               ;----------------------------------------------------------------
0044B9  2               ; mon_clear_all - empty every monster slot.
0044B9  2               ;----------------------------------------------------------------
0044B9  2               mon_clear_all:
0044B9  2  A2 00                LDX     #0
0044BB  2  A9 00                LDA     #M_NONE
0044BD  2               @c:
0044BD  2  9D 39 63             STA     mon_type,X
0044C0  2  9D 69 63             STA     mon_state,X
0044C3  2  E8                   INX
0044C4  2  E0 0C                CPX     #MAXMON
0044C6  2  D0 F5                BNE     @c
0044C8  2  60                   RTS
0044C9  2               
0044C9  2               ;----------------------------------------------------------------
0044C9  2               ; mon_find_free - find an empty slot.  Returns X = slot, C=1 ok,
0044C9  2               ;                 C=0 if table full.
0044C9  2               ;----------------------------------------------------------------
0044C9  2               mon_find_free:
0044C9  2  A2 00                LDX     #0
0044CB  2               @f:
0044CB  2  BD 39 63             LDA     mon_type,X
0044CE  2  C9 00                CMP     #M_NONE
0044D0  2  F0 07                BEQ     @found
0044D2  2  E8                   INX
0044D3  2  E0 0C                CPX     #MAXMON
0044D5  2  D0 F4                BNE     @f
0044D7  2  18                   CLC
0044D8  2  60                   RTS
0044D9  2               @found:
0044D9  2  38                   SEC
0044DA  2  60                   RTS
0044DB  2               
0044DB  2               ;----------------------------------------------------------------
0044DB  2               ; mon_spawn - create a monster.
0044DB  2               ;   IN: A=type, tgtx=x, tgty=y
0044DB  2               ;   Sets hp from the type table.  No-op if table full.
0044DB  2               ;----------------------------------------------------------------
0044DB  2               mon_spawn:
0044DB  2  85 20                STA     tmp0            ; type
0044DD  2  20 C9 44             JSR     mon_find_free
0044E0  2  90 1C                BCC     @full
0044E2  2  A5 20                LDA     tmp0
0044E4  2  9D 39 63             STA     mon_type,X
0044E7  2  A5 2C                LDA     tgtx
0044E9  2  9D 45 63             STA     mon_x,X
0044EC  2  A5 2D                LDA     tgty
0044EE  2  9D 51 63             STA     mon_y,X
0044F1  2  A4 20                LDY     tmp0
0044F3  2  B9 69 44             LDA     mtype_hp,Y
0044F6  2  9D 5D 63             STA     mon_hp,X
0044F9  2  A9 00                LDA     #0
0044FB  2  9D 69 63             STA     mon_state,X
0044FE  2               @full:
0044FE  2  60                   RTS
0044FF  2               
0044FF  2               ;----------------------------------------------------------------
0044FF  2               ; mon_at - is there a live monster at (tgtx,tgty)?
0044FF  2               ;          Returns X = slot and C=1 if found, else C=0.
0044FF  2               ;----------------------------------------------------------------
0044FF  2               mon_at:
0044FF  2  A2 00                LDX     #0
004501  2               @a:
004501  2  BD 39 63             LDA     mon_type,X
004504  2  C9 00                CMP     #M_NONE
004506  2  F0 10                BEQ     @nextslot
004508  2  BD 45 63             LDA     mon_x,X
00450B  2  C5 2C                CMP     tgtx
00450D  2  D0 09                BNE     @nextslot
00450F  2  BD 51 63             LDA     mon_y,X
004512  2  C5 2D                CMP     tgty
004514  2  D0 02                BNE     @nextslot
004516  2  38                   SEC
004517  2  60                   RTS
004518  2               @nextslot:
004518  2  E8                   INX
004519  2  E0 0C                CPX     #MAXMON
00451B  2  D0 E4                BNE     @a
00451D  2  18                   CLC
00451E  2  60                   RTS
00451F  2               
00451F  2               ;----------------------------------------------------------------
00451F  2               ; mon_kill - remove monster in slot X.
00451F  2               ;----------------------------------------------------------------
00451F  2               mon_kill:
00451F  2  A9 00                LDA     #M_NONE
004521  2  9D 39 63             STA     mon_type,X
004524  2  9D 69 63             STA     mon_state,X
004527  2  60                   RTS
004528  2               
004528  2               ;----------------------------------------------------------------
004528  2               ; save_overworld_monsters / restore_overworld_monsters
004528  2               ; Preserve the roaming group while an interior reuses mon_*.
004528  2               ;----------------------------------------------------------------
004528  2               save_overworld_monsters:
004528  2  A2 00                LDX     #0
00452A  2               @save:
00452A  2  BD 39 63             LDA     mon_type,X
00452D  2  9D 75 63             STA     ow_mon_type,X
004530  2  BD 45 63             LDA     mon_x,X
004533  2  9D 81 63             STA     ow_mon_x,X
004536  2  BD 51 63             LDA     mon_y,X
004539  2  9D 8D 63             STA     ow_mon_y,X
00453C  2  BD 5D 63             LDA     mon_hp,X
00453F  2  9D 99 63             STA     ow_mon_hp,X
004542  2  BD 69 63             LDA     mon_state,X
004545  2  9D A5 63             STA     ow_mon_state,X
004548  2  E8                   INX
004549  2  E0 0C                CPX     #MAXMON
00454B  2  D0 DD                BNE     @save
00454D  2  60                   RTS
00454E  2               
00454E  2               restore_overworld_monsters:
00454E  2  A2 00                LDX     #0
004550  2               @restore:
004550  2  BD 75 63             LDA     ow_mon_type,X
004553  2  9D 39 63             STA     mon_type,X
004556  2  BD 81 63             LDA     ow_mon_x,X
004559  2  9D 45 63             STA     mon_x,X
00455C  2  BD 8D 63             LDA     ow_mon_y,X
00455F  2  9D 51 63             STA     mon_y,X
004562  2  BD 99 63             LDA     ow_mon_hp,X
004565  2  9D 5D 63             STA     mon_hp,X
004568  2  BD A5 63             LDA     ow_mon_state,X
00456B  2  9D 69 63             STA     mon_state,X
00456E  2  E8                   INX
00456F  2  E0 0C                CPX     #MAXMON
004571  2  D0 DD                BNE     @restore
004573  2               ; only reinforce a world reduced below three living monsters
004573  2  20 82 45             JSR     count_live_monsters
004576  2  C9 03                CMP     #3
004578  2  B0 07                BCS     @done
00457A  2  A9 04                LDA     #4              ; four placement attempts, not four guarantees
00457C  2  85 24                STA     cnt0
00457E  2  4C 9A 45             JMP     spawn_overworld_attempts
004581  2               @done:
004581  2  60                   RTS
004582  2               
004582  2               ; count_live_monsters - return live slot count in A.
004582  2               count_live_monsters:
004582  2  A2 00                LDX     #0
004584  2  A0 00                LDY     #0
004586  2               @count:
004586  2  BD 39 63             LDA     mon_type,X
004589  2  F0 01                BEQ     @next
00458B  2  C8                   INY
00458C  2               @next:
00458C  2  E8                   INX
00458D  2  E0 0C                CPX     #MAXMON
00458F  2  D0 F5                BNE     @count
004591  2  98                   TYA
004592  2  60                   RTS
004593  2               
004593  2               ;----------------------------------------------------------------
004593  2               ; spawn_overworld_monsters - scatter a handful of monsters on the
004593  2               ; overworld at random passable land tiles near the player.
004593  2               ;----------------------------------------------------------------
004593  2               spawn_overworld_monsters:
004593  2  20 B9 44             JSR     mon_clear_all
004596  2  A9 04                LDA     #4              ; only a few roaming monsters at a time
004598  2  85 24                STA     cnt0
00459A  2               spawn_overworld_attempts:
00459A  2               @loop:
00459A  2               ; place in a ring roughly 6..21 tiles from the player: far
00459A  2               ; enough not to crowd you, near enough to be encountered.
00459A  2               ; offset = (rand(0..15) + 6), sign random per axis.
00459A  2  A9 10                LDA     #16
00459C  2  20 E8 0C             JSR     rng_mod
00459F  2  18                   CLC
0045A0  2  69 06                ADC     #6              ; 6..21
0045A2  2  85 21                STA     tmp1            ; magnitude
0045A4  2  20 C8 0C             JSR     rng_next        ; random sign bit
0045A7  2  29 01                AND     #1
0045A9  2  F0 09                BEQ     @xplus
0045AB  2  AD 0C 62             LDA     px
0045AE  2  38                   SEC
0045AF  2  E5 21                SBC     tmp1
0045B1  2  4C BA 45             JMP     @setx
0045B4  2               @xplus:
0045B4  2  AD 0C 62             LDA     px
0045B7  2  18                   CLC
0045B8  2  65 21                ADC     tmp1
0045BA  2               @setx:
0045BA  2  85 2C                STA     tgtx
0045BC  2  A9 10                LDA     #16
0045BE  2  20 E8 0C             JSR     rng_mod
0045C1  2  18                   CLC
0045C2  2  69 06                ADC     #6
0045C4  2  85 21                STA     tmp1
0045C6  2  20 C8 0C             JSR     rng_next
0045C9  2  29 01                AND     #1
0045CB  2  F0 09                BEQ     @yplus
0045CD  2  AD 0D 62             LDA     py
0045D0  2  38                   SEC
0045D1  2  E5 21                SBC     tmp1
0045D3  2  4C DC 45             JMP     @sety
0045D6  2               @yplus:
0045D6  2  AD 0D 62             LDA     py
0045D9  2  18                   CLC
0045DA  2  65 21                ADC     tmp1
0045DC  2               @sety:
0045DC  2  85 2D                STA     tgty
0045DE  2               ; reject the player's own tile (don't spawn on top of you)
0045DE  2  A5 2C                LDA     tgtx
0045E0  2  CD 0C 62             CMP     px
0045E3  2  D0 07                BNE     @okpos
0045E5  2  A5 2D                LDA     tgty
0045E7  2  CD 0D 62             CMP     py
0045EA  2  F0 43                BEQ     @skip
0045EC  2               @okpos:
0045EC  2               ; must be passable grass/forest (not water/mountain/town...)
0045EC  2  20 C4 1B             JSR     tileat
0045EF  2  A6 2E                LDX     tgttile
0045F1  2  BD 5B 1A             LDA     tile_prop,X
0045F4  2  29 01                AND     #P_PASS
0045F6  2  F0 37                BEQ     @skip
0045F8  2  BD 5B 1A             LDA     tile_prop,X
0045FB  2  29 8C                AND     #(P_TOWN|P_DUNG|P_CASTLE)
0045FD  2  D0 30                BNE     @skip           ; don't sit on a location entrance
0045FF  2               ; not already occupied by a monster?
0045FF  2  20 FF 44             JSR     mon_at
004602  2  B0 2B                BCS     @skip
004604  2               ; select a weighted encounter for this monster's region. Once the
004604  2               ; lair is open, use the tougher second half of the encounter table.
004604  2  A9 08                LDA     #REGION_ENC_SIZE
004606  2  20 E8 0C             JSR     rng_mod
004609  2  85 22                STA     tmp2
00460B  2  A5 2D                LDA     tgty
00460D  2  20 B3 1B             JSR     region_from_y
004610  2  0A                   ASL     A
004611  2  0A                   ASL     A
004612  2  0A                   ASL     A               ; region * REGION_ENC_SIZE
004613  2  85 23                STA     tmp3
004615  2  AD 21 62             LDA     queststate
004618  2  C9 03                CMP     #QUEST_DUNG_OPEN
00461A  2  90 07                BCC     @encounter_index
00461C  2  A5 23                LDA     tmp3
00461E  2  18                   CLC
00461F  2  69 18                ADC     #REGION_LATE_OFS
004621  2  85 23                STA     tmp3
004623  2               @encounter_index:
004623  2  A5 23                LDA     tmp3
004625  2  18                   CLC
004626  2  65 22                ADC     tmp2
004628  2  A8                   TAY
004629  2  B9 89 44             LDA     region_encounters,Y
00462C  2  20 DB 44             JSR     mon_spawn
00462F  2               @skip:
00462F  2  C6 24                DEC     cnt0
004631  2  F0 03                BEQ     @done
004633  2  4C 9A 45             JMP     @loop
004636  2               @done:
004636  2  60                   RTS
004637  2               
004637  2               ;----------------------------------------------------------------
004637  2               ; spawn_dungeon_monsters - populate the three authored dungeon zones.
004637  2               ;----------------------------------------------------------------
004637  2               spawn_dungeon_monsters:
004637  2  20 B9 44             JSR     mon_clear_all
00463A  2  A9 00                LDA     #BREATH_NONE
00463C  2  8D 22 62             STA     boss_breath_dir
00463F  2               ; once slain, the dragon and its guards do not return
00463F  2  AD 21 62             LDA     queststate
004642  2  C9 04                CMP     #QUEST_DRAGON_DEAD
004644  2  B0 34                BCS     @done
004646  2               ; the dragon waits in the open southern chamber
004646  2  A9 1B                LDA     #DRAGON_X
004648  2  85 2C                STA     tgtx
00464A  2  A9 12                LDA     #DRAGON_Y
00464C  2  85 2D                STA     tgty
00464E  2  A9 06                LDA     #M_BOSS
004650  2  20 DB 44             JSR     mon_spawn
004653  2               ; one authored guard in each approach zone
004653  2  A9 09                LDA     #9
004655  2  85 2C                STA     tgtx
004657  2  A9 05                LDA     #5
004659  2  85 2D                STA     tgty
00465B  2  A9 03                LDA     #M_SKELETON
00465D  2  20 DB 44             JSR     mon_spawn
004660  2  A9 0E                LDA     #14
004662  2  85 2C                STA     tgtx
004664  2  A9 0B                LDA     #11
004666  2  85 2D                STA     tgty
004668  2  A9 04                LDA     #M_THIEF
00466A  2  20 DB 44             JSR     mon_spawn
00466D  2  A9 17                LDA     #23
00466F  2  85 2C                STA     tgtx
004671  2  A9 0F                LDA     #15
004673  2  85 2D                STA     tgty
004675  2  A9 05                LDA     #M_TROLL
004677  2  20 DB 44             JSR     mon_spawn
00467A  2               @done:
00467A  2  60                   RTS
00467B  2               
00467B  2               ;----------------------------------------------------------------
00467B  2               ; spawn_shrine_monsters - the Wyrm Warden appears only while the
00467B  2               ; key quest is active. Once defeated, the shrine remains cleared.
00467B  2               ;----------------------------------------------------------------
00467B  2               spawn_shrine_monsters:
00467B  2  20 B9 44             JSR     mon_clear_all
00467E  2  AD 21 62             LDA     queststate
004681  2  C9 01                CMP     #QUEST_FIND_KEY
004683  2  D0 0D                BNE     @done
004685  2  A9 1B                LDA     #WARDEN_X
004687  2  85 2C                STA     tgtx
004689  2  A9 11                LDA     #WARDEN_Y
00468B  2  85 2D                STA     tgty
00468D  2  A9 07                LDA     #M_WARDEN
00468F  2  20 DB 44             JSR     mon_spawn
004692  2               @done:
004692  2  60                   RTS
004693  2               
004693  2               ;----------------------------------------------------------------
004693  2               ; draw_monsters_vram - overlay all visible monsters in the viewport.
004693  2               ; Called by render_view while video is paged in.
004693  2               ;----------------------------------------------------------------
004693  2               draw_monsters_vram:
004693  2  A2 00                LDX     #0
004695  2  86 2F                STX     monidx
004697  2               @dm:
004697  2  A6 2F                LDX     monidx
004699  2  BD 39 63             LDA     mon_type,X
00469C  2  C9 00                CMP     #M_NONE
00469E  2  F0 1A                BEQ     @next
0046A0  2               ; set world coords + glyph/color, then plot if visible
0046A0  2  BD 45 63             LDA     mon_x,X
0046A3  2  85 2C                STA     tgtx
0046A5  2  BD 51 63             LDA     mon_y,X
0046A8  2  85 2D                STA     tgty
0046AA  2  BC 39 63             LDY     mon_type,X
0046AD  2  B9 59 44             LDA     mtype_glyph,Y
0046B0  2  85 24                STA     cnt0            ; glyph (cnt0/cnt1 survive rowbase)
0046B2  2  B9 61 44             LDA     mtype_color,Y
0046B5  2  85 25                STA     cnt1            ; color
0046B7  2  20 50 3D             JSR     plot_view_cell
0046BA  2               @next:
0046BA  2  E6 2F                INC     monidx
0046BC  2  A5 2F                LDA     monidx
0046BE  2  C9 0C                CMP     #MAXMON
0046C0  2  D0 D5                BNE     @dm
0046C2  2  60                   RTS
0046C3  2               
0046C3  2               ;----------------------------------------------------------------
0046C3  2               ; draw_dragon_telegraph_vram - overlay the warned fire lane while
0046C3  2               ; the dragon is preparing a breath attack.
0046C3  2               ; Called by render_view while video is paged in.
0046C3  2               ;----------------------------------------------------------------
0046C3  2               draw_dragon_telegraph_vram:
0046C3  2  AD 19 62             LDA     loc
0046C6  2  C9 02                CMP     #LOC_DUNG
0046C8  2  D0 3B                BNE     @done
0046CA  2  AD 22 62             LDA     boss_breath_dir
0046CD  2  F0 36                BEQ     @done
0046CF  2               ; find the live dragon
0046CF  2  A2 00                LDX     #0
0046D1  2               @find:
0046D1  2  BD 39 63             LDA     mon_type,X
0046D4  2  C9 06                CMP     #M_BOSS
0046D6  2  F0 06                BEQ     @found
0046D8  2  E8                   INX
0046D9  2  E0 0C                CPX     #MAXMON
0046DB  2  D0 F4                BNE     @find
0046DD  2  60                   RTS
0046DE  2               @found:
0046DE  2  BD 45 63             LDA     mon_x,X
0046E1  2  85 2C                STA     tgtx
0046E3  2  BD 51 63             LDA     mon_y,X
0046E6  2  85 2D                STA     tgty
0046E8  2               @lane:
0046E8  2  20 84 48             JSR     dragon_advance_target
0046EB  2  20 C4 1B             JSR     tileat
0046EE  2  A6 2E                LDX     tgttile
0046F0  2  BD 5B 1A             LDA     tile_prop,X
0046F3  2  29 01                AND     #P_PASS
0046F5  2  F0 0E                BEQ     @done
0046F7  2  A9 F4                LDA     #MG_BREATH
0046F9  2  85 24                STA     cnt0
0046FB  2  A9 4E                LDA     #C_BREATH
0046FD  2  85 25                STA     cnt1
0046FF  2  20 50 3D             JSR     plot_view_cell
004702  2  4C E8 46             JMP     @lane
004705  2               @done:
004705  2  60                   RTS
004706  2               
004706  2               ;----------------------------------------------------------------
004706  2               ; mon_act - move/attack for every monster (called once per turn).
004706  2               ; Monsters in LOC_TOWN never act (towns are safe).
004706  2               ;   A monster adjacent to the player attacks; otherwise it steps
004706  2               ;   one tile toward the player if the destination is passable and
004706  2               ;   unoccupied.
004706  2               ;----------------------------------------------------------------
004706  2               mon_act:
004706  2  AD 19 62             LDA     loc
004709  2  C9 01                CMP     #LOC_TOWN
00470B  2  D0 01                BNE     :+
00470D  2  60                   RTS                     ; safe in town
00470E  2               :
00470E  2  EE 24 62             INC     turn_phase
004711  2  A2 00                LDX     #0
004713  2  86 2F                STX     monidx
004715  2               @ma:
004715  2  A6 2F                LDX     monidx
004717  2  BD 39 63             LDA     mon_type,X
00471A  2  C9 00                CMP     #M_NONE
00471C  2  F0 3F                BEQ     @next
00471E  2  C9 02                CMP     #M_SNAKE
004720  2  D0 06                BNE     @ckskeleton
004722  2  20 69 47             JSR     snake_act
004725  2  4C 5D 47             JMP     @next
004728  2               @ckskeleton:
004728  2  C9 03                CMP     #M_SKELETON
00472A  2  D0 06                BNE     @ckthief
00472C  2  20 6C 47             JSR     skeleton_act
00472F  2  4C 5D 47             JMP     @next
004732  2               @ckthief:
004732  2  C9 04                CMP     #M_THIEF
004734  2  D0 06                BNE     @cktroll
004736  2  20 A3 47             JSR     thief_act
004739  2  4C 5D 47             JMP     @next
00473C  2               @cktroll:
00473C  2  C9 05                CMP     #M_TROLL
00473E  2  D0 06                BNE     @ckwarden
004740  2  20 B8 47             JSR     troll_act
004743  2  4C 5D 47             JMP     @next
004746  2               @ckwarden:
004746  2  C9 07                CMP     #M_WARDEN
004748  2  D0 06                BNE     @ckdragon
00474A  2  20 9F 48             JSR     warden_act
00474D  2  4C 5D 47             JMP     @next
004750  2               @ckdragon:
004750  2  C9 06                CMP     #M_BOSS
004752  2  D0 06                BNE     @normal
004754  2  20 D9 47             JSR     dragon_act
004757  2  4C 5D 47             JMP     @next
00475A  2               @normal:
00475A  2               ; distance to player: dxv = px - mon_x ; dyv = py - mon_y
00475A  2               ; adjacency test (|dx|<=1 && |dy|<=1 && not both 0)
00475A  2  20 D7 48             JSR     mon_step_or_attack
00475D  2               @next:
00475D  2  E6 2F                INC     monidx
00475F  2  A5 2F                LDA     monidx
004761  2  C9 0C                CMP     #MAXMON
004763  2  F0 03                BEQ     @ret
004765  2  4C 15 47             JMP     @ma
004768  2               @ret:
004768  2  60                   RTS
004769  2               
004769  2               ;----------------------------------------------------------------
004769  2               ; Ordinary monster identities.
004769  2               ;----------------------------------------------------------------
004769  2               
004769  2               ; Snakes surge up to two cells per turn, like a weaker Warden.
004769  2               snake_act:
004769  2  4C 9F 48             JMP     warden_act
00476C  2               
00476C  2               ; Skeletons hold their ground until the player comes within four
00476C  2               ; cells, then remain awake and pursue normally.
00476C  2               skeleton_act:
00476C  2  A6 2F                LDX     monidx
00476E  2  BD 69 63             LDA     mon_state,X
004771  2  D0 2C                BNE     @awake
004773  2  38                   SEC
004774  2  AD 0C 62             LDA     px
004777  2  FD 45 63             SBC     mon_x,X
00477A  2  20 10 4A             JSR     abs_a
00477D  2  C9 05                CMP     #5
00477F  2  B0 21                BCS     @done
004781  2  A6 2F                LDX     monidx
004783  2  38                   SEC
004784  2  AD 0D 62             LDA     py
004787  2  FD 51 63             SBC     mon_y,X
00478A  2  20 10 4A             JSR     abs_a
00478D  2  C9 05                CMP     #5
00478F  2  B0 11                BCS     @done
004791  2  A6 2F                LDX     monidx
004793  2  A9 01                LDA     #1
004795  2  9D 69 63             STA     mon_state,X
004798  2  A9 37 A0 55          PRINTMSG_MSG m_skeleton_wakes
00479C  2  20 F9 3D     
00479F  2               @awake:
00479F  2  4C D7 48             JMP     mon_step_or_attack
0047A2  2               @done:
0047A2  2  60                   RTS
0047A3  2               
0047A3  2               ; Thieves approach until adjacent, steal once, then flee.
0047A3  2               thief_act:
0047A3  2  A6 2F                LDX     monidx
0047A5  2  BD 69 63             LDA     mon_state,X
0047A8  2  F0 03                BEQ     @hunting
0047AA  2  4C 9E 49             JMP     mon_step_away
0047AD  2               @hunting:
0047AD  2  20 B3 48             JSR     mon_is_adjacent
0047B0  2  90 03                BCC     @approach
0047B2  2  4C 3D 51             JMP     thief_steals_player
0047B5  2               @approach:
0047B5  2  4C D7 48             JMP     mon_step_or_attack
0047B8  2               
0047B8  2               ; Trolls act every other turn and recover one HP before acting.
0047B8  2               troll_act:
0047B8  2  AD 24 62             LDA     turn_phase
0047BB  2  29 01                AND     #1
0047BD  2  D0 19                BNE     @done
0047BF  2  A6 2F                LDX     monidx
0047C1  2  A0 05                LDY     #M_TROLL
0047C3  2  BD 5D 63             LDA     mon_hp,X
0047C6  2  D9 69 44             CMP     mtype_hp,Y
0047C9  2  B0 0A                BCS     @act
0047CB  2  FE 5D 63             INC     mon_hp,X
0047CE  2  A9 65 A0 55          PRINTMSG_MSG m_troll_regens
0047D2  2  20 F9 3D     
0047D5  2               @act:
0047D5  2  4C D7 48             JMP     mon_step_or_attack
0047D8  2               @done:
0047D8  2  60                   RTS
0047D9  2               
0047D9  2               ;----------------------------------------------------------------
0047D9  2               ; dragon_act - breathe down a warned straight lane on the following
0047D9  2               ; turn, otherwise warn when the player is in clear line of sight.
0047D9  2               ; The dragon uses normal melee and pursuit when no breath is ready.
0047D9  2               ;----------------------------------------------------------------
0047D9  2               dragon_act:
0047D9  2  AD 22 62             LDA     boss_breath_dir
0047DC  2  F0 03                BEQ     @ready
0047DE  2  4C 3A 48             JMP     dragon_fire_breath
0047E1  2               @ready:
0047E1  2  20 B3 48             JSR     mon_is_adjacent
0047E4  2  B0 05                BCS     @normal
0047E6  2  20 EF 47             JSR     dragon_prepare_breath
0047E9  2  B0 03                BCS     @done
0047EB  2               @normal:
0047EB  2  4C D7 48             JMP     mon_step_or_attack
0047EE  2               @done:
0047EE  2  60                   RTS
0047EF  2               
0047EF  2               ; dragon_prepare_breath - arm a breath attack if the player and
0047EF  2               ; dragon share a clear row or column. Returns C=1 when armed.
0047EF  2               dragon_prepare_breath:
0047EF  2  A6 2F                LDX     monidx
0047F1  2  BD 51 63             LDA     mon_y,X
0047F4  2  CD 0D 62             CMP     py
0047F7  2  D0 10                BNE     @vertical
0047F9  2               ; same row
0047F9  2  BD 45 63             LDA     mon_x,X
0047FC  2  CD 0C 62             CMP     px
0047FF  2  90 04                BCC     @right
004801  2  A9 03                LDA     #BREATH_LEFT
004803  2  D0 1A                BNE     @armed
004805  2               @right:
004805  2  A9 04                LDA     #BREATH_RIGHT
004807  2  D0 16                BNE     @armed
004809  2               @vertical:
004809  2  BD 45 63             LDA     mon_x,X
00480C  2  CD 0C 62             CMP     px
00480F  2  D0 27                BNE     @no
004811  2  BD 51 63             LDA     mon_y,X
004814  2  CD 0D 62             CMP     py
004817  2  90 04                BCC     @down
004819  2  A9 01                LDA     #BREATH_UP
00481B  2  D0 02                BNE     @armed
00481D  2               @down:
00481D  2  A9 02                LDA     #BREATH_DOWN
00481F  2               @armed:
00481F  2  8D 22 62             STA     boss_breath_dir
004822  2  20 57 48             JSR     dragon_line_hits_player
004825  2  90 0C                BCC     @blocked
004827  2  20 C9 0E             JSR     sfx_breath_warn
00482A  2  A9 58 A0 54          PRINTMSG_MSG m_breath_warn
00482E  2  20 F9 3D     
004831  2  38                   SEC
004832  2  60                   RTS
004833  2               @blocked:
004833  2  A9 00                LDA     #BREATH_NONE
004835  2  8D 22 62             STA     boss_breath_dir
004838  2               @no:
004838  2  18                   CLC
004839  2  60                   RTS
00483A  2               
00483A  2               ; dragon_fire_breath - resolve the prepared lane after the player
00483A  2               ; has had one turn to step clear.
00483A  2               dragon_fire_breath:
00483A  2  20 57 48             JSR     dragon_line_hits_player
00483D  2  90 08                BCC     @miss
00483F  2  A9 00                LDA     #BREATH_NONE
004841  2  8D 22 62             STA     boss_breath_dir
004844  2  4C B5 51             JMP     dragon_fire_player
004847  2               @miss:
004847  2  A9 00                LDA     #BREATH_NONE
004849  2  8D 22 62             STA     boss_breath_dir
00484C  2  20 F4 0E             JSR     sfx_breath
00484F  2  A9 8E A0 54          PRINTMSG_MSG m_breath_miss
004853  2  20 F9 3D     
004856  2  60                   RTS
004857  2               
004857  2               ; dragon_line_hits_player - trace the prepared lane from the dragon
004857  2               ; until blocked. Returns C=1 if the player is currently in it.
004857  2               dragon_line_hits_player:
004857  2  A6 2F                LDX     monidx
004859  2  BD 45 63             LDA     mon_x,X
00485C  2  85 2C                STA     tgtx
00485E  2  BD 51 63             LDA     mon_y,X
004861  2  85 2D                STA     tgty
004863  2               @trace:
004863  2  20 84 48             JSR     dragon_advance_target
004866  2  20 C4 1B             JSR     tileat
004869  2  A6 2E                LDX     tgttile
00486B  2  BD 5B 1A             LDA     tile_prop,X
00486E  2  29 01                AND     #P_PASS
004870  2  F0 10                BEQ     @no
004872  2  A5 2C                LDA     tgtx
004874  2  CD 0C 62             CMP     px
004877  2  D0 EA                BNE     @trace
004879  2  A5 2D                LDA     tgty
00487B  2  CD 0D 62             CMP     py
00487E  2  D0 E3                BNE     @trace
004880  2  38                   SEC
004881  2  60                   RTS
004882  2               @no:
004882  2  18                   CLC
004883  2  60                   RTS
004884  2               
004884  2               ; dragon_advance_target - move tgtx/tgty one cell in the prepared
004884  2               ; breath direction.
004884  2               dragon_advance_target:
004884  2  AD 22 62             LDA     boss_breath_dir
004887  2  C9 01                CMP     #BREATH_UP
004889  2  F0 0B                BEQ     @up
00488B  2  C9 02                CMP     #BREATH_DOWN
00488D  2  F0 0A                BEQ     @down
00488F  2  C9 03                CMP     #BREATH_LEFT
004891  2  F0 09                BEQ     @left
004893  2  E6 2C                INC     tgtx
004895  2  60                   RTS
004896  2               @up:
004896  2  C6 2D                DEC     tgty
004898  2  60                   RTS
004899  2               @down:
004899  2  E6 2D                INC     tgty
00489B  2  60                   RTS
00489C  2               @left:
00489C  2  C6 2C                DEC     tgtx
00489E  2  60                   RTS
00489F  2               
00489F  2               ;----------------------------------------------------------------
00489F  2               ; warden_act - the Wyrm Warden surges up to two tiles per turn.
00489F  2               ; It stops after closing to melee range, so it attacks at most once
00489F  2               ; per turn while remaining much harder to outrun than normal foes.
00489F  2               ;----------------------------------------------------------------
00489F  2               warden_act:
00489F  2  20 B3 48             JSR     mon_is_adjacent
0048A2  2  B0 0B                BCS     @attack
0048A4  2  20 D7 48             JSR     mon_step_or_attack
0048A7  2  20 B3 48             JSR     mon_is_adjacent
0048AA  2  B0 06                BCS     @done
0048AC  2  4C D7 48             JMP     mon_step_or_attack
0048AF  2               @attack:
0048AF  2  4C D7 48             JMP     mon_step_or_attack
0048B2  2               @done:
0048B2  2  60                   RTS
0048B3  2               
0048B3  2               ; mon_is_adjacent - C=1 if monster in monidx is beside the player.
0048B3  2               mon_is_adjacent:
0048B3  2  A6 2F                LDX     monidx
0048B5  2  38                   SEC
0048B6  2  AD 0C 62             LDA     px
0048B9  2  FD 45 63             SBC     mon_x,X
0048BC  2  20 10 4A             JSR     abs_a
0048BF  2  C9 02                CMP     #2
0048C1  2  B0 12                BCS     @no
0048C3  2  A6 2F                LDX     monidx
0048C5  2  38                   SEC
0048C6  2  AD 0D 62             LDA     py
0048C9  2  FD 51 63             SBC     mon_y,X
0048CC  2  20 10 4A             JSR     abs_a
0048CF  2  C9 02                CMP     #2
0048D1  2  B0 02                BCS     @no
0048D3  2  38                   SEC
0048D4  2  60                   RTS
0048D5  2               @no:
0048D5  2  18                   CLC
0048D6  2  60                   RTS
0048D7  2               
0048D7  2               ; mon_step_or_attack - for monster in slot monidx (X on entry).
0048D7  2               mon_step_or_attack:
0048D7  2               ; forests conceal the player from distant pursuers
0048D7  2  A9 00                LDA     #0
0048D9  2  85 25                STA     cnt1
0048DB  2  AD 19 62             LDA     loc
0048DE  2  D0 15                BNE     @distance
0048E0  2  AD 0C 62             LDA     px
0048E3  2  85 2C                STA     tgtx
0048E5  2  AD 0D 62             LDA     py
0048E8  2  85 2D                STA     tgty
0048EA  2  20 C4 1B             JSR     tileat
0048ED  2  A5 2E                LDA     tgttile
0048EF  2  C9 01                CMP     #T_FOREST
0048F1  2  D0 02                BNE     @distance
0048F3  2  E6 25                INC     cnt1
0048F5  2               @distance:
0048F5  2               ; compute signed dx = px - mon_x  -> tmp0 ; dy -> tmp1
0048F5  2  A6 2F                LDX     monidx
0048F7  2  38                   SEC
0048F8  2  AD 0C 62             LDA     px
0048FB  2  FD 45 63             SBC     mon_x,X
0048FE  2  85 20                STA     tmp0            ; dx (signed)
004900  2  38                   SEC
004901  2  AD 0D 62             LDA     py
004904  2  FD 51 63             SBC     mon_y,X
004907  2  85 21                STA     tmp1            ; dy (signed)
004909  2               ; |dx| <= 1 ?
004909  2  A5 20                LDA     tmp0
00490B  2  20 10 4A             JSR     abs_a
00490E  2  85 22                STA     tmp2            ; |dx|
004910  2  A5 21                LDA     tmp1
004912  2  20 10 4A             JSR     abs_a
004915  2  85 23                STA     tmp3            ; |dy|
004917  2               ; while concealed, monsters outside a five-cell square lose track
004917  2  A5 25                LDA     cnt1
004919  2  F0 12                BEQ     @adjacency
00491B  2  A5 22                LDA     tmp2
00491D  2  C9 06                CMP     #6
00491F  2  90 03                BCC     :+
004921  2  4C 9D 49             JMP     @done
004924  2               :
004924  2  A5 23                LDA     tmp3
004926  2  C9 06                CMP     #6
004928  2  90 03                BCC     :+
00492A  2  4C 9D 49             JMP     @done
00492D  2               :
00492D  2               @adjacency:
00492D  2               ; adjacency: |dx|<=1 and |dy|<=1
00492D  2  A5 22                LDA     tmp2
00492F  2  C9 02                CMP     #2
004931  2  B0 09                BCS     @move
004933  2  A5 23                LDA     tmp3
004935  2  C9 02                CMP     #2
004937  2  B0 03                BCS     @move
004939  2               ; adjacent (and since one of them is the player, not same cell)
004939  2               ; -> attack the player
004939  2  4C 99 50             JMP     monster_attacks_player; in combat.asm
00493C  2               @move:
00493C  2               ; step one tile toward player along the larger axis
00493C  2               ; choose step in x: sign of dx
00493C  2  A6 2F                LDX     monidx
00493E  2  BD 45 63             LDA     mon_x,X
004941  2  85 2C                STA     tgtx
004943  2  BD 51 63             LDA     mon_y,X
004946  2  85 2D                STA     tgty
004948  2               ; prefer horizontal if |dx|>=|dy|
004948  2  A5 22                LDA     tmp2
00494A  2  C5 23                CMP     tmp3
00494C  2  90 10                BCC     @vert
00494E  2               ; horizontal step
00494E  2  A5 20                LDA     tmp0
004950  2  F0 0C                BEQ     @vert           ; dx==0 -> try vertical
004952  2  30 05                BMI     @left
004954  2  E6 2C                INC     tgtx
004956  2  4C 6B 49             JMP     @trymove
004959  2               @left:
004959  2  C6 2C                DEC     tgtx
00495B  2  4C 6B 49             JMP     @trymove
00495E  2               @vert:
00495E  2  A5 21                LDA     tmp1
004960  2  F0 3B                BEQ     @done           ; dy==0 too -> no move
004962  2  30 05                BMI     @up
004964  2  E6 2D                INC     tgty
004966  2  4C 6B 49             JMP     @trymove
004969  2               @up:
004969  2  C6 2D                DEC     tgty
00496B  2               @trymove:
00496B  2               ; passable terrain?
00496B  2  20 C4 1B             JSR     tileat
00496E  2  A6 2E                LDX     tgttile
004970  2  BD 5B 1A             LDA     tile_prop,X
004973  2  29 01                AND     #P_PASS
004975  2  F0 26                BEQ     @done           ; blocked terrain
004977  2               ; monsters do not occupy map-transition landmarks
004977  2  BD 5B 1A             LDA     tile_prop,X
00497A  2  29 8C                AND     #(P_TOWN|P_DUNG|P_CASTLE)
00497C  2  D0 1F                BNE     @done
00497E  2               ; not onto the player?
00497E  2  A5 2C                LDA     tgtx
004980  2  CD 0C 62             CMP     px
004983  2  D0 07                BNE     @okcell
004985  2  A5 2D                LDA     tgty
004987  2  CD 0D 62             CMP     py
00498A  2  F0 11                BEQ     @done           ; would land on player (shouldn't: adjacency handled)
00498C  2               @okcell:
00498C  2               ; not onto another monster?
00498C  2  20 FF 44             JSR     mon_at
00498F  2  B0 0C                BCS     @done           ; occupied
004991  2               ; commit move
004991  2  A6 2F                LDX     monidx
004993  2  A5 2C                LDA     tgtx
004995  2  9D 45 63             STA     mon_x,X
004998  2  A5 2D                LDA     tgty
00499A  2  9D 51 63             STA     mon_y,X
00499D  2               @done:
00499D  2  60                   RTS
00499E  2               
00499E  2               ; mon_step_away - move the monster in monidx one cell away from the
00499E  2               ; player along the larger distance axis.
00499E  2               mon_step_away:
00499E  2  A6 2F                LDX     monidx
0049A0  2  38                   SEC
0049A1  2  BD 45 63             LDA     mon_x,X
0049A4  2  ED 0C 62             SBC     px
0049A7  2  85 20                STA     tmp0
0049A9  2  38                   SEC
0049AA  2  BD 51 63             LDA     mon_y,X
0049AD  2  ED 0D 62             SBC     py
0049B0  2  85 21                STA     tmp1
0049B2  2  A5 20                LDA     tmp0
0049B4  2  20 10 4A             JSR     abs_a
0049B7  2  85 22                STA     tmp2
0049B9  2  A5 21                LDA     tmp1
0049BB  2  20 10 4A             JSR     abs_a
0049BE  2  85 23                STA     tmp3
0049C0  2  A6 2F                LDX     monidx
0049C2  2  BD 45 63             LDA     mon_x,X
0049C5  2  85 2C                STA     tgtx
0049C7  2  BD 51 63             LDA     mon_y,X
0049CA  2  85 2D                STA     tgty
0049CC  2  A5 22                LDA     tmp2
0049CE  2  C5 23                CMP     tmp3
0049D0  2  90 0E                BCC     @vert
0049D2  2  A5 20                LDA     tmp0
0049D4  2  30 05                BMI     @left
0049D6  2  E6 2C                INC     tgtx
0049D8  2  4C EB 49             JMP     @try
0049DB  2               @left:
0049DB  2  C6 2C                DEC     tgtx
0049DD  2  4C EB 49             JMP     @try
0049E0  2               @vert:
0049E0  2  A5 21                LDA     tmp1
0049E2  2  30 05                BMI     @up
0049E4  2  E6 2D                INC     tgty
0049E6  2  4C EB 49             JMP     @try
0049E9  2               @up:
0049E9  2  C6 2D                DEC     tgty
0049EB  2               @try:
0049EB  2  20 C4 1B             JSR     tileat
0049EE  2  A6 2E                LDX     tgttile
0049F0  2  BD 5B 1A             LDA     tile_prop,X
0049F3  2  29 01                AND     #P_PASS
0049F5  2  F0 18                BEQ     @done
0049F7  2  BD 5B 1A             LDA     tile_prop,X
0049FA  2  29 8C                AND     #(P_TOWN|P_DUNG|P_CASTLE)
0049FC  2  D0 11                BNE     @done
0049FE  2  20 FF 44             JSR     mon_at
004A01  2  B0 0C                BCS     @done
004A03  2  A6 2F                LDX     monidx
004A05  2  A5 2C                LDA     tgtx
004A07  2  9D 45 63             STA     mon_x,X
004A0A  2  A5 2D                LDA     tgty
004A0C  2  9D 51 63             STA     mon_y,X
004A0F  2               @done:
004A0F  2  60                   RTS
004A10  2               
004A10  2               ;----------------------------------------------------------------
004A10  2               ; abs_a - A = |A| treating A as signed 8-bit.
004A10  2               ;----------------------------------------------------------------
004A10  2               abs_a:
004A10  2  C9 80                CMP     #$80
004A12  2  90 05                BCC     @pos
004A14  2  49 FF                EOR     #$FF
004A16  2  18                   CLC
004A17  2  69 01                ADC     #1
004A19  2               @pos:
004A19  2  60                   RTS
004A1A  2               
004A1A  1                       .INCLUDE "player.asm"
004A1A  2               ;______________________________________________________________________________
004A1A  2               ;  player.asm - player movement, map transitions, treasure
004A1A  2               ;______________________________________________________________________________
004A1A  2               
004A1A  2               ;----------------------------------------------------------------
004A1A  2               ; Player starting state on the overworld.
004A1A  2               ;----------------------------------------------------------------
004A1A  2               PLAYER_START_X  = 20
004A1A  2               PLAYER_START_Y  = 9
004A1A  2               
004A1A  2               player_init:
004A1A  2  A9 14                LDA     #PLAYER_START_X
004A1C  2  8D 0C 62             STA     px
004A1F  2  A9 09                LDA     #PLAYER_START_Y
004A21  2  8D 0D 62             STA     py
004A24  2  A9 1E                LDA     #30
004A26  2  8D 0E 62             STA     phealth
004A29  2  8D 0F 62             STA     pmaxhp
004A2C  2  A9 01                LDA     #1
004A2E  2  8D 10 62             STA     plevel
004A31  2  A9 00                LDA     #0
004A33  2  8D 11 62             STA     pxp
004A36  2  8D 12 62             STA     pxp+1
004A39  2  A9 32                LDA     #50
004A3B  2  8D 13 62             STA     pgold
004A3E  2  A9 00                LDA     #0
004A40  2  8D 14 62             STA     pgold+1
004A43  2  A9 FA 8D 15          SETW16  pfood, 250
004A47  2  62 A9 00 8D  
004A4B  2  16 62        
004A4D  2  A9 01                LDA     #1
004A4F  2  8D 17 62             STA     pweapon         ; dagger
004A52  2  A9 00                LDA     #0
004A54  2  8D 18 62             STA     parmor          ; clothes
004A57  2  A9 00                LDA     #LOC_WORLD
004A59  2  8D 19 62             STA     loc
004A5C  2  A9 00                LDA     #0
004A5E  2  8D 1A 62             STA     town_id
004A61  2  8D 1B 62             STA     discovery_flags
004A64  2  8D 20 62             STA     bosskilled
004A67  2  8D 21 62             STA     queststate
004A6A  2  8D 22 62             STA     boss_breath_dir
004A6D  2  8D 23 62             STA     poison_turns
004A70  2  8D 24 62             STA     turn_phase
004A73  2  8D 25 62             STA     guard_active
004A76  2  8D 26 62             STA     attack_flags
004A79  2  60                   RTS
004A7A  2               
004A7A  2               ;----------------------------------------------------------------
004A7A  2               ; try_move - attempt to move the player by (dx,dy).
004A7A  2               ;   IN: dx, dy = signed -1/0/+1 deltas
004A7A  2               ;   Effects: combat on bump, terrain block, town/dungeon entry,
004A7A  2               ;   treasure pickup, exit interiors, food cost.  Monsters act after
004A7A  2               ;   a successful step (handled by caller via did_move flag).
004A7A  2               ;   OUT: did_move (game var) = 1 if a turn was consumed.
004A7A  2               ;----------------------------------------------------------------
004A7A  2               try_move:
004A7A  2  A9 00                LDA     #0
004A7C  2  8D 27 62             STA     did_move
004A7F  2               ; target = (px+dx, py+dy)
004A7F  2  18                   CLC
004A80  2  AD 0C 62             LDA     px
004A83  2  65 2A                ADC     dx
004A85  2  85 2C                STA     tgtx
004A87  2  18                   CLC
004A88  2  AD 0D 62             LDA     py
004A8B  2  65 2B                ADC     dy
004A8D  2  85 2D                STA     tgty
004A8F  2               
004A8F  2               ; monster there? -> attack (consumes the turn)
004A8F  2  20 FF 44             JSR     mon_at
004A92  2  90 09                BCC     @noenemy
004A94  2               ; X = monster slot ; resolve combat
004A94  2  20 E2 4E             JSR     player_attacks_monster
004A97  2  A9 01                LDA     #1
004A99  2  8D 27 62             STA     did_move
004A9C  2  60                   RTS
004A9D  2               @noenemy:
004A9D  2               ; look at the terrain
004A9D  2  20 C4 1B             JSR     tileat          ; -> tgttile
004AA0  2  A6 2E                LDX     tgttile
004AA2  2  BD 5B 1A             LDA     tile_prop,X
004AA5  2  85 20                STA     tmp0            ; property bits
004AA7  2  29 01                AND     #P_PASS
004AA9  2  D0 0B                BNE     @passable
004AAB  2               ; blocked
004AAB  2  20 00 0E             JSR     sfx_blocked
004AAE  2  A9 B5 A0 52          PRINTMSG_MSG m_blocked
004AB2  2  20 F9 3D     
004AB5  2  60                   RTS                     ; no turn consumed on a wall bump
004AB6  2               @passable:
004AB6  2               ; check special tiles
004AB6  2  A5 20                LDA     tmp0
004AB8  2  29 04                AND     #P_TOWN
004ABA  2  F0 06                BEQ     @ck_castle
004ABC  2  20 28 45             JSR     save_overworld_monsters
004ABF  2  4C 16 4D             JMP     enter_town
004AC2  2               @ck_castle:
004AC2  2  A5 20                LDA     tmp0
004AC4  2  29 80                AND     #P_CASTLE
004AC6  2  F0 06                BEQ     @ck_dung
004AC8  2  20 28 45             JSR     save_overworld_monsters
004ACB  2  4C 6B 4D             JMP     enter_castle
004ACE  2               @ck_dung:
004ACE  2  A5 20                LDA     tmp0
004AD0  2  29 08                AND     #P_DUNG
004AD2  2  F0 06                BEQ     @ck_exit
004AD4  2  20 28 45             JSR     save_overworld_monsters
004AD7  2  4C A6 4D             JMP     enter_dungeon
004ADA  2               @ck_exit:
004ADA  2  A5 20                LDA     tmp0
004ADC  2  29 10                AND     #P_EXIT
004ADE  2  F0 03                BEQ     @ck_treas
004AE0  2  4C 2A 4E             JMP     leave_interior
004AE3  2               @ck_treas:
004AE3  2               ; commit the move first
004AE3  2  A5 2C                LDA     tgtx
004AE5  2  8D 0C 62             STA     px
004AE8  2  A5 2D                LDA     tgty
004AEA  2  8D 0D 62             STA     py
004AED  2  A9 01                LDA     #1
004AEF  2  8D 27 62             STA     did_move
004AF2  2               ; treasure?
004AF2  2  A5 20                LDA     tmp0
004AF4  2  29 20                AND     #P_TREAS
004AF6  2  F0 03                BEQ     @food
004AF8  2  20 EF 4C             JSR     collect_treasure
004AFB  2               @food:
004AFB  2               ; terrain sets the base travel cost: roads and bridges are free,
004AFB  2               ; ordinary ground costs one ration, and marshes cost two.
004AFB  2  A9 01                LDA     #1
004AFD  2  85 22                STA     tmp2
004AFF  2  AD 19 62             LDA     loc
004B02  2  D0 19                BNE     @armor_cost
004B04  2  A5 2E                LDA     tgttile
004B06  2  C9 07                CMP     #T_ROAD
004B08  2  F0 0F                BEQ     @easy_travel
004B0A  2  C9 08                CMP     #T_BRIDGE
004B0C  2  F0 0B                BEQ     @easy_travel
004B0E  2  C9 10                CMP     #T_MARSH
004B10  2  D0 0B                BNE     @armor_cost
004B12  2  A9 02                LDA     #2
004B14  2  85 22                STA     tmp2
004B16  2  4C 1D 4B             JMP     @armor_cost
004B19  2               @easy_travel:
004B19  2  A9 00                LDA     #0
004B1B  2  85 22                STA     tmp2
004B1D  2               @armor_cost:
004B1D  2               ; plate armor adds one ration to any successful step
004B1D  2  AE 18 62             LDX     parmor
004B20  2  E0 03                CPX     #3
004B22  2  D0 02                BNE     @consume_food
004B24  2  E6 22                INC     tmp2
004B26  2               @consume_food:
004B26  2  A5 22                LDA     tmp2
004B28  2  F0 08                BEQ     @terrain_effect
004B2A  2  20 44 4B             JSR     consume_food_unit
004B2D  2  C6 22                DEC     tmp2
004B2F  2  4C 26 4B             JMP     @consume_food
004B32  2               @terrain_effect:
004B32  2               ; marshes may poison the traveler after movement is committed
004B32  2  AD 19 62             LDA     loc
004B35  2  D0 09                BNE     @discoveries
004B37  2  A5 2E                LDA     tgttile
004B39  2  C9 10                CMP     #T_MARSH
004B3B  2  D0 03                BNE     @discoveries
004B3D  2  20 5E 4B             JSR     marsh_hazard
004B40  2               @discoveries:
004B40  2  20 8F 4B             JSR     check_overworld_discovery
004B43  2  60                   RTS
004B44  2               
004B44  2               ;----------------------------------------------------------------
004B44  2               ; consume_food_unit - consume one provision if any remain.
004B44  2               ;----------------------------------------------------------------
004B44  2               consume_food_unit:
004B44  2  AD 15 62             LDA     pfood
004B47  2  0D 16 62             ORA     pfood+1
004B4A  2  F0 11                BEQ     @done
004B4C  2  38                   SEC
004B4D  2  AD 15 62             LDA     pfood
004B50  2  E9 01                SBC     #1
004B52  2  8D 15 62             STA     pfood
004B55  2  AD 16 62             LDA     pfood+1
004B58  2  E9 00                SBC     #0
004B5A  2  8D 16 62             STA     pfood+1
004B5D  2               @done:
004B5D  2  60                   RTS
004B5E  2               
004B5E  2               ;----------------------------------------------------------------
004B5E  2               ; marsh_hazard - marsh travel can inflict poison. Leather armor
004B5E  2               ; reduces the chance from one-in-eight to one-in-sixteen.
004B5E  2               ;----------------------------------------------------------------
004B5E  2               marsh_hazard:
004B5E  2  AE 18 62             LDX     parmor
004B61  2  E0 01                CPX     #1
004B63  2  D0 04                BNE     @normal_risk
004B65  2  A9 10                LDA     #16
004B67  2  D0 02                BNE     @roll
004B69  2               @normal_risk:
004B69  2  A9 08                LDA     #8
004B6B  2               @roll:
004B6B  2  20 F8 0C             JSR     rng_d
004B6E  2  C9 01                CMP     #1
004B70  2  D0 1C                BNE     @safe
004B72  2  AD 23 62             LDA     poison_turns
004B75  2  D0 08                BNE     @refresh
004B77  2  A9 84                LDA     #$84            ; skip the immediate status tick
004B79  2  8D 23 62             STA     poison_turns
004B7C  2  4C 84 4B             JMP     @poisoned
004B7F  2               @refresh:
004B7F  2  A9 04                LDA     #4
004B81  2  8D 23 62             STA     poison_turns
004B84  2               @poisoned:
004B84  2  20 A0 0E             JSR     sfx_poison
004B87  2  A9 13 A0 55          PRINTMSG_MSG m_marsh_poison
004B8B  2  20 F9 3D     
004B8E  2               @safe:
004B8E  2  60                   RTS
004B8F  2               
004B8F  2               ;----------------------------------------------------------------
004B8F  2               ; check_overworld_discovery - award one-time authored discoveries
004B8F  2               ; when the player reaches their overworld coordinates.
004B8F  2               ;----------------------------------------------------------------
004B8F  2               check_overworld_discovery:
004B8F  2  AD 19 62             LDA     loc
004B92  2  F0 01                BEQ     :+
004B94  2  60                   RTS
004B95  2               :
004B95  2  AD 1B 62             LDA     discovery_flags
004B98  2  29 01                AND     #DISC_CACHE
004B9A  2  D0 11                BNE     @cairn_check
004B9C  2  AD 0C 62             LDA     px
004B9F  2  C9 1E                CMP     #CACHE_X
004BA1  2  D0 0A                BNE     @cairn_check
004BA3  2  AD 0D 62             LDA     py
004BA6  2  C9 04                CMP     #CACHE_Y
004BA8  2  D0 03                BNE     @cairn_check
004BAA  2  4C DE 4B             JMP     discover_cache
004BAD  2               @cairn_check:
004BAD  2  AD 1B 62             LDA     discovery_flags
004BB0  2  29 02                AND     #DISC_CAIRN
004BB2  2  D0 11                BNE     @waystone_check
004BB4  2  AD 0C 62             LDA     px
004BB7  2  C9 1F                CMP     #CAIRN_X
004BB9  2  D0 0A                BNE     @waystone_check
004BBB  2  AD 0D 62             LDA     py
004BBE  2  C9 1A                CMP     #CAIRN_Y
004BC0  2  D0 03                BNE     @waystone_check
004BC2  2  4C 13 4C             JMP     discover_cairn
004BC5  2               @waystone_check:
004BC5  2  AD 1B 62             LDA     discovery_flags
004BC8  2  29 04                AND     #DISC_WAYSTONE
004BCA  2  D0 11                BNE     @done
004BCC  2  AD 0C 62             LDA     px
004BCF  2  C9 1D                CMP     #WAYSTONE_X
004BD1  2  D0 0A                BNE     @done
004BD3  2  AD 0D 62             LDA     py
004BD6  2  C9 28                CMP     #WAYSTONE_Y
004BD8  2  D0 03                BNE     @done
004BDA  2  4C 37 4C             JMP     discover_waystone
004BDD  2               @done:
004BDD  2  60                   RTS
004BDE  2               
004BDE  2               ; A hunter's hidden cache provides both money and travel supplies.
004BDE  2               discover_cache:
004BDE  2  AD 1B 62             LDA     discovery_flags
004BE1  2  09 01                ORA     #DISC_CACHE
004BE3  2  8D 1B 62             STA     discovery_flags
004BE6  2  18                   CLC
004BE7  2  AD 13 62             LDA     pgold
004BEA  2  69 28                ADC     #40
004BEC  2  8D 13 62             STA     pgold
004BEF  2  AD 14 62             LDA     pgold+1
004BF2  2  69 00                ADC     #0
004BF4  2  8D 14 62             STA     pgold+1
004BF7  2  18                   CLC
004BF8  2  AD 15 62             LDA     pfood
004BFB  2  69 4B                ADC     #75
004BFD  2  8D 15 62             STA     pfood
004C00  2  AD 16 62             LDA     pfood+1
004C03  2  69 00                ADC     #0
004C05  2  8D 16 62             STA     pfood+1
004C08  2  20 41 0F             JSR     sfx_treasure
004C0B  2  A9 DA A0 55          PRINTMSG_MSG m_discover_cache
004C0F  2  20 F9 3D     
004C12  2  60                   RTS
004C13  2               
004C13  2               ; The hilltop cairn grants a permanent vitality blessing.
004C13  2               discover_cairn:
004C13  2  AD 1B 62             LDA     discovery_flags
004C16  2  09 02                ORA     #DISC_CAIRN
004C18  2  8D 1B 62             STA     discovery_flags
004C1B  2  18                   CLC
004C1C  2  AD 0F 62             LDA     pmaxhp
004C1F  2  69 05                ADC     #5
004C21  2  8D 0F 62             STA     pmaxhp
004C24  2  8D 0E 62             STA     phealth
004C27  2  A9 00                LDA     #0
004C29  2  8D 23 62             STA     poison_turns
004C2C  2  20 78 0F             JSR     sfx_levelup
004C2F  2  A9 0F A0 56          PRINTMSG_MSG m_discover_cairn
004C33  2  20 F9 3D     
004C36  2  60                   RTS
004C37  2               
004C37  2               ; The old waystone gives a concise route clue.
004C37  2               discover_waystone:
004C37  2  AD 1B 62             LDA     discovery_flags
004C3A  2  09 04                ORA     #DISC_WAYSTONE
004C3C  2  8D 1B 62             STA     discovery_flags
004C3F  2  20 41 0F             JSR     sfx_treasure
004C42  2  A9 44 A0 56          PRINTMSG_MSG m_discover_waystone
004C46  2  20 F9 3D     
004C49  2  60                   RTS
004C4A  2               
004C4A  2               ;----------------------------------------------------------------
004C4A  2               ; overworld_use - contextual overworld interaction. The discovered
004C4A  2               ; waystone can be read again with T so its route clue is not lost.
004C4A  2               ;----------------------------------------------------------------
004C4A  2               overworld_use:
004C4A  2  AD 0C 62             LDA     px
004C4D  2  C9 1D                CMP     #WAYSTONE_X
004C4F  2  D0 0F                BNE     @shortcut_a
004C51  2  AD 0D 62             LDA     py
004C54  2  C9 28                CMP     #WAYSTONE_Y
004C56  2  D0 08                BNE     @shortcut_a
004C58  2  A9 44 A0 56          PRINTMSG_MSG m_discover_waystone
004C5C  2  20 F9 3D     
004C5F  2  60                   RTS
004C60  2               @shortcut_a:
004C60  2  AD 0C 62             LDA     px
004C63  2  C9 14                CMP     #SHORTCUT_A_X
004C65  2  D0 12                BNE     @shortcut_b
004C67  2  AD 0D 62             LDA     py
004C6A  2  C9 39                CMP     #SHORTCUT_A_Y
004C6C  2  D0 0B                BNE     @shortcut_b
004C6E  2  A9 20                LDA     #SHORTCUT_B_X
004C70  2  85 2C                STA     tgtx
004C72  2  A9 3B                LDA     #SHORTCUT_B_Y
004C74  2  85 2D                STA     tgty
004C76  2  4C 9A 4C             JMP     shortcut_cross
004C79  2               @shortcut_b:
004C79  2  AD 0C 62             LDA     px
004C7C  2  C9 20                CMP     #SHORTCUT_B_X
004C7E  2  D0 12                BNE     @nothing
004C80  2  AD 0D 62             LDA     py
004C83  2  C9 3B                CMP     #SHORTCUT_B_Y
004C85  2  D0 0B                BNE     @nothing
004C87  2  A9 14                LDA     #SHORTCUT_A_X
004C89  2  85 2C                STA     tgtx
004C8B  2  A9 39                LDA     #SHORTCUT_A_Y
004C8D  2  85 2D                STA     tgty
004C8F  2  4C 9A 4C             JMP     shortcut_cross
004C92  2               @nothing:
004C92  2  A9 BD A0 5B          PRINTMSG_MSG t_nothing
004C96  2  20 F9 3D     
004C99  2  60                   RTS
004C9A  2               
004C9A  2               ; The reed ford is a deliberate shortcut through the Sunken March:
004C9A  2               ; useful, but costly enough that using it wounded is a bad idea.
004C9A  2               shortcut_cross:
004C9A  2  AD 0E 62             LDA     phealth
004C9D  2  C9 07                CMP     #SHORTCUT_HP_COST+1
004C9F  2  B0 0B                BCS     @can_cross
004CA1  2  20 00 0E             JSR     sfx_blocked
004CA4  2  A9 B8 A0 56          PRINTMSG_MSG m_shortcut_weak
004CA8  2  20 F9 3D     
004CAB  2  60                   RTS
004CAC  2               @can_cross:
004CAC  2  20 FF 44             JSR     mon_at
004CAF  2  90 0B                BCC     @destination_clear
004CB1  2  20 00 0E             JSR     sfx_blocked
004CB4  2  A9 E9 A0 56          PRINTMSG_MSG m_shortcut_blocked
004CB8  2  20 F9 3D     
004CBB  2  60                   RTS
004CBC  2               @destination_clear:
004CBC  2  38                   SEC
004CBD  2  AD 0E 62             LDA     phealth
004CC0  2  E9 06                SBC     #SHORTCUT_HP_COST
004CC2  2  8D 0E 62             STA     phealth
004CC5  2               
004CC5  2  A2 14                LDX     #SHORTCUT_FOOD_COST
004CC7  2               @food:
