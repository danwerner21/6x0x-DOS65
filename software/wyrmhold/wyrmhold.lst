ca65 V2.18 - Ubuntu 2.19-1
Main file   : wyrmhold.asm
Current file: wyrmhold.asm

000000r 1               ;______________________________________________________________________________
000000r 1               ;  WYRMHOLD  -  an original top-down fantasy RPG for the 6502PC / DOS/65
000000r 1               ;
000000r 1               ;  Written in 6502 assembly (ca65).  Uses the memory-mapped video card
000000r 1               ;  (direct VRAM via MMU paging, the SpeedScript way) and the AY-3-8910
000000r 1               ;  PSG for a title melody and sound effects.
000000r 1               ;
000000r 1               ;  Program loads at $0800 (DOS/65 TEA) and exits back to DOS with JMP $0100.
000000r 1               ;______________________________________________________________________________
000000r 1                       .PSC02
000000r 1               
000000r 1                       .SEGMENT "TEA"
000000r 1                       .ORG    $0800
000800  1               
000800  1                       .INCLUDE "macro.asm"
000800  2               ;______________________________________________________________________________
000800  2               ;  macro.asm - 16-bit helpers and a FARCALL convenience macro
000800  2               ;  Style follows software/speedscript/macro.asm
000800  2               ;______________________________________________________________________________
000800  2               
000800  2               ; Copy a 16-bit value src -> dst
000800  2                       .macro  COPY16  src, dst
000800  2                       LDA     src
000800  2                       STA     dst
000800  2                       LDA     src+1
000800  2                       STA     dst+1
000800  2                       .endmacro
000800  2               
000800  2               ; left = left + right (16-bit)
000800  2                       .macro  ADD16   left,right
000800  2                       CLC
000800  2                       LDA     left
000800  2                       ADC     right
000800  2                       STA     left
000800  2                       LDA     left+1
000800  2                       ADC     right+1
000800  2                       STA     left+1
000800  2                       .endmacro
000800  2               
000800  2               ; left = left - right (16-bit)
000800  2                       .macro  SUB16   left,right
000800  2                       SEC
000800  2                       LDA     left
000800  2                       SBC     right
000800  2                       STA     left
000800  2                       LDA     left+1
000800  2                       SBC     right+1
000800  2                       STA     left+1
000800  2                       .endmacro
000800  2               
000800  2               ; Set a 16-bit zero-page word to an immediate constant.
000800  2                       .macro  SETW16  dst, value
000800  2                       LDA     #<(value)
000800  2                       STA     dst
000800  2                       LDA     #>(value)
000800  2                       STA     dst+1
000800  2                       .endmacro
000800  2               
000800  2               ; Issue a FARCALL: store function number then JSR DO_FARCALL.
000800  2               ; Pass any X/Y/A arguments BEFORE invoking (this macro only touches A).
000800  2                       .macro  FARCALL func
000800  2                       LDA     #func
000800  2                       STA     farfunct
000800  2                       JSR     DO_FARCALL
000800  2                       .endmacro
000800  2               
000800  2               ; Print a zero-terminated message via the firmware console (FARCALL chrout).
000800  2               ; message = address of a 0-terminated string.
000800  2                       .macro  PRINTMSG message
000800  2                       LDA     #<message
000800  2                       LDY     #>message
000800  2                       JSR     prmsg
000800  2                       .endmacro
000800  2               
000800  2               ; Push a message into the scrolling message log at the bottom.
000800  2                       .macro  PRINTMSG_MSG message
000800  2                       LDA     #<message
000800  2                       LDY     #>message
000800  2                       JSR     msg_print
000800  2                       .endmacro
000800  2               
000800  2               ; Set the shop status-line pointer (shopstat) to a message address.
000800  2                       .macro  SETSTAT message
000800  2                       LDA     #<message
000800  2                       STA     shopstat
000800  2                       LDA     #>message
000800  2                       STA     shopstat+1
000800  2                       .endmacro
000800  2               
000800  1                       .INCLUDE "defines.asm"
000800  2               ;______________________________________________________________________________
000800  2               ;  defines.asm - system equates, constants and game state
000800  2               ;______________________________________________________________________________
000800  2               
000800  2               ;----------------------------------------------------------------
000800  2               ; DOS/65 system entry points
000800  2               ;----------------------------------------------------------------
000800  2               DFLFCB          = $107          ; DEFAULT FCB
000800  2               PEM             = $103          ; PEM ENTRY
000800  2               BOOT            = $100          ; WARM BOOT (exit back to DOS/65)
000800  2               
000800  2               ;----------------------------------------------------------------
000800  2               ; Memory-mapped video state (firmware-shared, fixed addresses)
000800  2               ;----------------------------------------------------------------
000800  2               CURX            = $0647         ; current cursor column
000800  2               CURY            = $0648         ; current cursor row
000800  2               SHOWCRSR        = $0649         ; show cursor (1=yes,0=no)
000800  2               CURCOLOR        = $064A         ; current print color
000800  2               CSRCOLOR        = $064B         ; current cursor color
000800  2               BVIDEOMODE      = $064C         ; current video mode (0=40,1=80)
000800  2               
000800  2               ;----------------------------------------------------------------
000800  2               ; FARCALL dispatch
000800  2               ;----------------------------------------------------------------
000800  2               DO_FARCALL      = $FFF0
000800  2               farfunct        = $32           ; zero-page: FARCALL function number
000800  2               
000800  2               ; MMU / video paging
000800  2               SETPAGE         = $FFF6         ; A=task, X=bank, Y=physical page
000800  2               VIDEOBANK       = $F8           ; base physical page for video RAM
000800  2               PC6502_ACT_TASK = $EFE0         ; MMU active task register (write only)
000800  2               VIDTEXT_PAGE    = $01+VIDEOBANK ; physical page for text page 1 ($F9)
000800  2               
000800  2               ; FARCALL function numbers (see 6502PC_firmware/dos65drv.asm)
000800  2               FC_CHROUT       = 19
000800  2               FC_CHRIN        = 20            ; non-blocking, returns A=key or $FF
000800  2               FC_LOCATE       = 37            ; X=col, Y=row
000800  2               FC_SCNCLR       = 38
000800  2               FC_COLOR        = 39            ; X=color, Y=cursor color
000800  2               FC_SCROLLDN     = 56
000800  2               FC_SETMODE      = 57
000800  2               FC_PAINTCSR     = 58
000800  2               FC_UNPAINTCSR   = 59
000800  2               
000800  2               ;----------------------------------------------------------------
000800  2               ; Video memory window (we map sub-page $F9 into CPU bank $A,
000800  2               ; matching software/speedscript/screen.asm).
000800  2               ;   text  chars : $A000 + row*80 + col
000800  2               ;   color cells : $A800 + row*80 + col   (low nibble fg, high nibble bg)
000800  2               ;----------------------------------------------------------------
000800  2               VRAM_TEXT       = $A000
000800  2               VRAM_COLOR      = $A800
000800  2               SCRW            = 80
000800  2               SCRH            = 24
000800  2               
000800  2               ;----------------------------------------------------------------
000800  2               ; Color values.  color byte = (bg<<4) | fg
000800  2               ; Base palette nibbles (typical 4-bit IRGB-ish ordering used by the card)
000800  2               ;----------------------------------------------------------------
000800  2               CO_BLACK        = $0
000800  2               CO_RED          = $1
000800  2               CO_GREEN        = $2
000800  2               CO_YELLOW       = $3
000800  2               CO_BLUE         = $4
000800  2               CO_MAGENTA      = $5
000800  2               CO_CYAN         = $6
000800  2               CO_WHITE        = $7
000800  2               CO_GREY         = $8
000800  2               CO_BRRED        = $9
000800  2               CO_BRGREEN      = $A
000800  2               CO_BRYELLOW     = $B
000800  2               CO_BRBLUE       = $C
000800  2               CO_BRMAGENTA    = $D
000800  2               CO_BRCYAN       = $E
000800  2               CO_BRWHITE      = $F
000800  2               
000800  2               ; convenience: build a color byte from fg,bg nibbles
000800  2               .define COLOR(fg,bg)  (((bg)<<4)|(fg))
000800  2               
000800  2               ; named cell colors used throughout the game
000800  2               C_GRASS         = COLOR(CO_BRGREEN, CO_BLACK)
000800  2               C_WATER         = COLOR(CO_BRBLUE,  CO_BLUE)
000800  2               C_FOREST        = COLOR(CO_GREEN,   CO_BLACK)
000800  2               C_MOUNT         = COLOR(CO_GREY,    CO_BLACK)
000800  2               C_TOWN          = COLOR(CO_BRYELLOW,CO_BLACK)
000800  2               C_CASTLE        = COLOR(CO_BRWHITE, CO_BLACK)
000800  2               C_DUNG          = COLOR(CO_BRMAGENTA,CO_BLACK)
000800  2               C_ROAD          = COLOR(CO_BRYELLOW,CO_BLACK)
000800  2               C_BRIDGE        = COLOR(CO_YELLOW,  CO_BLACK)
000800  2               C_FLOOR         = COLOR(CO_GREY,    CO_BLACK)
000800  2               C_WALL          = COLOR(CO_BRWHITE, CO_GREY)
000800  2               C_TREAS         = COLOR(CO_BRYELLOW,CO_BLACK)
000800  2               C_PLAYER        = COLOR(CO_BRWHITE, CO_BLACK)
000800  2               C_MONST         = COLOR(CO_BRRED,   CO_BLACK)
000800  2               C_BOSS          = COLOR(CO_BRRED,   CO_RED)
000800  2               C_BORDER        = COLOR(CO_BRCYAN,  CO_BLACK)
000800  2               C_PANEL         = COLOR(CO_BRWHITE, CO_BLACK)
000800  2               C_PANELHDR      = COLOR(CO_BRYELLOW,CO_BLUE)
000800  2               C_MSG           = COLOR(CO_BRWHITE, CO_BLACK)
000800  2               C_TITLE         = COLOR(CO_BRYELLOW,CO_BLACK)
000800  2               C_BLANK         = COLOR(CO_WHITE,   CO_BLACK)
000800  2               
000800  2               ; shop panel colors (blue panel with bright text)
000800  2               C_SHOPBG        = COLOR(CO_BRWHITE, CO_BLUE)
000800  2               C_SHOPBRD       = COLOR(CO_BRCYAN,  CO_BLUE)
000800  2               C_SHOPTTL       = COLOR(CO_BRYELLOW,CO_BLUE)
000800  2               C_SHOPTXT       = COLOR(CO_BRWHITE, CO_BLUE)
000800  2               C_SHOPST        = COLOR(CO_BRGREEN, CO_BLUE)
000800  2               
000800  2               ; exit tiles (town door / dungeon stairs) - bright so they stand out
000800  2               C_EXIT          = COLOR(CO_BLACK,   CO_BRGREEN)
000800  2               
000800  2               ;----------------------------------------------------------------
000800  2               ; Tile codes (index into terrain tables).  Stored in map data.
000800  2               ;----------------------------------------------------------------
000800  2               T_GRASS         = 0
000800  2               T_FOREST        = 1
000800  2               T_MOUNT         = 2
000800  2               T_WATER         = 3
000800  2               T_TOWN          = 4
000800  2               T_DUNG          = 5
000800  2               T_CASTLE        = 6
000800  2               T_ROAD          = 7
000800  2               T_BRIDGE        = 8
000800  2               T_FLOOR         = 9             ; dungeon/town floor
000800  2               T_WALL          = 10            ; dungeon/town wall (impassable)
000800  2               T_DOOR          = 11            ; exit tile (leave town/dungeon)
000800  2               T_TREAS         = 12            ; treasure chest
000800  2               T_UPSTAIR       = 13            ; leave dungeon
000800  2               T_SHOP          = 14            ; shop counter inside a town
000800  2               NUM_TILES       = 15
000800  2               
000800  2               ;----------------------------------------------------------------
000800  2               ; Map glyphs.  These are custom characters whose 8x8 bitmaps are
000800  2               ; uploaded to the character generator at startup by chargen_init
000800  2               ; (see tiles.asm).
000800  2               ;
000800  2               ; We use codes in the CONTROL range (1..31).  The UI only ever
000800  2               ; prints ASCII 32+, so these slots are free to redefine and they
000800  2               ; live safely in the low 128 of the font (some cards only redefine
000800  2               ; / display 128 glyphs and treat bit7 as an attribute, which broke
000800  2               ; the earlier 128+ codes - monsters showed the stock font).
000800  2               ;----------------------------------------------------------------
000800  2               G_GRASS         = 1
000800  2               G_FOREST        = 2
000800  2               G_MOUNT         = 3
000800  2               G_WATER         = 4
000800  2               G_TOWN          = 5
000800  2               G_DUNG          = 6
000800  2               G_CASTLE        = 7
000800  2               G_ROAD          = 8
000800  2               G_BRIDGE        = 9
000800  2               G_FLOOR         = 10
000800  2               G_WALL          = 11
000800  2               G_DOOR          = 12
000800  2               G_TREAS         = 13
000800  2               G_UPSTAIR       = 14
000800  2               G_SHOP          = 15
000800  2               
000800  2               G_PLAYER        = 16
000800  2               
000800  2               ; monster glyphs
000800  2               G_ORC           = 17
000800  2               G_SNAKE         = 18
000800  2               G_SKELETON      = 19
000800  2               G_THIEF         = 20
000800  2               G_TROLL         = 21
000800  2               G_BOSS          = 22
000800  2               
000800  2               ;----------------------------------------------------------------
000800  2               ; Monster type ids
000800  2               ;----------------------------------------------------------------
000800  2               M_NONE          = 0
000800  2               M_ORC           = 1
000800  2               M_SNAKE         = 2
000800  2               M_SKELETON      = 3
000800  2               M_THIEF         = 4
000800  2               M_TROLL         = 5
000800  2               M_BOSS          = 6
000800  2               NUM_MTYPE       = 7
000800  2               MAXMON          = 12            ; max simultaneously active monsters
000800  2               
000800  2               ;----------------------------------------------------------------
000800  2               ; Viewport geometry (left map window).  Odd width/height so the
000800  2               ; player sits dead center.  Interior only - the frame is drawn
000800  2               ; around it.
000800  2               ;   frame at col 0..VPW+1, rows 0..VPH+1  (top bar handled separately)
000800  2               ;----------------------------------------------------------------
000800  2               VPW             = 45            ; viewport interior width (cols 1..45)
000800  2               VPH             = 20            ; viewport interior height (rows 1..20)
000800  2               VPX0            = 1             ; first interior column (screen)
000800  2               VPY0            = 1             ; first interior row (screen)
000800  2               VPCX            = 22            ; player column within viewport interior (0-based)
000800  2               VPCY            = 10            ; player row within viewport interior (0-based)
000800  2               
000800  2               ; panel geometry (right side)
000800  2               PANX            = 48            ; panel text start column
000800  2               PANW            = 31
000800  2               
000800  2               ; message log geometry (bottom two rows)
000800  2               MSGY0           = 22
000800  2               MSGROWS         = 2
000800  2               
000800  2               ; map dimensions
000800  2               OWW             = 64            ; overworld width
000800  2               OWH             = 64            ; overworld height
000800  2               TOWNW           = 32            ; town map width
000800  2               TOWNH           = 20            ; town map height
000800  2               DUNGW           = 32            ; dungeon map width
000800  2               DUNGH           = 20            ; dungeon map height
000800  2               
000800  2               ; world/location ids (which map is active)
000800  2               LOC_WORLD       = 0
000800  2               LOC_TOWN        = 1
000800  2               LOC_DUNG        = 2
000800  2               
000800  2               ; misc constants
000800  2               space           = 32
000800  2               ESC             = 27
000800  2               CR              = 13
000800  2               
000800  2               ;----------------------------------------------------------------
000800  2               ; Zero-page allocation.  $00-$31 are largely free for the TEA;
000800  2               ; $32 (farfunct) is reserved by the system.  We use a contiguous
000800  2               ; block below it and a high block ($F0-$FE scratch pointers) the
000800  2               ; same way speedscript does.
000800  2               ;----------------------------------------------------------------
000800  2               ; 16-bit scratch pointers
000800  2               ptr             = $10           ; general pointer (2)
000800  2               ptr2            = $12           ; general pointer (2)
000800  2               vptr            = $14           ; video text pointer (2)
000800  2               cptr            = $16           ; video color pointer (2)
000800  2               srcp            = $18           ; source pointer (2)
000800  2               dstp            = $1A           ; dest pointer (2)
000800  2               strp            = $1C           ; string pointer for prmsg (2)
000800  2               numarg          = $1E           ; 16-bit number for displaynum (2)
000800  2               
000800  2               ; 8-bit scratch
000800  2               tmp0            = $20
000800  2               tmp1            = $21
000800  2               tmp2            = $22
000800  2               tmp3            = $23
000800  2               cnt0            = $24
000800  2               cnt1            = $25
000800  2               colidx          = $26           ; saved column index
000800  2               rowidx          = $27           ; saved row index
000800  2               numspace        = $28           ; displaynum digit accumulator
000800  2               keych           = $29           ; last key read
000800  2               dx              = $2A           ; signed move delta x
000800  2               dy              = $2B           ; signed move delta y
000800  2               tgtx            = $2C           ; target tile x
000800  2               tgty            = $2D           ; target tile y
000800  2               tgttile         = $2E           ; tile code at target
000800  2               monidx          = $2F           ; current monster index
000800  2               seedlo          = $30           ; RNG state low
000800  2               seedhi          = $31           ; RNG state high
000800  2               ; $32 = farfunct (system)
000800  2               seed2lo         = $33           ; RNG state 2 low
000800  2               seed2hi         = $34           ; RNG state 2 high
000800  2               
000800  2               ;----------------------------------------------------------------
000800  2               ; Game state (in TEA RAM, defined as labels in wyrmhold.asm BSS area)
000800  2               ; declared here as equates is not possible; real storage is in the
000800  2               ; .SEGMENT "TEA" at the end of wyrmhold.asm.  See gamevars there.
000800  2               ;----------------------------------------------------------------
000800  2               
000800  1               
000800  1               ;==============================================================================
000800  1               ; Entry point
000800  1               ;==============================================================================
000800  1               BEGIN:
000800  1  D8                   CLD
000801  1  20 96 0C             JSR     psg_init
000804  1  20 56 0C             JSR     rng_seed
000807  1  20 60 11             JSR     chargen_init    ; upload custom terrain/monster tiles
00080A  1                       ; hide the firmware text cursor; we draw our own world
00080A  1  A9 00                LDA     #0
00080C  1  8D 49 06             STA     SHOWCRSR
00080F  1               title_loop_outer:
00080F  1  20 1B 08             JSR     title_screen    ; returns when a key is pressed
000812  1  20 C1 08             JSR     new_game
000815  1  20 E7 08             JSR     game_loop       ; returns on death / victory / quit
000818  1                       ; game_loop decides what to do; if it returns we go to DOS
000818  1  4C 2E 0A             JMP     exit_to_dos
00081B  1               
00081B  1               ;==============================================================================
00081B  1               ; Title screen - draws a banner, plays the melody, waits for a key.
00081B  1               ;==============================================================================
00081B  1               title_screen:
00081B  1  20 FE 2A             JSR     cls_vram
00081E  1                       ; draw the banner art via firmware text
00081E  1  A2 12                LDX     #18
000820  1  A0 04                LDY     #4
000822  1  20 D0 2B             JSR     locate
000825  1  A9 0B                LDA     #C_TITLE
000827  1  8D 4A 06             STA     CURCOLOR
00082A  1  A9 54 A0 0A          PRINTMSG ttl1
00082E  1  20 E2 2B     
000831  1  A2 12                LDX     #18
000833  1  A0 05                LDY     #5
000835  1  20 D0 2B             JSR     locate
000838  1  A9 77 A0 0A          PRINTMSG ttl2
00083C  1  20 E2 2B     
00083F  1  A2 12                LDX     #18
000841  1  A0 06                LDY     #6
000843  1  20 D0 2B             JSR     locate
000846  1  A9 9A A0 0A          PRINTMSG ttl3
00084A  1  20 E2 2B     
00084D  1  A2 12                LDX     #18
00084F  1  A0 07                LDY     #7
000851  1  20 D0 2B             JSR     locate
000854  1  A9 BD A0 0A          PRINTMSG ttl4
000858  1  20 E2 2B     
00085B  1               
00085B  1  A2 18                LDX     #24
00085D  1  A0 0B                LDY     #11
00085F  1  20 D0 2B             JSR     locate
000862  1  A9 0F                LDA     #C_PANEL
000864  1  8D 4A 06             STA     CURCOLOR
000867  1  A9 E0 A0 0A          PRINTMSG ttl_by
00086B  1  20 E2 2B     
00086E  1               
00086E  1  A2 14                LDX     #20
000870  1  A0 0E                LDY     #14
000872  1  20 D0 2B             JSR     locate
000875  1  A9 0B                LDA     #COLOR(CO_BRYELLOW, CO_BLACK)
000877  1  8D 4A 06             STA     CURCOLOR
00087A  1  A9 04 A0 0B          PRINTMSG ttl_prompt
00087E  1  20 E2 2B     
000881  1               
000881  1  A2 0E                LDX     #14
000883  1  A0 12                LDY     #18
000885  1  20 D0 2B             JSR     locate
000888  1  A9 0F                LDA     #C_PANEL
00088A  1  8D 4A 06             STA     CURCOLOR
00088D  1  A9 25 A0 0B          PRINTMSG ttl_keys1
000891  1  20 E2 2B     
000894  1  A2 0E                LDX     #14
000896  1  A0 13                LDY     #19
000898  1  20 D0 2B             JSR     locate
00089B  1  A9 4E A0 0B          PRINTMSG ttl_keys2
00089F  1  20 E2 2B     
0008A2  1               
0008A2  1                       ; Settle period: for the first stretch of the title we PLAY the
0008A2  1                       ; music but ignore (and keep draining) any keys.  This swallows
0008A2  1                       ; the Enter typed to launch the program - on re-runs that key is
0008A2  1                       ; sometimes delivered just after we start, and without this it
0008A2  1                       ; would dismiss the title instantly (the "no intro on 2nd run"
0008A2  1                       ; bug).
0008A2  1  20 0F 0F             JSR     music_start
0008A5  1  A2 28                LDX     #40             ; settle ticks
0008A7  1               @settle:
0008A7  1  DA                   PHX
0008A8  1  20 63 0F             JSR     music_tick
0008AB  1  20 F9 2E             JSR     getkey          ; read & discard whatever shows up
0008AE  1  FA                   PLX
0008AF  1  CA                   DEX
0008B0  1  D0 F5                BNE     @settle
0008B2  1  20 07 2F             JSR     drainkeys       ; clear anything still buffered
0008B5  1               @spin:
0008B5  1  20 63 0F             JSR     music_tick
0008B8  1  20 F9 2E             JSR     getkey
0008BB  1  F0 F8                BEQ     @spin
0008BD  1  20 BE 0C             JSR     psg_silence
0008C0  1  60                   RTS
0008C1  1               
0008C1  1               ;==============================================================================
0008C1  1               ; new_game - initialise all game state and draw the initial screen.
0008C1  1               ;==============================================================================
0008C1  1               new_game:
0008C1  1  20 E1 31             JSR     player_init
0008C4  1  20 1F 13             JSR     decode_world
0008C7  1  A9 00                LDA     #LOC_WORLD
0008C9  1  8D DD 3A             STA     loc
0008CC  1  20 3C 30             JSR     spawn_overworld_monsters
0008CF  1  20 3A 2B             JSR     draw_frame
0008D2  1  20 9B 2D             JSR     msg_clear
0008D5  1  A9 76 A0 0B          PRINTMSG_MSG intro_msg
0008D9  1  20 3C 2D     
0008DC  1  20 E0 08             JSR     full_redraw
0008DF  1  60                   RTS
0008E0  1               
0008E0  1               ;==============================================================================
0008E0  1               ; full_redraw - viewport + panel.
0008E0  1               ;==============================================================================
0008E0  1               full_redraw:
0008E0  1  20 1D 2C             JSR     render_view
0008E3  1  20 AD 2D             JSR     draw_panel
0008E6  1  60                   RTS
0008E7  1               
0008E7  1               ;==============================================================================
0008E7  1               ; game_loop - the main turn loop.
0008E7  1               ;==============================================================================
0008E7  1               game_loop:
0008E7  1               @loop:
0008E7  1                       ; check end conditions first
0008E7  1  AD E2 3A             LDA     bosskilled
0008EA  1  F0 03                BEQ     @alive
0008EC  1  4C A3 09             JMP     victory
0008EF  1               @alive:
0008EF  1  AD D2 3A             LDA     phealth
0008F2  1  D0 03                BNE     @hasfood
0008F4  1  4C E1 09             JMP     game_over_hp
0008F7  1               @hasfood:
0008F7  1  AD D9 3A             LDA     pfood
0008FA  1  0D DA 3A             ORA     pfood+1
0008FD  1  D0 03                BNE     @input
0008FF  1  4C E8 09             JMP     game_over_food
000902  1               
000902  1               @input:
000902  1  20 F9 2E             JSR     getkey
000905  1  F0 E0                BEQ     @loop           ; no key - idle (no time passes)
000907  1  85 29                STA     keych
000909  1               
000909  1                       ; movement keys -> set dx,dy then try_move
000909  1  A9 00                LDA     #0
00090B  1  85 2A                STA     dx
00090D  1  85 2B                STA     dy
00090F  1               
00090F  1  A5 29                LDA     keych
000911  1  C9 77                CMP     #'w'
000913  1  F0 3F                BEQ     @up
000915  1  C9 57                CMP     #'W'
000917  1  F0 3B                BEQ     @up
000919  1  C9 6B                CMP     #'k'
00091B  1  F0 37                BEQ     @up
00091D  1  C9 73                CMP     #'s'
00091F  1  F0 3A                BEQ     @down
000921  1  C9 53                CMP     #'S'
000923  1  F0 36                BEQ     @down
000925  1  C9 6A                CMP     #'j'
000927  1  F0 32                BEQ     @down
000929  1  C9 61                CMP     #'a'
00092B  1  F0 35                BEQ     @left
00092D  1  C9 41                CMP     #'A'
00092F  1  F0 31                BEQ     @left
000931  1  C9 68                CMP     #'h'
000933  1  F0 2D                BEQ     @left
000935  1  C9 64                CMP     #'d'
000937  1  F0 30                BEQ     @right
000939  1  C9 44                CMP     #'D'
00093B  1  F0 2C                BEQ     @right
00093D  1  C9 6C                CMP     #'l'
00093F  1  F0 28                BEQ     @right
000941  1               
000941  1  C9 74                CMP     #'t'
000943  1  F0 39                BEQ     @use
000945  1  C9 54                CMP     #'T'
000947  1  F0 35                BEQ     @use
000949  1  C9 71                CMP     #'q'
00094B  1  F0 3A                BEQ     @quit
00094D  1  C9 51                CMP     #'Q'
00094F  1  F0 36                BEQ     @quit
000951  1  4C E7 08             JMP     @loop           ; unknown key
000954  1               
000954  1               @up:
000954  1  A9 FF                LDA     #$FF            ; dy = -1
000956  1  85 2B                STA     dy
000958  1  4C 6D 09             JMP     @domove
00095B  1               @down:
00095B  1  A9 01                LDA     #1
00095D  1  85 2B                STA     dy
00095F  1  4C 6D 09             JMP     @domove
000962  1               @left:
000962  1  A9 FF                LDA     #$FF
000964  1  85 2A                STA     dx
000966  1  4C 6D 09             JMP     @domove
000969  1               @right:
000969  1  A9 01                LDA     #1
00096B  1  85 2A                STA     dx
00096D  1               @domove:
00096D  1  20 29 32             JSR     try_move
000970  1                       ; if a turn was consumed and we're not in town, monsters act
000970  1  AD E3 3A             LDA     did_move
000973  1  F0 03                BEQ     @after
000975  1  20 2B 31             JSR     mon_act
000978  1               @after:
000978  1  20 E0 08             JSR     full_redraw
00097B  1  4C E7 08             JMP     @loop
00097E  1               
00097E  1               @use:
00097E  1  20 A5 36             JSR     use_action
000981  1  20 E0 08             JSR     full_redraw
000984  1  4C E7 08             JMP     @loop
000987  1               
000987  1               @quit:
000987  1  20 90 09             JSR     confirm_quit
00098A  1  F0 03                BEQ     @doquit         ; Z=1 means Yes
00098C  1  4C E7 08             JMP     @loop
00098F  1               @doquit:
00098F  1  60                   RTS
000990  1               
000990  1               ;==============================================================================
000990  1               ; confirm_quit - ask Y/N. Returns Z=1 if quitting.
000990  1               ;==============================================================================
000990  1               confirm_quit:
000990  1  20 9B 2D             JSR     msg_clear
000993  1  A9 A5 A0 0B          PRINTMSG_MSG q_quit
000997  1  20 3C 2D     
00099A  1  20 D1 2E             JSR     yorn            ; Z=1 if yes
00099D  1  08                   PHP
00099E  1  20 9B 2D             JSR     msg_clear
0009A1  1  28                   PLP
0009A2  1  60                   RTS
0009A3  1               
