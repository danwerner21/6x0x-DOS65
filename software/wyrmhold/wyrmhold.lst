0059EC  2  20 DB 3B             JSR     locate
0059EF  2  A9 1A                LDA     #C_SHOPST
0059F1  2  8D 4A 06             STA     CURCOLOR
0059F4  2  AD 31 62             LDA     shopstat
0059F7  2  AC 32 62             LDY     shopstat+1
0059FA  2  20 ED 3B             JSR     prmsg
0059FD  2  60                   RTS
