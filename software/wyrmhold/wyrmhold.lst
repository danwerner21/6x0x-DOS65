000800  2               CASTLE_RULER_X  = 15
000800  2               CASTLE_RULER_Y  = 4
000800  2               
000800  2               ; overworld and interior positions for the Wyrm Key quest
000800  2               KEY_SITE_X      = 20
000800  2               KEY_SITE_Y      = 58
000800  2               WARDEN_X        = 27
000800  2               WARDEN_Y        = 17
000800  2               DRAGON_X        = 27
000800  2               DRAGON_Y        = 18
000800  2               
000800  2               ; misc constants
000800  2               space           = 32
000800  2               ESC             = 27
000800  2               CR              = 13
000800  2               
000800  2               ;----------------------------------------------------------------
000800  2               ; Zero-page allocation.  $00-$31 are largely free for the TEA;
000800  2               ; $32 (farfunct) is reserved by the system.  We use a contiguous
000800  2               ; block below it and a high block ($F0-$FE scratch pointers) the
000800  2               ; same way speedscript does.
000800  2               ;----------------------------------------------------------------
000800  2               ; 16-bit scratch pointers
000800  2               ptr             = $10           ; general pointer (2)
000800  2               ptr2            = $12           ; general pointer (2)
000800  2               vptr            = $14           ; video text pointer (2)
000800  2               cptr            = $16           ; video color pointer (2)
000800  2               srcp            = $18           ; source pointer (2)
000800  2               dstp            = $1A           ; dest pointer (2)
000800  2               strp            = $1C           ; string pointer for prmsg (2)
000800  2               numarg          = $1E           ; 16-bit number for displaynum (2)
000800  2               
000800  2               ; 8-bit scratch
000800  2               tmp0            = $20
000800  2               tmp1            = $21
000800  2               tmp2            = $22
000800  2               tmp3            = $23
000800  2               cnt0            = $24
000800  2               cnt1            = $25
000800  2               colidx          = $26           ; saved column index
000800  2               rowidx          = $27           ; saved row index
000800  2               numspace        = $28           ; displaynum digit accumulator
000800  2               keych           = $29           ; last key read
000800  2               dx              = $2A           ; signed move delta x
000800  2               dy              = $2B           ; signed move delta y
000800  2               tgtx            = $2C           ; target tile x
000800  2               tgty            = $2D           ; target tile y
000800  2               tgttile         = $2E           ; tile code at target
000800  2               monidx          = $2F           ; current monster index
000800  2               seedlo          = $30           ; RNG state low
000800  2               seedhi          = $31           ; RNG state high
000800  2               ; $32 = farfunct (system)
000800  2               seed2lo         = $33           ; title timing counter low
000800  2               seed2hi         = $34           ; title timing counter high
000800  2               
000800  2               ;----------------------------------------------------------------
000800  2               ; Game state (in TEA RAM, defined as labels in wyrmhold.asm BSS area)
000800  2               ; declared here as equates is not possible; real storage is in the
000800  2               ; .SEGMENT "TEA" at the end of wyrmhold.asm.  See gamevars there.
000800  2               ;----------------------------------------------------------------
000800  2               
000800  1               
000800  1               ;==============================================================================
000800  1               ; Entry point
000800  1               ;==============================================================================
000800  1               BEGIN:
000800  1  D8                   CLD
000801  1  20 FF 0C             JSR     psg_init
000804  1  20 8D 0C             JSR     rng_seed
000807  1               ; All direct-VRAM rendering below assumes 80-byte screen rows.
000807  1               ; Establish that mode before uploading glyphs or drawing anything.
000807  1  A9 39                LDA     #FC_SETMODE
000809  1  85 32                STA     farfunct
00080B  1  A9 01                LDA     #1              ; 80-column text mode
00080D  1  20 F0 FF             JSR     DO_FARCALL
000810  1  20 B2 12             JSR     chargen_init    ; upload custom terrain/monster tiles
000813  1               ; hide the firmware text cursor; we draw our own world
000813  1  A9 00                LDA     #0
000815  1  8D 49 06             STA     SHOWCRSR
000818  1               title_loop_outer:
000818  1  20 24 08             JSR     title_screen    ; returns when a key is pressed
00081B  1  20 51 08             JSR     new_game
00081E  1  20 77 08             JSR     game_loop       ; returns on death / victory / quit
000821  1               ; game_loop decides what to do; if it returns we go to DOS
000821  1  4C 39 0A             JMP     exit_to_dos
000824  1               
000824  1               ;==============================================================================
000824  1               ; Title screen - draws a banner, plays the melody, waits for a key.
000824  1               ;==============================================================================
000824  1               title_screen:
000824  1  20 F9 17             JSR     draw_title_scene; full graphical title (title.asm)
000827  1               
000827  1               ; Settle period: for the first stretch of the title we PLAY the
000827  1               ; music but ignore (and keep draining) any keys.  This swallows
000827  1               ; the Enter typed to launch the program - on re-runs that key is
000827  1               ; sometimes delivered just after we start, and without this it
000827  1               ; would dismiss the title instantly (the "no intro on 2nd run"
000827  1               ; bug).
000827  1  20 54 10             JSR     music_start
00082A  1  A2 28                LDX     #40             ; settle ticks
00082C  1               @settle:
00082C  1  DA                   PHX
00082D  1  20 A8 10             JSR     music_tick
000830  1  20 9C 0C             JSR     rng_timing_tick
000833  1  20 85 41             JSR     getkey          ; read & discard whatever shows up
000836  1  FA                   PLX
000837  1  CA                   DEX
000838  1  D0 F2                BNE     @settle
00083A  1  20 93 41             JSR     drainkeys       ; clear anything still buffered
00083D  1               @spin:
00083D  1  20 A8 10             JSR     music_tick
000840  1  20 9C 0C             JSR     rng_timing_tick
000843  1  20 85 41             JSR     getkey
000846  1  F0 F5                BEQ     @spin
000848  1  85 29                STA     keych
00084A  1  20 A3 0C             JSR     rng_mix_timing
00084D  1  20 27 0D             JSR     psg_silence
000850  1  60                   RTS
000851  1               
000851  1               ;==============================================================================
000851  1               ; new_game - initialise all game state and draw the initial screen.
000851  1               ;==============================================================================
000851  1               new_game:
000851  1  20 1A 4A             JSR     player_init
000854  1  20 06 1B             JSR     decode_world
000857  1  A9 00                LDA     #LOC_WORLD
000859  1  8D 19 62             STA     loc
00085C  1  20 93 45             JSR     spawn_overworld_monsters
00085F  1  20 45 3B             JSR     draw_frame
000862  1  20 58 3E             JSR     msg_clear
000865  1  A9 98 A0 0B          PRINTMSG_MSG intro_msg
000869  1  20 F9 3D     
00086C  1  20 70 08             JSR     full_redraw
00086F  1  60                   RTS
000870  1               
000870  1               ;==============================================================================
000870  1               ; full_redraw - viewport + panel.
000870  1               ;==============================================================================
000870  1               full_redraw:
000870  1  20 28 3C             JSR     render_view
000873  1  20 6A 3E             JSR     draw_panel
000876  1  60                   RTS
000877  1               
000877  1               ;==============================================================================
000877  1               ; game_loop - the main turn loop.
000877  1               ;==============================================================================
000877  1               game_loop:
000877  1               @loop:
000877  1               ; check end conditions first
000877  1  AD 20 62             LDA     bosskilled
00087A  1  F0 03                BEQ     @alive
00087C  1  4C AE 09             JMP     victory
00087F  1               @alive:
00087F  1  AD 0E 62             LDA     phealth
000882  1  D0 03                BNE     @hasfood
000884  1  4C EC 09             JMP     game_over_hp
000887  1               @hasfood:
000887  1  AD 15 62             LDA     pfood
00088A  1  0D 16 62             ORA     pfood+1
00088D  1  D0 03                BNE     @input
00088F  1  4C F3 09             JMP     game_over_food
000892  1               
000892  1               @input:
000892  1  20 85 41             JSR     getkey
000895  1  F0 E0                BEQ     @loop           ; no key - idle (no time passes)
000897  1  85 29                STA     keych
000899  1               
000899  1               ; movement keys -> set dx,dy then try_move
000899  1  A9 00                LDA     #0
00089B  1  85 2A                STA     dx
00089D  1  85 2B                STA     dy
00089F  1               
00089F  1  A5 29                LDA     keych
0008A1  1  C9 77                CMP     #'w'
0008A3  1  D0 03                BNE     :+
0008A5  1  4C 29 09             JMP     @up
0008A8  1               :
0008A8  1  C9 57                CMP     #'W'
0008AA  1  D0 03                BNE     :+
0008AC  1  4C 29 09             JMP     @up
0008AF  1               :
0008AF  1  C9 6B                CMP     #'k'
0008B1  1  D0 03                BNE     :+
0008B3  1  4C 29 09             JMP     @up
0008B6  1               :
0008B6  1  C9 73                CMP     #'s'
0008B8  1  D0 03                BNE     :+
0008BA  1  4C 30 09             JMP     @down
0008BD  1               :
0008BD  1  C9 53                CMP     #'S'
0008BF  1  D0 03                BNE     :+
0008C1  1  4C 30 09             JMP     @down
0008C4  1               :
0008C4  1  C9 6A                CMP     #'j'
0008C6  1  D0 03                BNE     :+
0008C8  1  4C 30 09             JMP     @down
0008CB  1               :
0008CB  1  C9 61                CMP     #'a'
0008CD  1  D0 03                BNE     :+
0008CF  1  4C 37 09             JMP     @left
0008D2  1               :
0008D2  1  C9 41                CMP     #'A'
0008D4  1  D0 03                BNE     :+
0008D6  1  4C 37 09             JMP     @left
0008D9  1               :
0008D9  1  C9 68                CMP     #'h'
0008DB  1  D0 03                BNE     :+
0008DD  1  4C 37 09             JMP     @left
0008E0  1               :
0008E0  1  C9 64                CMP     #'d'
0008E2  1  D0 03                BNE     :+
0008E4  1  4C 3E 09             JMP     @right
0008E7  1               :
0008E7  1  C9 44                CMP     #'D'
0008E9  1  D0 03                BNE     :+
0008EB  1  4C 3E 09             JMP     @right
0008EE  1               :
0008EE  1  C9 6C                CMP     #'l'
0008F0  1  D0 03                BNE     :+
0008F2  1  4C 3E 09             JMP     @right
0008F5  1               :
0008F5  1               
0008F5  1  C9 67                CMP     #'g'
0008F7  1  D0 03                BNE     :+
0008F9  1  4C 48 09             JMP     @guard
0008FC  1               :
0008FC  1  C9 47                CMP     #'G'
0008FE  1  D0 03                BNE     :+
000900  1  4C 48 09             JMP     @guard
000903  1               :
000903  1  C9 74                CMP     #'t'
000905  1  D0 03                BNE     :+
000907  1  4C 6D 09             JMP     @use
00090A  1               :
00090A  1  C9 54                CMP     #'T'
00090C  1  D0 03                BNE     :+
00090E  1  4C 6D 09             JMP     @use
000911  1               :
000911  1  C9 3F                CMP     #'?'
000913  1  D0 03                BNE     :+
000915  1  4C 86 09             JMP     @help
000918  1               :
000918  1  C9 71                CMP     #'q'
00091A  1  D0 03                BNE     :+
00091C  1  4C 92 09             JMP     @quit
00091F  1               :
00091F  1  C9 51                CMP     #'Q'
000921  1  D0 03                BNE     :+
000923  1  4C 92 09             JMP     @quit
000926  1               :
000926  1  4C 77 08             JMP     @loop           ; unknown key
000929  1               
000929  1               @up:
000929  1  A9 FF                LDA     #$FF            ; dy = -1
00092B  1  85 2B                STA     dy
00092D  1  4C 42 09             JMP     @domove
000930  1               @down:
000930  1  A9 01                LDA     #1
000932  1  85 2B                STA     dy
000934  1  4C 42 09             JMP     @domove
000937  1               @left:
000937  1  A9 FF                LDA     #$FF
000939  1  85 2A                STA     dx
00093B  1  4C 42 09             JMP     @domove
00093E  1               @right:
00093E  1  A9 01                LDA     #1
000940  1  85 2A                STA     dx
000942  1               @domove:
000942  1  20 7A 4A             JSR     try_move
000945  1  4C 57 09             JMP     @doturn
000948  1               @guard:
000948  1  A9 01                LDA     #1
00094A  1  8D 25 62             STA     guard_active
00094D  1  8D 27 62             STA     did_move
000950  1  A9 87 A0 55          PRINTMSG_MSG m_guard
000954  1  20 F9 3D     
000957  1               @doturn:
000957  1               ; if a turn was consumed, monsters and status effects act
000957  1  AD 27 62             LDA     did_move
00095A  1  F0 06                BEQ     @after
00095C  1  20 06 47             JSR     mon_act
00095F  1  20 92 51             JSR     process_status
000962  1               @after:
000962  1  A9 00                LDA     #0
000964  1  8D 25 62             STA     guard_active
000967  1  20 70 08             JSR     full_redraw
00096A  1  4C 77 08             JMP     @loop
00096D  1               
00096D  1               @use:
00096D  1  A9 00                LDA     #0
00096F  1  8D 27 62             STA     did_move
000972  1  20 23 57             JSR     use_action
000975  1  AD 27 62             LDA     did_move
000978  1  F0 06                BEQ     @use_redraw
00097A  1  20 06 47             JSR     mon_act
00097D  1  20 92 51             JSR     process_status
000980  1               @use_redraw:
000980  1  20 70 08             JSR     full_redraw
000983  1  4C 77 08             JMP     @loop
000986  1               
000986  1               @help:
000986  1  20 83 40             JSR     help_menu
000989  1  20 70 08             JSR     full_redraw
00098C  1  20 28 3E             JSR     msg_redraw
00098F  1  4C 77 08             JMP     @loop
000992  1               
000992  1               @quit:
000992  1  20 9B 09             JSR     confirm_quit
000995  1  F0 03                BEQ     @doquit         ; Z=1 means Yes
000997  1  4C 77 08             JMP     @loop
00099A  1               @doquit:
00099A  1  60                   RTS
00099B  1               
00099B  1               ;==============================================================================
00099B  1               ; confirm_quit - ask Y/N. Returns Z=1 if quitting.
00099B  1               ;==============================================================================
00099B  1               confirm_quit:
00099B  1  20 58 3E             JSR     msg_clear
00099E  1  A9 D7 A0 0B          PRINTMSG_MSG q_quit
0009A2  1  20 F9 3D     
0009A5  1  20 5D 41             JSR     yorn            ; Z=1 if yes
0009A8  1  08                   PHP
0009A9  1  20 58 3E             JSR     msg_clear
0009AC  1  28                   PLP
0009AD  1  60                   RTS
0009AE  1               
0009AE  1               ;==============================================================================
0009AE  1               ; End-game screens
0009AE  1               ;==============================================================================
0009AE  1               victory:
0009AE  1  20 09 3B             JSR     cls_vram
0009B1  1  A2 14                LDX     #20
0009B3  1  A0 08                LDY     #8
0009B5  1  20 DB 3B             JSR     locate
0009B8  1  A9 0E                LDA     #C_TITLE
0009BA  1  8D 4A 06             STA     CURCOLOR
0009BD  1  A9 EA A0 0B          PRINTMSG win1
0009C1  1  20 ED 3B     
0009C4  1  A2 10                LDX     #16
0009C6  1  A0 0A                LDY     #10
0009C8  1  20 DB 3B             JSR     locate
0009CB  1  A9 0F                LDA     #C_PANEL
0009CD  1  8D 4A 06             STA     CURCOLOR
0009D0  1  A9 FB A0 0B          PRINTMSG win2
0009D4  1  20 ED 3B     
0009D7  1  A2 12                LDX     #18
0009D9  1  A0 0E                LDY     #14
0009DB  1  20 DB 3B             JSR     locate
0009DE  1  A9 7C A0 0C          PRINTMSG anykey
0009E2  1  20 ED 3B     
0009E5  1  20 0D 10             JSR     sfx_win
0009E8  1  20 79 41             JSR     getkey_block
0009EB  1  60                   RTS
0009EC  1               
0009EC  1               game_over_hp:
0009EC  1  A9 41                LDA     #<go_hp
0009EE  1  A0 0C                LDY     #>go_hp
0009F0  1  4C F7 09             JMP     game_over_common
0009F3  1               game_over_food:
0009F3  1  A9 5C                LDA     #<go_food
0009F5  1  A0 0C                LDY     #>go_food
0009F7  1               ; fall through
0009F7  1               game_over_common:
0009F7  1               ; stash the cause-string pointer somewhere that survives both
0009F7  1               ; cls_vram and prmsg. NOT strp (prmsg uses it as scratch) and NOT
0009F7  1               ; tmp0 (rowbase, called by cls_vram, clobbers it) - parking it in
0009F7  1               ; either reprinted the "THOU HAST FALLEN" banner a second time
0009F7  1               ; instead of the cause line. numarg is untouched on this path.
0009F7  1  85 1E                STA     numarg
0009F9  1  84 1F                STY     numarg+1
0009FB  1  20 09 3B             JSR     cls_vram
0009FE  1  A2 16                LDX     #22
000A00  1  A0 08                LDY     #8
000A02  1  20 DB 3B             JSR     locate
000A05  1  A9 0C                LDA     #COLOR(CO_BRRED, CO_BLACK)
000A07  1  8D 4A 06             STA     CURCOLOR
000A0A  1  A9 28 A0 0C          PRINTMSG over1
000A0E  1  20 ED 3B     
000A11  1  A2 10                LDX     #16
000A13  1  A0 0A                LDY     #10
000A15  1  20 DB 3B             JSR     locate
000A18  1  A9 0F                LDA     #C_PANEL
000A1A  1  8D 4A 06             STA     CURCOLOR
000A1D  1  A5 1E                LDA     numarg
000A1F  1  A4 1F                LDY     numarg+1
000A21  1  20 ED 3B             JSR     prmsg
000A24  1  A2 12                LDX     #18
000A26  1  A0 0E                LDY     #14
000A28  1  20 DB 3B             JSR     locate
000A2B  1  A9 7C A0 0C          PRINTMSG anykey
000A2F  1  20 ED 3B     
000A32  1  20 D6 0F             JSR     sfx_lose
000A35  1  20 79 41             JSR     getkey_block
000A38  1  60                   RTS
000A39  1               
000A39  1               ;==============================================================================
000A39  1               ; exit_to_dos
000A39  1               ;==============================================================================
000A39  1               exit_to_dos:
000A39  1  20 27 0D             JSR     psg_silence
000A3C  1               ; restore a normal console: 80-col, default colors, cursor on
000A3C  1  A9 39                LDA     #FC_SETMODE
000A3E  1  85 32                STA     farfunct
000A40  1  A9 01                LDA     #1
000A42  1  20 F0 FF             JSR     DO_FARCALL
000A45  1  A2 08                LDX     #C_BLANK
000A47  1  A0 E1                LDY     #CSRCOLOR_DEF
000A49  1  A9 27 85 32          FARCALL FC_COLOR
000A4D  1  20 F0 FF     
000A50  1  A9 26 85 32          FARCALL FC_SCNCLR
000A54  1  20 F0 FF     
000A57  1  A9 01                LDA     #1
000A59  1  8D 49 06             STA     SHOWCRSR
000A5C  1  4C 00 01             JMP     BOOT            ; back to DOS/65
000A5F  1               
000A5F  1               CSRCOLOR_DEF    = $E1
000A5F  1               
