000B7A  1  54 48 4F 55  
000B7E  1  20 48 41 53  
000B8F  1               go_hp:
000B8F  1  54 68 79 20          .BYTE   "Thy wounds were too grave.",0
000B93  1  77 6F 75 6E  
000B97  1  64 73 20 77  
000BAA  1               go_food:
000BAA  1  54 68 6F 75          .BYTE   "Thou hast starved in the wilds.",0
000BAE  1  20 68 61 73  
000BB2  1  74 20 73 74  
