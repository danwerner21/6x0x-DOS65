0047FE  1                       .INCLUDE "town.asm"
0047FE  2               ;______________________________________________________________________________
0047FE  2               ;  town.asm - shop interaction inside towns
0047FE  2               ;
0047FE  2               ;  When the player presses USE ('T') in a town while adjacent to a
0047FE  2               ;  shop counter ('S' tile), the shop menu opens.  The menu is drawn
0047FE  2               ;  over the message rows; the player picks an option, gold is spent,
0047FE  2               ;  and the menu returns to the map.
0047FE  2               ;______________________________________________________________________________
0047FE  2               
0047FE  2               PRICE_HEAL      = 10            ; gold per visit (full heal)
0047FE  2               PRICE_FOOD      = 20            ; gold for +100 food
0047FE  2               PRICE_WEAPON    = 60            ; gold to upgrade weapon one tier
0047FE  2               PRICE_ARMOR     = 50            ; gold to upgrade armor one tier
0047FE  2               
0047FE  2               ;----------------------------------------------------------------
0047FE  2               ; use_action - bound to the USE key ('T'). Dispatch contextual
0047FE  2               ; interactions for the active location.
0047FE  2               ;----------------------------------------------------------------
0047FE  2               use_action:
0047FE  2  AD 77 51             LDA     loc
004801  2  C9 03                CMP     #LOC_CASTLE
004803  2  F0 0C                BEQ     @incastle
004805  2  C9 01                CMP     #LOC_TOWN
004807  2  F0 0B                BEQ     @intown
004809  2  A9 20 A0 4B          PRINTMSG_MSG t_nothing
00480D  2  20 F4 39     
004810  2  60                   RTS
004811  2               @incastle:
004811  2  4C 30 4C             JMP     castle_use
004814  2               @intown:
004814  2               ; is a shop tile adjacent (4-neighbour) or under us?
004814  2  20 24 48             JSR     shop_adjacent
004817  2  B0 08                BCS     @open
004819  2  A9 31 A0 4B          PRINTMSG_MSG t_noshop
00481D  2  20 F4 39     
004820  2  60                   RTS
004821  2               @open:
004821  2  4C 8E 48             JMP     shop_menu
004824  2               
004824  2               ;----------------------------------------------------------------
004824  2               ; shop_adjacent - C=1 if a T_SHOP tile is at or next to the player.
004824  2               ;----------------------------------------------------------------
004824  2               shop_adjacent:
004824  2               ; center
004824  2  AD 6A 51             LDA     px
004827  2  85 2C                STA     tgtx
004829  2  AD 6B 51             LDA     py
00482C  2  85 2D                STA     tgty
00482E  2  20 53 1A             JSR     tileat
004831  2  A5 2E                LDA     tgttile
004833  2  C9 0E                CMP     #T_SHOP
004835  2  F0 55                BEQ     @yes
004837  2               ; up
004837  2  AD 6A 51             LDA     px
00483A  2  85 2C                STA     tgtx
00483C  2  AD 6B 51             LDA     py
00483F  2  38                   SEC
004840  2  E9 01                SBC     #1
004842  2  85 2D                STA     tgty
004844  2  20 53 1A             JSR     tileat
004847  2  A5 2E                LDA     tgttile
004849  2  C9 0E                CMP     #T_SHOP
00484B  2  F0 3F                BEQ     @yes
00484D  2               ; down
00484D  2  AD 6B 51             LDA     py
004850  2  18                   CLC
004851  2  69 01                ADC     #1
004853  2  85 2D                STA     tgty
004855  2  AD 6A 51             LDA     px
004858  2  85 2C                STA     tgtx
00485A  2  20 53 1A             JSR     tileat
00485D  2  A5 2E                LDA     tgttile
00485F  2  C9 0E                CMP     #T_SHOP
004861  2  F0 29                BEQ     @yes
004863  2               ; left
004863  2  AD 6B 51             LDA     py
004866  2  85 2D                STA     tgty
004868  2  AD 6A 51             LDA     px
00486B  2  38                   SEC
00486C  2  E9 01                SBC     #1
00486E  2  85 2C                STA     tgtx
004870  2  20 53 1A             JSR     tileat
004873  2  A5 2E                LDA     tgttile
004875  2  C9 0E                CMP     #T_SHOP
004877  2  F0 13                BEQ     @yes
004879  2               ; right
004879  2  AD 6A 51             LDA     px
00487C  2  18                   CLC
00487D  2  69 01                ADC     #1
00487F  2  85 2C                STA     tgtx
004881  2  20 53 1A             JSR     tileat
004884  2  A5 2E                LDA     tgttile
004886  2  C9 0E                CMP     #T_SHOP
004888  2  F0 02                BEQ     @yes
00488A  2  18                   CLC
00488B  2  60                   RTS
00488C  2               @yes:
00488C  2  38                   SEC
00488D  2  60                   RTS
00488E  2               
00488E  2               ;----------------------------------------------------------------
00488E  2               ; shop_menu - draw the shop menu over the message area and loop
00488E  2               ; processing purchases until the player presses X.
00488E  2               ;----------------------------------------------------------------
00488E  2               shop_menu:
00488E  2  20 61 0E             JSR     sfx_door
004891  2               ; start with the greeting as the status line
004891  2  A9 02                LDA     #<t_greet
004893  2  8D 89 51             STA     shopstat
004896  2  A9 4B                LDA     #>t_greet
004898  2  8D 8A 51             STA     shopstat+1
00489B  2               @redraw:
00489B  2  20 95 49             JSR     shop_draw
00489E  2               @key:
00489E  2  20 E4 3B             JSR     getkey_block
0048A1  2  C9 31                CMP     #'1'
0048A3  2  F0 1A                BEQ     @heal
0048A5  2  C9 32                CMP     #'2'
0048A7  2  F0 33                BEQ     @food
0048A9  2  C9 33                CMP     #'3'
0048AB  2  F0 54                BEQ     @weapon
0048AD  2  C9 34                CMP     #'4'
0048AF  2  F0 7B                BEQ     @armor
0048B1  2  C9 58                CMP     #'X'
0048B3  2  F0 07                BEQ     @goleave
0048B5  2  C9 78                CMP     #'x'
0048B7  2  F0 03                BEQ     @goleave
0048B9  2  4C 9E 48             JMP     @key
0048BC  2               @goleave:
0048BC  2  4C 64 49             JMP     @leave
0048BF  2               @heal:
0048BF  2  A9 0A                LDA     #PRICE_HEAL
0048C1  2  20 72 49             JSR     spend_gold
0048C4  2  B0 03                BCS     :+
0048C6  2  4C 57 49             JMP     @poor
0048C9  2               :
0048C9  2  AD 6D 51             LDA     pmaxhp
0048CC  2  8D 6C 51             STA     phealth
0048CF  2  A9 5E 8D 89          SETSTAT t_healed
0048D3  2  51 A9 4B 8D  
0048D7  2  8A 51        
0048D9  2  4C 9B 48             JMP     @redraw
0048DC  2               @food:
0048DC  2  A9 14                LDA     #PRICE_FOOD
0048DE  2  20 72 49             JSR     spend_gold
0048E1  2  90 74                BCC     @poor
0048E3  2  18                   CLC
0048E4  2  AD 73 51             LDA     pfood
0048E7  2  69 64                ADC     #100
0048E9  2  8D 73 51             STA     pfood
0048EC  2  AD 74 51             LDA     pfood+1
0048EF  2  69 00                ADC     #0
0048F1  2  8D 74 51             STA     pfood+1
0048F4  2  A9 7D 8D 89          SETSTAT t_fed
0048F8  2  51 A9 4B 8D  
0048FC  2  8A 51        
0048FE  2  4C 9B 48             JMP     @redraw
004901  2               @weapon:
004901  2  AD 75 51             LDA     pweapon
004904  2  C9 03                CMP     #3
004906  2  B0 17                BCS     @maxwpn
004908  2  A9 3C                LDA     #PRICE_WEAPON
00490A  2  20 72 49             JSR     spend_gold
00490D  2  90 48                BCC     @poor
00490F  2  EE 75 51             INC     pweapon
004912  2  A9 9C 8D 89          SETSTAT t_boughtw
004916  2  51 A9 4B 8D  
00491A  2  8A 51        
00491C  2  4C 9B 48             JMP     @redraw
00491F  2               @maxwpn:
00491F  2  A9 DA 8D 89          SETSTAT t_maxed
004923  2  51 A9 4B 8D  
004927  2  8A 51        
004929  2  4C 9B 48             JMP     @redraw
00492C  2               @armor:
00492C  2  AD 76 51             LDA     parmor
00492F  2  C9 03                CMP     #3
004931  2  B0 17                BCS     @maxarm
004933  2  A9 32                LDA     #PRICE_ARMOR
004935  2  20 72 49             JSR     spend_gold
004938  2  90 1D                BCC     @poor
00493A  2  EE 76 51             INC     parmor
00493D  2  A9 BB 8D 89          SETSTAT t_boughta
004941  2  51 A9 4B 8D  
004945  2  8A 51        
004947  2  4C 9B 48             JMP     @redraw
00494A  2               @maxarm:
00494A  2  A9 DA 8D 89          SETSTAT t_maxed
00494E  2  51 A9 4B 8D  
004952  2  8A 51        
