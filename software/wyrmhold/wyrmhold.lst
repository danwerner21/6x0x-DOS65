0009A8  1  A0 08                LDY     #8
0009AA  1  20 D0 2B             JSR     locate
0009AD  1  A9 0B                LDA     #C_TITLE
0009AF  1  8D 4A 06             STA     CURCOLOR
0009B2  1  A9 B8 A0 0B          PRINTMSG win1
0009B6  1  20 E2 2B     
0009B9  1  A2 10                LDX     #16
0009BB  1  A0 0A                LDY     #10
0009BD  1  20 D0 2B             JSR     locate
0009C0  1  A9 0F                LDA     #C_PANEL
0009C2  1  8D 4A 06             STA     CURCOLOR
0009C5  1  A9 C9 A0 0B          PRINTMSG win2
0009C9  1  20 E2 2B     
0009CC  1  A2 12                LDX     #18
0009CE  1  A0 0E                LDY     #14
0009D0  1  20 D0 2B             JSR     locate
0009D3  1  A9 45 A0 0C          PRINTMSG anykey
0009D7  1  20 E2 2B     
0009DA  1  20 C8 0E             JSR     sfx_win
0009DD  1  20 ED 2E             JSR     getkey_block
0009E0  1  60                   RTS
0009E1  1               
0009E1  1               game_over_hp:
0009E1  1  A9 0A                LDA     #<go_hp
0009E3  1  A0 0C                LDY     #>go_hp
0009E5  1  4C EC 09             JMP     game_over_common
0009E8  1               game_over_food:
0009E8  1  A9 25                LDA     #<go_food
0009EA  1  A0 0C                LDY     #>go_food
0009EC  1                       ; fall through
0009EC  1               game_over_common:
0009EC  1  85 1C                STA     strp
0009EE  1  84 1D                STY     strp+1
0009F0  1  20 FE 2A             JSR     cls_vram
0009F3  1  A2 16                LDX     #22
0009F5  1  A0 08                LDY     #8
0009F7  1  20 D0 2B             JSR     locate
0009FA  1  A9 09                LDA     #COLOR(CO_BRRED, CO_BLACK)
0009FC  1  8D 4A 06             STA     CURCOLOR
0009FF  1  A9 F1 A0 0B          PRINTMSG over1
000A03  1  20 E2 2B     
000A06  1  A2 10                LDX     #16
000A08  1  A0 0A                LDY     #10
000A0A  1  20 D0 2B             JSR     locate
000A0D  1  A9 0F                LDA     #C_PANEL
000A0F  1  8D 4A 06             STA     CURCOLOR
000A12  1  A5 1C                LDA     strp
000A14  1  A4 1D                LDY     strp+1
000A16  1  20 E2 2B             JSR     prmsg
000A19  1  A2 12                LDX     #18
000A1B  1  A0 0E                LDY     #14
000A1D  1  20 D0 2B             JSR     locate
000A20  1  A9 45 A0 0C          PRINTMSG anykey
000A24  1  20 E2 2B     
000A27  1  20 91 0E             JSR     sfx_lose
000A2A  1  20 ED 2E             JSR     getkey_block
000A2D  1  60                   RTS
