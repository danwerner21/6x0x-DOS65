000A23  1  20 20 61 20  
000A27  1  71 75 65 73  
000A42  1               ttl4:
000A42  1  2B 2D 2D 2D          .BYTE   "+--------------------------------+",0
000A46  1  2D 2D 2D 2D  
000A4A  1  2D 2D 2D 2D  
000A65  1               ttl_by:
000A65  1  44 65 66 65          .BYTE   "Defeat the Dragon to save the realm",0
000A69  1  61 74 20 74  
000A6D  1  68 65 20 44  
000A89  1               ttl_prompt:
000A89  1  50 72 65 73          .BYTE   "Press any key to begin thy quest",0
000A8D  1  73 20 61 6E  
000A91  1  79 20 6B 65  
000AAA  1               ttl_keys1:
000AAA  1  4D 6F 76 65          .BYTE   "Move: W A S D (or H J K L)   T: use/shop",0
000AAE  1  3A 20 57 20  
000AB2  1  41 20 53 20  
000AD3  1               ttl_keys2:
000AD3  1  42 75 6D 70          .BYTE   "Bump monsters to fight.  Q: quit to DOS",0
000AD7  1  20 6D 6F 6E  
000ADB  1  73 74 65 72  
000AFB  1               
000AFB  1               intro_msg:
000AFB  1  57 65 6C 63          .BYTE   "Welcome to Wyrmhold. Seek and slay the dragon!",0
000AFF  1  6F 6D 65 20  
000B03  1  74 6F 20 57  
000B2A  1               q_quit:
000B2A  1  51 75 69 74          .BYTE   "Quit to DOS? (Y/N)",0
000B2E  1  20 74 6F 20  
000B32  1  44 4F 53 3F  
000B3D  1               
000B3D  1               win1:
000B3D  1  2A 2A 2A 20          .BYTE   "*** VICTORY! ***",0
000B41  1  56 49 43 54  
000B45  1  4F 52 59 21  
000B4E  1               win2:
000B4E  1  54 68 65 20          .BYTE   "The dragon is slain. The land is saved!",0
000B52  1  64 72 61 67  
000B56  1  6F 6E 20 69  
000B76  1               over1:
