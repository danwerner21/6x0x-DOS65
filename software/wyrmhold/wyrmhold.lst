0011B5  2  04                   .BYTE   G_WATER
0011B6  2  66                   .BYTE   %01100110
0011B7  2  99                   .BYTE   %10011001
0011B8  2  00                   .BYTE   %00000000
0011B9  2  33                   .BYTE   %00110011
0011BA  2  CC                   .BYTE   %11001100
0011BB  2  00                   .BYTE   %00000000
