004C30  2               
004C30  2               ;----------------------------------------------------------------
004C30  2               ; castle_use - contextual USE action inside the audience chamber.
004C30  2               ;----------------------------------------------------------------
004C30  2               castle_use:
004C30  2  20 C8 4C             JSR     ruler_adjacent
004C33  2  B0 08                BCS     @ruler
004C35  2  A9 26 A0 4D          PRINTMSG_MSG c_approach
004C39  2  20 F4 39     
004C3C  2  60                   RTS
004C3D  2               @ruler:
004C3D  2  AD 7D 51             LDA     queststate
004C40  2  C9 00                CMP     #QUEST_NONE
004C42  2  F0 14                BEQ     @commission
004C44  2  C9 01                CMP     #QUEST_FIND_KEY
004C46  2  F0 27                BEQ     @reminder
004C48  2  C9 02                CMP     #QUEST_HAVE_KEY
004C4A  2  F0 32                BEQ     @unlock
004C4C  2  C9 04                CMP     #QUEST_DRAGON_DEAD
004C4E  2  F0 5C                BEQ     @finale
004C50  2               ; QUEST_DUNG_OPEN while the dragon still lives
004C50  2  A9 AE A0 4E          PRINTMSG_MSG c_open
004C54  2  20 F4 39     
004C57  2  60                   RTS
004C58  2               @commission:
004C58  2  A9 01                LDA     #QUEST_FIND_KEY
004C5A  2  8D 7D 51             STA     queststate
004C5D  2  20 2A 0E             JSR     sfx_levelup
004C60  2  A9 51 A0 4D          PRINTMSG_MSG c_commission1
004C64  2  20 F4 39     
004C67  2  A9 86 A0 4D          PRINTMSG_MSG c_commission2
004C6B  2  20 F4 39     
004C6E  2  60                   RTS
004C6F  2               @reminder:
004C6F  2  A9 CB A0 4D          PRINTMSG_MSG c_reminder1
004C73  2  20 F4 39     
004C76  2  A9 08 A0 4E          PRINTMSG_MSG c_reminder2
004C7A  2  20 F4 39     
004C7D  2  60                   RTS
004C7E  2               @unlock:
004C7E  2  A9 03                LDA     #QUEST_DUNG_OPEN
004C80  2  8D 7D 51             STA     queststate
004C83  2               ; royal reward: full healing and fresh provisions
004C83  2  AD 6D 51             LDA     pmaxhp
004C86  2  8D 6C 51             STA     phealth
004C89  2  18                   CLC
004C8A  2  AD 73 51             LDA     pfood
004C8D  2  69 64                ADC     #100
004C8F  2  8D 73 51             STA     pfood
004C92  2  AD 74 51             LDA     pfood+1
004C95  2  69 00                ADC     #0
004C97  2  8D 74 51             STA     pfood+1
004C9A  2  20 61 0E             JSR     sfx_door
004C9D  2  A9 3A A0 4E          PRINTMSG_MSG c_unlock1
004CA1  2  20 F4 39     
004CA4  2  A9 74 A0 4E          PRINTMSG_MSG c_unlock2
004CA8  2  20 F4 39     
004CAB  2  60                   RTS
004CAC  2               @finale:
004CAC  2  A9 05                LDA     #QUEST_COMPLETE
004CAE  2  8D 7D 51             STA     queststate
