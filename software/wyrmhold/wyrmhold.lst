0058CB  2               ;----------------------------------------------------------------
0058CB  2               ; spend_gold - try to spend A gold.  C=1 success (gold deducted),
0058CB  2               ;              C=0 if not enough.
0058CB  2               ;----------------------------------------------------------------
0058CB  2               spend_gold:
0058CB  2  85 20                STA     tmp0
0058CD  2               ; gold >= tmp0 ?  (16-bit gold, 8-bit cost)
0058CD  2  AD 14 62             LDA     pgold+1
0058D0  2  D0 07                BNE     @ok             ; high byte nonzero -> plenty
0058D2  2  AD 13 62             LDA     pgold
0058D5  2  C5 20                CMP     tmp0
0058D7  2  90 13                BCC     @no
0058D9  2               @ok:
0058D9  2  38                   SEC
0058DA  2  AD 13 62             LDA     pgold
0058DD  2  E5 20                SBC     tmp0
0058DF  2  8D 13 62             STA     pgold
0058E2  2  AD 14 62             LDA     pgold+1
0058E5  2  E9 00                SBC     #0
0058E7  2  8D 14 62             STA     pgold+1
0058EA  2  38                   SEC
0058EB  2  60                   RTS
0058EC  2               @no:
0058EC  2  18                   CLC
0058ED  2  60                   RTS
0058EE  2               
0058EE  2               ;----------------------------------------------------------------
0058EE  2               ; shop_set_greeting - select a greeting for the active town.
0058EE  2               ;----------------------------------------------------------------
0058EE  2               shop_set_greeting:
0058EE  2  AD 1A 62             LDA     town_id
0058F1  2  0A                   ASL     A
0058F2  2  AA                   TAX
0058F3  2  BD 83 5B             LDA     shop_greetings,X
0058F6  2  8D 31 62             STA     shopstat
0058F9  2  BD 84 5B             LDA     shop_greetings+1,X
0058FC  2  8D 32 62             STA     shopstat+1
0058FF  2  60                   RTS
005900  2               
005900  2               ;----------------------------------------------------------------
005900  2               ; shop_print_line - print a town-specific shop line.
005900  2               ;   IN: A = line index (SHOPTXT_*)
005900  2               ;----------------------------------------------------------------
005900  2               SHOPTXT_HEADER  = 0
005900  2               SHOPTXT_HEAL    = 1
005900  2               SHOPTXT_FOOD    = 2
005900  2               SHOPTXT_WEAPON  = 3
005900  2               SHOPTXT_ARMOR   = 4
005900  2               
005900  2               shop_print_line:
005900  2  0A                   ASL     A
005901  2  0A                   ASL     A               ; two town pointers per line
005902  2  85 20                STA     tmp0
005904  2  AD 1A 62             LDA     town_id
005907  2  0A                   ASL     A
005908  2  18                   CLC
005909  2  65 20                ADC     tmp0
00590B  2  AA                   TAX
00590C  2  BD FE 59             LDA     shop_text_table,X
00590F  2  BC FF 59             LDY     shop_text_table+1,X
005912  2  4C ED 3B             JMP     prmsg
005915  2               
005915  2               ;----------------------------------------------------------------
005915  2               ; Shop box geometry - a clean panel drawn inside the viewport,
005915  2               ; well clear of the bottom-right auto-scroll cell.
005915  2               ;----------------------------------------------------------------
005915  2               SHOP_X0         = 3             ; left column of box
005915  2               SHOP_X1         = 42            ; right column of box
005915  2               SHOP_Y0         = 4             ; top row of box
005915  2               SHOP_Y1         = 15            ; bottom row of box
005915  2               SHOP_W          = SHOP_X1-SHOP_X0+1
005915  2               
005915  2               ;----------------------------------------------------------------
005915  2               ; shop_draw - render the shop as a self-contained bordered panel.
005915  2               ; The whole box is repainted each call (background + border via
005915  2               ; direct VRAM, then text via firmware) so it is always clean.
005915  2               ;----------------------------------------------------------------
005915  2               shop_draw:
005915  2               ; --- paint box background + border directly to VRAM ---
005915  2  20 8D 3A             JSR     vid_enter
005918  2  A9 04                LDA     #SHOP_Y0
00591A  2  85 27                STA     rowidx
00591C  2               @bgrow:
00591C  2  A5 27                LDA     rowidx
00591E  2  20 A2 3A             JSR     rowbase
005921  2  A0 03                LDY     #SHOP_X0
005923  2               @bgcol:
005923  2               ; border on edges, blank interior
005923  2  C0 03                CPY     #SHOP_X0
005925  2  F0 19                BEQ     @edge
005927  2  C0 2A                CPY     #SHOP_X1
005929  2  F0 15                BEQ     @edge
00592B  2  A5 27                LDA     rowidx
00592D  2  C9 04                CMP     #SHOP_Y0
00592F  2  F0 0F                BEQ     @edge
005931  2  C9 0F                CMP     #SHOP_Y1
005933  2  F0 0B                BEQ     @edge
005935  2               ; interior cell
005935  2  A9 20                LDA     #space
005937  2  91 14                STA     (vptr),Y
005939  2  A9 1F                LDA     #C_SHOPBG
00593B  2  91 16                STA     (cptr),Y
00593D  2  4C 48 59             JMP     @bgnext
005940  2               @edge:
005940  2  A9 20                LDA     #' '
005942  2  91 14                STA     (vptr),Y
005944  2  A9 1B                LDA     #C_SHOPBRD
005946  2  91 16                STA     (cptr),Y
005948  2               @bgnext:
005948  2  C8                   INY
005949  2  C0 2B                CPY     #SHOP_X1+1
00594B  2  D0 D6                BNE     @bgcol
00594D  2  E6 27                INC     rowidx
00594F  2  A5 27                LDA     rowidx
005951  2  C9 10                CMP     #SHOP_Y1+1
005953  2  D0 C7                BNE     @bgrow
005955  2  20 9C 3A             JSR     vid_exit
005958  2               
005958  2               ; --- text lines via firmware (interior color C_SHOPBG) ---
005958  2  A9 1E                LDA     #C_SHOPTTL
00595A  2  8D 4A 06             STA     CURCOLOR
00595D  2  A2 0B                LDX     #SHOP_X0+8
00595F  2  A0 04                LDY     #SHOP_Y0
