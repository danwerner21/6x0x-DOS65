000B8C  1  54 48 4F 55  
000B90  1  20 48 41 53  
000BA1  1               go_hp:
000BA1  1  54 68 79 20          .BYTE   "Thy wounds were too grave.",0
000BA5  1  77 6F 75 6E  
000BA9  1  64 73 20 77  
000BBC  1               go_food:
000BBC  1  54 68 6F 75          .BYTE   "Thou hast starved in the wilds.",0
000BC0  1  20 68 61 73  
