0035EB  2               ; Map / event messages (shared with player.asm)
0035EB  2               ;----------------------------------------------------------------
0035EB  2  42 6C 6F 63  m_blocked:  .BYTE "Blocked!",0
0035EF  2  6B 65 64 21  
0035F3  2  00           
0035F4  2  59 6F 75 20  m_treasure: .BYTE "You found gold in a chest!",0
0035F8  2  66 6F 75 6E  
0035FC  2  64 20 67 6F  
