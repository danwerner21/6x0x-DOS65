000BDB  1               ;==============================================================================
000BDB  1               ; Include the rest of the engine
000BDB  1               ;==============================================================================
000BDB  1                       .INCLUDE "rng.asm"
000BDB  2               ;______________________________________________________________________________
000BDB  2               ;  rng.asm - 16-bit xorshift pseudo-random generator
000BDB  2               ;______________________________________________________________________________
000BDB  2               
000BDB  2               ;----------------------------------------------------------------
000BDB  2               ; rng_seed - initialise the generator (avoid all-zero state).
000BDB  2               ;----------------------------------------------------------------
000BDB  2               rng_seed:
000BDB  2  A9 A3                LDA     #$A3
000BDD  2  85 30                STA     seedlo
000BDF  2  A9 1C                LDA     #$1C
000BE1  2  85 31                STA     seedhi
000BE3  2  60                   RTS
000BE4  2               
000BE4  2               ;----------------------------------------------------------------
000BE4  2               ; rng_next - advance the 16-bit xorshift state, return low byte
000BE4  2               ;            in A.  (xorshift: x ^= x<<7; x ^= x>>9; x ^= x<<8)
000BE4  2               ;----------------------------------------------------------------
000BE4  2               rng_next:
000BE4  2               ; x ^= x << 7
000BE4  2  A5 31                LDA     seedhi
000BE6  2  4A                   LSR     A               ; carry = bit7 of hi after some shifts...
000BE7  2               ; Implement x<<7 via: shift left 7 = shift right 1 then swap?
000BE7  2               ; Simpler: do a byte-wise xorshift that is "good enough".
000BE7  2               ; x ^= x << 7
000BE7  2  A5 30                LDA     seedlo
000BE9  2  0A                   ASL     A
000BEA  2  0A                   ASL     A
000BEB  2  0A                   ASL     A
000BEC  2  0A                   ASL     A
000BED  2  0A                   ASL     A
000BEE  2  0A                   ASL     A
000BEF  2  0A                   ASL     A               ; lo << 7 (only bit0 survives into bit7)
000BF0  2  45 31                EOR     seedhi
000BF2  2  85 31                STA     seedhi
000BF4  2               ; x ^= x >> 9  (>>9 of 16-bit = hi >> 1 into lo)
000BF4  2  A5 31                LDA     seedhi
000BF6  2  4A                   LSR     A
000BF7  2  45 30                EOR     seedlo
000BF9  2  85 30                STA     seedlo
000BFB  2               ; x ^= x << 8  (swap bytes contribution: lo ^ into hi)
000BFB  2  A5 30                LDA     seedlo
000BFD  2  45 31                EOR     seedhi
000BFF  2  85 31                STA     seedhi
000C01  2  A5 30                LDA     seedlo
000C03  2  60                   RTS
000C04  2               
000C04  2               ;----------------------------------------------------------------
000C04  2               ; rng_mod - return a value 0..A-1 in A.  IN: A = modulus (1..255)
000C04  2               ;           (uses repeated subtraction mask via AND for powers of
000C04  2               ;            two is faster, but generic mod via subtract loop here)
000C04  2               ;----------------------------------------------------------------
000C04  2               rng_mod:
000C04  2  85 23                STA     tmp3            ; modulus
000C06  2  20 E4 0B             JSR     rng_next        ; A = random byte
000C09  2               ; reduce A mod tmp3 by subtraction
000C09  2               @rm:
000C09  2  C5 23                CMP     tmp3
000C0B  2  90 06                BCC     @done
000C0D  2  38                   SEC
000C0E  2  E5 23                SBC     tmp3
000C10  2  4C 09 0C             JMP     @rm
000C13  2               @done:
000C13  2  60                   RTS
000C14  2               
000C14  2               ;----------------------------------------------------------------
000C14  2               ; rng_d - roll a die: return 1..A in A.  IN: A = sides (1..255)
000C14  2               ;----------------------------------------------------------------
000C14  2               rng_d:
000C14  2  20 04 0C             JSR     rng_mod
000C17  2  18                   CLC
000C18  2  69 01                ADC     #1
000C1A  2  60                   RTS
000C1B  2               
000C1B  1                       .INCLUDE "sound.asm"
000C1B  2               ;______________________________________________________________________________
000C1B  2               ;  sound.asm - AY-3-8910 PSG sound effects and cooperative music player
000C1B  2               ;
000C1B  2               ;  PSG access ported from software/dbasic/ay38910.asm (PPI at $E230).
000C1B  2               ;  psgwr: A=register, Y=value        psgrd: A=register -> Y=value
000C1B  2               ;
000C1B  2               ;  AY register map:
000C1B  2               ;    0/1  ch A tone period (lo / hi 4 bits)
000C1B  2               ;    2/3  ch B tone period
000C1B  2               ;    4/5  ch C tone period
000C1B  2               ;    6    noise period (5 bits)
000C1B  2               ;    7    mixer: bit clear = enabled. 0-2 tone A/B/C, 3-5 noise A/B/C
000C1B  2               ;    8/9/10 ch A/B/C volume (0-15, bit4 = use envelope)
000C1B  2               ;    11/12 envelope period
000C1B  2               ;    13   envelope shape
000C1B  2               ;______________________________________________________________________________
000C1B  2               
000C1B  2               PPI_BASE        = $E230
000C1B  2               ppiPortA        = PPI_BASE+0
000C1B  2               ppiPortB        = PPI_BASE+1
000C1B  2               ppiPortC        = PPI_BASE+2
000C1B  2               ppiControl      = PPI_BASE+3
000C1B  2               
000C1B  2               ;----------------------------------------------------------------
000C1B  2               ; psg_init - put the PSG into a known, silent state
000C1B  2               ;----------------------------------------------------------------
000C1B  2               psg_init:
000C1B  2  A9 80                LDA     #%10000000
000C1D  2  8D 33 E2             STA     ppiControl
000C20  2  A9 10                LDA     #%00010000
000C22  2  8D 32 E2             STA     ppiPortC
000C25  2  A9 00                LDA     #$00
000C27  2  8D 31 E2             STA     ppiPortB
000C2A  2  20 2E 0C             JSR     clrpsg
000C2D  2  60                   RTS
000C2E  2               
000C2E  2               ;----------------------------------------------------------------
000C2E  2               ; clrpsg - zero all 16 registers, then disable all channels
000C2E  2               ;----------------------------------------------------------------
000C2E  2               clrpsg:
000C2E  2  A2 00                LDX     #00
000C30  2  A0 00                LDY     #00
000C32  2               @cp1:
000C32  2  8A                   TXA
000C33  2  20 60 0C             JSR     psgwr
000C36  2  E8                   INX
000C37  2  E0 10                CPX     #16
000C39  2  D0 F7                BNE     @cp1
000C3B  2  A9 07                LDA     #07
000C3D  2  A0 3F                LDY     #%00111111      ; all tone + noise disabled
000C3F  2  20 60 0C             JSR     psgwr
000C42  2  60                   RTS
000C43  2               
000C43  2               ;----------------------------------------------------------------
000C43  2               ; psg_silence - silence all three channels (volumes -> 0)
000C43  2               ;----------------------------------------------------------------
000C43  2               psg_silence:
000C43  2  A9 08                LDA     #8
000C45  2  A0 00                LDY     #0
000C47  2  20 60 0C             JSR     psgwr
000C4A  2  A9 09                LDA     #9
000C4C  2  A0 00                LDY     #0
000C4E  2  20 60 0C             JSR     psgwr
000C51  2  A9 0A                LDA     #10
000C53  2  A0 00                LDY     #0
000C55  2  20 60 0C             JSR     psgwr
000C58  2  A9 07                LDA     #07
000C5A  2  A0 3F                LDY     #%00111111
000C5C  2  20 60 0C             JSR     psgwr
000C5F  2  60                   RTS
000C60  2               
000C60  2               ;----------------------------------------------------------------
000C60  2               ; psgwr - write Y into PSG register A     (trashes A)
000C60  2               ;----------------------------------------------------------------
000C60  2               psgwr:
000C60  2  8D 31 E2             STA     ppiPortB        ; select register
000C63  2  A9 1C                LDA     #%00011100      ; latch address
000C65  2  8D 32 E2             STA     ppiPortC
000C68  2  8D 32 E2             STA     ppiPortC
000C6B  2  8D 32 E2             STA     ppiPortC
000C6E  2  A9 10                LDA     #%00010000      ; inactive
000C70  2  8D 32 E2             STA     ppiPortC
000C73  2  8D 32 E2             STA     ppiPortC
000C76  2  8D 32 E2             STA     ppiPortC
000C79  2  98                   TYA
000C7A  2  8D 31 E2             STA     ppiPortB        ; store data
000C7D  2  8D 31 E2             STA     ppiPortB
000C80  2  8D 31 E2             STA     ppiPortB
000C83  2  A9 14                LDA     #%00010100      ; latch data
000C85  2  8D 32 E2             STA     ppiPortC
000C88  2  8D 32 E2             STA     ppiPortC
000C8B  2  8D 32 E2             STA     ppiPortC
000C8E  2  A9 10                LDA     #%00010000      ; inactive
000C90  2  8D 32 E2             STA     ppiPortC
000C93  2  60                   RTS
000C94  2               
000C94  2               ;----------------------------------------------------------------
000C94  2               ; psgrd - read PSG register A into Y      (trashes A)
000C94  2               ;----------------------------------------------------------------
000C94  2               psgrd:
000C94  2  8D 31 E2             STA     ppiPortB        ; select register
000C97  2  A9 1C                LDA     #%00011100      ; latch address
000C99  2  8D 32 E2             STA     ppiPortC
000C9C  2  8D 32 E2             STA     ppiPortC
000C9F  2  8D 32 E2             STA     ppiPortC
000CA2  2  A9 10                LDA     #%00010000      ; inactive
000CA4  2  8D 32 E2             STA     ppiPortC
000CA7  2  8D 32 E2             STA     ppiPortC
000CAA  2  A9 82                LDA     #%10000010
000CAC  2  8D 33 E2             STA     ppiControl
000CAF  2  A9 18                LDA     #%00011000      ; latch data
000CB1  2  8D 32 E2             STA     ppiPortC
000CB4  2  8D 32 E2             STA     ppiPortC
000CB7  2  8D 32 E2             STA     ppiPortC
000CBA  2  AD 31 E2             LDA     ppiPortB        ; read data
000CBD  2  A8                   TAY
000CBE  2  A9 80                LDA     #%10000000
000CC0  2  8D 33 E2             STA     ppiControl
000CC3  2  A9 10                LDA     #%00010000      ; inactive
000CC5  2  8D 32 E2             STA     ppiPortC
000CC8  2  60                   RTS
000CC9  2               
000CC9  2               ;----------------------------------------------------------------
000CC9  2               ; tone_on - start a tone on channel A.
000CC9  2               ;   ptr (16-bit) = 12-bit tone period (lo in ptr, hi in ptr+1)
000CC9  2               ;   tmp0         = volume (0-15)
000CC9  2               ;----------------------------------------------------------------
000CC9  2               tone_on:
000CC9  2  A9 00                LDA     #0              ; ch A period low
000CCB  2  A4 10                LDY     ptr
000CCD  2  20 60 0C             JSR     psgwr
000CD0  2  A9 01                LDA     #1              ; ch A period high
000CD2  2  A4 11                LDY     ptr+1
000CD4  2  20 60 0C             JSR     psgwr
000CD7  2  A9 07                LDA     #07             ; mixer: enable tone A only
000CD9  2  A0 3E                LDY     #%00111110
000CDB  2  20 60 0C             JSR     psgwr
000CDE  2  A9 08                LDA     #8              ; ch A volume
000CE0  2  A4 20                LDY     tmp0
000CE2  2  20 60 0C             JSR     psgwr
000CE5  2  60                   RTS
000CE6  2               
000CE6  2               ;----------------------------------------------------------------
000CE6  2               ; busywait - crude delay.  X = outer count.
000CE6  2               ;----------------------------------------------------------------
000CE6  2               busywait:
000CE6  2               @bw0:
000CE6  2  A0 00                LDY     #0
000CE8  2               @bw1:
000CE8  2  A9 00                LDA     #0
000CEA  2               @bw2:
000CEA  2  18                   CLC
000CEB  2  69 01                ADC     #1
000CED  2  C9 28                CMP     #40
000CEF  2  D0 F9                BNE     @bw2
000CF1  2  C8                   INY
000CF2  2  D0 F4                BNE     @bw1
000CF4  2  CA                   DEX
000CF5  2  D0 EF                BNE     @bw0
000CF7  2  60                   RTS
000CF8  2               
000CF8  2               ;----------------------------------------------------------------
000CF8  2               ; mus_finewait - a short, fine-grained delay for tempo trimming.
000CF8  2               ; Spins MUS_FINEDELAY outer times, 256 inner each.  Much smaller
000CF8  2               ; than one busywait pass, so it gives sub-step tempo control.
000CF8  2               ;----------------------------------------------------------------
000CF8  2               mus_finewait:
000CF8  2  A2 46                LDX     #MUS_FINEDELAY
000CFA  2  F0 08                BEQ     @done
000CFC  2               @fw0:
000CFC  2  A0 00                LDY     #0
000CFE  2               @fw1:
000CFE  2  C8                   INY
000CFF  2  D0 FD                BNE     @fw1
000D01  2  CA                   DEX
000D02  2  D0 F8                BNE     @fw0
000D04  2               @done:
000D04  2  60                   RTS
000D05  2               
000D05  2               ;----------------------------------------------------------------
000D05  2               ; SFX helpers.  Each plays a short, self-contained sound and
000D05  2               ; silences the PSG afterwards.  All preserve nothing - callers
000D05  2               ; must save anything they need.
000D05  2               ;----------------------------------------------------------------
000D05  2               
000D05  2               ; sfx_move - very short low blip
000D05  2               sfx_move:
000D05  2  A9 40 85 10          SETW16  ptr, $0240
000D09  2  A9 02 85 11  
000D0D  2  A9 06                LDA     #6
000D0F  2  85 20                STA     tmp0
000D11  2  20 C9 0C             JSR     tone_on
000D14  2  A2 02                LDX     #2
000D16  2  20 E6 0C             JSR     busywait
000D19  2  4C 43 0C             JMP     psg_silence
000D1C  2               
000D1C  2               ; sfx_blocked - low buzz (use noise)
000D1C  2               sfx_blocked:
000D1C  2  A9 06                LDA     #6              ; noise period
000D1E  2  A0 14                LDY     #20
000D20  2  20 60 0C             JSR     psgwr
000D23  2  A9 07                LDA     #07             ; enable noise A
000D25  2  A0 37                LDY     #%00110111
000D27  2  20 60 0C             JSR     psgwr
000D2A  2  A9 08                LDA     #8
000D2C  2  A0 0A                LDY     #10
000D2E  2  20 60 0C             JSR     psgwr
000D31  2  A2 03                LDX     #3
000D33  2  20 E6 0C             JSR     busywait
000D36  2  4C 43 0C             JMP     psg_silence
000D39  2               
000D39  2               ; sfx_hit - quick high zap
000D39  2               sfx_hit:
000D39  2  A9 C0 85 10          SETW16  ptr, $00C0
000D3D  2  A9 00 85 11  
000D41  2  A9 0C                LDA     #12
000D43  2  85 20                STA     tmp0
000D45  2  20 C9 0C             JSR     tone_on
000D48  2  A2 02                LDX     #2
000D4A  2  20 E6 0C             JSR     busywait
000D4D  2  A9 40 85 10          SETW16  ptr, $0140
000D51  2  A9 01 85 11  
000D55  2  A9 0A                LDA     #10
000D57  2  85 20                STA     tmp0
000D59  2  20 C9 0C             JSR     tone_on
000D5C  2  A2 02                LDX     #2
000D5E  2  20 E6 0C             JSR     busywait
000D61  2  4C 43 0C             JMP     psg_silence
000D64  2               
000D64  2               ; sfx_killed - falling tone + noise
000D64  2               sfx_killed:
000D64  2  A9 06                LDA     #6
000D66  2  A0 10                LDY     #16
000D68  2  20 60 0C             JSR     psgwr
000D6B  2  A9 07                LDA     #07
000D6D  2  A0 37                LDY     #%00110111
000D6F  2  20 60 0C             JSR     psgwr
000D72  2  A9 08                LDA     #8
000D74  2  A0 0D                LDY     #13
000D76  2  20 60 0C             JSR     psgwr
000D79  2  A2 05                LDX     #5
000D7B  2  20 E6 0C             JSR     busywait
000D7E  2  4C 43 0C             JMP     psg_silence
000D81  2               
000D81  2               ; sfx_treasure - bright rising arpeggio
000D81  2               sfx_treasure:
000D81  2  A9 50 85 10          SETW16  ptr, $0150
000D85  2  A9 01 85 11  
000D89  2  A9 0D                LDA     #13
000D8B  2  85 20                STA     tmp0
000D8D  2  20 C9 0C             JSR     tone_on
000D90  2  A2 02                LDX     #2
000D92  2  20 E6 0C             JSR     busywait
000D95  2  A9 FC 85 10          SETW16  ptr, $00FC
000D99  2  A9 00 85 11  
000D9D  2  20 C9 0C             JSR     tone_on
000DA0  2  A2 02                LDX     #2
000DA2  2  20 E6 0C             JSR     busywait
000DA5  2  A9 A8 85 10          SETW16  ptr, $00A8
000DA9  2  A9 00 85 11  
000DAD  2  20 C9 0C             JSR     tone_on
000DB0  2  A2 03                LDX     #3
000DB2  2  20 E6 0C             JSR     busywait
000DB5  2  4C 43 0C             JMP     psg_silence
000DB8  2               
000DB8  2               ; sfx_levelup - three ascending happy notes
000DB8  2               sfx_levelup:
000DB8  2  A9 FC 85 10          SETW16  ptr, $00FC
000DBC  2  A9 00 85 11  
000DC0  2  A9 0E                LDA     #14
000DC2  2  85 20                STA     tmp0
000DC4  2  20 C9 0C             JSR     tone_on
000DC7  2  A2 03                LDX     #3
000DC9  2  20 E6 0C             JSR     busywait
000DCC  2  A9 C8 85 10          SETW16  ptr, $00C8
000DD0  2  A9 00 85 11  
000DD4  2  20 C9 0C             JSR     tone_on
000DD7  2  A2 03                LDX     #3
000DD9  2  20 E6 0C             JSR     busywait
000DDC  2  A9 A8 85 10          SETW16  ptr, $00A8
000DE0  2  A9 00 85 11  
000DE4  2  20 C9 0C             JSR     tone_on
000DE7  2  A2 04                LDX     #4
000DE9  2  20 E6 0C             JSR     busywait
000DEC  2  4C 43 0C             JMP     psg_silence
000DEF  2               
000DEF  2               ; sfx_door - short two-tone chime
000DEF  2               sfx_door:
000DEF  2  A9 80 85 10          SETW16  ptr, $0180
000DF3  2  A9 01 85 11  
000DF7  2  A9 0B                LDA     #11
000DF9  2  85 20                STA     tmp0
000DFB  2  20 C9 0C             JSR     tone_on
000DFE  2  A2 02                LDX     #2
000E00  2  20 E6 0C             JSR     busywait
000E03  2  A9 20 85 10          SETW16  ptr, $0120
000E07  2  A9 01 85 11  
000E0B  2  20 C9 0C             JSR     tone_on
000E0E  2  A2 03                LDX     #3
000E10  2  20 E6 0C             JSR     busywait
000E13  2  4C 43 0C             JMP     psg_silence
000E16  2               
000E16  2               ; sfx_lose - long descending sad tone
000E16  2               sfx_lose:
000E16  2  A9 20 85 10          SETW16  ptr, $0120
000E1A  2  A9 01 85 11  
000E1E  2  A9 0D                LDA     #13
000E20  2  85 20                STA     tmp0
000E22  2  20 C9 0C             JSR     tone_on
000E25  2  A2 06                LDX     #6
000E27  2  20 E6 0C             JSR     busywait
000E2A  2  A9 C0 85 10          SETW16  ptr, $01C0
000E2E  2  A9 01 85 11  
000E32  2  20 C9 0C             JSR     tone_on
000E35  2  A2 06                LDX     #6
000E37  2  20 E6 0C             JSR     busywait
000E3A  2  A9 80 85 10          SETW16  ptr, $0280
000E3E  2  A9 02 85 11  
000E42  2  20 C9 0C             JSR     tone_on
000E45  2  A2 0A                LDX     #10
000E47  2  20 E6 0C             JSR     busywait
000E4A  2  4C 43 0C             JMP     psg_silence
000E4D  2               
000E4D  2               ; sfx_win - triumphant fanfare
000E4D  2               sfx_win:
000E4D  2  A9 FC 85 10          SETW16  ptr, $00FC
000E51  2  A9 00 85 11  
000E55  2  A9 0F                LDA     #15
000E57  2  85 20                STA     tmp0
000E59  2  20 C9 0C             JSR     tone_on
000E5C  2  A2 04                LDX     #4
000E5E  2  20 E6 0C             JSR     busywait
000E61  2  A9 C8 85 10          SETW16  ptr, $00C8
000E65  2  A9 00 85 11  
000E69  2  20 C9 0C             JSR     tone_on
000E6C  2  A2 04                LDX     #4
000E6E  2  20 E6 0C             JSR     busywait
000E71  2  A9 A8 85 10          SETW16  ptr, $00A8
000E75  2  A9 00 85 11  
000E79  2  20 C9 0C             JSR     tone_on
000E7C  2  A2 04                LDX     #4
000E7E  2  20 E6 0C             JSR     busywait
000E81  2  A9 7E 85 10          SETW16  ptr, $007E
000E85  2  A9 00 85 11  
000E89  2  20 C9 0C             JSR     tone_on
000E8C  2  A2 0C                LDX     #12
000E8E  2  20 E6 0C             JSR     busywait
000E91  2  4C 43 0C             JMP     psg_silence
000E94  2               
000E94  2               ;==============================================================================
000E94  2               ;  Cooperative 3-channel title music player with hardware envelope.
000E94  2               ;
000E94  2               ;  Three independent voice tracks play simultaneously:
000E94  2               ;     channel A = lead melody   (uses the AY envelope generator so each
000E94  2               ;                                note has a soft attack/decay shape)
000E94  2               ;     channel B = counter/harmony (fixed mid volume)
000E94  2               ;     channel C = bass line       (fixed mid volume)
000E94  2               ;
000E94  2               ;  Each track is a list of events: (note, duration) byte pairs.
000E94  2               ;     note 0      = rest (silence this channel for the duration)
000E94  2               ;     note 1..47  = index into note_lo/note_hi period tables
000E94  2               ;     note $FF    = end marker -> loop the track from its start
000E94  2               ;     duration    = number of music ticks to hold (1..254)
000E94  2               ;
000E94  2               ;  music_tick is called once per title spin-loop iteration.  It paces
000E94  2               ;  itself with a short delay, then advances all three voices.
000E94  2               ;==============================================================================
000E94  2               
000E94  2               ; Tempo: each music tick waits busywait(1) plus an extra fine spin of
000E94  2               ; MUS_FINEDELAY * 256 loops.  delay=1 alone (FINE=0) was a little fast;
000E94  2               ; FINE=128 is about 1.5x slower.  Raise/lower MUS_FINEDELAY to taste.
000E94  2               MUS_TICKDELAY   = 1             ; busywait outer count per music tick
000E94  2               MUS_FINEDELAY   = 70            ; extra fine delay (0..255), tempo trim
000E94  2               
000E94  2               ; envelope shape values (reg 13)
000E94  2               ENV_DECAY       = %00000000     ; \____  single decay then off (plucky)
000E94  2               ENV_RAMP        = %00001000     ; \\\\   repeating saw (sustained pulse)
000E94  2               ENV_PERIOD      = $1800         ; 16-bit envelope period (attack/decay len)
000E94  2               MUS_VOL_B       = 8             ; harmony volume (gentle, under the lead)
000E94  2               MUS_VOL_C       = 13            ; bass volume (strong, so it is audible)
000E94  2               
000E94  2               ;----------------------------------------------------------------
000E94  2               ; music_start - reset all three voice cursors and program the AY
000E94  2               ; for music: all three tone channels enabled, envelope set up for
000E94  2               ; the lead.
000E94  2               ;----------------------------------------------------------------
000E94  2               music_start:
000E94  2               ; voice cursors -> track starts
000E94  2  A9 5D 8D 5B          SETW16  mvA_ptr, trackA
000E98  2  41 A9 10 8D  
000E9C  2  5C 41        
000E9E  2  A9 9A 8D 5E          SETW16  mvB_ptr, trackB
000EA2  2  41 A9 10 8D  
000EA6  2  5F 41        
000EA8  2  A9 AD 8D 61          SETW16  mvC_ptr, trackC
000EAC  2  41 A9 10 8D  
000EB0  2  62 41        
000EB2  2               ; all hold-counters = 0 so every voice fetches on the first tick.
000EB2  2               ; (must load #0 fresh each time - SETW16 above left A non-zero,
000EB2  2               ;  which is why B/C previously got garbage counts and went silent)
000EB2  2  A9 00                LDA     #0
000EB4  2  8D 5D 41             STA     mvA_cnt
000EB7  2  8D 60 41             STA     mvB_cnt
000EBA  2  8D 63 41             STA     mvC_cnt
000EBD  2               
000EBD  2               ; mixer: enable tone on A, B, C (noise off)  -> bits 0..2 clear
000EBD  2  A9 07                LDA     #07
000EBF  2  A0 38                LDY     #%00111000
000EC1  2  20 60 0C             JSR     psgwr
000EC4  2               ; envelope period (regs 11/12) - sets attack/decay length.
000EC4  2               ; longer = the plucked lead note rings out for more of its
000EC4  2               ; duration before fading.  Tune ENV_PERIOD to taste.
000EC4  2  A9 0B                LDA     #11
000EC6  2  A0 00                LDY     #<ENV_PERIOD
000EC8  2  20 60 0C             JSR     psgwr
000ECB  2  A9 0C                LDA     #12
000ECD  2  A0 18                LDY     #>ENV_PERIOD
000ECF  2  20 60 0C             JSR     psgwr
000ED2  2               ; channel A volume register = use envelope (bit4 set)
000ED2  2  A9 08                LDA     #8
000ED4  2  A0 10                LDY     #%00010000
000ED6  2  20 60 0C             JSR     psgwr
000ED9  2               ; channel B: gentle harmony pad ; channel C: strong bass
000ED9  2  A9 09                LDA     #9
000EDB  2  A0 08                LDY     #MUS_VOL_B
000EDD  2  20 60 0C             JSR     psgwr
000EE0  2  A9 0A                LDA     #10
000EE2  2  A0 0D                LDY     #MUS_VOL_C
000EE4  2  20 60 0C             JSR     psgwr
000EE7  2  60                   RTS
000EE8  2               
000EE8  2               ;----------------------------------------------------------------
000EE8  2               ; music_tick - advance all three voices by one tick.
000EE8  2               ;----------------------------------------------------------------
000EE8  2               music_tick:
000EE8  2  A2 01                LDX     #MUS_TICKDELAY
000EEA  2  20 E6 0C             JSR     busywait
000EED  2  20 F8 0C             JSR     mus_finewait    ; fine tempo trim
000EF0  2               
000EF0  2               ; --- voice A (lead, envelope) ---
000EF0  2  AD 5D 41             LDA     mvA_cnt
000EF3  2  F0 06                BEQ     @nextA
000EF5  2  CE 5D 41             DEC     mvA_cnt
000EF8  2  4C 50 0F             JMP     @doB
000EFB  2               @nextA:
000EFB  2  A9 5D 85 18          SETW16  srcp, trackA    ; (loop base, used if end marker hit)
000EFF  2  A9 10 85 19  
000F03  2  AD 5B 41             LDA     mvA_ptr
000F06  2  85 12                STA     ptr2
000F08  2  AD 5C 41             LDA     mvA_ptr+1
000F0B  2  85 13                STA     ptr2+1
000F0D  2  20 F9 0F             JSR     mus_fetch       ; -> tmp0=note, tmp1=dur, ptr2 advanced
000F10  2               ; program channel A tone (regs 0/1) from the note
000F10  2  A6 20                LDX     tmp0
000F12  2  F0 1B                BEQ     @restA          ; rest
000F14  2  20 25 10             JSR     note_period     ; -> ptr = period for note X
000F17  2  A9 00                LDA     #0
000F19  2  A4 10                LDY     ptr
000F1B  2  20 60 0C             JSR     psgwr
000F1E  2  A9 01                LDA     #1
000F20  2  A4 11                LDY     ptr+1
000F22  2  20 60 0C             JSR     psgwr
000F25  2               ; (re)trigger the envelope by rewriting the shape register
000F25  2  A9 0D                LDA     #13
000F27  2  A0 00                LDY     #ENV_DECAY
000F29  2  20 60 0C             JSR     psgwr
000F2C  2  4C 36 0F             JMP     @setA
000F2F  2               @restA:
000F2F  2               ; silence A for the rest: drop its volume to 0 (no envelope)
000F2F  2  A9 08                LDA     #8
000F31  2  A0 00                LDY     #0
000F33  2  20 60 0C             JSR     psgwr
000F36  2               @setA:
000F36  2               ; for a non-rest, make sure A uses the envelope again
000F36  2  A5 20                LDA     tmp0
000F38  2  F0 07                BEQ     @cntA
000F3A  2  A9 08                LDA     #8
000F3C  2  A0 10                LDY     #%00010000
000F3E  2  20 60 0C             JSR     psgwr
000F41  2               @cntA:
000F41  2  A5 21                LDA     tmp1
000F43  2  8D 5D 41             STA     mvA_cnt
000F46  2  A5 12                LDA     ptr2
000F48  2  8D 5B 41             STA     mvA_ptr
000F4B  2  A5 13                LDA     ptr2+1
000F4D  2  8D 5C 41             STA     mvA_ptr+1
000F50  2               
000F50  2               @doB:
000F50  2               ; --- voice B (harmony, fixed volume on channel B) ---
000F50  2  AD 60 41             LDA     mvB_cnt
000F53  2  F0 06                BEQ     @nextB
000F55  2  CE 60 41             DEC     mvB_cnt
000F58  2  4C A5 0F             JMP     @doC
000F5B  2               @nextB:
000F5B  2  A9 9A 85 18          SETW16  srcp, trackB
000F5F  2  A9 10 85 19  
000F63  2  AD 5E 41             LDA     mvB_ptr
000F66  2  85 12                STA     ptr2
000F68  2  AD 5F 41             LDA     mvB_ptr+1
000F6B  2  85 13                STA     ptr2+1
000F6D  2  20 F9 0F             JSR     mus_fetch
000F70  2  A6 20                LDX     tmp0
000F72  2  F0 1B                BEQ     @restB
000F74  2  20 25 10             JSR     note_period
000F77  2  A9 02                LDA     #2
000F79  2  A4 10                LDY     ptr
000F7B  2  20 60 0C             JSR     psgwr
000F7E  2  A9 03                LDA     #3
000F80  2  A4 11                LDY     ptr+1
000F82  2  20 60 0C             JSR     psgwr
000F85  2  A9 09                LDA     #9              ; restore B volume
000F87  2  A0 08                LDY     #MUS_VOL_B
000F89  2  20 60 0C             JSR     psgwr
000F8C  2  4C 96 0F             JMP     @cntB
000F8F  2               @restB:
000F8F  2  A9 09                LDA     #9
000F91  2  A0 00                LDY     #0
000F93  2  20 60 0C             JSR     psgwr
000F96  2               @cntB:
000F96  2  A5 21                LDA     tmp1
000F98  2  8D 60 41             STA     mvB_cnt
000F9B  2  A5 12                LDA     ptr2
000F9D  2  8D 5E 41             STA     mvB_ptr
000FA0  2  A5 13                LDA     ptr2+1
000FA2  2  8D 5F 41             STA     mvB_ptr+1
000FA5  2               
000FA5  2               @doC:
000FA5  2               ; --- voice C (bass, fixed volume on channel C) ---
000FA5  2  AD 63 41             LDA     mvC_cnt
000FA8  2  F0 04                BEQ     @nextC
000FAA  2  CE 63 41             DEC     mvC_cnt
000FAD  2  60                   RTS
000FAE  2               @nextC:
000FAE  2  A9 AD 85 18          SETW16  srcp, trackC
000FB2  2  A9 10 85 19  
000FB6  2  AD 61 41             LDA     mvC_ptr
000FB9  2  85 12                STA     ptr2
000FBB  2  AD 62 41             LDA     mvC_ptr+1
000FBE  2  85 13                STA     ptr2+1
000FC0  2  20 F9 0F             JSR     mus_fetch
000FC3  2  A6 20                LDX     tmp0
000FC5  2  F0 1B                BEQ     @restC
000FC7  2  20 25 10             JSR     note_period
000FCA  2  A9 04                LDA     #4
000FCC  2  A4 10                LDY     ptr
000FCE  2  20 60 0C             JSR     psgwr
000FD1  2  A9 05                LDA     #5
000FD3  2  A4 11                LDY     ptr+1
000FD5  2  20 60 0C             JSR     psgwr
000FD8  2  A9 0A                LDA     #10             ; restore C volume
000FDA  2  A0 0D                LDY     #MUS_VOL_C
000FDC  2  20 60 0C             JSR     psgwr
000FDF  2  4C E9 0F             JMP     @cntC
000FE2  2               @restC:
000FE2  2  A9 0A                LDA     #10
000FE4  2  A0 00                LDY     #0
000FE6  2  20 60 0C             JSR     psgwr
000FE9  2               @cntC:
000FE9  2  A5 21                LDA     tmp1
000FEB  2  8D 63 41             STA     mvC_cnt
000FEE  2  A5 12                LDA     ptr2
000FF0  2  8D 61 41             STA     mvC_ptr
000FF3  2  A5 13                LDA     ptr2+1
000FF5  2  8D 62 41             STA     mvC_ptr+1
000FF8  2  60                   RTS
000FF9  2               
000FF9  2               ;----------------------------------------------------------------
000FF9  2               ; mus_fetch - read one (note,dur) event from the track at ptr2.
000FF9  2               ;   IN : ptr2 -> current event ; srcp -> track loop base
000FF9  2               ;   OUT: tmp0 = note, tmp1 = duration, ptr2 advanced past the event.
000FF9  2               ;        On an $FF end marker, ptr2 is reset to srcp and the first
000FF9  2               ;        event of the track is returned.
000FF9  2               ;----------------------------------------------------------------
000FF9  2               mus_fetch:
000FF9  2  A0 00                LDY     #0
000FFB  2  B1 12                LDA     (ptr2),Y
000FFD  2  C9 FF                CMP     #$FF
000FFF  2  D0 0C                BNE     @ok
001001  2               ; loop: reset ptr2 to track base (srcp)
001001  2  A5 18                LDA     srcp
001003  2  85 12                STA     ptr2
001005  2  A5 19                LDA     srcp+1
001007  2  85 13                STA     ptr2+1
001009  2  A0 00                LDY     #0
00100B  2  B1 12                LDA     (ptr2),Y
00100D  2               @ok:
00100D  2  85 20                STA     tmp0            ; note
00100F  2  C8                   INY
001010  2  B1 12                LDA     (ptr2),Y
001012  2               ; The voice loops "fetch when counter hits 0", and the fetch
001012  2               ; tick itself is the first tick of the note.  So a note must
001012  2               ; hold for (dur-1) MORE ticks after the fetch tick to last
001012  2               ; exactly dur ticks.  Subtract 1 here.  (All durations are >=2,
001012  2               ; so no underflow.)  This keeps voices with different note
001012  2               ; counts the same real length - otherwise B/C drift away from
001012  2               ; the lead because they have fewer/more notes per loop.
001012  2  38                   SEC
001013  2  E9 01                SBC     #1
001015  2  85 21                STA     tmp1            ; duration - 1
001017  2               ; advance ptr2 by 2
001017  2  18                   CLC
001018  2  A5 12                LDA     ptr2
00101A  2  69 02                ADC     #2
00101C  2  85 12                STA     ptr2
00101E  2  A5 13                LDA     ptr2+1
001020  2  69 00                ADC     #0
001022  2  85 13                STA     ptr2+1
001024  2  60                   RTS
001025  2               
001025  2               ;----------------------------------------------------------------
001025  2               ; note_period - look up the 16-bit AY tone period for note X (1..N)
001025  2               ;   OUT: ptr = period (lo/hi).  Note index is 1-based.
001025  2               ;----------------------------------------------------------------
001025  2               note_period:
001025  2  CA                   DEX                     ; tables are 0-based
001026  2  BD 31 10             LDA     note_lo,X
001029  2  85 10                STA     ptr
00102B  2  BD 47 10             LDA     note_hi,X
00102E  2  85 11                STA     ptr+1
001030  2  60                   RTS
001031  2               
001031  2               ;----------------------------------------------------------------
001031  2               ; Note period tables (16-bit AY tone periods), two+ octaves.
001031  2               ; Note numbers (1-based) used by the tracks:
001031  2               ;   1=C3  2=D3 3=E3 4=F3 5=G3 6=A3 7=B3
001031  2               ;   8=C4  9=D4 10=E4 11=F4 12=G4 13=A4 14=B4
001031  2               ;  15=C5 16=D5 17=E5 18=F5 19=G5 20=A5 21=B5
001031  2               ;  22=C6
001031  2               ; (a diatonic C-major set is plenty for a heroic theme)
001031  2               ;----------------------------------------------------------------
001031  2               note_lo:
001031  2  F0 82 20 F4          .BYTE   <1008, <898, <800, <756, <672, <600, <534; C3..B3
001035  2  A0 58 16     
001038  2  F8 C2 90 7A          .BYTE   <504,  <450, <400, <378, <336, <300, <267; C4..B4
00103C  2  50 2C 0B     
00103F  2  FC E1 C8 BD          .BYTE   <252,  <225, <200, <189, <168, <150, <133; C5..B5
001043  2  A8 96 85     
001046  2  7E                   .BYTE   <126            ; C6
001047  2               note_hi:
001047  2  03 03 03 02          .BYTE   >1008, >898, >800, >756, >672, >600, >534
00104B  2  02 02 02     
00104E  2  01 01 01 01          .BYTE   >504,  >450, >400, >378, >336, >300, >267
001052  2  01 01 01     
001055  2  00 00 00 00          .BYTE   >252,  >225, >200, >189, >168, >150, >133
001059  2  00 00 00     
00105C  2  00                   .BYTE   >126
00105D  2               
00105D  2               ; note name -> index defines for readable tracks
00105D  2               N_REST          = 0
00105D  2               C3              = 1
00105D  2               D3              = 2
00105D  2               E3              = 3
00105D  2               F3              = 4
00105D  2               G3              = 5
00105D  2               A3              = 6
00105D  2               B3              = 7
00105D  2               C4              = 8
00105D  2               D4              = 9
00105D  2               E4              = 10
00105D  2               F4              = 11
00105D  2               G4              = 12
00105D  2               A4              = 13
00105D  2               B4              = 14
00105D  2               C5              = 15
00105D  2               D5              = 16
00105D  2               E5              = 17
00105D  2               F5              = 18
00105D  2               G5              = 19
00105D  2               A5              = 20
00105D  2               B5              = 21
00105D  2               C6              = 22
00105D  2               
00105D  2               ;----------------------------------------------------------------
00105D  2               ; The theme: a stately heroic tune in C major, 3 voices.
00105D  2               ; Durations are in ticks; the three tracks are written so their
00105D  2               ; total lengths line up over each phrase.
00105D  2               ;----------------------------------------------------------------
00105D  2               
00105D  2               ; --- Channel A : lead melody ---
00105D  2               ; Every phrase line totals 16 ticks so the lead stays locked in step
00105D  2               ; with the 16-tick harmony (B) and bass (C) lines.  (Line 1 was 20
00105D  2               ; ticks before, which drifted B/C out of phase each loop.)
00105D  2               trackA:
00105D  2  0C 04 0F 04          .BYTE   G4,4,  C5,4,  E5,4,  G5,2,  E5,2; 16
001061  2  11 04 13 02  
001065  2  11 02        
001067  2  12 04 11 04          .BYTE   F5,4,  E5,4,  D5,8; 16
00106B  2  10 08        
00106D  2  11 04 13 04          .BYTE   E5,4,  G5,4,  C6,6,  B5,2; 16
001071  2  16 06 15 02  
001075  2  14 04 13 04          .BYTE   A5,4,  G5,4,  E5,8; 16
001079  2  11 08        
00107B  2  12 04 14 04          .BYTE   F5,4,  A5,4,  G5,4,  E5,4; 16
00107F  2  13 04 11 04  
001083  2  10 04 12 04          .BYTE   D5,4,  F5,4,  E5,8; 16
001087  2  11 08        
001089  2  0F 04 11 04          .BYTE   C5,4,  E5,4,  G5,4,  C6,4; 16
00108D  2  13 04 16 04  
001091  2  13 04 11 04          .BYTE   G5,4,  E5,4,  C5,8; 16
001095  2  0F 08        
001097  2  00 04                .BYTE   N_REST,4
001099  2  FF                   .BYTE   $FF
00109A  2               
00109A  2               ; --- Channel B : sustained harmony, one note per phrase line.
00109A  2               ;     To stay consonant under a diatonic melody we use the FIFTH of
00109A  2               ;     each chord (perfect fifths never clash), in octave 4.
00109A  2               ;     Chords per line:  C  G  C  Am  F  G  C  C
00109A  2               ;     Fifths:           G  D  G  E   C  D  G  G
00109A  2               trackB:
00109A  2  0C 10                .BYTE   G4,16           ; C chord  (5th = G)
00109C  2  09 10                .BYTE   D4,16           ; G chord  (5th = D)
00109E  2  0C 10                .BYTE   G4,16           ; C chord
0010A0  2  0A 10                .BYTE   E4,16           ; Am chord (5th = E)
0010A2  2  08 10                .BYTE   C4,16           ; F chord  (5th = C)
0010A4  2  09 10                .BYTE   D4,16           ; G chord
0010A6  2  0C 10                .BYTE   G4,16           ; C chord
0010A8  2  0C 10                .BYTE   G4,16           ; C chord
0010AA  2  00 04                .BYTE   N_REST,4
0010AC  2  FF                   .BYTE   $FF
0010AD  2               
0010AD  2               ; --- Channel C : bass - the ROOT of each chord, re-struck halfway
0010AD  2               ;     for a gentle pulse.  Same progression: C G C Am F G C C
0010AD  2               trackC:
0010AD  2  01 08 01 08          .BYTE   C3,8,  C3,8     ; C
0010B1  2  05 08 05 08          .BYTE   G3,8,  G3,8     ; G
0010B5  2  01 08 01 08          .BYTE   C3,8,  C3,8     ; C
0010B9  2  06 08 06 08          .BYTE   A3,8,  A3,8     ; Am
0010BD  2  04 08 04 08          .BYTE   F3,8,  F3,8     ; F
0010C1  2  05 08 05 08          .BYTE   G3,8,  G3,8     ; G
0010C5  2  01 08 01 08          .BYTE   C3,8,  C3,8     ; C
0010C9  2  01 08 01 08          .BYTE   C3,8,  C3,8     ; C
0010CD  2  00 04                .BYTE   N_REST,4
0010CF  2  FF                   .BYTE   $FF
0010D0  2               
0010D0  1                       .INCLUDE "tiles.asm"
0010D0  2               ;______________________________________________________________________________
0010D0  2               ;  tiles.asm - custom 8x8 character bitmaps for terrain, items, monsters
0010D0  2               ;
0010D0  2               ;  The memory-mapped video card has a writable character generator.
0010D0  2               ;  To redefine character N (see V_PATTERN in dbasic/screencmds.asm):
0010D0  2               ;     1. map video sub-page $F8 (VIDEOBANK) into CPU bank $A
0010D0  2               ;     2. write N to VideoCharGenOffset ($A002)
0010D0  2               ;     3. write 8 scanline bytes to VideoCharGenData ($A003)
0010D0  2               ;        (the hardware auto-advances through the 8 rows of the glyph)
0010D0  2               ;
0010D0  2               ;  Each bitmap is authored as 8 bytes, top row first, with bit7 as
0010D0  2               ;  the leftmost pixel. The video character generator displays bit0
0010D0  2               ;  on the left, so chargen_init reverses each scanline before upload.
0010D0  2               ;  Small title glyphs use control codes 1..31. Gameplay metatiles
0010D0  2               ;  use $80..$DF. Printable ASCII used by the UI remains intact.
0010D0  2               ;______________________________________________________________________________
0010D0  2               
0010D0  2               VideoCharGenOffset = $A002
0010D0  2               VideoCharGenData = $A003
0010D0  2               
0010D0  2               ;----------------------------------------------------------------
0010D0  2               ; cg_enter / cg_exit - map the character-generator RAM (page $F8)
0010D0  2               ; into bank $A and select task 1 (mirrors PAGE_ENTER/PAGE_EXIT).
0010D0  2               ;----------------------------------------------------------------
0010D0  2               cg_enter:
0010D0  2  A9 01                LDA     #$01            ; task 01 (driver)
0010D2  2  A2 0A                LDX     #$0A            ; CPU bank $A
0010D4  2  A0 F8                LDY     #VIDEOBANK      ; physical page $F8 (char generator)
0010D6  2  20 F6 FF             JSR     SETPAGE
0010D9  2  A9 01                LDA     #$01
0010DB  2  8D E0 EF             STA     PC6502_ACT_TASK
0010DE  2  60                   RTS
0010DF  2               cg_exit:
0010DF  2  A9 00                LDA     #$00
0010E1  2  8D E0 EF             STA     PC6502_ACT_TASK
0010E4  2  60                   RTS
0010E5  2               
0010E5  2               ;----------------------------------------------------------------
0010E5  2               ; reverse_glyph_byte - convert authored bit7-left rows to the
0010E5  2               ; character generator's bit0-left display order.
0010E5  2               ;   IN/OUT: A = scanline byte
0010E5  2               ;   trashes X,tmp0; preserves Y
0010E5  2               ;----------------------------------------------------------------
0010E5  2               reverse_glyph_byte:
0010E5  2  85 20                STA     tmp0
0010E7  2  A9 00                LDA     #0
0010E9  2  A2 08                LDX     #8
0010EB  2               @bit:
0010EB  2  46 20                LSR     tmp0
0010ED  2  2A                   ROL     A
0010EE  2  CA                   DEX
0010EF  2  D0 FA                BNE     @bit
0010F1  2  60                   RTS
0010F2  2               
0010F2  2               ;----------------------------------------------------------------
0010F2  2               ; chargen_init - upload every custom glyph bitmap.
0010F2  2               ;
0010F2  2               ; Driven by a table of (charcode, 8 bytes) records.  The table ends
0010F2  2               ; with a $00 charcode marker (code 0 is never one of ours).
0010F2  2               ;----------------------------------------------------------------
0010F2  2               chargen_init:
0010F2  2  20 D0 10             JSR     cg_enter
0010F5  2  A9 28 85 18          SETW16  srcp, glyphtab
0010F9  2  A9 11 85 19  
0010FD  2               @rec:
0010FD  2  A0 00                LDY     #0
0010FF  2  B1 18                LDA     (srcp),Y        ; char code
001101  2  F0 22                BEQ     @done           ; 0 = end of table
001103  2  8D 02 A0             STA     VideoCharGenOffset
001106  2               ; write the 8 scanline bytes
001106  2  A0 01                LDY     #1
001108  2               @row:
001108  2  B1 18                LDA     (srcp),Y
00110A  2  20 E5 10             JSR     reverse_glyph_byte
00110D  2  8D 03 A0             STA     VideoCharGenData
001110  2  C8                   INY
001111  2  C0 09                CPY     #9
001113  2  D0 F3                BNE     @row
001115  2               ; advance srcp by 9 (1 code + 8 data)
001115  2  18                   CLC
001116  2  A5 18                LDA     srcp
001118  2  69 09                ADC     #9
00111A  2  85 18                STA     srcp
00111C  2  A5 19                LDA     srcp+1
00111E  2  69 00                ADC     #0
001120  2  85 19                STA     srcp+1
001122  2  4C FD 10             JMP     @rec
001125  2               @done:
001125  2  4C DF 10             JMP     cg_exit
001128  2               
001128  2               ;----------------------------------------------------------------
001128  2               ; Glyph bitmap table: each row is  code, b0..b7
001128  2               ;----------------------------------------------------------------
001128  2               glyphtab:
001128  2               
