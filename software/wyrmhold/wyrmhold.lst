003FCB  2  A5 2E                LDA     tgttile
003FCD  2  C9 07                CMP     #T_ROAD
003FCF  2  F0 1A                BEQ     @road
003FD1  2  C9 08                CMP     #T_BRIDGE
003FD3  2  F0 16                BEQ     @road
003FD5  2  C9 01                CMP     #T_FOREST
003FD7  2  F0 1C                BEQ     @forest
