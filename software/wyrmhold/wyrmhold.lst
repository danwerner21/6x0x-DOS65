0015C7  3  40 04 00 00  
0015CB  3  10           
0015CC  3  E6 10 00 00          .BYTE   MGV_FOREST+2, %00010000,%00000000,%00000000,%00000010,%00000000,%01001000,%00000000,%00000000
0015D0  3  02 00 48 00  
0015D4  3  00           
0015D5  3  E7 00 20 04          .BYTE   MGV_FOREST+3, %00000000,%00100000,%00000100,%00000000,%00000000,%01000100,%00000000,%00000000
0015D9  3  00 00 44 00  
