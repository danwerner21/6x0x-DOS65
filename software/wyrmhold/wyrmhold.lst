0011D8  2  00                   .BYTE   %00000000
0011D9  2               
0011D9  2               ; road: a faint dashed path
0011D9  2  08                   .BYTE   G_ROAD
0011DA  2  3C                   .BYTE   %00111100
0011DB  2  7E                   .BYTE   %01111110
