005D10  2  20 F9 3D     
005D13  2  A9 AA A0 5E          PRINTMSG_MSG c_reminder2
005D17  2  20 F9 3D     
005D1A  2  60                   RTS
005D1B  2               @unlock:
005D1B  2  A9 03                LDA     #QUEST_DUNG_OPEN
005D1D  2  8D 21 62             STA     queststate
005D20  2               ; royal reward: full healing and fresh provisions
005D20  2  AD 0F 62             LDA     pmaxhp
005D23  2  8D 0E 62             STA     phealth
005D26  2  A9 00                LDA     #0
005D28  2  8D 23 62             STA     poison_turns
005D2B  2  18                   CLC
