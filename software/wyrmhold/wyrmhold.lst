00125A  1                       .INCLUDE "world.asm"
00125A  2               ;______________________________________________________________________________
00125A  2               ;  world.asm - map data, tile property tables and lookup helpers
00125A  2               ;
00125A  2               ;  Maps are authored as ASCII rows for readability and converted to
00125A  2               ;  tile codes once at startup (map_decode).  The decoded tile grids
00125A  2               ;  live in RAM (owmap / locmap).  Authoring characters:
00125A  2               ;     . grass   & forest  ^ mountain  ~ water   T town    O dungeon
00125A  2               ;     # castle  : road     = bridge    space->grass
00125A  2               ;  For interiors (town/dungeon):
00125A  2               ;     . floor   # wall     + door(exit)  $ treasure  < stairs up
00125A  2               ;     S shop    ~ water
00125A  2               ;______________________________________________________________________________
00125A  2               
00125A  2               ;----------------------------------------------------------------
00125A  2               ; Tile glyph table  (tile code -> ASCII char)
00125A  2               ;----------------------------------------------------------------
00125A  2               tile_glyph:
00125A  2  01                   .BYTE   G_GRASS         ; 0  T_GRASS
00125B  2  02                   .BYTE   G_FOREST        ; 1  T_FOREST
00125C  2  03                   .BYTE   G_MOUNT         ; 2  T_MOUNT
00125D  2  04                   .BYTE   G_WATER         ; 3  T_WATER
00125E  2  05                   .BYTE   G_TOWN          ; 4  T_TOWN
00125F  2  06                   .BYTE   G_DUNG          ; 5  T_DUNG
001260  2  07                   .BYTE   G_CASTLE        ; 6  T_CASTLE
001261  2  08                   .BYTE   G_ROAD          ; 7  T_ROAD
001262  2  09                   .BYTE   G_BRIDGE        ; 8  T_BRIDGE
001263  2  0A                   .BYTE   G_FLOOR         ; 9  T_FLOOR
001264  2  0B                   .BYTE   G_WALL          ; 10 T_WALL
001265  2  0C                   .BYTE   G_DOOR          ; 11 T_DOOR
001266  2  0D                   .BYTE   G_TREAS         ; 12 T_TREAS
001267  2  0E                   .BYTE   G_UPSTAIR       ; 13 T_UPSTAIR
001268  2  0F                   .BYTE   G_SHOP          ; 14 T_SHOP
001269  2               
001269  2               ;----------------------------------------------------------------
001269  2               ; Tile color table  (tile code -> color byte)
001269  2               ;----------------------------------------------------------------
001269  2               tile_color:
001269  2  0A                   .BYTE   C_GRASS         ; 0
00126A  2  02                   .BYTE   C_FOREST        ; 1
00126B  2  08                   .BYTE   C_MOUNT         ; 2
00126C  2  4C                   .BYTE   C_WATER         ; 3
00126D  2  0B                   .BYTE   C_TOWN          ; 4
00126E  2  0D                   .BYTE   C_DUNG          ; 5
00126F  2  0F                   .BYTE   C_CASTLE        ; 6
001270  2  0B                   .BYTE   C_ROAD          ; 7
001271  2  03                   .BYTE   C_BRIDGE        ; 8
001272  2  08                   .BYTE   C_FLOOR         ; 9
001273  2  8F                   .BYTE   C_WALL          ; 10
001274  2  A0                   .BYTE   C_EXIT          ; 11 door (bright = exit)
001275  2  0B                   .BYTE   C_TREAS         ; 12
001276  2  A0                   .BYTE   C_EXIT          ; 13 stairs (bright = exit)
001277  2  0B                   .BYTE   C_TOWN          ; 14 shop
001278  2               
001278  2               ;----------------------------------------------------------------
001278  2               ; Tile property table  (tile code -> property bits)
001278  2               ;   bit0 PASS    passable on foot
001278  2               ;   bit1 WATER   water (impassable without ship)
001278  2               ;   bit2 TOWN    stepping here enters a town
001278  2               ;   bit3 DUNG    stepping here enters the dungeon
001278  2               ;   bit4 EXIT    stepping here leaves the interior (town/dungeon)
001278  2               ;   bit5 TREAS   treasure to collect
001278  2               ;   bit6 SHOP    shop counter (open shop when adjacent/entering)
001278  2               ;----------------------------------------------------------------
001278  2               P_PASS          = $01
001278  2               P_WATER         = $02
001278  2               P_TOWN          = $04
001278  2               P_DUNG          = $08
001278  2               P_EXIT          = $10
001278  2               P_TREAS         = $20
001278  2               P_SHOP          = $40
001278  2               
001278  2               tile_prop:
001278  2  01                   .BYTE   P_PASS                  ; 0 grass
001279  2  01                   .BYTE   P_PASS                  ; 1 forest (passable, slow flavor)
00127A  2  00                   .BYTE   $00                     ; 2 mountain (blocked)
00127B  2  02                   .BYTE   P_WATER                 ; 3 water (blocked on foot)
00127C  2  05                   .BYTE   P_PASS|P_TOWN           ; 4 town
00127D  2  09                   .BYTE   P_PASS|P_DUNG           ; 5 dungeon
00127E  2  00                   .BYTE   $00                     ; 6 castle (blocked, decorative)
00127F  2  01                   .BYTE   P_PASS                  ; 7 road
001280  2  01                   .BYTE   P_PASS                  ; 8 bridge
001281  2  01                   .BYTE   P_PASS                  ; 9 floor
001282  2  00                   .BYTE   $00                     ; 10 wall
001283  2  11                   .BYTE   P_PASS|P_EXIT           ; 11 door (exit interior)
001284  2  21                   .BYTE   P_PASS|P_TREAS          ; 12 treasure
001285  2  11                   .BYTE   P_PASS|P_EXIT           ; 13 stairs up (exit dungeon)
001286  2  41                   .BYTE   P_PASS|P_SHOP           ; 14 shop
001287  2               
001287  2               ;----------------------------------------------------------------
001287  2               ; Authoring char -> tile code translation (used by map_decode).
001287  2               ; Two parallel tables: chars[] and codes[], terminated by $00.
001287  2               ; (Distinct chars only; '#' = wall by default. The overworld uses
001287  2               ;  'C' for the decorative castle so it does not collide with walls.)
001287  2               ;----------------------------------------------------------------
001287  2               dec_chars:
001287  2  2E 26 5E 7E          .BYTE   ".&^~TOC:=#+$<S", $00
00128B  2  54 4F 43 3A  
00128F  2  3D 23 2B 24  
001296  2               dec_codes:
001296  2  00                   .BYTE   T_GRASS         ; .
001297  2  01                   .BYTE   T_FOREST        ; &
001298  2  02                   .BYTE   T_MOUNT         ; ^
001299  2  03                   .BYTE   T_WATER         ; ~
00129A  2  04                   .BYTE   T_TOWN          ; T
00129B  2  05                   .BYTE   T_DUNG          ; O
00129C  2  06                   .BYTE   T_CASTLE        ; C
00129D  2  07                   .BYTE   T_ROAD          ; :
00129E  2  08                   .BYTE   T_BRIDGE        ; =
00129F  2  0A                   .BYTE   T_WALL          ; #
0012A0  2  0B                   .BYTE   T_DOOR          ; +
0012A1  2  0C                   .BYTE   T_TREAS         ; $
0012A2  2  0D                   .BYTE   T_UPSTAIR       ; <
0012A3  2  0E                   .BYTE   T_SHOP          ; S
0012A4  2               
0012A4  2               ; map a single authoring char (A) to a tile code -> A
0012A4  2               xlate_char:
0012A4  2  85 20                STA     tmp0
0012A6  2  A2 00                LDX     #0
0012A8  2               @f:
0012A8  2  BD 87 12             LDA     dec_chars,X
0012AB  2  F0 07                BEQ     @nf
0012AD  2  C5 20                CMP     tmp0
0012AF  2  F0 06                BEQ     @ok
0012B1  2  E8                   INX
0012B2  2  D0 F4                BNE     @f
0012B4  2               @nf:
0012B4  2  A9 00                LDA     #T_GRASS
0012B6  2  60                   RTS
0012B7  2               @ok:
0012B7  2  BD 96 12             LDA     dec_codes,X
0012BA  2  60                   RTS
0012BB  2               
0012BB  2               ;----------------------------------------------------------------
0012BB  2               ; map_decode - translate an authored ASCII map into a tile grid,
0012BB  2               ; row by row.  Each source row is a NUL-terminated string.  Rows
0012BB  2               ; shorter than the map width are padded with grass; longer rows are
0012BB  2               ; truncated.  This makes exact source-row width unimportant.
0012BB  2               ;
0012BB  2               ;   IN : srcp -> first source row (rows packed back-to-back, each
0012BB  2               ;                NUL-terminated)
0012BB  2               ;        dstp -> destination tile-code buffer (width*height bytes)
0012BB  2               ;        tmp2 =  map width   (<=255)
0012BB  2               ;        tmp3 =  map height  (<=255)
0012BB  2               ;----------------------------------------------------------------
0012BB  2               ; NOTE: the column counter is kept in cnt0 (memory), NOT in X,
0012BB  2               ; because xlate_char clobbers X (it uses X as a search index).
0012BB  2               map_decode:
0012BB  2  A9 00                LDA     #0
0012BD  2  85 27                STA     rowidx          ; row counter
0012BF  2               @nextrow:
0012BF  2  A5 27                LDA     rowidx
0012C1  2  C5 23                CMP     tmp3
0012C3  2  B0 59                BCS     @done
0012C5  2  A9 00                LDA     #0
0012C7  2  85 24                STA     cnt0            ; column within row
0012C9  2               @col:
0012C9  2  A5 24                LDA     cnt0
0012CB  2  C5 22                CMP     tmp2
0012CD  2  B0 1E                BCS     @rowfull
0012CF  2                       ; cnt0 tracks column for width logic; srcp is the read head.
0012CF  2  A0 00                LDY     #0
0012D1  2  B1 18                LDA     (srcp),Y
0012D3  2  F0 27                BEQ     @padrow         ; early NUL -> pad rest with grass
0012D5  2  20 A4 12             JSR     xlate_char      ; A=tile code (clobbers X)
0012D8  2  A0 00                LDY     #0
0012DA  2  91 1A                STA     (dstp),Y
0012DC  2                       ; advance read head and dest
0012DC  2  E6 18                INC     srcp
0012DE  2  D0 02                BNE     :+
0012E0  2  E6 19                INC     srcp+1
0012E2  2               :
0012E2  2  E6 1A                INC     dstp
0012E4  2  D0 02                BNE     :+
0012E6  2  E6 1B                INC     dstp+1
0012E8  2               :
0012E8  2  E6 24                INC     cnt0
0012EA  2  4C C9 12             JMP     @col
0012ED  2               @rowfull:
0012ED  2                       ; consume any extra source chars up to the terminating NUL
0012ED  2               @skip:
0012ED  2  A0 00                LDY     #0
0012EF  2  B1 18                LDA     (srcp),Y
0012F1  2  F0 20                BEQ     @aftrow
0012F3  2  E6 18                INC     srcp
0012F5  2  D0 F6                BNE     @skip
0012F7  2  E6 19                INC     srcp+1
0012F9  2  4C ED 12             JMP     @skip
0012FC  2               @padrow:
0012FC  2                       ; fill remaining columns (cnt0..width-1) with grass in dest
0012FC  2               @pad:
0012FC  2  A5 24                LDA     cnt0
0012FE  2  C5 22                CMP     tmp2
001300  2  B0 11                BCS     @aftrow
001302  2  A9 00                LDA     #T_GRASS
001304  2  A0 00                LDY     #0
001306  2  91 1A                STA     (dstp),Y
001308  2  E6 1A                INC     dstp
00130A  2  D0 02                BNE     :+
00130C  2  E6 1B                INC     dstp+1
00130E  2               :
00130E  2  E6 24                INC     cnt0
001310  2  4C FC 12             JMP     @pad
001313  2               @aftrow:
001313  2                       ; step srcp past the row terminator NUL
001313  2  E6 18                INC     srcp
001315  2  D0 02                BNE     :+
001317  2  E6 19                INC     srcp+1
001319  2               :
001319  2  E6 27                INC     rowidx
00131B  2  4C BF 12             JMP     @nextrow
00131E  2               @done:
00131E  2  60                   RTS
00131F  2               
00131F  2               ;----------------------------------------------------------------
00131F  2               ; decode_world / decode_town / decode_dung - convenience wrappers
00131F  2               ;----------------------------------------------------------------
00131F  2               decode_world:
00131F  2  A9 9A 85 18          SETW16  srcp, ow_src
001323  2  A9 14 85 19  
001327  2  A9 20 85 1A          SETW16  dstp, owmap
00132B  2  A9 3C 85 1B  
00132F  2  A9 40                LDA     #OWW
001331  2  85 22                STA     tmp2
001333  2  A9 40                LDA     #OWH
001335  2  85 23                STA     tmp3
001337  2  4C BB 12             JMP     map_decode
00133A  2               
00133A  2               decode_town:
00133A  2  A9 5A 85 18          SETW16  srcp, town_src
00133E  2  A9 25 85 19  
001342  2  A9 20 85 1A          SETW16  dstp, locmap
001346  2  A9 4C 85 1B  
00134A  2  A9 20                LDA     #TOWNW
00134C  2  85 22                STA     tmp2
00134E  2  A9 14                LDA     #TOWNH
001350  2  85 23                STA     tmp3
001352  2  4C BB 12             JMP     map_decode
001355  2               
001355  2               decode_dung:
001355  2  A9 EE 85 18          SETW16  srcp, dung_src
001359  2  A9 27 85 19  
00135D  2  A9 20 85 1A          SETW16  dstp, locmap
001361  2  A9 4C 85 1B  
001365  2  A9 20                LDA     #DUNGW
001367  2  85 22                STA     tmp2
001369  2  A9 14                LDA     #DUNGH
00136B  2  85 23                STA     tmp3
00136D  2  4C BB 12             JMP     map_decode
001370  2               
001370  2               ;----------------------------------------------------------------
001370  2               ; tileat - read the tile code at (tgtx,tgty) from the ACTIVE map.
001370  2               ;   IN : tgtx, tgty ; loc (LOC_*) selects map + width
001370  2               ;   OUT: A = tile code, also stored in tgttile
001370  2               ;        if out of bounds -> returns T_WATER (overworld) / T_WALL (int)
001370  2               ;   Trashes ptr, tmp0, tmp1
001370  2               ;----------------------------------------------------------------
001370  2               tileat:
001370  2  AD DD 3A             LDA     loc
001373  2  D0 52                BNE     @interior
001375  2               ;--- overworld ---
001375  2                       ; bounds check 0..OWW-1 / 0..OWH-1
001375  2  A5 2C                LDA     tgtx
001377  2  C9 40                CMP     #OWW
001379  2  B0 47                BCS     @oob_world
00137B  2  A5 2D                LDA     tgty
00137D  2  C9 40                CMP     #OWH
00137F  2  B0 41                BCS     @oob_world
001381  2                       ; offset = tgty*OWW + tgtx  (OWW=64 -> *64)
001381  2  A5 2D                LDA     tgty
001383  2  85 10                STA     ptr
001385  2  A9 00                LDA     #0
001387  2  85 11                STA     ptr+1
001389  2  06 10                ASL     ptr
00138B  2  26 11                ROL     ptr+1           ; *2
00138D  2  06 10                ASL     ptr
00138F  2  26 11                ROL     ptr+1           ; *4
001391  2  06 10                ASL     ptr
001393  2  26 11                ROL     ptr+1           ; *8
001395  2  06 10                ASL     ptr
001397  2  26 11                ROL     ptr+1           ; *16
001399  2  06 10                ASL     ptr
00139B  2  26 11                ROL     ptr+1           ; *32
00139D  2  06 10                ASL     ptr
00139F  2  26 11                ROL     ptr+1           ; *64
0013A1  2  18                   CLC
0013A2  2  A5 10                LDA     ptr
0013A4  2  65 2C                ADC     tgtx
0013A6  2  85 10                STA     ptr
0013A8  2  A5 11                LDA     ptr+1
0013AA  2  69 00                ADC     #0
0013AC  2  85 11                STA     ptr+1
0013AE  2                       ; ptr += owmap base
0013AE  2  18                   CLC
0013AF  2  A5 10                LDA     ptr
0013B1  2  69 20                ADC     #<owmap
0013B3  2  85 10                STA     ptr
0013B5  2  A5 11                LDA     ptr+1
0013B7  2  69 3C                ADC     #>owmap
0013B9  2  85 11                STA     ptr+1
0013BB  2  A0 00                LDY     #0
0013BD  2  B1 10                LDA     (ptr),Y
0013BF  2  85 2E                STA     tgttile
0013C1  2  60                   RTS
0013C2  2               @oob_world:
0013C2  2  A9 03                LDA     #T_WATER
0013C4  2  85 2E                STA     tgttile
0013C6  2  60                   RTS
0013C7  2               ;--- interior (town/dungeon): width = locw, height = loch ---
0013C7  2               @interior:
0013C7  2  A5 2C                LDA     tgtx
0013C9  2  CD DE 3A             CMP     locw
0013CC  2  B0 44                BCS     @oob_int
0013CE  2  A5 2D                LDA     tgty
0013D0  2  CD DF 3A             CMP     loch
0013D3  2  B0 3D                BCS     @oob_int
0013D5  2                       ; offset = tgty*locw + tgtx  (locw is 32)
0013D5  2  A5 2D                LDA     tgty
0013D7  2  85 10                STA     ptr
0013D9  2  A9 00                LDA     #0
0013DB  2  85 11                STA     ptr+1
0013DD  2  06 10                ASL     ptr
0013DF  2  26 11                ROL     ptr+1           ; *2
0013E1  2  06 10                ASL     ptr
0013E3  2  26 11                ROL     ptr+1           ; *4
0013E5  2  06 10                ASL     ptr
0013E7  2  26 11                ROL     ptr+1           ; *8
0013E9  2  06 10                ASL     ptr
0013EB  2  26 11                ROL     ptr+1           ; *16
0013ED  2  06 10                ASL     ptr
0013EF  2  26 11                ROL     ptr+1           ; *32  (locw assumed 32)
0013F1  2  18                   CLC
0013F2  2  A5 10                LDA     ptr
0013F4  2  65 2C                ADC     tgtx
0013F6  2  85 10                STA     ptr
0013F8  2  A5 11                LDA     ptr+1
0013FA  2  69 00                ADC     #0
0013FC  2  85 11                STA     ptr+1
0013FE  2  18                   CLC
0013FF  2  A5 10                LDA     ptr
001401  2  69 20                ADC     #<locmap
001403  2  85 10                STA     ptr
001405  2  A5 11                LDA     ptr+1
001407  2  69 4C                ADC     #>locmap
001409  2  85 11                STA     ptr+1
00140B  2  A0 00                LDY     #0
00140D  2  B1 10                LDA     (ptr),Y
00140F  2  85 2E                STA     tgttile
001411  2  60                   RTS
001412  2               @oob_int:
001412  2  A9 0A                LDA     #T_WALL
001414  2  85 2E                STA     tgttile
001416  2  60                   RTS
001417  2               
001417  2               ;----------------------------------------------------------------
001417  2               ; settile - write tile code A at (tgtx,tgty) in the active map.
001417  2               ;   Used to clear treasure chests once collected, etc.
001417  2               ;   Recomputes the address exactly like tileat.
001417  2               ;----------------------------------------------------------------
001417  2               settile:
001417  2  85 21                STA     tmp1            ; new tile
001419  2  20 23 14             JSR     tile_addr       ; ptr -> cell
00141C  2  A0 00                LDY     #0
00141E  2  A5 21                LDA     tmp1
001420  2  91 10                STA     (ptr),Y
001422  2  60                   RTS
001423  2               
001423  2               ; tile_addr - compute ptr -> active-map cell for (tgtx,tgty).
001423  2               ; (assumes in-bounds; callers that might be OOB use tileat first)
001423  2               tile_addr:
001423  2  AD DD 3A             LDA     loc
001426  2  D0 3B                BNE     @int
001428  2  A5 2D                LDA     tgty
00142A  2  85 10                STA     ptr
00142C  2  A9 00                LDA     #0
00142E  2  85 11                STA     ptr+1
001430  2  06 10                ASL     ptr
001432  2  26 11                ROL     ptr+1
001434  2  06 10                ASL     ptr
001436  2  26 11                ROL     ptr+1
001438  2  06 10                ASL     ptr
00143A  2  26 11                ROL     ptr+1
00143C  2  06 10                ASL     ptr
00143E  2  26 11                ROL     ptr+1
001440  2  06 10                ASL     ptr
001442  2  26 11                ROL     ptr+1
001444  2  06 10                ASL     ptr
001446  2  26 11                ROL     ptr+1           ; *64
001448  2  18                   CLC
001449  2  A5 10                LDA     ptr
00144B  2  65 2C                ADC     tgtx
00144D  2  85 10                STA     ptr
00144F  2  A5 11                LDA     ptr+1
001451  2  69 00                ADC     #0
001453  2  85 11                STA     ptr+1
001455  2  18                   CLC
001456  2  A5 10                LDA     ptr
001458  2  69 20                ADC     #<owmap
00145A  2  85 10                STA     ptr
00145C  2  A5 11                LDA     ptr+1
00145E  2  69 3C                ADC     #>owmap
001460  2  85 11                STA     ptr+1
001462  2  60                   RTS
001463  2               @int:
001463  2  A5 2D                LDA     tgty
001465  2  85 10                STA     ptr
001467  2  A9 00                LDA     #0
001469  2  85 11                STA     ptr+1
00146B  2  06 10                ASL     ptr
00146D  2  26 11                ROL     ptr+1
00146F  2  06 10                ASL     ptr
001471  2  26 11                ROL     ptr+1
001473  2  06 10                ASL     ptr
001475  2  26 11                ROL     ptr+1
001477  2  06 10                ASL     ptr
001479  2  26 11                ROL     ptr+1
00147B  2  06 10                ASL     ptr
00147D  2  26 11                ROL     ptr+1           ; *32
00147F  2  18                   CLC
001480  2  A5 10                LDA     ptr
001482  2  65 2C                ADC     tgtx
001484  2  85 10                STA     ptr
001486  2  A5 11                LDA     ptr+1
001488  2  69 00                ADC     #0
00148A  2  85 11                STA     ptr+1
00148C  2  18                   CLC
00148D  2  A5 10                LDA     ptr
00148F  2  69 20                ADC     #<locmap
001491  2  85 10                STA     ptr
001493  2  A5 11                LDA     ptr+1
001495  2  69 4C                ADC     #>locmap
001497  2  85 11                STA     ptr+1
001499  2  60                   RTS
00149A  2               
00149A  2               ;----------------------------------------------------------------
00149A  2               ; Authored overworld map (64 x 64).
00149A  2               ; Surrounded by water; a central continent with two towns, a
00149A  2               ; castle, the dungeon entrance, forests, mountains and a river
00149A  2               ; crossed by a bridge.
00149A  2               ;----------------------------------------------------------------
00149A  2               ; Maps are stored as NUL-terminated rows.  The decoder pads short
00149A  2               ; rows with grass and truncates long ones, so the exact authored
00149A  2               ; width of each row is not critical (target widths shown in the
00149A  2               ; header rulers for readability).
00149A  2               ow_src:
00149A  2                       ;        0         1         2         3         4         5         6
00149A  2                       ;        0123456789012345678901234567890123456789012345678901234567890123
00149A  2  7E 7E 7E 7E          .BYTE   "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~",0
00149E  2  7E 7E 7E 7E  
0014A2  2  7E 7E 7E 7E  
0014DF  2  7E 2E 2E 2E          .BYTE   "~..............................................................~~",0
0014E3  2  2E 2E 2E 2E  
0014E7  2  2E 2E 2E 2E  
001521  2  7E 2E 2E 26          .BYTE   "~..&&&......^^^^.........&&&&&...........^^^...........&&&.....~~~",0
001525  2  26 26 2E 2E  
001529  2  2E 2E 2E 2E  
001564  2  7E 2E 26 26          .BYTE   "~.&&&&&....^^^^^^.......&&&&&&&.........^^^^^.........&&&&&....~~~~",0
001568  2  26 26 26 2E  
00156C  2  2E 2E 2E 5E  
0015A8  2  7E 2E 26 26          .BYTE   "~.&&&......^^^^^^^.....&&&...&&........^^^^^^........&&&&&&&...~~~~",0
0015AC  2  26 2E 2E 2E  
0015B0  2  2E 2E 2E 5E  
0015EC  2  7E 2E 2E 26          .BYTE   "~..&.......^^^^^^.....&&.......&&......^^^^^.........&&&&&....~~~~~",0
0015F0  2  2E 2E 2E 2E  
0015F4  2  2E 2E 2E 5E  
001630  2  7E 2E 2E 2E          .BYTE   "~.........^^^^.......&&.........&......^^^...........&&&......~~~~~",0
001634  2  2E 2E 2E 2E  
001638  2  2E 2E 5E 5E  
001674  2  7E 2E 2E 2E          .BYTE   "~....................................................T.......~~~~~",0
001678  2  2E 2E 2E 2E  
00167C  2  2E 2E 2E 2E  
0016B7  2  7E 2E 2E 2E          .BYTE   "~...............:::::::::::....................::::::::......~~~~~~",0
0016BB  2  2E 2E 2E 2E  
0016BF  2  2E 2E 2E 2E  
0016FB  2  7E 2E 2E 26          .BYTE   "~..&&......^^^..:..............:::::::::::::::::.......:.....~~~~~~",0
0016FF  2  26 2E 2E 2E  
001703  2  2E 2E 2E 5E  
00173F  2  7E 2E 26 26          .BYTE   "~.&&&&....^^^^^.:..............................:......:.....~~~~~~",0
001743  2  26 26 2E 2E  
001747  2  2E 2E 5E 5E  
001782  2  7E 2E 26 26          .BYTE   "~.&&&....^^^^^^.:.............#####............:......:....~~~~~~~",0
