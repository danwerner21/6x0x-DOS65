000800  2               SHORTCUT_FOOD_COST = 20
000800  2               
000800  2               ; opening quest progression
000800  2               QUEST_NONE      = 0             ; seek the castle and speak with the ruler
000800  2               QUEST_FIND_KEY  = 1             ; recover the lost Wyrm Key
000800  2               QUEST_HAVE_KEY  = 2             ; return to the ruler with the key
000800  2               QUEST_DUNG_OPEN = 3             ; dragon's ward has been broken
