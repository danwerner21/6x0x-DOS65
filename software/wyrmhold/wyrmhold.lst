0033FB  2  A9 8F                LDA     #<mbuf
0033FD  2  A0 3B                LDY     #>mbuf
0033FF  2  4C 3C 2D             JMP     msg_print
003402  2               
003402  2               ;----------------------------------------------------------------
003402  2               ; player_attacks_monster - X = monster slot.
003402  2               ;   Damage = 1..(weapon_power) + small bonus.  Apply, possibly kill.
003402  2               ;----------------------------------------------------------------
003402  2               player_attacks_monster:
003402  2  86 2F                STX     monidx
003404  2                       ; damage roll: base from weapon
003404  2  AE DB 3A             LDX     pweapon
003407  2  BD 67 35             LDA     wpn_power,X
00340A  2  20 8F 0C             JSR     rng_d           ; 1..power
00340D  2  85 20                STA     tmp0            ; damage
00340F  2                       ; subtract from monster hp
00340F  2  A6 2F                LDX     monidx
003411  2  38                   SEC
003412  2  BD 14 3C             LDA     mon_hp,X
003415  2  E5 20                SBC     tmp0
003417  2  9D 14 3C             STA     mon_hp,X
00341A  2                       ; build "You hit the Orc for N!"
00341A  2  20 76 33             JSR     mb_reset
00341D  2  A9 A9                LDA     #<c_youhit
00341F  2  A0 35                LDY     #>c_youhit
003421  2  20 7C 33             JSR     mb_str
003424  2  A6 2F                LDX     monidx
003426  2  BD F0 3B             LDA     mon_type,X
003429  2  20 E8 33             JSR     mb_mname
00342C  2  A9 B6                LDA     #<c_for
00342E  2  A0 35                LDY     #>c_for
003430  2  20 7C 33             JSR     mb_str
003433  2  A5 20                LDA     tmp0
003435  2  20 93 33             JSR     mb_num
003438  2  A9 BC                LDA     #<c_bang
00343A  2  A0 35                LDY     #>c_bang
00343C  2  20 7C 33             JSR     mb_str
00343F  2  20 F3 33             JSR     mb_flush
003442  2  20 B4 0D             JSR     sfx_hit
003445  2                       ; dead?  (hp <= 0 i.e. hp was <= damage -> result negative/zero)
003445  2  A6 2F                LDX     monidx
003447  2  BD 14 3C             LDA     mon_hp,X
00344A  2  F0 03                BEQ     @dead
00344C  2  30 01                BMI     @dead
00344E  2  60                   RTS
00344F  2               @dead:
00344F  2  4C 52 34             JMP     monster_dies
003452  2               
003452  2               ;----------------------------------------------------------------
003452  2               ; monster_dies - award XP/gold, drop the slot, maybe win, maybe
003452  2               ; level up.  Slot in monidx.
003452  2               ;----------------------------------------------------------------
003452  2               monster_dies:
003452  2  A6 2F                LDX     monidx
003454  2  BD F0 3B             LDA     mon_type,X
003457  2  85 21                STA     tmp1            ; type
003459  2                       ; XP
003459  2  A8                   TAY
00345A  2  B9 CA 2F             LDA     mtype_xp,Y
00345D  2  18                   CLC
00345E  2  6D D5 3A             ADC     pxp
003461  2  8D D5 3A             STA     pxp
003464  2  AD D6 3A             LDA     pxp+1
003467  2  69 00                ADC     #0
003469  2  8D D6 3A             STA     pxp+1
00346C  2                       ; gold drop 0..mtype_gold
00346C  2  A4 21                LDY     tmp1
00346E  2  B9 D1 2F             LDA     mtype_gold,Y
003471  2  F0 12                BEQ     @nogold
003473  2  20 7F 0C             JSR     rng_mod         ; 0..gold-1
003476  2  18                   CLC
003477  2  6D D7 3A             ADC     pgold
00347A  2  8D D7 3A             STA     pgold
00347D  2  AD D8 3A             LDA     pgold+1
003480  2  69 00                ADC     #0
003482  2  8D D8 3A             STA     pgold+1
003485  2               @nogold:
003485  2                       ; message "The Orc dies!"
003485  2  20 76 33             JSR     mb_reset
003488  2  A9 BE                LDA     #<c_the
00348A  2  A0 35                LDY     #>c_the
00348C  2  20 7C 33             JSR     mb_str
00348F  2  A5 21                LDA     tmp1
003491  2  20 E8 33             JSR     mb_mname
003494  2  A9 C3                LDA     #<c_dies
003496  2  A0 35                LDY     #>c_dies
003498  2  20 7C 33             JSR     mb_str
00349B  2  20 F3 33             JSR     mb_flush
00349E  2  20 DF 0D             JSR     sfx_killed
0034A1  2                       ; remove monster
0034A1  2  A6 2F                LDX     monidx
0034A3  2  20 36 30             JSR     mon_kill
0034A6  2                       ; boss?
0034A6  2  A5 21                LDA     tmp1
0034A8  2  C9 06                CMP     #M_BOSS
0034AA  2  D0 05                BNE     @lvl
0034AC  2  A9 01                LDA     #1
0034AE  2  8D E2 3A             STA     bosskilled
0034B1  2               @lvl:
0034B1  2  20 B5 34             JSR     check_levelup
0034B4  2  60                   RTS
0034B5  2               
0034B5  2               ;----------------------------------------------------------------
0034B5  2               ; check_levelup - if xp >= level*20, level up (raise maxhp, heal).
0034B5  2               ;----------------------------------------------------------------
0034B5  2               check_levelup:
0034B5  2                       ; threshold = plevel * 20  (8-bit is enough up to lvl 12)
0034B5  2  AD D4 3A             LDA     plevel
0034B8  2  85 20                STA     tmp0
0034BA  2  A9 00                LDA     #0
0034BC  2  85 21                STA     tmp1
0034BE  2                       ; tmp = level*20 = level*16 + level*4
0034BE  2  AD D4 3A             LDA     plevel
0034C1  2  0A                   ASL     A
0034C2  2  0A                   ASL     A               ; *4
0034C3  2  85 22                STA     tmp2
0034C5  2  AD D4 3A             LDA     plevel
0034C8  2  0A                   ASL     A
0034C9  2  0A                   ASL     A
0034CA  2  0A                   ASL     A
0034CB  2  0A                   ASL     A               ; *16
0034CC  2  18                   CLC
0034CD  2  65 22                ADC     tmp2
0034CF  2  85 22                STA     tmp2            ; level*20 (low); ignore >255 (caps fine)
0034D1  2                       ; compare xp (16-bit) >= tmp2
0034D1  2  AD D6 3A             LDA     pxp+1
0034D4  2  D0 07                BNE     @levelup        ; xp >= 256 definitely past early thresholds
0034D6  2  AD D5 3A             LDA     pxp
0034D9  2  C5 22                CMP     tmp2
0034DB  2  90 2C                BCC     @done
0034DD  2               @levelup:
0034DD  2  EE D4 3A             INC     plevel
0034E0  2                       ; maxhp += 8, full heal
0034E0  2  AD D3 3A             LDA     pmaxhp
0034E3  2  18                   CLC
0034E4  2  69 08                ADC     #8
0034E6  2  8D D3 3A             STA     pmaxhp
0034E9  2  8D D2 3A             STA     phealth
0034EC  2  20 33 0E             JSR     sfx_levelup
0034EF  2  20 76 33             JSR     mb_reset
0034F2  2  A9 D9                LDA     #<c_levelup
0034F4  2  A0 35                LDY     #>c_levelup
0034F6  2  20 7C 33             JSR     mb_str
0034F9  2  AD D4 3A             LDA     plevel
0034FC  2  20 93 33             JSR     mb_num
0034FF  2  A9 BC                LDA     #<c_bang
003501  2  A0 35                LDY     #>c_bang
003503  2  20 7C 33             JSR     mb_str
003506  2  20 F3 33             JSR     mb_flush
003509  2               @done:
003509  2  60                   RTS
00350A  2               
00350A  2               ;----------------------------------------------------------------
00350A  2               ; monster_attacks_player - monster in slot monidx strikes.
00350A  2               ;   Damage = 1..mtype_atk, reduced by armor.  Apply to phealth.
00350A  2               ;----------------------------------------------------------------
00350A  2               monster_attacks_player:
00350A  2  A6 2F                LDX     monidx
00350C  2  BD F0 3B             LDA     mon_type,X
00350F  2  85 21                STA     tmp1            ; type
003511  2  A8                   TAY
003512  2  B9 C3 2F             LDA     mtype_atk,Y
003515  2  20 8F 0C             JSR     rng_d           ; 1..atk
003518  2  85 20                STA     tmp0            ; raw damage
00351A  2                       ; armor reduces by armor index (0..3)
00351A  2  AE DC 3A             LDX     parmor
00351D  2  BD 6B 35             LDA     arm_def,X
003520  2  85 22                STA     tmp2
003522  2  38                   SEC
003523  2  A5 20                LDA     tmp0
003525  2  E5 22                SBC     tmp2
003527  2  10 02                BPL     @ok
003529  2  A9 01                LDA     #1              ; minimum 1 damage
00352B  2               @ok:
00352B  2  D0 02                BNE     @apply
00352D  2  A9 01                LDA     #1
00352F  2               @apply:
00352F  2  85 20                STA     tmp0
003531  2                       ; subtract from phealth (floor at 0)
003531  2  38                   SEC
003532  2  AD D2 3A             LDA     phealth
003535  2  E5 20                SBC     tmp0
003537  2  B0 02                BCS     @sethp
003539  2  A9 00                LDA     #0
00353B  2               @sethp:
00353B  2  8D D2 3A             STA     phealth
00353E  2                       ; message "Orc hits you for N!"
00353E  2  20 76 33             JSR     mb_reset
003541  2  A9 BE                LDA     #<c_the
003543  2  A0 35                LDY     #>c_the
003545  2  20 7C 33             JSR     mb_str
003548  2  A5 21                LDA     tmp1
00354A  2  20 E8 33             JSR     mb_mname
00354D  2  A9 CA                LDA     #<c_hitsyou
00354F  2  A0 35                LDY     #>c_hitsyou
003551  2  20 7C 33             JSR     mb_str
003554  2  A5 20                LDA     tmp0
003556  2  20 93 33             JSR     mb_num
003559  2  A9 BC                LDA     #<c_bang
00355B  2  A0 35                LDY     #>c_bang
00355D  2  20 7C 33             JSR     mb_str
003560  2  20 F3 33             JSR     mb_flush
003563  2  20 B4 0D             JSR     sfx_hit
003566  2  60                   RTS
003567  2               
003567  2               ;----------------------------------------------------------------
003567  2               ; Weapon power (damage sides) and armor defense tables
003567  2               ;----------------------------------------------------------------
003567  2               wpn_power:
003567  2  02                   .BYTE   2               ; 0 fists
003568  2  04                   .BYTE   4               ; 1 dagger
003569  2  07                   .BYTE   7               ; 2 sword
00356A  2  0A                   .BYTE   10              ; 3 axe
00356B  2               arm_def:
00356B  2  00                   .BYTE   0               ; 0 clothes
00356C  2  01                   .BYTE   1               ; 1 leather
00356D  2  02                   .BYTE   2               ; 2 chain
00356E  2  04                   .BYTE   4               ; 3 plate
