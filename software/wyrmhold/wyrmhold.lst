005CCD  2               ;______________________________________________________________________________
005CCD  2               ;  castle.asm - Wyrmhold Castle interaction and opening commission
005CCD  2               ;______________________________________________________________________________
005CCD  2               
005CCD  2               ;----------------------------------------------------------------
005CCD  2               ; castle_use - contextual USE action inside the audience chamber.
005CCD  2               ;----------------------------------------------------------------
005CCD  2               castle_use:
005CCD  2  20 6A 5D             JSR     ruler_adjacent
005CD0  2  B0 08                BCS     @ruler
005CD2  2  A9 C8 A0 5D          PRINTMSG_MSG c_approach
005CD6  2  20 F9 3D     
005CD9  2  60                   RTS
005CDA  2               @ruler:
005CDA  2  AD 21 62             LDA     queststate
005CDD  2  C9 00                CMP     #QUEST_NONE
005CDF  2  F0 14                BEQ     @commission
005CE1  2  C9 01                CMP     #QUEST_FIND_KEY
005CE3  2  F0 27                BEQ     @reminder
005CE5  2  C9 02                CMP     #QUEST_HAVE_KEY
005CE7  2  F0 32                BEQ     @unlock
005CE9  2  C9 04                CMP     #QUEST_DRAGON_DEAD
005CEB  2  F0 61                BEQ     @finale
005CED  2               ; QUEST_DUNG_OPEN while the dragon still lives
005CED  2  A9 50 A0 5F          PRINTMSG_MSG c_open
005CF1  2  20 F9 3D     
005CF4  2  60                   RTS
005CF5  2               @commission:
005CF5  2  A9 01                LDA     #QUEST_FIND_KEY
005CF7  2  8D 21 62             STA     queststate
005CFA  2  20 78 0F             JSR     sfx_levelup
005CFD  2  A9 F3 A0 5D          PRINTMSG_MSG c_commission1
005D01  2  20 F9 3D     
005D04  2  A9 28 A0 5E          PRINTMSG_MSG c_commission2
005D08  2  20 F9 3D     
005D0B  2  60                   RTS
