003068  2               
003068  1                       .INCLUDE "video.asm"
003068  2               ;______________________________________________________________________________
003068  2               ;  video.asm - memory-mapped video: paging, framing, viewport, UI text
003068  2               ;
003068  2               ;  Direct VRAM access (the fast path used by SpeedScript): map video
003068  2               ;  sub-page $F9 into CPU bank $A.  Then:
003068  2               ;     text  char at  $A000 + row*80 + col
003068  2               ;     color cell at  $A800 + row*80 + col
003068  2               ;  Color byte = (bg<<4)|fg.
003068  2               ;
003068  2               ;  All direct-write routines must be bracketed by vid_enter / vid_exit.
003068  2               ;  UI text via the firmware (prmsg / putxy) does NOT page; it uses
003068  2               ;  FARCALL chrout/locate and must be used while in task 0.
003068  2               ;______________________________________________________________________________
003068  2               
003068  2               ;----------------------------------------------------------------
003068  2               ; vid_enter - map video text/color page into $A000-$AFFF (task 1)
003068  2               ;             trashes A,X ; preserves Y
003068  2               ;----------------------------------------------------------------
003068  2               vid_enter:
003068  2  A9 01                LDA     #$01            ; configure task 01
00306A  2  A2 0A                LDX     #$0A            ; CPU bank $A ($A000-$AFFF)
00306C  2  A0 F9                LDY     #VIDTEXT_PAGE   ; physical video page $F9
00306E  2  20 F6 FF             JSR     SETPAGE
003071  2  A9 01                LDA     #$01
003073  2  8D E0 EF             STA     PC6502_ACT_TASK ; activate task 01
003076  2  60                   RTS
003077  2               
003077  2               ;----------------------------------------------------------------
003077  2               ; vid_exit - restore normal memory at $A000 (task 0)
003077  2               ;----------------------------------------------------------------
003077  2               vid_exit:
003077  2  A9 00                LDA     #$00
003079  2  8D E0 EF             STA     PC6502_ACT_TASK
00307C  2  60                   RTS
00307D  2               
00307D  2               ;----------------------------------------------------------------
00307D  2               ; rowbase - compute VRAM pointers for the start of a screen row.
00307D  2               ;   IN : A = row (0..23)
00307D  2               ;   OUT: vptr -> $A000 + row*80   (text)
00307D  2               ;        cptr -> $A800 + row*80   (color)
00307D  2               ;   row*80 = row*64 + row*16 = (row<<6)+(row<<4)
00307D  2               ;----------------------------------------------------------------
00307D  2               rowbase:
00307D  2  85 20                STA     tmp0            ; row
00307F  2               ; row*16 -> ptr2
00307F  2  A9 00                LDA     #0
003081  2  85 13                STA     ptr2+1
003083  2  A5 20                LDA     tmp0
003085  2  0A                   ASL     A               ; *2
003086  2  0A                   ASL     A               ; *4
003087  2  0A                   ASL     A               ; *8
003088  2  0A                   ASL     A               ; *16 (row<=23 so <=368, may set carry)
003089  2  85 12                STA     ptr2
00308B  2  A9 00                LDA     #0
00308D  2  2A                   ROL     A
00308E  2  85 13                STA     ptr2+1          ; high bits of row*16
003090  2               ; row*64 -> ptr
003090  2  A5 20                LDA     tmp0
003092  2  85 10                STA     ptr
003094  2  A9 00                LDA     #0
003096  2  85 11                STA     ptr+1
003098  2  06 10                ASL     ptr
00309A  2  26 11                ROL     ptr+1           ; *2
00309C  2  06 10                ASL     ptr
00309E  2  26 11                ROL     ptr+1           ; *4
0030A0  2  06 10                ASL     ptr
0030A2  2  26 11                ROL     ptr+1           ; *8
0030A4  2  06 10                ASL     ptr
0030A6  2  26 11                ROL     ptr+1           ; *16
0030A8  2  06 10                ASL     ptr
0030AA  2  26 11                ROL     ptr+1           ; *32
0030AC  2  06 10                ASL     ptr
0030AE  2  26 11                ROL     ptr+1           ; *64
0030B0  2               ; ptr = ptr + ptr2 = row*80
0030B0  2  18                   CLC
0030B1  2  A5 10                LDA     ptr
0030B3  2  65 12                ADC     ptr2
0030B5  2  85 10                STA     ptr
0030B7  2  A5 11                LDA     ptr+1
0030B9  2  65 13                ADC     ptr2+1
0030BB  2  85 11                STA     ptr+1
0030BD  2               ; vptr = $A000 + ptr
0030BD  2  18                   CLC
0030BE  2  A5 10                LDA     ptr
0030C0  2  85 14                STA     vptr
0030C2  2  A5 11                LDA     ptr+1
0030C4  2  69 A0                ADC     #>VRAM_TEXT
0030C6  2  85 15                STA     vptr+1
0030C8  2               ; cptr = $A800 + ptr
0030C8  2  18                   CLC
0030C9  2  A5 10                LDA     ptr
0030CB  2  85 16                STA     cptr
0030CD  2  A5 11                LDA     ptr+1
0030CF  2  69 A8                ADC     #>VRAM_COLOR
0030D1  2  85 17                STA     cptr+1
0030D3  2  60                   RTS
0030D4  2               
0030D4  2               ;----------------------------------------------------------------
0030D4  2               ; putcell - write one char+color cell directly to VRAM.
0030D4  2               ;   MUST be called between vid_enter / vid_exit.
0030D4  2               ;   IN : tmp1 = row, tmp2 = col, tmp3 = char, colidx = color
0030D4  2               ;   trashes A,Y
0030D4  2               ;----------------------------------------------------------------
0030D4  2               putcell:
0030D4  2  A5 21                LDA     tmp1
0030D6  2  20 7D 30             JSR     rowbase
0030D9  2  A4 22                LDY     tmp2
0030DB  2  A5 23                LDA     tmp3
0030DD  2  91 14                STA     (vptr),Y
0030DF  2  A5 26                LDA     colidx
0030E1  2  91 16                STA     (cptr),Y
0030E3  2  60                   RTS
0030E4  2               
0030E4  2               ;----------------------------------------------------------------
0030E4  2               ; cls_vram - fill the whole screen with spaces in C_BLANK.
0030E4  2               ;----------------------------------------------------------------
0030E4  2               cls_vram:
0030E4  2  20 68 30             JSR     vid_enter
0030E7  2  A9 00                LDA     #0
0030E9  2  85 27                STA     rowidx
0030EB  2               @row:
0030EB  2  A5 27                LDA     rowidx
0030ED  2  20 7D 30             JSR     rowbase
0030F0  2  A0 00                LDY     #0
0030F2  2               @col:
0030F2  2  A9 20                LDA     #space
0030F4  2  91 14                STA     (vptr),Y
0030F6  2  A9 08                LDA     #C_BLANK
0030F8  2  91 16                STA     (cptr),Y
0030FA  2  C8                   INY
0030FB  2  C0 50                CPY     #SCRW
0030FD  2  D0 F3                BNE     @col
0030FF  2  E6 27                INC     rowidx
003101  2  A5 27                LDA     rowidx
003103  2  C9 18                CMP     #SCRH
003105  2  D0 E4                BNE     @row
003107  2  4C 77 30             JMP     vid_exit
00310A  2               
00310A  2               ;----------------------------------------------------------------
00310A  2               ; fillrow_vram - fill one row [colA..colB) with char/color.
00310A  2               ;   IN: tmp1=row, tmp2=start col, tmp3=char, colidx=color, cnt0=count
00310A  2               ;   MUST be inside vid_enter/vid_exit.
00310A  2               ;----------------------------------------------------------------
00310A  2               fillrow_vram:
00310A  2  A5 21                LDA     tmp1
00310C  2  20 7D 30             JSR     rowbase
00310F  2  A4 22                LDY     tmp2
003111  2  A6 24                LDX     cnt0
003113  2               @fl:
003113  2  A5 23                LDA     tmp3
003115  2  91 14                STA     (vptr),Y
003117  2  A5 26                LDA     colidx
003119  2  91 16                STA     (cptr),Y
00311B  2  C8                   INY
00311C  2  CA                   DEX
00311D  2  D0 F4                BNE     @fl
00311F  2  60                   RTS
003120  2               
003120  2               ;----------------------------------------------------------------
003120  2               ; draw_frame - draw the static game UI: title bar, viewport frame,
003120  2               ;              stat panel frame, and message area divider.
003120  2               ;              Done once at game start (and after returning from
003120  2               ;              full-screen menus).
003120  2               ;----------------------------------------------------------------
003120  2               draw_frame:
003120  2  20 E4 30             JSR     cls_vram
003123  2  20 68 30             JSR     vid_enter
003126  2               
003126  2               ; --- top title bar (row 0) ---
003126  2  A9 00                LDA     #0
003128  2  85 21                STA     tmp1
00312A  2  A9 00                LDA     #0
00312C  2  85 22                STA     tmp2
00312E  2  A9 20                LDA     #space
003130  2  85 23                STA     tmp3
003132  2  A9 0E                LDA     #C_TITLE
003134  2  85 26                STA     colidx
003136  2  A9 50                LDA     #SCRW
003138  2  85 24                STA     cnt0
00313A  2  20 0A 31             JSR     fillrow_vram
00313D  2               ; centered title text written below via vid_exit path
00313D  2               
00313D  2               ; --- viewport top/bottom horizontal borders ---
00313D  2               ; top border at row 0 already part of title; we frame the
00313D  2               ; viewport with vertical bars and a bottom rule at VPY0+VPH.
00313D  2               ; vertical left/right bars for viewport rows
00313D  2  A2 01                LDX     #VPY0
00313F  2               @vbar:
00313F  2  8A                   TXA
003140  2  85 21                STA     tmp1
003142  2  20 7D 30             JSR     rowbase
003145  2  A0 00                LDY     #0              ; left edge col 0
003147  2  A9 7C                LDA     #'|'
003149  2  91 14                STA     (vptr),Y
00314B  2  A9 0B                LDA     #C_BORDER
00314D  2  91 16                STA     (cptr),Y
00314F  2  A0 2D                LDY     #(VPW+1)        ; right edge of viewport
003151  2  A9 7C                LDA     #'|'
003153  2  91 14                STA     (vptr),Y
003155  2  A9 0B                LDA     #C_BORDER
003157  2  91 16                STA     (cptr),Y
003159  2  E8                   INX
00315A  2  E0 15                CPX     #(VPY0+VPH)
00315C  2  D0 E1                BNE     @vbar
00315E  2               
00315E  2               ; viewport bottom rule + message divider share row VPY0+VPH
00315E  2               ; (= MSGY0-1).  Draw it full-width.
00315E  2  A9 15                LDA     #(VPY0+VPH)
003160  2  85 21                STA     tmp1
003162  2  A9 00                LDA     #0
003164  2  85 22                STA     tmp2
003166  2  A9 3D                LDA     #'='
003168  2  85 23                STA     tmp3
00316A  2  A9 0B                LDA     #C_BORDER
00316C  2  85 26                STA     colidx
00316E  2  A9 50                LDA     #SCRW
003170  2  85 24                STA     cnt0
003172  2  20 0A 31             JSR     fillrow_vram
003175  2               
003175  2               ; panel header row (row 1) background highlight
003175  2  A9 01                LDA     #1
003177  2  85 21                STA     tmp1
003179  2  A9 2E                LDA     #(VPW+2)
00317B  2  85 22                STA     tmp2
00317D  2  A9 20                LDA     #space
00317F  2  85 23                STA     tmp3
003181  2  A9 1E                LDA     #C_PANELHDR
003183  2  85 26                STA     colidx
003185  2  A9 22                LDA     #(SCRW-(VPW+2))
003187  2  85 24                STA     cnt0
003189  2  20 0A 31             JSR     fillrow_vram
00318C  2               
00318C  2  20 77 30             JSR     vid_exit
00318F  2               
00318F  2               ; write the title bar + panel header text via firmware
00318F  2  A2 1E                LDX     #30
003191  2  A0 00                LDY     #0
003193  2  20 B6 31             JSR     locate
003196  2  A9 0E                LDA     #C_TITLE
003198  2  8D 4A 06             STA     CURCOLOR
00319B  2  A9 38 A0 33          PRINTMSG titlebar
00319F  2  20 C8 31     
0031A2  2               
0031A2  2  A2 30                LDX     #(VPW+4)
0031A4  2  A0 01                LDY     #1
0031A6  2  20 B6 31             JSR     locate
0031A9  2  A9 1E                LDA     #C_PANELHDR
0031AB  2  8D 4A 06             STA     CURCOLOR
0031AE  2  A9 4C A0 33          PRINTMSG panelhdr
0031B2  2  20 C8 31     
0031B5  2  60                   RTS
0031B6  2               
0031B6  2               ;----------------------------------------------------------------
0031B6  2               ; locate - position the firmware text cursor.  X=col, Y=row.
0031B6  2               ;----------------------------------------------------------------
0031B6  2               locate:
0031B6  2  A9 25 85 32          FARCALL FC_LOCATE
0031BA  2  20 F0 FF     
0031BD  2  60                   RTS
0031BE  2               
0031BE  2               ;----------------------------------------------------------------
0031BE  2               ; putc - output one char via firmware (A=char), honoring CURCOLOR.
0031BE  2               ;        (Cannot use the FARCALL macro - it would clobber the char
0031BE  2               ;         in A.  Set farfunct, then restore A before the call.)
0031BE  2               ;----------------------------------------------------------------
0031BE  2               putc:
0031BE  2  48                   PHA
0031BF  2  A9 13                LDA     #FC_CHROUT
0031C1  2  85 32                STA     farfunct
0031C3  2  68                   PLA
0031C4  2  20 F0 FF             JSR     DO_FARCALL
0031C7  2  60                   RTS
0031C8  2               
0031C8  2               ;----------------------------------------------------------------
0031C8  2               ; prmsg - print a 0-terminated string via firmware chrout.
0031C8  2               ;   IN: A=lo, Y=hi of string address.  Uses CURCOLOR for color.
0031C8  2               ;----------------------------------------------------------------
0031C8  2               prmsg:
0031C8  2  85 1C                STA     strp
0031CA  2  84 1D                STY     strp+1
0031CC  2  A0 00                LDY     #0
0031CE  2               @pl:
0031CE  2  B1 1C                LDA     (strp),Y
0031D0  2  F0 08                BEQ     @done
0031D2  2  5A                   PHY
0031D3  2  20 BE 31             JSR     putc
0031D6  2  7A                   PLY
0031D7  2  C8                   INY
0031D8  2  D0 F4                BNE     @pl
0031DA  2               @done:
0031DA  2  60                   RTS
0031DB  2               
0031DB  2               ;----------------------------------------------------------------
0031DB  2               ; putxy - position cursor (X=col,Y=row), set color (A=color),
0031DB  2               ;         then print string at strp.  Helper for panel fields.
0031DB  2               ;   IN: tmp2=col, tmp1=row, colidx=color, strp=string ptr
0031DB  2               ;----------------------------------------------------------------
0031DB  2               putxy:
0031DB  2  A6 22                LDX     tmp2
0031DD  2  A4 21                LDY     tmp1
0031DF  2  20 B6 31             JSR     locate
0031E2  2  A5 26                LDA     colidx
0031E4  2  8D 4A 06             STA     CURCOLOR
0031E7  2  A5 1C                LDA     strp
0031E9  2  A4 1D                LDY     strp+1
0031EB  2  20 C8 31             JSR     prmsg
0031EE  2  60                   RTS
0031EF  2               
0031EF  2               ;----------------------------------------------------------------
0031EF  2               ; clear_panel_value - blank a panel field area before redraw.
0031EF  2               ;   IN: X=col, Y=row, A=width
0031EF  2               ;----------------------------------------------------------------
0031EF  2               clear_panel_value:
0031EF  2  85 25                STA     cnt1            ; width
0031F1  2  20 B6 31             JSR     locate
0031F4  2  A9 0F                LDA     #C_PANEL
0031F6  2  8D 4A 06             STA     CURCOLOR
0031F9  2               @cpv:
0031F9  2  A9 20                LDA     #space
0031FB  2  20 BE 31             JSR     putc
0031FE  2  C6 25                DEC     cnt1
003200  2  D0 F7                BNE     @cpv
003202  2  60                   RTS
003203  2               
003203  2               ;----------------------------------------------------------------
003203  2               ; render_view - draw the scrolling map viewport centered on the
003203  2               ; player. Each world tile is a 2x2 character-cell metatile.
003203  2               ;
003203  2               ;   uses: px,py (player world coords), loc (active map)
003203  2               ;   The top-left WORLD cell shown is (px-VPCX, py-VPCY).
003203  2               ;----------------------------------------------------------------
003203  2               render_view:
003203  2  20 68 30             JSR     vid_enter
003206  2               ; world-tile row = 0..VPTH-1
003206  2  A9 00                LDA     #0
003208  2  85 27                STA     rowidx
00320A  2               @vrow:
00320A  2               ; world y for this row = py - VPCY + rowidx
00320A  2  38                   SEC
00320B  2  AD 48 41             LDA     py
00320E  2  E9 05                SBC     #VPCY
003210  2  18                   CLC
003211  2  65 27                ADC     rowidx
003213  2  85 2D                STA     tgty
003215  2               ; world-tile column loop
003215  2  A9 00                LDA     #0
003217  2  85 26                STA     colidx
003219  2               @vcol:
003219  2               ; world x = px - VPCX + colidx
003219  2  38                   SEC
00321A  2  AD 47 41             LDA     px
00321D  2  E9 0B                SBC     #VPCX
00321F  2  18                   CLC
003220  2  65 26                ADC     colidx
003222  2  85 2C                STA     tgtx
003224  2               ; fetch tile (returns tgttile)
003224  2  20 5B 19             JSR     tileat
003227  2               ; metatile base glyph = MG_TERRAIN_BASE + tile_code*4
003227  2  A5 2E                LDA     tgttile
003229  2  0A                   ASL     A
00322A  2  0A                   ASL     A
00322B  2  18                   CLC
00322C  2  69 80                ADC     #MG_TERRAIN_BASE
00322E  2  85 24                STA     cnt0
003230  2  A6 2E                LDX     tgttile
003232  2  BD 31 18             LDA     tile_color,X
003235  2  85 25                STA     cnt1
003237  2               ; pick an alternate art variant for some cells so large regions of
003237  2               ; one terrain don't show an obvious repeating grid. A terrain has a
003237  2               ; variant iff tile_variant[code] != 0; we use it when the cheap
003237  2               ; position hash (tgtx ^ tgty) bit0 is set.
003237  2  BD 42 18             LDA     tile_variant,X
00323A  2  F0 0D                BEQ     @novar          ; this terrain has no variant
00323C  2  A5 2C                LDA     tgtx
00323E  2  45 2D                EOR     tgty
003240  2  29 01                AND     #$01
003242  2  F0 05                BEQ     @novar          ; hash says keep the base art
003244  2  BD 42 18             LDA     tile_variant,X  ; swap in the variant metatile base
003247  2  85 24                STA     cnt0
003249  2               @novar:
003249  2               ; screen column = VPX0 + colidx*2
003249  2  A5 26                LDA     colidx
00324B  2  0A                   ASL     A
00324C  2  18                   CLC
00324D  2  69 01                ADC     #VPX0
00324F  2  85 22                STA     tmp2
003251  2               ; screen row = VPY0 + rowidx*2
003251  2  A5 27                LDA     rowidx
003253  2  0A                   ASL     A
003254  2  18                   CLC
003255  2  69 01                ADC     #VPY0
003257  2  85 23                STA     tmp3
003259  2  20 85 32             JSR     blit_metatile_vram
00325C  2               ; next column
00325C  2  E6 26                INC     colidx
00325E  2  A5 26                LDA     colidx
003260  2  C9 16                CMP     #VPTW
003262  2  D0 B5                BNE     @vcol
003264  2               ; next row
003264  2  E6 27                INC     rowidx
003266  2  A5 27                LDA     rowidx
003268  2  C9 0A                CMP     #VPTH
00326A  2  D0 9E                BNE     @vrow
00326C  2               
00326C  2               ; --- overlay monsters that fall within the viewport ---
00326C  2  20 72 37             JSR     draw_monsters_vram
00326F  2               
00326F  2               ; --- overlay the player at the fixed center metatile ---
00326F  2  A9 C4                LDA     #MG_PLAYER
003271  2  85 24                STA     cnt0
003273  2  A9 0F                LDA     #C_PLAYER
003275  2  85 25                STA     cnt1
003277  2  A9 17                LDA     #(VPX0+(VPCX*2))
003279  2  85 22                STA     tmp2
00327B  2  A9 0B                LDA     #(VPY0+(VPCY*2))
00327D  2  85 23                STA     tmp3
00327F  2  20 C2 32             JSR     blit_entity_vram
003282  2               
003282  2  4C 77 30             JMP     vid_exit
003285  2               
003285  2               ;----------------------------------------------------------------
003285  2               ; blit_metatile_vram - draw a 2x2 terrain metatile with one color.
003285  2               ;   IN: cnt0=base glyph, cnt1=color, tmp2=screen col, tmp3=screen row
003285  2               ;   MUST be called inside vid_enter/vid_exit.
003285  2               ;----------------------------------------------------------------
003285  2               blit_metatile_vram:
003285  2  A5 23                LDA     tmp3
003287  2  20 7D 30             JSR     rowbase
00328A  2  A4 22                LDY     tmp2
00328C  2  A5 24                LDA     cnt0
00328E  2  91 14                STA     (vptr),Y
003290  2  A5 25                LDA     cnt1
003292  2  91 16                STA     (cptr),Y
003294  2  C8                   INY
003295  2  A5 24                LDA     cnt0
003297  2  18                   CLC
003298  2  69 01                ADC     #1
00329A  2  91 14                STA     (vptr),Y
00329C  2  A5 25                LDA     cnt1
00329E  2  91 16                STA     (cptr),Y
0032A0  2               
0032A0  2  A5 23                LDA     tmp3
0032A2  2  18                   CLC
0032A3  2  69 01                ADC     #1
0032A5  2  20 7D 30             JSR     rowbase
0032A8  2  A4 22                LDY     tmp2
0032AA  2  A5 24                LDA     cnt0
0032AC  2  18                   CLC
0032AD  2  69 02                ADC     #2
0032AF  2  91 14                STA     (vptr),Y
0032B1  2  A5 25                LDA     cnt1
0032B3  2  91 16                STA     (cptr),Y
0032B5  2  C8                   INY
0032B6  2  A5 24                LDA     cnt0
0032B8  2  18                   CLC
0032B9  2  69 03                ADC     #3
0032BB  2  91 14                STA     (vptr),Y
0032BD  2  A5 25                LDA     cnt1
0032BF  2  91 16                STA     (cptr),Y
0032C1  2  60                   RTS
0032C2  2               
0032C2  2               ;----------------------------------------------------------------
0032C2  2               ; blit_entity_vram - overlay a 2x2 entity metatile while preserving
0032C2  2               ; each terrain cell's background color.
0032C2  2               ;   IN: cnt0=base glyph, cnt1=entity color, tmp2=screen col,
0032C2  2               ;       tmp3=screen row
0032C2  2               ;   MUST be called inside vid_enter/vid_exit.
0032C2  2               ;----------------------------------------------------------------
0032C2  2               blit_entity_vram:
0032C2  2  A5 23                LDA     tmp3
0032C4  2  20 7D 30             JSR     rowbase
0032C7  2  A4 22                LDY     tmp2
0032C9  2  A5 24                LDA     cnt0
0032CB  2  91 14                STA     (vptr),Y
0032CD  2  20 FB 32             JSR     entity_color_at_y
0032D0  2  C8                   INY
0032D1  2  A5 24                LDA     cnt0
0032D3  2  18                   CLC
0032D4  2  69 01                ADC     #1
0032D6  2  91 14                STA     (vptr),Y
0032D8  2  20 FB 32             JSR     entity_color_at_y
0032DB  2               
0032DB  2  A5 23                LDA     tmp3
0032DD  2  18                   CLC
0032DE  2  69 01                ADC     #1
0032E0  2  20 7D 30             JSR     rowbase
0032E3  2  A4 22                LDY     tmp2
0032E5  2  A5 24                LDA     cnt0
0032E7  2  18                   CLC
0032E8  2  69 02                ADC     #2
0032EA  2  91 14                STA     (vptr),Y
0032EC  2  20 FB 32             JSR     entity_color_at_y
0032EF  2  C8                   INY
0032F0  2  A5 24                LDA     cnt0
0032F2  2  18                   CLC
0032F3  2  69 03                ADC     #3
0032F5  2  91 14                STA     (vptr),Y
0032F7  2  20 FB 32             JSR     entity_color_at_y
0032FA  2  60                   RTS
0032FB  2               
0032FB  2               ; preserve background nibble at the current cptr,Y; apply cnt1 foreground
0032FB  2               entity_color_at_y:
0032FB  2  B1 16                LDA     (cptr),Y
0032FD  2  29 F0                AND     #$F0
0032FF  2  85 20                STA     tmp0
003301  2  A5 25                LDA     cnt1
003303  2  29 0F                AND     #$0F
003305  2  05 20                ORA     tmp0
003307  2  91 16                STA     (cptr),Y
003309  2  60                   RTS
00330A  2               
00330A  2               ;----------------------------------------------------------------
00330A  2               ; plot_view_cell - overlay an entity metatile at WORLD coords
00330A  2               ; (tgtx,tgty) if it is visible.
00330A  2               ;   IN: tgtx,tgty=world coords, cnt0=base glyph, cnt1=color
00330A  2               ;   MUST be called inside vid_enter/vid_exit.
00330A  2               ;----------------------------------------------------------------
00330A  2               plot_view_cell:
00330A  2               ; viewport tile column = tgtx - px + VPCX
00330A  2  38                   SEC
00330B  2  A5 2C                LDA     tgtx
00330D  2  ED 47 41             SBC     px
003310  2  18                   CLC
003311  2  69 0B                ADC     #VPCX
003313  2               ; must be 0..VPTW-1
003313  2  30 22                BMI     @no             ; (signed underflow check via N flag)
003315  2  C9 16                CMP     #VPTW
003317  2  B0 1E                BCS     @no
003319  2  0A                   ASL     A
00331A  2  18                   CLC
00331B  2  69 01                ADC     #VPX0
00331D  2  85 22                STA     tmp2            ; screen column
00331F  2               ; viewport tile row = tgty - py + VPCY
00331F  2  38                   SEC
003320  2  A5 2D                LDA     tgty
003322  2  ED 48 41             SBC     py
003325  2  18                   CLC
003326  2  69 05                ADC     #VPCY
003328  2  30 0D                BMI     @no
00332A  2  C9 0A                CMP     #VPTH
00332C  2  B0 09                BCS     @no
00332E  2  0A                   ASL     A
00332F  2  18                   CLC
003330  2  69 01                ADC     #VPY0
003332  2  85 23                STA     tmp3            ; screen row
003334  2  4C C2 32             JMP     blit_entity_vram
003337  2               @no:
003337  2  60                   RTS
003338  2               
003338  2               ;----------------------------------------------------------------
003338  2               ; Static UI strings
003338  2               ;----------------------------------------------------------------
003338  2               titlebar:
003338  2  3D 20 57 20          .BYTE   "= W Y R M H O L D =",0
00333C  2  59 20 52 20  
003340  2  4D 20 48 20  
00334C  2               panelhdr:
00334C  2  41 44 56 45          .BYTE   "ADVENTURER",0
003350  2  4E 54 55 52  
003354  2  45 52 00     
003357  2               
003357  1                       .INCLUDE "ui.asm"
003357  2               ;______________________________________________________________________________
003357  2               ;  ui.asm - message log, stat panel, prompts, decimal output
003357  2               ;______________________________________________________________________________
003357  2               
003357  2               ;----------------------------------------------------------------
003357  2               ; displaynum - print the 16-bit value in numarg as decimal using
003357  2               ;              the firmware (honours CURCOLOR).  No leading spaces.
003357  2               ;              (adapted from speedscript displaynum)
003357  2               ;----------------------------------------------------------------
003357  2               displaynum:
003357  2  A0 08                LDY     #8              ; index into nums (5 entries x2 bytes)
003359  2               @find:
003359  2  A5 1F                LDA     numarg+1
00335B  2  D9 A1 33             CMP     nums+1,Y
00335E  2  90 09                BCC     @next
003360  2  D0 0B                BNE     @start
003362  2  A5 1E                LDA     numarg
003364  2  D9 A0 33             CMP     nums,Y
003367  2  B0 04                BCS     @start
003369  2               @next:
003369  2  88                   DEY
00336A  2  88                   DEY
00336B  2  D0 EC                BNE     @find
00336D  2               @start:
00336D  2  A9 30                LDA     #'0'
00336F  2  85 28                STA     numspace
003371  2               @dig:
003371  2  A5 1F                LDA     numarg+1
003373  2  D9 A1 33             CMP     nums+1,Y
003376  2  90 1E                BCC     @out
003378  2  D0 09                BNE     @nocmp
00337A  2  A5 1E                LDA     numarg
00337C  2  F9 A0 33             SBC     nums,Y          ; carry set
00337F  2  90 15                BCC     @out
003381  2  B0 05                BCS     @sub
003383  2               @nocmp:
003383  2  A5 1E                LDA     numarg
003385  2  F9 A0 33             SBC     nums,Y          ; carry set
003388  2               @sub:
003388  2  E6 28                INC     numspace
00338A  2  85 1E                STA     numarg
00338C  2  A5 1F                LDA     numarg+1
00338E  2  F9 A1 33             SBC     nums+1,Y
003391  2  85 1F                STA     numarg+1
003393  2  4C 71 33             JMP     @dig
003396  2               @out:
003396  2  A5 28                LDA     numspace
003398  2  20 BE 31             JSR     putc
00339B  2  88                   DEY
00339C  2  88                   DEY
00339D  2  10 CE                BPL     @start
00339F  2  60                   RTS
0033A0  2               
0033A0  2               ; place value table (1,10,100,1000,10000) as 16-bit LE words
0033A0  2               nums:
0033A0  2  01 00                .WORD   1
0033A2  2  0A 00                .WORD   10
0033A4  2  64 00                .WORD   100
0033A6  2  E8 03                .WORD   1000
0033A8  2  10 27                .WORD   10000
0033AA  2               
0033AA  2               ;----------------------------------------------------------------
0033AA  2               ; print a single 8-bit value (in A) as decimal.
0033AA  2               ;----------------------------------------------------------------
0033AA  2               print_byte:
0033AA  2  85 1E                STA     numarg
0033AC  2  A9 00                LDA     #0
0033AE  2  85 1F                STA     numarg+1
0033B0  2  4C 57 33             JMP     displaynum
0033B3  2               
0033B3  2               ;----------------------------------------------------------------
0033B3  2               ; Message log: two lines at rows MSGY0 and MSGY0+1.
0033B3  2               ; msg_print scrolls the bottom line up and prints a new line.
0033B3  2               ;
0033B3  2               ;   msg_print:  IN A=lo,Y=hi of 0-terminated string
0033B3  2               ;----------------------------------------------------------------
0033B3  2               msg_print:
0033B3  2  85 1C                STA     strp
0033B5  2  84 1D                STY     strp+1
0033B7  2               ; copy current bottom line (msgbuf1) up to (msgbuf0)
0033B7  2  A2 00                LDX     #0
0033B9  2               @up:
0033B9  2  BD BB 41             LDA     msgbuf1,X
0033BC  2  9D 6B 41             STA     msgbuf0,X
0033BF  2  E8                   INX
0033C0  2  E0 50                CPX     #SCRW
0033C2  2  D0 F5                BNE     @up
0033C4  2               ; copy new string into msgbuf1 (truncate/pad to SCRW)
0033C4  2  A0 00                LDY     #0
0033C6  2               @cp:
0033C6  2  B1 1C                LDA     (strp),Y
0033C8  2  F0 0B                BEQ     @padb
0033CA  2  99 BB 41             STA     msgbuf1,Y
0033CD  2  C8                   INY
0033CE  2  C0 50                CPY     #SCRW
0033D0  2  D0 F4                BNE     @cp
0033D2  2  4C DF 33             JMP     @draw
0033D5  2               @padb:
0033D5  2  A9 20                LDA     #space
0033D7  2               @pad:
0033D7  2  99 BB 41             STA     msgbuf1,Y
0033DA  2  C8                   INY
0033DB  2  C0 50                CPY     #SCRW
0033DD  2  D0 F8                BNE     @pad
0033DF  2               @draw:
0033DF  2  4C E2 33             JMP     msg_redraw
0033E2  2               
0033E2  2               ;----------------------------------------------------------------
0033E2  2               ; msg_redraw - blit both message buffers to the message rows via
0033E2  2               ;              direct VRAM (so it does not disturb the text cursor).
0033E2  2               ;----------------------------------------------------------------
0033E2  2               msg_redraw:
0033E2  2  20 68 30             JSR     vid_enter
0033E5  2               ; row MSGY0 <- msgbuf0
0033E5  2  A9 16                LDA     #MSGY0
0033E7  2  20 7D 30             JSR     rowbase
0033EA  2  A0 00                LDY     #0
0033EC  2               @r0:
0033EC  2  B9 6B 41             LDA     msgbuf0,Y
0033EF  2  91 14                STA     (vptr),Y
0033F1  2  A9 0F                LDA     #C_MSG
0033F3  2  91 16                STA     (cptr),Y
0033F5  2  C8                   INY
0033F6  2  C0 50                CPY     #SCRW
0033F8  2  D0 F2                BNE     @r0
0033FA  2               ; row MSGY0+1 <- msgbuf1
0033FA  2  A9 17                LDA     #MSGY0+1
0033FC  2  20 7D 30             JSR     rowbase
0033FF  2  A0 00                LDY     #0
003401  2               @r1:
003401  2  B9 BB 41             LDA     msgbuf1,Y
003404  2  91 14                STA     (vptr),Y
003406  2  A9 0F                LDA     #C_MSG
003408  2  91 16                STA     (cptr),Y
00340A  2  C8                   INY
00340B  2  C0 50                CPY     #SCRW
00340D  2  D0 F2                BNE     @r1
00340F  2  4C 77 30             JMP     vid_exit
003412  2               
003412  2               ;----------------------------------------------------------------
003412  2               ; msg_clear - blank both message buffers and redraw.
003412  2               ;----------------------------------------------------------------
003412  2               msg_clear:
003412  2  A2 00                LDX     #0
003414  2  A9 20                LDA     #space
003416  2               @mc:
003416  2  9D 6B 41             STA     msgbuf0,X
003419  2  9D BB 41             STA     msgbuf1,X
00341C  2  E8                   INX
00341D  2  E0 50                CPX     #SCRW
00341F  2  D0 F5                BNE     @mc
003421  2  4C E2 33             JMP     msg_redraw
003424  2               
003424  2               ;----------------------------------------------------------------
003424  2               ; Stat panel.  Drawn on the right side using firmware text output.
003424  2               ; Labels are static; values are redrawn each turn.
003424  2               ;----------------------------------------------------------------
003424  2               draw_panel:
003424  2               ; HP line:  "HP   : nn/nn"
003424  2  A2 30                LDX     #PANX
003426  2  A0 03                LDY     #3
003428  2  20 B6 31             JSR     locate
00342B  2  A9 0F                LDA     #C_PANEL
00342D  2  8D 4A 06             STA     CURCOLOR
003430  2  A9 8A A0 35          PRINTMSG lbl_hp
003434  2  20 C8 31     
003437  2  AD 49 41             LDA     phealth
00343A  2  20 AA 33             JSR     print_byte
00343D  2  A9 2F                LDA     #'/'
00343F  2  20 BE 31             JSR     putc
003442  2  AD 4A 41             LDA     pmaxhp
003445  2  20 AA 33             JSR     print_byte
003448  2  20 11 35             JSR     pad_clear       ; clear trailing junk
00344B  2               
00344B  2               ; Level / XP
00344B  2  A2 30                LDX     #PANX
00344D  2  A0 05                LDY     #5
00344F  2  20 B6 31             JSR     locate
003452  2  A9 92 A0 35          PRINTMSG lbl_lvl
003456  2  20 C8 31     
003459  2  AD 4B 41             LDA     plevel
00345C  2  20 AA 33             JSR     print_byte
00345F  2  A2 3C                LDX     #PANX+12
003461  2  A0 05                LDY     #5
003463  2  20 B6 31             JSR     locate
003466  2  A9 98 A0 35          PRINTMSG lbl_xp
00346A  2  20 C8 31     
00346D  2  AD 4C 41 85          COPY16  pxp, numarg
003471  2  1E AD 4D 41  
003475  2  85 1F        
003477  2  20 57 33             JSR     displaynum
00347A  2  20 11 35             JSR     pad_clear
00347D  2               
00347D  2               ; Gold / Food
00347D  2  A2 30                LDX     #PANX
00347F  2  A0 07                LDY     #7
003481  2  20 B6 31             JSR     locate
003484  2  A9 9D A0 35          PRINTMSG lbl_gold
003488  2  20 C8 31     
00348B  2  AD 4E 41 85          COPY16  pgold, numarg
00348F  2  1E AD 4F 41  
003493  2  85 1F        
003495  2  20 57 33             JSR     displaynum
003498  2  A2 3C                LDX     #PANX+12
00349A  2  A0 07                LDY     #7
00349C  2  20 B6 31             JSR     locate
00349F  2  A9 A4 A0 35          PRINTMSG lbl_food
0034A3  2  20 C8 31     
0034A6  2  AD 50 41 85          COPY16  pfood, numarg
0034AA  2  1E AD 51 41  
0034AE  2  85 1F        
0034B0  2  20 57 33             JSR     displaynum
0034B3  2  20 11 35             JSR     pad_clear
0034B6  2               
0034B6  2               ; Weapon
0034B6  2  A2 30                LDX     #PANX
0034B8  2  A0 09                LDY     #9
0034BA  2  20 B6 31             JSR     locate
0034BD  2  A9 AB A0 35          PRINTMSG lbl_wpn
0034C1  2  20 C8 31     
0034C4  2  AD 52 41             LDA     pweapon
0034C7  2  20 21 35             JSR     name_weapon     ; strp -> name
0034CA  2  A5 1C                LDA     strp
0034CC  2  A4 1D                LDY     strp+1
0034CE  2  20 C8 31             JSR     prmsg
0034D1  2  20 11 35             JSR     pad_clear
0034D4  2               
0034D4  2               ; Armor
0034D4  2  A2 30                LDX     #PANX
0034D6  2  A0 0A                LDY     #10
0034D8  2  20 B6 31             JSR     locate
0034DB  2  A9 B4 A0 35          PRINTMSG lbl_arm
0034DF  2  20 C8 31     
0034E2  2  AD 53 41             LDA     parmor
0034E5  2  20 2E 35             JSR     name_armor
0034E8  2  A5 1C                LDA     strp
0034EA  2  A4 1D                LDY     strp+1
0034EC  2  20 C8 31             JSR     prmsg
0034EF  2  20 11 35             JSR     pad_clear
0034F2  2               
0034F2  2               ; Location
0034F2  2  A2 30                LDX     #PANX
0034F4  2  A0 0C                LDY     #12
0034F6  2  20 B6 31             JSR     locate
0034F9  2  A9 BD A0 35          PRINTMSG lbl_loc
0034FD  2  20 C8 31     
003500  2  AD 54 41             LDA     loc
003503  2  20 3B 35             JSR     name_loc
003506  2  A5 1C                LDA     strp
003508  2  A4 1D                LDY     strp+1
00350A  2  20 C8 31             JSR     prmsg
00350D  2  20 11 35             JSR     pad_clear
003510  2  60                   RTS
003511  2               
003511  2               ; pad_clear - print spaces out to the right screen edge to erase
003511  2               ;             any leftover characters from a previous longer value.
003511  2               ;             Stops at the last column to avoid auto-scroll.
003511  2               pad_clear:
003511  2               @pc:
003511  2  AD 47 06             LDA     CURX
003514  2  C9 4F                CMP     #SCRW-1
003516  2  B0 08                BCS     @done
003518  2  A9 20                LDA     #space
00351A  2  20 BE 31             JSR     putc
00351D  2  4C 11 35             JMP     @pc
003520  2               @done:
003520  2  60                   RTS
003521  2               
003521  2               ;----------------------------------------------------------------
003521  2               ; name_weapon / name_armor / name_loc - set strp to a name string
003521  2               ;   IN: A = index
003521  2               ;----------------------------------------------------------------
003521  2               name_weapon:
003521  2  0A                   ASL     A
003522  2  AA                   TAX
003523  2  BD C6 35             LDA     wpn_names,X
003526  2  85 1C                STA     strp
003528  2  BD C7 35             LDA     wpn_names+1,X
00352B  2  85 1D                STA     strp+1
00352D  2  60                   RTS
00352E  2               name_armor:
00352E  2  0A                   ASL     A
00352F  2  AA                   TAX
003530  2  BD E5 35             LDA     arm_names,X
003533  2  85 1C                STA     strp
003535  2  BD E6 35             LDA     arm_names+1,X
003538  2  85 1D                STA     strp+1
00353A  2  60                   RTS
00353B  2               name_loc:
00353B  2  0A                   ASL     A
00353C  2  AA                   TAX
00353D  2  BD 09 36             LDA     loc_names,X
003540  2  85 1C                STA     strp
003542  2  BD 0A 36             LDA     loc_names+1,X
003545  2  85 1D                STA     strp+1
003547  2  60                   RTS
003548  2               
003548  2               ;----------------------------------------------------------------
003548  2               ; yorn - wait for a Y/N keypress.  Returns Z=1 if Yes (A='Y').
003548  2               ;----------------------------------------------------------------
003548  2               yorn:
003548  2               @wait:
003548  2  20 64 35             JSR     getkey_block
00354B  2  C9 59                CMP     #'Y'
00354D  2  F0 0F                BEQ     @yes
00354F  2  C9 79                CMP     #'y'
003551  2  F0 0B                BEQ     @yes
003553  2  C9 4E                CMP     #'N'
003555  2  F0 0A                BEQ     @no
003557  2  C9 6E                CMP     #'n'
003559  2  F0 06                BEQ     @no
00355B  2  4C 48 35             JMP     @wait
00355E  2               @yes:
00355E  2  A9 00                LDA     #0              ; Z=1
003560  2  60                   RTS
003561  2               @no:
003561  2  A9 01                LDA     #1              ; Z=0
003563  2  60                   RTS
003564  2               
003564  2               ;----------------------------------------------------------------
003564  2               ; getkey_block - block until a key is pressed; return it in A.
003564  2               ;----------------------------------------------------------------
003564  2               getkey_block:
003564  2               @gk:
003564  2  A9 14 85 32          FARCALL FC_CHRIN
003568  2  20 F0 FF     
00356B  2  C9 FF                CMP     #$FF
00356D  2  F0 F5                BEQ     @gk
00356F  2  60                   RTS
003570  2               
003570  2               ;----------------------------------------------------------------
003570  2               ; getkey - non-blocking read; A=key or 0 if none.
003570  2               ;----------------------------------------------------------------
003570  2               getkey:
003570  2  A9 14 85 32          FARCALL FC_CHRIN
003574  2  20 F0 FF     
003577  2  C9 FF                CMP     #$FF
003579  2  D0 02                BNE     @got
00357B  2  A9 00                LDA     #0
00357D  2               @got:
00357D  2  60                   RTS
00357E  2               
00357E  2               ;----------------------------------------------------------------
00357E  2               ; drainkeys - consume and discard all buffered keystrokes.
00357E  2               ;----------------------------------------------------------------
00357E  2               drainkeys:
00357E  2               @dk:
00357E  2  A9 14 85 32          FARCALL FC_CHRIN
003582  2  20 F0 FF     
003585  2  C9 FF                CMP     #$FF
003587  2  D0 F5                BNE     @dk             ; got a key - keep draining
003589  2  60                   RTS
00358A  2               
00358A  2               ;----------------------------------------------------------------
00358A  2               ; Panel labels and name tables
00358A  2               ;----------------------------------------------------------------
00358A  2               lbl_hp:
00358A  2  48 50 20 20          .BYTE   "HP   : ",0
00358E  2  20 3A 20 00  
003592  2               lbl_lvl:
003592  2  4C 76 6C 3A          .BYTE   "Lvl: ",0
003596  2  20 00        
003598  2               lbl_xp:
003598  2  58 50 3A 20          .BYTE   "XP: ",0
00359C  2  00           
00359D  2               lbl_gold:
00359D  2  47 6F 6C 64          .BYTE   "Gold: ",0
0035A1  2  3A 20 00     
0035A4  2               lbl_food:
0035A4  2  46 6F 6F 64          .BYTE   "Food: ",0
0035A8  2  3A 20 00     
0035AB  2               lbl_wpn:
0035AB  2  57 65 61 70          .BYTE   "Weapon: ",0
0035AF  2  6F 6E 3A 20  
0035B3  2  00           
0035B4  2               lbl_arm:
0035B4  2  41 72 6D 6F          .BYTE   "Armor : ",0
0035B8  2  72 20 3A 20  
0035BC  2  00           
0035BD  2               lbl_loc:
0035BD  2  57 68 65 72          .BYTE   "Where : ",0
0035C1  2  65 20 3A 20  
0035C5  2  00           
0035C6  2               
0035C6  2               wpn_names:
0035C6  2  CE 35 D4 35          .WORD   wn0, wn1, wn2, wn3
0035CA  2  DB 35 E1 35  
0035CE  2               wn0:
0035CE  2  46 69 73 74          .BYTE   "Fists",0
0035D2  2  73 00        
0035D4  2               wn1:
0035D4  2  44 61 67 67          .BYTE   "Dagger",0
0035D8  2  65 72 00     
0035DB  2               wn2:
0035DB  2  53 77 6F 72          .BYTE   "Sword",0
0035DF  2  64 00        
0035E1  2               wn3:
0035E1  2  41 78 65 00          .BYTE   "Axe",0
0035E5  2               
0035E5  2               arm_names:
0035E5  2  ED 35 F5 35          .WORD   an0, an1, an2, an3
0035E9  2  FD 35 03 36  
0035ED  2               an0:
0035ED  2  43 6C 6F 74          .BYTE   "Clothes",0
0035F1  2  68 65 73 00  
0035F5  2               an1:
0035F5  2  4C 65 61 74          .BYTE   "Leather",0
0035F9  2  68 65 72 00  
0035FD  2               an2:
0035FD  2  43 68 61 69          .BYTE   "Chain",0
003601  2  6E 00        
003603  2               an3:
003603  2  50 6C 61 74          .BYTE   "Plate",0
003607  2  65 00        
003609  2               
003609  2               loc_names:
003609  2  0F 36 18 36          .WORD   ln0, ln1, ln2
00360D  2  1D 36        
00360F  2               ln0:
00360F  2  57 79 72 6D          .BYTE   "Wyrmhold",0
003613  2  68 6F 6C 64  
003617  2  00           
003618  2               ln1:
003618  2  54 6F 77 6E          .BYTE   "Town",0
00361C  2  00           
00361D  2               ln2:
00361D  2  44 75 6E 67          .BYTE   "Dungeon",0
003621  2  65 6F 6E 00  
003625  2               
003625  1                       .INCLUDE "entity.asm"
003625  2               ;______________________________________________________________________________
003625  2               ;  entity.asm - monsters: table, spawning, simple AI, rendering
003625  2               ;
003625  2               ;  Parallel arrays of MAXMON slots.  A slot with mon_type == M_NONE
003625  2               ;  is empty.  Monsters live on the currently active map (overworld
003625  2               ;  or dungeon).  Towns have no monsters.
003625  2               ;______________________________________________________________________________
003625  2               
003625  2               ;----------------------------------------------------------------
003625  2               ; Per-monster-type stat tables (indexed by M_* id)
003625  2               ;   mtype_glyph : 2x2 metatile base glyph
003625  2               ;   mtype_color : color cell
003625  2               ;   mtype_hp    : starting HP
003625  2               ;   mtype_atk   : attack dice sides (damage 1..atk)
003625  2               ;   mtype_xp    : XP awarded on kill
003625  2               ;   mtype_gold  : gold dropped (max; rolled 0..gold)
003625  2               ;----------------------------------------------------------------
003625  2               mtype_glyph:
003625  2  20                   .BYTE   ' '             ; 0 none
003626  2  C8                   .BYTE   MG_ORC          ; 1 orc
003627  2  CC                   .BYTE   MG_SNAKE        ; 2 snake
003628  2  D0                   .BYTE   MG_SKELETON     ; 3 skeleton
003629  2  D4                   .BYTE   MG_THIEF        ; 4 thief
00362A  2  D8                   .BYTE   MG_TROLL        ; 5 troll
00362B  2  DC                   .BYTE   MG_BOSS         ; 6 boss (dragon)
00362C  2               mtype_color:
00362C  2  0C                   .BYTE   C_MONST         ; 0
00362D  2  0C                   .BYTE   COLOR(CO_BRRED, CO_BLACK); orc
00362E  2  0E                   .BYTE   COLOR(CO_BRYELLOW,CO_BLACK); snake
00362F  2  0F                   .BYTE   COLOR(CO_BRWHITE,CO_BLACK); skeleton
003630  2  05                   .BYTE   COLOR(CO_VIOLET,CO_BLACK); thief
003631  2  0B                   .BYTE   COLOR(CO_BRTURQ,CO_BLACK); troll
003632  2  4C                   .BYTE   C_BOSS          ; boss
003633  2               mtype_hp:
003633  2  00 06 04 08          .BYTE   0, 6, 4, 8, 5, 14, 40
003637  2  05 0E 28     
00363A  2               mtype_atk:
00363A  2  00 04 03 05          .BYTE   0, 4, 3, 5, 3, 7, 12
00363E  2  03 07 0C     
003641  2               mtype_xp:
003641  2  00 03 02 05          .BYTE   0, 3, 2, 5, 4, 10, 50
003645  2  04 0A 32     
003648  2               mtype_gold:
003648  2  00 04 01 03          .BYTE   0, 4, 1, 3, 12, 8, 40
00364C  2  0C 08 28     
00364F  2               
00364F  2               ;----------------------------------------------------------------
00364F  2               ; mon_clear_all - empty every monster slot.
00364F  2               ;----------------------------------------------------------------
00364F  2               mon_clear_all:
00364F  2  A2 00                LDX     #0
003651  2  A9 00                LDA     #M_NONE
003653  2               @c:
003653  2  9D 6C 42             STA     mon_type,X
003656  2  E8                   INX
003657  2  E0 0C                CPX     #MAXMON
003659  2  D0 F8                BNE     @c
00365B  2  60                   RTS
00365C  2               
00365C  2               ;----------------------------------------------------------------
00365C  2               ; mon_find_free - find an empty slot.  Returns X = slot, C=1 ok,
00365C  2               ;                 C=0 if table full.
00365C  2               ;----------------------------------------------------------------
00365C  2               mon_find_free:
00365C  2  A2 00                LDX     #0
00365E  2               @f:
00365E  2  BD 6C 42             LDA     mon_type,X
003661  2  C9 00                CMP     #M_NONE
003663  2  F0 07                BEQ     @found
003665  2  E8                   INX
003666  2  E0 0C                CPX     #MAXMON
003668  2  D0 F4                BNE     @f
00366A  2  18                   CLC
00366B  2  60                   RTS
00366C  2               @found:
00366C  2  38                   SEC
00366D  2  60                   RTS
00366E  2               
00366E  2               ;----------------------------------------------------------------
00366E  2               ; mon_spawn - create a monster.
00366E  2               ;   IN: A=type, tgtx=x, tgty=y
00366E  2               ;   Sets hp from the type table.  No-op if table full.
00366E  2               ;----------------------------------------------------------------
00366E  2               mon_spawn:
00366E  2  85 20                STA     tmp0            ; type
003670  2  20 5C 36             JSR     mon_find_free
003673  2  90 17                BCC     @full
003675  2  A5 20                LDA     tmp0
003677  2  9D 6C 42             STA     mon_type,X
00367A  2  A5 2C                LDA     tgtx
00367C  2  9D 78 42             STA     mon_x,X
00367F  2  A5 2D                LDA     tgty
003681  2  9D 84 42             STA     mon_y,X
003684  2  A4 20                LDY     tmp0
003686  2  B9 33 36             LDA     mtype_hp,Y
003689  2  9D 90 42             STA     mon_hp,X
00368C  2               @full:
00368C  2  60                   RTS
00368D  2               
00368D  2               ;----------------------------------------------------------------
00368D  2               ; mon_at - is there a live monster at (tgtx,tgty)?
00368D  2               ;          Returns X = slot and C=1 if found, else C=0.
00368D  2               ;----------------------------------------------------------------
00368D  2               mon_at:
00368D  2  A2 00                LDX     #0
00368F  2               @a:
00368F  2  BD 6C 42             LDA     mon_type,X
003692  2  C9 00                CMP     #M_NONE
003694  2  F0 10                BEQ     @nextslot
003696  2  BD 78 42             LDA     mon_x,X
003699  2  C5 2C                CMP     tgtx
00369B  2  D0 09                BNE     @nextslot
00369D  2  BD 84 42             LDA     mon_y,X
0036A0  2  C5 2D                CMP     tgty
0036A2  2  D0 02                BNE     @nextslot
0036A4  2  38                   SEC
0036A5  2  60                   RTS
0036A6  2               @nextslot:
0036A6  2  E8                   INX
0036A7  2  E0 0C                CPX     #MAXMON
0036A9  2  D0 E4                BNE     @a
0036AB  2  18                   CLC
0036AC  2  60                   RTS
0036AD  2               
0036AD  2               ;----------------------------------------------------------------
0036AD  2               ; mon_kill - remove monster in slot X.
0036AD  2               ;----------------------------------------------------------------
0036AD  2               mon_kill:
0036AD  2  A9 00                LDA     #M_NONE
0036AF  2  9D 6C 42             STA     mon_type,X
0036B2  2  60                   RTS
0036B3  2               
0036B3  2               ;----------------------------------------------------------------
0036B3  2               ; spawn_overworld_monsters - scatter a handful of monsters on the
0036B3  2               ; overworld at random passable land tiles near the centre.
0036B3  2               ;----------------------------------------------------------------
0036B3  2               spawn_overworld_monsters:
0036B3  2  20 4F 36             JSR     mon_clear_all
0036B6  2  A9 04                LDA     #4              ; only a few roaming monsters at a time
0036B8  2  85 24                STA     cnt0
0036BA  2               @loop:
0036BA  2               ; place in a ring roughly 6..21 tiles from the player: far
0036BA  2               ; enough not to crowd you, near enough to be encountered.
0036BA  2               ; offset = (rand(0..15) + 6), sign random per axis.
0036BA  2  A9 10                LDA     #16
0036BC  2  20 04 0C             JSR     rng_mod
0036BF  2  18                   CLC
0036C0  2  69 06                ADC     #6              ; 6..21
0036C2  2  85 21                STA     tmp1            ; magnitude
0036C4  2  20 E4 0B             JSR     rng_next        ; random sign bit
0036C7  2  29 01                AND     #1
0036C9  2  F0 09                BEQ     @xplus
0036CB  2  AD 47 41             LDA     px
0036CE  2  38                   SEC
0036CF  2  E5 21                SBC     tmp1
0036D1  2  4C DA 36             JMP     @setx
0036D4  2               @xplus:
0036D4  2  AD 47 41             LDA     px
0036D7  2  18                   CLC
0036D8  2  65 21                ADC     tmp1
0036DA  2               @setx:
0036DA  2  85 2C                STA     tgtx
0036DC  2  A9 10                LDA     #16
0036DE  2  20 04 0C             JSR     rng_mod
0036E1  2  18                   CLC
0036E2  2  69 06                ADC     #6
0036E4  2  85 21                STA     tmp1
0036E6  2  20 E4 0B             JSR     rng_next
0036E9  2  29 01                AND     #1
0036EB  2  F0 09                BEQ     @yplus
0036ED  2  AD 48 41             LDA     py
0036F0  2  38                   SEC
0036F1  2  E5 21                SBC     tmp1
0036F3  2  4C FC 36             JMP     @sety
0036F6  2               @yplus:
0036F6  2  AD 48 41             LDA     py
0036F9  2  18                   CLC
0036FA  2  65 21                ADC     tmp1
0036FC  2               @sety:
0036FC  2  85 2D                STA     tgty
0036FE  2               ; reject the player's own tile (don't spawn on top of you)
0036FE  2  A5 2C                LDA     tgtx
003700  2  CD 47 41             CMP     px
003703  2  D0 07                BNE     @okpos
003705  2  A5 2D                LDA     tgty
003707  2  CD 48 41             CMP     py
00370A  2  F0 20                BEQ     @skip
00370C  2               @okpos:
00370C  2               ; must be passable grass/forest (not water/mountain/town...)
00370C  2  20 5B 19             JSR     tileat
00370F  2  A6 2E                LDX     tgttile
003711  2  BD 53 18             LDA     tile_prop,X
003714  2  29 01                AND     #P_PASS
003716  2  F0 14                BEQ     @skip
003718  2  BD 53 18             LDA     tile_prop,X
00371B  2  29 0C                AND     #(P_TOWN|P_DUNG)
00371D  2  D0 0D                BNE     @skip           ; don't sit on a town/dungeon tile
00371F  2               ; not already occupied by a monster?
00371F  2  20 8D 36             JSR     mon_at
003722  2  B0 08                BCS     @skip
003724  2               ; pick a random monster type 1..5
003724  2  A9 05                LDA     #5
003726  2  20 14 0C             JSR     rng_d           ; 1..5
003729  2  20 6E 36             JSR     mon_spawn
00372C  2               @skip:
00372C  2  C6 24                DEC     cnt0
00372E  2  D0 8A                BNE     @loop
003730  2  60                   RTS
003731  2               
003731  2               ;----------------------------------------------------------------
003731  2               ; spawn_dungeon_monsters - place a few monsters and the boss.
003731  2               ;----------------------------------------------------------------
003731  2               spawn_dungeon_monsters:
003731  2  20 4F 36             JSR     mon_clear_all
003734  2               ; the boss waits at the far corner treasure room (bottom-right)
003734  2  A9 1D                LDA     #29
003736  2  85 2C                STA     tgtx
003738  2  A9 12                LDA     #18
00373A  2  85 2D                STA     tgty
00373C  2  A9 06                LDA     #M_BOSS
00373E  2  20 6E 36             JSR     mon_spawn
003741  2               ; a couple of guards on floor tiles
003741  2  A9 04                LDA     #4
003743  2  85 24                STA     cnt0
003745  2               @loop:
003745  2  A9 1C                LDA     #28
003747  2  20 04 0C             JSR     rng_mod
00374A  2  18                   CLC
00374B  2  69 02                ADC     #2
00374D  2  85 2C                STA     tgtx
00374F  2  A9 10                LDA     #16
003751  2  20 04 0C             JSR     rng_mod
003754  2  18                   CLC
003755  2  69 02                ADC     #2
003757  2  85 2D                STA     tgty
003759  2  20 5B 19             JSR     tileat
00375C  2  A6 2E                LDX     tgttile
00375E  2  E0 09                CPX     #T_FLOOR
003760  2  D0 0B                BNE     @skip
003762  2  A9 02                LDA     #2              ; orc or skeleton
003764  2  20 14 0C             JSR     rng_d
003767  2  18                   CLC
003768  2  69 02                ADC     #2              ; 3..4 -> skeleton/thief mix
00376A  2  20 6E 36             JSR     mon_spawn
00376D  2               @skip:
00376D  2  C6 24                DEC     cnt0
00376F  2  D0 D4                BNE     @loop
003771  2  60                   RTS
003772  2               
003772  2               ;----------------------------------------------------------------
003772  2               ; draw_monsters_vram - overlay all visible monsters in the viewport.
003772  2               ; Called by render_view while video is paged in.
003772  2               ;----------------------------------------------------------------
003772  2               draw_monsters_vram:
003772  2  A2 00                LDX     #0
003774  2  86 2F                STX     monidx
003776  2               @dm:
003776  2  A6 2F                LDX     monidx
003778  2  BD 6C 42             LDA     mon_type,X
00377B  2  C9 00                CMP     #M_NONE
00377D  2  F0 1A                BEQ     @next
00377F  2               ; set world coords + glyph/color, then plot if visible
00377F  2  BD 78 42             LDA     mon_x,X
003782  2  85 2C                STA     tgtx
003784  2  BD 84 42             LDA     mon_y,X
003787  2  85 2D                STA     tgty
003789  2  BC 6C 42             LDY     mon_type,X
00378C  2  B9 25 36             LDA     mtype_glyph,Y
00378F  2  85 24                STA     cnt0            ; glyph (cnt0/cnt1 survive rowbase)
003791  2  B9 2C 36             LDA     mtype_color,Y
003794  2  85 25                STA     cnt1            ; color
003796  2  20 0A 33             JSR     plot_view_cell
003799  2               @next:
003799  2  E6 2F                INC     monidx
00379B  2  A5 2F                LDA     monidx
00379D  2  C9 0C                CMP     #MAXMON
00379F  2  D0 D5                BNE     @dm
0037A1  2  60                   RTS
0037A2  2               
0037A2  2               ;----------------------------------------------------------------
0037A2  2               ; mon_act - move/attack for every monster (called once per turn).
0037A2  2               ; Monsters in LOC_TOWN never act (towns are safe).
0037A2  2               ;   A monster adjacent to the player attacks; otherwise it steps
0037A2  2               ;   one tile toward the player if the destination is passable and
0037A2  2               ;   unoccupied.
0037A2  2               ;----------------------------------------------------------------
0037A2  2               mon_act:
0037A2  2  AD 54 41             LDA     loc
0037A5  2  C9 01                CMP     #LOC_TOWN
0037A7  2  F0 18                BEQ     @ret            ; safe in town
0037A9  2  A2 00                LDX     #0
0037AB  2  86 2F                STX     monidx
0037AD  2               @ma:
0037AD  2  A6 2F                LDX     monidx
0037AF  2  BD 6C 42             LDA     mon_type,X
0037B2  2  C9 00                CMP     #M_NONE
0037B4  2  F0 03                BEQ     @next
0037B6  2               ; distance to player: dxv = px - mon_x ; dyv = py - mon_y
0037B6  2               ; adjacency test (|dx|<=1 && |dy|<=1 && not both 0)
0037B6  2  20 C2 37             JSR     mon_step_or_attack
0037B9  2               @next:
0037B9  2  E6 2F                INC     monidx
0037BB  2  A5 2F                LDA     monidx
0037BD  2  C9 0C                CMP     #MAXMON
0037BF  2  D0 EC                BNE     @ma
0037C1  2               @ret:
0037C1  2  60                   RTS
0037C2  2               
0037C2  2               ; mon_step_or_attack - for monster in slot monidx (X on entry).
0037C2  2               mon_step_or_attack:
0037C2  2               ; compute signed dx = px - mon_x  -> tmp0 ; dy -> tmp1
0037C2  2  A6 2F                LDX     monidx
0037C4  2  38                   SEC
0037C5  2  AD 47 41             LDA     px
0037C8  2  FD 78 42             SBC     mon_x,X
0037CB  2  85 20                STA     tmp0            ; dx (signed)
0037CD  2  38                   SEC
0037CE  2  AD 48 41             LDA     py
0037D1  2  FD 84 42             SBC     mon_y,X
0037D4  2  85 21                STA     tmp1            ; dy (signed)
0037D6  2               ; |dx| <= 1 ?
0037D6  2  A5 20                LDA     tmp0
0037D8  2  20 4E 38             JSR     abs_a
0037DB  2  85 22                STA     tmp2            ; |dx|
0037DD  2  A5 21                LDA     tmp1
0037DF  2  20 4E 38             JSR     abs_a
0037E2  2  85 23                STA     tmp3            ; |dy|
0037E4  2               ; adjacency: |dx|<=1 and |dy|<=1
0037E4  2  A5 22                LDA     tmp2
0037E6  2  C9 02                CMP     #2
0037E8  2  B0 09                BCS     @move
0037EA  2  A5 23                LDA     tmp3
0037EC  2  C9 02                CMP     #2
0037EE  2  B0 03                BCS     @move
0037F0  2               ; adjacent (and since one of them is the player, not same cell)
0037F0  2               ; -> attack the player
0037F0  2  4C 81 3B             JMP     monster_attacks_player; in combat.asm
0037F3  2               @move:
0037F3  2               ; step one tile toward player along the larger axis
0037F3  2               ; choose step in x: sign of dx
0037F3  2  A6 2F                LDX     monidx
0037F5  2  BD 78 42             LDA     mon_x,X
0037F8  2  85 2C                STA     tgtx
0037FA  2  BD 84 42             LDA     mon_y,X
0037FD  2  85 2D                STA     tgty
0037FF  2               ; prefer horizontal if |dx|>=|dy|
0037FF  2  A5 22                LDA     tmp2
003801  2  C5 23                CMP     tmp3
003803  2  90 10                BCC     @vert
003805  2               ; horizontal step
003805  2  A5 20                LDA     tmp0
003807  2  F0 0C                BEQ     @vert           ; dx==0 -> try vertical
003809  2  30 05                BMI     @left
00380B  2  E6 2C                INC     tgtx
00380D  2  4C 22 38             JMP     @trymove
003810  2               @left:
003810  2  C6 2C                DEC     tgtx
003812  2  4C 22 38             JMP     @trymove
003815  2               @vert:
003815  2  A5 21                LDA     tmp1
003817  2  F0 34                BEQ     @done           ; dy==0 too -> no move
003819  2  30 05                BMI     @up
00381B  2  E6 2D                INC     tgty
00381D  2  4C 22 38             JMP     @trymove
003820  2               @up:
003820  2  C6 2D                DEC     tgty
003822  2               @trymove:
003822  2               ; passable terrain?
003822  2  20 5B 19             JSR     tileat
003825  2  A6 2E                LDX     tgttile
003827  2  BD 53 18             LDA     tile_prop,X
00382A  2  29 01                AND     #P_PASS
00382C  2  F0 1F                BEQ     @done           ; blocked terrain
00382E  2               ; not onto the player?
00382E  2  A5 2C                LDA     tgtx
003830  2  CD 47 41             CMP     px
003833  2  D0 07                BNE     @okcell
003835  2  A5 2D                LDA     tgty
003837  2  CD 48 41             CMP     py
00383A  2  F0 11                BEQ     @done           ; would land on player (shouldn't: adjacency handled)
00383C  2               @okcell:
00383C  2               ; not onto another monster?
00383C  2  20 8D 36             JSR     mon_at
00383F  2  B0 0C                BCS     @done           ; occupied
003841  2               ; commit move
003841  2  A6 2F                LDX     monidx
003843  2  A5 2C                LDA     tgtx
003845  2  9D 78 42             STA     mon_x,X
003848  2  A5 2D                LDA     tgty
00384A  2  9D 84 42             STA     mon_y,X
00384D  2               @done:
00384D  2  60                   RTS
00384E  2               
00384E  2               ;----------------------------------------------------------------
00384E  2               ; abs_a - A = |A| treating A as signed 8-bit.
00384E  2               ;----------------------------------------------------------------
00384E  2               abs_a:
00384E  2  C9 80                CMP     #$80
003850  2  90 05                BCC     @pos
003852  2  49 FF                EOR     #$FF
003854  2  18                   CLC
003855  2  69 01                ADC     #1
003857  2               @pos:
003857  2  60                   RTS
003858  2               
003858  1                       .INCLUDE "player.asm"
003858  2               ;______________________________________________________________________________
003858  2               ;  player.asm - player movement, map transitions, treasure
003858  2               ;______________________________________________________________________________
003858  2               
003858  2               ;----------------------------------------------------------------
003858  2               ; Player starting state on the overworld.
003858  2               ;----------------------------------------------------------------
003858  2               PLAYER_START_X  = 20
003858  2               PLAYER_START_Y  = 9
003858  2               
003858  2               player_init:
003858  2  A9 14                LDA     #PLAYER_START_X
00385A  2  8D 47 41             STA     px
00385D  2  A9 09                LDA     #PLAYER_START_Y
00385F  2  8D 48 41             STA     py
003862  2  A9 1E                LDA     #30
003864  2  8D 49 41             STA     phealth
003867  2  8D 4A 41             STA     pmaxhp
00386A  2  A9 01                LDA     #1
00386C  2  8D 4B 41             STA     plevel
00386F  2  A9 00                LDA     #0
003871  2  8D 4C 41             STA     pxp
003874  2  8D 4D 41             STA     pxp+1
003877  2  A9 32                LDA     #50
003879  2  8D 4E 41             STA     pgold
00387C  2  A9 00                LDA     #0
00387E  2  8D 4F 41             STA     pgold+1
003881  2  A9 FA 8D 50          SETW16  pfood, 250
003885  2  41 A9 00 8D  
003889  2  51 41        
00388B  2  A9 01                LDA     #1
00388D  2  8D 52 41             STA     pweapon         ; dagger
003890  2  A9 00                LDA     #0
003892  2  8D 53 41             STA     parmor          ; clothes
003895  2  A9 00                LDA     #LOC_WORLD
003897  2  8D 54 41             STA     loc
00389A  2  A9 00                LDA     #0
00389C  2  8D 59 41             STA     bosskilled
00389F  2  60                   RTS
0038A0  2               
0038A0  2               ;----------------------------------------------------------------
0038A0  2               ; try_move - attempt to move the player by (dx,dy).
0038A0  2               ;   IN: dx, dy = signed -1/0/+1 deltas
0038A0  2               ;   Effects: combat on bump, terrain block, town/dungeon entry,
0038A0  2               ;   treasure pickup, exit interiors, food cost.  Monsters act after
0038A0  2               ;   a successful step (handled by caller via did_move flag).
0038A0  2               ;   OUT: did_move (game var) = 1 if a turn was consumed.
0038A0  2               ;----------------------------------------------------------------
0038A0  2               try_move:
0038A0  2  A9 00                LDA     #0
0038A2  2  8D 5A 41             STA     did_move
0038A5  2               ; target = (px+dx, py+dy)
0038A5  2  18                   CLC
0038A6  2  AD 47 41             LDA     px
0038A9  2  65 2A                ADC     dx
0038AB  2  85 2C                STA     tgtx
0038AD  2  18                   CLC
0038AE  2  AD 48 41             LDA     py
0038B1  2  65 2B                ADC     dy
0038B3  2  85 2D                STA     tgty
0038B5  2               
0038B5  2               ; monster there? -> attack (consumes the turn)
0038B5  2  20 8D 36             JSR     mon_at
0038B8  2  90 09                BCC     @noenemy
0038BA  2               ; X = monster slot ; resolve combat
0038BA  2  20 79 3A             JSR     player_attacks_monster
0038BD  2  A9 01                LDA     #1
0038BF  2  8D 5A 41             STA     did_move
0038C2  2  60                   RTS
0038C3  2               @noenemy:
0038C3  2               ; look at the terrain
0038C3  2  20 5B 19             JSR     tileat          ; -> tgttile
0038C6  2  A6 2E                LDX     tgttile
0038C8  2  BD 53 18             LDA     tile_prop,X
0038CB  2  85 20                STA     tmp0            ; property bits
0038CD  2  29 01                AND     #P_PASS
0038CF  2  D0 0B                BNE     @passable
0038D1  2               ; blocked
0038D1  2  20 1C 0D             JSR     sfx_blocked
0038D4  2  A9 62 A0 3C          PRINTMSG_MSG m_blocked
0038D8  2  20 B3 33     
0038DB  2  60                   RTS                     ; no turn consumed on a wall bump
0038DC  2               @passable:
0038DC  2               ; check special tiles
0038DC  2  A5 20                LDA     tmp0
0038DE  2  29 04                AND     #P_TOWN
0038E0  2  F0 03                BEQ     @ck_dung
0038E2  2  4C 50 39             JMP     enter_town
0038E5  2               @ck_dung:
0038E5  2  A5 20                LDA     tmp0
0038E7  2  29 08                AND     #P_DUNG
0038E9  2  F0 03                BEQ     @ck_exit
0038EB  2  4C 8B 39             JMP     enter_dungeon
0038EE  2               @ck_exit:
0038EE  2  A5 20                LDA     tmp0
0038F0  2  29 10                AND     #P_EXIT
0038F2  2  F0 03                BEQ     @ck_treas
0038F4  2  4C C6 39             JMP     leave_interior
0038F7  2               @ck_treas:
0038F7  2               ; commit the move first
0038F7  2  A5 2C                LDA     tgtx
0038F9  2  8D 47 41             STA     px
0038FC  2  A5 2D                LDA     tgty
0038FE  2  8D 48 41             STA     py
003901  2  A9 01                LDA     #1
003903  2  8D 5A 41             STA     did_move
003906  2               ; treasure?
003906  2  A5 20                LDA     tmp0
003908  2  29 20                AND     #P_TREAS
00390A  2  F0 03                BEQ     @food
00390C  2  20 29 39             JSR     collect_treasure
00390F  2               @food:
00390F  2               ; consume a unit of food per step
00390F  2  AD 50 41             LDA     pfood
003912  2  0D 51 41             ORA     pfood+1
003915  2  F0 11                BEQ     @nofood
003917  2  38                   SEC
003918  2  AD 50 41             LDA     pfood
00391B  2  E9 01                SBC     #1
00391D  2  8D 50 41             STA     pfood
003920  2  AD 51 41             LDA     pfood+1
003923  2  E9 00                SBC     #0
003925  2  8D 51 41             STA     pfood+1
003928  2               @nofood:
003928  2  60                   RTS
003929  2               
003929  2               ;----------------------------------------------------------------
003929  2               ; collect_treasure - pick up a chest at (tgtx,tgty): gold + maybe
003929  2               ; XP, then clear the tile to floor.
003929  2               ;----------------------------------------------------------------
003929  2               collect_treasure:
003929  2               ; gold 5..20
003929  2  A9 10                LDA     #16
00392B  2  20 14 0C             JSR     rng_d
00392E  2  18                   CLC
00392F  2  69 04                ADC     #4
003931  2               ; add to gold (16-bit)
003931  2  18                   CLC
003932  2  6D 4E 41             ADC     pgold
003935  2  8D 4E 41             STA     pgold
003938  2  AD 4F 41             LDA     pgold+1
00393B  2  69 00                ADC     #0
00393D  2  8D 4F 41             STA     pgold+1
003940  2               ; clear the chest tile -> floor
003940  2  A9 09                LDA     #T_FLOOR
003942  2  20 02 1A             JSR     settile
003945  2  20 81 0D             JSR     sfx_treasure
003948  2  A9 6B A0 3C          PRINTMSG_MSG m_treasure
00394C  2  20 B3 33     
00394F  2  60                   RTS
003950  2               
003950  2               ;----------------------------------------------------------------
003950  2               ; enter_town - switch to the town interior map.
003950  2               ;----------------------------------------------------------------
003950  2               enter_town:
003950  2  20 EF 0D             JSR     sfx_door
003953  2  20 1D 19             JSR     decode_town
003956  2  A9 01                LDA     #LOC_TOWN
003958  2  8D 54 41             STA     loc
00395B  2  A9 20                LDA     #TOWNW
00395D  2  8D 55 41             STA     locw
003960  2  A9 14                LDA     #TOWNH
003962  2  8D 56 41             STA     loch
003965  2               ; remember overworld position to restore on exit
003965  2  AD 47 41             LDA     px
003968  2  8D 57 41             STA     owretx
00396B  2  AD 48 41             LDA     py
00396E  2  8D 58 41             STA     owrety
003971  2               ; place player just inside, one tile NORTH of the door so the
003971  2               ; exit '+' is visible directly south of the player on entry.
003971  2  A9 0E                LDA     #14
003973  2  8D 47 41             STA     px
003976  2  A9 11                LDA     #TOWNH-3
003978  2  8D 48 41             STA     py
00397B  2               ; towns have no monsters
00397B  2  20 4F 36             JSR     mon_clear_all
00397E  2  A9 01                LDA     #1
003980  2  8D 5A 41             STA     did_move
003983  2  A9 86 A0 3C          PRINTMSG_MSG m_town
003987  2  20 B3 33     
00398A  2  60                   RTS
00398B  2               
00398B  2               ;----------------------------------------------------------------
00398B  2               ; enter_dungeon - switch to the dungeon map and spawn its monsters.
00398B  2               ;----------------------------------------------------------------
00398B  2               enter_dungeon:
00398B  2  20 EF 0D             JSR     sfx_door
00398E  2  20 3C 19             JSR     decode_dung
003991  2  A9 02                LDA     #LOC_DUNG
003993  2  8D 54 41             STA     loc
003996  2  A9 20                LDA     #DUNGW
003998  2  8D 55 41             STA     locw
00399B  2  A9 14                LDA     #DUNGH
00399D  2  8D 56 41             STA     loch
0039A0  2  AD 47 41             LDA     px
0039A3  2  8D 57 41             STA     owretx
0039A6  2  AD 48 41             LDA     py
0039A9  2  8D 58 41             STA     owrety
0039AC  2               ; start just east of the stairs-up '<' (at 1,1) so the exit
0039AC  2               ; is visible immediately to the west of the player.
0039AC  2  A9 02                LDA     #2
0039AE  2  8D 47 41             STA     px
0039B1  2  A9 01                LDA     #1
0039B3  2  8D 48 41             STA     py
0039B6  2  20 31 37             JSR     spawn_dungeon_monsters
0039B9  2  A9 01                LDA     #1
0039BB  2  8D 5A 41             STA     did_move
0039BE  2  A9 C5 A0 3C          PRINTMSG_MSG m_dungeon
0039C2  2  20 B3 33     
0039C5  2  60                   RTS
0039C6  2               
0039C6  2               ;----------------------------------------------------------------
0039C6  2               ; leave_interior - return to the overworld at the saved position.
0039C6  2               ;----------------------------------------------------------------
0039C6  2               leave_interior:
0039C6  2  20 EF 0D             JSR     sfx_door
0039C9  2  20 FE 18             JSR     decode_world
0039CC  2  A9 00                LDA     #LOC_WORLD
0039CE  2  8D 54 41             STA     loc
0039D1  2  AD 57 41             LDA     owretx
0039D4  2  8D 47 41             STA     px
0039D7  2  AD 58 41             LDA     owrety
0039DA  2  8D 48 41             STA     py
0039DD  2  20 B3 36             JSR     spawn_overworld_monsters
0039E0  2  A9 01                LDA     #1
0039E2  2  8D 5A 41             STA     did_move
0039E5  2  A9 F8 A0 3C          PRINTMSG_MSG m_world
0039E9  2  20 B3 33     
0039EC  2  60                   RTS
0039ED  2               
0039ED  1                       .INCLUDE "combat.asm"
0039ED  2               ;______________________________________________________________________________
0039ED  2               ;  combat.asm - bump combat resolution, leveling, message builder
0039ED  2               ;______________________________________________________________________________
0039ED  2               
0039ED  2               ;----------------------------------------------------------------
0039ED  2               ; Message builder.  Compose a line in mbuf then push to the log.
0039ED  2               ;   mb_reset            - start a new line
0039ED  2               ;   mb_str  (A=lo,Y=hi) - append a 0-terminated string
0039ED  2               ;   mb_num  (A=byte)    - append a 0..255 value in decimal
0039ED  2               ;   mb_mname(A=type)    - append a monster type name
0039ED  2               ;   mb_flush            - push mbuf into the scrolling log
0039ED  2               ;----------------------------------------------------------------
0039ED  2               mb_reset:
0039ED  2  A9 00                LDA     #0
0039EF  2  8D 6B 42             STA     mblen
0039F2  2  60                   RTS
0039F3  2               
0039F3  2               mb_str:
0039F3  2  85 1C                STA     strp
0039F5  2  84 1D                STY     strp+1
0039F7  2  A0 00                LDY     #0
0039F9  2               @s:
0039F9  2  B1 1C                LDA     (strp),Y
0039FB  2  F0 0C                BEQ     @done
0039FD  2  AE 6B 42             LDX     mblen
003A00  2  9D 0B 42             STA     mbuf,X
003A03  2  EE 6B 42             INC     mblen
003A06  2  C8                   INY
003A07  2  D0 F0                BNE     @s
003A09  2               @done:
003A09  2  60                   RTS
003A0A  2               
003A0A  2               ; append A (0..255) as decimal
003A0A  2               mb_num:
003A0A  2  85 1E                STA     numarg
003A0C  2  A9 00                LDA     #0
003A0E  2  85 1F                STA     numarg+1
003A10  2               mb_num16:
003A10  2               ; find highest place
003A10  2  A0 08                LDY     #8
003A12  2               @find:
003A12  2  A5 1F                LDA     numarg+1
003A14  2  D9 A1 33             CMP     nums+1,Y
003A17  2  90 09                BCC     @nx
003A19  2  D0 0B                BNE     @start
003A1B  2  A5 1E                LDA     numarg
003A1D  2  D9 A0 33             CMP     nums,Y
003A20  2  B0 04                BCS     @start
003A22  2               @nx:
003A22  2  88                   DEY
003A23  2  88                   DEY
003A24  2  D0 EC                BNE     @find
003A26  2               @start:
003A26  2  A9 30                LDA     #'0'
003A28  2  85 28                STA     numspace
003A2A  2               @dig:
003A2A  2  A5 1F                LDA     numarg+1
003A2C  2  D9 A1 33             CMP     nums+1,Y
003A2F  2  90 1E                BCC     @out
003A31  2  D0 09                BNE     @noc
003A33  2  A5 1E                LDA     numarg
003A35  2  F9 A0 33             SBC     nums,Y
003A38  2  90 15                BCC     @out
003A3A  2  B0 05                BCS     @sub
003A3C  2               @noc:
003A3C  2  A5 1E                LDA     numarg
003A3E  2  F9 A0 33             SBC     nums,Y
003A41  2               @sub:
003A41  2  E6 28                INC     numspace
003A43  2  85 1E                STA     numarg
003A45  2  A5 1F                LDA     numarg+1
003A47  2  F9 A1 33             SBC     nums+1,Y
003A4A  2  85 1F                STA     numarg+1
003A4C  2  4C 2A 3A             JMP     @dig
003A4F  2               @out:
003A4F  2  A5 28                LDA     numspace
003A51  2  AE 6B 42             LDX     mblen
003A54  2  9D 0B 42             STA     mbuf,X
003A57  2  EE 6B 42             INC     mblen
003A5A  2  88                   DEY
003A5B  2  88                   DEY
003A5C  2  10 C8                BPL     @start
003A5E  2  60                   RTS
003A5F  2               
003A5F  2               ; append a monster type name (A = type id)
003A5F  2               mb_mname:
003A5F  2  0A                   ASL     A
003A60  2  AA                   TAX
003A61  2  BD E6 3B             LDA     mon_names,X
003A64  2  BC E7 3B             LDY     mon_names+1,X
003A67  2  4C F3 39             JMP     mb_str
003A6A  2               
003A6A  2               mb_flush:
003A6A  2  AE 6B 42             LDX     mblen
003A6D  2  A9 00                LDA     #0
003A6F  2  9D 0B 42             STA     mbuf,X          ; NUL terminate
003A72  2  A9 0B                LDA     #<mbuf
003A74  2  A0 42                LDY     #>mbuf
003A76  2  4C B3 33             JMP     msg_print
003A79  2               
003A79  2               ;----------------------------------------------------------------
003A79  2               ; player_attacks_monster - X = monster slot.
003A79  2               ;   Damage = 1..(weapon_power) + small bonus.  Apply, possibly kill.
003A79  2               ;----------------------------------------------------------------
003A79  2               player_attacks_monster:
003A79  2  86 2F                STX     monidx
003A7B  2               ; damage roll: base from weapon
003A7B  2  AE 52 41             LDX     pweapon
003A7E  2  BD DE 3B             LDA     wpn_power,X
003A81  2  20 14 0C             JSR     rng_d           ; 1..power
003A84  2  85 20                STA     tmp0            ; damage
003A86  2               ; subtract from monster hp
003A86  2  A6 2F                LDX     monidx
003A88  2  38                   SEC
003A89  2  BD 90 42             LDA     mon_hp,X
003A8C  2  E5 20                SBC     tmp0
003A8E  2  9D 90 42             STA     mon_hp,X
003A91  2               ; build "You hit the Orc for N!"
003A91  2  20 ED 39             JSR     mb_reset
003A94  2  A9 20                LDA     #<c_youhit
003A96  2  A0 3C                LDY     #>c_youhit
003A98  2  20 F3 39             JSR     mb_str
003A9B  2  A6 2F                LDX     monidx
003A9D  2  BD 6C 42             LDA     mon_type,X
003AA0  2  20 5F 3A             JSR     mb_mname
003AA3  2  A9 2D                LDA     #<c_for
003AA5  2  A0 3C                LDY     #>c_for
003AA7  2  20 F3 39             JSR     mb_str
003AAA  2  A5 20                LDA     tmp0
003AAC  2  20 0A 3A             JSR     mb_num
003AAF  2  A9 33                LDA     #<c_bang
003AB1  2  A0 3C                LDY     #>c_bang
003AB3  2  20 F3 39             JSR     mb_str
003AB6  2  20 6A 3A             JSR     mb_flush
003AB9  2  20 39 0D             JSR     sfx_hit
003ABC  2               ; dead?  (hp <= 0 i.e. hp was <= damage -> result negative/zero)
003ABC  2  A6 2F                LDX     monidx
003ABE  2  BD 90 42             LDA     mon_hp,X
003AC1  2  F0 03                BEQ     @dead
003AC3  2  30 01                BMI     @dead
003AC5  2  60                   RTS
003AC6  2               @dead:
003AC6  2  4C C9 3A             JMP     monster_dies
003AC9  2               
003AC9  2               ;----------------------------------------------------------------
003AC9  2               ; monster_dies - award XP/gold, drop the slot, maybe win, maybe
003AC9  2               ; level up.  Slot in monidx.
003AC9  2               ;----------------------------------------------------------------
003AC9  2               monster_dies:
003AC9  2  A6 2F                LDX     monidx
003ACB  2  BD 6C 42             LDA     mon_type,X
003ACE  2  85 21                STA     tmp1            ; type
003AD0  2               ; XP
003AD0  2  A8                   TAY
003AD1  2  B9 41 36             LDA     mtype_xp,Y
003AD4  2  18                   CLC
003AD5  2  6D 4C 41             ADC     pxp
003AD8  2  8D 4C 41             STA     pxp
003ADB  2  AD 4D 41             LDA     pxp+1
003ADE  2  69 00                ADC     #0
003AE0  2  8D 4D 41             STA     pxp+1
003AE3  2               ; gold drop 0..mtype_gold
003AE3  2  A4 21                LDY     tmp1
003AE5  2  B9 48 36             LDA     mtype_gold,Y
003AE8  2  F0 12                BEQ     @nogold
003AEA  2  20 04 0C             JSR     rng_mod         ; 0..gold-1
003AED  2  18                   CLC
003AEE  2  6D 4E 41             ADC     pgold
003AF1  2  8D 4E 41             STA     pgold
003AF4  2  AD 4F 41             LDA     pgold+1
003AF7  2  69 00                ADC     #0
003AF9  2  8D 4F 41             STA     pgold+1
003AFC  2               @nogold:
003AFC  2               ; message "The Orc dies!"
003AFC  2  20 ED 39             JSR     mb_reset
003AFF  2  A9 35                LDA     #<c_the
003B01  2  A0 3C                LDY     #>c_the
003B03  2  20 F3 39             JSR     mb_str
003B06  2  A5 21                LDA     tmp1
003B08  2  20 5F 3A             JSR     mb_mname
003B0B  2  A9 3A                LDA     #<c_dies
003B0D  2  A0 3C                LDY     #>c_dies
003B0F  2  20 F3 39             JSR     mb_str
003B12  2  20 6A 3A             JSR     mb_flush
003B15  2  20 64 0D             JSR     sfx_killed
003B18  2               ; remove monster
003B18  2  A6 2F                LDX     monidx
003B1A  2  20 AD 36             JSR     mon_kill
003B1D  2               ; boss?
003B1D  2  A5 21                LDA     tmp1
003B1F  2  C9 06                CMP     #M_BOSS
003B21  2  D0 05                BNE     @lvl
003B23  2  A9 01                LDA     #1
003B25  2  8D 59 41             STA     bosskilled
003B28  2               @lvl:
003B28  2  20 2C 3B             JSR     check_levelup
003B2B  2  60                   RTS
003B2C  2               
003B2C  2               ;----------------------------------------------------------------
003B2C  2               ; check_levelup - if xp >= level*20, level up (raise maxhp, heal).
003B2C  2               ;----------------------------------------------------------------
003B2C  2               check_levelup:
003B2C  2               ; threshold = plevel * 20  (8-bit is enough up to lvl 12)
003B2C  2  AD 4B 41             LDA     plevel
003B2F  2  85 20                STA     tmp0
003B31  2  A9 00                LDA     #0
003B33  2  85 21                STA     tmp1
003B35  2               ; tmp = level*20 = level*16 + level*4
003B35  2  AD 4B 41             LDA     plevel
003B38  2  0A                   ASL     A
003B39  2  0A                   ASL     A               ; *4
003B3A  2  85 22                STA     tmp2
003B3C  2  AD 4B 41             LDA     plevel
003B3F  2  0A                   ASL     A
003B40  2  0A                   ASL     A
003B41  2  0A                   ASL     A
003B42  2  0A                   ASL     A               ; *16
003B43  2  18                   CLC
003B44  2  65 22                ADC     tmp2
003B46  2  85 22                STA     tmp2            ; level*20 (low); ignore >255 (caps fine)
003B48  2               ; compare xp (16-bit) >= tmp2
003B48  2  AD 4D 41             LDA     pxp+1
003B4B  2  D0 07                BNE     @levelup        ; xp >= 256 definitely past early thresholds
003B4D  2  AD 4C 41             LDA     pxp
003B50  2  C5 22                CMP     tmp2
003B52  2  90 2C                BCC     @done
003B54  2               @levelup:
003B54  2  EE 4B 41             INC     plevel
003B57  2               ; maxhp += 8, full heal
003B57  2  AD 4A 41             LDA     pmaxhp
003B5A  2  18                   CLC
003B5B  2  69 08                ADC     #8
003B5D  2  8D 4A 41             STA     pmaxhp
003B60  2  8D 49 41             STA     phealth
003B63  2  20 B8 0D             JSR     sfx_levelup
003B66  2  20 ED 39             JSR     mb_reset
003B69  2  A9 50                LDA     #<c_levelup
003B6B  2  A0 3C                LDY     #>c_levelup
003B6D  2  20 F3 39             JSR     mb_str
003B70  2  AD 4B 41             LDA     plevel
003B73  2  20 0A 3A             JSR     mb_num
003B76  2  A9 33                LDA     #<c_bang
003B78  2  A0 3C                LDY     #>c_bang
003B7A  2  20 F3 39             JSR     mb_str
003B7D  2  20 6A 3A             JSR     mb_flush
003B80  2               @done:
003B80  2  60                   RTS
003B81  2               
003B81  2               ;----------------------------------------------------------------
003B81  2               ; monster_attacks_player - monster in slot monidx strikes.
003B81  2               ;   Damage = 1..mtype_atk, reduced by armor.  Apply to phealth.
003B81  2               ;----------------------------------------------------------------
003B81  2               monster_attacks_player:
003B81  2  A6 2F                LDX     monidx
003B83  2  BD 6C 42             LDA     mon_type,X
003B86  2  85 21                STA     tmp1            ; type
003B88  2  A8                   TAY
003B89  2  B9 3A 36             LDA     mtype_atk,Y
003B8C  2  20 14 0C             JSR     rng_d           ; 1..atk
003B8F  2  85 20                STA     tmp0            ; raw damage
003B91  2               ; armor reduces by armor index (0..3)
003B91  2  AE 53 41             LDX     parmor
003B94  2  BD E2 3B             LDA     arm_def,X
003B97  2  85 22                STA     tmp2
003B99  2  38                   SEC
003B9A  2  A5 20                LDA     tmp0
003B9C  2  E5 22                SBC     tmp2
003B9E  2  10 02                BPL     @ok
003BA0  2  A9 01                LDA     #1              ; minimum 1 damage
003BA2  2               @ok:
003BA2  2  D0 02                BNE     @apply
003BA4  2  A9 01                LDA     #1
003BA6  2               @apply:
003BA6  2  85 20                STA     tmp0
003BA8  2               ; subtract from phealth (floor at 0)
003BA8  2  38                   SEC
003BA9  2  AD 49 41             LDA     phealth
003BAC  2  E5 20                SBC     tmp0
003BAE  2  B0 02                BCS     @sethp
003BB0  2  A9 00                LDA     #0
003BB2  2               @sethp:
003BB2  2  8D 49 41             STA     phealth
003BB5  2               ; message "Orc hits you for N!"
003BB5  2  20 ED 39             JSR     mb_reset
003BB8  2  A9 35                LDA     #<c_the
003BBA  2  A0 3C                LDY     #>c_the
003BBC  2  20 F3 39             JSR     mb_str
003BBF  2  A5 21                LDA     tmp1
003BC1  2  20 5F 3A             JSR     mb_mname
003BC4  2  A9 41                LDA     #<c_hitsyou
003BC6  2  A0 3C                LDY     #>c_hitsyou
003BC8  2  20 F3 39             JSR     mb_str
003BCB  2  A5 20                LDA     tmp0
003BCD  2  20 0A 3A             JSR     mb_num
003BD0  2  A9 33                LDA     #<c_bang
003BD2  2  A0 3C                LDY     #>c_bang
003BD4  2  20 F3 39             JSR     mb_str
003BD7  2  20 6A 3A             JSR     mb_flush
003BDA  2  20 39 0D             JSR     sfx_hit
003BDD  2  60                   RTS
003BDE  2               
003BDE  2               ;----------------------------------------------------------------
003BDE  2               ; Weapon power (damage sides) and armor defense tables
003BDE  2               ;----------------------------------------------------------------
003BDE  2               wpn_power:
003BDE  2  02                   .BYTE   2               ; 0 fists
003BDF  2  04                   .BYTE   4               ; 1 dagger
003BE0  2  07                   .BYTE   7               ; 2 sword
003BE1  2  0A                   .BYTE   10              ; 3 axe
003BE2  2               arm_def:
003BE2  2  00                   .BYTE   0               ; 0 clothes
003BE3  2  01                   .BYTE   1               ; 1 leather
003BE4  2  02                   .BYTE   2               ; 2 chain
003BE5  2  04                   .BYTE   4               ; 3 plate
003BE6  2               
003BE6  2               ;----------------------------------------------------------------
003BE6  2               ; Monster name table (for messages), indexed by type id
003BE6  2               ;----------------------------------------------------------------
003BE6  2               mon_names:
003BE6  2  F4 3B FA 3B          .WORD   mn_none, mn_orc, mn_snake, mn_skel, mn_thief, mn_troll, mn_boss
003BEA  2  FE 3B 04 3C  
003BEE  2  0D 3C 13 3C  
003BF4  2               mn_none:
003BF4  2  74 68 69 6E          .BYTE   "thing",0
003BF8  2  67 00        
003BFA  2               mn_orc:
003BFA  2  4F 72 63 00          .BYTE   "Orc",0
003BFE  2               mn_snake:
003BFE  2  53 6E 61 6B          .BYTE   "Snake",0
003C02  2  65 00        
003C04  2               mn_skel:
003C04  2  53 6B 65 6C          .BYTE   "Skeleton",0
003C08  2  65 74 6F 6E  
003C0C  2  00           
003C0D  2               mn_thief:
003C0D  2  54 68 69 65          .BYTE   "Thief",0
003C11  2  66 00        
003C13  2               mn_troll:
003C13  2  54 72 6F 6C          .BYTE   "Troll",0
003C17  2  6C 00        
003C19  2               mn_boss:
003C19  2  44 72 61 67          .BYTE   "Dragon",0
003C1D  2  6F 6E 00     
003C20  2               
003C20  2               ;----------------------------------------------------------------
003C20  2               ; Combat / event message fragments
003C20  2               ;----------------------------------------------------------------
003C20  2               c_youhit:
003C20  2  59 6F 75 20          .BYTE   "You hit the ",0
003C24  2  68 69 74 20  
003C28  2  74 68 65 20  
003C2D  2               c_for:
003C2D  2  20 66 6F 72          .BYTE   " for ",0
003C31  2  20 00        
003C33  2               c_bang:
003C33  2  21 00                .BYTE   "!",0
003C35  2               c_the:
003C35  2  54 68 65 20          .BYTE   "The ",0
003C39  2  00           
003C3A  2               c_dies:
003C3A  2  20 64 69 65          .BYTE   " dies!",0
003C3E  2  73 21 00     
003C41  2               c_hitsyou:
003C41  2  20 68 69 74          .BYTE   " hits you for ",0
003C45  2  73 20 79 6F  
003C49  2  75 20 66 6F  
003C50  2               c_levelup:
003C50  2  57 65 6C 63          .BYTE   "Welcome to level ",0
003C54  2  6F 6D 65 20  
003C58  2  74 6F 20 6C  
003C62  2               
003C62  2               ;----------------------------------------------------------------
003C62  2               ; Map / event messages (shared with player.asm)
003C62  2               ;----------------------------------------------------------------
003C62  2               m_blocked:
003C62  2  42 6C 6F 63          .BYTE   "Blocked!",0
003C66  2  6B 65 64 21  
003C6A  2  00           
003C6B  2               m_treasure:
003C6B  2  59 6F 75 20          .BYTE   "You found gold in a chest!",0
003C6F  2  66 6F 75 6E  
003C73  2  64 20 67 6F  
003C86  2               m_town:
003C86  2  54 6F 77 6E          .BYTE   "Town. Step on the door '+' (south) to leave. T at 'S' to shop.",0
003C8A  2  2E 20 53 74  
003C8E  2  65 70 20 6F  
003CC5  2               m_dungeon:
003CC5  2  44 75 6E 67          .BYTE   "Dungeon! Step on the stairs '<' to climb back out.",0
003CC9  2  65 6F 6E 21  
003CCD  2  20 53 74 65  
003CF8  2               m_world:
003CF8  2  59 6F 75 20          .BYTE   "You return to the land of Wyrmhold.",0
003CFC  2  72 65 74 75  
003D00  2  72 6E 20 74  
003D1C  2               
003D1C  1                       .INCLUDE "town.asm"
003D1C  2               ;______________________________________________________________________________
003D1C  2               ;  town.asm - shop interaction inside towns
003D1C  2               ;
003D1C  2               ;  When the player presses USE ('T') in a town while adjacent to a
003D1C  2               ;  shop counter ('S' tile), the shop menu opens.  The menu is drawn
003D1C  2               ;  over the message rows; the player picks an option, gold is spent,
003D1C  2               ;  and the menu returns to the map.
003D1C  2               ;______________________________________________________________________________
003D1C  2               
003D1C  2               PRICE_HEAL      = 10            ; gold per visit (full heal)
003D1C  2               PRICE_FOOD      = 20            ; gold for +100 food
003D1C  2               PRICE_WEAPON    = 60            ; gold to upgrade weapon one tier
003D1C  2               PRICE_ARMOR     = 50            ; gold to upgrade armor one tier
003D1C  2               
003D1C  2               ;----------------------------------------------------------------
003D1C  2               ; use_action - bound to the USE key ('T').  Only meaningful in a
003D1C  2               ; town next to a shop counter.
003D1C  2               ;----------------------------------------------------------------
003D1C  2               use_action:
003D1C  2  AD 54 41             LDA     loc
003D1F  2  C9 01                CMP     #LOC_TOWN
003D21  2  F0 08                BEQ     @intown
003D23  2  A9 37 A0 40          PRINTMSG_MSG t_nothing
003D27  2  20 B3 33     
003D2A  2  60                   RTS
003D2B  2               @intown:
003D2B  2               ; is a shop tile adjacent (4-neighbour) or under us?
003D2B  2  20 3B 3D             JSR     shop_adjacent
003D2E  2  B0 08                BCS     @open
003D30  2  A9 48 A0 40          PRINTMSG_MSG t_noshop
003D34  2  20 B3 33     
003D37  2  60                   RTS
003D38  2               @open:
003D38  2  4C A5 3D             JMP     shop_menu
003D3B  2               
003D3B  2               ;----------------------------------------------------------------
003D3B  2               ; shop_adjacent - C=1 if a T_SHOP tile is at or next to the player.
003D3B  2               ;----------------------------------------------------------------
003D3B  2               shop_adjacent:
003D3B  2               ; center
003D3B  2  AD 47 41             LDA     px
003D3E  2  85 2C                STA     tgtx
003D40  2  AD 48 41             LDA     py
003D43  2  85 2D                STA     tgty
003D45  2  20 5B 19             JSR     tileat
003D48  2  A5 2E                LDA     tgttile
003D4A  2  C9 0E                CMP     #T_SHOP
003D4C  2  F0 55                BEQ     @yes
003D4E  2               ; up
003D4E  2  AD 47 41             LDA     px
003D51  2  85 2C                STA     tgtx
003D53  2  AD 48 41             LDA     py
003D56  2  38                   SEC
003D57  2  E9 01                SBC     #1
003D59  2  85 2D                STA     tgty
003D5B  2  20 5B 19             JSR     tileat
003D5E  2  A5 2E                LDA     tgttile
003D60  2  C9 0E                CMP     #T_SHOP
003D62  2  F0 3F                BEQ     @yes
003D64  2               ; down
003D64  2  AD 48 41             LDA     py
003D67  2  18                   CLC
003D68  2  69 01                ADC     #1
003D6A  2  85 2D                STA     tgty
003D6C  2  AD 47 41             LDA     px
003D6F  2  85 2C                STA     tgtx
003D71  2  20 5B 19             JSR     tileat
003D74  2  A5 2E                LDA     tgttile
003D76  2  C9 0E                CMP     #T_SHOP
003D78  2  F0 29                BEQ     @yes
003D7A  2               ; left
003D7A  2  AD 48 41             LDA     py
003D7D  2  85 2D                STA     tgty
003D7F  2  AD 47 41             LDA     px
003D82  2  38                   SEC
003D83  2  E9 01                SBC     #1
003D85  2  85 2C                STA     tgtx
003D87  2  20 5B 19             JSR     tileat
003D8A  2  A5 2E                LDA     tgttile
003D8C  2  C9 0E                CMP     #T_SHOP
003D8E  2  F0 13                BEQ     @yes
003D90  2               ; right
003D90  2  AD 47 41             LDA     px
003D93  2  18                   CLC
003D94  2  69 01                ADC     #1
003D96  2  85 2C                STA     tgtx
003D98  2  20 5B 19             JSR     tileat
003D9B  2  A5 2E                LDA     tgttile
003D9D  2  C9 0E                CMP     #T_SHOP
003D9F  2  F0 02                BEQ     @yes
003DA1  2  18                   CLC
003DA2  2  60                   RTS
003DA3  2               @yes:
003DA3  2  38                   SEC
003DA4  2  60                   RTS
003DA5  2               
003DA5  2               ;----------------------------------------------------------------
003DA5  2               ; shop_menu - draw the shop menu over the message area and loop
003DA5  2               ; processing purchases until the player presses X.
003DA5  2               ;----------------------------------------------------------------
003DA5  2               shop_menu:
003DA5  2  20 EF 0D             JSR     sfx_door
003DA8  2               ; start with the greeting as the status line
003DA8  2  A9 19                LDA     #<t_greet
003DAA  2  8D 64 41             STA     shopstat
003DAD  2  A9 40                LDA     #>t_greet
003DAF  2  8D 65 41             STA     shopstat+1
003DB2  2               @redraw:
003DB2  2  20 AC 3E             JSR     shop_draw
003DB5  2               @key:
003DB5  2  20 64 35             JSR     getkey_block
003DB8  2  C9 31                CMP     #'1'
003DBA  2  F0 1A                BEQ     @heal
003DBC  2  C9 32                CMP     #'2'
003DBE  2  F0 33                BEQ     @food
003DC0  2  C9 33                CMP     #'3'
003DC2  2  F0 54                BEQ     @weapon
003DC4  2  C9 34                CMP     #'4'
003DC6  2  F0 7B                BEQ     @armor
003DC8  2  C9 58                CMP     #'X'
003DCA  2  F0 07                BEQ     @goleave
003DCC  2  C9 78                CMP     #'x'
003DCE  2  F0 03                BEQ     @goleave
003DD0  2  4C B5 3D             JMP     @key
003DD3  2               @goleave:
003DD3  2  4C 7B 3E             JMP     @leave
003DD6  2               @heal:
003DD6  2  A9 0A                LDA     #PRICE_HEAL
003DD8  2  20 89 3E             JSR     spend_gold
003DDB  2  B0 03                BCS     :+
003DDD  2  4C 6E 3E             JMP     @poor
003DE0  2               :
003DE0  2  AD 4A 41             LDA     pmaxhp
003DE3  2  8D 49 41             STA     phealth
003DE6  2  A9 75 8D 64          SETSTAT t_healed
003DEA  2  41 A9 40 8D  
003DEE  2  65 41        
003DF0  2  4C B2 3D             JMP     @redraw
003DF3  2               @food:
003DF3  2  A9 14                LDA     #PRICE_FOOD
003DF5  2  20 89 3E             JSR     spend_gold
003DF8  2  90 74                BCC     @poor
003DFA  2  18                   CLC
003DFB  2  AD 50 41             LDA     pfood
003DFE  2  69 64                ADC     #100
003E00  2  8D 50 41             STA     pfood
003E03  2  AD 51 41             LDA     pfood+1
003E06  2  69 00                ADC     #0
003E08  2  8D 51 41             STA     pfood+1
003E0B  2  A9 94 8D 64          SETSTAT t_fed
003E0F  2  41 A9 40 8D  
003E13  2  65 41        
003E15  2  4C B2 3D             JMP     @redraw
003E18  2               @weapon:
003E18  2  AD 52 41             LDA     pweapon
003E1B  2  C9 03                CMP     #3
003E1D  2  B0 17                BCS     @maxwpn
003E1F  2  A9 3C                LDA     #PRICE_WEAPON
003E21  2  20 89 3E             JSR     spend_gold
003E24  2  90 48                BCC     @poor
003E26  2  EE 52 41             INC     pweapon
003E29  2  A9 B3 8D 64          SETSTAT t_boughtw
003E2D  2  41 A9 40 8D  
003E31  2  65 41        
003E33  2  4C B2 3D             JMP     @redraw
003E36  2               @maxwpn:
003E36  2  A9 F1 8D 64          SETSTAT t_maxed
003E3A  2  41 A9 40 8D  
003E3E  2  65 41        
003E40  2  4C B2 3D             JMP     @redraw
003E43  2               @armor:
003E43  2  AD 53 41             LDA     parmor
003E46  2  C9 03                CMP     #3
003E48  2  B0 17                BCS     @maxarm
003E4A  2  A9 32                LDA     #PRICE_ARMOR
003E4C  2  20 89 3E             JSR     spend_gold
003E4F  2  90 1D                BCC     @poor
003E51  2  EE 53 41             INC     parmor
003E54  2  A9 D2 8D 64          SETSTAT t_boughta
003E58  2  41 A9 40 8D  
003E5C  2  65 41        
003E5E  2  4C B2 3D             JMP     @redraw
003E61  2               @maxarm:
003E61  2  A9 F1 8D 64          SETSTAT t_maxed
003E65  2  41 A9 40 8D  
003E69  2  65 41        
003E6B  2  4C B2 3D             JMP     @redraw
003E6E  2               @poor:
003E6E  2  A9 10 8D 64          SETSTAT t_poor
003E72  2  41 A9 41 8D  
003E76  2  65 41        
003E78  2  4C B2 3D             JMP     @redraw
003E7B  2               @leave:
003E7B  2               ; fully restore the game screen, then report leaving
003E7B  2  20 65 08             JSR     full_redraw
003E7E  2  20 E2 33             JSR     msg_redraw
003E81  2  A9 2F A0 41          PRINTMSG_MSG t_bye
003E85  2  20 B3 33     
003E88  2  60                   RTS
003E89  2               
003E89  2               ;----------------------------------------------------------------
003E89  2               ; spend_gold - try to spend A gold.  C=1 success (gold deducted),
003E89  2               ;              C=0 if not enough.
003E89  2               ;----------------------------------------------------------------
003E89  2               spend_gold:
003E89  2  85 20                STA     tmp0
003E8B  2               ; gold >= tmp0 ?  (16-bit gold, 8-bit cost)
003E8B  2  AD 4F 41             LDA     pgold+1
003E8E  2  D0 07                BNE     @ok             ; high byte nonzero -> plenty
003E90  2  AD 4E 41             LDA     pgold
003E93  2  C5 20                CMP     tmp0
003E95  2  90 13                BCC     @no
003E97  2               @ok:
003E97  2  38                   SEC
003E98  2  AD 4E 41             LDA     pgold
003E9B  2  E5 20                SBC     tmp0
003E9D  2  8D 4E 41             STA     pgold
003EA0  2  AD 4F 41             LDA     pgold+1
003EA3  2  E9 00                SBC     #0
003EA5  2  8D 4F 41             STA     pgold+1
003EA8  2  38                   SEC
003EA9  2  60                   RTS
003EAA  2               @no:
003EAA  2  18                   CLC
003EAB  2  60                   RTS
003EAC  2               
003EAC  2               ;----------------------------------------------------------------
003EAC  2               ; Shop box geometry - a clean panel drawn inside the viewport,
003EAC  2               ; well clear of the bottom-right auto-scroll cell.
003EAC  2               ;----------------------------------------------------------------
003EAC  2               SHOP_X0         = 3             ; left column of box
003EAC  2               SHOP_X1         = 42            ; right column of box
003EAC  2               SHOP_Y0         = 4             ; top row of box
003EAC  2               SHOP_Y1         = 15            ; bottom row of box
003EAC  2               SHOP_W          = SHOP_X1-SHOP_X0+1
003EAC  2               
003EAC  2               ;----------------------------------------------------------------
003EAC  2               ; shop_draw - render the shop as a self-contained bordered panel.
003EAC  2               ; The whole box is repainted each call (background + border via
003EAC  2               ; direct VRAM, then text via firmware) so it is always clean.
003EAC  2               ;----------------------------------------------------------------
003EAC  2               shop_draw:
003EAC  2               ; --- paint box background + border directly to VRAM ---
003EAC  2  20 68 30             JSR     vid_enter
003EAF  2  A9 04                LDA     #SHOP_Y0
003EB1  2  85 27                STA     rowidx
003EB3  2               @bgrow:
003EB3  2  A5 27                LDA     rowidx
003EB5  2  20 7D 30             JSR     rowbase
003EB8  2  A0 03                LDY     #SHOP_X0
003EBA  2               @bgcol:
003EBA  2               ; border on edges, blank interior
003EBA  2  C0 03                CPY     #SHOP_X0
003EBC  2  F0 19                BEQ     @edge
003EBE  2  C0 2A                CPY     #SHOP_X1
003EC0  2  F0 15                BEQ     @edge
003EC2  2  A5 27                LDA     rowidx
003EC4  2  C9 04                CMP     #SHOP_Y0
003EC6  2  F0 0F                BEQ     @edge
003EC8  2  C9 0F                CMP     #SHOP_Y1
003ECA  2  F0 0B                BEQ     @edge
003ECC  2               ; interior cell
003ECC  2  A9 20                LDA     #space
003ECE  2  91 14                STA     (vptr),Y
003ED0  2  A9 1F                LDA     #C_SHOPBG
003ED2  2  91 16                STA     (cptr),Y
003ED4  2  4C DF 3E             JMP     @bgnext
003ED7  2               @edge:
003ED7  2  A9 20                LDA     #' '
003ED9  2  91 14                STA     (vptr),Y
003EDB  2  A9 1B                LDA     #C_SHOPBRD
003EDD  2  91 16                STA     (cptr),Y
003EDF  2               @bgnext:
003EDF  2  C8                   INY
003EE0  2  C0 2B                CPY     #SHOP_X1+1
003EE2  2  D0 D6                BNE     @bgcol
003EE4  2  E6 27                INC     rowidx
003EE6  2  A5 27                LDA     rowidx
003EE8  2  C9 10                CMP     #SHOP_Y1+1
003EEA  2  D0 C7                BNE     @bgrow
003EEC  2  20 77 30             JSR     vid_exit
003EEF  2               
003EEF  2               ; --- text lines via firmware (interior color C_SHOPBG) ---
003EEF  2  A9 1E                LDA     #C_SHOPTTL
003EF1  2  8D 4A 06             STA     CURCOLOR
003EF4  2  A2 0B                LDX     #SHOP_X0+8
003EF6  2  A0 04                LDY     #SHOP_Y0
003EF8  2  20 B6 31             JSR     locate
003EFB  2  A9 83 A0 3F          PRINTMSG t_header
003EFF  2  20 C8 31     
003F02  2               
003F02  2  A9 1F                LDA     #C_SHOPTXT
003F04  2  8D 4A 06             STA     CURCOLOR
003F07  2  A2 06                LDX     #SHOP_X0+3
003F09  2  A0 06                LDY     #SHOP_Y0+2
003F0B  2  20 B6 31             JSR     locate
003F0E  2  A9 8C A0 3F          PRINTMSG t_opt1
003F12  2  20 C8 31     
003F15  2  A2 06                LDX     #SHOP_X0+3
003F17  2  A0 07                LDY     #SHOP_Y0+3
003F19  2  20 B6 31             JSR     locate
003F1C  2  A9 A8 A0 3F          PRINTMSG t_opt2
003F20  2  20 C8 31     
003F23  2  A2 06                LDX     #SHOP_X0+3
003F25  2  A0 08                LDY     #SHOP_Y0+4
003F27  2  20 B6 31             JSR     locate
003F2A  2  A9 C4 A0 3F          PRINTMSG t_opt3
003F2E  2  20 C8 31     
003F31  2  A2 06                LDX     #SHOP_X0+3
003F33  2  A0 09                LDY     #SHOP_Y0+5
003F35  2  20 B6 31             JSR     locate
003F38  2  A9 E0 A0 3F          PRINTMSG t_opt4
003F3C  2  20 C8 31     
003F3F  2  A2 06                LDX     #SHOP_X0+3
003F41  2  A0 0A                LDY     #SHOP_Y0+6
003F43  2  20 B6 31             JSR     locate
003F46  2  A9 FC A0 3F          PRINTMSG t_optx
003F4A  2  20 C8 31     
003F4D  2               
003F4D  2               ; gold line
003F4D  2  A2 06                LDX     #SHOP_X0+3
003F4F  2  A0 0C                LDY     #SHOP_Y0+8
003F51  2  20 B6 31             JSR     locate
003F54  2  A9 1F                LDA     #C_SHOPTXT
003F56  2  8D 4A 06             STA     CURCOLOR
003F59  2  A9 0E A0 40          PRINTMSG t_gold
003F5D  2  20 C8 31     
003F60  2  AD 4E 41 85          COPY16  pgold, numarg
003F64  2  1E AD 4F 41  
003F68  2  85 1F        
003F6A  2  20 57 33             JSR     displaynum
003F6D  2               
003F6D  2               ; status line (last action / greeting)
003F6D  2  A2 06                LDX     #SHOP_X0+3
003F6F  2  A0 0E                LDY     #SHOP_Y1-1
003F71  2  20 B6 31             JSR     locate
003F74  2  A9 1A                LDA     #C_SHOPST
003F76  2  8D 4A 06             STA     CURCOLOR
003F79  2  AD 64 41             LDA     shopstat
003F7C  2  AC 65 41             LDY     shopstat+1
003F7F  2  20 C8 31             JSR     prmsg
003F82  2  60                   RTS
