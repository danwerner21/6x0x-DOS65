003CA5  2               
003CA5  1                       .INCLUDE "entity.asm"
003CA5  2               ;______________________________________________________________________________
003CA5  2               ;  entity.asm - monsters: table, spawning, simple AI, rendering
003CA5  2               ;
003CA5  2               ;  Parallel arrays of MAXMON slots.  A slot with mon_type == M_NONE
003CA5  2               ;  is empty.  Monsters live on the currently active map (overworld
003CA5  2               ;  or dungeon).  Towns have no monsters.
003CA5  2               ;______________________________________________________________________________
003CA5  2               
003CA5  2               ;----------------------------------------------------------------
003CA5  2               ; Per-monster-type stat tables (indexed by M_* id)
003CA5  2               ;   mtype_glyph : 2x2 metatile base glyph
003CA5  2               ;   mtype_color : color cell
003CA5  2               ;   mtype_hp    : starting HP
003CA5  2               ;   mtype_atk   : attack dice sides (damage 1..atk)
003CA5  2               ;   mtype_xp    : XP awarded on kill
003CA5  2               ;   mtype_gold  : gold dropped (max; rolled 0..gold)
003CA5  2               ;----------------------------------------------------------------
003CA5  2               mtype_glyph:
003CA5  2  20                   .BYTE   ' '             ; 0 none
003CA6  2  C8                   .BYTE   MG_ORC          ; 1 orc
003CA7  2  CC                   .BYTE   MG_SNAKE        ; 2 snake
003CA8  2  D0                   .BYTE   MG_SKELETON     ; 3 skeleton
003CA9  2  D4                   .BYTE   MG_THIEF        ; 4 thief
003CAA  2  D8                   .BYTE   MG_TROLL        ; 5 troll
003CAB  2  DC                   .BYTE   MG_BOSS         ; 6 boss (dragon)
003CAC  2  F0                   .BYTE   MG_WARDEN       ; 7 Wyrm Warden
003CAD  2               mtype_color:
003CAD  2  0C                   .BYTE   C_MONST         ; 0
003CAE  2  0C                   .BYTE   COLOR(CO_BRRED, CO_BLACK); orc
003CAF  2  0E                   .BYTE   COLOR(CO_BRYELLOW,CO_BLACK); snake
003CB0  2  0F                   .BYTE   COLOR(CO_BRWHITE,CO_BLACK); skeleton
003CB1  2  05                   .BYTE   COLOR(CO_VIOLET,CO_BLACK); thief
003CB2  2  0B                   .BYTE   COLOR(CO_BRTURQ,CO_BLACK); troll
003CB3  2  4C                   .BYTE   C_BOSS          ; boss
003CB4  2  0D                   .BYTE   COLOR(CO_BRPURPLE,CO_BLACK); Wyrm Warden
003CB5  2               mtype_hp:
003CB5  2  00 06 04 08          .BYTE   0, 6, 4, 8, 5, 14, 40, 24
003CB9  2  05 0E 28 18  
003CBD  2               mtype_atk:
003CBD  2  00 04 03 05          .BYTE   0, 4, 3, 5, 3, 7, 12, 8
003CC1  2  03 07 0C 08  
003CC5  2               mtype_xp:
003CC5  2  00 03 02 05          .BYTE   0, 3, 2, 5, 4, 10, 50, 25
003CC9  2  04 0A 32 19  
003CCD  2               mtype_gold:
003CCD  2  00 04 01 03          .BYTE   0, 4, 1, 3, 12, 8, 40, 0
003CD1  2  0C 08 28 00  
003CD5  2               
003CD5  2               ;----------------------------------------------------------------
003CD5  2               ; mon_clear_all - empty every monster slot.
003CD5  2               ;----------------------------------------------------------------
003CD5  2               mon_clear_all:
003CD5  2  A2 00                LDX     #0
003CD7  2  A9 00                LDA     #M_NONE
003CD9  2               @c:
003CD9  2  9D 91 4E             STA     mon_type,X
003CDC  2  E8                   INX
003CDD  2  E0 0C                CPX     #MAXMON
003CDF  2  D0 F8                BNE     @c
003CE1  2  60                   RTS
003CE2  2               
003CE2  2               ;----------------------------------------------------------------
003CE2  2               ; mon_find_free - find an empty slot.  Returns X = slot, C=1 ok,
003CE2  2               ;                 C=0 if table full.
003CE2  2               ;----------------------------------------------------------------
003CE2  2               mon_find_free:
003CE2  2  A2 00                LDX     #0
003CE4  2               @f:
003CE4  2  BD 91 4E             LDA     mon_type,X
003CE7  2  C9 00                CMP     #M_NONE
003CE9  2  F0 07                BEQ     @found
003CEB  2  E8                   INX
003CEC  2  E0 0C                CPX     #MAXMON
003CEE  2  D0 F4                BNE     @f
003CF0  2  18                   CLC
003CF1  2  60                   RTS
003CF2  2               @found:
003CF2  2  38                   SEC
003CF3  2  60                   RTS
003CF4  2               
003CF4  2               ;----------------------------------------------------------------
003CF4  2               ; mon_spawn - create a monster.
003CF4  2               ;   IN: A=type, tgtx=x, tgty=y
003CF4  2               ;   Sets hp from the type table.  No-op if table full.
003CF4  2               ;----------------------------------------------------------------
003CF4  2               mon_spawn:
003CF4  2  85 20                STA     tmp0            ; type
003CF6  2  20 E2 3C             JSR     mon_find_free
003CF9  2  90 17                BCC     @full
003CFB  2  A5 20                LDA     tmp0
003CFD  2  9D 91 4E             STA     mon_type,X
003D00  2  A5 2C                LDA     tgtx
003D02  2  9D 9D 4E             STA     mon_x,X
003D05  2  A5 2D                LDA     tgty
003D07  2  9D A9 4E             STA     mon_y,X
003D0A  2  A4 20                LDY     tmp0
003D0C  2  B9 B5 3C             LDA     mtype_hp,Y
003D0F  2  9D B5 4E             STA     mon_hp,X
003D12  2               @full:
003D12  2  60                   RTS
003D13  2               
003D13  2               ;----------------------------------------------------------------
003D13  2               ; mon_at - is there a live monster at (tgtx,tgty)?
003D13  2               ;          Returns X = slot and C=1 if found, else C=0.
003D13  2               ;----------------------------------------------------------------
003D13  2               mon_at:
003D13  2  A2 00                LDX     #0
003D15  2               @a:
003D15  2  BD 91 4E             LDA     mon_type,X
003D18  2  C9 00                CMP     #M_NONE
003D1A  2  F0 10                BEQ     @nextslot
003D1C  2  BD 9D 4E             LDA     mon_x,X
003D1F  2  C5 2C                CMP     tgtx
003D21  2  D0 09                BNE     @nextslot
003D23  2  BD A9 4E             LDA     mon_y,X
003D26  2  C5 2D                CMP     tgty
003D28  2  D0 02                BNE     @nextslot
003D2A  2  38                   SEC
003D2B  2  60                   RTS
003D2C  2               @nextslot:
003D2C  2  E8                   INX
003D2D  2  E0 0C                CPX     #MAXMON
003D2F  2  D0 E4                BNE     @a
003D31  2  18                   CLC
003D32  2  60                   RTS
003D33  2               
003D33  2               ;----------------------------------------------------------------
003D33  2               ; mon_kill - remove monster in slot X.
003D33  2               ;----------------------------------------------------------------
003D33  2               mon_kill:
003D33  2  A9 00                LDA     #M_NONE
003D35  2  9D 91 4E             STA     mon_type,X
003D38  2  60                   RTS
003D39  2               
003D39  2               ;----------------------------------------------------------------
003D39  2               ; spawn_overworld_monsters - scatter a handful of monsters on the
003D39  2               ; overworld at random passable land tiles near the centre.
003D39  2               ;----------------------------------------------------------------
003D39  2               spawn_overworld_monsters:
003D39  2  20 D5 3C             JSR     mon_clear_all
003D3C  2  A9 04                LDA     #4              ; only a few roaming monsters at a time
003D3E  2  85 24                STA     cnt0
003D40  2               @loop:
003D40  2               ; place in a ring roughly 6..21 tiles from the player: far
003D40  2               ; enough not to crowd you, near enough to be encountered.
003D40  2               ; offset = (rand(0..15) + 6), sign random per axis.
003D40  2  A9 10                LDA     #16
003D42  2  20 16 0C             JSR     rng_mod
003D45  2  18                   CLC
003D46  2  69 06                ADC     #6              ; 6..21
003D48  2  85 21                STA     tmp1            ; magnitude
003D4A  2  20 F6 0B             JSR     rng_next        ; random sign bit
003D4D  2  29 01                AND     #1
003D4F  2  F0 09                BEQ     @xplus
003D51  2  AD 6B 4D             LDA     px
003D54  2  38                   SEC
003D55  2  E5 21                SBC     tmp1
003D57  2  4C 60 3D             JMP     @setx
003D5A  2               @xplus:
003D5A  2  AD 6B 4D             LDA     px
003D5D  2  18                   CLC
003D5E  2  65 21                ADC     tmp1
003D60  2               @setx:
003D60  2  85 2C                STA     tgtx
003D62  2  A9 10                LDA     #16
003D64  2  20 16 0C             JSR     rng_mod
003D67  2  18                   CLC
003D68  2  69 06                ADC     #6
003D6A  2  85 21                STA     tmp1
003D6C  2  20 F6 0B             JSR     rng_next
003D6F  2  29 01                AND     #1
003D71  2  F0 09                BEQ     @yplus
003D73  2  AD 6C 4D             LDA     py
003D76  2  38                   SEC
003D77  2  E5 21                SBC     tmp1
003D79  2  4C 82 3D             JMP     @sety
003D7C  2               @yplus:
003D7C  2  AD 6C 4D             LDA     py
003D7F  2  18                   CLC
003D80  2  65 21                ADC     tmp1
003D82  2               @sety:
003D82  2  85 2D                STA     tgty
003D84  2               ; reject the player's own tile (don't spawn on top of you)
003D84  2  A5 2C                LDA     tgtx
003D86  2  CD 6B 4D             CMP     px
003D89  2  D0 07                BNE     @okpos
003D8B  2  A5 2D                LDA     tgty
003D8D  2  CD 6C 4D             CMP     py
003D90  2  F0 20                BEQ     @skip
003D92  2               @okpos:
003D92  2               ; must be passable grass/forest (not water/mountain/town...)
003D92  2  20 CF 19             JSR     tileat
003D95  2  A6 2E                LDX     tgttile
003D97  2  BD 89 18             LDA     tile_prop,X
003D9A  2  29 01                AND     #P_PASS
003D9C  2  F0 14                BEQ     @skip
003D9E  2  BD 89 18             LDA     tile_prop,X
003DA1  2  29 8C                AND     #(P_TOWN|P_DUNG|P_CASTLE)
003DA3  2  D0 0D                BNE     @skip           ; don't sit on a location entrance
003DA5  2               ; not already occupied by a monster?
003DA5  2  20 13 3D             JSR     mon_at
003DA8  2  B0 08                BCS     @skip
003DAA  2               ; pick a random monster type 1..5
003DAA  2  A9 05                LDA     #5
003DAC  2  20 26 0C             JSR     rng_d           ; 1..5
003DAF  2  20 F4 3C             JSR     mon_spawn
003DB2  2               @skip:
003DB2  2  C6 24                DEC     cnt0
003DB4  2  D0 8A                BNE     @loop
003DB6  2  60                   RTS
003DB7  2               
003DB7  2               ;----------------------------------------------------------------
003DB7  2               ; spawn_dungeon_monsters - place a few monsters and the boss.
003DB7  2               ;----------------------------------------------------------------
003DB7  2               spawn_dungeon_monsters:
003DB7  2  20 D5 3C             JSR     mon_clear_all
003DBA  2               ; the boss waits at the far corner treasure room (bottom-right)
003DBA  2  A9 1D                LDA     #29
003DBC  2  85 2C                STA     tgtx
003DBE  2  A9 12                LDA     #18
003DC0  2  85 2D                STA     tgty
003DC2  2  A9 06                LDA     #M_BOSS
003DC4  2  20 F4 3C             JSR     mon_spawn
003DC7  2               ; a couple of guards on floor tiles
003DC7  2  A9 04                LDA     #4
003DC9  2  85 24                STA     cnt0
003DCB  2               @loop:
003DCB  2  A9 1C                LDA     #28
003DCD  2  20 16 0C             JSR     rng_mod
003DD0  2  18                   CLC
003DD1  2  69 02                ADC     #2
003DD3  2  85 2C                STA     tgtx
003DD5  2  A9 10                LDA     #16
003DD7  2  20 16 0C             JSR     rng_mod
003DDA  2  18                   CLC
003DDB  2  69 02                ADC     #2
003DDD  2  85 2D                STA     tgty
003DDF  2  20 CF 19             JSR     tileat
003DE2  2  A6 2E                LDX     tgttile
003DE4  2  E0 09                CPX     #T_FLOOR
003DE6  2  D0 0B                BNE     @skip
003DE8  2  A9 02                LDA     #2              ; orc or skeleton
003DEA  2  20 26 0C             JSR     rng_d
003DED  2  18                   CLC
003DEE  2  69 02                ADC     #2              ; 3..4 -> skeleton/thief mix
003DF0  2  20 F4 3C             JSR     mon_spawn
003DF3  2               @skip:
003DF3  2  C6 24                DEC     cnt0
003DF5  2  D0 D4                BNE     @loop
003DF7  2  60                   RTS
003DF8  2               
003DF8  2               ;----------------------------------------------------------------
003DF8  2               ; spawn_shrine_monsters - the Wyrm Warden appears only while the
003DF8  2               ; key quest is active. Once defeated, the shrine remains cleared.
003DF8  2               ;----------------------------------------------------------------
003DF8  2               spawn_shrine_monsters:
003DF8  2  20 D5 3C             JSR     mon_clear_all
003DFB  2  AD 7E 4D             LDA     queststate
003DFE  2  C9 01                CMP     #QUEST_FIND_KEY
003E00  2  D0 0D                BNE     @done
003E02  2  A9 1B                LDA     #WARDEN_X
003E04  2  85 2C                STA     tgtx
003E06  2  A9 11                LDA     #WARDEN_Y
003E08  2  85 2D                STA     tgty
003E0A  2  A9 07                LDA     #M_WARDEN
003E0C  2  20 F4 3C             JSR     mon_spawn
003E0F  2               @done:
003E0F  2  60                   RTS
003E10  2               
003E10  2               ;----------------------------------------------------------------
003E10  2               ; draw_monsters_vram - overlay all visible monsters in the viewport.
003E10  2               ; Called by render_view while video is paged in.
003E10  2               ;----------------------------------------------------------------
003E10  2               draw_monsters_vram:
003E10  2  A2 00                LDX     #0
003E12  2  86 2F                STX     monidx
003E14  2               @dm:
003E14  2  A6 2F                LDX     monidx
003E16  2  BD 91 4E             LDA     mon_type,X
003E19  2  C9 00                CMP     #M_NONE
003E1B  2  F0 1A                BEQ     @next
003E1D  2               ; set world coords + glyph/color, then plot if visible
003E1D  2  BD 9D 4E             LDA     mon_x,X
003E20  2  85 2C                STA     tgtx
003E22  2  BD A9 4E             LDA     mon_y,X
003E25  2  85 2D                STA     tgty
003E27  2  BC 91 4E             LDY     mon_type,X
003E2A  2  B9 A5 3C             LDA     mtype_glyph,Y
003E2D  2  85 24                STA     cnt0            ; glyph (cnt0/cnt1 survive rowbase)
003E2F  2  B9 AD 3C             LDA     mtype_color,Y
003E32  2  85 25                STA     cnt1            ; color
003E34  2  20 C4 38             JSR     plot_view_cell
003E37  2               @next:
003E37  2  E6 2F                INC     monidx
003E39  2  A5 2F                LDA     monidx
003E3B  2  C9 0C                CMP     #MAXMON
003E3D  2  D0 D5                BNE     @dm
003E3F  2  60                   RTS
003E40  2               
003E40  2               ;----------------------------------------------------------------
003E40  2               ; mon_act - move/attack for every monster (called once per turn).
003E40  2               ; Monsters in LOC_TOWN never act (towns are safe).
003E40  2               ;   A monster adjacent to the player attacks; otherwise it steps
003E40  2               ;   one tile toward the player if the destination is passable and
003E40  2               ;   unoccupied.
003E40  2               ;----------------------------------------------------------------
003E40  2               mon_act:
003E40  2  AD 78 4D             LDA     loc
003E43  2  C9 01                CMP     #LOC_TOWN
003E45  2  F0 22                BEQ     @ret            ; safe in town
003E47  2  A2 00                LDX     #0
003E49  2  86 2F                STX     monidx
003E4B  2               @ma:
003E4B  2  A6 2F                LDX     monidx
003E4D  2  BD 91 4E             LDA     mon_type,X
003E50  2  C9 00                CMP     #M_NONE
003E52  2  F0 0D                BEQ     @next
003E54  2  C9 07                CMP     #M_WARDEN
003E56  2  D0 06                BNE     @normal
003E58  2  20 6A 3E             JSR     warden_act
003E5B  2  4C 61 3E             JMP     @next
003E5E  2               @normal:
003E5E  2               ; distance to player: dxv = px - mon_x ; dyv = py - mon_y
003E5E  2               ; adjacency test (|dx|<=1 && |dy|<=1 && not both 0)
003E5E  2  20 A2 3E             JSR     mon_step_or_attack
003E61  2               @next:
003E61  2  E6 2F                INC     monidx
003E63  2  A5 2F                LDA     monidx
003E65  2  C9 0C                CMP     #MAXMON
003E67  2  D0 E2                BNE     @ma
003E69  2               @ret:
003E69  2  60                   RTS
003E6A  2               
003E6A  2               ;----------------------------------------------------------------
003E6A  2               ; warden_act - the Wyrm Warden surges up to two tiles per turn.
003E6A  2               ; It stops after closing to melee range, so it attacks at most once
003E6A  2               ; per turn while remaining much harder to outrun than normal foes.
003E6A  2               ;----------------------------------------------------------------
003E6A  2               warden_act:
003E6A  2  20 7E 3E             JSR     mon_is_adjacent
003E6D  2  B0 0B                BCS     @attack
003E6F  2  20 A2 3E             JSR     mon_step_or_attack
003E72  2  20 7E 3E             JSR     mon_is_adjacent
003E75  2  B0 06                BCS     @done
003E77  2  4C A2 3E             JMP     mon_step_or_attack
003E7A  2               @attack:
003E7A  2  4C A2 3E             JMP     mon_step_or_attack
003E7D  2               @done:
003E7D  2  60                   RTS
003E7E  2               
003E7E  2               ; mon_is_adjacent - C=1 if monster in monidx is beside the player.
003E7E  2               mon_is_adjacent:
003E7E  2  A6 2F                LDX     monidx
003E80  2  38                   SEC
003E81  2  AD 6B 4D             LDA     px
003E84  2  FD 9D 4E             SBC     mon_x,X
003E87  2  20 35 3F             JSR     abs_a
003E8A  2  C9 02                CMP     #2
003E8C  2  B0 12                BCS     @no
003E8E  2  A6 2F                LDX     monidx
003E90  2  38                   SEC
003E91  2  AD 6C 4D             LDA     py
003E94  2  FD A9 4E             SBC     mon_y,X
003E97  2  20 35 3F             JSR     abs_a
003E9A  2  C9 02                CMP     #2
003E9C  2  B0 02                BCS     @no
003E9E  2  38                   SEC
003E9F  2  60                   RTS
003EA0  2               @no:
003EA0  2  18                   CLC
003EA1  2  60                   RTS
003EA2  2               
003EA2  2               ; mon_step_or_attack - for monster in slot monidx (X on entry).
003EA2  2               mon_step_or_attack:
003EA2  2               ; compute signed dx = px - mon_x  -> tmp0 ; dy -> tmp1
003EA2  2  A6 2F                LDX     monidx
003EA4  2  38                   SEC
003EA5  2  AD 6B 4D             LDA     px
003EA8  2  FD 9D 4E             SBC     mon_x,X
003EAB  2  85 20                STA     tmp0            ; dx (signed)
003EAD  2  38                   SEC
003EAE  2  AD 6C 4D             LDA     py
003EB1  2  FD A9 4E             SBC     mon_y,X
003EB4  2  85 21                STA     tmp1            ; dy (signed)
003EB6  2               ; |dx| <= 1 ?
003EB6  2  A5 20                LDA     tmp0
003EB8  2  20 35 3F             JSR     abs_a
003EBB  2  85 22                STA     tmp2            ; |dx|
003EBD  2  A5 21                LDA     tmp1
003EBF  2  20 35 3F             JSR     abs_a
003EC2  2  85 23                STA     tmp3            ; |dy|
003EC4  2               ; adjacency: |dx|<=1 and |dy|<=1
003EC4  2  A5 22                LDA     tmp2
003EC6  2  C9 02                CMP     #2
003EC8  2  B0 09                BCS     @move
003ECA  2  A5 23                LDA     tmp3
003ECC  2  C9 02                CMP     #2
003ECE  2  B0 03                BCS     @move
003ED0  2               ; adjacent (and since one of them is the player, not same cell)
003ED0  2               ; -> attack the player
003ED0  2  4C EE 42             JMP     monster_attacks_player; in combat.asm
003ED3  2               @move:
003ED3  2               ; step one tile toward player along the larger axis
003ED3  2               ; choose step in x: sign of dx
003ED3  2  A6 2F                LDX     monidx
003ED5  2  BD 9D 4E             LDA     mon_x,X
003ED8  2  85 2C                STA     tgtx
003EDA  2  BD A9 4E             LDA     mon_y,X
003EDD  2  85 2D                STA     tgty
003EDF  2               ; prefer horizontal if |dx|>=|dy|
003EDF  2  A5 22                LDA     tmp2
003EE1  2  C5 23                CMP     tmp3
003EE3  2  90 10                BCC     @vert
003EE5  2               ; horizontal step
003EE5  2  A5 20                LDA     tmp0
003EE7  2  F0 0C                BEQ     @vert           ; dx==0 -> try vertical
003EE9  2  30 05                BMI     @left
003EEB  2  E6 2C                INC     tgtx
003EED  2  4C 02 3F             JMP     @trymove
003EF0  2               @left:
003EF0  2  C6 2C                DEC     tgtx
003EF2  2  4C 02 3F             JMP     @trymove
003EF5  2               @vert:
003EF5  2  A5 21                LDA     tmp1
003EF7  2  F0 3B                BEQ     @done           ; dy==0 too -> no move
003EF9  2  30 05                BMI     @up
003EFB  2  E6 2D                INC     tgty
003EFD  2  4C 02 3F             JMP     @trymove
003F00  2               @up:
003F00  2  C6 2D                DEC     tgty
003F02  2               @trymove:
003F02  2               ; passable terrain?
003F02  2  20 CF 19             JSR     tileat
003F05  2  A6 2E                LDX     tgttile
003F07  2  BD 89 18             LDA     tile_prop,X
003F0A  2  29 01                AND     #P_PASS
003F0C  2  F0 26                BEQ     @done           ; blocked terrain
003F0E  2               ; monsters do not occupy map-transition landmarks
003F0E  2  BD 89 18             LDA     tile_prop,X
003F11  2  29 8C                AND     #(P_TOWN|P_DUNG|P_CASTLE)
003F13  2  D0 1F                BNE     @done
003F15  2               ; not onto the player?
003F15  2  A5 2C                LDA     tgtx
003F17  2  CD 6B 4D             CMP     px
003F1A  2  D0 07                BNE     @okcell
003F1C  2  A5 2D                LDA     tgty
003F1E  2  CD 6C 4D             CMP     py
003F21  2  F0 11                BEQ     @done           ; would land on player (shouldn't: adjacency handled)
003F23  2               @okcell:
003F23  2               ; not onto another monster?
003F23  2  20 13 3D             JSR     mon_at
003F26  2  B0 0C                BCS     @done           ; occupied
003F28  2               ; commit move
003F28  2  A6 2F                LDX     monidx
003F2A  2  A5 2C                LDA     tgtx
003F2C  2  9D 9D 4E             STA     mon_x,X
003F2F  2  A5 2D                LDA     tgty
003F31  2  9D A9 4E             STA     mon_y,X
003F34  2               @done:
003F34  2  60                   RTS
003F35  2               
003F35  2               ;----------------------------------------------------------------
003F35  2               ; abs_a - A = |A| treating A as signed 8-bit.
003F35  2               ;----------------------------------------------------------------
003F35  2               abs_a:
003F35  2  C9 80                CMP     #$80
003F37  2  90 05                BCC     @pos
003F39  2  49 FF                EOR     #$FF
003F3B  2  18                   CLC
003F3C  2  69 01                ADC     #1
003F3E  2               @pos:
003F3E  2  60                   RTS
003F3F  2               
003F3F  1                       .INCLUDE "player.asm"
003F3F  2               ;______________________________________________________________________________
003F3F  2               ;  player.asm - player movement, map transitions, treasure
003F3F  2               ;______________________________________________________________________________
003F3F  2               
003F3F  2               ;----------------------------------------------------------------
003F3F  2               ; Player starting state on the overworld.
003F3F  2               ;----------------------------------------------------------------
003F3F  2               PLAYER_START_X  = 20
003F3F  2               PLAYER_START_Y  = 9
003F3F  2               
003F3F  2               player_init:
003F3F  2  A9 14                LDA     #PLAYER_START_X
003F41  2  8D 6B 4D             STA     px
003F44  2  A9 09                LDA     #PLAYER_START_Y
003F46  2  8D 6C 4D             STA     py
003F49  2  A9 1E                LDA     #30
003F4B  2  8D 6D 4D             STA     phealth
003F4E  2  8D 6E 4D             STA     pmaxhp
003F51  2  A9 01                LDA     #1
003F53  2  8D 6F 4D             STA     plevel
003F56  2  A9 00                LDA     #0
003F58  2  8D 70 4D             STA     pxp
003F5B  2  8D 71 4D             STA     pxp+1
003F5E  2  A9 32                LDA     #50
003F60  2  8D 72 4D             STA     pgold
003F63  2  A9 00                LDA     #0
003F65  2  8D 73 4D             STA     pgold+1
003F68  2  A9 FA 8D 74          SETW16  pfood, 250
003F6C  2  4D A9 00 8D  
003F70  2  75 4D        
003F72  2  A9 01                LDA     #1
003F74  2  8D 76 4D             STA     pweapon         ; dagger
003F77  2  A9 00                LDA     #0
003F79  2  8D 77 4D             STA     parmor          ; clothes
003F7C  2  A9 00                LDA     #LOC_WORLD
003F7E  2  8D 78 4D             STA     loc
003F81  2  A9 00                LDA     #0
003F83  2  8D 7D 4D             STA     bosskilled
003F86  2  8D 7E 4D             STA     queststate
003F89  2  60                   RTS
003F8A  2               
003F8A  2               ;----------------------------------------------------------------
003F8A  2               ; try_move - attempt to move the player by (dx,dy).
003F8A  2               ;   IN: dx, dy = signed -1/0/+1 deltas
003F8A  2               ;   Effects: combat on bump, terrain block, town/dungeon entry,
003F8A  2               ;   treasure pickup, exit interiors, food cost.  Monsters act after
003F8A  2               ;   a successful step (handled by caller via did_move flag).
003F8A  2               ;   OUT: did_move (game var) = 1 if a turn was consumed.
003F8A  2               ;----------------------------------------------------------------
003F8A  2               try_move:
003F8A  2  A9 00                LDA     #0
003F8C  2  8D 7F 4D             STA     did_move
003F8F  2               ; target = (px+dx, py+dy)
003F8F  2  18                   CLC
003F90  2  AD 6B 4D             LDA     px
003F93  2  65 2A                ADC     dx
003F95  2  85 2C                STA     tgtx
003F97  2  18                   CLC
003F98  2  AD 6C 4D             LDA     py
003F9B  2  65 2B                ADC     dy
003F9D  2  85 2D                STA     tgty
003F9F  2               
003F9F  2               ; monster there? -> attack (consumes the turn)
003F9F  2  20 13 3D             JSR     mon_at
003FA2  2  90 09                BCC     @noenemy
003FA4  2               ; X = monster slot ; resolve combat
003FA4  2  20 DA 41             JSR     player_attacks_monster
003FA7  2  A9 01                LDA     #1
003FA9  2  8D 7F 4D             STA     did_move
003FAC  2  60                   RTS
003FAD  2               @noenemy:
003FAD  2               ; look at the terrain
003FAD  2  20 CF 19             JSR     tileat          ; -> tgttile
003FB0  2  A6 2E                LDX     tgttile
003FB2  2  BD 89 18             LDA     tile_prop,X
003FB5  2  85 20                STA     tmp0            ; property bits
003FB7  2  29 01                AND     #P_PASS
003FB9  2  D0 0B                BNE     @passable
003FBB  2               ; blocked
003FBB  2  20 2E 0D             JSR     sfx_blocked
003FBE  2  A9 DD A0 43          PRINTMSG_MSG m_blocked
003FC2  2  20 6D 39     
003FC5  2  60                   RTS                     ; no turn consumed on a wall bump
003FC6  2               @passable:
003FC6  2               ; check special tiles
003FC6  2  A5 20                LDA     tmp0
003FC8  2  29 04                AND     #P_TOWN
003FCA  2  F0 03                BEQ     @ck_castle
003FCC  2  4C 43 40             JMP     enter_town
003FCF  2               @ck_castle:
003FCF  2  A5 20                LDA     tmp0
003FD1  2  29 80                AND     #P_CASTLE
003FD3  2  F0 03                BEQ     @ck_dung
003FD5  2  4C 7E 40             JMP     enter_castle
003FD8  2               @ck_dung:
003FD8  2  A5 20                LDA     tmp0
003FDA  2  29 08                AND     #P_DUNG
003FDC  2  F0 03                BEQ     @ck_exit
003FDE  2  4C B9 40             JMP     enter_dungeon
003FE1  2               @ck_exit:
003FE1  2  A5 20                LDA     tmp0
003FE3  2  29 10                AND     #P_EXIT
003FE5  2  F0 03                BEQ     @ck_treas
003FE7  2  4C 27 41             JMP     leave_interior
003FEA  2               @ck_treas:
003FEA  2               ; commit the move first
003FEA  2  A5 2C                LDA     tgtx
003FEC  2  8D 6B 4D             STA     px
003FEF  2  A5 2D                LDA     tgty
003FF1  2  8D 6C 4D             STA     py
003FF4  2  A9 01                LDA     #1
003FF6  2  8D 7F 4D             STA     did_move
003FF9  2               ; treasure?
003FF9  2  A5 20                LDA     tmp0
003FFB  2  29 20                AND     #P_TREAS
003FFD  2  F0 03                BEQ     @food
003FFF  2  20 1C 40             JSR     collect_treasure
004002  2               @food:
004002  2               ; consume a unit of food per step
004002  2  AD 74 4D             LDA     pfood
004005  2  0D 75 4D             ORA     pfood+1
004008  2  F0 11                BEQ     @nofood
00400A  2  38                   SEC
00400B  2  AD 74 4D             LDA     pfood
00400E  2  E9 01                SBC     #1
004010  2  8D 74 4D             STA     pfood
004013  2  AD 75 4D             LDA     pfood+1
004016  2  E9 00                SBC     #0
004018  2  8D 75 4D             STA     pfood+1
00401B  2               @nofood:
00401B  2  60                   RTS
00401C  2               
00401C  2               ;----------------------------------------------------------------
00401C  2               ; collect_treasure - pick up a chest at (tgtx,tgty): gold + maybe
00401C  2               ; XP, then clear the tile to floor.
00401C  2               ;----------------------------------------------------------------
00401C  2               collect_treasure:
00401C  2               ; gold 5..20
00401C  2  A9 10                LDA     #16
00401E  2  20 26 0C             JSR     rng_d
004021  2  18                   CLC
004022  2  69 04                ADC     #4
004024  2               ; add to gold (16-bit)
004024  2  18                   CLC
004025  2  6D 72 4D             ADC     pgold
004028  2  8D 72 4D             STA     pgold
00402B  2  AD 73 4D             LDA     pgold+1
00402E  2  69 00                ADC     #0
004030  2  8D 73 4D             STA     pgold+1
004033  2               ; clear the chest tile -> floor
004033  2  A9 09                LDA     #T_FLOOR
004035  2  20 76 1A             JSR     settile
004038  2  20 93 0D             JSR     sfx_treasure
00403B  2  A9 E6 A0 43          PRINTMSG_MSG m_treasure
00403F  2  20 6D 39     
004042  2  60                   RTS
004043  2               
004043  2               ;----------------------------------------------------------------
004043  2               ; enter_town - switch to the town interior map.
004043  2               ;----------------------------------------------------------------
004043  2               enter_town:
004043  2  20 01 0E             JSR     sfx_door
004046  2  20 53 19             JSR     decode_town
004049  2  A9 01                LDA     #LOC_TOWN
00404B  2  8D 78 4D             STA     loc
00404E  2  A9 20                LDA     #TOWNW
004050  2  8D 79 4D             STA     locw
004053  2  A9 14                LDA     #TOWNH
004055  2  8D 7A 4D             STA     loch
004058  2               ; remember overworld position to restore on exit
004058  2  AD 6B 4D             LDA     px
00405B  2  8D 7B 4D             STA     owretx
00405E  2  AD 6C 4D             LDA     py
004061  2  8D 7C 4D             STA     owrety
004064  2               ; place player just inside, one tile NORTH of the door so the
004064  2               ; exit '+' is visible directly south of the player on entry.
004064  2  A9 0E                LDA     #14
004066  2  8D 6B 4D             STA     px
004069  2  A9 11                LDA     #TOWNH-3
00406B  2  8D 6C 4D             STA     py
00406E  2               ; towns have no monsters
00406E  2  20 D5 3C             JSR     mon_clear_all
004071  2  A9 01                LDA     #1
004073  2  8D 7F 4D             STA     did_move
004076  2  A9 01 A0 44          PRINTMSG_MSG m_town
00407A  2  20 6D 39     
00407D  2  60                   RTS
00407E  2               
00407E  2               ;----------------------------------------------------------------
00407E  2               ; enter_castle - switch to Wyrmhold Castle's audience chamber.
00407E  2               ;----------------------------------------------------------------
00407E  2               enter_castle:
00407E  2  20 01 0E             JSR     sfx_door
004081  2  20 91 19             JSR     decode_castle
004084  2  A9 03                LDA     #LOC_CASTLE
004086  2  8D 78 4D             STA     loc
004089  2  A9 20                LDA     #CASTLEW
00408B  2  8D 79 4D             STA     locw
00408E  2  A9 14                LDA     #CASTLEH
004090  2  8D 7A 4D             STA     loch
004093  2  AD 6B 4D             LDA     px
004096  2  8D 7B 4D             STA     owretx
004099  2  AD 6C 4D             LDA     py
00409C  2  8D 7C 4D             STA     owrety
00409F  2               ; enter on the carpet, immediately north of the exit
00409F  2  A9 0F                LDA     #15
0040A1  2  8D 6B 4D             STA     px
0040A4  2  A9 11                LDA     #CASTLEH-3
0040A6  2  8D 6C 4D             STA     py
0040A9  2  20 D5 3C             JSR     mon_clear_all
0040AC  2  A9 01                LDA     #1
0040AE  2  8D 7F 4D             STA     did_move
0040B1  2  A9 6B A0 49          PRINTMSG_MSG m_castle
0040B5  2  20 6D 39     
0040B8  2  60                   RTS
0040B9  2               
0040B9  2               ;----------------------------------------------------------------
0040B9  2               ; enter_dungeon - dispatch cave landmarks. The southern-marsh cave
0040B9  2               ; is the Sunken Shrine; the dragon's lair stays sealed until the
0040B9  2               ; Wyrm Key has been returned to King Aldren.
0040B9  2               ;----------------------------------------------------------------
0040B9  2               enter_dungeon:
0040B9  2  A5 2C                LDA     tgtx
0040BB  2  C9 14                CMP     #KEY_SITE_X
0040BD  2  D0 1B                BNE     @dragon
0040BF  2  A5 2D                LDA     tgty
0040C1  2  C9 3A                CMP     #KEY_SITE_Y
0040C3  2  D0 15                BNE     @dragon
0040C5  2  AD 7E 4D             LDA     queststate
0040C8  2  C9 01                CMP     #QUEST_FIND_KEY
0040CA  2  90 03                BCC     @shrine_dormant
0040CC  2  4C 60 4B             JMP     enter_shrine
0040CF  2               @shrine_dormant:
0040CF  2  20 2E 0D             JSR     sfx_blocked
0040D2  2  A9 CF A0 4B          PRINTMSG_MSG m_shrine_dormant
0040D6  2  20 6D 39     
0040D9  2  60                   RTS
0040DA  2               @dragon:
0040DA  2  AD 7E 4D             LDA     queststate
0040DD  2  C9 03                CMP     #QUEST_DUNG_OPEN
0040DF  2  B0 0B                BCS     @enter
0040E1  2  20 2E 0D             JSR     sfx_blocked
0040E4  2  A9 15 A0 4C          PRINTMSG_MSG m_dung_sealed
0040E8  2  20 6D 39     
0040EB  2  60                   RTS
0040EC  2               @enter:
0040EC  2  20 01 0E             JSR     sfx_door
0040EF  2  20 72 19             JSR     decode_dung
0040F2  2  A9 02                LDA     #LOC_DUNG
0040F4  2  8D 78 4D             STA     loc
0040F7  2  A9 20                LDA     #DUNGW
0040F9  2  8D 79 4D             STA     locw
0040FC  2  A9 14                LDA     #DUNGH
0040FE  2  8D 7A 4D             STA     loch
004101  2  AD 6B 4D             LDA     px
004104  2  8D 7B 4D             STA     owretx
004107  2  AD 6C 4D             LDA     py
00410A  2  8D 7C 4D             STA     owrety
00410D  2               ; start just east of the stairs-up '<' (at 1,1) so the exit
00410D  2               ; is visible immediately to the west of the player.
00410D  2  A9 02                LDA     #2
00410F  2  8D 6B 4D             STA     px
004112  2  A9 01                LDA     #1
004114  2  8D 6C 4D             STA     py
004117  2  20 B7 3D             JSR     spawn_dungeon_monsters
00411A  2  A9 01                LDA     #1
00411C  2  8D 7F 4D             STA     did_move
00411F  2  A9 40 A0 44          PRINTMSG_MSG m_dungeon
004123  2  20 6D 39     
004126  2  60                   RTS
004127  2               
004127  2               ;----------------------------------------------------------------
004127  2               ; leave_interior - return to the overworld at the saved position.
004127  2               ;----------------------------------------------------------------
004127  2               leave_interior:
004127  2  20 01 0E             JSR     sfx_door
00412A  2  20 34 19             JSR     decode_world
00412D  2  A9 00                LDA     #LOC_WORLD
00412F  2  8D 78 4D             STA     loc
004132  2  AD 7B 4D             LDA     owretx
004135  2  8D 6B 4D             STA     px
004138  2  AD 7C 4D             LDA     owrety
00413B  2  8D 6C 4D             STA     py
00413E  2  20 39 3D             JSR     spawn_overworld_monsters
004141  2  A9 01                LDA     #1
004143  2  8D 7F 4D             STA     did_move
004146  2  A9 73 A0 44          PRINTMSG_MSG m_world
00414A  2  20 6D 39     
00414D  2  60                   RTS
00414E  2               
00414E  1                       .INCLUDE "combat.asm"
00414E  2               ;______________________________________________________________________________
00414E  2               ;  combat.asm - bump combat resolution, leveling, message builder
00414E  2               ;______________________________________________________________________________
00414E  2               
00414E  2               ;----------------------------------------------------------------
00414E  2               ; Message builder.  Compose a line in mbuf then push to the log.
00414E  2               ;   mb_reset            - start a new line
00414E  2               ;   mb_str  (A=lo,Y=hi) - append a 0-terminated string
00414E  2               ;   mb_num  (A=byte)    - append a 0..255 value in decimal
00414E  2               ;   mb_mname(A=type)    - append a monster type name
00414E  2               ;   mb_flush            - push mbuf into the scrolling log
00414E  2               ;----------------------------------------------------------------
00414E  2               mb_reset:
00414E  2  A9 00                LDA     #0
004150  2  8D 90 4E             STA     mblen
004153  2  60                   RTS
004154  2               
004154  2               mb_str:
004154  2  85 1C                STA     strp
004156  2  84 1D                STY     strp+1
004158  2  A0 00                LDY     #0
00415A  2               @s:
00415A  2  B1 1C                LDA     (strp),Y
00415C  2  F0 0C                BEQ     @done
00415E  2  AE 90 4E             LDX     mblen
004161  2  9D 30 4E             STA     mbuf,X
004164  2  EE 90 4E             INC     mblen
004167  2  C8                   INY
004168  2  D0 F0                BNE     @s
00416A  2               @done:
00416A  2  60                   RTS
00416B  2               
00416B  2               ; append A (0..255) as decimal
00416B  2               mb_num:
00416B  2  85 1E                STA     numarg
00416D  2  A9 00                LDA     #0
00416F  2  85 1F                STA     numarg+1
004171  2               mb_num16:
004171  2               ; find highest place
004171  2  A0 08                LDY     #8
004173  2               @find:
004173  2  A5 1F                LDA     numarg+1
004175  2  D9 5B 39             CMP     nums+1,Y
004178  2  90 09                BCC     @nx
00417A  2  D0 0B                BNE     @start
00417C  2  A5 1E                LDA     numarg
00417E  2  D9 5A 39             CMP     nums,Y
004181  2  B0 04                BCS     @start
004183  2               @nx:
004183  2  88                   DEY
004184  2  88                   DEY
004185  2  D0 EC                BNE     @find
004187  2               @start:
004187  2  A9 30                LDA     #'0'
004189  2  85 28                STA     numspace
00418B  2               @dig:
00418B  2  A5 1F                LDA     numarg+1
00418D  2  D9 5B 39             CMP     nums+1,Y
004190  2  90 1E                BCC     @out
004192  2  D0 09                BNE     @noc
004194  2  A5 1E                LDA     numarg
004196  2  F9 5A 39             SBC     nums,Y
004199  2  90 15                BCC     @out
00419B  2  B0 05                BCS     @sub
00419D  2               @noc:
00419D  2  A5 1E                LDA     numarg
00419F  2  F9 5A 39             SBC     nums,Y
0041A2  2               @sub:
0041A2  2  E6 28                INC     numspace
0041A4  2  85 1E                STA     numarg
0041A6  2  A5 1F                LDA     numarg+1
0041A8  2  F9 5B 39             SBC     nums+1,Y
0041AB  2  85 1F                STA     numarg+1
0041AD  2  4C 8B 41             JMP     @dig
0041B0  2               @out:
0041B0  2  A5 28                LDA     numspace
0041B2  2  AE 90 4E             LDX     mblen
0041B5  2  9D 30 4E             STA     mbuf,X
0041B8  2  EE 90 4E             INC     mblen
0041BB  2  88                   DEY
0041BC  2  88                   DEY
0041BD  2  10 C8                BPL     @start
0041BF  2  60                   RTS
0041C0  2               
0041C0  2               ; append a monster type name (A = type id)
0041C0  2               mb_mname:
0041C0  2  0A                   ASL     A
0041C1  2  AA                   TAX
0041C2  2  BD 53 43             LDA     mon_names,X
0041C5  2  BC 54 43             LDY     mon_names+1,X
0041C8  2  4C 54 41             JMP     mb_str
0041CB  2               
0041CB  2               mb_flush:
0041CB  2  AE 90 4E             LDX     mblen
0041CE  2  A9 00                LDA     #0
0041D0  2  9D 30 4E             STA     mbuf,X          ; NUL terminate
0041D3  2  A9 30                LDA     #<mbuf
0041D5  2  A0 4E                LDY     #>mbuf
0041D7  2  4C 6D 39             JMP     msg_print
0041DA  2               
0041DA  2               ;----------------------------------------------------------------
0041DA  2               ; player_attacks_monster - X = monster slot.
0041DA  2               ;   Damage = 1..(weapon_power) + small bonus.  Apply, possibly kill.
0041DA  2               ;----------------------------------------------------------------
0041DA  2               player_attacks_monster:
0041DA  2  86 2F                STX     monidx
0041DC  2               ; damage roll: base from weapon
0041DC  2  AE 76 4D             LDX     pweapon
0041DF  2  BD 4B 43             LDA     wpn_power,X
0041E2  2  20 26 0C             JSR     rng_d           ; 1..power
0041E5  2  85 20                STA     tmp0            ; damage
0041E7  2               ; subtract from monster hp
0041E7  2  A6 2F                LDX     monidx
0041E9  2  38                   SEC
0041EA  2  BD B5 4E             LDA     mon_hp,X
0041ED  2  E5 20                SBC     tmp0
0041EF  2  9D B5 4E             STA     mon_hp,X
0041F2  2               ; build "You hit the Orc for N!"
0041F2  2  20 4E 41             JSR     mb_reset
0041F5  2  A9 9B                LDA     #<c_youhit
0041F7  2  A0 43                LDY     #>c_youhit
0041F9  2  20 54 41             JSR     mb_str
0041FC  2  A6 2F                LDX     monidx
0041FE  2  BD 91 4E             LDA     mon_type,X
004201  2  20 C0 41             JSR     mb_mname
004204  2  A9 A8                LDA     #<c_for
004206  2  A0 43                LDY     #>c_for
004208  2  20 54 41             JSR     mb_str
00420B  2  A5 20                LDA     tmp0
00420D  2  20 6B 41             JSR     mb_num
004210  2  A9 AE                LDA     #<c_bang
004212  2  A0 43                LDY     #>c_bang
004214  2  20 54 41             JSR     mb_str
004217  2  20 CB 41             JSR     mb_flush
00421A  2  20 4B 0D             JSR     sfx_hit
00421D  2               ; dead?  (hp <= 0 i.e. hp was <= damage -> result negative/zero)
00421D  2  A6 2F                LDX     monidx
00421F  2  BD B5 4E             LDA     mon_hp,X
004222  2  F0 03                BEQ     @dead
004224  2  30 01                BMI     @dead
004226  2  60                   RTS
004227  2               @dead:
004227  2  4C 2A 42             JMP     monster_dies
00422A  2               
00422A  2               ;----------------------------------------------------------------
00422A  2               ; monster_dies - award XP/gold, drop the slot, maybe win, maybe
00422A  2               ; level up.  Slot in monidx.
00422A  2               ;----------------------------------------------------------------
00422A  2               monster_dies:
00422A  2  A6 2F                LDX     monidx
00422C  2  BD 91 4E             LDA     mon_type,X
00422F  2  85 21                STA     tmp1            ; type
004231  2               ; XP
004231  2  A8                   TAY
004232  2  B9 C5 3C             LDA     mtype_xp,Y
004235  2  18                   CLC
004236  2  6D 70 4D             ADC     pxp
004239  2  8D 70 4D             STA     pxp
00423C  2  AD 71 4D             LDA     pxp+1
00423F  2  69 00                ADC     #0
004241  2  8D 71 4D             STA     pxp+1
004244  2               ; gold drop 0..mtype_gold
004244  2  A4 21                LDY     tmp1
004246  2  B9 CD 3C             LDA     mtype_gold,Y
004249  2  F0 12                BEQ     @nogold
00424B  2  20 16 0C             JSR     rng_mod         ; 0..gold-1
00424E  2  18                   CLC
00424F  2  6D 72 4D             ADC     pgold
004252  2  8D 72 4D             STA     pgold
004255  2  AD 73 4D             LDA     pgold+1
004258  2  69 00                ADC     #0
00425A  2  8D 73 4D             STA     pgold+1
00425D  2               @nogold:
00425D  2               ; message "The Orc dies!"
00425D  2  20 4E 41             JSR     mb_reset
004260  2  A9 B0                LDA     #<c_the
004262  2  A0 43                LDY     #>c_the
004264  2  20 54 41             JSR     mb_str
004267  2  A5 21                LDA     tmp1
004269  2  20 C0 41             JSR     mb_mname
00426C  2  A9 B5                LDA     #<c_dies
00426E  2  A0 43                LDY     #>c_dies
004270  2  20 54 41             JSR     mb_str
004273  2  20 CB 41             JSR     mb_flush
004276  2  20 76 0D             JSR     sfx_killed
004279  2               ; remove monster
004279  2  A6 2F                LDX     monidx
00427B  2  20 33 3D             JSR     mon_kill
00427E  2               ; quest miniboss?
00427E  2  A5 21                LDA     tmp1
004280  2  C9 07                CMP     #M_WARDEN
004282  2  D0 06                BNE     @boss
004284  2  20 B1 4B             JSR     award_wyrm_key
004287  2  4C 95 42             JMP     @lvl
00428A  2               ; final boss?
00428A  2               @boss:
00428A  2  A5 21                LDA     tmp1
00428C  2  C9 06                CMP     #M_BOSS
00428E  2  D0 05                BNE     @lvl
004290  2  A9 01                LDA     #1
004292  2  8D 7D 4D             STA     bosskilled
004295  2               @lvl:
004295  2  20 99 42             JSR     check_levelup
004298  2  60                   RTS
004299  2               
004299  2               ;----------------------------------------------------------------
004299  2               ; check_levelup - if xp >= level*20, level up (raise maxhp, heal).
004299  2               ;----------------------------------------------------------------
004299  2               check_levelup:
004299  2               ; threshold = plevel * 20  (8-bit is enough up to lvl 12)
004299  2  AD 6F 4D             LDA     plevel
00429C  2  85 20                STA     tmp0
00429E  2  A9 00                LDA     #0
0042A0  2  85 21                STA     tmp1
0042A2  2               ; tmp = level*20 = level*16 + level*4
0042A2  2  AD 6F 4D             LDA     plevel
0042A5  2  0A                   ASL     A
0042A6  2  0A                   ASL     A               ; *4
0042A7  2  85 22                STA     tmp2
0042A9  2  AD 6F 4D             LDA     plevel
0042AC  2  0A                   ASL     A
0042AD  2  0A                   ASL     A
0042AE  2  0A                   ASL     A
0042AF  2  0A                   ASL     A               ; *16
0042B0  2  18                   CLC
0042B1  2  65 22                ADC     tmp2
0042B3  2  85 22                STA     tmp2            ; level*20 (low); ignore >255 (caps fine)
0042B5  2               ; compare xp (16-bit) >= tmp2
0042B5  2  AD 71 4D             LDA     pxp+1
0042B8  2  D0 07                BNE     @levelup        ; xp >= 256 definitely past early thresholds
0042BA  2  AD 70 4D             LDA     pxp
0042BD  2  C5 22                CMP     tmp2
0042BF  2  90 2C                BCC     @done
0042C1  2               @levelup:
0042C1  2  EE 6F 4D             INC     plevel
0042C4  2               ; maxhp += 8, full heal
0042C4  2  AD 6E 4D             LDA     pmaxhp
0042C7  2  18                   CLC
0042C8  2  69 08                ADC     #8
0042CA  2  8D 6E 4D             STA     pmaxhp
0042CD  2  8D 6D 4D             STA     phealth
0042D0  2  20 CA 0D             JSR     sfx_levelup
0042D3  2  20 4E 41             JSR     mb_reset
0042D6  2  A9 CB                LDA     #<c_levelup
0042D8  2  A0 43                LDY     #>c_levelup
0042DA  2  20 54 41             JSR     mb_str
0042DD  2  AD 6F 4D             LDA     plevel
0042E0  2  20 6B 41             JSR     mb_num
0042E3  2  A9 AE                LDA     #<c_bang
0042E5  2  A0 43                LDY     #>c_bang
0042E7  2  20 54 41             JSR     mb_str
0042EA  2  20 CB 41             JSR     mb_flush
0042ED  2               @done:
0042ED  2  60                   RTS
0042EE  2               
0042EE  2               ;----------------------------------------------------------------
0042EE  2               ; monster_attacks_player - monster in slot monidx strikes.
0042EE  2               ;   Damage = 1..mtype_atk, reduced by armor.  Apply to phealth.
0042EE  2               ;----------------------------------------------------------------
0042EE  2               monster_attacks_player:
0042EE  2  A6 2F                LDX     monidx
0042F0  2  BD 91 4E             LDA     mon_type,X
0042F3  2  85 21                STA     tmp1            ; type
0042F5  2  A8                   TAY
0042F6  2  B9 BD 3C             LDA     mtype_atk,Y
0042F9  2  20 26 0C             JSR     rng_d           ; 1..atk
0042FC  2  85 20                STA     tmp0            ; raw damage
0042FE  2               ; armor reduces by armor index (0..3)
0042FE  2  AE 77 4D             LDX     parmor
004301  2  BD 4F 43             LDA     arm_def,X
004304  2  85 22                STA     tmp2
004306  2  38                   SEC
004307  2  A5 20                LDA     tmp0
004309  2  E5 22                SBC     tmp2
00430B  2  10 02                BPL     @ok
00430D  2  A9 01                LDA     #1              ; minimum 1 damage
00430F  2               @ok:
00430F  2  D0 02                BNE     @apply
004311  2  A9 01                LDA     #1
004313  2               @apply:
004313  2  85 20                STA     tmp0
004315  2               ; subtract from phealth (floor at 0)
004315  2  38                   SEC
004316  2  AD 6D 4D             LDA     phealth
004319  2  E5 20                SBC     tmp0
00431B  2  B0 02                BCS     @sethp
00431D  2  A9 00                LDA     #0
00431F  2               @sethp:
00431F  2  8D 6D 4D             STA     phealth
004322  2               ; message "Orc hits you for N!"
004322  2  20 4E 41             JSR     mb_reset
004325  2  A9 B0                LDA     #<c_the
004327  2  A0 43                LDY     #>c_the
004329  2  20 54 41             JSR     mb_str
00432C  2  A5 21                LDA     tmp1
00432E  2  20 C0 41             JSR     mb_mname
004331  2  A9 BC                LDA     #<c_hitsyou
004333  2  A0 43                LDY     #>c_hitsyou
004335  2  20 54 41             JSR     mb_str
004338  2  A5 20                LDA     tmp0
00433A  2  20 6B 41             JSR     mb_num
00433D  2  A9 AE                LDA     #<c_bang
00433F  2  A0 43                LDY     #>c_bang
004341  2  20 54 41             JSR     mb_str
004344  2  20 CB 41             JSR     mb_flush
004347  2  20 4B 0D             JSR     sfx_hit
00434A  2  60                   RTS
00434B  2               
00434B  2               ;----------------------------------------------------------------
00434B  2               ; Weapon power (damage sides) and armor defense tables
00434B  2               ;----------------------------------------------------------------
00434B  2               wpn_power:
00434B  2  02                   .BYTE   2               ; 0 fists
00434C  2  04                   .BYTE   4               ; 1 dagger
00434D  2  07                   .BYTE   7               ; 2 sword
00434E  2  0A                   .BYTE   10              ; 3 axe
00434F  2               arm_def:
00434F  2  00                   .BYTE   0               ; 0 clothes
004350  2  01                   .BYTE   1               ; 1 leather
004351  2  02                   .BYTE   2               ; 2 chain
004352  2  04                   .BYTE   4               ; 3 plate
004353  2               
004353  2               ;----------------------------------------------------------------
004353  2               ; Monster name table (for messages), indexed by type id
004353  2               ;----------------------------------------------------------------
004353  2               mon_names:
004353  2  63 43 69 43          .WORD   mn_none, mn_orc, mn_snake, mn_skel, mn_thief, mn_troll, mn_boss, mn_warden
004357  2  6D 43 73 43  
00435B  2  7C 43 82 43  
004363  2               mn_none:
004363  2  74 68 69 6E          .BYTE   "thing",0
004367  2  67 00        
004369  2               mn_orc:
004369  2  4F 72 63 00          .BYTE   "Orc",0
00436D  2               mn_snake:
00436D  2  53 6E 61 6B          .BYTE   "Snake",0
004371  2  65 00        
004373  2               mn_skel:
004373  2  53 6B 65 6C          .BYTE   "Skeleton",0
004377  2  65 74 6F 6E  
00437B  2  00           
00437C  2               mn_thief:
00437C  2  54 68 69 65          .BYTE   "Thief",0
004380  2  66 00        
004382  2               mn_troll:
004382  2  54 72 6F 6C          .BYTE   "Troll",0
004386  2  6C 00        
004388  2               mn_boss:
004388  2  44 72 61 67          .BYTE   "Dragon",0
00438C  2  6F 6E 00     
00438F  2               mn_warden:
00438F  2  57 79 72 6D          .BYTE   "Wyrm Warden",0
004393  2  20 57 61 72  
004397  2  64 65 6E 00  
00439B  2               
00439B  2               ;----------------------------------------------------------------
00439B  2               ; Combat / event message fragments
00439B  2               ;----------------------------------------------------------------
00439B  2               c_youhit:
00439B  2  59 6F 75 20          .BYTE   "You hit the ",0
00439F  2  68 69 74 20  
0043A3  2  74 68 65 20  
0043A8  2               c_for:
0043A8  2  20 66 6F 72          .BYTE   " for ",0
0043AC  2  20 00        
0043AE  2               c_bang:
0043AE  2  21 00                .BYTE   "!",0
0043B0  2               c_the:
0043B0  2  54 68 65 20          .BYTE   "The ",0
0043B4  2  00           
0043B5  2               c_dies:
0043B5  2  20 64 69 65          .BYTE   " dies!",0
0043B9  2  73 21 00     
0043BC  2               c_hitsyou:
0043BC  2  20 68 69 74          .BYTE   " hits you for ",0
0043C0  2  73 20 79 6F  
0043C4  2  75 20 66 6F  
0043CB  2               c_levelup:
0043CB  2  57 65 6C 63          .BYTE   "Welcome to level ",0
0043CF  2  6F 6D 65 20  
0043D3  2  74 6F 20 6C  
0043DD  2               
0043DD  2               ;----------------------------------------------------------------
0043DD  2               ; Map / event messages (shared with player.asm)
0043DD  2               ;----------------------------------------------------------------
0043DD  2               m_blocked:
0043DD  2  42 6C 6F 63          .BYTE   "Blocked!",0
0043E1  2  6B 65 64 21  
0043E5  2  00           
0043E6  2               m_treasure:
0043E6  2  59 6F 75 20          .BYTE   "You found gold in a chest!",0
0043EA  2  66 6F 75 6E  
0043EE  2  64 20 67 6F  
004401  2               m_town:
004401  2  54 6F 77 6E          .BYTE   "Town. Step on the door '+' (south) to leave. T at 'S' to shop.",0
004405  2  2E 20 53 74  
004409  2  65 70 20 6F  
004440  2               m_dungeon:
004440  2  44 75 6E 67          .BYTE   "Dungeon! Step on the stairs '<' to climb back out.",0
004444  2  65 6F 6E 21  
004448  2  20 53 74 65  
004473  2               m_world:
004473  2  59 6F 75 20          .BYTE   "You return to the land of Wyrmhold.",0
004477  2  72 65 74 75  
00447B  2  72 6E 20 74  
004497  2               
004497  1                       .INCLUDE "town.asm"
004497  2               ;______________________________________________________________________________
004497  2               ;  town.asm - shop interaction inside towns
004497  2               ;
004497  2               ;  When the player presses USE ('T') in a town while adjacent to a
004497  2               ;  shop counter ('S' tile), the shop menu opens.  The menu is drawn
004497  2               ;  over the message rows; the player picks an option, gold is spent,
004497  2               ;  and the menu returns to the map.
004497  2               ;______________________________________________________________________________
004497  2               
004497  2               PRICE_HEAL      = 10            ; gold per visit (full heal)
004497  2               PRICE_FOOD      = 20            ; gold for +100 food
004497  2               PRICE_WEAPON    = 60            ; gold to upgrade weapon one tier
004497  2               PRICE_ARMOR     = 50            ; gold to upgrade armor one tier
004497  2               
004497  2               ;----------------------------------------------------------------
004497  2               ; use_action - bound to the USE key ('T'). Dispatch contextual
004497  2               ; interactions for the active location.
004497  2               ;----------------------------------------------------------------
004497  2               use_action:
004497  2  AD 78 4D             LDA     loc
00449A  2  C9 03                CMP     #LOC_CASTLE
00449C  2  F0 0C                BEQ     @incastle
00449E  2  C9 01                CMP     #LOC_TOWN
0044A0  2  F0 0B                BEQ     @intown
0044A2  2  A9 B9 A0 47          PRINTMSG_MSG t_nothing
0044A6  2  20 6D 39     
0044A9  2  60                   RTS
0044AA  2               @incastle:
0044AA  2  4C C9 48             JMP     castle_use
0044AD  2               @intown:
0044AD  2               ; is a shop tile adjacent (4-neighbour) or under us?
0044AD  2  20 BD 44             JSR     shop_adjacent
0044B0  2  B0 08                BCS     @open
0044B2  2  A9 CA A0 47          PRINTMSG_MSG t_noshop
0044B6  2  20 6D 39     
0044B9  2  60                   RTS
0044BA  2               @open:
0044BA  2  4C 27 45             JMP     shop_menu
0044BD  2               
0044BD  2               ;----------------------------------------------------------------
0044BD  2               ; shop_adjacent - C=1 if a T_SHOP tile is at or next to the player.
0044BD  2               ;----------------------------------------------------------------
0044BD  2               shop_adjacent:
0044BD  2               ; center
0044BD  2  AD 6B 4D             LDA     px
0044C0  2  85 2C                STA     tgtx
0044C2  2  AD 6C 4D             LDA     py
0044C5  2  85 2D                STA     tgty
0044C7  2  20 CF 19             JSR     tileat
0044CA  2  A5 2E                LDA     tgttile
0044CC  2  C9 0E                CMP     #T_SHOP
0044CE  2  F0 55                BEQ     @yes
0044D0  2               ; up
0044D0  2  AD 6B 4D             LDA     px
0044D3  2  85 2C                STA     tgtx
0044D5  2  AD 6C 4D             LDA     py
0044D8  2  38                   SEC
0044D9  2  E9 01                SBC     #1
0044DB  2  85 2D                STA     tgty
0044DD  2  20 CF 19             JSR     tileat
0044E0  2  A5 2E                LDA     tgttile
0044E2  2  C9 0E                CMP     #T_SHOP
0044E4  2  F0 3F                BEQ     @yes
0044E6  2               ; down
0044E6  2  AD 6C 4D             LDA     py
0044E9  2  18                   CLC
0044EA  2  69 01                ADC     #1
0044EC  2  85 2D                STA     tgty
0044EE  2  AD 6B 4D             LDA     px
0044F1  2  85 2C                STA     tgtx
0044F3  2  20 CF 19             JSR     tileat
0044F6  2  A5 2E                LDA     tgttile
0044F8  2  C9 0E                CMP     #T_SHOP
0044FA  2  F0 29                BEQ     @yes
0044FC  2               ; left
0044FC  2  AD 6C 4D             LDA     py
0044FF  2  85 2D                STA     tgty
004501  2  AD 6B 4D             LDA     px
004504  2  38                   SEC
004505  2  E9 01                SBC     #1
004507  2  85 2C                STA     tgtx
004509  2  20 CF 19             JSR     tileat
00450C  2  A5 2E                LDA     tgttile
00450E  2  C9 0E                CMP     #T_SHOP
004510  2  F0 13                BEQ     @yes
004512  2               ; right
004512  2  AD 6B 4D             LDA     px
004515  2  18                   CLC
004516  2  69 01                ADC     #1
004518  2  85 2C                STA     tgtx
00451A  2  20 CF 19             JSR     tileat
00451D  2  A5 2E                LDA     tgttile
00451F  2  C9 0E                CMP     #T_SHOP
004521  2  F0 02                BEQ     @yes
004523  2  18                   CLC
004524  2  60                   RTS
004525  2               @yes:
004525  2  38                   SEC
004526  2  60                   RTS
004527  2               
004527  2               ;----------------------------------------------------------------
004527  2               ; shop_menu - draw the shop menu over the message area and loop
004527  2               ; processing purchases until the player presses X.
004527  2               ;----------------------------------------------------------------
004527  2               shop_menu:
004527  2  20 01 0E             JSR     sfx_door
00452A  2               ; start with the greeting as the status line
00452A  2  A9 9B                LDA     #<t_greet
00452C  2  8D 89 4D             STA     shopstat
00452F  2  A9 47                LDA     #>t_greet
004531  2  8D 8A 4D             STA     shopstat+1
004534  2               @redraw:
004534  2  20 2E 46             JSR     shop_draw
004537  2               @key:
004537  2  20 5D 3B             JSR     getkey_block
00453A  2  C9 31                CMP     #'1'
00453C  2  F0 1A                BEQ     @heal
00453E  2  C9 32                CMP     #'2'
004540  2  F0 33                BEQ     @food
004542  2  C9 33                CMP     #'3'
004544  2  F0 54                BEQ     @weapon
004546  2  C9 34                CMP     #'4'
004548  2  F0 7B                BEQ     @armor
00454A  2  C9 58                CMP     #'X'
00454C  2  F0 07                BEQ     @goleave
00454E  2  C9 78                CMP     #'x'
004550  2  F0 03                BEQ     @goleave
004552  2  4C 37 45             JMP     @key
004555  2               @goleave:
004555  2  4C FD 45             JMP     @leave
004558  2               @heal:
004558  2  A9 0A                LDA     #PRICE_HEAL
00455A  2  20 0B 46             JSR     spend_gold
00455D  2  B0 03                BCS     :+
00455F  2  4C F0 45             JMP     @poor
004562  2               :
004562  2  AD 6E 4D             LDA     pmaxhp
004565  2  8D 6D 4D             STA     phealth
004568  2  A9 F7 8D 89          SETSTAT t_healed
00456C  2  4D A9 47 8D  
004570  2  8A 4D        
004572  2  4C 34 45             JMP     @redraw
004575  2               @food:
004575  2  A9 14                LDA     #PRICE_FOOD
004577  2  20 0B 46             JSR     spend_gold
00457A  2  90 74                BCC     @poor
00457C  2  18                   CLC
00457D  2  AD 74 4D             LDA     pfood
004580  2  69 64                ADC     #100
004582  2  8D 74 4D             STA     pfood
004585  2  AD 75 4D             LDA     pfood+1
004588  2  69 00                ADC     #0
00458A  2  8D 75 4D             STA     pfood+1
00458D  2  A9 16 8D 89          SETSTAT t_fed
004591  2  4D A9 48 8D  
004595  2  8A 4D        
004597  2  4C 34 45             JMP     @redraw
00459A  2               @weapon:
00459A  2  AD 76 4D             LDA     pweapon
00459D  2  C9 03                CMP     #3
00459F  2  B0 17                BCS     @maxwpn
0045A1  2  A9 3C                LDA     #PRICE_WEAPON
0045A3  2  20 0B 46             JSR     spend_gold
0045A6  2  90 48                BCC     @poor
0045A8  2  EE 76 4D             INC     pweapon
0045AB  2  A9 35 8D 89          SETSTAT t_boughtw
0045AF  2  4D A9 48 8D  
0045B3  2  8A 4D        
0045B5  2  4C 34 45             JMP     @redraw
0045B8  2               @maxwpn:
0045B8  2  A9 73 8D 89          SETSTAT t_maxed
0045BC  2  4D A9 48 8D  
0045C0  2  8A 4D        
0045C2  2  4C 34 45             JMP     @redraw
0045C5  2               @armor:
0045C5  2  AD 77 4D             LDA     parmor
0045C8  2  C9 03                CMP     #3
0045CA  2  B0 17                BCS     @maxarm
0045CC  2  A9 32                LDA     #PRICE_ARMOR
0045CE  2  20 0B 46             JSR     spend_gold
0045D1  2  90 1D                BCC     @poor
0045D3  2  EE 77 4D             INC     parmor
0045D6  2  A9 54 8D 89          SETSTAT t_boughta
0045DA  2  4D A9 48 8D  
0045DE  2  8A 4D        
0045E0  2  4C 34 45             JMP     @redraw
0045E3  2               @maxarm:
0045E3  2  A9 73 8D 89          SETSTAT t_maxed
0045E7  2  4D A9 48 8D  
0045EB  2  8A 4D        
0045ED  2  4C 34 45             JMP     @redraw
0045F0  2               @poor:
0045F0  2  A9 92 8D 89          SETSTAT t_poor
0045F4  2  4D A9 48 8D  
0045F8  2  8A 4D        
0045FA  2  4C 34 45             JMP     @redraw
0045FD  2               @leave:
0045FD  2               ; fully restore the game screen, then report leaving
0045FD  2  20 65 08             JSR     full_redraw
004600  2  20 9C 39             JSR     msg_redraw
004603  2  A9 B1 A0 48          PRINTMSG_MSG t_bye
004607  2  20 6D 39     
00460A  2  60                   RTS
00460B  2               
00460B  2               ;----------------------------------------------------------------
00460B  2               ; spend_gold - try to spend A gold.  C=1 success (gold deducted),
00460B  2               ;              C=0 if not enough.
00460B  2               ;----------------------------------------------------------------
00460B  2               spend_gold:
00460B  2  85 20                STA     tmp0
00460D  2               ; gold >= tmp0 ?  (16-bit gold, 8-bit cost)
00460D  2  AD 73 4D             LDA     pgold+1
004610  2  D0 07                BNE     @ok             ; high byte nonzero -> plenty
004612  2  AD 72 4D             LDA     pgold
004615  2  C5 20                CMP     tmp0
004617  2  90 13                BCC     @no
004619  2               @ok:
004619  2  38                   SEC
00461A  2  AD 72 4D             LDA     pgold
00461D  2  E5 20                SBC     tmp0
00461F  2  8D 72 4D             STA     pgold
004622  2  AD 73 4D             LDA     pgold+1
004625  2  E9 00                SBC     #0
004627  2  8D 73 4D             STA     pgold+1
00462A  2  38                   SEC
00462B  2  60                   RTS
00462C  2               @no:
00462C  2  18                   CLC
00462D  2  60                   RTS
00462E  2               
00462E  2               ;----------------------------------------------------------------
00462E  2               ; Shop box geometry - a clean panel drawn inside the viewport,
00462E  2               ; well clear of the bottom-right auto-scroll cell.
00462E  2               ;----------------------------------------------------------------
00462E  2               SHOP_X0         = 3             ; left column of box
00462E  2               SHOP_X1         = 42            ; right column of box
00462E  2               SHOP_Y0         = 4             ; top row of box
00462E  2               SHOP_Y1         = 15            ; bottom row of box
00462E  2               SHOP_W          = SHOP_X1-SHOP_X0+1
00462E  2               
00462E  2               ;----------------------------------------------------------------
00462E  2               ; shop_draw - render the shop as a self-contained bordered panel.
00462E  2               ; The whole box is repainted each call (background + border via
00462E  2               ; direct VRAM, then text via firmware) so it is always clean.
00462E  2               ;----------------------------------------------------------------
00462E  2               shop_draw:
00462E  2               ; --- paint box background + border directly to VRAM ---
00462E  2  20 04 36             JSR     vid_enter
004631  2  A9 04                LDA     #SHOP_Y0
004633  2  85 27                STA     rowidx
004635  2               @bgrow:
004635  2  A5 27                LDA     rowidx
004637  2  20 19 36             JSR     rowbase
00463A  2  A0 03                LDY     #SHOP_X0
00463C  2               @bgcol:
00463C  2               ; border on edges, blank interior
00463C  2  C0 03                CPY     #SHOP_X0
00463E  2  F0 19                BEQ     @edge
004640  2  C0 2A                CPY     #SHOP_X1
004642  2  F0 15                BEQ     @edge
004644  2  A5 27                LDA     rowidx
004646  2  C9 04                CMP     #SHOP_Y0
004648  2  F0 0F                BEQ     @edge
00464A  2  C9 0F                CMP     #SHOP_Y1
00464C  2  F0 0B                BEQ     @edge
00464E  2               ; interior cell
00464E  2  A9 20                LDA     #space
004650  2  91 14                STA     (vptr),Y
004652  2  A9 1F                LDA     #C_SHOPBG
004654  2  91 16                STA     (cptr),Y
004656  2  4C 61 46             JMP     @bgnext
004659  2               @edge:
004659  2  A9 20                LDA     #' '
00465B  2  91 14                STA     (vptr),Y
00465D  2  A9 1B                LDA     #C_SHOPBRD
00465F  2  91 16                STA     (cptr),Y
004661  2               @bgnext:
004661  2  C8                   INY
004662  2  C0 2B                CPY     #SHOP_X1+1
004664  2  D0 D6                BNE     @bgcol
004666  2  E6 27                INC     rowidx
004668  2  A5 27                LDA     rowidx
00466A  2  C9 10                CMP     #SHOP_Y1+1
00466C  2  D0 C7                BNE     @bgrow
00466E  2  20 13 36             JSR     vid_exit
004671  2               
004671  2               ; --- text lines via firmware (interior color C_SHOPBG) ---
004671  2  A9 1E                LDA     #C_SHOPTTL
004673  2  8D 4A 06             STA     CURCOLOR
004676  2  A2 0B                LDX     #SHOP_X0+8
004678  2  A0 04                LDY     #SHOP_Y0
00467A  2  20 52 37             JSR     locate
00467D  2  A9 05 A0 47          PRINTMSG t_header
004681  2  20 64 37     
004684  2               
004684  2  A9 1F                LDA     #C_SHOPTXT
004686  2  8D 4A 06             STA     CURCOLOR
004689  2  A2 06                LDX     #SHOP_X0+3
00468B  2  A0 06                LDY     #SHOP_Y0+2
00468D  2  20 52 37             JSR     locate
004690  2  A9 0E A0 47          PRINTMSG t_opt1
004694  2  20 64 37     
004697  2  A2 06                LDX     #SHOP_X0+3
004699  2  A0 07                LDY     #SHOP_Y0+3
00469B  2  20 52 37             JSR     locate
00469E  2  A9 2A A0 47          PRINTMSG t_opt2
0046A2  2  20 64 37     
0046A5  2  A2 06                LDX     #SHOP_X0+3
0046A7  2  A0 08                LDY     #SHOP_Y0+4
0046A9  2  20 52 37             JSR     locate
0046AC  2  A9 46 A0 47          PRINTMSG t_opt3
0046B0  2  20 64 37     
0046B3  2  A2 06                LDX     #SHOP_X0+3
0046B5  2  A0 09                LDY     #SHOP_Y0+5
0046B7  2  20 52 37             JSR     locate
0046BA  2  A9 62 A0 47          PRINTMSG t_opt4
0046BE  2  20 64 37     
0046C1  2  A2 06                LDX     #SHOP_X0+3
0046C3  2  A0 0A                LDY     #SHOP_Y0+6
0046C5  2  20 52 37             JSR     locate
0046C8  2  A9 7E A0 47          PRINTMSG t_optx
0046CC  2  20 64 37     
0046CF  2               
0046CF  2               ; gold line
0046CF  2  A2 06                LDX     #SHOP_X0+3
0046D1  2  A0 0C                LDY     #SHOP_Y0+8
0046D3  2  20 52 37             JSR     locate
0046D6  2  A9 1F                LDA     #C_SHOPTXT
0046D8  2  8D 4A 06             STA     CURCOLOR
0046DB  2  A9 90 A0 47          PRINTMSG t_gold
0046DF  2  20 64 37     
0046E2  2  AD 72 4D 85          COPY16  pgold, numarg
0046E6  2  1E AD 73 4D  
0046EA  2  85 1F        
0046EC  2  20 11 39             JSR     displaynum
0046EF  2               
0046EF  2               ; status line (last action / greeting)
0046EF  2  A2 06                LDX     #SHOP_X0+3
0046F1  2  A0 0E                LDY     #SHOP_Y1-1
0046F3  2  20 52 37             JSR     locate
0046F6  2  A9 1A                LDA     #C_SHOPST
0046F8  2  8D 4A 06             STA     CURCOLOR
0046FB  2  AD 89 4D             LDA     shopstat
0046FE  2  AC 8A 4D             LDY     shopstat+1
004701  2  20 64 37             JSR     prmsg
004704  2  60                   RTS
004705  2               
004705  2               ;----------------------------------------------------------------
004705  2               ; Shop strings
004705  2               ;----------------------------------------------------------------
004705  2               t_header:
004705  2  2D 20 53 48          .BYTE   "- SHOP -",0
004709  2  4F 50 20 2D  
00470D  2  00           
00470E  2               t_opt1:
00470E  2  31 29 20 48          .BYTE   "1) Heal to full     10 gold",0
004712  2  65 61 6C 20  
004716  2  74 6F 20 66  
00472A  2               t_opt2:
00472A  2  32 29 20 50          .BYTE   "2) Provisions +100  20 gold",0
00472E  2  72 6F 76 69  
004732  2  73 69 6F 6E  
004746  2               t_opt3:
004746  2  33 29 20 42          .BYTE   "3) Better weapon    60 gold",0
00474A  2  65 74 74 65  
00474E  2  72 20 77 65  
004762  2               t_opt4:
004762  2  34 29 20 42          .BYTE   "4) Better armor     50 gold",0
004766  2  65 74 74 65  
00476A  2  72 20 61 72  
00477E  2               t_optx:
00477E  2  58 29 20 4C          .BYTE   "X) Leave the shop",0
004782  2  65 61 76 65  
004786  2  20 74 68 65  
004790  2               t_gold:
004790  2  54 68 79 20          .BYTE   "Thy gold: ",0
004794  2  67 6F 6C 64  
004798  2  3A 20 00     
00479B  2               
00479B  2               t_greet:
00479B  2  57 65 6C 63          .BYTE   "Welcome! What dost thou need?",0
00479F  2  6F 6D 65 21  
0047A3  2  20 57 68 61  
0047B9  2               t_nothing:
0047B9  2  4E 6F 74 68          .BYTE   "Nothing happens.",0
0047BD  2  69 6E 67 20  
0047C1  2  68 61 70 70  
0047CA  2               t_noshop:
0047CA  2  54 68 65 72          .BYTE   "There is no shop here. Find the 'S' counter.",0
0047CE  2  65 20 69 73  
0047D2  2  20 6E 6F 20  
0047F7  2               t_healed:
0047F7  2  54 68 6F 75          .BYTE   "Thou art fully healed.        ",0
0047FB  2  20 61 72 74  
0047FF  2  20 66 75 6C  
004816  2               t_fed:
004816  2  50 72 6F 76          .BYTE   "Provisions purchased.         ",0
00481A  2  69 73 69 6F  
00481E  2  6E 73 20 70  
004835  2               t_boughtw:
004835  2  41 20 66 69          .BYTE   "A finer weapon is thine!      ",0
004839  2  6E 65 72 20  
00483D  2  77 65 61 70  
004854  2               t_boughta:
004854  2  53 74 75 72          .BYTE   "Sturdier armor is thine!      ",0
004858  2  64 69 65 72  
00485C  2  20 61 72 6D  
004873  2               t_maxed:
004873  2  54 68 6F 75          .BYTE   "Thou hast the finest already. ",0
004877  2  20 68 61 73  
00487B  2  74 20 74 68  
004892  2               t_poor:
004892  2  54 68 6F 75          .BYTE   "Thou canst not afford that.   ",0
004896  2  20 63 61 6E  
00489A  2  73 74 20 6E  
0048B1  2               t_bye:
0048B1  2  43 6F 6D 65          .BYTE   "Come again, adventurer.",0
0048B5  2  20 61 67 61  
0048B9  2  69 6E 2C 20  
0048C9  2               
0048C9  1                       .INCLUDE "castle.asm"
0048C9  2               ;______________________________________________________________________________
0048C9  2               ;  castle.asm - Wyrmhold Castle interaction and opening commission
0048C9  2               ;______________________________________________________________________________
0048C9  2               
0048C9  2               ;----------------------------------------------------------------
0048C9  2               ; castle_use - contextual USE action inside the audience chamber.
0048C9  2               ;----------------------------------------------------------------
0048C9  2               castle_use:
0048C9  2  20 41 49             JSR     ruler_adjacent
0048CC  2  B0 08                BCS     @ruler
0048CE  2  A9 9F A0 49          PRINTMSG_MSG c_approach
0048D2  2  20 6D 39     
0048D5  2  60                   RTS
0048D6  2               @ruler:
0048D6  2  AD 7E 4D             LDA     queststate
0048D9  2  C9 00                CMP     #QUEST_NONE
0048DB  2  F0 10                BEQ     @commission
0048DD  2  C9 01                CMP     #QUEST_FIND_KEY
0048DF  2  F0 23                BEQ     @reminder
0048E1  2  C9 02                CMP     #QUEST_HAVE_KEY
0048E3  2  F0 2E                BEQ     @unlock
0048E5  2               ; QUEST_DUNG_OPEN and any later state
0048E5  2  A9 27 A0 4B          PRINTMSG_MSG c_open
0048E9  2  20 6D 39     
0048EC  2  60                   RTS
0048ED  2               @commission:
0048ED  2  A9 01                LDA     #QUEST_FIND_KEY
0048EF  2  8D 7E 4D             STA     queststate
0048F2  2  20 CA 0D             JSR     sfx_levelup
0048F5  2  A9 CA A0 49          PRINTMSG_MSG c_commission1
0048F9  2  20 6D 39     
0048FC  2  A9 FF A0 49          PRINTMSG_MSG c_commission2
004900  2  20 6D 39     
004903  2  60                   RTS
004904  2               @reminder:
004904  2  A9 44 A0 4A          PRINTMSG_MSG c_reminder1
004908  2  20 6D 39     
00490B  2  A9 81 A0 4A          PRINTMSG_MSG c_reminder2
00490F  2  20 6D 39     
004912  2  60                   RTS
004913  2               @unlock:
004913  2  A9 03                LDA     #QUEST_DUNG_OPEN
004915  2  8D 7E 4D             STA     queststate
004918  2               ; royal reward: full healing and fresh provisions
004918  2  AD 6E 4D             LDA     pmaxhp
00491B  2  8D 6D 4D             STA     phealth
00491E  2  18                   CLC
00491F  2  AD 74 4D             LDA     pfood
004922  2  69 64                ADC     #100
004924  2  8D 74 4D             STA     pfood
004927  2  AD 75 4D             LDA     pfood+1
00492A  2  69 00                ADC     #0
00492C  2  8D 75 4D             STA     pfood+1
00492F  2  20 01 0E             JSR     sfx_door
004932  2  A9 B3 A0 4A          PRINTMSG_MSG c_unlock1
004936  2  20 6D 39     
004939  2  A9 ED A0 4A          PRINTMSG_MSG c_unlock2
00493D  2  20 6D 39     
004940  2  60                   RTS
004941  2               
004941  2               ;----------------------------------------------------------------
004941  2               ; ruler_adjacent - C=1 if player is orthogonally adjacent to the
004941  2               ; ruler's throne. The throne itself is a wall and cannot be entered.
004941  2               ;----------------------------------------------------------------
004941  2               ruler_adjacent:
004941  2  AD 6B 4D             LDA     px
004944  2  C9 0F                CMP     #CASTLE_RULER_X
004946  2  D0 0D                BNE     @side
004948  2  AD 6C 4D             LDA     py
00494B  2  C9 03                CMP     #CASTLE_RULER_Y-1
00494D  2  F0 1A                BEQ     @yes
00494F  2  C9 05                CMP     #CASTLE_RULER_Y+1
004951  2  F0 16                BEQ     @yes
004953  2  18                   CLC
004954  2  60                   RTS
004955  2               @side:
004955  2  AD 6C 4D             LDA     py
004958  2  C9 04                CMP     #CASTLE_RULER_Y
00495A  2  D0 0B                BNE     @no
00495C  2  AD 6B 4D             LDA     px
00495F  2  C9 0E                CMP     #CASTLE_RULER_X-1
004961  2  F0 06                BEQ     @yes
004963  2  C9 10                CMP     #CASTLE_RULER_X+1
004965  2  F0 02                BEQ     @yes
004967  2               @no:
004967  2  18                   CLC
004968  2  60                   RTS
004969  2               @yes:
004969  2  38                   SEC
00496A  2  60                   RTS
00496B  2               
