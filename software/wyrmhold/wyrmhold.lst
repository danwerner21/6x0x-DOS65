003812  2               ;----------------------------------------------------------------
003812  2               ; spend_gold - try to spend A gold.  C=1 success (gold deducted),
003812  2               ;              C=0 if not enough.
003812  2               ;----------------------------------------------------------------
003812  2               spend_gold:
003812  2  85 20                STA     tmp0
003814  2                       ; gold >= tmp0 ?  (16-bit gold, 8-bit cost)
003814  2  AD D8 3A             LDA     pgold+1
003817  2  D0 07                BNE     @ok             ; high byte nonzero -> plenty
003819  2  AD D7 3A             LDA     pgold
00381C  2  C5 20                CMP     tmp0
00381E  2  90 13                BCC     @no
003820  2               @ok:
003820  2  38                   SEC
003821  2  AD D7 3A             LDA     pgold
003824  2  E5 20                SBC     tmp0
003826  2  8D D7 3A             STA     pgold
003829  2  AD D8 3A             LDA     pgold+1
00382C  2  E9 00                SBC     #0
00382E  2  8D D8 3A             STA     pgold+1
003831  2  38                   SEC
003832  2  60                   RTS
003833  2               @no:
003833  2  18                   CLC
003834  2  60                   RTS
003835  2               
003835  2               ;----------------------------------------------------------------
003835  2               ; Shop box geometry - a clean panel drawn inside the viewport,
003835  2               ; well clear of the bottom-right auto-scroll cell.
003835  2               ;----------------------------------------------------------------
003835  2               SHOP_X0         = 3             ; left column of box
003835  2               SHOP_X1         = 42            ; right column of box
003835  2               SHOP_Y0         = 4             ; top row of box
003835  2               SHOP_Y1         = 15            ; bottom row of box
003835  2               SHOP_W          = SHOP_X1-SHOP_X0+1
003835  2               
003835  2               ;----------------------------------------------------------------
003835  2               ; shop_draw - render the shop as a self-contained bordered panel.
003835  2               ; The whole box is repainted each call (background + border via
003835  2               ; direct VRAM, then text via firmware) so it is always clean.
003835  2               ;----------------------------------------------------------------
003835  2               shop_draw:
003835  2                       ; --- paint box background + border directly to VRAM ---
003835  2  20 82 2A             JSR     vid_enter
003838  2  A9 04                LDA     #SHOP_Y0
00383A  2  85 27                STA     rowidx
00383C  2               @bgrow:
00383C  2  A5 27                LDA     rowidx
00383E  2  20 97 2A             JSR     rowbase
003841  2  A0 03                LDY     #SHOP_X0
003843  2               @bgcol:
003843  2                       ; border on edges, blank interior
003843  2  C0 03                CPY     #SHOP_X0
003845  2  F0 19                BEQ     @edge
003847  2  C0 2A                CPY     #SHOP_X1
003849  2  F0 15                BEQ     @edge
00384B  2  A5 27                LDA     rowidx
00384D  2  C9 04                CMP     #SHOP_Y0
00384F  2  F0 0F                BEQ     @edge
003851  2  C9 0F                CMP     #SHOP_Y1
003853  2  F0 0B                BEQ     @edge
003855  2                       ; interior cell
003855  2  A9 20                LDA     #space
003857  2  91 14                STA     (vptr),Y
003859  2  A9 4F                LDA     #C_SHOPBG
00385B  2  91 16                STA     (cptr),Y
00385D  2  4C 68 38             JMP     @bgnext
003860  2               @edge:
003860  2  A9 20                LDA     #' '
003862  2  91 14                STA     (vptr),Y
003864  2  A9 4E                LDA     #C_SHOPBRD
003866  2  91 16                STA     (cptr),Y
003868  2               @bgnext:
003868  2  C8                   INY
003869  2  C0 2B                CPY     #SHOP_X1+1
00386B  2  D0 D6                BNE     @bgcol
00386D  2  E6 27                INC     rowidx
00386F  2  A5 27                LDA     rowidx
003871  2  C9 10                CMP     #SHOP_Y1+1
003873  2  D0 C7                BNE     @bgrow
003875  2  20 91 2A             JSR     vid_exit
003878  2               
