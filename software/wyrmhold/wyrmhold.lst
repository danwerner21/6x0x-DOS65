0015DE  3  E8 06 00 00          .BYTE   MGV_WATER+0, %00000110,%00000000,%00000000,%00110000,%00000000,%00011001,%00000000,%00000000
0015E2  3  30 00 19 00  
0015E6  3  00           
0015E7  3  E9 00 64 00          .BYTE   MGV_WATER+1, %00000000,%01100100,%00000000,%00000000,%00000110,%00000000,%00000000,%01100000
0015EB  3  00 06 00 00  
