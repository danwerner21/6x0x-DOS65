000C56  1               ;==============================================================================
000C56  1               ; Include the rest of the engine
000C56  1               ;==============================================================================
000C56  1                       .INCLUDE "rng.asm"
000C56  2               ;______________________________________________________________________________
000C56  2               ;  rng.asm - 16-bit xorshift pseudo-random generator
000C56  2               ;______________________________________________________________________________
000C56  2               
000C56  2               ;----------------------------------------------------------------
000C56  2               ; rng_seed - initialise the generator (avoid all-zero state).
000C56  2               ;----------------------------------------------------------------
000C56  2               rng_seed:
000C56  2  A9 A3                LDA     #$A3
000C58  2  85 30                STA     seedlo
000C5A  2  A9 1C                LDA     #$1C
000C5C  2  85 31                STA     seedhi
000C5E  2  60                   RTS
000C5F  2               
000C5F  2               ;----------------------------------------------------------------
000C5F  2               ; rng_next - advance the 16-bit xorshift state, return low byte
000C5F  2               ;            in A.  (xorshift: x ^= x<<7; x ^= x>>9; x ^= x<<8)
000C5F  2               ;----------------------------------------------------------------
000C5F  2               rng_next:
000C5F  2                       ; x ^= x << 7
000C5F  2  A5 31                LDA     seedhi
000C61  2  4A                   LSR     A               ; carry = bit7 of hi after some shifts...
000C62  2                       ; Implement x<<7 via: shift left 7 = shift right 1 then swap?
000C62  2                       ; Simpler: do a byte-wise xorshift that is "good enough".
000C62  2                       ; x ^= x << 7
000C62  2  A5 30                LDA     seedlo
000C64  2  0A                   ASL     A
000C65  2  0A                   ASL     A
000C66  2  0A                   ASL     A
000C67  2  0A                   ASL     A
000C68  2  0A                   ASL     A
000C69  2  0A                   ASL     A
000C6A  2  0A                   ASL     A               ; lo << 7 (only bit0 survives into bit7)
000C6B  2  45 31                EOR     seedhi
000C6D  2  85 31                STA     seedhi
000C6F  2                       ; x ^= x >> 9  (>>9 of 16-bit = hi >> 1 into lo)
000C6F  2  A5 31                LDA     seedhi
000C71  2  4A                   LSR     A
000C72  2  45 30                EOR     seedlo
000C74  2  85 30                STA     seedlo
000C76  2                       ; x ^= x << 8  (swap bytes contribution: lo ^ into hi)
000C76  2  A5 30                LDA     seedlo
000C78  2  45 31                EOR     seedhi
000C7A  2  85 31                STA     seedhi
000C7C  2  A5 30                LDA     seedlo
000C7E  2  60                   RTS
000C7F  2               
000C7F  2               ;----------------------------------------------------------------
000C7F  2               ; rng_mod - return a value 0..A-1 in A.  IN: A = modulus (1..255)
000C7F  2               ;           (uses repeated subtraction mask via AND for powers of
000C7F  2               ;            two is faster, but generic mod via subtract loop here)
000C7F  2               ;----------------------------------------------------------------
000C7F  2               rng_mod:
000C7F  2  85 23                STA     tmp3            ; modulus
000C81  2  20 5F 0C             JSR     rng_next        ; A = random byte
000C84  2                       ; reduce A mod tmp3 by subtraction
000C84  2               @rm:
000C84  2  C5 23                CMP     tmp3
000C86  2  90 06                BCC     @done
000C88  2  38                   SEC
000C89  2  E5 23                SBC     tmp3
000C8B  2  4C 84 0C             JMP     @rm
000C8E  2               @done:
000C8E  2  60                   RTS
000C8F  2               
000C8F  2               ;----------------------------------------------------------------
000C8F  2               ; rng_d - roll a die: return 1..A in A.  IN: A = sides (1..255)
000C8F  2               ;----------------------------------------------------------------
000C8F  2               rng_d:
000C8F  2  20 7F 0C             JSR     rng_mod
000C92  2  18                   CLC
000C93  2  69 01                ADC     #1
000C95  2  60                   RTS
000C96  2               
000C96  1                       .INCLUDE "sound.asm"
000C96  2               ;______________________________________________________________________________
000C96  2               ;  sound.asm - AY-3-8910 PSG sound effects and cooperative music player
000C96  2               ;
000C96  2               ;  PSG access ported from software/dbasic/ay38910.asm (PPI at $E230).
000C96  2               ;  psgwr: A=register, Y=value        psgrd: A=register -> Y=value
000C96  2               ;
000C96  2               ;  AY register map:
000C96  2               ;    0/1  ch A tone period (lo / hi 4 bits)
000C96  2               ;    2/3  ch B tone period
000C96  2               ;    4/5  ch C tone period
000C96  2               ;    6    noise period (5 bits)
000C96  2               ;    7    mixer: bit clear = enabled. 0-2 tone A/B/C, 3-5 noise A/B/C
000C96  2               ;    8/9/10 ch A/B/C volume (0-15, bit4 = use envelope)
000C96  2               ;    11/12 envelope period
000C96  2               ;    13   envelope shape
000C96  2               ;______________________________________________________________________________
000C96  2               
000C96  2               PPI_BASE        = $E230
000C96  2               ppiPortA        = PPI_BASE+0
000C96  2               ppiPortB        = PPI_BASE+1
000C96  2               ppiPortC        = PPI_BASE+2
000C96  2               ppiControl      = PPI_BASE+3
000C96  2               
000C96  2               ;----------------------------------------------------------------
000C96  2               ; psg_init - put the PSG into a known, silent state
000C96  2               ;----------------------------------------------------------------
000C96  2               psg_init:
000C96  2  A9 80                LDA     #%10000000
000C98  2  8D 33 E2             STA     ppiControl
000C9B  2  A9 10                LDA     #%00010000
000C9D  2  8D 32 E2             STA     ppiPortC
000CA0  2  A9 00                LDA     #$00
000CA2  2  8D 31 E2             STA     ppiPortB
000CA5  2  20 A9 0C             JSR     clrpsg
000CA8  2  60                   RTS
000CA9  2               
000CA9  2               ;----------------------------------------------------------------
000CA9  2               ; clrpsg - zero all 16 registers, then disable all channels
000CA9  2               ;----------------------------------------------------------------
000CA9  2               clrpsg:
000CA9  2  A2 00                LDX     #00
000CAB  2  A0 00                LDY     #00
000CAD  2               @cp1:
000CAD  2  8A                   TXA
000CAE  2  20 DB 0C             JSR     psgwr
000CB1  2  E8                   INX
000CB2  2  E0 10                CPX     #16
000CB4  2  D0 F7                BNE     @cp1
000CB6  2  A9 07                LDA     #07
000CB8  2  A0 3F                LDY     #%00111111      ; all tone + noise disabled
000CBA  2  20 DB 0C             JSR     psgwr
000CBD  2  60                   RTS
000CBE  2               
000CBE  2               ;----------------------------------------------------------------
000CBE  2               ; psg_silence - silence all three channels (volumes -> 0)
000CBE  2               ;----------------------------------------------------------------
000CBE  2               psg_silence:
000CBE  2  A9 08                LDA     #8
000CC0  2  A0 00                LDY     #0
000CC2  2  20 DB 0C             JSR     psgwr
000CC5  2  A9 09                LDA     #9
000CC7  2  A0 00                LDY     #0
000CC9  2  20 DB 0C             JSR     psgwr
000CCC  2  A9 0A                LDA     #10
000CCE  2  A0 00                LDY     #0
000CD0  2  20 DB 0C             JSR     psgwr
000CD3  2  A9 07                LDA     #07
000CD5  2  A0 3F                LDY     #%00111111
000CD7  2  20 DB 0C             JSR     psgwr
000CDA  2  60                   RTS
000CDB  2               
000CDB  2               ;----------------------------------------------------------------
000CDB  2               ; psgwr - write Y into PSG register A     (trashes A)
000CDB  2               ;----------------------------------------------------------------
000CDB  2               psgwr:
000CDB  2  8D 31 E2             STA     ppiPortB        ; select register
000CDE  2  A9 1C                LDA     #%00011100      ; latch address
000CE0  2  8D 32 E2             STA     ppiPortC
000CE3  2  8D 32 E2             STA     ppiPortC
000CE6  2  8D 32 E2             STA     ppiPortC
000CE9  2  A9 10                LDA     #%00010000      ; inactive
000CEB  2  8D 32 E2             STA     ppiPortC
000CEE  2  8D 32 E2             STA     ppiPortC
000CF1  2  8D 32 E2             STA     ppiPortC
000CF4  2  98                   TYA
000CF5  2  8D 31 E2             STA     ppiPortB        ; store data
000CF8  2  8D 31 E2             STA     ppiPortB
000CFB  2  8D 31 E2             STA     ppiPortB
000CFE  2  A9 14                LDA     #%00010100      ; latch data
000D00  2  8D 32 E2             STA     ppiPortC
000D03  2  8D 32 E2             STA     ppiPortC
000D06  2  8D 32 E2             STA     ppiPortC
000D09  2  A9 10                LDA     #%00010000      ; inactive
000D0B  2  8D 32 E2             STA     ppiPortC
000D0E  2  60                   RTS
000D0F  2               
000D0F  2               ;----------------------------------------------------------------
000D0F  2               ; psgrd - read PSG register A into Y      (trashes A)
000D0F  2               ;----------------------------------------------------------------
000D0F  2               psgrd:
000D0F  2  8D 31 E2             STA     ppiPortB        ; select register
000D12  2  A9 1C                LDA     #%00011100      ; latch address
000D14  2  8D 32 E2             STA     ppiPortC
000D17  2  8D 32 E2             STA     ppiPortC
000D1A  2  8D 32 E2             STA     ppiPortC
000D1D  2  A9 10                LDA     #%00010000      ; inactive
000D1F  2  8D 32 E2             STA     ppiPortC
000D22  2  8D 32 E2             STA     ppiPortC
000D25  2  A9 82                LDA     #%10000010
000D27  2  8D 33 E2             STA     ppiControl
000D2A  2  A9 18                LDA     #%00011000      ; latch data
000D2C  2  8D 32 E2             STA     ppiPortC
000D2F  2  8D 32 E2             STA     ppiPortC
000D32  2  8D 32 E2             STA     ppiPortC
000D35  2  AD 31 E2             LDA     ppiPortB        ; read data
000D38  2  A8                   TAY
000D39  2  A9 80                LDA     #%10000000
000D3B  2  8D 33 E2             STA     ppiControl
000D3E  2  A9 10                LDA     #%00010000      ; inactive
000D40  2  8D 32 E2             STA     ppiPortC
000D43  2  60                   RTS
000D44  2               
000D44  2               ;----------------------------------------------------------------
000D44  2               ; tone_on - start a tone on channel A.
000D44  2               ;   ptr (16-bit) = 12-bit tone period (lo in ptr, hi in ptr+1)
000D44  2               ;   tmp0         = volume (0-15)
000D44  2               ;----------------------------------------------------------------
000D44  2               tone_on:
000D44  2  A9 00                LDA     #0              ; ch A period low
000D46  2  A4 10                LDY     ptr
000D48  2  20 DB 0C             JSR     psgwr
000D4B  2  A9 01                LDA     #1              ; ch A period high
000D4D  2  A4 11                LDY     ptr+1
000D4F  2  20 DB 0C             JSR     psgwr
000D52  2  A9 07                LDA     #07             ; mixer: enable tone A only
000D54  2  A0 3E                LDY     #%00111110
000D56  2  20 DB 0C             JSR     psgwr
000D59  2  A9 08                LDA     #8              ; ch A volume
000D5B  2  A4 20                LDY     tmp0
000D5D  2  20 DB 0C             JSR     psgwr
000D60  2  60                   RTS
000D61  2               
000D61  2               ;----------------------------------------------------------------
000D61  2               ; busywait - crude delay.  X = outer count.
000D61  2               ;----------------------------------------------------------------
000D61  2               busywait:
000D61  2               @bw0:
000D61  2  A0 00                LDY     #0
000D63  2               @bw1:
000D63  2  A9 00                LDA     #0
000D65  2               @bw2:
000D65  2  18                   CLC
000D66  2  69 01                ADC     #1
000D68  2  C9 28                CMP     #40
000D6A  2  D0 F9                BNE     @bw2
000D6C  2  C8                   INY
000D6D  2  D0 F4                BNE     @bw1
000D6F  2  CA                   DEX
000D70  2  D0 EF                BNE     @bw0
000D72  2  60                   RTS
000D73  2               
000D73  2               ;----------------------------------------------------------------
000D73  2               ; mus_finewait - a short, fine-grained delay for tempo trimming.
000D73  2               ; Spins MUS_FINEDELAY outer times, 256 inner each.  Much smaller
000D73  2               ; than one busywait pass, so it gives sub-step tempo control.
000D73  2               ;----------------------------------------------------------------
000D73  2               mus_finewait:
000D73  2  A2 46                LDX     #MUS_FINEDELAY
000D75  2  F0 08                BEQ     @done
000D77  2               @fw0:
000D77  2  A0 00                LDY     #0
000D79  2               @fw1:
000D79  2  C8                   INY
000D7A  2  D0 FD                BNE     @fw1
000D7C  2  CA                   DEX
000D7D  2  D0 F8                BNE     @fw0
000D7F  2               @done:
000D7F  2  60                   RTS
000D80  2               
000D80  2               ;----------------------------------------------------------------
000D80  2               ; SFX helpers.  Each plays a short, self-contained sound and
000D80  2               ; silences the PSG afterwards.  All preserve nothing - callers
000D80  2               ; must save anything they need.
000D80  2               ;----------------------------------------------------------------
000D80  2               
000D80  2               ; sfx_move - very short low blip
000D80  2               sfx_move:
000D80  2  A9 40 85 10          SETW16  ptr, $0240
000D84  2  A9 02 85 11  
000D88  2  A9 06                LDA     #6
000D8A  2  85 20                STA     tmp0
000D8C  2  20 44 0D             JSR     tone_on
000D8F  2  A2 02                LDX     #2
000D91  2  20 61 0D             JSR     busywait
000D94  2  4C BE 0C             JMP     psg_silence
000D97  2               
000D97  2               ; sfx_blocked - low buzz (use noise)
000D97  2               sfx_blocked:
000D97  2  A9 06                LDA     #6              ; noise period
000D99  2  A0 14                LDY     #20
000D9B  2  20 DB 0C             JSR     psgwr
000D9E  2  A9 07                LDA     #07             ; enable noise A
000DA0  2  A0 37                LDY     #%00110111
000DA2  2  20 DB 0C             JSR     psgwr
000DA5  2  A9 08                LDA     #8
000DA7  2  A0 0A                LDY     #10
000DA9  2  20 DB 0C             JSR     psgwr
000DAC  2  A2 03                LDX     #3
000DAE  2  20 61 0D             JSR     busywait
000DB1  2  4C BE 0C             JMP     psg_silence
000DB4  2               
000DB4  2               ; sfx_hit - quick high zap
000DB4  2               sfx_hit:
000DB4  2  A9 C0 85 10          SETW16  ptr, $00C0
000DB8  2  A9 00 85 11  
000DBC  2  A9 0C                LDA     #12
000DBE  2  85 20                STA     tmp0
000DC0  2  20 44 0D             JSR     tone_on
000DC3  2  A2 02                LDX     #2
000DC5  2  20 61 0D             JSR     busywait
000DC8  2  A9 40 85 10          SETW16  ptr, $0140
000DCC  2  A9 01 85 11  
000DD0  2  A9 0A                LDA     #10
000DD2  2  85 20                STA     tmp0
000DD4  2  20 44 0D             JSR     tone_on
000DD7  2  A2 02                LDX     #2
000DD9  2  20 61 0D             JSR     busywait
000DDC  2  4C BE 0C             JMP     psg_silence
000DDF  2               
000DDF  2               ; sfx_killed - falling tone + noise
000DDF  2               sfx_killed:
000DDF  2  A9 06                LDA     #6
000DE1  2  A0 10                LDY     #16
000DE3  2  20 DB 0C             JSR     psgwr
000DE6  2  A9 07                LDA     #07
000DE8  2  A0 37                LDY     #%00110111
000DEA  2  20 DB 0C             JSR     psgwr
000DED  2  A9 08                LDA     #8
000DEF  2  A0 0D                LDY     #13
000DF1  2  20 DB 0C             JSR     psgwr
000DF4  2  A2 05                LDX     #5
000DF6  2  20 61 0D             JSR     busywait
000DF9  2  4C BE 0C             JMP     psg_silence
000DFC  2               
000DFC  2               ; sfx_treasure - bright rising arpeggio
000DFC  2               sfx_treasure:
000DFC  2  A9 50 85 10          SETW16  ptr, $0150
000E00  2  A9 01 85 11  
000E04  2  A9 0D                LDA     #13
000E06  2  85 20                STA     tmp0
000E08  2  20 44 0D             JSR     tone_on
000E0B  2  A2 02                LDX     #2
000E0D  2  20 61 0D             JSR     busywait
000E10  2  A9 FC 85 10          SETW16  ptr, $00FC
000E14  2  A9 00 85 11  
000E18  2  20 44 0D             JSR     tone_on
000E1B  2  A2 02                LDX     #2
000E1D  2  20 61 0D             JSR     busywait
000E20  2  A9 A8 85 10          SETW16  ptr, $00A8
000E24  2  A9 00 85 11  
000E28  2  20 44 0D             JSR     tone_on
000E2B  2  A2 03                LDX     #3
000E2D  2  20 61 0D             JSR     busywait
000E30  2  4C BE 0C             JMP     psg_silence
000E33  2               
000E33  2               ; sfx_levelup - three ascending happy notes
000E33  2               sfx_levelup:
000E33  2  A9 FC 85 10          SETW16  ptr, $00FC
000E37  2  A9 00 85 11  
000E3B  2  A9 0E                LDA     #14
000E3D  2  85 20                STA     tmp0
000E3F  2  20 44 0D             JSR     tone_on
000E42  2  A2 03                LDX     #3
000E44  2  20 61 0D             JSR     busywait
000E47  2  A9 C8 85 10          SETW16  ptr, $00C8
000E4B  2  A9 00 85 11  
000E4F  2  20 44 0D             JSR     tone_on
000E52  2  A2 03                LDX     #3
000E54  2  20 61 0D             JSR     busywait
000E57  2  A9 A8 85 10          SETW16  ptr, $00A8
000E5B  2  A9 00 85 11  
000E5F  2  20 44 0D             JSR     tone_on
000E62  2  A2 04                LDX     #4
000E64  2  20 61 0D             JSR     busywait
000E67  2  4C BE 0C             JMP     psg_silence
000E6A  2               
000E6A  2               ; sfx_door - short two-tone chime
000E6A  2               sfx_door:
000E6A  2  A9 80 85 10          SETW16  ptr, $0180
000E6E  2  A9 01 85 11  
000E72  2  A9 0B                LDA     #11
000E74  2  85 20                STA     tmp0
000E76  2  20 44 0D             JSR     tone_on
000E79  2  A2 02                LDX     #2
000E7B  2  20 61 0D             JSR     busywait
000E7E  2  A9 20 85 10          SETW16  ptr, $0120
000E82  2  A9 01 85 11  
000E86  2  20 44 0D             JSR     tone_on
000E89  2  A2 03                LDX     #3
000E8B  2  20 61 0D             JSR     busywait
000E8E  2  4C BE 0C             JMP     psg_silence
000E91  2               
000E91  2               ; sfx_lose - long descending sad tone
000E91  2               sfx_lose:
000E91  2  A9 20 85 10          SETW16  ptr, $0120
000E95  2  A9 01 85 11  
000E99  2  A9 0D                LDA     #13
000E9B  2  85 20                STA     tmp0
000E9D  2  20 44 0D             JSR     tone_on
000EA0  2  A2 06                LDX     #6
000EA2  2  20 61 0D             JSR     busywait
000EA5  2  A9 C0 85 10          SETW16  ptr, $01C0
000EA9  2  A9 01 85 11  
000EAD  2  20 44 0D             JSR     tone_on
000EB0  2  A2 06                LDX     #6
000EB2  2  20 61 0D             JSR     busywait
000EB5  2  A9 80 85 10          SETW16  ptr, $0280
000EB9  2  A9 02 85 11  
000EBD  2  20 44 0D             JSR     tone_on
000EC0  2  A2 0A                LDX     #10
000EC2  2  20 61 0D             JSR     busywait
000EC5  2  4C BE 0C             JMP     psg_silence
000EC8  2               
000EC8  2               ; sfx_win - triumphant fanfare
000EC8  2               sfx_win:
000EC8  2  A9 FC 85 10          SETW16  ptr, $00FC
000ECC  2  A9 00 85 11  
000ED0  2  A9 0F                LDA     #15
000ED2  2  85 20                STA     tmp0
000ED4  2  20 44 0D             JSR     tone_on
000ED7  2  A2 04                LDX     #4
000ED9  2  20 61 0D             JSR     busywait
000EDC  2  A9 C8 85 10          SETW16  ptr, $00C8
000EE0  2  A9 00 85 11  
000EE4  2  20 44 0D             JSR     tone_on
000EE7  2  A2 04                LDX     #4
000EE9  2  20 61 0D             JSR     busywait
000EEC  2  A9 A8 85 10          SETW16  ptr, $00A8
000EF0  2  A9 00 85 11  
000EF4  2  20 44 0D             JSR     tone_on
000EF7  2  A2 04                LDX     #4
000EF9  2  20 61 0D             JSR     busywait
000EFC  2  A9 7E 85 10          SETW16  ptr, $007E
000F00  2  A9 00 85 11  
000F04  2  20 44 0D             JSR     tone_on
000F07  2  A2 0C                LDX     #12
000F09  2  20 61 0D             JSR     busywait
000F0C  2  4C BE 0C             JMP     psg_silence
000F0F  2               
000F0F  2               ;==============================================================================
000F0F  2               ;  Cooperative 3-channel title music player with hardware envelope.
000F0F  2               ;
000F0F  2               ;  Three independent voice tracks play simultaneously:
000F0F  2               ;     channel A = lead melody   (uses the AY envelope generator so each
000F0F  2               ;                                note has a soft attack/decay shape)
000F0F  2               ;     channel B = counter/harmony (fixed mid volume)
000F0F  2               ;     channel C = bass line       (fixed mid volume)
000F0F  2               ;
000F0F  2               ;  Each track is a list of events: (note, duration) byte pairs.
000F0F  2               ;     note 0      = rest (silence this channel for the duration)
000F0F  2               ;     note 1..47  = index into note_lo/note_hi period tables
000F0F  2               ;     note $FF    = end marker -> loop the track from its start
000F0F  2               ;     duration    = number of music ticks to hold (1..254)
000F0F  2               ;
000F0F  2               ;  music_tick is called once per title spin-loop iteration.  It paces
000F0F  2               ;  itself with a short delay, then advances all three voices.
000F0F  2               ;==============================================================================
000F0F  2               
000F0F  2               ; Tempo: each music tick waits busywait(1) plus an extra fine spin of
000F0F  2               ; MUS_FINEDELAY * 256 loops.  delay=1 alone (FINE=0) was a little fast;
000F0F  2               ; FINE=128 is about 1.5x slower.  Raise/lower MUS_FINEDELAY to taste.
000F0F  2               MUS_TICKDELAY   = 1             ; busywait outer count per music tick
000F0F  2               MUS_FINEDELAY   = 70            ; extra fine delay (0..255), tempo trim
000F0F  2               
000F0F  2               ; envelope shape values (reg 13)
000F0F  2               ENV_DECAY       = %00000000     ; \____  single decay then off (plucky)
000F0F  2               ENV_RAMP        = %00001000     ; \\\\   repeating saw (sustained pulse)
000F0F  2               ENV_PERIOD      = $1800         ; 16-bit envelope period (attack/decay len)
000F0F  2               MUS_VOL_B       = 8             ; harmony volume (gentle, under the lead)
000F0F  2               MUS_VOL_C       = 13            ; bass volume (strong, so it is audible)
000F0F  2               
000F0F  2               ;----------------------------------------------------------------
000F0F  2               ; music_start - reset all three voice cursors and program the AY
000F0F  2               ; for music: all three tone channels enabled, envelope set up for
000F0F  2               ; the lead.
000F0F  2               ;----------------------------------------------------------------
000F0F  2               music_start:
000F0F  2                       ; voice cursors -> track starts
000F0F  2  A9 D8 8D E4          SETW16  mvA_ptr, trackA
000F13  2  3A A9 10 8D  
000F17  2  E5 3A        
000F19  2  A9 15 8D E7          SETW16  mvB_ptr, trackB
000F1D  2  3A A9 11 8D  
000F21  2  E8 3A        
000F23  2  A9 28 8D EA          SETW16  mvC_ptr, trackC
000F27  2  3A A9 11 8D  
000F2B  2  EB 3A        
000F2D  2                       ; all hold-counters = 0 so every voice fetches on the first tick.
000F2D  2                       ; (must load #0 fresh each time - SETW16 above left A non-zero,
000F2D  2                       ;  which is why B/C previously got garbage counts and went silent)
000F2D  2  A9 00                LDA     #0
000F2F  2  8D E6 3A             STA     mvA_cnt
000F32  2  8D E9 3A             STA     mvB_cnt
000F35  2  8D EC 3A             STA     mvC_cnt
000F38  2               
000F38  2                       ; mixer: enable tone on A, B, C (noise off)  -> bits 0..2 clear
000F38  2  A9 07                LDA     #07
000F3A  2  A0 38                LDY     #%00111000
000F3C  2  20 DB 0C             JSR     psgwr
000F3F  2                       ; envelope period (regs 11/12) - sets attack/decay length.
000F3F  2                       ; longer = the plucked lead note rings out for more of its
000F3F  2                       ; duration before fading.  Tune ENV_PERIOD to taste.
000F3F  2  A9 0B                LDA     #11
000F41  2  A0 00                LDY     #<ENV_PERIOD
000F43  2  20 DB 0C             JSR     psgwr
000F46  2  A9 0C                LDA     #12
000F48  2  A0 18                LDY     #>ENV_PERIOD
000F4A  2  20 DB 0C             JSR     psgwr
000F4D  2                       ; channel A volume register = use envelope (bit4 set)
000F4D  2  A9 08                LDA     #8
000F4F  2  A0 10                LDY     #%00010000
000F51  2  20 DB 0C             JSR     psgwr
000F54  2                       ; channel B: gentle harmony pad ; channel C: strong bass
000F54  2  A9 09                LDA     #9
000F56  2  A0 08                LDY     #MUS_VOL_B
000F58  2  20 DB 0C             JSR     psgwr
000F5B  2  A9 0A                LDA     #10
000F5D  2  A0 0D                LDY     #MUS_VOL_C
000F5F  2  20 DB 0C             JSR     psgwr
000F62  2  60                   RTS
000F63  2               
000F63  2               ;----------------------------------------------------------------
000F63  2               ; music_tick - advance all three voices by one tick.
000F63  2               ;----------------------------------------------------------------
000F63  2               music_tick:
000F63  2  A2 01                LDX     #MUS_TICKDELAY
000F65  2  20 61 0D             JSR     busywait
000F68  2  20 73 0D             JSR     mus_finewait    ; fine tempo trim
000F6B  2               
000F6B  2                       ; --- voice A (lead, envelope) ---
000F6B  2  AD E6 3A             LDA     mvA_cnt
000F6E  2  F0 06                BEQ     @nextA
000F70  2  CE E6 3A             DEC     mvA_cnt
000F73  2  4C CB 0F             JMP     @doB
000F76  2               @nextA:
000F76  2  A9 D8 85 18          SETW16  srcp, trackA    ; (loop base, used if end marker hit)
000F7A  2  A9 10 85 19  
000F7E  2  AD E4 3A             LDA     mvA_ptr
000F81  2  85 12                STA     ptr2
000F83  2  AD E5 3A             LDA     mvA_ptr+1
000F86  2  85 13                STA     ptr2+1
000F88  2  20 74 10             JSR     mus_fetch       ; -> tmp0=note, tmp1=dur, ptr2 advanced
000F8B  2                       ; program channel A tone (regs 0/1) from the note
000F8B  2  A6 20                LDX     tmp0
000F8D  2  F0 1B                BEQ     @restA          ; rest
000F8F  2  20 A0 10             JSR     note_period     ; -> ptr = period for note X
000F92  2  A9 00                LDA     #0
000F94  2  A4 10                LDY     ptr
000F96  2  20 DB 0C             JSR     psgwr
000F99  2  A9 01                LDA     #1
000F9B  2  A4 11                LDY     ptr+1
000F9D  2  20 DB 0C             JSR     psgwr
000FA0  2                       ; (re)trigger the envelope by rewriting the shape register
000FA0  2  A9 0D                LDA     #13
000FA2  2  A0 00                LDY     #ENV_DECAY
000FA4  2  20 DB 0C             JSR     psgwr
000FA7  2  4C B1 0F             JMP     @setA
000FAA  2               @restA:
000FAA  2                       ; silence A for the rest: drop its volume to 0 (no envelope)
000FAA  2  A9 08                LDA     #8
000FAC  2  A0 00                LDY     #0
000FAE  2  20 DB 0C             JSR     psgwr
000FB1  2               @setA:
000FB1  2                       ; for a non-rest, make sure A uses the envelope again
000FB1  2  A5 20                LDA     tmp0
000FB3  2  F0 07                BEQ     @cntA
000FB5  2  A9 08                LDA     #8
000FB7  2  A0 10                LDY     #%00010000
000FB9  2  20 DB 0C             JSR     psgwr
000FBC  2               @cntA:
000FBC  2  A5 21                LDA     tmp1
000FBE  2  8D E6 3A             STA     mvA_cnt
000FC1  2  A5 12                LDA     ptr2
000FC3  2  8D E4 3A             STA     mvA_ptr
000FC6  2  A5 13                LDA     ptr2+1
000FC8  2  8D E5 3A             STA     mvA_ptr+1
000FCB  2               
000FCB  2               @doB:
000FCB  2                       ; --- voice B (harmony, fixed volume on channel B) ---
000FCB  2  AD E9 3A             LDA     mvB_cnt
000FCE  2  F0 06                BEQ     @nextB
000FD0  2  CE E9 3A             DEC     mvB_cnt
000FD3  2  4C 20 10             JMP     @doC
000FD6  2               @nextB:
000FD6  2  A9 15 85 18          SETW16  srcp, trackB
000FDA  2  A9 11 85 19  
000FDE  2  AD E7 3A             LDA     mvB_ptr
000FE1  2  85 12                STA     ptr2
000FE3  2  AD E8 3A             LDA     mvB_ptr+1
000FE6  2  85 13                STA     ptr2+1
000FE8  2  20 74 10             JSR     mus_fetch
000FEB  2  A6 20                LDX     tmp0
000FED  2  F0 1B                BEQ     @restB
000FEF  2  20 A0 10             JSR     note_period
000FF2  2  A9 02                LDA     #2
000FF4  2  A4 10                LDY     ptr
000FF6  2  20 DB 0C             JSR     psgwr
000FF9  2  A9 03                LDA     #3
000FFB  2  A4 11                LDY     ptr+1
000FFD  2  20 DB 0C             JSR     psgwr
001000  2  A9 09                LDA     #9              ; restore B volume
001002  2  A0 08                LDY     #MUS_VOL_B
001004  2  20 DB 0C             JSR     psgwr
001007  2  4C 11 10             JMP     @cntB
00100A  2               @restB:
00100A  2  A9 09                LDA     #9
00100C  2  A0 00                LDY     #0
00100E  2  20 DB 0C             JSR     psgwr
001011  2               @cntB:
001011  2  A5 21                LDA     tmp1
001013  2  8D E9 3A             STA     mvB_cnt
001016  2  A5 12                LDA     ptr2
001018  2  8D E7 3A             STA     mvB_ptr
00101B  2  A5 13                LDA     ptr2+1
00101D  2  8D E8 3A             STA     mvB_ptr+1
001020  2               
001020  2               @doC:
001020  2                       ; --- voice C (bass, fixed volume on channel C) ---
001020  2  AD EC 3A             LDA     mvC_cnt
001023  2  F0 04                BEQ     @nextC
001025  2  CE EC 3A             DEC     mvC_cnt
001028  2  60                   RTS
001029  2               @nextC:
001029  2  A9 28 85 18          SETW16  srcp, trackC
00102D  2  A9 11 85 19  
001031  2  AD EA 3A             LDA     mvC_ptr
001034  2  85 12                STA     ptr2
001036  2  AD EB 3A             LDA     mvC_ptr+1
001039  2  85 13                STA     ptr2+1
00103B  2  20 74 10             JSR     mus_fetch
00103E  2  A6 20                LDX     tmp0
001040  2  F0 1B                BEQ     @restC
001042  2  20 A0 10             JSR     note_period
001045  2  A9 04                LDA     #4
001047  2  A4 10                LDY     ptr
001049  2  20 DB 0C             JSR     psgwr
00104C  2  A9 05                LDA     #5
00104E  2  A4 11                LDY     ptr+1
001050  2  20 DB 0C             JSR     psgwr
001053  2  A9 0A                LDA     #10             ; restore C volume
001055  2  A0 0D                LDY     #MUS_VOL_C
001057  2  20 DB 0C             JSR     psgwr
00105A  2  4C 64 10             JMP     @cntC
00105D  2               @restC:
00105D  2  A9 0A                LDA     #10
00105F  2  A0 00                LDY     #0
001061  2  20 DB 0C             JSR     psgwr
001064  2               @cntC:
001064  2  A5 21                LDA     tmp1
001066  2  8D EC 3A             STA     mvC_cnt
001069  2  A5 12                LDA     ptr2
00106B  2  8D EA 3A             STA     mvC_ptr
00106E  2  A5 13                LDA     ptr2+1
001070  2  8D EB 3A             STA     mvC_ptr+1
001073  2  60                   RTS
001074  2               
001074  2               ;----------------------------------------------------------------
001074  2               ; mus_fetch - read one (note,dur) event from the track at ptr2.
001074  2               ;   IN : ptr2 -> current event ; srcp -> track loop base
001074  2               ;   OUT: tmp0 = note, tmp1 = duration, ptr2 advanced past the event.
001074  2               ;        On an $FF end marker, ptr2 is reset to srcp and the first
001074  2               ;        event of the track is returned.
001074  2               ;----------------------------------------------------------------
001074  2               mus_fetch:
001074  2  A0 00                LDY     #0
001076  2  B1 12                LDA     (ptr2),Y
001078  2  C9 FF                CMP     #$FF
00107A  2  D0 0C                BNE     @ok
00107C  2                       ; loop: reset ptr2 to track base (srcp)
00107C  2  A5 18                LDA     srcp
00107E  2  85 12                STA     ptr2
001080  2  A5 19                LDA     srcp+1
001082  2  85 13                STA     ptr2+1
001084  2  A0 00                LDY     #0
001086  2  B1 12                LDA     (ptr2),Y
001088  2               @ok:
001088  2  85 20                STA     tmp0            ; note
00108A  2  C8                   INY
00108B  2  B1 12                LDA     (ptr2),Y
00108D  2                       ; The voice loops "fetch when counter hits 0", and the fetch
00108D  2                       ; tick itself is the first tick of the note.  So a note must
00108D  2                       ; hold for (dur-1) MORE ticks after the fetch tick to last
00108D  2                       ; exactly dur ticks.  Subtract 1 here.  (All durations are >=2,
00108D  2                       ; so no underflow.)  This keeps voices with different note
00108D  2                       ; counts the same real length - otherwise B/C drift away from
00108D  2                       ; the lead because they have fewer/more notes per loop.
00108D  2  38                   SEC
00108E  2  E9 01                SBC     #1
001090  2  85 21                STA     tmp1            ; duration - 1
001092  2                       ; advance ptr2 by 2
001092  2  18                   CLC
001093  2  A5 12                LDA     ptr2
001095  2  69 02                ADC     #2
001097  2  85 12                STA     ptr2
001099  2  A5 13                LDA     ptr2+1
00109B  2  69 00                ADC     #0
00109D  2  85 13                STA     ptr2+1
00109F  2  60                   RTS
0010A0  2               
0010A0  2               ;----------------------------------------------------------------
0010A0  2               ; note_period - look up the 16-bit AY tone period for note X (1..N)
0010A0  2               ;   OUT: ptr = period (lo/hi).  Note index is 1-based.
0010A0  2               ;----------------------------------------------------------------
0010A0  2               note_period:
0010A0  2  CA                   DEX                     ; tables are 0-based
0010A1  2  BD AC 10             LDA     note_lo,X
0010A4  2  85 10                STA     ptr
0010A6  2  BD C2 10             LDA     note_hi,X
0010A9  2  85 11                STA     ptr+1
0010AB  2  60                   RTS
0010AC  2               
0010AC  2               ;----------------------------------------------------------------
0010AC  2               ; Note period tables (16-bit AY tone periods), two+ octaves.
0010AC  2               ; Note numbers (1-based) used by the tracks:
0010AC  2               ;   1=C3  2=D3 3=E3 4=F3 5=G3 6=A3 7=B3
0010AC  2               ;   8=C4  9=D4 10=E4 11=F4 12=G4 13=A4 14=B4
0010AC  2               ;  15=C5 16=D5 17=E5 18=F5 19=G5 20=A5 21=B5
0010AC  2               ;  22=C6
0010AC  2               ; (a diatonic C-major set is plenty for a heroic theme)
0010AC  2               ;----------------------------------------------------------------
0010AC  2               note_lo:
0010AC  2  F0 82 20 F4          .BYTE   <1008, <898, <800, <756, <672, <600, <534    ; C3..B3
0010B0  2  A0 58 16     
0010B3  2  F8 C2 90 7A          .BYTE   <504,  <450, <400, <378, <336, <300, <267    ; C4..B4
0010B7  2  50 2C 0B     
0010BA  2  FC E1 C8 BD          .BYTE   <252,  <225, <200, <189, <168, <150, <133    ; C5..B5
0010BE  2  A8 96 85     
0010C1  2  7E                   .BYTE   <126                                          ; C6
0010C2  2               note_hi:
0010C2  2  03 03 03 02          .BYTE   >1008, >898, >800, >756, >672, >600, >534
0010C6  2  02 02 02     
0010C9  2  01 01 01 01          .BYTE   >504,  >450, >400, >378, >336, >300, >267
0010CD  2  01 01 01     
0010D0  2  00 00 00 00          .BYTE   >252,  >225, >200, >189, >168, >150, >133
0010D4  2  00 00 00     
0010D7  2  00                   .BYTE   >126
0010D8  2               
0010D8  2               ; note name -> index defines for readable tracks
0010D8  2               N_REST  = 0
0010D8  2               C3 = 1
0010D8  2               D3 = 2
0010D8  2               E3 = 3
0010D8  2               F3 = 4
0010D8  2               G3 = 5
0010D8  2               A3 = 6
0010D8  2               B3 = 7
0010D8  2               C4 = 8
0010D8  2               D4 = 9
0010D8  2               E4 = 10
0010D8  2               F4 = 11
0010D8  2               G4 = 12
0010D8  2               A4 = 13
0010D8  2               B4 = 14
0010D8  2               C5 = 15
0010D8  2               D5 = 16
0010D8  2               E5 = 17
0010D8  2               F5 = 18
0010D8  2               G5 = 19
0010D8  2               A5 = 20
0010D8  2               B5 = 21
0010D8  2               C6 = 22
0010D8  2               
0010D8  2               ;----------------------------------------------------------------
0010D8  2               ; The theme: a stately heroic tune in C major, 3 voices.
0010D8  2               ; Durations are in ticks; the three tracks are written so their
0010D8  2               ; total lengths line up over each phrase.
0010D8  2               ;----------------------------------------------------------------
0010D8  2               
0010D8  2               ; --- Channel A : lead melody ---
0010D8  2               ; Every phrase line totals 16 ticks so the lead stays locked in step
0010D8  2               ; with the 16-tick harmony (B) and bass (C) lines.  (Line 1 was 20
0010D8  2               ; ticks before, which drifted B/C out of phase each loop.)
0010D8  2               trackA:
0010D8  2  0C 04 0F 04          .BYTE   G4,4,  C5,4,  E5,4,  G5,2,  E5,2   ; 16
0010DC  2  11 04 13 02  
0010E0  2  11 02        
0010E2  2  12 04 11 04          .BYTE   F5,4,  E5,4,  D5,8                 ; 16
0010E6  2  10 08        
0010E8  2  11 04 13 04          .BYTE   E5,4,  G5,4,  C6,6,  B5,2          ; 16
0010EC  2  16 06 15 02  
0010F0  2  14 04 13 04          .BYTE   A5,4,  G5,4,  E5,8                 ; 16
0010F4  2  11 08        
0010F6  2  12 04 14 04          .BYTE   F5,4,  A5,4,  G5,4,  E5,4          ; 16
0010FA  2  13 04 11 04  
0010FE  2  10 04 12 04          .BYTE   D5,4,  F5,4,  E5,8                 ; 16
001102  2  11 08        
001104  2  0F 04 11 04          .BYTE   C5,4,  E5,4,  G5,4,  C6,4          ; 16
001108  2  13 04 16 04  
00110C  2  13 04 11 04          .BYTE   G5,4,  E5,4,  C5,8                 ; 16
001110  2  0F 08        
001112  2  00 04                .BYTE   N_REST,4
001114  2  FF                   .BYTE   $FF
001115  2               
001115  2               ; --- Channel B : sustained harmony, one note per phrase line.
001115  2               ;     To stay consonant under a diatonic melody we use the FIFTH of
001115  2               ;     each chord (perfect fifths never clash), in octave 4.
001115  2               ;     Chords per line:  C  G  C  Am  F  G  C  C
001115  2               ;     Fifths:           G  D  G  E   C  D  G  G
001115  2               trackB:
001115  2  0C 10                .BYTE   G4,16           ; C chord  (5th = G)
001117  2  09 10                .BYTE   D4,16           ; G chord  (5th = D)
001119  2  0C 10                .BYTE   G4,16           ; C chord
00111B  2  0A 10                .BYTE   E4,16           ; Am chord (5th = E)
00111D  2  08 10                .BYTE   C4,16           ; F chord  (5th = C)
00111F  2  09 10                .BYTE   D4,16           ; G chord
001121  2  0C 10                .BYTE   G4,16           ; C chord
001123  2  0C 10                .BYTE   G4,16           ; C chord
001125  2  00 04                .BYTE   N_REST,4
001127  2  FF                   .BYTE   $FF
001128  2               
001128  2               ; --- Channel C : bass - the ROOT of each chord, re-struck halfway
001128  2               ;     for a gentle pulse.  Same progression: C G C Am F G C C
001128  2               trackC:
001128  2  01 08 01 08          .BYTE   C3,8,  C3,8     ; C
00112C  2  05 08 05 08          .BYTE   G3,8,  G3,8     ; G
001130  2  01 08 01 08          .BYTE   C3,8,  C3,8     ; C
001134  2  06 08 06 08          .BYTE   A3,8,  A3,8     ; Am
001138  2  04 08 04 08          .BYTE   F3,8,  F3,8     ; F
00113C  2  05 08 05 08          .BYTE   G3,8,  G3,8     ; G
001140  2  01 08 01 08          .BYTE   C3,8,  C3,8     ; C
001144  2  01 08 01 08          .BYTE   C3,8,  C3,8     ; C
001148  2  00 04                .BYTE   N_REST,4
00114A  2  FF                   .BYTE   $FF
00114B  2               
00114B  1                       .INCLUDE "tiles.asm"
00114B  2               ;______________________________________________________________________________
00114B  2               ;  tiles.asm - custom 8x8 character bitmaps for terrain, items, monsters
00114B  2               ;
00114B  2               ;  The memory-mapped video card has a writable character generator.
00114B  2               ;  To redefine character N (see V_PATTERN in dbasic/screencmds.asm):
00114B  2               ;     1. map video sub-page $F8 (VIDEOBANK) into CPU bank $A
00114B  2               ;     2. write N to VideoCharGenOffset ($A002)
00114B  2               ;     3. write 8 scanline bytes to VideoCharGenData ($A003)
00114B  2               ;        (the hardware auto-advances through the 8 rows of the glyph)
00114B  2               ;
00114B  2               ;  Each bitmap is 8 bytes, top row first; bit7 = leftmost pixel.
00114B  2               ;  We redefine codes 128.. (G_* constants) so the normal ASCII font
00114B  2               ;  used for UI text is left intact.
00114B  2               ;______________________________________________________________________________
00114B  2               
00114B  2               VideoCharGenOffset = $A002
00114B  2               VideoCharGenData   = $A003
00114B  2               
00114B  2               ;----------------------------------------------------------------
00114B  2               ; cg_enter / cg_exit - map the character-generator RAM (page $F8)
00114B  2               ; into bank $A and select task 1 (mirrors PAGE_ENTER/PAGE_EXIT).
00114B  2               ;----------------------------------------------------------------
00114B  2               cg_enter:
00114B  2  A9 01                LDA     #$01            ; task 01 (driver)
00114D  2  A2 0A                LDX     #$0A            ; CPU bank $A
00114F  2  A0 F8                LDY     #VIDEOBANK      ; physical page $F8 (char generator)
001151  2  20 F6 FF             JSR     SETPAGE
001154  2  A9 01                LDA     #$01
001156  2  8D E0 EF             STA     PC6502_ACT_TASK
001159  2  60                   RTS
00115A  2               cg_exit:
00115A  2  A9 00                LDA     #$00
00115C  2  8D E0 EF             STA     PC6502_ACT_TASK
00115F  2  60                   RTS
001160  2               
001160  2               ;----------------------------------------------------------------
001160  2               ; chargen_init - upload every custom glyph bitmap.
001160  2               ;
001160  2               ; Driven by a table of (charcode, 8 bytes) records.  The table ends
001160  2               ; with a $00 charcode marker (code 0 is never one of ours).
001160  2               ;----------------------------------------------------------------
001160  2               chargen_init:
001160  2  20 4B 11             JSR     cg_enter
001163  2  A9 93 85 18          SETW16  srcp, glyphtab
001167  2  A9 11 85 19  
00116B  2               @rec:
00116B  2  A0 00                LDY     #0
00116D  2  B1 18                LDA     (srcp),Y        ; char code
00116F  2  F0 1F                BEQ     @done           ; 0 = end of table
001171  2  8D 02 A0             STA     VideoCharGenOffset
001174  2                       ; write the 8 scanline bytes
001174  2  A0 01                LDY     #1
001176  2               @row:
001176  2  B1 18                LDA     (srcp),Y
001178  2  8D 03 A0             STA     VideoCharGenData
00117B  2  C8                   INY
00117C  2  C0 09                CPY     #9
00117E  2  D0 F6                BNE     @row
001180  2                       ; advance srcp by 9 (1 code + 8 data)
001180  2  18                   CLC
001181  2  A5 18                LDA     srcp
001183  2  69 09                ADC     #9
001185  2  85 18                STA     srcp
001187  2  A5 19                LDA     srcp+1
001189  2  69 00                ADC     #0
00118B  2  85 19                STA     srcp+1
00118D  2  4C 6B 11             JMP     @rec
001190  2               @done:
001190  2  4C 5A 11             JMP     cg_exit
001193  2               
001193  2               ;----------------------------------------------------------------
001193  2               ; Glyph bitmap table: each row is  code, b0..b7
001193  2               ;----------------------------------------------------------------
