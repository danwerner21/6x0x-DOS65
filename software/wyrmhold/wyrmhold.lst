0037B7  2  23 23 23 23          .BYTE   "###############+################",0
0037BB  2  23 23 23 23  
0037BF  2  23 23 23 23  
0037D8  2  23 23 23 23          .BYTE   "################################",0
0037DC  2  23 23 23 23  
0037E0  2  23 23 23 23  
0037F9  2               
0037F9  2               ;----------------------------------------------------------------
0037F9  2               ; Authored Sunken Shrine (32 x 20). '<' returns to the overworld.
0037F9  2               ; The Wyrm Warden is spawned in the southeast chamber.
0037F9  2               ;----------------------------------------------------------------
0037F9  2               shrine_src:
0037F9  2  23 23 23 23          .BYTE   "################################",0
0037FD  2  23 23 23 23  
003801  2  23 23 23 23  
00381A  2  23 3C 2E 2E          .BYTE   "#<.............................#",0
00381E  2  2E 2E 2E 2E  
003822  2  2E 2E 2E 2E  
00383B  2  23 2E 2E 2E          .BYTE   "#..............................#",0
00383F  2  2E 2E 2E 2E  
003843  2  2E 2E 2E 2E  
00385C  2  23 2E 2E 2E          .BYTE   "#....~~~~..........~~~~........#",0
003860  2  2E 7E 7E 7E  
003864  2  7E 2E 2E 2E  
00387D  2  23 2E 2E 2E          .BYTE   "#....~~~~..........~~~~........#",0
003881  2  2E 7E 7E 7E  
003885  2  7E 2E 2E 2E  
00389E  2  23 2E 2E 2E          .BYTE   "#....~~~~..........~~~~........#",0
0038A2  2  2E 7E 7E 7E  
0038A6  2  7E 2E 2E 2E  
0038BF  2  23 2E 2E 2E          .BYTE   "#..............................#",0
0038C3  2  2E 2E 2E 2E  
0038C7  2  2E 2E 2E 2E  
0038E0  2  23 2E 23 23          .BYTE   "#.######................######.#",0
0038E4  2  23 23 23 23  
0038E8  2  2E 2E 2E 2E  
003901  2  23 2E 23 2E          .BYTE   "#.#....#................#....#.#",0
003905  2  2E 2E 2E 23  
003909  2  2E 2E 2E 2E  
003922  2  23 2E 23 2E          .BYTE   "#.#....#................#....#.#",0
003926  2  2E 2E 2E 23  
00392A  2  2E 2E 2E 2E  
003943  2  23 2E 23 23          .BYTE   "#.######................######.#",0
003947  2  23 23 23 23  
00394B  2  2E 2E 2E 2E  
003964  2  23 2E 2E 2E          .BYTE   "#..............................#",0
003968  2  2E 2E 2E 2E  
00396C  2  2E 2E 2E 2E  
003985  2  23 2E 2E 2E          .BYTE   "#....~~~~..........~~~~........#",0
003989  2  2E 7E 7E 7E  
00398D  2  7E 2E 2E 2E  
0039A6  2  23 2E 2E 2E          .BYTE   "#....~~~~..........~~~~........#",0
0039AA  2  2E 7E 7E 7E  
0039AE  2  7E 2E 2E 2E  
0039C7  2  23 2E 2E 2E          .BYTE   "#....~~~~..........~~~~........#",0
0039CB  2  2E 7E 7E 7E  
0039CF  2  7E 2E 2E 2E  
0039E8  2  23 2E 2E 2E          .BYTE   "#..............................#",0
0039EC  2  2E 2E 2E 2E  
0039F0  2  2E 2E 2E 2E  
003A09  2  23 2E 2E 2E          .BYTE   "#..........########............#",0
003A0D  2  2E 2E 2E 2E  
003A11  2  2E 2E 2E 23  
003A2A  2  23 2E 2E 2E          .BYTE   "#..............................#",0
003A2E  2  2E 2E 2E 2E  
003A32  2  2E 2E 2E 2E  
003A4B  2  23 2E 2E 2E          .BYTE   "#..............................#",0
003A4F  2  2E 2E 2E 2E  
003A53  2  2E 2E 2E 2E  
003A6C  2  23 23 23 23          .BYTE   "################################",0
003A70  2  23 23 23 23  
003A74  2  23 23 23 23  
003A8D  2               
003A8D  1                       .INCLUDE "video.asm"
003A8D  2               ;______________________________________________________________________________
003A8D  2               ;  video.asm - memory-mapped video: paging, framing, viewport, UI text
003A8D  2               ;
003A8D  2               ;  Direct VRAM access (the fast path used by SpeedScript): map video
003A8D  2               ;  sub-page $F9 into CPU bank $A.  Then:
003A8D  2               ;     text  char at  $A000 + row*80 + col
003A8D  2               ;     color cell at  $A800 + row*80 + col
003A8D  2               ;  Color byte = (bg<<4)|fg.
003A8D  2               ;
003A8D  2               ;  All direct-write routines must be bracketed by vid_enter / vid_exit.
003A8D  2               ;  UI text via the firmware (prmsg / putxy) does NOT page; it uses
003A8D  2               ;  FARCALL chrout/locate and must be used while in task 0.
003A8D  2               ;______________________________________________________________________________
003A8D  2               
003A8D  2               ;----------------------------------------------------------------
003A8D  2               ; vid_enter - map video text/color page into $A000-$AFFF (task 1)
003A8D  2               ;             trashes A,X ; preserves Y
003A8D  2               ;----------------------------------------------------------------
003A8D  2               vid_enter:
003A8D  2  A9 01                LDA     #$01            ; configure task 01
003A8F  2  A2 0A                LDX     #$0A            ; CPU bank $A ($A000-$AFFF)
003A91  2  A0 F9                LDY     #VIDTEXT_PAGE   ; physical video page $F9
003A93  2  20 F6 FF             JSR     SETPAGE
003A96  2  A9 01                LDA     #$01
003A98  2  8D E0 EF             STA     PC6502_ACT_TASK ; activate task 01
003A9B  2  60                   RTS
003A9C  2               
003A9C  2               ;----------------------------------------------------------------
003A9C  2               ; vid_exit - restore normal memory at $A000 (task 0)
003A9C  2               ;----------------------------------------------------------------
003A9C  2               vid_exit:
003A9C  2  A9 00                LDA     #$00
003A9E  2  8D E0 EF             STA     PC6502_ACT_TASK
003AA1  2  60                   RTS
003AA2  2               
003AA2  2               ;----------------------------------------------------------------
003AA2  2               ; rowbase - compute VRAM pointers for the start of a screen row.
003AA2  2               ;   IN : A = row (0..23)
003AA2  2               ;   OUT: vptr -> $A000 + row*80   (text)
003AA2  2               ;        cptr -> $A800 + row*80   (color)
003AA2  2               ;   row*80 = row*64 + row*16 = (row<<6)+(row<<4)
003AA2  2               ;----------------------------------------------------------------
003AA2  2               rowbase:
003AA2  2  85 20                STA     tmp0            ; row
003AA4  2               ; row*16 -> ptr2
003AA4  2  A9 00                LDA     #0
003AA6  2  85 13                STA     ptr2+1
003AA8  2  A5 20                LDA     tmp0
003AAA  2  0A                   ASL     A               ; *2
003AAB  2  0A                   ASL     A               ; *4
003AAC  2  0A                   ASL     A               ; *8
003AAD  2  0A                   ASL     A               ; *16 (row<=23 so <=368, may set carry)
003AAE  2  85 12                STA     ptr2
003AB0  2  A9 00                LDA     #0
003AB2  2  2A                   ROL     A
003AB3  2  85 13                STA     ptr2+1          ; high bits of row*16
003AB5  2               ; row*64 -> ptr
003AB5  2  A5 20                LDA     tmp0
003AB7  2  85 10                STA     ptr
003AB9  2  A9 00                LDA     #0
003ABB  2  85 11                STA     ptr+1
003ABD  2  06 10                ASL     ptr
003ABF  2  26 11                ROL     ptr+1           ; *2
003AC1  2  06 10                ASL     ptr
003AC3  2  26 11                ROL     ptr+1           ; *4
003AC5  2  06 10                ASL     ptr
003AC7  2  26 11                ROL     ptr+1           ; *8
003AC9  2  06 10                ASL     ptr
003ACB  2  26 11                ROL     ptr+1           ; *16
003ACD  2  06 10                ASL     ptr
003ACF  2  26 11                ROL     ptr+1           ; *32
003AD1  2  06 10                ASL     ptr
003AD3  2  26 11                ROL     ptr+1           ; *64
003AD5  2               ; ptr = ptr + ptr2 = row*80
003AD5  2  18                   CLC
003AD6  2  A5 10                LDA     ptr
003AD8  2  65 12                ADC     ptr2
003ADA  2  85 10                STA     ptr
003ADC  2  A5 11                LDA     ptr+1
003ADE  2  65 13                ADC     ptr2+1
003AE0  2  85 11                STA     ptr+1
003AE2  2               ; vptr = $A000 + ptr
003AE2  2  18                   CLC
003AE3  2  A5 10                LDA     ptr
003AE5  2  85 14                STA     vptr
003AE7  2  A5 11                LDA     ptr+1
003AE9  2  69 A0                ADC     #>VRAM_TEXT
003AEB  2  85 15                STA     vptr+1
003AED  2               ; cptr = $A800 + ptr
003AED  2  18                   CLC
003AEE  2  A5 10                LDA     ptr
003AF0  2  85 16                STA     cptr
003AF2  2  A5 11                LDA     ptr+1
003AF4  2  69 A8                ADC     #>VRAM_COLOR
003AF6  2  85 17                STA     cptr+1
003AF8  2  60                   RTS
003AF9  2               
003AF9  2               ;----------------------------------------------------------------
003AF9  2               ; putcell - write one char+color cell directly to VRAM.
003AF9  2               ;   MUST be called between vid_enter / vid_exit.
003AF9  2               ;   IN : tmp1 = row, tmp2 = col, tmp3 = char, colidx = color
003AF9  2               ;   trashes A,Y
003AF9  2               ;----------------------------------------------------------------
003AF9  2               putcell:
003AF9  2  A5 21                LDA     tmp1
003AFB  2  20 A2 3A             JSR     rowbase
003AFE  2  A4 22                LDY     tmp2
003B00  2  A5 23                LDA     tmp3
003B02  2  91 14                STA     (vptr),Y
003B04  2  A5 26                LDA     colidx
003B06  2  91 16                STA     (cptr),Y
003B08  2  60                   RTS
003B09  2               
003B09  2               ;----------------------------------------------------------------
003B09  2               ; cls_vram - fill the whole screen with spaces in C_BLANK.
003B09  2               ;----------------------------------------------------------------
003B09  2               cls_vram:
003B09  2  20 8D 3A             JSR     vid_enter
003B0C  2  A9 00                LDA     #0
003B0E  2  85 27                STA     rowidx
003B10  2               @row:
003B10  2  A5 27                LDA     rowidx
003B12  2  20 A2 3A             JSR     rowbase
003B15  2  A0 00                LDY     #0
003B17  2               @col:
003B17  2  A9 20                LDA     #space
003B19  2  91 14                STA     (vptr),Y
003B1B  2  A9 08                LDA     #C_BLANK
003B1D  2  91 16                STA     (cptr),Y
003B1F  2  C8                   INY
003B20  2  C0 50                CPY     #SCRW
003B22  2  D0 F3                BNE     @col
003B24  2  E6 27                INC     rowidx
003B26  2  A5 27                LDA     rowidx
003B28  2  C9 18                CMP     #SCRH
003B2A  2  D0 E4                BNE     @row
003B2C  2  4C 9C 3A             JMP     vid_exit
003B2F  2               
003B2F  2               ;----------------------------------------------------------------
003B2F  2               ; fillrow_vram - fill one row [colA..colB) with char/color.
003B2F  2               ;   IN: tmp1=row, tmp2=start col, tmp3=char, colidx=color, cnt0=count
003B2F  2               ;   MUST be inside vid_enter/vid_exit.
003B2F  2               ;----------------------------------------------------------------
003B2F  2               fillrow_vram:
003B2F  2  A5 21                LDA     tmp1
003B31  2  20 A2 3A             JSR     rowbase
003B34  2  A4 22                LDY     tmp2
003B36  2  A6 24                LDX     cnt0
003B38  2               @fl:
003B38  2  A5 23                LDA     tmp3
003B3A  2  91 14                STA     (vptr),Y
003B3C  2  A5 26                LDA     colidx
003B3E  2  91 16                STA     (cptr),Y
003B40  2  C8                   INY
003B41  2  CA                   DEX
003B42  2  D0 F4                BNE     @fl
003B44  2  60                   RTS
003B45  2               
003B45  2               ;----------------------------------------------------------------
003B45  2               ; draw_frame - draw the static game UI: title bar, viewport frame,
003B45  2               ;              stat panel frame, and message area divider.
003B45  2               ;              Done once at game start (and after returning from
003B45  2               ;              full-screen menus).
003B45  2               ;----------------------------------------------------------------
003B45  2               draw_frame:
003B45  2  20 09 3B             JSR     cls_vram
003B48  2  20 8D 3A             JSR     vid_enter
003B4B  2               
003B4B  2               ; --- top title bar (row 0) ---
003B4B  2  A9 00                LDA     #0
003B4D  2  85 21                STA     tmp1
003B4F  2  A9 00                LDA     #0
003B51  2  85 22                STA     tmp2
003B53  2  A9 20                LDA     #space
003B55  2  85 23                STA     tmp3
003B57  2  A9 0E                LDA     #C_TITLE
003B59  2  85 26                STA     colidx
003B5B  2  A9 50                LDA     #SCRW
003B5D  2  85 24                STA     cnt0
003B5F  2  20 2F 3B             JSR     fillrow_vram
003B62  2               ; centered title text written below via vid_exit path
003B62  2               
003B62  2               ; --- viewport top/bottom horizontal borders ---
003B62  2               ; top border at row 0 already part of title; we frame the
003B62  2               ; viewport with vertical bars and a bottom rule at VPY0+VPH.
003B62  2               ; vertical left/right bars for viewport rows
003B62  2  A2 01                LDX     #VPY0
003B64  2               @vbar:
003B64  2  8A                   TXA
003B65  2  85 21                STA     tmp1
003B67  2  20 A2 3A             JSR     rowbase
003B6A  2  A0 00                LDY     #0              ; left edge col 0
003B6C  2  A9 7C                LDA     #'|'
003B6E  2  91 14                STA     (vptr),Y
003B70  2  A9 0B                LDA     #C_BORDER
003B72  2  91 16                STA     (cptr),Y
003B74  2  A0 2D                LDY     #(VPW+1)        ; right edge of viewport
003B76  2  A9 7C                LDA     #'|'
003B78  2  91 14                STA     (vptr),Y
003B7A  2  A9 0B                LDA     #C_BORDER
003B7C  2  91 16                STA     (cptr),Y
003B7E  2  E8                   INX
003B7F  2  E0 15                CPX     #(VPY0+VPH)
003B81  2  D0 E1                BNE     @vbar
003B83  2               
003B83  2               ; viewport bottom rule + message divider share row VPY0+VPH
003B83  2               ; (= MSGY0-1).  Draw it full-width.
003B83  2  A9 15                LDA     #(VPY0+VPH)
003B85  2  85 21                STA     tmp1
003B87  2  A9 00                LDA     #0
003B89  2  85 22                STA     tmp2
003B8B  2  A9 3D                LDA     #'='
003B8D  2  85 23                STA     tmp3
003B8F  2  A9 0B                LDA     #C_BORDER
003B91  2  85 26                STA     colidx
003B93  2  A9 50                LDA     #SCRW
003B95  2  85 24                STA     cnt0
003B97  2  20 2F 3B             JSR     fillrow_vram
003B9A  2               
003B9A  2               ; panel header row (row 1) background highlight
003B9A  2  A9 01                LDA     #1
003B9C  2  85 21                STA     tmp1
003B9E  2  A9 2E                LDA     #(VPW+2)
003BA0  2  85 22                STA     tmp2
003BA2  2  A9 20                LDA     #space
003BA4  2  85 23                STA     tmp3
003BA6  2  A9 1E                LDA     #C_PANELHDR
003BA8  2  85 26                STA     colidx
003BAA  2  A9 22                LDA     #(SCRW-(VPW+2))
003BAC  2  85 24                STA     cnt0
003BAE  2  20 2F 3B             JSR     fillrow_vram
003BB1  2               
003BB1  2  20 9C 3A             JSR     vid_exit
003BB4  2               
003BB4  2               ; write the title bar + panel header text via firmware
003BB4  2  A2 1E                LDX     #30
003BB6  2  A0 00                LDY     #0
003BB8  2  20 DB 3B             JSR     locate
003BBB  2  A9 0E                LDA     #C_TITLE
003BBD  2  8D 4A 06             STA     CURCOLOR
003BC0  2  A9 7E A0 3D          PRINTMSG titlebar
003BC4  2  20 ED 3B     
003BC7  2               
003BC7  2  A2 30                LDX     #(VPW+4)
003BC9  2  A0 01                LDY     #1
003BCB  2  20 DB 3B             JSR     locate
003BCE  2  A9 1E                LDA     #C_PANELHDR
003BD0  2  8D 4A 06             STA     CURCOLOR
003BD3  2  A9 92 A0 3D          PRINTMSG panelhdr
003BD7  2  20 ED 3B     
003BDA  2  60                   RTS
003BDB  2               
003BDB  2               ;----------------------------------------------------------------
003BDB  2               ; locate - position the firmware text cursor.  X=col, Y=row.
003BDB  2               ;----------------------------------------------------------------
003BDB  2               locate:
003BDB  2  A9 25 85 32          FARCALL FC_LOCATE
003BDF  2  20 F0 FF     
003BE2  2  60                   RTS
003BE3  2               
003BE3  2               ;----------------------------------------------------------------
003BE3  2               ; putc - output one char via firmware (A=char), honoring CURCOLOR.
003BE3  2               ;        (Cannot use the FARCALL macro - it would clobber the char
003BE3  2               ;         in A.  Set farfunct, then restore A before the call.)
003BE3  2               ;----------------------------------------------------------------
003BE3  2               putc:
003BE3  2  48                   PHA
003BE4  2  A9 13                LDA     #FC_CHROUT
003BE6  2  85 32                STA     farfunct
003BE8  2  68                   PLA
003BE9  2  20 F0 FF             JSR     DO_FARCALL
003BEC  2  60                   RTS
003BED  2               
003BED  2               ;----------------------------------------------------------------
003BED  2               ; prmsg - print a 0-terminated string via firmware chrout.
003BED  2               ;   IN: A=lo, Y=hi of string address.  Uses CURCOLOR for color.
003BED  2               ;----------------------------------------------------------------
003BED  2               prmsg:
003BED  2  85 1C                STA     strp
003BEF  2  84 1D                STY     strp+1
003BF1  2  A0 00                LDY     #0
003BF3  2               @pl:
003BF3  2  B1 1C                LDA     (strp),Y
003BF5  2  F0 08                BEQ     @done
003BF7  2  5A                   PHY
003BF8  2  20 E3 3B             JSR     putc
003BFB  2  7A                   PLY
003BFC  2  C8                   INY
003BFD  2  D0 F4                BNE     @pl
003BFF  2               @done:
003BFF  2  60                   RTS
003C00  2               
003C00  2               ;----------------------------------------------------------------
003C00  2               ; putxy - position cursor (X=col,Y=row), set color (A=color),
003C00  2               ;         then print string at strp.  Helper for panel fields.
003C00  2               ;   IN: tmp2=col, tmp1=row, colidx=color, strp=string ptr
003C00  2               ;----------------------------------------------------------------
003C00  2               putxy:
003C00  2  A6 22                LDX     tmp2
003C02  2  A4 21                LDY     tmp1
003C04  2  20 DB 3B             JSR     locate
003C07  2  A5 26                LDA     colidx
003C09  2  8D 4A 06             STA     CURCOLOR
003C0C  2  A5 1C                LDA     strp
003C0E  2  A4 1D                LDY     strp+1
003C10  2  20 ED 3B             JSR     prmsg
003C13  2  60                   RTS
003C14  2               
003C14  2               ;----------------------------------------------------------------
003C14  2               ; clear_panel_value - blank a panel field area before redraw.
003C14  2               ;   IN: X=col, Y=row, A=width
003C14  2               ;----------------------------------------------------------------
003C14  2               clear_panel_value:
003C14  2  85 25                STA     cnt1            ; width
003C16  2  20 DB 3B             JSR     locate
003C19  2  A9 0F                LDA     #C_PANEL
003C1B  2  8D 4A 06             STA     CURCOLOR
003C1E  2               @cpv:
003C1E  2  A9 20                LDA     #space
003C20  2  20 E3 3B             JSR     putc
003C23  2  C6 25                DEC     cnt1
003C25  2  D0 F7                BNE     @cpv
003C27  2  60                   RTS
003C28  2               
003C28  2               ;----------------------------------------------------------------
003C28  2               ; render_view - draw the scrolling map viewport centered on the
003C28  2               ; player. Each world tile is a 2x2 character-cell metatile.
003C28  2               ;
003C28  2               ;   uses: px,py (player world coords), loc (active map)
003C28  2               ;   The top-left WORLD cell shown is (px-VPCX, py-VPCY).
003C28  2               ;----------------------------------------------------------------
003C28  2               render_view:
003C28  2  20 8D 3A             JSR     vid_enter
003C2B  2               ; world-tile row = 0..VPTH-1
003C2B  2  A9 00                LDA     #0
003C2D  2  85 27                STA     rowidx
003C2F  2               @vrow:
003C2F  2               ; world y for this row = py - VPCY + rowidx
003C2F  2  38                   SEC
003C30  2  AD 0D 62             LDA     py
003C33  2  E9 05                SBC     #VPCY
003C35  2  18                   CLC
003C36  2  65 27                ADC     rowidx
003C38  2  85 2D                STA     tgty
003C3A  2               ; world-tile column loop
003C3A  2  A9 00                LDA     #0
003C3C  2  85 26                STA     colidx
003C3E  2               @vcol:
003C3E  2               ; world x = px - VPCX + colidx
003C3E  2  38                   SEC
003C3F  2  AD 0C 62             LDA     px
003C42  2  E9 0B                SBC     #VPCX
003C44  2  18                   CLC
003C45  2  65 26                ADC     colidx
003C47  2  85 2C                STA     tgtx
003C49  2               ; fetch tile (returns tgttile)
003C49  2  20 C4 1B             JSR     tileat
003C4C  2               ; metatile base glyph = MG_TERRAIN_BASE + tile_code*4
003C4C  2  A5 2E                LDA     tgttile
003C4E  2  0A                   ASL     A
003C4F  2  0A                   ASL     A
003C50  2  18                   CLC
003C51  2  69 80                ADC     #MG_TERRAIN_BASE
003C53  2  85 24                STA     cnt0
003C55  2  A6 2E                LDX     tgttile
003C57  2  BD 39 1A             LDA     tile_color,X
003C5A  2  85 25                STA     cnt1
003C5C  2               ; pick an alternate art variant for some cells so large regions of
003C5C  2               ; one terrain don't show an obvious repeating grid. A terrain has a
003C5C  2               ; variant iff tile_variant[code] != 0; we use it when the cheap
003C5C  2               ; position hash (tgtx ^ tgty) bit0 is set.
003C5C  2  BD 4A 1A             LDA     tile_variant,X
003C5F  2  F0 0D                BEQ     @novar          ; this terrain has no variant
003C61  2  A5 2C                LDA     tgtx
003C63  2  45 2D                EOR     tgty
003C65  2  29 01                AND     #$01
003C67  2  F0 05                BEQ     @novar          ; hash says keep the base art
003C69  2  BD 4A 1A             LDA     tile_variant,X  ; swap in the variant metatile base
003C6C  2  85 24                STA     cnt0
003C6E  2               @novar:
003C6E  2               ; screen column = VPX0 + colidx*2
003C6E  2  A5 26                LDA     colidx
003C70  2  0A                   ASL     A
003C71  2  18                   CLC
003C72  2  69 01                ADC     #VPX0
003C74  2  85 22                STA     tmp2
003C76  2               ; screen row = VPY0 + rowidx*2
003C76  2  A5 27                LDA     rowidx
003C78  2  0A                   ASL     A
003C79  2  18                   CLC
003C7A  2  69 01                ADC     #VPY0
003C7C  2  85 23                STA     tmp3
003C7E  2  20 CB 3C             JSR     blit_metatile_vram
003C81  2               ; next column
003C81  2  E6 26                INC     colidx
003C83  2  A5 26                LDA     colidx
003C85  2  C9 16                CMP     #VPTW
003C87  2  D0 B5                BNE     @vcol
003C89  2               ; next row
003C89  2  E6 27                INC     rowidx
003C8B  2  A5 27                LDA     rowidx
003C8D  2  C9 0A                CMP     #VPTH
003C8F  2  D0 9E                BNE     @vrow
003C91  2               
003C91  2               ; --- overlay monsters that fall within the viewport ---
003C91  2  20 93 46             JSR     draw_monsters_vram
003C94  2               
003C94  2               ; --- overlay the dragon's warned fire lane ---
003C94  2  20 C3 46             JSR     draw_dragon_telegraph_vram
003C97  2               
003C97  2               ; --- overlay fixed location characters ---
003C97  2  20 B0 3C             JSR     draw_castle_ruler_vram
003C9A  2               
003C9A  2               ; --- overlay the player at the fixed center metatile ---
003C9A  2  A9 C4                LDA     #MG_PLAYER
003C9C  2  85 24                STA     cnt0
003C9E  2  A9 0F                LDA     #C_PLAYER
003CA0  2  85 25                STA     cnt1
003CA2  2  A9 17                LDA     #(VPX0+(VPCX*2))
003CA4  2  85 22                STA     tmp2
003CA6  2  A9 0B                LDA     #(VPY0+(VPCY*2))
003CA8  2  85 23                STA     tmp3
003CAA  2  20 08 3D             JSR     blit_entity_vram
003CAD  2               
003CAD  2  4C 9C 3A             JMP     vid_exit
003CB0  2               
003CB0  2               ;----------------------------------------------------------------
003CB0  2               ; draw_castle_ruler_vram - draw the ruler over the audience-room
003CB0  2               ; throne using the player silhouette in royal colors.
003CB0  2               ;----------------------------------------------------------------
003CB0  2               draw_castle_ruler_vram:
003CB0  2  AD 19 62             LDA     loc
003CB3  2  C9 03                CMP     #LOC_CASTLE
003CB5  2  D0 13                BNE     @done
003CB7  2  A9 0F                LDA     #CASTLE_RULER_X
003CB9  2  85 2C                STA     tgtx
003CBB  2  A9 04                LDA     #CASTLE_RULER_Y
003CBD  2  85 2D                STA     tgty
003CBF  2  A9 C4                LDA     #MG_PLAYER
003CC1  2  85 24                STA     cnt0
003CC3  2  A9 4E                LDA     #COLOR(CO_BRYELLOW,CO_RED)
003CC5  2  85 25                STA     cnt1
003CC7  2  4C 50 3D             JMP     plot_view_cell
003CCA  2               @done:
003CCA  2  60                   RTS
003CCB  2               
003CCB  2               ;----------------------------------------------------------------
003CCB  2               ; blit_metatile_vram - draw a 2x2 terrain metatile with one color.
003CCB  2               ;   IN: cnt0=base glyph, cnt1=color, tmp2=screen col, tmp3=screen row
003CCB  2               ;   MUST be called inside vid_enter/vid_exit.
003CCB  2               ;----------------------------------------------------------------
003CCB  2               blit_metatile_vram:
003CCB  2  A5 23                LDA     tmp3
003CCD  2  20 A2 3A             JSR     rowbase
003CD0  2  A4 22                LDY     tmp2
003CD2  2  A5 24                LDA     cnt0
003CD4  2  91 14                STA     (vptr),Y
003CD6  2  A5 25                LDA     cnt1
003CD8  2  91 16                STA     (cptr),Y
003CDA  2  C8                   INY
003CDB  2  A5 24                LDA     cnt0
003CDD  2  18                   CLC
003CDE  2  69 01                ADC     #1
003CE0  2  91 14                STA     (vptr),Y
003CE2  2  A5 25                LDA     cnt1
003CE4  2  91 16                STA     (cptr),Y
003CE6  2               
003CE6  2  A5 23                LDA     tmp3
003CE8  2  18                   CLC
003CE9  2  69 01                ADC     #1
003CEB  2  20 A2 3A             JSR     rowbase
003CEE  2  A4 22                LDY     tmp2
003CF0  2  A5 24                LDA     cnt0
003CF2  2  18                   CLC
003CF3  2  69 02                ADC     #2
003CF5  2  91 14                STA     (vptr),Y
003CF7  2  A5 25                LDA     cnt1
003CF9  2  91 16                STA     (cptr),Y
003CFB  2  C8                   INY
003CFC  2  A5 24                LDA     cnt0
003CFE  2  18                   CLC
003CFF  2  69 03                ADC     #3
003D01  2  91 14                STA     (vptr),Y
003D03  2  A5 25                LDA     cnt1
003D05  2  91 16                STA     (cptr),Y
003D07  2  60                   RTS
003D08  2               
003D08  2               ;----------------------------------------------------------------
003D08  2               ; blit_entity_vram - overlay a 2x2 entity metatile while preserving
003D08  2               ; each terrain cell's background color.
003D08  2               ;   IN: cnt0=base glyph, cnt1=entity color, tmp2=screen col,
003D08  2               ;       tmp3=screen row
003D08  2               ;   MUST be called inside vid_enter/vid_exit.
003D08  2               ;----------------------------------------------------------------
003D08  2               blit_entity_vram:
003D08  2  A5 23                LDA     tmp3
003D0A  2  20 A2 3A             JSR     rowbase
003D0D  2  A4 22                LDY     tmp2
003D0F  2  A5 24                LDA     cnt0
003D11  2  91 14                STA     (vptr),Y
003D13  2  20 41 3D             JSR     entity_color_at_y
003D16  2  C8                   INY
003D17  2  A5 24                LDA     cnt0
003D19  2  18                   CLC
003D1A  2  69 01                ADC     #1
003D1C  2  91 14                STA     (vptr),Y
003D1E  2  20 41 3D             JSR     entity_color_at_y
003D21  2               
003D21  2  A5 23                LDA     tmp3
003D23  2  18                   CLC
003D24  2  69 01                ADC     #1
003D26  2  20 A2 3A             JSR     rowbase
003D29  2  A4 22                LDY     tmp2
003D2B  2  A5 24                LDA     cnt0
003D2D  2  18                   CLC
003D2E  2  69 02                ADC     #2
003D30  2  91 14                STA     (vptr),Y
003D32  2  20 41 3D             JSR     entity_color_at_y
003D35  2  C8                   INY
003D36  2  A5 24                LDA     cnt0
003D38  2  18                   CLC
003D39  2  69 03                ADC     #3
003D3B  2  91 14                STA     (vptr),Y
003D3D  2  20 41 3D             JSR     entity_color_at_y
003D40  2  60                   RTS
003D41  2               
003D41  2               ; preserve background nibble at the current cptr,Y; apply cnt1 foreground
003D41  2               entity_color_at_y:
003D41  2  B1 16                LDA     (cptr),Y
003D43  2  29 F0                AND     #$F0
003D45  2  85 20                STA     tmp0
003D47  2  A5 25                LDA     cnt1
003D49  2  29 0F                AND     #$0F
003D4B  2  05 20                ORA     tmp0
003D4D  2  91 16                STA     (cptr),Y
003D4F  2  60                   RTS
003D50  2               
003D50  2               ;----------------------------------------------------------------
003D50  2               ; plot_view_cell - overlay an entity metatile at WORLD coords
003D50  2               ; (tgtx,tgty) if it is visible.
003D50  2               ;   IN: tgtx,tgty=world coords, cnt0=base glyph, cnt1=color
003D50  2               ;   MUST be called inside vid_enter/vid_exit.
003D50  2               ;----------------------------------------------------------------
003D50  2               plot_view_cell:
003D50  2               ; viewport tile column = tgtx - px + VPCX
003D50  2  38                   SEC
003D51  2  A5 2C                LDA     tgtx
003D53  2  ED 0C 62             SBC     px
003D56  2  18                   CLC
003D57  2  69 0B                ADC     #VPCX
003D59  2               ; must be 0..VPTW-1
003D59  2  30 22                BMI     @no             ; (signed underflow check via N flag)
003D5B  2  C9 16                CMP     #VPTW
003D5D  2  B0 1E                BCS     @no
003D5F  2  0A                   ASL     A
003D60  2  18                   CLC
003D61  2  69 01                ADC     #VPX0
003D63  2  85 22                STA     tmp2            ; screen column
003D65  2               ; viewport tile row = tgty - py + VPCY
003D65  2  38                   SEC
003D66  2  A5 2D                LDA     tgty
003D68  2  ED 0D 62             SBC     py
003D6B  2  18                   CLC
003D6C  2  69 05                ADC     #VPCY
003D6E  2  30 0D                BMI     @no
003D70  2  C9 0A                CMP     #VPTH
003D72  2  B0 09                BCS     @no
003D74  2  0A                   ASL     A
003D75  2  18                   CLC
003D76  2  69 01                ADC     #VPY0
003D78  2  85 23                STA     tmp3            ; screen row
003D7A  2  4C 08 3D             JMP     blit_entity_vram
003D7D  2               @no:
003D7D  2  60                   RTS
003D7E  2               
003D7E  2               ;----------------------------------------------------------------
003D7E  2               ; Static UI strings
003D7E  2               ;----------------------------------------------------------------
003D7E  2               titlebar:
003D7E  2  3D 20 57 20          .BYTE   "= W Y R M H O L D =",0
003D82  2  59 20 52 20  
003D86  2  4D 20 48 20  
003D92  2               panelhdr:
003D92  2  41 44 56 45          .BYTE   "ADVENTURER",0
003D96  2  4E 54 55 52  
003D9A  2  45 52 00     
003D9D  2               
003D9D  1                       .INCLUDE "ui.asm"
003D9D  2               ;______________________________________________________________________________
003D9D  2               ;  ui.asm - message log, stat panel, prompts, decimal output
003D9D  2               ;______________________________________________________________________________
003D9D  2               
003D9D  2               ;----------------------------------------------------------------
003D9D  2               ; displaynum - print the 16-bit value in numarg as decimal using
003D9D  2               ;              the firmware (honours CURCOLOR).  No leading spaces.
003D9D  2               ;              (adapted from speedscript displaynum)
003D9D  2               ;----------------------------------------------------------------
003D9D  2               displaynum:
003D9D  2  A0 08                LDY     #8              ; index into nums (5 entries x2 bytes)
003D9F  2               @find:
003D9F  2  A5 1F                LDA     numarg+1
003DA1  2  D9 E7 3D             CMP     nums+1,Y
003DA4  2  90 09                BCC     @next
003DA6  2  D0 0B                BNE     @start
003DA8  2  A5 1E                LDA     numarg
003DAA  2  D9 E6 3D             CMP     nums,Y
003DAD  2  B0 04                BCS     @start
003DAF  2               @next:
003DAF  2  88                   DEY
003DB0  2  88                   DEY
003DB1  2  D0 EC                BNE     @find
003DB3  2               @start:
003DB3  2  A9 30                LDA     #'0'
003DB5  2  85 28                STA     numspace
003DB7  2               @dig:
003DB7  2  A5 1F                LDA     numarg+1
003DB9  2  D9 E7 3D             CMP     nums+1,Y
003DBC  2  90 1E                BCC     @out
003DBE  2  D0 09                BNE     @nocmp
003DC0  2  A5 1E                LDA     numarg
003DC2  2  F9 E6 3D             SBC     nums,Y          ; carry set
003DC5  2  90 15                BCC     @out
003DC7  2  B0 05                BCS     @sub
003DC9  2               @nocmp:
003DC9  2  A5 1E                LDA     numarg
003DCB  2  F9 E6 3D             SBC     nums,Y          ; carry set
003DCE  2               @sub:
003DCE  2  E6 28                INC     numspace
003DD0  2  85 1E                STA     numarg
003DD2  2  A5 1F                LDA     numarg+1
003DD4  2  F9 E7 3D             SBC     nums+1,Y
003DD7  2  85 1F                STA     numarg+1
003DD9  2  4C B7 3D             JMP     @dig
003DDC  2               @out:
003DDC  2  A5 28                LDA     numspace
003DDE  2  20 E3 3B             JSR     putc
003DE1  2  88                   DEY
003DE2  2  88                   DEY
003DE3  2  10 CE                BPL     @start
003DE5  2  60                   RTS
003DE6  2               
003DE6  2               ; place value table (1,10,100,1000,10000) as 16-bit LE words
003DE6  2               nums:
003DE6  2  01 00                .WORD   1
003DE8  2  0A 00                .WORD   10
003DEA  2  64 00                .WORD   100
003DEC  2  E8 03                .WORD   1000
003DEE  2  10 27                .WORD   10000
003DF0  2               
003DF0  2               ;----------------------------------------------------------------
003DF0  2               ; print a single 8-bit value (in A) as decimal.
003DF0  2               ;----------------------------------------------------------------
003DF0  2               print_byte:
003DF0  2  85 1E                STA     numarg
003DF2  2  A9 00                LDA     #0
003DF4  2  85 1F                STA     numarg+1
003DF6  2  4C 9D 3D             JMP     displaynum
003DF9  2               
003DF9  2               ;----------------------------------------------------------------
003DF9  2               ; Message log: two lines at rows MSGY0 and MSGY0+1.
003DF9  2               ; msg_print scrolls the bottom line up and prints a new line.
003DF9  2               ;
003DF9  2               ;   msg_print:  IN A=lo,Y=hi of 0-terminated string
003DF9  2               ;----------------------------------------------------------------
003DF9  2               msg_print:
003DF9  2  85 1C                STA     strp
003DFB  2  84 1D                STY     strp+1
003DFD  2               ; copy current bottom line (msgbuf1) up to (msgbuf0)
003DFD  2  A2 00                LDX     #0
003DFF  2               @up:
003DFF  2  BD 88 62             LDA     msgbuf1,X
003E02  2  9D 38 62             STA     msgbuf0,X
003E05  2  E8                   INX
003E06  2  E0 50                CPX     #SCRW
003E08  2  D0 F5                BNE     @up
003E0A  2               ; copy new string into msgbuf1 (truncate/pad to SCRW)
003E0A  2  A0 00                LDY     #0
003E0C  2               @cp:
003E0C  2  B1 1C                LDA     (strp),Y
003E0E  2  F0 0B                BEQ     @padb
003E10  2  99 88 62             STA     msgbuf1,Y
003E13  2  C8                   INY
003E14  2  C0 50                CPY     #SCRW
003E16  2  D0 F4                BNE     @cp
003E18  2  4C 25 3E             JMP     @draw
003E1B  2               @padb:
003E1B  2  A9 20                LDA     #space
003E1D  2               @pad:
003E1D  2  99 88 62             STA     msgbuf1,Y
003E20  2  C8                   INY
003E21  2  C0 50                CPY     #SCRW
003E23  2  D0 F8                BNE     @pad
003E25  2               @draw:
003E25  2  4C 28 3E             JMP     msg_redraw
003E28  2               
003E28  2               ;----------------------------------------------------------------
003E28  2               ; msg_redraw - blit both message buffers to the message rows via
003E28  2               ;              direct VRAM (so it does not disturb the text cursor).
003E28  2               ;----------------------------------------------------------------
003E28  2               msg_redraw:
003E28  2  20 8D 3A             JSR     vid_enter
003E2B  2               ; row MSGY0 <- msgbuf0
003E2B  2  A9 16                LDA     #MSGY0
003E2D  2  20 A2 3A             JSR     rowbase
003E30  2  A0 00                LDY     #0
003E32  2               @r0:
003E32  2  B9 38 62             LDA     msgbuf0,Y
003E35  2  91 14                STA     (vptr),Y
003E37  2  A9 0F                LDA     #C_MSG
003E39  2  91 16                STA     (cptr),Y
003E3B  2  C8                   INY
003E3C  2  C0 50                CPY     #SCRW
003E3E  2  D0 F2                BNE     @r0
003E40  2               ; row MSGY0+1 <- msgbuf1
003E40  2  A9 17                LDA     #MSGY0+1
003E42  2  20 A2 3A             JSR     rowbase
003E45  2  A0 00                LDY     #0
003E47  2               @r1:
003E47  2  B9 88 62             LDA     msgbuf1,Y
003E4A  2  91 14                STA     (vptr),Y
003E4C  2  A9 0F                LDA     #C_MSG
003E4E  2  91 16                STA     (cptr),Y
003E50  2  C8                   INY
003E51  2  C0 50                CPY     #SCRW
003E53  2  D0 F2                BNE     @r1
003E55  2  4C 9C 3A             JMP     vid_exit
003E58  2               
003E58  2               ;----------------------------------------------------------------
003E58  2               ; msg_clear - blank both message buffers and redraw.
003E58  2               ;----------------------------------------------------------------
003E58  2               msg_clear:
003E58  2  A2 00                LDX     #0
003E5A  2  A9 20                LDA     #space
003E5C  2               @mc:
003E5C  2  9D 38 62             STA     msgbuf0,X
003E5F  2  9D 88 62             STA     msgbuf1,X
003E62  2  E8                   INX
003E63  2  E0 50                CPX     #SCRW
003E65  2  D0 F5                BNE     @mc
003E67  2  4C 28 3E             JMP     msg_redraw
003E6A  2               
003E6A  2               ;----------------------------------------------------------------
003E6A  2               ; Stat panel.  Drawn on the right side using firmware text output.
003E6A  2               ; Labels are static; values are redrawn each turn.
003E6A  2               ;----------------------------------------------------------------
003E6A  2               draw_panel:
003E6A  2               ; HP line:  "HP   : nn/nn"
003E6A  2  A2 30                LDX     #PANX
003E6C  2  A0 03                LDY     #3
003E6E  2  20 DB 3B             JSR     locate
003E71  2  A9 0F                LDA     #C_PANEL
003E73  2  8D 4A 06             STA     CURCOLOR
003E76  2  A9 9F A0 41          PRINTMSG lbl_hp
003E7A  2  20 ED 3B     
003E7D  2  AD 0E 62             LDA     phealth
003E80  2  20 F0 3D             JSR     print_byte
003E83  2  A9 2F                LDA     #'/'
003E85  2  20 E3 3B             JSR     putc
003E88  2  AD 0F 62             LDA     pmaxhp
003E8B  2  20 F0 3D             JSR     print_byte
003E8E  2  20 14 40             JSR     pad_clear       ; clear trailing junk
003E91  2               
003E91  2               ; Level / XP
003E91  2  A2 30                LDX     #PANX
003E93  2  A0 05                LDY     #5
003E95  2  20 DB 3B             JSR     locate
003E98  2  A9 A7 A0 41          PRINTMSG lbl_lvl
003E9C  2  20 ED 3B     
003E9F  2  AD 10 62             LDA     plevel
003EA2  2  20 F0 3D             JSR     print_byte
003EA5  2  A2 3C                LDX     #PANX+12
003EA7  2  A0 05                LDY     #5
003EA9  2  20 DB 3B             JSR     locate
003EAC  2  A9 AD A0 41          PRINTMSG lbl_xp
003EB0  2  20 ED 3B     
003EB3  2  AD 11 62 85          COPY16  pxp, numarg
003EB7  2  1E AD 12 62  
003EBB  2  85 1F        
003EBD  2  20 9D 3D             JSR     displaynum
003EC0  2  20 14 40             JSR     pad_clear
003EC3  2               
003EC3  2               ; Gold / Food
003EC3  2  A2 30                LDX     #PANX
003EC5  2  A0 07                LDY     #7
003EC7  2  20 DB 3B             JSR     locate
003ECA  2  A9 B2 A0 41          PRINTMSG lbl_gold
003ECE  2  20 ED 3B     
003ED1  2  AD 13 62 85          COPY16  pgold, numarg
003ED5  2  1E AD 14 62  
003ED9  2  85 1F        
003EDB  2  20 9D 3D             JSR     displaynum
003EDE  2  A2 3C                LDX     #PANX+12
003EE0  2  A0 07                LDY     #7
003EE2  2  20 DB 3B             JSR     locate
003EE5  2  A9 B9 A0 41          PRINTMSG lbl_food
003EE9  2  20 ED 3B     
003EEC  2  AD 15 62 85          COPY16  pfood, numarg
003EF0  2  1E AD 16 62  
003EF4  2  85 1F        
003EF6  2  20 9D 3D             JSR     displaynum
003EF9  2  20 14 40             JSR     pad_clear
003EFC  2               
003EFC  2               ; Weapon
003EFC  2  A2 30                LDX     #PANX
003EFE  2  A0 09                LDY     #9
003F00  2  20 DB 3B             JSR     locate
003F03  2  A9 C0 A0 41          PRINTMSG lbl_wpn
003F07  2  20 ED 3B     
003F0A  2  AD 17 62             LDA     pweapon
003F0D  2  20 24 40             JSR     name_weapon     ; strp -> name
003F10  2  A5 1C                LDA     strp
003F12  2  A4 1D                LDY     strp+1
003F14  2  20 ED 3B             JSR     prmsg
003F17  2  20 14 40             JSR     pad_clear
003F1A  2               
003F1A  2               ; Armor
003F1A  2  A2 30                LDX     #PANX
003F1C  2  A0 0A                LDY     #10
003F1E  2  20 DB 3B             JSR     locate
003F21  2  A9 C9 A0 41          PRINTMSG lbl_arm
003F25  2  20 ED 3B     
003F28  2  AD 18 62             LDA     parmor
003F2B  2  20 31 40             JSR     name_armor
003F2E  2  A5 1C                LDA     strp
003F30  2  A4 1D                LDY     strp+1
003F32  2  20 ED 3B             JSR     prmsg
003F35  2  20 14 40             JSR     pad_clear
003F38  2               
003F38  2               ; Location
003F38  2  A2 30                LDX     #PANX
003F3A  2  A0 0C                LDY     #12
003F3C  2  20 DB 3B             JSR     locate
003F3F  2  A9 D2 A0 41          PRINTMSG lbl_loc
003F43  2  20 ED 3B     
003F46  2  AD 19 62             LDA     loc
003F49  2  20 3E 40             JSR     name_loc
003F4C  2  A5 1C                LDA     strp
003F4E  2  A4 1D                LDY     strp+1
003F50  2  20 ED 3B             JSR     prmsg
003F53  2  20 14 40             JSR     pad_clear
003F56  2               
003F56  2               ; Current objective
003F56  2  A2 30                LDX     #PANX
003F58  2  A0 0E                LDY     #14
003F5A  2  20 DB 3B             JSR     locate
003F5D  2  A9 1E                LDA     #C_PANELHDR
003F5F  2  8D 4A 06             STA     CURCOLOR
003F62  2  A9 DB A0 41          PRINTMSG lbl_obj
003F66  2  20 ED 3B     
003F69  2  20 14 40             JSR     pad_clear
003F6C  2  A2 30                LDX     #PANX
003F6E  2  A0 0F                LDY     #15
003F70  2  20 DB 3B             JSR     locate
003F73  2  A9 0F                LDA     #C_PANEL
003F75  2  8D 4A 06             STA     CURCOLOR
003F78  2  AD 21 62             LDA     queststate
003F7B  2  20 76 40             JSR     name_objective
003F7E  2  A5 1C                LDA     strp
003F80  2  A4 1D                LDY     strp+1
003F82  2  20 ED 3B             JSR     prmsg
003F85  2  20 14 40             JSR     pad_clear
003F88  2               
003F88  2               ; Current status
003F88  2  A2 30                LDX     #PANX
003F8A  2  A0 11                LDY     #17
003F8C  2  20 DB 3B             JSR     locate
