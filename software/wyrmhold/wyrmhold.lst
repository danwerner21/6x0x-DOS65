0011C7  2               
0011C7  2               ; dungeon: an arched cave mouth (outline)
0011C7  2  06                   .BYTE   G_DUNG
0011C8  2  00                   .BYTE   %00000000
0011C9  2  3C                   .BYTE   %00111100
0011CA  2  42                   .BYTE   %01000010
0011CB  2  42                   .BYTE   %01000010
0011CC  2  42                   .BYTE   %01000010
0011CD  2  42                   .BYTE   %01000010
