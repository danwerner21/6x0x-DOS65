003D59  2               
003D59  1                       .INCLUDE "entity.asm"
003D59  2               ;______________________________________________________________________________
003D59  2               ;  entity.asm - monsters: table, spawning, simple AI, rendering
003D59  2               ;
003D59  2               ;  Parallel arrays of MAXMON slots.  A slot with mon_type == M_NONE
003D59  2               ;  is empty.  Monsters live on the currently active map (overworld
003D59  2               ;  or dungeon).  Towns have no monsters.
003D59  2               ;______________________________________________________________________________
003D59  2               
003D59  2               ;----------------------------------------------------------------
003D59  2               ; Per-monster-type stat tables (indexed by M_* id)
003D59  2               ;   mtype_glyph : 2x2 metatile base glyph
003D59  2               ;   mtype_color : color cell
003D59  2               ;   mtype_hp    : starting HP
003D59  2               ;   mtype_atk   : attack dice sides (damage 1..atk)
003D59  2               ;   mtype_xp    : XP awarded on kill
003D59  2               ;   mtype_gold  : gold dropped (max; rolled 0..gold)
003D59  2               ;----------------------------------------------------------------
003D59  2               mtype_glyph:
003D59  2  20                   .BYTE   ' '             ; 0 none
003D5A  2  C8                   .BYTE   MG_ORC          ; 1 orc
003D5B  2  CC                   .BYTE   MG_SNAKE        ; 2 snake
003D5C  2  D0                   .BYTE   MG_SKELETON     ; 3 skeleton
003D5D  2  D4                   .BYTE   MG_THIEF        ; 4 thief
003D5E  2  D8                   .BYTE   MG_TROLL        ; 5 troll
003D5F  2  DC                   .BYTE   MG_BOSS         ; 6 boss (dragon)
003D60  2  F0                   .BYTE   MG_WARDEN       ; 7 Wyrm Warden
003D61  2               mtype_color:
003D61  2  0C                   .BYTE   C_MONST         ; 0
003D62  2  0C                   .BYTE   COLOR(CO_BRRED, CO_BLACK); orc
003D63  2  0E                   .BYTE   COLOR(CO_BRYELLOW,CO_BLACK); snake
003D64  2  0F                   .BYTE   COLOR(CO_BRWHITE,CO_BLACK); skeleton
003D65  2  05                   .BYTE   COLOR(CO_VIOLET,CO_BLACK); thief
003D66  2  0B                   .BYTE   COLOR(CO_BRTURQ,CO_BLACK); troll
003D67  2  4C                   .BYTE   C_BOSS          ; boss
003D68  2  0D                   .BYTE   COLOR(CO_BRPURPLE,CO_BLACK); Wyrm Warden
003D69  2               mtype_hp:
003D69  2  00 06 04 08          .BYTE   0, 6, 4, 8, 5, 14, 40, 24
003D6D  2  05 0E 28 18  
003D71  2               mtype_atk:
003D71  2  00 04 03 05          .BYTE   0, 4, 3, 5, 3, 7, 12, 8
003D75  2  03 07 0C 08  
003D79  2               mtype_xp:
003D79  2  00 03 02 05          .BYTE   0, 3, 2, 5, 4, 10, 50, 25
003D7D  2  04 0A 32 19  
003D81  2               mtype_gold:
003D81  2  00 04 01 03          .BYTE   0, 4, 1, 3, 12, 8, 40, 0
003D85  2  0C 08 28 00  
003D89  2               
003D89  2               ;----------------------------------------------------------------
003D89  2               ; mon_clear_all - empty every monster slot.
003D89  2               ;----------------------------------------------------------------
003D89  2               mon_clear_all:
003D89  2  A2 00                LDX     #0
003D8B  2  A9 00                LDA     #M_NONE
003D8D  2               @c:
003D8D  2  9D 91 52             STA     mon_type,X
003D90  2  E8                   INX
003D91  2  E0 0C                CPX     #MAXMON
003D93  2  D0 F8                BNE     @c
003D95  2  60                   RTS
003D96  2               
003D96  2               ;----------------------------------------------------------------
003D96  2               ; mon_find_free - find an empty slot.  Returns X = slot, C=1 ok,
003D96  2               ;                 C=0 if table full.
003D96  2               ;----------------------------------------------------------------
003D96  2               mon_find_free:
003D96  2  A2 00                LDX     #0
003D98  2               @f:
003D98  2  BD 91 52             LDA     mon_type,X
003D9B  2  C9 00                CMP     #M_NONE
003D9D  2  F0 07                BEQ     @found
003D9F  2  E8                   INX
003DA0  2  E0 0C                CPX     #MAXMON
003DA2  2  D0 F4                BNE     @f
003DA4  2  18                   CLC
003DA5  2  60                   RTS
003DA6  2               @found:
003DA6  2  38                   SEC
003DA7  2  60                   RTS
003DA8  2               
003DA8  2               ;----------------------------------------------------------------
003DA8  2               ; mon_spawn - create a monster.
003DA8  2               ;   IN: A=type, tgtx=x, tgty=y
003DA8  2               ;   Sets hp from the type table.  No-op if table full.
003DA8  2               ;----------------------------------------------------------------
003DA8  2               mon_spawn:
003DA8  2  85 20                STA     tmp0            ; type
003DAA  2  20 96 3D             JSR     mon_find_free
003DAD  2  90 17                BCC     @full
003DAF  2  A5 20                LDA     tmp0
003DB1  2  9D 91 52             STA     mon_type,X
003DB4  2  A5 2C                LDA     tgtx
003DB6  2  9D 9D 52             STA     mon_x,X
003DB9  2  A5 2D                LDA     tgty
003DBB  2  9D A9 52             STA     mon_y,X
003DBE  2  A4 20                LDY     tmp0
003DC0  2  B9 69 3D             LDA     mtype_hp,Y
003DC3  2  9D B5 52             STA     mon_hp,X
003DC6  2               @full:
003DC6  2  60                   RTS
003DC7  2               
003DC7  2               ;----------------------------------------------------------------
003DC7  2               ; mon_at - is there a live monster at (tgtx,tgty)?
003DC7  2               ;          Returns X = slot and C=1 if found, else C=0.
003DC7  2               ;----------------------------------------------------------------
003DC7  2               mon_at:
003DC7  2  A2 00                LDX     #0
003DC9  2               @a:
003DC9  2  BD 91 52             LDA     mon_type,X
003DCC  2  C9 00                CMP     #M_NONE
003DCE  2  F0 10                BEQ     @nextslot
003DD0  2  BD 9D 52             LDA     mon_x,X
003DD3  2  C5 2C                CMP     tgtx
003DD5  2  D0 09                BNE     @nextslot
003DD7  2  BD A9 52             LDA     mon_y,X
003DDA  2  C5 2D                CMP     tgty
003DDC  2  D0 02                BNE     @nextslot
003DDE  2  38                   SEC
003DDF  2  60                   RTS
003DE0  2               @nextslot:
003DE0  2  E8                   INX
003DE1  2  E0 0C                CPX     #MAXMON
003DE3  2  D0 E4                BNE     @a
003DE5  2  18                   CLC
003DE6  2  60                   RTS
003DE7  2               
003DE7  2               ;----------------------------------------------------------------
003DE7  2               ; mon_kill - remove monster in slot X.
003DE7  2               ;----------------------------------------------------------------
003DE7  2               mon_kill:
003DE7  2  A9 00                LDA     #M_NONE
003DE9  2  9D 91 52             STA     mon_type,X
003DEC  2  60                   RTS
003DED  2               
003DED  2               ;----------------------------------------------------------------
003DED  2               ; spawn_overworld_monsters - scatter a handful of monsters on the
003DED  2               ; overworld at random passable land tiles near the centre.
003DED  2               ;----------------------------------------------------------------
003DED  2               spawn_overworld_monsters:
003DED  2  20 89 3D             JSR     mon_clear_all
003DF0  2  A9 04                LDA     #4              ; only a few roaming monsters at a time
003DF2  2  85 24                STA     cnt0
003DF4  2               @loop:
003DF4  2               ; place in a ring roughly 6..21 tiles from the player: far
003DF4  2               ; enough not to crowd you, near enough to be encountered.
003DF4  2               ; offset = (rand(0..15) + 6), sign random per axis.
003DF4  2  A9 10                LDA     #16
003DF6  2  20 1B 0C             JSR     rng_mod
003DF9  2  18                   CLC
003DFA  2  69 06                ADC     #6              ; 6..21
003DFC  2  85 21                STA     tmp1            ; magnitude
003DFE  2  20 FB 0B             JSR     rng_next        ; random sign bit
003E01  2  29 01                AND     #1
003E03  2  F0 09                BEQ     @xplus
003E05  2  AD 6A 51             LDA     px
003E08  2  38                   SEC
003E09  2  E5 21                SBC     tmp1
003E0B  2  4C 14 3E             JMP     @setx
003E0E  2               @xplus:
003E0E  2  AD 6A 51             LDA     px
003E11  2  18                   CLC
003E12  2  65 21                ADC     tmp1
003E14  2               @setx:
003E14  2  85 2C                STA     tgtx
003E16  2  A9 10                LDA     #16
003E18  2  20 1B 0C             JSR     rng_mod
003E1B  2  18                   CLC
003E1C  2  69 06                ADC     #6
003E1E  2  85 21                STA     tmp1
003E20  2  20 FB 0B             JSR     rng_next
003E23  2  29 01                AND     #1
003E25  2  F0 09                BEQ     @yplus
003E27  2  AD 6B 51             LDA     py
003E2A  2  38                   SEC
003E2B  2  E5 21                SBC     tmp1
003E2D  2  4C 36 3E             JMP     @sety
003E30  2               @yplus:
003E30  2  AD 6B 51             LDA     py
003E33  2  18                   CLC
003E34  2  65 21                ADC     tmp1
003E36  2               @sety:
003E36  2  85 2D                STA     tgty
003E38  2               ; reject the player's own tile (don't spawn on top of you)
003E38  2  A5 2C                LDA     tgtx
003E3A  2  CD 6A 51             CMP     px
003E3D  2  D0 07                BNE     @okpos
003E3F  2  A5 2D                LDA     tgty
003E41  2  CD 6B 51             CMP     py
003E44  2  F0 20                BEQ     @skip
003E46  2               @okpos:
003E46  2               ; must be passable grass/forest (not water/mountain/town...)
003E46  2  20 53 1A             JSR     tileat
003E49  2  A6 2E                LDX     tgttile
003E4B  2  BD 0D 19             LDA     tile_prop,X
003E4E  2  29 01                AND     #P_PASS
003E50  2  F0 14                BEQ     @skip
003E52  2  BD 0D 19             LDA     tile_prop,X
003E55  2  29 8C                AND     #(P_TOWN|P_DUNG|P_CASTLE)
003E57  2  D0 0D                BNE     @skip           ; don't sit on a location entrance
003E59  2               ; not already occupied by a monster?
003E59  2  20 C7 3D             JSR     mon_at
003E5C  2  B0 08                BCS     @skip
003E5E  2               ; pick a random monster type 1..5
003E5E  2  A9 05                LDA     #5
003E60  2  20 2B 0C             JSR     rng_d           ; 1..5
003E63  2  20 A8 3D             JSR     mon_spawn
003E66  2               @skip:
003E66  2  C6 24                DEC     cnt0
003E68  2  D0 8A                BNE     @loop
003E6A  2  60                   RTS
003E6B  2               
003E6B  2               ;----------------------------------------------------------------
003E6B  2               ; spawn_dungeon_monsters - populate the three authored dungeon zones.
003E6B  2               ;----------------------------------------------------------------
003E6B  2               spawn_dungeon_monsters:
003E6B  2  20 89 3D             JSR     mon_clear_all
003E6E  2  A9 00                LDA     #BREATH_NONE
003E70  2  8D 7E 51             STA     boss_breath_dir
003E73  2               ; once slain, the dragon and its guards do not return
003E73  2  AD 7D 51             LDA     queststate
003E76  2  C9 04                CMP     #QUEST_DRAGON_DEAD
003E78  2  B0 34                BCS     @done
003E7A  2               ; the dragon waits in the open southern chamber
003E7A  2  A9 1B                LDA     #DRAGON_X
003E7C  2  85 2C                STA     tgtx
003E7E  2  A9 12                LDA     #DRAGON_Y
003E80  2  85 2D                STA     tgty
003E82  2  A9 06                LDA     #M_BOSS
003E84  2  20 A8 3D             JSR     mon_spawn
003E87  2               ; one authored guard in each approach zone
003E87  2  A9 09                LDA     #9
003E89  2  85 2C                STA     tgtx
003E8B  2  A9 05                LDA     #5
003E8D  2  85 2D                STA     tgty
003E8F  2  A9 03                LDA     #M_SKELETON
003E91  2  20 A8 3D             JSR     mon_spawn
003E94  2  A9 0E                LDA     #14
003E96  2  85 2C                STA     tgtx
003E98  2  A9 0B                LDA     #11
003E9A  2  85 2D                STA     tgty
003E9C  2  A9 04                LDA     #M_THIEF
003E9E  2  20 A8 3D             JSR     mon_spawn
003EA1  2  A9 17                LDA     #23
003EA3  2  85 2C                STA     tgtx
003EA5  2  A9 0F                LDA     #15
003EA7  2  85 2D                STA     tgty
003EA9  2  A9 05                LDA     #M_TROLL
003EAB  2  20 A8 3D             JSR     mon_spawn
003EAE  2               @done:
003EAE  2  60                   RTS
003EAF  2               
003EAF  2               ;----------------------------------------------------------------
003EAF  2               ; spawn_shrine_monsters - the Wyrm Warden appears only while the
003EAF  2               ; key quest is active. Once defeated, the shrine remains cleared.
003EAF  2               ;----------------------------------------------------------------
003EAF  2               spawn_shrine_monsters:
003EAF  2  20 89 3D             JSR     mon_clear_all
003EB2  2  AD 7D 51             LDA     queststate
003EB5  2  C9 01                CMP     #QUEST_FIND_KEY
003EB7  2  D0 0D                BNE     @done
003EB9  2  A9 1B                LDA     #WARDEN_X
003EBB  2  85 2C                STA     tgtx
003EBD  2  A9 11                LDA     #WARDEN_Y
003EBF  2  85 2D                STA     tgty
003EC1  2  A9 07                LDA     #M_WARDEN
003EC3  2  20 A8 3D             JSR     mon_spawn
003EC6  2               @done:
003EC6  2  60                   RTS
003EC7  2               
003EC7  2               ;----------------------------------------------------------------
003EC7  2               ; draw_monsters_vram - overlay all visible monsters in the viewport.
003EC7  2               ; Called by render_view while video is paged in.
003EC7  2               ;----------------------------------------------------------------
003EC7  2               draw_monsters_vram:
003EC7  2  A2 00                LDX     #0
003EC9  2  86 2F                STX     monidx
003ECB  2               @dm:
003ECB  2  A6 2F                LDX     monidx
003ECD  2  BD 91 52             LDA     mon_type,X
003ED0  2  C9 00                CMP     #M_NONE
003ED2  2  F0 1A                BEQ     @next
003ED4  2               ; set world coords + glyph/color, then plot if visible
003ED4  2  BD 9D 52             LDA     mon_x,X
003ED7  2  85 2C                STA     tgtx
003ED9  2  BD A9 52             LDA     mon_y,X
003EDC  2  85 2D                STA     tgty
003EDE  2  BC 91 52             LDY     mon_type,X
003EE1  2  B9 59 3D             LDA     mtype_glyph,Y
003EE4  2  85 24                STA     cnt0            ; glyph (cnt0/cnt1 survive rowbase)
003EE6  2  B9 61 3D             LDA     mtype_color,Y
003EE9  2  85 25                STA     cnt1            ; color
003EEB  2  20 4B 39             JSR     plot_view_cell
003EEE  2               @next:
003EEE  2  E6 2F                INC     monidx
003EF0  2  A5 2F                LDA     monidx
003EF2  2  C9 0C                CMP     #MAXMON
003EF4  2  D0 D5                BNE     @dm
003EF6  2  60                   RTS
003EF7  2               
003EF7  2               ;----------------------------------------------------------------
003EF7  2               ; draw_dragon_telegraph_vram - overlay the warned fire lane while
003EF7  2               ; the dragon is preparing a breath attack.
003EF7  2               ; Called by render_view while video is paged in.
003EF7  2               ;----------------------------------------------------------------
003EF7  2               draw_dragon_telegraph_vram:
003EF7  2  AD 77 51             LDA     loc
003EFA  2  C9 02                CMP     #LOC_DUNG
003EFC  2  D0 3B                BNE     @done
003EFE  2  AD 7E 51             LDA     boss_breath_dir
003F01  2  F0 36                BEQ     @done
003F03  2               ; find the live dragon
003F03  2  A2 00                LDX     #0
003F05  2               @find:
003F05  2  BD 91 52             LDA     mon_type,X
003F08  2  C9 06                CMP     #M_BOSS
003F0A  2  F0 06                BEQ     @found
003F0C  2  E8                   INX
003F0D  2  E0 0C                CPX     #MAXMON
003F0F  2  D0 F4                BNE     @find
003F11  2  60                   RTS
003F12  2               @found:
003F12  2  BD 9D 52             LDA     mon_x,X
003F15  2  85 2C                STA     tgtx
003F17  2  BD A9 52             LDA     mon_y,X
003F1A  2  85 2D                STA     tgty
003F1C  2               @lane:
003F1C  2  20 19 40             JSR     dragon_advance_target
003F1F  2  20 53 1A             JSR     tileat
003F22  2  A6 2E                LDX     tgttile
003F24  2  BD 0D 19             LDA     tile_prop,X
003F27  2  29 01                AND     #P_PASS
003F29  2  F0 0E                BEQ     @done
003F2B  2  A9 F4                LDA     #MG_BREATH
003F2D  2  85 24                STA     cnt0
003F2F  2  A9 4E                LDA     #C_BREATH
003F31  2  85 25                STA     cnt1
003F33  2  20 4B 39             JSR     plot_view_cell
003F36  2  4C 1C 3F             JMP     @lane
003F39  2               @done:
003F39  2  60                   RTS
003F3A  2               
003F3A  2               ;----------------------------------------------------------------
003F3A  2               ; mon_act - move/attack for every monster (called once per turn).
003F3A  2               ; Monsters in LOC_TOWN never act (towns are safe).
003F3A  2               ;   A monster adjacent to the player attacks; otherwise it steps
003F3A  2               ;   one tile toward the player if the destination is passable and
003F3A  2               ;   unoccupied.
003F3A  2               ;----------------------------------------------------------------
003F3A  2               mon_act:
003F3A  2  AD 77 51             LDA     loc
003F3D  2  C9 01                CMP     #LOC_TOWN
003F3F  2  F0 2C                BEQ     @ret            ; safe in town
003F41  2  A2 00                LDX     #0
003F43  2  86 2F                STX     monidx
003F45  2               @ma:
003F45  2  A6 2F                LDX     monidx
003F47  2  BD 91 52             LDA     mon_type,X
003F4A  2  C9 00                CMP     #M_NONE
003F4C  2  F0 17                BEQ     @next
003F4E  2  C9 07                CMP     #M_WARDEN
003F50  2  D0 06                BNE     @ckdragon
003F52  2  20 34 40             JSR     warden_act
003F55  2  4C 65 3F             JMP     @next
003F58  2               @ckdragon:
003F58  2  C9 06                CMP     #M_BOSS
003F5A  2  D0 06                BNE     @normal
003F5C  2  20 6E 3F             JSR     dragon_act
003F5F  2  4C 65 3F             JMP     @next
003F62  2               @normal:
003F62  2               ; distance to player: dxv = px - mon_x ; dyv = py - mon_y
003F62  2               ; adjacency test (|dx|<=1 && |dy|<=1 && not both 0)
003F62  2  20 6C 40             JSR     mon_step_or_attack
003F65  2               @next:
003F65  2  E6 2F                INC     monidx
003F67  2  A5 2F                LDA     monidx
003F69  2  C9 0C                CMP     #MAXMON
003F6B  2  D0 D8                BNE     @ma
003F6D  2               @ret:
003F6D  2  60                   RTS
003F6E  2               
003F6E  2               ;----------------------------------------------------------------
003F6E  2               ; dragon_act - breathe down a warned straight lane on the following
003F6E  2               ; turn, otherwise warn when the player is in clear line of sight.
003F6E  2               ; The dragon uses normal melee and pursuit when no breath is ready.
003F6E  2               ;----------------------------------------------------------------
003F6E  2               dragon_act:
003F6E  2  AD 7E 51             LDA     boss_breath_dir
003F71  2  F0 03                BEQ     @ready
003F73  2  4C CF 3F             JMP     dragon_fire_breath
003F76  2               @ready:
003F76  2  20 48 40             JSR     mon_is_adjacent
003F79  2  B0 05                BCS     @normal
003F7B  2  20 84 3F             JSR     dragon_prepare_breath
003F7E  2  B0 03                BCS     @done
003F80  2               @normal:
003F80  2  4C 6C 40             JMP     mon_step_or_attack
003F83  2               @done:
003F83  2  60                   RTS
003F84  2               
003F84  2               ; dragon_prepare_breath - arm a breath attack if the player and
003F84  2               ; dragon share a clear row or column. Returns C=1 when armed.
003F84  2               dragon_prepare_breath:
003F84  2  A6 2F                LDX     monidx
003F86  2  BD A9 52             LDA     mon_y,X
003F89  2  CD 6B 51             CMP     py
003F8C  2  D0 10                BNE     @vertical
003F8E  2               ; same row
003F8E  2  BD 9D 52             LDA     mon_x,X
003F91  2  CD 6A 51             CMP     px
003F94  2  90 04                BCC     @right
003F96  2  A9 03                LDA     #BREATH_LEFT
003F98  2  D0 1A                BNE     @armed
003F9A  2               @right:
003F9A  2  A9 04                LDA     #BREATH_RIGHT
003F9C  2  D0 16                BNE     @armed
003F9E  2               @vertical:
003F9E  2  BD 9D 52             LDA     mon_x,X
003FA1  2  CD 6A 51             CMP     px
003FA4  2  D0 27                BNE     @no
003FA6  2  BD A9 52             LDA     mon_y,X
003FA9  2  CD 6B 51             CMP     py
003FAC  2  90 04                BCC     @down
003FAE  2  A9 01                LDA     #BREATH_UP
003FB0  2  D0 02                BNE     @armed
003FB2  2               @down:
003FB2  2  A9 02                LDA     #BREATH_DOWN
003FB4  2               @armed:
003FB4  2  8D 7E 51             STA     boss_breath_dir
003FB7  2  20 EC 3F             JSR     dragon_line_hits_player
003FBA  2  90 0C                BCC     @blocked
003FBC  2  20 7B 0D             JSR     sfx_breath_warn
003FBF  2  A9 8C A0 47          PRINTMSG_MSG m_breath_warn
003FC3  2  20 F4 39     
003FC6  2  38                   SEC
003FC7  2  60                   RTS
003FC8  2               @blocked:
003FC8  2  A9 00                LDA     #BREATH_NONE
003FCA  2  8D 7E 51             STA     boss_breath_dir
003FCD  2               @no:
003FCD  2  18                   CLC
003FCE  2  60                   RTS
003FCF  2               
003FCF  2               ; dragon_fire_breath - resolve the prepared lane after the player
003FCF  2               ; has had one turn to step clear.
003FCF  2               dragon_fire_breath:
003FCF  2  20 EC 3F             JSR     dragon_line_hits_player
003FD2  2  90 08                BCC     @miss
003FD4  2  A9 00                LDA     #BREATH_NONE
003FD6  2  8D 7E 51             STA     boss_breath_dir
003FD9  2  4C 3F 45             JMP     dragon_fire_player
003FDC  2               @miss:
003FDC  2  A9 00                LDA     #BREATH_NONE
003FDE  2  8D 7E 51             STA     boss_breath_dir
003FE1  2  20 A6 0D             JSR     sfx_breath
003FE4  2  A9 C2 A0 47          PRINTMSG_MSG m_breath_miss
003FE8  2  20 F4 39     
003FEB  2  60                   RTS
003FEC  2               
003FEC  2               ; dragon_line_hits_player - trace the prepared lane from the dragon
003FEC  2               ; until blocked. Returns C=1 if the player is currently in it.
003FEC  2               dragon_line_hits_player:
003FEC  2  A6 2F                LDX     monidx
003FEE  2  BD 9D 52             LDA     mon_x,X
003FF1  2  85 2C                STA     tgtx
003FF3  2  BD A9 52             LDA     mon_y,X
003FF6  2  85 2D                STA     tgty
003FF8  2               @trace:
003FF8  2  20 19 40             JSR     dragon_advance_target
003FFB  2  20 53 1A             JSR     tileat
003FFE  2  A6 2E                LDX     tgttile
004000  2  BD 0D 19             LDA     tile_prop,X
004003  2  29 01                AND     #P_PASS
004005  2  F0 10                BEQ     @no
004007  2  A5 2C                LDA     tgtx
004009  2  CD 6A 51             CMP     px
00400C  2  D0 EA                BNE     @trace
00400E  2  A5 2D                LDA     tgty
004010  2  CD 6B 51             CMP     py
004013  2  D0 E3                BNE     @trace
004015  2  38                   SEC
004016  2  60                   RTS
004017  2               @no:
004017  2  18                   CLC
004018  2  60                   RTS
004019  2               
004019  2               ; dragon_advance_target - move tgtx/tgty one cell in the prepared
004019  2               ; breath direction.
004019  2               dragon_advance_target:
004019  2  AD 7E 51             LDA     boss_breath_dir
00401C  2  C9 01                CMP     #BREATH_UP
00401E  2  F0 0B                BEQ     @up
004020  2  C9 02                CMP     #BREATH_DOWN
004022  2  F0 0A                BEQ     @down
004024  2  C9 03                CMP     #BREATH_LEFT
004026  2  F0 09                BEQ     @left
004028  2  E6 2C                INC     tgtx
00402A  2  60                   RTS
00402B  2               @up:
00402B  2  C6 2D                DEC     tgty
00402D  2  60                   RTS
00402E  2               @down:
00402E  2  E6 2D                INC     tgty
004030  2  60                   RTS
004031  2               @left:
004031  2  C6 2C                DEC     tgtx
004033  2  60                   RTS
004034  2               
004034  2               ;----------------------------------------------------------------
004034  2               ; warden_act - the Wyrm Warden surges up to two tiles per turn.
004034  2               ; It stops after closing to melee range, so it attacks at most once
004034  2               ; per turn while remaining much harder to outrun than normal foes.
004034  2               ;----------------------------------------------------------------
004034  2               warden_act:
004034  2  20 48 40             JSR     mon_is_adjacent
004037  2  B0 0B                BCS     @attack
004039  2  20 6C 40             JSR     mon_step_or_attack
00403C  2  20 48 40             JSR     mon_is_adjacent
00403F  2  B0 06                BCS     @done
004041  2  4C 6C 40             JMP     mon_step_or_attack
004044  2               @attack:
004044  2  4C 6C 40             JMP     mon_step_or_attack
004047  2               @done:
004047  2  60                   RTS
004048  2               
004048  2               ; mon_is_adjacent - C=1 if monster in monidx is beside the player.
004048  2               mon_is_adjacent:
004048  2  A6 2F                LDX     monidx
00404A  2  38                   SEC
00404B  2  AD 6A 51             LDA     px
00404E  2  FD 9D 52             SBC     mon_x,X
004051  2  20 FF 40             JSR     abs_a
004054  2  C9 02                CMP     #2
004056  2  B0 12                BCS     @no
004058  2  A6 2F                LDX     monidx
00405A  2  38                   SEC
00405B  2  AD 6B 51             LDA     py
00405E  2  FD A9 52             SBC     mon_y,X
004061  2  20 FF 40             JSR     abs_a
004064  2  C9 02                CMP     #2
004066  2  B0 02                BCS     @no
004068  2  38                   SEC
004069  2  60                   RTS
00406A  2               @no:
00406A  2  18                   CLC
00406B  2  60                   RTS
00406C  2               
00406C  2               ; mon_step_or_attack - for monster in slot monidx (X on entry).
00406C  2               mon_step_or_attack:
00406C  2               ; compute signed dx = px - mon_x  -> tmp0 ; dy -> tmp1
00406C  2  A6 2F                LDX     monidx
00406E  2  38                   SEC
00406F  2  AD 6A 51             LDA     px
004072  2  FD 9D 52             SBC     mon_x,X
004075  2  85 20                STA     tmp0            ; dx (signed)
004077  2  38                   SEC
004078  2  AD 6B 51             LDA     py
00407B  2  FD A9 52             SBC     mon_y,X
00407E  2  85 21                STA     tmp1            ; dy (signed)
004080  2               ; |dx| <= 1 ?
004080  2  A5 20                LDA     tmp0
004082  2  20 FF 40             JSR     abs_a
004085  2  85 22                STA     tmp2            ; |dx|
004087  2  A5 21                LDA     tmp1
004089  2  20 FF 40             JSR     abs_a
00408C  2  85 23                STA     tmp3            ; |dy|
00408E  2               ; adjacency: |dx|<=1 and |dy|<=1
00408E  2  A5 22                LDA     tmp2
004090  2  C9 02                CMP     #2
004092  2  B0 09                BCS     @move
004094  2  A5 23                LDA     tmp3
004096  2  C9 02                CMP     #2
004098  2  B0 03                BCS     @move
00409A  2               ; adjacent (and since one of them is the player, not same cell)
00409A  2               ; -> attack the player
00409A  2  4C E2 44             JMP     monster_attacks_player; in combat.asm
00409D  2               @move:
00409D  2               ; step one tile toward player along the larger axis
00409D  2               ; choose step in x: sign of dx
00409D  2  A6 2F                LDX     monidx
00409F  2  BD 9D 52             LDA     mon_x,X
0040A2  2  85 2C                STA     tgtx
0040A4  2  BD A9 52             LDA     mon_y,X
0040A7  2  85 2D                STA     tgty
0040A9  2               ; prefer horizontal if |dx|>=|dy|
0040A9  2  A5 22                LDA     tmp2
0040AB  2  C5 23                CMP     tmp3
0040AD  2  90 10                BCC     @vert
0040AF  2               ; horizontal step
0040AF  2  A5 20                LDA     tmp0
0040B1  2  F0 0C                BEQ     @vert           ; dx==0 -> try vertical
0040B3  2  30 05                BMI     @left
0040B5  2  E6 2C                INC     tgtx
0040B7  2  4C CC 40             JMP     @trymove
0040BA  2               @left:
0040BA  2  C6 2C                DEC     tgtx
0040BC  2  4C CC 40             JMP     @trymove
0040BF  2               @vert:
0040BF  2  A5 21                LDA     tmp1
0040C1  2  F0 3B                BEQ     @done           ; dy==0 too -> no move
0040C3  2  30 05                BMI     @up
0040C5  2  E6 2D                INC     tgty
0040C7  2  4C CC 40             JMP     @trymove
0040CA  2               @up:
0040CA  2  C6 2D                DEC     tgty
0040CC  2               @trymove:
0040CC  2               ; passable terrain?
0040CC  2  20 53 1A             JSR     tileat
0040CF  2  A6 2E                LDX     tgttile
0040D1  2  BD 0D 19             LDA     tile_prop,X
0040D4  2  29 01                AND     #P_PASS
0040D6  2  F0 26                BEQ     @done           ; blocked terrain
0040D8  2               ; monsters do not occupy map-transition landmarks
0040D8  2  BD 0D 19             LDA     tile_prop,X
0040DB  2  29 8C                AND     #(P_TOWN|P_DUNG|P_CASTLE)
0040DD  2  D0 1F                BNE     @done
0040DF  2               ; not onto the player?
0040DF  2  A5 2C                LDA     tgtx
0040E1  2  CD 6A 51             CMP     px
0040E4  2  D0 07                BNE     @okcell
0040E6  2  A5 2D                LDA     tgty
0040E8  2  CD 6B 51             CMP     py
0040EB  2  F0 11                BEQ     @done           ; would land on player (shouldn't: adjacency handled)
0040ED  2               @okcell:
0040ED  2               ; not onto another monster?
0040ED  2  20 C7 3D             JSR     mon_at
0040F0  2  B0 0C                BCS     @done           ; occupied
0040F2  2               ; commit move
0040F2  2  A6 2F                LDX     monidx
0040F4  2  A5 2C                LDA     tgtx
0040F6  2  9D 9D 52             STA     mon_x,X
0040F9  2  A5 2D                LDA     tgty
0040FB  2  9D A9 52             STA     mon_y,X
0040FE  2               @done:
0040FE  2  60                   RTS
0040FF  2               
0040FF  2               ;----------------------------------------------------------------
0040FF  2               ; abs_a - A = |A| treating A as signed 8-bit.
0040FF  2               ;----------------------------------------------------------------
0040FF  2               abs_a:
0040FF  2  C9 80                CMP     #$80
004101  2  90 05                BCC     @pos
004103  2  49 FF                EOR     #$FF
004105  2  18                   CLC
004106  2  69 01                ADC     #1
004108  2               @pos:
004108  2  60                   RTS
004109  2               
004109  1                       .INCLUDE "player.asm"
004109  2               ;______________________________________________________________________________
004109  2               ;  player.asm - player movement, map transitions, treasure
004109  2               ;______________________________________________________________________________
004109  2               
004109  2               ;----------------------------------------------------------------
004109  2               ; Player starting state on the overworld.
004109  2               ;----------------------------------------------------------------
004109  2               PLAYER_START_X  = 20
004109  2               PLAYER_START_Y  = 9
004109  2               
004109  2               player_init:
004109  2  A9 14                LDA     #PLAYER_START_X
00410B  2  8D 6A 51             STA     px
00410E  2  A9 09                LDA     #PLAYER_START_Y
004110  2  8D 6B 51             STA     py
004113  2  A9 1E                LDA     #30
004115  2  8D 6C 51             STA     phealth
004118  2  8D 6D 51             STA     pmaxhp
00411B  2  A9 01                LDA     #1
00411D  2  8D 6E 51             STA     plevel
004120  2  A9 00                LDA     #0
004122  2  8D 6F 51             STA     pxp
004125  2  8D 70 51             STA     pxp+1
004128  2  A9 32                LDA     #50
00412A  2  8D 71 51             STA     pgold
00412D  2  A9 00                LDA     #0
00412F  2  8D 72 51             STA     pgold+1
004132  2  A9 FA 8D 73          SETW16  pfood, 250
004136  2  51 A9 00 8D  
00413A  2  74 51        
00413C  2  A9 01                LDA     #1
00413E  2  8D 75 51             STA     pweapon         ; dagger
004141  2  A9 00                LDA     #0
004143  2  8D 76 51             STA     parmor          ; clothes
004146  2  A9 00                LDA     #LOC_WORLD
004148  2  8D 77 51             STA     loc
00414B  2  A9 00                LDA     #0
00414D  2  8D 7C 51             STA     bosskilled
004150  2  8D 7D 51             STA     queststate
004153  2  8D 7E 51             STA     boss_breath_dir
004156  2  60                   RTS
004157  2               
004157  2               ;----------------------------------------------------------------
004157  2               ; try_move - attempt to move the player by (dx,dy).
004157  2               ;   IN: dx, dy = signed -1/0/+1 deltas
004157  2               ;   Effects: combat on bump, terrain block, town/dungeon entry,
004157  2               ;   treasure pickup, exit interiors, food cost.  Monsters act after
004157  2               ;   a successful step (handled by caller via did_move flag).
004157  2               ;   OUT: did_move (game var) = 1 if a turn was consumed.
004157  2               ;----------------------------------------------------------------
004157  2               try_move:
004157  2  A9 00                LDA     #0
004159  2  8D 7F 51             STA     did_move
00415C  2               ; target = (px+dx, py+dy)
00415C  2  18                   CLC
00415D  2  AD 6A 51             LDA     px
004160  2  65 2A                ADC     dx
004162  2  85 2C                STA     tgtx
004164  2  18                   CLC
004165  2  AD 6B 51             LDA     py
004168  2  65 2B                ADC     dy
00416A  2  85 2D                STA     tgty
00416C  2               
00416C  2               ; monster there? -> attack (consumes the turn)
00416C  2  20 C7 3D             JSR     mon_at
00416F  2  90 09                BCC     @noenemy
004171  2               ; X = monster slot ; resolve combat
004171  2  20 C2 43             JSR     player_attacks_monster
004174  2  A9 01                LDA     #1
004176  2  8D 7F 51             STA     did_move
004179  2  60                   RTS
00417A  2               @noenemy:
00417A  2               ; look at the terrain
00417A  2  20 53 1A             JSR     tileat          ; -> tgttile
00417D  2  A6 2E                LDX     tgttile
00417F  2  BD 0D 19             LDA     tile_prop,X
004182  2  85 20                STA     tmp0            ; property bits
004184  2  29 01                AND     #P_PASS
004186  2  D0 0B                BNE     @passable
004188  2               ; blocked
004188  2  20 33 0D             JSR     sfx_blocked
00418B  2  A9 20 A0 46          PRINTMSG_MSG m_blocked
00418F  2  20 F4 39     
004192  2  60                   RTS                     ; no turn consumed on a wall bump
004193  2               @passable:
004193  2               ; check special tiles
004193  2  A5 20                LDA     tmp0
004195  2  29 04                AND     #P_TOWN
004197  2  F0 03                BEQ     @ck_castle
004199  2  4C 10 42             JMP     enter_town
00419C  2               @ck_castle:
00419C  2  A5 20                LDA     tmp0
00419E  2  29 80                AND     #P_CASTLE
0041A0  2  F0 03                BEQ     @ck_dung
0041A2  2  4C 4B 42             JMP     enter_castle
0041A5  2               @ck_dung:
0041A5  2  A5 20                LDA     tmp0
0041A7  2  29 08                AND     #P_DUNG
0041A9  2  F0 03                BEQ     @ck_exit
0041AB  2  4C 86 42             JMP     enter_dungeon
0041AE  2               @ck_exit:
0041AE  2  A5 20                LDA     tmp0
0041B0  2  29 10                AND     #P_EXIT
0041B2  2  F0 03                BEQ     @ck_treas
0041B4  2  4C 0A 43             JMP     leave_interior
0041B7  2               @ck_treas:
0041B7  2               ; commit the move first
0041B7  2  A5 2C                LDA     tgtx
0041B9  2  8D 6A 51             STA     px
0041BC  2  A5 2D                LDA     tgty
0041BE  2  8D 6B 51             STA     py
0041C1  2  A9 01                LDA     #1
0041C3  2  8D 7F 51             STA     did_move
0041C6  2               ; treasure?
0041C6  2  A5 20                LDA     tmp0
0041C8  2  29 20                AND     #P_TREAS
0041CA  2  F0 03                BEQ     @food
0041CC  2  20 E9 41             JSR     collect_treasure
0041CF  2               @food:
0041CF  2               ; consume a unit of food per step
0041CF  2  AD 73 51             LDA     pfood
0041D2  2  0D 74 51             ORA     pfood+1
0041D5  2  F0 11                BEQ     @nofood
0041D7  2  38                   SEC
0041D8  2  AD 73 51             LDA     pfood
0041DB  2  E9 01                SBC     #1
0041DD  2  8D 73 51             STA     pfood
0041E0  2  AD 74 51             LDA     pfood+1
0041E3  2  E9 00                SBC     #0
0041E5  2  8D 74 51             STA     pfood+1
0041E8  2               @nofood:
0041E8  2  60                   RTS
0041E9  2               
0041E9  2               ;----------------------------------------------------------------
0041E9  2               ; collect_treasure - pick up a chest at (tgtx,tgty): gold + maybe
0041E9  2               ; XP, then clear the tile to floor.
0041E9  2               ;----------------------------------------------------------------
0041E9  2               collect_treasure:
0041E9  2               ; gold 5..20
0041E9  2  A9 10                LDA     #16
0041EB  2  20 2B 0C             JSR     rng_d
0041EE  2  18                   CLC
0041EF  2  69 04                ADC     #4
0041F1  2               ; add to gold (16-bit)
0041F1  2  18                   CLC
0041F2  2  6D 71 51             ADC     pgold
0041F5  2  8D 71 51             STA     pgold
0041F8  2  AD 72 51             LDA     pgold+1
0041FB  2  69 00                ADC     #0
0041FD  2  8D 72 51             STA     pgold+1
004200  2               ; clear the chest tile -> floor
004200  2  A9 09                LDA     #T_FLOOR
004202  2  20 FA 1A             JSR     settile
004205  2  20 F3 0D             JSR     sfx_treasure
004208  2  A9 29 A0 46          PRINTMSG_MSG m_treasure
00420C  2  20 F4 39     
00420F  2  60                   RTS
004210  2               
004210  2               ;----------------------------------------------------------------
004210  2               ; enter_town - switch to the town interior map.
004210  2               ;----------------------------------------------------------------
004210  2               enter_town:
004210  2  20 61 0E             JSR     sfx_door
004213  2  20 D7 19             JSR     decode_town
004216  2  A9 01                LDA     #LOC_TOWN
004218  2  8D 77 51             STA     loc
00421B  2  A9 20                LDA     #TOWNW
00421D  2  8D 78 51             STA     locw
004220  2  A9 14                LDA     #TOWNH
004222  2  8D 79 51             STA     loch
004225  2               ; remember overworld position to restore on exit
004225  2  AD 6A 51             LDA     px
004228  2  8D 7A 51             STA     owretx
00422B  2  AD 6B 51             LDA     py
00422E  2  8D 7B 51             STA     owrety
004231  2               ; place player just inside, one tile NORTH of the door so the
004231  2               ; exit '+' is visible directly south of the player on entry.
004231  2  A9 0E                LDA     #14
004233  2  8D 6A 51             STA     px
004236  2  A9 11                LDA     #TOWNH-3
004238  2  8D 6B 51             STA     py
00423B  2               ; towns have no monsters
00423B  2  20 89 3D             JSR     mon_clear_all
00423E  2  A9 01                LDA     #1
004240  2  8D 7F 51             STA     did_move
004243  2  A9 44 A0 46          PRINTMSG_MSG m_town
004247  2  20 F4 39     
00424A  2  60                   RTS
00424B  2               
00424B  2               ;----------------------------------------------------------------
00424B  2               ; enter_castle - switch to Wyrmhold Castle's audience chamber.
00424B  2               ;----------------------------------------------------------------
00424B  2               enter_castle:
00424B  2  20 61 0E             JSR     sfx_door
00424E  2  20 15 1A             JSR     decode_castle
004251  2  A9 03                LDA     #LOC_CASTLE
004253  2  8D 77 51             STA     loc
004256  2  A9 20                LDA     #CASTLEW
004258  2  8D 78 51             STA     locw
00425B  2  A9 14                LDA     #CASTLEH
00425D  2  8D 79 51             STA     loch
004260  2  AD 6A 51             LDA     px
004263  2  8D 7A 51             STA     owretx
004266  2  AD 6B 51             LDA     py
004269  2  8D 7B 51             STA     owrety
00426C  2               ; enter on the carpet, immediately north of the exit
00426C  2  A9 0F                LDA     #15
00426E  2  8D 6A 51             STA     px
004271  2  A9 11                LDA     #CASTLEH-3
004273  2  8D 6B 51             STA     py
004276  2  20 89 3D             JSR     mon_clear_all
004279  2  A9 01                LDA     #1
00427B  2  8D 7F 51             STA     did_move
00427E  2  A9 F2 A0 4C          PRINTMSG_MSG m_castle
004282  2  20 F4 39     
004285  2  60                   RTS
004286  2               
004286  2               ;----------------------------------------------------------------
004286  2               ; enter_dungeon - dispatch cave landmarks. The southern-marsh cave
004286  2               ; is the Sunken Shrine; the dragon's lair stays sealed until the
004286  2               ; Wyrm Key has been returned to King Aldren.
004286  2               ;----------------------------------------------------------------
004286  2               enter_dungeon:
004286  2  A5 2C                LDA     tgtx
004288  2  C9 14                CMP     #KEY_SITE_X
00428A  2  D0 1B                BNE     @dragon
00428C  2  A5 2D                LDA     tgty
00428E  2  C9 3A                CMP     #KEY_SITE_Y
004290  2  D0 15                BNE     @dragon
004292  2  AD 7D 51             LDA     queststate
004295  2  C9 01                CMP     #QUEST_FIND_KEY
004297  2  90 03                BCC     @shrine_dormant
004299  2  4C 5F 4F             JMP     enter_shrine
00429C  2               @shrine_dormant:
00429C  2  20 33 0D             JSR     sfx_blocked
00429F  2  A9 CE A0 4F          PRINTMSG_MSG m_shrine_dormant
0042A3  2  20 F4 39     
0042A6  2  60                   RTS
0042A7  2               @dragon:
0042A7  2  AD 7D 51             LDA     queststate
0042AA  2  C9 03                CMP     #QUEST_DUNG_OPEN
0042AC  2  B0 0B                BCS     @enter
0042AE  2  20 33 0D             JSR     sfx_blocked
0042B1  2  A9 14 A0 50          PRINTMSG_MSG m_dung_sealed
0042B5  2  20 F4 39     
0042B8  2  60                   RTS
0042B9  2               @enter:
0042B9  2  20 61 0E             JSR     sfx_door
0042BC  2  20 F6 19             JSR     decode_dung
0042BF  2  A9 02                LDA     #LOC_DUNG
0042C1  2  8D 77 51             STA     loc
0042C4  2  A9 20                LDA     #DUNGW
0042C6  2  8D 78 51             STA     locw
0042C9  2  A9 14                LDA     #DUNGH
0042CB  2  8D 79 51             STA     loch
0042CE  2  AD 6A 51             LDA     px
0042D1  2  8D 7A 51             STA     owretx
0042D4  2  AD 6B 51             LDA     py
0042D7  2  8D 7B 51             STA     owrety
0042DA  2               ; start just east of the stairs-up '<' (at 1,1) so the exit
0042DA  2               ; is visible immediately to the west of the player.
0042DA  2  A9 02                LDA     #2
0042DC  2  8D 6A 51             STA     px
0042DF  2  A9 01                LDA     #1
0042E1  2  8D 6B 51             STA     py
0042E4  2  20 6B 3E             JSR     spawn_dungeon_monsters
0042E7  2  A9 01                LDA     #1
0042E9  2  8D 7F 51             STA     did_move
0042EC  2  AD 7D 51             LDA     queststate
0042EF  2  C9 04                CMP     #QUEST_DRAGON_DEAD
0042F1  2  B0 0F                BCS     @silent_lair
0042F3  2  A9 83 A0 46          PRINTMSG_MSG m_dungeon
0042F7  2  20 F4 39     
0042FA  2  A9 C0 A0 46          PRINTMSG_MSG m_dragon_wakes
0042FE  2  20 F4 39     
004301  2  60                   RTS
004302  2               @silent_lair:
004302  2  A9 F0 A0 46          PRINTMSG_MSG m_dungeon_empty
004306  2  20 F4 39     
004309  2  60                   RTS
00430A  2               
00430A  2               ;----------------------------------------------------------------
00430A  2               ; leave_interior - return to the overworld at the saved position.
00430A  2               ;----------------------------------------------------------------
00430A  2               leave_interior:
00430A  2  20 61 0E             JSR     sfx_door
00430D  2  A9 00                LDA     #BREATH_NONE
00430F  2  8D 7E 51             STA     boss_breath_dir
004312  2  20 B8 19             JSR     decode_world
004315  2  A9 00                LDA     #LOC_WORLD
004317  2  8D 77 51             STA     loc
00431A  2  AD 7A 51             LDA     owretx
00431D  2  8D 6A 51             STA     px
004320  2  AD 7B 51             LDA     owrety
004323  2  8D 6B 51             STA     py
004326  2  20 ED 3D             JSR     spawn_overworld_monsters
004329  2  A9 01                LDA     #1
00432B  2  8D 7F 51             STA     did_move
00432E  2  A9 2C A0 47          PRINTMSG_MSG m_world
004332  2  20 F4 39     
004335  2  60                   RTS
004336  2               
004336  1                       .INCLUDE "combat.asm"
004336  2               ;______________________________________________________________________________
004336  2               ;  combat.asm - bump combat resolution, leveling, message builder
004336  2               ;______________________________________________________________________________
004336  2               
004336  2               ;----------------------------------------------------------------
004336  2               ; Message builder.  Compose a line in mbuf then push to the log.
004336  2               ;   mb_reset            - start a new line
004336  2               ;   mb_str  (A=lo,Y=hi) - append a 0-terminated string
004336  2               ;   mb_num  (A=byte)    - append a 0..255 value in decimal
004336  2               ;   mb_mname(A=type)    - append a monster type name
004336  2               ;   mb_flush            - push mbuf into the scrolling log
004336  2               ;----------------------------------------------------------------
004336  2               mb_reset:
004336  2  A9 00                LDA     #0
004338  2  8D 90 52             STA     mblen
00433B  2  60                   RTS
00433C  2               
00433C  2               mb_str:
00433C  2  85 1C                STA     strp
00433E  2  84 1D                STY     strp+1
004340  2  A0 00                LDY     #0
004342  2               @s:
004342  2  B1 1C                LDA     (strp),Y
004344  2  F0 0C                BEQ     @done
004346  2  AE 90 52             LDX     mblen
004349  2  9D 30 52             STA     mbuf,X
00434C  2  EE 90 52             INC     mblen
00434F  2  C8                   INY
004350  2  D0 F0                BNE     @s
004352  2               @done:
004352  2  60                   RTS
004353  2               
004353  2               ; append A (0..255) as decimal
004353  2               mb_num:
004353  2  85 1E                STA     numarg
004355  2  A9 00                LDA     #0
004357  2  85 1F                STA     numarg+1
004359  2               mb_num16:
004359  2               ; find highest place
004359  2  A0 08                LDY     #8
00435B  2               @find:
00435B  2  A5 1F                LDA     numarg+1
00435D  2  D9 E2 39             CMP     nums+1,Y
004360  2  90 09                BCC     @nx
004362  2  D0 0B                BNE     @start
004364  2  A5 1E                LDA     numarg
004366  2  D9 E1 39             CMP     nums,Y
004369  2  B0 04                BCS     @start
00436B  2               @nx:
00436B  2  88                   DEY
00436C  2  88                   DEY
00436D  2  D0 EC                BNE     @find
00436F  2               @start:
00436F  2  A9 30                LDA     #'0'
004371  2  85 28                STA     numspace
004373  2               @dig:
004373  2  A5 1F                LDA     numarg+1
004375  2  D9 E2 39             CMP     nums+1,Y
004378  2  90 1E                BCC     @out
00437A  2  D0 09                BNE     @noc
00437C  2  A5 1E                LDA     numarg
00437E  2  F9 E1 39             SBC     nums,Y
004381  2  90 15                BCC     @out
004383  2  B0 05                BCS     @sub
004385  2               @noc:
004385  2  A5 1E                LDA     numarg
004387  2  F9 E1 39             SBC     nums,Y
00438A  2               @sub:
00438A  2  E6 28                INC     numspace
00438C  2  85 1E                STA     numarg
00438E  2  A5 1F                LDA     numarg+1
004390  2  F9 E2 39             SBC     nums+1,Y
004393  2  85 1F                STA     numarg+1
004395  2  4C 73 43             JMP     @dig
004398  2               @out:
004398  2  A5 28                LDA     numspace
00439A  2  AE 90 52             LDX     mblen
00439D  2  9D 30 52             STA     mbuf,X
0043A0  2  EE 90 52             INC     mblen
0043A3  2  88                   DEY
0043A4  2  88                   DEY
0043A5  2  10 C8                BPL     @start
0043A7  2  60                   RTS
0043A8  2               
0043A8  2               ; append a monster type name (A = type id)
0043A8  2               mb_mname:
0043A8  2  0A                   ASL     A
0043A9  2  AA                   TAX
0043AA  2  BD 7B 45             LDA     mon_names,X
0043AD  2  BC 7C 45             LDY     mon_names+1,X
0043B0  2  4C 3C 43             JMP     mb_str
0043B3  2               
0043B3  2               mb_flush:
0043B3  2  AE 90 52             LDX     mblen
0043B6  2  A9 00                LDA     #0
0043B8  2  9D 30 52             STA     mbuf,X          ; NUL terminate
0043BB  2  A9 30                LDA     #<mbuf
0043BD  2  A0 52                LDY     #>mbuf
0043BF  2  4C F4 39             JMP     msg_print
0043C2  2               
0043C2  2               ;----------------------------------------------------------------
0043C2  2               ; player_attacks_monster - X = monster slot.
0043C2  2               ;   Damage = 1..(weapon_power) + small bonus.  Apply, possibly kill.
0043C2  2               ;----------------------------------------------------------------
0043C2  2               player_attacks_monster:
0043C2  2  86 2F                STX     monidx
0043C4  2               ; damage roll: base from weapon
0043C4  2  AE 75 51             LDX     pweapon
0043C7  2  BD 73 45             LDA     wpn_power,X
0043CA  2  20 2B 0C             JSR     rng_d           ; 1..power
0043CD  2  85 20                STA     tmp0            ; damage
0043CF  2               ; subtract from monster hp
0043CF  2  A6 2F                LDX     monidx
0043D1  2  38                   SEC
0043D2  2  BD B5 52             LDA     mon_hp,X
0043D5  2  E5 20                SBC     tmp0
0043D7  2  9D B5 52             STA     mon_hp,X
0043DA  2               ; build "You hit the Orc for N!"
0043DA  2  20 36 43             JSR     mb_reset
0043DD  2  A9 C3                LDA     #<c_youhit
0043DF  2  A0 45                LDY     #>c_youhit
0043E1  2  20 3C 43             JSR     mb_str
0043E4  2  A6 2F                LDX     monidx
0043E6  2  BD 91 52             LDA     mon_type,X
0043E9  2  20 A8 43             JSR     mb_mname
0043EC  2  A9 D0                LDA     #<c_for
0043EE  2  A0 45                LDY     #>c_for
0043F0  2  20 3C 43             JSR     mb_str
0043F3  2  A5 20                LDA     tmp0
0043F5  2  20 53 43             JSR     mb_num
0043F8  2  A9 D6                LDA     #<c_bang
0043FA  2  A0 45                LDY     #>c_bang
0043FC  2  20 3C 43             JSR     mb_str
0043FF  2  20 B3 43             JSR     mb_flush
004402  2  20 50 0D             JSR     sfx_hit
004405  2               ; dead?  (hp <= 0 i.e. hp was <= damage -> result negative/zero)
004405  2  A6 2F                LDX     monidx
004407  2  BD B5 52             LDA     mon_hp,X
00440A  2  F0 03                BEQ     @dead
00440C  2  30 01                BMI     @dead
00440E  2  60                   RTS
00440F  2               @dead:
00440F  2  4C 12 44             JMP     monster_dies
004412  2               
004412  2               ;----------------------------------------------------------------
004412  2               ; monster_dies - award XP/gold, drop the slot, maybe win, maybe
004412  2               ; level up.  Slot in monidx.
004412  2               ;----------------------------------------------------------------
004412  2               monster_dies:
004412  2  A6 2F                LDX     monidx
004414  2  BD 91 52             LDA     mon_type,X
004417  2  85 21                STA     tmp1            ; type
004419  2               ; XP
004419  2  A8                   TAY
00441A  2  B9 79 3D             LDA     mtype_xp,Y
00441D  2  18                   CLC
00441E  2  6D 6F 51             ADC     pxp
004421  2  8D 6F 51             STA     pxp
004424  2  AD 70 51             LDA     pxp+1
004427  2  69 00                ADC     #0
004429  2  8D 70 51             STA     pxp+1
00442C  2               ; gold drop 0..mtype_gold
00442C  2  A4 21                LDY     tmp1
00442E  2  B9 81 3D             LDA     mtype_gold,Y
004431  2  F0 12                BEQ     @nogold
004433  2  20 1B 0C             JSR     rng_mod         ; 0..gold-1
004436  2  18                   CLC
004437  2  6D 71 51             ADC     pgold
00443A  2  8D 71 51             STA     pgold
00443D  2  AD 72 51             LDA     pgold+1
004440  2  69 00                ADC     #0
004442  2  8D 72 51             STA     pgold+1
004445  2               @nogold:
004445  2               ; message "The Orc dies!"
004445  2  20 36 43             JSR     mb_reset
004448  2  A9 D8                LDA     #<c_the
00444A  2  A0 45                LDY     #>c_the
00444C  2  20 3C 43             JSR     mb_str
00444F  2  A5 21                LDA     tmp1
004451  2  20 A8 43             JSR     mb_mname
004454  2  A9 DD                LDA     #<c_dies
004456  2  A0 45                LDY     #>c_dies
004458  2  20 3C 43             JSR     mb_str
00445B  2  20 B3 43             JSR     mb_flush
00445E  2  20 D6 0D             JSR     sfx_killed
004461  2               ; remove monster
004461  2  A6 2F                LDX     monidx
004463  2  20 E7 3D             JSR     mon_kill
004466  2               ; quest miniboss?
004466  2  A5 21                LDA     tmp1
004468  2  C9 07                CMP     #M_WARDEN
00446A  2  D0 06                BNE     @boss
00446C  2  20 B0 4F             JSR     award_wyrm_key
00446F  2  4C 89 44             JMP     @lvl
004472  2               ; final boss?
004472  2               @boss:
004472  2  A5 21                LDA     tmp1
004474  2  C9 06                CMP     #M_BOSS
004476  2  D0 11                BNE     @lvl
004478  2  A9 00                LDA     #BREATH_NONE
00447A  2  8D 7E 51             STA     boss_breath_dir
00447D  2  A9 04                LDA     #QUEST_DRAGON_DEAD
00447F  2  8D 7D 51             STA     queststate
004482  2  A9 50 A0 47          PRINTMSG_MSG m_dragon_fallen
004486  2  20 F4 39     
004489  2               @lvl:
004489  2  20 8D 44             JSR     check_levelup
00448C  2  60                   RTS
00448D  2               
00448D  2               ;----------------------------------------------------------------
00448D  2               ; check_levelup - if xp >= level*20, level up (raise maxhp, heal).
00448D  2               ;----------------------------------------------------------------
00448D  2               check_levelup:
00448D  2               ; threshold = plevel * 20  (8-bit is enough up to lvl 12)
00448D  2  AD 6E 51             LDA     plevel
004490  2  85 20                STA     tmp0
004492  2  A9 00                LDA     #0
004494  2  85 21                STA     tmp1
004496  2               ; tmp = level*20 = level*16 + level*4
004496  2  AD 6E 51             LDA     plevel
004499  2  0A                   ASL     A
00449A  2  0A                   ASL     A               ; *4
00449B  2  85 22                STA     tmp2
00449D  2  AD 6E 51             LDA     plevel
0044A0  2  0A                   ASL     A
0044A1  2  0A                   ASL     A
0044A2  2  0A                   ASL     A
0044A3  2  0A                   ASL     A               ; *16
0044A4  2  18                   CLC
0044A5  2  65 22                ADC     tmp2
0044A7  2  85 22                STA     tmp2            ; level*20 (low); ignore >255 (caps fine)
0044A9  2               ; compare xp (16-bit) >= tmp2
0044A9  2  AD 70 51             LDA     pxp+1
0044AC  2  D0 07                BNE     @levelup        ; xp >= 256 definitely past early thresholds
0044AE  2  AD 6F 51             LDA     pxp
0044B1  2  C5 22                CMP     tmp2
0044B3  2  90 2C                BCC     @done
0044B5  2               @levelup:
0044B5  2  EE 6E 51             INC     plevel
0044B8  2               ; maxhp += 8, full heal
0044B8  2  AD 6D 51             LDA     pmaxhp
0044BB  2  18                   CLC
0044BC  2  69 08                ADC     #8
0044BE  2  8D 6D 51             STA     pmaxhp
0044C1  2  8D 6C 51             STA     phealth
0044C4  2  20 2A 0E             JSR     sfx_levelup
0044C7  2  20 36 43             JSR     mb_reset
0044CA  2  A9 0E                LDA     #<c_levelup
0044CC  2  A0 46                LDY     #>c_levelup
0044CE  2  20 3C 43             JSR     mb_str
0044D1  2  AD 6E 51             LDA     plevel
0044D4  2  20 53 43             JSR     mb_num
0044D7  2  A9 D6                LDA     #<c_bang
0044D9  2  A0 45                LDY     #>c_bang
0044DB  2  20 3C 43             JSR     mb_str
0044DE  2  20 B3 43             JSR     mb_flush
0044E1  2               @done:
0044E1  2  60                   RTS
0044E2  2               
0044E2  2               ;----------------------------------------------------------------
0044E2  2               ; monster_attacks_player - monster in slot monidx strikes.
0044E2  2               ;   Damage = 1..mtype_atk, reduced by armor.  Apply to phealth.
0044E2  2               ;----------------------------------------------------------------
0044E2  2               monster_attacks_player:
0044E2  2  A6 2F                LDX     monidx
0044E4  2  BD 91 52             LDA     mon_type,X
0044E7  2  85 21                STA     tmp1            ; type
0044E9  2  A8                   TAY
0044EA  2  B9 71 3D             LDA     mtype_atk,Y
0044ED  2  20 2B 0C             JSR     rng_d           ; 1..atk
0044F0  2  85 20                STA     tmp0            ; raw damage
0044F2  2               ; armor reduces by armor index (0..3)
0044F2  2  AE 76 51             LDX     parmor
0044F5  2  BD 77 45             LDA     arm_def,X
0044F8  2  85 22                STA     tmp2
0044FA  2  38                   SEC
0044FB  2  A5 20                LDA     tmp0
0044FD  2  E5 22                SBC     tmp2
0044FF  2  10 02                BPL     @ok
004501  2  A9 01                LDA     #1              ; minimum 1 damage
004503  2               @ok:
004503  2  D0 02                BNE     @apply
004505  2  A9 01                LDA     #1
004507  2               @apply:
004507  2  85 20                STA     tmp0
004509  2               ; subtract from phealth (floor at 0)
004509  2  38                   SEC
00450A  2  AD 6C 51             LDA     phealth
00450D  2  E5 20                SBC     tmp0
00450F  2  B0 02                BCS     @sethp
004511  2  A9 00                LDA     #0
004513  2               @sethp:
004513  2  8D 6C 51             STA     phealth
004516  2               ; message "Orc hits you for N!"
004516  2  20 36 43             JSR     mb_reset
004519  2  A9 D8                LDA     #<c_the
00451B  2  A0 45                LDY     #>c_the
00451D  2  20 3C 43             JSR     mb_str
004520  2  A5 21                LDA     tmp1
004522  2  20 A8 43             JSR     mb_mname
004525  2  A9 E4                LDA     #<c_hitsyou
004527  2  A0 45                LDY     #>c_hitsyou
004529  2  20 3C 43             JSR     mb_str
00452C  2  A5 20                LDA     tmp0
00452E  2  20 53 43             JSR     mb_num
004531  2  A9 D6                LDA     #<c_bang
004533  2  A0 45                LDY     #>c_bang
004535  2  20 3C 43             JSR     mb_str
004538  2  20 B3 43             JSR     mb_flush
00453B  2  20 50 0D             JSR     sfx_hit
00453E  2  60                   RTS
00453F  2               
00453F  2               ;----------------------------------------------------------------
00453F  2               ; dragon_fire_player - apply the dragon's telegraphed breath attack.
00453F  2               ; Fire ignores armor but is avoidable by leaving the warned lane.
00453F  2               ;----------------------------------------------------------------
00453F  2               dragon_fire_player:
00453F  2  A9 07                LDA     #7
004541  2  20 2B 0C             JSR     rng_d           ; 1..7
004544  2  18                   CLC
004545  2  69 05                ADC     #5              ; 6..12 damage
004547  2  85 20                STA     tmp0
004549  2  38                   SEC
00454A  2  AD 6C 51             LDA     phealth
00454D  2  E5 20                SBC     tmp0
00454F  2  B0 02                BCS     @sethp
004551  2  A9 00                LDA     #0
004553  2               @sethp:
004553  2  8D 6C 51             STA     phealth
004556  2  20 36 43             JSR     mb_reset
004559  2  A9 F3                LDA     #<c_dragonfire
00455B  2  A0 45                LDY     #>c_dragonfire
00455D  2  20 3C 43             JSR     mb_str
004560  2  A5 20                LDA     tmp0
004562  2  20 53 43             JSR     mb_num
004565  2  A9 D6                LDA     #<c_bang
004567  2  A0 45                LDY     #>c_bang
004569  2  20 3C 43             JSR     mb_str
00456C  2  20 B3 43             JSR     mb_flush
00456F  2  20 A6 0D             JSR     sfx_breath
004572  2  60                   RTS
004573  2               
