004CC8  2               ;----------------------------------------------------------------
004CC8  2               ; ruler_adjacent - C=1 if player is orthogonally adjacent to the
004CC8  2               ; ruler's throne. The throne itself is a wall and cannot be entered.
004CC8  2               ;----------------------------------------------------------------
004CC8  2               ruler_adjacent:
004CC8  2  AD 6A 51             LDA     px
004CCB  2  C9 0F                CMP     #CASTLE_RULER_X
004CCD  2  D0 0D                BNE     @side
004CCF  2  AD 6B 51             LDA     py
004CD2  2  C9 03                CMP     #CASTLE_RULER_Y-1
004CD4  2  F0 1A                BEQ     @yes
004CD6  2  C9 05                CMP     #CASTLE_RULER_Y+1
004CD8  2  F0 16                BEQ     @yes
004CDA  2  18                   CLC
004CDB  2  60                   RTS
004CDC  2               @side:
004CDC  2  AD 6B 51             LDA     py
004CDF  2  C9 04                CMP     #CASTLE_RULER_Y
004CE1  2  D0 0B                BNE     @no
004CE3  2  AD 6A 51             LDA     px
004CE6  2  C9 0E                CMP     #CASTLE_RULER_X-1
004CE8  2  F0 06                BEQ     @yes
004CEA  2  C9 10                CMP     #CASTLE_RULER_X+1
004CEC  2  F0 02                BEQ     @yes
004CEE  2               @no:
004CEE  2  18                   CLC
004CEF  2  60                   RTS
004CF0  2               @yes:
004CF0  2  38                   SEC
004CF1  2  60                   RTS
