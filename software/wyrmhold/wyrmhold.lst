0036A5  1                       .INCLUDE "town.asm"
0036A5  2               ;______________________________________________________________________________
0036A5  2               ;  town.asm - shop interaction inside towns
0036A5  2               ;
0036A5  2               ;  When the player presses USE ('T') in a town while adjacent to a
0036A5  2               ;  shop counter ('S' tile), the shop menu opens.  The menu is drawn
0036A5  2               ;  over the message rows; the player picks an option, gold is spent,
0036A5  2               ;  and the menu returns to the map.
0036A5  2               ;______________________________________________________________________________
0036A5  2               
0036A5  2               PRICE_HEAL      = 10            ; gold per visit (full heal)
0036A5  2               PRICE_FOOD      = 20            ; gold for +100 food
0036A5  2               PRICE_WEAPON    = 60            ; gold to upgrade weapon one tier
0036A5  2               PRICE_ARMOR     = 50            ; gold to upgrade armor one tier
0036A5  2               
0036A5  2               ;----------------------------------------------------------------
0036A5  2               ; use_action - bound to the USE key ('T').  Only meaningful in a
0036A5  2               ; town next to a shop counter.
0036A5  2               ;----------------------------------------------------------------
0036A5  2               use_action:
0036A5  2  AD DD 3A             LDA     loc
0036A8  2  C9 01                CMP     #LOC_TOWN
0036AA  2  F0 08                BEQ     @intown
0036AC  2  A9 C0 A0 39          PRINTMSG_MSG t_nothing
0036B0  2  20 3C 2D     
0036B3  2  60                   RTS
0036B4  2               @intown:
0036B4  2                       ; is a shop tile adjacent (4-neighbour) or under us?
0036B4  2  20 C4 36             JSR     shop_adjacent
0036B7  2  B0 08                BCS     @open
0036B9  2  A9 D1 A0 39          PRINTMSG_MSG t_noshop
0036BD  2  20 3C 2D     
0036C0  2  60                   RTS
0036C1  2               @open:
0036C1  2  4C 2E 37             JMP     shop_menu
0036C4  2               
0036C4  2               ;----------------------------------------------------------------
0036C4  2               ; shop_adjacent - C=1 if a T_SHOP tile is at or next to the player.
0036C4  2               ;----------------------------------------------------------------
0036C4  2               shop_adjacent:
0036C4  2                       ; center
0036C4  2  AD D0 3A             LDA     px
0036C7  2  85 2C                STA     tgtx
0036C9  2  AD D1 3A             LDA     py
0036CC  2  85 2D                STA     tgty
0036CE  2  20 70 13             JSR     tileat
0036D1  2  A5 2E                LDA     tgttile
0036D3  2  C9 0E                CMP     #T_SHOP
0036D5  2  F0 55                BEQ     @yes
0036D7  2                       ; up
0036D7  2  AD D0 3A             LDA     px
0036DA  2  85 2C                STA     tgtx
0036DC  2  AD D1 3A             LDA     py
0036DF  2  38                   SEC
0036E0  2  E9 01                SBC     #1
0036E2  2  85 2D                STA     tgty
0036E4  2  20 70 13             JSR     tileat
0036E7  2  A5 2E                LDA     tgttile
0036E9  2  C9 0E                CMP     #T_SHOP
0036EB  2  F0 3F                BEQ     @yes
0036ED  2                       ; down
0036ED  2  AD D1 3A             LDA     py
0036F0  2  18                   CLC
0036F1  2  69 01                ADC     #1
0036F3  2  85 2D                STA     tgty
0036F5  2  AD D0 3A             LDA     px
0036F8  2  85 2C                STA     tgtx
0036FA  2  20 70 13             JSR     tileat
0036FD  2  A5 2E                LDA     tgttile
0036FF  2  C9 0E                CMP     #T_SHOP
003701  2  F0 29                BEQ     @yes
003703  2                       ; left
003703  2  AD D1 3A             LDA     py
003706  2  85 2D                STA     tgty
003708  2  AD D0 3A             LDA     px
00370B  2  38                   SEC
00370C  2  E9 01                SBC     #1
00370E  2  85 2C                STA     tgtx
003710  2  20 70 13             JSR     tileat
003713  2  A5 2E                LDA     tgttile
003715  2  C9 0E                CMP     #T_SHOP
003717  2  F0 13                BEQ     @yes
003719  2                       ; right
003719  2  AD D0 3A             LDA     px
00371C  2  18                   CLC
00371D  2  69 01                ADC     #1
00371F  2  85 2C                STA     tgtx
003721  2  20 70 13             JSR     tileat
003724  2  A5 2E                LDA     tgttile
003726  2  C9 0E                CMP     #T_SHOP
003728  2  F0 02                BEQ     @yes
00372A  2  18                   CLC
00372B  2  60                   RTS
00372C  2               @yes:
00372C  2  38                   SEC
00372D  2  60                   RTS
00372E  2               
00372E  2               ;----------------------------------------------------------------
00372E  2               ; shop_menu - draw the shop menu over the message area and loop
00372E  2               ; processing purchases until the player presses X.
00372E  2               ;----------------------------------------------------------------
00372E  2               shop_menu:
00372E  2  20 6A 0E             JSR     sfx_door
003731  2                       ; start with the greeting as the status line
003731  2  A9 A2                LDA     #<t_greet
003733  2  8D ED 3A             STA     shopstat
003736  2  A9 39                LDA     #>t_greet
003738  2  8D EE 3A             STA     shopstat+1
00373B  2               @redraw:
00373B  2  20 35 38             JSR     shop_draw
00373E  2               @key:
00373E  2  20 ED 2E             JSR     getkey_block
003741  2  C9 31                CMP     #'1'
003743  2  F0 1A                BEQ     @heal
003745  2  C9 32                CMP     #'2'
003747  2  F0 33                BEQ     @food
003749  2  C9 33                CMP     #'3'
00374B  2  F0 54                BEQ     @weapon
00374D  2  C9 34                CMP     #'4'
00374F  2  F0 7B                BEQ     @armor
003751  2  C9 58                CMP     #'X'
003753  2  F0 07                BEQ     @goleave
003755  2  C9 78                CMP     #'x'
003757  2  F0 03                BEQ     @goleave
003759  2  4C 3E 37             JMP     @key
00375C  2               @goleave:
00375C  2  4C 04 38             JMP     @leave
00375F  2               @heal:
