004F5F  2               ;  shrine.asm - Sunken Shrine transition and Wyrm Key reward
004F5F  2               ;______________________________________________________________________________
004F5F  2               
004F5F  2               ;----------------------------------------------------------------
004F5F  2               ; enter_shrine - enter the southern-marsh quest location.
004F5F  2               ;----------------------------------------------------------------
004F5F  2               enter_shrine:
004F5F  2  20 61 0E             JSR     sfx_door
004F62  2  20 34 1A             JSR     decode_shrine
004F65  2  A9 04                LDA     #LOC_SHRINE
004F67  2  8D 77 51             STA     loc
004F6A  2  A9 20                LDA     #SHRINEW
004F6C  2  8D 78 51             STA     locw
004F6F  2  A9 14                LDA     #SHRINEH
004F71  2  8D 79 51             STA     loch
004F74  2  AD 6A 51             LDA     px
004F77  2  8D 7A 51             STA     owretx
004F7A  2  AD 6B 51             LDA     py
004F7D  2  8D 7B 51             STA     owrety
004F80  2               ; begin just east of the stairs-up tile
004F80  2  A9 02                LDA     #2
004F82  2  8D 6A 51             STA     px
004F85  2  A9 01                LDA     #1
004F87  2  8D 6B 51             STA     py
004F8A  2  20 AF 3E             JSR     spawn_shrine_monsters
004F8D  2  A9 01                LDA     #1
004F8F  2  8D 7F 51             STA     did_move
004F92  2  AD 7D 51             LDA     queststate
004F95  2  C9 01                CMP     #QUEST_FIND_KEY
004F97  2  D0 0F                BNE     @quiet
004F99  2  A9 53 A0 50          PRINTMSG_MSG m_shrine1
004F9D  2  20 F4 39     
004FA0  2  A9 8F A0 50          PRINTMSG_MSG m_shrine2
004FA4  2  20 F4 39     
004FA7  2  60                   RTS
004FA8  2               @quiet:
004FA8  2  A9 C4 A0 50          PRINTMSG_MSG m_shrine_empty
004FAC  2  20 F4 39     
004FAF  2  60                   RTS
004FB0  2               
004FB0  2               ;----------------------------------------------------------------
004FB0  2               ; award_wyrm_key - called when the Wyrm Warden dies.
004FB0  2               ;----------------------------------------------------------------
004FB0  2               award_wyrm_key:
004FB0  2  AD 7D 51             LDA     queststate
004FB3  2  C9 01                CMP     #QUEST_FIND_KEY
004FB5  2  D0 16                BNE     @done
004FB7  2  A9 02                LDA     #QUEST_HAVE_KEY
004FB9  2  8D 7D 51             STA     queststate
