ca65 V2.18 - Ubuntu 2.19-1
Main file   : wyrmhold.asm
Current file: wyrmhold.asm

000000r 1               ;______________________________________________________________________________
000000r 1               ;  WYRMHOLD  -  an original top-down fantasy RPG for the 6502PC / DOS/65
000000r 1               ;
000000r 1               ;  Written in 6502 assembly (ca65).  Uses the memory-mapped video card
000000r 1               ;  (direct VRAM via MMU paging, the SpeedScript way) and the AY-3-8910
000000r 1               ;  PSG for a title melody and sound effects.
000000r 1               ;
000000r 1               ;  Program loads at $0800 (DOS/65 TEA) and exits back to DOS with JMP $0100.
000000r 1               ;______________________________________________________________________________
000000r 1                       .PSC02
000000r 1               
000000r 1                       .SEGMENT "TEA"
000000r 1                       .ORG    $0800
000800  1               
000800  1                       .INCLUDE "macro.asm"
000800  2               ;______________________________________________________________________________
000800  2               ;  macro.asm - 16-bit helpers and a FARCALL convenience macro
000800  2               ;  Style follows software/speedscript/macro.asm
000800  2               ;______________________________________________________________________________
000800  2               
000800  2               ; Copy a 16-bit value src -> dst
000800  2                       .MACRO  COPY16  src, dst
000800  2                       LDA     src
000800  2                       STA     dst
000800  2                       LDA     src+1
000800  2                       STA     dst+1
000800  2                       .ENDMACRO
000800  2               
000800  2               ; left = left + right (16-bit)
000800  2                       .MACRO  ADD16   left,right
000800  2                       CLC
000800  2                       LDA     left
000800  2                       ADC     right
000800  2                       STA     left
000800  2                       LDA     left+1
000800  2                       ADC     right+1
000800  2                       STA     left+1
000800  2                       .ENDMACRO
000800  2               
000800  2               ; left = left - right (16-bit)
000800  2                       .MACRO  SUB16   left,right
000800  2                       SEC
000800  2                       LDA     left
000800  2                       SBC     right
000800  2                       STA     left
000800  2                       LDA     left+1
000800  2                       SBC     right+1
000800  2                       STA     left+1
000800  2                       .ENDMACRO
000800  2               
000800  2               ; Set a 16-bit zero-page word to an immediate constant.
000800  2                       .MACRO  SETW16  dst, value
000800  2                       LDA     #<(value)
000800  2                       STA     dst
000800  2                       LDA     #>(value)
000800  2                       STA     dst+1
000800  2                       .ENDMACRO
000800  2               
000800  2               ; Issue a FARCALL: store function number then JSR DO_FARCALL.
000800  2               ; Pass any X/Y/A arguments BEFORE invoking (this macro only touches A).
000800  2                       .MACRO  FARCALL func
000800  2                       LDA     #func
000800  2                       STA     farfunct
000800  2                       JSR     DO_FARCALL
000800  2                       .ENDMACRO
000800  2               
000800  2               ; Print a zero-terminated message via the firmware console (FARCALL chrout).
000800  2               ; message = address of a 0-terminated string.
000800  2                       .MACRO  PRINTMSG message
000800  2                       LDA     #<message
000800  2                       LDY     #>message
000800  2                       JSR     prmsg
000800  2                       .ENDMACRO
000800  2               
000800  2               ; Push a message into the scrolling message log at the bottom.
000800  2                       .MACRO  PRINTMSG_MSG message
000800  2                       LDA     #<message
000800  2                       LDY     #>message
000800  2                       JSR     msg_print
000800  2                       .ENDMACRO
000800  2               
000800  2               ; Set the shop status-line pointer (shopstat) to a message address.
000800  2                       .MACRO  SETSTAT message
000800  2                       LDA     #<message
000800  2                       STA     shopstat
000800  2                       LDA     #>message
000800  2                       STA     shopstat+1
000800  2                       .ENDMACRO
000800  2               
000800  1                       .INCLUDE "defines.asm"
000800  2               ;______________________________________________________________________________
000800  2               ;  defines.asm - system equates, constants and game state
000800  2               ;______________________________________________________________________________
000800  2               
000800  2               ;----------------------------------------------------------------
000800  2               ; DOS/65 system entry points
000800  2               ;----------------------------------------------------------------
000800  2               DFLFCB          = $107          ; DEFAULT FCB
000800  2               PEM             = $103          ; PEM ENTRY
000800  2               BOOT            = $100          ; WARM BOOT (exit back to DOS/65)
000800  2               
000800  2               ;----------------------------------------------------------------
000800  2               ; Memory-mapped video state (firmware-shared, fixed addresses)
000800  2               ;----------------------------------------------------------------
000800  2               CURX            = $0647         ; current cursor column
000800  2               CURY            = $0648         ; current cursor row
000800  2               SHOWCRSR        = $0649         ; show cursor (1=yes,0=no)
000800  2               CURCOLOR        = $064A         ; current print color
000800  2               CSRCOLOR        = $064B         ; current cursor color
000800  2               BVIDEOMODE      = $064C         ; current video mode (0=40,1=80)
000800  2               
000800  2               ;----------------------------------------------------------------
000800  2               ; FARCALL dispatch
000800  2               ;----------------------------------------------------------------
000800  2               DO_FARCALL      = $FFF0
000800  2               farfunct        = $32           ; zero-page: FARCALL function number
000800  2               
000800  2               ; MMU / video paging
000800  2               SETPAGE         = $FFF6         ; A=task, X=bank, Y=physical page
000800  2               VIDEOBANK       = $F8           ; base physical page for video RAM
000800  2               PC6502_ACT_TASK = $EFE0         ; MMU active task register (write only)
000800  2               VIDTEXT_PAGE    = $01+VIDEOBANK ; physical page for text page 1 ($F9)
000800  2               
000800  2               ; FARCALL function numbers (see 6502PC_firmware/dos65drv.asm)
000800  2               FC_CHROUT       = 19
000800  2               FC_CHRIN        = 20            ; non-blocking, returns A=key or $FF
000800  2               FC_LOCATE       = 37            ; X=col, Y=row
000800  2               FC_SCNCLR       = 38
000800  2               FC_COLOR        = 39            ; X=color, Y=cursor color
000800  2               FC_SCROLLDN     = 56
000800  2               FC_SETMODE      = 57
000800  2               FC_PAINTCSR     = 58
000800  2               FC_UNPAINTCSR   = 59
000800  2               
000800  2               ;----------------------------------------------------------------
000800  2               ; Video memory window (we map sub-page $F9 into CPU bank $A,
000800  2               ; matching software/speedscript/screen.asm).
000800  2               ;   text  chars : $A000 + row*80 + col
000800  2               ;   color cells : $A800 + row*80 + col   (low nibble fg, high nibble bg)
000800  2               ;----------------------------------------------------------------
000800  2               VRAM_TEXT       = $A000
000800  2               VRAM_COLOR      = $A800
000800  2               SCRW            = 80
000800  2               SCRH            = 24
000800  2               
000800  2               ;----------------------------------------------------------------
000800  2               ; Color values.  color byte = (bg<<4) | fg
000800  2               ; Base palette nibbles (typical 4-bit IRGB-ish ordering used by the card)
000800  2               ;----------------------------------------------------------------
000800  2               CO_BLACK        = $0
000800  2               CO_RED          = $1
000800  2               CO_GREEN        = $2
000800  2               CO_YELLOW       = $3
000800  2               CO_BLUE         = $4
000800  2               CO_MAGENTA      = $5
000800  2               CO_CYAN         = $6
000800  2               CO_WHITE        = $7
000800  2               CO_GREY         = $8
000800  2               CO_BRRED        = $9
000800  2               CO_BRGREEN      = $A
000800  2               CO_BRYELLOW     = $B
000800  2               CO_BRBLUE       = $C
000800  2               CO_BRMAGENTA    = $D
000800  2               CO_BRCYAN       = $E
000800  2               CO_BRWHITE      = $F
000800  2               
000800  2               ; convenience: build a color byte from fg,bg nibbles
000800  2                       .DEFINE COLOR(fg,bg) (((bg)<<4)|(fg))
000800  2               
000800  2               ; named cell colors used throughout the game
000800  2               ; Terrain uses colored backgrounds so adjoining cells read as landscape,
000800  2               ; while the brighter foreground pixels provide texture and landmarks.
000800  2               C_GRASS         = COLOR(CO_BRGREEN, CO_GREEN)
000800  2               C_WATER         = COLOR(CO_BRCYAN,  CO_BLUE)
000800  2               C_FOREST        = COLOR(CO_BRGREEN, CO_BLACK)
000800  2               C_MOUNT         = COLOR(CO_BRWHITE, CO_GREY)
000800  2               C_TOWN          = COLOR(CO_BRYELLOW,CO_RED)
000800  2               C_CASTLE        = COLOR(CO_BRWHITE, CO_GREY)
000800  2               C_DUNG          = COLOR(CO_BRMAGENTA,CO_BLACK)
000800  2               C_ROAD          = COLOR(CO_BRYELLOW,CO_RED)
000800  2               C_BRIDGE        = COLOR(CO_BRYELLOW,CO_BLUE)
000800  2               C_FLOOR         = COLOR(CO_GREY,    CO_BLACK)
000800  2               C_WALL          = COLOR(CO_BRWHITE, CO_GREY)
000800  2               C_HILLS         = COLOR(CO_BRYELLOW,CO_GREEN)
000800  2               C_MARSH         = COLOR(CO_BRGREEN, CO_BLUE)
000800  2               C_TREAS         = COLOR(CO_BRYELLOW,CO_BLACK)
000800  2               C_PLAYER        = COLOR(CO_BRWHITE, CO_BLACK)
000800  2               C_MONST         = COLOR(CO_BRRED,   CO_BLACK)
000800  2               C_BOSS          = COLOR(CO_BRRED,   CO_RED)
000800  2               C_BORDER        = COLOR(CO_BRCYAN,  CO_BLACK)
000800  2               C_PANEL         = COLOR(CO_BRWHITE, CO_BLACK)
000800  2               C_PANELHDR      = COLOR(CO_BRYELLOW,CO_BLUE)
000800  2               C_MSG           = COLOR(CO_BRWHITE, CO_BLACK)
000800  2               C_TITLE         = COLOR(CO_BRYELLOW,CO_BLACK)
000800  2               C_BLANK         = COLOR(CO_WHITE,   CO_BLACK)
000800  2               
000800  2               ; shop panel colors (blue panel with bright text)
000800  2               C_SHOPBG        = COLOR(CO_BRWHITE, CO_BLUE)
000800  2               C_SHOPBRD       = COLOR(CO_BRCYAN,  CO_BLUE)
000800  2               C_SHOPTTL       = COLOR(CO_BRYELLOW,CO_BLUE)
000800  2               C_SHOPTXT       = COLOR(CO_BRWHITE, CO_BLUE)
000800  2               C_SHOPST        = COLOR(CO_BRGREEN, CO_BLUE)
000800  2               
000800  2               ; exit tiles (town door / dungeon stairs) - bright so they stand out
000800  2               C_EXIT          = COLOR(CO_BLACK,   CO_BRGREEN)
000800  2               
000800  2               ;----------------------------------------------------------------
000800  2               ; Tile codes (index into terrain tables).  Stored in map data.
000800  2               ;----------------------------------------------------------------
000800  2               T_GRASS         = 0
000800  2               T_FOREST        = 1
000800  2               T_MOUNT         = 2
000800  2               T_WATER         = 3
000800  2               T_TOWN          = 4
000800  2               T_DUNG          = 5
000800  2               T_CASTLE        = 6
000800  2               T_ROAD          = 7
000800  2               T_BRIDGE        = 8
000800  2               T_FLOOR         = 9             ; dungeon/town floor
000800  2               T_WALL          = 10            ; dungeon/town wall (impassable)
000800  2               T_DOOR          = 11            ; exit tile (leave town/dungeon)
000800  2               T_TREAS         = 12            ; treasure chest
000800  2               T_UPSTAIR       = 13            ; leave dungeon
000800  2               T_SHOP          = 14            ; shop counter inside a town
000800  2               T_HILLS         = 15            ; passable rolling foothills
000800  2               T_MARSH         = 16            ; passable wetland
000800  2               NUM_TILES       = 17
000800  2               
000800  2               ;----------------------------------------------------------------
000800  2               ; Small custom glyphs used by the title scene. Gameplay uses the
000800  2               ; 2x2 metatile glyphs in the upper half of the character set below.
000800  2               ;----------------------------------------------------------------
000800  2               G_GRASS         = 1
000800  2               G_FOREST        = 2
000800  2               G_MOUNT         = 3
000800  2               G_WATER         = 4
000800  2               G_TOWN          = 5
000800  2               G_DUNG          = 6
000800  2               G_CASTLE        = 7
000800  2               G_ROAD          = 8
000800  2               G_BRIDGE        = 9
000800  2               G_FLOOR         = 10
000800  2               G_WALL          = 11
000800  2               G_DOOR          = 12
000800  2               G_TREAS         = 13
000800  2               G_UPSTAIR       = 14
000800  2               G_SHOP          = 15
000800  2               
000800  2               G_PLAYER        = 16
000800  2               
000800  2               ; monster glyphs
000800  2               G_ORC           = 17
000800  2               G_SNAKE         = 18
000800  2               G_SKELETON      = 19
000800  2               G_THIEF         = 20
000800  2               G_TROLL         = 21
000800  2               G_BOSS          = 22
000800  2               
000800  2               G_HILLS         = 23
000800  2               G_MARSH         = 24
000800  2               
000800  2               ;----------------------------------------------------------------
000800  2               ; Gameplay metatile glyphs. Each world tile occupies four adjacent
000800  2               ; character cells:
000800  2               ;   base+0 base+1
000800  2               ;   base+2 base+3
000800  2               ;
000800  2               ; Terrain bases are computed as MG_TERRAIN_BASE + tile_code*4.
000800  2               ; $80..$DF stays clear of printable ASCII used by the UI.
000800  2               ; The DBASIC PATTERN implementation accepts character numbers 0..255.
000800  2               ;----------------------------------------------------------------
000800  2               MG_TERRAIN_BASE = $80
000800  2               
000800  2               MG_GRASS        = MG_TERRAIN_BASE+(T_GRASS*4)
000800  2               MG_FOREST       = MG_TERRAIN_BASE+(T_FOREST*4)
000800  2               MG_MOUNT        = MG_TERRAIN_BASE+(T_MOUNT*4)
000800  2               MG_WATER        = MG_TERRAIN_BASE+(T_WATER*4)
000800  2               MG_TOWN         = MG_TERRAIN_BASE+(T_TOWN*4)
000800  2               MG_DUNG         = MG_TERRAIN_BASE+(T_DUNG*4)
000800  2               MG_CASTLE       = MG_TERRAIN_BASE+(T_CASTLE*4)
000800  2               MG_ROAD         = MG_TERRAIN_BASE+(T_ROAD*4)
000800  2               MG_BRIDGE       = MG_TERRAIN_BASE+(T_BRIDGE*4)
000800  2               MG_FLOOR        = MG_TERRAIN_BASE+(T_FLOOR*4)
000800  2               MG_WALL         = MG_TERRAIN_BASE+(T_WALL*4)
000800  2               MG_DOOR         = MG_TERRAIN_BASE+(T_DOOR*4)
000800  2               MG_TREAS        = MG_TERRAIN_BASE+(T_TREAS*4)
000800  2               MG_UPSTAIR      = MG_TERRAIN_BASE+(T_UPSTAIR*4)
000800  2               MG_SHOP         = MG_TERRAIN_BASE+(T_SHOP*4)
000800  2               MG_HILLS        = MG_TERRAIN_BASE+(T_HILLS*4)
000800  2               MG_MARSH        = MG_TERRAIN_BASE+(T_MARSH*4)
000800  2               
000800  2               MG_PLAYER       = $C4
000800  2               MG_ORC          = $C8
000800  2               MG_SNAKE        = $CC
000800  2               MG_SKELETON     = $D0
000800  2               MG_THIEF        = $D4
000800  2               MG_TROLL        = $D8
000800  2               MG_BOSS         = $DC
000800  2               
000800  2               ;----------------------------------------------------------------
000800  2               ; Terrain variant metatiles ($E0..$FF). A few high-traffic field
000800  2               ; terrains get a 2nd art variant so large regions don't show an
000800  2               ; obvious grid. render_view picks variant 0 (the MG_* base above)
000800  2               ; or variant 1 (these) from a position hash. Tiles without a
000800  2               ; variant entry here are left to fall through to their base.
000800  2               ;   NOTE: depends on the video card redefining glyphs >= $80; the
000800  2               ;   $E0+ range is verified on hardware at build time.
000800  2               ;----------------------------------------------------------------
000800  2               MGV_GRASS       = $E0
000800  2               MGV_FOREST      = $E4
000800  2               MGV_WATER       = $E8
000800  2               MGV_MOUNT       = $EC
000800  2               ; $F0..$FF still free for more variants
000800  2               
000800  2               ;----------------------------------------------------------------
000800  2               ; Monster type ids
000800  2               ;----------------------------------------------------------------
000800  2               M_NONE          = 0
000800  2               M_ORC           = 1
000800  2               M_SNAKE         = 2
000800  2               M_SKELETON      = 3
000800  2               M_THIEF         = 4
000800  2               M_TROLL         = 5
000800  2               M_BOSS          = 6
000800  2               NUM_MTYPE       = 7
000800  2               MAXMON          = 12            ; max simultaneously active monsters
000800  2               
000800  2               ;----------------------------------------------------------------
000800  2               ; Viewport geometry (left map window). Gameplay world tiles are
000800  2               ; rendered as 2x2 character-cell metatiles.
000800  2               ;   frame at col 0..VPW+1, rows 0..VPH+1  (top bar handled separately)
000800  2               ;----------------------------------------------------------------
000800  2               VPW             = 44            ; viewport interior width in screen cells
000800  2               VPH             = 20            ; viewport interior height (rows 1..20)
000800  2               VPX0            = 1             ; first interior column (screen)
000800  2               VPY0            = 1             ; first interior row (screen)
000800  2               VPTW            = VPW/2         ; viewport width in world tiles
000800  2               VPTH            = VPH/2         ; viewport height in world tiles
000800  2               VPCX            = 11            ; player world-tile column within viewport
000800  2               VPCY            = 5             ; player world-tile row within viewport
000800  2               
000800  2               ; panel geometry (right side)
000800  2               PANX            = 48            ; panel text start column
000800  2               PANW            = 31
000800  2               
000800  2               ; message log geometry (bottom two rows)
000800  2               MSGY0           = 22
000800  2               MSGROWS         = 2
000800  2               
000800  2               ; map dimensions
000800  2               OWW             = 64            ; overworld width
000800  2               OWH             = 64            ; overworld height
000800  2               TOWNW           = 32            ; town map width
000800  2               TOWNH           = 20            ; town map height
000800  2               DUNGW           = 32            ; dungeon map width
000800  2               DUNGH           = 20            ; dungeon map height
000800  2               
000800  2               ; world/location ids (which map is active)
000800  2               LOC_WORLD       = 0
000800  2               LOC_TOWN        = 1
000800  2               LOC_DUNG        = 2
000800  2               
000800  2               ; misc constants
000800  2               space           = 32
000800  2               ESC             = 27
000800  2               CR              = 13
000800  2               
000800  2               ;----------------------------------------------------------------
000800  2               ; Zero-page allocation.  $00-$31 are largely free for the TEA;
000800  2               ; $32 (farfunct) is reserved by the system.  We use a contiguous
000800  2               ; block below it and a high block ($F0-$FE scratch pointers) the
000800  2               ; same way speedscript does.
000800  2               ;----------------------------------------------------------------
000800  2               ; 16-bit scratch pointers
000800  2               ptr             = $10           ; general pointer (2)
000800  2               ptr2            = $12           ; general pointer (2)
000800  2               vptr            = $14           ; video text pointer (2)
000800  2               cptr            = $16           ; video color pointer (2)
000800  2               srcp            = $18           ; source pointer (2)
000800  2               dstp            = $1A           ; dest pointer (2)
000800  2               strp            = $1C           ; string pointer for prmsg (2)
000800  2               numarg          = $1E           ; 16-bit number for displaynum (2)
000800  2               
000800  2               ; 8-bit scratch
000800  2               tmp0            = $20
000800  2               tmp1            = $21
000800  2               tmp2            = $22
000800  2               tmp3            = $23
000800  2               cnt0            = $24
000800  2               cnt1            = $25
000800  2               colidx          = $26           ; saved column index
000800  2               rowidx          = $27           ; saved row index
000800  2               numspace        = $28           ; displaynum digit accumulator
000800  2               keych           = $29           ; last key read
000800  2               dx              = $2A           ; signed move delta x
000800  2               dy              = $2B           ; signed move delta y
000800  2               tgtx            = $2C           ; target tile x
000800  2               tgty            = $2D           ; target tile y
000800  2               tgttile         = $2E           ; tile code at target
000800  2               monidx          = $2F           ; current monster index
000800  2               seedlo          = $30           ; RNG state low
000800  2               seedhi          = $31           ; RNG state high
000800  2               ; $32 = farfunct (system)
000800  2               seed2lo         = $33           ; RNG state 2 low
000800  2               seed2hi         = $34           ; RNG state 2 high
000800  2               
000800  2               ;----------------------------------------------------------------
000800  2               ; Game state (in TEA RAM, defined as labels in wyrmhold.asm BSS area)
000800  2               ; declared here as equates is not possible; real storage is in the
000800  2               ; .SEGMENT "TEA" at the end of wyrmhold.asm.  See gamevars there.
000800  2               ;----------------------------------------------------------------
000800  2               
000800  1               
000800  1               ;==============================================================================
000800  1               ; Entry point
000800  1               ;==============================================================================
000800  1               BEGIN:
000800  1  D8                   CLD
000801  1  20 1B 0C             JSR     psg_init
000804  1  20 DB 0B             JSR     rng_seed
000807  1               ; All direct-VRAM rendering below assumes 80-byte screen rows.
000807  1               ; Establish that mode before uploading glyphs or drawing anything.
000807  1  A9 39                LDA     #FC_SETMODE
000809  1  85 32                STA     farfunct
00080B  1  A9 01                LDA     #1              ; 80-column text mode
00080D  1  20 F0 FF             JSR     DO_FARCALL
000810  1  20 F2 10             JSR     chargen_init    ; upload custom terrain/monster tiles
000813  1               ; hide the firmware text cursor; we draw our own world
000813  1  A9 00                LDA     #0
000815  1  8D 49 06             STA     SHOWCRSR
000818  1               title_loop_outer:
000818  1  20 24 08             JSR     title_screen    ; returns when a key is pressed
00081B  1  20 46 08             JSR     new_game
00081E  1  20 6C 08             JSR     game_loop       ; returns on death / victory / quit
000821  1               ; game_loop decides what to do; if it returns we go to DOS
000821  1  4C B3 09             JMP     exit_to_dos
000824  1               
000824  1               ;==============================================================================
000824  1               ; Title screen - draws a banner, plays the melody, waits for a key.
000824  1               ;==============================================================================
000824  1               title_screen:
000824  1  20 F1 15             JSR     draw_title_scene; full graphical title (title.asm)
000827  1               
000827  1               ; Settle period: for the first stretch of the title we PLAY the
000827  1               ; music but ignore (and keep draining) any keys.  This swallows
000827  1               ; the Enter typed to launch the program - on re-runs that key is
000827  1               ; sometimes delivered just after we start, and without this it
000827  1               ; would dismiss the title instantly (the "no intro on 2nd run"
000827  1               ; bug).
000827  1  20 94 0E             JSR     music_start
00082A  1  A2 28                LDX     #40             ; settle ticks
00082C  1               @settle:
00082C  1  DA                   PHX
00082D  1  20 E8 0E             JSR     music_tick
000830  1  20 6E 35             JSR     getkey          ; read & discard whatever shows up
000833  1  FA                   PLX
000834  1  CA                   DEX
000835  1  D0 F5                BNE     @settle
000837  1  20 7C 35             JSR     drainkeys       ; clear anything still buffered
00083A  1               @spin:
00083A  1  20 E8 0E             JSR     music_tick
00083D  1  20 6E 35             JSR     getkey
000840  1  F0 F8                BEQ     @spin
000842  1  20 43 0C             JSR     psg_silence
000845  1  60                   RTS
000846  1               
000846  1               ;==============================================================================
000846  1               ; new_game - initialise all game state and draw the initial screen.
000846  1               ;==============================================================================
000846  1               new_game:
000846  1  20 56 38             JSR     player_init
000849  1  20 FE 18             JSR     decode_world
00084C  1  A9 00                LDA     #LOC_WORLD
00084E  1  8D 52 41             STA     loc
000851  1  20 B1 36             JSR     spawn_overworld_monsters
000854  1  20 1E 31             JSR     draw_frame
000857  1  20 10 34             JSR     msg_clear
00085A  1  A9 FB A0 0A          PRINTMSG_MSG intro_msg
00085E  1  20 B1 33     
000861  1  20 65 08             JSR     full_redraw
000864  1  60                   RTS
000865  1               
000865  1               ;==============================================================================
000865  1               ; full_redraw - viewport + panel.
000865  1               ;==============================================================================
000865  1               full_redraw:
000865  1  20 01 32             JSR     render_view
000868  1  20 22 34             JSR     draw_panel
00086B  1  60                   RTS
00086C  1               
00086C  1               ;==============================================================================
00086C  1               ; game_loop - the main turn loop.
00086C  1               ;==============================================================================
00086C  1               game_loop:
00086C  1               @loop:
00086C  1               ; check end conditions first
00086C  1  AD 57 41             LDA     bosskilled
00086F  1  F0 03                BEQ     @alive
000871  1  4C 28 09             JMP     victory
000874  1               @alive:
000874  1  AD 47 41             LDA     phealth
000877  1  D0 03                BNE     @hasfood
000879  1  4C 66 09             JMP     game_over_hp
00087C  1               @hasfood:
00087C  1  AD 4E 41             LDA     pfood
00087F  1  0D 4F 41             ORA     pfood+1
000882  1  D0 03                BNE     @input
000884  1  4C 6D 09             JMP     game_over_food
000887  1               
000887  1               @input:
000887  1  20 6E 35             JSR     getkey
00088A  1  F0 E0                BEQ     @loop           ; no key - idle (no time passes)
00088C  1  85 29                STA     keych
00088E  1               
00088E  1               ; movement keys -> set dx,dy then try_move
00088E  1  A9 00                LDA     #0
000890  1  85 2A                STA     dx
000892  1  85 2B                STA     dy
000894  1               
000894  1  A5 29                LDA     keych
000896  1  C9 77                CMP     #'w'
000898  1  F0 3F                BEQ     @up
00089A  1  C9 57                CMP     #'W'
00089C  1  F0 3B                BEQ     @up
00089E  1  C9 6B                CMP     #'k'
0008A0  1  F0 37                BEQ     @up
0008A2  1  C9 73                CMP     #'s'
0008A4  1  F0 3A                BEQ     @down
0008A6  1  C9 53                CMP     #'S'
0008A8  1  F0 36                BEQ     @down
0008AA  1  C9 6A                CMP     #'j'
0008AC  1  F0 32                BEQ     @down
0008AE  1  C9 61                CMP     #'a'
0008B0  1  F0 35                BEQ     @left
0008B2  1  C9 41                CMP     #'A'
0008B4  1  F0 31                BEQ     @left
0008B6  1  C9 68                CMP     #'h'
0008B8  1  F0 2D                BEQ     @left
0008BA  1  C9 64                CMP     #'d'
0008BC  1  F0 30                BEQ     @right
0008BE  1  C9 44                CMP     #'D'
0008C0  1  F0 2C                BEQ     @right
0008C2  1  C9 6C                CMP     #'l'
0008C4  1  F0 28                BEQ     @right
0008C6  1               
0008C6  1  C9 74                CMP     #'t'
0008C8  1  F0 39                BEQ     @use
0008CA  1  C9 54                CMP     #'T'
0008CC  1  F0 35                BEQ     @use
0008CE  1  C9 71                CMP     #'q'
0008D0  1  F0 3A                BEQ     @quit
0008D2  1  C9 51                CMP     #'Q'
0008D4  1  F0 36                BEQ     @quit
0008D6  1  4C 6C 08             JMP     @loop           ; unknown key
0008D9  1               
0008D9  1               @up:
0008D9  1  A9 FF                LDA     #$FF            ; dy = -1
0008DB  1  85 2B                STA     dy
0008DD  1  4C F2 08             JMP     @domove
0008E0  1               @down:
0008E0  1  A9 01                LDA     #1
0008E2  1  85 2B                STA     dy
0008E4  1  4C F2 08             JMP     @domove
0008E7  1               @left:
0008E7  1  A9 FF                LDA     #$FF
0008E9  1  85 2A                STA     dx
0008EB  1  4C F2 08             JMP     @domove
0008EE  1               @right:
0008EE  1  A9 01                LDA     #1
0008F0  1  85 2A                STA     dx
0008F2  1               @domove:
0008F2  1  20 9E 38             JSR     try_move
0008F5  1               ; if a turn was consumed and we're not in town, monsters act
0008F5  1  AD 58 41             LDA     did_move
0008F8  1  F0 03                BEQ     @after
0008FA  1  20 A0 37             JSR     mon_act
0008FD  1               @after:
0008FD  1  20 65 08             JSR     full_redraw
000900  1  4C 6C 08             JMP     @loop
000903  1               
000903  1               @use:
000903  1  20 1A 3D             JSR     use_action
000906  1  20 65 08             JSR     full_redraw
000909  1  4C 6C 08             JMP     @loop
00090C  1               
00090C  1               @quit:
00090C  1  20 15 09             JSR     confirm_quit
00090F  1  F0 03                BEQ     @doquit         ; Z=1 means Yes
000911  1  4C 6C 08             JMP     @loop
000914  1               @doquit:
000914  1  60                   RTS
000915  1               
000915  1               ;==============================================================================
000915  1               ; confirm_quit - ask Y/N. Returns Z=1 if quitting.
000915  1               ;==============================================================================
000915  1               confirm_quit:
000915  1  20 10 34             JSR     msg_clear
000918  1  A9 2A A0 0B          PRINTMSG_MSG q_quit
00091C  1  20 B1 33     
00091F  1  20 46 35             JSR     yorn            ; Z=1 if yes
000922  1  08                   PHP
000923  1  20 10 34             JSR     msg_clear
000926  1  28                   PLP
000927  1  60                   RTS
000928  1               
000928  1               ;==============================================================================
000928  1               ; End-game screens
000928  1               ;==============================================================================
000928  1               victory:
000928  1  20 E2 30             JSR     cls_vram
00092B  1  A2 14                LDX     #20
00092D  1  A0 08                LDY     #8
00092F  1  20 B4 31             JSR     locate
000932  1  A9 0B                LDA     #C_TITLE
000934  1  8D 4A 06             STA     CURCOLOR
000937  1  A9 3D A0 0B          PRINTMSG win1
00093B  1  20 C6 31     
00093E  1  A2 10                LDX     #16
000940  1  A0 0A                LDY     #10
000942  1  20 B4 31             JSR     locate
000945  1  A9 0F                LDA     #C_PANEL
000947  1  8D 4A 06             STA     CURCOLOR
00094A  1  A9 4E A0 0B          PRINTMSG win2
00094E  1  20 C6 31     
000951  1  A2 12                LDX     #18
000953  1  A0 0E                LDY     #14
000955  1  20 B4 31             JSR     locate
000958  1  A9 CA A0 0B          PRINTMSG anykey
00095C  1  20 C6 31     
00095F  1  20 4D 0E             JSR     sfx_win
000962  1  20 62 35             JSR     getkey_block
000965  1  60                   RTS
000966  1               
000966  1               game_over_hp:
000966  1  A9 8F                LDA     #<go_hp
000968  1  A0 0B                LDY     #>go_hp
00096A  1  4C 71 09             JMP     game_over_common
00096D  1               game_over_food:
00096D  1  A9 AA                LDA     #<go_food
00096F  1  A0 0B                LDY     #>go_food
000971  1               ; fall through
000971  1               game_over_common:
000971  1  85 1C                STA     strp
000973  1  84 1D                STY     strp+1
000975  1  20 E2 30             JSR     cls_vram
000978  1  A2 16                LDX     #22
00097A  1  A0 08                LDY     #8
00097C  1  20 B4 31             JSR     locate
00097F  1  A9 09                LDA     #COLOR(CO_BRRED, CO_BLACK)
000981  1  8D 4A 06             STA     CURCOLOR
000984  1  A9 76 A0 0B          PRINTMSG over1
000988  1  20 C6 31     
00098B  1  A2 10                LDX     #16
00098D  1  A0 0A                LDY     #10
00098F  1  20 B4 31             JSR     locate
000992  1  A9 0F                LDA     #C_PANEL
000994  1  8D 4A 06             STA     CURCOLOR
000997  1  A5 1C                LDA     strp
000999  1  A4 1D                LDY     strp+1
00099B  1  20 C6 31             JSR     prmsg
00099E  1  A2 12                LDX     #18
0009A0  1  A0 0E                LDY     #14
0009A2  1  20 B4 31             JSR     locate
0009A5  1  A9 CA A0 0B          PRINTMSG anykey
0009A9  1  20 C6 31     
0009AC  1  20 16 0E             JSR     sfx_lose
0009AF  1  20 62 35             JSR     getkey_block
0009B2  1  60                   RTS
0009B3  1               
0009B3  1               ;==============================================================================
0009B3  1               ; exit_to_dos
0009B3  1               ;==============================================================================
0009B3  1               exit_to_dos:
0009B3  1  20 43 0C             JSR     psg_silence
0009B6  1               ; restore a normal console: 80-col, default colors, cursor on
0009B6  1  A9 39                LDA     #FC_SETMODE
0009B8  1  85 32                STA     farfunct
0009BA  1  A9 01                LDA     #1
0009BC  1  20 F0 FF             JSR     DO_FARCALL
0009BF  1  A2 07                LDX     #C_BLANK
0009C1  1  A0 E1                LDY     #CSRCOLOR_DEF
0009C3  1  A9 27 85 32          FARCALL FC_COLOR
0009C7  1  20 F0 FF     
0009CA  1  A9 26 85 32          FARCALL FC_SCNCLR
0009CE  1  20 F0 FF     
0009D1  1  A9 01                LDA     #1
0009D3  1  8D 49 06             STA     SHOWCRSR
0009D6  1  4C 00 01             JMP     BOOT            ; back to DOS/65
0009D9  1               
0009D9  1               CSRCOLOR_DEF    = $E1
0009D9  1               
0009D9  1               ;==============================================================================
0009D9  1               ; Title / end strings
0009D9  1               ;==============================================================================
0009D9  1               ttl1:
0009D9  1  2B 2D 2D 2D          .BYTE   "+--------------------------------+",0
0009DD  1  2D 2D 2D 2D  
0009E1  1  2D 2D 2D 2D  
0009FC  1               ttl2:
0009FC  1  7C 20 20 20          .BYTE   "|       W Y R M H O L D          |",0
000A00  1  20 20 20 20  
000A04  1  57 20 59 20  
000A1F  1               ttl3:
