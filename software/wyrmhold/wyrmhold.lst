000A5F  1               ; Title / end strings
000A5F  1               ;==============================================================================
000A5F  1               ttl1:
000A5F  1  2B 2D 2D 2D          .BYTE   "+--------------------------------+",0
000A63  1  2D 2D 2D 2D  
000A67  1  2D 2D 2D 2D  
000A82  1               ttl2:
000A82  1  7C 20 20 20          .BYTE   "|       W Y R M H O L D          |",0
000A86  1  20 20 20 20  
000A8A  1  57 20 59 20  
000AA5  1               ttl3:
000AA5  1  7C 20 20 20          .BYTE   "|     a quest for the 6502PC     |",0
000AA9  1  20 20 61 20  
000AAD  1  71 75 65 73  
000AC8  1               ttl4:
000AC8  1  2B 2D 2D 2D          .BYTE   "+--------------------------------+",0
000ACC  1  2D 2D 2D 2D  
000AD0  1  2D 2D 2D 2D  
000AEB  1               ttl_by:
000AEB  1  41 6E 73 77          .BYTE   "Answer the summons of Wyrmhold Castle",0
000AEF  1  65 72 20 74  
000AF3  1  68 65 20 73  
000B11  1               ttl_prompt:
000B11  1  50 72 65 73          .BYTE   "Press any key to begin thy quest",0
000B15  1  73 20 61 6E  
000B19  1  79 20 6B 65  
000B32  1               ttl_keys1:
000B32  1  4D 6F 76 65          .BYTE   "Move: W A S D (or H J K L)   G: guard   T: use/shop",0
000B36  1  3A 20 57 20  
000B3A  1  41 20 53 20  
000B66  1               ttl_keys2:
000B66  1  42 75 6D 70          .BYTE   "Bump monsters to fight.  ?: help   Q: quit to DOS",0
000B6A  1  20 6D 6F 6E  
