0018EB  2               
0018EB  1                       .INCLUDE "world.asm"
0018EB  2               ;______________________________________________________________________________
0018EB  2               ;  world.asm - map data, tile property tables and lookup helpers
0018EB  2               ;
0018EB  2               ;  Maps are authored as ASCII rows for readability and converted to
0018EB  2               ;  tile codes once at startup (map_decode).  The decoded tile grids
0018EB  2               ;  live in RAM (owmap / locmap).  Authoring characters:
0018EB  2               ;     . grass   & forest  ^ mountain  ~ water   h hills   % marsh
0018EB  2               ;     T town    O dungeon C castle    : road    = bridge
0018EB  2               ;     space->grass
0018EB  2               ;  For interiors (town/dungeon/castle/shrine):
0018EB  2               ;     . floor   # wall     + door(exit)  $ treasure  < stairs up
0018EB  2               ;     S shop    ~ water
0018EB  2               ;______________________________________________________________________________
0018EB  2               
0018EB  2               ;----------------------------------------------------------------
0018EB  2               ; Tile color table  (tile code -> color byte)
0018EB  2               ;----------------------------------------------------------------
0018EB  2               tile_color:
0018EB  2  2A                   .BYTE   C_GRASS         ; 0
0018EC  2  0A                   .BYTE   C_FOREST        ; 1
0018ED  2  8F                   .BYTE   C_MOUNT         ; 2
0018EE  2  1B                   .BYTE   C_WATER         ; 3
0018EF  2  4E                   .BYTE   C_TOWN          ; 4
0018F0  2  0B                   .BYTE   C_DUNG          ; 5
0018F1  2  8F                   .BYTE   C_CASTLE        ; 6
0018F2  2  4E                   .BYTE   C_ROAD          ; 7
0018F3  2  1E                   .BYTE   C_BRIDGE        ; 8
0018F4  2  08                   .BYTE   C_FLOOR         ; 9
0018F5  2  8F                   .BYTE   C_WALL          ; 10
0018F6  2  A0                   .BYTE   C_EXIT          ; 11 door (bright = exit)
0018F7  2  0E                   .BYTE   C_TREAS         ; 12
0018F8  2  A0                   .BYTE   C_EXIT          ; 13 stairs (bright = exit)
0018F9  2  4E                   .BYTE   C_TOWN          ; 14 shop
0018FA  2  2E                   .BYTE   C_HILLS         ; 15
0018FB  2  1A                   .BYTE   C_MARSH         ; 16
0018FC  2               
0018FC  2               ;----------------------------------------------------------------
0018FC  2               ; Tile variant table  (tile code -> alternate metatile base, or 0)
0018FC  2               ; A non-zero entry means this terrain has a 2nd art variant; the
0018FC  2               ; renderer may use it instead of the MG_* base for some map cells
0018FC  2               ; to break up the repeating-grid look. 0 = no variant (use base).
0018FC  2               ;----------------------------------------------------------------
0018FC  2               tile_variant:
0018FC  2  E0                   .BYTE   MGV_GRASS       ; 0  grass
0018FD  2  E4                   .BYTE   MGV_FOREST      ; 1  forest
0018FE  2  EC                   .BYTE   MGV_MOUNT       ; 2  mountain
0018FF  2  E8                   .BYTE   MGV_WATER       ; 3  water
001900  2  00                   .BYTE   0               ; 4  town
001901  2  00                   .BYTE   0               ; 5  dungeon
001902  2  00                   .BYTE   0               ; 6  castle
001903  2  00                   .BYTE   0               ; 7  road
001904  2  00                   .BYTE   0               ; 8  bridge
001905  2  00                   .BYTE   0               ; 9  floor
001906  2  00                   .BYTE   0               ; 10 wall
001907  2  00                   .BYTE   0               ; 11 door
001908  2  00                   .BYTE   0               ; 12 treasure
001909  2  00                   .BYTE   0               ; 13 stairs
00190A  2  00                   .BYTE   0               ; 14 shop
00190B  2  00                   .BYTE   0               ; 15 hills
00190C  2  00                   .BYTE   0               ; 16 marsh
00190D  2               
00190D  2               ;----------------------------------------------------------------
00190D  2               ; Tile property table  (tile code -> property bits)
00190D  2               ;   bit0 PASS    passable on foot
00190D  2               ;   bit1 WATER   water (impassable without ship)
00190D  2               ;   bit2 TOWN    stepping here enters a town
00190D  2               ;   bit3 DUNG    stepping here enters the dungeon
00190D  2               ;   bit4 EXIT    stepping here leaves the interior (town/dungeon)
00190D  2               ;   bit5 TREAS   treasure to collect
00190D  2               ;   bit6 SHOP    shop counter (open shop when adjacent/entering)
00190D  2               ;   bit7 CASTLE  stepping here enters Wyrmhold Castle
00190D  2               ;----------------------------------------------------------------
00190D  2               P_PASS          = $01
00190D  2               P_WATER         = $02
00190D  2               P_TOWN          = $04
00190D  2               P_DUNG          = $08
00190D  2               P_EXIT          = $10
00190D  2               P_TREAS         = $20
00190D  2               P_SHOP          = $40
00190D  2               P_CASTLE        = $80
00190D  2               
00190D  2               tile_prop:
00190D  2  01                   .BYTE   P_PASS          ; 0 grass
00190E  2  01                   .BYTE   P_PASS          ; 1 forest (passable, slow flavor)
00190F  2  00                   .BYTE   $00             ; 2 mountain (blocked)
001910  2  02                   .BYTE   P_WATER         ; 3 water (blocked on foot)
001911  2  05                   .BYTE   P_PASS|P_TOWN   ; 4 town
001912  2  09                   .BYTE   P_PASS|P_DUNG   ; 5 dungeon
001913  2  81                   .BYTE   P_PASS|P_CASTLE ; 6 castle
001914  2  01                   .BYTE   P_PASS          ; 7 road
001915  2  01                   .BYTE   P_PASS          ; 8 bridge
001916  2  01                   .BYTE   P_PASS          ; 9 floor
001917  2  00                   .BYTE   $00             ; 10 wall
001918  2  11                   .BYTE   P_PASS|P_EXIT   ; 11 door (exit interior)
001919  2  21                   .BYTE   P_PASS|P_TREAS  ; 12 treasure
00191A  2  11                   .BYTE   P_PASS|P_EXIT   ; 13 stairs up (exit dungeon)
00191B  2  41                   .BYTE   P_PASS|P_SHOP   ; 14 shop
00191C  2  01                   .BYTE   P_PASS          ; 15 hills
00191D  2  01                   .BYTE   P_PASS          ; 16 marsh
00191E  2               
00191E  2               ;----------------------------------------------------------------
00191E  2               ; Authoring char -> tile code translation (used by map_decode).
00191E  2               ; Two parallel tables: chars[] and codes[], terminated by $00.
00191E  2               ; The current decoder supplies the map-specific default tile:
00191E  2               ; grass outdoors and floor indoors. Thus '.' and unknown/space
00191E  2               ; characters become the appropriate default without a table entry.
00191E  2               ;----------------------------------------------------------------
00191E  2               dec_chars:
00191E  2  26 5E 7E 54          .BYTE   "&^~TOC:=#+$<Sh%", $00
001922  2  4F 43 3A 3D  
001926  2  23 2B 24 3C  
00192E  2               dec_codes:
00192E  2  01                   .BYTE   T_FOREST        ; &
00192F  2  02                   .BYTE   T_MOUNT         ; ^
001930  2  03                   .BYTE   T_WATER         ; ~
001931  2  04                   .BYTE   T_TOWN          ; T
001932  2  05                   .BYTE   T_DUNG          ; O
001933  2  06                   .BYTE   T_CASTLE        ; C
001934  2  07                   .BYTE   T_ROAD          ; :
001935  2  08                   .BYTE   T_BRIDGE        ; =
001936  2  0A                   .BYTE   T_WALL          ; #
001937  2  0B                   .BYTE   T_DOOR          ; +
001938  2  0C                   .BYTE   T_TREAS         ; $
001939  2  0D                   .BYTE   T_UPSTAIR       ; <
00193A  2  0E                   .BYTE   T_SHOP          ; S
00193B  2  0F                   .BYTE   T_HILLS         ; h
00193C  2  10                   .BYTE   T_MARSH         ; %
00193D  2               
00193D  2               ; map a single authoring char (A) to a tile code -> A
00193D  2               xlate_char:
00193D  2  85 20                STA     tmp0
00193F  2  A2 00                LDX     #0
001941  2               @f:
001941  2  BD 1E 19             LDA     dec_chars,X
001944  2  F0 07                BEQ     @nf
001946  2  C5 20                CMP     tmp0
001948  2  F0 06                BEQ     @ok
00194A  2  E8                   INX
00194B  2  D0 F4                BNE     @f
00194D  2               @nf:
00194D  2  A5 25                LDA     cnt1            ; map-specific default tile
00194F  2  60                   RTS
001950  2               @ok:
001950  2  BD 2E 19             LDA     dec_codes,X
001953  2  60                   RTS
001954  2               
001954  2               ;----------------------------------------------------------------
001954  2               ; map_decode - translate an authored ASCII map into a tile grid,
001954  2               ; row by row.  Each source row is a NUL-terminated string.  Rows
001954  2               ; shorter than the map width are padded with the map default; longer
001954  2               ; rows are truncated.  This makes exact source-row width unimportant.
001954  2               ;
001954  2               ;   IN : srcp -> first source row (rows packed back-to-back, each
001954  2               ;                NUL-terminated)
001954  2               ;        dstp -> destination tile-code buffer (width*height bytes)
001954  2               ;        tmp2 =  map width   (<=255)
001954  2               ;        tmp3 =  map height  (<=255)
001954  2               ;        cnt1 = default tile (grass outdoors, floor indoors)
001954  2               ;----------------------------------------------------------------
001954  2               ; NOTE: the column counter is kept in cnt0 (memory), NOT in X,
001954  2               ; because xlate_char clobbers X (it uses X as a search index).
001954  2               map_decode:
001954  2  A9 00                LDA     #0
001956  2  85 27                STA     rowidx          ; row counter
001958  2               @nextrow:
001958  2  A5 27                LDA     rowidx
00195A  2  C5 23                CMP     tmp3
00195C  2  B0 59                BCS     @done
00195E  2  A9 00                LDA     #0
001960  2  85 24                STA     cnt0            ; column within row
001962  2               @col:
001962  2  A5 24                LDA     cnt0
001964  2  C5 22                CMP     tmp2
001966  2  B0 1E                BCS     @rowfull
001968  2               ; cnt0 tracks column for width logic; srcp is the read head.
001968  2  A0 00                LDY     #0
00196A  2  B1 18                LDA     (srcp),Y
00196C  2  F0 27                BEQ     @padrow         ; early NUL -> pad rest with grass
00196E  2  20 3D 19             JSR     xlate_char      ; A=tile code (clobbers X)
001971  2  A0 00                LDY     #0
001973  2  91 1A                STA     (dstp),Y
001975  2               ; advance read head and dest
001975  2  E6 18                INC     srcp
001977  2  D0 02                BNE     :+
001979  2  E6 19                INC     srcp+1
00197B  2               :
00197B  2  E6 1A                INC     dstp
00197D  2  D0 02                BNE     :+
00197F  2  E6 1B                INC     dstp+1
001981  2               :
001981  2  E6 24                INC     cnt0
001983  2  4C 62 19             JMP     @col
001986  2               @rowfull:
001986  2               ; consume any extra source chars up to the terminating NUL
001986  2               @skip:
001986  2  A0 00                LDY     #0
001988  2  B1 18                LDA     (srcp),Y
00198A  2  F0 20                BEQ     @aftrow
00198C  2  E6 18                INC     srcp
00198E  2  D0 F6                BNE     @skip
001990  2  E6 19                INC     srcp+1
001992  2  4C 86 19             JMP     @skip
001995  2               @padrow:
001995  2               ; fill remaining columns (cnt0..width-1) with the map default
001995  2               @pad:
001995  2  A5 24                LDA     cnt0
001997  2  C5 22                CMP     tmp2
001999  2  B0 11                BCS     @aftrow
00199B  2  A5 25                LDA     cnt1
00199D  2  A0 00                LDY     #0
00199F  2  91 1A                STA     (dstp),Y
0019A1  2  E6 1A                INC     dstp
0019A3  2  D0 02                BNE     :+
0019A5  2  E6 1B                INC     dstp+1
0019A7  2               :
0019A7  2  E6 24                INC     cnt0
0019A9  2  4C 95 19             JMP     @pad
0019AC  2               @aftrow:
0019AC  2               ; step srcp past the row terminator NUL
0019AC  2  E6 18                INC     srcp
0019AE  2  D0 02                BNE     :+
0019B0  2  E6 19                INC     srcp+1
0019B2  2               :
0019B2  2  E6 27                INC     rowidx
0019B4  2  4C 58 19             JMP     @nextrow
0019B7  2               @done:
0019B7  2  60                   RTS
0019B8  2               
0019B8  2               ;----------------------------------------------------------------
0019B8  2               ; decode_world / decode_town / decode_dung / decode_castle / decode_shrine
0019B8  2               ;----------------------------------------------------------------
0019B8  2               decode_world:
0019B8  2  A9 7D 85 18          SETW16  srcp, ow_src
0019BC  2  A9 1B 85 19  
0019C0  2  A9 C1 85 1A          SETW16  dstp, owmap
0019C4  2  A9 52 85 1B  
0019C8  2  A9 00                LDA     #T_GRASS
0019CA  2  85 25                STA     cnt1
0019CC  2  A9 40                LDA     #OWW
0019CE  2  85 22                STA     tmp2
0019D0  2  A9 40                LDA     #OWH
0019D2  2  85 23                STA     tmp3
0019D4  2  4C 54 19             JMP     map_decode
0019D7  2               
0019D7  2               decode_town:
0019D7  2  A9 38 85 18          SETW16  srcp, town_src
0019DB  2  A9 2C 85 19  
0019DF  2  A9 C1 85 1A          SETW16  dstp, locmap
0019E3  2  A9 62 85 1B  
0019E7  2  A9 09                LDA     #T_FLOOR
0019E9  2  85 25                STA     cnt1
0019EB  2  A9 20                LDA     #TOWNW
0019ED  2  85 22                STA     tmp2
0019EF  2  A9 14                LDA     #TOWNH
0019F1  2  85 23                STA     tmp3
0019F3  2  4C 54 19             JMP     map_decode
0019F6  2               
0019F6  2               decode_dung:
0019F6  2  A9 CC 85 18          SETW16  srcp, dung_src
0019FA  2  A9 2E 85 19  
0019FE  2  A9 C1 85 1A          SETW16  dstp, locmap
001A02  2  A9 62 85 1B  
001A06  2  A9 09                LDA     #T_FLOOR
001A08  2  85 25                STA     cnt1
001A0A  2  A9 20                LDA     #DUNGW
001A0C  2  85 22                STA     tmp2
001A0E  2  A9 14                LDA     #DUNGH
001A10  2  85 23                STA     tmp3
001A12  2  4C 54 19             JMP     map_decode
001A15  2               
001A15  2               decode_castle:
001A15  2  A9 60 85 18          SETW16  srcp, castle_src
001A19  2  A9 31 85 19  
001A1D  2  A9 C1 85 1A          SETW16  dstp, locmap
001A21  2  A9 62 85 1B  
001A25  2  A9 09                LDA     #T_FLOOR
001A27  2  85 25                STA     cnt1
001A29  2  A9 20                LDA     #CASTLEW
001A2B  2  85 22                STA     tmp2
001A2D  2  A9 14                LDA     #CASTLEH
001A2F  2  85 23                STA     tmp3
001A31  2  4C 54 19             JMP     map_decode
001A34  2               
001A34  2               decode_shrine:
001A34  2  A9 F4 85 18          SETW16  srcp, shrine_src
001A38  2  A9 33 85 19  
001A3C  2  A9 C1 85 1A          SETW16  dstp, locmap
001A40  2  A9 62 85 1B  
001A44  2  A9 09                LDA     #T_FLOOR
001A46  2  85 25                STA     cnt1
001A48  2  A9 20                LDA     #SHRINEW
001A4A  2  85 22                STA     tmp2
001A4C  2  A9 14                LDA     #SHRINEH
001A4E  2  85 23                STA     tmp3
001A50  2  4C 54 19             JMP     map_decode
001A53  2               
001A53  2               ;----------------------------------------------------------------
001A53  2               ; tileat - read the tile code at (tgtx,tgty) from the ACTIVE map.
001A53  2               ;   IN : tgtx, tgty ; loc (LOC_*) selects map + width
001A53  2               ;   OUT: A = tile code, also stored in tgttile
001A53  2               ;        if out of bounds -> returns T_WATER (overworld) / T_WALL (int)
001A53  2               ;   Trashes ptr, tmp0, tmp1
001A53  2               ;----------------------------------------------------------------
001A53  2               tileat:
001A53  2  AD 77 51             LDA     loc
001A56  2  D0 52                BNE     @interior
001A58  2               ;--- overworld ---
001A58  2               ; bounds check 0..OWW-1 / 0..OWH-1
001A58  2  A5 2C                LDA     tgtx
001A5A  2  C9 40                CMP     #OWW
001A5C  2  B0 47                BCS     @oob_world
001A5E  2  A5 2D                LDA     tgty
001A60  2  C9 40                CMP     #OWH
001A62  2  B0 41                BCS     @oob_world
001A64  2               ; offset = tgty*OWW + tgtx  (OWW=64 -> *64)
001A64  2  A5 2D                LDA     tgty
001A66  2  85 10                STA     ptr
001A68  2  A9 00                LDA     #0
001A6A  2  85 11                STA     ptr+1
001A6C  2  06 10                ASL     ptr
001A6E  2  26 11                ROL     ptr+1           ; *2
001A70  2  06 10                ASL     ptr
001A72  2  26 11                ROL     ptr+1           ; *4
001A74  2  06 10                ASL     ptr
001A76  2  26 11                ROL     ptr+1           ; *8
001A78  2  06 10                ASL     ptr
001A7A  2  26 11                ROL     ptr+1           ; *16
001A7C  2  06 10                ASL     ptr
001A7E  2  26 11                ROL     ptr+1           ; *32
001A80  2  06 10                ASL     ptr
001A82  2  26 11                ROL     ptr+1           ; *64
001A84  2  18                   CLC
001A85  2  A5 10                LDA     ptr
001A87  2  65 2C                ADC     tgtx
001A89  2  85 10                STA     ptr
001A8B  2  A5 11                LDA     ptr+1
001A8D  2  69 00                ADC     #0
001A8F  2  85 11                STA     ptr+1
001A91  2               ; ptr += owmap base
001A91  2  18                   CLC
001A92  2  A5 10                LDA     ptr
001A94  2  69 C1                ADC     #<owmap
001A96  2  85 10                STA     ptr
001A98  2  A5 11                LDA     ptr+1
001A9A  2  69 52                ADC     #>owmap
001A9C  2  85 11                STA     ptr+1
001A9E  2  A0 00                LDY     #0
001AA0  2  B1 10                LDA     (ptr),Y
001AA2  2  85 2E                STA     tgttile
001AA4  2  60                   RTS
001AA5  2               @oob_world:
001AA5  2  A9 03                LDA     #T_WATER
001AA7  2  85 2E                STA     tgttile
001AA9  2  60                   RTS
001AAA  2               ;--- interior (town/dungeon): width = locw, height = loch ---
001AAA  2               @interior:
001AAA  2  A5 2C                LDA     tgtx
001AAC  2  CD 78 51             CMP     locw
001AAF  2  B0 44                BCS     @oob_int
001AB1  2  A5 2D                LDA     tgty
001AB3  2  CD 79 51             CMP     loch
001AB6  2  B0 3D                BCS     @oob_int
001AB8  2               ; offset = tgty*locw + tgtx  (locw is 32)
001AB8  2  A5 2D                LDA     tgty
001ABA  2  85 10                STA     ptr
001ABC  2  A9 00                LDA     #0
001ABE  2  85 11                STA     ptr+1
001AC0  2  06 10                ASL     ptr
001AC2  2  26 11                ROL     ptr+1           ; *2
001AC4  2  06 10                ASL     ptr
001AC6  2  26 11                ROL     ptr+1           ; *4
001AC8  2  06 10                ASL     ptr
001ACA  2  26 11                ROL     ptr+1           ; *8
001ACC  2  06 10                ASL     ptr
001ACE  2  26 11                ROL     ptr+1           ; *16
001AD0  2  06 10                ASL     ptr
001AD2  2  26 11                ROL     ptr+1           ; *32  (locw assumed 32)
001AD4  2  18                   CLC
001AD5  2  A5 10                LDA     ptr
001AD7  2  65 2C                ADC     tgtx
001AD9  2  85 10                STA     ptr
001ADB  2  A5 11                LDA     ptr+1
001ADD  2  69 00                ADC     #0
001ADF  2  85 11                STA     ptr+1
001AE1  2  18                   CLC
001AE2  2  A5 10                LDA     ptr
001AE4  2  69 C1                ADC     #<locmap
001AE6  2  85 10                STA     ptr
001AE8  2  A5 11                LDA     ptr+1
001AEA  2  69 62                ADC     #>locmap
001AEC  2  85 11                STA     ptr+1
001AEE  2  A0 00                LDY     #0
001AF0  2  B1 10                LDA     (ptr),Y
001AF2  2  85 2E                STA     tgttile
001AF4  2  60                   RTS
001AF5  2               @oob_int:
001AF5  2  A9 0A                LDA     #T_WALL
001AF7  2  85 2E                STA     tgttile
001AF9  2  60                   RTS
001AFA  2               
001AFA  2               ;----------------------------------------------------------------
001AFA  2               ; settile - write tile code A at (tgtx,tgty) in the active map.
001AFA  2               ;   Used to clear treasure chests once collected, etc.
001AFA  2               ;   Recomputes the address exactly like tileat.
001AFA  2               ;----------------------------------------------------------------
001AFA  2               settile:
001AFA  2  85 21                STA     tmp1            ; new tile
001AFC  2  20 06 1B             JSR     tile_addr       ; ptr -> cell
001AFF  2  A0 00                LDY     #0
001B01  2  A5 21                LDA     tmp1
001B03  2  91 10                STA     (ptr),Y
001B05  2  60                   RTS
001B06  2               
001B06  2               ; tile_addr - compute ptr -> active-map cell for (tgtx,tgty).
001B06  2               ; (assumes in-bounds; callers that might be OOB use tileat first)
001B06  2               tile_addr:
001B06  2  AD 77 51             LDA     loc
001B09  2  D0 3B                BNE     @int
001B0B  2  A5 2D                LDA     tgty
001B0D  2  85 10                STA     ptr
001B0F  2  A9 00                LDA     #0
001B11  2  85 11                STA     ptr+1
001B13  2  06 10                ASL     ptr
001B15  2  26 11                ROL     ptr+1
001B17  2  06 10                ASL     ptr
001B19  2  26 11                ROL     ptr+1
001B1B  2  06 10                ASL     ptr
001B1D  2  26 11                ROL     ptr+1
001B1F  2  06 10                ASL     ptr
001B21  2  26 11                ROL     ptr+1
001B23  2  06 10                ASL     ptr
001B25  2  26 11                ROL     ptr+1
001B27  2  06 10                ASL     ptr
001B29  2  26 11                ROL     ptr+1           ; *64
001B2B  2  18                   CLC
001B2C  2  A5 10                LDA     ptr
001B2E  2  65 2C                ADC     tgtx
001B30  2  85 10                STA     ptr
001B32  2  A5 11                LDA     ptr+1
001B34  2  69 00                ADC     #0
001B36  2  85 11                STA     ptr+1
001B38  2  18                   CLC
001B39  2  A5 10                LDA     ptr
001B3B  2  69 C1                ADC     #<owmap
001B3D  2  85 10                STA     ptr
001B3F  2  A5 11                LDA     ptr+1
001B41  2  69 52                ADC     #>owmap
001B43  2  85 11                STA     ptr+1
001B45  2  60                   RTS
001B46  2               @int:
001B46  2  A5 2D                LDA     tgty
001B48  2  85 10                STA     ptr
001B4A  2  A9 00                LDA     #0
001B4C  2  85 11                STA     ptr+1
001B4E  2  06 10                ASL     ptr
