001627  2               
001627  1                       .INCLUDE "title.asm"
001627  2               ;______________________________________________________________________________
001627  2               ;  title.asm - graphical title screen
001627  2               ;
001627  2               ;  Composes a colorful scene with direct-VRAM fills, the custom terrain
001627  2               ;  tiles, a big block-letter "WYRMHOLD" logo, and a dragon, rather than
001627  2               ;  plain ASCII text.
001627  2               ;______________________________________________________________________________
001627  2               
001627  2               ; big-letter logo geometry
001627  2               BL_W            = 5             ; cells per letter (incl. 1 col gap handled by caller)
001627  2               BL_H            = 5             ; rows per letter
001627  2               BL_ROW          = 3             ; top screen row of the logo
001627  2               BL_COL          = 8             ; left screen col of the logo
001627  2               
001627  2               ;----------------------------------------------------------------
001627  2               ; draw_title_scene - paint the whole title screen.
001627  2               ;----------------------------------------------------------------
001627  2               draw_title_scene:
001627  2  20 80 36             JSR     cls_vram
00162A  2  20 04 36             JSR     vid_enter
00162D  2               
00162D  2                       ; --- sky band (rows 0..9) : deep blue background ---
00162D  2  A9 00                LDA     #0
00162F  2  85 27                STA     rowidx
001631  2               @sky:
001631  2  A5 27                LDA     rowidx
001633  2  85 21                STA     tmp1
001635  2  A9 00                LDA     #0
001637  2  85 22                STA     tmp2
001639  2  A9 20                LDA     #space
00163B  2  85 23                STA     tmp3
00163D  2  A9 1F                LDA     #COLOR(CO_BRWHITE, CO_BLUE)
00163F  2  85 26                STA     colidx
001641  2  A9 50                LDA     #SCRW
001643  2  85 24                STA     cnt0
001645  2  20 A6 36             JSR     fillrow_vram
001648  2  E6 27                INC     rowidx
00164A  2  A5 27                LDA     rowidx
00164C  2  C9 0A                CMP     #10
00164E  2  D0 E1                BNE     @sky
001650  2               
001650  2                       ; sprinkle a few "stars" in the sky (asterisks)
001650  2  A9 2E                LDA     #'.'
001652  2  85 23                STA     tmp3
001654  2  A9 1F                LDA     #COLOR(CO_BRWHITE, CO_BLUE)
001656  2  85 26                STA     colidx
001658  2  A2 00                LDX     #0
00165A  2               @stars:
00165A  2  BD 41 18             LDA     star_row,X
00165D  2  85 21                STA     tmp1
00165F  2  BD 4B 18             LDA     star_col,X
001662  2  85 22                STA     tmp2
001664  2  DA                   PHX
001665  2  20 70 36             JSR     putcell
001668  2  FA                   PLX
001669  2  E8                   INX
00166A  2  E0 0A                CPX     #NSTARS
00166C  2  D0 EC                BNE     @stars
00166E  2               
00166E  2                       ; --- ground band (rows 16..23) : green ---
00166E  2  A9 10                LDA     #16
001670  2  85 27                STA     rowidx
001672  2               @grnd:
001672  2  A5 27                LDA     rowidx
001674  2  85 21                STA     tmp1
001676  2  A9 00                LDA     #0
001678  2  85 22                STA     tmp2
00167A  2  A9 01                LDA     #G_GRASS
00167C  2  85 23                STA     tmp3
00167E  2  A9 2A                LDA     #C_GRASS
001680  2  85 26                STA     colidx
001682  2  A9 50                LDA     #SCRW
001684  2  85 24                STA     cnt0
001686  2  20 A6 36             JSR     fillrow_vram
001689  2  E6 27                INC     rowidx
00168B  2  A5 27                LDA     rowidx
00168D  2  C9 18                CMP     #24
00168F  2  D0 E1                BNE     @grnd
001691  2               
001691  2                       ; --- a mountain range across the horizon (row 15) ---
001691  2  A9 0F                LDA     #15
001693  2  85 21                STA     tmp1
001695  2  A9 00                LDA     #0
001697  2  85 22                STA     tmp2
001699  2  A9 03                LDA     #G_MOUNT
00169B  2  85 23                STA     tmp3
00169D  2  A9 8F                LDA     #C_MOUNT
00169F  2  85 26                STA     colidx
0016A1  2  A9 50                LDA     #SCRW
0016A3  2  85 24                STA     cnt0
0016A5  2  20 A6 36             JSR     fillrow_vram
0016A8  2               
0016A8  2  20 13 36             JSR     vid_exit
0016AB  2               
0016AB  2                       ; --- scenery objects (single tiles) via putcell helper ---
0016AB  2  20 F9 16             JSR     draw_scenery
0016AE  2               
0016AE  2                       ; --- the big block-letter logo ---
0016AE  2  20 78 17             JSR     draw_logo
0016B1  2               
0016B1  2                       ; --- text: subtitle, prompt, controls (colored) ---
0016B1  2  A2 1A                LDX     #26
0016B3  2  A0 0A                LDY     #10
0016B5  2  20 52 37             JSR     locate
0016B8  2  A9 0B                LDA     #COLOR(CO_BRTURQ, CO_BLACK)
0016BA  2  8D 4A 06             STA     CURCOLOR
0016BD  2  A9 65 A0 0A          PRINTMSG ttl_by
0016C1  2  20 64 37     
0016C4  2               
0016C4  2  A2 17                LDX     #23
0016C6  2  A0 12                LDY     #18
0016C8  2  20 52 37             JSR     locate
0016CB  2  A9 0E                LDA     #COLOR(CO_BRYELLOW, CO_BLACK)
0016CD  2  8D 4A 06             STA     CURCOLOR
0016D0  2  A9 8B A0 0A          PRINTMSG ttl_prompt
0016D4  2  20 64 37     
0016D7  2               
0016D7  2  A2 14                LDX     #20
0016D9  2  A0 15                LDY     #21
0016DB  2  20 52 37             JSR     locate
0016DE  2  A9 0F                LDA     #COLOR(CO_BRWHITE, CO_BLACK)
0016E0  2  8D 4A 06             STA     CURCOLOR
0016E3  2  A9 AC A0 0A          PRINTMSG ttl_keys1
0016E7  2  20 64 37     
0016EA  2  A2 14                LDX     #20
0016EC  2  A0 16                LDY     #22
0016EE  2  20 52 37             JSR     locate
0016F1  2  A9 D5 A0 0A          PRINTMSG ttl_keys2
0016F5  2  20 64 37     
0016F8  2  60                   RTS
0016F9  2               
0016F9  2               ;----------------------------------------------------------------
0016F9  2               ; draw_scenery - place tile objects on the landscape: forests, a
0016F9  2               ; castle, a lake, and a big dragon (boss glyph) menacing the scene.
0016F9  2               ;----------------------------------------------------------------
0016F9  2               draw_scenery:
0016F9  2  20 04 36             JSR     vid_enter
0016FC  2                       ; forests dotted along the ground (row 16/17)
0016FC  2  A2 00                LDX     #0
0016FE  2               @trees:
0016FE  2  BD 55 18             LDA     tree_row,X
001701  2  85 21                STA     tmp1
001703  2  BD 5E 18             LDA     tree_col,X
001706  2  85 22                STA     tmp2
001708  2  A9 02                LDA     #G_FOREST
00170A  2  85 23                STA     tmp3
00170C  2  A9 0A                LDA     #C_FOREST
00170E  2  85 26                STA     colidx
001710  2  DA                   PHX
001711  2  20 70 36             JSR     putcell
001714  2  FA                   PLX
001715  2  E8                   INX
001716  2  E0 09                CPX     #NTREES
001718  2  D0 E4                BNE     @trees
00171A  2               
00171A  2                       ; a castle on the left hill (row 14-15 area)
00171A  2  A9 0E                LDA     #14
00171C  2  85 21                STA     tmp1
00171E  2  A9 06                LDA     #6
001720  2  85 22                STA     tmp2
001722  2  A9 07                LDA     #G_CASTLE
001724  2  85 23                STA     tmp3
001726  2  A9 8F                LDA     #C_CASTLE
001728  2  85 26                STA     colidx
00172A  2  20 70 36             JSR     putcell
00172D  2  A9 0E                LDA     #14
00172F  2  85 21                STA     tmp1
001731  2  A9 07                LDA     #7
001733  2  85 22                STA     tmp2
001735  2  20 70 36             JSR     putcell
001738  2               
001738  2                       ; a small lake on the right (row 17)
001738  2  A9 11                LDA     #17
00173A  2  85 21                STA     tmp1
00173C  2  A9 3E                LDA     #62
00173E  2  85 22                STA     tmp2
001740  2  A9 04                LDA     #G_WATER
001742  2  85 23                STA     tmp3
001744  2  A9 1B                LDA     #C_WATER
001746  2  85 26                STA     colidx
001748  2  A9 0A                LDA     #10
00174A  2  85 24                STA     cnt0
00174C  2  20 A6 36             JSR     fillrow_vram
00174F  2               
00174F  2                       ; the DRAGON - big and red, hovering at the right of the sky
00174F  2  A9 0C                LDA     #12
001751  2  85 21                STA     tmp1
001753  2  A9 3C                LDA     #60
001755  2  85 22                STA     tmp2
001757  2  A9 16                LDA     #G_BOSS
001759  2  85 23                STA     tmp3
00175B  2  A9 1C                LDA     #COLOR(CO_BRRED, CO_BLUE)
00175D  2  85 26                STA     colidx
00175F  2  20 70 36             JSR     putcell
001762  2                       ; a second dragon, smaller/left, different color
001762  2  A9 06                LDA     #6
001764  2  85 21                STA     tmp1
001766  2  A9 42                LDA     #66
001768  2  85 22                STA     tmp2
00176A  2  A9 16                LDA     #G_BOSS
00176C  2  85 23                STA     tmp3
00176E  2  A9 1E                LDA     #COLOR(CO_BRYELLOW, CO_BLUE)
001770  2  85 26                STA     colidx
001772  2  20 70 36             JSR     putcell
001775  2               
001775  2  4C 13 36             JMP     vid_exit
001778  2               
001778  2               ;----------------------------------------------------------------
001778  2               ; draw_logo - stamp the big block-letter "WYRMHOLD" logo using
001778  2               ; solid wall tiles in bright gold.  Each letter is a 5x5 bitmap
001778  2               ; (5 bytes, top bit = leftmost of 5 columns).  Letters are spaced
001778  2               ; BL_W+1 columns apart.
001778  2               ;----------------------------------------------------------------
001778  2               draw_logo:
001778  2  20 04 36             JSR     vid_enter
00177B  2  A9 00                LDA     #0
00177D  2  8D 8B 4D             STA     logo_li         ; letter index
001780  2               @letter:
001780  2  AD 8B 4D             LDA     logo_li
001783  2  C9 08                CMP     #8              ; 8 letters
001785  2  90 03                BCC     :+
001787  2  4C 16 18             JMP     @done
00178A  2               :
00178A  2                       ; pointer to this letter's 5 bytes:  logo_font + li*5
00178A  2  AD 8B 4D             LDA     logo_li
00178D  2  85 20                STA     tmp0
00178F  2  0A                   ASL     A               ; *2
001790  2  0A                   ASL     A               ; *4
001791  2  18                   CLC
001792  2  65 20                ADC     tmp0            ; *5
001794  2  A8                   TAY                     ; Y = li*5 offset into logo_font
001795  2                       ; left screen column for this letter = BL_COL + li*(BL_W+1)
001795  2  AD 8B 4D             LDA     logo_li
001798  2  85 20                STA     tmp0
00179A  2  0A                   ASL     A               ; *2
00179B  2  0A                   ASL     A               ; *4
00179C  2  18                   CLC
00179D  2  65 20                ADC     tmp0            ; *5
00179F  2  18                   CLC
0017A0  2  6D 8B 4D             ADC     logo_li         ; + li  -> li*6
0017A3  2  18                   CLC
0017A4  2  69 08                ADC     #BL_COL
0017A6  2  8D 8C 4D             STA     logo_lx         ; base column
0017A9  2                       ; draw 5 rows
0017A9  2  A9 00                LDA     #0
0017AB  2  8D 8D 4D             STA     logo_ry
0017AE  2               @row:
0017AE  2  AD 8D 4D             LDA     logo_ry
0017B1  2  C9 05                CMP     #BL_H
0017B3  2  B0 5B                BCS     @nextletter
0017B5  2                       ; fetch the bitmap byte for (li,row): logo_font[li*5 + row]
0017B5  2  98                   TYA
0017B6  2  18                   CLC
0017B7  2  6D 8D 4D             ADC     logo_ry
0017BA  2  AA                   TAX
0017BB  2  BD 19 18             LDA     logo_font,X
0017BE  2  8D 8F 4D             STA     logo_bits       ; 5 bits, bit4..bit0 = cols 0..4
0017C1  2                       ; draw 5 columns
0017C1  2  A9 00                LDA     #0
0017C3  2  8D 8E 4D             STA     logo_cx
0017C6  2               @col:
0017C6  2  AD 8E 4D             LDA     logo_cx
0017C9  2  C9 05                CMP     #BL_W
0017CB  2  B0 32                BCS     @nextrow
0017CD  2                       ; test bit (4 - cx) of logo_bits
0017CD  2  A9 10                LDA     #%00010000      ; bit4 mask
0017CF  2  AE 8E 4D             LDX     logo_cx
0017D2  2  F0 04                BEQ     @havemask
0017D4  2               @shr:
0017D4  2  4A                   LSR     A
0017D5  2  CA                   DEX
0017D6  2  D0 FC                BNE     @shr
0017D8  2               @havemask:
0017D8  2  2D 8F 4D             AND     logo_bits
0017DB  2  F0 1C                BEQ     @blank
0017DD  2                       ; set pixel -> solid gold block
0017DD  2  AD 8D 4D             LDA     logo_ry
0017E0  2  18                   CLC
0017E1  2  69 03                ADC     #BL_ROW
0017E3  2  85 21                STA     tmp1            ; screen row
0017E5  2  AD 8C 4D             LDA     logo_lx
0017E8  2  18                   CLC
0017E9  2  6D 8E 4D             ADC     logo_cx
0017EC  2  85 22                STA     tmp2            ; screen col
0017EE  2  A9 0B                LDA     #G_WALL
0017F0  2  85 23                STA     tmp3
0017F2  2  A9 4E                LDA     #COLOR(CO_BRYELLOW, CO_RED)
0017F4  2  85 26                STA     colidx
0017F6  2  20 70 36             JSR     putcell
0017F9  2               @blank:
0017F9  2  EE 8E 4D             INC     logo_cx
0017FC  2  4C C6 17             JMP     @col
0017FF  2               @nextrow:
0017FF  2  EE 8D 4D             INC     logo_ry
001802  2                       ; Y must be reloaded (clobbered above): recompute li*5
001802  2  AD 8B 4D             LDA     logo_li
001805  2  85 20                STA     tmp0
001807  2  0A                   ASL     A
001808  2  0A                   ASL     A
001809  2  18                   CLC
00180A  2  65 20                ADC     tmp0
00180C  2  A8                   TAY
00180D  2  4C AE 17             JMP     @row
001810  2               @nextletter:
001810  2  EE 8B 4D             INC     logo_li
001813  2  4C 80 17             JMP     @letter
001816  2               @done:
001816  2  4C 13 36             JMP     vid_exit
001819  2               
001819  2               ;----------------------------------------------------------------
001819  2               ; Big-letter 5x5 font for  W Y R M H O L D  (bit4..bit0 = 5 cols)
001819  2               ;----------------------------------------------------------------
001819  2               logo_font:
001819  2                       ; W
001819  2  11                   .BYTE   %10001
00181A  2  11                   .BYTE   %10001
00181B  2  15                   .BYTE   %10101
00181C  2  1B                   .BYTE   %11011
00181D  2  11                   .BYTE   %10001
00181E  2                       ; Y
00181E  2  11                   .BYTE   %10001
00181F  2  0A                   .BYTE   %01010
001820  2  04                   .BYTE   %00100
001821  2  04                   .BYTE   %00100
001822  2  04                   .BYTE   %00100
001823  2                       ; R
001823  2  1E                   .BYTE   %11110
001824  2  11                   .BYTE   %10001
001825  2  1E                   .BYTE   %11110
001826  2  12                   .BYTE   %10010
001827  2  11                   .BYTE   %10001
001828  2                       ; M
001828  2  11                   .BYTE   %10001
001829  2  1B                   .BYTE   %11011
00182A  2  15                   .BYTE   %10101
00182B  2  11                   .BYTE   %10001
00182C  2  11                   .BYTE   %10001
00182D  2                       ; H
00182D  2  11                   .BYTE   %10001
00182E  2  11                   .BYTE   %10001
00182F  2  1F                   .BYTE   %11111
001830  2  11                   .BYTE   %10001
001831  2  11                   .BYTE   %10001
001832  2                       ; O
001832  2  0E                   .BYTE   %01110
001833  2  11                   .BYTE   %10001
001834  2  11                   .BYTE   %10001
001835  2  11                   .BYTE   %10001
001836  2  0E                   .BYTE   %01110
001837  2                       ; L
001837  2  10                   .BYTE   %10000
001838  2  10                   .BYTE   %10000
001839  2  10                   .BYTE   %10000
00183A  2  10                   .BYTE   %10000
00183B  2  1F                   .BYTE   %11111
00183C  2                       ; D
00183C  2  1E                   .BYTE   %11110
00183D  2  11                   .BYTE   %10001
00183E  2  11                   .BYTE   %10001
00183F  2  11                   .BYTE   %10001
001840  2  1E                   .BYTE   %11110
001841  2               
001841  2               ;----------------------------------------------------------------
001841  2               ; decorative element positions
001841  2               ;----------------------------------------------------------------
001841  2               NSTARS  = 10
001841  2               star_row:
001841  2  01 02 00 03          .BYTE   1, 2, 0, 3, 1, 2, 0, 4, 1, 3
001845  2  01 02 00 04  
001849  2  01 03        
00184B  2               star_col:
00184B  2  04 0C 16 1E          .BYTE   4, 12, 22, 30, 44, 52, 58, 16, 70, 74
00184F  2  2C 34 3A 10  
001853  2  46 4A        
001855  2               
001855  2               NTREES  = 9
001855  2               tree_row:
001855  2  10 11 10 10          .BYTE   16, 17, 16, 16, 17, 16, 17, 16, 16
001859  2  11 10 11 10  
00185D  2  10           
