000BF2  1               
000BF2  1               ;==============================================================================
000BF2  1               ; Include the rest of the engine
000BF2  1               ;==============================================================================
000BF2  1                       .INCLUDE "rng.asm"
000BF2  2               ;______________________________________________________________________________
000BF2  2               ;  rng.asm - 16-bit xorshift pseudo-random generator
000BF2  2               ;______________________________________________________________________________
000BF2  2               
000BF2  2               ;----------------------------------------------------------------
000BF2  2               ; rng_seed - initialise the generator (avoid all-zero state).
000BF2  2               ;----------------------------------------------------------------
000BF2  2               rng_seed:
000BF2  2  A9 A3                LDA     #$A3
000BF4  2  85 30                STA     seedlo
000BF6  2  A9 1C                LDA     #$1C
000BF8  2  85 31                STA     seedhi
000BFA  2  60                   RTS
000BFB  2               
000BFB  2               ;----------------------------------------------------------------
000BFB  2               ; rng_next - advance the 16-bit xorshift state, return low byte
000BFB  2               ;            in A.  (xorshift: x ^= x<<7; x ^= x>>9; x ^= x<<8)
000BFB  2               ;----------------------------------------------------------------
000BFB  2               rng_next:
000BFB  2               ; x ^= x << 7
000BFB  2  A5 31                LDA     seedhi
000BFD  2  4A                   LSR     A               ; carry = bit7 of hi after some shifts...
000BFE  2               ; Implement x<<7 via: shift left 7 = shift right 1 then swap?
000BFE  2               ; Simpler: do a byte-wise xorshift that is "good enough".
000BFE  2               ; x ^= x << 7
000BFE  2  A5 30                LDA     seedlo
000C00  2  0A                   ASL     A
000C01  2  0A                   ASL     A
000C02  2  0A                   ASL     A
000C03  2  0A                   ASL     A
000C04  2  0A                   ASL     A
000C05  2  0A                   ASL     A
000C06  2  0A                   ASL     A               ; lo << 7 (only bit0 survives into bit7)
000C07  2  45 31                EOR     seedhi
000C09  2  85 31                STA     seedhi
000C0B  2               ; x ^= x >> 9  (>>9 of 16-bit = hi >> 1 into lo)
000C0B  2  A5 31                LDA     seedhi
000C0D  2  4A                   LSR     A
000C0E  2  45 30                EOR     seedlo
000C10  2  85 30                STA     seedlo
000C12  2               ; x ^= x << 8  (swap bytes contribution: lo ^ into hi)
000C12  2  A5 30                LDA     seedlo
000C14  2  45 31                EOR     seedhi
000C16  2  85 31                STA     seedhi
000C18  2  A5 30                LDA     seedlo
000C1A  2  60                   RTS
000C1B  2               
000C1B  2               ;----------------------------------------------------------------
000C1B  2               ; rng_mod - return a value 0..A-1 in A.  IN: A = modulus (1..255)
000C1B  2               ;           (uses repeated subtraction mask via AND for powers of
000C1B  2               ;            two is faster, but generic mod via subtract loop here)
000C1B  2               ;----------------------------------------------------------------
000C1B  2               rng_mod:
000C1B  2  85 23                STA     tmp3            ; modulus
000C1D  2  20 FB 0B             JSR     rng_next        ; A = random byte
000C20  2               ; reduce A mod tmp3 by subtraction
000C20  2               @rm:
000C20  2  C5 23                CMP     tmp3
000C22  2  90 06                BCC     @done
000C24  2  38                   SEC
000C25  2  E5 23                SBC     tmp3
000C27  2  4C 20 0C             JMP     @rm
000C2A  2               @done:
000C2A  2  60                   RTS
000C2B  2               
000C2B  2               ;----------------------------------------------------------------
000C2B  2               ; rng_d - roll a die: return 1..A in A.  IN: A = sides (1..255)
000C2B  2               ;----------------------------------------------------------------
000C2B  2               rng_d:
000C2B  2  20 1B 0C             JSR     rng_mod
000C2E  2  18                   CLC
000C2F  2  69 01                ADC     #1
000C31  2  60                   RTS
000C32  2               
000C32  1                       .INCLUDE "sound.asm"
000C32  2               ;______________________________________________________________________________
000C32  2               ;  sound.asm - AY-3-8910 PSG sound effects and cooperative music player
000C32  2               ;
000C32  2               ;  PSG access ported from software/dbasic/ay38910.asm (PPI at $E230).
000C32  2               ;  psgwr: A=register, Y=value        psgrd: A=register -> Y=value
000C32  2               ;
000C32  2               ;  AY register map:
000C32  2               ;    0/1  ch A tone period (lo / hi 4 bits)
000C32  2               ;    2/3  ch B tone period
000C32  2               ;    4/5  ch C tone period
000C32  2               ;    6    noise period (5 bits)
000C32  2               ;    7    mixer: bit clear = enabled. 0-2 tone A/B/C, 3-5 noise A/B/C
000C32  2               ;    8/9/10 ch A/B/C volume (0-15, bit4 = use envelope)
000C32  2               ;    11/12 envelope period
000C32  2               ;    13   envelope shape
000C32  2               ;______________________________________________________________________________
000C32  2               
000C32  2               PPI_BASE        = $E230
000C32  2               ppiPortA        = PPI_BASE+0
000C32  2               ppiPortB        = PPI_BASE+1
000C32  2               ppiPortC        = PPI_BASE+2
000C32  2               ppiControl      = PPI_BASE+3
000C32  2               
000C32  2               ;----------------------------------------------------------------
000C32  2               ; psg_init - put the PSG into a known, silent state
000C32  2               ;----------------------------------------------------------------
000C32  2               psg_init:
000C32  2  A9 80                LDA     #%10000000
000C34  2  8D 33 E2             STA     ppiControl
000C37  2  A9 10                LDA     #%00010000
000C39  2  8D 32 E2             STA     ppiPortC
000C3C  2  A9 00                LDA     #$00
000C3E  2  8D 31 E2             STA     ppiPortB
000C41  2  20 45 0C             JSR     clrpsg
000C44  2  60                   RTS
000C45  2               
000C45  2               ;----------------------------------------------------------------
000C45  2               ; clrpsg - zero all 16 registers, then disable all channels
000C45  2               ;----------------------------------------------------------------
000C45  2               clrpsg:
000C45  2  A2 00                LDX     #00
000C47  2  A0 00                LDY     #00
000C49  2               @cp1:
000C49  2  8A                   TXA
000C4A  2  20 77 0C             JSR     psgwr
000C4D  2  E8                   INX
000C4E  2  E0 10                CPX     #16
000C50  2  D0 F7                BNE     @cp1
000C52  2  A9 07                LDA     #07
000C54  2  A0 3F                LDY     #%00111111      ; all tone + noise disabled
000C56  2  20 77 0C             JSR     psgwr
000C59  2  60                   RTS
000C5A  2               
000C5A  2               ;----------------------------------------------------------------
000C5A  2               ; psg_silence - silence all three channels (volumes -> 0)
000C5A  2               ;----------------------------------------------------------------
000C5A  2               psg_silence:
000C5A  2  A9 08                LDA     #8
000C5C  2  A0 00                LDY     #0
000C5E  2  20 77 0C             JSR     psgwr
000C61  2  A9 09                LDA     #9
000C63  2  A0 00                LDY     #0
000C65  2  20 77 0C             JSR     psgwr
000C68  2  A9 0A                LDA     #10
000C6A  2  A0 00                LDY     #0
000C6C  2  20 77 0C             JSR     psgwr
000C6F  2  A9 07                LDA     #07
000C71  2  A0 3F                LDY     #%00111111
000C73  2  20 77 0C             JSR     psgwr
000C76  2  60                   RTS
000C77  2               
000C77  2               ;----------------------------------------------------------------
000C77  2               ; psgwr - write Y into PSG register A     (trashes A)
000C77  2               ;----------------------------------------------------------------
000C77  2               psgwr:
000C77  2  8D 31 E2             STA     ppiPortB        ; select register
000C7A  2  A9 1C                LDA     #%00011100      ; latch address
000C7C  2  8D 32 E2             STA     ppiPortC
000C7F  2  8D 32 E2             STA     ppiPortC
000C82  2  8D 32 E2             STA     ppiPortC
000C85  2  A9 10                LDA     #%00010000      ; inactive
000C87  2  8D 32 E2             STA     ppiPortC
000C8A  2  8D 32 E2             STA     ppiPortC
000C8D  2  8D 32 E2             STA     ppiPortC
000C90  2  98                   TYA
000C91  2  8D 31 E2             STA     ppiPortB        ; store data
000C94  2  8D 31 E2             STA     ppiPortB
000C97  2  8D 31 E2             STA     ppiPortB
000C9A  2  A9 14                LDA     #%00010100      ; latch data
000C9C  2  8D 32 E2             STA     ppiPortC
000C9F  2  8D 32 E2             STA     ppiPortC
000CA2  2  8D 32 E2             STA     ppiPortC
000CA5  2  A9 10                LDA     #%00010000      ; inactive
000CA7  2  8D 32 E2             STA     ppiPortC
000CAA  2  60                   RTS
000CAB  2               
000CAB  2               ;----------------------------------------------------------------
000CAB  2               ; psgrd - read PSG register A into Y      (trashes A)
000CAB  2               ;----------------------------------------------------------------
000CAB  2               psgrd:
000CAB  2  8D 31 E2             STA     ppiPortB        ; select register
000CAE  2  A9 1C                LDA     #%00011100      ; latch address
000CB0  2  8D 32 E2             STA     ppiPortC
000CB3  2  8D 32 E2             STA     ppiPortC
000CB6  2  8D 32 E2             STA     ppiPortC
000CB9  2  A9 10                LDA     #%00010000      ; inactive
000CBB  2  8D 32 E2             STA     ppiPortC
000CBE  2  8D 32 E2             STA     ppiPortC
000CC1  2  A9 82                LDA     #%10000010
000CC3  2  8D 33 E2             STA     ppiControl
000CC6  2  A9 18                LDA     #%00011000      ; latch data
000CC8  2  8D 32 E2             STA     ppiPortC
000CCB  2  8D 32 E2             STA     ppiPortC
000CCE  2  8D 32 E2             STA     ppiPortC
000CD1  2  AD 31 E2             LDA     ppiPortB        ; read data
000CD4  2  A8                   TAY
000CD5  2  A9 80                LDA     #%10000000
000CD7  2  8D 33 E2             STA     ppiControl
000CDA  2  A9 10                LDA     #%00010000      ; inactive
000CDC  2  8D 32 E2             STA     ppiPortC
000CDF  2  60                   RTS
000CE0  2               
000CE0  2               ;----------------------------------------------------------------
000CE0  2               ; tone_on - start a tone on channel A.
000CE0  2               ;   ptr (16-bit) = 12-bit tone period (lo in ptr, hi in ptr+1)
000CE0  2               ;   tmp0         = volume (0-15)
000CE0  2               ;----------------------------------------------------------------
000CE0  2               tone_on:
000CE0  2  A9 00                LDA     #0              ; ch A period low
000CE2  2  A4 10                LDY     ptr
000CE4  2  20 77 0C             JSR     psgwr
000CE7  2  A9 01                LDA     #1              ; ch A period high
000CE9  2  A4 11                LDY     ptr+1
000CEB  2  20 77 0C             JSR     psgwr
000CEE  2  A9 07                LDA     #07             ; mixer: enable tone A only
000CF0  2  A0 3E                LDY     #%00111110
000CF2  2  20 77 0C             JSR     psgwr
000CF5  2  A9 08                LDA     #8              ; ch A volume
000CF7  2  A4 20                LDY     tmp0
000CF9  2  20 77 0C             JSR     psgwr
000CFC  2  60                   RTS
000CFD  2               
000CFD  2               ;----------------------------------------------------------------
000CFD  2               ; busywait - crude delay.  X = outer count.
000CFD  2               ;----------------------------------------------------------------
000CFD  2               busywait:
000CFD  2               @bw0:
000CFD  2  A0 00                LDY     #0
000CFF  2               @bw1:
000CFF  2  A9 00                LDA     #0
000D01  2               @bw2:
000D01  2  18                   CLC
000D02  2  69 01                ADC     #1
000D04  2  C9 28                CMP     #40
000D06  2  D0 F9                BNE     @bw2
000D08  2  C8                   INY
000D09  2  D0 F4                BNE     @bw1
000D0B  2  CA                   DEX
000D0C  2  D0 EF                BNE     @bw0
000D0E  2  60                   RTS
000D0F  2               
000D0F  2               ;----------------------------------------------------------------
000D0F  2               ; mus_finewait - a short, fine-grained delay for tempo trimming.
000D0F  2               ; Spins MUS_FINEDELAY outer times, 256 inner each.  Much smaller
000D0F  2               ; than one busywait pass, so it gives sub-step tempo control.
000D0F  2               ;----------------------------------------------------------------
000D0F  2               mus_finewait:
000D0F  2  A2 46                LDX     #MUS_FINEDELAY
000D11  2  F0 08                BEQ     @done
000D13  2               @fw0:
000D13  2  A0 00                LDY     #0
000D15  2               @fw1:
000D15  2  C8                   INY
000D16  2  D0 FD                BNE     @fw1
000D18  2  CA                   DEX
000D19  2  D0 F8                BNE     @fw0
000D1B  2               @done:
000D1B  2  60                   RTS
000D1C  2               
000D1C  2               ;----------------------------------------------------------------
000D1C  2               ; SFX helpers.  Each plays a short, self-contained sound and
000D1C  2               ; silences the PSG afterwards.  All preserve nothing - callers
000D1C  2               ; must save anything they need.
000D1C  2               ;----------------------------------------------------------------
000D1C  2               
000D1C  2               ; sfx_move - very short low blip
000D1C  2               sfx_move:
000D1C  2  A9 40 85 10          SETW16  ptr, $0240
000D20  2  A9 02 85 11  
000D24  2  A9 06                LDA     #6
000D26  2  85 20                STA     tmp0
000D28  2  20 E0 0C             JSR     tone_on
000D2B  2  A2 02                LDX     #2
000D2D  2  20 FD 0C             JSR     busywait
000D30  2  4C 5A 0C             JMP     psg_silence
000D33  2               
000D33  2               ; sfx_blocked - low buzz (use noise)
000D33  2               sfx_blocked:
000D33  2  A9 06                LDA     #6              ; noise period
000D35  2  A0 14                LDY     #20
000D37  2  20 77 0C             JSR     psgwr
000D3A  2  A9 07                LDA     #07             ; enable noise A
000D3C  2  A0 37                LDY     #%00110111
000D3E  2  20 77 0C             JSR     psgwr
000D41  2  A9 08                LDA     #8
000D43  2  A0 0A                LDY     #10
000D45  2  20 77 0C             JSR     psgwr
000D48  2  A2 03                LDX     #3
000D4A  2  20 FD 0C             JSR     busywait
000D4D  2  4C 5A 0C             JMP     psg_silence
000D50  2               
000D50  2               ; sfx_hit - quick high zap
000D50  2               sfx_hit:
000D50  2  A9 C0 85 10          SETW16  ptr, $00C0
000D54  2  A9 00 85 11  
000D58  2  A9 0C                LDA     #12
000D5A  2  85 20                STA     tmp0
000D5C  2  20 E0 0C             JSR     tone_on
000D5F  2  A2 02                LDX     #2
000D61  2  20 FD 0C             JSR     busywait
000D64  2  A9 40 85 10          SETW16  ptr, $0140
000D68  2  A9 01 85 11  
000D6C  2  A9 0A                LDA     #10
000D6E  2  85 20                STA     tmp0
000D70  2  20 E0 0C             JSR     tone_on
000D73  2  A2 02                LDX     #2
000D75  2  20 FD 0C             JSR     busywait
000D78  2  4C 5A 0C             JMP     psg_silence
000D7B  2               
000D7B  2               ; sfx_breath_warn - rising intake before the dragon breathes
000D7B  2               sfx_breath_warn:
000D7B  2  A9 20 85 10          SETW16  ptr, $0320
000D7F  2  A9 03 85 11  
000D83  2  A9 09                LDA     #9
000D85  2  85 20                STA     tmp0
000D87  2  20 E0 0C             JSR     tone_on
000D8A  2  A2 02                LDX     #2
000D8C  2  20 FD 0C             JSR     busywait
000D8F  2  A9 20 85 10          SETW16  ptr, $0220
000D93  2  A9 02 85 11  
000D97  2  A9 0C                LDA     #12
000D99  2  85 20                STA     tmp0
000D9B  2  20 E0 0C             JSR     tone_on
000D9E  2  A2 03                LDX     #3
000DA0  2  20 FD 0C             JSR     busywait
000DA3  2  4C 5A 0C             JMP     psg_silence
000DA6  2               
000DA6  2               ; sfx_breath - forceful noise burst for dragon fire
000DA6  2               sfx_breath:
000DA6  2  A9 06                LDA     #6
000DA8  2  A0 03                LDY     #3
000DAA  2  20 77 0C             JSR     psgwr
000DAD  2  A9 07                LDA     #7
000DAF  2  A0 37                LDY     #%00110111
000DB1  2  20 77 0C             JSR     psgwr
000DB4  2  A9 08                LDA     #8
000DB6  2  A0 0F                LDY     #15
000DB8  2  20 77 0C             JSR     psgwr
000DBB  2  A2 05                LDX     #5
000DBD  2  20 FD 0C             JSR     busywait
000DC0  2  A9 06                LDA     #6
000DC2  2  A0 0A                LDY     #10
000DC4  2  20 77 0C             JSR     psgwr
000DC7  2  A9 08                LDA     #8
000DC9  2  A0 0B                LDY     #11
000DCB  2  20 77 0C             JSR     psgwr
000DCE  2  A2 04                LDX     #4
000DD0  2  20 FD 0C             JSR     busywait
000DD3  2  4C 5A 0C             JMP     psg_silence
000DD6  2               
000DD6  2               ; sfx_killed - falling tone + noise
000DD6  2               sfx_killed:
000DD6  2  A9 06                LDA     #6
000DD8  2  A0 10                LDY     #16
000DDA  2  20 77 0C             JSR     psgwr
000DDD  2  A9 07                LDA     #07
000DDF  2  A0 37                LDY     #%00110111
000DE1  2  20 77 0C             JSR     psgwr
000DE4  2  A9 08                LDA     #8
000DE6  2  A0 0D                LDY     #13
000DE8  2  20 77 0C             JSR     psgwr
000DEB  2  A2 05                LDX     #5
000DED  2  20 FD 0C             JSR     busywait
000DF0  2  4C 5A 0C             JMP     psg_silence
000DF3  2               
000DF3  2               ; sfx_treasure - bright rising arpeggio
000DF3  2               sfx_treasure:
000DF3  2  A9 50 85 10          SETW16  ptr, $0150
000DF7  2  A9 01 85 11  
000DFB  2  A9 0D                LDA     #13
000DFD  2  85 20                STA     tmp0
000DFF  2  20 E0 0C             JSR     tone_on
000E02  2  A2 02                LDX     #2
000E04  2  20 FD 0C             JSR     busywait
000E07  2  A9 FC 85 10          SETW16  ptr, $00FC
000E0B  2  A9 00 85 11  
000E0F  2  20 E0 0C             JSR     tone_on
000E12  2  A2 02                LDX     #2
000E14  2  20 FD 0C             JSR     busywait
000E17  2  A9 A8 85 10          SETW16  ptr, $00A8
000E1B  2  A9 00 85 11  
000E1F  2  20 E0 0C             JSR     tone_on
000E22  2  A2 03                LDX     #3
000E24  2  20 FD 0C             JSR     busywait
000E27  2  4C 5A 0C             JMP     psg_silence
000E2A  2               
000E2A  2               ; sfx_levelup - three ascending happy notes
000E2A  2               sfx_levelup:
000E2A  2  A9 FC 85 10          SETW16  ptr, $00FC
000E2E  2  A9 00 85 11  
000E32  2  A9 0E                LDA     #14
000E34  2  85 20                STA     tmp0
000E36  2  20 E0 0C             JSR     tone_on
000E39  2  A2 03                LDX     #3
000E3B  2  20 FD 0C             JSR     busywait
000E3E  2  A9 C8 85 10          SETW16  ptr, $00C8
000E42  2  A9 00 85 11  
000E46  2  20 E0 0C             JSR     tone_on
000E49  2  A2 03                LDX     #3
000E4B  2  20 FD 0C             JSR     busywait
000E4E  2  A9 A8 85 10          SETW16  ptr, $00A8
000E52  2  A9 00 85 11  
000E56  2  20 E0 0C             JSR     tone_on
000E59  2  A2 04                LDX     #4
000E5B  2  20 FD 0C             JSR     busywait
000E5E  2  4C 5A 0C             JMP     psg_silence
000E61  2               
000E61  2               ; sfx_door - short two-tone chime
000E61  2               sfx_door:
000E61  2  A9 80 85 10          SETW16  ptr, $0180
000E65  2  A9 01 85 11  
000E69  2  A9 0B                LDA     #11
000E6B  2  85 20                STA     tmp0
000E6D  2  20 E0 0C             JSR     tone_on
000E70  2  A2 02                LDX     #2
000E72  2  20 FD 0C             JSR     busywait
000E75  2  A9 20 85 10          SETW16  ptr, $0120
000E79  2  A9 01 85 11  
000E7D  2  20 E0 0C             JSR     tone_on
000E80  2  A2 03                LDX     #3
000E82  2  20 FD 0C             JSR     busywait
000E85  2  4C 5A 0C             JMP     psg_silence
000E88  2               
000E88  2               ; sfx_lose - long descending sad tone
000E88  2               sfx_lose:
000E88  2  A9 20 85 10          SETW16  ptr, $0120
000E8C  2  A9 01 85 11  
000E90  2  A9 0D                LDA     #13
000E92  2  85 20                STA     tmp0
000E94  2  20 E0 0C             JSR     tone_on
000E97  2  A2 06                LDX     #6
000E99  2  20 FD 0C             JSR     busywait
000E9C  2  A9 C0 85 10          SETW16  ptr, $01C0
000EA0  2  A9 01 85 11  
000EA4  2  20 E0 0C             JSR     tone_on
000EA7  2  A2 06                LDX     #6
000EA9  2  20 FD 0C             JSR     busywait
000EAC  2  A9 80 85 10          SETW16  ptr, $0280
000EB0  2  A9 02 85 11  
000EB4  2  20 E0 0C             JSR     tone_on
000EB7  2  A2 0A                LDX     #10
000EB9  2  20 FD 0C             JSR     busywait
000EBC  2  4C 5A 0C             JMP     psg_silence
000EBF  2               
000EBF  2               ; sfx_win - triumphant fanfare
000EBF  2               sfx_win:
000EBF  2  A9 FC 85 10          SETW16  ptr, $00FC
000EC3  2  A9 00 85 11  
000EC7  2  A9 0F                LDA     #15
000EC9  2  85 20                STA     tmp0
000ECB  2  20 E0 0C             JSR     tone_on
000ECE  2  A2 04                LDX     #4
000ED0  2  20 FD 0C             JSR     busywait
000ED3  2  A9 C8 85 10          SETW16  ptr, $00C8
000ED7  2  A9 00 85 11  
000EDB  2  20 E0 0C             JSR     tone_on
000EDE  2  A2 04                LDX     #4
000EE0  2  20 FD 0C             JSR     busywait
000EE3  2  A9 A8 85 10          SETW16  ptr, $00A8
000EE7  2  A9 00 85 11  
000EEB  2  20 E0 0C             JSR     tone_on
000EEE  2  A2 04                LDX     #4
000EF0  2  20 FD 0C             JSR     busywait
000EF3  2  A9 7E 85 10          SETW16  ptr, $007E
000EF7  2  A9 00 85 11  
000EFB  2  20 E0 0C             JSR     tone_on
000EFE  2  A2 0C                LDX     #12
000F00  2  20 FD 0C             JSR     busywait
000F03  2  4C 5A 0C             JMP     psg_silence
000F06  2               
000F06  2               ;==============================================================================
000F06  2               ;  Cooperative 3-channel title music player with hardware envelope.
000F06  2               ;
000F06  2               ;  Three independent voice tracks play simultaneously:
000F06  2               ;     channel A = lead melody   (uses the AY envelope generator so each
000F06  2               ;                                note has a soft attack/decay shape)
000F06  2               ;     channel B = counter/harmony (fixed mid volume)
000F06  2               ;     channel C = bass line       (fixed mid volume)
000F06  2               ;
000F06  2               ;  Each track is a list of events: (note, duration) byte pairs.
000F06  2               ;     note 0      = rest (silence this channel for the duration)
000F06  2               ;     note 1..47  = index into note_lo/note_hi period tables
000F06  2               ;     note $FF    = end marker -> loop the track from its start
000F06  2               ;     duration    = number of music ticks to hold (1..254)
000F06  2               ;
000F06  2               ;  music_tick is called once per title spin-loop iteration.  It paces
000F06  2               ;  itself with a short delay, then advances all three voices.
000F06  2               ;==============================================================================
000F06  2               
000F06  2               ; Tempo: each music tick waits busywait(1) plus an extra fine spin of
000F06  2               ; MUS_FINEDELAY * 256 loops.  delay=1 alone (FINE=0) was a little fast;
000F06  2               ; FINE=128 is about 1.5x slower.  Raise/lower MUS_FINEDELAY to taste.
000F06  2               MUS_TICKDELAY   = 1             ; busywait outer count per music tick
000F06  2               MUS_FINEDELAY   = 70            ; extra fine delay (0..255), tempo trim
000F06  2               
000F06  2               ; envelope shape values (reg 13)
000F06  2               ENV_DECAY       = %00000000     ; \____  single decay then off (plucky)
000F06  2               ENV_RAMP        = %00001000     ; \\\\   repeating saw (sustained pulse)
000F06  2               ENV_PERIOD      = $1800         ; 16-bit envelope period (attack/decay len)
000F06  2               MUS_VOL_B       = 8             ; harmony volume (gentle, under the lead)
000F06  2               MUS_VOL_C       = 13            ; bass volume (strong, so it is audible)
000F06  2               
000F06  2               ;----------------------------------------------------------------
000F06  2               ; music_start - reset all three voice cursors and program the AY
000F06  2               ; for music: all three tone channels enabled, envelope set up for
000F06  2               ; the lead.
000F06  2               ;----------------------------------------------------------------
000F06  2               music_start:
000F06  2               ; voice cursors -> track starts
000F06  2  A9 CF 8D 80          SETW16  mvA_ptr, trackA
000F0A  2  51 A9 10 8D  
000F0E  2  81 51        
000F10  2  A9 0C 8D 83          SETW16  mvB_ptr, trackB
000F14  2  51 A9 11 8D  
000F18  2  84 51        
000F1A  2  A9 1F 8D 86          SETW16  mvC_ptr, trackC
000F1E  2  51 A9 11 8D  
000F22  2  87 51        
000F24  2               ; all hold-counters = 0 so every voice fetches on the first tick.
000F24  2               ; (must load #0 fresh each time - SETW16 above left A non-zero,
000F24  2               ;  which is why B/C previously got garbage counts and went silent)
000F24  2  A9 00                LDA     #0
000F26  2  8D 82 51             STA     mvA_cnt
000F29  2  8D 85 51             STA     mvB_cnt
000F2C  2  8D 88 51             STA     mvC_cnt
000F2F  2               
000F2F  2               ; mixer: enable tone on A, B, C (noise off)  -> bits 0..2 clear
000F2F  2  A9 07                LDA     #07
000F31  2  A0 38                LDY     #%00111000
000F33  2  20 77 0C             JSR     psgwr
000F36  2               ; envelope period (regs 11/12) - sets attack/decay length.
000F36  2               ; longer = the plucked lead note rings out for more of its
000F36  2               ; duration before fading.  Tune ENV_PERIOD to taste.
000F36  2  A9 0B                LDA     #11
000F38  2  A0 00                LDY     #<ENV_PERIOD
000F3A  2  20 77 0C             JSR     psgwr
000F3D  2  A9 0C                LDA     #12
000F3F  2  A0 18                LDY     #>ENV_PERIOD
000F41  2  20 77 0C             JSR     psgwr
000F44  2               ; channel A volume register = use envelope (bit4 set)
000F44  2  A9 08                LDA     #8
000F46  2  A0 10                LDY     #%00010000
000F48  2  20 77 0C             JSR     psgwr
000F4B  2               ; channel B: gentle harmony pad ; channel C: strong bass
000F4B  2  A9 09                LDA     #9
000F4D  2  A0 08                LDY     #MUS_VOL_B
000F4F  2  20 77 0C             JSR     psgwr
000F52  2  A9 0A                LDA     #10
000F54  2  A0 0D                LDY     #MUS_VOL_C
000F56  2  20 77 0C             JSR     psgwr
000F59  2  60                   RTS
000F5A  2               
000F5A  2               ;----------------------------------------------------------------
000F5A  2               ; music_tick - advance all three voices by one tick.
000F5A  2               ;----------------------------------------------------------------
000F5A  2               music_tick:
000F5A  2  A2 01                LDX     #MUS_TICKDELAY
000F5C  2  20 FD 0C             JSR     busywait
000F5F  2  20 0F 0D             JSR     mus_finewait    ; fine tempo trim
000F62  2               
000F62  2               ; --- voice A (lead, envelope) ---
000F62  2  AD 82 51             LDA     mvA_cnt
000F65  2  F0 06                BEQ     @nextA
000F67  2  CE 82 51             DEC     mvA_cnt
000F6A  2  4C C2 0F             JMP     @doB
000F6D  2               @nextA:
000F6D  2  A9 CF 85 18          SETW16  srcp, trackA    ; (loop base, used if end marker hit)
000F71  2  A9 10 85 19  
000F75  2  AD 80 51             LDA     mvA_ptr
000F78  2  85 12                STA     ptr2
000F7A  2  AD 81 51             LDA     mvA_ptr+1
000F7D  2  85 13                STA     ptr2+1
000F7F  2  20 6B 10             JSR     mus_fetch       ; -> tmp0=note, tmp1=dur, ptr2 advanced
000F82  2               ; program channel A tone (regs 0/1) from the note
000F82  2  A6 20                LDX     tmp0
000F84  2  F0 1B                BEQ     @restA          ; rest
000F86  2  20 97 10             JSR     note_period     ; -> ptr = period for note X
000F89  2  A9 00                LDA     #0
000F8B  2  A4 10                LDY     ptr
000F8D  2  20 77 0C             JSR     psgwr
000F90  2  A9 01                LDA     #1
000F92  2  A4 11                LDY     ptr+1
000F94  2  20 77 0C             JSR     psgwr
000F97  2               ; (re)trigger the envelope by rewriting the shape register
000F97  2  A9 0D                LDA     #13
000F99  2  A0 00                LDY     #ENV_DECAY
000F9B  2  20 77 0C             JSR     psgwr
000F9E  2  4C A8 0F             JMP     @setA
000FA1  2               @restA:
000FA1  2               ; silence A for the rest: drop its volume to 0 (no envelope)
000FA1  2  A9 08                LDA     #8
000FA3  2  A0 00                LDY     #0
000FA5  2  20 77 0C             JSR     psgwr
000FA8  2               @setA:
000FA8  2               ; for a non-rest, make sure A uses the envelope again
000FA8  2  A5 20                LDA     tmp0
000FAA  2  F0 07                BEQ     @cntA
000FAC  2  A9 08                LDA     #8
000FAE  2  A0 10                LDY     #%00010000
000FB0  2  20 77 0C             JSR     psgwr
000FB3  2               @cntA:
000FB3  2  A5 21                LDA     tmp1
000FB5  2  8D 82 51             STA     mvA_cnt
000FB8  2  A5 12                LDA     ptr2
000FBA  2  8D 80 51             STA     mvA_ptr
000FBD  2  A5 13                LDA     ptr2+1
000FBF  2  8D 81 51             STA     mvA_ptr+1
000FC2  2               
000FC2  2               @doB:
000FC2  2               ; --- voice B (harmony, fixed volume on channel B) ---
000FC2  2  AD 85 51             LDA     mvB_cnt
000FC5  2  F0 06                BEQ     @nextB
000FC7  2  CE 85 51             DEC     mvB_cnt
000FCA  2  4C 17 10             JMP     @doC
000FCD  2               @nextB:
000FCD  2  A9 0C 85 18          SETW16  srcp, trackB
000FD1  2  A9 11 85 19  
000FD5  2  AD 83 51             LDA     mvB_ptr
000FD8  2  85 12                STA     ptr2
000FDA  2  AD 84 51             LDA     mvB_ptr+1
000FDD  2  85 13                STA     ptr2+1
000FDF  2  20 6B 10             JSR     mus_fetch
000FE2  2  A6 20                LDX     tmp0
000FE4  2  F0 1B                BEQ     @restB
000FE6  2  20 97 10             JSR     note_period
000FE9  2  A9 02                LDA     #2
000FEB  2  A4 10                LDY     ptr
000FED  2  20 77 0C             JSR     psgwr
000FF0  2  A9 03                LDA     #3
000FF2  2  A4 11                LDY     ptr+1
000FF4  2  20 77 0C             JSR     psgwr
000FF7  2  A9 09                LDA     #9              ; restore B volume
000FF9  2  A0 08                LDY     #MUS_VOL_B
000FFB  2  20 77 0C             JSR     psgwr
000FFE  2  4C 08 10             JMP     @cntB
001001  2               @restB:
001001  2  A9 09                LDA     #9
001003  2  A0 00                LDY     #0
001005  2  20 77 0C             JSR     psgwr
001008  2               @cntB:
001008  2  A5 21                LDA     tmp1
00100A  2  8D 85 51             STA     mvB_cnt
00100D  2  A5 12                LDA     ptr2
00100F  2  8D 83 51             STA     mvB_ptr
001012  2  A5 13                LDA     ptr2+1
001014  2  8D 84 51             STA     mvB_ptr+1
001017  2               
001017  2               @doC:
001017  2               ; --- voice C (bass, fixed volume on channel C) ---
001017  2  AD 88 51             LDA     mvC_cnt
00101A  2  F0 04                BEQ     @nextC
00101C  2  CE 88 51             DEC     mvC_cnt
00101F  2  60                   RTS
001020  2               @nextC:
001020  2  A9 1F 85 18          SETW16  srcp, trackC
001024  2  A9 11 85 19  
001028  2  AD 86 51             LDA     mvC_ptr
00102B  2  85 12                STA     ptr2
00102D  2  AD 87 51             LDA     mvC_ptr+1
001030  2  85 13                STA     ptr2+1
001032  2  20 6B 10             JSR     mus_fetch
001035  2  A6 20                LDX     tmp0
001037  2  F0 1B                BEQ     @restC
001039  2  20 97 10             JSR     note_period
00103C  2  A9 04                LDA     #4
00103E  2  A4 10                LDY     ptr
001040  2  20 77 0C             JSR     psgwr
001043  2  A9 05                LDA     #5
001045  2  A4 11                LDY     ptr+1
001047  2  20 77 0C             JSR     psgwr
00104A  2  A9 0A                LDA     #10             ; restore C volume
00104C  2  A0 0D                LDY     #MUS_VOL_C
00104E  2  20 77 0C             JSR     psgwr
001051  2  4C 5B 10             JMP     @cntC
001054  2               @restC:
001054  2  A9 0A                LDA     #10
001056  2  A0 00                LDY     #0
001058  2  20 77 0C             JSR     psgwr
00105B  2               @cntC:
00105B  2  A5 21                LDA     tmp1
00105D  2  8D 88 51             STA     mvC_cnt
001060  2  A5 12                LDA     ptr2
001062  2  8D 86 51             STA     mvC_ptr
001065  2  A5 13                LDA     ptr2+1
001067  2  8D 87 51             STA     mvC_ptr+1
00106A  2  60                   RTS
00106B  2               
00106B  2               ;----------------------------------------------------------------
00106B  2               ; mus_fetch - read one (note,dur) event from the track at ptr2.
00106B  2               ;   IN : ptr2 -> current event ; srcp -> track loop base
00106B  2               ;   OUT: tmp0 = note, tmp1 = duration, ptr2 advanced past the event.
00106B  2               ;        On an $FF end marker, ptr2 is reset to srcp and the first
00106B  2               ;        event of the track is returned.
00106B  2               ;----------------------------------------------------------------
00106B  2               mus_fetch:
00106B  2  A0 00                LDY     #0
00106D  2  B1 12                LDA     (ptr2),Y
00106F  2  C9 FF                CMP     #$FF
001071  2  D0 0C                BNE     @ok
001073  2               ; loop: reset ptr2 to track base (srcp)
001073  2  A5 18                LDA     srcp
001075  2  85 12                STA     ptr2
001077  2  A5 19                LDA     srcp+1
001079  2  85 13                STA     ptr2+1
00107B  2  A0 00                LDY     #0
00107D  2  B1 12                LDA     (ptr2),Y
00107F  2               @ok:
00107F  2  85 20                STA     tmp0            ; note
001081  2  C8                   INY
001082  2  B1 12                LDA     (ptr2),Y
001084  2               ; The voice loops "fetch when counter hits 0", and the fetch
001084  2               ; tick itself is the first tick of the note.  So a note must
001084  2               ; hold for (dur-1) MORE ticks after the fetch tick to last
001084  2               ; exactly dur ticks.  Subtract 1 here.  (All durations are >=2,
001084  2               ; so no underflow.)  This keeps voices with different note
001084  2               ; counts the same real length - otherwise B/C drift away from
001084  2               ; the lead because they have fewer/more notes per loop.
001084  2  38                   SEC
001085  2  E9 01                SBC     #1
001087  2  85 21                STA     tmp1            ; duration - 1
001089  2               ; advance ptr2 by 2
001089  2  18                   CLC
00108A  2  A5 12                LDA     ptr2
00108C  2  69 02                ADC     #2
00108E  2  85 12                STA     ptr2
001090  2  A5 13                LDA     ptr2+1
001092  2  69 00                ADC     #0
001094  2  85 13                STA     ptr2+1
001096  2  60                   RTS
001097  2               
001097  2               ;----------------------------------------------------------------
001097  2               ; note_period - look up the 16-bit AY tone period for note X (1..N)
001097  2               ;   OUT: ptr = period (lo/hi).  Note index is 1-based.
001097  2               ;----------------------------------------------------------------
001097  2               note_period:
001097  2  CA                   DEX                     ; tables are 0-based
001098  2  BD A3 10             LDA     note_lo,X
00109B  2  85 10                STA     ptr
00109D  2  BD B9 10             LDA     note_hi,X
0010A0  2  85 11                STA     ptr+1
0010A2  2  60                   RTS
0010A3  2               
0010A3  2               ;----------------------------------------------------------------
0010A3  2               ; Note period tables (16-bit AY tone periods), two+ octaves.
0010A3  2               ; Note numbers (1-based) used by the tracks:
0010A3  2               ;   1=C3  2=D3 3=E3 4=F3 5=G3 6=A3 7=B3
0010A3  2               ;   8=C4  9=D4 10=E4 11=F4 12=G4 13=A4 14=B4
0010A3  2               ;  15=C5 16=D5 17=E5 18=F5 19=G5 20=A5 21=B5
0010A3  2               ;  22=C6
0010A3  2               ; (a diatonic C-major set is plenty for a heroic theme)
0010A3  2               ;----------------------------------------------------------------
0010A3  2               note_lo:
0010A3  2  F0 82 20 F4          .BYTE   <1008, <898, <800, <756, <672, <600, <534; C3..B3
0010A7  2  A0 58 16     
0010AA  2  F8 C2 90 7A          .BYTE   <504,  <450, <400, <378, <336, <300, <267; C4..B4
0010AE  2  50 2C 0B     
0010B1  2  FC E1 C8 BD          .BYTE   <252,  <225, <200, <189, <168, <150, <133; C5..B5
0010B5  2  A8 96 85     
0010B8  2  7E                   .BYTE   <126            ; C6
0010B9  2               note_hi:
0010B9  2  03 03 03 02          .BYTE   >1008, >898, >800, >756, >672, >600, >534
0010BD  2  02 02 02     
0010C0  2  01 01 01 01          .BYTE   >504,  >450, >400, >378, >336, >300, >267
0010C4  2  01 01 01     
0010C7  2  00 00 00 00          .BYTE   >252,  >225, >200, >189, >168, >150, >133
0010CB  2  00 00 00     
0010CE  2  00                   .BYTE   >126
0010CF  2               
0010CF  2               ; note name -> index defines for readable tracks
0010CF  2               N_REST          = 0
0010CF  2               C3              = 1
0010CF  2               D3              = 2
0010CF  2               E3              = 3
0010CF  2               F3              = 4
0010CF  2               G3              = 5
0010CF  2               A3              = 6
0010CF  2               B3              = 7
0010CF  2               C4              = 8
0010CF  2               D4              = 9
0010CF  2               E4              = 10
0010CF  2               F4              = 11
0010CF  2               G4              = 12
0010CF  2               A4              = 13
0010CF  2               B4              = 14
0010CF  2               C5              = 15
0010CF  2               D5              = 16
0010CF  2               E5              = 17
0010CF  2               F5              = 18
0010CF  2               G5              = 19
0010CF  2               A5              = 20
0010CF  2               B5              = 21
0010CF  2               C6              = 22
0010CF  2               
0010CF  2               ;----------------------------------------------------------------
0010CF  2               ; The theme: a stately heroic tune in C major, 3 voices.
0010CF  2               ; Durations are in ticks; the three tracks are written so their
0010CF  2               ; total lengths line up over each phrase.
0010CF  2               ;----------------------------------------------------------------
0010CF  2               
0010CF  2               ; --- Channel A : lead melody ---
0010CF  2               ; Every phrase line totals 16 ticks so the lead stays locked in step
0010CF  2               ; with the 16-tick harmony (B) and bass (C) lines.  (Line 1 was 20
0010CF  2               ; ticks before, which drifted B/C out of phase each loop.)
0010CF  2               trackA:
0010CF  2  0C 04 0F 04          .BYTE   G4,4,  C5,4,  E5,4,  G5,2,  E5,2; 16
0010D3  2  11 04 13 02  
0010D7  2  11 02        
0010D9  2  12 04 11 04          .BYTE   F5,4,  E5,4,  D5,8; 16
0010DD  2  10 08        
0010DF  2  11 04 13 04          .BYTE   E5,4,  G5,4,  C6,6,  B5,2; 16
0010E3  2  16 06 15 02  
0010E7  2  14 04 13 04          .BYTE   A5,4,  G5,4,  E5,8; 16
0010EB  2  11 08        
0010ED  2  12 04 14 04          .BYTE   F5,4,  A5,4,  G5,4,  E5,4; 16
0010F1  2  13 04 11 04  
0010F5  2  10 04 12 04          .BYTE   D5,4,  F5,4,  E5,8; 16
0010F9  2  11 08        
0010FB  2  0F 04 11 04          .BYTE   C5,4,  E5,4,  G5,4,  C6,4; 16
0010FF  2  13 04 16 04  
001103  2  13 04 11 04          .BYTE   G5,4,  E5,4,  C5,8; 16
001107  2  0F 08        
001109  2  00 04                .BYTE   N_REST,4
00110B  2  FF                   .BYTE   $FF
00110C  2               
00110C  2               ; --- Channel B : sustained harmony, one note per phrase line.
00110C  2               ;     To stay consonant under a diatonic melody we use the FIFTH of
00110C  2               ;     each chord (perfect fifths never clash), in octave 4.
00110C  2               ;     Chords per line:  C  G  C  Am  F  G  C  C
00110C  2               ;     Fifths:           G  D  G  E   C  D  G  G
00110C  2               trackB:
00110C  2  0C 10                .BYTE   G4,16           ; C chord  (5th = G)
00110E  2  09 10                .BYTE   D4,16           ; G chord  (5th = D)
001110  2  0C 10                .BYTE   G4,16           ; C chord
001112  2  0A 10                .BYTE   E4,16           ; Am chord (5th = E)
001114  2  08 10                .BYTE   C4,16           ; F chord  (5th = C)
001116  2  09 10                .BYTE   D4,16           ; G chord
001118  2  0C 10                .BYTE   G4,16           ; C chord
00111A  2  0C 10                .BYTE   G4,16           ; C chord
00111C  2  00 04                .BYTE   N_REST,4
00111E  2  FF                   .BYTE   $FF
00111F  2               
00111F  2               ; --- Channel C : bass - the ROOT of each chord, re-struck halfway
00111F  2               ;     for a gentle pulse.  Same progression: C G C Am F G C C
00111F  2               trackC:
00111F  2  01 08 01 08          .BYTE   C3,8,  C3,8     ; C
001123  2  05 08 05 08          .BYTE   G3,8,  G3,8     ; G
001127  2  01 08 01 08          .BYTE   C3,8,  C3,8     ; C
00112B  2  06 08 06 08          .BYTE   A3,8,  A3,8     ; Am
00112F  2  04 08 04 08          .BYTE   F3,8,  F3,8     ; F
001133  2  05 08 05 08          .BYTE   G3,8,  G3,8     ; G
001137  2  01 08 01 08          .BYTE   C3,8,  C3,8     ; C
00113B  2  01 08 01 08          .BYTE   C3,8,  C3,8     ; C
00113F  2  00 04                .BYTE   N_REST,4
001141  2  FF                   .BYTE   $FF
001142  2               
001142  1                       .INCLUDE "tiles.asm"
001142  2               ;______________________________________________________________________________
001142  2               ;  tiles.asm - custom 8x8 character bitmaps for terrain, items, monsters
001142  2               ;
001142  2               ;  The memory-mapped video card has a writable character generator.
001142  2               ;  To redefine character N (see V_PATTERN in dbasic/screencmds.asm):
001142  2               ;     1. map video sub-page $F8 (VIDEOBANK) into CPU bank $A
001142  2               ;     2. write N to VideoCharGenOffset ($A002)
001142  2               ;     3. write 8 scanline bytes to VideoCharGenData ($A003)
001142  2               ;        (the hardware auto-advances through the 8 rows of the glyph)
001142  2               ;
001142  2               ;  Each bitmap is authored as 8 bytes, top row first, with bit7 as
001142  2               ;  the leftmost pixel. The video character generator displays bit0
001142  2               ;  on the left, so chargen_init reverses each scanline before upload.
001142  2               ;  Small title glyphs use control codes 1..31. Gameplay metatiles
001142  2               ;  use $80..$DF. Printable ASCII used by the UI remains intact.
001142  2               ;______________________________________________________________________________
001142  2               
001142  2               VideoCharGenOffset = $A002
001142  2               VideoCharGenData = $A003
001142  2               
001142  2               ;----------------------------------------------------------------
001142  2               ; cg_enter / cg_exit - map the character-generator RAM (page $F8)
001142  2               ; into bank $A and select task 1 (mirrors PAGE_ENTER/PAGE_EXIT).
001142  2               ;----------------------------------------------------------------
001142  2               cg_enter:
001142  2  A9 01                LDA     #$01            ; task 01 (driver)
001144  2  A2 0A                LDX     #$0A            ; CPU bank $A
001146  2  A0 F8                LDY     #VIDEOBANK      ; physical page $F8 (char generator)
001148  2  20 F6 FF             JSR     SETPAGE
00114B  2  A9 01                LDA     #$01
00114D  2  8D E0 EF             STA     PC6502_ACT_TASK
001150  2  60                   RTS
001151  2               cg_exit:
001151  2  A9 00                LDA     #$00
001153  2  8D E0 EF             STA     PC6502_ACT_TASK
001156  2  60                   RTS
001157  2               
001157  2               ;----------------------------------------------------------------
001157  2               ; reverse_glyph_byte - convert authored bit7-left rows to the
001157  2               ; character generator's bit0-left display order.
001157  2               ;   IN/OUT: A = scanline byte
001157  2               ;   trashes X,tmp0; preserves Y
001157  2               ;----------------------------------------------------------------
001157  2               reverse_glyph_byte:
001157  2  85 20                STA     tmp0
001159  2  A9 00                LDA     #0
00115B  2  A2 08                LDX     #8
00115D  2               @bit:
00115D  2  46 20                LSR     tmp0
00115F  2  2A                   ROL     A
001160  2  CA                   DEX
001161  2  D0 FA                BNE     @bit
001163  2  60                   RTS
001164  2               
001164  2               ;----------------------------------------------------------------
001164  2               ; chargen_init - upload every custom glyph bitmap.
001164  2               ;
001164  2               ; Driven by a table of (charcode, 8 bytes) records.  The table ends
001164  2               ; with a $00 charcode marker (code 0 is never one of ours).
001164  2               ;----------------------------------------------------------------
001164  2               chargen_init:
001164  2  20 42 11             JSR     cg_enter
001167  2  A9 9A 85 18          SETW16  srcp, glyphtab
00116B  2  A9 11 85 19  
00116F  2               @rec:
00116F  2  A0 00                LDY     #0
001171  2  B1 18                LDA     (srcp),Y        ; char code
001173  2  F0 22                BEQ     @done           ; 0 = end of table
001175  2  8D 02 A0             STA     VideoCharGenOffset
001178  2               ; write the 8 scanline bytes
001178  2  A0 01                LDY     #1
00117A  2               @row:
00117A  2  B1 18                LDA     (srcp),Y
00117C  2  20 57 11             JSR     reverse_glyph_byte
00117F  2  8D 03 A0             STA     VideoCharGenData
001182  2  C8                   INY
001183  2  C0 09                CPY     #9
001185  2  D0 F3                BNE     @row
001187  2               ; advance srcp by 9 (1 code + 8 data)
001187  2  18                   CLC
001188  2  A5 18                LDA     srcp
00118A  2  69 09                ADC     #9
00118C  2  85 18                STA     srcp
00118E  2  A5 19                LDA     srcp+1
001190  2  69 00                ADC     #0
001192  2  85 19                STA     srcp+1
001194  2  4C 6F 11             JMP     @rec
001197  2               @done:
001197  2  4C 51 11             JMP     cg_exit
00119A  2               
00119A  2               ;----------------------------------------------------------------
00119A  2               ; Glyph bitmap table: each row is  code, b0..b7
00119A  2               ;----------------------------------------------------------------
00119A  2               glyphtab:
00119A  2               
00119A  2               ; --- terrain ---------------------------------------------------
00119A  2               ; Terrain uses colored backgrounds and brighter foreground texture.
00119A  2               ; Adjoining cells therefore read as continuous landscape.
00119A  2               
00119A  2               ; grass: sparse blades over a green field
00119A  2  01                   .BYTE   G_GRASS
00119B  2  00                   .BYTE   %00000000
00119C  2  10                   .BYTE   %00010000
00119D  2  02                   .BYTE   %00000010
00119E  2  40                   .BYTE   %01000000
00119F  2  08                   .BYTE   %00001000
0011A0  2  00                   .BYTE   %00000000
0011A1  2  20                   .BYTE   %00100000
0011A2  2  04                   .BYTE   %00000100
0011A3  2               
0011A3  2               ; forest: broad evergreen silhouette
0011A3  2  02                   .BYTE   G_FOREST
0011A4  2  18                   .BYTE   %00011000
0011A5  2  3C                   .BYTE   %00111100
0011A6  2  7E                   .BYTE   %01111110
0011A7  2  3C                   .BYTE   %00111100
0011A8  2  7E                   .BYTE   %01111110
0011A9  2  FF                   .BYTE   %11111111
0011AA  2  18                   .BYTE   %00011000
0011AB  2  3C                   .BYTE   %00111100
0011AC  2               
