0015F1  1                       .INCLUDE "title.asm"
0015F1  2               ;______________________________________________________________________________
0015F1  2               ;  title.asm - graphical title screen
0015F1  2               ;
0015F1  2               ;  Composes a colorful scene with direct-VRAM fills, the custom terrain
0015F1  2               ;  tiles, a big block-letter "WYRMHOLD" logo, and a dragon, rather than
0015F1  2               ;  plain ASCII text.
0015F1  2               ;______________________________________________________________________________
0015F1  2               
0015F1  2               ; big-letter logo geometry
0015F1  2               BL_W            = 5             ; cells per letter (incl. 1 col gap handled by caller)
0015F1  2               BL_H            = 5             ; rows per letter
0015F1  2               BL_ROW          = 3             ; top screen row of the logo
0015F1  2               BL_COL          = 8             ; left screen col of the logo
0015F1  2               
0015F1  2               ;----------------------------------------------------------------
0015F1  2               ; draw_title_scene - paint the whole title screen.
0015F1  2               ;----------------------------------------------------------------
0015F1  2               draw_title_scene:
0015F1  2  20 E2 30             JSR     cls_vram
0015F4  2  20 66 30             JSR     vid_enter
0015F7  2               
0015F7  2                       ; --- sky band (rows 0..9) : deep blue background ---
0015F7  2  A9 00                LDA     #0
0015F9  2  85 27                STA     rowidx
0015FB  2               @sky:
0015FB  2  A5 27                LDA     rowidx
0015FD  2  85 21                STA     tmp1
0015FF  2  A9 00                LDA     #0
001601  2  85 22                STA     tmp2
001603  2  A9 20                LDA     #space
001605  2  85 23                STA     tmp3
001607  2  A9 4F                LDA     #COLOR(CO_BRWHITE, CO_BLUE)
001609  2  85 26                STA     colidx
00160B  2  A9 50                LDA     #SCRW
00160D  2  85 24                STA     cnt0
00160F  2  20 08 31             JSR     fillrow_vram
001612  2  E6 27                INC     rowidx
001614  2  A5 27                LDA     rowidx
001616  2  C9 0A                CMP     #10
001618  2  D0 E1                BNE     @sky
00161A  2               
00161A  2                       ; sprinkle a few "stars" in the sky (asterisks)
00161A  2  A9 2E                LDA     #'.'
00161C  2  85 23                STA     tmp3
00161E  2  A9 4F                LDA     #COLOR(CO_BRWHITE, CO_BLUE)
001620  2  85 26                STA     colidx
001622  2  A2 00                LDX     #0
001624  2               @stars:
001624  2  BD 0B 18             LDA     star_row,X
001627  2  85 21                STA     tmp1
001629  2  BD 15 18             LDA     star_col,X
00162C  2  85 22                STA     tmp2
00162E  2  DA                   PHX
00162F  2  20 D2 30             JSR     putcell
001632  2  FA                   PLX
001633  2  E8                   INX
001634  2  E0 0A                CPX     #NSTARS
001636  2  D0 EC                BNE     @stars
001638  2               
001638  2                       ; --- ground band (rows 16..23) : green ---
001638  2  A9 10                LDA     #16
00163A  2  85 27                STA     rowidx
00163C  2               @grnd:
00163C  2  A5 27                LDA     rowidx
00163E  2  85 21                STA     tmp1
001640  2  A9 00                LDA     #0
001642  2  85 22                STA     tmp2
001644  2  A9 01                LDA     #G_GRASS
001646  2  85 23                STA     tmp3
001648  2  A9 2A                LDA     #C_GRASS
00164A  2  85 26                STA     colidx
00164C  2  A9 50                LDA     #SCRW
00164E  2  85 24                STA     cnt0
001650  2  20 08 31             JSR     fillrow_vram
001653  2  E6 27                INC     rowidx
001655  2  A5 27                LDA     rowidx
001657  2  C9 18                CMP     #24
001659  2  D0 E1                BNE     @grnd
00165B  2               
00165B  2                       ; --- a mountain range across the horizon (row 15) ---
00165B  2  A9 0F                LDA     #15
00165D  2  85 21                STA     tmp1
00165F  2  A9 00                LDA     #0
001661  2  85 22                STA     tmp2
001663  2  A9 03                LDA     #G_MOUNT
001665  2  85 23                STA     tmp3
001667  2  A9 8F                LDA     #C_MOUNT
001669  2  85 26                STA     colidx
00166B  2  A9 50                LDA     #SCRW
00166D  2  85 24                STA     cnt0
00166F  2  20 08 31             JSR     fillrow_vram
001672  2               
001672  2  20 75 30             JSR     vid_exit
001675  2               
001675  2                       ; --- scenery objects (single tiles) via putcell helper ---
001675  2  20 C3 16             JSR     draw_scenery
001678  2               
001678  2                       ; --- the big block-letter logo ---
001678  2  20 42 17             JSR     draw_logo
00167B  2               
00167B  2                       ; --- text: subtitle, prompt, controls (colored) ---
00167B  2  A2 1A                LDX     #26
00167D  2  A0 0A                LDY     #10
00167F  2  20 B4 31             JSR     locate
001682  2  A9 0E                LDA     #COLOR(CO_BRCYAN, CO_BLACK)
001684  2  8D 4A 06             STA     CURCOLOR
001687  2  A9 65 A0 0A          PRINTMSG ttl_by
00168B  2  20 C6 31     
00168E  2               
00168E  2  A2 17                LDX     #23
001690  2  A0 12                LDY     #18
001692  2  20 B4 31             JSR     locate
001695  2  A9 0B                LDA     #COLOR(CO_BRYELLOW, CO_BLACK)
001697  2  8D 4A 06             STA     CURCOLOR
00169A  2  A9 89 A0 0A          PRINTMSG ttl_prompt
00169E  2  20 C6 31     
0016A1  2               
0016A1  2  A2 14                LDX     #20
0016A3  2  A0 15                LDY     #21
0016A5  2  20 B4 31             JSR     locate
0016A8  2  A9 0F                LDA     #COLOR(CO_BRWHITE, CO_BLACK)
0016AA  2  8D 4A 06             STA     CURCOLOR
0016AD  2  A9 AA A0 0A          PRINTMSG ttl_keys1
0016B1  2  20 C6 31     
0016B4  2  A2 14                LDX     #20
0016B6  2  A0 16                LDY     #22
0016B8  2  20 B4 31             JSR     locate
0016BB  2  A9 D3 A0 0A          PRINTMSG ttl_keys2
0016BF  2  20 C6 31     
0016C2  2  60                   RTS
0016C3  2               
0016C3  2               ;----------------------------------------------------------------
0016C3  2               ; draw_scenery - place tile objects on the landscape: forests, a
0016C3  2               ; castle, a lake, and a big dragon (boss glyph) menacing the scene.
0016C3  2               ;----------------------------------------------------------------
0016C3  2               draw_scenery:
0016C3  2  20 66 30             JSR     vid_enter
0016C6  2                       ; forests dotted along the ground (row 16/17)
0016C6  2  A2 00                LDX     #0
0016C8  2               @trees:
0016C8  2  BD 1F 18             LDA     tree_row,X
0016CB  2  85 21                STA     tmp1
0016CD  2  BD 28 18             LDA     tree_col,X
0016D0  2  85 22                STA     tmp2
0016D2  2  A9 02                LDA     #G_FOREST
0016D4  2  85 23                STA     tmp3
0016D6  2  A9 0A                LDA     #C_FOREST
0016D8  2  85 26                STA     colidx
0016DA  2  DA                   PHX
0016DB  2  20 D2 30             JSR     putcell
0016DE  2  FA                   PLX
0016DF  2  E8                   INX
0016E0  2  E0 09                CPX     #NTREES
0016E2  2  D0 E4                BNE     @trees
0016E4  2               
0016E4  2                       ; a castle on the left hill (row 14-15 area)
0016E4  2  A9 0E                LDA     #14
0016E6  2  85 21                STA     tmp1
0016E8  2  A9 06                LDA     #6
0016EA  2  85 22                STA     tmp2
0016EC  2  A9 07                LDA     #G_CASTLE
0016EE  2  85 23                STA     tmp3
0016F0  2  A9 8F                LDA     #C_CASTLE
0016F2  2  85 26                STA     colidx
0016F4  2  20 D2 30             JSR     putcell
0016F7  2  A9 0E                LDA     #14
0016F9  2  85 21                STA     tmp1
0016FB  2  A9 07                LDA     #7
0016FD  2  85 22                STA     tmp2
0016FF  2  20 D2 30             JSR     putcell
001702  2               
001702  2                       ; a small lake on the right (row 17)
001702  2  A9 11                LDA     #17
001704  2  85 21                STA     tmp1
001706  2  A9 3E                LDA     #62
001708  2  85 22                STA     tmp2
00170A  2  A9 04                LDA     #G_WATER
00170C  2  85 23                STA     tmp3
00170E  2  A9 4E                LDA     #C_WATER
001710  2  85 26                STA     colidx
001712  2  A9 0A                LDA     #10
001714  2  85 24                STA     cnt0
001716  2  20 08 31             JSR     fillrow_vram
001719  2               
001719  2                       ; the DRAGON - big and red, hovering at the right of the sky
001719  2  A9 0C                LDA     #12
00171B  2  85 21                STA     tmp1
00171D  2  A9 3C                LDA     #60
00171F  2  85 22                STA     tmp2
001721  2  A9 16                LDA     #G_BOSS
001723  2  85 23                STA     tmp3
001725  2  A9 49                LDA     #COLOR(CO_BRRED, CO_BLUE)
001727  2  85 26                STA     colidx
001729  2  20 D2 30             JSR     putcell
00172C  2                       ; a second dragon, smaller/left, different color
00172C  2  A9 06                LDA     #6
00172E  2  85 21                STA     tmp1
001730  2  A9 42                LDA     #66
001732  2  85 22                STA     tmp2
001734  2  A9 16                LDA     #G_BOSS
001736  2  85 23                STA     tmp3
001738  2  A9 4B                LDA     #COLOR(CO_BRYELLOW, CO_BLUE)
00173A  2  85 26                STA     colidx
00173C  2  20 D2 30             JSR     putcell
00173F  2               
00173F  2  4C 75 30             JMP     vid_exit
001742  2               
001742  2               ;----------------------------------------------------------------
001742  2               ; draw_logo - stamp the big block-letter "WYRMHOLD" logo using
001742  2               ; solid wall tiles in bright gold.  Each letter is a 5x5 bitmap
001742  2               ; (5 bytes, top bit = leftmost of 5 columns).  Letters are spaced
001742  2               ; BL_W+1 columns apart.
001742  2               ;----------------------------------------------------------------
001742  2               draw_logo:
001742  2  20 66 30             JSR     vid_enter
001745  2  A9 00                LDA     #0
001747  2  8D 64 41             STA     logo_li         ; letter index
00174A  2               @letter:
00174A  2  AD 64 41             LDA     logo_li
00174D  2  C9 08                CMP     #8              ; 8 letters
00174F  2  90 03                BCC     :+
001751  2  4C E0 17             JMP     @done
001754  2               :
001754  2                       ; pointer to this letter's 5 bytes:  logo_font + li*5
001754  2  AD 64 41             LDA     logo_li
001757  2  85 20                STA     tmp0
001759  2  0A                   ASL     A               ; *2
00175A  2  0A                   ASL     A               ; *4
00175B  2  18                   CLC
00175C  2  65 20                ADC     tmp0            ; *5
00175E  2  A8                   TAY                     ; Y = li*5 offset into logo_font
00175F  2                       ; left screen column for this letter = BL_COL + li*(BL_W+1)
00175F  2  AD 64 41             LDA     logo_li
001762  2  85 20                STA     tmp0
001764  2  0A                   ASL     A               ; *2
001765  2  0A                   ASL     A               ; *4
001766  2  18                   CLC
001767  2  65 20                ADC     tmp0            ; *5
001769  2  18                   CLC
00176A  2  6D 64 41             ADC     logo_li         ; + li  -> li*6
00176D  2  18                   CLC
00176E  2  69 08                ADC     #BL_COL
001770  2  8D 65 41             STA     logo_lx         ; base column
001773  2                       ; draw 5 rows
001773  2  A9 00                LDA     #0
001775  2  8D 66 41             STA     logo_ry
001778  2               @row:
001778  2  AD 66 41             LDA     logo_ry
00177B  2  C9 05                CMP     #BL_H
00177D  2  B0 5B                BCS     @nextletter
00177F  2                       ; fetch the bitmap byte for (li,row): logo_font[li*5 + row]
00177F  2  98                   TYA
001780  2  18                   CLC
001781  2  6D 66 41             ADC     logo_ry
001784  2  AA                   TAX
001785  2  BD E3 17             LDA     logo_font,X
001788  2  8D 68 41             STA     logo_bits       ; 5 bits, bit4..bit0 = cols 0..4
00178B  2                       ; draw 5 columns
00178B  2  A9 00                LDA     #0
00178D  2  8D 67 41             STA     logo_cx
001790  2               @col:
001790  2  AD 67 41             LDA     logo_cx
001793  2  C9 05                CMP     #BL_W
001795  2  B0 32                BCS     @nextrow
001797  2                       ; test bit (4 - cx) of logo_bits
001797  2  A9 10                LDA     #%00010000      ; bit4 mask
001799  2  AE 67 41             LDX     logo_cx
00179C  2  F0 04                BEQ     @havemask
00179E  2               @shr:
00179E  2  4A                   LSR     A
00179F  2  CA                   DEX
0017A0  2  D0 FC                BNE     @shr
0017A2  2               @havemask:
0017A2  2  2D 68 41             AND     logo_bits
0017A5  2  F0 1C                BEQ     @blank
0017A7  2                       ; set pixel -> solid gold block
0017A7  2  AD 66 41             LDA     logo_ry
0017AA  2  18                   CLC
0017AB  2  69 03                ADC     #BL_ROW
0017AD  2  85 21                STA     tmp1            ; screen row
0017AF  2  AD 65 41             LDA     logo_lx
0017B2  2  18                   CLC
0017B3  2  6D 67 41             ADC     logo_cx
0017B6  2  85 22                STA     tmp2            ; screen col
0017B8  2  A9 0B                LDA     #G_WALL
0017BA  2  85 23                STA     tmp3
0017BC  2  A9 1B                LDA     #COLOR(CO_BRYELLOW, CO_RED)
0017BE  2  85 26                STA     colidx
0017C0  2  20 D2 30             JSR     putcell
0017C3  2               @blank:
0017C3  2  EE 67 41             INC     logo_cx
0017C6  2  4C 90 17             JMP     @col
0017C9  2               @nextrow:
0017C9  2  EE 66 41             INC     logo_ry
0017CC  2                       ; Y must be reloaded (clobbered above): recompute li*5
0017CC  2  AD 64 41             LDA     logo_li
0017CF  2  85 20                STA     tmp0
0017D1  2  0A                   ASL     A
0017D2  2  0A                   ASL     A
0017D3  2  18                   CLC
0017D4  2  65 20                ADC     tmp0
0017D6  2  A8                   TAY
0017D7  2  4C 78 17             JMP     @row
0017DA  2               @nextletter:
0017DA  2  EE 64 41             INC     logo_li
0017DD  2  4C 4A 17             JMP     @letter
0017E0  2               @done:
0017E0  2  4C 75 30             JMP     vid_exit
0017E3  2               
0017E3  2               ;----------------------------------------------------------------
0017E3  2               ; Big-letter 5x5 font for  W Y R M H O L D  (bit4..bit0 = 5 cols)
0017E3  2               ;----------------------------------------------------------------
0017E3  2               logo_font:
0017E3  2                       ; W
0017E3  2  11                   .BYTE   %10001
0017E4  2  11                   .BYTE   %10001
0017E5  2  15                   .BYTE   %10101
0017E6  2  1B                   .BYTE   %11011
0017E7  2  11                   .BYTE   %10001
0017E8  2                       ; Y
0017E8  2  11                   .BYTE   %10001
0017E9  2  0A                   .BYTE   %01010
0017EA  2  04                   .BYTE   %00100
0017EB  2  04                   .BYTE   %00100
0017EC  2  04                   .BYTE   %00100
0017ED  2                       ; R
0017ED  2  1E                   .BYTE   %11110
0017EE  2  11                   .BYTE   %10001
0017EF  2  1E                   .BYTE   %11110
0017F0  2  12                   .BYTE   %10010
0017F1  2  11                   .BYTE   %10001
0017F2  2                       ; M
0017F2  2  11                   .BYTE   %10001
0017F3  2  1B                   .BYTE   %11011
0017F4  2  15                   .BYTE   %10101
0017F5  2  11                   .BYTE   %10001
0017F6  2  11                   .BYTE   %10001
0017F7  2                       ; H
0017F7  2  11                   .BYTE   %10001
0017F8  2  11                   .BYTE   %10001
0017F9  2  1F                   .BYTE   %11111
0017FA  2  11                   .BYTE   %10001
0017FB  2  11                   .BYTE   %10001
0017FC  2                       ; O
0017FC  2  0E                   .BYTE   %01110
0017FD  2  11                   .BYTE   %10001
0017FE  2  11                   .BYTE   %10001
0017FF  2  11                   .BYTE   %10001
001800  2  0E                   .BYTE   %01110
001801  2                       ; L
001801  2  10                   .BYTE   %10000
001802  2  10                   .BYTE   %10000
001803  2  10                   .BYTE   %10000
001804  2  10                   .BYTE   %10000
001805  2  1F                   .BYTE   %11111
001806  2                       ; D
001806  2  1E                   .BYTE   %11110
001807  2  11                   .BYTE   %10001
001808  2  11                   .BYTE   %10001
001809  2  11                   .BYTE   %10001
00180A  2  1E                   .BYTE   %11110
00180B  2               
00180B  2               ;----------------------------------------------------------------
00180B  2               ; decorative element positions
00180B  2               ;----------------------------------------------------------------
00180B  2               NSTARS  = 10
00180B  2               star_row:
00180B  2  01 02 00 03          .BYTE   1, 2, 0, 3, 1, 2, 0, 4, 1, 3
00180F  2  01 02 00 04  
001813  2  01 03        
001815  2               star_col:
001815  2  04 0C 16 1E          .BYTE   4, 12, 22, 30, 44, 52, 58, 16, 70, 74
001819  2  2C 34 3A 10  
00181D  2  46 4A        
00181F  2               
00181F  2               NTREES  = 9
00181F  2               tree_row:
00181F  2  10 11 10 10          .BYTE   16, 17, 16, 16, 17, 16, 17, 16, 16
001823  2  11 10 11 10  
001827  2  10           
001828  2               tree_col:
001828  2  12 18 1E 26          .BYTE   18, 24, 30, 38, 44, 50, 14, 56, 34
00182C  2  2C 32 0E 38  
001830  2  22           
001831  2               
001831  1                       .INCLUDE "world.asm"
001831  2               ;______________________________________________________________________________
001831  2               ;  world.asm - map data, tile property tables and lookup helpers
001831  2               ;
001831  2               ;  Maps are authored as ASCII rows for readability and converted to
001831  2               ;  tile codes once at startup (map_decode).  The decoded tile grids
001831  2               ;  live in RAM (owmap / locmap).  Authoring characters:
001831  2               ;     . grass   & forest  ^ mountain  ~ water   h hills   % marsh
001831  2               ;     T town    O dungeon C castle    : road    = bridge
001831  2               ;     space->grass
001831  2               ;  For interiors (town/dungeon):
001831  2               ;     . floor   # wall     + door(exit)  $ treasure  < stairs up
001831  2               ;     S shop    ~ water
001831  2               ;______________________________________________________________________________
001831  2               
001831  2               ;----------------------------------------------------------------
001831  2               ; Tile color table  (tile code -> color byte)
001831  2               ;----------------------------------------------------------------
001831  2               tile_color:
001831  2  2A                   .BYTE   C_GRASS         ; 0
001832  2  0A                   .BYTE   C_FOREST        ; 1
001833  2  8F                   .BYTE   C_MOUNT         ; 2
001834  2  4E                   .BYTE   C_WATER         ; 3
001835  2  1B                   .BYTE   C_TOWN          ; 4
001836  2  0D                   .BYTE   C_DUNG          ; 5
001837  2  8F                   .BYTE   C_CASTLE        ; 6
001838  2  1B                   .BYTE   C_ROAD          ; 7
001839  2  4B                   .BYTE   C_BRIDGE        ; 8
00183A  2  08                   .BYTE   C_FLOOR         ; 9
00183B  2  8F                   .BYTE   C_WALL          ; 10
00183C  2  A0                   .BYTE   C_EXIT          ; 11 door (bright = exit)
00183D  2  0B                   .BYTE   C_TREAS         ; 12
00183E  2  A0                   .BYTE   C_EXIT          ; 13 stairs (bright = exit)
00183F  2  1B                   .BYTE   C_TOWN          ; 14 shop
001840  2  2B                   .BYTE   C_HILLS         ; 15
001841  2  4A                   .BYTE   C_MARSH         ; 16
001842  2               
001842  2               ;----------------------------------------------------------------
001842  2               ; Tile variant table  (tile code -> alternate metatile base, or 0)
001842  2               ; A non-zero entry means this terrain has a 2nd art variant; the
001842  2               ; renderer may use it instead of the MG_* base for some map cells
001842  2               ; to break up the repeating-grid look. 0 = no variant (use base).
001842  2               ;----------------------------------------------------------------
001842  2               tile_variant:
001842  2  E0                   .BYTE   MGV_GRASS       ; 0  grass
001843  2  E4                   .BYTE   MGV_FOREST      ; 1  forest
001844  2  EC                   .BYTE   MGV_MOUNT       ; 2  mountain
001845  2  E8                   .BYTE   MGV_WATER       ; 3  water
001846  2  00                   .BYTE   0               ; 4  town
001847  2  00                   .BYTE   0               ; 5  dungeon
001848  2  00                   .BYTE   0               ; 6  castle
001849  2  00                   .BYTE   0               ; 7  road
00184A  2  00                   .BYTE   0               ; 8  bridge
00184B  2  00                   .BYTE   0               ; 9  floor
00184C  2  00                   .BYTE   0               ; 10 wall
00184D  2  00                   .BYTE   0               ; 11 door
00184E  2  00                   .BYTE   0               ; 12 treasure
00184F  2  00                   .BYTE   0               ; 13 stairs
001850  2  00                   .BYTE   0               ; 14 shop
001851  2  00                   .BYTE   0               ; 15 hills
001852  2  00                   .BYTE   0               ; 16 marsh
001853  2               
001853  2               ;----------------------------------------------------------------
001853  2               ; Tile property table  (tile code -> property bits)
001853  2               ;   bit0 PASS    passable on foot
001853  2               ;   bit1 WATER   water (impassable without ship)
001853  2               ;   bit2 TOWN    stepping here enters a town
001853  2               ;   bit3 DUNG    stepping here enters the dungeon
001853  2               ;   bit4 EXIT    stepping here leaves the interior (town/dungeon)
001853  2               ;   bit5 TREAS   treasure to collect
001853  2               ;   bit6 SHOP    shop counter (open shop when adjacent/entering)
001853  2               ;----------------------------------------------------------------
001853  2               P_PASS          = $01
001853  2               P_WATER         = $02
001853  2               P_TOWN          = $04
001853  2               P_DUNG          = $08
001853  2               P_EXIT          = $10
001853  2               P_TREAS         = $20
001853  2               P_SHOP          = $40
001853  2               
001853  2               tile_prop:
001853  2  01                   .BYTE   P_PASS          ; 0 grass
001854  2  01                   .BYTE   P_PASS          ; 1 forest (passable, slow flavor)
001855  2  00                   .BYTE   $00             ; 2 mountain (blocked)
001856  2  02                   .BYTE   P_WATER         ; 3 water (blocked on foot)
001857  2  05                   .BYTE   P_PASS|P_TOWN   ; 4 town
001858  2  09                   .BYTE   P_PASS|P_DUNG   ; 5 dungeon
001859  2  00                   .BYTE   $00             ; 6 castle (blocked, decorative)
00185A  2  01                   .BYTE   P_PASS          ; 7 road
00185B  2  01                   .BYTE   P_PASS          ; 8 bridge
00185C  2  01                   .BYTE   P_PASS          ; 9 floor
00185D  2  00                   .BYTE   $00             ; 10 wall
00185E  2  11                   .BYTE   P_PASS|P_EXIT   ; 11 door (exit interior)
00185F  2  21                   .BYTE   P_PASS|P_TREAS  ; 12 treasure
001860  2  11                   .BYTE   P_PASS|P_EXIT   ; 13 stairs up (exit dungeon)
001861  2  41                   .BYTE   P_PASS|P_SHOP   ; 14 shop
001862  2  01                   .BYTE   P_PASS          ; 15 hills
001863  2  01                   .BYTE   P_PASS          ; 16 marsh
001864  2               
001864  2               ;----------------------------------------------------------------
001864  2               ; Authoring char -> tile code translation (used by map_decode).
001864  2               ; Two parallel tables: chars[] and codes[], terminated by $00.
001864  2               ; The current decoder supplies the map-specific default tile:
001864  2               ; grass outdoors and floor indoors. Thus '.' and unknown/space
001864  2               ; characters become the appropriate default without a table entry.
001864  2               ;----------------------------------------------------------------
001864  2               dec_chars:
001864  2  26 5E 7E 54          .BYTE   "&^~TOC:=#+$<Sh%", $00
001868  2  4F 43 3A 3D  
00186C  2  23 2B 24 3C  
001874  2               dec_codes:
001874  2  01                   .BYTE   T_FOREST        ; &
001875  2  02                   .BYTE   T_MOUNT         ; ^
001876  2  03                   .BYTE   T_WATER         ; ~
001877  2  04                   .BYTE   T_TOWN          ; T
001878  2  05                   .BYTE   T_DUNG          ; O
001879  2  06                   .BYTE   T_CASTLE        ; C
00187A  2  07                   .BYTE   T_ROAD          ; :
00187B  2  08                   .BYTE   T_BRIDGE        ; =
00187C  2  0A                   .BYTE   T_WALL          ; #
00187D  2  0B                   .BYTE   T_DOOR          ; +
00187E  2  0C                   .BYTE   T_TREAS         ; $
00187F  2  0D                   .BYTE   T_UPSTAIR       ; <
001880  2  0E                   .BYTE   T_SHOP          ; S
001881  2  0F                   .BYTE   T_HILLS         ; h
001882  2  10                   .BYTE   T_MARSH         ; %
001883  2               
001883  2               ; map a single authoring char (A) to a tile code -> A
001883  2               xlate_char:
001883  2  85 20                STA     tmp0
001885  2  A2 00                LDX     #0
001887  2               @f:
001887  2  BD 64 18             LDA     dec_chars,X
00188A  2  F0 07                BEQ     @nf
00188C  2  C5 20                CMP     tmp0
00188E  2  F0 06                BEQ     @ok
001890  2  E8                   INX
001891  2  D0 F4                BNE     @f
001893  2               @nf:
001893  2  A5 25                LDA     cnt1            ; map-specific default tile
001895  2  60                   RTS
001896  2               @ok:
001896  2  BD 74 18             LDA     dec_codes,X
001899  2  60                   RTS
00189A  2               
00189A  2               ;----------------------------------------------------------------
00189A  2               ; map_decode - translate an authored ASCII map into a tile grid,
00189A  2               ; row by row.  Each source row is a NUL-terminated string.  Rows
00189A  2               ; shorter than the map width are padded with the map default; longer
00189A  2               ; rows are truncated.  This makes exact source-row width unimportant.
00189A  2               ;
00189A  2               ;   IN : srcp -> first source row (rows packed back-to-back, each
00189A  2               ;                NUL-terminated)
00189A  2               ;        dstp -> destination tile-code buffer (width*height bytes)
00189A  2               ;        tmp2 =  map width   (<=255)
00189A  2               ;        tmp3 =  map height  (<=255)
00189A  2               ;        cnt1 = default tile (grass outdoors, floor indoors)
00189A  2               ;----------------------------------------------------------------
00189A  2               ; NOTE: the column counter is kept in cnt0 (memory), NOT in X,
00189A  2               ; because xlate_char clobbers X (it uses X as a search index).
00189A  2               map_decode:
00189A  2  A9 00                LDA     #0
00189C  2  85 27                STA     rowidx          ; row counter
00189E  2               @nextrow:
00189E  2  A5 27                LDA     rowidx
0018A0  2  C5 23                CMP     tmp3
0018A2  2  B0 59                BCS     @done
0018A4  2  A9 00                LDA     #0
0018A6  2  85 24                STA     cnt0            ; column within row
0018A8  2               @col:
0018A8  2  A5 24                LDA     cnt0
0018AA  2  C5 22                CMP     tmp2
0018AC  2  B0 1E                BCS     @rowfull
0018AE  2               ; cnt0 tracks column for width logic; srcp is the read head.
0018AE  2  A0 00                LDY     #0
0018B0  2  B1 18                LDA     (srcp),Y
0018B2  2  F0 27                BEQ     @padrow         ; early NUL -> pad rest with grass
0018B4  2  20 83 18             JSR     xlate_char      ; A=tile code (clobbers X)
0018B7  2  A0 00                LDY     #0
0018B9  2  91 1A                STA     (dstp),Y
0018BB  2               ; advance read head and dest
0018BB  2  E6 18                INC     srcp
0018BD  2  D0 02                BNE     :+
0018BF  2  E6 19                INC     srcp+1
0018C1  2               :
0018C1  2  E6 1A                INC     dstp
0018C3  2  D0 02                BNE     :+
0018C5  2  E6 1B                INC     dstp+1
0018C7  2               :
0018C7  2  E6 24                INC     cnt0
0018C9  2  4C A8 18             JMP     @col
0018CC  2               @rowfull:
0018CC  2               ; consume any extra source chars up to the terminating NUL
0018CC  2               @skip:
0018CC  2  A0 00                LDY     #0
0018CE  2  B1 18                LDA     (srcp),Y
0018D0  2  F0 20                BEQ     @aftrow
0018D2  2  E6 18                INC     srcp
0018D4  2  D0 F6                BNE     @skip
0018D6  2  E6 19                INC     srcp+1
0018D8  2  4C CC 18             JMP     @skip
0018DB  2               @padrow:
0018DB  2               ; fill remaining columns (cnt0..width-1) with the map default
0018DB  2               @pad:
0018DB  2  A5 24                LDA     cnt0
0018DD  2  C5 22                CMP     tmp2
0018DF  2  B0 11                BCS     @aftrow
0018E1  2  A5 25                LDA     cnt1
0018E3  2  A0 00                LDY     #0
0018E5  2  91 1A                STA     (dstp),Y
0018E7  2  E6 1A                INC     dstp
0018E9  2  D0 02                BNE     :+
0018EB  2  E6 1B                INC     dstp+1
0018ED  2               :
0018ED  2  E6 24                INC     cnt0
0018EF  2  4C DB 18             JMP     @pad
0018F2  2               @aftrow:
0018F2  2               ; step srcp past the row terminator NUL
0018F2  2  E6 18                INC     srcp
0018F4  2  D0 02                BNE     :+
0018F6  2  E6 19                INC     srcp+1
0018F8  2               :
0018F8  2  E6 27                INC     rowidx
0018FA  2  4C 9E 18             JMP     @nextrow
0018FD  2               @done:
0018FD  2  60                   RTS
0018FE  2               
0018FE  2               ;----------------------------------------------------------------
0018FE  2               ; decode_world / decode_town / decode_dung - convenience wrappers
0018FE  2               ;----------------------------------------------------------------
0018FE  2               decode_world:
0018FE  2  A9 85 85 18          SETW16  srcp, ow_src
001902  2  A9 1A 85 19  
001906  2  A9 9A 85 1A          SETW16  dstp, owmap
00190A  2  A9 42 85 1B  
00190E  2  A9 00                LDA     #T_GRASS
001910  2  85 25                STA     cnt1
001912  2  A9 40                LDA     #OWW
001914  2  85 22                STA     tmp2
001916  2  A9 40                LDA     #OWH
001918  2  85 23                STA     tmp3
00191A  2  4C 9A 18             JMP     map_decode
00191D  2               
00191D  2               decode_town:
00191D  2  A9 3E 85 18          SETW16  srcp, town_src
001921  2  A9 2B 85 19  
001925  2  A9 9A 85 1A          SETW16  dstp, locmap
001929  2  A9 52 85 1B  
00192D  2  A9 09                LDA     #T_FLOOR
00192F  2  85 25                STA     cnt1
001931  2  A9 20                LDA     #TOWNW
001933  2  85 22                STA     tmp2
001935  2  A9 14                LDA     #TOWNH
001937  2  85 23                STA     tmp3
001939  2  4C 9A 18             JMP     map_decode
00193C  2               
00193C  2               decode_dung:
00193C  2  A9 D2 85 18          SETW16  srcp, dung_src
001940  2  A9 2D 85 19  
001944  2  A9 9A 85 1A          SETW16  dstp, locmap
001948  2  A9 52 85 1B  
00194C  2  A9 09                LDA     #T_FLOOR
00194E  2  85 25                STA     cnt1
001950  2  A9 20                LDA     #DUNGW
001952  2  85 22                STA     tmp2
001954  2  A9 14                LDA     #DUNGH
001956  2  85 23                STA     tmp3
001958  2  4C 9A 18             JMP     map_decode
00195B  2               
00195B  2               ;----------------------------------------------------------------
00195B  2               ; tileat - read the tile code at (tgtx,tgty) from the ACTIVE map.
00195B  2               ;   IN : tgtx, tgty ; loc (LOC_*) selects map + width
00195B  2               ;   OUT: A = tile code, also stored in tgttile
00195B  2               ;        if out of bounds -> returns T_WATER (overworld) / T_WALL (int)
00195B  2               ;   Trashes ptr, tmp0, tmp1
00195B  2               ;----------------------------------------------------------------
00195B  2               tileat:
00195B  2  AD 52 41             LDA     loc
00195E  2  D0 52                BNE     @interior
001960  2               ;--- overworld ---
001960  2               ; bounds check 0..OWW-1 / 0..OWH-1
001960  2  A5 2C                LDA     tgtx
001962  2  C9 40                CMP     #OWW
001964  2  B0 47                BCS     @oob_world
001966  2  A5 2D                LDA     tgty
001968  2  C9 40                CMP     #OWH
00196A  2  B0 41                BCS     @oob_world
00196C  2               ; offset = tgty*OWW + tgtx  (OWW=64 -> *64)
00196C  2  A5 2D                LDA     tgty
00196E  2  85 10                STA     ptr
001970  2  A9 00                LDA     #0
001972  2  85 11                STA     ptr+1
001974  2  06 10                ASL     ptr
001976  2  26 11                ROL     ptr+1           ; *2
001978  2  06 10                ASL     ptr
00197A  2  26 11                ROL     ptr+1           ; *4
00197C  2  06 10                ASL     ptr
00197E  2  26 11                ROL     ptr+1           ; *8
001980  2  06 10                ASL     ptr
001982  2  26 11                ROL     ptr+1           ; *16
001984  2  06 10                ASL     ptr
001986  2  26 11                ROL     ptr+1           ; *32
001988  2  06 10                ASL     ptr
00198A  2  26 11                ROL     ptr+1           ; *64
00198C  2  18                   CLC
00198D  2  A5 10                LDA     ptr
00198F  2  65 2C                ADC     tgtx
001991  2  85 10                STA     ptr
001993  2  A5 11                LDA     ptr+1
001995  2  69 00                ADC     #0
001997  2  85 11                STA     ptr+1
001999  2               ; ptr += owmap base
001999  2  18                   CLC
00199A  2  A5 10                LDA     ptr
00199C  2  69 9A                ADC     #<owmap
00199E  2  85 10                STA     ptr
0019A0  2  A5 11                LDA     ptr+1
0019A2  2  69 42                ADC     #>owmap
0019A4  2  85 11                STA     ptr+1
0019A6  2  A0 00                LDY     #0
0019A8  2  B1 10                LDA     (ptr),Y
0019AA  2  85 2E                STA     tgttile
0019AC  2  60                   RTS
0019AD  2               @oob_world:
0019AD  2  A9 03                LDA     #T_WATER
0019AF  2  85 2E                STA     tgttile
0019B1  2  60                   RTS
0019B2  2               ;--- interior (town/dungeon): width = locw, height = loch ---
0019B2  2               @interior:
0019B2  2  A5 2C                LDA     tgtx
0019B4  2  CD 53 41             CMP     locw
0019B7  2  B0 44                BCS     @oob_int
0019B9  2  A5 2D                LDA     tgty
0019BB  2  CD 54 41             CMP     loch
0019BE  2  B0 3D                BCS     @oob_int
0019C0  2               ; offset = tgty*locw + tgtx  (locw is 32)
0019C0  2  A5 2D                LDA     tgty
0019C2  2  85 10                STA     ptr
0019C4  2  A9 00                LDA     #0
0019C6  2  85 11                STA     ptr+1
0019C8  2  06 10                ASL     ptr
0019CA  2  26 11                ROL     ptr+1           ; *2
0019CC  2  06 10                ASL     ptr
0019CE  2  26 11                ROL     ptr+1           ; *4
0019D0  2  06 10                ASL     ptr
0019D2  2  26 11                ROL     ptr+1           ; *8
0019D4  2  06 10                ASL     ptr
0019D6  2  26 11                ROL     ptr+1           ; *16
0019D8  2  06 10                ASL     ptr
0019DA  2  26 11                ROL     ptr+1           ; *32  (locw assumed 32)
0019DC  2  18                   CLC
0019DD  2  A5 10                LDA     ptr
0019DF  2  65 2C                ADC     tgtx
0019E1  2  85 10                STA     ptr
0019E3  2  A5 11                LDA     ptr+1
0019E5  2  69 00                ADC     #0
0019E7  2  85 11                STA     ptr+1
0019E9  2  18                   CLC
0019EA  2  A5 10                LDA     ptr
0019EC  2  69 9A                ADC     #<locmap
0019EE  2  85 10                STA     ptr
0019F0  2  A5 11                LDA     ptr+1
0019F2  2  69 52                ADC     #>locmap
0019F4  2  85 11                STA     ptr+1
0019F6  2  A0 00                LDY     #0
0019F8  2  B1 10                LDA     (ptr),Y
0019FA  2  85 2E                STA     tgttile
0019FC  2  60                   RTS
0019FD  2               @oob_int:
0019FD  2  A9 0A                LDA     #T_WALL
0019FF  2  85 2E                STA     tgttile
001A01  2  60                   RTS
001A02  2               
001A02  2               ;----------------------------------------------------------------
001A02  2               ; settile - write tile code A at (tgtx,tgty) in the active map.
001A02  2               ;   Used to clear treasure chests once collected, etc.
001A02  2               ;   Recomputes the address exactly like tileat.
001A02  2               ;----------------------------------------------------------------
001A02  2               settile:
001A02  2  85 21                STA     tmp1            ; new tile
001A04  2  20 0E 1A             JSR     tile_addr       ; ptr -> cell
001A07  2  A0 00                LDY     #0
001A09  2  A5 21                LDA     tmp1
001A0B  2  91 10                STA     (ptr),Y
001A0D  2  60                   RTS
001A0E  2               
001A0E  2               ; tile_addr - compute ptr -> active-map cell for (tgtx,tgty).
001A0E  2               ; (assumes in-bounds; callers that might be OOB use tileat first)
001A0E  2               tile_addr:
001A0E  2  AD 52 41             LDA     loc
001A11  2  D0 3B                BNE     @int
001A13  2  A5 2D                LDA     tgty
001A15  2  85 10                STA     ptr
001A17  2  A9 00                LDA     #0
001A19  2  85 11                STA     ptr+1
001A1B  2  06 10                ASL     ptr
001A1D  2  26 11                ROL     ptr+1
001A1F  2  06 10                ASL     ptr
001A21  2  26 11                ROL     ptr+1
001A23  2  06 10                ASL     ptr
001A25  2  26 11                ROL     ptr+1
001A27  2  06 10                ASL     ptr
001A29  2  26 11                ROL     ptr+1
001A2B  2  06 10                ASL     ptr
001A2D  2  26 11                ROL     ptr+1
001A2F  2  06 10                ASL     ptr
001A31  2  26 11                ROL     ptr+1           ; *64
001A33  2  18                   CLC
001A34  2  A5 10                LDA     ptr
001A36  2  65 2C                ADC     tgtx
001A38  2  85 10                STA     ptr
001A3A  2  A5 11                LDA     ptr+1
001A3C  2  69 00                ADC     #0
001A3E  2  85 11                STA     ptr+1
001A40  2  18                   CLC
001A41  2  A5 10                LDA     ptr
001A43  2  69 9A                ADC     #<owmap
001A45  2  85 10                STA     ptr
001A47  2  A5 11                LDA     ptr+1
001A49  2  69 42                ADC     #>owmap
001A4B  2  85 11                STA     ptr+1
001A4D  2  60                   RTS
001A4E  2               @int:
001A4E  2  A5 2D                LDA     tgty
001A50  2  85 10                STA     ptr
001A52  2  A9 00                LDA     #0
001A54  2  85 11                STA     ptr+1
001A56  2  06 10                ASL     ptr
001A58  2  26 11                ROL     ptr+1
001A5A  2  06 10                ASL     ptr
001A5C  2  26 11                ROL     ptr+1
001A5E  2  06 10                ASL     ptr
001A60  2  26 11                ROL     ptr+1
001A62  2  06 10                ASL     ptr
001A64  2  26 11                ROL     ptr+1
001A66  2  06 10                ASL     ptr
001A68  2  26 11                ROL     ptr+1           ; *32
001A6A  2  18                   CLC
001A6B  2  A5 10                LDA     ptr
001A6D  2  65 2C                ADC     tgtx
001A6F  2  85 10                STA     ptr
001A71  2  A5 11                LDA     ptr+1
001A73  2  69 00                ADC     #0
001A75  2  85 11                STA     ptr+1
001A77  2  18                   CLC
001A78  2  A5 10                LDA     ptr
001A7A  2  69 9A                ADC     #<locmap
001A7C  2  85 10                STA     ptr
001A7E  2  A5 11                LDA     ptr+1
001A80  2  69 52                ADC     #>locmap
001A82  2  85 11                STA     ptr+1
001A84  2  60                   RTS
001A85  2               
001A85  2               ;----------------------------------------------------------------
001A85  2               ; Authored overworld map (64 x 64).
001A85  2               ; Surrounded by water; a central continent with two towns, a
001A85  2               ; castle, the dungeon entrance, forests, mountains and a river
001A85  2               ; crossed by a bridge.
001A85  2               ;----------------------------------------------------------------
001A85  2               ; Maps are stored as NUL-terminated rows.  The decoder pads short
001A85  2               ; rows with the map default and truncates long ones, so the exact
001A85  2               ; authored width of each row is not critical (target widths shown
001A85  2               ; in the header rulers for readability).
001A85  2               ow_src:
001A85  2               ;        0         1         2         3         4         5         6
001A85  2               ;        0123456789012345678901234567890123456789012345678901234567890123
001A85  2  7E 7E 7E 7E          .BYTE   "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~",0
001A89  2  7E 7E 7E 7E  
001A8D  2  7E 7E 7E 7E  
001ACA  2  7E 2E 2E 2E          .BYTE   "~..............................................................~~",0
001ACE  2  2E 2E 2E 2E  
001AD2  2  2E 2E 2E 2E  
