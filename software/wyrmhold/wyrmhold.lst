004CCA  2  0D 16 62             ORA     pfood+1
004CCD  2  F0 06                BEQ     @move
004CCF  2  20 44 4B             JSR     consume_food_unit
004CD2  2  CA                   DEX
004CD3  2  D0 F2                BNE     @food
004CD5  2               @move:
004CD5  2  A5 2C                LDA     tgtx
004CD7  2  8D 0C 62             STA     px
004CDA  2  A5 2D                LDA     tgty
004CDC  2  8D 0D 62             STA     py
004CDF  2  A9 01                LDA     #1
004CE1  2  8D 27 62             STA     did_move
004CE4  2  20 E9 0D             JSR     sfx_move
004CE7  2  A9 81 A0 56          PRINTMSG_MSG m_shortcut_cross
004CEB  2  20 F9 3D     
004CEE  2  60                   RTS
