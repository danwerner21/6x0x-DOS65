002A82  2               
002A82  1                       .INCLUDE "video.asm"
002A82  2               ;______________________________________________________________________________
002A82  2               ;  video.asm - memory-mapped video: paging, framing, viewport, UI text
002A82  2               ;
002A82  2               ;  Direct VRAM access (the fast path used by SpeedScript): map video
002A82  2               ;  sub-page $F9 into CPU bank $A.  Then:
002A82  2               ;     text  char at  $A000 + row*80 + col
002A82  2               ;     color cell at  $A800 + row*80 + col
002A82  2               ;  Color byte = (bg<<4)|fg.
002A82  2               ;
002A82  2               ;  All direct-write routines must be bracketed by vid_enter / vid_exit.
002A82  2               ;  UI text via the firmware (prmsg / putxy) does NOT page; it uses
002A82  2               ;  FARCALL chrout/locate and must be used while in task 0.
002A82  2               ;______________________________________________________________________________
002A82  2               
002A82  2               ;----------------------------------------------------------------
002A82  2               ; vid_enter - map video text/color page into $A000-$AFFF (task 1)
002A82  2               ;             trashes A,X ; preserves Y
002A82  2               ;----------------------------------------------------------------
002A82  2               vid_enter:
002A82  2  A9 01                LDA     #$01            ; configure task 01
002A84  2  A2 0A                LDX     #$0A            ; CPU bank $A ($A000-$AFFF)
002A86  2  A0 F9                LDY     #VIDTEXT_PAGE   ; physical video page $F9
002A88  2  20 F6 FF             JSR     SETPAGE
002A8B  2  A9 01                LDA     #$01
002A8D  2  8D E0 EF             STA     PC6502_ACT_TASK ; activate task 01
002A90  2  60                   RTS
002A91  2               
002A91  2               ;----------------------------------------------------------------
002A91  2               ; vid_exit - restore normal memory at $A000 (task 0)
002A91  2               ;----------------------------------------------------------------
002A91  2               vid_exit:
002A91  2  A9 00                LDA     #$00
002A93  2  8D E0 EF             STA     PC6502_ACT_TASK
002A96  2  60                   RTS
002A97  2               
002A97  2               ;----------------------------------------------------------------
002A97  2               ; rowbase - compute VRAM pointers for the start of a screen row.
002A97  2               ;   IN : A = row (0..23)
002A97  2               ;   OUT: vptr -> $A000 + row*80   (text)
002A97  2               ;        cptr -> $A800 + row*80   (color)
002A97  2               ;   row*80 = row*64 + row*16 = (row<<6)+(row<<4)
002A97  2               ;----------------------------------------------------------------
002A97  2               rowbase:
002A97  2  85 20                STA     tmp0            ; row
002A99  2                       ; row*16 -> ptr2
002A99  2  A9 00                LDA     #0
002A9B  2  85 13                STA     ptr2+1
002A9D  2  A5 20                LDA     tmp0
002A9F  2  0A                   ASL     A               ; *2
002AA0  2  0A                   ASL     A               ; *4
002AA1  2  0A                   ASL     A               ; *8
002AA2  2  0A                   ASL     A               ; *16 (row<=23 so <=368, may set carry)
002AA3  2  85 12                STA     ptr2
002AA5  2  A9 00                LDA     #0
002AA7  2  2A                   ROL     A
002AA8  2  85 13                STA     ptr2+1          ; high bits of row*16
002AAA  2                       ; row*64 -> ptr
002AAA  2  A5 20                LDA     tmp0
002AAC  2  85 10                STA     ptr
002AAE  2  A9 00                LDA     #0
002AB0  2  85 11                STA     ptr+1
002AB2  2  06 10                ASL     ptr
002AB4  2  26 11                ROL     ptr+1           ; *2
002AB6  2  06 10                ASL     ptr
002AB8  2  26 11                ROL     ptr+1           ; *4
002ABA  2  06 10                ASL     ptr
002ABC  2  26 11                ROL     ptr+1           ; *8
002ABE  2  06 10                ASL     ptr
002AC0  2  26 11                ROL     ptr+1           ; *16
002AC2  2  06 10                ASL     ptr
002AC4  2  26 11                ROL     ptr+1           ; *32
002AC6  2  06 10                ASL     ptr
002AC8  2  26 11                ROL     ptr+1           ; *64
002ACA  2                       ; ptr = ptr + ptr2 = row*80
002ACA  2  18                   CLC
002ACB  2  A5 10                LDA     ptr
002ACD  2  65 12                ADC     ptr2
002ACF  2  85 10                STA     ptr
002AD1  2  A5 11                LDA     ptr+1
002AD3  2  65 13                ADC     ptr2+1
002AD5  2  85 11                STA     ptr+1
002AD7  2                       ; vptr = $A000 + ptr
002AD7  2  18                   CLC
002AD8  2  A5 10                LDA     ptr
002ADA  2  85 14                STA     vptr
002ADC  2  A5 11                LDA     ptr+1
002ADE  2  69 A0                ADC     #>VRAM_TEXT
002AE0  2  85 15                STA     vptr+1
002AE2  2                       ; cptr = $A800 + ptr
002AE2  2  18                   CLC
002AE3  2  A5 10                LDA     ptr
002AE5  2  85 16                STA     cptr
002AE7  2  A5 11                LDA     ptr+1
002AE9  2  69 A8                ADC     #>VRAM_COLOR
002AEB  2  85 17                STA     cptr+1
002AED  2  60                   RTS
002AEE  2               
002AEE  2               ;----------------------------------------------------------------
002AEE  2               ; putcell - write one char+color cell directly to VRAM.
002AEE  2               ;   MUST be called between vid_enter / vid_exit.
002AEE  2               ;   IN : tmp1 = row, tmp2 = col, tmp3 = char, colidx = color
002AEE  2               ;   trashes A,Y
002AEE  2               ;----------------------------------------------------------------
002AEE  2               putcell:
002AEE  2  A5 21                LDA     tmp1
002AF0  2  20 97 2A             JSR     rowbase
002AF3  2  A4 22                LDY     tmp2
002AF5  2  A5 23                LDA     tmp3
002AF7  2  91 14                STA     (vptr),Y
002AF9  2  A5 26                LDA     colidx
002AFB  2  91 16                STA     (cptr),Y
002AFD  2  60                   RTS
002AFE  2               
002AFE  2               ;----------------------------------------------------------------
002AFE  2               ; cls_vram - fill the whole screen with spaces in C_BLANK.
002AFE  2               ;----------------------------------------------------------------
002AFE  2               cls_vram:
002AFE  2  20 82 2A             JSR     vid_enter
002B01  2  A9 00                LDA     #0
002B03  2  85 27                STA     rowidx
002B05  2               @row:
002B05  2  A5 27                LDA     rowidx
002B07  2  20 97 2A             JSR     rowbase
002B0A  2  A0 00                LDY     #0
002B0C  2               @col:
002B0C  2  A9 20                LDA     #space
002B0E  2  91 14                STA     (vptr),Y
002B10  2  A9 07                LDA     #C_BLANK
002B12  2  91 16                STA     (cptr),Y
002B14  2  C8                   INY
002B15  2  C0 50                CPY     #SCRW
002B17  2  D0 F3                BNE     @col
002B19  2  E6 27                INC     rowidx
002B1B  2  A5 27                LDA     rowidx
002B1D  2  C9 18                CMP     #SCRH
002B1F  2  D0 E4                BNE     @row
002B21  2  4C 91 2A             JMP     vid_exit
002B24  2               
002B24  2               ;----------------------------------------------------------------
002B24  2               ; fillrow_vram - fill one row [colA..colB) with char/color.
002B24  2               ;   IN: tmp1=row, tmp2=start col, tmp3=char, colidx=color, cnt0=count
002B24  2               ;   MUST be inside vid_enter/vid_exit.
002B24  2               ;----------------------------------------------------------------
002B24  2               fillrow_vram:
002B24  2  A5 21                LDA     tmp1
002B26  2  20 97 2A             JSR     rowbase
002B29  2  A4 22                LDY     tmp2
002B2B  2  A6 24                LDX     cnt0
002B2D  2               @fl:
002B2D  2  A5 23                LDA     tmp3
002B2F  2  91 14                STA     (vptr),Y
002B31  2  A5 26                LDA     colidx
002B33  2  91 16                STA     (cptr),Y
002B35  2  C8                   INY
002B36  2  CA                   DEX
002B37  2  D0 F4                BNE     @fl
002B39  2  60                   RTS
002B3A  2               
002B3A  2               ;----------------------------------------------------------------
002B3A  2               ; draw_frame - draw the static game UI: title bar, viewport frame,
002B3A  2               ;              stat panel frame, and message area divider.
002B3A  2               ;              Done once at game start (and after returning from
002B3A  2               ;              full-screen menus).
002B3A  2               ;----------------------------------------------------------------
002B3A  2               draw_frame:
002B3A  2  20 FE 2A             JSR     cls_vram
002B3D  2  20 82 2A             JSR     vid_enter
002B40  2               
002B40  2                       ; --- top title bar (row 0) ---
002B40  2  A9 00                LDA     #0
002B42  2  85 21                STA     tmp1
002B44  2  A9 00                LDA     #0
002B46  2  85 22                STA     tmp2
002B48  2  A9 20                LDA     #space
002B4A  2  85 23                STA     tmp3
002B4C  2  A9 0B                LDA     #C_TITLE
002B4E  2  85 26                STA     colidx
002B50  2  A9 50                LDA     #SCRW
002B52  2  85 24                STA     cnt0
002B54  2  20 24 2B             JSR     fillrow_vram
002B57  2                       ; centered title text written below via vid_exit path
002B57  2               
002B57  2                       ; --- viewport top/bottom horizontal borders ---
002B57  2                       ; top border at row 0 already part of title; we frame the
002B57  2                       ; viewport with vertical bars and a bottom rule at VPY0+VPH.
002B57  2                       ; vertical left/right bars for viewport rows
002B57  2  A2 01                LDX     #VPY0
002B59  2               @vbar:
002B59  2  8A                   TXA
002B5A  2  85 21                STA     tmp1
002B5C  2  20 97 2A             JSR     rowbase
002B5F  2  A0 00                LDY     #0              ; left edge col 0
002B61  2  A9 7C                LDA     #'|'
002B63  2  91 14                STA     (vptr),Y
002B65  2  A9 0E                LDA     #C_BORDER
002B67  2  91 16                STA     (cptr),Y
002B69  2  A0 2E                LDY     #(VPW+1)        ; right edge of viewport
002B6B  2  A9 7C                LDA     #'|'
002B6D  2  91 14                STA     (vptr),Y
002B6F  2  A9 0E                LDA     #C_BORDER
002B71  2  91 16                STA     (cptr),Y
002B73  2  E8                   INX
002B74  2  E0 15                CPX     #(VPY0+VPH)
002B76  2  D0 E1                BNE     @vbar
002B78  2               
002B78  2                       ; viewport bottom rule + message divider share row VPY0+VPH
002B78  2                       ; (= MSGY0-1).  Draw it full-width.
002B78  2  A9 15                LDA     #(VPY0+VPH)
002B7A  2  85 21                STA     tmp1
002B7C  2  A9 00                LDA     #0
002B7E  2  85 22                STA     tmp2
002B80  2  A9 3D                LDA     #'='
002B82  2  85 23                STA     tmp3
002B84  2  A9 0E                LDA     #C_BORDER
002B86  2  85 26                STA     colidx
002B88  2  A9 50                LDA     #SCRW
002B8A  2  85 24                STA     cnt0
002B8C  2  20 24 2B             JSR     fillrow_vram
002B8F  2               
002B8F  2                       ; panel header row (row 1) background highlight
002B8F  2  A9 01                LDA     #1
002B91  2  85 21                STA     tmp1
002B93  2  A9 2F                LDA     #(VPW+2)
002B95  2  85 22                STA     tmp2
002B97  2  A9 20                LDA     #space
002B99  2  85 23                STA     tmp3
002B9B  2  A9 4B                LDA     #C_PANELHDR
002B9D  2  85 26                STA     colidx
002B9F  2  A9 21                LDA     #(SCRW-(VPW+2))
002BA1  2  85 24                STA     cnt0
002BA3  2  20 24 2B             JSR     fillrow_vram
002BA6  2               
002BA6  2  20 91 2A             JSR     vid_exit
002BA9  2               
002BA9  2                       ; write the title bar + panel header text via firmware
002BA9  2  A2 1E                LDX     #30
002BAB  2  A0 00                LDY     #0
002BAD  2  20 D0 2B             JSR     locate
002BB0  2  A9 0B                LDA     #C_TITLE
002BB2  2  8D 4A 06             STA     CURCOLOR
002BB5  2  A9 C1 A0 2C          PRINTMSG titlebar
002BB9  2  20 E2 2B     
002BBC  2               
002BBC  2  A2 31                LDX     #(VPW+4)
002BBE  2  A0 01                LDY     #1
002BC0  2  20 D0 2B             JSR     locate
002BC3  2  A9 4B                LDA     #C_PANELHDR
002BC5  2  8D 4A 06             STA     CURCOLOR
002BC8  2  A9 D5 A0 2C          PRINTMSG panelhdr
002BCC  2  20 E2 2B     
002BCF  2  60                   RTS
002BD0  2               
002BD0  2               ;----------------------------------------------------------------
002BD0  2               ; locate - position the firmware text cursor.  X=col, Y=row.
002BD0  2               ;----------------------------------------------------------------
002BD0  2               locate:
002BD0  2  A9 25 85 32          FARCALL FC_LOCATE
002BD4  2  20 F0 FF     
002BD7  2  60                   RTS
002BD8  2               
002BD8  2               ;----------------------------------------------------------------
002BD8  2               ; putc - output one char via firmware (A=char), honoring CURCOLOR.
002BD8  2               ;        (Cannot use the FARCALL macro - it would clobber the char
002BD8  2               ;         in A.  Set farfunct, then restore A before the call.)
002BD8  2               ;----------------------------------------------------------------
002BD8  2               putc:
002BD8  2  48                   PHA
002BD9  2  A9 13                LDA     #FC_CHROUT
002BDB  2  85 32                STA     farfunct
002BDD  2  68                   PLA
002BDE  2  20 F0 FF             JSR     DO_FARCALL
002BE1  2  60                   RTS
002BE2  2               
002BE2  2               ;----------------------------------------------------------------
002BE2  2               ; prmsg - print a 0-terminated string via firmware chrout.
002BE2  2               ;   IN: A=lo, Y=hi of string address.  Uses CURCOLOR for color.
002BE2  2               ;----------------------------------------------------------------
002BE2  2               prmsg:
002BE2  2  85 1C                STA     strp
002BE4  2  84 1D                STY     strp+1
002BE6  2  A0 00                LDY     #0
002BE8  2               @pl:
002BE8  2  B1 1C                LDA     (strp),Y
002BEA  2  F0 08                BEQ     @done
002BEC  2  5A                   PHY
002BED  2  20 D8 2B             JSR     putc
002BF0  2  7A                   PLY
002BF1  2  C8                   INY
002BF2  2  D0 F4                BNE     @pl
002BF4  2               @done:
002BF4  2  60                   RTS
002BF5  2               
002BF5  2               ;----------------------------------------------------------------
002BF5  2               ; putxy - position cursor (X=col,Y=row), set color (A=color),
002BF5  2               ;         then print string at strp.  Helper for panel fields.
002BF5  2               ;   IN: tmp2=col, tmp1=row, colidx=color, strp=string ptr
002BF5  2               ;----------------------------------------------------------------
002BF5  2               putxy:
002BF5  2  A6 22                LDX     tmp2
002BF7  2  A4 21                LDY     tmp1
002BF9  2  20 D0 2B             JSR     locate
002BFC  2  A5 26                LDA     colidx
002BFE  2  8D 4A 06             STA     CURCOLOR
002C01  2  A5 1C                LDA     strp
002C03  2  A4 1D                LDY     strp+1
002C05  2  20 E2 2B             JSR     prmsg
002C08  2  60                   RTS
002C09  2               
002C09  2               ;----------------------------------------------------------------
002C09  2               ; clear_panel_value - blank a panel field area before redraw.
002C09  2               ;   IN: X=col, Y=row, A=width
002C09  2               ;----------------------------------------------------------------
002C09  2               clear_panel_value:
002C09  2  85 25                STA     cnt1            ; width
002C0B  2  20 D0 2B             JSR     locate
002C0E  2  A9 0F                LDA     #C_PANEL
002C10  2  8D 4A 06             STA     CURCOLOR
002C13  2               @cpv:
002C13  2  A9 20                LDA     #space
002C15  2  20 D8 2B             JSR     putc
002C18  2  C6 25                DEC     cnt1
002C1A  2  D0 F7                BNE     @cpv
002C1C  2  60                   RTS
002C1D  2               
002C1D  2               ;----------------------------------------------------------------
002C1D  2               ; render_view - draw the scrolling map viewport centered on the
002C1D  2               ; player.  Reads tiles from the active map via tileat, looks up
002C1D  2               ; glyph + color, writes directly to VRAM, then overlays visible
002C1D  2               ; monsters and the player glyph at the center.
002C1D  2               ;
002C1D  2               ;   uses: px,py (player world coords), loc (active map)
002C1D  2               ;   The top-left WORLD cell shown is (px-VPCX, py-VPCY).
002C1D  2               ;----------------------------------------------------------------
002C1D  2               render_view:
002C1D  2  20 82 2A             JSR     vid_enter
002C20  2                       ; vrow = 0..VPH-1
002C20  2  A9 00                LDA     #0
002C22  2  85 27                STA     rowidx          ; viewport row
002C24  2               @vrow:
002C24  2                       ; screen row = VPY0 + rowidx ; compute vptr/cptr base for it
002C24  2  18                   CLC
002C25  2  A5 27                LDA     rowidx
002C27  2  69 01                ADC     #VPY0
002C29  2  20 97 2A             JSR     rowbase         ; vptr/cptr -> start of that screen row
002C2C  2                       ; world y for this row = py - VPCY + rowidx
002C2C  2  38                   SEC
002C2D  2  AD D1 3A             LDA     py
002C30  2  E9 0A                SBC     #VPCY
002C32  2  18                   CLC
002C33  2  65 27                ADC     rowidx
002C35  2  85 2D                STA     tgty
002C37  2                       ; column loop
002C37  2  A9 00                LDA     #0
002C39  2  85 26                STA     colidx          ; viewport column
002C3B  2               @vcol:
002C3B  2                       ; world x = px - VPCX + colidx
002C3B  2  38                   SEC
002C3C  2  AD D0 3A             LDA     px
002C3F  2  E9 16                SBC     #VPCX
002C41  2  18                   CLC
002C42  2  65 26                ADC     colidx
002C44  2  85 2C                STA     tgtx
002C46  2                       ; fetch tile (returns tgttile)
002C46  2  20 70 13             JSR     tileat
002C49  2                       ; look up glyph and color
002C49  2  A6 2E                LDX     tgttile
002C4B  2  BD 5A 12             LDA     tile_glyph,X
002C4E  2  85 20                STA     tmp0            ; glyph
002C50  2  BD 69 12             LDA     tile_color,X
002C53  2  85 21                STA     tmp1            ; color
002C55  2                       ; write to VRAM at column VPX0+colidx
002C55  2  18                   CLC
002C56  2  A5 26                LDA     colidx
002C58  2  69 01                ADC     #VPX0
002C5A  2  A8                   TAY
002C5B  2  A5 20                LDA     tmp0
002C5D  2  91 14                STA     (vptr),Y
002C5F  2  A5 21                LDA     tmp1
002C61  2  91 16                STA     (cptr),Y
002C63  2                       ; next column
002C63  2  E6 26                INC     colidx
002C65  2  A5 26                LDA     colidx
002C67  2  C9 2D                CMP     #VPW
002C69  2  D0 D0                BNE     @vcol
002C6B  2                       ; next row
002C6B  2  E6 27                INC     rowidx
002C6D  2  A5 27                LDA     rowidx
002C6F  2  C9 14                CMP     #VPH
002C71  2  D0 B1                BNE     @vrow
002C73  2               
002C73  2                       ; --- overlay monsters that fall within the viewport ---
002C73  2  20 FB 30             JSR     draw_monsters_vram
002C76  2               
002C76  2                       ; --- overlay the player at the fixed center cell ---
002C76  2  A9 0B                LDA     #(VPY0+VPCY)
002C78  2  20 97 2A             JSR     rowbase
002C7B  2  A0 17                LDY     #(VPX0+VPCX)
002C7D  2  A9 10                LDA     #G_PLAYER
002C7F  2  91 14                STA     (vptr),Y
002C81  2  A9 0F                LDA     #C_PLAYER
002C83  2  91 16                STA     (cptr),Y
002C85  2               
002C85  2  4C 91 2A             JMP     vid_exit
002C88  2               
002C88  2               ;----------------------------------------------------------------
002C88  2               ; plot_view_cell - write a glyph+color to the viewport at WORLD
002C88  2               ; coords (tgtx,tgty) IF that cell is currently visible.  Used to
002C88  2               ; overlay monsters.  MUST be called inside vid_enter/vid_exit.
002C88  2               ;   IN: tgtx,tgty = world coords ; cnt0 = glyph ; cnt1 = color
002C88  2               ;       px,py = player world coords
002C88  2               ;   NOTE: glyph/color are passed in cnt0/cnt1, NOT tmp0/tmp1,
002C88  2               ;   because rowbase (called below) clobbers tmp0.
002C88  2               ;----------------------------------------------------------------
002C88  2               plot_view_cell:
002C88  2                       ; vc = tgtx - (px - VPCX) = tgtx - px + VPCX
002C88  2  38                   SEC
002C89  2  A5 2C                LDA     tgtx
002C8B  2  ED D0 3A             SBC     px
002C8E  2  18                   CLC
002C8F  2  69 16                ADC     #VPCX
002C91  2                       ; must be 0..VPW-1
002C91  2  30 2D                BMI     @no             ; (signed underflow check via N flag)
002C93  2  C9 2D                CMP     #VPW
002C95  2  B0 29                BCS     @no
002C97  2  85 22                STA     tmp2            ; viewport column
002C99  2                       ; vr = tgty - py + VPCY
002C99  2  38                   SEC
002C9A  2  A5 2D                LDA     tgty
002C9C  2  ED D1 3A             SBC     py
002C9F  2  18                   CLC
002CA0  2  69 0A                ADC     #VPCY
002CA2  2  30 1C                BMI     @no
002CA4  2  C9 14                CMP     #VPH
002CA6  2  B0 18                BCS     @no
002CA8  2  85 23                STA     tmp3            ; viewport row
002CAA  2                       ; screen row = VPY0 + tmp3
002CAA  2  18                   CLC
002CAB  2  A5 23                LDA     tmp3
002CAD  2  69 01                ADC     #VPY0
002CAF  2  20 97 2A             JSR     rowbase         ; (clobbers tmp0/ptr/ptr2; tmp2/3,cnt0/1 safe)
002CB2  2  18                   CLC
002CB3  2  A5 22                LDA     tmp2
002CB5  2  69 01                ADC     #VPX0
002CB7  2  A8                   TAY
002CB8  2  A5 24                LDA     cnt0            ; glyph
002CBA  2  91 14                STA     (vptr),Y
002CBC  2  A5 25                LDA     cnt1            ; color
002CBE  2  91 16                STA     (cptr),Y
002CC0  2               @no:
002CC0  2  60                   RTS
002CC1  2               
002CC1  2               ;----------------------------------------------------------------
002CC1  2               ; Static UI strings
002CC1  2               ;----------------------------------------------------------------
002CC1  2               titlebar:
002CC1  2  3D 20 57 20          .BYTE   "= W Y R M H O L D =",0
002CC5  2  59 20 52 20  
002CC9  2  4D 20 48 20  
002CD5  2               panelhdr:
002CD5  2  41 44 56 45          .BYTE   "ADVENTURER",0
002CD9  2  4E 54 55 52  
002CDD  2  45 52 00     
002CE0  2               
002CE0  1                       .INCLUDE "ui.asm"
002CE0  2               ;______________________________________________________________________________
002CE0  2               ;  ui.asm - message log, stat panel, prompts, decimal output
002CE0  2               ;______________________________________________________________________________
002CE0  2               
002CE0  2               ;----------------------------------------------------------------
002CE0  2               ; displaynum - print the 16-bit value in numarg as decimal using
002CE0  2               ;              the firmware (honours CURCOLOR).  No leading spaces.
002CE0  2               ;              (adapted from speedscript displaynum)
002CE0  2               ;----------------------------------------------------------------
002CE0  2               displaynum:
002CE0  2  A0 08                LDY     #8              ; index into nums (5 entries x2 bytes)
002CE2  2               @find:
002CE2  2  A5 1F                LDA     numarg+1
002CE4  2  D9 2A 2D             CMP     nums+1,Y
002CE7  2  90 09                BCC     @next
002CE9  2  D0 0B                BNE     @start
002CEB  2  A5 1E                LDA     numarg
002CED  2  D9 29 2D             CMP     nums,Y
002CF0  2  B0 04                BCS     @start
002CF2  2               @next:
002CF2  2  88                   DEY
002CF3  2  88                   DEY
002CF4  2  D0 EC                BNE     @find
002CF6  2               @start:
002CF6  2  A9 30                LDA     #'0'
002CF8  2  85 28                STA     numspace
002CFA  2               @dig:
002CFA  2  A5 1F                LDA     numarg+1
002CFC  2  D9 2A 2D             CMP     nums+1,Y
002CFF  2  90 1E                BCC     @out
002D01  2  D0 09                BNE     @nocmp
002D03  2  A5 1E                LDA     numarg
002D05  2  F9 29 2D             SBC     nums,Y          ; carry set
002D08  2  90 15                BCC     @out
002D0A  2  B0 05                BCS     @sub
002D0C  2               @nocmp:
002D0C  2  A5 1E                LDA     numarg
002D0E  2  F9 29 2D             SBC     nums,Y          ; carry set
002D11  2               @sub:
002D11  2  E6 28                INC     numspace
002D13  2  85 1E                STA     numarg
002D15  2  A5 1F                LDA     numarg+1
002D17  2  F9 2A 2D             SBC     nums+1,Y
002D1A  2  85 1F                STA     numarg+1
002D1C  2  4C FA 2C             JMP     @dig
002D1F  2               @out:
002D1F  2  A5 28                LDA     numspace
002D21  2  20 D8 2B             JSR     putc
002D24  2  88                   DEY
002D25  2  88                   DEY
002D26  2  10 CE                BPL     @start
002D28  2  60                   RTS
002D29  2               
002D29  2               ; place value table (1,10,100,1000,10000) as 16-bit LE words
002D29  2               nums:
002D29  2  01 00                .WORD   1
002D2B  2  0A 00                .WORD   10
002D2D  2  64 00                .WORD   100
002D2F  2  E8 03                .WORD   1000
002D31  2  10 27                .WORD   10000
002D33  2               
002D33  2               ;----------------------------------------------------------------
002D33  2               ; print a single 8-bit value (in A) as decimal.
002D33  2               ;----------------------------------------------------------------
002D33  2               print_byte:
002D33  2  85 1E                STA     numarg
002D35  2  A9 00                LDA     #0
002D37  2  85 1F                STA     numarg+1
002D39  2  4C E0 2C             JMP     displaynum
002D3C  2               
002D3C  2               ;----------------------------------------------------------------
002D3C  2               ; Message log: two lines at rows MSGY0 and MSGY0+1.
002D3C  2               ; msg_print scrolls the bottom line up and prints a new line.
002D3C  2               ;
002D3C  2               ;   msg_print:  IN A=lo,Y=hi of 0-terminated string
002D3C  2               ;----------------------------------------------------------------
002D3C  2               msg_print:
002D3C  2  85 1C                STA     strp
002D3E  2  84 1D                STY     strp+1
002D40  2                       ; copy current bottom line (msgbuf1) up to (msgbuf0)
002D40  2  A2 00                LDX     #0
002D42  2               @up:
002D42  2  BD 3F 3B             LDA     msgbuf1,X
002D45  2  9D EF 3A             STA     msgbuf0,X
002D48  2  E8                   INX
002D49  2  E0 50                CPX     #SCRW
002D4B  2  D0 F5                BNE     @up
002D4D  2                       ; copy new string into msgbuf1 (truncate/pad to SCRW)
002D4D  2  A0 00                LDY     #0
002D4F  2               @cp:
002D4F  2  B1 1C                LDA     (strp),Y
002D51  2  F0 0B                BEQ     @padb
002D53  2  99 3F 3B             STA     msgbuf1,Y
002D56  2  C8                   INY
002D57  2  C0 50                CPY     #SCRW
002D59  2  D0 F4                BNE     @cp
002D5B  2  4C 68 2D             JMP     @draw
002D5E  2               @padb:
002D5E  2  A9 20                LDA     #space
002D60  2               @pad:
002D60  2  99 3F 3B             STA     msgbuf1,Y
002D63  2  C8                   INY
002D64  2  C0 50                CPY     #SCRW
002D66  2  D0 F8                BNE     @pad
002D68  2               @draw:
002D68  2  4C 6B 2D             JMP     msg_redraw
002D6B  2               
002D6B  2               ;----------------------------------------------------------------
002D6B  2               ; msg_redraw - blit both message buffers to the message rows via
002D6B  2               ;              direct VRAM (so it does not disturb the text cursor).
002D6B  2               ;----------------------------------------------------------------
002D6B  2               msg_redraw:
002D6B  2  20 82 2A             JSR     vid_enter
002D6E  2                       ; row MSGY0 <- msgbuf0
002D6E  2  A9 16                LDA     #MSGY0
002D70  2  20 97 2A             JSR     rowbase
002D73  2  A0 00                LDY     #0
002D75  2               @r0:
002D75  2  B9 EF 3A             LDA     msgbuf0,Y
002D78  2  91 14                STA     (vptr),Y
002D7A  2  A9 0F                LDA     #C_MSG
002D7C  2  91 16                STA     (cptr),Y
002D7E  2  C8                   INY
002D7F  2  C0 50                CPY     #SCRW
002D81  2  D0 F2                BNE     @r0
002D83  2                       ; row MSGY0+1 <- msgbuf1
002D83  2  A9 17                LDA     #MSGY0+1
002D85  2  20 97 2A             JSR     rowbase
002D88  2  A0 00                LDY     #0
002D8A  2               @r1:
002D8A  2  B9 3F 3B             LDA     msgbuf1,Y
002D8D  2  91 14                STA     (vptr),Y
002D8F  2  A9 0F                LDA     #C_MSG
002D91  2  91 16                STA     (cptr),Y
002D93  2  C8                   INY
002D94  2  C0 50                CPY     #SCRW
002D96  2  D0 F2                BNE     @r1
002D98  2  4C 91 2A             JMP     vid_exit
002D9B  2               
002D9B  2               ;----------------------------------------------------------------
002D9B  2               ; msg_clear - blank both message buffers and redraw.
002D9B  2               ;----------------------------------------------------------------
002D9B  2               msg_clear:
002D9B  2  A2 00                LDX     #0
002D9D  2  A9 20                LDA     #space
002D9F  2               @mc:
002D9F  2  9D EF 3A             STA     msgbuf0,X
002DA2  2  9D 3F 3B             STA     msgbuf1,X
002DA5  2  E8                   INX
002DA6  2  E0 50                CPX     #SCRW
002DA8  2  D0 F5                BNE     @mc
002DAA  2  4C 6B 2D             JMP     msg_redraw
002DAD  2               
002DAD  2               ;----------------------------------------------------------------
002DAD  2               ; Stat panel.  Drawn on the right side using firmware text output.
002DAD  2               ; Labels are static; values are redrawn each turn.
002DAD  2               ;----------------------------------------------------------------
002DAD  2               draw_panel:
002DAD  2                       ; HP line:  "HP   : nn/nn"
002DAD  2  A2 30                LDX     #PANX
002DAF  2  A0 03                LDY     #3
002DB1  2  20 D0 2B             JSR     locate
002DB4  2  A9 0F                LDA     #C_PANEL
002DB6  2  8D 4A 06             STA     CURCOLOR
002DB9  2  A9 13 A0 2F          PRINTMSG lbl_hp
002DBD  2  20 E2 2B     
002DC0  2  AD D2 3A             LDA     phealth
002DC3  2  20 33 2D             JSR     print_byte
002DC6  2  A9 2F                LDA     #'/'
002DC8  2  20 D8 2B             JSR     putc
002DCB  2  AD D3 3A             LDA     pmaxhp
002DCE  2  20 33 2D             JSR     print_byte
002DD1  2  20 9A 2E             JSR     pad_clear       ; clear trailing junk
002DD4  2               
002DD4  2                       ; Level / XP
002DD4  2  A2 30                LDX     #PANX
002DD6  2  A0 05                LDY     #5
002DD8  2  20 D0 2B             JSR     locate
002DDB  2  A9 1B A0 2F          PRINTMSG lbl_lvl
002DDF  2  20 E2 2B     
002DE2  2  AD D4 3A             LDA     plevel
002DE5  2  20 33 2D             JSR     print_byte
002DE8  2  A2 3C                LDX     #PANX+12
002DEA  2  A0 05                LDY     #5
002DEC  2  20 D0 2B             JSR     locate
002DEF  2  A9 21 A0 2F          PRINTMSG lbl_xp
002DF3  2  20 E2 2B     
002DF6  2  AD D5 3A 85          COPY16  pxp, numarg
002DFA  2  1E AD D6 3A  
002DFE  2  85 1F        
002E00  2  20 E0 2C             JSR     displaynum
002E03  2  20 9A 2E             JSR     pad_clear
002E06  2               
002E06  2                       ; Gold / Food
002E06  2  A2 30                LDX     #PANX
002E08  2  A0 07                LDY     #7
002E0A  2  20 D0 2B             JSR     locate
002E0D  2  A9 26 A0 2F          PRINTMSG lbl_gold
002E11  2  20 E2 2B     
002E14  2  AD D7 3A 85          COPY16  pgold, numarg
002E18  2  1E AD D8 3A  
002E1C  2  85 1F        
002E1E  2  20 E0 2C             JSR     displaynum
002E21  2  A2 3C                LDX     #PANX+12
002E23  2  A0 07                LDY     #7
002E25  2  20 D0 2B             JSR     locate
002E28  2  A9 2D A0 2F          PRINTMSG lbl_food
002E2C  2  20 E2 2B     
002E2F  2  AD D9 3A 85          COPY16  pfood, numarg
002E33  2  1E AD DA 3A  
002E37  2  85 1F        
002E39  2  20 E0 2C             JSR     displaynum
002E3C  2  20 9A 2E             JSR     pad_clear
002E3F  2               
002E3F  2                       ; Weapon
002E3F  2  A2 30                LDX     #PANX
002E41  2  A0 09                LDY     #9
002E43  2  20 D0 2B             JSR     locate
002E46  2  A9 34 A0 2F          PRINTMSG lbl_wpn
002E4A  2  20 E2 2B     
002E4D  2  AD DB 3A             LDA     pweapon
002E50  2  20 AA 2E             JSR     name_weapon     ; strp -> name
002E53  2  A5 1C                LDA     strp
002E55  2  A4 1D                LDY     strp+1
002E57  2  20 E2 2B             JSR     prmsg
002E5A  2  20 9A 2E             JSR     pad_clear
002E5D  2               
002E5D  2                       ; Armor
002E5D  2  A2 30                LDX     #PANX
002E5F  2  A0 0A                LDY     #10
002E61  2  20 D0 2B             JSR     locate
002E64  2  A9 3D A0 2F          PRINTMSG lbl_arm
002E68  2  20 E2 2B     
002E6B  2  AD DC 3A             LDA     parmor
002E6E  2  20 B7 2E             JSR     name_armor
002E71  2  A5 1C                LDA     strp
002E73  2  A4 1D                LDY     strp+1
002E75  2  20 E2 2B             JSR     prmsg
002E78  2  20 9A 2E             JSR     pad_clear
002E7B  2               
002E7B  2                       ; Location
002E7B  2  A2 30                LDX     #PANX
002E7D  2  A0 0C                LDY     #12
002E7F  2  20 D0 2B             JSR     locate
002E82  2  A9 46 A0 2F          PRINTMSG lbl_loc
002E86  2  20 E2 2B     
002E89  2  AD DD 3A             LDA     loc
002E8C  2  20 C4 2E             JSR     name_loc
002E8F  2  A5 1C                LDA     strp
002E91  2  A4 1D                LDY     strp+1
002E93  2  20 E2 2B             JSR     prmsg
002E96  2  20 9A 2E             JSR     pad_clear
002E99  2  60                   RTS
002E9A  2               
002E9A  2               ; pad_clear - print spaces out to the right screen edge to erase
002E9A  2               ;             any leftover characters from a previous longer value.
002E9A  2               ;             Stops at the last column to avoid auto-scroll.
002E9A  2               pad_clear:
002E9A  2               @pc:
002E9A  2  AD 47 06             LDA     CURX
002E9D  2  C9 4F                CMP     #SCRW-1
002E9F  2  B0 08                BCS     @done
002EA1  2  A9 20                LDA     #space
002EA3  2  20 D8 2B             JSR     putc
002EA6  2  4C 9A 2E             JMP     @pc
002EA9  2               @done:
002EA9  2  60                   RTS
002EAA  2               
002EAA  2               ;----------------------------------------------------------------
002EAA  2               ; name_weapon / name_armor / name_loc - set strp to a name string
002EAA  2               ;   IN: A = index
002EAA  2               ;----------------------------------------------------------------
002EAA  2               name_weapon:
002EAA  2  0A                   ASL     A
002EAB  2  AA                   TAX
002EAC  2  BD 4F 2F             LDA     wpn_names,X
002EAF  2  85 1C                STA     strp
002EB1  2  BD 50 2F             LDA     wpn_names+1,X
002EB4  2  85 1D                STA     strp+1
002EB6  2  60                   RTS
002EB7  2               name_armor:
002EB7  2  0A                   ASL     A
002EB8  2  AA                   TAX
002EB9  2  BD 6E 2F             LDA     arm_names,X
002EBC  2  85 1C                STA     strp
002EBE  2  BD 6F 2F             LDA     arm_names+1,X
002EC1  2  85 1D                STA     strp+1
002EC3  2  60                   RTS
002EC4  2               name_loc:
002EC4  2  0A                   ASL     A
002EC5  2  AA                   TAX
002EC6  2  BD 92 2F             LDA     loc_names,X
002EC9  2  85 1C                STA     strp
002ECB  2  BD 93 2F             LDA     loc_names+1,X
002ECE  2  85 1D                STA     strp+1
002ED0  2  60                   RTS
002ED1  2               
002ED1  2               ;----------------------------------------------------------------
002ED1  2               ; yorn - wait for a Y/N keypress.  Returns Z=1 if Yes (A='Y').
002ED1  2               ;----------------------------------------------------------------
002ED1  2               yorn:
002ED1  2               @wait:
002ED1  2  20 ED 2E             JSR     getkey_block
002ED4  2  C9 59                CMP     #'Y'
002ED6  2  F0 0F                BEQ     @yes
002ED8  2  C9 79                CMP     #'y'
002EDA  2  F0 0B                BEQ     @yes
002EDC  2  C9 4E                CMP     #'N'
002EDE  2  F0 0A                BEQ     @no
002EE0  2  C9 6E                CMP     #'n'
002EE2  2  F0 06                BEQ     @no
002EE4  2  4C D1 2E             JMP     @wait
002EE7  2               @yes:
002EE7  2  A9 00                LDA     #0              ; Z=1
002EE9  2  60                   RTS
002EEA  2               @no:
002EEA  2  A9 01                LDA     #1              ; Z=0
002EEC  2  60                   RTS
002EED  2               
002EED  2               ;----------------------------------------------------------------
002EED  2               ; getkey_block - block until a key is pressed; return it in A.
002EED  2               ;----------------------------------------------------------------
002EED  2               getkey_block:
002EED  2               @gk:
002EED  2  A9 14 85 32          FARCALL FC_CHRIN
002EF1  2  20 F0 FF     
002EF4  2  C9 FF                CMP     #$FF
002EF6  2  F0 F5                BEQ     @gk
002EF8  2  60                   RTS
002EF9  2               
002EF9  2               ;----------------------------------------------------------------
002EF9  2               ; getkey - non-blocking read; A=key or 0 if none.
002EF9  2               ;----------------------------------------------------------------
002EF9  2               getkey:
002EF9  2  A9 14 85 32          FARCALL FC_CHRIN
002EFD  2  20 F0 FF     
002F00  2  C9 FF                CMP     #$FF
002F02  2  D0 02                BNE     @got
002F04  2  A9 00                LDA     #0
002F06  2               @got:
002F06  2  60                   RTS
002F07  2               
002F07  2               ;----------------------------------------------------------------
002F07  2               ; drainkeys - consume and discard all buffered keystrokes.
002F07  2               ;----------------------------------------------------------------
002F07  2               drainkeys:
002F07  2               @dk:
002F07  2  A9 14 85 32          FARCALL FC_CHRIN
002F0B  2  20 F0 FF     
002F0E  2  C9 FF                CMP     #$FF
002F10  2  D0 F5                BNE     @dk             ; got a key - keep draining
002F12  2  60                   RTS
002F13  2               
002F13  2               ;----------------------------------------------------------------
002F13  2               ; Panel labels and name tables
002F13  2               ;----------------------------------------------------------------
002F13  2  48 50 20 20  lbl_hp:   .BYTE "HP   : ",0
002F17  2  20 3A 20 00  
002F1B  2  4C 76 6C 3A  lbl_lvl:  .BYTE "Lvl: ",0
002F1F  2  20 00        
002F21  2  58 50 3A 20  lbl_xp:   .BYTE "XP: ",0
002F25  2  00           
002F26  2  47 6F 6C 64  lbl_gold: .BYTE "Gold: ",0
002F2A  2  3A 20 00     
002F2D  2  46 6F 6F 64  lbl_food: .BYTE "Food: ",0
002F31  2  3A 20 00     
002F34  2  57 65 61 70  lbl_wpn:  .BYTE "Weapon: ",0
002F38  2  6F 6E 3A 20  
002F3C  2  00           
002F3D  2  41 72 6D 6F  lbl_arm:  .BYTE "Armor : ",0
002F41  2  72 20 3A 20  
002F45  2  00           
002F46  2  57 68 65 72  lbl_loc:  .BYTE "Where : ",0
002F4A  2  65 20 3A 20  
002F4E  2  00           
002F4F  2               
002F4F  2               wpn_names:
002F4F  2  57 2F 5D 2F          .WORD   wn0, wn1, wn2, wn3
002F53  2  64 2F 6A 2F  
002F57  2  46 69 73 74  wn0:    .BYTE   "Fists",0
002F5B  2  73 00        
002F5D  2  44 61 67 67  wn1:    .BYTE   "Dagger",0
002F61  2  65 72 00     
002F64  2  53 77 6F 72  wn2:    .BYTE   "Sword",0
002F68  2  64 00        
002F6A  2  41 78 65 00  wn3:    .BYTE   "Axe",0
002F6E  2               
002F6E  2               arm_names:
002F6E  2  76 2F 7E 2F          .WORD   an0, an1, an2, an3
002F72  2  86 2F 8C 2F  
002F76  2  43 6C 6F 74  an0:    .BYTE   "Clothes",0
002F7A  2  68 65 73 00  
002F7E  2  4C 65 61 74  an1:    .BYTE   "Leather",0
002F82  2  68 65 72 00  
002F86  2  43 68 61 69  an2:    .BYTE   "Chain",0
002F8A  2  6E 00        
002F8C  2  50 6C 61 74  an3:    .BYTE   "Plate",0
002F90  2  65 00        
002F92  2               
002F92  2               loc_names:
002F92  2  98 2F A1 2F          .WORD   ln0, ln1, ln2
002F96  2  A6 2F        
002F98  2  57 79 72 6D  ln0:    .BYTE   "Wyrmhold",0
002F9C  2  68 6F 6C 64  
002FA0  2  00           
002FA1  2  54 6F 77 6E  ln1:    .BYTE   "Town",0
002FA5  2  00           
002FA6  2  44 75 6E 67  ln2:    .BYTE   "Dungeon",0
002FAA  2  65 6F 6E 00  
002FAE  2               
002FAE  1                       .INCLUDE "entity.asm"
002FAE  2               ;______________________________________________________________________________
002FAE  2               ;  entity.asm - monsters: table, spawning, simple AI, rendering
002FAE  2               ;
002FAE  2               ;  Parallel arrays of MAXMON slots.  A slot with mon_type == M_NONE
002FAE  2               ;  is empty.  Monsters live on the currently active map (overworld
002FAE  2               ;  or dungeon).  Towns have no monsters.
002FAE  2               ;______________________________________________________________________________
002FAE  2               
002FAE  2               ;----------------------------------------------------------------
002FAE  2               ; Per-monster-type stat tables (indexed by M_* id)
002FAE  2               ;   mtype_glyph : ASCII glyph
002FAE  2               ;   mtype_color : color cell
002FAE  2               ;   mtype_hp    : starting HP
002FAE  2               ;   mtype_atk   : attack dice sides (damage 1..atk)
002FAE  2               ;   mtype_xp    : XP awarded on kill
002FAE  2               ;   mtype_gold  : gold dropped (max; rolled 0..gold)
002FAE  2               ;----------------------------------------------------------------
002FAE  2               mtype_glyph:
002FAE  2  20                   .BYTE   ' '             ; 0 none
002FAF  2  11                   .BYTE   G_ORC           ; 1 orc
002FB0  2  12                   .BYTE   G_SNAKE         ; 2 snake
002FB1  2  13                   .BYTE   G_SKELETON      ; 3 skeleton
002FB2  2  14                   .BYTE   G_THIEF         ; 4 thief
002FB3  2  15                   .BYTE   G_TROLL         ; 5 troll
002FB4  2  16                   .BYTE   G_BOSS          ; 6 boss (dragon)
002FB5  2               mtype_color:
002FB5  2  09                   .BYTE   C_MONST         ; 0
002FB6  2  0A                   .BYTE   COLOR(CO_BRGREEN,CO_BLACK)  ; orc
002FB7  2  02                   .BYTE   COLOR(CO_GREEN, CO_BLACK)   ; snake
002FB8  2  0F                   .BYTE   COLOR(CO_BRWHITE,CO_BLACK)  ; skeleton
002FB9  2  0B                   .BYTE   COLOR(CO_BRYELLOW,CO_BLACK) ; thief
002FBA  2  0E                   .BYTE   COLOR(CO_BRCYAN,CO_BLACK)   ; troll
002FBB  2  19                   .BYTE   C_BOSS                      ; boss
002FBC  2               mtype_hp:
002FBC  2  00 06 04 08          .BYTE   0, 6, 4, 8, 5, 14, 40
002FC0  2  05 0E 28     
002FC3  2               mtype_atk:
002FC3  2  00 04 03 05          .BYTE   0, 4, 3, 5, 3, 7, 12
002FC7  2  03 07 0C     
002FCA  2               mtype_xp:
002FCA  2  00 03 02 05          .BYTE   0, 3, 2, 5, 4, 10, 50
002FCE  2  04 0A 32     
002FD1  2               mtype_gold:
002FD1  2  00 04 01 03          .BYTE   0, 4, 1, 3, 12, 8, 40
002FD5  2  0C 08 28     
002FD8  2               
002FD8  2               ;----------------------------------------------------------------
002FD8  2               ; mon_clear_all - empty every monster slot.
002FD8  2               ;----------------------------------------------------------------
002FD8  2               mon_clear_all:
002FD8  2  A2 00                LDX     #0
002FDA  2  A9 00                LDA     #M_NONE
002FDC  2               @c:
002FDC  2  9D F0 3B             STA     mon_type,X
002FDF  2  E8                   INX
002FE0  2  E0 0C                CPX     #MAXMON
002FE2  2  D0 F8                BNE     @c
002FE4  2  60                   RTS
002FE5  2               
002FE5  2               ;----------------------------------------------------------------
002FE5  2               ; mon_find_free - find an empty slot.  Returns X = slot, C=1 ok,
002FE5  2               ;                 C=0 if table full.
002FE5  2               ;----------------------------------------------------------------
002FE5  2               mon_find_free:
002FE5  2  A2 00                LDX     #0
002FE7  2               @f:
002FE7  2  BD F0 3B             LDA     mon_type,X
002FEA  2  C9 00                CMP     #M_NONE
002FEC  2  F0 07                BEQ     @found
002FEE  2  E8                   INX
002FEF  2  E0 0C                CPX     #MAXMON
002FF1  2  D0 F4                BNE     @f
002FF3  2  18                   CLC
002FF4  2  60                   RTS
002FF5  2               @found:
002FF5  2  38                   SEC
002FF6  2  60                   RTS
002FF7  2               
002FF7  2               ;----------------------------------------------------------------
002FF7  2               ; mon_spawn - create a monster.
002FF7  2               ;   IN: A=type, tgtx=x, tgty=y
002FF7  2               ;   Sets hp from the type table.  No-op if table full.
002FF7  2               ;----------------------------------------------------------------
002FF7  2               mon_spawn:
002FF7  2  85 20                STA     tmp0            ; type
002FF9  2  20 E5 2F             JSR     mon_find_free
002FFC  2  90 17                BCC     @full
002FFE  2  A5 20                LDA     tmp0
003000  2  9D F0 3B             STA     mon_type,X
003003  2  A5 2C                LDA     tgtx
003005  2  9D FC 3B             STA     mon_x,X
003008  2  A5 2D                LDA     tgty
00300A  2  9D 08 3C             STA     mon_y,X
00300D  2  A4 20                LDY     tmp0
00300F  2  B9 BC 2F             LDA     mtype_hp,Y
003012  2  9D 14 3C             STA     mon_hp,X
003015  2               @full:
003015  2  60                   RTS
003016  2               
003016  2               ;----------------------------------------------------------------
003016  2               ; mon_at - is there a live monster at (tgtx,tgty)?
003016  2               ;          Returns X = slot and C=1 if found, else C=0.
003016  2               ;----------------------------------------------------------------
003016  2               mon_at:
003016  2  A2 00                LDX     #0
003018  2               @a:
003018  2  BD F0 3B             LDA     mon_type,X
00301B  2  C9 00                CMP     #M_NONE
00301D  2  F0 10                BEQ     @nextslot
00301F  2  BD FC 3B             LDA     mon_x,X
003022  2  C5 2C                CMP     tgtx
003024  2  D0 09                BNE     @nextslot
003026  2  BD 08 3C             LDA     mon_y,X
003029  2  C5 2D                CMP     tgty
00302B  2  D0 02                BNE     @nextslot
00302D  2  38                   SEC
00302E  2  60                   RTS
00302F  2               @nextslot:
00302F  2  E8                   INX
003030  2  E0 0C                CPX     #MAXMON
003032  2  D0 E4                BNE     @a
003034  2  18                   CLC
003035  2  60                   RTS
003036  2               
003036  2               ;----------------------------------------------------------------
003036  2               ; mon_kill - remove monster in slot X.
003036  2               ;----------------------------------------------------------------
003036  2               mon_kill:
003036  2  A9 00                LDA     #M_NONE
003038  2  9D F0 3B             STA     mon_type,X
00303B  2  60                   RTS
00303C  2               
00303C  2               ;----------------------------------------------------------------
00303C  2               ; spawn_overworld_monsters - scatter a handful of monsters on the
00303C  2               ; overworld at random passable land tiles near the centre.
00303C  2               ;----------------------------------------------------------------
00303C  2               spawn_overworld_monsters:
00303C  2  20 D8 2F             JSR     mon_clear_all
00303F  2  A9 04                LDA     #4              ; only a few roaming monsters at a time
003041  2  85 24                STA     cnt0
003043  2               @loop:
003043  2                       ; place in a ring roughly 6..21 tiles from the player: far
003043  2                       ; enough not to crowd you, near enough to be encountered.
003043  2                       ; offset = (rand(0..15) + 6), sign random per axis.
003043  2  A9 10                LDA     #16
003045  2  20 7F 0C             JSR     rng_mod
003048  2  18                   CLC
003049  2  69 06                ADC     #6              ; 6..21
00304B  2  85 21                STA     tmp1            ; magnitude
00304D  2  20 5F 0C             JSR     rng_next        ; random sign bit
003050  2  29 01                AND     #1
003052  2  F0 09                BEQ     @xplus
003054  2  AD D0 3A             LDA     px
003057  2  38                   SEC
003058  2  E5 21                SBC     tmp1
00305A  2  4C 63 30             JMP     @setx
00305D  2               @xplus:
00305D  2  AD D0 3A             LDA     px
003060  2  18                   CLC
003061  2  65 21                ADC     tmp1
003063  2               @setx:
003063  2  85 2C                STA     tgtx
003065  2  A9 10                LDA     #16
003067  2  20 7F 0C             JSR     rng_mod
00306A  2  18                   CLC
00306B  2  69 06                ADC     #6
00306D  2  85 21                STA     tmp1
00306F  2  20 5F 0C             JSR     rng_next
003072  2  29 01                AND     #1
003074  2  F0 09                BEQ     @yplus
003076  2  AD D1 3A             LDA     py
003079  2  38                   SEC
00307A  2  E5 21                SBC     tmp1
00307C  2  4C 85 30             JMP     @sety
00307F  2               @yplus:
00307F  2  AD D1 3A             LDA     py
003082  2  18                   CLC
003083  2  65 21                ADC     tmp1
003085  2               @sety:
003085  2  85 2D                STA     tgty
003087  2                       ; reject the player's own tile (don't spawn on top of you)
003087  2  A5 2C                LDA     tgtx
003089  2  CD D0 3A             CMP     px
00308C  2  D0 07                BNE     @okpos
00308E  2  A5 2D                LDA     tgty
003090  2  CD D1 3A             CMP     py
003093  2  F0 20                BEQ     @skip
003095  2               @okpos:
003095  2                       ; must be passable grass/forest (not water/mountain/town...)
003095  2  20 70 13             JSR     tileat
003098  2  A6 2E                LDX     tgttile
00309A  2  BD 78 12             LDA     tile_prop,X
00309D  2  29 01                AND     #P_PASS
00309F  2  F0 14                BEQ     @skip
0030A1  2  BD 78 12             LDA     tile_prop,X
0030A4  2  29 0C                AND     #(P_TOWN|P_DUNG)
0030A6  2  D0 0D                BNE     @skip           ; don't sit on a town/dungeon tile
0030A8  2                       ; not already occupied by a monster?
0030A8  2  20 16 30             JSR     mon_at
0030AB  2  B0 08                BCS     @skip
0030AD  2                       ; pick a random monster type 1..5
0030AD  2  A9 05                LDA     #5
0030AF  2  20 8F 0C             JSR     rng_d           ; 1..5
0030B2  2  20 F7 2F             JSR     mon_spawn
0030B5  2               @skip:
0030B5  2  C6 24                DEC     cnt0
0030B7  2  D0 8A                BNE     @loop
0030B9  2  60                   RTS
0030BA  2               
0030BA  2               ;----------------------------------------------------------------
0030BA  2               ; spawn_dungeon_monsters - place a few monsters and the boss.
0030BA  2               ;----------------------------------------------------------------
0030BA  2               spawn_dungeon_monsters:
0030BA  2  20 D8 2F             JSR     mon_clear_all
0030BD  2                       ; the boss waits at the far corner treasure room (bottom-right)
0030BD  2  A9 1D                LDA     #29
0030BF  2  85 2C                STA     tgtx
0030C1  2  A9 12                LDA     #18
0030C3  2  85 2D                STA     tgty
0030C5  2  A9 06                LDA     #M_BOSS
0030C7  2  20 F7 2F             JSR     mon_spawn
0030CA  2                       ; a couple of guards on floor tiles
0030CA  2  A9 04                LDA     #4
0030CC  2  85 24                STA     cnt0
0030CE  2               @loop:
0030CE  2  A9 1C                LDA     #28
0030D0  2  20 7F 0C             JSR     rng_mod
0030D3  2  18                   CLC
0030D4  2  69 02                ADC     #2
0030D6  2  85 2C                STA     tgtx
0030D8  2  A9 10                LDA     #16
0030DA  2  20 7F 0C             JSR     rng_mod
0030DD  2  18                   CLC
0030DE  2  69 02                ADC     #2
0030E0  2  85 2D                STA     tgty
0030E2  2  20 70 13             JSR     tileat
0030E5  2  A6 2E                LDX     tgttile
0030E7  2  E0 09                CPX     #T_FLOOR
0030E9  2  D0 0B                BNE     @skip
0030EB  2  A9 02                LDA     #2              ; orc or skeleton
0030ED  2  20 8F 0C             JSR     rng_d
0030F0  2  18                   CLC
0030F1  2  69 02                ADC     #2              ; 3..4 -> skeleton/thief mix
0030F3  2  20 F7 2F             JSR     mon_spawn
0030F6  2               @skip:
0030F6  2  C6 24                DEC     cnt0
0030F8  2  D0 D4                BNE     @loop
0030FA  2  60                   RTS
0030FB  2               
0030FB  2               ;----------------------------------------------------------------
0030FB  2               ; draw_monsters_vram - overlay all visible monsters in the viewport.
0030FB  2               ; Called by render_view while video is paged in.
0030FB  2               ;----------------------------------------------------------------
0030FB  2               draw_monsters_vram:
0030FB  2  A2 00                LDX     #0
0030FD  2  86 2F                STX     monidx
0030FF  2               @dm:
0030FF  2  A6 2F                LDX     monidx
003101  2  BD F0 3B             LDA     mon_type,X
003104  2  C9 00                CMP     #M_NONE
003106  2  F0 1A                BEQ     @next
003108  2                       ; set world coords + glyph/color, then plot if visible
003108  2  BD FC 3B             LDA     mon_x,X
00310B  2  85 2C                STA     tgtx
00310D  2  BD 08 3C             LDA     mon_y,X
003110  2  85 2D                STA     tgty
003112  2  BC F0 3B             LDY     mon_type,X
003115  2  B9 AE 2F             LDA     mtype_glyph,Y
003118  2  85 24                STA     cnt0            ; glyph (cnt0/cnt1 survive rowbase)
00311A  2  B9 B5 2F             LDA     mtype_color,Y
00311D  2  85 25                STA     cnt1            ; color
00311F  2  20 88 2C             JSR     plot_view_cell
003122  2               @next:
003122  2  E6 2F                INC     monidx
003124  2  A5 2F                LDA     monidx
003126  2  C9 0C                CMP     #MAXMON
003128  2  D0 D5                BNE     @dm
00312A  2  60                   RTS
00312B  2               
00312B  2               ;----------------------------------------------------------------
00312B  2               ; mon_act - move/attack for every monster (called once per turn).
00312B  2               ; Monsters in LOC_TOWN never act (towns are safe).
00312B  2               ;   A monster adjacent to the player attacks; otherwise it steps
00312B  2               ;   one tile toward the player if the destination is passable and
00312B  2               ;   unoccupied.
00312B  2               ;----------------------------------------------------------------
00312B  2               mon_act:
00312B  2  AD DD 3A             LDA     loc
00312E  2  C9 01                CMP     #LOC_TOWN
003130  2  F0 18                BEQ     @ret            ; safe in town
003132  2  A2 00                LDX     #0
003134  2  86 2F                STX     monidx
003136  2               @ma:
003136  2  A6 2F                LDX     monidx
003138  2  BD F0 3B             LDA     mon_type,X
00313B  2  C9 00                CMP     #M_NONE
00313D  2  F0 03                BEQ     @next
00313F  2                       ; distance to player: dxv = px - mon_x ; dyv = py - mon_y
00313F  2                       ; adjacency test (|dx|<=1 && |dy|<=1 && not both 0)
00313F  2  20 4B 31             JSR     mon_step_or_attack
003142  2               @next:
003142  2  E6 2F                INC     monidx
003144  2  A5 2F                LDA     monidx
003146  2  C9 0C                CMP     #MAXMON
003148  2  D0 EC                BNE     @ma
00314A  2               @ret:
00314A  2  60                   RTS
00314B  2               
00314B  2               ; mon_step_or_attack - for monster in slot monidx (X on entry).
00314B  2               mon_step_or_attack:
00314B  2                       ; compute signed dx = px - mon_x  -> tmp0 ; dy -> tmp1
00314B  2  A6 2F                LDX     monidx
00314D  2  38                   SEC
00314E  2  AD D0 3A             LDA     px
003151  2  FD FC 3B             SBC     mon_x,X
003154  2  85 20                STA     tmp0            ; dx (signed)
003156  2  38                   SEC
003157  2  AD D1 3A             LDA     py
00315A  2  FD 08 3C             SBC     mon_y,X
00315D  2  85 21                STA     tmp1            ; dy (signed)
00315F  2                       ; |dx| <= 1 ?
00315F  2  A5 20                LDA     tmp0
003161  2  20 D7 31             JSR     abs_a
003164  2  85 22                STA     tmp2            ; |dx|
003166  2  A5 21                LDA     tmp1
003168  2  20 D7 31             JSR     abs_a
00316B  2  85 23                STA     tmp3            ; |dy|
00316D  2                       ; adjacency: |dx|<=1 and |dy|<=1
00316D  2  A5 22                LDA     tmp2
00316F  2  C9 02                CMP     #2
003171  2  B0 09                BCS     @move
003173  2  A5 23                LDA     tmp3
003175  2  C9 02                CMP     #2
003177  2  B0 03                BCS     @move
003179  2                       ; adjacent (and since one of them is the player, not same cell)
003179  2                       ; -> attack the player
003179  2  4C 0A 35             JMP     monster_attacks_player          ; in combat.asm
00317C  2               @move:
00317C  2                       ; step one tile toward player along the larger axis
00317C  2                       ; choose step in x: sign of dx
00317C  2  A6 2F                LDX     monidx
00317E  2  BD FC 3B             LDA     mon_x,X
003181  2  85 2C                STA     tgtx
003183  2  BD 08 3C             LDA     mon_y,X
003186  2  85 2D                STA     tgty
003188  2                       ; prefer horizontal if |dx|>=|dy|
003188  2  A5 22                LDA     tmp2
00318A  2  C5 23                CMP     tmp3
00318C  2  90 10                BCC     @vert
00318E  2                       ; horizontal step
00318E  2  A5 20                LDA     tmp0
003190  2  F0 0C                BEQ     @vert           ; dx==0 -> try vertical
003192  2  30 05                BMI     @left
003194  2  E6 2C                INC     tgtx
003196  2  4C AB 31             JMP     @trymove
003199  2               @left:
003199  2  C6 2C                DEC     tgtx
00319B  2  4C AB 31             JMP     @trymove
00319E  2               @vert:
00319E  2  A5 21                LDA     tmp1
0031A0  2  F0 34                BEQ     @done           ; dy==0 too -> no move
0031A2  2  30 05                BMI     @up
0031A4  2  E6 2D                INC     tgty
0031A6  2  4C AB 31             JMP     @trymove
0031A9  2               @up:
0031A9  2  C6 2D                DEC     tgty
0031AB  2               @trymove:
0031AB  2                       ; passable terrain?
0031AB  2  20 70 13             JSR     tileat
0031AE  2  A6 2E                LDX     tgttile
0031B0  2  BD 78 12             LDA     tile_prop,X
0031B3  2  29 01                AND     #P_PASS
0031B5  2  F0 1F                BEQ     @done           ; blocked terrain
0031B7  2                       ; not onto the player?
0031B7  2  A5 2C                LDA     tgtx
0031B9  2  CD D0 3A             CMP     px
0031BC  2  D0 07                BNE     @okcell
0031BE  2  A5 2D                LDA     tgty
0031C0  2  CD D1 3A             CMP     py
0031C3  2  F0 11                BEQ     @done           ; would land on player (shouldn't: adjacency handled)
0031C5  2               @okcell:
0031C5  2                       ; not onto another monster?
0031C5  2  20 16 30             JSR     mon_at
0031C8  2  B0 0C                BCS     @done           ; occupied
0031CA  2                       ; commit move
0031CA  2  A6 2F                LDX     monidx
0031CC  2  A5 2C                LDA     tgtx
0031CE  2  9D FC 3B             STA     mon_x,X
0031D1  2  A5 2D                LDA     tgty
0031D3  2  9D 08 3C             STA     mon_y,X
0031D6  2               @done:
0031D6  2  60                   RTS
0031D7  2               
0031D7  2               ;----------------------------------------------------------------
0031D7  2               ; abs_a - A = |A| treating A as signed 8-bit.
0031D7  2               ;----------------------------------------------------------------
0031D7  2               abs_a:
0031D7  2  C9 80                CMP     #$80
0031D9  2  90 05                BCC     @pos
0031DB  2  49 FF                EOR     #$FF
0031DD  2  18                   CLC
0031DE  2  69 01                ADC     #1
0031E0  2               @pos:
0031E0  2  60                   RTS
0031E1  2               
0031E1  1                       .INCLUDE "player.asm"
0031E1  2               ;______________________________________________________________________________
0031E1  2               ;  player.asm - player movement, map transitions, treasure
0031E1  2               ;______________________________________________________________________________
0031E1  2               
0031E1  2               ;----------------------------------------------------------------
0031E1  2               ; Player starting state on the overworld.
0031E1  2               ;----------------------------------------------------------------
0031E1  2               PLAYER_START_X  = 20
0031E1  2               PLAYER_START_Y  = 9
0031E1  2               
0031E1  2               player_init:
0031E1  2  A9 14                LDA     #PLAYER_START_X
0031E3  2  8D D0 3A             STA     px
0031E6  2  A9 09                LDA     #PLAYER_START_Y
0031E8  2  8D D1 3A             STA     py
0031EB  2  A9 1E                LDA     #30
0031ED  2  8D D2 3A             STA     phealth
0031F0  2  8D D3 3A             STA     pmaxhp
0031F3  2  A9 01                LDA     #1
0031F5  2  8D D4 3A             STA     plevel
0031F8  2  A9 00                LDA     #0
0031FA  2  8D D5 3A             STA     pxp
0031FD  2  8D D6 3A             STA     pxp+1
003200  2  A9 32                LDA     #50
003202  2  8D D7 3A             STA     pgold
003205  2  A9 00                LDA     #0
003207  2  8D D8 3A             STA     pgold+1
00320A  2  A9 FA 8D D9          SETW16  pfood, 250
00320E  2  3A A9 00 8D  
003212  2  DA 3A        
003214  2  A9 01                LDA     #1
003216  2  8D DB 3A             STA     pweapon         ; dagger
003219  2  A9 00                LDA     #0
00321B  2  8D DC 3A             STA     parmor          ; clothes
00321E  2  A9 00                LDA     #LOC_WORLD
003220  2  8D DD 3A             STA     loc
003223  2  A9 00                LDA     #0
003225  2  8D E2 3A             STA     bosskilled
003228  2  60                   RTS
003229  2               
003229  2               ;----------------------------------------------------------------
003229  2               ; try_move - attempt to move the player by (dx,dy).
003229  2               ;   IN: dx, dy = signed -1/0/+1 deltas
003229  2               ;   Effects: combat on bump, terrain block, town/dungeon entry,
003229  2               ;   treasure pickup, exit interiors, food cost.  Monsters act after
003229  2               ;   a successful step (handled by caller via did_move flag).
003229  2               ;   OUT: did_move (game var) = 1 if a turn was consumed.
003229  2               ;----------------------------------------------------------------
003229  2               try_move:
003229  2  A9 00                LDA     #0
00322B  2  8D E3 3A             STA     did_move
00322E  2                       ; target = (px+dx, py+dy)
00322E  2  18                   CLC
00322F  2  AD D0 3A             LDA     px
003232  2  65 2A                ADC     dx
003234  2  85 2C                STA     tgtx
003236  2  18                   CLC
003237  2  AD D1 3A             LDA     py
00323A  2  65 2B                ADC     dy
00323C  2  85 2D                STA     tgty
00323E  2               
00323E  2                       ; monster there? -> attack (consumes the turn)
00323E  2  20 16 30             JSR     mon_at
003241  2  90 09                BCC     @noenemy
003243  2                       ; X = monster slot ; resolve combat
003243  2  20 02 34             JSR     player_attacks_monster
003246  2  A9 01                LDA     #1
003248  2  8D E3 3A             STA     did_move
00324B  2  60                   RTS
00324C  2               @noenemy:
00324C  2                       ; look at the terrain
00324C  2  20 70 13             JSR     tileat          ; -> tgttile
00324F  2  A6 2E                LDX     tgttile
003251  2  BD 78 12             LDA     tile_prop,X
003254  2  85 20                STA     tmp0            ; property bits
003256  2  29 01                AND     #P_PASS
003258  2  D0 0B                BNE     @passable
00325A  2                       ; blocked
00325A  2  20 97 0D             JSR     sfx_blocked
00325D  2  A9 EB A0 35          PRINTMSG_MSG m_blocked
003261  2  20 3C 2D     
003264  2  60                   RTS                     ; no turn consumed on a wall bump
003265  2               @passable:
003265  2                       ; check special tiles
003265  2  A5 20                LDA     tmp0
003267  2  29 04                AND     #P_TOWN
003269  2  F0 03                BEQ     @ck_dung
00326B  2  4C D9 32             JMP     enter_town
00326E  2               @ck_dung:
00326E  2  A5 20                LDA     tmp0
003270  2  29 08                AND     #P_DUNG
003272  2  F0 03                BEQ     @ck_exit
003274  2  4C 14 33             JMP     enter_dungeon
003277  2               @ck_exit:
003277  2  A5 20                LDA     tmp0
003279  2  29 10                AND     #P_EXIT
00327B  2  F0 03                BEQ     @ck_treas
00327D  2  4C 4F 33             JMP     leave_interior
003280  2               @ck_treas:
003280  2                       ; commit the move first
003280  2  A5 2C                LDA     tgtx
003282  2  8D D0 3A             STA     px
003285  2  A5 2D                LDA     tgty
003287  2  8D D1 3A             STA     py
00328A  2  A9 01                LDA     #1
00328C  2  8D E3 3A             STA     did_move
00328F  2                       ; treasure?
00328F  2  A5 20                LDA     tmp0
003291  2  29 20                AND     #P_TREAS
003293  2  F0 03                BEQ     @food
003295  2  20 B2 32             JSR     collect_treasure
003298  2               @food:
003298  2                       ; consume a unit of food per step
003298  2  AD D9 3A             LDA     pfood
00329B  2  0D DA 3A             ORA     pfood+1
00329E  2  F0 11                BEQ     @nofood
0032A0  2  38                   SEC
0032A1  2  AD D9 3A             LDA     pfood
0032A4  2  E9 01                SBC     #1
0032A6  2  8D D9 3A             STA     pfood
0032A9  2  AD DA 3A             LDA     pfood+1
0032AC  2  E9 00                SBC     #0
0032AE  2  8D DA 3A             STA     pfood+1
0032B1  2               @nofood:
0032B1  2  60                   RTS
0032B2  2               
0032B2  2               ;----------------------------------------------------------------
0032B2  2               ; collect_treasure - pick up a chest at (tgtx,tgty): gold + maybe
0032B2  2               ; XP, then clear the tile to floor.
0032B2  2               ;----------------------------------------------------------------
0032B2  2               collect_treasure:
0032B2  2                       ; gold 5..20
0032B2  2  A9 10                LDA     #16
0032B4  2  20 8F 0C             JSR     rng_d
0032B7  2  18                   CLC
0032B8  2  69 04                ADC     #4
0032BA  2                       ; add to gold (16-bit)
0032BA  2  18                   CLC
0032BB  2  6D D7 3A             ADC     pgold
0032BE  2  8D D7 3A             STA     pgold
0032C1  2  AD D8 3A             LDA     pgold+1
0032C4  2  69 00                ADC     #0
0032C6  2  8D D8 3A             STA     pgold+1
0032C9  2                       ; clear the chest tile -> floor
0032C9  2  A9 09                LDA     #T_FLOOR
0032CB  2  20 17 14             JSR     settile
0032CE  2  20 FC 0D             JSR     sfx_treasure
0032D1  2  A9 F4 A0 35          PRINTMSG_MSG m_treasure
0032D5  2  20 3C 2D     
0032D8  2  60                   RTS
0032D9  2               
0032D9  2               ;----------------------------------------------------------------
0032D9  2               ; enter_town - switch to the town interior map.
0032D9  2               ;----------------------------------------------------------------
0032D9  2               enter_town:
0032D9  2  20 6A 0E             JSR     sfx_door
0032DC  2  20 3A 13             JSR     decode_town
0032DF  2  A9 01                LDA     #LOC_TOWN
0032E1  2  8D DD 3A             STA     loc
0032E4  2  A9 20                LDA     #TOWNW
0032E6  2  8D DE 3A             STA     locw
0032E9  2  A9 14                LDA     #TOWNH
0032EB  2  8D DF 3A             STA     loch
0032EE  2                       ; remember overworld position to restore on exit
0032EE  2  AD D0 3A             LDA     px
0032F1  2  8D E0 3A             STA     owretx
0032F4  2  AD D1 3A             LDA     py
0032F7  2  8D E1 3A             STA     owrety
0032FA  2                       ; place player just inside, one tile NORTH of the door so the
0032FA  2                       ; exit '+' is visible directly south of the player on entry.
0032FA  2  A9 0E                LDA     #14
0032FC  2  8D D0 3A             STA     px
0032FF  2  A9 11                LDA     #TOWNH-3
003301  2  8D D1 3A             STA     py
003304  2                       ; towns have no monsters
003304  2  20 D8 2F             JSR     mon_clear_all
003307  2  A9 01                LDA     #1
003309  2  8D E3 3A             STA     did_move
00330C  2  A9 0F A0 36          PRINTMSG_MSG m_town
003310  2  20 3C 2D     
003313  2  60                   RTS
003314  2               
003314  2               ;----------------------------------------------------------------
003314  2               ; enter_dungeon - switch to the dungeon map and spawn its monsters.
003314  2               ;----------------------------------------------------------------
003314  2               enter_dungeon:
003314  2  20 6A 0E             JSR     sfx_door
003317  2  20 55 13             JSR     decode_dung
00331A  2  A9 02                LDA     #LOC_DUNG
00331C  2  8D DD 3A             STA     loc
00331F  2  A9 20                LDA     #DUNGW
003321  2  8D DE 3A             STA     locw
003324  2  A9 14                LDA     #DUNGH
003326  2  8D DF 3A             STA     loch
003329  2  AD D0 3A             LDA     px
00332C  2  8D E0 3A             STA     owretx
00332F  2  AD D1 3A             LDA     py
003332  2  8D E1 3A             STA     owrety
003335  2                       ; start just east of the stairs-up '<' (at 1,1) so the exit
003335  2                       ; is visible immediately to the west of the player.
003335  2  A9 02                LDA     #2
003337  2  8D D0 3A             STA     px
00333A  2  A9 01                LDA     #1
00333C  2  8D D1 3A             STA     py
00333F  2  20 BA 30             JSR     spawn_dungeon_monsters
003342  2  A9 01                LDA     #1
003344  2  8D E3 3A             STA     did_move
003347  2  A9 4E A0 36          PRINTMSG_MSG m_dungeon
00334B  2  20 3C 2D     
00334E  2  60                   RTS
00334F  2               
00334F  2               ;----------------------------------------------------------------
00334F  2               ; leave_interior - return to the overworld at the saved position.
00334F  2               ;----------------------------------------------------------------
00334F  2               leave_interior:
00334F  2  20 6A 0E             JSR     sfx_door
003352  2  20 1F 13             JSR     decode_world
003355  2  A9 00                LDA     #LOC_WORLD
003357  2  8D DD 3A             STA     loc
00335A  2  AD E0 3A             LDA     owretx
00335D  2  8D D0 3A             STA     px
003360  2  AD E1 3A             LDA     owrety
003363  2  8D D1 3A             STA     py
003366  2  20 3C 30             JSR     spawn_overworld_monsters
003369  2  A9 01                LDA     #1
00336B  2  8D E3 3A             STA     did_move
00336E  2  A9 81 A0 36          PRINTMSG_MSG m_world
003372  2  20 3C 2D     
003375  2  60                   RTS
003376  2               
003376  1                       .INCLUDE "combat.asm"
003376  2               ;______________________________________________________________________________
003376  2               ;  combat.asm - bump combat resolution, leveling, message builder
003376  2               ;______________________________________________________________________________
003376  2               
003376  2               ;----------------------------------------------------------------
003376  2               ; Message builder.  Compose a line in mbuf then push to the log.
003376  2               ;   mb_reset            - start a new line
003376  2               ;   mb_str  (A=lo,Y=hi) - append a 0-terminated string
003376  2               ;   mb_num  (A=byte)    - append a 0..255 value in decimal
003376  2               ;   mb_mname(A=type)    - append a monster type name
003376  2               ;   mb_flush            - push mbuf into the scrolling log
003376  2               ;----------------------------------------------------------------
003376  2               mb_reset:
003376  2  A9 00                LDA     #0
003378  2  8D EF 3B             STA     mblen
00337B  2  60                   RTS
00337C  2               
00337C  2               mb_str:
00337C  2  85 1C                STA     strp
00337E  2  84 1D                STY     strp+1
003380  2  A0 00                LDY     #0
003382  2               @s:
003382  2  B1 1C                LDA     (strp),Y
003384  2  F0 0C                BEQ     @done
003386  2  AE EF 3B             LDX     mblen
003389  2  9D 8F 3B             STA     mbuf,X
00338C  2  EE EF 3B             INC     mblen
00338F  2  C8                   INY
003390  2  D0 F0                BNE     @s
003392  2               @done:
003392  2  60                   RTS
003393  2               
003393  2               ; append A (0..255) as decimal
003393  2               mb_num:
003393  2  85 1E                STA     numarg
003395  2  A9 00                LDA     #0
003397  2  85 1F                STA     numarg+1
003399  2               mb_num16:
003399  2                       ; find highest place
003399  2  A0 08                LDY     #8
00339B  2               @find:
00339B  2  A5 1F                LDA     numarg+1
00339D  2  D9 2A 2D             CMP     nums+1,Y
0033A0  2  90 09                BCC     @nx
0033A2  2  D0 0B                BNE     @start
0033A4  2  A5 1E                LDA     numarg
0033A6  2  D9 29 2D             CMP     nums,Y
0033A9  2  B0 04                BCS     @start
0033AB  2               @nx:
0033AB  2  88                   DEY
0033AC  2  88                   DEY
0033AD  2  D0 EC                BNE     @find
0033AF  2               @start:
0033AF  2  A9 30                LDA     #'0'
0033B1  2  85 28                STA     numspace
0033B3  2               @dig:
0033B3  2  A5 1F                LDA     numarg+1
0033B5  2  D9 2A 2D             CMP     nums+1,Y
0033B8  2  90 1E                BCC     @out
0033BA  2  D0 09                BNE     @noc
0033BC  2  A5 1E                LDA     numarg
0033BE  2  F9 29 2D             SBC     nums,Y
0033C1  2  90 15                BCC     @out
0033C3  2  B0 05                BCS     @sub
0033C5  2               @noc:
0033C5  2  A5 1E                LDA     numarg
0033C7  2  F9 29 2D             SBC     nums,Y
0033CA  2               @sub:
0033CA  2  E6 28                INC     numspace
0033CC  2  85 1E                STA     numarg
0033CE  2  A5 1F                LDA     numarg+1
0033D0  2  F9 2A 2D             SBC     nums+1,Y
0033D3  2  85 1F                STA     numarg+1
0033D5  2  4C B3 33             JMP     @dig
0033D8  2               @out:
0033D8  2  A5 28                LDA     numspace
0033DA  2  AE EF 3B             LDX     mblen
0033DD  2  9D 8F 3B             STA     mbuf,X
0033E0  2  EE EF 3B             INC     mblen
0033E3  2  88                   DEY
0033E4  2  88                   DEY
0033E5  2  10 C8                BPL     @start
0033E7  2  60                   RTS
0033E8  2               
0033E8  2               ; append a monster type name (A = type id)
0033E8  2               mb_mname:
0033E8  2  0A                   ASL     A
0033E9  2  AA                   TAX
0033EA  2  BD 6F 35             LDA     mon_names,X
0033ED  2  BC 70 35             LDY     mon_names+1,X
0033F0  2  4C 7C 33             JMP     mb_str
0033F3  2               
0033F3  2               mb_flush:
0033F3  2  AE EF 3B             LDX     mblen
0033F6  2  A9 00                LDA     #0
