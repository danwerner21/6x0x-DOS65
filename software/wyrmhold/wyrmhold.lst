0016AB  1                       .INCLUDE "title.asm"
0016AB  2               ;______________________________________________________________________________
0016AB  2               ;  title.asm - graphical title screen
0016AB  2               ;
0016AB  2               ;  Composes a colorful scene with direct-VRAM fills, the custom terrain
0016AB  2               ;  tiles, a big block-letter "WYRMHOLD" logo, and a dragon, rather than
0016AB  2               ;  plain ASCII text.
0016AB  2               ;______________________________________________________________________________
0016AB  2               
0016AB  2               ; big-letter logo geometry
0016AB  2               BL_W            = 5             ; cells per letter (incl. 1 col gap handled by caller)
0016AB  2               BL_H            = 5             ; rows per letter
0016AB  2               BL_ROW          = 3             ; top screen row of the logo
0016AB  2               BL_COL          = 8             ; left screen col of the logo
0016AB  2               
0016AB  2               ;----------------------------------------------------------------
0016AB  2               ; draw_title_scene - paint the whole title screen.
0016AB  2               ;----------------------------------------------------------------
0016AB  2               draw_title_scene:
0016AB  2  20 04 37             JSR     cls_vram
0016AE  2  20 88 36             JSR     vid_enter
0016B1  2               
0016B1  2                       ; --- sky band (rows 0..9) : deep blue background ---
0016B1  2  A9 00                LDA     #0
0016B3  2  85 27                STA     rowidx
0016B5  2               @sky:
0016B5  2  A5 27                LDA     rowidx
0016B7  2  85 21                STA     tmp1
0016B9  2  A9 00                LDA     #0
0016BB  2  85 22                STA     tmp2
0016BD  2  A9 20                LDA     #space
0016BF  2  85 23                STA     tmp3
0016C1  2  A9 1F                LDA     #COLOR(CO_BRWHITE, CO_BLUE)
0016C3  2  85 26                STA     colidx
0016C5  2  A9 50                LDA     #SCRW
0016C7  2  85 24                STA     cnt0
0016C9  2  20 2A 37             JSR     fillrow_vram
0016CC  2  E6 27                INC     rowidx
0016CE  2  A5 27                LDA     rowidx
0016D0  2  C9 0A                CMP     #10
0016D2  2  D0 E1                BNE     @sky
0016D4  2               
0016D4  2                       ; sprinkle a few "stars" in the sky (asterisks)
0016D4  2  A9 2E                LDA     #'.'
0016D6  2  85 23                STA     tmp3
0016D8  2  A9 1F                LDA     #COLOR(CO_BRWHITE, CO_BLUE)
0016DA  2  85 26                STA     colidx
0016DC  2  A2 00                LDX     #0
0016DE  2               @stars:
0016DE  2  BD C5 18             LDA     star_row,X
0016E1  2  85 21                STA     tmp1
0016E3  2  BD CF 18             LDA     star_col,X
0016E6  2  85 22                STA     tmp2
0016E8  2  DA                   PHX
0016E9  2  20 F4 36             JSR     putcell
0016EC  2  FA                   PLX
0016ED  2  E8                   INX
0016EE  2  E0 0A                CPX     #NSTARS
0016F0  2  D0 EC                BNE     @stars
0016F2  2               
0016F2  2                       ; --- ground band (rows 16..23) : green ---
0016F2  2  A9 10                LDA     #16
0016F4  2  85 27                STA     rowidx
0016F6  2               @grnd:
0016F6  2  A5 27                LDA     rowidx
0016F8  2  85 21                STA     tmp1
0016FA  2  A9 00                LDA     #0
0016FC  2  85 22                STA     tmp2
0016FE  2  A9 01                LDA     #G_GRASS
001700  2  85 23                STA     tmp3
001702  2  A9 2A                LDA     #C_GRASS
001704  2  85 26                STA     colidx
001706  2  A9 50                LDA     #SCRW
001708  2  85 24                STA     cnt0
00170A  2  20 2A 37             JSR     fillrow_vram
00170D  2  E6 27                INC     rowidx
00170F  2  A5 27                LDA     rowidx
001711  2  C9 18                CMP     #24
001713  2  D0 E1                BNE     @grnd
001715  2               
001715  2                       ; --- a mountain range across the horizon (row 15) ---
001715  2  A9 0F                LDA     #15
001717  2  85 21                STA     tmp1
001719  2  A9 00                LDA     #0
00171B  2  85 22                STA     tmp2
00171D  2  A9 03                LDA     #G_MOUNT
00171F  2  85 23                STA     tmp3
001721  2  A9 8F                LDA     #C_MOUNT
001723  2  85 26                STA     colidx
001725  2  A9 50                LDA     #SCRW
001727  2  85 24                STA     cnt0
001729  2  20 2A 37             JSR     fillrow_vram
00172C  2               
00172C  2  20 97 36             JSR     vid_exit
00172F  2               
00172F  2                       ; --- scenery objects (single tiles) via putcell helper ---
00172F  2  20 7D 17             JSR     draw_scenery
001732  2               
001732  2                       ; --- the big block-letter logo ---
001732  2  20 FC 17             JSR     draw_logo
001735  2               
001735  2                       ; --- text: subtitle, prompt, controls (colored) ---
001735  2  A2 1A                LDX     #26
001737  2  A0 0A                LDY     #10
001739  2  20 D6 37             JSR     locate
00173C  2  A9 0B                LDA     #COLOR(CO_BRTURQ, CO_BLACK)
00173E  2  8D 4A 06             STA     CURCOLOR
001741  2  A9 65 A0 0A          PRINTMSG ttl_by
001745  2  20 E8 37     
001748  2               
001748  2  A2 17                LDX     #23
00174A  2  A0 12                LDY     #18
00174C  2  20 D6 37             JSR     locate
00174F  2  A9 0E                LDA     #COLOR(CO_BRYELLOW, CO_BLACK)
001751  2  8D 4A 06             STA     CURCOLOR
001754  2  A9 8B A0 0A          PRINTMSG ttl_prompt
001758  2  20 E8 37     
00175B  2               
00175B  2  A2 14                LDX     #20
00175D  2  A0 15                LDY     #21
00175F  2  20 D6 37             JSR     locate
001762  2  A9 0F                LDA     #COLOR(CO_BRWHITE, CO_BLACK)
001764  2  8D 4A 06             STA     CURCOLOR
001767  2  A9 AC A0 0A          PRINTMSG ttl_keys1
00176B  2  20 E8 37     
00176E  2  A2 14                LDX     #20
001770  2  A0 16                LDY     #22
001772  2  20 D6 37             JSR     locate
001775  2  A9 D5 A0 0A          PRINTMSG ttl_keys2
001779  2  20 E8 37     
00177C  2  60                   RTS
00177D  2               
00177D  2               ;----------------------------------------------------------------
00177D  2               ; draw_scenery - place tile objects on the landscape: forests, a
00177D  2               ; castle, a lake, and a big dragon (boss glyph) menacing the scene.
00177D  2               ;----------------------------------------------------------------
00177D  2               draw_scenery:
00177D  2  20 88 36             JSR     vid_enter
001780  2                       ; forests dotted along the ground (row 16/17)
001780  2  A2 00                LDX     #0
001782  2               @trees:
001782  2  BD D9 18             LDA     tree_row,X
001785  2  85 21                STA     tmp1
001787  2  BD E2 18             LDA     tree_col,X
00178A  2  85 22                STA     tmp2
00178C  2  A9 02                LDA     #G_FOREST
00178E  2  85 23                STA     tmp3
001790  2  A9 0A                LDA     #C_FOREST
001792  2  85 26                STA     colidx
001794  2  DA                   PHX
001795  2  20 F4 36             JSR     putcell
001798  2  FA                   PLX
001799  2  E8                   INX
00179A  2  E0 09                CPX     #NTREES
00179C  2  D0 E4                BNE     @trees
00179E  2               
00179E  2                       ; a castle on the left hill (row 14-15 area)
00179E  2  A9 0E                LDA     #14
0017A0  2  85 21                STA     tmp1
0017A2  2  A9 06                LDA     #6
0017A4  2  85 22                STA     tmp2
0017A6  2  A9 07                LDA     #G_CASTLE
0017A8  2  85 23                STA     tmp3
0017AA  2  A9 8F                LDA     #C_CASTLE
0017AC  2  85 26                STA     colidx
0017AE  2  20 F4 36             JSR     putcell
0017B1  2  A9 0E                LDA     #14
0017B3  2  85 21                STA     tmp1
0017B5  2  A9 07                LDA     #7
0017B7  2  85 22                STA     tmp2
0017B9  2  20 F4 36             JSR     putcell
0017BC  2               
0017BC  2                       ; a small lake on the right (row 17)
0017BC  2  A9 11                LDA     #17
0017BE  2  85 21                STA     tmp1
0017C0  2  A9 3E                LDA     #62
0017C2  2  85 22                STA     tmp2
0017C4  2  A9 04                LDA     #G_WATER
0017C6  2  85 23                STA     tmp3
0017C8  2  A9 1B                LDA     #C_WATER
0017CA  2  85 26                STA     colidx
0017CC  2  A9 0A                LDA     #10
0017CE  2  85 24                STA     cnt0
0017D0  2  20 2A 37             JSR     fillrow_vram
0017D3  2               
0017D3  2                       ; the DRAGON - big and red, hovering at the right of the sky
0017D3  2  A9 0C                LDA     #12
0017D5  2  85 21                STA     tmp1
0017D7  2  A9 3C                LDA     #60
0017D9  2  85 22                STA     tmp2
0017DB  2  A9 16                LDA     #G_BOSS
0017DD  2  85 23                STA     tmp3
0017DF  2  A9 1C                LDA     #COLOR(CO_BRRED, CO_BLUE)
0017E1  2  85 26                STA     colidx
0017E3  2  20 F4 36             JSR     putcell
0017E6  2                       ; a second dragon, smaller/left, different color
0017E6  2  A9 06                LDA     #6
0017E8  2  85 21                STA     tmp1
0017EA  2  A9 42                LDA     #66
0017EC  2  85 22                STA     tmp2
0017EE  2  A9 16                LDA     #G_BOSS
0017F0  2  85 23                STA     tmp3
0017F2  2  A9 1E                LDA     #COLOR(CO_BRYELLOW, CO_BLUE)
0017F4  2  85 26                STA     colidx
0017F6  2  20 F4 36             JSR     putcell
0017F9  2               
0017F9  2  4C 97 36             JMP     vid_exit
0017FC  2               
0017FC  2               ;----------------------------------------------------------------
0017FC  2               ; draw_logo - stamp the big block-letter "WYRMHOLD" logo using
0017FC  2               ; solid wall tiles in bright gold.  Each letter is a 5x5 bitmap
0017FC  2               ; (5 bytes, top bit = leftmost of 5 columns).  Letters are spaced
0017FC  2               ; BL_W+1 columns apart.
0017FC  2               ;----------------------------------------------------------------
0017FC  2               draw_logo:
0017FC  2  20 88 36             JSR     vid_enter
0017FF  2  A9 00                LDA     #0
001801  2  8D 8B 51             STA     logo_li         ; letter index
001804  2               @letter:
001804  2  AD 8B 51             LDA     logo_li
001807  2  C9 08                CMP     #8              ; 8 letters
001809  2  90 03                BCC     :+
00180B  2  4C 9A 18             JMP     @done
00180E  2               :
00180E  2                       ; pointer to this letter's 5 bytes:  logo_font + li*5
00180E  2  AD 8B 51             LDA     logo_li
001811  2  85 20                STA     tmp0
001813  2  0A                   ASL     A               ; *2
001814  2  0A                   ASL     A               ; *4
001815  2  18                   CLC
001816  2  65 20                ADC     tmp0            ; *5
001818  2  A8                   TAY                     ; Y = li*5 offset into logo_font
001819  2                       ; left screen column for this letter = BL_COL + li*(BL_W+1)
001819  2  AD 8B 51             LDA     logo_li
00181C  2  85 20                STA     tmp0
00181E  2  0A                   ASL     A               ; *2
00181F  2  0A                   ASL     A               ; *4
001820  2  18                   CLC
001821  2  65 20                ADC     tmp0            ; *5
001823  2  18                   CLC
001824  2  6D 8B 51             ADC     logo_li         ; + li  -> li*6
001827  2  18                   CLC
001828  2  69 08                ADC     #BL_COL
00182A  2  8D 8C 51             STA     logo_lx         ; base column
00182D  2                       ; draw 5 rows
00182D  2  A9 00                LDA     #0
00182F  2  8D 8D 51             STA     logo_ry
001832  2               @row:
001832  2  AD 8D 51             LDA     logo_ry
001835  2  C9 05                CMP     #BL_H
001837  2  B0 5B                BCS     @nextletter
001839  2                       ; fetch the bitmap byte for (li,row): logo_font[li*5 + row]
001839  2  98                   TYA
00183A  2  18                   CLC
00183B  2  6D 8D 51             ADC     logo_ry
00183E  2  AA                   TAX
00183F  2  BD 9D 18             LDA     logo_font,X
001842  2  8D 8F 51             STA     logo_bits       ; 5 bits, bit4..bit0 = cols 0..4
001845  2                       ; draw 5 columns
001845  2  A9 00                LDA     #0
001847  2  8D 8E 51             STA     logo_cx
00184A  2               @col:
00184A  2  AD 8E 51             LDA     logo_cx
00184D  2  C9 05                CMP     #BL_W
00184F  2  B0 32                BCS     @nextrow
001851  2                       ; test bit (4 - cx) of logo_bits
001851  2  A9 10                LDA     #%00010000      ; bit4 mask
001853  2  AE 8E 51             LDX     logo_cx
001856  2  F0 04                BEQ     @havemask
001858  2               @shr:
001858  2  4A                   LSR     A
001859  2  CA                   DEX
00185A  2  D0 FC                BNE     @shr
00185C  2               @havemask:
00185C  2  2D 8F 51             AND     logo_bits
00185F  2  F0 1C                BEQ     @blank
001861  2                       ; set pixel -> solid gold block
001861  2  AD 8D 51             LDA     logo_ry
001864  2  18                   CLC
001865  2  69 03                ADC     #BL_ROW
001867  2  85 21                STA     tmp1            ; screen row
001869  2  AD 8C 51             LDA     logo_lx
00186C  2  18                   CLC
00186D  2  6D 8E 51             ADC     logo_cx
001870  2  85 22                STA     tmp2            ; screen col
001872  2  A9 0B                LDA     #G_WALL
001874  2  85 23                STA     tmp3
001876  2  A9 4E                LDA     #COLOR(CO_BRYELLOW, CO_RED)
001878  2  85 26                STA     colidx
00187A  2  20 F4 36             JSR     putcell
00187D  2               @blank:
00187D  2  EE 8E 51             INC     logo_cx
001880  2  4C 4A 18             JMP     @col
001883  2               @nextrow:
001883  2  EE 8D 51             INC     logo_ry
001886  2                       ; Y must be reloaded (clobbered above): recompute li*5
001886  2  AD 8B 51             LDA     logo_li
001889  2  85 20                STA     tmp0
00188B  2  0A                   ASL     A
00188C  2  0A                   ASL     A
00188D  2  18                   CLC
00188E  2  65 20                ADC     tmp0
001890  2  A8                   TAY
001891  2  4C 32 18             JMP     @row
001894  2               @nextletter:
001894  2  EE 8B 51             INC     logo_li
001897  2  4C 04 18             JMP     @letter
00189A  2               @done:
00189A  2  4C 97 36             JMP     vid_exit
00189D  2               
00189D  2               ;----------------------------------------------------------------
00189D  2               ; Big-letter 5x5 font for  W Y R M H O L D  (bit4..bit0 = 5 cols)
00189D  2               ;----------------------------------------------------------------
00189D  2               logo_font:
00189D  2                       ; W
00189D  2  11                   .BYTE   %10001
00189E  2  11                   .BYTE   %10001
00189F  2  15                   .BYTE   %10101
0018A0  2  1B                   .BYTE   %11011
0018A1  2  11                   .BYTE   %10001
0018A2  2                       ; Y
0018A2  2  11                   .BYTE   %10001
0018A3  2  0A                   .BYTE   %01010
0018A4  2  04                   .BYTE   %00100
0018A5  2  04                   .BYTE   %00100
0018A6  2  04                   .BYTE   %00100
0018A7  2                       ; R
0018A7  2  1E                   .BYTE   %11110
0018A8  2  11                   .BYTE   %10001
0018A9  2  1E                   .BYTE   %11110
0018AA  2  12                   .BYTE   %10010
0018AB  2  11                   .BYTE   %10001
0018AC  2                       ; M
0018AC  2  11                   .BYTE   %10001
0018AD  2  1B                   .BYTE   %11011
0018AE  2  15                   .BYTE   %10101
0018AF  2  11                   .BYTE   %10001
0018B0  2  11                   .BYTE   %10001
0018B1  2                       ; H
0018B1  2  11                   .BYTE   %10001
0018B2  2  11                   .BYTE   %10001
0018B3  2  1F                   .BYTE   %11111
0018B4  2  11                   .BYTE   %10001
0018B5  2  11                   .BYTE   %10001
0018B6  2                       ; O
0018B6  2  0E                   .BYTE   %01110
0018B7  2  11                   .BYTE   %10001
0018B8  2  11                   .BYTE   %10001
0018B9  2  11                   .BYTE   %10001
0018BA  2  0E                   .BYTE   %01110
0018BB  2                       ; L
0018BB  2  10                   .BYTE   %10000
0018BC  2  10                   .BYTE   %10000
0018BD  2  10                   .BYTE   %10000
0018BE  2  10                   .BYTE   %10000
0018BF  2  1F                   .BYTE   %11111
0018C0  2                       ; D
0018C0  2  1E                   .BYTE   %11110
0018C1  2  11                   .BYTE   %10001
0018C2  2  11                   .BYTE   %10001
0018C3  2  11                   .BYTE   %10001
0018C4  2  1E                   .BYTE   %11110
