001CF6  2  7E 7E 7E 7E  
001D33  2  7E 2E 2E 2E          .BYTE   "~..............................................................~~",0
001D37  2  2E 2E 2E 2E  
001D3B  2  2E 2E 2E 2E  
001D75  2  7E 2E 2E 26          .BYTE   "~..&&&....hh^^^^hh.......&&&&&.........hh^^^hh.........&&&.....~~~",0
001D79  2  26 26 2E 2E  
001D7D  2  2E 2E 68 68  
001DB8  2  7E 2E 26 26          .BYTE   "~.&&&&&..hh^^^^^^hh.....&&&&&&&.......hh^^^^^hh.......&&&&&....~~~~",0
001DBC  2  26 26 26 2E  
001DC0  2  2E 68 68 5E  
001DFC  2  7E 2E 26 26          .BYTE   "~.&&&....hh^^^^^^^hh...&&&...&&......hh^^^^^^hh......&&&&&&&...~~~~",0
001E00  2  26 2E 2E 2E  
001E04  2  2E 68 68 5E  
001E40  2  7E 2E 2E 26          .BYTE   "~..&.....hh^^^^^^hh...&&.......&&....hh^^^^^hh.......&&&&&....~~~~~",0
001E44  2  2E 2E 2E 2E  
001E48  2  2E 68 68 5E  
001E84  2  7E 2E 2E 2E          .BYTE   "~.......hh^^^^hh.....&&.........&....hh^^^hh.........&&&......~~~~~",0
001E88  2  2E 2E 2E 2E  
001E8C  2  68 68 5E 5E  
001EC8  2  7E 2E 2E 2E          .BYTE   "~....................................................T.......~~~~~",0
001ECC  2  2E 2E 2E 2E  
001ED0  2  2E 2E 2E 2E  
001F0B  2  7E 2E 2E 2E          .BYTE   "~...............:::::::::::....................::::::::......~~~~~~",0
001F0F  2  2E 2E 2E 2E  
001F13  2  2E 2E 2E 2E  
001F4F  2  7E 2E 2E 26          .BYTE   "~..&&......^^^..:..............:::::::::::::::::.......:.....~~~~~~",0
001F53  2  26 2E 2E 2E  
001F57  2  2E 2E 2E 5E  
001F93  2  7E 2E 26 26          .BYTE   "~.&&&&....^^^^^.:..............................:......:.....~~~~~~",0
001F97  2  26 26 2E 2E  
001F9B  2  2E 2E 5E 5E  
001FD6  2  7E 2E 26 26          .BYTE   "~.&&&....^^^^^^.:.............hhhhh............:......:....~~~~~~~",0
001FDA  2  26 2E 2E 2E  
001FDE  2  2E 5E 5E 5E  
002019  2  7E 2E 2E 26          .BYTE   "~..&....^^^^^...:.............h~~~h............:......:...~~~~~~~~",0
00201D  2  2E 2E 2E 2E  
002021  2  5E 5E 5E 5E  
00205C  2  7E 2E 2E 2E          .BYTE   "~......^^^^....::.............h~C~h............:......:...~~~~~~~~",0
002060  2  2E 2E 2E 5E  
002064  2  5E 5E 5E 2E  
00209F  2  7E 2E 2E 2E          .BYTE   "~.....^^^....::..............::::::............:......:..~~~~~~~~~",0
0020A3  2  2E 2E 5E 5E  
0020A7  2  5E 2E 2E 2E  
