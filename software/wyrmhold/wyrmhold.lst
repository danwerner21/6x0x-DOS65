001B5C  2  26 11                ROL     ptr+1
001B5E  2  06 10                ASL     ptr
001B60  2  26 11                ROL     ptr+1           ; *32
001B62  2  18                   CLC
001B63  2  A5 10                LDA     ptr
001B65  2  65 2C                ADC     tgtx
001B67  2  85 10                STA     ptr
001B69  2  A5 11                LDA     ptr+1
001B6B  2  69 00                ADC     #0
