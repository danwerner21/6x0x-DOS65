005719  1                       .INCLUDE "town.asm"
005719  2               ;______________________________________________________________________________
005719  2               ;  town.asm - shop interaction inside towns
005719  2               ;
005719  2               ;  When the player presses USE ('T') in a town while adjacent to a
005719  2               ;  shop counter ('S' tile), the shop menu opens.  The menu is drawn
005719  2               ;  over the message rows; the player picks an option, gold is spent,
005719  2               ;  and the menu returns to the map.
005719  2               ;______________________________________________________________________________
005719  2               
005719  2               ; Eastmere's outfitter favors equipment; Valehaven's market favors
005719  2               ; healing and provisions. All services remain available in both.
005719  2               shop_heal_price:
005719  2  0F 05                .BYTE   15, 5
00571B  2               shop_food_price:
00571B  2  19 0F                .BYTE   25, 15
00571D  2               shop_food_amount:
00571D  2  4B 96                .BYTE   75, 150
00571F  2               shop_weapon_price:
00571F  2  2D 4B                .BYTE   45, 75
005721  2               shop_armor_price:
005721  2  23 41                .BYTE   35, 65
005723  2               
005723  2               ;----------------------------------------------------------------
005723  2               ; use_action - bound to the USE key ('T'). Dispatch contextual
005723  2               ; interactions for the active location.
005723  2               ;----------------------------------------------------------------
005723  2               use_action:
005723  2  AD 19 62             LDA     loc
005726  2  C9 00                CMP     #LOC_WORLD
005728  2  F0 10                BEQ     @inworld
00572A  2  C9 03                CMP     #LOC_CASTLE
00572C  2  F0 0F                BEQ     @incastle
00572E  2  C9 01                CMP     #LOC_TOWN
005730  2  F0 0E                BEQ     @intown
005732  2  A9 BD A0 5B          PRINTMSG_MSG t_nothing
005736  2  20 F9 3D     
005739  2  60                   RTS
00573A  2               @inworld:
00573A  2  4C 4A 4C             JMP     overworld_use
00573D  2               @incastle:
00573D  2  4C CD 5C             JMP     castle_use
005740  2               @intown:
005740  2               ; is a shop tile adjacent (4-neighbour) or under us?
005740  2  20 50 57             JSR     shop_adjacent
005743  2  B0 08                BCS     @open
005745  2  A9 CE A0 5B          PRINTMSG_MSG t_noshop
005749  2  20 F9 3D     
00574C  2  60                   RTS
00574D  2               @open:
00574D  2  4C BA 57             JMP     shop_menu
005750  2               
005750  2               ;----------------------------------------------------------------
005750  2               ; shop_adjacent - C=1 if a T_SHOP tile is at or next to the player.
005750  2               ;----------------------------------------------------------------
005750  2               shop_adjacent:
005750  2               ; center
005750  2  AD 0C 62             LDA     px
005753  2  85 2C                STA     tgtx
005755  2  AD 0D 62             LDA     py
005758  2  85 2D                STA     tgty
00575A  2  20 C4 1B             JSR     tileat
00575D  2  A5 2E                LDA     tgttile
00575F  2  C9 0E                CMP     #T_SHOP
005761  2  F0 55                BEQ     @yes
005763  2               ; up
005763  2  AD 0C 62             LDA     px
005766  2  85 2C                STA     tgtx
005768  2  AD 0D 62             LDA     py
00576B  2  38                   SEC
00576C  2  E9 01                SBC     #1
00576E  2  85 2D                STA     tgty
005770  2  20 C4 1B             JSR     tileat
005773  2  A5 2E                LDA     tgttile
005775  2  C9 0E                CMP     #T_SHOP
005777  2  F0 3F                BEQ     @yes
005779  2               ; down
005779  2  AD 0D 62             LDA     py
00577C  2  18                   CLC
00577D  2  69 01                ADC     #1
00577F  2  85 2D                STA     tgty
005781  2  AD 0C 62             LDA     px
005784  2  85 2C                STA     tgtx
005786  2  20 C4 1B             JSR     tileat
005789  2  A5 2E                LDA     tgttile
00578B  2  C9 0E                CMP     #T_SHOP
00578D  2  F0 29                BEQ     @yes
00578F  2               ; left
00578F  2  AD 0D 62             LDA     py
005792  2  85 2D                STA     tgty
005794  2  AD 0C 62             LDA     px
005797  2  38                   SEC
005798  2  E9 01                SBC     #1
00579A  2  85 2C                STA     tgtx
00579C  2  20 C4 1B             JSR     tileat
00579F  2  A5 2E                LDA     tgttile
0057A1  2  C9 0E                CMP     #T_SHOP
0057A3  2  F0 13                BEQ     @yes
0057A5  2               ; right
0057A5  2  AD 0C 62             LDA     px
0057A8  2  18                   CLC
0057A9  2  69 01                ADC     #1
0057AB  2  85 2C                STA     tgtx
0057AD  2  20 C4 1B             JSR     tileat
0057B0  2  A5 2E                LDA     tgttile
0057B2  2  C9 0E                CMP     #T_SHOP
0057B4  2  F0 02                BEQ     @yes
0057B6  2  18                   CLC
0057B7  2  60                   RTS
0057B8  2               @yes:
0057B8  2  38                   SEC
0057B9  2  60                   RTS
0057BA  2               
0057BA  2               ;----------------------------------------------------------------
0057BA  2               ; shop_menu - draw the shop menu over the message area and loop
0057BA  2               ; processing purchases until the player presses X.
0057BA  2               ;----------------------------------------------------------------
0057BA  2               shop_menu:
0057BA  2  20 AF 0F             JSR     sfx_door
0057BD  2               ; start with the greeting as the status line
0057BD  2  20 EE 58             JSR     shop_set_greeting
0057C0  2               @redraw:
0057C0  2  20 15 59             JSR     shop_draw
0057C3  2               @key:
0057C3  2  20 79 41             JSR     getkey_block
0057C6  2  C9 31                CMP     #'1'
0057C8  2  D0 03                BNE     :+
0057CA  2  4C F6 57             JMP     @heal
0057CD  2               :
0057CD  2  C9 32                CMP     #'2'
0057CF  2  D0 03                BNE     :+
0057D1  2  4C 1C 58             JMP     @food
0057D4  2               :
