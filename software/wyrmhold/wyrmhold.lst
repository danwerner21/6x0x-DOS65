00415D  2               ;----------------------------------------------------------------
00415D  2               ; yorn - wait for a Y/N keypress.  Returns Z=1 if Yes (A='Y').
00415D  2               ;----------------------------------------------------------------
00415D  2               yorn:
00415D  2               @wait:
00415D  2  20 79 41             JSR     getkey_block
004160  2  C9 59                CMP     #'Y'
004162  2  F0 0F                BEQ     @yes
004164  2  C9 79                CMP     #'y'
004166  2  F0 0B                BEQ     @yes
004168  2  C9 4E                CMP     #'N'
00416A  2  F0 0A                BEQ     @no
00416C  2  C9 6E                CMP     #'n'
00416E  2  F0 06                BEQ     @no
004170  2  4C 5D 41             JMP     @wait
004173  2               @yes:
004173  2  A9 00                LDA     #0              ; Z=1
004175  2  60                   RTS
004176  2               @no:
004176  2  A9 01                LDA     #1              ; Z=0
004178  2  60                   RTS
004179  2               
004179  2               ;----------------------------------------------------------------
004179  2               ; getkey_block - block until a key is pressed; return it in A.
004179  2               ;----------------------------------------------------------------
004179  2               getkey_block:
004179  2               @gk:
004179  2  A9 14 85 32          FARCALL FC_CHRIN
00417D  2  20 F0 FF     
004180  2  C9 FF                CMP     #$FF
004182  2  F0 F5                BEQ     @gk
004184  2  60                   RTS
004185  2               
004185  2               ;----------------------------------------------------------------
004185  2               ; getkey - non-blocking read; A=key or 0 if none.
004185  2               ;----------------------------------------------------------------
004185  2               getkey:
004185  2  A9 14 85 32          FARCALL FC_CHRIN
004189  2  20 F0 FF     
00418C  2  C9 FF                CMP     #$FF
00418E  2  D0 02                BNE     @got
004190  2  A9 00                LDA     #0
004192  2               @got:
004192  2  60                   RTS
004193  2               
004193  2               ;----------------------------------------------------------------
004193  2               ; drainkeys - consume and discard all buffered keystrokes.
004193  2               ;----------------------------------------------------------------
004193  2               drainkeys:
004193  2               @dk:
004193  2  A9 14 85 32          FARCALL FC_CHRIN
004197  2  20 F0 FF     
00419A  2  C9 FF                CMP     #$FF
00419C  2  D0 F5                BNE     @dk             ; got a key - keep draining
00419E  2  60                   RTS
