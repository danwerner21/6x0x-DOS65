001398  3               ;___OPEN____________________________________________________
001398  3               ;
001398  3               ; OPEN A FILE
001398  3               ;
001398  3               ;
001398  3               ; BASIC COMMAND EXPECTS FOUR VARS
001398  3               
001398  3               ; DRIVE,MODE, FILENAME$,FILE$
001398  3               ;
001398  3               ; FILE$ = STRING TO HOLD 33 BYTE FCB
001398  3               ; DRIVE = NUMERIC DRIVE -- 0=A, 1=B, 2= . . .
001398  3               ; MODE = 0=EXISTING, 1=CREATE
001398  3               ; FILENAME$ = FILENAME STRING
001398  3               ;__________________________________________________________
001398  3               V_OPEN:
001398  3                                               ; CLEAR FCB
001398  3  A9 00                LDA     #0              ; FILL WITH NULL
00139A  3  A0 00                LDY     #0              ;
00139C  3               :
00139C  3  99 70 15             STA     FCB,Y           ;
00139F  3  C8                   INY                     ;
0013A0  3  C0 21                CPY     #33             ;
0013A2  3  D0 F8                BNE     :-              ;
0013A4  3                                               ;
0013A4  3  A9 20                LDA     #32             ; FILL FILENAME AND EXTENSION WITH SPACES
0013A6  3  A0 01                LDY     #1              ;
0013A8  3               :
0013A8  3  99 70 15             STA     FCB,Y           ;
0013AB  3  C8                   INY                     ;
0013AC  3  C0 0C                CPY     #12             ;
0013AE  3  D0 F8                BNE     :-              ;
0013B0  3                                               ;
0013B0  3  20 E7 2A             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (DRIVE)
0013B3  3  8A                   TXA
0013B4  3  8D 70 15             STA     FCB             ; STORE DRIVE IN FCB
0013B7  3                                               ;
0013B7  3  20 56 22             JSR     LAB_1C01        ; (AFTER ',') OR SYN ERR
0013BA  3  20 E7 2A             JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X (MODE)
0013BD  3                                               ;
0013BD  3  E0 00                CPX     #0
0013BF  3  D0 08                BNE     :+
0013C1  3  A9 0F                LDA     #15
0013C3  3  8D 77 14             STA     OPNTMP
0013C6  3  4C CE 13             JMP     V_OPEN1
0013C9  3               :
0013C9  3  A9 16                LDA     #22
0013CB  3  8D 77 14             STA     OPNTMP          ;
0013CE  3               V_OPEN1:
0013CE  3  20 56 22             JSR     LAB_1C01        ; (AFTER ',') OR SYN ERR
0013D1  3  20 38 21             JSR     LAB_EVEX        ; GET THE THIRD PARAMETER
0013D4  3  A5 5F                LDA     <Dtypef         ; IS IT A STRING?
0013D6  3  D0 08                BNE     :+              ; YES, CONTINUE ON
0013D8  3  A2 02                LDX     #$02            ; NOPE, SYNTAX ERROR
0013DA  3  20 94 17             JSR     LAB_XERR
0013DD  3  4C 6C 18             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
0013E0  3               :
0013E0  3  20 99 29             JSR     LAB_22B6        ; pop string off descriptor stack, or from top of string
0013E3  3                                               ; space returns with A = length, X=$71=pointer low byte,
0013E3  3                                               ; Y=$72=pointer high byte
0013E3  3  85 AC                STA     str_ln          ; set string length
0013E5  3  86 AD                STX     str_pl          ; set string pointer low byte
0013E7  3  84 AE                STY     str_ph          ; set string pointer high byte
0013E9  3                                               ; STORE IN FILENAME AND EXTENSION
0013E9  3  A2 00                LDX     #0
0013EB  3  A0 00                LDY     #0
0013ED  3               :
0013ED  3  B1 AD                LDA     (str_pl),Y
0013EF  3  C9 2E                CMP     #'.'
0013F1  3  F0 1E                BEQ     V_OPEN_EXTENSION
0013F3  3  C4 AC                CPY     str_ln
0013F5  3  F0 35                BEQ     V_OPEN_FNEND
0013F7  3  C8                   INY
0013F8  3  99 70 15             STA     FCB,Y
0013FB  3  C0 08                CPY     #8
0013FD  3  D0 EE                BNE     :-
0013FF  3               :
0013FF  3  C8                   INY
001400  3  B9 70 15             LDA     FCB,Y
001403  3  C9 2E                CMP     #'.'
001405  3  F0 0A                BEQ     V_OPEN_EXTENSION
001407  3  C4 AC                CPY     str_ln
001409  3  F0 21                BEQ     V_OPEN_FNEND
00140B  3  4C FF 13             JMP     :-
00140E  3  4C 2C 14             JMP     V_OPEN_FNEND
001411  3               V_OPEN_EXTENSION:
001411  3  A2 09                LDX     #9
001413  3               :
001413  3  C8                   INY
001414  3  B1 AD                LDA     (str_pl),Y
001416  3  C4 AC                CPY     str_ln
001418  3  F0 12                BEQ     V_OPEN_FNEND
00141A  3  84 E4                STY     Rbyte3
00141C  3  86 E3                STX     Rbyte2
00141E  3  A4 E3                LDY     Rbyte2
001420  3  99 70 15             STA     FCB,Y
001423  3  E6 E3                INC     Rbyte2
001425  3  A4 E4                LDY     Rbyte3
001427  3  E8                   INX
001428  3  E0 0C                CPX     #12
00142A  3  D0 E7                BNE     :-
00142C  3               V_OPEN_FNEND:
00142C  3  A2 0D                LDX     #13             ; INITIALIZE SYSTEM
00142E  3  20 4D 11             JSR     PEM             ;
001431  3  AE 77 14             LDX     OPNTMP          ; OPEN OR CREATE
001434  3  A9 70                LDA     #<FCB           ; FCB
001436  3  A0 15                LDY     #>FCB           ; FCB
001438  3  20 4D 11             JSR     PEM
00143B  3  C9 FF                CMP     #$FF
00143D  3  D0 08                BNE     :+
00143F  3  A2 24                LDX     #$24            ; IO ERROR
001441  3  20 94 17             JSR     LAB_XERR
001444  3  4C 6C 18             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001447  3               :
001447  3  20 56 22             JSR     LAB_1C01        ; (AFTER ',') OR SYN ERR
00144A  3  20 03 24             JSR     LAB_GVAR        ; GET THE FOURTH PARAMETER
00144D  3  85 97                STA     Lvarpl          ; save var address low byte
00144F  3  84 98                STY     Lvarph          ; save var address high byte
001451  3  A5 5F                LDA     <Dtypef         ; IS IT A STRING?
001453  3  D0 08                BNE     :+              ; YES, CONTINUE ON
001455  3  A2 02                LDX     #$02            ; NOPE, SYNTAX ERROR
001457  3  20 94 17             JSR     LAB_XERR
00145A  3  4C 6C 18             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
00145D  3               :
00145D  3  A9 22                LDA     #34
00145F  3  20 93 27             JSR     LAB_MSSP        ; make string space A bytes long A=$AC=length,
001462  3                                               ; X=$AD=<Sutill=ptr low byte, Y=$AE=<Sutilh=ptr high byte
001462  3                                               ; COPY FCB TO STRING
001462  3  A2 21                LDX     #33             ;
001464  3  A0 21                LDY     #33             ;
001466  3               :
001466  3  CA                   DEX
001467  3  88                   DEY
001468  3  BD 70 15             LDA     FCB,X
00146B  3  91 AD                STA     (str_pl),Y       ;
00146D  3  E0 00                CPX     #0              ;
00146F  3  D0 F5                BNE     :-              ;
001471  3                                               ;
001471  3  20 E0 27             JSR     LAB_RTST        ; STORE STRING
001474  3  4C 27 1E             JMP     LAB_17D5        ; do string LET and return
001477  3               
001477  3               OPNTMP:
001477  3  00                   .BYTE 00
