0012A8  3                       JSL     LAB_GBYT        ; scan memory
0012A8  3                       .ELSE
0012A8  3  20 C2 00             JSR     LAB_GBYT        ; scan memory
0012AB  3                       .ENDIF
0012AB  3               
0012AB  3  38                   SEC                     ;
0012AC  3  E9 40                SBC     #64             ; PARSE DRIVE NUMBER
0012AE  3  8D 43 15             STA     DOSDRIVE        ; STORE IT IN FCB
0012B1  3                       .IFDEF  DUODYNE
0012B1  3                       JSL     LAB_IGBY        ; increment and scan memory
0012B1  3                       .ELSE
0012B1  3  20 BC 00             JSR     LAB_IGBY        ; increment and scan memory
0012B4  3                       .ENDIF
0012B4  3               
0012B4  3  C9 3A                CMP     #':'            ;
0012B6  3  F0 08                BEQ     DOS65FCBPREP_1  ; YES, IT WAS A DRIVE, CONTINUE
0012B8  3  A2 26                LDX     #$26            ; IO ERROR
0012BA  3  20 67 17             JSR     LAB_XERR
0012BD  3  4C 3F 18             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
0012C0  3               
0012C0  3               DOS65FCBPREP_1:
0012C0  3  A9 43                LDA     #<FCB           ; SETUP FCBPTR
0012C2  3  85 20                STA     FCBPTR          ;
0012C4  3  A9 15                LDA     #>FCB           ;
0012C6  3  85 21                STA     FCBPTR+1        ;
0012C8  3  A0 01                LDY     #$01            ; POINT Y TO FCB FILE NAME
0012CA  3  A9 20                LDA     #$20            ; LOAD SPACE CHAR INTO A
0012CC  3               DOS65FCBPREP_1A:                ; BLANK OUT FCB
0012CC  3  91 20                STAINDIRECTY FCBPTR     ;
0012CE  3  C8                   INY                     ;
0012CF  3  C0 09                CPY     #$09            ; IS DONE
0012D1  3  D0 F9                BNE     DOS65FCBPREP_1A ; NO, LOOP
0012D3  3  A0 01                LDY     #$01            ; POINT Y TO FCB FILE NAME
0012D5  3               DOS65FCBPREP_2:                 ; COPY FILE NAME PARAMETER INTO FCB
0012D5  3                       .IFDEF  DUODYNE
0012D5  3                       JSL     LAB_IGBY        ; increment and scan memory
0012D5  3                       .ELSE
0012D5  3  20 BC 00             JSR     LAB_IGBY        ; increment and scan memory
0012D8  3                       .ENDIF
0012D8  3  F0 0E                BEQ     DOS65FCBPREP_3  ;
0012DA  3  C9 2E                CMP     #'.'
0012DC  3  F0 0A                BEQ     DOS65FCBPREP_3  ;
0012DE  3  91 20                STAINDIRECTY FCBPTR     ;
0012E0  3  C8                   INY                     ;
0012E1  3  C0 09                CPY     #$09            ;
0012E3  3  F0 03                BEQ     DOS65FCBPREP_3  ;
0012E5  3  4C D5 12             JMP     DOS65FCBPREP_2  ;
