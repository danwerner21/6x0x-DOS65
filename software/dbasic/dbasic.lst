0011F0  3  20 A8 12             JSR     DOS65FCBPREP    ; parse parameters into FCB
0011F3  3  B0 1F                BCS     DOS65LOAD_ERR1  ; Error?, if so abort
0011F5  3  A2 0D                LDX     #13             ;
