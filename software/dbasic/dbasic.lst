0011FA  3  A9 00                LDA     #0              ; clear
0011FC  3  8D 63 15             STA     FCB+32          ; record number
0011FF  3  A9 43                LDA     #<FCB           ; Open File
001201  3  A0 15                LDY     #>FCB           ;
001203  3  A2 0F                LDX     #15             ;
001205  3  20 2F 11             JSR     PEM             ;
001208  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
00120A  3  D0 0B                BNE     DOS65LOAD_1     ;
00120C  3               DOS65LOAD_ERR:
00120C  3  A2 26                LDX     #$26            ; IO ERROR
00120E  3  20 67 17             JSR     LAB_XERR
001211  3  4C 3F 18             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001214  3               DOS65LOAD_ERR1:
001214  3  4C 43 1D             JMP     LAB_REM         ; comment out the remainder of the line (if any)
001217  3               DOS65LOAD_1:
001217  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
001219  3  85 22                STA     FCBPTR+2        ; point to base of RAM
00121B  3  8D EA 12             STA     EndOfBas        ;
00121E  3  A5 7A                LDA     <Smemh          ;
001220  3  85 23                STA     FCBPTR+3        ;
001222  3  8D EB 12             STA     EndOfBas+1      ;
001225  3  A9 CD                LDA     #<FCBBUFFER     ; SETUP BUFFER
001227  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
001229  3  A0 36                LDY     #>FCBBUFFER     ;
00122B  3  84 21                STY     FCBPTR+1        ; STORE DEST BUFFER IN FCBPTR
00122D  3  A2 1A                LDX     #26             ; Setup Buffer
00122F  3  20 2F 11             JSR     PEM             ;
001232  3  4C 70 12             JMP     DOS65LOAD_3C
001235  3               DOS65LOAD_3:
001235  3  B1 20                LDA     (FCBPTR),Y      ; load from BUFFER
001237  3  91 22                STA     (FCBPTR+2),Y    ; save to RAM
001239  3  EE EA 12             INC     EndOfBas
00123C  3  D0 03                BNE     :+
00123E  3  EE EB 12             INC     EndOfBas+1
001241  3               :
001241  3  C9 00                CMP     #$00
001243  3  D0 0D                BNE     :+
001245  3  EE EC 12             INC     NullCounter
001248  3  AD EC 12             LDA     NullCounter
00124B  3  C9 03                CMP     #3
00124D  3  D0 08                BNE     :++
00124F  3  4C 83 12             JMP     DOS65LOAD_4
001252  3               :
001252  3  A9 00                LDA     #$00
001254  3  8D EC 12             STA     NullCounter
001257  3               :
001257  3  C8                   INY                     ; bump index
001258  3  C0 80                CPY     #$80            ; end of buffer?
00125A  3  D0 D9                BNE     DOS65LOAD_3     ; no, loop
00125C  3  18                   CLC                     ;
00125D  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
00125F  3  69 80                ADC     #$80            ;
001261  3  85 22                STA     FCBPTR+2        ;
001263  3  90 0B                BCC     DOS65LOAD_3C    ; is carry?, no SKIP
001265  3  18                   CLC                     ; yes, carry, inc high byte
001266  3  A5 23                LDA     FCBPTR+3        ;
001268  3  69 01                ADC     #$01            ;
00126A  3  85 23                STA     FCBPTR+3        ;
00126C  3  C9 B8                CMP     #>Ram_top       ; are we at the end of RAM?
00126E  3  F0 13                BEQ     DOS65LOAD_4
001270  3               
001270  3               DOS65LOAD_3C:
001270  3  A9 43                LDA     #<FCB           ; READ record buffer from disk file
001272  3  A0 15                LDY     #>FCB           ;
001274  3  A2 14                LDX     #20             ;
001276  3  20 2F 11             JSR     PEM             ;
001279  3  A0 00                LDY     #$00            ; RESET INDEX
00127B  3  C9 00                CMP     #$00            ; is error or EOF
00127D  3  F0 B6                BEQ     DOS65LOAD_3     ;
00127F  3  C9 01                CMP     #$01            ; EOF?
001281  3  D0 89                BNE     DOS65LOAD_ERR   ; ERROR, do error handling
001283  3               DOS65LOAD_4:
001283  3  A9 43                LDA     #<FCB           ;
001285  3  A0 15                LDY     #>FCB           ;
001287  3  A2 10                LDX     #16             ;
001289  3  20 2F 11             JSR     PEM             ;
00128C  3                                               ; setup pointers to return to basic
00128C  3  AD EA 12             LDA     EndOfBas
00128F  3  85 7B                STA     Svarl
001291  3  85 7D                STA     Sarryl
001293  3  85 7F                STA     Earryl
001295  3  AD EB 12             LDA     EndOfBas+1
001298  3  85 7C                STA     Svarh
00129A  3  85 7E                STA     Sarryh
00129C  3  85 80                STA     Earryh
00129E  3  A9 5A                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
0012A0  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
0012A2  3  20 EA 1E             JSR     LAB_18C3
0012A5  3  4C 3F 18             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
