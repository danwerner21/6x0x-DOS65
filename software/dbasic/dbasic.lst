001153  3               ;___SAVE____________________________________________________
001153  3               ;
001153  3               ; SAVE COMMAND
001153  3               ;
001153  3               ;  SAVE THE BASIC PROGRAM IN MEMORY TO DISK
001153  3               ;
001153  3               ;__________________________________________________________
001153  3               V_SAVE: ; save BASIC program
001153  3               DOS65SAVE:
001153  3  20 C8 12             JSR     DOS65FCBPREP    ; parse parameters into FCB
001156  3  B0 29                BCS     DOS65SAVE_ERR1  ; Error?, if so abort
001158  3  A2 0D                LDX     #13             ;
00115A  3  20 4D 11             JSR     PEM             ;
00115D  3  A9 70                LDA     #<FCB           ; CREATE File
00115F  3  A0 15                LDY     #>FCB           ;
001161  3  A2 16                LDX     #22             ;
001163  3  20 4D 11             JSR     PEM             ;
001166  3  A9 00                LDA     #0              ; clear
001168  3  8D 90 15             STA     FCB+32          ; record number
00116B  3  A9 70                LDA     #<FCB           ; Open File
00116D  3  A0 15                LDY     #>FCB           ;
00116F  3  A2 0F                LDX     #15             ;
001171  3  20 4D 11             JSR     PEM             ;
001174  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
001176  3  D0 0C                BNE     DOS65SAVE_1     ;
001178  3               DOS65SAVE_ERR:
001178  3  A9 BE                LDA     #<FILEERROR2    ; NO, ERROR OUT
00117A  3  A0 0F                LDY     #>FILEERROR2
00117C  3  A2 09                LDX     #9              ; Print error message
00117E  3  20 4D 11             JSR     PEM             ;
001181  3               DOS65SAVE_ERR1:
001181  3  4C 75 1D             JMP     LAB_REM         ; comment out the remainder of the line (if any)
001184  3               DOS65SAVE_1:
001184  3  A9 52                LDA     #<FCBBUFFER     ; SETUP BUFFER
001186  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
001188  3  A0 37                LDY     #>FCBBUFFER     ;
00118A  3  84 21                STY     FCBPTR+1        ;
00118C  3  A2 1A                LDX     #26             ; Setup Buffer
00118E  3  20 4D 11             JSR     PEM             ;
001191  3               DOS65SAVE_2:
001191  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
001193  3  85 22                STA     FCBPTR+2        ; point to base of RAM
001195  3  A5 7A                LDA     <Smemh          ;
001197  3  85 23                STA     FCBPTR+3        ;
001199  3  A2 00                LDX     #$00            ; x=0 (null counter)
00119B  3               DOS65SAVE_2A:
00119B  3  A0 00                LDY     #$00            ; y=0 (Loop Index)
00119D  3               DOS65SAVE_3:
00119D  3  B1 22                LDA     (FCBPTR+2),Y    ; load from RAM
00119F  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
0011A1  3  C9 00                CMP     #$00            ; is Zero?
0011A3  3  D0 1E                BNE     DOS65SAVE_3A    ; No, continue
0011A5  3  E8                   INX                     ; yes, bump Null Counter
0011A6  3  E0 03                CPX     #$03            ; Three nulls in a row?
0011A8  3  D0 1B                BNE     DOS65SAVE_3B    ; No, continue
0011AA  3                                               ; FINISH FILLING BUFFER WITH NULLS
0011AA  3               :
0011AA  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
0011AC  3  C8                   INY                     ; bump index
0011AD  3  C0 80                CPY     #$80            ; end of buffer?
0011AF  3  D0 F9                BNE     :-              ; no, loop
0011B1  3  A9 70                LDA     #<FCB           ; Write record in buffer to disk file AND END
0011B3  3  A0 15                LDY     #>FCB           ;
0011B5  3  A2 15                LDX     #21             ;
0011B7  3  20 4D 11             JSR     PEM             ;
0011BA  3  29 FE                AND     #$FE            ; strip out extension
0011BC  3  C9 00                CMP     #$00            ; is error
0011BE  3  D0 B8                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
0011C0  3  4C F0 11             JMP     DOS65SAVE_4
0011C3  3               DOS65SAVE_3A:                   ;
0011C3  3  A2 00                LDX     #$00            ; prior char not null, reset null counter
0011C5  3               DOS65SAVE_3B:                   ;
0011C5  3  C8                   INY                     ; bump index
0011C6  3  C0 80                CPY     #$80            ; end of buffer?
0011C8  3  D0 D3                BNE     DOS65SAVE_3     ; no, loop
0011CA  3               DOS65SAVE_3C:
0011CA  3  A9 70                LDA     #<FCB           ; Write record in buffer to disk file
0011CC  3  A0 15                LDY     #>FCB           ;
0011CE  3  A2 15                LDX     #21             ;
0011D0  3  20 4D 11             JSR     PEM             ;
0011D3  3  29 FE                AND     #$FE            ; strip out extension
0011D5  3  C9 00                CMP     #$00            ; is error
0011D7  3  D0 9F                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
0011D9  3  18                   CLC                     ;
0011DA  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
0011DC  3  69 80                ADC     #$80            ;
0011DE  3  85 22                STA     FCBPTR+2        ;
0011E0  3  90 B9                BCC     DOS65SAVE_2A    ; is carry?, no loop
0011E2  3  18                   CLC                     ; yes, carry, inc high byte
0011E3  3  A5 23                LDA     FCBPTR+3        ;
0011E5  3  69 01                ADC     #$01            ;
0011E7  3  85 23                STA     FCBPTR+3        ;
0011E9  3  C9 B8                CMP     #>Ram_top       ; are we at the end of RAM?
0011EB  3  F0 03                BEQ     DOS65SAVE_4
0011ED  3  4C 9B 11             JMP     DOS65SAVE_2A
0011F0  3               DOS65SAVE_4:
0011F0  3  A9 70                LDA     #<FCB           ;
0011F2  3  A0 15                LDY     #>FCB           ;
0011F4  3  A2 10                LDX     #16             ;
0011F6  3  20 4D 11             JSR     PEM             ;
0011F9  3  C9 FF                CMP     #$FF            ;
0011FB  3  D0 03                BNE     DOS65SAVE_5     ;
0011FD  3  4C 78 11             JMP     DOS65SAVE_ERR   ; ERROR, DISPLAY IT
001200  3               DOS65SAVE_5:
001200  3  A9 65                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
001202  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
001204  3  20 2A 1F             JSR     LAB_18C3
001207  3  4C 6C 18             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
