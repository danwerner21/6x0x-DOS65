0010CA  2               BYTEOUT:
0010CA  2                       STA     DBGA
0010CA  2                       STY     DBGY
0010CA  2                       STX     DBGX
0010CA  2                       LDA     #19
0010CA  2                       STA     farfunct
0010CA  2                       LDA     DBGA
0010CA  2                       JSR     DO_FARCALL
0010CA  2                       LDA     DBGA
0010CA  2                       LDY     DBGY
0010CA  2                       LDX     DBGX
0010CA  2                       RTS
0010CA  2               
0010CA  2               V_INPT: ; non halting keyboard scan
0010CA  2               BYTEIN:
0010CA  2                       STY     DBGY            ;
0010CA  2                       STX     DBGX            ;
0010CA  2                       LDA     #20
0010CA  2                       STA     farfunct
0010CA  2                       JSR     DO_FARCALL
0010CA  2                       CMP     #$FF            ;
0010CA  2                       BEQ     LAB_nobyw       ; branch if no byte waiting
0010CA  2                       LDY     DBGY
0010CA  2                       LDX     DBGX
0010CA  2                       SEC                     ; flag byte received
0010CA  2                       RTS
0010CA  2               LAB_nobyw:
