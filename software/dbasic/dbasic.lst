00144C  3  E0 00                CPX     #0              ;
00144E  3  D0 F5                BNE     :-              ;
001450  3                                               ;
001450  3  20 AC 27             JSR     LAB_RTST        ; STORE STRING
001453  3  4C F3 1D             JMP     LAB_17D5        ; do string LET and return
