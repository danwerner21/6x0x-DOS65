00175B  3               ;___SOUND__________________________________________________
00175B  3               ;
00175B  3               ; PLAY SOUND
00175B  3               ;
00175B  3               ;  TAKES TWO PARAMETERS CHANNEL,FREQUENCY
00175B  3               ;
00175B  3               ; THIS IS NATIVE '816 CODE
00175B  3               ;__________________________________________________________
00175B  3               LAB_SOUND:
00175B  3  20 DA 2D             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (CHANNEL)
00175E  3  DA                   PHX
00175F  3  20 49 25             JSR     LAB_1C01        ; (AFTER ',') OR SYN ERR
001762  3  20 17 24             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001765  3               ; else do type mismatch
001765  3  20 40 2E             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001768  3               
001768  3  68                   PLA                     ; LIMIT THE CHANNELS TO <3
001769  3  29 03                AND     #$03
00176B  3  18                   CLC
00176C  3  0A                   ASL                     ; = *2
00176D  3  48                   PHA
00176E  3  A4 11                LDY     <Itempl
001770  3  20 85 18             JSR     psgwr           ; SET LOW BYTE
001773  3  68                   PLA
001774  3  1A                   INC     A
001775  3  A4 12                LDY     <Itemph
001777  3  20 85 18             JSR     psgwr           ; SET HIGH BYTE
00177A  3  60                   RTS
00177B  3               
