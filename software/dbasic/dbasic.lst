0010BA  2  A9 00                LDA     #$00
0010BC  2  8D 57 10             STA     printflag
0010BF  2  60                   RTS
0010C0  2               V_LLIST:
0010C0  2  08                   PHP
0010C1  2  A9 01                LDA     #$01
0010C3  2  8D 57 10             STA     printflag
0010C6  2  28                   PLP
0010C7  2  20 75 1B             JSR     LAB_LIST
0010CA  2  A9 00                LDA     #$00
0010CC  2  8D 57 10             STA     printflag
0010CF  2  60                   RTS
