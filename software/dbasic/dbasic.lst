0015B7  3               ;___FILTER_________________________________________________
0015B7  3               ;
0015B7  3               ; SET SID FILTERS
0015B7  3               ;
0015B7  3               ;  FILTER CUTOFF, RESONANCE, VOICE 1 ENABLE, VOICE 2 ENABLE, VOICE 3 ENABLE, EXTERNAL ENABLE, FILTER MODE, VOLUME
0015B7  3               ;
0015B7  3               ;
0015B7  3               ;__________________________________________________________
0015B7  3               LAB_FILTER:
0015B7  3                       JSR     LAB_EVNM        ; evaluate expression and check is numeric,
0015B7  3                                               ; else do type mismatch
0015B7  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
0015B7  3                                               ; SET CUTOFF
0015B7  3                       LDA     Itempl
0015B7  3                       STA     SID_BASE+$15
0015B7  3                       LDA     Itemph
0015B7  3                       STA     SID_BASE+$16
0015B7  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
0015B7  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (RESONANCE)
0015B7  3                       TXA
0015B7  3                       LSR     A
0015B7  3                       LSR     A
0015B7  3                       LSR     A
0015B7  3                       LSR     A
0015B7  3                       STA     PTEMPW
0015B7  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
0015B7  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 1 ENABLE)
0015B7  3                       TXA
0015B7  3                       AND     #1
0015B7  3                       ORA     PTEMPW
0015B7  3                       STA     PTEMPW
0015B7  3                       JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
0015B7  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 2 ENABLE)
0015B7  3                       TXA
0015B7  3                       AND     #1
0015B7  3                       LSR     A
0015B7  3                       ORA     PTEMPW
0015B7  3                       STA     PTEMPW
0015B7  3                       JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
0015B7  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 3 ENABLE)
0015B7  3                       TXA
0015B7  3                       AND     #1
0015B7  3                       LSR     A
0015B7  3                       LSR     A
0015B7  3                       ORA     PTEMPW
0015B7  3                       STA     PTEMPW
0015B7  3                       JSR     LAB_1C01        ; GET THE SIXTH PARAMETER (AFTER ',') OR SYN ERR
0015B7  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (EXTERNAL AUDIO ENABLE)
0015B7  3                       TXA
0015B7  3                       AND     #1
0015B7  3                       LSR     A
0015B7  3                       LSR     A
0015B7  3                       LSR     A
0015B7  3                       ORA     PTEMPW
0015B7  3                       STA     SID_BASE+$17
0015B7  3                       JSR     LAB_1C01        ; GET THE SEVENTH PARAMETER (AFTER ',') OR SYN ERR
0015B7  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (FILTER MODE)
0015B7  3                       TXA
0015B7  3                       LSR     A
0015B7  3                       LSR     A
0015B7  3                       LSR     A
0015B7  3                       LSR     A
0015B7  3                       STA     PTEMPW
0015B7  3                       JSR     LAB_1C01        ; GET THE EIGHTH PARAMETER (AFTER ',') OR SYN ERR
0015B7  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOLUME)
0015B7  3                       TXA
0015B7  3                       AND     #$0F
0015B7  3                       ORA     PTEMPW
0015B7  3                       STA     SID_BASE+$18
0015B7  3                       RTS
0015B7  3               
0015B7  3                       .ELSE
