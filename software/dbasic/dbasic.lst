001962  3               BCD_TO_HEX:
001962  3  85 12                STA     nums_2          ; Store in TEMP2
001964  3  29 F0                AND     #$F0
001966  3  4A                   LSR     A               ; (shift 1 times to /2)
001967  3  85 11                STA     nums_1          ; Store the /2 into TEMP
001969  3  4A                   LSR     A               ;
00196A  3  4A                   LSR     A               ; Shift two more times to /8
00196B  3  18                   CLC
00196C  3  65 11                ADC     nums_1          ; add /8 + /2 to get /10
00196E  3  85 11                STA     nums_1          ; Store tens digit into TEMP
001970  3  A5 12                LDA     nums_2          ; Get Ones
001972  3  29 0F                AND     #$0F
001974  3  18                   CLC
001975  3  65 11                ADC     nums_1
001977  3  60                   RTS                     ; Return from subroutine
