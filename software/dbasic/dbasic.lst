0010F4  2  8E 62 11             STX     TTX
0010F7  2  8C 63 11             STY     TTY
0010FA  2  8D 64 11             STA     TTA
0010FD  2  A9 0D                LDA     #13
0010FF  2  20 65 11             JSR     WRSER1          ; output upper nybble
001102  2  A9 0A                LDA     #10
001104  2  20 65 11             JSR     WRSER1          ; output upper nybble
001107  2  AE 62 11             LDX     TTX
00110A  2  AC 63 11             LDY     TTY
00110D  2  AD 64 11             LDA     TTA
001110  2  60                   RTS
001111  2               
001111  2               PRINT_SPACE:
001111  2  8E 62 11             STX     TTX
001114  2  8C 63 11             STY     TTY
001117  2  8D 64 11             STA     TTA
00111A  2  A9 20                LDA     #32
00111C  2  20 65 11             JSR     WRSER1          ; output upper nybble
00111F  2  AE 62 11             LDX     TTX
001122  2  AC 63 11             LDY     TTY
001125  2  AD 64 11             LDA     TTA
001128  2  60                   RTS
001129  2               
001129  2               
001129  2               PRINT_BYTE:
001129  2  8E 62 11             STX     TTX
00112C  2  8C 63 11             STY     TTY
00112F  2  8D 64 11             STA     TTA
001132  2  8E 61 11             STX     SAVX            ; save X
001135  2  20 4C 11             JSR     ASCTWO          ; get hex chars for byte in X (lower) and A (upper)
001138  2  20 65 11             JSR     WRSER1          ; output upper nybble
00113B  2  8A                   TXA                     ; transfer lower to A
00113C  2  AE 61 11             LDX     SAVX            ; restore X
00113F  2  20 65 11             JSR     WRSER1          ; output lower nybble
001142  2  AE 62 11             LDX     TTX
001145  2  AC 63 11             LDY     TTY
001148  2  AD 64 11             LDA     TTA
00114B  2  60                   RTS
00114C  2               ASCTWO:
00114C  2  48                   PHA                     ; save byte
00114D  2  20 56 11             JSR     ASCII           ; do low nybble
001150  2  AA                   TAX                     ; save in X
001151  2  68                   PLA                     ; restore byte
001152  2  4A                   LSR     A               ; shift upper nybble down
001153  2  4A                   LSR     A
001154  2  4A                   LSR     A
001155  2  4A                   LSR     A
001156  2               ; convert low nybble in A to hex digit
001156  2               ASCII:
001156  2  29 0F                AND     #$0F            ; clear upper nibble
001158  2  C9 0A                CMP     #$0A            ; if less than A, skip next step
00115A  2  90 02                BCC     ASC1
00115C  2  69 06                ADC     #6              ; skip ascii chars between 9 and A
00115E  2               ASC1:
00115E  2  69 30                ADC     #$30            ; add ascii char 0 to value
001160  2  60                   RTS
001161  2               SAVX:
001161  2  00                   .BYTE   00
001162  2               TTX:
001162  2  00                   .BYTE   00
001163  2               TTY:
001163  2  00                   .BYTE   00
001164  2               TTA:
001164  2  00                   .BYTE   00
