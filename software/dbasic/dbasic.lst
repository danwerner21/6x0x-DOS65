0010CA  2  8E 38 11             STX     TTX
0010CD  2  8C 39 11             STY     TTY
0010D0  2  8D 3A 11             STA     TTA
0010D3  2  A9 0D                LDA     #13
0010D5  2  20 3B 11             JSR     WRSER1          ; output upper nybble
0010D8  2  A9 0A                LDA     #10
0010DA  2  20 3B 11             JSR     WRSER1          ; output upper nybble
0010DD  2  AE 38 11             LDX     TTX
0010E0  2  AC 39 11             LDY     TTY
0010E3  2  AD 3A 11             LDA     TTA
0010E6  2  60                   RTS
