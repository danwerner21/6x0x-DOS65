00324C  1  B0 03                BCS     LAB_WDLP        ; branch if >= tab size
00324E  1               
00324E  1  85 64                STA     TabSiz          ; else make tab size = terminal width
003250  1               LAB_SULP:
003250  1  38                   SEC                     ; set carry for subtract
003251  1               LAB_WDLP:
003251  1  E5 64                SBC     TabSiz          ; subtract tab size
003253  1  B0 FC                BCS     LAB_WDLP        ; loop while no borrow
003255  1               
