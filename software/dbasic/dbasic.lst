0015B2  3                       .IFDEF  MEMORYMAPPEDSCREEN
0015B2  3               
0015B2  3               ;* MEMORY MAP
0015B2  3               ;  VIDEO CARD IS A 32K AREA (MAPPED IN BANKS TO $AXXX)
0015B2  3               ;  $0x00 0x01=soft_scanline_emulation, 0x02 NO soft_scanline_emulation
0015B2  3               ;  $0x01 0x01=page1, 0x02 page2
0015B2  3               ;  $0x02  character generator write offset (data << 3)
0015B2  3               ;  $0x03 character generator write DATA
0015B2  3               ;  $0x04 EXECUTE device command
0015B2  3               ;        0x00- reset to the default configuration
0015B2  3               ;        0x01- reset to the saved configuration
0015B2  3               ;	0x02- save the current configuration
0015B2  3               ;
0015B2  3               ;  $0x05  0x01=soft_text=true, 0x02=soft_text=false
0015B2  3               ;  $0x06 Lores Mode=0X01,NO lores Mode=0x02
0015B2  3               ;  $0x07 Double Lores Mode=0X01,NO Double lores Mode=0x02
0015B2  3               ;  $0x08 Hires Mode=0X01,NO Hires Mode=0x02
0015B2  3               ;  $0x09 Double Hires Mode=0X01,NO Double Hires lores Mode=0x02
0015B2  3               ;  $0x0A 80COL Mode=0X01,NO 80COL Mode=0x02
0015B2  3               ;  $0x0B MIXED Mode=0X01,NO MIXED Mode=0x02
0015B2  3               ;  $0x0C QUAD Hires Mode=0X01,NO QUAD Hires lores Mode=0x02
0015B2  3               ;  $0x0D MONO Hires Mode=0X01,NO MONO Hires lores Mode=0x02
0015B2  3               ;
0015B2  3               ; 	VRAM Memory Map
0015B2  3               ;	$1000-$177F	40/80 Text Page 1
0015B2  3               ;	$1800-$1F7F	40/80 Color Page 1
0015B2  3               ;	$2000-$277F	40/80 Text Page 2
0015B2  3               ;	$2800-$2F7F	40/80 Color Page 2
0015B2  3               ;	$2000-$5FFF	HIRES PAGE 1
0015B2  3               ;	$6000-$8FFF	HIRES PAGE 2
0015B2  3               ;	$2000-$BFFF	DOUBLE HIRES
0015B2  3               
0015B2  3               VIDEOBANK       = $F8
0015B2  3               PC6502_IOSPACE  = $EF00
0015B2  3               ; PAGER
0015B2  3               PC6502_ACT_TASK = PC6502_IOSPACE+$E0
0015B2  3               PC6502_MAP_SETUP = PC6502_IOSPACE+$E1
0015B2  3               PC6502_MMU_ENA  = PC6502_IOSPACE+$E2
0015B2  3               PC6502_MAP_SPACE = PC6502_IOSPACE+$D0
0015B2  3               
0015B2  3               VideoDisplayPage = $A001
0015B2  3               VideoCharGenOffset = $A002
0015B2  3               VideoCharGenData = $A003
0015B2  3               VideoTextMode   = $A005
0015B2  3               VideoLoresMode  = $A006
0015B2  3               VideoDoubleLores = $A007
0015B2  3               VideoHiresMode  = $A008
0015B2  3               VideoDoubleHires = $A009
0015B2  3               Video80col      = $A00A
0015B2  3               VideoMixedMode  = $A00b
0015B2  3               VideoQuadHires  = $A00c
0015B2  3               VideoMonoHires  = $A00d
0015B2  3               
0015B2  3               CURX            = $0647         ; CURRENT CURSOR POSITION (MEMORY MAPPED)
0015B2  3               CURY            = $0648
0015B2  3               SHOWCRSR        = $0649         ; SHOW CURSOR (1-YES, 0-NO) (MEMORY MAPPED)
0015B2  3               CURCOLOR        = $064A         ; CURRENT PRINT COLOR (MEMORY MAPPED)
0015B2  3               CSRCOLOR        = $064B         ; CURRENT CURSOR COLOR (MEMORY MAPPED)
0015B2  3               BVIDEOMODE      = $064C         ; CURRENT VIDEO MODE (MEMORY MAPPED) 00=40 COL, 01=80 COL
0015B2  3               
0015B2  3               
0015B2  3               VIDEOMODE:
0015B2  3                       .BYTE   $00
0015B2  3               CLRTMP:
0015B2  3                       .BYTE   $00
0015B2  3               VIDEOWIDTH:
0015B2  3                       .BYTE   80
0015B2  3               
0015B2  3               PTEMPW:
0015B2  3                       .BYTE   $00,$00
0015B2  3               PTEMPW1:
0015B2  3                       .BYTE   $00,$00
0015B2  3               PTEMPW2:
0015B2  3                       .BYTE   $00,$00
0015B2  3               PTEMPW3:
0015B2  3                       .BYTE   $00,$00
0015B2  3               PTEMP:
0015B2  3                       .BYTE   $00
0015B2  3               PTEMP4:
0015B2  3                       .BYTE   $00
0015B2  3               
0015B2  3               
0015B2  3               ;___V_SCRCLR________________________________________________
0015B2  3               ;
0015B2  3               ; CLEAR SCREEN
0015B2  3               ;
0015B2  3               ;__________________________________________________________
0015B2  3               LAB_SCRCLR:
0015B2  3               V_SCNCLR:
0015B2  3                       STA     DBGA
0015B2  3                       STY     DBGY
0015B2  3                       STX     DBGX
0015B2  3                       LDA     #38
0015B2  3                       STA     farfunct
0015B2  3                       JSR     DO_FARCALL
0015B2  3                       LDA     #59
0015B2  3                       STA     farfunct
0015B2  3                       JSR     DO_FARCALL
0015B2  3                       LDA     DBGA
0015B2  3                       LDY     DBGY
0015B2  3                       LDX     DBGX
0015B2  3                       RTS
0015B2  3               
0015B2  3               
0015B2  3               
0015B2  3               ;___V_LOCATE________________________________________________
0015B2  3               ;
0015B2  3               ; SET CURSOR LOCATION
0015B2  3               ;
0015B2  3               ;       LOCATE X,Y
0015B2  3               ;
0015B2  3               ;__________________________________________________________
0015B2  3               V_LOCATE:
0015B2  3               LAB_LOCATE:
0015B2  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (MODE)
0015B2  3                       STX     DBGX
0015B2  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
0015B2  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
0015B2  3                       TXA
0015B2  3                       TAY
0015B2  3                       LDX     DBGX
0015B2  3                       LDA     #37
0015B2  3                       STA     farfunct
0015B2  3                       JSR     DO_FARCALL
0015B2  3                       RTS
0015B2  3               
0015B2  3               ;___V_COLOR_________________________________________________
0015B2  3               ;
0015B2  3               ; SET COLOR FG,BG,CFG,CBG
0015B2  3               ;
0015B2  3               ;__________________________________________________________
0015B2  3               LAB_COLOR:
0015B2  3               V_COLOR:
0015B2  3                       LDA     #$00            ; CLEAR TEMP SPACE
0015B2  3                       STA     PTEMPW
0015B2  3                       STA     PTEMPW+1
0015B2  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (MODE)
0015B2  3                       TXA
0015B2  3                       AND     #$0F
0015B2  3                       STA     PTEMPW
0015B2  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
0015B2  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
0015B2  3                       TXA
0015B2  3                       ASL     A
0015B2  3                       ASL     A
0015B2  3                       ASL     A
0015B2  3                       ASL     A
0015B2  3                       ORA     PTEMPW
0015B2  3                       STA     PTEMPW
0015B2  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
0015B2  3                       JSR     LAB_GTBY        ; GET THE THIRD PARAMETER, RETURN IN X
0015B2  3                       TXA
0015B2  3                       AND     #$0F
0015B2  3                       STA     PTEMPW+1
0015B2  3                       JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
0015B2  3                       JSR     LAB_GTBY        ; GET THE FOURTH PARAMETER, RETURN IN X
0015B2  3                       TXA
0015B2  3                       ASL     A
0015B2  3                       ASL     A
0015B2  3                       ASL     A
0015B2  3                       ASL     A
0015B2  3                       ORA     PTEMPW+1
0015B2  3                       STA     PTEMPW+1
0015B2  3                       LDX     PTEMPW
0015B2  3                       LDY     PTEMPW+1
0015B2  3                       LDA     #39
0015B2  3                       STA     farfunct
0015B2  3                       JSR     DO_FARCALL
0015B2  3                       RTS
0015B2  3               
0015B2  3               
0015B2  3               
0015B2  3               ;___V_SPEEK()______________________________________________
0015B2  3               ;
0015B2  3               ; GET VALUE FROM SCREEN MEMORY
0015B2  3               ;
0015B2  3               ;  TAKES ONE PARAMETER (ADDRESS), RETURNS VALUE
0015B2  3               ;
0015B2  3               ;__________________________________________________________
0015B2  3               LAB_SPEEK:
0015B2  3               V_SPEEK:
0015B2  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
0015B2  3                       LDA     Itemph
0015B2  3                       TAY
0015B2  3                       AND     #$0F
0015B2  3                       ORA     #$A0
0015B2  3                       STA     Itemph
0015B2  3                       TYA
0015B2  3                       AND     #$F0
0015B2  3                       LSR     A
0015B2  3                       LSR     A
0015B2  3                       LSR     A
0015B2  3                       LSR     A
0015B2  3                       AND     #$07
0015B2  3                       CLC
0015B2  3                       ADC     #VIDEOBANK
0015B2  3                       TAY
0015B2  3                       LDA     #$01            ; MODIFY TASK 01 (DRIVER TASK)
0015B2  3                       LDX     #$0A            ; MAP $AXXX
0015B2  3                       JSR     SETPAGE         ; CALL SETPAGE
0015B2  3                       LDA     #$01
0015B2  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 01
0015B2  3                       LDY     #0
0015B2  3                       LDA     (Itempl),Y
0015B2  3                       TAY
0015B2  3                       LDA     #$00
0015B2  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 00
0015B2  3                       JMP     LAB_1FD0        ; convert Y to byte in FAC1 and return
0015B2  3               
0015B2  3               
0015B2  3               
0015B2  3               ;___V_SPOKE_________________________________________________
0015B2  3               ;
0015B2  3               ; PUT VALUE IN SCREEN MEMORY
0015B2  3               ;
0015B2  3               ;  TAKES TWO PARAMETERS ADDRESS,VALUE
0015B2  3               ;
0015B2  3               ;__________________________________________________________
0015B2  3               LAB_SPOKE:
0015B2  3               V_SPOKE:
0015B2  3                       JSR     LAB_GADB        ; get two parameters for POKE or WAIT
0015B2  3                       TXA                     ; BYTE ARGUMENT IS IN X
0015B2  3                       PHA                     ; PUSH BYTE ARGUMENT TO STACK
0015B2  3                       LDA     Itemph
0015B2  3                       TAY
0015B2  3                       AND     #$0F
0015B2  3                       ORA     #$A0
0015B2  3                       STA     Itemph
0015B2  3                       TYA
0015B2  3                       AND     #$F0
0015B2  3                       LSR     A
0015B2  3                       LSR     A
0015B2  3                       LSR     A
0015B2  3                       LSR     A
0015B2  3                       AND     #$07
0015B2  3                       CLC
0015B2  3                       ADC     #VIDEOBANK
0015B2  3                       TAY
0015B2  3                       LDA     #$01            ; MODIFY TASK 01 (DRIVER TASK)
0015B2  3                       LDX     #$0A            ; MAP $AXXX
0015B2  3                       JSR     SETPAGE         ; CALL SETPAGE
0015B2  3                       LDA     #$01
0015B2  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 01
0015B2  3                       LDY     #0
0015B2  3                       PLA                     ; PULL BYTE ARGUMENT
0015B2  3                       STA     (Itempl),Y
0015B2  3                       LDA     #$00
0015B2  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 00
0015B2  3                       RTS
0015B2  3               
0015B2  3               ;___V_SCREEN_________________________________________________
0015B2  3               ;
0015B2  3               ;  SET SCREEN MODE
0015B2  3               ;
0015B2  3               ;  TAKES UP TO THREE PARAMETERS
0015B2  3               ;  FIRST PARAMETER SCREEN MODE
0015B2  3               ;  0=TEXT MODE
0015B2  3               ;  1=LORES MODE
0015B2  3               ;  2=HIRES MODE
0015B2  3               ;
0015B2  3               ;  TEXT MODE PARAMETERS
0015B2  3               ;  0=40 COLUMNS
0015B2  3               ;  1=80 COLUMNS
0015B2  3               ;
0015B2  3               ;  LORES MODE SECOND PARAMETER
0015B2  3               ;  0=SINGLE LORES
0015B2  3               ;  1=DOUBLE LORES
0015B2  3               ;  LORES MODE THIRD PARAMETER
0015B2  3               ;  0=MIXED MODE
0015B2  3               ;  1=FULL SCREEN MODE
0015B2  3               ;
0015B2  3               ;  HIRES MODE SECOND PARAMETER
0015B2  3               ;  0=SINGLE HIRES
0015B2  3               ;  1=DOUBLE HIRES
0015B2  3               ;  2=QUAD HIRES
0015B2  3               ;  3=MONO HIRES
0015B2  3               ;  HIRES MODE THIRD PARAMETER
0015B2  3               ;  1=MIXED MODE
0015B2  3               ;  0=FULL SCREEN MODE
0015B2  3               ;
0015B2  3               ;__________________________________________________________
0015B2  3               LAB_SCREEN:
0015B2  3               V_SCREEN:
0015B2  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (MODE)
0015B2  3               V_SCREEN1:
0015B2  3                       STX     VIDEOMODE
0015B2  3                       CPX     #00
0015B2  3                       BNE     *+5
0015B2  3                       JMP     SETUPMODE0
0015B2  3                       CPX     #01
0015B2  3                       BNE     *+5
0015B2  3                       JMP     SETUPMODE1
0015B2  3                       CPX     #02
0015B2  3                       BNE     *+5
0015B2  3                       JMP     SETUPMODE2
0015B2  3               
0015B2  3                       LDX     #$02            ; SYNTAX ERROR
0015B2  3                       JSR     LAB_XERR
0015B2  3                       JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
0015B2  3                       RTS
0015B2  3               
0015B2  3               SETUPMODE0:                     ; TEXT MODE
0015B2  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
0015B2  3                       JSR     PAGE_ENTER
0015B2  3                       LDA     #$01
0015B2  3                       STA     VideoTextMode
0015B2  3                       LDA     #$02
0015B2  3                       STA     VideoLoresMode
0015B2  3                       STA     VideoHiresMode
0015B2  3                       JSR     PAGE_EXIT
0015B2  3               
0015B2  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
0015B2  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
0015B2  3                       CPX     #$00
0015B2  3                       BNE     SETUPMODE0_80
0015B2  3               
0015B2  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
0015B2  3                       JSR     PAGE_ENTER
0015B2  3                       LDA     #$02
0015B2  3                       STA     Video80col
0015B2  3                       JSR     PAGE_EXIT
0015B2  3                       LDA     #40
0015B2  3                       STA     VIDEOWIDTH
0015B2  3                       LDA     #0
0015B2  3                       STA     BVIDEOMODE
0015B2  3                       JMP     SETUPMODE0_CLEAR
0015B2  3               SETUPMODE0_80:
0015B2  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
0015B2  3                       JSR     PAGE_ENTER
0015B2  3                       LDA     #$01
0015B2  3                       STA     Video80col
0015B2  3                       JSR     PAGE_EXIT
0015B2  3                       LDA     #80
0015B2  3                       STA     VIDEOWIDTH
0015B2  3                       LDA     #1
0015B2  3                       STA     BVIDEOMODE
0015B2  3               SETUPMODE0_CLEAR:
0015B2  3                       JMP     V_SCNCLR
0015B2  3                       RTS
0015B2  3               
0015B2  3               SETUPMODE1:                     ; LORES MODE
0015B2  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
0015B2  3                       JSR     PAGE_ENTER
0015B2  3                       LDA     #$01
0015B2  3                       STA     VideoLoresMode
0015B2  3                       LDA     #$02
0015B2  3                       STA     VideoTextMode
0015B2  3                       STA     VideoHiresMode
0015B2  3                       JSR     PAGE_EXIT
0015B2  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
0015B2  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
0015B2  3               
0015B2  3                       CPX     #$00
0015B2  3                       BNE     SETUPMODE1_DOUBLE
0015B2  3               
0015B2  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
0015B2  3                       JSR     PAGE_ENTER
0015B2  3                       LDA     #$02
0015B2  3                       STA     VideoDoubleLores
0015B2  3                       JSR     PAGE_EXIT
0015B2  3                       JMP     SETUPMODE1_CLEAR
0015B2  3               SETUPMODE1_DOUBLE:
0015B2  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
0015B2  3                       JSR     PAGE_ENTER
0015B2  3                       LDA     #$01
0015B2  3                       STA     VideoDoubleLores
0015B2  3                       JSR     PAGE_EXIT
0015B2  3                       LDA     #$11
0015B2  3                       STA     VIDEOMODE
0015B2  3               SETUPMODE1_CLEAR:               ;    ($2000-$2800)
0015B2  3                       LDY     #$02+VIDEOBANK  ; AREA $2000-$2FFF
0015B2  3                       JSR     PAGE_ENTER
0015B2  3                       LDA     #$00
0015B2  3                       STA     TEMPW
0015B2  3                       LDA     #$A0
0015B2  3                       STA     TEMPW+1
0015B2  3                       LDY     #$00
0015B2  3                       LDA     #$00
0015B2  3               :
0015B2  3                       STA     (TEMPW),Y
0015B2  3                       INC     TEMPW
0015B2  3                       BNE     :-
0015B2  3                       INC     TEMPW+1
0015B2  3               
0015B2  3                       LDX     TEMPW+1
0015B2  3                       CPX     #$A8
0015B2  3                       BNE     :-
0015B2  3                       JSR     PAGE_EXIT
0015B2  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
0015B2  3                       JSR     LAB_GTBY        ; GET THE THIRD PARAMETER, RETURN IN X
0015B2  3                       CPX     #$00
0015B2  3                       BNE     SETUPMODE1_MIXED
0015B2  3               
0015B2  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
0015B2  3                       JSR     PAGE_ENTER
0015B2  3                       LDA     #$02
0015B2  3                       STA     VideoMixedMode
0015B2  3                       JSR     PAGE_EXIT
0015B2  3                       RTS
0015B2  3               SETUPMODE1_MIXED:
0015B2  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
0015B2  3                       JSR     PAGE_ENTER
0015B2  3                       LDA     #$01
0015B2  3                       STA     VideoMixedMode
0015B2  3                       JSR     PAGE_EXIT
0015B2  3                       LDA     VIDEOMODE
0015B2  3                       ORA     #$80
0015B2  3                       STA     VIDEOMODE
0015B2  3                       RTS
0015B2  3               
0015B2  3               
0015B2  3               SETUPMODE2:                     ; HIRES MODE
0015B2  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
0015B2  3                       JSR     PAGE_ENTER
0015B2  3                       LDA     #$01
0015B2  3                       STA     VideoHiresMode
0015B2  3                       LDA     #$02
0015B2  3                       STA     VideoTextMode
0015B2  3                       STA     VideoLoresMode
0015B2  3                       JSR     PAGE_EXIT
0015B2  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
0015B2  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
0015B2  3               
0015B2  3                       CPX     #$00
0015B2  3                       BNE     SETUPMODE2_DOUBLE
0015B2  3               
0015B2  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
0015B2  3                       JSR     PAGE_ENTER
0015B2  3                       LDA     #$02
0015B2  3                       STA     VideoDoubleHires
0015B2  3                       STA     VideoQuadHires
0015B2  3                       STA     VideoMonoHires
0015B2  3                       JSR     PAGE_EXIT
0015B2  3                       JMP     SETUPMODE2_CLEAR
0015B2  3               SETUPMODE2_DOUBLE:
0015B2  3                       CPX     #$01
0015B2  3                       BNE     SETUPMODE2_QUAD
0015B2  3               
0015B2  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
0015B2  3                       JSR     PAGE_ENTER
0015B2  3                       LDA     #$01
0015B2  3                       STA     VideoDoubleHires
0015B2  3                       LDA     #$02
0015B2  3                       STA     VideoQuadHires
0015B2  3                       STA     VideoMonoHires
0015B2  3                       JSR     PAGE_EXIT
0015B2  3                       LDA     #$12
0015B2  3                       STA     VIDEOMODE
0015B2  3                       JMP     SETUPMODE2_CLEAR
0015B2  3               SETUPMODE2_QUAD:
0015B2  3                       CPX     #$02
0015B2  3                       BNE     SETUPMODE2_MONO
0015B2  3               
0015B2  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
0015B2  3                       JSR     PAGE_ENTER
0015B2  3                       LDA     #$01
0015B2  3                       STA     VideoQuadHires
0015B2  3                       LDA     #$02
0015B2  3                       STA     VideoDoubleHires
0015B2  3                       STA     VideoMonoHires
0015B2  3                       JSR     PAGE_EXIT
0015B2  3                       LDA     #$22
0015B2  3                       STA     VIDEOMODE
0015B2  3                       JMP     SETUPMODE2_CLEAR
0015B2  3               SETUPMODE2_MONO:
0015B2  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
0015B2  3                       JSR     PAGE_ENTER
0015B2  3                       LDA     #$01
0015B2  3                       STA     VideoMonoHires
0015B2  3                       LDA     #$02
0015B2  3                       STA     VideoDoubleHires
0015B2  3                       STA     VideoQuadHires
0015B2  3                       JSR     PAGE_EXIT
0015B2  3                       LDA     #$32
0015B2  3                       STA     VIDEOMODE
0015B2  3               
0015B2  3               SETUPMODE2_CLEAR:               ; ($2000-$7FFF)
0015B2  3                       LDY     #$02+VIDEOBANK
0015B2  3                       STY     CLRTMP
0015B2  3               
0015B2  3               :
0015B2  3                       LDY     CLRTMP
0015B2  3                       JSR     PAGE_ENTER
0015B2  3               
0015B2  3                       LDA     #$00
0015B2  3                       TAY
0015B2  3                       STA     TEMPW
0015B2  3                       LDA     #$A0
0015B2  3                       STA     TEMPW+1
0015B2  3                       LDA     #$00
0015B2  3               :
0015B2  3                       STA     (TEMPW),Y
0015B2  3                       INC     TEMPW
0015B2  3                       BNE     :-
0015B2  3                       INC     TEMPW+1
0015B2  3                       LDX     TEMPW+1
0015B2  3                       CPX     #$B0
0015B2  3                       BNE     :-
0015B2  3                       LDX     #$A0
0015B2  3                       INC     CLRTMP
0015B2  3                       LDX     CLRTMP
0015B2  3                       CPX     #$00
0015B2  3                       BNE     :--
0015B2  3                       JSR     PAGE_EXIT
0015B2  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
0015B2  3                       JSR     LAB_GTBY        ; GET THE THIRD PARAMETER, RETURN IN X
0015B2  3                       CPX     #$00
0015B2  3                       BNE     SETUPMODE2_MIXED
0015B2  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
0015B2  3                       JSR     PAGE_ENTER
0015B2  3                       LDA     #$02
0015B2  3                       STA     VideoMixedMode
0015B2  3                       JSR     PAGE_EXIT
0015B2  3                       RTS
0015B2  3               SETUPMODE2_MIXED:
0015B2  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
0015B2  3                       JSR     PAGE_ENTER
0015B2  3                       LDA     #$01
0015B2  3                       STA     VideoMixedMode
0015B2  3                       JSR     PAGE_EXIT
0015B2  3                       LDA     VIDEOMODE
0015B2  3                       ORA     #$80
0015B2  3                       STA     VIDEOMODE
0015B2  3                       RTS
0015B2  3               
0015B2  3               
0015B2  3               
0015B2  3               PAGE_EXIT:
0015B2  3                       LDA     #$00
0015B2  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 00
0015B2  3                       RTS
0015B2  3               
0015B2  3               PAGE_ENTER:
0015B2  3               ; Set "Y" register to video page ($YXXX)
0015B2  3                       LDA     #$01            ; MODIFY TASK 01 (DRIVER TASK)
0015B2  3                       LDX     #$0A            ; MAP $AXXX
0015B2  3                       JSR     SETPAGE         ; CALL SETPAGE
0015B2  3                       LDA     #$01
0015B2  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 01
0015B2  3                       RTS
0015B2  3               
0015B2  3               ;___V_PLOT__________________________________________________
0015B2  3               ;
0015B2  3               ;  PLOT ON SCREEN
0015B2  3               ;         TAKES THREE PARAMETERS,  X,Y,COLOR
0015B2  3               ;
0015B2  3               ;__________________________________________________________
0015B2  3               LAB_PLOT:
0015B2  3               V_PLOT:
0015B2  3                       LDA     VIDEOMODE
0015B2  3                       AND     #$0F
0015B2  3                       CMP     #$01
0015B2  3                       BEQ     V_PLOT_LORES
0015B2  3                       LDA     VIDEOMODE
0015B2  3                       AND     #$2F
0015B2  3                       CMP     #$02
0015B2  3                       BNE     :+
0015B2  3                       JMP     V_PLOT_HIRES_COLOR
0015B2  3               :
0015B2  3                       CMP     #$22
0015B2  3                       BNE     :+
0015B2  3                       JMP     V_PLOT_HIRES_MONO
0015B2  3               :
0015B2  3                       RTS
0015B2  3               
0015B2  3               V_PLOT_LORES:
0015B2  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X
0015B2  3                       STX     PTEMPW          ; STORE X COORD IN OFFSET ADDRESS
0015B2  3                       LDA     #00
0015B2  3                       STA     PTEMPW+1
0015B2  3                       STA     PTEMPW1+1
0015B2  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
0015B2  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
0015B2  3                                               ; FIGURE THE BUFFER OFFSET
0015B2  3                       TXA                     ; Y COORD IN X
0015B2  3                       PHA
0015B2  3                       LSR     A               ; 2 LINES PER BYTE
0015B2  3                       STA     PTEMPW1
0015B2  3                                               ; MULTIPLY Y (PTEMPW) COORD BY 40 OR 80 (SINGLE OR DOUBLE LORES)
0015B2  3                       CLC
0015B2  3                       ASL     PTEMPW1
0015B2  3                       ROL     PTEMPW1+1       ; *2
0015B2  3                       ASL     PTEMPW1
0015B2  3                       ROL     PTEMPW1+1       ; *2 (*4)
0015B2  3                       ASL     PTEMPW1
0015B2  3                       ROL     PTEMPW1+1       ; *2 (*8)
0015B2  3                       LDA     PTEMPW1
0015B2  3                       STA     PTEMPW2
0015B2  3                       LDA     PTEMPW1+1
0015B2  3                       STA     PTEMPW2+1       ; STORE Y*8 INTO PTEMPW2
0015B2  3                       ASL     PTEMPW1
0015B2  3                       ROL     PTEMPW1+1       ; *2 (*16)
0015B2  3                       ASL     PTEMPW1
0015B2  3                       ROL     PTEMPW1+1       ; *2 (*32)
0015B2  3                                               ; NOW TAKE Y*8(PTEMPW2) + Y*32(PTEMPW1) == Y*40 STORE IN PTEMPW1
0015B2  3                       CLC                     ; Clear the Carry flag before the first addition
0015B2  3               
0015B2  3                       LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
0015B2  3                       ADC     PTEMPW2         ; Add the low byte of the second number (plus carry)
0015B2  3                       STA     PTEMPW1         ; Store the low byte of the result
0015B2  3               
0015B2  3                       LDA     PTEMPW1+1       ; Load the high byte of the first number
0015B2  3                       ADC     PTEMPW2+1       ; Add the high byte of the second number (plus carry from previous op)
0015B2  3                       STA     PTEMPW1+1       ; Store the high byte of the result
0015B2  3               
0015B2  3               ; if double lores columns double it.
0015B2  3                       LDA     VIDEOMODE
0015B2  3                       AND     #$10
0015B2  3                       CMP     #00
0015B2  3                       BEQ     :+
0015B2  3                       ASL     PTEMPW1
0015B2  3                       ROL     PTEMPW1+1       ; *2
0015B2  3               :
0015B2  3                                               ; OK, Y OFFSET IS IN PTEMPW1, X IS IN PTEMPW
0015B2  3                       LDA     #$A0            ; ADD THE MEMORY OFFSET TO PTEMPW (BECAUSE IT IS EASY)
0015B2  3                       STA     PTEMPW+1        ; THEN ADD PTEMPW1 TO PTEMPW THAT SHOULD BE THE MEMORY ADDRESS TO UPDATE
0015B2  3                                               ;
0015B2  3                       CLC                     ; Clear the Carry flag before the first addition
0015B2  3                       LDA     PTEMPW          ; Load the low byte of the first number into the accumulator
0015B2  3                       ADC     PTEMPW1         ; Add the low byte of the second number (plus carry)
0015B2  3                       STA     TEMPW           ; Store the low byte of the result
0015B2  3               
0015B2  3                       LDA     PTEMPW+1        ; Load the high byte of the first number
0015B2  3                       ADC     PTEMPW1+1       ; Add the high byte of the second number (plus carry from previous op)
0015B2  3                       STA     TEMPW+1         ; Store the high byte of the result
0015B2  3                                               ; PTEMPW IS THE MEMORY OFFSET TO UPDATE
0015B2  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
0015B2  3                       JSR     LAB_GTBY        ; GET THE THIRD PARAMETER, RETURN IN X (PATTERN)
0015B2  3                       TXA
0015B2  3                       AND     #$0F
0015B2  3                       STA     PTEMP           ; SAVE COLOR IN PTEMP
0015B2  3                       PLA
0015B2  3                       LSR     A               ; TOP OR BOTTOM PIXEL?
0015B2  3                       BCC     :+
0015B2  3                                               ; TOP PIXEL
0015B2  3                       LDY     #$02+VIDEOBANK  ; AREA $2000-$2FFF
0015B2  3                       JSR     PAGE_ENTER
0015B2  3                       LDY     #$00
0015B2  3                       LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
0015B2  3                       AND     #$0F
0015B2  3                       PHA
0015B2  3                       LDA     PTEMP
0015B2  3                       ASL     A
0015B2  3                       ASL     A
0015B2  3                       ASL     A
0015B2  3                       ASL     A
0015B2  3                       STA     PTEMP
0015B2  3                       PLA
0015B2  3                       ORA     PTEMP
0015B2  3                       STA     (TEMPW),Y       ; STORE  DOUBLE PIXEL
0015B2  3                       JSR     PAGE_EXIT
0015B2  3                       RTS
0015B2  3               :
0015B2  3                                               ; BOTTOM PIXEL
0015B2  3                       LDY     #$02+VIDEOBANK  ; AREA $2000-$2FFF
0015B2  3                       JSR     PAGE_ENTER
0015B2  3                       LDY     #$00
0015B2  3                       LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
0015B2  3                       AND     #$F0
0015B2  3                       ORA     PTEMP
0015B2  3                       STA     (TEMPW),Y       ; STORE  DOUBLE PIXEL
0015B2  3                       JSR     PAGE_EXIT
0015B2  3                       RTS
0015B2  3               
0015B2  3               V_PLOT_HIRES_COLOR:
0015B2  3                       JSR     LAB_EVNM        ; evaluate expression and check is numeric,
0015B2  3               ; else do type mismatch
0015B2  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
0015B2  3                       LDA     Itemph
0015B2  3                       STA     PTEMPW+1
0015B2  3                       LDA     Itempl
0015B2  3                       PHA                     ; PUSH LOW BYTE OF X (FOR EVEN/ODD LATER)
0015B2  3                       LSR     Itemph
0015B2  3                       ROR     Itempl          ; 2 PIXEL PER BYTE
0015B2  3                       LDA     Itempl          ;
0015B2  3                       STA     PTEMPW          ;
0015B2  3                       LDA     Itemph          ;
0015B2  3                       STA     PTEMPW+1        ; STORE X COORD IN OFFSET ADDRESS;
0015B2  3                       LDA     #$00
0015B2  3                       STA     PTEMPW1+1
0015B2  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
0015B2  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
0015B2  3                                               ; FIGURE THE BUFFER OFFSET
0015B2  3                       LDA     #$00
0015B2  3                       TXA                     ; GET Y COORD
0015B2  3                       STX     PTEMPW1
0015B2  3               
0015B2  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
0015B2  3                       JSR     LAB_GTBY        ; GET THE THIRD PARAMETER, RETURN IN X (PATTERN)
0015B2  3                       TXA
0015B2  3                       AND     #$0F
0015B2  3                       STA     PTEMP4          ; SAVE COLOR IN PTEMP4
0015B2  3                       CLC                     ; MULTIPLY Y COORD BY 70 OR 140 (SINGLE OR DOUBLE HIRES)
0015B2  3                       ASL     PTEMPW1
0015B2  3                       ROL     PTEMPW1+1       ; *2
0015B2  3                       LDA     PTEMPW1
0015B2  3                       STA     PTEMPW2
0015B2  3                       LDA     PTEMPW1+1
0015B2  3                       STA     PTEMPW2+1       ; STORE Y*2 INTO PTEMPW2
0015B2  3                       ASL     PTEMPW1
0015B2  3                       ROL     PTEMPW1+1       ; *2 (*4)
0015B2  3                       LDA     PTEMPW1
0015B2  3                       STA     PTEMPW3
0015B2  3                       LDA     PTEMPW1+1
0015B2  3                       STA     PTEMPW3+1       ; STORE Y*4 INTO PTEMPW3
0015B2  3                       ASL     PTEMPW1
0015B2  3                       ROL     PTEMPW1+1       ; *2 (*8)
0015B2  3                       ASL     PTEMPW1
0015B2  3                       ROL     PTEMPW1+1       ; *2 (*16)
0015B2  3                       ASL     PTEMPW1
0015B2  3                       ROL     PTEMPW1+1       ; *2 (*32)
0015B2  3                       ASL     PTEMPW1
0015B2  3                       ROL     PTEMPW1+1       ; *2 (*64)
0015B2  3                                               ; RESULT OFFSET PTEMPW1 = PTEMPW1(Y*64)+PTEMPW2(Y*2)+PTEMPW3(Y*4)
0015B2  3                       CLC                     ; Clear the Carry flag before the first addition
0015B2  3                       LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
0015B2  3                       ADC     PTEMPW2         ; Add the low byte of the second number (plus carry)
0015B2  3                       STA     PTEMPW1         ; Store the low byte of the result
0015B2  3                       LDA     PTEMPW1+1       ; Load the high byte of the first number
0015B2  3                       ADC     PTEMPW2+1       ; Add the high byte of the second number (plus carry from previous op)
0015B2  3                       STA     PTEMPW1+1       ; Store the high byte of the result
0015B2  3               
0015B2  3                       CLC                     ; Clear the Carry flag before the first addition
0015B2  3                       LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
0015B2  3                       ADC     PTEMPW3         ; Add the low byte of the second number (plus carry)
0015B2  3                       STA     PTEMPW1         ; Store the low byte of the result
0015B2  3                       LDA     PTEMPW1+1       ; Load the high byte of the first number
0015B2  3                       ADC     PTEMPW3+1       ; Add the high byte of the second number (plus carry from previous op)
0015B2  3                       STA     PTEMPW1+1       ; Store the high byte of the result
0015B2  3               
0015B2  3               ; if double hires double it.
0015B2  3                       LDA     VIDEOMODE
0015B2  3                       AND     #$10
0015B2  3                       CMP     #00
0015B2  3                       BEQ     :+
0015B2  3                       ASL     PTEMPW1
0015B2  3                       ROL     PTEMPW1+1       ; *2
0015B2  3               :
0015B2  3                                               ; PTEMPW1 IS NOW Y OFFSET, ADD X OFFSET FOR MEMORY ADDRESS INTO TEMPW
0015B2  3                       CLC                     ; Clear the Carry flag before the first addition
0015B2  3                       LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
0015B2  3                       ADC     PTEMPW          ; Add the low byte of the second number (plus carry)
0015B2  3                       STA     TEMPW           ; Store the low byte of the result
0015B2  3                       LDA     PTEMPW1+1       ; Load the high byte of the first number
0015B2  3                       ADC     PTEMPW+1        ; Add the high byte of the second number (plus carry from previous op)
0015B2  3                       STA     TEMPW+1         ; Store the high byte of the result
0015B2  3               
0015B2  3                       LDA     TEMPW+1         ; OK, LET'S CALCULATE THE BANK
0015B2  3                       AND     #$F0
0015B2  3                       LSR     A
0015B2  3                       LSR     A
0015B2  3                       LSR     A
0015B2  3                       LSR     A
0015B2  3                       CLC
0015B2  3                       ADC     #$02+VIDEOBANK  ; AREA $2000-?
0015B2  3                       CMP     #$F8
0015B2  3                       BCC     V_PLOT_HIRES_COLOR_RANGE
0015B2  3                       TAY                     ; VIDEO BANK SHOULD BE IN Y
0015B2  3                       JSR     PAGE_ENTER
0015B2  3               
0015B2  3                       LDA     TEMPW+1
0015B2  3                       AND     #$0F
0015B2  3                       ORA     #$A0
0015B2  3                       STA     TEMPW+1         ; TEMPW NOW REFLECTS MAPPED ADDRESSS
0015B2  3                       PLA
0015B2  3                       LSR     A               ; LEFT OR RIGHT PIXEL?
0015B2  3                       BCS     :+
0015B2  3                                               ; LEFT PIXEL
0015B2  3                       LDY     #$00
0015B2  3                       LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
0015B2  3                       AND     #$0F
0015B2  3                       PHA
0015B2  3                       LDA     PTEMP4
0015B2  3                       ASL     A
0015B2  3                       ASL     A
0015B2  3                       ASL     A
0015B2  3                       ASL     A
0015B2  3                       STA     PTEMP4
0015B2  3                       PLA
0015B2  3                       ORA     PTEMP4
0015B2  3                       STA     (TEMPW),Y       ; WRITE THE PIXEL BACK OUT
0015B2  3                       JSR     PAGE_EXIT
0015B2  3                       RTS
0015B2  3               :
0015B2  3               ; RIGHT PIXEL
0015B2  3                       LDY     #$00
0015B2  3                       LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
0015B2  3                       AND     #$F0
0015B2  3                       ORA     PTEMP4
0015B2  3                       STA     (TEMPW),Y       ; WRITE THE PIXEL BACK OUT
0015B2  3                       JSR     PAGE_EXIT
0015B2  3                       RTS
0015B2  3               
0015B2  3               V_PLOT_HIRES_COLOR_RANGE:
0015B2  3                       JMP     LAB_2564
0015B2  3               
0015B2  3               V_PLOT_HIRES_MONO:
0015B2  3                       JSR     LAB_EVNM        ; evaluate expression and check is numeric,
0015B2  3                                               ; else do type mismatch
0015B2  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
0015B2  3                       LDA     Itempl
0015B2  3                       PHA
0015B2  3                       LSR     Itemph
0015B2  3                       ROR     Itempl
0015B2  3                       LSR     Itemph
0015B2  3                       ROR     Itempl
0015B2  3                       LSR     Itemph
0015B2  3                       ROR     Itempl          ; 8 PIXEL PER BYTE
0015B2  3                       LDA     Itempl
0015B2  3                       STA     PTEMPW          ; STORE X COORD IN OFFSET ADDRESS
0015B2  3                       LDA     #00
0015B2  3                       STA     PTEMPW+1
0015B2  3                       STA     PTEMPW1+1
0015B2  3                       STA     PTEMPW3+1
0015B2  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
0015B2  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
0015B2  3                                               ; FIGURE THE BUFFER OFFSET
0015B2  3                       STX     PTEMPW1         ; STORE Y COORD
0015B2  3                       STX     PTEMPW3
0015B2  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
0015B2  3                       JSR     LAB_GTBY        ; GET THE THIRD PARAMETER, RETURN IN X (PATTERN)
0015B2  3                       TXA
0015B2  3                       AND     #$01
0015B2  3                       STA     PTEMP4          ; STORE COLOR IN PTEMP4
0015B2  3                       LDA     PTEMPW3
0015B2  3                                               ; MULTIPLY Y COORD BY 35 OR 70 (MONO OR QUAD HIRES)
0015B2  3                       ASL     PTEMPW1
0015B2  3                       ROL     PTEMPW1+1       ; *2
0015B2  3                       LDA     PTEMPW1
0015B2  3                       STA     PTEMPW2
0015B2  3                       LDA     PTEMPW1+1
0015B2  3                       STA     PTEMPW2+1       ; STORE *2 INTO PTEMPW2
0015B2  3                       ASL     PTEMPW1
0015B2  3                       ROL     PTEMPW1+1       ; *2 (*4)
0015B2  3                       ASL     PTEMPW1
0015B2  3                       ROL     PTEMPW1+1       ; *2 (*8)
0015B2  3                       ASL     PTEMPW1
0015B2  3                       ROL     PTEMPW1+1       ; *2 (*16)
0015B2  3                       ASL     PTEMPW1
0015B2  3                       ROL     PTEMPW1+1       ; *2 (*32)
0015B2  3                                               ;
0015B2  3                                               ; PTEMPW1(Y*35) = PTEMPW1(Y*32)+PTEMPW2(Y*2)+PTEMPW3(Y)
0015B2  3                       CLC                     ; Clear the Carry flag before the first addition
0015B2  3                       LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
0015B2  3                       ADC     PTEMPW2         ; Add the low byte of the second number (plus carry)
0015B2  3                       STA     PTEMPW1         ; Store the low byte of the result
0015B2  3               
0015B2  3                       LDA     PTEMPW1+1       ; Load the high byte of the first number
0015B2  3                       ADC     PTEMPW2+1       ; Add the high byte of the second number (plus carry from previous op)
0015B2  3                       STA     PTEMPW1+1       ; Store the high byte of the result
0015B2  3                       CLC                     ; Clear the Carry flag before the first addition
0015B2  3                       LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
0015B2  3                       ADC     PTEMPW3         ; Add the low byte of the second number (plus carry)
0015B2  3                       STA     PTEMPW1         ; Store the low byte of the result
0015B2  3               
0015B2  3                       LDA     PTEMPW1+1       ; Load the high byte of the first number
0015B2  3                       ADC     PTEMPW3+1       ; Add the high byte of the second number (plus carry from previous op)
0015B2  3                       STA     PTEMPW1+1       ; Store the high byte of the result
0015B2  3                                               ;
0015B2  3                                               ; PTEMPW1 IS NOW THE Y OFFSET
0015B2  3                                               ; if quad hires double it.
0015B2  3                       LDA     VIDEOMODE
0015B2  3                       AND     #$10
0015B2  3                       CMP     #00
0015B2  3                       BNE     :+
0015B2  3                       ASL     PTEMPW1
0015B2  3                       ROL     PTEMPW1+1       ; *2
0015B2  3               :
0015B2  3                                               ; ADD THE X OFFSET
0015B2  3                       CLC                     ; Clear the Carry flag before the first addition
0015B2  3                       LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
0015B2  3                       ADC     PTEMPW          ; Add the low byte of the second number (plus carry)
0015B2  3                       STA     TEMPW           ; Store the low byte of the result
0015B2  3               
0015B2  3                       LDA     PTEMPW1+1       ; Load the high byte of the first number
0015B2  3                       ADC     PTEMPW+1        ; Add the high byte of the second number (plus carry from previous op)
0015B2  3                       STA     TEMPW+1         ; Store the high byte of the result
0015B2  3                                               ; TEMPW IS NOW THE MEMORY ADDRESS
0015B2  3               
0015B2  3                       LDA     TEMPW+1         ; OK, LET'S CALCULATE THE BANK
0015B2  3                       AND     #$F0
0015B2  3                       LSR     A
0015B2  3                       LSR     A
0015B2  3                       LSR     A
0015B2  3                       LSR     A
0015B2  3                       CLC
0015B2  3                       ADC     #$02+VIDEOBANK  ; AREA $2000-?
0015B2  3                       CMP     #$F8
0015B2  3                       BCC     V_PLOT_HIRES_COLOR_RANGE1
0015B2  3                       TAY                     ; VIDEO BANK SHOULD BE IN Y
0015B2  3                       JSR     PAGE_ENTER
0015B2  3                       LDA     TEMPW+1
0015B2  3                       AND     #$0F
0015B2  3                       ORA     #$A0
0015B2  3                       STA     TEMPW+1         ; TEMPW NOW REFLECTS MAPPED ADDRESSS
0015B2  3                       PLA
0015B2  3                       AND     #$07            ; WHICH BIT?
0015B2  3                       TAX
0015B2  3                       LDA     PTEMP4
0015B2  3                       CMP     #$01
0015B2  3                       BNE     :+
0015B2  3                       LDA     HIRES_BIT_LOOKUP_SET,X
0015B2  3                       LDY     #$00
0015B2  3                       ORA     (TEMPW),Y
0015B2  3                       STA     (TEMPW),Y
0015B2  3                       JSR     PAGE_EXIT
0015B2  3                       RTS
0015B2  3               :
0015B2  3                       LDA     HIRES_BIT_LOOKUP_RESET,X
0015B2  3                       PHA
0015B2  3                       LDY     #$00
0015B2  3                       AND     (TEMPW),Y
0015B2  3                       STA     (TEMPW),Y
0015B2  3                       JSR     PAGE_EXIT
0015B2  3                       RTS
0015B2  3               V_PLOT_HIRES_COLOR_RANGE1:
0015B2  3                       JMP     LAB_2564
0015B2  3               HIRES_BIT_LOOKUP_SET:
0015B2  3                       .BYTE   %10000000,%01000000,%00100000,%00010000,%00001000,%00000100,%00000010,%00000001
0015B2  3               HIRES_BIT_LOOKUP_RESET:
0015B2  3                       .BYTE   %01111111,%10111111,%11011111,%11101111,%11110111,%11111011,%11111101,%11111110
0015B2  3               
0015B2  3               ;___V_PATTERN________________________________________________
0015B2  3               ;
0015B2  3               ;  DEFINE GRAPHICS PATTERN
0015B2  3               ;
0015B2  3               ;  TAKES 10 PARAMETERS
0015B2  3               ;       PATTERN NUM (0-255)
0015B2  3               ;       PATTERN DATA (8 BYTES)
0015B2  3               ;__________________________________________________________
0015B2  3               LAB_PATTERN
0015B2  3               V_PATTERN:
0015B2  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X
0015B2  3                       TXA
0015B2  3                       PHA
0015B2  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
0015B2  3                       JSR     PAGE_ENTER
0015B2  3                       PLA
0015B2  3                       STA     VideoCharGenOffset
0015B2  3                       LDY     #8
0015B2  3               :
0015B2  3                       TYA
0015B2  3                       PHA
0015B2  3                       JSR     LAB_1C01        ; GET THE NEXT PARAMETER (AFTER ',') OR SYN ERR
0015B2  3                       JSR     LAB_GTBY        ; GET THE NEXT PARAMETER, RETURN IN X
0015B2  3                       PLA
0015B2  3                       TAY
0015B2  3                       TXA
0015B2  3                       STA     VideoCharGenData
0015B2  3                       DEY
0015B2  3                       CPY     #$00
0015B2  3                       BNE     :-
0015B2  3                       JSR     PAGE_EXIT
0015B2  3                       RTS
0015B2  3               
0015B2  3               
0015B2  3               LAB_LINE:
0015B2  3                       rts
0015B2  3                       .ELSE
0015B2  3               
0015B2  3               
0015B2  3               ; ENSURE ALL OF THESE SPECIAL COMMANDS GIVE ERRORS IN NORMAL BASIC
0015B2  3               LAB_SPEEK:
0015B2  3               LAB_SPOKE:
0015B2  3               LAB_SCRCLR:
0015B2  3               LAB_SCREEN:
0015B2  3               LAB_PATTERN:
0015B2  3               LAB_PLOT:
0015B2  3               LAB_LOCATE:
0015B2  3               LAB_COLOR:
0015B2  3               LAB_LINE:
0015B2  3  A2 02                LDX     #$02            ; error code $02 ("SYNTAX" error)
0015B4  3  4C 94 17             JMP     LAB_XERR        ; do error #X, then warm start
0015B7  3               
0015B7  3                       .ENDIF
0015B7  3               
0015B7  2                       .INCLUDE "sid.asm"
0015B7  3               
0015B7  3               
0015B7  3                       .IFDEF  MEMORYMAPPEDSCREEN
0015B7  3               
0015B7  3               PC6502_IO       = $E000
0015B7  3               SID_BASE        = PC6502_IO+$100
0015B7  3               
0015B7  3               ;___SOUND__________________________________________________
0015B7  3               ;
0015B7  3               ; PLAY SOUND
0015B7  3               ;
0015B7  3               ;  SOUND VOICE, FREQ, DUTY, WAVEFORM, ATTACK, SUSTAIN, DECAY, RELEASE
0015B7  3               ;
0015B7  3               ;
0015B7  3               ;__________________________________________________________
0015B7  3               LAB_SOUND:
0015B7  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (VOICE)
0015B7  3                       TXA
0015B7  3                       AND     #3
0015B7  3                       ASL     A
0015B7  3                       TAX
0015B7  3                       LDA     SIDVOICELOOKUP,X
0015B7  3                       STA     TEMPW
0015B7  3                       LDA     SIDVOICELOOKUP+1,X
0015B7  3                       STA     TEMPW+1
0015B7  3                                               ; OK, TEMPW POINTS TO SID REGISTER TO MODIFY
0015B7  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
0015B7  3                       JSR     LAB_EVNM        ; evaluate expression and check is numeric,
0015B7  3                                               ; else do type mismatch
0015B7  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
0015B7  3                       LDY     #0              ; SET FREQUENCY
0015B7  3                       LDA     Itempl
0015B7  3                       STA     (TEMPW),Y
0015B7  3                       LDA     Itemph
0015B7  3                       INX
0015B7  3                       STA     (TEMPW),Y
0015B7  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
0015B7  3                       JSR     LAB_EVNM        ; evaluate expression and check is numeric,
0015B7  3                                               ; else do type mismatch
0015B7  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
0015B7  3                       LDY     #2              ; SET DUTY CYCLE
0015B7  3                       LDA     Itempl
0015B7  3                       STA     (TEMPW),Y
0015B7  3                       LDA     Itemph
0015B7  3                       INY
0015B7  3                       STA     (TEMPW),Y
0015B7  3                       JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
0015B7  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (WAVEFORM)
0015B7  3                       TXA
0015B7  3                       LDY     #4              ; SET WAVEFORM CYCLE
0015B7  3                       STA     (TEMPW),Y
0015B7  3                       JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
0015B7  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (ATTACK)
0015B7  3                       TXA
0015B7  3                       LSR     A
