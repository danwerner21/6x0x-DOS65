0010FA  2               PRINT_CRLF:
0010FA  2  8E 68 11             STX     TTX
0010FD  2  8C 69 11             STY     TTY
001100  2  8D 6A 11             STA     TTA
001103  2  A9 0D                LDA     #13
001105  2  20 6B 11             JSR     WRSER1          ; output upper nybble
001108  2  A9 0A                LDA     #10
00110A  2  20 6B 11             JSR     WRSER1          ; output upper nybble
00110D  2  AE 68 11             LDX     TTX
001110  2  AC 69 11             LDY     TTY
001113  2  AD 6A 11             LDA     TTA
001116  2  60                   RTS
001117  2               
001117  2               PRINT_SPACE:
001117  2  8E 68 11             STX     TTX
00111A  2  8C 69 11             STY     TTY
00111D  2  8D 6A 11             STA     TTA
001120  2  A9 20                LDA     #32
001122  2  20 6B 11             JSR     WRSER1          ; output upper nybble
001125  2  AE 68 11             LDX     TTX
001128  2  AC 69 11             LDY     TTY
00112B  2  AD 6A 11             LDA     TTA
00112E  2  60                   RTS
00112F  2               
00112F  2               
00112F  2               PRINT_BYTE:
00112F  2  8E 68 11             STX     TTX
001132  2  8C 69 11             STY     TTY
001135  2  8D 6A 11             STA     TTA
001138  2  8E 67 11             STX     SAVX            ; save X
00113B  2  20 52 11             JSR     ASCTWO          ; get hex chars for byte in X (lower) and A (upper)
00113E  2  20 6B 11             JSR     WRSER1          ; output upper nybble
001141  2  8A                   TXA                     ; transfer lower to A
001142  2  AE 67 11             LDX     SAVX            ; restore X
001145  2  20 6B 11             JSR     WRSER1          ; output lower nybble
001148  2  AE 68 11             LDX     TTX
00114B  2  AC 69 11             LDY     TTY
00114E  2  AD 6A 11             LDA     TTA
001151  2  60                   RTS
001152  2               ASCTWO:
001152  2  48                   PHA                     ; save byte
001153  2  20 5C 11             JSR     ASCII           ; do low nybble
001156  2  AA                   TAX                     ; save in X
001157  2  68                   PLA                     ; restore byte
001158  2  4A                   LSR     A               ; shift upper nybble down
001159  2  4A                   LSR     A
00115A  2  4A                   LSR     A
00115B  2  4A                   LSR     A
00115C  2               ; convert low nybble in A to hex digit
00115C  2               ASCII:
00115C  2  29 0F                AND     #$0F            ; clear upper nibble
00115E  2  C9 0A                CMP     #$0A            ; if less than A, skip next step
001160  2  90 02                BCC     ASC1
001162  2  69 06                ADC     #6              ; skip ascii chars between 9 and A
001164  2               ASC1:
001164  2  69 30                ADC     #$30            ; add ascii char 0 to value
001166  2  60                   RTS
001167  2               SAVX:
001167  2  00                   .BYTE   00
001168  2               TTX:
001168  2  00                   .BYTE   00
001169  2               TTY:
001169  2  00                   .BYTE   00
00116A  2               TTA:
00116A  2  00                   .BYTE   00
00116B  2               ;__WRSER1________________________________________________________________________________________________________________________
00116B  2               ;
00116B  2               ;	WRITE CHARACTER(A) TO UART
00116B  2               ;________________________________________________________________________________________________________________________________
00116B  2               ;
00116B  2               WRSER1:
00116B  2  48                   PHA
00116C  2               WRSER1a:
00116C  2  AD 85 EF             LDA     UART1STATUS     ; GET STATUS
00116F  2  29 10                AND     #%00010000      ; IS TX READY
001171  2  F0 F9                BEQ     WRSER1a         ; NO, WAIT FOR IT
001173  2  68                   PLA
001174  2  8D 84 EF             STA     UART1DATA       ; WRITE DATA
001177  2  60                   RTS
