00108C  2               ;___ScreenEditor____________________________________________
00108C  2               ;
00108C  2               ; Basic Screen editor code
00108C  2               ;
00108C  2               ;__________________________________________________________
00108C  2               ScreenEditor:
00108C  2               ; allow prepopulate of screen
00108C  2               ploop:
00108C  2                       LDA     #58
00108C  2                       STA     farfunct
00108C  2                       JSR     DO_FARCALL      ; PAINT cursor
00108C  2               ploop1:
00108C  2                       LDA     #20
00108C  2                       STA     farfunct
00108C  2                       JSR     DO_FARCALL      ; GET KEYSTROKE
00108C  2                       CMP     #$FF
00108C  2                       BEQ     ploop1
00108C  2                       PHA
00108C  2                       LDA     #59
00108C  2                       STA     farfunct
00108C  2                       JSR     DO_FARCALL      ; UNPAINT cursor
00108C  2                       PLA
00108C  2                       CMP     #$F6
00108C  2                       BEQ     crsrup
00108C  2                       CMP     #$F7
00108C  2                       BEQ     crsrdn
00108C  2                       CMP     #$F8
00108C  2                       BEQ     crsrlt
00108C  2                       CMP     #$F9
00108C  2                       BEQ     Lcrsrrt
00108C  2                       CMP     #$0A
00108C  2                       BEQ     ploop
00108C  2                       CMP     #13
00108C  2                       BEQ     Lpexit
00108C  2               
00108C  2                       PHA
00108C  2                       LDA     #19
00108C  2                       STA     farfunct
00108C  2                       PLA
00108C  2                       JSR     DO_FARCALL
00108C  2                       JMP     ploop
00108C  2               Lpexit:
00108C  2                       JMP     pexit
00108C  2               Lcrsrrt:
00108C  2                       JMP     crsrrt
00108C  2               
00108C  2               crsrup:
00108C  2                       LDA     CURY
00108C  2                       CMP     #00
00108C  2                       BEQ     ploop
00108C  2                       DEC     CURY
00108C  2                       JMP     ploop
00108C  2               crsrdn:
00108C  2                       LDA     CURY
00108C  2                       CMP     #23
00108C  2                       BEQ     crsrdn_1
00108C  2                       INC     CURY
00108C  2                       JMP     ploop
00108C  2               crsrdn_1:
00108C  2                       LDA     #56
00108C  2                       STA     farfunct
00108C  2                       JSR     DO_FARCALL
00108C  2                       JMP     ploop
00108C  2               crsrlt:
00108C  2                       LDA     CURX
00108C  2                       CMP     #00
00108C  2                       BEQ     crsrlt_1
00108C  2                       DEC     CURX
00108C  2                       JMP     ploop
00108C  2               crsrlt_1:
00108C  2                       LDA     CURY
00108C  2                       CMP     #00
00108C  2                       BEQ     :+
00108C  2                       LDX     VIDEOWIDTH
00108C  2                       DEX
00108C  2                       STX     CURX
00108C  2                       LDY     CURY
00108C  2                       DEY
00108C  2                       STY     CURY
00108C  2               :
00108C  2                       JMP     ploop
00108C  2               crsrrt:
00108C  2                       LDX     VIDEOWIDTH
00108C  2                       DEX
00108C  2                       CPX     CURX
00108C  2                       BEQ     crsrrt_1
00108C  2                       INC     CURX
00108C  2                       JMP     ploop
00108C  2               crsrrt_1:
00108C  2                       LDA     #00
00108C  2                       STA     CURX
00108C  2                       JMP     crsrdn
00108C  2               pexit:
00108C  2                       JSR     LdKbBuffer
00108C  2                       LDX     #80
00108C  2                       LDA     #$00
00108C  2                       STA     Ibuffs,X
00108C  2               TERMLOOP:
00108C  2                       DEX
00108C  2                       LDA     Ibuffs,X
00108C  2                       CMP     #32
00108C  2                       BEQ     TERMLOOP_B
00108C  2                       CMP     #00
00108C  2                       BEQ     TERMLOOP_C
00108C  2                       JMP     TERMLOOP_A
00108C  2               TERMLOOP_B:
00108C  2                       LDA     #00
00108C  2                       STA     Ibuffs,X
00108C  2               TERMLOOP_C:
00108C  2                       CPX     #00
00108C  2                       BNE     TERMLOOP
00108C  2               TERMLOOP_A:
00108C  2                       LDA     #19
00108C  2                       STA     farfunct
00108C  2                       LDA     #13
00108C  2                       JSR     DO_FARCALL
00108C  2                       LDA     #19
00108C  2                       STA     farfunct
00108C  2                       LDA     #10
00108C  2                       JSR     DO_FARCALL
00108C  2                       RTS
00108C  2               
00108C  2               LdKbBuffer:
00108C  2               ; clear input buffer
00108C  2                       LDX     #81
00108C  2               :
00108C  2                       LDA     #00
00108C  2                       STA     Ibuffs-1,X
00108C  2                       DEX
00108C  2                       BNE     :-
00108C  2               
00108C  2                       LDY     CURY
00108C  2               
00108C  2                       STY     PTEMPW
00108C  2                       LDA     #0
00108C  2                       STA     PTEMPW+1
00108C  2                       CLC
00108C  2                       ASL     PTEMPW
00108C  2                       ROL     PTEMPW+1        ; *2
00108C  2                       ASL     PTEMPW
00108C  2                       ROL     PTEMPW+1        ; *4
00108C  2                       ASL     PTEMPW
00108C  2                       ROL     PTEMPW+1        ; *8
00108C  2                       LDA     PTEMPW
00108C  2                       STA     PTEMPW1
00108C  2                       LDA     PTEMPW+1
00108C  2                       STA     PTEMPW1+1       ; PTEMPW1=Y*8
00108C  2                       ASL     PTEMPW
00108C  2                       ROL     PTEMPW+1        ; *16
00108C  2                       ASL     PTEMPW
00108C  2                       ROL     PTEMPW+1        ; *32
00108C  2                                               ; TEMPW  = Y*8 + Y*32  (Y*40)
00108C  2                       CLC                     ; Clear the Carry flag before the first addition
00108C  2                       LDA     PTEMPW          ; Load the low byte of the first number into the accumulator
00108C  2                       ADC     PTEMPW1         ; Add the low byte of the second number (plus carry)
00108C  2                       STA     TEMPW           ; Store the low byte of the result
00108C  2                       LDA     PTEMPW+1        ; Load the high byte of the first number
00108C  2                       ADC     PTEMPW1+1       ; Add the high byte of the second number (plus carry from previous op)
00108C  2                       STA     TEMPW+1         ; Store the high byte of the result
00108C  2               
00108C  2                       LDA     VIDEOWIDTH      ; If 80 col, double again
00108C  2                       CMP     #80
00108C  2                       BNE     :+
00108C  2                       ASL     TEMPW
00108C  2                       ROL     TEMPW+1         ; *2  (80)
00108C  2               :
00108C  2                       LDA     TEMPW+1
00108C  2                       ORA     #$A0            ; add in the bank#
00108C  2                       STA     TEMPW+1
00108C  2               
00108C  2                       LDY     #$01+VIDEOBANK  ; SCREEN AREA $1000-$1FFF
00108C  2                       JSR     PAGE_ENTER
00108C  2                       LDY     #0
00108C  2               :
00108C  2                       LDA     (TEMPW),Y
00108C  2                       STA     Ibuffs,Y
00108C  2                       INY
00108C  2                       CPY     VIDEOWIDTH
00108C  2                       BNE     :-
00108C  2               
00108C  2                       JSR     PAGE_EXIT
00108C  2                       RTS
00108C  2                       RTS
00108C  2               
00108C  2                       .ENDIF
