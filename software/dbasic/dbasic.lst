001212  3  B0 20                BCS     DOS65LOAD_ERR1  ; Error?, if so abort
001214  3  A2 0D                LDX     #13             ;
001216  3  20 4D 11             JSR     PEM             ;
001219  3  A9 00                LDA     #0              ; clear
00121B  3  8D 90 15             STA     FCB+32          ; record number
00121E  3  A9 70                LDA     #<FCB           ; Open File
001220  3  A0 15                LDY     #>FCB           ;
001222  3  A2 0F                LDX     #15             ;
001224  3  20 4D 11             JSR     PEM             ;
001227  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
001229  3  D0 0C                BNE     DOS65LOAD_1     ;
00122B  3               DOS65LOAD_ERR:
00122B  3  A9 BE                LDA     #<FILEERROR2    ; NO, ERROR OUT
00122D  3  A0 0F                LDY     #>FILEERROR2
00122F  3  A2 09                LDX     #9              ; Print error message
001231  3  20 4D 11             JSR     PEM             ;
001234  3               DOS65LOAD_ERR1:
001234  3  4C 75 1D             JMP     LAB_REM         ; comment out the remainder of the line (if any)
001237  3               DOS65LOAD_1:
001237  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
001239  3  85 22                STA     FCBPTR+2        ; point to base of RAM
00123B  3  8D 10 13             STA     EndOfBas        ;
00123E  3  A5 7A                LDA     <Smemh          ;
001240  3  85 23                STA     FCBPTR+3        ;
001242  3  8D 11 13             STA     EndOfBas+1      ;
001245  3  A9 52                LDA     #<FCBBUFFER     ; SETUP BUFFER
001247  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
001249  3  A0 37                LDY     #>FCBBUFFER     ;
00124B  3  84 21                STY     FCBPTR+1        ; STORE DEST BUFFER IN FCBPTR
00124D  3  A2 1A                LDX     #26             ; Setup Buffer
00124F  3  20 4D 11             JSR     PEM             ;
001252  3  4C 90 12             JMP     DOS65LOAD_3C
001255  3               DOS65LOAD_3:
001255  3  B1 20                LDA     (FCBPTR),Y      ; load from BUFFER
001257  3  91 22                STA     (FCBPTR+2),Y    ; save to RAM
001259  3  EE 10 13             INC     EndOfBas
00125C  3  D0 03                BNE     :+
00125E  3  EE 11 13             INC     EndOfBas+1
001261  3               :
001261  3  C9 00                CMP     #$00
001263  3  D0 0D                BNE     :+
001265  3  EE 12 13             INC     NullCounter
001268  3  AD 12 13             LDA     NullCounter
00126B  3  C9 03                CMP     #3
00126D  3  D0 08                BNE     :++
00126F  3  4C A3 12             JMP     DOS65LOAD_4
001272  3               :
001272  3  A9 00                LDA     #$00
001274  3  8D 12 13             STA     NullCounter
001277  3               :
001277  3  C8                   INY                     ; bump index
001278  3  C0 80                CPY     #$80            ; end of buffer?
00127A  3  D0 D9                BNE     DOS65LOAD_3     ; no, loop
00127C  3  18                   CLC                     ;
00127D  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
00127F  3  69 80                ADC     #$80            ;
001281  3  85 22                STA     FCBPTR+2        ;
001283  3  90 0B                BCC     DOS65LOAD_3C    ; is carry?, no SKIP
001285  3  18                   CLC                     ; yes, carry, inc high byte
001286  3  A5 23                LDA     FCBPTR+3        ;
001288  3  69 01                ADC     #$01            ;
00128A  3  85 23                STA     FCBPTR+3        ;
00128C  3  C9 B8                CMP     #>Ram_top       ; are we at the end of RAM?
00128E  3  F0 13                BEQ     DOS65LOAD_4
001290  3               
001290  3               DOS65LOAD_3C:
001290  3  A9 70                LDA     #<FCB           ; READ record buffer from disk file
001292  3  A0 15                LDY     #>FCB           ;
001294  3  A2 14                LDX     #20             ;
001296  3  20 4D 11             JSR     PEM             ;
001299  3  A0 00                LDY     #$00            ; RESET INDEX
00129B  3  C9 00                CMP     #$00            ; is error or EOF
00129D  3  F0 B6                BEQ     DOS65LOAD_3     ;
00129F  3  C9 01                CMP     #$01            ; EOF?
0012A1  3  D0 88                BNE     DOS65LOAD_ERR   ; ERROR, do error handling
0012A3  3               DOS65LOAD_4:
0012A3  3  A9 70                LDA     #<FCB           ;
0012A5  3  A0 15                LDY     #>FCB           ;
0012A7  3  A2 10                LDX     #16             ;
0012A9  3  20 4D 11             JSR     PEM             ;
0012AC  3                                               ; setup pointers to return to basic
0012AC  3  AD 10 13             LDA     EndOfBas
0012AF  3  85 7B                STA     Svarl
0012B1  3  85 7D                STA     Sarryl
0012B3  3  85 7F                STA     Earryl
0012B5  3  AD 11 13             LDA     EndOfBas+1
0012B8  3  85 7C                STA     Svarh
0012BA  3  85 7E                STA     Sarryh
0012BC  3  85 80                STA     Earryh
0012BE  3  A9 65                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
0012C0  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
0012C2  3  20 2A 1F             JSR     LAB_18C3
0012C5  3  4C 6C 18             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
