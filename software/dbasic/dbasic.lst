0010D4  2  08                   PHP
0010D5  2  A9 01                LDA     #$01
0010D7  2  8D 7B 10             STA     printflag
0010DA  2  28                   PLP
0010DB  2  20 C3 1E             JSR     LAB_PRINT
0010DE  2  A9 00                LDA     #$00
0010E0  2  8D 7B 10             STA     printflag
0010E3  2  60                   RTS
