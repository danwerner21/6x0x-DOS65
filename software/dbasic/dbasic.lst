00109F  2  20 4D 11             JSR     PEM             ;
0010A2  2  AC 4B 11             LDY     DBGY
0010A5  2  AE 4A 11             LDX     DBGX
0010A8  2  38                   SEC                     ; flag byte received
0010A9  2  60                   RTS
