0010DA  2                       DEX
0010DA  2                       CPX     CURX
0010DA  2                       BEQ     crsrrt_1
0010DA  2                       INC     CURX
0010DA  2                       JMP     ploop
0010DA  2               crsrrt_1:
0010DA  2                       LDA     #00
0010DA  2                       STA     CURX
0010DA  2                       JMP     crsrdn
0010DA  2               pexit:
0010DA  2                       JSR     LdKbBuffer
0010DA  2                       LDX     #80
0010DA  2                       LDA     #$00
0010DA  2                       STA     Ibuffs,X
0010DA  2               TERMLOOP:
0010DA  2                       DEX
0010DA  2                       LDA     Ibuffs,X
0010DA  2                       CMP     #32
0010DA  2                       BEQ     TERMLOOP_B
0010DA  2                       CMP     #00
0010DA  2                       BEQ     TERMLOOP_C
0010DA  2                       JMP     TERMLOOP_A
0010DA  2               TERMLOOP_B:
0010DA  2                       LDA     #00
0010DA  2                       STA     Ibuffs,X
0010DA  2               TERMLOOP_C:
0010DA  2                       CPX     #00
0010DA  2                       BNE     TERMLOOP
0010DA  2               TERMLOOP_A:
