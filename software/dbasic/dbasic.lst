0010DA  2               ;___ScreenEditor____________________________________________
0010DA  2               ;
0010DA  2               ; Basic Screen editor code
0010DA  2               ;
0010DA  2               ;__________________________________________________________
0010DA  2               ScreenEditor:
0010DA  2               ; allow prepopulate of screen
0010DA  2               ploop:
0010DA  2                       LDA     #58
0010DA  2                       STA     farfunct
0010DA  2                       JSR     DO_FARCALL      ; PAINT cursor
0010DA  2               ploop1:
0010DA  2                       LDA     #20
0010DA  2                       STA     farfunct
0010DA  2                       JSR     DO_FARCALL      ; GET KEYSTROKE
0010DA  2                       CMP     #$FF
0010DA  2                       BEQ     ploop1
0010DA  2                       PHA
0010DA  2                       LDA     #59
0010DA  2                       STA     farfunct
0010DA  2                       JSR     DO_FARCALL      ; UNPAINT cursor
0010DA  2                       PLA
0010DA  2                       CMP     #$F0
0010DA  2                       BEQ     insert
0010DA  2                       CMP     #$F1
0010DA  2                       BEQ     delete
0010DA  2                       CMP     #$F6
0010DA  2                       BEQ     crsrup
0010DA  2                       CMP     #$F7
0010DA  2                       BEQ     crsrdn
0010DA  2                       CMP     #$F8
0010DA  2                       BEQ     crsrlt
0010DA  2                       CMP     #$F9
0010DA  2                       BEQ     Lcrsrrt
0010DA  2                       CMP     #$0A
0010DA  2                       BEQ     ploop
0010DA  2                       CMP     #13
0010DA  2                       BEQ     Lpexit
0010DA  2               
0010DA  2                       PHA
0010DA  2                       LDA     #19
0010DA  2                       STA     farfunct
0010DA  2                       PLA
0010DA  2                       JSR     DO_FARCALL
0010DA  2                       JMP     ploop
0010DA  2               Lpexit:
0010DA  2                       JMP     pexit
0010DA  2               Lcrsrrt:
0010DA  2                       JMP     crsrrt
0010DA  2               insert:
0010DA  2                       JMP     DOINSERT
0010DA  2               delete:
0010DA  2                       JMP     DODELETE
0010DA  2               crsrup:
0010DA  2                       LDA     CURY
0010DA  2                       CMP     #00
0010DA  2                       BEQ     ploop
0010DA  2                       DEC     CURY
0010DA  2                       JMP     ploop
0010DA  2               crsrdn:
0010DA  2                       LDA     CURY
0010DA  2                       CMP     #23
0010DA  2                       BEQ     crsrdn_1
0010DA  2                       INC     CURY
0010DA  2                       JMP     ploop
0010DA  2               crsrdn_1:
0010DA  2                       LDA     #56
0010DA  2                       STA     farfunct
0010DA  2                       JSR     DO_FARCALL
0010DA  2                       JMP     ploop
