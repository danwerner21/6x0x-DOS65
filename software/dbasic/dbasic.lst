001636  3               
001636  3               BCD_TO_HEX:
001636  3  85 12                STA     nums_2          ; Store in TEMP2
001638  3  29 F0                AND     #$F0
00163A  3  4A                   LSR     A               ; (shift 1 times to /2)
00163B  3  85 11                STA     nums_1          ; Store the /2 into TEMP
00163D  3  4A                   LSR     A               ;
00163E  3  4A                   LSR     A               ; Shift two more times to /8
00163F  3  18                   CLC
001640  3  65 11                ADC     nums_1          ; add /8 + /2 to get /10
001642  3  85 11                STA     nums_1          ; Store tens digit into TEMP
001644  3  A5 12                LDA     nums_2          ; Get Ones
001646  3  29 0F                AND     #$0F
001648  3  18                   CLC
001649  3  65 11                ADC     nums_1
00164B  3  60                   RTS                     ; Return from subroutine
00164C  3               
