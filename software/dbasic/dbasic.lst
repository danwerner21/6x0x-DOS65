00159B  3               ;__________________________________________________________
00159B  3               LAB_SECOND:
00159B  3  A2 00                LDX     #RTCSECONDS
00159D  3  A9 33                LDA     #51
00159F  3  85 32                STA     farfunct
0015A1  3  20 F0 FF             JSR     DO_FARCALL
0015A4  3  98                   TYA
0015A5  3               
0015A5  3  20 36 16             JSR     BCD_TO_HEX
0015A8  3  A8                   TAY
0015A9  3  A9 00                LDA     #0              ; Get high byte
0015AB  3  20 7E 26             JSR     LAB_AYFC
0015AE  3  60                   RTS
