0010D0  2               PRINT_CRLF:
0010D0  2  8E 3E 11             STX     TTX
0010D3  2  8C 3F 11             STY     TTY
0010D6  2  8D 40 11             STA     TTA
0010D9  2  A9 0D                LDA     #13
0010DB  2  20 41 11             JSR     WRSER1          ; output upper nybble
0010DE  2  A9 0A                LDA     #10
0010E0  2  20 41 11             JSR     WRSER1          ; output upper nybble
0010E3  2  AE 3E 11             LDX     TTX
0010E6  2  AC 3F 11             LDY     TTY
0010E9  2  AD 40 11             LDA     TTA
0010EC  2  60                   RTS
0010ED  2               
0010ED  2               PRINT_SPACE:
0010ED  2  8E 3E 11             STX     TTX
0010F0  2  8C 3F 11             STY     TTY
0010F3  2  8D 40 11             STA     TTA
0010F6  2  A9 20                LDA     #32
0010F8  2  20 41 11             JSR     WRSER1          ; output upper nybble
0010FB  2  AE 3E 11             LDX     TTX
0010FE  2  AC 3F 11             LDY     TTY
001101  2  AD 40 11             LDA     TTA
001104  2  60                   RTS
001105  2               
001105  2               
001105  2               PRINT_BYTE:
001105  2  8E 3E 11             STX     TTX
001108  2  8C 3F 11             STY     TTY
00110B  2  8D 40 11             STA     TTA
00110E  2  8E 3D 11             STX     SAVX            ; save X
001111  2  20 28 11             JSR     ASCTWO          ; get hex chars for byte in X (lower) and A (upper)
001114  2  20 41 11             JSR     WRSER1          ; output upper nybble
001117  2  8A                   TXA                     ; transfer lower to A
001118  2  AE 3D 11             LDX     SAVX            ; restore X
00111B  2  20 41 11             JSR     WRSER1          ; output lower nybble
00111E  2  AE 3E 11             LDX     TTX
001121  2  AC 3F 11             LDY     TTY
001124  2  AD 40 11             LDA     TTA
001127  2  60                   RTS
001128  2               ASCTWO:
001128  2  48                   PHA                     ; save byte
001129  2  20 32 11             JSR     ASCII           ; do low nybble
00112C  2  AA                   TAX                     ; save in X
00112D  2  68                   PLA                     ; restore byte
00112E  2  4A                   LSR     A               ; shift upper nybble down
00112F  2  4A                   LSR     A
001130  2  4A                   LSR     A
001131  2  4A                   LSR     A
001132  2               ; convert low nybble in A to hex digit
001132  2               ASCII:
001132  2  29 0F                AND     #$0F            ; clear upper nibble
001134  2  C9 0A                CMP     #$0A            ; if less than A, skip next step
001136  2  90 02                BCC     ASC1
001138  2  69 06                ADC     #6              ; skip ascii chars between 9 and A
00113A  2               ASC1:
00113A  2  69 30                ADC     #$30            ; add ascii char 0 to value
00113C  2  60                   RTS
00113D  2               SAVX:
00113D  2  00                   .BYTE   00
00113E  2               TTX:
00113E  2  00                   .BYTE   00
00113F  2               TTY:
00113F  2  00                   .BYTE   00
001140  2               TTA:
001140  2  00                   .BYTE   00
