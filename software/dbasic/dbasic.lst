0015B7  3                       JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
0015B7  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (DECAY)
0015B7  3                       TXA
0015B7  3                       AND     #$0F
0015B7  3                       ORA     PTEMPW
0015B7  3                       LDY     #5              ; SET ATTACK/DECAY
