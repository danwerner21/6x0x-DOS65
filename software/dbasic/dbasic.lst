0013D3  3  B9 43 15             LDA     FCB,Y
0013D6  3  C9 2E                CMP     #'.'
0013D8  3  F0 0A                BEQ     V_OPEN_EXTENSION
0013DA  3  C4 AC                CPY     str_ln
0013DC  3  F0 21                BEQ     V_OPEN_FNEND
0013DE  3  4C D2 13             JMP     :-
0013E1  3  4C FF 13             JMP     V_OPEN_FNEND
