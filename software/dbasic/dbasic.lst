0010B0  2               
0010B0  2                       JSR     PAGE_EXIT
0010B0  2                       RTS
0010B0  2               
0010B0  2               GETVIDEOADDRESS:
0010B0  2                       LDY     CURY
0010B0  2               
0010B0  2                       STY     PTEMPW
0010B0  2                       LDA     #0
0010B0  2                       STA     PTEMPW+1
0010B0  2                       CLC
0010B0  2                       ASL     PTEMPW
0010B0  2                       ROL     PTEMPW+1        ; *2
0010B0  2                       ASL     PTEMPW
0010B0  2                       ROL     PTEMPW+1        ; *4
0010B0  2                       ASL     PTEMPW
0010B0  2                       ROL     PTEMPW+1        ; *8
0010B0  2                       LDA     PTEMPW
0010B0  2                       STA     PTEMPW1
0010B0  2                       LDA     PTEMPW+1
0010B0  2                       STA     PTEMPW1+1       ; PTEMPW1=Y*8
0010B0  2                       ASL     PTEMPW
0010B0  2                       ROL     PTEMPW+1        ; *16
0010B0  2                       ASL     PTEMPW
0010B0  2                       ROL     PTEMPW+1        ; *32
0010B0  2                                               ; TEMPW  = Y*8 + Y*32  (Y*40)
0010B0  2                       CLC                     ; Clear the Carry flag before the first addition
0010B0  2                       LDA     PTEMPW          ; Load the low byte of the first number into the accumulator
0010B0  2                       ADC     PTEMPW1         ; Add the low byte of the second number (plus carry)
0010B0  2                       STA     TEMPW           ; Store the low byte of the result
0010B0  2                       LDA     PTEMPW+1        ; Load the high byte of the first number
0010B0  2                       ADC     PTEMPW1+1       ; Add the high byte of the second number (plus carry from previous op)
0010B0  2                       STA     TEMPW+1         ; Store the high byte of the result
0010B0  2               
0010B0  2                       LDA     VIDEOWIDTH      ; If 80 col, double again
0010B0  2                       CMP     #80
0010B0  2                       BNE     :+
0010B0  2                       ASL     TEMPW
0010B0  2                       ROL     TEMPW+1         ; *2  (80)
0010B0  2               :
0010B0  2                       LDA     TEMPW+1
0010B0  2                       ORA     #$A0            ; add in the bank#
0010B0  2                       STA     TEMPW+1
0010B0  2                       RTS
0010B0  2               
0010B0  2               
0010B0  2                       .ENDIF
0010B0  2               
