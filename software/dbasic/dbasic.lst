001451  3  A0 02                LDY     #$02            ; index to string pointer high byte
001453  3  B1 95                LDAINDIRECTY Cvaral     ; get string pointer high byte
001455  3  85 FE                STA     TEMPW+1         ; set string pointer high byte
001457  3  88                   DEY                     ; index to string pointer low byte
001458  3  B1 95                LDAINDIRECTY Cvaral     ; get string pointer low byte
