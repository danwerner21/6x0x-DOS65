0038FC  1               ; returns A=$00 if FAC1 = (AY)
0038FC  1               ; returns A=$01 if FAC1 > (AY)
0038FC  1               ; returns A=$FF if FAC1 < (AY)
0038FC  1               
0038FC  1               ; perform WIDTH
0038FC  1               
0038FC  1               LAB_WDTH:
0038FC  1  C9 2C                CMP     #','            ; is next byte ","
