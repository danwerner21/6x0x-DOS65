001413  3  A9 4F                LDA     #<FCB           ; FCB
001415  3  A0 15                LDY     #>FCB           ; FCB
001417  3  20 3B 11             JSR     PEM
00141A  3  C9 FF                CMP     #$FF
00141C  3  D0 08                BNE     :+
00141E  3  A2 24                LDX     #$24            ; IO ERROR
001420  3  20 73 17             JSR     LAB_XERR
001423  3  4C 4B 18             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001426  3               :
