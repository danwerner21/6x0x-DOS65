00145A  3  20 F5 20             JSR     LAB_CTST        ; check if source is string, else do type mismatch
00145D  3  A0 02                LDY     #$02            ; index to string pointer high byte
00145F  3  B1 95                LDAINDIRECTY Cvaral     ; get string pointer high byte
001461  3  85 FE                STA     TEMPW+1         ; set string pointer high byte
001463  3  88                   DEY                     ; index to string pointer low byte
001464  3  B1 95                LDAINDIRECTY Cvaral     ; get string pointer low byte
001466  3  85 FD                STA     TEMPW           ; set string pointer low byte
001468  3  A2 10                LDX     #16             ; CLOSE
00146A  3  A5 FD                LDA     TEMPW           ; FCB
00146C  3  A4 FE                LDY     TEMPW+1         ; FCB
00146E  3  20 3B 11             JSR     PEM
001471  3  C9 FF                CMP     #$FF
001473  3  D0 08                BNE     :+
001475  3  A2 24                LDX     #$24            ; IO ERROR
001477  3  20 73 17             JSR     LAB_XERR
00147A  3  4C 4B 18             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
00147D  3               :
00147D  3  60                   RTS
