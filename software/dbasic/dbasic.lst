001159  3               ;___SAVE____________________________________________________
001159  3               ;
001159  3               ; SAVE COMMAND
001159  3               ;
001159  3               ;  SAVE THE BASIC PROGRAM IN MEMORY TO DISK
001159  3               ;
001159  3               ;__________________________________________________________
001159  3               V_SAVE: ; save BASIC program
001159  3               DOS65SAVE:
001159  3  20 CC 12             JSR     DOS65FCBPREP    ; parse parameters into FCB
00115C  3  B0 28                BCS     DOS65SAVE_ERR1  ; Error?, if so abort
00115E  3  A2 0D                LDX     #13             ;
001160  3  20 53 11             JSR     PEM             ;
001163  3  A9 FE                LDA     #<FCB           ; CREATE File
001165  3  A0 16                LDY     #>FCB           ;
001167  3  A2 16                LDX     #22             ;
001169  3  20 53 11             JSR     PEM             ;
00116C  3  A9 00                LDA     #0              ; clear
00116E  3  8D 1E 17             STA     FCB+32          ; record number
001171  3  A9 FE                LDA     #<FCB           ; Open File
001173  3  A0 16                LDY     #>FCB           ;
001175  3  A2 0F                LDX     #15             ;
001177  3  20 53 11             JSR     PEM             ;
00117A  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
00117C  3  D0 0B                BNE     DOS65SAVE_1     ;
00117E  3               DOS65SAVE_ERR:
00117E  3  A2 24                LDX     #$24            ; IO ERROR
001180  3  20 22 19             JSR     LAB_XERR
001183  3  4C FA 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001186  3               DOS65SAVE_ERR1:
001186  3  4C FB 1E             JMP     LAB_REM         ; comment out the remainder of the line (if any)
001189  3               DOS65SAVE_1:
001189  3  A9 83                LDA     #<FCBBUFFER     ; SETUP BUFFER
00118B  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
00118D  3  A0 38                LDY     #>FCBBUFFER     ;
00118F  3  84 21                STY     FCBPTR+1        ;
001191  3  A2 1A                LDX     #26             ; Setup Buffer
001193  3  20 53 11             JSR     PEM             ;
001196  3               DOS65SAVE_2:
001196  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
001198  3  85 22                STA     FCBPTR+2        ; point to base of RAM
00119A  3  A5 7A                LDA     <Smemh          ;
00119C  3  85 23                STA     FCBPTR+3        ;
00119E  3  A2 00                LDX     #$00            ; x=0 (null counter)
0011A0  3               DOS65SAVE_2A:
0011A0  3  A0 00                LDY     #$00            ; y=0 (Loop Index)
0011A2  3               DOS65SAVE_3:
0011A2  3  B1 22                LDA     (FCBPTR+2),Y    ; load from RAM
0011A4  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
0011A6  3  C9 00                CMP     #$00            ; is Zero?
0011A8  3  D0 1E                BNE     DOS65SAVE_3A    ; No, continue
0011AA  3  E8                   INX                     ; yes, bump Null Counter
0011AB  3  E0 03                CPX     #$03            ; Three nulls in a row?
0011AD  3  D0 1B                BNE     DOS65SAVE_3B    ; No, continue
0011AF  3                                               ; FINISH FILLING BUFFER WITH NULLS
0011AF  3               :
0011AF  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
0011B1  3  C8                   INY                     ; bump index
0011B2  3  C0 80                CPY     #$80            ; end of buffer?
0011B4  3  D0 F9                BNE     :-              ; no, loop
0011B6  3  A9 FE                LDA     #<FCB           ; Write record in buffer to disk file AND END
0011B8  3  A0 16                LDY     #>FCB           ;
0011BA  3  A2 15                LDX     #21             ;
0011BC  3  20 53 11             JSR     PEM             ;
0011BF  3  29 FE                AND     #$FE            ; strip out extension
0011C1  3  C9 00                CMP     #$00            ; is error
0011C3  3  D0 B9                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
0011C5  3  4C F5 11             JMP     DOS65SAVE_4
0011C8  3               DOS65SAVE_3A:                   ;
0011C8  3  A2 00                LDX     #$00            ; prior char not null, reset null counter
0011CA  3               DOS65SAVE_3B:                   ;
0011CA  3  C8                   INY                     ; bump index
0011CB  3  C0 80                CPY     #$80            ; end of buffer?
0011CD  3  D0 D3                BNE     DOS65SAVE_3     ; no, loop
0011CF  3               DOS65SAVE_3C:
0011CF  3  A9 FE                LDA     #<FCB           ; Write record in buffer to disk file
0011D1  3  A0 16                LDY     #>FCB           ;
0011D3  3  A2 15                LDX     #21             ;
0011D5  3  20 53 11             JSR     PEM             ;
0011D8  3  29 FE                AND     #$FE            ; strip out extension
0011DA  3  C9 00                CMP     #$00            ; is error
0011DC  3  D0 A0                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
0011DE  3  18                   CLC                     ;
0011DF  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
0011E1  3  69 80                ADC     #$80            ;
0011E3  3  85 22                STA     FCBPTR+2        ;
0011E5  3  90 B9                BCC     DOS65SAVE_2A    ; is carry?, no loop
0011E7  3  18                   CLC                     ; yes, carry, inc high byte
0011E8  3  A5 23                LDA     FCBPTR+3        ;
0011EA  3  69 01                ADC     #$01            ;
0011EC  3  85 23                STA     FCBPTR+3        ;
0011EE  3  C9 B8                CMP     #>Ram_top       ; are we at the end of RAM?
0011F0  3  F0 03                BEQ     DOS65SAVE_4
0011F2  3  4C A0 11             JMP     DOS65SAVE_2A
0011F5  3               DOS65SAVE_4:
0011F5  3  A9 FE                LDA     #<FCB           ;
0011F7  3  A0 16                LDY     #>FCB           ;
0011F9  3  A2 10                LDX     #16             ;
0011FB  3  20 53 11             JSR     PEM             ;
0011FE  3  C9 FF                CMP     #$FF            ;
001200  3  D0 03                BNE     DOS65SAVE_5     ;
001202  3  4C 7E 11             JMP     DOS65SAVE_ERR   ; ERROR, DISPLAY IT
001205  3               DOS65SAVE_5:
001205  3  A9 7E                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
001207  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
001209  3  20 A2 20             JSR     LAB_18C3
00120C  3  4C FA 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
00120F  3               
00120F  3               ;___LOAD____________________________________________________
00120F  3               ;
00120F  3               ; LOAD COMMAND
