0017D1  3  85 12                STA     nums_2          ; Store in TEMP2
0017D3  3  29 F0                AND     #$F0
0017D5  3  4A                   LSR     A               ; (shift 1 times to /2)
0017D6  3  85 11                STA     nums_1          ; Store the /2 into TEMP
0017D8  3  4A                   LSR     A               ;
0017D9  3  4A                   LSR     A               ; Shift two more times to /8
0017DA  3  18                   CLC
0017DB  3  65 11                ADC     nums_1          ; add /8 + /2 to get /10
0017DD  3  85 11                STA     nums_1          ; Store tens digit into TEMP
0017DF  3  A5 12                LDA     nums_2          ; Get Ones
0017E1  3  29 0F                AND     #$0F
0017E3  3  18                   CLC
0017E4  3  65 11                ADC     nums_1
0017E6  3  60                   RTS                     ; Return from subroutine
