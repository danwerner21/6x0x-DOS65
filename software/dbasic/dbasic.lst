0037DE  1  A5 B3                LDA     FAC2_e          ; get exponent
0037E0  1  4A                   LSR     A               ; check odd/even
0037E1  1  B0 0E                BCS     LAB_SQE2        ; if odd only 1 shift first time
0037E3  1               
0037E3  1               LAB_SQE1:
0037E3  1  06 B6                ASL     FAC2_3          ; shift highest bit of number ..
0037E5  1  26 B5                ROL     FAC2_2          ; ..
0037E7  1  26 B4                ROL     FAC2_1          ; ..
0037E9  1  26 77                ROL     FACt_3          ; .. into remainder
0037EB  1  26 76                ROL     FACt_2          ; ..
0037ED  1  26 75                ROL     FACt_1          ; ..
0037EF  1  26 78                ROL     TempB           ; .. never overflows
0037F1  1               LAB_SQE2:
0037F1  1  06 B6                ASL     FAC2_3          ; shift highest bit of number ..
0037F3  1  26 B5                ROL     FAC2_2          ; ..
