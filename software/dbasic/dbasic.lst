001135  3               ;___SAVE____________________________________________________
001135  3               ;
001135  3               ; SAVE COMMAND
001135  3               ;
001135  3               ;  SAVE THE BASIC PROGRAM IN MEMORY TO DISK
001135  3               ;
001135  3               ;__________________________________________________________
001135  3               V_SAVE: ; save BASIC program
001135  3               DOS65SAVE:
001135  3  20 A8 12             JSR     DOS65FCBPREP    ; parse parameters into FCB
001138  3  B0 28                BCS     DOS65SAVE_ERR1  ; Error?, if so abort
00113A  3  A2 0D                LDX     #13             ;
00113C  3  20 2F 11             JSR     PEM             ;
00113F  3  A9 43                LDA     #<FCB           ; CREATE File
001141  3  A0 15                LDY     #>FCB           ;
001143  3  A2 16                LDX     #22             ;
001145  3  20 2F 11             JSR     PEM             ;
001148  3  A9 00                LDA     #0              ; clear
00114A  3  8D 63 15             STA     FCB+32          ; record number
00114D  3  A9 43                LDA     #<FCB           ; Open File
00114F  3  A0 15                LDY     #>FCB           ;
001151  3  A2 0F                LDX     #15             ;
001153  3  20 2F 11             JSR     PEM             ;
001156  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
001158  3  D0 0B                BNE     DOS65SAVE_1     ;
00115A  3               DOS65SAVE_ERR:
00115A  3  A2 24                LDX     #$24            ; IO ERROR
00115C  3  20 67 17             JSR     LAB_XERR
00115F  3  4C 3F 18             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001162  3               DOS65SAVE_ERR1:
001162  3  4C 43 1D             JMP     LAB_REM         ; comment out the remainder of the line (if any)
001165  3               DOS65SAVE_1:
001165  3  A9 CD                LDA     #<FCBBUFFER     ; SETUP BUFFER
001167  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
001169  3  A0 36                LDY     #>FCBBUFFER     ;
00116B  3  84 21                STY     FCBPTR+1        ;
00116D  3  A2 1A                LDX     #26             ; Setup Buffer
00116F  3  20 2F 11             JSR     PEM             ;
001172  3               DOS65SAVE_2:
001172  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
001174  3  85 22                STA     FCBPTR+2        ; point to base of RAM
001176  3  A5 7A                LDA     <Smemh          ;
001178  3  85 23                STA     FCBPTR+3        ;
00117A  3  A2 00                LDX     #$00            ; x=0 (null counter)
00117C  3               DOS65SAVE_2A:
00117C  3  A0 00                LDY     #$00            ; y=0 (Loop Index)
00117E  3               DOS65SAVE_3:
00117E  3  B1 22                LDA     (FCBPTR+2),Y    ; load from RAM
001180  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
001182  3  C9 00                CMP     #$00            ; is Zero?
001184  3  D0 1E                BNE     DOS65SAVE_3A    ; No, continue
001186  3  E8                   INX                     ; yes, bump Null Counter
001187  3  E0 03                CPX     #$03            ; Three nulls in a row?
001189  3  D0 1B                BNE     DOS65SAVE_3B    ; No, continue
00118B  3                                               ; FINISH FILLING BUFFER WITH NULLS
00118B  3               :
00118B  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
00118D  3  C8                   INY                     ; bump index
00118E  3  C0 80                CPY     #$80            ; end of buffer?
001190  3  D0 F9                BNE     :-              ; no, loop
001192  3  A9 43                LDA     #<FCB           ; Write record in buffer to disk file AND END
001194  3  A0 15                LDY     #>FCB           ;
001196  3  A2 15                LDX     #21             ;
001198  3  20 2F 11             JSR     PEM             ;
00119B  3  29 FE                AND     #$FE            ; strip out extension
00119D  3  C9 00                CMP     #$00            ; is error
00119F  3  D0 B9                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
0011A1  3  4C D1 11             JMP     DOS65SAVE_4
0011A4  3               DOS65SAVE_3A:                   ;
0011A4  3  A2 00                LDX     #$00            ; prior char not null, reset null counter
0011A6  3               DOS65SAVE_3B:                   ;
0011A6  3  C8                   INY                     ; bump index
0011A7  3  C0 80                CPY     #$80            ; end of buffer?
0011A9  3  D0 D3                BNE     DOS65SAVE_3     ; no, loop
0011AB  3               DOS65SAVE_3C:
0011AB  3  A9 43                LDA     #<FCB           ; Write record in buffer to disk file
0011AD  3  A0 15                LDY     #>FCB           ;
0011AF  3  A2 15                LDX     #21             ;
0011B1  3  20 2F 11             JSR     PEM             ;
0011B4  3  29 FE                AND     #$FE            ; strip out extension
0011B6  3  C9 00                CMP     #$00            ; is error
0011B8  3  D0 A0                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
0011BA  3  18                   CLC                     ;
0011BB  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
0011BD  3  69 80                ADC     #$80            ;
0011BF  3  85 22                STA     FCBPTR+2        ;
0011C1  3  90 B9                BCC     DOS65SAVE_2A    ; is carry?, no loop
0011C3  3  18                   CLC                     ; yes, carry, inc high byte
0011C4  3  A5 23                LDA     FCBPTR+3        ;
0011C6  3  69 01                ADC     #$01            ;
0011C8  3  85 23                STA     FCBPTR+3        ;
0011CA  3  C9 B8                CMP     #>Ram_top       ; are we at the end of RAM?
0011CC  3  F0 03                BEQ     DOS65SAVE_4
0011CE  3  4C 7C 11             JMP     DOS65SAVE_2A
0011D1  3               DOS65SAVE_4:
0011D1  3  A9 43                LDA     #<FCB           ;
0011D3  3  A0 15                LDY     #>FCB           ;
0011D5  3  A2 10                LDX     #16             ;
0011D7  3  20 2F 11             JSR     PEM             ;
0011DA  3  C9 FF                CMP     #$FF            ;
0011DC  3  D0 03                BNE     DOS65SAVE_5     ;
0011DE  3  4C 5A 11             JMP     DOS65SAVE_ERR   ; ERROR, DISPLAY IT
0011E1  3               DOS65SAVE_5:
0011E1  3  A9 5A                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
0011E3  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
0011E5  3  20 EA 1E             JSR     LAB_18C3
0011E8  3  4C 3F 18             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
