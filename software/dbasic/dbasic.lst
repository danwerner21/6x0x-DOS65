0039A7  1  2A                   ROL     A               ; *2
0039A8  1  85 5E                STA     Temp3+3         ; save partial high byte
0039AA  1               
0039AA  1               ; carry clear for subtract +1
0039AA  1  A5 77                LDA     FACt_3          ; get remainder low byte
0039AC  1  E5 5B                SBC     Temp3           ; subtract partial low byte
0039AE  1  85 5B                STA     Temp3           ; save partial low byte
0039B0  1               
