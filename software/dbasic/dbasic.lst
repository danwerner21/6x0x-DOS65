00143E  3  20 5F 27             JSR     LAB_MSSP        ; make string space A bytes long A=$AC=length,
001441  3                                               ; X=$AD=<Sutill=ptr low byte, Y=$AE=<Sutilh=ptr high byte
001441  3                                               ; COPY FCB TO STRING
001441  3  A2 21                LDX     #33             ;
001443  3  A0 21                LDY     #33             ;
