00119C  3  E9 40                SBC     #64             ; PARSE DRIVE NUMBER
00119E  3  8D 0C 12             STA     DOSDRIVE        ; STORE IT IN FCB
0011A1  3                       .IFDEF  DUODYNE
0011A1  3                       JSL     LAB_IGBY        ; increment and scan memory
0011A1  3                       .ELSE
0011A1  3  20 BC 00             JSR     LAB_IGBY        ; increment and scan memory
0011A4  3                       .ENDIF
0011A4  3               
0011A4  3  C9 3A                CMP     #':'            ;
0011A6  3  F0 0E                BEQ     DOS65FCBPREP_1  ; YES, IT WAS A DRIVE, CONTINUE
0011A8  3  A9 DC                LDA     #<FILEERROR1    ; NO, ERROR OUT
0011AA  3  A0 0E                LDY     #>FILEERROR1
0011AC  3  A2 09                LDX     #9
0011AE  3  20 61 10             JSR     PEM
0011B1  3  20 3A 19             JSR     LAB_REM
0011B4  3  38                   SEC
0011B5  3  60                   RTS
0011B6  3               DOS65FCBPREP_1:
0011B6  3  A9 0C                LDA     #<FCB           ; SETUP FCBPTR
0011B8  3  85 20                STA     FCBPTR          ;
0011BA  3  A9 12                LDA     #>FCB           ;
0011BC  3  85 21                STA     FCBPTR+1        ;
0011BE  3  A0 01                LDY     #$01            ; POINT Y TO FCB FILE NAME
0011C0  3  A9 20                LDA     #$20            ; LOAD SPACE CHAR INTO A
0011C2  3               DOS65FCBPREP_1A:                ; BLANK OUT FCB
0011C2  3  91 20                STAINDIRECTY FCBPTR     ;
0011C4  3  C8                   INY                     ;
0011C5  3  C0 09                CPY     #$09            ; IS DONE
0011C7  3  D0 F9                BNE     DOS65FCBPREP_1A ; NO, LOOP
0011C9  3  A0 01                LDY     #$01            ; POINT Y TO FCB FILE NAME
0011CB  3               DOS65FCBPREP_2:                 ; COPY FILE NAME PARAMETER INTO FCB
0011CB  3                       .IFDEF  DUODYNE
0011CB  3                       JSL     LAB_IGBY        ; increment and scan memory
0011CB  3                       .ELSE
0011CB  3  20 BC 00             JSR     LAB_IGBY        ; increment and scan memory
0011CE  3                       .ENDIF
0011CE  3  F0 0E                BEQ     DOS65FCBPREP_3  ;
0011D0  3  C9 2E                CMP     #'.'
0011D2  3  F0 0A                BEQ     DOS65FCBPREP_3  ;
0011D4  3  91 20                STAINDIRECTY FCBPTR     ;
0011D6  3  C8                   INY                     ;
0011D7  3  C0 09                CPY     #$09            ;
0011D9  3  F0 03                BEQ     DOS65FCBPREP_3  ;
0011DB  3  4C CB 11             JMP     DOS65FCBPREP_2  ;
0011DE  3               DOS65FCBPREP_3:                 ;
0011DE  3  18                   CLC
0011DF  3  60                   RTS                     ;
0011E0  3               
0011E0  3               ;SUBROUTINES
0011E0  3               ;OPEN FILE
0011E0  3               OPNFIL:
0011E0  3  A2 0F                LDX     #15
0011E2  3  4C 61 10             JMP     PEM
0011E5  3               ;CLOSE FILE
0011E5  3               CLSFIL:
0011E5  3  A2 10                LDX     #16
0011E7  3  4C 61 10             JMP     PEM
0011EA  3               ;DELETE FILE
0011EA  3               DLTFIL:
0011EA  3  A2 13                LDX     #19
0011EC  3  4C 61 10             JMP     PEM
0011EF  3               ;READ RECORD
0011EF  3               RDERCR:
0011EF  3  A2 14                LDX     #20
0011F1  3  4C 61 10             JMP     PEM
0011F4  3               ;WRITE RECORD
0011F4  3               WRTRCR:
0011F4  3  A2 15                LDX     #21
0011F6  3  4C 61 10             JMP     PEM
0011F9  3               ;CREATE FILE
0011F9  3               CRTFIL:
0011F9  3  A2 16                LDX     #22
0011FB  3  4C 61 10             JMP     PEM
0011FE  3               ;RENAME FILE
0011FE  3               RNMFIL:
0011FE  3  A2 17                LDX     #23
001200  3  4C 61 10             JMP     PEM
001203  3               ;SET BUFFER
001203  3               SETBUF:
001203  3  A2 1A                LDX     #26
001205  3  4C 61 10             JMP     PEM
001208  3               
001208  3               
001208  3               VDOS65SAVE:
001208  3  67 10                .WORD   DOS65SAVE
00120A  3               VDOS65LOAD:
00120A  3  17 11                .WORD   DOS65LOAD
00120C  3               
00120C  3               FCB:
00120C  3               DOSDRIVE:
00120C  3  00                   .BYTE   0               ; DRIVE NUMBER
00120D  3               DOSFN:
00120D  3  20 20 20 20          .BYTE   "        "      ; FILE NAME
001211  3  20 20 20 20  
001215  3               DOSEX:
001215  3  42 41 53             .BYTE   "BAS"           ; EXTENSION
001218  3               DOSET:
001218  3  00 00 00             .BYTE   0,0,0           ; EXTENT
00121B  3               DOSNR:
00121B  3  00                   .BYTE   0               ; NUMBER OF RECORDS IN FILE
00121C  3               DOSBL:
00121C  3  00 00 00 00          .BYTE   0,0,0,0,0,0,0,0 ; BLOCKS IN FILE
001220  3  00 00 00 00  
001224  3  00 00 00 00          .BYTE   0,0,0,0,0,0,0,0 ;
001228  3  00 00 00 00  
00122C  3               DOSNX:
00122C  3  00                   .BYTE   0               ; NEXT RECORD
00122D  3               
00122D  2                       .INCLUDE "screencmds.asm"
00122D  3               
00122D  3               
00122D  3                       .IFDEF  MEMORYMAPPEDSCREEN
00122D  3               
00122D  3               ;* MEMORY MAP
00122D  3               ;  VIDEO CARD IS A 32K AREA
00122D  3               ;  $0x00 0x01=soft_scanline_emulation, 0x02 NO soft_scanline_emulation
00122D  3               ;  $0x01 0x01=page1, 0x02 page2
00122D  3               ;  $0x02  character generator write offset (data << 3)
00122D  3               ;  $0x03 character generator write DATA
00122D  3               ;  $0x04 EXECUTE device command
00122D  3               ;        0x00- reset to the default configuration
00122D  3               ;        0x01- reset to the saved configuration
00122D  3               ;	0x02- save the current configuration
00122D  3               ;
00122D  3               ;  $0x05  0x01=soft_text=true, 0x02=soft_text=false
00122D  3               ;  $0x06 Lores Mode=0X01,NO lores Mode=0x02
00122D  3               ;  $0x07 Double Lores Mode=0X01,NO Double lores Mode=0x02
00122D  3               ;  $0x08 Hires Mode=0X01,NO Hires Mode=0x02
00122D  3               ;  $0x09 Double Hires Mode=0X01,NO Double Hires lores Mode=0x02
00122D  3               ;  $0x0A 80COL Mode=0X01,NO 80COL Mode=0x02
00122D  3               ;  $0x0B MIXED Mode=0X01,NO MIXED Mode=0x02
00122D  3               ;  $0x0C QUAD Hires Mode=0X01,NO QUAD Hires lores Mode=0x02
00122D  3               ;  $0x0D MONO Hires Mode=0X01,NO MONO Hires lores Mode=0x02
00122D  3               ;
00122D  3               ; 	VRAM Memory Map
00122D  3               ;	$1000-$177F	40/80 Text Page 1
00122D  3               ;	$1800-$1F7F	40/80 Color Page 1
00122D  3               ;	$2000-$277F	40/80 Text Page 2
00122D  3               ;	$2800-$2F7F	40/80 Color Page 2
00122D  3               ;	$2000-$5FFF	HIRES PAGE 1
00122D  3               ;	$6000-$8FFF	HIRES PAGE 2
00122D  3               ;	$2000-$BFFF	DOUBLE HIRES
00122D  3               
00122D  3               VIDEOBANK       = $F8
00122D  3               PC6502_IOSPACE  = $EF00
00122D  3               ; PAGER
00122D  3               PC6502_ACT_TASK = PC6502_IOSPACE+$E0
00122D  3               PC6502_MAP_SETUP = PC6502_IOSPACE+$E1
00122D  3               PC6502_MMU_ENA  = PC6502_IOSPACE+$E2
00122D  3               PC6502_MAP_SPACE = PC6502_IOSPACE+$D0
00122D  3               
00122D  3               VideoDisplayPage = $B001
00122D  3               VideoCharGenOffset = $B002
00122D  3               VideoCharGenData = $B003
00122D  3               VideoTextMode   = $B005
00122D  3               VideoLoresMode  = $B006
00122D  3               VideoDoubleLores = $B007
00122D  3               VideoHiresMode  = $B008
00122D  3               VideoDoubleHires = $B009
00122D  3               Video80col      = $B00A
00122D  3               VideoMixedMode  = $B00b
00122D  3               VideoQuadHires  = $B00c
00122D  3               VideoMonoHires  = $B00d
00122D  3               
00122D  3               
00122D  3               VIDEOMODE:
00122D  3                       .BYTE   $00
00122D  3               CLRTMP:
00122D  3                       .BYTE   $00
00122D  3               VIDEOWIDTH:
00122D  3                       .BYTE   $00
00122D  3               
00122D  3               PTEMPW:
00122D  3                       .BYTE   $00,$00
00122D  3               PTEMPW1:
00122D  3                       .BYTE   $00,$00
00122D  3               PTEMPW2:
00122D  3                       .BYTE   $00,$00
00122D  3               PTEMPW3:
00122D  3                       .BYTE   $00,$00
00122D  3               PTEMP:
00122D  3                       .BYTE   $00
00122D  3               
00122D  3               ;___V_SPEEK()______________________________________________
00122D  3               ;
00122D  3               ; GET VALUE FROM SCREEN MEMORY
00122D  3               ;
00122D  3               ;  TAKES ONE PARAMETER (ADDRESS), RETURNS VALUE
00122D  3               ;
00122D  3               ;__________________________________________________________
00122D  3               LAB_SPEEK:
00122D  3               V_SPEEK:
00122D  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
00122D  3                       LDA     Itemph
00122D  3                       JSR     PRINT_BYTE
00122D  3                       TAY
00122D  3                       AND     #$0F
00122D  3                       ORA     #$B0
00122D  3                       STA     Itemph
00122D  3                       JSR     PRINT_BYTE
00122D  3                       TYA
00122D  3                       AND     #$F0
00122D  3                       LSR     A
00122D  3                       LSR     A
00122D  3                       LSR     A
00122D  3                       LSR     A
00122D  3                       AND     #$07
00122D  3                       CLC
00122D  3                       ADC     #VIDEOBANK
00122D  3                       TAY
00122D  3                       JSR     PRINT_BYTE
00122D  3                       LDA     #$01            ; MODIFY TASK 01 (DRIVER TASK)
00122D  3                       LDX     #$0B            ; MAP $BXXX
00122D  3                       JSR     $FFF6           ; CALL SETPAGE
00122D  3                       LDA     #$01
00122D  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 01
00122D  3                       LDY     #0
00122D  3                       LDA     (Itempl),Y
00122D  3                       JSR     PRINT_BYTE
00122D  3                       TAY
00122D  3                       LDA     #$00
00122D  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 00
00122D  3                       JMP     LAB_1FD0        ; convert Y to byte in FAC1 and return
00122D  3               
00122D  3               
00122D  3               
00122D  3               ;___V_SPOKE_________________________________________________
00122D  3               ;
00122D  3               ; PUT VALUE IN SCREEN MEMORY
00122D  3               ;
00122D  3               ;  TAKES TWO PARAMETERS ADDRESS,VALUE
00122D  3               ;
00122D  3               ;__________________________________________________________
00122D  3               LAB_SPOKE:
00122D  3               V_SPOKE:
00122D  3                       JSR     LAB_GADB        ; get two parameters for POKE or WAIT
00122D  3                       TXA                     ; BYTE ARGUMENT IS IN X
00122D  3                       PHA                     ; PUSH BYTE ARGUMENT TO STACK
00122D  3                       LDA     Itemph
00122D  3                       TAY
00122D  3                       AND     #$0F
00122D  3                       ORA     #$B0
00122D  3                       STA     Itemph
00122D  3                       TYA
00122D  3                       AND     #$F0
00122D  3                       LSR     A
00122D  3                       LSR     A
00122D  3                       LSR     A
00122D  3                       LSR     A
00122D  3                       AND     #$07
00122D  3                       CLC
00122D  3                       ADC     #VIDEOBANK
00122D  3                       TAY
00122D  3               
00122D  3                       LDY     #0
00122D  3                       PLA                     ; PULL BYTE ARGUMENT
00122D  3                       STA     (Itempl),Y
00122D  3                       LDA     #$00
00122D  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 00
00122D  3                       RTS
00122D  3               
00122D  3               ;___V_SCREEN_________________________________________________
00122D  3               ;
00122D  3               ;  SET SCREEN MODE
00122D  3               ;
00122D  3               ;  TAKES UP TO THREE PARAMETERS
00122D  3               ;  FIRST PARAMETER SCREEN MODE
00122D  3               ;  0=TEXT MODE
00122D  3               ;  1=LORES MODE
00122D  3               ;  2=HIRES MODE
00122D  3               ;
00122D  3               ;  TEXT MODE PARAMETERS
00122D  3               ;  0=40 COLUMNS
00122D  3               ;  1=80 COLUMNS
00122D  3               ;
00122D  3               ;  LORES MODE SECOND PARAMETER
00122D  3               ;  0=SINGLE LORES
00122D  3               ;  1=DOUBLE LORES
00122D  3               ;  LORES MODE THIRD PARAMETER
00122D  3               ;  0=MIXED MODE
00122D  3               ;  1=FULL SCREEN MODE
00122D  3               ;
00122D  3               ;  HIRES MODE SECOND PARAMETER
00122D  3               ;  0=SINGLE HIRES
00122D  3               ;  1=DOUBLE HIRES
00122D  3               ;  2=QUAD HIRES
00122D  3               ;  3=MONO HIRES
00122D  3               ;  HIRES MODE THIRD PARAMETER
00122D  3               ;  1=MIXED MODE
00122D  3               ;  0=FULL SCREEN MODE
00122D  3               ;
00122D  3               ;__________________________________________________________
00122D  3               LAB_SCREEN:
00122D  3               V_SCREEN:
00122D  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (MODE)
00122D  3               V_SCREEN1:
00122D  3                       STX     VIDEOMODE
00122D  3                       CPX     #00
00122D  3                       BNE     *+5
00122D  3                       JMP     SETUPMODE0
00122D  3                       CPX     #01
00122D  3                       BNE     *+5
00122D  3                       JMP     SETUPMODE1
00122D  3                       CPX     #02
00122D  3                       BNE     *+5
00122D  3                       JMP     SETUPMODE2
00122D  3               
00122D  3                       LDX     #$02            ; SYNTAX ERROR
00122D  3                       JSR     LAB_XERR
00122D  3                       JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
00122D  3                       RTS
00122D  3               
00122D  3               SETUPMODE0:                     ; TEXT MODE
00122D  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00122D  3                       JSR     PAGE_ENTER
00122D  3                       LDA     #$01
00122D  3                       STA     VideoTextMode
00122D  3                       LDA     #$02
00122D  3                       STA     VideoLoresMode
00122D  3                       STA     VideoHiresMode
00122D  3                       JSR     PAGE_EXIT
00122D  3               
00122D  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
00122D  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
00122D  3                       CPX     #$00
00122D  3                       BNE     SETUPMODE0_80
00122D  3               
00122D  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00122D  3                       JSR     PAGE_ENTER
00122D  3                       LDA     #$02
00122D  3                       STA     Video80col
00122D  3                       JSR     PAGE_EXIT
00122D  3                       LDA     #40
00122D  3                       STA     VIDEOWIDTH
00122D  3                       JMP     SETUPMODE0_CLEAR
00122D  3               SETUPMODE0_80:
00122D  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00122D  3                       JSR     PAGE_ENTER
00122D  3                       LDA     #$01
00122D  3                       STA     Video80col
00122D  3                       JSR     PAGE_EXIT
00122D  3                       LDA     #80
00122D  3                       STA     VIDEOWIDTH
00122D  3               SETUPMODE0_CLEAR:
00122D  3                       JMP     V_SCNCLR
00122D  3                       RTS
00122D  3               
00122D  3               SETUPMODE1:                     ; LORES MODE
00122D  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00122D  3                       JSR     PAGE_ENTER
00122D  3                       LDA     #$01
00122D  3                       STA     VideoLoresMode
00122D  3                       LDA     #$02
00122D  3                       STA     VideoTextMode
00122D  3                       STA     VideoHiresMode
00122D  3                       JSR     PAGE_EXIT
00122D  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
00122D  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
00122D  3               
00122D  3                       CPX     #$00
00122D  3                       BNE     SETUPMODE1_DOUBLE
00122D  3               
00122D  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00122D  3                       JSR     PAGE_ENTER
00122D  3                       LDA     #$02
00122D  3                       STA     VideoDoubleLores
00122D  3                       JSR     PAGE_EXIT
00122D  3                       JMP     SETUPMODE1_CLEAR
00122D  3               SETUPMODE1_DOUBLE:
00122D  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00122D  3                       JSR     PAGE_ENTER
00122D  3                       LDA     #$01
00122D  3                       STA     VideoDoubleLores
00122D  3                       JSR     PAGE_EXIT
00122D  3                       LDA     #$11
00122D  3                       STA     VIDEOMODE
00122D  3               SETUPMODE1_CLEAR:               ;    ($2000-$2800)
00122D  3                       LDY     #$02+VIDEOBANK  ; AREA $2000-$2FFF
00122D  3                       JSR     PAGE_ENTER
00122D  3                       LDA     #$00
00122D  3                       STA     TEMPW
00122D  3                       LDA     #$B0
00122D  3                       STA     TEMPW+1
00122D  3                       LDY     #$00
00122D  3                       LDA     #$00
00122D  3               :
00122D  3                       STA     (TEMPW),Y
00122D  3                       INC     TEMPW
00122D  3                       BNE     :-
00122D  3                       INC     TEMPW+1
00122D  3               
00122D  3                       LDX     TEMPW+1
00122D  3                       CPX     #$B8
00122D  3                       BNE     :-
00122D  3                       JSR     PAGE_EXIT
00122D  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
00122D  3                       JSR     LAB_GTBY        ; GET THE THIRD PARAMETER, RETURN IN X
00122D  3                       CPX     #$00
00122D  3                       BNE     SETUPMODE1_MIXED
00122D  3               
00122D  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00122D  3                       JSR     PAGE_ENTER
00122D  3                       LDA     #$02
00122D  3                       STA     VideoMixedMode
00122D  3                       JSR     PAGE_EXIT
00122D  3                       RTS
00122D  3               SETUPMODE1_MIXED:
00122D  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00122D  3                       JSR     PAGE_ENTER
00122D  3                       LDA     #$01
00122D  3                       STA     VideoMixedMode
00122D  3                       JSR     PAGE_EXIT
00122D  3                       LDA     VIDEOMODE
00122D  3                       ORA     #$80
00122D  3                       STA     VIDEOMODE
00122D  3                       RTS
00122D  3               
00122D  3               
00122D  3               SETUPMODE2:                     ; HIRES MODE
00122D  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00122D  3                       JSR     PAGE_ENTER
00122D  3                       LDA     #$01
00122D  3                       STA     VideoHiresMode
00122D  3                       LDA     #$02
00122D  3                       STA     VideoTextMode
00122D  3                       STA     VideoLoresMode
00122D  3                       JSR     PAGE_EXIT
00122D  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
00122D  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
00122D  3               
00122D  3                       CPX     #$00
00122D  3                       BNE     SETUPMODE2_DOUBLE
00122D  3               
00122D  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00122D  3                       JSR     PAGE_ENTER
00122D  3                       LDA     #$02
00122D  3                       STA     VideoDoubleHires
00122D  3                       STA     VideoQuadHires
00122D  3                       STA     VideoMonoHires
00122D  3                       JSR     PAGE_EXIT
00122D  3                       JMP     SETUPMODE2_CLEAR
00122D  3               SETUPMODE2_DOUBLE:
00122D  3                       CPX     #$01
00122D  3                       BNE     SETUPMODE2_QUAD
00122D  3               
00122D  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00122D  3                       JSR     PAGE_ENTER
00122D  3                       LDA     #$01
00122D  3                       STA     VideoDoubleHires
00122D  3                       LDA     #$02
00122D  3                       STA     VideoQuadHires
00122D  3                       STA     VideoMonoHires
00122D  3                       JSR     PAGE_EXIT
00122D  3                       LDA     #$12
00122D  3                       STA     VIDEOMODE
00122D  3                       JMP     SETUPMODE2_CLEAR
00122D  3               SETUPMODE2_QUAD:
00122D  3                       CPX     #$02
00122D  3                       BNE     SETUPMODE2_MONO
00122D  3               
00122D  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00122D  3                       JSR     PAGE_ENTER
00122D  3                       LDA     #$01
00122D  3                       STA     VideoQuadHires
00122D  3                       LDA     #$02
00122D  3                       STA     VideoDoubleHires
00122D  3                       STA     VideoMonoHires
00122D  3                       JSR     PAGE_EXIT
00122D  3                       LDA     #$22
00122D  3                       STA     VIDEOMODE
00122D  3                       JMP     SETUPMODE2_CLEAR
00122D  3               SETUPMODE2_MONO:
00122D  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00122D  3                       JSR     PAGE_ENTER
00122D  3                       LDA     #$01
00122D  3                       STA     VideoMonoHires
00122D  3                       LDA     #$02
00122D  3                       STA     VideoDoubleHires
00122D  3                       STA     VideoQuadHires
00122D  3                       JSR     PAGE_EXIT
00122D  3                       LDA     #$32
00122D  3                       STA     VIDEOMODE
00122D  3               
00122D  3               SETUPMODE2_CLEAR:               ; ($2000-$7FFF)
00122D  3                       LDY     #$02+VIDEOBANK
00122D  3                       STY     CLRTMP
00122D  3               
00122D  3               :
00122D  3                       LDY     CLRTMP
00122D  3                       JSR     PAGE_ENTER
00122D  3               
00122D  3                       LDA     #$00
00122D  3                       TAY
00122D  3                       STA     TEMPW
00122D  3                       LDA     #$B0
00122D  3                       STA     TEMPW+1
00122D  3                       LDA     #$00
00122D  3               :
00122D  3                       STA     (TEMPW),Y
00122D  3                       INC     TEMPW
00122D  3                       BNE     :-
00122D  3                       INC     TEMPW+1
00122D  3                       LDX     TEMPW+1
00122D  3                       CPX     #$C0
00122D  3                       BNE     :-
00122D  3                       LDX     #$B0
00122D  3                       INC     CLRTMP
00122D  3                       LDX     CLRTMP
00122D  3                       CPX     #$00
00122D  3                       BNE     :--
00122D  3                       JSR     PAGE_EXIT
00122D  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
00122D  3                       JSR     LAB_GTBY        ; GET THE THIRD PARAMETER, RETURN IN X
00122D  3                       CPX     #$00
00122D  3                       BNE     SETUPMODE2_MIXED
00122D  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00122D  3                       JSR     PAGE_ENTER
00122D  3                       LDA     #$02
00122D  3                       STA     VideoMixedMode
00122D  3                       JSR     PAGE_EXIT
00122D  3                       RTS
00122D  3               SETUPMODE2_MIXED:
00122D  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00122D  3                       JSR     PAGE_ENTER
00122D  3                       LDA     #$01
00122D  3                       STA     VideoMixedMode
00122D  3                       JSR     PAGE_EXIT
00122D  3                       LDA     VIDEOMODE
00122D  3                       ORA     #$80
00122D  3                       STA     VIDEOMODE
00122D  3                       RTS
00122D  3               
00122D  3               LAB_SCRCLR:
00122D  3               V_SCNCLR:
00122D  3                       RTS
00122D  3               
00122D  3               PAGE_EXIT:
00122D  3                       LDA     #$00
00122D  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 00
00122D  3                       RTS
00122D  3               
00122D  3               PAGE_ENTER:
00122D  3               ; Set "Y" register to video page ($YXXX)
00122D  3                       LDA     #$01            ; MODIFY TASK 01 (DRIVER TASK)
00122D  3                       LDX     #$0B            ; MAP $BXXX
00122D  3                       JSR     $FFF6           ; CALL SETPAGE
00122D  3                       LDA     #$01
00122D  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 01
00122D  3                       RTS
00122D  3               
00122D  3               ;___V_PLOT__________________________________________________
00122D  3               ;
00122D  3               ;  PLOT ON SCREEN
00122D  3               ;         TAKES THREE PARAMETERS,  X,Y,COLOR
00122D  3               ;
00122D  3               ;__________________________________________________________
00122D  3               LAB_PLOT:
00122D  3               V_PLOT:
00122D  3                       LDA     VIDEOMODE
00122D  3                       AND     #$0F
00122D  3                       CMP     #$01
00122D  3                       BEQ     V_PLOT_LORES
00122D  3                       LDA     VIDEOMODE
00122D  3                       AND     #$2F
00122D  3                       CMP     #$02
00122D  3                       BNE     :+
00122D  3                       JMP    V_PLOT_HIRES_COLOR
00122D  3               :
00122D  3                       CMP     #$22
00122D  3                       BNE     :+
00122D  3                       JMP     V_PLOT_HIRES_MONO
00122D  3               :
00122D  3                       RTS
00122D  3               
00122D  3               V_PLOT_LORES:
00122D  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X
00122D  3                       STX     PTEMPW          ; STORE X COORD IN OFFSET ADDRESS
00122D  3                       LDA     #00
00122D  3                       STA     PTEMPW+1
00122D  3                       STA     PTEMPW1+1
00122D  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
00122D  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
00122D  3                                               ; FIGURE THE BUFFER OFFSET
00122D  3                       TXA                     ; Y COORD IN X
00122D  3                       PHA
00122D  3                       LSR     A               ; 2 LINES PER BYTE
00122D  3                       STA     PTEMPW1
00122D  3                                               ; MULTIPLY Y (PTEMPW) COORD BY 40 OR 80 (SINGLE OR DOUBLE LORES)
00122D  3                       CLC
00122D  3                       ASL     PTEMPW1
00122D  3                       ROL     PTEMPW1+1       ; *2
00122D  3                       ASL     PTEMPW1
00122D  3                       ROL     PTEMPW1+1       ; *2 (*4)
00122D  3                       ASL     PTEMPW1
00122D  3                       ROL     PTEMPW1+1       ; *2 (*8)
00122D  3                       LDA     PTEMPW1
00122D  3                       STA     PTEMPW2
00122D  3                       LDA     PTEMPW1+1
00122D  3                       STA     PTEMPW2+1       ; STORE Y*8 INTO PTEMPW2
00122D  3                       ASL     PTEMPW1
00122D  3                       ROL     PTEMPW1+1       ; *2 (*16)
00122D  3                       ASL     PTEMPW1
00122D  3                       ROL     PTEMPW1+1       ; *2 (*32)
00122D  3                                               ; NOW TAKE Y*8(PTEMPW2) + Y*32(PTEMPW1) == Y*40 STORE IN PTEMPW1
00122D  3                       CLC                     ; Clear the Carry flag before the first addition
00122D  3               
00122D  3                       LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
00122D  3                       ADC     PTEMPW2         ; Add the low byte of the second number (plus carry)
00122D  3                       STA     PTEMPW1         ; Store the low byte of the result
00122D  3               
00122D  3                       LDA     PTEMPW1+1       ; Load the high byte of the first number
00122D  3                       ADC     PTEMPW2+1       ; Add the high byte of the second number (plus carry from previous op)
00122D  3                       STA     PTEMPW1+1       ; Store the high byte of the result
00122D  3               
00122D  3               ; if double lores columns double it.
00122D  3                       LDA     VIDEOMODE
00122D  3                       AND     #$10
00122D  3                       CMP     #00
00122D  3                       BEQ     :+
00122D  3                       ASL     PTEMPW1
00122D  3                       ROL     PTEMPW1+1       ; *2
00122D  3               :
00122D  3                                               ; OK, Y OFFSET IS IN PTEMPW1, X IS IN PTEMPW
00122D  3                       LDA     #$B0            ; ADD THE MEMORY OFFSET TO PTEMPW (BECAUSE IT IS EASY)
00122D  3                       STA     PTEMPW+1        ; THEN ADD PTEMPW1 TO PTEMPW THAT SHOULD BE THE MEMORY ADDRESS TO UPDATE
00122D  3                                               ;
00122D  3                       CLC                     ; Clear the Carry flag before the first addition
00122D  3                       LDA     PTEMPW          ; Load the low byte of the first number into the accumulator
00122D  3                       ADC     PTEMPW1         ; Add the low byte of the second number (plus carry)
00122D  3                       STA     TEMPW           ; Store the low byte of the result
00122D  3               
00122D  3                       LDA     PTEMPW+1        ; Load the high byte of the first number
00122D  3                       ADC     PTEMPW1+1       ; Add the high byte of the second number (plus carry from previous op)
00122D  3                       STA     TEMPW+1         ; Store the high byte of the result
00122D  3                                               ; PTEMPW IS THE MEMORY OFFSET TO UPDATE
00122D  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
00122D  3                       JSR     LAB_GTBY        ; GET THE THIRD PARAMETER, RETURN IN X (PATTERN)
00122D  3                       TXA
00122D  3                       AND     #$0F
00122D  3                       STA     PTEMP           ; SAVE COLOR IN PTEMP
00122D  3                       PLA
00122D  3                       LSR     A               ; TOP OR BOTTOM PIXEL?
00122D  3                       BCC     :+
00122D  3                                               ; TOP PIXEL
00122D  3                       LDY     #$02+VIDEOBANK  ; AREA $2000-$2FFF
00122D  3                       JSR     PAGE_ENTER
00122D  3                       LDY     #$00
00122D  3                       LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
00122D  3                       AND     #$0F
00122D  3                       PHA
00122D  3                       LDA     PTEMP
00122D  3                       ASL     A
00122D  3                       ASL     A
00122D  3                       ASL     A
00122D  3                       ASL     A
00122D  3                       STA     PTEMP
00122D  3                       PLA
00122D  3                       ORA     PTEMP
00122D  3                       STA     (TEMPW),Y       ; STORE  DOUBLE PIXEL
00122D  3                       JSR     PAGE_EXIT
00122D  3                       RTS
00122D  3               :
00122D  3                                               ; BOTTOM PIXEL
00122D  3                       LDY     #$02+VIDEOBANK  ; AREA $2000-$2FFF
00122D  3                       JSR     PAGE_ENTER
00122D  3                       LDY     #$00
00122D  3                       LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
00122D  3                       AND     #$F0
00122D  3                       ORA     PTEMP
00122D  3                       STA     (TEMPW),Y       ; STORE  DOUBLE PIXEL
00122D  3                       JSR     PAGE_EXIT
00122D  3                       RTS
00122D  3               
00122D  3               V_PLOT_HIRES_COLOR:
00122D  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X
00122D  3                       TXA
00122D  3                       PHA
00122D  3                       LSR     A               ; 2 PIXEL PER BYTE
00122D  3                       STA     PTEMPW          ; STORE X COORD IN OFFSET ADDRESS
00122D  3                       LDA     #$00
00122D  3                       STA     PTEMPW+1
00122D  3                       STA     PTEMPW1+1
00122D  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
00122D  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
00122D  3                                               ; FIGURE THE BUFFER OFFSET
00122D  3                       LDA     #$00
00122D  3               
00122D  3                       TXA                     ; GET Y COORD
00122D  3                       STX     PTEMPW1
00122D  3                       CLC                     ; MULTIPLY Y COORD BY 70 OR 140 (SINGLE OR DOUBLE HIRES)
00122D  3                       ASL     PTEMPW1
00122D  3                       ROL     PTEMPW1+1       ; *2
00122D  3                       LDA     PTEMPW1
00122D  3                       STA     PTEMPW2
00122D  3                       LDA     PTEMPW1+1
00122D  3                       STA     PTEMPW2+1       ; STORE Y*2 INTO PTEMPW2
00122D  3                       ASL     PTEMPW1
00122D  3                       ROL     PTEMPW1+1       ; *2 (*4)
00122D  3                       LDA     PTEMPW1
00122D  3                       STA     PTEMPW3
00122D  3                       LDA     PTEMPW1+1
00122D  3                       STA     PTEMPW3+1       ; STORE Y*4 INTO PTEMPW3
00122D  3                       ASL     PTEMPW1
00122D  3                       ROL     PTEMPW1+1       ; *2 (*8)
00122D  3                       ASL     PTEMPW1
00122D  3                       ROL     PTEMPW1+1       ; *2 (*16)
00122D  3                       ASL     PTEMPW1
00122D  3                       ROL     PTEMPW1+1       ; *2 (*32)
00122D  3                       ASL     PTEMPW1
00122D  3                       ROL     PTEMPW1+1       ; *2 (*64)
00122D  3                                               ; RESULT OFFSET PTEMPW1 = PTEMPW1(Y*64)+PTEMPW2(Y*2)+PTEMPW3(Y*4)
00122D  3                       CLC                     ; Clear the Carry flag before the first addition
00122D  3                       LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
00122D  3                       ADC     PTEMPW2         ; Add the low byte of the second number (plus carry)
00122D  3                       STA     PTEMPW1         ; Store the low byte of the result
00122D  3               
00122D  3                       LDA     PTEMPW1+1       ; Load the high byte of the first number
00122D  3                       ADC     PTEMPW2+1       ; Add the high byte of the second number (plus carry from previous op)
00122D  3                       STA     PTEMPW1+1       ; Store the high byte of the result
00122D  3                       CLC                     ; Clear the Carry flag before the first addition
00122D  3                       LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
00122D  3                       ADC     PTEMPW3         ; Add the low byte of the second number (plus carry)
00122D  3                       STA     PTEMPW1         ; Store the low byte of the result
00122D  3               
00122D  3                       LDA     PTEMPW1+1       ; Load the high byte of the first number
00122D  3                       ADC     PTEMPW3+1       ; Add the high byte of the second number (plus carry from previous op)
00122D  3                       STA     PTEMPW1+1       ; Store the high byte of the result
00122D  3               
00122D  3               ; if double hires double it.
00122D  3                       LDA     VIDEOMODE
00122D  3                       AND     #$10
00122D  3                       CMP     #00
00122D  3                       BEQ     :+
00122D  3                       ASL     PTEMPW1
00122D  3                       ROL     PTEMPW1+1       ; *2 (*4)
00122D  3               :
00122D  3                                               ; PTEMPW1 IS NOW Y OFFSET, ADD X OFFSET FOR MEMORY ADDRESS INTO TEMPW
00122D  3                       CLC                     ; Clear the Carry flag before the first addition
00122D  3                       LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
00122D  3                       ADC     PTEMPW          ; Add the low byte of the second number (plus carry)
00122D  3                       STA     TEMPW           ; Store the low byte of the result
00122D  3               
00122D  3                       LDA     PTEMPW1+1        ; Load the high byte of the first number
00122D  3                       ADC     PTEMPW+1        ; Add the high byte of the second number (plus carry from previous op)
00122D  3                       STA     TEMPW+1         ; Store the high byte of the result
00122D  3               
00122D  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
00122D  3                       JSR     LAB_GTBY        ; GET THE THIRD PARAMETER, RETURN IN X (PATTERN)
00122D  3                       TXA
00122D  3                       AND     #$0F
00122D  3                       STA     PTEMP          ; SAVE COLOR IN TEMP
00122D  3                       LDA     TEMPW           ; OK, LET'S CALCULATE THE BANK
00122D  3                       AND     #$F0
00122D  3                       LSR     A
00122D  3                       LSR     A
00122D  3                       LSR     A
00122D  3                       LSR     A
00122D  3                       CLC
00122D  3                       ADC     #$02+VIDEOBANK  ; AREA $2000-?
00122D  3                       TAY                     ; VIDEO BANK SHOULD BE IN Y
00122D  3                       JSR     PAGE_ENTER
00122D  3                       LDA     TEMPW+1
00122D  3                       AND     #$0F
00122D  3                       ORA     #$B0
00122D  3                       STA     TEMPW+1         ; TEMPW NOW REFLECTS MAPPED ADDRESSS
00122D  3                       PLA
00122D  3                       LSR     A               ; LEFT OR RIGHT PIXEL?
00122D  3                       BCC     :+
00122D  3                                               ; LEFT PIXEL
00122D  3                       LDY     #$00
00122D  3                       LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
00122D  3                       AND     #$0F
00122D  3                       PHA
00122D  3                       LDA     PTEMP
00122D  3                       ASL     A
00122D  3                       ASL     A
00122D  3                       ASL     A
00122D  3                       ASL     A
00122D  3                       STA     PTEMP
00122D  3                       PLA
00122D  3                       ORA     PTEMP
00122D  3                       STA     (TEMPW),Y       ; WRITE THE PIXEL BACK OUT
00122D  3                       JSR     PAGE_EXIT
00122D  3                       RTS
00122D  3               :
00122D  3               ; RIGHT PIXEL
00122D  3                       LDY     #$00
00122D  3                       LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
00122D  3                       AND     #$F0
00122D  3                       ORA     PTEMP
00122D  3                       STA     (TEMPW),Y       ; WRITE THE PIXEL BACK OUT
00122D  3                       JSR     PAGE_EXIT
00122D  3                       RTS
00122D  3               
00122D  3               V_PLOT_HIRES_MONO:
00122D  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X
00122D  3                       TXA
00122D  3                       PHA
00122D  3                       LSR     A               ; 8 PIXEL PER BYTE
00122D  3                       LSR     A
00122D  3                       LSR     A
00122D  3               
00122D  3                       STA     PTEMPW         ; STORE X COORD IN OFFSET ADDRESS
00122D  3                       LDA     #00
00122D  3                       STA     PTEMPW+1
00122D  3                       STA     PTEMPW1+1
00122D  3                       STA     PTEMPW3+1
00122D  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
00122D  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
00122D  3                                               ; FIGURE THE BUFFER OFFSET
00122D  3                       TXA                     ; GET Y COORD
00122D  3                       STX     PTEMPW1
00122D  3                       STX     PTEMPW3
00122D  3                                               ; MULTIPLY Y COORD BY 35 OR 70 (MONO OR QUAD HIRES)
00122D  3                       ASL     PTEMPW1
00122D  3                       ROL     PTEMPW1+1       ; *2
00122D  3                       LDA     PTEMPW1
00122D  3                       STA     PTEMPW2
00122D  3                       LDA     PTEMPW1+1
00122D  3                       STA     PTEMPW2+1       ; STORE *2 INTO PTEMPW2
00122D  3                       ASL     PTEMPW1
00122D  3                       ROL     PTEMPW1+1       ; *2 (*4)
00122D  3                       ASL     PTEMPW1
00122D  3                       ROL     PTEMPW1+1       ; *2 (*8)
00122D  3                       ASL     PTEMPW1
00122D  3                       ROL     PTEMPW1+1       ; *2 (*16)
00122D  3                       ASL     PTEMPW1
00122D  3                       ROL     PTEMPW1+1       ; *2 (*32)
00122D  3                                               ;
00122D  3                                               ; PTEMPW1(Y*35) = PTEMPW1(Y*32)+PTEMPW2(Y*2)+PTEMPW3(Y)
00122D  3                       CLC                     ; Clear the Carry flag before the first addition
00122D  3                       LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
00122D  3                       ADC     PTEMPW2         ; Add the low byte of the second number (plus carry)
00122D  3                       STA     PTEMPW1         ; Store the low byte of the result
00122D  3               
00122D  3                       LDA     PTEMPW1+1       ; Load the high byte of the first number
00122D  3                       ADC     PTEMPW2+1       ; Add the high byte of the second number (plus carry from previous op)
00122D  3                       STA     PTEMPW1+1       ; Store the high byte of the result
00122D  3                       CLC                     ; Clear the Carry flag before the first addition
00122D  3                       LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
00122D  3                       ADC     PTEMPW3         ; Add the low byte of the second number (plus carry)
00122D  3                       STA     PTEMPW1         ; Store the low byte of the result
00122D  3               
00122D  3                       LDA     PTEMPW1+1       ; Load the high byte of the first number
00122D  3                       ADC     PTEMPW3+1       ; Add the high byte of the second number (plus carry from previous op)
00122D  3                       STA     PTEMPW1+1       ; Store the high byte of the result
00122D  3                                               ;
00122D  3                                               ; PTEMPW1 IS NOW THE Y OFFSET
00122D  3                                               ; if quad hires double it.
00122D  3                       LDA     VIDEOMODE
00122D  3                       AND     #$10
00122D  3                       CMP     #00
00122D  3                       BNE     :+
00122D  3                       ASL     PTEMPW1
00122D  3                       ROL     PTEMPW1+1       ; *2
00122D  3               :
00122D  3                                               ; ADD THE X OFFSET
00122D  3                       CLC                     ; Clear the Carry flag before the first addition
00122D  3                       LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
00122D  3                       ADC     PTEMPW          ; Add the low byte of the second number (plus carry)
00122D  3                       STA     TEMPW           ; Store the low byte of the result
00122D  3               
00122D  3                       LDA     PTEMPW1+1       ; Load the high byte of the first number
00122D  3                       ADC     PTEMPW+1        ; Add the high byte of the second number (plus carry from previous op)
00122D  3                       STA     TEMPW+1         ; Store the high byte of the result
00122D  3                                               ; TEMPW IS NOW THE MEMORY ADDRESS
00122D  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
00122D  3                       JSR     LAB_GTBY        ; GET THE THIRD PARAMETER, RETURN IN X (PATTERN)
00122D  3                       LDA     TEMPW           ; OK, LET'S CALCULATE THE BANK
00122D  3                       AND     #$F0
00122D  3                       LSR     A
00122D  3                       LSR     A
00122D  3                       LSR     A
00122D  3                       LSR     A
00122D  3                       CLC
00122D  3                       ADC     #$02+VIDEOBANK  ; AREA $2000-?
00122D  3                       TAY                     ; VIDEO BANK SHOULD BE IN Y
00122D  3                       JSR     PAGE_ENTER
00122D  3                       LDA     TEMPW+1
00122D  3                       AND     #$0F
00122D  3                       ORA     #$B0
00122D  3                       STA     TEMPW+1         ; TEMPW NOW REFLECTS MAPPED ADDRESSS
00122D  3                       TXA
00122D  3                       AND     #$01
00122D  3                       STA     PTEMP          ; SAVE COLOR IN TEMP
00122D  3                       PLA
00122D  3                       AND     #$07            ; WHICH BIT?
00122D  3                       TAX
00122D  3                       LDA     PTEMP
00122D  3                       CMP     #$01
00122D  3                       BNE     :+
00122D  3                       LDA     HIRES_BIT_LOOKUP_SET,X
00122D  3                       LDY     #$00
00122D  3                       ORA     (TEMPW),Y
00122D  3                       STA     (TEMPW),Y
00122D  3                       JSR     PAGE_EXIT
00122D  3                       RTS
00122D  3               :
00122D  3                       LDA     HIRES_BIT_LOOKUP_RESET,X
00122D  3                       PHA
00122D  3                       LDY     #$00
00122D  3                       AND     (TEMPW),Y
00122D  3                       STA     (TEMPW),Y
00122D  3                       JSR     PAGE_EXIT
00122D  3                       RTS
00122D  3               HIRES_BIT_LOOKUP_SET:
00122D  3                       .BYTE   %10000000,%01000000,%00100000,%00010000,%00001000,%00000100,%00000010,%00000001
00122D  3               HIRES_BIT_LOOKUP_RESET:
00122D  3                       .BYTE   %01111111,%10111111,%11011111,%11101111,%11110111,%11111011,%11111101,%11111110
00122D  3               
00122D  3               ;___V_PATTERN________________________________________________
00122D  3               ;
00122D  3               ;  DEFINE GRAPHICS PATTERN
00122D  3               ;
00122D  3               ;  TAKES 10 PARAMETERS
00122D  3               ;       PATTERN NUM (0-255)
00122D  3               ;       PATTERN DATA (8 BYTES)
00122D  3               ;__________________________________________________________
00122D  3               LAB_PATTERN
00122D  3               V_PATTERN:
00122D  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X
00122D  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00122D  3                       JSR     PAGE_ENTER
00122D  3                       TXA
00122D  3                       STA     VideoCharGenOffset
00122D  3                       LDY     #8
00122D  3               :
00122D  3                       TYA
00122D  3                       PHA
00122D  3                       JSR     LAB_1C01        ; GET THE NEXT PARAMETER (AFTER ',') OR SYN ERR
00122D  3                       JSR     LAB_GTBY        ; GET THE NEXT PARAMETER, RETURN IN X
00122D  3                       PLA
00122D  3                       TAY
00122D  3                       TXA
00122D  3                       STA     VideoCharGenData
00122D  3                       DEY
00122D  3                       CPY     #$00
00122D  3                       BNE     :-
00122D  3                       JSR     PAGE_EXIT
00122D  3                       RTS
00122D  3               
00122D  3               
00122D  3               
00122D  3                       .ELSE
00122D  3               
00122D  3               
00122D  3               ; ENSURE ALL OF THESE SPECIAL COMMANDS GIVE ERRORS IN NORMAL BASIC
00122D  3               LAB_SPEEK:
00122D  3               LAB_SPOKE:
00122D  3               LAB_SCRCLR:
00122D  3               LAB_SCREEN:
00122D  3               LAB_PATTERN:
00122D  3               LAB_PLOT:
00122D  3  A2 02                LDX     #$02            ; error code $02 ("SYNTAX" error)
00122F  3  4C 59 13             JMP     LAB_XERR        ; do error #X, then warm start
001232  3               
001232  3                       .ENDIF
001232  3               
