0010B8  2               UART1CONTROL    = $EF87         ; SERIAL PORT 1 (I/O Card)
0010B8  2               
0010B8  2               PRINT_CRLF:
0010B8  2  8E 26 11             STX     TTX
0010BB  2  8C 27 11             STY     TTY
0010BE  2  8D 28 11             STA     TTA
0010C1  2  A9 0D                LDA     #13
0010C3  2  20 29 11             JSR     WRSER1          ; output upper nybble
0010C6  2  A9 0A                LDA     #10
0010C8  2  20 29 11             JSR     WRSER1          ; output upper nybble
0010CB  2  AE 26 11             LDX     TTX
0010CE  2  AC 27 11             LDY     TTY
0010D1  2  AD 28 11             LDA     TTA
0010D4  2  60                   RTS
0010D5  2               
0010D5  2               PRINT_SPACE:
0010D5  2  8E 26 11             STX     TTX
0010D8  2  8C 27 11             STY     TTY
0010DB  2  8D 28 11             STA     TTA
0010DE  2  A9 20                LDA     #32
0010E0  2  20 29 11             JSR     WRSER1          ; output upper nybble
0010E3  2  AE 26 11             LDX     TTX
0010E6  2  AC 27 11             LDY     TTY
0010E9  2  AD 28 11             LDA     TTA
0010EC  2  60                   RTS
0010ED  2               
0010ED  2               
0010ED  2               PRINT_BYTE:
0010ED  2  8E 26 11             STX     TTX
0010F0  2  8C 27 11             STY     TTY
0010F3  2  8D 28 11             STA     TTA
0010F6  2  8E 25 11             STX     SAVX            ; save X
0010F9  2  20 10 11             JSR     ASCTWO          ; get hex chars for byte in X (lower) and A (upper)
0010FC  2  20 29 11             JSR     WRSER1          ; output upper nybble
0010FF  2  8A                   TXA                     ; transfer lower to A
001100  2  AE 25 11             LDX     SAVX            ; restore X
001103  2  20 29 11             JSR     WRSER1          ; output lower nybble
001106  2  AE 26 11             LDX     TTX
001109  2  AC 27 11             LDY     TTY
00110C  2  AD 28 11             LDA     TTA
00110F  2  60                   RTS
001110  2               ASCTWO:
001110  2  48                   PHA                     ; save byte
001111  2  20 1A 11             JSR     ASCII           ; do low nybble
001114  2  AA                   TAX                     ; save in X
001115  2  68                   PLA                     ; restore byte
001116  2  4A                   LSR     A               ; shift upper nybble down
001117  2  4A                   LSR     A
001118  2  4A                   LSR     A
001119  2  4A                   LSR     A
00111A  2               ; convert low nybble in A to hex digit
00111A  2               ASCII:
00111A  2  29 0F                AND     #$0F            ; clear upper nibble
00111C  2  C9 0A                CMP     #$0A            ; if less than A, skip next step
00111E  2  90 02                BCC     ASC1
001120  2  69 06                ADC     #6              ; skip ascii chars between 9 and A
001122  2               ASC1:
001122  2  69 30                ADC     #$30            ; add ascii char 0 to value
001124  2  60                   RTS
001125  2               SAVX:
001125  2  00                   .BYTE   00
001126  2               TTX:
001126  2  00                   .BYTE   00
001127  2               TTY:
001127  2  00                   .BYTE   00
001128  2               TTA:
001128  2  00                   .BYTE   00
001129  2               ;__WRSER1________________________________________________________________________________________________________________________
001129  2               ;
001129  2               ;	WRITE CHARACTER(A) TO UART
001129  2               ;________________________________________________________________________________________________________________________________
001129  2               ;
001129  2               WRSER1:
001129  2  48                   PHA
00112A  2               WRSER1a:
00112A  2  AD 85 EF             LDA     UART1STATUS     ; GET STATUS
00112D  2  29 10                AND     #%00010000      ; IS TX READY
00112F  2  F0 F9                BEQ     WRSER1a         ; NO, WAIT FOR IT
001131  2  68                   PLA
001132  2  8D 84 EF             STA     UART1DATA       ; WRITE DATA
001135  2  60                   RTS
