0010DB  2  A9 01                LDA     #$01
0010DD  2  8D 81 10             STA     printflag
0010E0  2  28                   PLP
0010E1  2  20 A1 21             JSR     LAB_PRINT
0010E4  2  A9 00                LDA     #$00
0010E6  2  8D 81 10             STA     printflag
0010E9  2  60                   RTS
0010EA  2               V_LLIST:
0010EA  2  08                   PHP
0010EB  2  A9 01                LDA     #$01
0010ED  2  8D 81 10             STA     printflag
0010F0  2  28                   PLP
0010F1  2  20 06 1D             JSR     LAB_LIST
0010F4  2  A9 00                LDA     #$00
0010F6  2  8D 81 10             STA     printflag
0010F9  2  60                   RTS
