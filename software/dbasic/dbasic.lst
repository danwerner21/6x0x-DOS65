00117D  3               ;___SAVE____________________________________________________
00117D  3               ;
00117D  3               ; SAVE COMMAND
00117D  3               ;
00117D  3               ;  SAVE THE BASIC PROGRAM IN MEMORY TO DISK
00117D  3               ;
00117D  3               ;__________________________________________________________
00117D  3               V_SAVE: ; save BASIC program
00117D  3               DOS65SAVE:
00117D  3  20 F2 12             JSR     DOS65FCBPREP    ; parse parameters into FCB
001180  3  B0 29                BCS     DOS65SAVE_ERR1  ; Error?, if so abort
001182  3  A2 0D                LDX     #13             ;
001184  3  20 77 11             JSR     PEM             ;
001187  3  A9 9A                LDA     #<FCB           ; CREATE File
001189  3  A0 15                LDY     #>FCB           ;
00118B  3  A2 16                LDX     #22             ;
00118D  3  20 77 11             JSR     PEM             ;
001190  3  A9 00                LDA     #0              ; clear
001192  3  8D BA 15             STA     FCB+32          ; record number
001195  3  A9 9A                LDA     #<FCB           ; Open File
001197  3  A0 15                LDY     #>FCB           ;
001199  3  A2 0F                LDX     #15             ;
00119B  3  20 77 11             JSR     PEM             ;
00119E  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
0011A0  3  D0 0C                BNE     DOS65SAVE_1     ;
0011A2  3               DOS65SAVE_ERR:
0011A2  3  A9 AB                LDA     #<FILEERROR2    ; NO, ERROR OUT
0011A4  3  A0 0F                LDY     #>FILEERROR2
0011A6  3  A2 09                LDX     #9              ; Print error message
0011A8  3  20 77 11             JSR     PEM             ;
0011AB  3               DOS65SAVE_ERR1:
0011AB  3  4C 9A 1D             JMP     LAB_REM         ; comment out the remainder of the line (if any)
0011AE  3               DOS65SAVE_1:
0011AE  3  A9 24                LDA     #<FCBBUFFER     ; SETUP BUFFER
0011B0  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
0011B2  3  A0 37                LDY     #>FCBBUFFER     ;
0011B4  3  84 21                STY     FCBPTR+1        ;
0011B6  3  A2 1A                LDX     #26             ; Setup Buffer
0011B8  3  20 77 11             JSR     PEM             ;
0011BB  3               DOS65SAVE_2:
0011BB  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
0011BD  3  85 22                STA     FCBPTR+2        ; point to base of RAM
0011BF  3  A5 7A                LDA     <Smemh          ;
0011C1  3  85 23                STA     FCBPTR+3        ;
0011C3  3  A2 00                LDX     #$00            ; x=0 (null counter)
0011C5  3               DOS65SAVE_2A:
0011C5  3  A0 00                LDY     #$00            ; y=0 (Loop Index)
0011C7  3               DOS65SAVE_3:
0011C7  3  B1 22                LDA     (FCBPTR+2),Y    ; load from RAM
0011C9  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
0011CB  3  C9 00                CMP     #$00            ; is Zero?
0011CD  3  D0 1E                BNE     DOS65SAVE_3A    ; No, continue
0011CF  3  E8                   INX                     ; yes, bump Null Counter
0011D0  3  E0 03                CPX     #$03            ; Three nulls in a row?
0011D2  3  D0 1B                BNE     DOS65SAVE_3B    ; No, continue
0011D4  3                                               ; FINISH FILLING BUFFER WITH NULLS
0011D4  3               :
0011D4  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
0011D6  3  C8                   INY                     ; bump index
0011D7  3  C0 80                CPY     #$80            ; end of buffer?
0011D9  3  D0 F9                BNE     :-              ; no, loop
0011DB  3  A9 9A                LDA     #<FCB           ; Write record in buffer to disk file AND END
0011DD  3  A0 15                LDY     #>FCB           ;
0011DF  3  A2 15                LDX     #21             ;
0011E1  3  20 77 11             JSR     PEM             ;
0011E4  3  29 FE                AND     #$FE            ; strip out extension
0011E6  3  C9 00                CMP     #$00            ; is error
0011E8  3  D0 B8                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
0011EA  3  4C 1A 12             JMP     DOS65SAVE_4
0011ED  3               DOS65SAVE_3A:                   ;
0011ED  3  A2 00                LDX     #$00            ; prior char not null, reset null counter
0011EF  3               DOS65SAVE_3B:                   ;
0011EF  3  C8                   INY                     ; bump index
0011F0  3  C0 80                CPY     #$80            ; end of buffer?
0011F2  3  D0 D3                BNE     DOS65SAVE_3     ; no, loop
0011F4  3               DOS65SAVE_3C:
0011F4  3  A9 9A                LDA     #<FCB           ; Write record in buffer to disk file
0011F6  3  A0 15                LDY     #>FCB           ;
0011F8  3  A2 15                LDX     #21             ;
0011FA  3  20 77 11             JSR     PEM             ;
0011FD  3  29 FE                AND     #$FE            ; strip out extension
0011FF  3  C9 00                CMP     #$00            ; is error
001201  3  D0 9F                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
001203  3  18                   CLC                     ;
001204  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
001206  3  69 80                ADC     #$80            ;
001208  3  85 22                STA     FCBPTR+2        ;
00120A  3  90 B9                BCC     DOS65SAVE_2A    ; is carry?, no loop
00120C  3  18                   CLC                     ; yes, carry, inc high byte
00120D  3  A5 23                LDA     FCBPTR+3        ;
00120F  3  69 01                ADC     #$01            ;
001211  3  85 23                STA     FCBPTR+3        ;
001213  3  C9 B8                CMP     #>Ram_top       ; are we at the end of RAM?
001215  3  F0 03                BEQ     DOS65SAVE_4
001217  3  4C C5 11             JMP     DOS65SAVE_2A
00121A  3               DOS65SAVE_4:
00121A  3  A9 9A                LDA     #<FCB           ;
00121C  3  A0 15                LDY     #>FCB           ;
00121E  3  A2 10                LDX     #16             ;
001220  3  20 77 11             JSR     PEM             ;
001223  3  C9 FF                CMP     #$FF            ;
001225  3  D0 03                BNE     DOS65SAVE_5     ;
001227  3  4C A2 11             JMP     DOS65SAVE_ERR   ; ERROR, DISPLAY IT
00122A  3               DOS65SAVE_5:
00122A  3  A9 52                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
00122C  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
00122E  3  20 41 1F             JSR     LAB_18C3
001231  3  4C 96 18             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001234  3               
