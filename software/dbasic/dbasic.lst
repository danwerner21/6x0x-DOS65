0015F9  3               ; RENAME A FILE
0015F9  3               ;
0015F9  3               ;
0015F9  3               ; BASIC COMMAND EXPECTS THREE VARS
0015F9  3               ; DRIVE, FILENAME$, NEWFILENAME$
0015F9  3               ;
0015F9  3               ; DRIVE = NUMERIC DRIVE -- 0=CURRENT, 1=A, 2=B . . .
0015F9  3               ; FILENAME$ = OLD FILENAME STRING
0015F9  3               ; FILENAME$ = NEW FILENAME STRING
0015F9  3               ;__________________________________________________________
