001183  3               ;___SAVE____________________________________________________
001183  3               ;
001183  3               ; SAVE COMMAND
001183  3               ;
001183  3               ;  SAVE THE BASIC PROGRAM IN MEMORY TO DISK
001183  3               ;
001183  3               ;__________________________________________________________
001183  3               V_SAVE: ; save BASIC program
001183  3               DOS65SAVE:
001183  3  20 F6 12             JSR     DOS65FCBPREP    ; parse parameters into FCB
001186  3  B0 28                BCS     DOS65SAVE_ERR1  ; Error?, if so abort
001188  3  A2 0D                LDX     #13             ;
00118A  3  20 7D 11             JSR     PEM             ;
00118D  3  A9 14                LDA     #<FCB           ; CREATE File
00118F  3  A0 17                LDY     #>FCB           ;
001191  3  A2 16                LDX     #22             ;
001193  3  20 7D 11             JSR     PEM             ;
001196  3  A9 00                LDA     #0              ; clear
001198  3  8D 34 17             STA     FCB+32          ; record number
00119B  3  A9 14                LDA     #<FCB           ; Open File
00119D  3  A0 17                LDY     #>FCB           ;
00119F  3  A2 0F                LDX     #15             ;
0011A1  3  20 7D 11             JSR     PEM             ;
0011A4  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
0011A6  3  D0 0B                BNE     DOS65SAVE_1     ;
0011A8  3               DOS65SAVE_ERR:
0011A8  3  A2 24                LDX     #$24            ; IO ERROR
0011AA  3  20 9F 1A             JSR     LAB_XERR
0011AD  3  4C 77 1B             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
0011B0  3               DOS65SAVE_ERR1:
0011B0  3  4C 78 20             JMP     LAB_REM         ; comment out the remainder of the line (if any)
0011B3  3               DOS65SAVE_1:
0011B3  3  A9 00                LDA     #<FCBBUFFER     ; SETUP BUFFER
0011B5  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
0011B7  3  A0 3A                LDY     #>FCBBUFFER     ;
0011B9  3  84 21                STY     FCBPTR+1        ;
0011BB  3  A2 1A                LDX     #26             ; Setup Buffer
0011BD  3  20 7D 11             JSR     PEM             ;
0011C0  3               DOS65SAVE_2:
0011C0  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
0011C2  3  85 22                STA     FCBPTR+2        ; point to base of RAM
0011C4  3  A5 7A                LDA     <Smemh          ;
0011C6  3  85 23                STA     FCBPTR+3        ;
0011C8  3  A2 00                LDX     #$00            ; x=0 (null counter)
0011CA  3               DOS65SAVE_2A:
0011CA  3  A0 00                LDY     #$00            ; y=0 (Loop Index)
0011CC  3               DOS65SAVE_3:
0011CC  3  B1 22                LDA     (FCBPTR+2),Y    ; load from RAM
0011CE  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
0011D0  3  C9 00                CMP     #$00            ; is Zero?
0011D2  3  D0 1E                BNE     DOS65SAVE_3A    ; No, continue
0011D4  3  E8                   INX                     ; yes, bump Null Counter
0011D5  3  E0 03                CPX     #$03            ; Three nulls in a row?
0011D7  3  D0 1B                BNE     DOS65SAVE_3B    ; No, continue
0011D9  3                                               ; FINISH FILLING BUFFER WITH NULLS
0011D9  3               :
0011D9  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
0011DB  3  C8                   INY                     ; bump index
0011DC  3  C0 80                CPY     #$80            ; end of buffer?
0011DE  3  D0 F9                BNE     :-              ; no, loop
0011E0  3  A9 14                LDA     #<FCB           ; Write record in buffer to disk file AND END
0011E2  3  A0 17                LDY     #>FCB           ;
0011E4  3  A2 15                LDX     #21             ;
0011E6  3  20 7D 11             JSR     PEM             ;
0011E9  3  29 FE                AND     #$FE            ; strip out extension
0011EB  3  C9 00                CMP     #$00            ; is error
0011ED  3  D0 B9                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
0011EF  3  4C 1F 12             JMP     DOS65SAVE_4
0011F2  3               DOS65SAVE_3A:                   ;
0011F2  3  A2 00                LDX     #$00            ; prior char not null, reset null counter
0011F4  3               DOS65SAVE_3B:                   ;
0011F4  3  C8                   INY                     ; bump index
0011F5  3  C0 80                CPY     #$80            ; end of buffer?
0011F7  3  D0 D3                BNE     DOS65SAVE_3     ; no, loop
0011F9  3               DOS65SAVE_3C:
0011F9  3  A9 14                LDA     #<FCB           ; Write record in buffer to disk file
0011FB  3  A0 17                LDY     #>FCB           ;
0011FD  3  A2 15                LDX     #21             ;
0011FF  3  20 7D 11             JSR     PEM             ;
001202  3  29 FE                AND     #$FE            ; strip out extension
001204  3  C9 00                CMP     #$00            ; is error
001206  3  D0 A0                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
001208  3  18                   CLC                     ;
001209  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
00120B  3  69 80                ADC     #$80            ;
00120D  3  85 22                STA     FCBPTR+2        ;
00120F  3  90 B9                BCC     DOS65SAVE_2A    ; is carry?, no loop
001211  3  18                   CLC                     ; yes, carry, inc high byte
001212  3  A5 23                LDA     FCBPTR+3        ;
001214  3  69 01                ADC     #$01            ;
001216  3  85 23                STA     FCBPTR+3        ;
001218  3  C9 B8                CMP     #>Ram_top       ; are we at the end of RAM?
00121A  3  F0 03                BEQ     DOS65SAVE_4
00121C  3  4C CA 11             JMP     DOS65SAVE_2A
00121F  3               DOS65SAVE_4:
00121F  3  A9 14                LDA     #<FCB           ;
001221  3  A0 17                LDY     #>FCB           ;
001223  3  A2 10                LDX     #16             ;
001225  3  20 7D 11             JSR     PEM             ;
001228  3  C9 FF                CMP     #$FF            ;
00122A  3  D0 03                BNE     DOS65SAVE_5     ;
00122C  3  4C A8 11             JMP     DOS65SAVE_ERR   ; ERROR, DISPLAY IT
00122F  3               DOS65SAVE_5:
00122F  3  A9 A8                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
001231  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
001233  3  20 1F 22             JSR     LAB_18C3
001236  3  4C 77 1B             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001239  3               
001239  3               ;___LOAD____________________________________________________
001239  3               ;
001239  3               ; LOAD COMMAND
001239  3               ;
001239  3               ;  LOAD A BASIC PROGRAM FROM DISK TO MEMORY
001239  3               ;
001239  3               ;__________________________________________________________
001239  3               V_LOAD: ; load BASIC program
001239  3               DOS65LOAD:
001239  3  A9 00                LDA     #$00
00123B  3  8D 3A 13             STA     NullCounter
00123E  3  20 F6 12             JSR     DOS65FCBPREP    ; parse parameters into FCB
001241  3  B0 1F                BCS     DOS65LOAD_ERR1  ; Error?, if so abort
001243  3  A2 0D                LDX     #13             ;
001245  3  20 7D 11             JSR     PEM             ;
001248  3  A9 00                LDA     #0              ; clear
00124A  3  8D 34 17             STA     FCB+32          ; record number
00124D  3  A9 14                LDA     #<FCB           ; Open File
00124F  3  A0 17                LDY     #>FCB           ;
001251  3  A2 0F                LDX     #15             ;
001253  3  20 7D 11             JSR     PEM             ;
001256  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
001258  3  D0 0B                BNE     DOS65LOAD_1     ;
00125A  3               DOS65LOAD_ERR:
00125A  3  A2 24                LDX     #$24            ; IO ERROR
00125C  3  20 9F 1A             JSR     LAB_XERR
00125F  3  4C 77 1B             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001262  3               DOS65LOAD_ERR1:
001262  3  4C 78 20             JMP     LAB_REM         ; comment out the remainder of the line (if any)
001265  3               DOS65LOAD_1:
001265  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
001267  3  85 22                STA     FCBPTR+2        ; point to base of RAM
001269  3  8D 38 13             STA     EndOfBas        ;
00126C  3  A5 7A                LDA     <Smemh          ;
00126E  3  85 23                STA     FCBPTR+3        ;
001270  3  8D 39 13             STA     EndOfBas+1      ;
001273  3  A9 00                LDA     #<FCBBUFFER     ; SETUP BUFFER
001275  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
001277  3  A0 3A                LDY     #>FCBBUFFER     ;
001279  3  84 21                STY     FCBPTR+1        ; STORE DEST BUFFER IN FCBPTR
00127B  3  A2 1A                LDX     #26             ; Setup Buffer
00127D  3  20 7D 11             JSR     PEM             ;
001280  3  4C BE 12             JMP     DOS65LOAD_3C
001283  3               DOS65LOAD_3:
001283  3  B1 20                LDA     (FCBPTR),Y      ; load from BUFFER
001285  3  91 22                STA     (FCBPTR+2),Y    ; save to RAM
001287  3  EE 38 13             INC     EndOfBas
00128A  3  D0 03                BNE     :+
00128C  3  EE 39 13             INC     EndOfBas+1
00128F  3               :
00128F  3  C9 00                CMP     #$00
001291  3  D0 0D                BNE     :+
001293  3  EE 3A 13             INC     NullCounter
001296  3  AD 3A 13             LDA     NullCounter
001299  3  C9 03                CMP     #3
00129B  3  D0 08                BNE     :++
00129D  3  4C D1 12             JMP     DOS65LOAD_4
0012A0  3               :
0012A0  3  A9 00                LDA     #$00
0012A2  3  8D 3A 13             STA     NullCounter
0012A5  3               :
0012A5  3  C8                   INY                     ; bump index
0012A6  3  C0 80                CPY     #$80            ; end of buffer?
0012A8  3  D0 D9                BNE     DOS65LOAD_3     ; no, loop
0012AA  3  18                   CLC                     ;
0012AB  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
0012AD  3  69 80                ADC     #$80            ;
0012AF  3  85 22                STA     FCBPTR+2        ;
0012B1  3  90 0B                BCC     DOS65LOAD_3C    ; is carry?, no SKIP
0012B3  3  18                   CLC                     ; yes, carry, inc high byte
0012B4  3  A5 23                LDA     FCBPTR+3        ;
0012B6  3  69 01                ADC     #$01            ;
0012B8  3  85 23                STA     FCBPTR+3        ;
0012BA  3  C9 B8                CMP     #>Ram_top       ; are we at the end of RAM?
0012BC  3  F0 13                BEQ     DOS65LOAD_4
0012BE  3               
0012BE  3               DOS65LOAD_3C:
0012BE  3  A9 14                LDA     #<FCB           ; READ record buffer from disk file
0012C0  3  A0 17                LDY     #>FCB           ;
0012C2  3  A2 14                LDX     #20             ;
0012C4  3  20 7D 11             JSR     PEM             ;
0012C7  3  A0 00                LDY     #$00            ; RESET INDEX
0012C9  3  C9 00                CMP     #$00            ; is error or EOF
0012CB  3  F0 B6                BEQ     DOS65LOAD_3     ;
0012CD  3  C9 01                CMP     #$01            ; EOF?
0012CF  3  D0 89                BNE     DOS65LOAD_ERR   ; ERROR, do error handling
0012D1  3               DOS65LOAD_4:
0012D1  3  A9 14                LDA     #<FCB           ;
0012D3  3  A0 17                LDY     #>FCB           ;
0012D5  3  A2 10                LDX     #16             ;
0012D7  3  20 7D 11             JSR     PEM             ;
0012DA  3                                               ; setup pointers to return to basic
0012DA  3  AD 38 13             LDA     EndOfBas
0012DD  3  85 7B                STA     Svarl
0012DF  3  85 7D                STA     Sarryl
0012E1  3  85 7F                STA     Earryl
0012E3  3  AD 39 13             LDA     EndOfBas+1
0012E6  3  85 7C                STA     Svarh
0012E8  3  85 7E                STA     Sarryh
0012EA  3  85 80                STA     Earryh
0012EC  3  A9 A8                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
0012EE  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
0012F0  3  20 1F 22             JSR     LAB_18C3
0012F3  3  4C 77 1B             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
0012F6  3               
0012F6  3               
0012F6  3               
0012F6  3               DOS65FCBPREP:
0012F6  3                       .IFDEF  DUODYNE
0012F6  3                       JSL     LAB_GBYT        ; scan memory
0012F6  3                       .ELSE
0012F6  3  20 C2 00             JSR     LAB_GBYT        ; scan memory
0012F9  3                       .ENDIF
0012F9  3               
0012F9  3  38                   SEC                     ;
0012FA  3  E9 40                SBC     #64             ; PARSE DRIVE NUMBER
0012FC  3  8D 14 17             STA     DOSDRIVE        ; STORE IT IN FCB
0012FF  3                       .IFDEF  DUODYNE
0012FF  3                       JSL     LAB_IGBY        ; increment and scan memory
0012FF  3                       .ELSE
0012FF  3  20 BC 00             JSR     LAB_IGBY        ; increment and scan memory
001302  3                       .ENDIF
001302  3               
001302  3  C9 3A                CMP     #':'            ;
001304  3  F0 08                BEQ     DOS65FCBPREP_1  ; YES, IT WAS A DRIVE, CONTINUE
001306  3  A2 26                LDX     #$26            ; IO ERROR
001308  3  20 9F 1A             JSR     LAB_XERR
00130B  3  4C 77 1B             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
00130E  3               
00130E  3               DOS65FCBPREP_1:
00130E  3  A9 14                LDA     #<FCB           ; SETUP FCBPTR
