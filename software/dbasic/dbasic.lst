001429  3  20 CF 23             JSR     LAB_GVAR        ; GET THE FOURTH PARAMETER
00142C  3  85 97                STA     Lvarpl          ; save var address low byte
00142E  3  84 98                STY     Lvarph          ; save var address high byte
001430  3  A5 5F                LDA     <Dtypef         ; IS IT A STRING?
001432  3  D0 08                BNE     :+              ; YES, CONTINUE ON
001434  3  A2 02                LDX     #$02            ; NOPE, SYNTAX ERROR
001436  3  20 73 17             JSR     LAB_XERR
001439  3  4C 4B 18             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
00143C  3               :
