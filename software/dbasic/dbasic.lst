0012F9  3               ;
0012F9  3               ;__________________________________________________________
0012F9  3               
0012F9  3               LAB_DIR:
0012F9  3  A9 00                LDA     #$00
0012FB  3  8D 7C 15             STA     DIRET
0012FE  3  8D 7D 15             STA     DIRET+1
001301  3  8D 7E 15             STA     DIRET+2
001304  3               
001304  3  A9 D9                LDA     #<FCBBUFFER     ; SETUP BUFFER
001306  3  A0 36                LDY     #>FCBBUFFER     ;
