00164F  1  8D 36 11             STA     PEMVEC
001652  1  AD 05 01             LDA     $0105
001655  1  8D 37 11             STA     PEMVEC+1
001658  1               
001658  1                       .IFDEF  MEMORYMAPPEDSCREEN
001658  1                       LDA     #0
001658  1                       STA     SHOWCRSR        ; TURN OFF CURSOR
001658  1                       LDA     #38
001658  1                       STA     farfunct
001658  1                       JSR     DO_FARCALL      ; CLEAR SCREEN
001658  1                       LDA     #59
001658  1                       STA     farfunct
001658  1                       JSR     DO_FARCALL      ; UNPAINT CURSOR
001658  1                       .ENDIF
001658  1               
001658  1               LAB_COLD:
001658  1  A0 04                LDY     #PG2_TABE-PG2_TABS-1
00165A  1               ; byte count-1
00165A  1               LAB_2D13:
00165A  1  B9 32 08             LDA     PG2_TABS,Y      ; get byte
00165D  1  99 00 06             STA     ccflag,Y        ; store in page 2
001660  1  88                   DEY                     ; decrement count
001661  1  10 F7                BPL     LAB_2D13        ; loop if not done
001663  1               
001663  1  A2 FF                LDX     #$FF            ; set byte
001665  1  86 88                STX     Clineh          ; set current line high byte (set immediate mode)
001667  1               
001667  1  A9 4C                LDA     #$4C            ; code for JMP
001669  1  85 A1                STA     Fnxjmp          ; save for jump vector for functions
00166B  1               
00166B  1               ; copy block from LAB_2CEE to $00BC - $00D3
00166B  1               
00166B  1  A0 1C                LDY     #StrTab-LAB_2CEE; set byte count
00166D  1               LAB_2D4E:
00166D  1  BE 02 08             LDX     LAB_2CEE-1,Y    ; get byte from table
001670  1  96 BB                STX     LAB_IGBY-1,Y    ; save byte in page zero
001672  1  88                   DEY                     ; decrement count
001673  1  D0 F8                BNE     LAB_2D4E        ; loop if not all done
001675  1               
001675  1               ; copy block from StrTab to $0000 - $0012
001675  1               
001675  1               LAB_GMEM:
001675  1  A0 12                LDY     #EndTab-StrTab-1; set byte count-1
001677  1               TabLoop:
001677  1  BE 1F 08             LDX     StrTab,Y        ; get byte from table
00167A  1  96 00                STX     PLUS_0,Y        ; save byte in page zero
00167C  1  88                   DEY                     ; decrement count
00167D  1  10 F8                BPL     TabLoop         ; loop if not all done
00167F  1               
00167F  1               
00167F  1                       .IFDEF  DUODYNE
