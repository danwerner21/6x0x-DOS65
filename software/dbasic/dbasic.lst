001745  3               ;___FILTER_________________________________________________
001745  3               ;
001745  3               ; SET SID FILTERS
001745  3               ;
001745  3               ;  FILTER CUTOFF, RESONANCE, VOICE 1 ENABLE, VOICE 2 ENABLE, VOICE 3 ENABLE, EXTERNAL ENABLE, FILTER MODE, VOLUME
001745  3               ;
001745  3               ;
001745  3               ;__________________________________________________________
001745  3               LAB_FILTER:
001745  3                       JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001745  3                                               ; else do type mismatch
001745  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001745  3                                               ; SET CUTOFF
001745  3                       LDA     Itempl
001745  3                       STA     SID_BASE+$15
001745  3                       LDA     Itemph
001745  3                       STA     SID_BASE+$16
001745  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001745  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (RESONANCE)
001745  3                       TXA
001745  3                       LSR     A
001745  3                       LSR     A
001745  3                       LSR     A
001745  3                       LSR     A
001745  3                       STA     PTEMPW
001745  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001745  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 1 ENABLE)
001745  3                       TXA
001745  3                       AND     #1
001745  3                       ORA     PTEMPW
001745  3                       STA     PTEMPW
001745  3                       JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
001745  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 2 ENABLE)
001745  3                       TXA
001745  3                       AND     #1
001745  3                       LSR     A
001745  3                       ORA     PTEMPW
001745  3                       STA     PTEMPW
001745  3                       JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001745  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 3 ENABLE)
001745  3                       TXA
001745  3                       AND     #1
001745  3                       LSR     A
001745  3                       LSR     A
001745  3                       ORA     PTEMPW
001745  3                       STA     PTEMPW
001745  3                       JSR     LAB_1C01        ; GET THE SIXTH PARAMETER (AFTER ',') OR SYN ERR
001745  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (EXTERNAL AUDIO ENABLE)
001745  3                       TXA
001745  3                       AND     #1
001745  3                       LSR     A
001745  3                       LSR     A
001745  3                       LSR     A
001745  3                       ORA     PTEMPW
001745  3                       STA     SID_BASE+$17
001745  3                       JSR     LAB_1C01        ; GET THE SEVENTH PARAMETER (AFTER ',') OR SYN ERR
001745  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (FILTER MODE)
001745  3                       TXA
001745  3                       LSR     A
001745  3                       LSR     A
001745  3                       LSR     A
001745  3                       LSR     A
001745  3                       STA     PTEMPW
001745  3                       JSR     LAB_1C01        ; GET THE EIGHTH PARAMETER (AFTER ',') OR SYN ERR
001745  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOLUME)
001745  3                       TXA
001745  3                       AND     #$0F
001745  3                       ORA     PTEMPW
001745  3                       STA     SID_BASE+$18
001745  3                       RTS
001745  3               
001745  3                       .ELSE
001745  3               
