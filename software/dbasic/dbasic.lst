001159  3               ;___SAVE____________________________________________________
001159  3               ;
001159  3               ; SAVE COMMAND
001159  3               ;
001159  3               ;  SAVE THE BASIC PROGRAM IN MEMORY TO DISK
001159  3               ;
001159  3               ;__________________________________________________________
001159  3               V_SAVE: ; save BASIC program
001159  3               DOS65SAVE:
001159  3  20 CC 12             JSR     DOS65FCBPREP    ; parse parameters into FCB
00115C  3  B0 28                BCS     DOS65SAVE_ERR1  ; Error?, if so abort
00115E  3  A2 0D                LDX     #13             ;
001160  3  20 53 11             JSR     PEM             ;
001163  3  A9 EA                LDA     #<FCB           ; CREATE File
001165  3  A0 16                LDY     #>FCB           ;
001167  3  A2 16                LDX     #22             ;
001169  3  20 53 11             JSR     PEM             ;
00116C  3  A9 00                LDA     #0              ; clear
00116E  3  8D 0A 17             STA     FCB+32          ; record number
001171  3  A9 EA                LDA     #<FCB           ; Open File
001173  3  A0 16                LDY     #>FCB           ;
001175  3  A2 0F                LDX     #15             ;
001177  3  20 53 11             JSR     PEM             ;
00117A  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
00117C  3  D0 0B                BNE     DOS65SAVE_1     ;
00117E  3               DOS65SAVE_ERR:
00117E  3  A2 24                LDX     #$24            ; IO ERROR
001180  3  20 0E 19             JSR     LAB_XERR
001183  3  4C E6 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001186  3               DOS65SAVE_ERR1:
001186  3  4C E7 1E             JMP     LAB_REM         ; comment out the remainder of the line (if any)
001189  3               DOS65SAVE_1:
001189  3  A9 6F                LDA     #<FCBBUFFER     ; SETUP BUFFER
00118B  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
00118D  3  A0 38                LDY     #>FCBBUFFER     ;
00118F  3  84 21                STY     FCBPTR+1        ;
001191  3  A2 1A                LDX     #26             ; Setup Buffer
001193  3  20 53 11             JSR     PEM             ;
001196  3               DOS65SAVE_2:
001196  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
001198  3  85 22                STA     FCBPTR+2        ; point to base of RAM
00119A  3  A5 7A                LDA     <Smemh          ;
00119C  3  85 23                STA     FCBPTR+3        ;
00119E  3  A2 00                LDX     #$00            ; x=0 (null counter)
0011A0  3               DOS65SAVE_2A:
0011A0  3  A0 00                LDY     #$00            ; y=0 (Loop Index)
0011A2  3               DOS65SAVE_3:
0011A2  3  B1 22                LDA     (FCBPTR+2),Y    ; load from RAM
0011A4  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
0011A6  3  C9 00                CMP     #$00            ; is Zero?
0011A8  3  D0 1E                BNE     DOS65SAVE_3A    ; No, continue
0011AA  3  E8                   INX                     ; yes, bump Null Counter
0011AB  3  E0 03                CPX     #$03            ; Three nulls in a row?
0011AD  3  D0 1B                BNE     DOS65SAVE_3B    ; No, continue
0011AF  3                                               ; FINISH FILLING BUFFER WITH NULLS
0011AF  3               :
0011AF  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
0011B1  3  C8                   INY                     ; bump index
0011B2  3  C0 80                CPY     #$80            ; end of buffer?
0011B4  3  D0 F9                BNE     :-              ; no, loop
0011B6  3  A9 EA                LDA     #<FCB           ; Write record in buffer to disk file AND END
0011B8  3  A0 16                LDY     #>FCB           ;
0011BA  3  A2 15                LDX     #21             ;
0011BC  3  20 53 11             JSR     PEM             ;
0011BF  3  29 FE                AND     #$FE            ; strip out extension
0011C1  3  C9 00                CMP     #$00            ; is error
0011C3  3  D0 B9                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
0011C5  3  4C F5 11             JMP     DOS65SAVE_4
0011C8  3               DOS65SAVE_3A:                   ;
0011C8  3  A2 00                LDX     #$00            ; prior char not null, reset null counter
0011CA  3               DOS65SAVE_3B:                   ;
0011CA  3  C8                   INY                     ; bump index
0011CB  3  C0 80                CPY     #$80            ; end of buffer?
0011CD  3  D0 D3                BNE     DOS65SAVE_3     ; no, loop
0011CF  3               DOS65SAVE_3C:
0011CF  3  A9 EA                LDA     #<FCB           ; Write record in buffer to disk file
0011D1  3  A0 16                LDY     #>FCB           ;
0011D3  3  A2 15                LDX     #21             ;
0011D5  3  20 53 11             JSR     PEM             ;
0011D8  3  29 FE                AND     #$FE            ; strip out extension
0011DA  3  C9 00                CMP     #$00            ; is error
0011DC  3  D0 A0                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
0011DE  3  18                   CLC                     ;
0011DF  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
0011E1  3  69 80                ADC     #$80            ;
0011E3  3  85 22                STA     FCBPTR+2        ;
0011E5  3  90 B9                BCC     DOS65SAVE_2A    ; is carry?, no loop
0011E7  3  18                   CLC                     ; yes, carry, inc high byte
0011E8  3  A5 23                LDA     FCBPTR+3        ;
0011EA  3  69 01                ADC     #$01            ;
0011EC  3  85 23                STA     FCBPTR+3        ;
0011EE  3  C9 B8                CMP     #>Ram_top       ; are we at the end of RAM?
0011F0  3  F0 03                BEQ     DOS65SAVE_4
0011F2  3  4C A0 11             JMP     DOS65SAVE_2A
0011F5  3               DOS65SAVE_4:
0011F5  3  A9 EA                LDA     #<FCB           ;
0011F7  3  A0 16                LDY     #>FCB           ;
0011F9  3  A2 10                LDX     #16             ;
0011FB  3  20 53 11             JSR     PEM             ;
0011FE  3  C9 FF                CMP     #$FF            ;
001200  3  D0 03                BNE     DOS65SAVE_5     ;
001202  3  4C 7E 11             JMP     DOS65SAVE_ERR   ; ERROR, DISPLAY IT
001205  3               DOS65SAVE_5:
001205  3  A9 7E                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
001207  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
001209  3  20 8E 20             JSR     LAB_18C3
00120C  3  4C E6 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
00120F  3               
00120F  3               ;___LOAD____________________________________________________
00120F  3               ;
00120F  3               ; LOAD COMMAND
00120F  3               ;
00120F  3               ;  LOAD A BASIC PROGRAM FROM DISK TO MEMORY
00120F  3               ;
00120F  3               ;__________________________________________________________
00120F  3               V_LOAD: ; load BASIC program
00120F  3               DOS65LOAD:
00120F  3  A9 00                LDA     #$00
001211  3  8D 10 13             STA     NullCounter
001214  3  20 CC 12             JSR     DOS65FCBPREP    ; parse parameters into FCB
001217  3  B0 1F                BCS     DOS65LOAD_ERR1  ; Error?, if so abort
001219  3  A2 0D                LDX     #13             ;
00121B  3  20 53 11             JSR     PEM             ;
00121E  3  A9 00                LDA     #0              ; clear
001220  3  8D 0A 17             STA     FCB+32          ; record number
001223  3  A9 EA                LDA     #<FCB           ; Open File
001225  3  A0 16                LDY     #>FCB           ;
001227  3  A2 0F                LDX     #15             ;
001229  3  20 53 11             JSR     PEM             ;
00122C  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
00122E  3  D0 0B                BNE     DOS65LOAD_1     ;
001230  3               DOS65LOAD_ERR:
001230  3  A2 24                LDX     #$24            ; IO ERROR
001232  3  20 0E 19             JSR     LAB_XERR
001235  3  4C E6 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001238  3               DOS65LOAD_ERR1:
001238  3  4C E7 1E             JMP     LAB_REM         ; comment out the remainder of the line (if any)
00123B  3               DOS65LOAD_1:
00123B  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
00123D  3  85 22                STA     FCBPTR+2        ; point to base of RAM
00123F  3  8D 0E 13             STA     EndOfBas        ;
001242  3  A5 7A                LDA     <Smemh          ;
001244  3  85 23                STA     FCBPTR+3        ;
001246  3  8D 0F 13             STA     EndOfBas+1      ;
001249  3  A9 6F                LDA     #<FCBBUFFER     ; SETUP BUFFER
00124B  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
00124D  3  A0 38                LDY     #>FCBBUFFER     ;
00124F  3  84 21                STY     FCBPTR+1        ; STORE DEST BUFFER IN FCBPTR
001251  3  A2 1A                LDX     #26             ; Setup Buffer
001253  3  20 53 11             JSR     PEM             ;
001256  3  4C 94 12             JMP     DOS65LOAD_3C
001259  3               DOS65LOAD_3:
001259  3  B1 20                LDA     (FCBPTR),Y      ; load from BUFFER
00125B  3  91 22                STA     (FCBPTR+2),Y    ; save to RAM
00125D  3  EE 0E 13             INC     EndOfBas
001260  3  D0 03                BNE     :+
001262  3  EE 0F 13             INC     EndOfBas+1
001265  3               :
001265  3  C9 00                CMP     #$00
001267  3  D0 0D                BNE     :+
001269  3  EE 10 13             INC     NullCounter
00126C  3  AD 10 13             LDA     NullCounter
00126F  3  C9 03                CMP     #3
001271  3  D0 08                BNE     :++
001273  3  4C A7 12             JMP     DOS65LOAD_4
001276  3               :
001276  3  A9 00                LDA     #$00
001278  3  8D 10 13             STA     NullCounter
00127B  3               :
00127B  3  C8                   INY                     ; bump index
00127C  3  C0 80                CPY     #$80            ; end of buffer?
00127E  3  D0 D9                BNE     DOS65LOAD_3     ; no, loop
001280  3  18                   CLC                     ;
001281  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
001283  3  69 80                ADC     #$80            ;
001285  3  85 22                STA     FCBPTR+2        ;
001287  3  90 0B                BCC     DOS65LOAD_3C    ; is carry?, no SKIP
001289  3  18                   CLC                     ; yes, carry, inc high byte
00128A  3  A5 23                LDA     FCBPTR+3        ;
00128C  3  69 01                ADC     #$01            ;
00128E  3  85 23                STA     FCBPTR+3        ;
001290  3  C9 B8                CMP     #>Ram_top       ; are we at the end of RAM?
001292  3  F0 13                BEQ     DOS65LOAD_4
001294  3               
001294  3               DOS65LOAD_3C:
001294  3  A9 EA                LDA     #<FCB           ; READ record buffer from disk file
001296  3  A0 16                LDY     #>FCB           ;
001298  3  A2 14                LDX     #20             ;
00129A  3  20 53 11             JSR     PEM             ;
00129D  3  A0 00                LDY     #$00            ; RESET INDEX
00129F  3  C9 00                CMP     #$00            ; is error or EOF
0012A1  3  F0 B6                BEQ     DOS65LOAD_3     ;
0012A3  3  C9 01                CMP     #$01            ; EOF?
0012A5  3  D0 89                BNE     DOS65LOAD_ERR   ; ERROR, do error handling
0012A7  3               DOS65LOAD_4:
0012A7  3  A9 EA                LDA     #<FCB           ;
0012A9  3  A0 16                LDY     #>FCB           ;
0012AB  3  A2 10                LDX     #16             ;
0012AD  3  20 53 11             JSR     PEM             ;
0012B0  3                                               ; setup pointers to return to basic
0012B0  3  AD 0E 13             LDA     EndOfBas
0012B3  3  85 7B                STA     Svarl
0012B5  3  85 7D                STA     Sarryl
0012B7  3  85 7F                STA     Earryl
0012B9  3  AD 0F 13             LDA     EndOfBas+1
0012BC  3  85 7C                STA     Svarh
0012BE  3  85 7E                STA     Sarryh
0012C0  3  85 80                STA     Earryh
0012C2  3  A9 7E                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
0012C4  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
0012C6  3  20 8E 20             JSR     LAB_18C3
0012C9  3  4C E6 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
0012CC  3               
0012CC  3               
0012CC  3               
0012CC  3               DOS65FCBPREP:
0012CC  3                       .IFDEF  DUODYNE
0012CC  3                       JSL     LAB_GBYT        ; scan memory
0012CC  3                       .ELSE
0012CC  3  20 C2 00             JSR     LAB_GBYT        ; scan memory
0012CF  3                       .ENDIF
0012CF  3               
0012CF  3  38                   SEC                     ;
0012D0  3  E9 40                SBC     #64             ; PARSE DRIVE NUMBER
0012D2  3  8D EA 16             STA     DOSDRIVE        ; STORE IT IN FCB
0012D5  3                       .IFDEF  DUODYNE
0012D5  3                       JSL     LAB_IGBY        ; increment and scan memory
0012D5  3                       .ELSE
0012D5  3  20 BC 00             JSR     LAB_IGBY        ; increment and scan memory
0012D8  3                       .ENDIF
0012D8  3               
0012D8  3  C9 3A                CMP     #':'            ;
0012DA  3  F0 08                BEQ     DOS65FCBPREP_1  ; YES, IT WAS A DRIVE, CONTINUE
0012DC  3  A2 26                LDX     #$26            ; IO ERROR
0012DE  3  20 0E 19             JSR     LAB_XERR
0012E1  3  4C E6 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
0012E4  3               
0012E4  3               DOS65FCBPREP_1:
0012E4  3  A9 EA                LDA     #<FCB           ; SETUP FCBPTR
0012E6  3  85 20                STA     FCBPTR          ;
0012E8  3  A9 16                LDA     #>FCB           ;
0012EA  3  85 21                STA     FCBPTR+1        ;
0012EC  3  A0 01                LDY     #$01            ; POINT Y TO FCB FILE NAME
0012EE  3  A9 20                LDA     #$20            ; LOAD SPACE CHAR INTO A
0012F0  3               DOS65FCBPREP_1A:                ; BLANK OUT FCB
0012F0  3  91 20                STAINDIRECTY FCBPTR     ;
0012F2  3  C8                   INY                     ;
0012F3  3  C0 09                CPY     #$09            ; IS DONE
0012F5  3  D0 F9                BNE     DOS65FCBPREP_1A ; NO, LOOP
0012F7  3  A0 01                LDY     #$01            ; POINT Y TO FCB FILE NAME
0012F9  3               DOS65FCBPREP_2:                 ; COPY FILE NAME PARAMETER INTO FCB
0012F9  3                       .IFDEF  DUODYNE
0012F9  3                       JSL     LAB_IGBY        ; increment and scan memory
0012F9  3                       .ELSE
0012F9  3  20 BC 00             JSR     LAB_IGBY        ; increment and scan memory
0012FC  3                       .ENDIF
0012FC  3  F0 0E                BEQ     DOS65FCBPREP_3  ;
0012FE  3  C9 2E                CMP     #'.'
