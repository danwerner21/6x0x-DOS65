001600  3  C8                   INY                     ;
001601  3  C0 21                CPY     #33             ;
001603  3  D0 F8                BNE     :-              ;
001605  3                                               ;
001605  3  A9 20                LDA     #32             ; FILL FILENAME AND EXTENSION WITH SPACES
001607  3  A0 01                LDY     #1              ;
001609  3               :
001609  3  99 FE 16             STA     FCB,Y           ;
00160C  3  C8                   INY                     ;
00160D  3  C0 0C                CPY     #12             ;
00160F  3  D0 F8                BNE     :-              ;
001611  3  A0 11                LDY     #17             ;
001613  3               :
