001478  3               ;___CLOSE____________________________________________________
001478  3               ;
001478  3               ; CLOSE A FILE
001478  3               ;
001478  3               ; BASIC COMMAND EXPECTS ONE VAR
001478  3               ;
001478  3               ; FILE$
001478  3               ;
001478  3               ; FILE$ = STRING HOLDING 33 BYTE FCB
001478  3               ;__________________________________________________________
001478  3               V_CLOSE:
001478  3  20 03 24             JSR     LAB_GVAR        ; GET THE FIRST PARAMETER
00147B  3  20 29 21             JSR     LAB_CTST        ; check if source is string, else do type mismatch
00147E  3  A0 02                LDY     #$02            ; index to string pointer high byte
001480  3  B1 95                LDAINDIRECTY Cvaral     ; get string pointer high byte
001482  3  85 FE                STA     TEMPW+1         ; set string pointer high byte
001484  3  88                   DEY                     ; index to string pointer low byte
001485  3  B1 95                LDAINDIRECTY Cvaral     ; get string pointer low byte
001487  3  85 FD                STA     TEMPW           ; set string pointer low byte
001489  3  A2 10                LDX     #16             ; CLOSE
00148B  3  A5 FD                LDA     TEMPW           ; FCB
00148D  3  A4 FE                LDY     TEMPW+1         ; FCB
00148F  3  20 4D 11             JSR     PEM
001492  3  C9 FF                CMP     #$FF
001494  3  D0 08                BNE     :+
001496  3  A2 24                LDX     #$24            ; IO ERROR
001498  3  20 94 17             JSR     LAB_XERR
00149B  3  4C 6C 18             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
00149E  3               :
00149E  3  60                   RTS
00149F  3               
