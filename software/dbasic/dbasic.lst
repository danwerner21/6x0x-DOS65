001377  3               ;___OPEN____________________________________________________
001377  3               ;
001377  3               ; OPEN A FILE
001377  3               ;
001377  3               ;
001377  3               ; BASIC COMMAND EXPECTS FOUR VARS
001377  3               
001377  3               ; DRIVE,MODE, FILENAME$,FILE$
001377  3               ;
001377  3               ; FILE$ = STRING TO HOLD 33 BYTE FCB
001377  3               ; DRIVE = NUMERIC DRIVE -- 0=A, 1=B, 2= . . .
001377  3               ; MODE = 0=EXISTING, 1=CREATE
001377  3               ; FILENAME$ = FILENAME STRING
001377  3               ;__________________________________________________________
001377  3               V_OPEN:
001377  3               ; CLEAR FCB
001377  3  A9 00                LDA     #0              ; FILL WITH NULL
001379  3  A0 00                LDY     #0              ;
00137B  3               :
00137B  3  99 4F 15             STA     FCB,Y           ;
00137E  3  C8                   INY                     ;
00137F  3  C0 21                CPY     #33             ;
001381  3  D0 F8                BNE     :-              ;
001383  3                                               ;
001383  3  A9 20                LDA     #32             ; FILL FILENAME AND EXTENSION WITH SPACES
001385  3  A0 01                LDY     #1              ;
001387  3               :
001387  3  99 4F 15             STA     FCB,Y           ;
00138A  3  C8                   INY                     ;
00138B  3  C0 0C                CPY     #12             ;
00138D  3  D0 F8                BNE     :-              ;
00138F  3                                               ;
00138F  3  20 B3 2A             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (DRIVE)
001392  3  8A                   TXA
001393  3  8D 4F 15             STA     FCB             ; STORE DRIVE IN FCB
001396  3                                               ;
001396  3  20 22 22             JSR     LAB_1C01        ; (AFTER ',') OR SYN ERR
001399  3  20 B3 2A             JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X (MODE)
00139C  3                                               ;
00139C  3  E0 00                CPX     #0
00139E  3  D0 08                BNE     :+
0013A0  3  A9 0F                LDA     #15
0013A2  3  8D 56 14             STA     OPNTMP
0013A5  3  4C AD 13             JMP     V_OPEN1
0013A8  3               :
0013A8  3  A9 16                LDA     #22
0013AA  3  8D 56 14             STA     OPNTMP          ;
0013AD  3               V_OPEN1:
0013AD  3  20 22 22             JSR     LAB_1C01        ; (AFTER ',') OR SYN ERR
0013B0  3  20 04 21             JSR     LAB_EVEX        ; GET THE THIRD PARAMETER
0013B3  3  A5 5F                LDA     <Dtypef         ; IS IT A STRING?
0013B5  3  D0 08                BNE     :+              ; YES, CONTINUE ON
0013B7  3  A2 02                LDX     #$02            ; NOPE, SYNTAX ERROR
0013B9  3  20 73 17             JSR     LAB_XERR
0013BC  3  4C 4B 18             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
0013BF  3               :
0013BF  3  20 65 29             JSR     LAB_22B6        ; pop string off descriptor stack, or from top of string
0013C2  3                                               ; space returns with A = length, X=$71=pointer low byte,
0013C2  3                                               ; Y=$72=pointer high byte
0013C2  3  85 AC                STA     str_ln          ; set string length
0013C4  3  86 AD                STX     str_pl          ; set string pointer low byte
0013C6  3  84 AE                STY     str_ph          ; set string pointer high byte
0013C8  3                                               ; STORE IN FILENAME AND EXTENSION
0013C8  3  A2 00                LDX     #0
0013CA  3  A0 00                LDY     #0
0013CC  3               :
0013CC  3  B1 AD                LDA     (str_pl),Y
0013CE  3  C9 2E                CMP     #'.'
0013D0  3  F0 1E                BEQ     V_OPEN_EXTENSION
0013D2  3  C4 AC                CPY     str_ln
0013D4  3  F0 35                BEQ     V_OPEN_FNEND
0013D6  3  C8                   INY
0013D7  3  99 4F 15             STA     FCB,Y
0013DA  3  C0 08                CPY     #8
0013DC  3  D0 EE                BNE     :-
0013DE  3               :
0013DE  3  C8                   INY
0013DF  3  B9 4F 15             LDA     FCB,Y
0013E2  3  C9 2E                CMP     #'.'
0013E4  3  F0 0A                BEQ     V_OPEN_EXTENSION
0013E6  3  C4 AC                CPY     str_ln
0013E8  3  F0 21                BEQ     V_OPEN_FNEND
0013EA  3  4C DE 13             JMP     :-
0013ED  3  4C 0B 14             JMP     V_OPEN_FNEND
0013F0  3               V_OPEN_EXTENSION:
0013F0  3  A2 09                LDX     #9
0013F2  3               :
0013F2  3  C8                   INY
0013F3  3  B1 AD                LDA     (str_pl),Y
0013F5  3  C4 AC                CPY     str_ln
