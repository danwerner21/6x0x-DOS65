00130A  3  20 3B 11             JSR     PEM             ;
00130D  3               
00130D  3                       .IFDEF  DUODYNE
00130D  3                       JSL     LAB_GBYT        ; scan memory
00130D  3                       .ELSE
00130D  3  20 C2 00             JSR     LAB_GBYT        ; scan memory
001310  3                       .ENDIF
001310  3               
