001098  2               
001098  2               LdKbBuffer:
001098  2               ; clear input buffer
001098  2                       LDX     #81
001098  2               :
001098  2                       LDA     #00
001098  2                       STA     Ibuffs-1,X
001098  2                       DEX
001098  2                       BNE     :-
001098  2               
001098  2                       LDY     CURY
001098  2               
001098  2                       STY     PTEMPW
001098  2                       LDA     #0
001098  2                       STA     PTEMPW+1
001098  2                       CLC
001098  2                       ASL     PTEMPW
001098  2                       ROL     PTEMPW+1        ; *2
001098  2                       ASL     PTEMPW
001098  2                       ROL     PTEMPW+1        ; *4
001098  2                       ASL     PTEMPW
001098  2                       ROL     PTEMPW+1        ; *8
001098  2                       LDA     PTEMPW
001098  2                       STA     PTEMPW1
001098  2                       LDA     PTEMPW+1
001098  2                       STA     PTEMPW1+1       ; PTEMPW1=Y*8
001098  2                       ASL     PTEMPW
001098  2                       ROL     PTEMPW+1        ; *16
001098  2                       ASL     PTEMPW
001098  2                       ROL     PTEMPW+1        ; *32
001098  2                                               ; TEMPW  = Y*8 + Y*32  (Y*40)
001098  2                       CLC                     ; Clear the Carry flag before the first addition
001098  2                       LDA     PTEMPW          ; Load the low byte of the first number into the accumulator
001098  2                       ADC     PTEMPW1         ; Add the low byte of the second number (plus carry)
001098  2                       STA     TEMPW           ; Store the low byte of the result
001098  2                       LDA     PTEMPW+1        ; Load the high byte of the first number
001098  2                       ADC     PTEMPW1+1       ; Add the high byte of the second number (plus carry from previous op)
001098  2                       STA     TEMPW+1         ; Store the high byte of the result
001098  2               
001098  2                       LDA     VIDEOWIDTH      ; If 80 col, double again
001098  2                       CMP     #80
001098  2                       BNE     :+
001098  2                       ASL     TEMPW
001098  2                       ROL     TEMPW+1         ; *2  (80)
001098  2               :
001098  2                       LDA     TEMPW+1
001098  2                       ORA     #$A0            ; add in the bank#
001098  2                       STA     TEMPW+1
001098  2               
001098  2                       LDY     #$01+VIDEOBANK  ; SCREEN AREA $1000-$1FFF
001098  2                       JSR     PAGE_ENTER
001098  2                       LDY     #0
001098  2               :
001098  2                       LDA     (TEMPW),Y
001098  2                       STA     Ibuffs,Y
001098  2                       INY
001098  2                       CPY     VIDEOWIDTH
001098  2                       BNE     :-
001098  2               
001098  2                       JSR     PAGE_EXIT
001098  2                       RTS
001098  2                       RTS
001098  2               
001098  2                       .ENDIF
