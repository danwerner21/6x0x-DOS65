003900  1               
003900  1  20 DA 2D             JSR     LAB_GTBY        ; get byte parameter
003903  1  8A                   TXA                     ; copy width to A
003904  1  F0 0A                BEQ     LAB_NSTT        ; branch if set for infinite line
003906  1               
003906  1  E0 10                CPX     #$10            ; else make min width = 16d
003908  1  90 45                BCC     TabErr          ; if less do function call error and exit
00390A  1               
00390A  1               ; this next compare ensures that we can't exit WIDTH via an error leaving the
00390A  1               ; tab size greater than the line length.
00390A  1               
00390A  1  E4 64                CPX     TabSiz          ; compare with tab size
00390C  1  B0 02                BCS     LAB_NSTT        ; branch if >= tab size
00390E  1               
00390E  1  86 64                STX     TabSiz          ; else make tab size = terminal width
003910  1               LAB_NSTT:
003910  1  86 0F                STX     TWidth          ; set the terminal width
003912  1                       .IFDEF  DUODYNE
003912  1                       JSL     LAB_GBYT        ; scan memory
003912  1                       .ELSE
003912  1  20 C2 00             JSR     LAB_GBYT        ; scan memory
003915  1                       .ENDIF
003915  1               
003915  1  F0 1A                BEQ     WExit           ; exit if no following
003917  1               
003917  1  C9 2C                CMP     #','            ; else is it ","
003919  1  D0 A9                BNE     LAB_MMSE        ; if not do syntax error
00391B  1               
00391B  1               LAB_TBSZ:
00391B  1  20 D7 2D             JSR     LAB_SGBY        ; scan and get byte parameter
00391E  1  8A                   TXA                     ; copy TAB size
00391F  1  30 2E                BMI     TabErr          ; if >127 do function call error and exit
003921  1               
003921  1  E0 01                CPX     #$01            ; compare with min-1
003923  1  90 2A                BCC     TabErr          ; if <=1 do function call error and exit
003925  1               
003925  1  A5 0F                LDA     TWidth          ; set flags for width
003927  1  F0 06                BEQ     LAB_SVTB        ; skip check if infinite line
003929  1               
003929  1  E4 0F                CPX     TWidth          ; compare TAB with width
00392B  1  F0 02                BEQ     LAB_SVTB        ; ok if =
00392D  1               
00392D  1  B0 20                BCS     TabErr          ; branch if too big
00392F  1               
00392F  1               LAB_SVTB:
00392F  1  86 64                STX     TabSiz          ; save TAB size
003931  1               
003931  1               ; calculate tab column limit from TAB size. The Iclim is set to the last tab
003931  1               ; position on a line that still has at least one whole tab width between it
003931  1               ; and the end of the line.
003931  1               
003931  1               WExit:
003931  1  A5 0F                LDA     TWidth          ; get width
003933  1  F0 06                BEQ     LAB_SULP        ; branch if infinite line
003935  1               
003935  1  C5 64                CMP     TabSiz          ; compare with tab size
003937  1  B0 03                BCS     LAB_WDLP        ; branch if >= tab size
003939  1               
003939  1  85 64                STA     TabSiz          ; else make tab size = terminal width
00393B  1               LAB_SULP:
00393B  1  38                   SEC                     ; set carry for subtract
00393C  1               LAB_WDLP:
00393C  1  E5 64                SBC     TabSiz          ; subtract tab size
00393E  1  B0 FC                BCS     LAB_WDLP        ; loop while no borrow
003940  1               
003940  1  65 64                ADC     TabSiz          ; add tab size back
003942  1  18                   CLC                     ; clear carry for add
003943  1  65 64                ADC     TabSiz          ; add tab size back again
003945  1  85 10                STA     Iclim           ; save for now
003947  1  A5 0F                LDA     TWidth          ; get width back
003949  1  38                   SEC                     ; set carry for subtract
00394A  1  E5 10                SBC     Iclim           ; subtract remainder
00394C  1  85 10                STA     Iclim           ; save tab column limit
00394E  1               LAB_NOSQ:
00394E  1  60                   RTS
00394F  1               
00394F  1               TabErr:
00394F  1  4C 75 28             JMP     LAB_FCER        ; do function call error then warm start
003952  1               
003952  1               ; perform SQR()
003952  1               
003952  1               LAB_SQR:
003952  1  A5 B0                LDA     FAC1_s          ; get FAC1 sign
003954  1  30 F9                BMI     TabErr          ; if -ve do function call error
003956  1               
003956  1  A5 AC                LDA     FAC1_e          ; get exponent
003958  1  F0 F4                BEQ     LAB_NOSQ        ; if zero just return
00395A  1               
00395A  1               ; else do root
00395A  1  20 20 32             JSR     LAB_27AB        ; round and copy FAC1 to FAC2
00395D  1  A9 00                LDA     #$00            ; clear A
00395F  1               
00395F  1  85 77                STA     FACt_3          ; clear remainder
003961  1  85 76                STA     FACt_2          ; ..
003963  1  85 75                STA     FACt_1          ; ..
003965  1  85 78                STA     TempB           ; ..
003967  1               
003967  1  85 AF                STA     FAC1_3          ; clear root
003969  1  85 AE                STA     FAC1_2          ; ..
00396B  1  85 AD                STA     FAC1_1          ; ..
