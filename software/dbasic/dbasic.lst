0013B9  3               ;
0013B9  3               ; OPEN A FILE
0013B9  3               ;
0013B9  3               ;
0013B9  3               ; BASIC COMMAND EXPECTS FOUR VARS
0013B9  3               
0013B9  3               ; DRIVE,MODE, FILENAME$,FILE$
0013B9  3               ;
0013B9  3               ; FILE$ = STRING TO HOLD 33 BYTE FCB
0013B9  3               ; DRIVE = NUMERIC DRIVE -- 0=CURRENT, 1=A, 2=B . . .
0013B9  3               ; MODE = 0=EXISTING, 1=CREATE
0013B9  3               ; FILENAME$ = FILENAME STRING
0013B9  3               ;__________________________________________________________
0013B9  3               V_OPEN:
0013B9  3               ; CLEAR FCB
0013B9  3  A9 00                LDA     #0              ; FILL WITH NULL
0013BB  3  A0 00                LDY     #0              ;
