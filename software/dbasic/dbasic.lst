00323E  1               
00323E  1  E4 0F                CPX     TWidth          ; compare TAB with width
003240  1  F0 02                BEQ     LAB_SVTB        ; ok if =
003242  1               
003242  1  B0 20                BCS     TabErr          ; branch if too big
003244  1               
003244  1               LAB_SVTB:
003244  1  86 64                STX     TabSiz          ; save TAB size
003246  1               
003246  1               ; calculate tab column limit from TAB size. The Iclim is set to the last tab
003246  1               ; position on a line that still has at least one whole tab width between it
003246  1               ; and the end of the line.
003246  1               
003246  1               WExit:
003246  1  A5 0F                LDA     TWidth          ; get width
003248  1  F0 06                BEQ     LAB_SULP        ; branch if infinite line
00324A  1               
