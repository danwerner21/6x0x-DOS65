0013C2  3               ;
0013C2  3               ; OPEN A FILE
0013C2  3               ;
0013C2  3               ;
0013C2  3               ; BASIC COMMAND EXPECTS FOUR VARS
0013C2  3               
0013C2  3               ; DRIVE,MODE, FILENAME$,FILE$
0013C2  3               ;
0013C2  3               ; FILE$ = STRING TO HOLD 33 BYTE FCB
0013C2  3               ; DRIVE = NUMERIC DRIVE -- 0=A, 1=B, 2= . . .
0013C2  3               ; MODE = 0=EXISTING, 1=CREATE
0013C2  3               ; FILENAME$ = FILENAME STRING
0013C2  3               ;__________________________________________________________
0013C2  3               V_OPEN:
0013C2  3               ; CLEAR FCB
0013C2  3  A9 00                LDA     #0              ; FILL WITH NULL
0013C4  3  A0 00                LDY     #0              ;
0013C6  3               :
0013C6  3  99 9A 15             STA     FCB,Y           ;
0013C9  3  C8                   INY                     ;
0013CA  3  C0 21                CPY     #33             ;
0013CC  3  D0 F8                BNE     :-              ;
0013CE  3                                               ;
0013CE  3  A9 20                LDA     #32             ; FILL FILENAME AND EXTENSION WITH SPACES
0013D0  3  A0 01                LDY     #1              ;
0013D2  3               :
0013D2  3  99 9A 15             STA     FCB,Y           ;
0013D5  3  C8                   INY                     ;
0013D6  3  C0 0C                CPY     #12             ;
0013D8  3  D0 F8                BNE     :-              ;
0013DA  3                                               ;
0013DA  3  20 FE 2A             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (DRIVE)
0013DD  3  8A                   TXA
0013DE  3  8D 9A 15             STA     FCB             ; STORE DRIVE IN FCB
0013E1  3                                               ;
0013E1  3  20 6D 22             JSR     LAB_1C01        ; (AFTER ',') OR SYN ERR
0013E4  3  20 FE 2A             JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X (MODE)
0013E7  3                                               ;
0013E7  3  E0 00                CPX     #0
0013E9  3  D0 08                BNE     :+
0013EB  3  A9 0F                LDA     #15
0013ED  3  8D A1 14             STA     OPNTMP
0013F0  3  4C F8 13             JMP     V_OPEN1
0013F3  3               :
0013F3  3  A9 16                LDA     #22
0013F5  3  8D A1 14             STA     OPNTMP          ;
