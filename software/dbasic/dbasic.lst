001098  2               ;
001098  2               ; Basic Screen editor code
001098  2               ;
001098  2               ;__________________________________________________________
001098  2               ScreenEditor:
001098  2               ; allow prepopulate of screen
001098  2               ploop:
001098  2                       LDA     #58
001098  2                       STA     farfunct
001098  2                       JSR     DO_FARCALL      ; PAINT cursor
001098  2               ploop1:
001098  2                       LDA     #20
001098  2                       STA     farfunct
001098  2                       JSR     DO_FARCALL      ; GET KEYSTROKE
001098  2                       CMP     #$FF
001098  2                       BEQ     ploop1
001098  2                       PHA
001098  2                       LDA     #59
001098  2                       STA     farfunct
001098  2                       JSR     DO_FARCALL      ; UNPAINT cursor
001098  2                       PLA
001098  2                       CMP     #$F6
001098  2                       BEQ     crsrup
001098  2                       CMP     #$F7
001098  2                       BEQ     crsrdn
001098  2                       CMP     #$F8
001098  2                       BEQ     crsrlt
001098  2                       CMP     #$F9
001098  2                       BEQ     Lcrsrrt
001098  2                       CMP     #$0A
001098  2                       BEQ     ploop
001098  2                       CMP     #13
001098  2                       BEQ     Lpexit
001098  2               
001098  2                       PHA
001098  2                       LDA     #19
001098  2                       STA     farfunct
001098  2                       PLA
001098  2                       JSR     DO_FARCALL
001098  2                       JMP     ploop
001098  2               Lpexit:
001098  2                       JMP     pexit
001098  2               Lcrsrrt:
001098  2                       JMP     crsrrt
001098  2               
001098  2               crsrup:
001098  2                       LDA     CURY
001098  2                       CMP     #00
001098  2                       BEQ     ploop
001098  2                       DEC     CURY
001098  2                       JMP     ploop
001098  2               crsrdn:
001098  2                       LDA     CURY
001098  2                       CMP     #23
001098  2                       BEQ     crsrdn_1
001098  2                       INC     CURY
001098  2                       JMP     ploop
001098  2               crsrdn_1:
001098  2                       LDA     #56
001098  2                       STA     farfunct
001098  2                       JSR     DO_FARCALL
001098  2                       JMP     ploop
001098  2               crsrlt:
001098  2                       LDA     CURX
001098  2                       CMP     #00
001098  2                       BEQ     crsrlt_1
001098  2                       DEC     CURX
001098  2                       JMP     ploop
001098  2               crsrlt_1:
001098  2                       LDA     CURY
001098  2                       CMP     #00
001098  2                       BEQ     :+
001098  2                       LDX     VIDEOWIDTH
001098  2                       DEX
001098  2                       STX     CURX
001098  2                       LDY     CURY
001098  2                       DEY
001098  2                       STY     CURY
001098  2               :
001098  2                       JMP     ploop
001098  2               crsrrt:
001098  2                       LDX     VIDEOWIDTH
001098  2                       DEX
001098  2                       CPX     CURX
001098  2                       BEQ     crsrrt_1
001098  2                       INC     CURX
001098  2                       JMP     ploop
001098  2               crsrrt_1:
001098  2                       LDA     #00
001098  2                       STA     CURX
001098  2                       JMP     crsrdn
001098  2               pexit:
001098  2                       JSR     LdKbBuffer
001098  2                       LDX     #80
001098  2                       LDA     #$00
001098  2                       STA     Ibuffs,X
001098  2               TERMLOOP:
001098  2                       DEX
001098  2                       LDA     Ibuffs,X
001098  2                       CMP     #32
001098  2                       BEQ     TERMLOOP_B
001098  2                       CMP     #00
001098  2                       BEQ     TERMLOOP_C
001098  2                       JMP     TERMLOOP_A
001098  2               TERMLOOP_B:
001098  2                       LDA     #00
001098  2                       STA     Ibuffs,X
001098  2               TERMLOOP_C:
001098  2                       CPX     #00
001098  2                       BNE     TERMLOOP
001098  2               TERMLOOP_A:
001098  2                       LDA     #19
001098  2                       STA     farfunct
001098  2                       LDA     #13
001098  2                       JSR     DO_FARCALL
001098  2                       LDA     #19
001098  2                       STA     farfunct
001098  2                       LDA     #10
001098  2                       JSR     DO_FARCALL
