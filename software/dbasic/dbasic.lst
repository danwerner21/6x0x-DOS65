0036AC  1               LAB_VARPTR:
0036AC  1                       .IFDEF  DUODYNE
0036AC  1                       JSL     LAB_IGBY        ; increment and scan memory
0036AC  1                       .ELSE
0036AC  1  20 BC 00             JSR     LAB_IGBY        ; increment and scan memory
0036AF  1                       .ENDIF
0036AF  1               
0036AF  1  20 C3 23             JSR     LAB_GVAR        ; get var address
0036B2  1  20 06 22             JSR     LAB_1BFB        ; scan for ")" , else do syntax error then warm start
0036B5  1  A4 95                LDY     Cvaral          ; get var address low byte
0036B7  1  A5 96                LDA     Cvarah          ; get var address high byte
0036B9  1  4C 72 26             JMP     LAB_AYFC        ; save and convert integer AY to FAC1 and return
0036BC  1               
0036BC  1               ; perform PI
0036BC  1               
0036BC  1               LAB_PI:
0036BC  1  A9 E7                LDA     #<LAB_2C7C      ; set (2*pi) pointer low byte
0036BE  1  A0 0F                LDY     #>LAB_2C7C      ; set (2*pi) pointer high byte
0036C0  1  20 A0 2E             JSR     LAB_UFAC        ; unpack memory (AY) into FAC1
0036C3  1  C6 AC                DEC     FAC1_e          ; make result = PI
0036C5  1  60                   RTS
0036C6  1               
0036C6  1               ; perform TWOPI
0036C6  1               
0036C6  1               LAB_TWOPI:
0036C6  1  A9 E7                LDA     #<LAB_2C7C      ; set (2*pi) pointer low byte
0036C8  1  A0 0F                LDY     #>LAB_2C7C      ; set (2*pi) pointer high byte
0036CA  1  4C A0 2E             JMP     LAB_UFAC        ; unpack memory (AY) into FAC1 and return
0036CD  1               
