00136B  3               ;___OPEN____________________________________________________
00136B  3               ;
00136B  3               ; OPEN A FILE
00136B  3               ;
00136B  3               ;
00136B  3               ; BASIC COMMAND EXPECTS FOUR VARS
00136B  3               
00136B  3               ; DRIVE,MODE, FILENAME$,FILE$
00136B  3               ;
00136B  3               ; FILE$ = STRING TO HOLD 33 BYTE FCB
00136B  3               ; DRIVE = NUMERIC DRIVE -- 0=A, 1=B, 2= . . .
00136B  3               ; MODE = 0=EXISTING, 1=CREATE
00136B  3               ; FILENAME$ = FILENAME STRING
00136B  3               ;__________________________________________________________
00136B  3               V_OPEN:
00136B  3               ; CLEAR FCB
00136B  3  A9 00                LDA     #0              ; FILL WITH NULL
00136D  3  A0 00                LDY     #0              ;
00136F  3               :
00136F  3  99 43 15             STA     FCB,Y           ;
001372  3  C8                   INY                     ;
001373  3  C0 21                CPY     #33             ;
001375  3  D0 F8                BNE     :-              ;
001377  3                                               ;
001377  3  A9 20                LDA     #32             ; FILL FILENAME AND EXTENSION WITH SPACES
001379  3  A0 01                LDY     #1              ;
00137B  3               :
00137B  3  99 43 15             STA     FCB,Y           ;
00137E  3  C8                   INY                     ;
00137F  3  C0 0C                CPY     #12             ;
001381  3  D0 F8                BNE     :-              ;
001383  3                                               ;
001383  3  20 A7 2A             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (DRIVE)
001386  3  8A                   TXA
001387  3  8D 43 15             STA     FCB             ; STORE DRIVE IN FCB
00138A  3                                               ;
00138A  3  20 16 22             JSR     LAB_1C01        ; (AFTER ',') OR SYN ERR
00138D  3  20 A7 2A             JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X (MODE)
001390  3                                               ;
001390  3  E0 00                CPX     #0
001392  3  D0 08                BNE     :+
001394  3  A9 0F                LDA     #15
001396  3  8D 4A 14             STA     OPNTMP
001399  3  4C A1 13             JMP     V_OPEN1
00139C  3               :
00139C  3  A9 16                LDA     #22
00139E  3  8D 4A 14             STA     OPNTMP          ;
0013A1  3               V_OPEN1:
0013A1  3  20 16 22             JSR     LAB_1C01        ; (AFTER ',') OR SYN ERR
0013A4  3  20 F8 20             JSR     LAB_EVEX        ; GET THE THIRD PARAMETER
0013A7  3  A5 5F                LDA     <Dtypef         ; IS IT A STRING?
0013A9  3  D0 08                BNE     :+              ; YES, CONTINUE ON
0013AB  3  A2 02                LDX     #$02            ; NOPE, SYNTAX ERROR
0013AD  3  20 67 17             JSR     LAB_XERR
0013B0  3  4C 3F 18             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
0013B3  3               :
0013B3  3  20 59 29             JSR     LAB_22B6        ; pop string off descriptor stack, or from top of string
0013B6  3                                               ; space returns with A = length, X=$71=pointer low byte,
0013B6  3                                               ; Y=$72=pointer high byte
0013B6  3  85 AC                STA     str_ln          ; set string length
0013B8  3  86 AD                STX     str_pl          ; set string pointer low byte
0013BA  3  84 AE                STY     str_ph          ; set string pointer high byte
0013BC  3                                               ; STORE IN FILENAME AND EXTENSION
0013BC  3  A2 00                LDX     #0
0013BE  3  A0 00                LDY     #0
0013C0  3               :
0013C0  3  B1 AD                LDA     (str_pl),Y
0013C2  3  C9 2E                CMP     #'.'
0013C4  3  F0 1E                BEQ     V_OPEN_EXTENSION
0013C6  3  C4 AC                CPY     str_ln
0013C8  3  F0 35                BEQ     V_OPEN_FNEND
0013CA  3  C8                   INY
0013CB  3  99 43 15             STA     FCB,Y
0013CE  3  C0 08                CPY     #8
0013D0  3  D0 EE                BNE     :-
0013D2  3               :
