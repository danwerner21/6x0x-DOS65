0037C9  1  20 8F 30             JSR     LAB_27AB        ; round and copy FAC1 to FAC2
0037CC  1  A9 00                LDA     #$00            ; clear A
0037CE  1               
0037CE  1  85 77                STA     FACt_3          ; clear remainder
0037D0  1  85 76                STA     FACt_2          ; ..
0037D2  1  85 75                STA     FACt_1          ; ..
0037D4  1  85 78                STA     TempB           ; ..
0037D6  1               
0037D6  1  85 AF                STA     FAC1_3          ; clear root
