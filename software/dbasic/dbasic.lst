0010E7  2  8E 38 11             STX     TTX
0010EA  2  8C 39 11             STY     TTY
0010ED  2  8D 3A 11             STA     TTA
0010F0  2  A9 20                LDA     #32
0010F2  2  20 3B 11             JSR     WRSER1          ; output upper nybble
0010F5  2  AE 38 11             LDX     TTX
0010F8  2  AC 39 11             LDY     TTY
0010FB  2  AD 3A 11             LDA     TTA
0010FE  2  60                   RTS
0010FF  2               
0010FF  2               
0010FF  2               PRINT_BYTE:
0010FF  2  8E 38 11             STX     TTX
001102  2  8C 39 11             STY     TTY
001105  2  8D 3A 11             STA     TTA
001108  2  8E 37 11             STX     SAVX            ; save X
00110B  2  20 22 11             JSR     ASCTWO          ; get hex chars for byte in X (lower) and A (upper)
00110E  2  20 3B 11             JSR     WRSER1          ; output upper nybble
001111  2  8A                   TXA                     ; transfer lower to A
001112  2  AE 37 11             LDX     SAVX            ; restore X
001115  2  20 3B 11             JSR     WRSER1          ; output lower nybble
001118  2  AE 38 11             LDX     TTX
00111B  2  AC 39 11             LDY     TTY
00111E  2  AD 3A 11             LDA     TTA
001121  2  60                   RTS
001122  2               ASCTWO:
001122  2  48                   PHA                     ; save byte
001123  2  20 2C 11             JSR     ASCII           ; do low nybble
001126  2  AA                   TAX                     ; save in X
001127  2  68                   PLA                     ; restore byte
001128  2  4A                   LSR     A               ; shift upper nybble down
001129  2  4A                   LSR     A
00112A  2  4A                   LSR     A
00112B  2  4A                   LSR     A
00112C  2               ; convert low nybble in A to hex digit
00112C  2               ASCII:
00112C  2  29 0F                AND     #$0F            ; clear upper nibble
00112E  2  C9 0A                CMP     #$0A            ; if less than A, skip next step
001130  2  90 02                BCC     ASC1
001132  2  69 06                ADC     #6              ; skip ascii chars between 9 and A
001134  2               ASC1:
001134  2  69 30                ADC     #$30            ; add ascii char 0 to value
001136  2  60                   RTS
001137  2               SAVX:
001137  2  00                   .BYTE   00
001138  2               TTX:
001138  2  00                   .BYTE   00
001139  2               TTY:
001139  2  00                   .BYTE   00
00113A  2               TTA:
00113A  2  00                   .BYTE   00
00113B  2               ;__WRSER1________________________________________________________________________________________________________________________
00113B  2               ;
00113B  2               ;	WRITE CHARACTER(A) TO UART
00113B  2               ;________________________________________________________________________________________________________________________________
00113B  2               ;
00113B  2               WRSER1:
00113B  2  48                   PHA
00113C  2               WRSER1a:
00113C  2  AD 85 EF             LDA     UART1STATUS     ; GET STATUS
00113F  2  29 10                AND     #%00010000      ; IS TX READY
001141  2  F0 F9                BEQ     WRSER1a         ; NO, WAIT FOR IT
001143  2  68                   PLA
001144  2  8D 84 EF             STA     UART1DATA       ; WRITE DATA
001147  2  60                   RTS
