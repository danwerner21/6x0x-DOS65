00161D  3               LAB_YEAR:
00161D  3  A2 06                LDX     #RTCYEAR
00161F  3  A9 33                LDA     #51
001621  3  85 32                STA     farfunct
001623  3  20 F0 FF             JSR     DO_FARCALL
001626  3  98                   TYA
001627  3  20 36 16             JSR     BCD_TO_HEX
00162A  3  A9 00                LDA     #0              ; Get high byte
00162C  3  20 7E 26             JSR     LAB_AYFC
