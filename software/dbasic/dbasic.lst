0010AC  2               PRINT_CRLF:
0010AC  2  8E 1A 11             STX     TTX
0010AF  2  8C 1B 11             STY     TTY
0010B2  2  8D 1C 11             STA     TTA
0010B5  2  A9 0D                LDA     #13
0010B7  2  20 1D 11             JSR     WRSER1          ; output upper nybble
0010BA  2  A9 0A                LDA     #10
0010BC  2  20 1D 11             JSR     WRSER1          ; output upper nybble
0010BF  2  AE 1A 11             LDX     TTX
0010C2  2  AC 1B 11             LDY     TTY
0010C5  2  AD 1C 11             LDA     TTA
0010C8  2  60                   RTS
0010C9  2               
0010C9  2               PRINT_SPACE:
0010C9  2  8E 1A 11             STX     TTX
0010CC  2  8C 1B 11             STY     TTY
0010CF  2  8D 1C 11             STA     TTA
0010D2  2  A9 20                LDA     #32
0010D4  2  20 1D 11             JSR     WRSER1          ; output upper nybble
0010D7  2  AE 1A 11             LDX     TTX
0010DA  2  AC 1B 11             LDY     TTY
0010DD  2  AD 1C 11             LDA     TTA
0010E0  2  60                   RTS
0010E1  2               
0010E1  2               
0010E1  2               PRINT_BYTE:
0010E1  2  8E 1A 11             STX     TTX
0010E4  2  8C 1B 11             STY     TTY
0010E7  2  8D 1C 11             STA     TTA
0010EA  2  8E 19 11             STX     SAVX            ; save X
0010ED  2  20 04 11             JSR     ASCTWO          ; get hex chars for byte in X (lower) and A (upper)
0010F0  2  20 1D 11             JSR     WRSER1          ; output upper nybble
0010F3  2  8A                   TXA                     ; transfer lower to A
0010F4  2  AE 19 11             LDX     SAVX            ; restore X
0010F7  2  20 1D 11             JSR     WRSER1          ; output lower nybble
0010FA  2  AE 1A 11             LDX     TTX
0010FD  2  AC 1B 11             LDY     TTY
001100  2  AD 1C 11             LDA     TTA
001103  2  60                   RTS
001104  2               ASCTWO:
001104  2  48                   PHA                     ; save byte
001105  2  20 0E 11             JSR     ASCII           ; do low nybble
001108  2  AA                   TAX                     ; save in X
001109  2  68                   PLA                     ; restore byte
00110A  2  4A                   LSR     A               ; shift upper nybble down
00110B  2  4A                   LSR     A
00110C  2  4A                   LSR     A
00110D  2  4A                   LSR     A
00110E  2               ; convert low nybble in A to hex digit
00110E  2               ASCII:
00110E  2  29 0F                AND     #$0F            ; clear upper nibble
001110  2  C9 0A                CMP     #$0A            ; if less than A, skip next step
001112  2  90 02                BCC     ASC1
001114  2  69 06                ADC     #6              ; skip ascii chars between 9 and A
001116  2               ASC1:
001116  2  69 30                ADC     #$30            ; add ascii char 0 to value
001118  2  60                   RTS
001119  2               SAVX:
001119  2  00                   .BYTE   00
00111A  2               TTX:
00111A  2  00                   .BYTE   00
00111B  2               TTY:
00111B  2  00                   .BYTE   00
00111C  2               TTA:
00111C  2  00                   .BYTE   00
00111D  2               ;__WRSER1________________________________________________________________________________________________________________________
00111D  2               ;
00111D  2               ;	WRITE CHARACTER(A) TO UART
00111D  2               ;________________________________________________________________________________________________________________________________
00111D  2               ;
00111D  2               WRSER1:
00111D  2  48                   PHA
00111E  2               WRSER1a:
00111E  2  AD 85 EF             LDA     UART1STATUS     ; GET STATUS
001121  2  29 10                AND     #%00010000      ; IS TX READY
001123  2  F0 F9                BEQ     WRSER1a         ; NO, WAIT FOR IT
001125  2  68                   PLA
001126  2  8D 84 EF             STA     UART1DATA       ; WRITE DATA
001129  2  60                   RTS
