0037F9  1  26 76                ROL     FACt_2          ; ..
0037FB  1  26 75                ROL     FACt_1          ; ..
0037FD  1  26 78                ROL     TempB           ; .. never overflows
0037FF  1               
0037FF  1  06 AF                ASL     FAC1_3          ; root = root * 2
003801  1  26 AE                ROL     FAC1_2          ; ..
003803  1  26 AD                ROL     FAC1_1          ; .. never overflows
003805  1               
003805  1  A5 AF                LDA     FAC1_3          ; get root low byte
003807  1  2A                   ROL     A               ; *2
003808  1  85 5B                STA     Temp3           ; save partial low byte
00380A  1  A5 AE                LDA     FAC1_2          ; get root low mid byte
00380C  1  2A                   ROL     A               ; *2
00380D  1  85 5C                STA     Temp3+1         ; save partial low mid byte
00380F  1  A5 AD                LDA     FAC1_1          ; get root high mid byte
