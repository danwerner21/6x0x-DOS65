001166  2               WRSER1a:
001166  2  AD 85 EF             LDA     UART1STATUS     ; GET STATUS
001169  2  29 10                AND     #%00010000      ; IS TX READY
00116B  2  F0 F9                BEQ     WRSER1a         ; NO, WAIT FOR IT
00116D  2  68                   PLA
00116E  2  8D 84 EF             STA     UART1DATA       ; WRITE DATA
001171  2  60                   RTS
