0039C1  1               
0039C1  1  85 78                STA     TempB           ; save remainder high byte
0039C3  1               
0039C3  1  84 75                STY     FACt_1          ; save remainder high mid byte
0039C5  1               
0039C5  1  A5 5C                LDA     Temp3+1         ; get remainder low mid byte
0039C7  1  85 76                STA     FACt_2          ; save remainder low mid byte
0039C9  1               
