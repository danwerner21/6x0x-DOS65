00117A  3               
00117A  3               DBGX:
00117A  3  00                   .BYTE   0
00117B  3               DBGY:
00117B  3  00                   .BYTE   0
00117C  3               DBGA:
00117C  3  00                   .BYTE   0
00117D  3               
00117D  3               PEM:
