0010B0  2               ScreenEditor:
0010B0  2               ; allow prepopulate of screen
0010B0  2               ploop:
0010B0  2                       LDA     #58
0010B0  2                       STA     farfunct
0010B0  2                       JSR     DO_FARCALL      ; PAINT cursor
0010B0  2               ploop1:
0010B0  2                       LDA     #20
0010B0  2                       STA     farfunct
0010B0  2                       JSR     DO_FARCALL      ; GET KEYSTROKE
0010B0  2                       CMP     #$FF
0010B0  2                       BEQ     ploop1
0010B0  2                       PHA
0010B0  2                       LDA     #59
0010B0  2                       STA     farfunct
0010B0  2                       JSR     DO_FARCALL      ; UNPAINT cursor
0010B0  2                       PLA
0010B0  2                       CMP     #$F6
0010B0  2                       BEQ     crsrup
0010B0  2                       CMP     #$F7
0010B0  2                       BEQ     crsrdn
0010B0  2                       CMP     #$F8
0010B0  2                       BEQ     crsrlt
0010B0  2                       CMP     #$F9
0010B0  2                       BEQ     Lcrsrrt
0010B0  2                       CMP     #$0A
0010B0  2                       BEQ     ploop
0010B0  2                       CMP     #13
0010B0  2                       BEQ     Lpexit
