0038F3  1  85 B7                STA     FAC2_s          ; save FAC2 sign
0038F5  1               
0038F5  1               ; compare FAC1 with (packed) FAC2
0038F5  1  A9 B3                LDA     #<FAC2_e        ; set pointer low byte to FAC2
0038F7  1  A0 00                LDY     #>FAC2_e        ; set pointer high byte to FAC2
