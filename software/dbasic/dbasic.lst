0012C8  3                       JSL     LAB_GBYT        ; scan memory
0012C8  3                       .ELSE
0012C8  3  20 C2 00             JSR     LAB_GBYT        ; scan memory
0012CB  3                       .ENDIF
0012CB  3               
0012CB  3  38                   SEC                     ;
0012CC  3  E9 40                SBC     #64             ; PARSE DRIVE NUMBER
0012CE  3  8D 70 15             STA     DOSDRIVE        ; STORE IT IN FCB
0012D1  3                       .IFDEF  DUODYNE
0012D1  3                       JSL     LAB_IGBY        ; increment and scan memory
0012D1  3                       .ELSE
0012D1  3  20 BC 00             JSR     LAB_IGBY        ; increment and scan memory
0012D4  3                       .ENDIF
