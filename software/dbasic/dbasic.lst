0015E1  3               ;
0015E1  3               ;__________________________________________________________
0015E1  3               LAB_FILTER:
0015E1  3                       JSR     LAB_EVNM        ; evaluate expression and check is numeric,
0015E1  3                                               ; else do type mismatch
0015E1  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
0015E1  3                                               ; SET CUTOFF
0015E1  3                       LDA     Itempl
0015E1  3                       STA     SID_BASE+$15
0015E1  3                       LDA     Itemph
0015E1  3                       STA     SID_BASE+$16
0015E1  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
0015E1  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (RESONANCE)
0015E1  3                       TXA
0015E1  3                       LSR     A
0015E1  3                       LSR     A
0015E1  3                       LSR     A
0015E1  3                       LSR     A
0015E1  3                       STA     PTEMPW
0015E1  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
0015E1  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 1 ENABLE)
0015E1  3                       TXA
0015E1  3                       AND     #1
0015E1  3                       ORA     PTEMPW
0015E1  3                       STA     PTEMPW
0015E1  3                       JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
0015E1  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 2 ENABLE)
0015E1  3                       TXA
0015E1  3                       AND     #1
0015E1  3                       LSR     A
0015E1  3                       ORA     PTEMPW
0015E1  3                       STA     PTEMPW
0015E1  3                       JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
0015E1  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 3 ENABLE)
0015E1  3                       TXA
0015E1  3                       AND     #1
0015E1  3                       LSR     A
0015E1  3                       LSR     A
0015E1  3                       ORA     PTEMPW
0015E1  3                       STA     PTEMPW
0015E1  3                       JSR     LAB_1C01        ; GET THE SIXTH PARAMETER (AFTER ',') OR SYN ERR
0015E1  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (EXTERNAL AUDIO ENABLE)
0015E1  3                       TXA
0015E1  3                       AND     #1
0015E1  3                       LSR     A
0015E1  3                       LSR     A
0015E1  3                       LSR     A
0015E1  3                       ORA     PTEMPW
0015E1  3                       STA     SID_BASE+$17
0015E1  3                       JSR     LAB_1C01        ; GET THE SEVENTH PARAMETER (AFTER ',') OR SYN ERR
0015E1  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (FILTER MODE)
0015E1  3                       TXA
0015E1  3                       LSR     A
0015E1  3                       LSR     A
0015E1  3                       LSR     A
0015E1  3                       LSR     A
0015E1  3                       STA     PTEMPW
0015E1  3                       JSR     LAB_1C01        ; GET THE EIGHTH PARAMETER (AFTER ',') OR SYN ERR
0015E1  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOLUME)
0015E1  3                       TXA
0015E1  3                       AND     #$0F
0015E1  3                       ORA     PTEMPW
0015E1  3                       STA     SID_BASE+$18
0015E1  3                       RTS
0015E1  3               
0015E1  3                       .ELSE
