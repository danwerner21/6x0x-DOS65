001141  3               ;___SAVE____________________________________________________
001141  3               ;
001141  3               ; SAVE COMMAND
001141  3               ;
001141  3               ;  SAVE THE BASIC PROGRAM IN MEMORY TO DISK
001141  3               ;
001141  3               ;__________________________________________________________
001141  3               V_SAVE: ; save BASIC program
001141  3               DOS65SAVE:
001141  3  20 B4 12             JSR     DOS65FCBPREP    ; parse parameters into FCB
001144  3  B0 28                BCS     DOS65SAVE_ERR1  ; Error?, if so abort
001146  3  A2 0D                LDX     #13             ;
001148  3  20 3B 11             JSR     PEM             ;
00114B  3  A9 4F                LDA     #<FCB           ; CREATE File
00114D  3  A0 15                LDY     #>FCB           ;
00114F  3  A2 16                LDX     #22             ;
001151  3  20 3B 11             JSR     PEM             ;
001154  3  A9 00                LDA     #0              ; clear
001156  3  8D 6F 15             STA     FCB+32          ; record number
001159  3  A9 4F                LDA     #<FCB           ; Open File
00115B  3  A0 15                LDY     #>FCB           ;
00115D  3  A2 0F                LDX     #15             ;
00115F  3  20 3B 11             JSR     PEM             ;
001162  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
001164  3  D0 0B                BNE     DOS65SAVE_1     ;
001166  3               DOS65SAVE_ERR:
001166  3  A2 24                LDX     #$24            ; IO ERROR
001168  3  20 73 17             JSR     LAB_XERR
00116B  3  4C 4B 18             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
00116E  3               DOS65SAVE_ERR1:
00116E  3  4C 4F 1D             JMP     LAB_REM         ; comment out the remainder of the line (if any)
001171  3               DOS65SAVE_1:
001171  3  A9 D9                LDA     #<FCBBUFFER     ; SETUP BUFFER
001173  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
001175  3  A0 36                LDY     #>FCBBUFFER     ;
001177  3  84 21                STY     FCBPTR+1        ;
001179  3  A2 1A                LDX     #26             ; Setup Buffer
00117B  3  20 3B 11             JSR     PEM             ;
00117E  3               DOS65SAVE_2:
00117E  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
001180  3  85 22                STA     FCBPTR+2        ; point to base of RAM
001182  3  A5 7A                LDA     <Smemh          ;
001184  3  85 23                STA     FCBPTR+3        ;
001186  3  A2 00                LDX     #$00            ; x=0 (null counter)
001188  3               DOS65SAVE_2A:
001188  3  A0 00                LDY     #$00            ; y=0 (Loop Index)
00118A  3               DOS65SAVE_3:
00118A  3  B1 22                LDA     (FCBPTR+2),Y    ; load from RAM
00118C  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
00118E  3  C9 00                CMP     #$00            ; is Zero?
001190  3  D0 1E                BNE     DOS65SAVE_3A    ; No, continue
001192  3  E8                   INX                     ; yes, bump Null Counter
001193  3  E0 03                CPX     #$03            ; Three nulls in a row?
001195  3  D0 1B                BNE     DOS65SAVE_3B    ; No, continue
001197  3                                               ; FINISH FILLING BUFFER WITH NULLS
001197  3               :
001197  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
001199  3  C8                   INY                     ; bump index
00119A  3  C0 80                CPY     #$80            ; end of buffer?
00119C  3  D0 F9                BNE     :-              ; no, loop
00119E  3  A9 4F                LDA     #<FCB           ; Write record in buffer to disk file AND END
0011A0  3  A0 15                LDY     #>FCB           ;
0011A2  3  A2 15                LDX     #21             ;
0011A4  3  20 3B 11             JSR     PEM             ;
0011A7  3  29 FE                AND     #$FE            ; strip out extension
0011A9  3  C9 00                CMP     #$00            ; is error
0011AB  3  D0 B9                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
0011AD  3  4C DD 11             JMP     DOS65SAVE_4
0011B0  3               DOS65SAVE_3A:                   ;
0011B0  3  A2 00                LDX     #$00            ; prior char not null, reset null counter
0011B2  3               DOS65SAVE_3B:                   ;
0011B2  3  C8                   INY                     ; bump index
0011B3  3  C0 80                CPY     #$80            ; end of buffer?
0011B5  3  D0 D3                BNE     DOS65SAVE_3     ; no, loop
0011B7  3               DOS65SAVE_3C:
0011B7  3  A9 4F                LDA     #<FCB           ; Write record in buffer to disk file
0011B9  3  A0 15                LDY     #>FCB           ;
0011BB  3  A2 15                LDX     #21             ;
0011BD  3  20 3B 11             JSR     PEM             ;
0011C0  3  29 FE                AND     #$FE            ; strip out extension
0011C2  3  C9 00                CMP     #$00            ; is error
0011C4  3  D0 A0                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
0011C6  3  18                   CLC                     ;
0011C7  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
0011C9  3  69 80                ADC     #$80            ;
0011CB  3  85 22                STA     FCBPTR+2        ;
0011CD  3  90 B9                BCC     DOS65SAVE_2A    ; is carry?, no loop
0011CF  3  18                   CLC                     ; yes, carry, inc high byte
0011D0  3  A5 23                LDA     FCBPTR+3        ;
0011D2  3  69 01                ADC     #$01            ;
0011D4  3  85 23                STA     FCBPTR+3        ;
0011D6  3  C9 B8                CMP     #>Ram_top       ; are we at the end of RAM?
0011D8  3  F0 03                BEQ     DOS65SAVE_4
0011DA  3  4C 88 11             JMP     DOS65SAVE_2A
0011DD  3               DOS65SAVE_4:
0011DD  3  A9 4F                LDA     #<FCB           ;
0011DF  3  A0 15                LDY     #>FCB           ;
0011E1  3  A2 10                LDX     #16             ;
0011E3  3  20 3B 11             JSR     PEM             ;
0011E6  3  C9 FF                CMP     #$FF            ;
0011E8  3  D0 03                BNE     DOS65SAVE_5     ;
0011EA  3  4C 66 11             JMP     DOS65SAVE_ERR   ; ERROR, DISPLAY IT
0011ED  3               DOS65SAVE_5:
0011ED  3  A9 66                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
0011EF  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
0011F1  3  20 F6 1E             JSR     LAB_18C3
0011F4  3  4C 4B 18             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
0011F7  3               
0011F7  3               ;___LOAD____________________________________________________
0011F7  3               ;
0011F7  3               ; LOAD COMMAND
0011F7  3               ;
0011F7  3               ;  LOAD A BASIC PROGRAM FROM DISK TO MEMORY
0011F7  3               ;
0011F7  3               ;__________________________________________________________
0011F7  3               V_LOAD: ; load BASIC program
0011F7  3               DOS65LOAD:
0011F7  3  A9 00                LDA     #$00
0011F9  3  8D F8 12             STA     NullCounter
0011FC  3  20 B4 12             JSR     DOS65FCBPREP    ; parse parameters into FCB
0011FF  3  B0 1F                BCS     DOS65LOAD_ERR1  ; Error?, if so abort
001201  3  A2 0D                LDX     #13             ;
001203  3  20 3B 11             JSR     PEM             ;
001206  3  A9 00                LDA     #0              ; clear
001208  3  8D 6F 15             STA     FCB+32          ; record number
00120B  3  A9 4F                LDA     #<FCB           ; Open File
00120D  3  A0 15                LDY     #>FCB           ;
00120F  3  A2 0F                LDX     #15             ;
001211  3  20 3B 11             JSR     PEM             ;
001214  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
001216  3  D0 0B                BNE     DOS65LOAD_1     ;
001218  3               DOS65LOAD_ERR:
001218  3  A2 26                LDX     #$26            ; IO ERROR
00121A  3  20 73 17             JSR     LAB_XERR
00121D  3  4C 4B 18             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001220  3               DOS65LOAD_ERR1:
001220  3  4C 4F 1D             JMP     LAB_REM         ; comment out the remainder of the line (if any)
001223  3               DOS65LOAD_1:
001223  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
001225  3  85 22                STA     FCBPTR+2        ; point to base of RAM
001227  3  8D F6 12             STA     EndOfBas        ;
00122A  3  A5 7A                LDA     <Smemh          ;
00122C  3  85 23                STA     FCBPTR+3        ;
00122E  3  8D F7 12             STA     EndOfBas+1      ;
001231  3  A9 D9                LDA     #<FCBBUFFER     ; SETUP BUFFER
001233  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
001235  3  A0 36                LDY     #>FCBBUFFER     ;
001237  3  84 21                STY     FCBPTR+1        ; STORE DEST BUFFER IN FCBPTR
001239  3  A2 1A                LDX     #26             ; Setup Buffer
00123B  3  20 3B 11             JSR     PEM             ;
00123E  3  4C 7C 12             JMP     DOS65LOAD_3C
001241  3               DOS65LOAD_3:
001241  3  B1 20                LDA     (FCBPTR),Y      ; load from BUFFER
001243  3  91 22                STA     (FCBPTR+2),Y    ; save to RAM
001245  3  EE F6 12             INC     EndOfBas
001248  3  D0 03                BNE     :+
00124A  3  EE F7 12             INC     EndOfBas+1
00124D  3               :
00124D  3  C9 00                CMP     #$00
00124F  3  D0 0D                BNE     :+
001251  3  EE F8 12             INC     NullCounter
001254  3  AD F8 12             LDA     NullCounter
001257  3  C9 03                CMP     #3
001259  3  D0 08                BNE     :++
00125B  3  4C 8F 12             JMP     DOS65LOAD_4
00125E  3               :
00125E  3  A9 00                LDA     #$00
001260  3  8D F8 12             STA     NullCounter
001263  3               :
001263  3  C8                   INY                     ; bump index
001264  3  C0 80                CPY     #$80            ; end of buffer?
001266  3  D0 D9                BNE     DOS65LOAD_3     ; no, loop
001268  3  18                   CLC                     ;
001269  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
00126B  3  69 80                ADC     #$80            ;
00126D  3  85 22                STA     FCBPTR+2        ;
00126F  3  90 0B                BCC     DOS65LOAD_3C    ; is carry?, no SKIP
001271  3  18                   CLC                     ; yes, carry, inc high byte
001272  3  A5 23                LDA     FCBPTR+3        ;
001274  3  69 01                ADC     #$01            ;
001276  3  85 23                STA     FCBPTR+3        ;
001278  3  C9 B8                CMP     #>Ram_top       ; are we at the end of RAM?
00127A  3  F0 13                BEQ     DOS65LOAD_4
00127C  3               
00127C  3               DOS65LOAD_3C:
00127C  3  A9 4F                LDA     #<FCB           ; READ record buffer from disk file
00127E  3  A0 15                LDY     #>FCB           ;
001280  3  A2 14                LDX     #20             ;
001282  3  20 3B 11             JSR     PEM             ;
001285  3  A0 00                LDY     #$00            ; RESET INDEX
001287  3  C9 00                CMP     #$00            ; is error or EOF
001289  3  F0 B6                BEQ     DOS65LOAD_3     ;
00128B  3  C9 01                CMP     #$01            ; EOF?
00128D  3  D0 89                BNE     DOS65LOAD_ERR   ; ERROR, do error handling
00128F  3               DOS65LOAD_4:
00128F  3  A9 4F                LDA     #<FCB           ;
001291  3  A0 15                LDY     #>FCB           ;
001293  3  A2 10                LDX     #16             ;
001295  3  20 3B 11             JSR     PEM             ;
001298  3                                               ; setup pointers to return to basic
001298  3  AD F6 12             LDA     EndOfBas
00129B  3  85 7B                STA     Svarl
00129D  3  85 7D                STA     Sarryl
00129F  3  85 7F                STA     Earryl
0012A1  3  AD F7 12             LDA     EndOfBas+1
0012A4  3  85 7C                STA     Svarh
0012A6  3  85 7E                STA     Sarryh
0012A8  3  85 80                STA     Earryh
0012AA  3  A9 66                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
0012AC  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
0012AE  3  20 F6 1E             JSR     LAB_18C3
0012B1  3  4C 4B 18             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
0012B4  3               
0012B4  3               
0012B4  3               
0012B4  3               DOS65FCBPREP:
0012B4  3                       .IFDEF  DUODYNE
0012B4  3                       JSL     LAB_GBYT        ; scan memory
0012B4  3                       .ELSE
0012B4  3  20 C2 00             JSR     LAB_GBYT        ; scan memory
0012B7  3                       .ENDIF
0012B7  3               
0012B7  3  38                   SEC                     ;
0012B8  3  E9 40                SBC     #64             ; PARSE DRIVE NUMBER
0012BA  3  8D 4F 15             STA     DOSDRIVE        ; STORE IT IN FCB
0012BD  3                       .IFDEF  DUODYNE
0012BD  3                       JSL     LAB_IGBY        ; increment and scan memory
0012BD  3                       .ELSE
0012BD  3  20 BC 00             JSR     LAB_IGBY        ; increment and scan memory
0012C0  3                       .ENDIF
0012C0  3               
0012C0  3  C9 3A                CMP     #':'            ;
0012C2  3  F0 08                BEQ     DOS65FCBPREP_1  ; YES, IT WAS A DRIVE, CONTINUE
0012C4  3  A2 26                LDX     #$26            ; IO ERROR
0012C6  3  20 73 17             JSR     LAB_XERR
0012C9  3  4C 4B 18             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
0012CC  3               
0012CC  3               DOS65FCBPREP_1:
0012CC  3  A9 4F                LDA     #<FCB           ; SETUP FCBPTR
0012CE  3  85 20                STA     FCBPTR          ;
0012D0  3  A9 15                LDA     #>FCB           ;
0012D2  3  85 21                STA     FCBPTR+1        ;
0012D4  3  A0 01                LDY     #$01            ; POINT Y TO FCB FILE NAME
0012D6  3  A9 20                LDA     #$20            ; LOAD SPACE CHAR INTO A
0012D8  3               DOS65FCBPREP_1A:                ; BLANK OUT FCB
0012D8  3  91 20                STAINDIRECTY FCBPTR     ;
0012DA  3  C8                   INY                     ;
0012DB  3  C0 09                CPY     #$09            ; IS DONE
0012DD  3  D0 F9                BNE     DOS65FCBPREP_1A ; NO, LOOP
0012DF  3  A0 01                LDY     #$01            ; POINT Y TO FCB FILE NAME
0012E1  3               DOS65FCBPREP_2:                 ; COPY FILE NAME PARAMETER INTO FCB
0012E1  3                       .IFDEF  DUODYNE
0012E1  3                       JSL     LAB_IGBY        ; increment and scan memory
0012E1  3                       .ELSE
0012E1  3  20 BC 00             JSR     LAB_IGBY        ; increment and scan memory
0012E4  3                       .ENDIF
0012E4  3  F0 0E                BEQ     DOS65FCBPREP_3  ;
0012E6  3  C9 2E                CMP     #'.'
0012E8  3  F0 0A                BEQ     DOS65FCBPREP_3  ;
0012EA  3  91 20                STAINDIRECTY FCBPTR     ;
0012EC  3  C8                   INY                     ;
0012ED  3  C0 09                CPY     #$09            ;
0012EF  3  F0 03                BEQ     DOS65FCBPREP_3  ;
0012F1  3  4C E1 12             JMP     DOS65FCBPREP_2  ;
0012F4  3               DOS65FCBPREP_3:                 ;
0012F4  3  18                   CLC
0012F5  3  60                   RTS                     ;
0012F6  3               
0012F6  3               EndOfBas:
0012F6  3  00 00                .BYTE   00,00
0012F8  3               NullCounter:
0012F8  3  00                   .BYTE   00
