001782  3  20 DA 2D             JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X (VOLUME)
001785  3  8A                   TXA
001786  3  A8                   TAY
001787  3  68                   PLA                     ; LIMIT THE CHANNELS TO <3
001788  3  29 03                AND     #$03
00178A  3               
00178A  3  18                   CLC
00178B  3  69 08                ADC     #08
00178D  3  20 85 18             JSR     psgwr
001790  3  60                   RTS
001791  3               
001791  3               
