001311  3  E9 40                SBC     #64             ; PARSE DRIVE NUMBER
001313  3  8D 70 15             STA     DIRDRIVE        ; STORE IT IN FCB
001316  3                       .IFDEF  DUODYNE
001316  3                       JSL     LAB_IGBY        ; increment and scan memory
001316  3                       .ELSE
001316  3  20 BC 00             JSR     LAB_IGBY        ; increment and scan memory
001319  3                       .ENDIF
001319  3               
001319  3  C9 3A                CMP     #':'            ;
00131B  3  F0 08                BEQ     :+              ; YES, IT WAS A DRIVE, CONTINUE
00131D  3  A2 26                LDX     #$26            ; IO ERROR
00131F  3  20 73 17             JSR     LAB_XERR
001322  3  4C 4B 18             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001325  3               :
001325  3  A9 70                LDA     #<DIRFCB        ; GET FIRST DIR ENTRY
001327  3  A0 15                LDY     #>DIRFCB        ;
001329  3  A2 11                LDX     #17             ;
00132B  3  20 3B 11             JSR     PEM             ;
