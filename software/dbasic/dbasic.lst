003971  1  4A                   LSR     A               ; check odd/even
003972  1  B0 0E                BCS     LAB_SQE2        ; if odd only 1 shift first time
003974  1               
003974  1               LAB_SQE1:
003974  1  06 B6                ASL     FAC2_3          ; shift highest bit of number ..
003976  1  26 B5                ROL     FAC2_2          ; ..
003978  1  26 B4                ROL     FAC2_1          ; ..
00397A  1  26 77                ROL     FACt_3          ; .. into remainder
00397C  1  26 76                ROL     FACt_2          ; ..
00397E  1  26 75                ROL     FACt_1          ; ..
003980  1  26 78                ROL     TempB           ; .. never overflows
003982  1               LAB_SQE2:
003982  1  06 B6                ASL     FAC2_3          ; shift highest bit of number ..
003984  1  26 B5                ROL     FAC2_2          ; ..
003986  1  26 B4                ROL     FAC2_1          ; ..
003988  1  26 77                ROL     FACt_3          ; .. into remainder
00398A  1  26 76                ROL     FACt_2          ; ..
00398C  1  26 75                ROL     FACt_1          ; ..
00398E  1  26 78                ROL     TempB           ; .. never overflows
003990  1               
003990  1  06 AF                ASL     FAC1_3          ; root = root * 2
003992  1  26 AE                ROL     FAC1_2          ; ..
003994  1  26 AD                ROL     FAC1_1          ; .. never overflows
003996  1               
003996  1  A5 AF                LDA     FAC1_3          ; get root low byte
003998  1  2A                   ROL     A               ; *2
003999  1  85 5B                STA     Temp3           ; save partial low byte
00399B  1  A5 AE                LDA     FAC1_2          ; get root low mid byte
00399D  1  2A                   ROL     A               ; *2
00399E  1  85 5C                STA     Temp3+1         ; save partial low mid byte
0039A0  1  A5 AD                LDA     FAC1_1          ; get root high mid byte
0039A2  1  2A                   ROL     A               ; *2
0039A3  1  85 5D                STA     Temp3+2         ; save partial high mid byte
