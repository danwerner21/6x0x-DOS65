001731  3                       .IFDEF  MEMORYMAPPEDSCREEN
001731  3               
001731  3               PC6502_IO       = $E000
001731  3               SID_BASE        = PC6502_IO+$100
001731  3               
001731  3               ;___SOUND__________________________________________________
001731  3               ;
001731  3               ; PLAY SOUND
001731  3               ;
001731  3               ;  SOUND VOICE, FREQ, DUTY, WAVEFORM, ATTACK, SUSTAIN, DECAY, RELEASE
001731  3               ;
001731  3               ;
001731  3               ;__________________________________________________________
001731  3               LAB_SOUND:
001731  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (VOICE)
001731  3                       TXA
001731  3                       AND     #3
001731  3                       ASL     A
001731  3                       TAX
001731  3                       LDA     SIDVOICELOOKUP,X
001731  3                       STA     TEMPW
001731  3                       LDA     SIDVOICELOOKUP+1,X
001731  3                       STA     TEMPW+1
001731  3                                               ; OK, TEMPW POINTS TO SID REGISTER TO MODIFY
001731  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001731  3                       JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001731  3                                               ; else do type mismatch
001731  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001731  3                       LDY     #0              ; SET FREQUENCY
001731  3                       LDA     Itempl
001731  3                       STA     (TEMPW),Y
001731  3                       LDA     Itemph
001731  3                       INX
001731  3                       STA     (TEMPW),Y
001731  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001731  3                       JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001731  3                                               ; else do type mismatch
001731  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001731  3                       LDY     #2              ; SET DUTY CYCLE
001731  3                       LDA     Itempl
001731  3                       STA     (TEMPW),Y
001731  3                       LDA     Itemph
001731  3                       INY
001731  3                       STA     (TEMPW),Y
001731  3                       JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
001731  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (WAVEFORM)
001731  3                       TXA
001731  3                       LDY     #4              ; SET WAVEFORM CYCLE
001731  3                       STA     (TEMPW),Y
001731  3                       JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001731  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (ATTACK)
001731  3                       TXA
001731  3                       LSR     A
001731  3                       LSR     A
001731  3                       LSR     A
001731  3                       LSR     A
001731  3                       STA     PTEMPW
001731  3                       JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001731  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (DECAY)
001731  3                       TXA
001731  3                       AND     #$0F
001731  3                       ORA     PTEMPW
001731  3                       LDY     #5              ; SET ATTACK/DECAY
001731  3                       STA     (TEMPW),Y
001731  3                       JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001731  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (SUSTAIN)
001731  3                       TXA
001731  3                       LSR     A
001731  3                       LSR     A
001731  3                       LSR     A
001731  3                       LSR     A
001731  3                       STA     PTEMPW
001731  3                       JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001731  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (RELEASE)
001731  3                       TXA
001731  3                       AND     #$0F
001731  3                       ORA     PTEMPW
001731  3                       LDY     #6              ; SET SUSTAIN/RELEASE
001731  3                       STA     (TEMPW),Y
001731  3                       RTS
001731  3               SIDVOICELOOKUP:
001731  3                       .WORD   SID_BASE,SID_BASE+7,SID_BASE+$12
001731  3               
001731  3               ;___FILTER_________________________________________________
001731  3               ;
001731  3               ; SET SID FILTERS
001731  3               ;
001731  3               ;  FILTER CUTOFF, RESONANCE, VOICE 1 ENABLE, VOICE 2 ENABLE, VOICE 3 ENABLE, EXTERNAL ENABLE, FILTER MODE, VOLUME
001731  3               ;
001731  3               ;
001731  3               ;__________________________________________________________
001731  3               LAB_FILTER:
001731  3                       JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001731  3                                               ; else do type mismatch
001731  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001731  3                                               ; SET CUTOFF
001731  3                       LDA     Itempl
001731  3                       STA     SID_BASE+$15
001731  3                       LDA     Itemph
001731  3                       STA     SID_BASE+$16
001731  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001731  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (RESONANCE)
001731  3                       TXA
001731  3                       LSR     A
001731  3                       LSR     A
001731  3                       LSR     A
001731  3                       LSR     A
001731  3                       STA     PTEMPW
001731  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001731  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 1 ENABLE)
001731  3                       TXA
001731  3                       AND     #1
001731  3                       ORA     PTEMPW
001731  3                       STA     PTEMPW
001731  3                       JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
001731  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 2 ENABLE)
001731  3                       TXA
001731  3                       AND     #1
001731  3                       LSR     A
001731  3                       ORA     PTEMPW
001731  3                       STA     PTEMPW
001731  3                       JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001731  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 3 ENABLE)
001731  3                       TXA
001731  3                       AND     #1
001731  3                       LSR     A
001731  3                       LSR     A
001731  3                       ORA     PTEMPW
001731  3                       STA     PTEMPW
001731  3                       JSR     LAB_1C01        ; GET THE SIXTH PARAMETER (AFTER ',') OR SYN ERR
001731  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (EXTERNAL AUDIO ENABLE)
001731  3                       TXA
001731  3                       AND     #1
001731  3                       LSR     A
001731  3                       LSR     A
001731  3                       LSR     A
001731  3                       ORA     PTEMPW
001731  3                       STA     SID_BASE+$17
001731  3                       JSR     LAB_1C01        ; GET THE SEVENTH PARAMETER (AFTER ',') OR SYN ERR
001731  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (FILTER MODE)
001731  3                       TXA
001731  3                       LSR     A
001731  3                       LSR     A
001731  3                       LSR     A
001731  3                       LSR     A
001731  3                       STA     PTEMPW
001731  3                       JSR     LAB_1C01        ; GET THE EIGHTH PARAMETER (AFTER ',') OR SYN ERR
001731  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOLUME)
001731  3                       TXA
001731  3                       AND     #$0F
001731  3                       ORA     PTEMPW
001731  3                       STA     SID_BASE+$18
001731  3                       RTS
001731  3               
001731  3                       .ELSE
001731  3               
001731  3               
001731  3               ; ENSURE ALL OF THESE SPECIAL COMMANDS GIVE ERRORS IN NORMAL BASIC
001731  3               LAB_SOUND:
001731  3               LAB_FILTER:
001731  3  A2 02                LDX     #$02            ; error code $02 ("SYNTAX" error)
001733  3  4C 0E 19             JMP     LAB_XERR        ; do error #X, then warm start
001736  3               
001736  3                       .ENDIF
