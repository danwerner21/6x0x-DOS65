0012D4  3  C9 3A                CMP     #':'            ;
0012D6  3  F0 0E                BEQ     DOS65FCBPREP_1  ; YES, IT WAS A DRIVE, CONTINUE
0012D8  3  A9 93                LDA     #<FILEERROR1    ; NO, ERROR OUT
0012DA  3  A0 0F                LDY     #>FILEERROR1
0012DC  3  A2 09                LDX     #9
0012DE  3  20 4D 11             JSR     PEM
0012E1  3  20 75 1D             JSR     LAB_REM
0012E4  3  38                   SEC
0012E5  3  60                   RTS
0012E6  3               DOS65FCBPREP_1:
0012E6  3  A9 70                LDA     #<FCB           ; SETUP FCBPTR
0012E8  3  85 20                STA     FCBPTR          ;
0012EA  3  A9 15                LDA     #>FCB           ;
0012EC  3  85 21                STA     FCBPTR+1        ;
0012EE  3  A0 01                LDY     #$01            ; POINT Y TO FCB FILE NAME
0012F0  3  A9 20                LDA     #$20            ; LOAD SPACE CHAR INTO A
0012F2  3               DOS65FCBPREP_1A:                ; BLANK OUT FCB
0012F2  3  91 20                STAINDIRECTY FCBPTR     ;
0012F4  3  C8                   INY                     ;
0012F5  3  C0 09                CPY     #$09            ; IS DONE
0012F7  3  D0 F9                BNE     DOS65FCBPREP_1A ; NO, LOOP
0012F9  3  A0 01                LDY     #$01            ; POINT Y TO FCB FILE NAME
0012FB  3               DOS65FCBPREP_2:                 ; COPY FILE NAME PARAMETER INTO FCB
0012FB  3                       .IFDEF  DUODYNE
0012FB  3                       JSL     LAB_IGBY        ; increment and scan memory
0012FB  3                       .ELSE
0012FB  3  20 BC 00             JSR     LAB_IGBY        ; increment and scan memory
0012FE  3                       .ENDIF
0012FE  3  F0 0E                BEQ     DOS65FCBPREP_3  ;
001300  3  C9 2E                CMP     #'.'
001302  3  F0 0A                BEQ     DOS65FCBPREP_3  ;
001304  3  91 20                STAINDIRECTY FCBPTR     ;
001306  3  C8                   INY                     ;
001307  3  C0 09                CPY     #$09            ;
001309  3  F0 03                BEQ     DOS65FCBPREP_3  ;
