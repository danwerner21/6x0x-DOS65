001745  3                       LSR     A
001745  3                       LSR     A
001745  3                       LSR     A
001745  3                       LSR     A
001745  3                       STA     PTEMPW
001745  3                       JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001745  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (RELEASE)
001745  3                       TXA
001745  3                       AND     #$0F
001745  3                       ORA     PTEMPW
