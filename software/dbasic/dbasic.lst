00158A  3               LAB_FILTER:
00158A  3                       JSR     LAB_EVNM        ; evaluate expression and check is numeric,
00158A  3                                               ; else do type mismatch
00158A  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
00158A  3                                               ; SET CUTOFF
00158A  3                       LDA     Itempl
00158A  3                       STA     SID_BASE+$15
00158A  3                       LDA     Itemph
00158A  3                       STA     SID_BASE+$16
00158A  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
00158A  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (RESONANCE)
00158A  3                       TXA
00158A  3                       LSR     A
00158A  3                       LSR     A
00158A  3                       LSR     A
00158A  3                       LSR     A
00158A  3                       STA     PTEMPW
00158A  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
00158A  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 1 ENABLE)
00158A  3                       TXA
00158A  3                       AND     #1
00158A  3                       ORA     PTEMPW
00158A  3                       STA     PTEMPW
00158A  3                       JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
00158A  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 2 ENABLE)
00158A  3                       TXA
00158A  3                       AND     #1
00158A  3                       LSR     A
00158A  3                       ORA     PTEMPW
00158A  3                       STA     PTEMPW
00158A  3                       JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
00158A  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 3 ENABLE)
00158A  3                       TXA
00158A  3                       AND     #1
00158A  3                       LSR     A
00158A  3                       LSR     A
00158A  3                       ORA     PTEMPW
00158A  3                       STA     PTEMPW
00158A  3                       JSR     LAB_1C01        ; GET THE SIXTH PARAMETER (AFTER ',') OR SYN ERR
00158A  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (EXTERNAL AUDIO ENABLE)
00158A  3                       TXA
00158A  3                       AND     #1
00158A  3                       LSR     A
00158A  3                       LSR     A
00158A  3                       LSR     A
00158A  3                       ORA     PTEMPW
00158A  3                       STA     SID_BASE+$17
00158A  3                       JSR     LAB_1C01        ; GET THE SEVENTH PARAMETER (AFTER ',') OR SYN ERR
00158A  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (FILTER MODE)
00158A  3                       TXA
00158A  3                       LSR     A
00158A  3                       LSR     A
00158A  3                       LSR     A
00158A  3                       LSR     A
00158A  3                       STA     PTEMPW
00158A  3                       JSR     LAB_1C01        ; GET THE EIGHTH PARAMETER (AFTER ',') OR SYN ERR
00158A  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOLUME)
00158A  3                       TXA
00158A  3                       AND     #$0F
00158A  3                       ORA     PTEMPW
00158A  3                       STA     SID_BASE+$18
00158A  3                       RTS
00158A  3               
00158A  3                       .ELSE
00158A  3               
