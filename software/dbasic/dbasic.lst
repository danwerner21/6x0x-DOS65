00172C  3               ;___V_SCRCLR________________________________________________
00172C  3               ;
00172C  3               ; CLEAR SCREEN
00172C  3               ;
00172C  3               ;__________________________________________________________
00172C  3               LAB_SCRCLR:
00172C  3               V_SCNCLR:
00172C  3                       STA     DBGA
00172C  3                       STY     DBGY
00172C  3                       STX     DBGX
00172C  3                       LDA     #38
00172C  3                       STA     farfunct
00172C  3                       JSR     DO_FARCALL
00172C  3                       LDA     #59
00172C  3                       STA     farfunct
00172C  3                       JSR     DO_FARCALL
00172C  3                       LDA     DBGA
00172C  3                       LDY     DBGY
00172C  3                       LDX     DBGX
00172C  3                       RTS
00172C  3               
00172C  3               
00172C  3               
00172C  3               ;___V_LOCATE________________________________________________
00172C  3               ;
00172C  3               ; SET CURSOR LOCATION
00172C  3               ;
00172C  3               ;       LOCATE X,Y
00172C  3               ;
00172C  3               ;__________________________________________________________
00172C  3               V_LOCATE:
00172C  3               LAB_LOCATE:
00172C  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (MODE)
00172C  3                       STX     DBGX
00172C  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
00172C  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
00172C  3                       TXA
00172C  3                       TAY
00172C  3                       LDX     DBGX
00172C  3                       LDA     #37
00172C  3                       STA     farfunct
00172C  3                       JSR     DO_FARCALL
00172C  3                       RTS
00172C  3               
00172C  3               ;___V_COLOR_________________________________________________
00172C  3               ;
00172C  3               ; SET COLOR FG,BG,CFG,CBG
00172C  3               ;
00172C  3               ;__________________________________________________________
00172C  3               LAB_COLOR:
00172C  3               V_COLOR:
00172C  3                       LDA     #$00            ; CLEAR TEMP SPACE
00172C  3                       STA     PTEMPW
00172C  3                       STA     PTEMPW+1
00172C  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (MODE)
00172C  3                       TXA
00172C  3                       AND     #$0F
00172C  3                       STA     PTEMPW
00172C  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
00172C  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
00172C  3                       TXA
00172C  3                       ASL     A
00172C  3                       ASL     A
00172C  3                       ASL     A
00172C  3                       ASL     A
00172C  3                       ORA     PTEMPW
00172C  3                       STA     PTEMPW
00172C  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
00172C  3                       JSR     LAB_GTBY        ; GET THE THIRD PARAMETER, RETURN IN X
00172C  3                       TXA
00172C  3                       AND     #$0F
00172C  3                       STA     PTEMPW+1
00172C  3                       JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
00172C  3                       JSR     LAB_GTBY        ; GET THE FOURTH PARAMETER, RETURN IN X
00172C  3                       TXA
00172C  3                       ASL     A
00172C  3                       ASL     A
00172C  3                       ASL     A
00172C  3                       ASL     A
00172C  3                       ORA     PTEMPW+1
00172C  3                       STA     PTEMPW+1
00172C  3                       LDX     PTEMPW
00172C  3                       LDY     PTEMPW+1
00172C  3                       LDA     #39
00172C  3                       STA     farfunct
00172C  3                       JSR     DO_FARCALL
00172C  3                       RTS
00172C  3               
00172C  3               
00172C  3               
00172C  3               ;___V_SPEEK()______________________________________________
00172C  3               ;
00172C  3               ; GET VALUE FROM SCREEN MEMORY
00172C  3               ;
00172C  3               ;  TAKES ONE PARAMETER (ADDRESS), RETURNS VALUE
00172C  3               ;
00172C  3               ;__________________________________________________________
00172C  3               LAB_SPEEK:
00172C  3               V_SPEEK:
00172C  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
00172C  3                       LDA     Itemph
00172C  3                       TAY
00172C  3                       AND     #$0F
00172C  3                       ORA     #$A0
00172C  3                       STA     Itemph
00172C  3                       TYA
00172C  3                       AND     #$F0
00172C  3                       LSR     A
00172C  3                       LSR     A
00172C  3                       LSR     A
00172C  3                       LSR     A
00172C  3                       AND     #$07
00172C  3                       CLC
00172C  3                       ADC     #VIDEOBANK
00172C  3                       TAY
00172C  3                       LDA     #$01            ; MODIFY TASK 01 (DRIVER TASK)
00172C  3                       LDX     #$0A            ; MAP $AXXX
00172C  3                       JSR     SETPAGE         ; CALL SETPAGE
00172C  3                       LDA     #$01
00172C  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 01
00172C  3                       LDY     #0
00172C  3                       LDA     (Itempl),Y
00172C  3                       TAY
00172C  3                       LDA     #$00
00172C  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 00
00172C  3                       JMP     LAB_1FD0        ; convert Y to byte in FAC1 and return
00172C  3               
00172C  3               
00172C  3               
00172C  3               ;___V_SPOKE_________________________________________________
00172C  3               ;
00172C  3               ; PUT VALUE IN SCREEN MEMORY
00172C  3               ;
00172C  3               ;  TAKES TWO PARAMETERS ADDRESS,VALUE
00172C  3               ;
00172C  3               ;__________________________________________________________
00172C  3               LAB_SPOKE:
00172C  3               V_SPOKE:
00172C  3                       JSR     LAB_GADB        ; get two parameters for POKE or WAIT
00172C  3                       TXA                     ; BYTE ARGUMENT IS IN X
00172C  3                       PHA                     ; PUSH BYTE ARGUMENT TO STACK
00172C  3                       LDA     Itemph
00172C  3                       TAY
00172C  3                       AND     #$0F
00172C  3                       ORA     #$A0
00172C  3                       STA     Itemph
00172C  3                       TYA
00172C  3                       AND     #$F0
00172C  3                       LSR     A
00172C  3                       LSR     A
00172C  3                       LSR     A
00172C  3                       LSR     A
00172C  3                       AND     #$07
00172C  3                       CLC
00172C  3                       ADC     #VIDEOBANK
00172C  3                       TAY
00172C  3                       LDA     #$01            ; MODIFY TASK 01 (DRIVER TASK)
00172C  3                       LDX     #$0A            ; MAP $AXXX
00172C  3                       JSR     SETPAGE         ; CALL SETPAGE
00172C  3                       LDA     #$01
00172C  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 01
00172C  3                       LDY     #0
00172C  3                       PLA                     ; PULL BYTE ARGUMENT
00172C  3                       STA     (Itempl),Y
00172C  3                       LDA     #$00
00172C  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 00
00172C  3                       RTS
00172C  3               
00172C  3               ;___V_SCREEN_________________________________________________
00172C  3               ;
00172C  3               ;  SET SCREEN MODE
00172C  3               ;
00172C  3               ;  TAKES UP TO THREE PARAMETERS
00172C  3               ;  FIRST PARAMETER SCREEN MODE
00172C  3               ;  0=TEXT MODE
00172C  3               ;  1=LORES MODE
00172C  3               ;  2=HIRES MODE
00172C  3               ;
00172C  3               ;  TEXT MODE PARAMETERS
00172C  3               ;  0=40 COLUMNS
00172C  3               ;  1=80 COLUMNS
00172C  3               ;
00172C  3               ;  LORES MODE SECOND PARAMETER
00172C  3               ;  0=SINGLE LORES
00172C  3               ;  1=DOUBLE LORES
00172C  3               ;  LORES MODE THIRD PARAMETER
00172C  3               ;  0=MIXED MODE
00172C  3               ;  1=FULL SCREEN MODE
00172C  3               ;
00172C  3               ;  HIRES MODE SECOND PARAMETER
00172C  3               ;  0=SINGLE HIRES
00172C  3               ;  1=DOUBLE HIRES
00172C  3               ;  2=QUAD HIRES
00172C  3               ;  3=MONO HIRES
00172C  3               ;  HIRES MODE THIRD PARAMETER
00172C  3               ;  1=MIXED MODE
00172C  3               ;  0=FULL SCREEN MODE
00172C  3               ;
00172C  3               ;__________________________________________________________
00172C  3               LAB_SCREEN:
00172C  3               V_SCREEN:
00172C  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (MODE)
00172C  3               V_SCREEN1:
00172C  3                       STX     VIDEOMODE
00172C  3                       CPX     #00
00172C  3                       BNE     *+5
00172C  3                       JMP     SETUPMODE0
00172C  3                       CPX     #01
00172C  3                       BNE     *+5
00172C  3                       JMP     SETUPMODE1
00172C  3                       CPX     #02
00172C  3                       BNE     *+5
00172C  3                       JMP     SETUPMODE2
00172C  3               
00172C  3                       LDX     #$02            ; SYNTAX ERROR
00172C  3                       JSR     LAB_XERR
00172C  3                       JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
00172C  3                       RTS
00172C  3               
00172C  3               SETUPMODE0:                     ; TEXT MODE
00172C  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00172C  3                       JSR     PAGE_ENTER
00172C  3                       LDA     #$01
00172C  3                       STA     VideoTextMode
00172C  3                       LDA     #$02
00172C  3                       STA     VideoLoresMode
00172C  3                       STA     VideoHiresMode
00172C  3                       JSR     PAGE_EXIT
00172C  3               
00172C  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
00172C  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
00172C  3                       CPX     #$00
00172C  3                       BNE     SETUPMODE0_80
00172C  3               
00172C  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00172C  3                       JSR     PAGE_ENTER
00172C  3                       LDA     #$02
00172C  3                       STA     Video80col
00172C  3                       JSR     PAGE_EXIT
00172C  3                       LDA     #40
00172C  3                       STA     VIDEOWIDTH
00172C  3                       LDA     #0
00172C  3                       STA     BVIDEOMODE
00172C  3                       JMP     SETUPMODE0_CLEAR
00172C  3               SETUPMODE0_80:
00172C  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00172C  3                       JSR     PAGE_ENTER
00172C  3                       LDA     #$01
00172C  3                       STA     Video80col
00172C  3                       JSR     PAGE_EXIT
00172C  3                       LDA     #80
00172C  3                       STA     VIDEOWIDTH
00172C  3                       LDA     #1
00172C  3                       STA     BVIDEOMODE
00172C  3               SETUPMODE0_CLEAR:
00172C  3                       JMP     V_SCNCLR
00172C  3                       RTS
00172C  3               
00172C  3               SETUPMODE1:                     ; LORES MODE
00172C  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00172C  3                       JSR     PAGE_ENTER
00172C  3                       LDA     #$01
00172C  3                       STA     VideoLoresMode
00172C  3                       LDA     #$02
00172C  3                       STA     VideoTextMode
00172C  3                       STA     VideoHiresMode
00172C  3                       JSR     PAGE_EXIT
00172C  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
00172C  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
00172C  3               
00172C  3                       CPX     #$00
00172C  3                       BNE     SETUPMODE1_DOUBLE
00172C  3               
00172C  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00172C  3                       JSR     PAGE_ENTER
00172C  3                       LDA     #$02
00172C  3                       STA     VideoDoubleLores
00172C  3                       JSR     PAGE_EXIT
00172C  3                       JMP     SETUPMODE1_CLEAR
00172C  3               SETUPMODE1_DOUBLE:
00172C  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00172C  3                       JSR     PAGE_ENTER
00172C  3                       LDA     #$01
00172C  3                       STA     VideoDoubleLores
00172C  3                       JSR     PAGE_EXIT
00172C  3                       LDA     #$11
00172C  3                       STA     VIDEOMODE
00172C  3               SETUPMODE1_CLEAR:               ;    ($2000-$2800)
00172C  3                       LDY     #$02+VIDEOBANK  ; AREA $2000-$2FFF
00172C  3                       JSR     PAGE_ENTER
00172C  3                       LDA     #$00
00172C  3                       STA     TEMPW
00172C  3                       LDA     #$A0
00172C  3                       STA     TEMPW+1
00172C  3                       LDY     #$00
00172C  3                       LDA     #$00
00172C  3               :
00172C  3                       STA     (TEMPW),Y
00172C  3                       INC     TEMPW
00172C  3                       BNE     :-
00172C  3                       INC     TEMPW+1
00172C  3               
00172C  3                       LDX     TEMPW+1
00172C  3                       CPX     #$A8
00172C  3                       BNE     :-
00172C  3                       JSR     PAGE_EXIT
00172C  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
00172C  3                       JSR     LAB_GTBY        ; GET THE THIRD PARAMETER, RETURN IN X
00172C  3                       CPX     #$00
00172C  3                       BNE     SETUPMODE1_MIXED
00172C  3               
00172C  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00172C  3                       JSR     PAGE_ENTER
00172C  3                       LDA     #$02
00172C  3                       STA     VideoMixedMode
00172C  3                       JSR     PAGE_EXIT
00172C  3                       RTS
00172C  3               SETUPMODE1_MIXED:
00172C  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00172C  3                       JSR     PAGE_ENTER
00172C  3                       LDA     #$01
00172C  3                       STA     VideoMixedMode
00172C  3                       JSR     PAGE_EXIT
00172C  3                       LDA     VIDEOMODE
00172C  3                       ORA     #$80
00172C  3                       STA     VIDEOMODE
00172C  3                       RTS
00172C  3               
00172C  3               
00172C  3               SETUPMODE2:                     ; HIRES MODE
00172C  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00172C  3                       JSR     PAGE_ENTER
00172C  3                       LDA     #$01
00172C  3                       STA     VideoHiresMode
00172C  3                       LDA     #$02
00172C  3                       STA     VideoTextMode
00172C  3                       STA     VideoLoresMode
00172C  3                       JSR     PAGE_EXIT
00172C  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
00172C  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
00172C  3               
00172C  3                       CPX     #$00
00172C  3                       BNE     SETUPMODE2_DOUBLE
00172C  3               
00172C  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00172C  3                       JSR     PAGE_ENTER
00172C  3                       LDA     #$02
00172C  3                       STA     VideoDoubleHires
00172C  3                       STA     VideoQuadHires
00172C  3                       STA     VideoMonoHires
00172C  3                       JSR     PAGE_EXIT
00172C  3                       JMP     SETUPMODE2_CLEAR
00172C  3               SETUPMODE2_DOUBLE:
00172C  3                       CPX     #$01
00172C  3                       BNE     SETUPMODE2_QUAD
00172C  3               
00172C  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00172C  3                       JSR     PAGE_ENTER
00172C  3                       LDA     #$01
00172C  3                       STA     VideoDoubleHires
00172C  3                       LDA     #$02
00172C  3                       STA     VideoQuadHires
00172C  3                       STA     VideoMonoHires
00172C  3                       JSR     PAGE_EXIT
00172C  3                       LDA     #$12
00172C  3                       STA     VIDEOMODE
00172C  3                       JMP     SETUPMODE2_CLEAR
00172C  3               SETUPMODE2_QUAD:
00172C  3                       CPX     #$02
00172C  3                       BNE     SETUPMODE2_MONO
00172C  3               
00172C  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00172C  3                       JSR     PAGE_ENTER
00172C  3                       LDA     #$01
00172C  3                       STA     VideoQuadHires
00172C  3                       LDA     #$02
00172C  3                       STA     VideoDoubleHires
00172C  3                       STA     VideoMonoHires
00172C  3                       JSR     PAGE_EXIT
00172C  3                       LDA     #$22
00172C  3                       STA     VIDEOMODE
00172C  3                       JMP     SETUPMODE2_CLEAR
00172C  3               SETUPMODE2_MONO:
00172C  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00172C  3                       JSR     PAGE_ENTER
00172C  3                       LDA     #$01
00172C  3                       STA     VideoMonoHires
00172C  3                       LDA     #$02
00172C  3                       STA     VideoDoubleHires
00172C  3                       STA     VideoQuadHires
00172C  3                       JSR     PAGE_EXIT
00172C  3                       LDA     #$32
00172C  3                       STA     VIDEOMODE
00172C  3               
00172C  3               SETUPMODE2_CLEAR:               ; ($2000-$7FFF)
00172C  3                       LDY     #$02+VIDEOBANK
00172C  3                       STY     CLRTMP
00172C  3               
00172C  3               :
00172C  3                       LDY     CLRTMP
00172C  3                       JSR     PAGE_ENTER
00172C  3               
00172C  3                       LDA     #$00
00172C  3                       TAY
00172C  3                       STA     TEMPW
00172C  3                       LDA     #$A0
00172C  3                       STA     TEMPW+1
00172C  3                       LDA     #$00
00172C  3               :
00172C  3                       STA     (TEMPW),Y
00172C  3                       INC     TEMPW
00172C  3                       BNE     :-
00172C  3                       INC     TEMPW+1
00172C  3                       LDX     TEMPW+1
00172C  3                       CPX     #$B0
00172C  3                       BNE     :-
00172C  3                       LDX     #$A0
00172C  3                       INC     CLRTMP
00172C  3                       LDX     CLRTMP
00172C  3                       CPX     #$00
00172C  3                       BNE     :--
00172C  3                       JSR     PAGE_EXIT
00172C  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
00172C  3                       JSR     LAB_GTBY        ; GET THE THIRD PARAMETER, RETURN IN X
00172C  3                       CPX     #$00
00172C  3                       BNE     SETUPMODE2_MIXED
00172C  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00172C  3                       JSR     PAGE_ENTER
00172C  3                       LDA     #$02
00172C  3                       STA     VideoMixedMode
00172C  3                       JSR     PAGE_EXIT
00172C  3                       RTS
00172C  3               SETUPMODE2_MIXED:
00172C  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00172C  3                       JSR     PAGE_ENTER
00172C  3                       LDA     #$01
00172C  3                       STA     VideoMixedMode
00172C  3                       JSR     PAGE_EXIT
00172C  3                       LDA     VIDEOMODE
00172C  3                       ORA     #$80
00172C  3                       STA     VIDEOMODE
00172C  3                       RTS
00172C  3               
00172C  3               
00172C  3               
00172C  3               PAGE_EXIT:
00172C  3                       LDA     #$00
00172C  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 00
00172C  3                       RTS
00172C  3               
00172C  3               PAGE_ENTER:
00172C  3               ; Set "Y" register to video page ($YXXX)
00172C  3                       LDA     #$01            ; MODIFY TASK 01 (DRIVER TASK)
00172C  3                       LDX     #$0A            ; MAP $AXXX
00172C  3                       JSR     SETPAGE         ; CALL SETPAGE
00172C  3                       LDA     #$01
00172C  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 01
00172C  3                       RTS
00172C  3               
00172C  3               ;___V_PLOT__________________________________________________
00172C  3               ;
00172C  3               ;  PLOT ON SCREEN
00172C  3               ;         TAKES THREE PARAMETERS,  X,Y,COLOR
00172C  3               ;
00172C  3               ;__________________________________________________________
00172C  3               LAB_PLOT:
00172C  3               V_PLOT:
00172C  3                       JSR     LAB_EVNM        ; evaluate expression and check is numeric,
00172C  3                                               ; else do type mismatch
00172C  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
00172C  3                       LDA     Itemph
00172C  3                       STA     PLOTX+1
00172C  3                       LDA     Itempl
00172C  3                       STA     PLOTX
00172C  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
00172C  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
00172C  3                       STX     PLOTY           ; STORE IN PLOTY
00172C  3                       LDA     #$00
00172C  3                       STA     PLOTY+1
00172C  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
00172C  3                       JSR     LAB_GTBY        ; RETURN IN X
00172C  3                       STX     PLOTCOLOR
00172C  3               DOPLOTXY:
00172C  3                                               ; PARAMETERS PARSED, GO TO PROPER MODE CODE
00172C  3                       LDA     VIDEOMODE
00172C  3                       AND     #$0F
00172C  3                       CMP     #$01
00172C  3                       BEQ     V_PLOT_LORES
00172C  3                       LDA     VIDEOMODE
00172C  3                       AND     #$2F
00172C  3                       CMP     #$02
00172C  3                       BNE     :+
00172C  3                       JMP     V_PLOT_HIRES_COLOR
00172C  3               :
00172C  3                       CMP     #$22
00172C  3                       BNE     :+
00172C  3                       JMP     V_PLOT_HIRES_MONO
00172C  3               :
00172C  3                       RTS
00172C  3               
00172C  3               V_PLOT_LORES:
00172C  3                       LDA     PLOTY
00172C  3                       PHA
00172C  3                       LSR     A               ; 2 LINES PER BYTE
00172C  3                       STA     PLOTY
00172C  3                                               ; MULTIPLY Y (PTEMPW) COORD BY 40 OR 80 (SINGLE OR DOUBLE LORES)
00172C  3                       CLC
00172C  3                       ASL     PLOTY
00172C  3                       ROL     PLOTY+1         ; *2
00172C  3                       ASL     PLOTY
00172C  3                       ROL     PLOTY+1         ; *2 (*4)
00172C  3                       ASL     PLOTY
00172C  3                       ROL     PLOTY+1         ; *2 (*8)
00172C  3                       LDA     PLOTY
00172C  3                       STA     PTEMPW
00172C  3                       LDA     PLOTY+1
00172C  3                       STA     PTEMPW+1        ; STORE Y*8 INTO PTEMPW
00172C  3                       ASL     PLOTY
00172C  3                       ROL     PLOTY+1         ; *2 (*16)
00172C  3                       ASL     PLOTY
00172C  3                       ROL     PLOTY+1         ; *2 (*32)
00172C  3               ; NOW TAKE Y*8(PTEMPW) + Y*32(PLOTY) == Y*40 STORE IN PLOTY
00172C  3                       CLC                     ; Clear the Carry flag before the first addition
00172C  3               
00172C  3                       LDA     PLOTY           ; Load the low byte of the first number into the accumulator
00172C  3                       ADC     PTEMPW          ; Add the low byte of the second number (plus carry)
00172C  3                       STA     PLOTY           ; Store the low byte of the result
00172C  3               
00172C  3                       LDA     PLOTY+1         ; Load the high byte of the first number
00172C  3                       ADC     PTEMPW+1        ; Add the high byte of the second number (plus carry from previous op)
00172C  3                       STA     PLOTY+1         ; Store the high byte of the result
00172C  3               
00172C  3               ; if double lores columns double it.
00172C  3                       LDA     VIDEOMODE
00172C  3                       AND     #$10
00172C  3                       CMP     #00
00172C  3                       BEQ     :+
00172C  3                       ASL     PLOTY
00172C  3                       ROL     PLOTY+1         ; *2
00172C  3               :
00172C  3               ; OK, Y OFFSET IS IN PTEMPW1, X IS IN PTEMPW
00172C  3                       LDA     #$A0            ; ADD THE MEMORY OFFSET TO PTEMPW (BECAUSE IT IS EASY)
00172C  3                       STA     PLOTX+1         ; THEN ADD PTEMPW1 TO PTEMPW THAT SHOULD BE THE MEMORY ADDRESS TO UPDATE
00172C  3                                               ;
00172C  3                       CLC                     ; Clear the Carry flag before the first addition
00172C  3                       LDA     PLOTX           ; Load the low byte of the first number into the accumulator
00172C  3                       ADC     PLOTY           ; Add the low byte of the second number (plus carry)
00172C  3                       STA     TEMPW           ; Store the low byte of the result
00172C  3               
00172C  3                       LDA     PLOTX+1         ; Load the high byte of the first number
00172C  3                       ADC     PLOTY+1         ; Add the high byte of the second number (plus carry from previous op)
00172C  3                       STA     TEMPW+1         ; Store the high byte of the result
00172C  3                                               ; PTEMPW IS THE MEMORY OFFSET TO UPDATE
00172C  3                       PLA
00172C  3                       LSR     A               ; TOP OR BOTTOM PIXEL?
00172C  3                       BCC     :+
00172C  3                                               ; TOP PIXEL
00172C  3                       LDY     #$02+VIDEOBANK  ; AREA $2000-$2FFF
00172C  3                       JSR     PAGE_ENTER
00172C  3                       LDY     #$00
00172C  3                       LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
00172C  3                       AND     #$0F
00172C  3                       PHA
00172C  3                       LDA     PLOTCOLOR
00172C  3                       ASL     A
00172C  3                       ASL     A
00172C  3                       ASL     A
00172C  3                       ASL     A
00172C  3                       STA     PLOTCOLOR
00172C  3                       PLA
00172C  3                       ORA     PLOTCOLOR
00172C  3                       STA     (TEMPW),Y       ; STORE  DOUBLE PIXEL
00172C  3                       JSR     PAGE_EXIT
00172C  3                       RTS
00172C  3               :
00172C  3                                               ; BOTTOM PIXEL
00172C  3                       LDY     #$02+VIDEOBANK  ; AREA $2000-$2FFF
00172C  3                       JSR     PAGE_ENTER
00172C  3                       LDY     #$00
00172C  3                       LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
00172C  3                       AND     #$F0
00172C  3                       ORA     PLOTCOLOR
00172C  3                       STA     (TEMPW),Y       ; STORE  DOUBLE PIXEL
00172C  3                       JSR     PAGE_EXIT
00172C  3                       RTS
00172C  3               
00172C  3               V_PLOT_HIRES_COLOR:
00172C  3                       LDA     PLOTX
00172C  3                       PHA                     ; PUSH LOW BYTE OF X (FOR EVEN/ODD LATER)
00172C  3                       LSR     PLOTX+1
00172C  3                       ROR     PLOTX           ; 2 PIXEL PER BYTE
00172C  3                       LDA     PLOTX           ;
00172C  3                                               ; FIGURE THE BUFFER OFFSET
00172C  3                       CLC                     ; MULTIPLY Y COORD BY 70 OR 140 (SINGLE OR DOUBLE HIRES)
00172C  3                       ASL     PLOTY
00172C  3                       ROL     PLOTY+1         ; *2
00172C  3                       LDA     PLOTY
00172C  3                       STA     PTEMPW
00172C  3                       LDA     PLOTY+1
00172C  3                       STA     PTEMPW+1        ; STORE Y*2 INTO PTEMPW
00172C  3                       ASL     PLOTY
00172C  3                       ROL     PLOTY+1         ; *2 (*4)
00172C  3                       LDA     PLOTY
00172C  3                       STA     PTEMPW1
00172C  3                       LDA     PLOTY+1
00172C  3                       STA     PTEMPW1+1       ; STORE Y*4 INTO PTEMPW1
00172C  3                       ASL     PLOTY
00172C  3                       ROL     PLOTY+1         ; *2 (*8)
00172C  3                       ASL     PLOTY
00172C  3                       ROL     PLOTY+1         ; *2 (*16)
00172C  3                       ASL     PLOTY
00172C  3                       ROL     PLOTY+1         ; *2 (*32)
00172C  3                       ASL     PLOTY
00172C  3                       ROL     PLOTY+1         ; *2 (*64)
00172C  3                                               ; RESULT OFFSET PLOTY = PLOTY(Y*64)+PTEMPW(Y*2)+PTEMPW1(Y*4)
00172C  3                       CLC                     ; Clear the Carry flag before the first addition
00172C  3                       LDA     PLOTY           ; Load the low byte of the first number into the accumulator
00172C  3                       ADC     PTEMPW          ; Add the low byte of the second number (plus carry)
00172C  3                       STA     PLOTY           ; Store the low byte of the result
00172C  3                       LDA     PLOTY+1         ; Load the high byte of the first number
00172C  3                       ADC     PTEMPW+1        ; Add the high byte of the second number (plus carry from previous op)
00172C  3                       STA     PLOTY+1         ; Store the high byte of the result
00172C  3               
00172C  3                       CLC                     ; Clear the Carry flag before the first addition
00172C  3                       LDA     PLOTY           ; Load the low byte of the first number into the accumulator
00172C  3                       ADC     PTEMPW1         ; Add the low byte of the second number (plus carry)
00172C  3                       STA     PLOTY           ; Store the low byte of the result
00172C  3                       LDA     PLOTY+1         ; Load the high byte of the first number
00172C  3                       ADC     PTEMPW1+1       ; Add the high byte of the second number (plus carry from previous op)
00172C  3                       STA     PLOTY+1         ; Store the high byte of the result
00172C  3               
00172C  3               ; if double hires double it.
00172C  3                       LDA     VIDEOMODE
00172C  3                       AND     #$10
00172C  3                       CMP     #00
00172C  3                       BEQ     :+
00172C  3                       ASL     PLOTY
00172C  3                       ROL     PLOTY+1         ; *2
00172C  3               :
00172C  3               ; PLOTY IS NOW Y OFFSET, ADD X OFFSET FOR MEMORY ADDRESS INTO TEMPW
00172C  3                       CLC                     ; Clear the Carry flag before the first addition
00172C  3                       LDA     PLOTY           ; Load the low byte of the first number into the accumulator
00172C  3                       ADC     PLOTX           ; Add the low byte of the second number (plus carry)
00172C  3                       STA     TEMPW           ; Store the low byte of the result
00172C  3                       LDA     PLOTY+1         ; Load the high byte of the first number
00172C  3                       ADC     PLOTX+1         ; Add the high byte of the second number (plus carry from previous op)
00172C  3                       STA     TEMPW+1         ; Store the high byte of the result
00172C  3               
00172C  3                       LDA     TEMPW+1         ; OK, LET'S CALCULATE THE BANK
00172C  3                       AND     #$F0
00172C  3                       LSR     A
00172C  3                       LSR     A
00172C  3                       LSR     A
00172C  3                       LSR     A
00172C  3                       CLC
00172C  3                       ADC     #$02+VIDEOBANK  ; AREA $2000-?
00172C  3                       CMP     #$F8
00172C  3                       BCC     V_PLOT_HIRES_COLOR_RANGE
00172C  3                       TAY                     ; VIDEO BANK SHOULD BE IN Y
00172C  3                       JSR     PAGE_ENTER
00172C  3               
00172C  3                       LDA     TEMPW+1
00172C  3                       AND     #$0F
00172C  3                       ORA     #$A0
00172C  3                       STA     TEMPW+1         ; TEMPW NOW REFLECTS MAPPED ADDRESSS
00172C  3                       PLA
00172C  3                       LSR     A               ; LEFT OR RIGHT PIXEL?
00172C  3                       BCC     :+
00172C  3                                               ; LEFT PIXEL
00172C  3                       LDY     #$00
00172C  3                       LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
00172C  3                       AND     #$0F
00172C  3                       PHA
00172C  3                       LDA     PLOTCOLOR
00172C  3                       ASL     A
00172C  3                       ASL     A
00172C  3                       ASL     A
00172C  3                       ASL     A
00172C  3                       STA     PLOTCOLOR
00172C  3                       PLA
00172C  3                       ORA     PLOTCOLOR
00172C  3                       STA     (TEMPW),Y       ; WRITE THE PIXEL BACK OUT
00172C  3                       JSR     PAGE_EXIT
00172C  3                       RTS
00172C  3               :
00172C  3               ; RIGHT PIXEL
00172C  3                       LDY     #$00
00172C  3                       LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
00172C  3                       AND     #$F0
00172C  3                       ORA     PLOTCOLOR
00172C  3                       STA     (TEMPW),Y       ; WRITE THE PIXEL BACK OUT
00172C  3                       JSR     PAGE_EXIT
00172C  3                       RTS
00172C  3               
00172C  3               V_PLOT_HIRES_COLOR_RANGE:
00172C  3                       JMP     LAB_2564
00172C  3               
00172C  3               V_PLOT_HIRES_MONO:
00172C  3                       LDA     PLOTX
00172C  3                       PHA
00172C  3                       LSR     PLOTX+1
00172C  3                       ROR     PLOTX
00172C  3                       LSR     PLOTX+1
00172C  3                       ROR     PLOTX
00172C  3                       LSR     PLOTX+1
00172C  3                       ROR     PLOTX           ; 8 PIXEL PER BYTE
00172C  3                       LDA     #00
00172C  3                       STA     PLOTX+1
00172C  3                       STA     PTEMPW1+1
00172C  3                       LDA     PLOTY
00172C  3                       STA     PTEMPW1
00172C  3                                               ; MULTIPLY Y COORD BY 35 OR 70 (MONO OR QUAD HIRES)
00172C  3                       ASL     PLOTY
00172C  3                       ROL     PLOTY+1         ; *2
00172C  3                       LDA     PLOTY
00172C  3                       STA     PTEMPW
00172C  3                       LDA     PLOTY+1
00172C  3                       STA     PTEMPW+1        ; STORE *2 INTO PTEMPW
00172C  3                       ASL     PLOTY
00172C  3                       ROL     PLOTY+1         ; *2 (*4)
00172C  3                       ASL     PLOTY
00172C  3                       ROL     PLOTY+1         ; *2 (*8)
00172C  3                       ASL     PLOTY
00172C  3                       ROL     PLOTY+1         ; *2 (*16)
00172C  3                       ASL     PLOTY
00172C  3                       ROL     PLOTY+1         ; *2 (*32)
00172C  3               ;
00172C  3               ; PLOTY(Y*35) = PLOTY(Y*32)+PTEMPW(Y*2)+PTEMPW1(Y)
00172C  3                       CLC                     ; Clear the Carry flag before the first addition
00172C  3                       LDA     PLOTY           ; Load the low byte of the first number into the accumulator
00172C  3                       ADC     PTEMPW          ; Add the low byte of the second number (plus carry)
00172C  3                       STA     PLOTY           ; Store the low byte of the result
00172C  3               
00172C  3                       LDA     PLOTY+1         ; Load the high byte of the first number
00172C  3                       ADC     PTEMPW+1        ; Add the high byte of the second number (plus carry from previous op)
00172C  3                       STA     PLOTY+1         ; Store the high byte of the result
00172C  3                       CLC                     ; Clear the Carry flag before the first addition
00172C  3                       LDA     PLOTY           ; Load the low byte of the first number into the accumulator
00172C  3                       ADC     PTEMPW1         ; Add the low byte of the second number (plus carry)
00172C  3                       STA     PLOTY           ; Store the low byte of the result
00172C  3               
00172C  3                       LDA     PLOTY+1         ; Load the high byte of the first number
00172C  3                       ADC     PTEMPW1+1       ; Add the high byte of the second number (plus carry from previous op)
00172C  3                       STA     PLOTY+1         ; Store the high byte of the result
00172C  3               ;
00172C  3               ; PLOTY IS NOW THE Y OFFSET
00172C  3               ; if quad hires double it.
00172C  3                       LDA     VIDEOMODE
00172C  3                       AND     #$10
00172C  3                       CMP     #00
00172C  3                       BNE     :+
00172C  3                       ASL     PLOTY
00172C  3                       ROL     PLOTY+1         ; *2
00172C  3               :
00172C  3               ; ADD THE X OFFSET
00172C  3                       CLC                     ; Clear the Carry flag before the first addition
00172C  3                       LDA     PLOTY           ; Load the low byte of the first number into the accumulator
00172C  3                       ADC     PLOTX           ; Add the low byte of the second number (plus carry)
00172C  3                       STA     TEMPW           ; Store the low byte of the result
00172C  3               
00172C  3                       LDA     PLOTY+1         ; Load the high byte of the first number
00172C  3                       ADC     PLOTX+1         ; Add the high byte of the second number (plus carry from previous op)
00172C  3                       STA     TEMPW+1         ; Store the high byte of the result
00172C  3                                               ; TEMPW IS NOW THE MEMORY ADDRESS
00172C  3               
00172C  3                       LDA     TEMPW+1         ; OK, LET'S CALCULATE THE BANK
00172C  3                       AND     #$F0
00172C  3                       LSR     A
00172C  3                       LSR     A
00172C  3                       LSR     A
00172C  3                       LSR     A
00172C  3                       CLC
00172C  3                       ADC     #$02+VIDEOBANK  ; AREA $2000-?
00172C  3                       CMP     #$F8
00172C  3                       BCC     V_PLOT_HIRES_COLOR_RANGE1
00172C  3                       TAY                     ; VIDEO BANK SHOULD BE IN Y
00172C  3                       JSR     PAGE_ENTER
00172C  3                       LDA     TEMPW+1
00172C  3                       AND     #$0F
00172C  3                       ORA     #$A0
00172C  3                       STA     TEMPW+1         ; TEMPW NOW REFLECTS MAPPED ADDRESSS
00172C  3                       PLA
00172C  3                       AND     #$07            ; WHICH BIT?
00172C  3                       TAX
00172C  3                       LDA     PLOTCOLOR
00172C  3                       CMP     #$01
00172C  3                       BNE     :+
00172C  3                       LDA     HIRES_BIT_LOOKUP_SET,X
00172C  3                       LDY     #$00
00172C  3                       ORA     (TEMPW),Y
00172C  3                       STA     (TEMPW),Y
00172C  3                       JSR     PAGE_EXIT
00172C  3                       RTS
00172C  3               :
00172C  3                       LDA     HIRES_BIT_LOOKUP_RESET,X
00172C  3                       PHA
00172C  3                       LDY     #$00
00172C  3                       AND     (TEMPW),Y
00172C  3                       STA     (TEMPW),Y
00172C  3                       JSR     PAGE_EXIT
00172C  3                       RTS
00172C  3               V_PLOT_HIRES_COLOR_RANGE1:
00172C  3                       JMP     LAB_2564
00172C  3               HIRES_BIT_LOOKUP_SET:
00172C  3                       .BYTE   %10000000,%01000000,%00100000,%00010000,%00001000,%00000100,%00000010,%00000001
00172C  3               HIRES_BIT_LOOKUP_RESET:
00172C  3                       .BYTE   %01111111,%10111111,%11011111,%11101111,%11110111,%11111011,%11111101,%11111110
00172C  3               
00172C  3               ;___V_PATTERN________________________________________________
00172C  3               ;
00172C  3               ;  DEFINE GRAPHICS PATTERN
00172C  3               ;
00172C  3               ;  TAKES 10 PARAMETERS
00172C  3               ;       PATTERN NUM (0-255)
00172C  3               ;       PATTERN DATA (8 BYTES)
00172C  3               ;__________________________________________________________
00172C  3               LAB_PATTERN
00172C  3               V_PATTERN:
00172C  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X
00172C  3                       TXA
00172C  3                       PHA
00172C  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00172C  3                       JSR     PAGE_ENTER
00172C  3                       PLA
00172C  3                       STA     VideoCharGenOffset
00172C  3                       LDY     #8
00172C  3               :
00172C  3                       TYA
00172C  3                       PHA
00172C  3                       JSR     LAB_1C01        ; GET THE NEXT PARAMETER (AFTER ',') OR SYN ERR
00172C  3                       JSR     LAB_GTBY        ; GET THE NEXT PARAMETER, RETURN IN X
00172C  3                       PLA
00172C  3                       TAY
00172C  3                       TXA
00172C  3                       STA     VideoCharGenData
00172C  3                       DEY
00172C  3                       CPY     #$00
00172C  3                       BNE     :-
00172C  3                       JSR     PAGE_EXIT
00172C  3                       RTS
00172C  3               
00172C  3               ;___LAB_LINE_______________________________________________
00172C  3               ;
00172C  3               ;  DRAW LINE USING THE BRESENHAM LINE DRAWING ALGORITHM
00172C  3               ;
00172C  3               ;  TAKES 5 PARAMETERS
00172C  3               ;       START X,Y
00172C  3               ;       DESTINATION X,Y
00172C  3               ;       COLOR
00172C  3               ;__________________________________________________________
00172C  3               LAB_LINE:
00172C  3               ; GET X1
00172C  3                       JSR     LAB_EVNM        ; evaluate expression and check is numeric,
00172C  3                                               ; else do type mismatch
00172C  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
00172C  3                       LDA     Itemph
00172C  3                       STA     LINEX1+1
00172C  3                       LDA     Itempl
00172C  3                       STA     LINEX1
00172C  3                                               ; GET Y1
00172C  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
00172C  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
00172C  3                       STX     LINEY1          ; STORE IN LINEY1
00172C  3               
00172C  3               ; GET X2
00172C  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
00172C  3                       JSR     LAB_EVNM        ; evaluate expression and check is numeric,
00172C  3                                               ; else do type mismatch
00172C  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
00172C  3                       LDA     Itemph
00172C  3                       STA     LINEX2+1
00172C  3                       LDA     Itempl
00172C  3                       STA     LINEX2
00172C  3                                               ; GET Y2
00172C  3                       JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
00172C  3                       JSR     LAB_GTBY        ; RETURN IN X
00172C  3                       STX     LINEY2          ; STORE IN LINEY2
00172C  3                                               ; GET COLOR
00172C  3                       JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
00172C  3                       JSR     LAB_GTBY        ; RETURN IN X
00172C  3                       STX     LINECOLOR       ; STORE IN COLOR
00172C  3                       LDA     #$00
00172C  3                       STA     LINEY1+1
00172C  3                       STA     LINEY2+1
00172C  3                                               ; LINE COORDS AND COLOR STORED IN PROPER PLACE
00172C  3                                               ; CALCULATE DELTAX
00172C  3                       SEC                     ; Set Carry flag (represents "no borrow" for 1st byte)
00172C  3                       LDA     LINEX1          ; Load low byte of number 1
00172C  3                       SBC     LINEX2          ; Subtract low byte of number 2 with carry
00172C  3                       STA     DELTAX          ; Store result low byte
00172C  3                       LDA     LINEX1+1        ; Load high byte of number 1
00172C  3                       SBC     LINEX2+1        ; Subtract high byte of number 2 with borrow
00172C  3                       STA     DELTAX+1        ; Store result high byte
00172C  3                       BCS     :+              ; BRANCH IF X1>=X2
00172C  3                                               ; X1 < X2
00172C  3                       LDA     #0
00172C  3                       STA     PTEMP           ; IF X2>X1 (PTEMP=x0)
00172C  3                       LDA     #$FF            ; TAKE ABSOLUTE VALUE OF DELTAX
00172C  3                       EOR     DELTAX+1        ; Invert high byte (one's complement)
00172C  3                       STA     DELTAX+1
00172C  3                       LDA     #$FF            ;
00172C  3                       EOR     DELTAX          ; Invert low byte
00172C  3                       STA     DELTAX          ;
00172C  3                       INC     DELTAX          ; Add 1 to the low byte
00172C  3                       BNE     :++             ; If no carry from low byte INC, we are done
00172C  3                       INC     DELTAX+1        ; Increment high byte if carry occurred
00172C  3                       JMP     :++
00172C  3               :
00172C  3                       LDA     #1
00172C  3                       STA     PTEMP           ; IF X1>X2 (PTEMP=x1)
00172C  3               :
00172C  3                                               ; CALCULATE DELTAY
00172C  3                       LDA     #0
00172C  3                       STA     DELTAY+1
00172C  3                       SEC                     ; Set Carry flag
00172C  3                       LDA     LINEY1          ; Load low byte of number 1
00172C  3                       SBC     LINEY2          ; Subtract low byte of number 2 with carry
00172C  3                       STA     DELTAY          ; Store result low byte
00172C  3                       BCS     :+              ; BRANCH IF Y1>=Y2
00172C  3                                               ; Y1 < Y2
00172C  3                       LDA     PTEMP
00172C  3                       AND     #1
00172C  3                       STA     PTEMP           ; IF Y2>Y1 (PTEMP=0x)
00172C  3                                               ; TAKE ABSOLUTE VALUE OF DELTAY
00172C  3                       LDA     #$FF
00172C  3                       EOR     DELTAY          ; Flip all bits (one's complement)
00172C  3                       STA     DELTAY
00172C  3                       INC     DELTAY          ; Add 1 (two's complement)
00172C  3                       JMP     :++
00172C  3               :
00172C  3                       LDA     PTEMP
00172C  3                       ORA     #$10
00172C  3                       STA     PTEMP           ; IF Y1>Y2 (PTEMP=1x)
00172C  3               :
00172C  3                                               ; SLOPE DETERMINED, AND DELTAS CALCULATED
00172C  3                                               ; OK, LET'S FIND OUT IF THIS IS A HORIZONTAL-ISH
00172C  3                                               ; OR VERTICAL-ISH LINE
00172C  3                       SEC                     ; Set Carry Flag (for subtraction)
00172C  3                       LDA     DELTAX          ; Load low byte of DELTAX
00172C  3                       SBC     DELTAY          ; Subtract low byte of DELTAY
00172C  3                       LDA     DELTAX+1        ; Load high byte of DELTAX
00172C  3                       SBC     DELTAY+1        ; Subtract high byte of DELTAY (with borrow)
00172C  3                                               ; Flags now reflect the 16-bit comparison
00172C  3                       BCC     LINEVERT        ; If Carry clear, LINE IS VERTICAL-ISH
00172C  3                       JMP     LINEHORZ
00172C  3               LINEVERT:
00172C  3                                               ; FOR A VERTICAL-ISH LINE WE STEP ALONG THE
00172C  3                                               ; Y AXIS (STEEP GRADIENT)
00172C  3                                               ; FIND LARGER Y . . .
00172C  3                       LDA     LINEY1
00172C  3                       CMP     LINEY2
00172C  3                       BCS     :+
00172C  3                       JSR     LINESWAPXY
00172C  3               :
00172C  3                                               ; Initialize error = DELTAY / 2
00172C  3                       LDA     DELTAY
00172C  3                       STA     LINEERR
00172C  3                       LDA     DELTAY+1
00172C  3                       STA     LINEERR+1
00172C  3                       LSR     LINEERR+1
00172C  3                       ROR     LINEERR
00172C  3               LINEVERTLOOP:
00172C  3                       LDA     LINEY1          ; OK LET'S PLOT A POINT
00172C  3                       STA     PLOTY
00172C  3                       LDA     LINEY1+1
00172C  3                       STA     PLOTY+1
00172C  3                       LDA     LINEX1
00172C  3                       STA     PLOTX
00172C  3                       LDA     LINEX1+1
00172C  3                       STA     PLOTX+1
00172C  3                       LDA     LINECOLOR
00172C  3                       STA     PLOTCOLOR
00172C  3                       JSR     DOPLOTXY
00172C  3                                               ; NOW MOVE LINE1 CLOSER TO LINE2
00172C  3                       DEC     LINEY1          ; BY STEPPING ALONG Y AXIS
00172C  3               
00172C  3                                               ; BRESENHAM: err -= DELTAX
00172C  3                       SEC
00172C  3                       LDA     LINEERR
00172C  3                       SBC     DELTAX
00172C  3                       STA     LINEERR
00172C  3                       LDA     LINEERR+1
00172C  3                       SBC     DELTAX+1
00172C  3                       STA     LINEERR+1
00172C  3                       BPL     LINEVERT_NOSTEP ; IF ERR >= 0, NO X STEP NEEDED
00172C  3                                               ; ERR += DELTAY (RESTORE ERROR)
00172C  3                       CLC
00172C  3                       LDA     LINEERR
00172C  3                       ADC     DELTAY
00172C  3                       STA     LINEERR
00172C  3                       LDA     LINEERR+1
00172C  3                       ADC     DELTAY+1
00172C  3                       STA     LINEERR+1
00172C  3                                               ; STEP X TOWARD X2 (16-BIT)
00172C  3                       LDA     LINEX2
00172C  3                       CMP     LINEX1
00172C  3                       LDA     LINEX2+1
00172C  3                       SBC     LINEX1+1
00172C  3                       BCC     LINEVERT_DECX   ; X2 < X1, DECREMENT X1
00172C  3                       INC     LINEX1          ; X2 >= X1, INCREMENT X1
00172C  3                       BNE     LINEVERT_NOSTEP
00172C  3                       INC     LINEX1+1
00172C  3                       JMP     LINEVERT_NOSTEP
00172C  3               LINEVERT_DECX:
00172C  3                       LDA     LINEX1
00172C  3                       BNE     :+
00172C  3                       DEC     LINEX1+1
00172C  3               :       DEC     LINEX1
00172C  3               LINEVERT_NOSTEP:
00172C  3               
00172C  3                       LDA     LINEY1
00172C  3                       CMP     LINEY2
00172C  3                       BNE     LINEVERTLOOP
00172C  3                       RTS                     ; DONE
00172C  3               
00172C  3               LINEHORZ:
00172C  3               ; FOR A HORIZONTAL-ISH LINE WE STEP ALONG THE
00172C  3               ; X AXIS (SHALLOW GRADIENT)
00172C  3               ; FIND LARGER X . . .
00172C  3                       SEC                     ; Set carry flag for subtraction
00172C  3                       LDA     LINEX2          ; Load low byte of first number
00172C  3                       SBC     LINEX1          ; Subtract low byte of second number
00172C  3                       LDA     LINEX2+1        ; Load high byte of first number
00172C  3                       SBC     LINEX1+1        ; Subtract high byte of second number
00172C  3                                               ; Result flags (N, Z, C) now reflect: Val1 - Val2
00172C  3                       BCS     :+              ; If carry is set, LINEX2 >= LINEX1
00172C  3                       JSR     LINESWAPXY
00172C  3               :
00172C  3                                               ; Initialize error = DELTAX / 2
00172C  3                       LDA     DELTAX
00172C  3                       STA     LINEERR
00172C  3                       LDA     DELTAX+1
00172C  3                       STA     LINEERR+1
00172C  3                       LSR     LINEERR+1
00172C  3                       ROR     LINEERR
00172C  3               LINEHORZLOOP:
00172C  3                       LDA     LINEY1          ; OK LET'S PLOT A POINT
00172C  3                       STA     PLOTY
00172C  3                       LDA     LINEY1+1
00172C  3                       STA     PLOTY+1
00172C  3                       LDA     LINEX1
00172C  3                       STA     PLOTX
00172C  3                       LDA     LINEX1+1
00172C  3                       STA     PLOTX+1
00172C  3                       LDA     LINECOLOR
00172C  3                       STA     PLOTCOLOR
00172C  3                       JSR     DOPLOTXY
00172C  3                                               ; NOW MOVE LINE1 CLOSER TO LINE2
00172C  3                       INC     LINEX1          ; BY STEPPING ALONG X AXIS
00172C  3                       BNE     :+
00172C  3                       INC     LINEX1+1
00172C  3               :
00172C  3                                               ; BRESENHAM: err -= DELTAY
00172C  3                       SEC
00172C  3                       LDA     LINEERR
00172C  3                       SBC     DELTAY
00172C  3                       STA     LINEERR
00172C  3                       LDA     LINEERR+1
00172C  3                       SBC     DELTAY+1
00172C  3                       STA     LINEERR+1
00172C  3                       BPL     LINEHORZ_NOSTEP ; IF ERR >= 0, NO Y STEP NEEDED
00172C  3                                               ; ERR += DELTAX (RESTORE ERROR)
00172C  3                       CLC
00172C  3                       LDA     LINEERR
00172C  3                       ADC     DELTAX
00172C  3                       STA     LINEERR
00172C  3                       LDA     LINEERR+1
00172C  3                       ADC     DELTAX+1
00172C  3                       STA     LINEERR+1
00172C  3                                               ; STEP Y TOWARD Y2
00172C  3                       LDA     LINEY2
00172C  3                       CMP     LINEY1
00172C  3                       BCC     LINEHORZ_DECY   ; Y2 < Y1, DECREMENT
00172C  3                       INC     LINEY1          ; Y2 >= Y1, INCREMENT
