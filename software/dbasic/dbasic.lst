001234  3  A9 00                LDA     #$00
001236  3  8D 3C 13             STA     NullCounter
001239  3  20 F2 12             JSR     DOS65FCBPREP    ; parse parameters into FCB
00123C  3  B0 20                BCS     DOS65LOAD_ERR1  ; Error?, if so abort
00123E  3  A2 0D                LDX     #13             ;
001240  3  20 77 11             JSR     PEM             ;
001243  3  A9 00                LDA     #0              ; clear
001245  3  8D BA 15             STA     FCB+32          ; record number
001248  3  A9 9A                LDA     #<FCB           ; Open File
00124A  3  A0 15                LDY     #>FCB           ;
00124C  3  A2 0F                LDX     #15             ;
00124E  3  20 77 11             JSR     PEM             ;
001251  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
001253  3  D0 0C                BNE     DOS65LOAD_1     ;
001255  3               DOS65LOAD_ERR:
001255  3  A9 AB                LDA     #<FILEERROR2    ; NO, ERROR OUT
001257  3  A0 0F                LDY     #>FILEERROR2
001259  3  A2 09                LDX     #9              ; Print error message
00125B  3  20 77 11             JSR     PEM             ;
00125E  3               DOS65LOAD_ERR1:
00125E  3  4C 9A 1D             JMP     LAB_REM         ; comment out the remainder of the line (if any)
001261  3               DOS65LOAD_1:
001261  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
001263  3  85 22                STA     FCBPTR+2        ; point to base of RAM
001265  3  8D 3A 13             STA     EndOfBas        ;
001268  3  A5 7A                LDA     <Smemh          ;
00126A  3  85 23                STA     FCBPTR+3        ;
00126C  3  8D 3B 13             STA     EndOfBas+1      ;
00126F  3  A9 24                LDA     #<FCBBUFFER     ; SETUP BUFFER
001271  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
001273  3  A0 37                LDY     #>FCBBUFFER     ;
001275  3  84 21                STY     FCBPTR+1        ; STORE DEST BUFFER IN FCBPTR
001277  3  A2 1A                LDX     #26             ; Setup Buffer
001279  3  20 77 11             JSR     PEM             ;
00127C  3  4C BA 12             JMP     DOS65LOAD_3C
00127F  3               DOS65LOAD_3:
00127F  3  B1 20                LDA     (FCBPTR),Y      ; load from BUFFER
001281  3  91 22                STA     (FCBPTR+2),Y    ; save to RAM
001283  3  EE 3A 13             INC     EndOfBas
001286  3  D0 03                BNE     :+
001288  3  EE 3B 13             INC     EndOfBas+1
00128B  3               :
00128B  3  C9 00                CMP     #$00
00128D  3  D0 0D                BNE     :+
00128F  3  EE 3C 13             INC     NullCounter
001292  3  AD 3C 13             LDA     NullCounter
001295  3  C9 03                CMP     #3
001297  3  D0 08                BNE     :++
001299  3  4C CD 12             JMP     DOS65LOAD_4
00129C  3               :
00129C  3  A9 00                LDA     #$00
00129E  3  8D 3C 13             STA     NullCounter
0012A1  3               :
0012A1  3  C8                   INY                     ; bump index
0012A2  3  C0 80                CPY     #$80            ; end of buffer?
0012A4  3  D0 D9                BNE     DOS65LOAD_3     ; no, loop
0012A6  3  18                   CLC                     ;
0012A7  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
0012A9  3  69 80                ADC     #$80            ;
0012AB  3  85 22                STA     FCBPTR+2        ;
0012AD  3  90 0B                BCC     DOS65LOAD_3C    ; is carry?, no SKIP
0012AF  3  18                   CLC                     ; yes, carry, inc high byte
0012B0  3  A5 23                LDA     FCBPTR+3        ;
0012B2  3  69 01                ADC     #$01            ;
0012B4  3  85 23                STA     FCBPTR+3        ;
0012B6  3  C9 B8                CMP     #>Ram_top       ; are we at the end of RAM?
0012B8  3  F0 13                BEQ     DOS65LOAD_4
0012BA  3               
0012BA  3               DOS65LOAD_3C:
0012BA  3  A9 9A                LDA     #<FCB           ; READ record buffer from disk file
0012BC  3  A0 15                LDY     #>FCB           ;
0012BE  3  A2 14                LDX     #20             ;
0012C0  3  20 77 11             JSR     PEM             ;
0012C3  3  A0 00                LDY     #$00            ; RESET INDEX
0012C5  3  C9 00                CMP     #$00            ; is error or EOF
0012C7  3  F0 B6                BEQ     DOS65LOAD_3     ;
0012C9  3  C9 01                CMP     #$01            ; EOF?
0012CB  3  D0 88                BNE     DOS65LOAD_ERR   ; ERROR, do error handling
0012CD  3               DOS65LOAD_4:
0012CD  3  A9 9A                LDA     #<FCB           ;
0012CF  3  A0 15                LDY     #>FCB           ;
0012D1  3  A2 10                LDX     #16             ;
0012D3  3  20 77 11             JSR     PEM             ;
0012D6  3                                               ; setup pointers to return to basic
0012D6  3  AD 3A 13             LDA     EndOfBas
0012D9  3  85 7B                STA     Svarl
0012DB  3  85 7D                STA     Sarryl
0012DD  3  85 7F                STA     Earryl
0012DF  3  AD 3B 13             LDA     EndOfBas+1
0012E2  3  85 7C                STA     Svarh
0012E4  3  85 7E                STA     Sarryh
0012E6  3  85 80                STA     Earryh
0012E8  3  A9 52                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
0012EA  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
0012EC  3  20 41 1F             JSR     LAB_18C3
0012EF  3  4C 96 18             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
0012F2  3               
0012F2  3               
0012F2  3               
0012F2  3               DOS65FCBPREP:
0012F2  3                       .IFDEF  DUODYNE
0012F2  3                       JSL     LAB_GBYT        ; scan memory
0012F2  3                       .ELSE
0012F2  3  20 C2 00             JSR     LAB_GBYT        ; scan memory
0012F5  3                       .ENDIF
0012F5  3               
0012F5  3  38                   SEC                     ;
0012F6  3  E9 40                SBC     #64             ; PARSE DRIVE NUMBER
0012F8  3  8D 9A 15             STA     DOSDRIVE        ; STORE IT IN FCB
0012FB  3                       .IFDEF  DUODYNE
0012FB  3                       JSL     LAB_IGBY        ; increment and scan memory
0012FB  3                       .ELSE
0012FB  3  20 BC 00             JSR     LAB_IGBY        ; increment and scan memory
0012FE  3                       .ENDIF
0012FE  3               
0012FE  3  C9 3A                CMP     #':'            ;
001300  3  F0 0E                BEQ     DOS65FCBPREP_1  ; YES, IT WAS A DRIVE, CONTINUE
001302  3  A9 80                LDA     #<FILEERROR1    ; NO, ERROR OUT
001304  3  A0 0F                LDY     #>FILEERROR1
001306  3  A2 09                LDX     #9
001308  3  20 77 11             JSR     PEM
00130B  3  20 9A 1D             JSR     LAB_REM
00130E  3  38                   SEC
00130F  3  60                   RTS
001310  3               DOS65FCBPREP_1:
001310  3  A9 9A                LDA     #<FCB           ; SETUP FCBPTR
001312  3  85 20                STA     FCBPTR          ;
001314  3  A9 15                LDA     #>FCB           ;
001316  3  85 21                STA     FCBPTR+1        ;
001318  3  A0 01                LDY     #$01            ; POINT Y TO FCB FILE NAME
00131A  3  A9 20                LDA     #$20            ; LOAD SPACE CHAR INTO A
00131C  3               DOS65FCBPREP_1A:                ; BLANK OUT FCB
00131C  3  91 20                STAINDIRECTY FCBPTR     ;
00131E  3  C8                   INY                     ;
00131F  3  C0 09                CPY     #$09            ; IS DONE
001321  3  D0 F9                BNE     DOS65FCBPREP_1A ; NO, LOOP
001323  3  A0 01                LDY     #$01            ; POINT Y TO FCB FILE NAME
001325  3               DOS65FCBPREP_2:                 ; COPY FILE NAME PARAMETER INTO FCB
001325  3                       .IFDEF  DUODYNE
001325  3                       JSL     LAB_IGBY        ; increment and scan memory
001325  3                       .ELSE
001325  3  20 BC 00             JSR     LAB_IGBY        ; increment and scan memory
001328  3                       .ENDIF
001328  3  F0 0E                BEQ     DOS65FCBPREP_3  ;
00132A  3  C9 2E                CMP     #'.'
00132C  3  F0 0A                BEQ     DOS65FCBPREP_3  ;
00132E  3  91 20                STAINDIRECTY FCBPTR     ;
001330  3  C8                   INY                     ;
001331  3  C0 09                CPY     #$09            ;
001333  3  F0 03                BEQ     DOS65FCBPREP_3  ;
001335  3  4C 25 13             JMP     DOS65FCBPREP_2  ;
001338  3               DOS65FCBPREP_3:                 ;
