0010DA  2                       LDA     CURX
0010DA  2                       CMP     #00
0010DA  2                       BEQ     crsrlt_1
0010DA  2                       DEC     CURX
0010DA  2                       JMP     ploop
0010DA  2               crsrlt_1:
0010DA  2                       LDA     CURY
0010DA  2                       CMP     #00
0010DA  2                       BEQ     :+
0010DA  2                       LDX     VIDEOWIDTH
0010DA  2                       DEX
0010DA  2                       STX     CURX
0010DA  2                       LDY     CURY
0010DA  2                       DEY
0010DA  2                       STY     CURY
0010DA  2               :
0010DA  2                       JMP     ploop
0010DA  2               crsrrt:
