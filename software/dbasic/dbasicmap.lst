001531  3  8A                   TXA
001532  3  8D EE 16             STA     FCB             ; STORE DRIVE IN FCB
001535  3                                               ;
001535  3  20 F2 2A             JSR     LAB_1C01        ; (AFTER ',') OR SYN ERR
001538  3  20 83 33             JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X (MODE)
00153B  3                                               ;
00153B  3  E0 00                CPX     #0
00153D  3  D0 08                BNE     :+
00153F  3  A9 0F                LDA     #15
001541  3  8D F5 15             STA     OPNTMP
001544  3  4C 4C 15             JMP     V_OPEN1
001547  3               :
001547  3  A9 16                LDA     #22
001549  3  8D F5 15             STA     OPNTMP          ;
00154C  3               V_OPEN1:
00154C  3  20 F2 2A             JSR     LAB_1C01        ; (AFTER ',') OR SYN ERR
00154F  3  20 D4 29             JSR     LAB_EVEX        ; GET THE THIRD PARAMETER
