002108  3               ;___SOUND__________________________________________________
002108  3               ;
002108  3               ; PLAY SOUND
002108  3               ;
002108  3               ;  TAKES TWO PARAMETERS CHANNEL,FREQUENCY
002108  3               ;
002108  3               ; THIS IS NATIVE '816 CODE
002108  3               ;__________________________________________________________
002108  3               LAB_SOUND:
002108  3  20 B4 37             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (CHANNEL)
00210B  3  DA                   PHX
00210C  3  20 23 2F             JSR     LAB_1C01        ; (AFTER ',') OR SYN ERR
00210F  3  20 F1 2D             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
002112  3               ; else do type mismatch
002112  3  20 1A 38             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
002115  3               
002115  3  68                   PLA                     ; LIMIT THE CHANNELS TO <3
002116  3  29 03                AND     #$03
002118  3  18                   CLC
002119  3  0A                   ASL                     ; = *2
00211A  3  48                   PHA
00211B  3  A4 11                LDY     <Itempl
00211D  3  20 32 22             JSR     psgwr           ; SET LOW BYTE
002120  3  68                   PLA
002121  3  1A                   INC     A
002122  3  A4 12                LDY     <Itemph
002124  3  20 32 22             JSR     psgwr           ; SET HIGH BYTE
002127  3  60                   RTS
002128  3               
002128  3               ;___VOLUME__________________________________________________
002128  3               ;
002128  3               ; SET VOLUME
002128  3               ;
002128  3               ;  TAKES TWO PARAMETERS CHANNEL,VOLUME
002128  3               ;
002128  3               ; THIS IS NATIVE '816 CODE
002128  3               ;__________________________________________________________
002128  3               LAB_VOLUME:
002128  3  20 B4 37             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (CHANNEL)
00212B  3  DA                   PHX
00212C  3  20 23 2F             JSR     LAB_1C01        ; (AFTER ',') OR SYN ERR
00212F  3  20 B4 37             JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X (VOLUME)
002132  3  8A                   TXA
002133  3  A8                   TAY
002134  3  68                   PLA                     ; LIMIT THE CHANNELS TO <3
002135  3  29 03                AND     #$03
002137  3               
002137  3  18                   CLC
002138  3  69 08                ADC     #08
00213A  3  20 32 22             JSR     psgwr
00213D  3  60                   RTS
00213E  3               
00213E  3               
00213E  3               ;___VOICE__________________________________________________
00213E  3               ;
00213E  3               ; SET VOICE
00213E  3               ;
00213E  3               ;  TAKES TWO PARAMETERS VOICE, ENVELOPE
00213E  3               ;
00213E  3               ; THIS IS NATIVE '816 CODE
00213E  3               ;__________________________________________________________
00213E  3               LAB_VOICE:
00213E  3  20 B4 37             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (CHANNEL)
002141  3  DA                   PHX
002142  3  20 23 2F             JSR     LAB_1C01        ; (AFTER ',') OR SYN ERR
002145  3  20 F1 2D             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
002148  3               ; else do type mismatch
002148  3  20 1A 38             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
00214B  3  7A                   PLY
00214C  3  A9 0D                LDA     #13
00214E  3  20 32 22             JSR     psgwr
002151  3               
002151  3  A9 0B                LDA     #11
002153  3  A4 11                LDY     <Itempl
002155  3  20 32 22             JSR     psgwr           ; SET LOW BYTE
002158  3  A9 0C                LDA     #12
00215A  3  A4 12                LDY     <Itemph         ; SET HIGH BYTE
00215C  3  20 32 22             JSR     psgwr
00215F  3               
00215F  3  60                   RTS
002160  3               
002160  3               
002160  3               
002160  3               
002160  3               
002160  3               ;___NOISE__________________________________________________
002160  3               ;
002160  3               ; SELECT NOISE CHANNEL
002160  3               ;
002160  3               ;  TAKES TWO PARAMETERS CHANNEL,FREQUENCY
002160  3               ;
002160  3               ; THIS IS NATIVE '816 CODE
002160  3               ;__________________________________________________________
002160  3               LAB_NOISE:
002160  3  20 B4 37             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (CHANNEL)
002163  3  DA                   PHX
002164  3  20 23 2F             JSR     LAB_1C01        ; (AFTER ',') OR SYN ERR
002167  3  20 B4 37             JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X (FREQ)
00216A  3  68                   PLA                     ; LIMIT THE CHANNELS TO <3
00216B  3  DA                   PHX
00216C  3  AA                   TAX
00216D  3               
00216D  3  29 1F                AND     #%00011111
00216F  3  A8                   TAY
002170  3  A9 06                LDA     #$06
002172  3  20 32 22             JSR     psgwr           ; SET NOISE FREQ
002175  3               
002175  3  A9 07                LDA     #$07
002177  3  20 FD 21             JSR     psgrd           ; GET CONFIG
00217A  3  68                   PLA
00217B  3  5A                   PHY
00217C  3  29 03                AND     #$03
00217E  3  AA                   TAX                     ; A=CONFIG, X=CHANNEL
00217F  3  68                   PLA
002180  3  E0 00                CPX     #$00
002182  3  D0 06                BNE     NOISE_1
002184  3  29 37                AND     #%00110111
002186  3  09 01                ORA     #%00000001
002188  3  80 0E                BRA     NOISE_3
00218A  3               NOISE_1:
00218A  3  E0 01                CPX     #$01
00218C  3  D0 06                BNE     NOISE_2
00218E  3  29 2F                AND     #%00101111
002190  3  09 02                ORA     #%00000010
002192  3  80 04                BRA     NOISE_3
002194  3               NOISE_2:
002194  3  29 1F                AND     #%00011111
002196  3  09 04                ORA     #%00000100
