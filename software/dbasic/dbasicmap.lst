001E1C  3  98                   TYA
001E1D  3  20 94 1E             JSR     BCD_TO_HEX
001E20  3  A8                   TAY
001E21  3  A9 00                LDA     #0              ; Get high byte
001E23  3  20 F9 2E             JSR     LAB_AYFC
