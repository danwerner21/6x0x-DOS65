001289  3               ;___SAVE____________________________________________________
001289  3               ;
001289  3               ; SAVE COMMAND
001289  3               ;
001289  3               ;  SAVE THE BASIC PROGRAM IN MEMORY TO DISK
001289  3               ;
001289  3               ;__________________________________________________________
001289  3               V_SAVE: ; save BASIC program
001289  3               DOS65SAVE:
001289  3  20 FC 13             JSR     DOS65FCBPREP    ; parse parameters into FCB
00128C  3  B0 28                BCS     DOS65SAVE_ERR1  ; Error?, if so abort
00128E  3  A2 0D                LDX     #13             ;
001290  3  20 83 12             JSR     PEM             ;
001293  3  A9 97                LDA     #<FCB           ; CREATE File
001295  3  A0 16                LDY     #>FCB           ;
001297  3  A2 16                LDX     #22             ;
001299  3  20 83 12             JSR     PEM             ;
00129C  3  A9 00                LDA     #0              ; clear
00129E  3  8D B7 16             STA     FCB+32          ; record number
0012A1  3  A9 97                LDA     #<FCB           ; Open File
0012A3  3  A0 16                LDY     #>FCB           ;
0012A5  3  A2 0F                LDX     #15             ;
0012A7  3  20 83 12             JSR     PEM             ;
0012AA  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
0012AC  3  D0 0B                BNE     DOS65SAVE_1     ;
0012AE  3               DOS65SAVE_ERR:
0012AE  3  A2 24                LDX     #$24            ; IO ERROR
0012B0  3  20 E2 1F             JSR     LAB_XERR
0012B3  3  4C BA 20             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
0012B6  3               DOS65SAVE_ERR1:
0012B6  3  4C C8 25             JMP     LAB_REM         ; comment out the remainder of the line (if any)
0012B9  3               DOS65SAVE_1:
0012B9  3  A9 52                LDA     #<FCBBUFFER     ; SETUP BUFFER
0012BB  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
0012BD  3  A0 3F                LDY     #>FCBBUFFER     ;
0012BF  3  84 21                STY     FCBPTR+1        ;
0012C1  3  A2 1A                LDX     #26             ; Setup Buffer
0012C3  3  20 83 12             JSR     PEM             ;
0012C6  3               DOS65SAVE_2:
0012C6  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
0012C8  3  85 22                STA     FCBPTR+2        ; point to base of RAM
0012CA  3  A5 7A                LDA     <Smemh          ;
0012CC  3  85 23                STA     FCBPTR+3        ;
0012CE  3  A2 00                LDX     #$00            ; x=0 (null counter)
0012D0  3               DOS65SAVE_2A:
0012D0  3  A0 00                LDY     #$00            ; y=0 (Loop Index)
0012D2  3               DOS65SAVE_3:
0012D2  3  B1 22                LDA     (FCBPTR+2),Y    ; load from RAM
0012D4  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
0012D6  3  C9 00                CMP     #$00            ; is Zero?
0012D8  3  D0 1E                BNE     DOS65SAVE_3A    ; No, continue
0012DA  3  E8                   INX                     ; yes, bump Null Counter
0012DB  3  E0 03                CPX     #$03            ; Three nulls in a row?
0012DD  3  D0 1B                BNE     DOS65SAVE_3B    ; No, continue
0012DF  3                                               ; FINISH FILLING BUFFER WITH NULLS
0012DF  3               :
0012DF  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
0012E1  3  C8                   INY                     ; bump index
0012E2  3  C0 80                CPY     #$80            ; end of buffer?
0012E4  3  D0 F9                BNE     :-              ; no, loop
0012E6  3  A9 97                LDA     #<FCB           ; Write record in buffer to disk file AND END
0012E8  3  A0 16                LDY     #>FCB           ;
0012EA  3  A2 15                LDX     #21             ;
0012EC  3  20 83 12             JSR     PEM             ;
0012EF  3  29 FE                AND     #$FE            ; strip out extension
0012F1  3  C9 00                CMP     #$00            ; is error
0012F3  3  D0 B9                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
0012F5  3  4C 25 13             JMP     DOS65SAVE_4
0012F8  3               DOS65SAVE_3A:                   ;
0012F8  3  A2 00                LDX     #$00            ; prior char not null, reset null counter
0012FA  3               DOS65SAVE_3B:                   ;
0012FA  3  C8                   INY                     ; bump index
0012FB  3  C0 80                CPY     #$80            ; end of buffer?
0012FD  3  D0 D3                BNE     DOS65SAVE_3     ; no, loop
0012FF  3               DOS65SAVE_3C:
0012FF  3  A9 97                LDA     #<FCB           ; Write record in buffer to disk file
001301  3  A0 16                LDY     #>FCB           ;
001303  3  A2 15                LDX     #21             ;
001305  3  20 83 12             JSR     PEM             ;
001308  3  29 FE                AND     #$FE            ; strip out extension
00130A  3  C9 00                CMP     #$00            ; is error
00130C  3  D0 A0                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
00130E  3  18                   CLC                     ;
00130F  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
001311  3  69 80                ADC     #$80            ;
001313  3  85 22                STA     FCBPTR+2        ;
001315  3  90 B9                BCC     DOS65SAVE_2A    ; is carry?, no loop
001317  3  18                   CLC                     ; yes, carry, inc high byte
001318  3  A5 23                LDA     FCBPTR+3        ;
00131A  3  69 01                ADC     #$01            ;
00131C  3  85 23                STA     FCBPTR+3        ;
00131E  3  C9 B8                CMP     #>Ram_top       ; are we at the end of RAM?
001320  3  F0 03                BEQ     DOS65SAVE_4
001322  3  4C D0 12             JMP     DOS65SAVE_2A
001325  3               DOS65SAVE_4:
001325  3  A9 97                LDA     #<FCB           ;
001327  3  A0 16                LDY     #>FCB           ;
001329  3  A2 10                LDX     #16             ;
00132B  3  20 83 12             JSR     PEM             ;
00132E  3  C9 FF                CMP     #$FF            ;
001330  3  D0 03                BNE     DOS65SAVE_5     ;
001332  3  4C AE 12             JMP     DOS65SAVE_ERR   ; ERROR, DISPLAY IT
001335  3               DOS65SAVE_5:
001335  3  A9 5A                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
001337  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
001339  3  20 6F 27             JSR     LAB_18C3
00133C  3  4C BA 20             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
