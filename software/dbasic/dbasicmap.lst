001E35  3  6D 18 19             ADC     PTEMPW+1        ; Add the high byte of the second number (plus carry from previous op)
001E38  3  8D 08 19             STA     PLOTY+1         ; Store the high byte of the result
001E3B  3  18                   CLC                     ; Clear the Carry flag before the first addition
001E3C  3  AD 07 19             LDA     PLOTY           ; Load the low byte of the first number into the accumulator
001E3F  3  6D 19 19             ADC     PTEMPW1         ; Add the low byte of the second number (plus carry)
001E42  3  8D 07 19             STA     PLOTY           ; Store the low byte of the result
001E45  3               
001E45  3  AD 08 19             LDA     PLOTY+1         ; Load the high byte of the first number
001E48  3  6D 1A 19             ADC     PTEMPW1+1       ; Add the high byte of the second number (plus carry from previous op)
001E4B  3  8D 08 19             STA     PLOTY+1         ; Store the high byte of the result
001E4E  3               ;
001E4E  3               ; PLOTY IS NOW THE Y OFFSET
001E4E  3               ; if quad hires double it.
001E4E  3  AD 02 19             LDA     VIDEOMODE
001E51  3  29 10                AND     #$10
001E53  3  C9 00                CMP     #00
001E55  3  D0 06                BNE     :+
001E57  3  0E 07 19             ASL     PLOTY
001E5A  3  2E 08 19             ROL     PLOTY+1         ; *2
001E5D  3               :
