001A71  3  18                   CLC                     ; Clear the Carry flag before the first addition
001A72  3               
001A72  3  AD 0E 17             LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
001A75  3  6D 10 17             ADC     PTEMPW2         ; Add the low byte of the second number (plus carry)
001A78  3  8D 0E 17             STA     PTEMPW1         ; Store the low byte of the result
001A7B  3               
