001C5F  3  18                   CLC                     ; Clear the Carry flag before the first addition
001C60  3  AD 0E 17             LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
001C63  3  6D 10 17             ADC     PTEMPW2         ; Add the low byte of the second number (plus carry)
001C66  3  8D 0E 17             STA     PTEMPW1         ; Store the low byte of the result
001C69  3               
001C69  3  AD 0F 17             LDA     PTEMPW1+1       ; Load the high byte of the first number
001C6C  3  6D 11 17             ADC     PTEMPW2+1       ; Add the high byte of the second number (plus carry from previous op)
001C6F  3  8D 0F 17             STA     PTEMPW1+1       ; Store the high byte of the result
001C72  3  18                   CLC                     ; Clear the Carry flag before the first addition
001C73  3  AD 0E 17             LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
001C76  3  6D 12 17             ADC     PTEMPW3         ; Add the low byte of the second number (plus carry)
001C79  3  8D 0E 17             STA     PTEMPW1         ; Store the low byte of the result
001C7C  3               
001C7C  3  AD 0F 17             LDA     PTEMPW1+1       ; Load the high byte of the first number
001C7F  3  6D 13 17             ADC     PTEMPW3+1       ; Add the high byte of the second number (plus carry from previous op)
001C82  3  8D 0F 17             STA     PTEMPW1+1       ; Store the high byte of the result
001C85  3                                               ;
001C85  3                                               ; PTEMPW1 IS NOW THE Y OFFSET
001C85  3                                               ; if quad hires double it.
001C85  3  AD 09 17             LDA     VIDEOMODE
001C88  3  29 10                AND     #$10
001C8A  3  C9 00                CMP     #00
001C8C  3  D0 06                BNE     :+
001C8E  3  0E 0E 17             ASL     PTEMPW1
001C91  3  2E 0F 17             ROL     PTEMPW1+1       ; *2
001C94  3               :
001C94  3                                               ; ADD THE X OFFSET
001C94  3  18                   CLC                     ; Clear the Carry flag before the first addition
001C95  3  AD 0E 17             LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
001C98  3  6D 0C 17             ADC     PTEMPW          ; Add the low byte of the second number (plus carry)
001C9B  3  85 FD                STA     TEMPW           ; Store the low byte of the result
001C9D  3               
001C9D  3  AD 0F 17             LDA     PTEMPW1+1       ; Load the high byte of the first number
001CA0  3  6D 0D 17             ADC     PTEMPW+1        ; Add the high byte of the second number (plus carry from previous op)
001CA3  3  85 FE                STA     TEMPW+1         ; Store the high byte of the result
001CA5  3                                               ; TEMPW IS NOW THE MEMORY ADDRESS
001CA5  3               
001CA5  3  A5 FE                LDA     TEMPW+1         ; OK, LET'S CALCULATE THE BANK
001CA7  3  29 F0                AND     #$F0
001CA9  3  4A                   LSR     A
001CAA  3  4A                   LSR     A
001CAB  3  4A                   LSR     A
001CAC  3  4A                   LSR     A
001CAD  3  18                   CLC
001CAE  3  69 FA                ADC     #$02+VIDEOBANK  ; AREA $2000-?
001CB0  3  C9 F8                CMP     #$F8
001CB2  3  90 32                BCC     V_PLOT_HIRES_COLOR_RANGE1
001CB4  3  A8                   TAY                     ; VIDEO BANK SHOULD BE IN Y
001CB5  3  20 02 1A             JSR     PAGE_ENTER
001CB8  3  A5 FE                LDA     TEMPW+1
001CBA  3  29 0F                AND     #$0F
001CBC  3  09 A0                ORA     #$A0
001CBE  3  85 FE                STA     TEMPW+1         ; TEMPW NOW REFLECTS MAPPED ADDRESSS
001CC0  3  68                   PLA
001CC1  3  29 07                AND     #$07            ; WHICH BIT?
001CC3  3  AA                   TAX
001CC4  3  AD 15 17             LDA     PTEMP4
001CC7  3  C9 01                CMP     #$01
001CC9  3  D0 0D                BNE     :+
001CCB  3  BD E9 1C             LDA     HIRES_BIT_LOOKUP_SET,X
001CCE  3  A0 00                LDY     #$00
001CD0  3  11 FD                ORA     (TEMPW),Y
001CD2  3  91 FD                STA     (TEMPW),Y
001CD4  3  20 FC 19             JSR     PAGE_EXIT
001CD7  3  60                   RTS
001CD8  3               :
001CD8  3  BD F1 1C             LDA     HIRES_BIT_LOOKUP_RESET,X
001CDB  3  48                   PHA
001CDC  3  A0 00                LDY     #$00
001CDE  3  31 FD                AND     (TEMPW),Y
001CE0  3  91 FD                STA     (TEMPW),Y
001CE2  3  20 FC 19             JSR     PAGE_EXIT
001CE5  3  60                   RTS
001CE6  3               V_PLOT_HIRES_COLOR_RANGE1:
001CE6  3  4C AE 35             JMP     LAB_2564
001CE9  3               HIRES_BIT_LOOKUP_SET:
001CE9  3  80 40 20 10          .BYTE   %10000000,%01000000,%00100000,%00010000,%00001000,%00000100,%00000010,%00000001
001CED  3  08 04 02 01  
001CF1  3               HIRES_BIT_LOOKUP_RESET:
001CF1  3  7F BF DF EF          .BYTE   %01111111,%10111111,%11011111,%11101111,%11110111,%11111011,%11111101,%11111110
001CF5  3  F7 FB FD FE  
001CF9  3               
001CF9  3               ;___V_PATTERN________________________________________________
001CF9  3               ;
001CF9  3               ;  DEFINE GRAPHICS PATTERN
001CF9  3               ;
001CF9  3               ;  TAKES 10 PARAMETERS
001CF9  3               ;       PATTERN NUM (0-255)
001CF9  3               ;       PATTERN DATA (8 BYTES)
001CF9  3               ;__________________________________________________________
001CF9  3               LAB_PATTERN
001CF9  3               V_PATTERN:
001CF9  3  20 6F 33             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X
001CFC  3  8A                   TXA
001CFD  3  48                   PHA
001CFE  3  A0 F8                LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001D00  3  20 02 1A             JSR     PAGE_ENTER
001D03  3  68                   PLA
001D04  3  8D 02 A0             STA     VideoCharGenOffset
001D07  3  A0 08                LDY     #8
001D09  3               :
001D09  3  98                   TYA
001D0A  3  48                   PHA
001D0B  3  20 DE 2A             JSR     LAB_1C01        ; GET THE NEXT PARAMETER (AFTER ',') OR SYN ERR
001D0E  3  20 6F 33             JSR     LAB_GTBY        ; GET THE NEXT PARAMETER, RETURN IN X
001D11  3  68                   PLA
001D12  3  A8                   TAY
001D13  3  8A                   TXA
001D14  3  8D 03 A0             STA     VideoCharGenData
001D17  3  88                   DEY
001D18  3  C0 00                CPY     #$00
001D1A  3  D0 ED                BNE     :-
001D1C  3  20 FC 19             JSR     PAGE_EXIT
001D1F  3  60                   RTS
001D20  3               
001D20  3               
001D20  3               LAB_LINE:
001D20  3  60                   rts
001D21  3                       .ELSE
001D21  3               
001D21  3               
001D21  3               ; ENSURE ALL OF THESE SPECIAL COMMANDS GIVE ERRORS IN NORMAL BASIC
001D21  3               LAB_SPEEK:
001D21  3               LAB_SPOKE:
001D21  3               LAB_SCRCLR:
001D21  3               LAB_SCREEN:
001D21  3               LAB_PATTERN:
001D21  3               LAB_PLOT:
001D21  3               LAB_LOCATE:
001D21  3               LAB_COLOR:
001D21  3               LAB_LINE:
001D21  3                       LDX     #$02            ; error code $02 ("SYNTAX" error)
001D21  3                       JMP     LAB_XERR        ; do error #X, then warm start
001D21  3               
001D21  3                       .ENDIF
001D21  3               
001D21  2                       .INCLUDE "sid.asm"
001D21  3               
001D21  3               
001D21  3                       .IFDEF  MEMORYMAPPEDSCREEN
001D21  3               
001D21  3               PC6502_IO       = $E000
001D21  3               SID_BASE        = PC6502_IO+$100
001D21  3               
001D21  3               ;___SOUND__________________________________________________
001D21  3               ;
001D21  3               ; PLAY SOUND
001D21  3               ;
001D21  3               ;  SOUND VOICE, FREQ, DUTY, WAVEFORM, ATTACK, SUSTAIN, DECAY, RELEASE
001D21  3               ;
001D21  3               ;
001D21  3               ;__________________________________________________________
001D21  3               LAB_SOUND:
001D21  3  20 6F 33             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (VOICE)
001D24  3  8A                   TXA
001D25  3  29 03                AND     #3
001D27  3  0A                   ASL     A
001D28  3  AA                   TAX
001D29  3  BD A3 1D             LDA     SIDVOICELOOKUP,X
001D2C  3  85 FD                STA     TEMPW
001D2E  3  BD A4 1D             LDA     SIDVOICELOOKUP+1,X
001D31  3  85 FE                STA     TEMPW+1
001D33  3                                               ; OK, TEMPW POINTS TO SID REGISTER TO MODIFY
001D33  3  20 DE 2A             JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001D36  3  20 AC 29             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001D39  3                                               ; else do type mismatch
001D39  3  20 D5 33             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001D3C  3  A0 00                LDY     #0              ; SET FREQUENCY
001D3E  3  A5 11                LDA     Itempl
001D40  3  91 FD                STA     (TEMPW),Y
001D42  3  A5 12                LDA     Itemph
001D44  3  E8                   INX
001D45  3  91 FD                STA     (TEMPW),Y
001D47  3  20 DE 2A             JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001D4A  3  20 AC 29             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001D4D  3                                               ; else do type mismatch
001D4D  3  20 D5 33             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001D50  3  A0 02                LDY     #2              ; SET DUTY CYCLE
001D52  3  A5 11                LDA     Itempl
001D54  3  91 FD                STA     (TEMPW),Y
001D56  3  A5 12                LDA     Itemph
001D58  3  C8                   INY
001D59  3  91 FD                STA     (TEMPW),Y
001D5B  3  20 DE 2A             JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
001D5E  3  20 6F 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (WAVEFORM)
001D61  3  8A                   TXA
001D62  3  A0 04                LDY     #4              ; SET WAVEFORM CYCLE
001D64  3  91 FD                STA     (TEMPW),Y
001D66  3  20 DE 2A             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001D69  3  20 6F 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (ATTACK)
001D6C  3  8A                   TXA
001D6D  3  4A                   LSR     A
001D6E  3  4A                   LSR     A
001D6F  3  4A                   LSR     A
001D70  3  4A                   LSR     A
001D71  3  8D 0C 17             STA     PTEMPW
001D74  3  20 DE 2A             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001D77  3  20 6F 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (DECAY)
001D7A  3  8A                   TXA
001D7B  3  29 0F                AND     #$0F
001D7D  3  0D 0C 17             ORA     PTEMPW
001D80  3  A0 05                LDY     #5              ; SET ATTACK/DECAY
001D82  3  91 FD                STA     (TEMPW),Y
001D84  3  20 DE 2A             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001D87  3  20 6F 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (SUSTAIN)
001D8A  3  8A                   TXA
001D8B  3  4A                   LSR     A
001D8C  3  4A                   LSR     A
001D8D  3  4A                   LSR     A
001D8E  3  4A                   LSR     A
001D8F  3  8D 0C 17             STA     PTEMPW
001D92  3  20 DE 2A             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001D95  3  20 6F 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (RELEASE)
001D98  3  8A                   TXA
001D99  3  29 0F                AND     #$0F
001D9B  3  0D 0C 17             ORA     PTEMPW
001D9E  3  A0 06                LDY     #6              ; SET SUSTAIN/RELEASE
001DA0  3  91 FD                STA     (TEMPW),Y
001DA2  3  60                   RTS
001DA3  3               SIDVOICELOOKUP:
001DA3  3  00 E1 07 E1          .WORD  SID_BASE,SID_BASE+7,SID_BASE+$12
001DA7  3  12 E1        
001DA9  3               
001DA9  3               ;___FILTER_________________________________________________
001DA9  3               ;
001DA9  3               ; SET SID FILTERS
001DA9  3               ;
001DA9  3               ;  FILTER CUTOFF, RESONANCE, VOICE 1 ENABLE, VOICE 2 ENABLE, VOICE 3 ENABLE, EXTERNAL ENABLE, FILTER MODE, VOLUME
001DA9  3               ;
001DA9  3               ;
001DA9  3               ;__________________________________________________________
001DA9  3               LAB_FILTER:
001DA9  3  20 AC 29             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001DAC  3                                               ; else do type mismatch
001DAC  3  20 D5 33             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001DAF  3                                               ; SET CUTOFF
001DAF  3  A5 11                LDA     Itempl
001DB1  3  8D 15 E1             STA     SID_BASE+$15
001DB4  3  A5 12                LDA     Itemph
001DB6  3  8D 16 E1             STA     SID_BASE+$16
001DB9  3  20 DE 2A             JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001DBC  3  20 6F 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (RESONANCE)
001DBF  3  8A                   TXA
001DC0  3  4A                   LSR     A
001DC1  3  4A                   LSR     A
001DC2  3  4A                   LSR     A
001DC3  3  4A                   LSR     A
001DC4  3  8D 0C 17             STA     PTEMPW
001DC7  3  20 DE 2A             JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001DCA  3  20 6F 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 1 ENABLE)
001DCD  3  8A                   TXA
001DCE  3  29 01                AND     #1
001DD0  3  0D 0C 17             ORA     PTEMPW
001DD3  3  8D 0C 17             STA     PTEMPW
001DD6  3  20 DE 2A             JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
001DD9  3  20 6F 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 2 ENABLE)
001DDC  3  8A                   TXA
001DDD  3  29 01                AND     #1
001DDF  3  4A                   LSR     A
001DE0  3  0D 0C 17             ORA     PTEMPW
001DE3  3  8D 0C 17             STA     PTEMPW
001DE6  3  20 DE 2A             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001DE9  3  20 6F 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 3 ENABLE)
001DEC  3  8A                   TXA
001DED  3  29 01                AND     #1
001DEF  3  4A                   LSR     A
001DF0  3  4A                   LSR     A
001DF1  3  0D 0C 17             ORA     PTEMPW
001DF4  3  8D 0C 17             STA     PTEMPW
001DF7  3  20 DE 2A             JSR     LAB_1C01        ; GET THE SIXTH PARAMETER (AFTER ',') OR SYN ERR
001DFA  3  20 6F 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (EXTERNAL AUDIO ENABLE)
001DFD  3  8A                   TXA
001DFE  3  29 01                AND     #1
001E00  3  4A                   LSR     A
001E01  3  4A                   LSR     A
001E02  3  4A                   LSR     A
001E03  3  0D 0C 17             ORA     PTEMPW
001E06  3  8D 17 E1             STA     SID_BASE+$17
001E09  3  20 DE 2A             JSR     LAB_1C01        ; GET THE SEVENTH PARAMETER (AFTER ',') OR SYN ERR
001E0C  3  20 6F 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (FILTER MODE)
001E0F  3  8A                   TXA
001E10  3  4A                   LSR     A
001E11  3  4A                   LSR     A
001E12  3  4A                   LSR     A
001E13  3  4A                   LSR     A
001E14  3  8D 0C 17             STA     PTEMPW
001E17  3  20 DE 2A             JSR     LAB_1C01        ; GET THE EIGHTH PARAMETER (AFTER ',') OR SYN ERR
001E1A  3  20 6F 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOLUME)
001E1D  3  8A                   TXA
001E1E  3  29 0F                AND     #$0F
001E20  3  0D 0C 17             ORA     PTEMPW
001E23  3  8D 18 E1             STA     SID_BASE+$18
001E26  3  60                   RTS
001E27  3               
001E27  3                       .ELSE
001E27  3               
001E27  3               
001E27  3               ; ENSURE ALL OF THESE SPECIAL COMMANDS GIVE ERRORS IN NORMAL BASIC
001E27  3               LAB_SOUND:
001E27  3               LAB_FILTER:
001E27  3                       LDX     #$02            ; error code $02 ("SYNTAX" error)
001E27  3                       JMP     LAB_XERR        ; do error #X, then warm start
001E27  3               
001E27  3                       .ENDIF
