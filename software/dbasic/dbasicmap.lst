001565  3               ;___OPEN____________________________________________________
001565  3               ;
001565  3               ; OPEN A FILE
001565  3               ;
001565  3               ;
001565  3               ; BASIC COMMAND EXPECTS FOUR VARS
001565  3               
001565  3               ; DRIVE,MODE, FILENAME$,FILE$
001565  3               ;
001565  3               ; FILE$ = STRING TO HOLD 33 BYTE FCB
001565  3               ; DRIVE = NUMERIC DRIVE -- 0=CURRENT, 1=A, 2=B . . .
001565  3               ; MODE = 0=EXISTING, 1=CREATE
001565  3               ; FILENAME$ = FILENAME STRING
001565  3               ;__________________________________________________________
001565  3               V_OPEN:
001565  3               ; CLEAR FCB
001565  3  A9 00                LDA     #0              ; FILL WITH NULL
001567  3  A0 00                LDY     #0              ;
