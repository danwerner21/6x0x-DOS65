001305  3               ;___SAVE____________________________________________________
001305  3               ;
001305  3               ; SAVE COMMAND
001305  3               ;
001305  3               ;  SAVE THE BASIC PROGRAM IN MEMORY TO DISK
001305  3               ;
001305  3               ;__________________________________________________________
001305  3               V_SAVE: ; save BASIC program
001305  3               DOS65SAVE:
001305  3  20 78 14             JSR     DOS65FCBPREP    ; parse parameters into FCB
001308  3  B0 28                BCS     DOS65SAVE_ERR1  ; Error?, if so abort
00130A  3  A2 0D                LDX     #13             ;
00130C  3  20 FF 12             JSR     PEM             ;
00130F  3  A9 96                LDA     #<FCB           ; CREATE File
001311  3  A0 18                LDY     #>FCB           ;
001313  3  A2 16                LDX     #22             ;
001315  3  20 FF 12             JSR     PEM             ;
001318  3  A9 00                LDA     #0              ; clear
00131A  3  8D B6 18             STA     FCB+32          ; record number
00131D  3  A9 96                LDA     #<FCB           ; Open File
00131F  3  A0 18                LDY     #>FCB           ;
001321  3  A2 0F                LDX     #15             ;
001323  3  20 FF 12             JSR     PEM             ;
001326  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
001328  3  D0 0B                BNE     DOS65SAVE_1     ;
00132A  3               DOS65SAVE_ERR:
00132A  3  A2 24                LDX     #$24            ; IO ERROR
00132C  3  20 CF 23             JSR     LAB_XERR
00132F  3  4C A7 24             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001332  3               DOS65SAVE_ERR1:
001332  3  4C C2 29             JMP     LAB_REM         ; comment out the remainder of the line (if any)
001335  3               DOS65SAVE_1:
001335  3  A9 4A                LDA     #<FCBBUFFER     ; SETUP BUFFER
001337  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
001339  3  A0 43                LDY     #>FCBBUFFER     ;
00133B  3  84 21                STY     FCBPTR+1        ;
00133D  3  A2 1A                LDX     #26             ; Setup Buffer
00133F  3  20 FF 12             JSR     PEM             ;
001342  3               DOS65SAVE_2:
001342  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
001344  3  85 22                STA     FCBPTR+2        ; point to base of RAM
001346  3  A5 7A                LDA     <Smemh          ;
001348  3  85 23                STA     FCBPTR+3        ;
00134A  3  A2 00                LDX     #$00            ; x=0 (null counter)
00134C  3               DOS65SAVE_2A:
00134C  3  A0 00                LDY     #$00            ; y=0 (Loop Index)
00134E  3               DOS65SAVE_3:
00134E  3  B1 22                LDA     (FCBPTR+2),Y    ; load from RAM
001350  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
001352  3  C9 00                CMP     #$00            ; is Zero?
001354  3  D0 1E                BNE     DOS65SAVE_3A    ; No, continue
001356  3  E8                   INX                     ; yes, bump Null Counter
001357  3  E0 03                CPX     #$03            ; Three nulls in a row?
001359  3  D0 1B                BNE     DOS65SAVE_3B    ; No, continue
00135B  3                                               ; FINISH FILLING BUFFER WITH NULLS
00135B  3               :
00135B  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
00135D  3  C8                   INY                     ; bump index
00135E  3  C0 80                CPY     #$80            ; end of buffer?
001360  3  D0 F9                BNE     :-              ; no, loop
001362  3  A9 96                LDA     #<FCB           ; Write record in buffer to disk file AND END
001364  3  A0 18                LDY     #>FCB           ;
001366  3  A2 15                LDX     #21             ;
001368  3  20 FF 12             JSR     PEM             ;
00136B  3  29 FE                AND     #$FE            ; strip out extension
00136D  3  C9 00                CMP     #$00            ; is error
00136F  3  D0 B9                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
001371  3  4C A1 13             JMP     DOS65SAVE_4
001374  3               DOS65SAVE_3A:                   ;
001374  3  A2 00                LDX     #$00            ; prior char not null, reset null counter
001376  3               DOS65SAVE_3B:                   ;
001376  3  C8                   INY                     ; bump index
001377  3  C0 80                CPY     #$80            ; end of buffer?
001379  3  D0 D3                BNE     DOS65SAVE_3     ; no, loop
00137B  3               DOS65SAVE_3C:
00137B  3  A9 96                LDA     #<FCB           ; Write record in buffer to disk file
00137D  3  A0 18                LDY     #>FCB           ;
00137F  3  A2 15                LDX     #21             ;
001381  3  20 FF 12             JSR     PEM             ;
001384  3  29 FE                AND     #$FE            ; strip out extension
001386  3  C9 00                CMP     #$00            ; is error
001388  3  D0 A0                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
00138A  3  18                   CLC                     ;
00138B  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
00138D  3  69 80                ADC     #$80            ;
00138F  3  85 22                STA     FCBPTR+2        ;
001391  3  90 B9                BCC     DOS65SAVE_2A    ; is carry?, no loop
001393  3  18                   CLC                     ; yes, carry, inc high byte
001394  3  A5 23                LDA     FCBPTR+3        ;
001396  3  69 01                ADC     #$01            ;
001398  3  85 23                STA     FCBPTR+3        ;
00139A  3  C9 B8                CMP     #>Ram_top       ; are we at the end of RAM?
00139C  3  F0 03                BEQ     DOS65SAVE_4
00139E  3  4C 4C 13             JMP     DOS65SAVE_2A
0013A1  3               DOS65SAVE_4:
0013A1  3  A9 96                LDA     #<FCB           ;
0013A3  3  A0 18                LDY     #>FCB           ;
0013A5  3  A2 10                LDX     #16             ;
0013A7  3  20 FF 12             JSR     PEM             ;
0013AA  3  C9 FF                CMP     #$FF            ;
0013AC  3  D0 03                BNE     DOS65SAVE_5     ;
0013AE  3  4C 2A 13             JMP     DOS65SAVE_ERR   ; ERROR, DISPLAY IT
0013B1  3               DOS65SAVE_5:
0013B1  3  A9 7E                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
0013B3  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
0013B5  3  20 69 2B             JSR     LAB_18C3
0013B8  3  4C A7 24             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
0013BB  3               
0013BB  3               ;___LOAD____________________________________________________
0013BB  3               ;
0013BB  3               ; LOAD COMMAND
0013BB  3               ;
0013BB  3               ;  LOAD A BASIC PROGRAM FROM DISK TO MEMORY
0013BB  3               ;
0013BB  3               ;__________________________________________________________
0013BB  3               V_LOAD: ; load BASIC program
0013BB  3               DOS65LOAD:
0013BB  3  A9 00                LDA     #$00
0013BD  3  8D BC 14             STA     NullCounter
0013C0  3  20 78 14             JSR     DOS65FCBPREP    ; parse parameters into FCB
0013C3  3  B0 1F                BCS     DOS65LOAD_ERR1  ; Error?, if so abort
0013C5  3  A2 0D                LDX     #13             ;
0013C7  3  20 FF 12             JSR     PEM             ;
0013CA  3  A9 00                LDA     #0              ; clear
0013CC  3  8D B6 18             STA     FCB+32          ; record number
0013CF  3  A9 96                LDA     #<FCB           ; Open File
0013D1  3  A0 18                LDY     #>FCB           ;
0013D3  3  A2 0F                LDX     #15             ;
0013D5  3  20 FF 12             JSR     PEM             ;
0013D8  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
0013DA  3  D0 0B                BNE     DOS65LOAD_1     ;
0013DC  3               DOS65LOAD_ERR:
0013DC  3  A2 24                LDX     #$24            ; IO ERROR
0013DE  3  20 CF 23             JSR     LAB_XERR
0013E1  3  4C A7 24             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
0013E4  3               DOS65LOAD_ERR1:
0013E4  3  4C C2 29             JMP     LAB_REM         ; comment out the remainder of the line (if any)
0013E7  3               DOS65LOAD_1:
0013E7  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
0013E9  3  85 22                STA     FCBPTR+2        ; point to base of RAM
0013EB  3  8D BA 14             STA     EndOfBas        ;
0013EE  3  A5 7A                LDA     <Smemh          ;
0013F0  3  85 23                STA     FCBPTR+3        ;
0013F2  3  8D BB 14             STA     EndOfBas+1      ;
0013F5  3  A9 4A                LDA     #<FCBBUFFER     ; SETUP BUFFER
0013F7  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
0013F9  3  A0 43                LDY     #>FCBBUFFER     ;
0013FB  3  84 21                STY     FCBPTR+1        ; STORE DEST BUFFER IN FCBPTR
0013FD  3  A2 1A                LDX     #26             ; Setup Buffer
0013FF  3  20 FF 12             JSR     PEM             ;
001402  3  4C 40 14             JMP     DOS65LOAD_3C
001405  3               DOS65LOAD_3:
001405  3  B1 20                LDA     (FCBPTR),Y      ; load from BUFFER
001407  3  91 22                STA     (FCBPTR+2),Y    ; save to RAM
001409  3  EE BA 14             INC     EndOfBas
00140C  3  D0 03                BNE     :+
00140E  3  EE BB 14             INC     EndOfBas+1
001411  3               :
001411  3  C9 00                CMP     #$00
001413  3  D0 0D                BNE     :+
001415  3  EE BC 14             INC     NullCounter
001418  3  AD BC 14             LDA     NullCounter
00141B  3  C9 03                CMP     #3
00141D  3  D0 08                BNE     :++
00141F  3  4C 53 14             JMP     DOS65LOAD_4
001422  3               :
001422  3  A9 00                LDA     #$00
001424  3  8D BC 14             STA     NullCounter
001427  3               :
001427  3  C8                   INY                     ; bump index
001428  3  C0 80                CPY     #$80            ; end of buffer?
00142A  3  D0 D9                BNE     DOS65LOAD_3     ; no, loop
00142C  3  18                   CLC                     ;
00142D  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
00142F  3  69 80                ADC     #$80            ;
001431  3  85 22                STA     FCBPTR+2        ;
001433  3  90 0B                BCC     DOS65LOAD_3C    ; is carry?, no SKIP
001435  3  18                   CLC                     ; yes, carry, inc high byte
001436  3  A5 23                LDA     FCBPTR+3        ;
001438  3  69 01                ADC     #$01            ;
00143A  3  85 23                STA     FCBPTR+3        ;
00143C  3  C9 B8                CMP     #>Ram_top       ; are we at the end of RAM?
00143E  3  F0 13                BEQ     DOS65LOAD_4
001440  3               
001440  3               DOS65LOAD_3C:
001440  3  A9 96                LDA     #<FCB           ; READ record buffer from disk file
001442  3  A0 18                LDY     #>FCB           ;
001444  3  A2 14                LDX     #20             ;
001446  3  20 FF 12             JSR     PEM             ;
001449  3  A0 00                LDY     #$00            ; RESET INDEX
00144B  3  C9 00                CMP     #$00            ; is error or EOF
00144D  3  F0 B6                BEQ     DOS65LOAD_3     ;
00144F  3  C9 01                CMP     #$01            ; EOF?
001451  3  D0 89                BNE     DOS65LOAD_ERR   ; ERROR, do error handling
001453  3               DOS65LOAD_4:
001453  3  A9 96                LDA     #<FCB           ;
001455  3  A0 18                LDY     #>FCB           ;
001457  3  A2 10                LDX     #16             ;
001459  3  20 FF 12             JSR     PEM             ;
00145C  3                                               ; setup pointers to return to basic
00145C  3  AD BA 14             LDA     EndOfBas
00145F  3  85 7B                STA     Svarl
001461  3  85 7D                STA     Sarryl
001463  3  85 7F                STA     Earryl
001465  3  AD BB 14             LDA     EndOfBas+1
001468  3  85 7C                STA     Svarh
00146A  3  85 7E                STA     Sarryh
00146C  3  85 80                STA     Earryh
00146E  3  A9 7E                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
001470  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
001472  3  20 69 2B             JSR     LAB_18C3
001475  3  4C A7 24             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001478  3               
001478  3               
001478  3               
001478  3               DOS65FCBPREP:
001478  3                       .IFDEF  DUODYNE
001478  3                       JSL     LAB_GBYT        ; scan memory
001478  3                       .ELSE
001478  3  20 C2 00             JSR     LAB_GBYT        ; scan memory
00147B  3                       .ENDIF
00147B  3               
00147B  3  38                   SEC                     ;
00147C  3  E9 40                SBC     #64             ; PARSE DRIVE NUMBER
00147E  3  8D 96 18             STA     DOSDRIVE        ; STORE IT IN FCB
001481  3                       .IFDEF  DUODYNE
001481  3                       JSL     LAB_IGBY        ; increment and scan memory
001481  3                       .ELSE
001481  3  20 BC 00             JSR     LAB_IGBY        ; increment and scan memory
001484  3                       .ENDIF
001484  3               
