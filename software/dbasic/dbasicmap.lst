001200  2  06 FD                ASL     TEMPW
001202  2  26 FE                ROL     TEMPW+1         ; *2  (80)
001204  2               :
001204  2  A5 FE                LDA     TEMPW+1
001206  2  09 A0                ORA     #$A0            ; add in the bank#
001208  2  85 FE                STA     TEMPW+1
00120A  2               
00120A  2  A0 F9                LDY     #$01+VIDEOBANK  ; SCREEN AREA $1000-$1FFF
00120C  2  20 02 1A             JSR     PAGE_ENTER
00120F  2  A0 00                LDY     #0
001211  2               :
001211  2  B1 FD                LDA     (TEMPW),Y
001213  2  99 81 41             STA     Ibuffs,Y
001216  2  C8                   INY
001217  2  CC 0B 17             CPY     VIDEOWIDTH
00121A  2  D0 F5                BNE     :-
00121C  2               
