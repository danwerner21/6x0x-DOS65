0011C9  2  D0 04                BNE     :+
0011CB  2  06 FD                ASL     TEMPW
0011CD  2  26 FE                ROL     TEMPW+1         ; *2  (80)
0011CF  2               :
0011CF  2  A5 FE                LDA     TEMPW+1
0011D1  2  09 A0                ORA     #$A0            ; add in the bank#
0011D3  2  85 FE                STA     TEMPW+1
0011D5  2               
0011D5  2  A0 F9                LDY     #$01+VIDEOBANK  ; SCREEN AREA $1000-$1FFF
0011D7  2  20 ED 19             JSR     PAGE_ENTER
0011DA  2  A0 00                LDY     #0
0011DC  2               :
0011DC  2  B1 FD                LDA     (TEMPW),Y
0011DE  2  99 81 42             STA     Ibuffs,Y
0011E1  2  C8                   INY
0011E2  2  CC E7 16             CPY     VIDEOWIDTH
0011E5  2  D0 F5                BNE     :-
0011E7  2               
0011E7  2  20 E7 19             JSR     PAGE_EXIT
0011EA  2  60                   RTS
0011EB  2  60                   RTS
0011EC  2               
0011EC  2                       .ENDIF
