0011CB  2  18                   CLC                     ; Clear the Carry flag before the first addition
0011CC  2  AD 95 18             LDA     PTEMPW          ; Load the low byte of the first number into the accumulator
0011CF  2  6D 97 18             ADC     PTEMPW1         ; Add the low byte of the second number (plus carry)
0011D2  2  85 FD                STA     TEMPW           ; Store the low byte of the result
0011D4  2  AD 96 18             LDA     PTEMPW+1        ; Load the high byte of the first number
0011D7  2  6D 98 18             ADC     PTEMPW1+1       ; Add the high byte of the second number (plus carry from previous op)
0011DA  2  85 FE                STA     TEMPW+1         ; Store the high byte of the result
0011DC  2               
0011DC  2  AD 82 18             LDA     VIDEOWIDTH      ; If 80 col, double again
0011DF  2  C9 50                CMP     #80
0011E1  2  D0 04                BNE     :+
0011E3  2  06 FD                ASL     TEMPW
0011E5  2  26 FE                ROL     TEMPW+1         ; *2  (80)
0011E7  2               :
0011E7  2  A5 FE                LDA     TEMPW+1
0011E9  2  09 A0                ORA     #$A0            ; add in the bank#
0011EB  2  85 FE                STA     TEMPW+1
0011ED  2               
0011ED  2  A0 F9                LDY     #$01+VIDEOBANK  ; SCREEN AREA $1000-$1FFF
0011EF  2  20 88 1B             JSR     PAGE_ENTER
0011F2  2  A0 00                LDY     #0
0011F4  2               :
0011F4  2  B1 FD                LDA     (TEMPW),Y
0011F6  2  99 81 43             STA     Ibuffs,Y
0011F9  2  C8                   INY
0011FA  2  CC 82 18             CPY     VIDEOWIDTH
0011FD  2  D0 F5                BNE     :-
0011FF  2               
0011FF  2  20 82 1B             JSR     PAGE_EXIT
001202  2  60                   RTS
001203  2  60                   RTS
001204  2               
001204  2                       .ENDIF
001204  2               
001204  2               V_LPRINT:
001204  2  08                   PHP
001205  2  A9 01                LDA     #$01
001207  2  8D 57 10             STA     printflag
00120A  2  28                   PLP
00120B  2  20 93 2A             JSR     LAB_PRINT
00120E  2  A9 00                LDA     #$00
001210  2  8D 57 10             STA     printflag
001213  2  60                   RTS
001214  2               V_LLIST:
001214  2  08                   PHP
001215  2  A9 01                LDA     #$01
001217  2  8D 57 10             STA     printflag
00121A  2  28                   PLP
00121B  2  20 F8 25             JSR     LAB_LIST
00121E  2  A9 00                LDA     #$00
001220  2  8D 57 10             STA     printflag
