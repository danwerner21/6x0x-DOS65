00120C  2               UART1DATA       = $EF84         ; SERIAL PORT 1 (I/O Card)
00120C  2               UART1STATUS     = $EF85         ; SERIAL PORT 1 (I/O Card)
00120C  2               UART1COMMAND    = $EF86         ; SERIAL PORT 1 (I/O Card)
00120C  2               UART1CONTROL    = $EF87         ; SERIAL PORT 1 (I/O Card)
