00132F  3               ;___SAVE____________________________________________________
00132F  3               ;
00132F  3               ; SAVE COMMAND
00132F  3               ;
00132F  3               ;  SAVE THE BASIC PROGRAM IN MEMORY TO DISK
00132F  3               ;
00132F  3               ;__________________________________________________________
00132F  3               V_SAVE: ; save BASIC program
00132F  3               DOS65SAVE:
00132F  3  20 A2 14             JSR     DOS65FCBPREP    ; parse parameters into FCB
001332  3  B0 28                BCS     DOS65SAVE_ERR1  ; Error?, if so abort
001334  3  A2 0D                LDX     #13             ;
001336  3  20 29 13             JSR     PEM             ;
001339  3  A9 C0                LDA     #<FCB           ; CREATE File
00133B  3  A0 18                LDY     #>FCB           ;
00133D  3  A2 16                LDX     #22             ;
00133F  3  20 29 13             JSR     PEM             ;
001342  3  A9 00                LDA     #0              ; clear
001344  3  8D E0 18             STA     FCB+32          ; record number
001347  3  A9 C0                LDA     #<FCB           ; Open File
001349  3  A0 18                LDY     #>FCB           ;
00134B  3  A2 0F                LDX     #15             ;
00134D  3  20 29 13             JSR     PEM             ;
001350  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
001352  3  D0 0B                BNE     DOS65SAVE_1     ;
001354  3               DOS65SAVE_ERR:
001354  3  A2 24                LDX     #$24            ; IO ERROR
001356  3  20 5F 24             JSR     LAB_XERR
001359  3  4C 37 25             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
00135C  3               DOS65SAVE_ERR1:
00135C  3  4C 52 2A             JMP     LAB_REM         ; comment out the remainder of the line (if any)
00135F  3               DOS65SAVE_1:
00135F  3  A9 DA                LDA     #<FCBBUFFER     ; SETUP BUFFER
001361  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
001363  3  A0 43                LDY     #>FCBBUFFER     ;
001365  3  84 21                STY     FCBPTR+1        ;
001367  3  A2 1A                LDX     #26             ; Setup Buffer
001369  3  20 29 13             JSR     PEM             ;
00136C  3               DOS65SAVE_2:
00136C  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
00136E  3  85 22                STA     FCBPTR+2        ; point to base of RAM
001370  3  A5 7A                LDA     <Smemh          ;
001372  3  85 23                STA     FCBPTR+3        ;
001374  3  A2 00                LDX     #$00            ; x=0 (null counter)
001376  3               DOS65SAVE_2A:
001376  3  A0 00                LDY     #$00            ; y=0 (Loop Index)
001378  3               DOS65SAVE_3:
001378  3  B1 22                LDA     (FCBPTR+2),Y    ; load from RAM
00137A  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
00137C  3  C9 00                CMP     #$00            ; is Zero?
00137E  3  D0 1E                BNE     DOS65SAVE_3A    ; No, continue
001380  3  E8                   INX                     ; yes, bump Null Counter
001381  3  E0 03                CPX     #$03            ; Three nulls in a row?
001383  3  D0 1B                BNE     DOS65SAVE_3B    ; No, continue
001385  3                                               ; FINISH FILLING BUFFER WITH NULLS
001385  3               :
001385  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
001387  3  C8                   INY                     ; bump index
001388  3  C0 80                CPY     #$80            ; end of buffer?
00138A  3  D0 F9                BNE     :-              ; no, loop
00138C  3  A9 C0                LDA     #<FCB           ; Write record in buffer to disk file AND END
00138E  3  A0 18                LDY     #>FCB           ;
001390  3  A2 15                LDX     #21             ;
001392  3  20 29 13             JSR     PEM             ;
001395  3  29 FE                AND     #$FE            ; strip out extension
001397  3  C9 00                CMP     #$00            ; is error
001399  3  D0 B9                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
00139B  3  4C CB 13             JMP     DOS65SAVE_4
00139E  3               DOS65SAVE_3A:                   ;
00139E  3  A2 00                LDX     #$00            ; prior char not null, reset null counter
0013A0  3               DOS65SAVE_3B:                   ;
0013A0  3  C8                   INY                     ; bump index
0013A1  3  C0 80                CPY     #$80            ; end of buffer?
0013A3  3  D0 D3                BNE     DOS65SAVE_3     ; no, loop
0013A5  3               DOS65SAVE_3C:
0013A5  3  A9 C0                LDA     #<FCB           ; Write record in buffer to disk file
0013A7  3  A0 18                LDY     #>FCB           ;
0013A9  3  A2 15                LDX     #21             ;
0013AB  3  20 29 13             JSR     PEM             ;
0013AE  3  29 FE                AND     #$FE            ; strip out extension
0013B0  3  C9 00                CMP     #$00            ; is error
0013B2  3  D0 A0                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
0013B4  3  18                   CLC                     ;
0013B5  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
0013B7  3  69 80                ADC     #$80            ;
0013B9  3  85 22                STA     FCBPTR+2        ;
0013BB  3  90 B9                BCC     DOS65SAVE_2A    ; is carry?, no loop
0013BD  3  18                   CLC                     ; yes, carry, inc high byte
0013BE  3  A5 23                LDA     FCBPTR+3        ;
0013C0  3  69 01                ADC     #$01            ;
0013C2  3  85 23                STA     FCBPTR+3        ;
0013C4  3  C9 B8                CMP     #>Ram_top       ; are we at the end of RAM?
0013C6  3  F0 03                BEQ     DOS65SAVE_4
0013C8  3  4C 76 13             JMP     DOS65SAVE_2A
0013CB  3               DOS65SAVE_4:
0013CB  3  A9 C0                LDA     #<FCB           ;
0013CD  3  A0 18                LDY     #>FCB           ;
0013CF  3  A2 10                LDX     #16             ;
0013D1  3  20 29 13             JSR     PEM             ;
0013D4  3  C9 FF                CMP     #$FF            ;
0013D6  3  D0 03                BNE     DOS65SAVE_5     ;
0013D8  3  4C 54 13             JMP     DOS65SAVE_ERR   ; ERROR, DISPLAY IT
0013DB  3               DOS65SAVE_5:
0013DB  3  A9 A8                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
0013DD  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
0013DF  3  20 F9 2B             JSR     LAB_18C3
0013E2  3  4C 37 25             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
0013E5  3               
0013E5  3               ;___LOAD____________________________________________________
0013E5  3               ;
0013E5  3               ; LOAD COMMAND
0013E5  3               ;
0013E5  3               ;  LOAD A BASIC PROGRAM FROM DISK TO MEMORY
0013E5  3               ;
0013E5  3               ;__________________________________________________________
0013E5  3               V_LOAD: ; load BASIC program
0013E5  3               DOS65LOAD:
0013E5  3  A9 00                LDA     #$00
0013E7  3  8D E6 14             STA     NullCounter
0013EA  3  20 A2 14             JSR     DOS65FCBPREP    ; parse parameters into FCB
0013ED  3  B0 1F                BCS     DOS65LOAD_ERR1  ; Error?, if so abort
0013EF  3  A2 0D                LDX     #13             ;
0013F1  3  20 29 13             JSR     PEM             ;
0013F4  3  A9 00                LDA     #0              ; clear
0013F6  3  8D E0 18             STA     FCB+32          ; record number
0013F9  3  A9 C0                LDA     #<FCB           ; Open File
0013FB  3  A0 18                LDY     #>FCB           ;
0013FD  3  A2 0F                LDX     #15             ;
0013FF  3  20 29 13             JSR     PEM             ;
001402  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
001404  3  D0 0B                BNE     DOS65LOAD_1     ;
001406  3               DOS65LOAD_ERR:
001406  3  A2 24                LDX     #$24            ; IO ERROR
001408  3  20 5F 24             JSR     LAB_XERR
00140B  3  4C 37 25             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
00140E  3               DOS65LOAD_ERR1:
00140E  3  4C 52 2A             JMP     LAB_REM         ; comment out the remainder of the line (if any)
001411  3               DOS65LOAD_1:
001411  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
001413  3  85 22                STA     FCBPTR+2        ; point to base of RAM
001415  3  8D E4 14             STA     EndOfBas        ;
001418  3  A5 7A                LDA     <Smemh          ;
00141A  3  85 23                STA     FCBPTR+3        ;
00141C  3  8D E5 14             STA     EndOfBas+1      ;
00141F  3  A9 DA                LDA     #<FCBBUFFER     ; SETUP BUFFER
001421  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
001423  3  A0 43                LDY     #>FCBBUFFER     ;
001425  3  84 21                STY     FCBPTR+1        ; STORE DEST BUFFER IN FCBPTR
001427  3  A2 1A                LDX     #26             ; Setup Buffer
001429  3  20 29 13             JSR     PEM             ;
00142C  3  4C 6A 14             JMP     DOS65LOAD_3C
00142F  3               DOS65LOAD_3:
00142F  3  B1 20                LDA     (FCBPTR),Y      ; load from BUFFER
001431  3  91 22                STA     (FCBPTR+2),Y    ; save to RAM
001433  3  EE E4 14             INC     EndOfBas
001436  3  D0 03                BNE     :+
001438  3  EE E5 14             INC     EndOfBas+1
00143B  3               :
00143B  3  C9 00                CMP     #$00
00143D  3  D0 0D                BNE     :+
00143F  3  EE E6 14             INC     NullCounter
001442  3  AD E6 14             LDA     NullCounter
001445  3  C9 03                CMP     #3
001447  3  D0 08                BNE     :++
001449  3  4C 7D 14             JMP     DOS65LOAD_4
00144C  3               :
00144C  3  A9 00                LDA     #$00
00144E  3  8D E6 14             STA     NullCounter
001451  3               :
001451  3  C8                   INY                     ; bump index
001452  3  C0 80                CPY     #$80            ; end of buffer?
001454  3  D0 D9                BNE     DOS65LOAD_3     ; no, loop
001456  3  18                   CLC                     ;
001457  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
001459  3  69 80                ADC     #$80            ;
00145B  3  85 22                STA     FCBPTR+2        ;
00145D  3  90 0B                BCC     DOS65LOAD_3C    ; is carry?, no SKIP
00145F  3  18                   CLC                     ; yes, carry, inc high byte
001460  3  A5 23                LDA     FCBPTR+3        ;
001462  3  69 01                ADC     #$01            ;
001464  3  85 23                STA     FCBPTR+3        ;
001466  3  C9 B8                CMP     #>Ram_top       ; are we at the end of RAM?
001468  3  F0 13                BEQ     DOS65LOAD_4
00146A  3               
00146A  3               DOS65LOAD_3C:
00146A  3  A9 C0                LDA     #<FCB           ; READ record buffer from disk file
00146C  3  A0 18                LDY     #>FCB           ;
00146E  3  A2 14                LDX     #20             ;
001470  3  20 29 13             JSR     PEM             ;
001473  3  A0 00                LDY     #$00            ; RESET INDEX
001475  3  C9 00                CMP     #$00            ; is error or EOF
001477  3  F0 B6                BEQ     DOS65LOAD_3     ;
001479  3  C9 01                CMP     #$01            ; EOF?
00147B  3  D0 89                BNE     DOS65LOAD_ERR   ; ERROR, do error handling
