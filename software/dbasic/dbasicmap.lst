00180B  3  29 07                AND     #$07
00180D  3  18                   CLC
00180E  3  69 F8                ADC     #VIDEOBANK
001810  3  A8                   TAY
001811  3  A9 01                LDA     #$01            ; MODIFY TASK 01 (DRIVER TASK)
001813  3  A2 0A                LDX     #$0A            ; MAP $AXXX
001815  3  20 F6 FF             JSR     SETPAGE         ; CALL SETPAGE
001818  3  A9 01                LDA     #$01
00181A  3  8D E0 EF             STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 01
