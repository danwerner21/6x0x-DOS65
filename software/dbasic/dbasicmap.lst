00210A  3               ;___SOUND__________________________________________________
00210A  3               ;
00210A  3               ; PLAY SOUND
00210A  3               ;
00210A  3               ;  TAKES TWO PARAMETERS CHANNEL,FREQUENCY
00210A  3               ;
00210A  3               ;__________________________________________________________
00210A  3               LAB_SOUND:
00210A  3  20 BE 37             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (CHANNEL)
00210D  3  DA                   PHX
00210E  3  20 2D 2F             JSR     LAB_1C01        ; (AFTER ',') OR SYN ERR
002111  3  20 FB 2D             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
002114  3               ; else do type mismatch
002114  3  20 24 38             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
002117  3               
002117  3  68                   PLA                     ; LIMIT THE CHANNELS TO <3
002118  3  29 03                AND     #$03
00211A  3  18                   CLC
00211B  3  0A                   ASL                     ; = *2
00211C  3  48                   PHA
00211D  3  A4 11                LDY     <Itempl
00211F  3  20 2F 22             JSR     psgwr           ; SET LOW BYTE
002122  3  68                   PLA
002123  3  1A                   INC     A
002124  3  A4 12                LDY     <Itemph
002126  3  20 2F 22             JSR     psgwr           ; SET HIGH BYTE
002129  3  60                   RTS
00212A  3               
00212A  3               ;___VOLUME__________________________________________________
00212A  3               ;
00212A  3               ; SET VOLUME
00212A  3               ;
00212A  3               ;  TAKES TWO PARAMETERS CHANNEL,VOLUME
00212A  3               ;
00212A  3               ;__________________________________________________________
00212A  3               LAB_VOLUME:
00212A  3  20 BE 37             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (CHANNEL)
00212D  3  DA                   PHX
00212E  3  20 2D 2F             JSR     LAB_1C01        ; (AFTER ',') OR SYN ERR
002131  3  20 BE 37             JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X (VOLUME)
002134  3  8A                   TXA
002135  3  A8                   TAY
002136  3  68                   PLA                     ; LIMIT THE CHANNELS TO <3
002137  3  29 03                AND     #$03
002139  3               
002139  3  18                   CLC
00213A  3  69 08                ADC     #08
00213C  3  20 2F 22             JSR     psgwr
00213F  3  60                   RTS
002140  3               
002140  3               
002140  3               ;___VOICE__________________________________________________
002140  3               ;
002140  3               ; SET VOICE
002140  3               ;
002140  3               ;  TAKES TWO PARAMETERS VOICE, ENVELOPE
002140  3               ;
002140  3               ;__________________________________________________________
002140  3               LAB_VOICE:
002140  3  20 BE 37             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (CHANNEL)
002143  3  DA                   PHX
002144  3  20 2D 2F             JSR     LAB_1C01        ; (AFTER ',') OR SYN ERR
002147  3  20 FB 2D             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
00214A  3               ; else do type mismatch
00214A  3  20 24 38             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
00214D  3  7A                   PLY
00214E  3  A9 0D                LDA     #13
002150  3  20 2F 22             JSR     psgwr
002153  3               
002153  3  A9 0B                LDA     #11
002155  3  A4 11                LDY     <Itempl
002157  3  20 2F 22             JSR     psgwr           ; SET LOW BYTE
00215A  3  A9 0C                LDA     #12
00215C  3  A4 12                LDY     <Itemph         ; SET HIGH BYTE
00215E  3  20 2F 22             JSR     psgwr
002161  3               
002161  3  60                   RTS
002162  3               
002162  3               
002162  3               
002162  3               
002162  3               
002162  3               ;___NOISE__________________________________________________
002162  3               ;
002162  3               ; SELECT NOISE CHANNEL
002162  3               ;
002162  3               ;  TAKES TWO PARAMETERS CHANNEL,FREQUENCY
002162  3               ;
002162  3               ;__________________________________________________________
002162  3               LAB_NOISE:
002162  3  20 BE 37             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (CHANNEL)
002165  3  DA                   PHX
002166  3  20 2D 2F             JSR     LAB_1C01        ; (AFTER ',') OR SYN ERR
002169  3  20 BE 37             JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X (FREQ)
00216C  3  68                   PLA                     ; LIMIT THE CHANNELS TO <3
00216D  3  DA                   PHX
00216E  3  AA                   TAX
00216F  3               
00216F  3  29 1F                AND     #%00011111
002171  3  A8                   TAY
002172  3  A9 06                LDA     #$06
002174  3  20 2F 22             JSR     psgwr           ; SET NOISE FREQ
002177  3               
002177  3  A9 07                LDA     #$07
002179  3  20 FA 21             JSR     psgrd           ; GET CONFIG
00217C  3  68                   PLA
00217D  3  5A                   PHY
00217E  3  29 03                AND     #$03
002180  3  AA                   TAX                     ; A=CONFIG, X=CHANNEL
002181  3  68                   PLA
002182  3  E0 00                CPX     #$00
002184  3  D0 06                BNE     NOISE_1
002186  3  29 37                AND     #%00110111
002188  3  09 01                ORA     #%00000001
00218A  3  80 0E                BRA     NOISE_3
00218C  3               NOISE_1:
00218C  3  E0 01                CPX     #$01
00218E  3  D0 06                BNE     NOISE_2
002190  3  29 2F                AND     #%00101111
002192  3  09 02                ORA     #%00000010
002194  3  80 04                BRA     NOISE_3
002196  3               NOISE_2:
002196  3  29 1F                AND     #%00011111
002198  3  09 04                ORA     #%00000100
00219A  3               NOISE_3:
00219A  3  A8                   TAY
00219B  3  A9 07                LDA     #$07
00219D  3  20 2F 22             JSR     psgwr           ; SET LOW BYTE
0021A0  3  60                   RTS
0021A1  3               
