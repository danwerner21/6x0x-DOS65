0017C7  3  A5 12                LDA     Itemph
0017C9  3  A8                   TAY
0017CA  3  29 0F                AND     #$0F
0017CC  3  09 A0                ORA     #$A0
0017CE  3  85 12                STA     Itemph
0017D0  3  98                   TYA
0017D1  3  29 F0                AND     #$F0
0017D3  3  4A                   LSR     A
0017D4  3  4A                   LSR     A
0017D5  3  4A                   LSR     A
0017D6  3  4A                   LSR     A
