001E4A  3  98                   TYA
001E4B  3  20 C2 1E             JSR     BCD_TO_HEX
001E4E  3  A8                   TAY
001E4F  3  A9 00                LDA     #0              ; Get high byte
001E51  3  20 3A 2F             JSR     LAB_AYFC
