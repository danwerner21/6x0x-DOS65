001BA9  3               ;___V_PLOT__________________________________________________
001BA9  3               ;
001BA9  3               ;  PLOT ON SCREEN
001BA9  3               ;         TAKES THREE PARAMETERS,  X,Y,COLOR
001BA9  3               ;
001BA9  3               ;__________________________________________________________
001BA9  3               LAB_PLOT:
001BA9  3               V_PLOT:
001BA9  3  20 1D 2D             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001BAC  3                                               ; else do type mismatch
001BAC  3  20 46 37             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001BAF  3  A5 12                LDA     Itemph
001BB1  3  8D 98 18             STA     PLOTX+1
001BB4  3  A5 11                LDA     Itempl
001BB6  3  8D 97 18             STA     PLOTX
001BB9  3  20 4F 2E             JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001BBC  3  20 E0 36             JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
001BBF  3  8E 99 18             STX     PLOTY           ; STORE IN PLOTY
001BC2  3  A9 00                LDA     #$00
001BC4  3  8D 9A 18             STA     PLOTY+1
001BC7  3  20 4F 2E             JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001BCA  3  20 E0 36             JSR     LAB_GTBY        ; RETURN IN X
001BCD  3  8E 9B 18             STX     PLOTCOLOR
