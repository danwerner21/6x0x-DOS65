0011A9  2                                               ; TEMPW  = Y*8 + Y*32  (Y*40)
0011A9  2  18                   CLC                     ; Clear the Carry flag before the first addition
0011AA  2  AD DE 16             LDA     PTEMPW          ; Load the low byte of the first number into the accumulator
0011AD  2  6D E0 16             ADC     PTEMPW1         ; Add the low byte of the second number (plus carry)
0011B0  2  85 FD                STA     TEMPW           ; Store the low byte of the result
0011B2  2  AD DF 16             LDA     PTEMPW+1        ; Load the high byte of the first number
0011B5  2  6D E1 16             ADC     PTEMPW1+1       ; Add the high byte of the second number (plus carry from previous op)
0011B8  2  85 FE                STA     TEMPW+1         ; Store the high byte of the result
