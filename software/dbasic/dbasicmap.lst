001C17  3               ;
001C17  3               ;__________________________________________________________
001C17  3               LAB_PLOT:
001C17  3               V_PLOT:
001C17  3  20 F1 2D             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001C1A  3                                               ; else do type mismatch
001C1A  3  20 1A 38             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001C1D  3  A5 12                LDA     Itemph
001C1F  3  8D 06 19             STA     PLOTX+1
001C22  3  A5 11                LDA     Itempl
001C24  3  8D 05 19             STA     PLOTX
001C27  3  20 23 2F             JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001C2A  3  20 B4 37             JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
001C2D  3  8E 07 19             STX     PLOTY           ; STORE IN PLOTY
001C30  3  A9 00                LDA     #$00
001C32  3  8D 08 19             STA     PLOTY+1
001C35  3  20 23 2F             JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001C38  3  20 B4 37             JSR     LAB_GTBY        ; RETURN IN X
001C3B  3  8E 09 19             STX     PLOTCOLOR
001C3E  3               DOPLOTXY:
001C3E  3                                               ; PARAMETERS PARSED, GO TO PROPER MODE CODE
001C3E  3  AD 02 19             LDA     VIDEOMODE
001C41  3  29 0F                AND     #$0F
001C43  3  C9 01                CMP     #$01
001C45  3  F0 14                BEQ     V_PLOT_LORES
001C47  3  AD 02 19             LDA     VIDEOMODE
001C4A  3  29 2F                AND     #$2F
001C4C  3  C9 02                CMP     #$02
001C4E  3  D0 03                BNE     :+
001C50  3  4C FE 1C             JMP     V_PLOT_HIRES_COLOR
001C53  3               :
