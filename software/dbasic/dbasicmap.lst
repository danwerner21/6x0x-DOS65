0011E0  2               LdKbBuffer:
0011E0  2               ; clear input buffer
0011E0  2  A2 51                LDX     #81
0011E2  2               :
0011E2  2  A9 00                LDA     #00
0011E4  2  9D 80 44             STA     Ibuffs-1,X
0011E7  2  CA                   DEX
0011E8  2  D0 F8                BNE     :-
0011EA  2               
