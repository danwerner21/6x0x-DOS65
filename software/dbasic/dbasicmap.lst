00129D  3               ;___V_SCREEN_________________________________________________
00129D  3               ;
00129D  3               ;  SET SCREEN MODE
00129D  3               ;
00129D  3               ;  TAKES UP TO THREE PARAMETERS
00129D  3               ;  FIRST PARAMETER SCREEN MODE
00129D  3               ;  0=TEXT MODE
00129D  3               ;  1=LORES MODE
00129D  3               ;  2=HIRES MODE
00129D  3               ;
00129D  3               ;  TEXT MODE PARAMETERS
00129D  3               ;  0=40 COLUMNS
00129D  3               ;  1=80 COLUMNS
00129D  3               ;
00129D  3               ;  LORES MODE SECOND PARAMETER
00129D  3               ;  0=SINGLE LORES
00129D  3               ;  1=DOUBLE LORES
00129D  3               ;  LORES MODE THIRD PARAMETER
00129D  3               ;  0=MIXED MODE
00129D  3               ;  1=FULL SCREEN MODE
00129D  3               ;
00129D  3               ;  HIRES MODE SECOND PARAMETER
00129D  3               ;  0=SINGLE HIRES
00129D  3               ;  1=DOUBLE HIRES
00129D  3               ;  2=QUAD HIRES
00129D  3               ;  3=MONO HIRES
00129D  3               ;  HIRES MODE THIRD PARAMETER
00129D  3               ;  1=MIXED MODE
00129D  3               ;  0=FULL SCREEN MODE
00129D  3               ;
00129D  3               ;__________________________________________________________
00129D  3               LAB_SCREEN:
00129D  3               V_SCREEN:
00129D  3  20 FC 2B             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (MODE)
