002313  3               BCD_TO_HEX:
002313  3  85 12                STA     nums_2          ; Store in TEMP2
002315  3  29 F0                AND     #$F0
002317  3  4A                   LSR     A               ; (shift 1 times to /2)
002318  3  85 11                STA     nums_1          ; Store the /2 into TEMP
00231A  3  4A                   LSR     A               ;
00231B  3  4A                   LSR     A               ; Shift two more times to /8
00231C  3  18                   CLC
00231D  3  65 11                ADC     nums_1          ; add /8 + /2 to get /10
00231F  3  85 11                STA     nums_1          ; Store tens digit into TEMP
002321  3  A5 12                LDA     nums_2          ; Get Ones
002323  3  29 0F                AND     #$0F
002325  3  18                   CLC
002326  3  65 11                ADC     nums_1
002328  3  60                   RTS                     ; Return from subroutine
