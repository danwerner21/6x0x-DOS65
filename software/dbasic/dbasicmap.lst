0019FE  3               V_PLOT_LORES:
0019FE  3  20 2E 33             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X
001A01  3  8E DE 16             STX     PTEMPW          ; STORE X COORD IN OFFSET ADDRESS
001A04  3  A9 00                LDA     #00
001A06  3  8D DF 16             STA     PTEMPW+1
001A09  3  8D E1 16             STA     PTEMPW1+1
001A0C  3  20 9D 2A             JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001A0F  3  20 2E 33             JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
001A12  3                                               ; FIGURE THE BUFFER OFFSET
001A12  3  8A                   TXA                     ; Y COORD IN X
001A13  3  48                   PHA
001A14  3  4A                   LSR     A               ; 2 LINES PER BYTE
001A15  3  8D E0 16             STA     PTEMPW1
001A18  3                                               ; MULTIPLY Y (PTEMPW) COORD BY 40 OR 80 (SINGLE OR DOUBLE LORES)
001A18  3  18                   CLC
001A19  3  0E E0 16             ASL     PTEMPW1
001A1C  3  2E E1 16             ROL     PTEMPW1+1       ; *2
001A1F  3  0E E0 16             ASL     PTEMPW1
001A22  3  2E E1 16             ROL     PTEMPW1+1       ; *2 (*4)
001A25  3  0E E0 16             ASL     PTEMPW1
001A28  3  2E E1 16             ROL     PTEMPW1+1       ; *2 (*8)
001A2B  3  AD E0 16             LDA     PTEMPW1
001A2E  3  8D E2 16             STA     PTEMPW2
001A31  3  AD E1 16             LDA     PTEMPW1+1
001A34  3  8D E3 16             STA     PTEMPW2+1       ; STORE Y*8 INTO PTEMPW2
001A37  3  0E E0 16             ASL     PTEMPW1
001A3A  3  2E E1 16             ROL     PTEMPW1+1       ; *2 (*16)
001A3D  3  0E E0 16             ASL     PTEMPW1
001A40  3  2E E1 16             ROL     PTEMPW1+1       ; *2 (*32)
001A43  3                                               ; NOW TAKE Y*8(PTEMPW2) + Y*32(PTEMPW1) == Y*40 STORE IN PTEMPW1
001A43  3  18                   CLC                     ; Clear the Carry flag before the first addition
001A44  3               
001A44  3  AD E0 16             LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
001A47  3  6D E2 16             ADC     PTEMPW2         ; Add the low byte of the second number (plus carry)
001A4A  3  8D E0 16             STA     PTEMPW1         ; Store the low byte of the result
001A4D  3               
001A4D  3  AD E1 16             LDA     PTEMPW1+1       ; Load the high byte of the first number
001A50  3  6D E3 16             ADC     PTEMPW2+1       ; Add the high byte of the second number (plus carry from previous op)
001A53  3  8D E1 16             STA     PTEMPW1+1       ; Store the high byte of the result
001A56  3               
001A56  3               ; if double lores columns double it.
