0012AD  3               ;___SAVE____________________________________________________
0012AD  3               ;
0012AD  3               ; SAVE COMMAND
0012AD  3               ;
0012AD  3               ;  SAVE THE BASIC PROGRAM IN MEMORY TO DISK
0012AD  3               ;
0012AD  3               ;__________________________________________________________
0012AD  3               V_SAVE: ; save BASIC program
0012AD  3               DOS65SAVE:
0012AD  3  20 20 14             JSR     DOS65FCBPREP    ; parse parameters into FCB
0012B0  3  B0 28                BCS     DOS65SAVE_ERR1  ; Error?, if so abort
0012B2  3  A2 0D                LDX     #13             ;
0012B4  3  20 A7 12             JSR     PEM             ;
0012B7  3  A9 52                LDA     #<FCB           ; CREATE File
0012B9  3  A0 18                LDY     #>FCB           ;
0012BB  3  A2 16                LDX     #22             ;
0012BD  3  20 A7 12             JSR     PEM             ;
0012C0  3  A9 00                LDA     #0              ; clear
0012C2  3  8D 72 18             STA     FCB+32          ; record number
0012C5  3  A9 52                LDA     #<FCB           ; Open File
0012C7  3  A0 18                LDY     #>FCB           ;
0012C9  3  A2 0F                LDX     #15             ;
0012CB  3  20 A7 12             JSR     PEM             ;
0012CE  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
0012D0  3  D0 0B                BNE     DOS65SAVE_1     ;
0012D2  3               DOS65SAVE_ERR:
0012D2  3  A2 24                LDX     #$24            ; IO ERROR
0012D4  3  20 8B 23             JSR     LAB_XERR
0012D7  3  4C 63 24             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
0012DA  3               DOS65SAVE_ERR1:
0012DA  3  4C 7E 29             JMP     LAB_REM         ; comment out the remainder of the line (if any)
0012DD  3               DOS65SAVE_1:
0012DD  3  A9 06                LDA     #<FCBBUFFER     ; SETUP BUFFER
0012DF  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
0012E1  3  A0 43                LDY     #>FCBBUFFER     ;
0012E3  3  84 21                STY     FCBPTR+1        ;
0012E5  3  A2 1A                LDX     #26             ; Setup Buffer
0012E7  3  20 A7 12             JSR     PEM             ;
0012EA  3               DOS65SAVE_2:
0012EA  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
0012EC  3  85 22                STA     FCBPTR+2        ; point to base of RAM
0012EE  3  A5 7A                LDA     <Smemh          ;
0012F0  3  85 23                STA     FCBPTR+3        ;
0012F2  3  A2 00                LDX     #$00            ; x=0 (null counter)
0012F4  3               DOS65SAVE_2A:
0012F4  3  A0 00                LDY     #$00            ; y=0 (Loop Index)
0012F6  3               DOS65SAVE_3:
0012F6  3  B1 22                LDA     (FCBPTR+2),Y    ; load from RAM
0012F8  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
0012FA  3  C9 00                CMP     #$00            ; is Zero?
0012FC  3  D0 1E                BNE     DOS65SAVE_3A    ; No, continue
0012FE  3  E8                   INX                     ; yes, bump Null Counter
0012FF  3  E0 03                CPX     #$03            ; Three nulls in a row?
001301  3  D0 1B                BNE     DOS65SAVE_3B    ; No, continue
001303  3                                               ; FINISH FILLING BUFFER WITH NULLS
001303  3               :
001303  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
001305  3  C8                   INY                     ; bump index
001306  3  C0 80                CPY     #$80            ; end of buffer?
001308  3  D0 F9                BNE     :-              ; no, loop
00130A  3  A9 52                LDA     #<FCB           ; Write record in buffer to disk file AND END
00130C  3  A0 18                LDY     #>FCB           ;
00130E  3  A2 15                LDX     #21             ;
001310  3  20 A7 12             JSR     PEM             ;
001313  3  29 FE                AND     #$FE            ; strip out extension
001315  3  C9 00                CMP     #$00            ; is error
001317  3  D0 B9                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
001319  3  4C 49 13             JMP     DOS65SAVE_4
00131C  3               DOS65SAVE_3A:                   ;
00131C  3  A2 00                LDX     #$00            ; prior char not null, reset null counter
00131E  3               DOS65SAVE_3B:                   ;
00131E  3  C8                   INY                     ; bump index
00131F  3  C0 80                CPY     #$80            ; end of buffer?
001321  3  D0 D3                BNE     DOS65SAVE_3     ; no, loop
001323  3               DOS65SAVE_3C:
001323  3  A9 52                LDA     #<FCB           ; Write record in buffer to disk file
001325  3  A0 18                LDY     #>FCB           ;
001327  3  A2 15                LDX     #21             ;
001329  3  20 A7 12             JSR     PEM             ;
00132C  3  29 FE                AND     #$FE            ; strip out extension
00132E  3  C9 00                CMP     #$00            ; is error
001330  3  D0 A0                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
001332  3  18                   CLC                     ;
001333  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
001335  3  69 80                ADC     #$80            ;
001337  3  85 22                STA     FCBPTR+2        ;
001339  3  90 B9                BCC     DOS65SAVE_2A    ; is carry?, no loop
00133B  3  18                   CLC                     ; yes, carry, inc high byte
00133C  3  A5 23                LDA     FCBPTR+3        ;
00133E  3  69 01                ADC     #$01            ;
001340  3  85 23                STA     FCBPTR+3        ;
001342  3  C9 B8                CMP     #>Ram_top       ; are we at the end of RAM?
001344  3  F0 03                BEQ     DOS65SAVE_4
001346  3  4C F4 12             JMP     DOS65SAVE_2A
001349  3               DOS65SAVE_4:
001349  3  A9 52                LDA     #<FCB           ;
00134B  3  A0 18                LDY     #>FCB           ;
00134D  3  A2 10                LDX     #16             ;
00134F  3  20 A7 12             JSR     PEM             ;
001352  3  C9 FF                CMP     #$FF            ;
001354  3  D0 03                BNE     DOS65SAVE_5     ;
001356  3  4C D2 12             JMP     DOS65SAVE_ERR   ; ERROR, DISPLAY IT
001359  3               DOS65SAVE_5:
001359  3  A9 7E                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
00135B  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
00135D  3  20 25 2B             JSR     LAB_18C3
001360  3  4C 63 24             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001363  3               
001363  3               ;___LOAD____________________________________________________
001363  3               ;
001363  3               ; LOAD COMMAND
001363  3               ;
001363  3               ;  LOAD A BASIC PROGRAM FROM DISK TO MEMORY
001363  3               ;
001363  3               ;__________________________________________________________
001363  3               V_LOAD: ; load BASIC program
001363  3               DOS65LOAD:
001363  3  A9 00                LDA     #$00
001365  3  8D 64 14             STA     NullCounter
001368  3  20 20 14             JSR     DOS65FCBPREP    ; parse parameters into FCB
00136B  3  B0 1F                BCS     DOS65LOAD_ERR1  ; Error?, if so abort
00136D  3  A2 0D                LDX     #13             ;
00136F  3  20 A7 12             JSR     PEM             ;
001372  3  A9 00                LDA     #0              ; clear
001374  3  8D 72 18             STA     FCB+32          ; record number
001377  3  A9 52                LDA     #<FCB           ; Open File
001379  3  A0 18                LDY     #>FCB           ;
00137B  3  A2 0F                LDX     #15             ;
00137D  3  20 A7 12             JSR     PEM             ;
001380  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
001382  3  D0 0B                BNE     DOS65LOAD_1     ;
001384  3               DOS65LOAD_ERR:
001384  3  A2 24                LDX     #$24            ; IO ERROR
001386  3  20 8B 23             JSR     LAB_XERR
001389  3  4C 63 24             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
00138C  3               DOS65LOAD_ERR1:
00138C  3  4C 7E 29             JMP     LAB_REM         ; comment out the remainder of the line (if any)
00138F  3               DOS65LOAD_1:
00138F  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
001391  3  85 22                STA     FCBPTR+2        ; point to base of RAM
001393  3  8D 62 14             STA     EndOfBas        ;
001396  3  A5 7A                LDA     <Smemh          ;
001398  3  85 23                STA     FCBPTR+3        ;
00139A  3  8D 63 14             STA     EndOfBas+1      ;
00139D  3  A9 06                LDA     #<FCBBUFFER     ; SETUP BUFFER
00139F  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
0013A1  3  A0 43                LDY     #>FCBBUFFER     ;
0013A3  3  84 21                STY     FCBPTR+1        ; STORE DEST BUFFER IN FCBPTR
0013A5  3  A2 1A                LDX     #26             ; Setup Buffer
0013A7  3  20 A7 12             JSR     PEM             ;
0013AA  3  4C E8 13             JMP     DOS65LOAD_3C
0013AD  3               DOS65LOAD_3:
0013AD  3  B1 20                LDA     (FCBPTR),Y      ; load from BUFFER
0013AF  3  91 22                STA     (FCBPTR+2),Y    ; save to RAM
0013B1  3  EE 62 14             INC     EndOfBas
0013B4  3  D0 03                BNE     :+
0013B6  3  EE 63 14             INC     EndOfBas+1
0013B9  3               :
0013B9  3  C9 00                CMP     #$00
0013BB  3  D0 0D                BNE     :+
0013BD  3  EE 64 14             INC     NullCounter
0013C0  3  AD 64 14             LDA     NullCounter
0013C3  3  C9 03                CMP     #3
0013C5  3  D0 08                BNE     :++
0013C7  3  4C FB 13             JMP     DOS65LOAD_4
0013CA  3               :
0013CA  3  A9 00                LDA     #$00
0013CC  3  8D 64 14             STA     NullCounter
0013CF  3               :
0013CF  3  C8                   INY                     ; bump index
0013D0  3  C0 80                CPY     #$80            ; end of buffer?
0013D2  3  D0 D9                BNE     DOS65LOAD_3     ; no, loop
0013D4  3  18                   CLC                     ;
0013D5  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
0013D7  3  69 80                ADC     #$80            ;
0013D9  3  85 22                STA     FCBPTR+2        ;
0013DB  3  90 0B                BCC     DOS65LOAD_3C    ; is carry?, no SKIP
0013DD  3  18                   CLC                     ; yes, carry, inc high byte
0013DE  3  A5 23                LDA     FCBPTR+3        ;
0013E0  3  69 01                ADC     #$01            ;
0013E2  3  85 23                STA     FCBPTR+3        ;
0013E4  3  C9 B8                CMP     #>Ram_top       ; are we at the end of RAM?
0013E6  3  F0 13                BEQ     DOS65LOAD_4
0013E8  3               
0013E8  3               DOS65LOAD_3C:
0013E8  3  A9 52                LDA     #<FCB           ; READ record buffer from disk file
0013EA  3  A0 18                LDY     #>FCB           ;
0013EC  3  A2 14                LDX     #20             ;
0013EE  3  20 A7 12             JSR     PEM             ;
0013F1  3  A0 00                LDY     #$00            ; RESET INDEX
0013F3  3  C9 00                CMP     #$00            ; is error or EOF
0013F5  3  F0 B6                BEQ     DOS65LOAD_3     ;
0013F7  3  C9 01                CMP     #$01            ; EOF?
0013F9  3  D0 89                BNE     DOS65LOAD_ERR   ; ERROR, do error handling
0013FB  3               DOS65LOAD_4:
0013FB  3  A9 52                LDA     #<FCB           ;
0013FD  3  A0 18                LDY     #>FCB           ;
0013FF  3  A2 10                LDX     #16             ;
001401  3  20 A7 12             JSR     PEM             ;
001404  3                                               ; setup pointers to return to basic
001404  3  AD 62 14             LDA     EndOfBas
001407  3  85 7B                STA     Svarl
001409  3  85 7D                STA     Sarryl
00140B  3  85 7F                STA     Earryl
00140D  3  AD 63 14             LDA     EndOfBas+1
001410  3  85 7C                STA     Svarh
001412  3  85 7E                STA     Sarryh
001414  3  85 80                STA     Earryh
001416  3  A9 7E                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
001418  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
00141A  3  20 25 2B             JSR     LAB_18C3
00141D  3  4C 63 24             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001420  3               
001420  3               
001420  3               
001420  3               DOS65FCBPREP:
001420  3                       .IFDEF  DUODYNE
001420  3                       JSL     LAB_GBYT        ; scan memory
001420  3                       .ELSE
001420  3  20 C2 00             JSR     LAB_GBYT        ; scan memory
001423  3                       .ENDIF
001423  3               
001423  3  38                   SEC                     ;
001424  3  E9 40                SBC     #64             ; PARSE DRIVE NUMBER
001426  3  8D 52 18             STA     DOSDRIVE        ; STORE IT IN FCB
001429  3                       .IFDEF  DUODYNE
001429  3                       JSL     LAB_IGBY        ; increment and scan memory
001429  3                       .ELSE
001429  3  20 BC 00             JSR     LAB_IGBY        ; increment and scan memory
00142C  3                       .ENDIF
00142C  3               
00142C  3  C9 3A                CMP     #':'            ;
00142E  3  F0 08                BEQ     DOS65FCBPREP_1  ; YES, IT WAS A DRIVE, CONTINUE
001430  3  A2 26                LDX     #$26            ; IO ERROR
001432  3  20 8B 23             JSR     LAB_XERR
001435  3  4C 63 24             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001438  3               
001438  3               DOS65FCBPREP_1:
001438  3  A9 52                LDA     #<FCB           ; SETUP FCBPTR
00143A  3  85 20                STA     FCBPTR          ;
00143C  3  A9 18                LDA     #>FCB           ;
00143E  3  85 21                STA     FCBPTR+1        ;
001440  3  A0 01                LDY     #$01            ; POINT Y TO FCB FILE NAME
001442  3  A9 20                LDA     #$20            ; LOAD SPACE CHAR INTO A
001444  3               DOS65FCBPREP_1A:                ; BLANK OUT FCB
001444  3  91 20                STAINDIRECTY FCBPTR     ;
001446  3  C8                   INY                     ;
001447  3  C0 09                CPY     #$09            ; IS DONE
001449  3  D0 F9                BNE     DOS65FCBPREP_1A ; NO, LOOP
00144B  3  A0 01                LDY     #$01            ; POINT Y TO FCB FILE NAME
00144D  3               DOS65FCBPREP_2:                 ; COPY FILE NAME PARAMETER INTO FCB
00144D  3                       .IFDEF  DUODYNE
00144D  3                       JSL     LAB_IGBY        ; increment and scan memory
00144D  3                       .ELSE
00144D  3  20 BC 00             JSR     LAB_IGBY        ; increment and scan memory
001450  3                       .ENDIF
001450  3  F0 0E                BEQ     DOS65FCBPREP_3  ;
001452  3  C9 2E                CMP     #'.'
001454  3  F0 0A                BEQ     DOS65FCBPREP_3  ;
001456  3  91 20                STAINDIRECTY FCBPTR     ;
001458  3  C8                   INY                     ;
001459  3  C0 09                CPY     #$09            ;
00145B  3  F0 03                BEQ     DOS65FCBPREP_3  ;
00145D  3  4C 4D 14             JMP     DOS65FCBPREP_2  ;
001460  3               DOS65FCBPREP_3:                 ;
001460  3  18                   CLC
001461  3  60                   RTS                     ;
