003E45  1  E9 01                SBC     #$01            ; -1 (carry already set for subtract)
003E47  1  95 01                STA     PLUS_1,X        ; save as interrupt pointer low byte
003E49  1  A5 AB                LDA     Baslnh          ; get pointer high byte
003E4B  1  E9 00                SBC     #$00            ; subtract carry
003E4D  1  95 02                STA     PLUS_2,X        ; save as interrupt pointer high byte
003E4F  1               
003E4F  1  A9 C0                LDA     #$C0            ; set interrupt enabled/setup bits
003E51  1  95 00                STA     PLUS_0,X        ; set interrupt flags
003E53  1               LAB_IRTS:
003E53  1  60                   RTS
003E54  1               
003E54  1               ; return from IRQ service, restores the enabled flag.
003E54  1               
003E54  1               ; perform RETIRQ
003E54  1               
003E54  1               LAB_RETIRQ:
003E54  1  D0 FD                BNE     LAB_IRTS        ; exit if following token (to allow syntax error)
003E56  1               
003E56  1  A5 E8                LDA     IrqBase         ; get interrupt flags
003E58  1  0A                   ASL     A               ; copy setup to enabled (b7)
003E59  1  05 E8                ORA     IrqBase         ; OR in setup flag
003E5B  1  85 E8                STA     IrqBase         ; save enabled flag
003E5D  1  4C 58 25             JMP     LAB_16E8        ; go do rest of RETURN
003E60  1               
003E60  1               ; return from NMI service, restores the enabled flag.
003E60  1               
003E60  1               ; perform RETNMI
003E60  1               
003E60  1               LAB_RETNMI:
003E60  1  D0 F1                BNE     LAB_IRTS        ; exit if following token (to allow syntax error)
003E62  1               
003E62  1  A5 E5                LDA     NmiBase         ; get set-up flag
003E64  1  0A                   ASL     A               ; copy setup to enabled (b7)
003E65  1  05 E5                ORA     NmiBase         ; OR in setup flag
003E67  1  85 E5                STA     NmiBase         ; save enabled flag
003E69  1  4C 58 25             JMP     LAB_16E8        ; go do rest of RETURN
003E6C  1               
003E6C  1               ; MAX() MIN() pre process
003E6C  1               
003E6C  1               LAB_MMPP:
003E6C  1  20 C8 29             JSR     LAB_EVEZ        ; process expression
003E6F  1  4C AF 29             JMP     LAB_CTNM        ; check if source is numeric, else do type mismatch
003E72  1               
003E72  1               ; perform MAX()
003E72  1               
003E72  1               LAB_MAX:
003E72  1  20 A1 3E             JSR     LAB_PHFA        ; push FAC1, evaluate expression,
003E75  1               ; pull FAC2 and compare with FAC1
003E75  1  10 FB                BPL     LAB_MAX         ; branch if no swap to do
003E77  1               
003E77  1  A5 B4                LDA     FAC2_1          ; get FAC2 mantissa1
003E79  1  09 80                ORA     #$80            ; set top bit (clear sign from compare)
003E7B  1  85 B4                STA     FAC2_1          ; save FAC2 mantissa1
003E7D  1  20 AE 34             JSR     LAB_279B        ; copy FAC2 to FAC1
003E80  1  F0 F0                BEQ     LAB_MAX         ; go do next (branch always)
003E82  1               
003E82  1               ; perform MIN()
003E82  1               
003E82  1               LAB_MIN:
003E82  1  20 A1 3E             JSR     LAB_PHFA        ; push FAC1, evaluate expression,
003E85  1               ; pull FAC2 and compare with FAC1
003E85  1  30 FB                BMI     LAB_MIN         ; branch if no swap to do
003E87  1               
003E87  1  F0 F9                BEQ     LAB_MIN         ; branch if no swap to do
003E89  1               
003E89  1  A5 B4                LDA     FAC2_1          ; get FAC2 mantissa1
003E8B  1  09 80                ORA     #$80            ; set top bit (clear sign from compare)
003E8D  1  85 B4                STA     FAC2_1          ; save FAC2 mantissa1
003E8F  1  20 AE 34             JSR     LAB_279B        ; copy FAC2 to FAC1
003E92  1  F0 EE                BEQ     LAB_MIN         ; go do next (branch always)
003E94  1               
003E94  1               ; exit routine. don't bother returning to the loop code
003E94  1               ; check for correct exit, else so syntax error
003E94  1               
003E94  1               LAB_MMEC:
003E94  1  C9 29                CMP     #')'            ; is it end of function?
003E96  1  D0 06                BNE     LAB_MMSE        ; if not do MAX MIN syntax error
003E98  1               
003E98  1  68                   PLA                     ; dump return address low byte
003E99  1  68                   PLA                     ; dump return address high byte
003E9A  1                       .IFDEF  DUODYNE
003E9A  1                       JSL     LAB_IGBY        ; increment and scan memory
003E9A  1                       .ELSE
003E9A  1  20 BC 00             JSR     LAB_IGBY        ; increment and scan memory
003E9D  1                       .ENDIF
003E9D  1               
003E9D  1  60                   RTS                     ; update BASIC execute pointer (to chr past ")")
003E9E  1               
003E9E  1               LAB_MMSE:
003E9E  1  4C E2 2A             JMP     LAB_SNER        ; do syntax error then warm start
003EA1  1               
003EA1  1               ; check for next, evaluate and return or exit
003EA1  1               ; this is the routine that does most of the work
003EA1  1               
003EA1  1               LAB_PHFA:
003EA1  1                       .IFDEF  DUODYNE
003EA1  1                       JSL     LAB_GBYT        ; scan memory
003EA1  1                       .ELSE
003EA1  1  20 C2 00             JSR     LAB_GBYT        ; scan memory
003EA4  1                       .ENDIF
003EA4  1               
003EA4  1  C9 2C                CMP     #','            ; is there more ?
003EA6  1  D0 EC                BNE     LAB_MMEC        ; if not go do end check
003EA8  1               
003EA8  1               ; push FAC1
003EA8  1  20 C4 37             JSR     LAB_27BA        ; round FAC1
003EAB  1  A5 B0                LDA     FAC1_s          ; get FAC1 sign
003EAD  1  09 7F                ORA     #$7F            ; set all non sign bits
003EAF  1  25 AD                AND     FAC1_1          ; AND FAC1 mantissa1 (AND in sign bit)
003EB1  1  48                   PHA                     ; push on stack
003EB2  1  A5 AE                LDA     FAC1_2          ; get FAC1 mantissa2
003EB4  1  48                   PHA                     ; push on stack
003EB5  1  A5 AF                LDA     FAC1_3          ; get FAC1 mantissa3
003EB7  1  48                   PHA                     ; push on stack
003EB8  1  A5 AC                LDA     FAC1_e          ; get FAC1 exponent
003EBA  1  48                   PHA                     ; push on stack
003EBB  1               
003EBB  1                       .IFDEF  DUODYNE
003EBB  1                       JSL     LAB_IGBY        ; increment and scan memory
003EBB  1                       .ELSE
003EBB  1  20 BC 00             JSR     LAB_IGBY        ; increment and scan memory
003EBE  1                       .ENDIF
003EBE  1               
003EBE  1  20 AC 29             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
003EC1  1               ; else do type mismatch
003EC1  1               
003EC1  1               ; pop FAC2 (MAX/MIN expression so far)
003EC1  1  68                   PLA                     ; pop exponent
003EC2  1  85 B3                STA     FAC2_e          ; save FAC2 exponent
003EC4  1  68                   PLA                     ; pop mantissa3
003EC5  1  85 B6                STA     FAC2_3          ; save FAC2 mantissa3
003EC7  1  68                   PLA                     ; pop mantissa1
003EC8  1  85 B5                STA     FAC2_2          ; save FAC2 mantissa2
003ECA  1  68                   PLA                     ; pop sign/mantissa1
003ECB  1  85 B4                STA     FAC2_1          ; save FAC2 sign/mantissa1
003ECD  1  85 B7                STA     FAC2_s          ; save FAC2 sign
003ECF  1               
003ECF  1               ; compare FAC1 with (packed) FAC2
003ECF  1  A9 B3                LDA     #<FAC2_e        ; set pointer low byte to FAC2
003ED1  1  A0 00                LDY     #>FAC2_e        ; set pointer high byte to FAC2
003ED3  1  4C 02 38             JMP     LAB_27F8        ; compare FAC1 with FAC2 (AY) and return
003ED6  1               ; returns A=$00 if FAC1 = (AY)
003ED6  1               ; returns A=$01 if FAC1 > (AY)
003ED6  1               ; returns A=$FF if FAC1 < (AY)
003ED6  1               
003ED6  1               ; perform WIDTH
003ED6  1               
003ED6  1               LAB_WDTH:
003ED6  1  C9 2C                CMP     #','            ; is next byte ","
003ED8  1  F0 1B                BEQ     LAB_TBSZ        ; if so do tab size
003EDA  1               
003EDA  1  20 6F 33             JSR     LAB_GTBY        ; get byte parameter
003EDD  1  8A                   TXA                     ; copy width to A
003EDE  1  F0 0A                BEQ     LAB_NSTT        ; branch if set for infinite line
003EE0  1               
003EE0  1  E0 10                CPX     #$10            ; else make min width = 16d
003EE2  1  90 45                BCC     TabErr          ; if less do function call error and exit
003EE4  1               
003EE4  1               ; this next compare ensures that we can't exit WIDTH via an error leaving the
003EE4  1               ; tab size greater than the line length.
003EE4  1               
003EE4  1  E4 64                CPX     TabSiz          ; compare with tab size
003EE6  1  B0 02                BCS     LAB_NSTT        ; branch if >= tab size
003EE8  1               
003EE8  1  86 64                STX     TabSiz          ; else make tab size = terminal width
003EEA  1               LAB_NSTT:
003EEA  1  86 0F                STX     TWidth          ; set the terminal width
003EEC  1                       .IFDEF  DUODYNE
003EEC  1                       JSL     LAB_GBYT        ; scan memory
003EEC  1                       .ELSE
003EEC  1  20 C2 00             JSR     LAB_GBYT        ; scan memory
003EEF  1                       .ENDIF
003EEF  1               
003EEF  1  F0 1A                BEQ     WExit           ; exit if no following
003EF1  1               
003EF1  1  C9 2C                CMP     #','            ; else is it ","
003EF3  1  D0 A9                BNE     LAB_MMSE        ; if not do syntax error
003EF5  1               
003EF5  1               LAB_TBSZ:
003EF5  1  20 6C 33             JSR     LAB_SGBY        ; scan and get byte parameter
003EF8  1  8A                   TXA                     ; copy TAB size
003EF9  1  30 2E                BMI     TabErr          ; if >127 do function call error and exit
003EFB  1               
003EFB  1  E0 01                CPX     #$01            ; compare with min-1
003EFD  1  90 2A                BCC     TabErr          ; if <=1 do function call error and exit
003EFF  1               
003EFF  1  A5 0F                LDA     TWidth          ; set flags for width
003F01  1  F0 06                BEQ     LAB_SVTB        ; skip check if infinite line
003F03  1               
003F03  1  E4 0F                CPX     TWidth          ; compare TAB with width
003F05  1  F0 02                BEQ     LAB_SVTB        ; ok if =
003F07  1               
003F07  1  B0 20                BCS     TabErr          ; branch if too big
003F09  1               
003F09  1               LAB_SVTB:
003F09  1  86 64                STX     TabSiz          ; save TAB size
003F0B  1               
003F0B  1               ; calculate tab column limit from TAB size. The Iclim is set to the last tab
003F0B  1               ; position on a line that still has at least one whole tab width between it
003F0B  1               ; and the end of the line.
003F0B  1               
003F0B  1               WExit:
003F0B  1  A5 0F                LDA     TWidth          ; get width
003F0D  1  F0 06                BEQ     LAB_SULP        ; branch if infinite line
003F0F  1               
003F0F  1  C5 64                CMP     TabSiz          ; compare with tab size
003F11  1  B0 03                BCS     LAB_WDLP        ; branch if >= tab size
003F13  1               
003F13  1  85 64                STA     TabSiz          ; else make tab size = terminal width
003F15  1               LAB_SULP:
003F15  1  38                   SEC                     ; set carry for subtract
003F16  1               LAB_WDLP:
003F16  1  E5 64                SBC     TabSiz          ; subtract tab size
003F18  1  B0 FC                BCS     LAB_WDLP        ; loop while no borrow
003F1A  1               
003F1A  1  65 64                ADC     TabSiz          ; add tab size back
003F1C  1  18                   CLC                     ; clear carry for add
003F1D  1  65 64                ADC     TabSiz          ; add tab size back again
003F1F  1  85 10                STA     Iclim           ; save for now
003F21  1  A5 0F                LDA     TWidth          ; get width back
003F23  1  38                   SEC                     ; set carry for subtract
003F24  1  E5 10                SBC     Iclim           ; subtract remainder
003F26  1  85 10                STA     Iclim           ; save tab column limit
003F28  1               LAB_NOSQ:
003F28  1  60                   RTS
003F29  1               
003F29  1               TabErr:
003F29  1  4C 0A 2E             JMP     LAB_FCER        ; do function call error then warm start
003F2C  1               
003F2C  1               ; perform SQR()
003F2C  1               
003F2C  1               LAB_SQR:
003F2C  1  A5 B0                LDA     FAC1_s          ; get FAC1 sign
003F2E  1  30 F9                BMI     TabErr          ; if -ve do function call error
003F30  1               
003F30  1  A5 AC                LDA     FAC1_e          ; get exponent
003F32  1  F0 F4                BEQ     LAB_NOSQ        ; if zero just return
003F34  1               
003F34  1               ; else do root
003F34  1  20 B5 37             JSR     LAB_27AB        ; round and copy FAC1 to FAC2
003F37  1  A9 00                LDA     #$00            ; clear A
003F39  1               
003F39  1  85 77                STA     FACt_3          ; clear remainder
003F3B  1  85 76                STA     FACt_2          ; ..
003F3D  1  85 75                STA     FACt_1          ; ..
003F3F  1  85 78                STA     TempB           ; ..
003F41  1               
003F41  1  85 AF                STA     FAC1_3          ; clear root
003F43  1  85 AE                STA     FAC1_2          ; ..
003F45  1  85 AD                STA     FAC1_1          ; ..
003F47  1               
003F47  1  A2 18                LDX     #$18            ; 24 pairs of bits to do
003F49  1  A5 B3                LDA     FAC2_e          ; get exponent
003F4B  1  4A                   LSR     A               ; check odd/even
003F4C  1  B0 0E                BCS     LAB_SQE2        ; if odd only 1 shift first time
003F4E  1               
003F4E  1               LAB_SQE1:
003F4E  1  06 B6                ASL     FAC2_3          ; shift highest bit of number ..
003F50  1  26 B5                ROL     FAC2_2          ; ..
003F52  1  26 B4                ROL     FAC2_1          ; ..
003F54  1  26 77                ROL     FACt_3          ; .. into remainder
003F56  1  26 76                ROL     FACt_2          ; ..
003F58  1  26 75                ROL     FACt_1          ; ..
003F5A  1  26 78                ROL     TempB           ; .. never overflows
003F5C  1               LAB_SQE2:
003F5C  1  06 B6                ASL     FAC2_3          ; shift highest bit of number ..
003F5E  1  26 B5                ROL     FAC2_2          ; ..
003F60  1  26 B4                ROL     FAC2_1          ; ..
003F62  1  26 77                ROL     FACt_3          ; .. into remainder
003F64  1  26 76                ROL     FACt_2          ; ..
003F66  1  26 75                ROL     FACt_1          ; ..
003F68  1  26 78                ROL     TempB           ; .. never overflows
003F6A  1               
003F6A  1  06 AF                ASL     FAC1_3          ; root = root * 2
003F6C  1  26 AE                ROL     FAC1_2          ; ..
003F6E  1  26 AD                ROL     FAC1_1          ; .. never overflows
003F70  1               
003F70  1  A5 AF                LDA     FAC1_3          ; get root low byte
003F72  1  2A                   ROL     A               ; *2
003F73  1  85 5B                STA     Temp3           ; save partial low byte
003F75  1  A5 AE                LDA     FAC1_2          ; get root low mid byte
003F77  1  2A                   ROL     A               ; *2
003F78  1  85 5C                STA     Temp3+1         ; save partial low mid byte
003F7A  1  A5 AD                LDA     FAC1_1          ; get root high mid byte
003F7C  1  2A                   ROL     A               ; *2
003F7D  1  85 5D                STA     Temp3+2         ; save partial high mid byte
003F7F  1  A9 00                LDA     #$00            ; get root high byte (always $00)
003F81  1  2A                   ROL     A               ; *2
003F82  1  85 5E                STA     Temp3+3         ; save partial high byte
003F84  1               
003F84  1               ; carry clear for subtract +1
003F84  1  A5 77                LDA     FACt_3          ; get remainder low byte
003F86  1  E5 5B                SBC     Temp3           ; subtract partial low byte
003F88  1  85 5B                STA     Temp3           ; save partial low byte
003F8A  1               
003F8A  1  A5 76                LDA     FACt_2          ; get remainder low mid byte
003F8C  1  E5 5C                SBC     Temp3+1         ; subtract partial low mid byte
003F8E  1  85 5C                STA     Temp3+1         ; save partial low mid byte
003F90  1               
003F90  1  A5 75                LDA     FACt_1          ; get remainder high mid byte
003F92  1  E5 5D                SBC     Temp3+2         ; subtract partial high mid byte
003F94  1  A8                   TAY                     ; copy partial high mid byte
003F95  1               
003F95  1  A5 78                LDA     TempB           ; get remainder high byte
003F97  1  E5 5E                SBC     Temp3+3         ; subtract partial high byte
003F99  1  90 0E                BCC     LAB_SQNS        ; skip sub if remainder smaller
003F9B  1               
003F9B  1  85 78                STA     TempB           ; save remainder high byte
003F9D  1               
003F9D  1  84 75                STY     FACt_1          ; save remainder high mid byte
003F9F  1               
003F9F  1  A5 5C                LDA     Temp3+1         ; get remainder low mid byte
003FA1  1  85 76                STA     FACt_2          ; save remainder low mid byte
003FA3  1               
003FA3  1  A5 5B                LDA     Temp3           ; get partial low byte
003FA5  1  85 77                STA     FACt_3          ; save remainder low byte
003FA7  1               
003FA7  1  E6 AF                INC     FAC1_3          ; increment root low byte (never any rollover)
003FA9  1               LAB_SQNS:
003FA9  1  CA                   DEX                     ; decrement bit pair count
003FAA  1  D0 A2                BNE     LAB_SQE1        ; loop if not all done
003FAC  1               
003FAC  1  38                   SEC                     ; set carry for subtract
003FAD  1  A5 B3                LDA     FAC2_e          ; get exponent
003FAF  1  E9 80                SBC     #$80            ; normalise
003FB1  1  6A                   ROR     A               ; /2 and re-bias to $80
003FB2  1  69 00                ADC     #$00            ; add bit zero back in (allow for half shift)
003FB4  1  85 AC                STA     FAC1_e          ; save it
003FB6  1  4C 1F 35             JMP     LAB_24D5        ; normalise FAC1 and return
003FB9  1               
003FB9  1               ; perform VARPTR()
003FB9  1               
003FB9  1               LAB_VARPTR:
003FB9  1                       .IFDEF  DUODYNE
003FB9  1                       JSL     LAB_IGBY        ; increment and scan memory
003FB9  1                       .ELSE
003FB9  1  20 BC 00             JSR     LAB_IGBY        ; increment and scan memory
003FBC  1                       .ENDIF
003FBC  1               
003FBC  1  20 8B 2C             JSR     LAB_GVAR        ; get var address
003FBF  1  20 CE 2A             JSR     LAB_1BFB        ; scan for ")" , else do syntax error then warm start
003FC2  1  A4 95                LDY     Cvaral          ; get var address low byte
003FC4  1  A5 96                LDA     Cvarah          ; get var address high byte
003FC6  1  4C 3A 2F             JMP     LAB_AYFC        ; save and convert integer AY to FAC1 and return
003FC9  1               
003FC9  1               ; perform PI
003FC9  1               
003FC9  1               LAB_PI:
003FC9  1  A9 42                LDA     #<LAB_2C7C      ; set (2*pi) pointer low byte
003FCB  1  A0 10                LDY     #>LAB_2C7C      ; set (2*pi) pointer high byte
003FCD  1  20 68 37             JSR     LAB_UFAC        ; unpack memory (AY) into FAC1
003FD0  1  C6 AC                DEC     FAC1_e          ; make result = PI
003FD2  1  60                   RTS
003FD3  1               
003FD3  1               ; perform TWOPI
003FD3  1               
003FD3  1               LAB_TWOPI:
003FD3  1  A9 42                LDA     #<LAB_2C7C      ; set (2*pi) pointer low byte
003FD5  1  A0 10                LDY     #>LAB_2C7C      ; set (2*pi) pointer high byte
003FD7  1  4C 68 37             JMP     LAB_UFAC        ; unpack memory (AY) into FAC1 and return
