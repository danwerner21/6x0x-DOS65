001BED  3               V_PLOT_LORES:
001BED  3  AD 99 18             LDA     PLOTY
001BF0  3  48                   PHA
001BF1  3  4A                   LSR     A               ; 2 LINES PER BYTE
001BF2  3  8D 99 18             STA     PLOTY
001BF5  3                                               ; MULTIPLY Y (PTEMPW) COORD BY 40 OR 80 (SINGLE OR DOUBLE LORES)
001BF5  3  18                   CLC
001BF6  3  0E 99 18             ASL     PLOTY
001BF9  3  2E 9A 18             ROL     PLOTY+1         ; *2
001BFC  3  0E 99 18             ASL     PLOTY
001BFF  3  2E 9A 18             ROL     PLOTY+1         ; *2 (*4)
001C02  3  0E 99 18             ASL     PLOTY
001C05  3  2E 9A 18             ROL     PLOTY+1         ; *2 (*8)
001C08  3  AD 99 18             LDA     PLOTY
001C0B  3  8D A9 18             STA     PTEMPW
001C0E  3  AD 9A 18             LDA     PLOTY+1
