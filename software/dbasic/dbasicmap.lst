0012BD  2  29 10                AND     #%00010000      ; IS TX READY
0012BF  2  F0 F9                BEQ     WRSER1a         ; NO, WAIT FOR IT
0012C1  2  68                   PLA
0012C2  2  8D 84 EF             STA     UART1DATA       ; WRITE DATA
0012C5  2  60                   RTS
