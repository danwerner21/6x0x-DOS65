001E70  3  29 F0                AND     #$F0
001E72  3  4A                   LSR     A
001E73  3  4A                   LSR     A
001E74  3  4A                   LSR     A
001E75  3  4A                   LSR     A
001E76  3  18                   CLC
001E77  3  69 FA                ADC     #$02+VIDEOBANK  ; AREA $2000-?
001E79  3  C9 F8                CMP     #$F8
001E7B  3  90 32                BCC     V_PLOT_HIRES_COLOR_RANGE1
001E7D  3  A8                   TAY                     ; VIDEO BANK SHOULD BE IN Y
