00133F  3  A9 00                LDA     #$00
001341  3  8D 40 14             STA     NullCounter
001344  3  20 FC 13             JSR     DOS65FCBPREP    ; parse parameters into FCB
001347  3  B0 1F                BCS     DOS65LOAD_ERR1  ; Error?, if so abort
001349  3  A2 0D                LDX     #13             ;
00134B  3  20 83 12             JSR     PEM             ;
00134E  3  A9 00                LDA     #0              ; clear
001350  3  8D B7 16             STA     FCB+32          ; record number
001353  3  A9 97                LDA     #<FCB           ; Open File
001355  3  A0 16                LDY     #>FCB           ;
001357  3  A2 0F                LDX     #15             ;
001359  3  20 83 12             JSR     PEM             ;
00135C  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
00135E  3  D0 0B                BNE     DOS65LOAD_1     ;
001360  3               DOS65LOAD_ERR:
001360  3  A2 26                LDX     #$26            ; IO ERROR
001362  3  20 E2 1F             JSR     LAB_XERR
001365  3  4C BA 20             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001368  3               DOS65LOAD_ERR1:
001368  3  4C C8 25             JMP     LAB_REM         ; comment out the remainder of the line (if any)
00136B  3               DOS65LOAD_1:
00136B  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
00136D  3  85 22                STA     FCBPTR+2        ; point to base of RAM
00136F  3  8D 3E 14             STA     EndOfBas        ;
001372  3  A5 7A                LDA     <Smemh          ;
001374  3  85 23                STA     FCBPTR+3        ;
001376  3  8D 3F 14             STA     EndOfBas+1      ;
001379  3  A9 52                LDA     #<FCBBUFFER     ; SETUP BUFFER
00137B  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
00137D  3  A0 3F                LDY     #>FCBBUFFER     ;
00137F  3  84 21                STY     FCBPTR+1        ; STORE DEST BUFFER IN FCBPTR
001381  3  A2 1A                LDX     #26             ; Setup Buffer
001383  3  20 83 12             JSR     PEM             ;
001386  3  4C C4 13             JMP     DOS65LOAD_3C
001389  3               DOS65LOAD_3:
001389  3  B1 20                LDA     (FCBPTR),Y      ; load from BUFFER
00138B  3  91 22                STA     (FCBPTR+2),Y    ; save to RAM
00138D  3  EE 3E 14             INC     EndOfBas
001390  3  D0 03                BNE     :+
001392  3  EE 3F 14             INC     EndOfBas+1
001395  3               :
001395  3  C9 00                CMP     #$00
001397  3  D0 0D                BNE     :+
001399  3  EE 40 14             INC     NullCounter
00139C  3  AD 40 14             LDA     NullCounter
00139F  3  C9 03                CMP     #3
0013A1  3  D0 08                BNE     :++
0013A3  3  4C D7 13             JMP     DOS65LOAD_4
0013A6  3               :
0013A6  3  A9 00                LDA     #$00
0013A8  3  8D 40 14             STA     NullCounter
0013AB  3               :
0013AB  3  C8                   INY                     ; bump index
0013AC  3  C0 80                CPY     #$80            ; end of buffer?
0013AE  3  D0 D9                BNE     DOS65LOAD_3     ; no, loop
0013B0  3  18                   CLC                     ;
0013B1  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
0013B3  3  69 80                ADC     #$80            ;
0013B5  3  85 22                STA     FCBPTR+2        ;
0013B7  3  90 0B                BCC     DOS65LOAD_3C    ; is carry?, no SKIP
0013B9  3  18                   CLC                     ; yes, carry, inc high byte
0013BA  3  A5 23                LDA     FCBPTR+3        ;
0013BC  3  69 01                ADC     #$01            ;
0013BE  3  85 23                STA     FCBPTR+3        ;
0013C0  3  C9 B8                CMP     #>Ram_top       ; are we at the end of RAM?
0013C2  3  F0 13                BEQ     DOS65LOAD_4
0013C4  3               
0013C4  3               DOS65LOAD_3C:
0013C4  3  A9 97                LDA     #<FCB           ; READ record buffer from disk file
0013C6  3  A0 16                LDY     #>FCB           ;
0013C8  3  A2 14                LDX     #20             ;
0013CA  3  20 83 12             JSR     PEM             ;
0013CD  3  A0 00                LDY     #$00            ; RESET INDEX
0013CF  3  C9 00                CMP     #$00            ; is error or EOF
0013D1  3  F0 B6                BEQ     DOS65LOAD_3     ;
0013D3  3  C9 01                CMP     #$01            ; EOF?
0013D5  3  D0 89                BNE     DOS65LOAD_ERR   ; ERROR, do error handling
0013D7  3               DOS65LOAD_4:
0013D7  3  A9 97                LDA     #<FCB           ;
0013D9  3  A0 16                LDY     #>FCB           ;
0013DB  3  A2 10                LDX     #16             ;
0013DD  3  20 83 12             JSR     PEM             ;
0013E0  3                                               ; setup pointers to return to basic
0013E0  3  AD 3E 14             LDA     EndOfBas
0013E3  3  85 7B                STA     Svarl
0013E5  3  85 7D                STA     Sarryl
0013E7  3  85 7F                STA     Earryl
0013E9  3  AD 3F 14             LDA     EndOfBas+1
0013EC  3  85 7C                STA     Svarh
0013EE  3  85 7E                STA     Sarryh
0013F0  3  85 80                STA     Earryh
0013F2  3  A9 5A                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
0013F4  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
0013F6  3  20 6F 27             JSR     LAB_18C3
0013F9  3  4C BA 20             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
