0011E8  2                                               ; TEMPW  = Y*8 + Y*32  (Y*40)
0011E8  2  18                   CLC                     ; Clear the Carry flag before the first addition
0011E9  2  AD 0C 17             LDA     PTEMPW          ; Load the low byte of the first number into the accumulator
0011EC  2  6D 0E 17             ADC     PTEMPW1         ; Add the low byte of the second number (plus carry)
0011EF  2  85 FD                STA     TEMPW           ; Store the low byte of the result
0011F1  2  AD 0D 17             LDA     PTEMPW+1        ; Load the high byte of the first number
0011F4  2  6D 0F 17             ADC     PTEMPW1+1       ; Add the high byte of the second number (plus carry from previous op)
0011F7  2  85 FE                STA     TEMPW+1         ; Store the high byte of the result
