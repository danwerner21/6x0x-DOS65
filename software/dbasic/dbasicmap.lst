001A3D  3  20 6F 33             JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
001A40  3                                               ; FIGURE THE BUFFER OFFSET
001A40  3  8A                   TXA                     ; Y COORD IN X
001A41  3  48                   PHA
001A42  3  4A                   LSR     A               ; 2 LINES PER BYTE
001A43  3  8D 0E 17             STA     PTEMPW1
001A46  3                                               ; MULTIPLY Y (PTEMPW) COORD BY 40 OR 80 (SINGLE OR DOUBLE LORES)
001A46  3  18                   CLC
001A47  3  0E 0E 17             ASL     PTEMPW1
001A4A  3  2E 0F 17             ROL     PTEMPW1+1       ; *2
001A4D  3  0E 0E 17             ASL     PTEMPW1
001A50  3  2E 0F 17             ROL     PTEMPW1+1       ; *2 (*4)
001A53  3  0E 0E 17             ASL     PTEMPW1
001A56  3  2E 0F 17             ROL     PTEMPW1+1       ; *2 (*8)
001A59  3  AD 0E 17             LDA     PTEMPW1
001A5C  3  8D 10 17             STA     PTEMPW2
001A5F  3  AD 0F 17             LDA     PTEMPW1+1
001A62  3  8D 11 17             STA     PTEMPW2+1       ; STORE Y*8 INTO PTEMPW2
001A65  3  0E 0E 17             ASL     PTEMPW1
001A68  3  2E 0F 17             ROL     PTEMPW1+1       ; *2 (*16)
001A6B  3  0E 0E 17             ASL     PTEMPW1
