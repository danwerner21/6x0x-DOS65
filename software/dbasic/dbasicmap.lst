0015C6  3  20 0E 2D             JSR     LAB_CTST        ; check if source is string, else do type mismatch
0015C9  3  A0 02                LDY     #$02            ; index to string pointer high byte
0015CB  3  B1 95                LDAINDIRECTY Cvaral     ; get string pointer high byte
0015CD  3  85 FE                STA     TEMPW+1         ; set string pointer high byte
0015CF  3  88                   DEY                     ; index to string pointer low byte
0015D0  3  B1 95                LDAINDIRECTY Cvaral     ; get string pointer low byte
0015D2  3  85 FD                STA     TEMPW           ; set string pointer low byte
0015D4  3  A2 10                LDX     #16             ; CLOSE
0015D6  3  A5 FD                LDA     TEMPW           ; FCB
0015D8  3  A4 FE                LDY     TEMPW+1         ; FCB
0015DA  3  20 A7 12             JSR     PEM
0015DD  3  C9 FF                CMP     #$FF
0015DF  3  D0 08                BNE     :+
0015E1  3  A2 24                LDX     #$24            ; IO ERROR
0015E3  3  20 77 23             JSR     LAB_XERR
