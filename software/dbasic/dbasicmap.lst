00120C  2  8E 7A 12             STX     TTX
00120F  2  8C 7B 12             STY     TTY
001212  2  8D 7C 12             STA     TTA
001215  2  A9 0D                LDA     #13
001217  2  20 7D 12             JSR     WRSER1          ; output upper nybble
00121A  2  A9 0A                LDA     #10
00121C  2  20 7D 12             JSR     WRSER1          ; output upper nybble
00121F  2  AE 7A 12             LDX     TTX
001222  2  AC 7B 12             LDY     TTY
001225  2  AD 7C 12             LDA     TTA
001228  2  60                   RTS
001229  2               
001229  2               PRINT_SPACE:
001229  2  8E 7A 12             STX     TTX
00122C  2  8C 7B 12             STY     TTY
00122F  2  8D 7C 12             STA     TTA
001232  2  A9 20                LDA     #32
001234  2  20 7D 12             JSR     WRSER1          ; output upper nybble
001237  2  AE 7A 12             LDX     TTX
00123A  2  AC 7B 12             LDY     TTY
00123D  2  AD 7C 12             LDA     TTA
001240  2  60                   RTS
001241  2               
001241  2               
001241  2               PRINT_BYTE:
001241  2  8E 7A 12             STX     TTX
001244  2  8C 7B 12             STY     TTY
001247  2  8D 7C 12             STA     TTA
00124A  2  8E 79 12             STX     SAVX            ; save X
00124D  2  20 64 12             JSR     ASCTWO          ; get hex chars for byte in X (lower) and A (upper)
001250  2  20 7D 12             JSR     WRSER1          ; output upper nybble
001253  2  8A                   TXA                     ; transfer lower to A
001254  2  AE 79 12             LDX     SAVX            ; restore X
001257  2  20 7D 12             JSR     WRSER1          ; output lower nybble
00125A  2  AE 7A 12             LDX     TTX
00125D  2  AC 7B 12             LDY     TTY
001260  2  AD 7C 12             LDA     TTA
001263  2  60                   RTS
001264  2               ASCTWO:
001264  2  48                   PHA                     ; save byte
001265  2  20 6E 12             JSR     ASCII           ; do low nybble
001268  2  AA                   TAX                     ; save in X
001269  2  68                   PLA                     ; restore byte
00126A  2  4A                   LSR     A               ; shift upper nybble down
00126B  2  4A                   LSR     A
00126C  2  4A                   LSR     A
00126D  2  4A                   LSR     A
00126E  2               ; convert low nybble in A to hex digit
00126E  2               ASCII:
00126E  2  29 0F                AND     #$0F            ; clear upper nibble
001270  2  C9 0A                CMP     #$0A            ; if less than A, skip next step
001272  2  90 02                BCC     ASC1
001274  2  69 06                ADC     #6              ; skip ascii chars between 9 and A
001276  2               ASC1:
001276  2  69 30                ADC     #$30            ; add ascii char 0 to value
001278  2  60                   RTS
001279  2               SAVX:
001279  2  00                   .BYTE   00
00127A  2               TTX:
00127A  2  00                   .BYTE   00
00127B  2               TTY:
00127B  2  00                   .BYTE   00
00127C  2               TTA:
00127C  2  00                   .BYTE   00
