001295  3               ;___SAVE____________________________________________________
001295  3               ;
001295  3               ; SAVE COMMAND
001295  3               ;
001295  3               ;  SAVE THE BASIC PROGRAM IN MEMORY TO DISK
001295  3               ;
001295  3               ;__________________________________________________________
001295  3               V_SAVE: ; save BASIC program
001295  3               DOS65SAVE:
001295  3  20 08 14             JSR     DOS65FCBPREP    ; parse parameters into FCB
001298  3  B0 28                BCS     DOS65SAVE_ERR1  ; Error?, if so abort
00129A  3  A2 0D                LDX     #13             ;
00129C  3  20 8F 12             JSR     PEM             ;
00129F  3  A9 A3                LDA     #<FCB           ; CREATE File
0012A1  3  A0 16                LDY     #>FCB           ;
0012A3  3  A2 16                LDX     #22             ;
0012A5  3  20 8F 12             JSR     PEM             ;
0012A8  3  A9 00                LDA     #0              ; clear
0012AA  3  8D C3 16             STA     FCB+32          ; record number
0012AD  3  A9 A3                LDA     #<FCB           ; Open File
0012AF  3  A0 16                LDY     #>FCB           ;
0012B1  3  A2 0F                LDX     #15             ;
0012B3  3  20 8F 12             JSR     PEM             ;
0012B6  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
0012B8  3  D0 0B                BNE     DOS65SAVE_1     ;
0012BA  3               DOS65SAVE_ERR:
0012BA  3  A2 24                LDX     #$24            ; IO ERROR
0012BC  3  20 DC 21             JSR     LAB_XERR
0012BF  3  4C B4 22             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
0012C2  3               DOS65SAVE_ERR1:
0012C2  3  4C C2 27             JMP     LAB_REM         ; comment out the remainder of the line (if any)
0012C5  3               DOS65SAVE_1:
0012C5  3  A9 4C                LDA     #<FCBBUFFER     ; SETUP BUFFER
0012C7  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
0012C9  3  A0 41                LDY     #>FCBBUFFER     ;
0012CB  3  84 21                STY     FCBPTR+1        ;
0012CD  3  A2 1A                LDX     #26             ; Setup Buffer
0012CF  3  20 8F 12             JSR     PEM             ;
0012D2  3               DOS65SAVE_2:
0012D2  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
0012D4  3  85 22                STA     FCBPTR+2        ; point to base of RAM
0012D6  3  A5 7A                LDA     <Smemh          ;
0012D8  3  85 23                STA     FCBPTR+3        ;
0012DA  3  A2 00                LDX     #$00            ; x=0 (null counter)
0012DC  3               DOS65SAVE_2A:
0012DC  3  A0 00                LDY     #$00            ; y=0 (Loop Index)
0012DE  3               DOS65SAVE_3:
0012DE  3  B1 22                LDA     (FCBPTR+2),Y    ; load from RAM
0012E0  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
0012E2  3  C9 00                CMP     #$00            ; is Zero?
0012E4  3  D0 1E                BNE     DOS65SAVE_3A    ; No, continue
0012E6  3  E8                   INX                     ; yes, bump Null Counter
0012E7  3  E0 03                CPX     #$03            ; Three nulls in a row?
0012E9  3  D0 1B                BNE     DOS65SAVE_3B    ; No, continue
0012EB  3                                               ; FINISH FILLING BUFFER WITH NULLS
0012EB  3               :
0012EB  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
0012ED  3  C8                   INY                     ; bump index
0012EE  3  C0 80                CPY     #$80            ; end of buffer?
0012F0  3  D0 F9                BNE     :-              ; no, loop
0012F2  3  A9 A3                LDA     #<FCB           ; Write record in buffer to disk file AND END
0012F4  3  A0 16                LDY     #>FCB           ;
0012F6  3  A2 15                LDX     #21             ;
0012F8  3  20 8F 12             JSR     PEM             ;
0012FB  3  29 FE                AND     #$FE            ; strip out extension
0012FD  3  C9 00                CMP     #$00            ; is error
0012FF  3  D0 B9                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
001301  3  4C 31 13             JMP     DOS65SAVE_4
001304  3               DOS65SAVE_3A:                   ;
001304  3  A2 00                LDX     #$00            ; prior char not null, reset null counter
001306  3               DOS65SAVE_3B:                   ;
001306  3  C8                   INY                     ; bump index
001307  3  C0 80                CPY     #$80            ; end of buffer?
001309  3  D0 D3                BNE     DOS65SAVE_3     ; no, loop
00130B  3               DOS65SAVE_3C:
00130B  3  A9 A3                LDA     #<FCB           ; Write record in buffer to disk file
00130D  3  A0 16                LDY     #>FCB           ;
00130F  3  A2 15                LDX     #21             ;
001311  3  20 8F 12             JSR     PEM             ;
001314  3  29 FE                AND     #$FE            ; strip out extension
001316  3  C9 00                CMP     #$00            ; is error
001318  3  D0 A0                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
00131A  3  18                   CLC                     ;
00131B  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
00131D  3  69 80                ADC     #$80            ;
00131F  3  85 22                STA     FCBPTR+2        ;
001321  3  90 B9                BCC     DOS65SAVE_2A    ; is carry?, no loop
001323  3  18                   CLC                     ; yes, carry, inc high byte
001324  3  A5 23                LDA     FCBPTR+3        ;
001326  3  69 01                ADC     #$01            ;
001328  3  85 23                STA     FCBPTR+3        ;
00132A  3  C9 B8                CMP     #>Ram_top       ; are we at the end of RAM?
00132C  3  F0 03                BEQ     DOS65SAVE_4
00132E  3  4C DC 12             JMP     DOS65SAVE_2A
001331  3               DOS65SAVE_4:
001331  3  A9 A3                LDA     #<FCB           ;
001333  3  A0 16                LDY     #>FCB           ;
001335  3  A2 10                LDX     #16             ;
001337  3  20 8F 12             JSR     PEM             ;
00133A  3  C9 FF                CMP     #$FF            ;
00133C  3  D0 03                BNE     DOS65SAVE_5     ;
00133E  3  4C BA 12             JMP     DOS65SAVE_ERR   ; ERROR, DISPLAY IT
001341  3               DOS65SAVE_5:
001341  3  A9 66                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
001343  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
001345  3  20 69 29             JSR     LAB_18C3
001348  3  4C B4 22             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
00134B  3               
00134B  3               ;___LOAD____________________________________________________
00134B  3               ;
00134B  3               ; LOAD COMMAND
00134B  3               ;
00134B  3               ;  LOAD A BASIC PROGRAM FROM DISK TO MEMORY
00134B  3               ;
00134B  3               ;__________________________________________________________
00134B  3               V_LOAD: ; load BASIC program
00134B  3               DOS65LOAD:
00134B  3  A9 00                LDA     #$00
00134D  3  8D 4C 14             STA     NullCounter
001350  3  20 08 14             JSR     DOS65FCBPREP    ; parse parameters into FCB
001353  3  B0 1F                BCS     DOS65LOAD_ERR1  ; Error?, if so abort
001355  3  A2 0D                LDX     #13             ;
001357  3  20 8F 12             JSR     PEM             ;
00135A  3  A9 00                LDA     #0              ; clear
00135C  3  8D C3 16             STA     FCB+32          ; record number
00135F  3  A9 A3                LDA     #<FCB           ; Open File
001361  3  A0 16                LDY     #>FCB           ;
001363  3  A2 0F                LDX     #15             ;
001365  3  20 8F 12             JSR     PEM             ;
001368  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
00136A  3  D0 0B                BNE     DOS65LOAD_1     ;
00136C  3               DOS65LOAD_ERR:
00136C  3  A2 26                LDX     #$26            ; IO ERROR
00136E  3  20 DC 21             JSR     LAB_XERR
001371  3  4C B4 22             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001374  3               DOS65LOAD_ERR1:
001374  3  4C C2 27             JMP     LAB_REM         ; comment out the remainder of the line (if any)
001377  3               DOS65LOAD_1:
001377  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
001379  3  85 22                STA     FCBPTR+2        ; point to base of RAM
00137B  3  8D 4A 14             STA     EndOfBas        ;
00137E  3  A5 7A                LDA     <Smemh          ;
001380  3  85 23                STA     FCBPTR+3        ;
001382  3  8D 4B 14             STA     EndOfBas+1      ;
001385  3  A9 4C                LDA     #<FCBBUFFER     ; SETUP BUFFER
001387  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
001389  3  A0 41                LDY     #>FCBBUFFER     ;
00138B  3  84 21                STY     FCBPTR+1        ; STORE DEST BUFFER IN FCBPTR
00138D  3  A2 1A                LDX     #26             ; Setup Buffer
00138F  3  20 8F 12             JSR     PEM             ;
001392  3  4C D0 13             JMP     DOS65LOAD_3C
001395  3               DOS65LOAD_3:
001395  3  B1 20                LDA     (FCBPTR),Y      ; load from BUFFER
001397  3  91 22                STA     (FCBPTR+2),Y    ; save to RAM
001399  3  EE 4A 14             INC     EndOfBas
00139C  3  D0 03                BNE     :+
00139E  3  EE 4B 14             INC     EndOfBas+1
0013A1  3               :
0013A1  3  C9 00                CMP     #$00
0013A3  3  D0 0D                BNE     :+
0013A5  3  EE 4C 14             INC     NullCounter
0013A8  3  AD 4C 14             LDA     NullCounter
0013AB  3  C9 03                CMP     #3
0013AD  3  D0 08                BNE     :++
0013AF  3  4C E3 13             JMP     DOS65LOAD_4
0013B2  3               :
0013B2  3  A9 00                LDA     #$00
0013B4  3  8D 4C 14             STA     NullCounter
0013B7  3               :
0013B7  3  C8                   INY                     ; bump index
0013B8  3  C0 80                CPY     #$80            ; end of buffer?
0013BA  3  D0 D9                BNE     DOS65LOAD_3     ; no, loop
0013BC  3  18                   CLC                     ;
0013BD  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
0013BF  3  69 80                ADC     #$80            ;
0013C1  3  85 22                STA     FCBPTR+2        ;
0013C3  3  90 0B                BCC     DOS65LOAD_3C    ; is carry?, no SKIP
0013C5  3  18                   CLC                     ; yes, carry, inc high byte
0013C6  3  A5 23                LDA     FCBPTR+3        ;
0013C8  3  69 01                ADC     #$01            ;
0013CA  3  85 23                STA     FCBPTR+3        ;
0013CC  3  C9 B8                CMP     #>Ram_top       ; are we at the end of RAM?
0013CE  3  F0 13                BEQ     DOS65LOAD_4
0013D0  3               
0013D0  3               DOS65LOAD_3C:
0013D0  3  A9 A3                LDA     #<FCB           ; READ record buffer from disk file
0013D2  3  A0 16                LDY     #>FCB           ;
0013D4  3  A2 14                LDX     #20             ;
0013D6  3  20 8F 12             JSR     PEM             ;
0013D9  3  A0 00                LDY     #$00            ; RESET INDEX
0013DB  3  C9 00                CMP     #$00            ; is error or EOF
0013DD  3  F0 B6                BEQ     DOS65LOAD_3     ;
0013DF  3  C9 01                CMP     #$01            ; EOF?
0013E1  3  D0 89                BNE     DOS65LOAD_ERR   ; ERROR, do error handling
0013E3  3               DOS65LOAD_4:
0013E3  3  A9 A3                LDA     #<FCB           ;
0013E5  3  A0 16                LDY     #>FCB           ;
0013E7  3  A2 10                LDX     #16             ;
0013E9  3  20 8F 12             JSR     PEM             ;
0013EC  3                                               ; setup pointers to return to basic
0013EC  3  AD 4A 14             LDA     EndOfBas
0013EF  3  85 7B                STA     Svarl
0013F1  3  85 7D                STA     Sarryl
0013F3  3  85 7F                STA     Earryl
0013F5  3  AD 4B 14             LDA     EndOfBas+1
0013F8  3  85 7C                STA     Svarh
0013FA  3  85 7E                STA     Sarryh
0013FC  3  85 80                STA     Earryh
0013FE  3  A9 66                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
001400  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
001402  3  20 69 29             JSR     LAB_18C3
001405  3  4C B4 22             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001408  3               
001408  3               
001408  3               
001408  3               DOS65FCBPREP:
001408  3                       .IFDEF  DUODYNE
001408  3                       JSL     LAB_GBYT        ; scan memory
001408  3                       .ELSE
001408  3  20 C2 00             JSR     LAB_GBYT        ; scan memory
00140B  3                       .ENDIF
00140B  3               
00140B  3  38                   SEC                     ;
00140C  3  E9 40                SBC     #64             ; PARSE DRIVE NUMBER
00140E  3  8D A3 16             STA     DOSDRIVE        ; STORE IT IN FCB
001411  3                       .IFDEF  DUODYNE
001411  3                       JSL     LAB_IGBY        ; increment and scan memory
001411  3                       .ELSE
001411  3  20 BC 00             JSR     LAB_IGBY        ; increment and scan memory
001414  3                       .ENDIF
001414  3               
001414  3  C9 3A                CMP     #':'            ;
001416  3  F0 08                BEQ     DOS65FCBPREP_1  ; YES, IT WAS A DRIVE, CONTINUE
001418  3  A2 26                LDX     #$26            ; IO ERROR
00141A  3  20 DC 21             JSR     LAB_XERR
00141D  3  4C B4 22             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001420  3               
001420  3               DOS65FCBPREP_1:
001420  3  A9 A3                LDA     #<FCB           ; SETUP FCBPTR
001422  3  85 20                STA     FCBPTR          ;
001424  3  A9 16                LDA     #>FCB           ;
001426  3  85 21                STA     FCBPTR+1        ;
001428  3  A0 01                LDY     #$01            ; POINT Y TO FCB FILE NAME
00142A  3  A9 20                LDA     #$20            ; LOAD SPACE CHAR INTO A
00142C  3               DOS65FCBPREP_1A:                ; BLANK OUT FCB
00142C  3  91 20                STAINDIRECTY FCBPTR     ;
00142E  3  C8                   INY                     ;
00142F  3  C0 09                CPY     #$09            ; IS DONE
001431  3  D0 F9                BNE     DOS65FCBPREP_1A ; NO, LOOP
001433  3  A0 01                LDY     #$01            ; POINT Y TO FCB FILE NAME
001435  3               DOS65FCBPREP_2:                 ; COPY FILE NAME PARAMETER INTO FCB
001435  3                       .IFDEF  DUODYNE
001435  3                       JSL     LAB_IGBY        ; increment and scan memory
001435  3                       .ELSE
001435  3  20 BC 00             JSR     LAB_IGBY        ; increment and scan memory
001438  3                       .ENDIF
001438  3  F0 0E                BEQ     DOS65FCBPREP_3  ;
00143A  3  C9 2E                CMP     #'.'
00143C  3  F0 0A                BEQ     DOS65FCBPREP_3  ;
00143E  3  91 20                STAINDIRECTY FCBPTR     ;
001440  3  C8                   INY                     ;
001441  3  C0 09                CPY     #$09            ;
001443  3  F0 03                BEQ     DOS65FCBPREP_3  ;
001445  3  4C 35 14             JMP     DOS65FCBPREP_2  ;
001448  3               DOS65FCBPREP_3:                 ;
001448  3  18                   CLC
001449  3  60                   RTS                     ;
