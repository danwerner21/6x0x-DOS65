000D2E  1               ; DEFINITIONS
000D2E  1                       .INCLUDE "definitions.asm"
000D2E  2                       .IFDEF  DUODYNE
000D2E  2               STACK_BOTTOM    = $4000         ; stack bottom, no offset
000D2E  2               STACK           = $5FFF         ; stack top, no offset
000D2E  2               Ram_top         = $D000         ; end of user RAM+1 (set as needed, should be page aligned)
000D2E  2                       .ELSE
000D2E  2               Ram_top         = $B800         ; end of user RAM+1 (set as needed, should be page aligned)
000D2E  2                       .ENDIF
000D2E  2               
000D2E  2               
000D2E  2               ; offsets from a base of X or Y
000D2E  2               PLUS_0          = $00           ; X or Y plus 0
000D2E  2               PLUS_1          = $01           ; X or Y plus 1
000D2E  2               PLUS_2          = $02           ; X or Y plus 2
000D2E  2               PLUS_3          = $03           ; X or Y plus 3
000D2E  2               
000D2E  2               LAB_STAK        = $0100         ; stack bottom, no offset
000D2E  2               
000D2E  2               LAB_SKFE        = LAB_STAK+$FE
000D2E  2               ; flushed stack address
000D2E  2               LAB_SKFF        = LAB_STAK+$FF
000D2E  2               ; flushed stack address
000D2E  2               
000D2E  2               ccflag          = $0600         ; BASIC CTRL-C flag, 00 = enabled, 01 = dis
000D2E  2               ccbyte          = ccflag+1      ; BASIC CTRL-C byte
000D2E  2               ccnull          = ccbyte+1      ; BASIC CTRL-C byte timeout
000D2E  2               
000D2E  2               VEC_CC          = ccnull+1      ; ctrl c check vector
000D2E  2               
000D2E  2               ; Ibuffs can now be anywhere in RAM AS LONG AS IT IS BEFORE RAM_BASE AND IS NOT PAGE ALIGNED!, ensure that the max length is < $80
000D2E  2               Ibuffs          = (ENDOFBASIC&$FF00)+$181
000D2E  2               Ibuffe          = Ibuffs+80     ; end of input buffer
000D2E  2               Ram_base        = (Ibuffe&$FF00)+$100; start of user RAM (set as needed, should be page aligned)
000D2E  2               
