001248  2               PRINT_CRLF:
001248  2  8E B6 12             STX     TTX
00124B  2  8C B7 12             STY     TTY
00124E  2  8D B8 12             STA     TTA
001251  2  A9 0D                LDA     #13
001253  2  20 B9 12             JSR     WRSER1          ; output upper nybble
001256  2  A9 0A                LDA     #10
001258  2  20 B9 12             JSR     WRSER1          ; output upper nybble
00125B  2  AE B6 12             LDX     TTX
00125E  2  AC B7 12             LDY     TTY
001261  2  AD B8 12             LDA     TTA
001264  2  60                   RTS
001265  2               
001265  2               PRINT_SPACE:
001265  2  8E B6 12             STX     TTX
001268  2  8C B7 12             STY     TTY
00126B  2  8D B8 12             STA     TTA
00126E  2  A9 20                LDA     #32
001270  2  20 B9 12             JSR     WRSER1          ; output upper nybble
001273  2  AE B6 12             LDX     TTX
001276  2  AC B7 12             LDY     TTY
001279  2  AD B8 12             LDA     TTA
00127C  2  60                   RTS
00127D  2               
00127D  2               
00127D  2               PRINT_BYTE:
00127D  2  8E B6 12             STX     TTX
001280  2  8C B7 12             STY     TTY
001283  2  8D B8 12             STA     TTA
001286  2  8E B5 12             STX     SAVX            ; save X
001289  2  20 A0 12             JSR     ASCTWO          ; get hex chars for byte in X (lower) and A (upper)
00128C  2  20 B9 12             JSR     WRSER1          ; output upper nybble
00128F  2  8A                   TXA                     ; transfer lower to A
001290  2  AE B5 12             LDX     SAVX            ; restore X
001293  2  20 B9 12             JSR     WRSER1          ; output lower nybble
001296  2  AE B6 12             LDX     TTX
001299  2  AC B7 12             LDY     TTY
00129C  2  AD B8 12             LDA     TTA
00129F  2  60                   RTS
0012A0  2               ASCTWO:
0012A0  2  48                   PHA                     ; save byte
0012A1  2  20 AA 12             JSR     ASCII           ; do low nybble
0012A4  2  AA                   TAX                     ; save in X
0012A5  2  68                   PLA                     ; restore byte
0012A6  2  4A                   LSR     A               ; shift upper nybble down
0012A7  2  4A                   LSR     A
0012A8  2  4A                   LSR     A
0012A9  2  4A                   LSR     A
0012AA  2               ; convert low nybble in A to hex digit
0012AA  2               ASCII:
0012AA  2  29 0F                AND     #$0F            ; clear upper nibble
0012AC  2  C9 0A                CMP     #$0A            ; if less than A, skip next step
0012AE  2  90 02                BCC     ASC1
0012B0  2  69 06                ADC     #6              ; skip ascii chars between 9 and A
0012B2  2               ASC1:
0012B2  2  69 30                ADC     #$30            ; add ascii char 0 to value
0012B4  2  60                   RTS
0012B5  2               SAVX:
0012B5  2  00                   .BYTE   00
0012B6  2               TTX:
0012B6  2  00                   .BYTE   00
0012B7  2               TTY:
0012B7  2  00                   .BYTE   00
0012B8  2               TTA:
0012B8  2  00                   .BYTE   00
