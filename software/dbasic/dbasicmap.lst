0011A7  2                                               ; TEMPW  = Y*8 + Y*32  (Y*40)
0011A7  2  18                   CLC                     ; Clear the Carry flag before the first addition
0011A8  2  AD DC 16             LDA     PTEMPW          ; Load the low byte of the first number into the accumulator
0011AB  2  6D DE 16             ADC     PTEMPW1         ; Add the low byte of the second number (plus carry)
