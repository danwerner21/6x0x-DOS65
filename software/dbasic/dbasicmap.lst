00122D  2               GETVIDEOADDRESS:
00122D  2  AC 48 06             LDY     CURY
001230  2               
001230  2  8C 17 19             STY     PTEMPW
001233  2  A9 00                LDA     #0
001235  2  8D 18 19             STA     PTEMPW+1
001238  2  18                   CLC
001239  2  0E 17 19             ASL     PTEMPW
00123C  2  2E 18 19             ROL     PTEMPW+1        ; *2
00123F  2  0E 17 19             ASL     PTEMPW
001242  2  2E 18 19             ROL     PTEMPW+1        ; *4
001245  2  0E 17 19             ASL     PTEMPW
001248  2  2E 18 19             ROL     PTEMPW+1        ; *8
00124B  2  AD 17 19             LDA     PTEMPW
00124E  2  8D 19 19             STA     PTEMPW1
001251  2  AD 18 19             LDA     PTEMPW+1
001254  2  8D 1A 19             STA     PTEMPW1+1       ; PTEMPW1=Y*8
001257  2  0E 17 19             ASL     PTEMPW
00125A  2  2E 18 19             ROL     PTEMPW+1        ; *16
00125D  2  0E 17 19             ASL     PTEMPW
001260  2  2E 18 19             ROL     PTEMPW+1        ; *32
001263  2                                               ; TEMPW  = Y*8 + Y*32  (Y*40)
001263  2  18                   CLC                     ; Clear the Carry flag before the first addition
001264  2  AD 17 19             LDA     PTEMPW          ; Load the low byte of the first number into the accumulator
001267  2  6D 19 19             ADC     PTEMPW1         ; Add the low byte of the second number (plus carry)
00126A  2  85 FD                STA     TEMPW           ; Store the low byte of the result
00126C  2  AD 18 19             LDA     PTEMPW+1        ; Load the high byte of the first number
00126F  2  6D 1A 19             ADC     PTEMPW1+1       ; Add the high byte of the second number (plus carry from previous op)
001272  2  85 FE                STA     TEMPW+1         ; Store the high byte of the result
001274  2               
001274  2  AD 04 19             LDA     VIDEOWIDTH      ; If 80 col, double again
001277  2  C9 50                CMP     #80
001279  2  D0 04                BNE     :+
00127B  2  06 FD                ASL     TEMPW
00127D  2  26 FE                ROL     TEMPW+1         ; *2  (80)
00127F  2               :
00127F  2  A5 FE                LDA     TEMPW+1
001281  2  09 A0                ORA     #$A0            ; add in the bank#
001283  2  85 FE                STA     TEMPW+1
001285  2  60                   RTS
