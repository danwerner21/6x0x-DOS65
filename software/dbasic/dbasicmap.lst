0012DB  2               
0012DB  2               
0012DB  2               PRINT_BYTE:
0012DB  2  8E 14 13             STX     TTX
0012DE  2  8C 15 13             STY     TTY
0012E1  2  8D 16 13             STA     TTA
0012E4  2  8E 13 13             STX     SAVX            ; save X
0012E7  2  20 FE 12             JSR     ASCTWO          ; get hex chars for byte in X (lower) and A (upper)
0012EA  2  20 17 13             JSR     WRSER1          ; output upper nybble
0012ED  2  8A                   TXA                     ; transfer lower to A
0012EE  2  AE 13 13             LDX     SAVX            ; restore X
0012F1  2  20 17 13             JSR     WRSER1          ; output lower nybble
0012F4  2  AE 14 13             LDX     TTX
0012F7  2  AC 15 13             LDY     TTY
0012FA  2  AD 16 13             LDA     TTA
0012FD  2  60                   RTS
0012FE  2               ASCTWO:
0012FE  2  48                   PHA                     ; save byte
0012FF  2  20 08 13             JSR     ASCII           ; do low nybble
001302  2  AA                   TAX                     ; save in X
001303  2  68                   PLA                     ; restore byte
001304  2  4A                   LSR     A               ; shift upper nybble down
001305  2  4A                   LSR     A
001306  2  4A                   LSR     A
001307  2  4A                   LSR     A
001308  2               ; convert low nybble in A to hex digit
001308  2               ASCII:
001308  2  29 0F                AND     #$0F            ; clear upper nibble
00130A  2  C9 0A                CMP     #$0A            ; if less than A, skip next step
00130C  2  90 02                BCC     ASC1
00130E  2  69 06                ADC     #6              ; skip ascii chars between 9 and A
001310  2               ASC1:
001310  2  69 30                ADC     #$30            ; add ascii char 0 to value
001312  2  60                   RTS
001313  2               SAVX:
001313  2  00                   .BYTE   00
001314  2               TTX:
001314  2  00                   .BYTE   00
001315  2               TTY:
