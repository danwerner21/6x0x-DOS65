0015AA  3  20 78 33             JSR     LAB_MSSP        ; make string space A bytes long A=$AC=length,
0015AD  3                                               ; X=$AD=<Sutill=ptr low byte, Y=$AE=<Sutilh=ptr high byte
0015AD  3                                               ; COPY FCB TO STRING
0015AD  3  A2 21                LDX     #33             ;
0015AF  3  A0 21                LDY     #33             ;
