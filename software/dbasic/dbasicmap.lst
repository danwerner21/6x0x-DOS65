001221  2  8E 8F 12             STX     TTX
001224  2  8C 90 12             STY     TTY
001227  2  8D 91 12             STA     TTA
00122A  2  A9 0D                LDA     #13
00122C  2  20 92 12             JSR     WRSER1          ; output upper nybble
00122F  2  A9 0A                LDA     #10
001231  2  20 92 12             JSR     WRSER1          ; output upper nybble
001234  2  AE 8F 12             LDX     TTX
001237  2  AC 90 12             LDY     TTY
00123A  2  AD 91 12             LDA     TTA
00123D  2  60                   RTS
00123E  2               
00123E  2               PRINT_SPACE:
00123E  2  8E 8F 12             STX     TTX
001241  2  8C 90 12             STY     TTY
001244  2  8D 91 12             STA     TTA
001247  2  A9 20                LDA     #32
001249  2  20 92 12             JSR     WRSER1          ; output upper nybble
00124C  2  AE 8F 12             LDX     TTX
00124F  2  AC 90 12             LDY     TTY
001252  2  AD 91 12             LDA     TTA
001255  2  60                   RTS
001256  2               
001256  2               
001256  2               PRINT_BYTE:
001256  2  8E 8F 12             STX     TTX
001259  2  8C 90 12             STY     TTY
00125C  2  8D 91 12             STA     TTA
00125F  2  8E 8E 12             STX     SAVX            ; save X
001262  2  20 79 12             JSR     ASCTWO          ; get hex chars for byte in X (lower) and A (upper)
001265  2  20 92 12             JSR     WRSER1          ; output upper nybble
001268  2  8A                   TXA                     ; transfer lower to A
001269  2  AE 8E 12             LDX     SAVX            ; restore X
00126C  2  20 92 12             JSR     WRSER1          ; output lower nybble
00126F  2  AE 8F 12             LDX     TTX
001272  2  AC 90 12             LDY     TTY
001275  2  AD 91 12             LDA     TTA
001278  2  60                   RTS
001279  2               ASCTWO:
001279  2  48                   PHA                     ; save byte
00127A  2  20 83 12             JSR     ASCII           ; do low nybble
00127D  2  AA                   TAX                     ; save in X
00127E  2  68                   PLA                     ; restore byte
00127F  2  4A                   LSR     A               ; shift upper nybble down
001280  2  4A                   LSR     A
001281  2  4A                   LSR     A
001282  2  4A                   LSR     A
001283  2               ; convert low nybble in A to hex digit
001283  2               ASCII:
001283  2  29 0F                AND     #$0F            ; clear upper nibble
001285  2  C9 0A                CMP     #$0A            ; if less than A, skip next step
001287  2  90 02                BCC     ASC1
001289  2  69 06                ADC     #6              ; skip ascii chars between 9 and A
00128B  2               ASC1:
00128B  2  69 30                ADC     #$30            ; add ascii char 0 to value
00128D  2  60                   RTS
00128E  2               SAVX:
00128E  2  00                   .BYTE   00
00128F  2               TTX:
00128F  2  00                   .BYTE   00
001290  2               TTY:
