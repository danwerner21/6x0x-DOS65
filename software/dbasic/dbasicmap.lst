001516  3               ;___OPEN____________________________________________________
001516  3               ;
001516  3               ; OPEN A FILE
001516  3               ;
001516  3               ;
001516  3               ; BASIC COMMAND EXPECTS FOUR VARS
001516  3               
001516  3               ; DRIVE,MODE, FILENAME$,FILE$
001516  3               ;
001516  3               ; FILE$ = STRING TO HOLD 33 BYTE FCB
001516  3               ; DRIVE = NUMERIC DRIVE -- 0=A, 1=B, 2= . . .
001516  3               ; MODE = 0=EXISTING, 1=CREATE
001516  3               ; FILENAME$ = FILENAME STRING
001516  3               ;__________________________________________________________
001516  3               V_OPEN:
001516  3               ; CLEAR FCB
001516  3  A9 00                LDA     #0              ; FILL WITH NULL
001518  3  A0 00                LDY     #0              ;
00151A  3               :
00151A  3  99 EE 16             STA     FCB,Y           ;
00151D  3  C8                   INY                     ;
00151E  3  C0 21                CPY     #33             ;
001520  3  D0 F8                BNE     :-              ;
001522  3                                               ;
001522  3  A9 20                LDA     #32             ; FILL FILENAME AND EXTENSION WITH SPACES
001524  3  A0 01                LDY     #1              ;
001526  3               :
001526  3  99 EE 16             STA     FCB,Y           ;
001529  3  C8                   INY                     ;
00152A  3  C0 0C                CPY     #12             ;
00152C  3  D0 F8                BNE     :-              ;
00152E  3                                               ;
