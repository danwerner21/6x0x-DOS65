001B5D  3  0E 0E 17             ASL     PTEMPW1
001B60  3  2E 0F 17             ROL     PTEMPW1+1       ; *2 (*64)
001B63  3                                               ; RESULT OFFSET PTEMPW1 = PTEMPW1(Y*64)+PTEMPW2(Y*2)+PTEMPW3(Y*4)
