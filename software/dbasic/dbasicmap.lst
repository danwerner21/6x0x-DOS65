001580  3  8A                   TXA
001581  3  8D C0 18             STA     FCB             ; STORE DRIVE IN FCB
001584  3                                               ;
001584  3  20 23 2F             JSR     LAB_1C01        ; (AFTER ',') OR SYN ERR
001587  3  20 B4 37             JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X (MODE)
00158A  3                                               ;
00158A  3  E0 00                CPX     #0
00158C  3  D0 08                BNE     :+
00158E  3  A9 0F                LDA     #15
001590  3  8D 44 16             STA     OPNTMP
001593  3  4C 9B 15             JMP     V_OPEN1
001596  3               :
001596  3  A9 16                LDA     #22
001598  3  8D 44 16             STA     OPNTMP          ;
