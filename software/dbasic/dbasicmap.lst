00122D  3               ;* MEMORY MAP
00122D  3               ;  VIDEO CARD IS A 32K AREA
00122D  3               ;  $0x00 0x01=soft_scanline_emulation, 0x02 NO soft_scanline_emulation
00122D  3               ;  $0x01 0x01=page1, 0x02 page2
00122D  3               ;  $0x02  character generator write offset (data << 3)
00122D  3               ;  $0x03 character generator write DATA
00122D  3               ;  $0x04 EXECUTE device command
00122D  3               ;        0x00- reset to the default configuration
00122D  3               ;        0x01- reset to the saved configuration
00122D  3               ;	0x02- save the current configuration
00122D  3               ;
00122D  3               ;  $0x05  0x01=soft_text=true, 0x02=soft_text=false
00122D  3               ;  $0x06 Lores Mode=0X01,NO lores Mode=0x02
00122D  3               ;  $0x07 Double Lores Mode=0X01,NO Double lores Mode=0x02
00122D  3               ;  $0x08 Hires Mode=0X01,NO Hires Mode=0x02
00122D  3               ;  $0x09 Double Hires Mode=0X01,NO Double Hires lores Mode=0x02
00122D  3               ;  $0x0A 80COL Mode=0X01,NO 80COL Mode=0x02
00122D  3               ;  $0x0B MIXED Mode=0X01,NO MIXED Mode=0x02
00122D  3               ;  $0x0C QUAD Hires Mode=0X01,NO QUAD Hires lores Mode=0x02
00122D  3               ;  $0x0D MONO Hires Mode=0X01,NO MONO Hires lores Mode=0x02
00122D  3               ;
00122D  3               ; 	VRAM Memory Map
00122D  3               ;	$1000-$177F	40/80 Text Page 1
00122D  3               ;	$1800-$1F7F	40/80 Color Page 1
00122D  3               ;	$2000-$277F	40/80 Text Page 2
00122D  3               ;	$2800-$2F7F	40/80 Color Page 2
00122D  3               ;	$2000-$5FFF	HIRES PAGE 1
00122D  3               ;	$6000-$8FFF	HIRES PAGE 2
00122D  3               ;	$2000-$BFFF	DOUBLE HIRES
00122D  3               
