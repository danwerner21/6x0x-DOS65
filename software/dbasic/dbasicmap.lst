001CF1  2                       .INCLUDE "sid.asm"
001CF1  3               
001CF1  3               
001CF1  3                       .IFDEF  MEMORYMAPPEDSCREEN
001CF1  3               
001CF1  3               PC6502_IO       = $E000
001CF1  3               SID_BASE        = PC6502_IO+$100
001CF1  3               
001CF1  3               ;___SOUND__________________________________________________
001CF1  3               ;
001CF1  3               ; PLAY SOUND
001CF1  3               ;
001CF1  3               ;  SOUND VOICE, FREQ, DUTY, WAVEFORM, ATTACK, SUSTAIN, DECAY, RELEASE
001CF1  3               ;
001CF1  3               ;
001CF1  3               ;__________________________________________________________
001CF1  3               LAB_SOUND:
001CF1  3  20 2C 33             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (VOICE)
001CF4  3  8A                   TXA
001CF5  3  29 03                AND     #3
001CF7  3  0A                   ASL     A
001CF8  3  AA                   TAX
001CF9  3  BD 73 1D             LDA     SIDVOICELOOKUP,X
001CFC  3  85 FD                STA     TEMPW
001CFE  3  BD 74 1D             LDA     SIDVOICELOOKUP+1,X
001D01  3  85 FE                STA     TEMPW+1
001D03  3                                               ; OK, TEMPW POINTS TO SID REGISTER TO MODIFY
001D03  3  20 9B 2A             JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001D06  3  20 69 29             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001D09  3                                               ; else do type mismatch
001D09  3  20 92 33             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001D0C  3  A0 00                LDY     #0              ; SET FREQUENCY
001D0E  3  A5 11                LDA     Itempl
001D10  3  91 FD                STA     (TEMPW),Y
001D12  3  A5 12                LDA     Itemph
001D14  3  E8                   INX
001D15  3  91 FD                STA     (TEMPW),Y
001D17  3  20 9B 2A             JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001D1A  3  20 69 29             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001D1D  3                                               ; else do type mismatch
001D1D  3  20 92 33             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001D20  3  A0 02                LDY     #2              ; SET DUTY CYCLE
001D22  3  A5 11                LDA     Itempl
001D24  3  91 FD                STA     (TEMPW),Y
001D26  3  A5 12                LDA     Itemph
001D28  3  C8                   INY
001D29  3  91 FD                STA     (TEMPW),Y
001D2B  3  20 9B 2A             JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
001D2E  3  20 2C 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (WAVEFORM)
001D31  3  8A                   TXA
001D32  3  A0 04                LDY     #4              ; SET WAVEFORM CYCLE
001D34  3  91 FD                STA     (TEMPW),Y
001D36  3  20 9B 2A             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001D39  3  20 2C 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (ATTACK)
001D3C  3  8A                   TXA
001D3D  3  4A                   LSR     A
001D3E  3  4A                   LSR     A
001D3F  3  4A                   LSR     A
001D40  3  4A                   LSR     A
001D41  3  8D DC 16             STA     PTEMPW
001D44  3  20 9B 2A             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001D47  3  20 2C 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (DECAY)
001D4A  3  8A                   TXA
001D4B  3  29 0F                AND     #$0F
001D4D  3  0D DC 16             ORA     PTEMPW
001D50  3  A0 05                LDY     #5              ; SET ATTACK/DECAY
001D52  3  91 FD                STA     (TEMPW),Y
001D54  3  20 9B 2A             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001D57  3  20 2C 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (SUSTAIN)
001D5A  3  8A                   TXA
001D5B  3  4A                   LSR     A
001D5C  3  4A                   LSR     A
001D5D  3  4A                   LSR     A
001D5E  3  4A                   LSR     A
001D5F  3  8D DC 16             STA     PTEMPW
001D62  3  20 9B 2A             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001D65  3  20 2C 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (RELEASE)
001D68  3  8A                   TXA
001D69  3  29 0F                AND     #$0F
001D6B  3  0D DC 16             ORA     PTEMPW
001D6E  3  A0 06                LDY     #6              ; SET SUSTAIN/RELEASE
001D70  3  91 FD                STA     (TEMPW),Y
001D72  3  60                   RTS
001D73  3               SIDVOICELOOKUP:
001D73  3  00 E1 07 E1          .WORD   SID_BASE,SID_BASE+7,SID_BASE+$12
001D77  3  12 E1        
001D79  3               
001D79  3               ;___FILTER_________________________________________________
001D79  3               ;
001D79  3               ; SET SID FILTERS
001D79  3               ;
001D79  3               ;  FILTER CUTOFF, RESONANCE, VOICE 1 ENABLE, VOICE 2 ENABLE, VOICE 3 ENABLE, EXTERNAL ENABLE, FILTER MODE, VOLUME
001D79  3               ;
001D79  3               ;
001D79  3               ;__________________________________________________________
001D79  3               LAB_FILTER:
001D79  3  20 69 29             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001D7C  3                                               ; else do type mismatch
001D7C  3  20 92 33             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001D7F  3                                               ; SET CUTOFF
001D7F  3  A5 11                LDA     Itempl
001D81  3  8D 15 E1             STA     SID_BASE+$15
001D84  3  A5 12                LDA     Itemph
001D86  3  8D 16 E1             STA     SID_BASE+$16
001D89  3  20 9B 2A             JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001D8C  3  20 2C 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (RESONANCE)
001D8F  3  8A                   TXA
001D90  3  4A                   LSR     A
001D91  3  4A                   LSR     A
001D92  3  4A                   LSR     A
001D93  3  4A                   LSR     A
001D94  3  8D DC 16             STA     PTEMPW
001D97  3  20 9B 2A             JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001D9A  3  20 2C 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 1 ENABLE)
001D9D  3  8A                   TXA
001D9E  3  29 01                AND     #1
001DA0  3  0D DC 16             ORA     PTEMPW
001DA3  3  8D DC 16             STA     PTEMPW
001DA6  3  20 9B 2A             JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
001DA9  3  20 2C 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 2 ENABLE)
001DAC  3  8A                   TXA
001DAD  3  29 01                AND     #1
001DAF  3  4A                   LSR     A
001DB0  3  0D DC 16             ORA     PTEMPW
001DB3  3  8D DC 16             STA     PTEMPW
001DB6  3  20 9B 2A             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001DB9  3  20 2C 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 3 ENABLE)
001DBC  3  8A                   TXA
001DBD  3  29 01                AND     #1
001DBF  3  4A                   LSR     A
001DC0  3  4A                   LSR     A
001DC1  3  0D DC 16             ORA     PTEMPW
001DC4  3  8D DC 16             STA     PTEMPW
001DC7  3  20 9B 2A             JSR     LAB_1C01        ; GET THE SIXTH PARAMETER (AFTER ',') OR SYN ERR
001DCA  3  20 2C 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (EXTERNAL AUDIO ENABLE)
001DCD  3  8A                   TXA
001DCE  3  29 01                AND     #1
001DD0  3  4A                   LSR     A
001DD1  3  4A                   LSR     A
001DD2  3  4A                   LSR     A
001DD3  3  0D DC 16             ORA     PTEMPW
001DD6  3  8D 17 E1             STA     SID_BASE+$17
001DD9  3  20 9B 2A             JSR     LAB_1C01        ; GET THE SEVENTH PARAMETER (AFTER ',') OR SYN ERR
001DDC  3  20 2C 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (FILTER MODE)
001DDF  3  8A                   TXA
001DE0  3  4A                   LSR     A
001DE1  3  4A                   LSR     A
001DE2  3  4A                   LSR     A
001DE3  3  4A                   LSR     A
001DE4  3  8D DC 16             STA     PTEMPW
001DE7  3  20 9B 2A             JSR     LAB_1C01        ; GET THE EIGHTH PARAMETER (AFTER ',') OR SYN ERR
001DEA  3  20 2C 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOLUME)
001DED  3  8A                   TXA
001DEE  3  29 0F                AND     #$0F
001DF0  3  0D DC 16             ORA     PTEMPW
001DF3  3  8D 18 E1             STA     SID_BASE+$18
001DF6  3  60                   RTS
001DF7  3               
001DF7  3                       .ELSE
