001203  2               GETVIDEOADDRESS:
001203  2  AC 48 06             LDY     CURY
001206  2               
001206  2  8C ED 18             STY     PTEMPW
001209  2  A9 00                LDA     #0
00120B  2  8D EE 18             STA     PTEMPW+1
00120E  2  18                   CLC
00120F  2  0E ED 18             ASL     PTEMPW
001212  2  2E EE 18             ROL     PTEMPW+1        ; *2
001215  2  0E ED 18             ASL     PTEMPW
001218  2  2E EE 18             ROL     PTEMPW+1        ; *4
00121B  2  0E ED 18             ASL     PTEMPW
00121E  2  2E EE 18             ROL     PTEMPW+1        ; *8
001221  2  AD ED 18             LDA     PTEMPW
001224  2  8D EF 18             STA     PTEMPW1
001227  2  AD EE 18             LDA     PTEMPW+1
00122A  2  8D F0 18             STA     PTEMPW1+1       ; PTEMPW1=Y*8
00122D  2  0E ED 18             ASL     PTEMPW
001230  2  2E EE 18             ROL     PTEMPW+1        ; *16
001233  2  0E ED 18             ASL     PTEMPW
001236  2  2E EE 18             ROL     PTEMPW+1        ; *32
001239  2                                               ; TEMPW  = Y*8 + Y*32  (Y*40)
001239  2  18                   CLC                     ; Clear the Carry flag before the first addition
00123A  2  AD ED 18             LDA     PTEMPW          ; Load the low byte of the first number into the accumulator
00123D  2  6D EF 18             ADC     PTEMPW1         ; Add the low byte of the second number (plus carry)
001240  2  85 FD                STA     TEMPW           ; Store the low byte of the result
001242  2  AD EE 18             LDA     PTEMPW+1        ; Load the high byte of the first number
001245  2  6D F0 18             ADC     PTEMPW1+1       ; Add the high byte of the second number (plus carry from previous op)
001248  2  85 FE                STA     TEMPW+1         ; Store the high byte of the result
00124A  2               
00124A  2  AD DA 18             LDA     VIDEOWIDTH      ; If 80 col, double again
00124D  2  C9 50                CMP     #80
00124F  2  D0 04                BNE     :+
001251  2  06 FD                ASL     TEMPW
001253  2  26 FE                ROL     TEMPW+1         ; *2  (80)
001255  2               :
001255  2  A5 FE                LDA     TEMPW+1
001257  2  09 A0                ORA     #$A0            ; add in the bank#
001259  2  85 FE                STA     TEMPW+1
00125B  2  60                   RTS
00125C  2               
00125C  2               
00125C  2                       .ENDIF
