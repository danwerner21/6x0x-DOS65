001CFE  3               V_PLOT_HIRES_COLOR:
001CFE  3  AD 05 19             LDA     PLOTX
001D01  3  48                   PHA                     ; PUSH LOW BYTE OF X (FOR EVEN/ODD LATER)
001D02  3  4E 06 19             LSR     PLOTX+1
001D05  3  6E 05 19             ROR     PLOTX           ; 2 PIXEL PER BYTE
001D08  3  AD 05 19             LDA     PLOTX           ;
001D0B  3                                               ; FIGURE THE BUFFER OFFSET
001D0B  3  18                   CLC                     ; MULTIPLY Y COORD BY 70 OR 140 (SINGLE OR DOUBLE HIRES)
001D0C  3  0E 07 19             ASL     PLOTY
001D0F  3  2E 08 19             ROL     PLOTY+1         ; *2
001D12  3  AD 07 19             LDA     PLOTY
001D15  3  8D 17 19             STA     PTEMPW
001D18  3  AD 08 19             LDA     PLOTY+1
001D1B  3  8D 18 19             STA     PTEMPW+1        ; STORE Y*2 INTO PTEMPW
001D1E  3  0E 07 19             ASL     PLOTY
001D21  3  2E 08 19             ROL     PLOTY+1         ; *2 (*4)
001D24  3  AD 07 19             LDA     PLOTY
001D27  3  8D 19 19             STA     PTEMPW1
001D2A  3  AD 08 19             LDA     PLOTY+1
001D2D  3  8D 1A 19             STA     PTEMPW1+1       ; STORE Y*4 INTO PTEMPW1
001D30  3  0E 07 19             ASL     PLOTY
001D33  3  2E 08 19             ROL     PLOTY+1         ; *2 (*8)
001D36  3  0E 07 19             ASL     PLOTY
001D39  3  2E 08 19             ROL     PLOTY+1         ; *2 (*16)
001D3C  3  0E 07 19             ASL     PLOTY
001D3F  3  2E 08 19             ROL     PLOTY+1         ; *2 (*32)
001D42  3  0E 07 19             ASL     PLOTY
001D45  3  2E 08 19             ROL     PLOTY+1         ; *2 (*64)
001D48  3                                               ; RESULT OFFSET PLOTY = PLOTY(Y*64)+PTEMPW(Y*2)+PTEMPW1(Y*4)
001D48  3  18                   CLC                     ; Clear the Carry flag before the first addition
001D49  3  AD 07 19             LDA     PLOTY           ; Load the low byte of the first number into the accumulator
001D4C  3  6D 17 19             ADC     PTEMPW          ; Add the low byte of the second number (plus carry)
001D4F  3  8D 07 19             STA     PLOTY           ; Store the low byte of the result
001D52  3  AD 08 19             LDA     PLOTY+1         ; Load the high byte of the first number
001D55  3  6D 18 19             ADC     PTEMPW+1        ; Add the high byte of the second number (plus carry from previous op)
001D58  3  8D 08 19             STA     PLOTY+1         ; Store the high byte of the result
001D5B  3               
001D5B  3  18                   CLC                     ; Clear the Carry flag before the first addition
001D5C  3  AD 07 19             LDA     PLOTY           ; Load the low byte of the first number into the accumulator
001D5F  3  6D 19 19             ADC     PTEMPW1         ; Add the low byte of the second number (plus carry)
001D62  3  8D 07 19             STA     PLOTY           ; Store the low byte of the result
001D65  3  AD 08 19             LDA     PLOTY+1         ; Load the high byte of the first number
001D68  3  6D 1A 19             ADC     PTEMPW1+1       ; Add the high byte of the second number (plus carry from previous op)
001D6B  3  8D 08 19             STA     PLOTY+1         ; Store the high byte of the result
001D6E  3               
001D6E  3               ; if double hires double it.
001D6E  3  AD 02 19             LDA     VIDEOMODE
001D71  3  29 10                AND     #$10
001D73  3  C9 00                CMP     #00
001D75  3  F0 06                BEQ     :+
001D77  3  0E 07 19             ASL     PLOTY
001D7A  3  2E 08 19             ROL     PLOTY+1         ; *2
001D7D  3               :
001D7D  3               ; PLOTY IS NOW Y OFFSET, ADD X OFFSET FOR MEMORY ADDRESS INTO TEMPW
001D7D  3  18                   CLC                     ; Clear the Carry flag before the first addition
001D7E  3  AD 07 19             LDA     PLOTY           ; Load the low byte of the first number into the accumulator
001D81  3  6D 05 19             ADC     PLOTX           ; Add the low byte of the second number (plus carry)
001D84  3  85 FD                STA     TEMPW           ; Store the low byte of the result
001D86  3  AD 08 19             LDA     PLOTY+1         ; Load the high byte of the first number
001D89  3  6D 06 19             ADC     PLOTX+1         ; Add the high byte of the second number (plus carry from previous op)
001D8C  3  85 FE                STA     TEMPW+1         ; Store the high byte of the result
001D8E  3               
001D8E  3  A5 FE                LDA     TEMPW+1         ; OK, LET'S CALCULATE THE BANK
001D90  3  29 F0                AND     #$F0
001D92  3  4A                   LSR     A
001D93  3  4A                   LSR     A
001D94  3  4A                   LSR     A
001D95  3  4A                   LSR     A
001D96  3  18                   CLC
001D97  3  69 FA                ADC     #$02+VIDEOBANK  ; AREA $2000-?
001D99  3  C9 F8                CMP     #$F8
001D9B  3  90 3A                BCC     V_PLOT_HIRES_COLOR_RANGE
001D9D  3  A8                   TAY                     ; VIDEO BANK SHOULD BE IN Y
001D9E  3  20 0A 1C             JSR     PAGE_ENTER
001DA1  3               
001DA1  3  A5 FE                LDA     TEMPW+1
001DA3  3  29 0F                AND     #$0F
001DA5  3  09 A0                ORA     #$A0
001DA7  3  85 FE                STA     TEMPW+1         ; TEMPW NOW REFLECTS MAPPED ADDRESSS
001DA9  3  68                   PLA
001DAA  3  4A                   LSR     A               ; LEFT OR RIGHT PIXEL?
001DAB  3  90 1B                BCC     :+
001DAD  3                                               ; LEFT PIXEL
001DAD  3  A0 00                LDY     #$00
001DAF  3  B1 FD                LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
001DB1  3  29 0F                AND     #$0F
001DB3  3  48                   PHA
001DB4  3  AD 09 19             LDA     PLOTCOLOR
001DB7  3  0A                   ASL     A
001DB8  3  0A                   ASL     A
001DB9  3  0A                   ASL     A
001DBA  3  0A                   ASL     A
001DBB  3  8D 09 19             STA     PLOTCOLOR
001DBE  3  68                   PLA
001DBF  3  0D 09 19             ORA     PLOTCOLOR
001DC2  3  91 FD                STA     (TEMPW),Y       ; WRITE THE PIXEL BACK OUT
001DC4  3  20 04 1C             JSR     PAGE_EXIT
001DC7  3  60                   RTS
001DC8  3               :
001DC8  3               ; RIGHT PIXEL
001DC8  3  A0 00                LDY     #$00
001DCA  3  B1 FD                LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
001DCC  3  29 F0                AND     #$F0
001DCE  3  0D 09 19             ORA     PLOTCOLOR
001DD1  3  91 FD                STA     (TEMPW),Y       ; WRITE THE PIXEL BACK OUT
