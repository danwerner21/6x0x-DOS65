001E5D  3  18                   CLC                     ; Clear the Carry flag before the first addition
001E5E  3  AD 07 19             LDA     PLOTY           ; Load the low byte of the first number into the accumulator
001E61  3  6D 05 19             ADC     PLOTX           ; Add the low byte of the second number (plus carry)
001E64  3  85 FD                STA     TEMPW           ; Store the low byte of the result
001E66  3               
