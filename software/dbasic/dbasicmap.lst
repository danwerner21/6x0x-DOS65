0012A9  2  8C 15 13             STY     TTY
0012AC  2  8D 16 13             STA     TTA
0012AF  2  A9 0D                LDA     #13
0012B1  2  20 17 13             JSR     WRSER1          ; output upper nybble
0012B4  2  A9 0A                LDA     #10
0012B6  2  20 17 13             JSR     WRSER1          ; output upper nybble
0012B9  2  AE 14 13             LDX     TTX
0012BC  2  AC 15 13             LDY     TTY
0012BF  2  AD 16 13             LDA     TTA
