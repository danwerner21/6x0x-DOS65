0012C9  2  8D 16 13             STA     TTA
0012CC  2  A9 20                LDA     #32
0012CE  2  20 17 13             JSR     WRSER1          ; output upper nybble
0012D1  2  AE 14 13             LDX     TTX
0012D4  2  AC 15 13             LDY     TTY
0012D7  2  AD 16 13             LDA     TTA
