001828  3               ;___V_SCREEN_________________________________________________
001828  3               ;
001828  3               ;  SET SCREEN MODE
001828  3               ;
001828  3               ;  TAKES UP TO THREE PARAMETERS
001828  3               ;  FIRST PARAMETER SCREEN MODE
001828  3               ;  0=TEXT MODE
001828  3               ;  1=LORES MODE
001828  3               ;  2=HIRES MODE
001828  3               ;
001828  3               ;  TEXT MODE PARAMETERS
001828  3               ;  0=40 COLUMNS
001828  3               ;  1=80 COLUMNS
001828  3               ;
001828  3               ;  LORES MODE SECOND PARAMETER
001828  3               ;  0=SINGLE LORES
001828  3               ;  1=DOUBLE LORES
001828  3               ;  LORES MODE THIRD PARAMETER
001828  3               ;  0=MIXED MODE
001828  3               ;  1=FULL SCREEN MODE
001828  3               ;
001828  3               ;  HIRES MODE SECOND PARAMETER
001828  3               ;  0=SINGLE HIRES
001828  3               ;  1=DOUBLE HIRES
001828  3               ;  2=QUAD HIRES
001828  3               ;  3=MONO HIRES
001828  3               ;  HIRES MODE THIRD PARAMETER
001828  3               ;  1=MIXED MODE
001828  3               ;  0=FULL SCREEN MODE
001828  3               ;
001828  3               ;__________________________________________________________
001828  3               LAB_SCREEN:
001828  3               V_SCREEN:
001828  3  20 83 33             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (MODE)
