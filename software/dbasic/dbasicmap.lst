0017D9  3  18                   CLC
0017DA  3  69 F8                ADC     #VIDEOBANK
0017DC  3  A8                   TAY
0017DD  3  A9 01                LDA     #$01            ; MODIFY TASK 01 (DRIVER TASK)
0017DF  3  A2 0A                LDX     #$0A            ; MAP $AXXX
