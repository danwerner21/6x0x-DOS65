001ECE  3  ED A2 18             SBC     LINEX2+1        ; Subtract high byte of number 2 with borrow
001ED1  3  8D A6 18             STA     DELTAX+1        ; Store result high byte
001ED4  3  B0 20                BCS     :+              ; BRANCH IF X1>=X2
001ED6  3                                               ; X1 < X2
001ED6  3  A9 00                LDA     #0
001ED8  3  8D AD 18             STA     PTEMP           ; IF X2>X1 (PTEMP=x0)
001EDB  3  A9 FF                LDA     #$FF            ; TAKE ABSOLUTE VALUE OF DELTAX
001EDD  3  4D A6 18             EOR     DELTAX+1        ; Invert high byte (one's complement)
001EE0  3  8D A6 18             STA     DELTAX+1
001EE3  3  A9 FF                LDA     #$FF            ;
001EE5  3  4D A5 18             EOR     DELTAX          ; Invert low byte
001EE8  3  8D A5 18             STA     DELTAX          ;
001EEB  3  EE A5 18             INC     DELTAX          ; Add 1 to the low byte
001EEE  3  D0 0B                BNE     :++             ; If no carry from low byte INC, we are done
001EF0  3  EE A6 18             INC     DELTAX+1        ; Increment high byte if carry occurred
001EF3  3  4C FB 1E             JMP     :++
001EF6  3               :
001EF6  3  A9 01                LDA     #1
001EF8  3  8D AD 18             STA     PTEMP           ; IF X1>X2 (PTEMP=x1)
001EFB  3               :
001EFB  3                                               ; CALCULATE DELTAY
001EFB  3  A9 00                LDA     #0
001EFD  3  8D A8 18             STA     DELTAY+1
001F00  3  38                   SEC                     ; Set Carry flag
001F01  3  AD 9F 18             LDA     LINEY1          ; Load low byte of number 1
001F04  3  ED A3 18             SBC     LINEY2          ; Subtract low byte of number 2 with carry
001F07  3  8D A7 18             STA     DELTAY          ; Store result low byte
001F0A  3  B0 16                BCS     :+              ; BRANCH IF Y1>=Y2
001F0C  3                                               ; Y1 < Y2
001F0C  3  AD AD 18             LDA     PTEMP
001F0F  3  29 01                AND     #1
001F11  3  8D AD 18             STA     PTEMP           ; IF Y2>Y1 (PTEMP=0x)
001F14  3                                               ; TAKE ABSOLUTE VALUE OF DELTAY
001F14  3  A9 FF                LDA     #$FF
001F16  3  4D A7 18             EOR     DELTAY          ; Flip all bits (one's complement)
001F19  3  8D A7 18             STA     DELTAY
001F1C  3  EE A7 18             INC     DELTAY          ; Add 1 (two's complement)
001F1F  3  4C 2A 1F             JMP     :++
001F22  3               :
001F22  3  AD AD 18             LDA     PTEMP
001F25  3  09 10                ORA     #$10
001F27  3  8D AD 18             STA     PTEMP           ; IF Y1>Y2 (PTEMP=1x)
001F2A  3               :
001F2A  3                                               ; SLOPE DETERMINED, AND DELTAS CALCULATED
001F2A  3                                               ; OK, LET'S FIND OUT IF THIS IS A HORIZONTAL-ISH
001F2A  3                                               ; OR VERTICAL-ISH LINE
001F2A  3  38                   SEC                     ; Set Carry Flag (for subtraction)
001F2B  3  AD A5 18             LDA     DELTAX          ; Load low byte of DELTAX
001F2E  3  ED A7 18             SBC     DELTAY          ; Subtract low byte of DELTAY
001F31  3  AD A6 18             LDA     DELTAX+1        ; Load high byte of DELTAX
001F34  3  ED A8 18             SBC     DELTAY+1        ; Subtract high byte of DELTAY (with borrow)
001F37  3                                               ; Flags now reflect the 16-bit comparison
001F37  3  90 03                BCC     LINEVERT        ; If Carry clear, LINE IS VERTICAL-ISH
001F39  3  4C D2 1F             JMP     LINEHORZ
001F3C  3               LINEVERT:
001F3C  3                                               ; FOR A VERTICAL-ISH LINE WE STEP ALONG THE
001F3C  3                                               ; Y AXIS (STEEP GRADIENT)
001F3C  3                                               ; FIND LARGER Y . . .
001F3C  3  AD 9F 18             LDA     LINEY1
001F3F  3  CD A3 18             CMP     LINEY2
001F42  3  B0 03                BCS     :+
001F44  3  20 69 20             JSR     LINESWAPXY
001F47  3               :
001F47  3                                               ; Initialize error = DELTAY / 2
001F47  3  AD A7 18             LDA     DELTAY
001F4A  3  8D AE 18             STA     LINEERR
001F4D  3  AD A8 18             LDA     DELTAY+1
001F50  3  8D AF 18             STA     LINEERR+1
001F53  3  4E AF 18             LSR     LINEERR+1
001F56  3  6E AE 18             ROR     LINEERR
001F59  3               LINEVERTLOOP:
001F59  3  AD 9F 18             LDA     LINEY1          ; OK LET'S PLOT A POINT
001F5C  3  8D 99 18             STA     PLOTY
001F5F  3  AD A0 18             LDA     LINEY1+1
001F62  3  8D 9A 18             STA     PLOTY+1
001F65  3  AD 9D 18             LDA     LINEX1
001F68  3  8D 97 18             STA     PLOTX
001F6B  3  AD 9E 18             LDA     LINEX1+1
001F6E  3  8D 98 18             STA     PLOTX+1
001F71  3  AD 9C 18             LDA     LINECOLOR
001F74  3  8D 9B 18             STA     PLOTCOLOR
001F77  3  20 D0 1B             JSR     DOPLOTXY
001F7A  3                                               ; NOW MOVE LINE1 CLOSER TO LINE2
001F7A  3  CE 9F 18             DEC     LINEY1          ; BY STEPPING ALONG Y AXIS
001F7D  3               
001F7D  3                                               ; BRESENHAM: err -= DELTAX
001F7D  3  38                   SEC
001F7E  3  AD AE 18             LDA     LINEERR
001F81  3  ED A5 18             SBC     DELTAX
001F84  3  8D AE 18             STA     LINEERR
001F87  3  AD AF 18             LDA     LINEERR+1
001F8A  3  ED A6 18             SBC     DELTAX+1
001F8D  3  8D AF 18             STA     LINEERR+1
001F90  3  10 37                BPL     LINEVERT_NOSTEP ; IF ERR >= 0, NO X STEP NEEDED
001F92  3                                               ; ERR += DELTAY (RESTORE ERROR)
001F92  3  18                   CLC
001F93  3  AD AE 18             LDA     LINEERR
001F96  3  6D A7 18             ADC     DELTAY
001F99  3  8D AE 18             STA     LINEERR
001F9C  3  AD AF 18             LDA     LINEERR+1
001F9F  3  6D A8 18             ADC     DELTAY+1
001FA2  3  8D AF 18             STA     LINEERR+1
001FA5  3                                               ; STEP X TOWARD X2 (16-BIT)
001FA5  3  AD A1 18             LDA     LINEX2
001FA8  3  CD 9D 18             CMP     LINEX1
001FAB  3  AD A2 18             LDA     LINEX2+1
001FAE  3  ED 9E 18             SBC     LINEX1+1
001FB1  3  90 0B                BCC     LINEVERT_DECX   ; X2 < X1, DECREMENT X1
001FB3  3  EE 9D 18             INC     LINEX1          ; X2 >= X1, INCREMENT X1
001FB6  3  D0 11                BNE     LINEVERT_NOSTEP
001FB8  3  EE 9E 18             INC     LINEX1+1
001FBB  3  4C C9 1F             JMP     LINEVERT_NOSTEP
001FBE  3               LINEVERT_DECX:
001FBE  3  AD 9D 18             LDA     LINEX1
001FC1  3  D0 03                BNE     :+
001FC3  3  CE 9E 18             DEC     LINEX1+1
001FC6  3  CE 9D 18     :       DEC     LINEX1
001FC9  3               LINEVERT_NOSTEP:
001FC9  3               
001FC9  3  AD 9F 18             LDA     LINEY1
001FCC  3  CD A3 18             CMP     LINEY2
001FCF  3  D0 88                BNE     LINEVERTLOOP
001FD1  3  60                   RTS                     ; DONE
001FD2  3               
001FD2  3               LINEHORZ:
001FD2  3               ; FOR A HORIZONTAL-ISH LINE WE STEP ALONG THE
001FD2  3               ; X AXIS (SHALLOW GRADIENT)
001FD2  3               ; FIND LARGER X . . .
001FD2  3  38                   SEC                     ; Set carry flag for subtraction
001FD3  3  AD A1 18             LDA     LINEX2          ; Load low byte of first number
001FD6  3  ED 9D 18             SBC     LINEX1          ; Subtract low byte of second number
001FD9  3  AD A2 18             LDA     LINEX2+1        ; Load high byte of first number
001FDC  3  ED 9E 18             SBC     LINEX1+1        ; Subtract high byte of second number
001FDF  3                                               ; Result flags (N, Z, C) now reflect: Val1 - Val2
001FDF  3  B0 03                BCS     :+              ; If carry is set, LINEX2 >= LINEX1
001FE1  3  20 69 20             JSR     LINESWAPXY
001FE4  3               :
001FE4  3                                               ; Initialize error = DELTAX / 2
001FE4  3  AD A5 18             LDA     DELTAX
001FE7  3  8D AE 18             STA     LINEERR
001FEA  3  AD A6 18             LDA     DELTAX+1
001FED  3  8D AF 18             STA     LINEERR+1
001FF0  3  4E AF 18             LSR     LINEERR+1
001FF3  3  6E AE 18             ROR     LINEERR
001FF6  3               LINEHORZLOOP:
001FF6  3  AD 9F 18             LDA     LINEY1          ; OK LET'S PLOT A POINT
001FF9  3  8D 99 18             STA     PLOTY
001FFC  3  AD A0 18             LDA     LINEY1+1
001FFF  3  8D 9A 18             STA     PLOTY+1
002002  3  AD 9D 18             LDA     LINEX1
002005  3  8D 97 18             STA     PLOTX
002008  3  AD 9E 18             LDA     LINEX1+1
00200B  3  8D 98 18             STA     PLOTX+1
00200E  3  AD 9C 18             LDA     LINECOLOR
002011  3  8D 9B 18             STA     PLOTCOLOR
002014  3  20 D0 1B             JSR     DOPLOTXY
002017  3                                               ; NOW MOVE LINE1 CLOSER TO LINE2
002017  3  EE 9D 18             INC     LINEX1          ; BY STEPPING ALONG X AXIS
00201A  3  D0 03                BNE     :+
00201C  3  EE 9E 18             INC     LINEX1+1
00201F  3               :
00201F  3                                               ; BRESENHAM: err -= DELTAY
00201F  3  38                   SEC
002020  3  AD AE 18             LDA     LINEERR
002023  3  ED A7 18             SBC     DELTAY
002026  3  8D AE 18             STA     LINEERR
002029  3  AD AF 18             LDA     LINEERR+1
00202C  3  ED A8 18             SBC     DELTAY+1
00202F  3  8D AF 18             STA     LINEERR+1
002032  3  10 24                BPL     LINEHORZ_NOSTEP ; IF ERR >= 0, NO Y STEP NEEDED
002034  3                                               ; ERR += DELTAX (RESTORE ERROR)
002034  3  18                   CLC
002035  3  AD AE 18             LDA     LINEERR
002038  3  6D A5 18             ADC     DELTAX
00203B  3  8D AE 18             STA     LINEERR
00203E  3  AD AF 18             LDA     LINEERR+1
002041  3  6D A6 18             ADC     DELTAX+1
002044  3  8D AF 18             STA     LINEERR+1
002047  3                                               ; STEP Y TOWARD Y2
002047  3  AD A3 18             LDA     LINEY2
00204A  3  CD 9F 18             CMP     LINEY1
00204D  3  90 06                BCC     LINEHORZ_DECY   ; Y2 < Y1, DECREMENT
00204F  3  EE 9F 18             INC     LINEY1          ; Y2 >= Y1, INCREMENT
002052  3  4C 58 20             JMP     LINEHORZ_NOSTEP
002055  3               LINEHORZ_DECY:
002055  3  CE 9F 18             DEC     LINEY1
002058  3               LINEHORZ_NOSTEP:
002058  3               
002058  3  AD 9D 18             LDA     LINEX1
00205B  3  CD A1 18             CMP     LINEX2
00205E  3  D0 96                BNE     LINEHORZLOOP
002060  3  AD 9E 18             LDA     LINEX1+1
002063  3  CD A2 18             CMP     LINEX2+1
002066  3  D0 8E                BNE     LINEHORZLOOP
002068  3  60                   RTS                     ; DONE
002069  3               
002069  3               LINESWAPXY:
002069  3  AD 9D 18             LDA     LINEX1
00206C  3  AC A1 18             LDY     LINEX2
00206F  3  8C 9D 18             STY     LINEX1
002072  3  8D A1 18             STA     LINEX2
002075  3  AD 9E 18             LDA     LINEX1+1
002078  3  AC A2 18             LDY     LINEX2+1
00207B  3  8C 9E 18             STY     LINEX1+1
00207E  3  8D A2 18             STA     LINEX2+1
002081  3               ;
002081  3  AD 9F 18             LDA     LINEY1
002084  3  AC A3 18             LDY     LINEY2
002087  3  8C 9F 18             STY     LINEY1
00208A  3  8D A3 18             STA     LINEY2
00208D  3  AD A0 18             LDA     LINEY1+1
002090  3  AC A4 18             LDY     LINEY2+1
002093  3  8C A0 18             STY     LINEY1+1
002096  3  8D A4 18             STA     LINEY2+1
002099  3  60                   RTS
00209A  3                       .ELSE
00209A  3               
00209A  3               
00209A  3               ; ENSURE ALL OF THESE SPECIAL COMMANDS GIVE ERRORS IN NORMAL BASIC
00209A  3               LAB_SPEEK:
00209A  3               LAB_SPOKE:
00209A  3               LAB_SCRCLR:
00209A  3               LAB_SCREEN:
00209A  3               LAB_PATTERN:
00209A  3               LAB_PLOT:
00209A  3               LAB_LOCATE:
00209A  3               LAB_COLOR:
00209A  3               LAB_LINE:
00209A  3                       LDX     #$02            ; error code $02 ("SYNTAX" error)
00209A  3                       JMP     LAB_XERR        ; do error #X, then warm start
00209A  3               
00209A  3                       .ENDIF
00209A  3               
00209A  2                       .INCLUDE "sid.asm"
00209A  3               
00209A  3               
00209A  3                       .IFDEF  MEMORYMAPPEDSCREEN
00209A  3               
00209A  3               PC6502_IO       = $E000
00209A  3               SID_BASE        = PC6502_IO+$100
00209A  3               
00209A  3               ;___SOUND__________________________________________________
00209A  3               ;
00209A  3               ; PLAY SOUND
00209A  3               ;
00209A  3               ;  SOUND VOICE, FREQ, DUTY, WAVEFORM, ATTACK, SUSTAIN, DECAY, RELEASE
00209A  3               ;
00209A  3               ;
00209A  3               ;__________________________________________________________
00209A  3               LAB_SOUND:
00209A  3  20 E0 36             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (VOICE)
00209D  3  8A                   TXA
00209E  3  29 03                AND     #3
0020A0  3  0A                   ASL     A
0020A1  3  AA                   TAX
0020A2  3  BD 1C 21             LDA     SIDVOICELOOKUP,X
0020A5  3  85 FD                STA     TEMPW
0020A7  3  BD 1D 21             LDA     SIDVOICELOOKUP+1,X
0020AA  3  85 FE                STA     TEMPW+1
0020AC  3                                               ; OK, TEMPW POINTS TO SID REGISTER TO MODIFY
0020AC  3  20 4F 2E             JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
0020AF  3  20 1D 2D             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
0020B2  3                                               ; else do type mismatch
0020B2  3  20 46 37             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
0020B5  3  A0 00                LDY     #0              ; SET FREQUENCY
0020B7  3  A5 11                LDA     Itempl
0020B9  3  91 FD                STA     (TEMPW),Y
0020BB  3  A5 12                LDA     Itemph
0020BD  3  E8                   INX
0020BE  3  91 FD                STA     (TEMPW),Y
0020C0  3  20 4F 2E             JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
0020C3  3  20 1D 2D             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
0020C6  3                                               ; else do type mismatch
0020C6  3  20 46 37             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
0020C9  3  A0 02                LDY     #2              ; SET DUTY CYCLE
0020CB  3  A5 11                LDA     Itempl
0020CD  3  91 FD                STA     (TEMPW),Y
0020CF  3  A5 12                LDA     Itemph
0020D1  3  C8                   INY
0020D2  3  91 FD                STA     (TEMPW),Y
0020D4  3  20 4F 2E             JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
0020D7  3  20 E0 36             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (WAVEFORM)
0020DA  3  8A                   TXA
0020DB  3  A0 04                LDY     #4              ; SET WAVEFORM CYCLE
0020DD  3  91 FD                STA     (TEMPW),Y
0020DF  3  20 4F 2E             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
0020E2  3  20 E0 36             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (ATTACK)
0020E5  3  8A                   TXA
0020E6  3  4A                   LSR     A
0020E7  3  4A                   LSR     A
0020E8  3  4A                   LSR     A
0020E9  3  4A                   LSR     A
0020EA  3  8D A9 18             STA     PTEMPW
0020ED  3  20 4F 2E             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
0020F0  3  20 E0 36             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (DECAY)
0020F3  3  8A                   TXA
0020F4  3  29 0F                AND     #$0F
0020F6  3  0D A9 18             ORA     PTEMPW
0020F9  3  A0 05                LDY     #5              ; SET ATTACK/DECAY
0020FB  3  91 FD                STA     (TEMPW),Y
0020FD  3  20 4F 2E             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
002100  3  20 E0 36             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (SUSTAIN)
002103  3  8A                   TXA
002104  3  4A                   LSR     A
002105  3  4A                   LSR     A
002106  3  4A                   LSR     A
002107  3  4A                   LSR     A
002108  3  8D A9 18             STA     PTEMPW
00210B  3  20 4F 2E             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
00210E  3  20 E0 36             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (RELEASE)
002111  3  8A                   TXA
002112  3  29 0F                AND     #$0F
002114  3  0D A9 18             ORA     PTEMPW
002117  3  A0 06                LDY     #6              ; SET SUSTAIN/RELEASE
002119  3  91 FD                STA     (TEMPW),Y
00211B  3  60                   RTS
00211C  3               SIDVOICELOOKUP:
00211C  3  00 E1 07 E1          .WORD   SID_BASE,SID_BASE+7,SID_BASE+$12
002120  3  12 E1        
002122  3               
002122  3               ;___FILTER_________________________________________________
002122  3               ;
002122  3               ; SET SID FILTERS
002122  3               ;
002122  3               ;  FILTER CUTOFF, RESONANCE, VOICE 1 ENABLE, VOICE 2 ENABLE, VOICE 3 ENABLE, EXTERNAL ENABLE, FILTER MODE, VOLUME
002122  3               ;
002122  3               ;
002122  3               ;__________________________________________________________
002122  3               LAB_FILTER:
002122  3  20 1D 2D             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
002125  3                                               ; else do type mismatch
002125  3  20 46 37             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
002128  3                                               ; SET CUTOFF
002128  3  A5 11                LDA     Itempl
00212A  3  8D 15 E1             STA     SID_BASE+$15
00212D  3  A5 12                LDA     Itemph
00212F  3  8D 16 E1             STA     SID_BASE+$16
002132  3  20 4F 2E             JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
002135  3  20 E0 36             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (RESONANCE)
002138  3  8A                   TXA
002139  3  4A                   LSR     A
00213A  3  4A                   LSR     A
00213B  3  4A                   LSR     A
00213C  3  4A                   LSR     A
00213D  3  8D A9 18             STA     PTEMPW
002140  3  20 4F 2E             JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
002143  3  20 E0 36             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 1 ENABLE)
002146  3  8A                   TXA
002147  3  29 01                AND     #1
002149  3  0D A9 18             ORA     PTEMPW
00214C  3  8D A9 18             STA     PTEMPW
00214F  3  20 4F 2E             JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
002152  3  20 E0 36             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 2 ENABLE)
002155  3  8A                   TXA
002156  3  29 01                AND     #1
002158  3  4A                   LSR     A
002159  3  0D A9 18             ORA     PTEMPW
00215C  3  8D A9 18             STA     PTEMPW
00215F  3  20 4F 2E             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
002162  3  20 E0 36             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 3 ENABLE)
002165  3  8A                   TXA
002166  3  29 01                AND     #1
002168  3  4A                   LSR     A
002169  3  4A                   LSR     A
00216A  3  0D A9 18             ORA     PTEMPW
00216D  3  8D A9 18             STA     PTEMPW
002170  3  20 4F 2E             JSR     LAB_1C01        ; GET THE SIXTH PARAMETER (AFTER ',') OR SYN ERR
002173  3  20 E0 36             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (EXTERNAL AUDIO ENABLE)
002176  3  8A                   TXA
002177  3  29 01                AND     #1
002179  3  4A                   LSR     A
00217A  3  4A                   LSR     A
00217B  3  4A                   LSR     A
00217C  3  0D A9 18             ORA     PTEMPW
00217F  3  8D 17 E1             STA     SID_BASE+$17
002182  3  20 4F 2E             JSR     LAB_1C01        ; GET THE SEVENTH PARAMETER (AFTER ',') OR SYN ERR
002185  3  20 E0 36             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (FILTER MODE)
002188  3  8A                   TXA
002189  3  4A                   LSR     A
00218A  3  4A                   LSR     A
00218B  3  4A                   LSR     A
00218C  3  4A                   LSR     A
00218D  3  8D A9 18             STA     PTEMPW
002190  3  20 4F 2E             JSR     LAB_1C01        ; GET THE EIGHTH PARAMETER (AFTER ',') OR SYN ERR
002193  3  20 E0 36             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOLUME)
002196  3  8A                   TXA
002197  3  29 0F                AND     #$0F
002199  3  0D A9 18             ORA     PTEMPW
00219C  3  8D 18 E1             STA     SID_BASE+$18
00219F  3  60                   RTS
0021A0  3               
0021A0  3                       .ELSE
0021A0  3               
0021A0  3               
0021A0  3               ; ENSURE ALL OF THESE SPECIAL COMMANDS GIVE ERRORS IN NORMAL BASIC
0021A0  3               LAB_SOUND:
0021A0  3               LAB_FILTER:
0021A0  3                       LDX     #$02            ; error code $02 ("SYNTAX" error)
0021A0  3                       JMP     LAB_XERR        ; do error #X, then warm start
0021A0  3               
0021A0  3                       .ENDIF
0021A0  3               
0021A0  2                       .INCLUDE "rtc.asm"
0021A0  3               
0021A0  3               
0021A0  3               RTCSECONDS      = 0
0021A0  3               RTCMINUTES      = 1
0021A0  3               RTCHOUR         = 2
0021A0  3               RTCDATE         = 3
0021A0  3               RTCMONTH        = 4
0021A0  3               RTCYEAR         = 6
0021A0  3               
0021A0  3               ;___LAB_SECOND______________________________________________
0021A0  3               ;
