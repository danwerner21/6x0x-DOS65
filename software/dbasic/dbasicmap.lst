0012AA  3               ;___SAVE____________________________________________________
0012AA  3               ;
0012AA  3               ; SAVE COMMAND
0012AA  3               ;
0012AA  3               ;  SAVE THE BASIC PROGRAM IN MEMORY TO DISK
0012AA  3               ;
0012AA  3               ;__________________________________________________________
0012AA  3               V_SAVE: ; save BASIC program
0012AA  3               DOS65SAVE:
0012AA  3  20 1F 14             JSR     DOS65FCBPREP    ; parse parameters into FCB
0012AD  3  B0 29                BCS     DOS65SAVE_ERR1  ; Error?, if so abort
0012AF  3  A2 0D                LDX     #13             ;
0012B1  3  20 A4 12             JSR     PEM             ;
0012B4  3  A9 C7                LDA     #<FCB           ; CREATE File
0012B6  3  A0 16                LDY     #>FCB           ;
0012B8  3  A2 16                LDX     #22             ;
0012BA  3  20 A4 12             JSR     PEM             ;
0012BD  3  A9 00                LDA     #0              ; clear
0012BF  3  8D E7 16             STA     FCB+32          ; record number
0012C2  3  A9 C7                LDA     #<FCB           ; Open File
0012C4  3  A0 16                LDY     #>FCB           ;
0012C6  3  A2 0F                LDX     #15             ;
0012C8  3  20 A4 12             JSR     PEM             ;
0012CB  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
0012CD  3  D0 0C                BNE     DOS65SAVE_1     ;
0012CF  3               DOS65SAVE_ERR:
0012CF  3  A9 BE                LDA     #<FILEERROR2    ; NO, ERROR OUT
0012D1  3  A0 0F                LDY     #>FILEERROR2
0012D3  3  A2 09                LDX     #9              ; Print error message
0012D5  3  20 A4 12             JSR     PEM             ;
0012D8  3               DOS65SAVE_ERR1:
0012D8  3  4C FD 25             JMP     LAB_REM         ; comment out the remainder of the line (if any)
0012DB  3               DOS65SAVE_1:
0012DB  3  A9 DA                LDA     #<FCBBUFFER     ; SETUP BUFFER
0012DD  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
0012DF  3  A0 3F                LDY     #>FCBBUFFER     ;
0012E1  3  84 21                STY     FCBPTR+1        ;
0012E3  3  A2 1A                LDX     #26             ; Setup Buffer
0012E5  3  20 A4 12             JSR     PEM             ;
0012E8  3               DOS65SAVE_2:
0012E8  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
0012EA  3  85 22                STA     FCBPTR+2        ; point to base of RAM
0012EC  3  A5 7A                LDA     <Smemh          ;
0012EE  3  85 23                STA     FCBPTR+3        ;
0012F0  3  A2 00                LDX     #$00            ; x=0 (null counter)
0012F2  3               DOS65SAVE_2A:
0012F2  3  A0 00                LDY     #$00            ; y=0 (Loop Index)
0012F4  3               DOS65SAVE_3:
0012F4  3  B1 22                LDA     (FCBPTR+2),Y    ; load from RAM
0012F6  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
0012F8  3  C9 00                CMP     #$00            ; is Zero?
0012FA  3  D0 1E                BNE     DOS65SAVE_3A    ; No, continue
0012FC  3  E8                   INX                     ; yes, bump Null Counter
0012FD  3  E0 03                CPX     #$03            ; Three nulls in a row?
0012FF  3  D0 1B                BNE     DOS65SAVE_3B    ; No, continue
001301  3                                               ; FINISH FILLING BUFFER WITH NULLS
001301  3               :
001301  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
001303  3  C8                   INY                     ; bump index
001304  3  C0 80                CPY     #$80            ; end of buffer?
001306  3  D0 F9                BNE     :-              ; no, loop
001308  3  A9 C7                LDA     #<FCB           ; Write record in buffer to disk file AND END
00130A  3  A0 16                LDY     #>FCB           ;
00130C  3  A2 15                LDX     #21             ;
00130E  3  20 A4 12             JSR     PEM             ;
001311  3  29 FE                AND     #$FE            ; strip out extension
001313  3  C9 00                CMP     #$00            ; is error
001315  3  D0 B8                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
001317  3  4C 47 13             JMP     DOS65SAVE_4
00131A  3               DOS65SAVE_3A:                   ;
00131A  3  A2 00                LDX     #$00            ; prior char not null, reset null counter
00131C  3               DOS65SAVE_3B:                   ;
00131C  3  C8                   INY                     ; bump index
00131D  3  C0 80                CPY     #$80            ; end of buffer?
00131F  3  D0 D3                BNE     DOS65SAVE_3     ; no, loop
001321  3               DOS65SAVE_3C:
001321  3  A9 C7                LDA     #<FCB           ; Write record in buffer to disk file
001323  3  A0 16                LDY     #>FCB           ;
001325  3  A2 15                LDX     #21             ;
001327  3  20 A4 12             JSR     PEM             ;
00132A  3  29 FE                AND     #$FE            ; strip out extension
00132C  3  C9 00                CMP     #$00            ; is error
00132E  3  D0 9F                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
001330  3  18                   CLC                     ;
001331  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
001333  3  69 80                ADC     #$80            ;
001335  3  85 22                STA     FCBPTR+2        ;
001337  3  90 B9                BCC     DOS65SAVE_2A    ; is carry?, no loop
001339  3  18                   CLC                     ; yes, carry, inc high byte
00133A  3  A5 23                LDA     FCBPTR+3        ;
00133C  3  69 01                ADC     #$01            ;
00133E  3  85 23                STA     FCBPTR+3        ;
001340  3  C9 B8                CMP     #>Ram_top       ; are we at the end of RAM?
001342  3  F0 03                BEQ     DOS65SAVE_4
001344  3  4C F2 12             JMP     DOS65SAVE_2A
001347  3               DOS65SAVE_4:
001347  3  A9 C7                LDA     #<FCB           ;
001349  3  A0 16                LDY     #>FCB           ;
00134B  3  A2 10                LDX     #16             ;
00134D  3  20 A4 12             JSR     PEM             ;
001350  3  C9 FF                CMP     #$FF            ;
001352  3  D0 03                BNE     DOS65SAVE_5     ;
001354  3  4C CF 12             JMP     DOS65SAVE_ERR   ; ERROR, DISPLAY IT
001357  3               DOS65SAVE_5:
001357  3  A9 65                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
001359  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
00135B  3  20 B2 27             JSR     LAB_18C3
00135E  3  4C EA 20             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
