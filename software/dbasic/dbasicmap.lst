001202  2  8E 70 12             STX     TTX
001205  2  8C 71 12             STY     TTY
001208  2  8D 72 12             STA     TTA
00120B  2  A9 0D                LDA     #13
00120D  2  20 73 12             JSR     WRSER1          ; output upper nybble
001210  2  A9 0A                LDA     #10
001212  2  20 73 12             JSR     WRSER1          ; output upper nybble
001215  2  AE 70 12             LDX     TTX
001218  2  AC 71 12             LDY     TTY
00121B  2  AD 72 12             LDA     TTA
