00128B  3               ;  SAVE THE BASIC PROGRAM IN MEMORY TO DISK
00128B  3               ;
00128B  3               ;__________________________________________________________
00128B  3               V_SAVE: ; save BASIC program
00128B  3               DOS65SAVE:
00128B  3  20 FE 13             JSR     DOS65FCBPREP    ; parse parameters into FCB
00128E  3  B0 28                BCS     DOS65SAVE_ERR1  ; Error?, if so abort
001290  3  A2 0D                LDX     #13             ;
001292  3  20 85 12             JSR     PEM             ;
001295  3  A9 99                LDA     #<FCB           ; CREATE File
001297  3  A0 16                LDY     #>FCB           ;
001299  3  A2 16                LDX     #22             ;
00129B  3  20 85 12             JSR     PEM             ;
00129E  3  A9 00                LDA     #0              ; clear
0012A0  3  8D B9 16             STA     FCB+32          ; record number
0012A3  3  A9 99                LDA     #<FCB           ; Open File
0012A5  3  A0 16                LDY     #>FCB           ;
0012A7  3  A2 0F                LDX     #15             ;
0012A9  3  20 85 12             JSR     PEM             ;
0012AC  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
0012AE  3  D0 0B                BNE     DOS65SAVE_1     ;
0012B0  3               DOS65SAVE_ERR:
0012B0  3  A2 24                LDX     #$24            ; IO ERROR
0012B2  3  20 E4 1F             JSR     LAB_XERR
0012B5  3  4C BC 20             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
0012B8  3               DOS65SAVE_ERR1:
0012B8  3  4C CA 25             JMP     LAB_REM         ; comment out the remainder of the line (if any)
0012BB  3               DOS65SAVE_1:
0012BB  3  A9 54                LDA     #<FCBBUFFER     ; SETUP BUFFER
0012BD  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
0012BF  3  A0 3F                LDY     #>FCBBUFFER     ;
0012C1  3  84 21                STY     FCBPTR+1        ;
0012C3  3  A2 1A                LDX     #26             ; Setup Buffer
0012C5  3  20 85 12             JSR     PEM             ;
0012C8  3               DOS65SAVE_2:
0012C8  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
0012CA  3  85 22                STA     FCBPTR+2        ; point to base of RAM
0012CC  3  A5 7A                LDA     <Smemh          ;
0012CE  3  85 23                STA     FCBPTR+3        ;
0012D0  3  A2 00                LDX     #$00            ; x=0 (null counter)
0012D2  3               DOS65SAVE_2A:
0012D2  3  A0 00                LDY     #$00            ; y=0 (Loop Index)
0012D4  3               DOS65SAVE_3:
0012D4  3  B1 22                LDA     (FCBPTR+2),Y    ; load from RAM
0012D6  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
0012D8  3  C9 00                CMP     #$00            ; is Zero?
0012DA  3  D0 1E                BNE     DOS65SAVE_3A    ; No, continue
0012DC  3  E8                   INX                     ; yes, bump Null Counter
0012DD  3  E0 03                CPX     #$03            ; Three nulls in a row?
0012DF  3  D0 1B                BNE     DOS65SAVE_3B    ; No, continue
0012E1  3                                               ; FINISH FILLING BUFFER WITH NULLS
0012E1  3               :
0012E1  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
0012E3  3  C8                   INY                     ; bump index
0012E4  3  C0 80                CPY     #$80            ; end of buffer?
0012E6  3  D0 F9                BNE     :-              ; no, loop
0012E8  3  A9 99                LDA     #<FCB           ; Write record in buffer to disk file AND END
0012EA  3  A0 16                LDY     #>FCB           ;
0012EC  3  A2 15                LDX     #21             ;
0012EE  3  20 85 12             JSR     PEM             ;
0012F1  3  29 FE                AND     #$FE            ; strip out extension
0012F3  3  C9 00                CMP     #$00            ; is error
0012F5  3  D0 B9                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
0012F7  3  4C 27 13             JMP     DOS65SAVE_4
0012FA  3               DOS65SAVE_3A:                   ;
0012FA  3  A2 00                LDX     #$00            ; prior char not null, reset null counter
0012FC  3               DOS65SAVE_3B:                   ;
0012FC  3  C8                   INY                     ; bump index
0012FD  3  C0 80                CPY     #$80            ; end of buffer?
0012FF  3  D0 D3                BNE     DOS65SAVE_3     ; no, loop
001301  3               DOS65SAVE_3C:
001301  3  A9 99                LDA     #<FCB           ; Write record in buffer to disk file
001303  3  A0 16                LDY     #>FCB           ;
001305  3  A2 15                LDX     #21             ;
001307  3  20 85 12             JSR     PEM             ;
00130A  3  29 FE                AND     #$FE            ; strip out extension
00130C  3  C9 00                CMP     #$00            ; is error
00130E  3  D0 A0                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
001310  3  18                   CLC                     ;
001311  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
001313  3  69 80                ADC     #$80            ;
001315  3  85 22                STA     FCBPTR+2        ;
001317  3  90 B9                BCC     DOS65SAVE_2A    ; is carry?, no loop
001319  3  18                   CLC                     ; yes, carry, inc high byte
00131A  3  A5 23                LDA     FCBPTR+3        ;
00131C  3  69 01                ADC     #$01            ;
00131E  3  85 23                STA     FCBPTR+3        ;
001320  3  C9 B8                CMP     #>Ram_top       ; are we at the end of RAM?
001322  3  F0 03                BEQ     DOS65SAVE_4
001324  3  4C D2 12             JMP     DOS65SAVE_2A
001327  3               DOS65SAVE_4:
001327  3  A9 99                LDA     #<FCB           ;
001329  3  A0 16                LDY     #>FCB           ;
00132B  3  A2 10                LDX     #16             ;
00132D  3  20 85 12             JSR     PEM             ;
001330  3  C9 FF                CMP     #$FF            ;
001332  3  D0 03                BNE     DOS65SAVE_5     ;
001334  3  4C B0 12             JMP     DOS65SAVE_ERR   ; ERROR, DISPLAY IT
001337  3               DOS65SAVE_5:
001337  3  A9 5C                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
001339  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
00133B  3  20 71 27             JSR     LAB_18C3
00133E  3  4C BC 20             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
