00127C  2  8E EA 12             STX     TTX
00127F  2  8C EB 12             STY     TTY
001282  2  8D EC 12             STA     TTA
001285  2  A9 0D                LDA     #13
001287  2  20 ED 12             JSR     WRSER1          ; output upper nybble
00128A  2  A9 0A                LDA     #10
00128C  2  20 ED 12             JSR     WRSER1          ; output upper nybble
00128F  2  AE EA 12             LDX     TTX
001292  2  AC EB 12             LDY     TTY
001295  2  AD EC 12             LDA     TTA
