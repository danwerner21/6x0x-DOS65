001349  3  B0 1F                BCS     DOS65LOAD_ERR1  ; Error?, if so abort
00134B  3  A2 0D                LDX     #13             ;
00134D  3  20 85 12             JSR     PEM             ;
001350  3  A9 00                LDA     #0              ; clear
001352  3  8D B9 16             STA     FCB+32          ; record number
001355  3  A9 99                LDA     #<FCB           ; Open File
001357  3  A0 16                LDY     #>FCB           ;
001359  3  A2 0F                LDX     #15             ;
00135B  3  20 85 12             JSR     PEM             ;
00135E  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
001360  3  D0 0B                BNE     DOS65LOAD_1     ;
001362  3               DOS65LOAD_ERR:
001362  3  A2 26                LDX     #$26            ; IO ERROR
001364  3  20 E4 1F             JSR     LAB_XERR
001367  3  4C BC 20             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
00136A  3               DOS65LOAD_ERR1:
00136A  3  4C CA 25             JMP     LAB_REM         ; comment out the remainder of the line (if any)
00136D  3               DOS65LOAD_1:
00136D  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
00136F  3  85 22                STA     FCBPTR+2        ; point to base of RAM
001371  3  8D 40 14             STA     EndOfBas        ;
001374  3  A5 7A                LDA     <Smemh          ;
001376  3  85 23                STA     FCBPTR+3        ;
001378  3  8D 41 14             STA     EndOfBas+1      ;
00137B  3  A9 54                LDA     #<FCBBUFFER     ; SETUP BUFFER
00137D  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
00137F  3  A0 3F                LDY     #>FCBBUFFER     ;
001381  3  84 21                STY     FCBPTR+1        ; STORE DEST BUFFER IN FCBPTR
001383  3  A2 1A                LDX     #26             ; Setup Buffer
001385  3  20 85 12             JSR     PEM             ;
001388  3  4C C6 13             JMP     DOS65LOAD_3C
00138B  3               DOS65LOAD_3:
00138B  3  B1 20                LDA     (FCBPTR),Y      ; load from BUFFER
00138D  3  91 22                STA     (FCBPTR+2),Y    ; save to RAM
00138F  3  EE 40 14             INC     EndOfBas
001392  3  D0 03                BNE     :+
001394  3  EE 41 14             INC     EndOfBas+1
001397  3               :
001397  3  C9 00                CMP     #$00
001399  3  D0 0D                BNE     :+
00139B  3  EE 42 14             INC     NullCounter
00139E  3  AD 42 14             LDA     NullCounter
0013A1  3  C9 03                CMP     #3
0013A3  3  D0 08                BNE     :++
0013A5  3  4C D9 13             JMP     DOS65LOAD_4
0013A8  3               :
0013A8  3  A9 00                LDA     #$00
0013AA  3  8D 42 14             STA     NullCounter
0013AD  3               :
0013AD  3  C8                   INY                     ; bump index
0013AE  3  C0 80                CPY     #$80            ; end of buffer?
0013B0  3  D0 D9                BNE     DOS65LOAD_3     ; no, loop
0013B2  3  18                   CLC                     ;
0013B3  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
0013B5  3  69 80                ADC     #$80            ;
0013B7  3  85 22                STA     FCBPTR+2        ;
0013B9  3  90 0B                BCC     DOS65LOAD_3C    ; is carry?, no SKIP
0013BB  3  18                   CLC                     ; yes, carry, inc high byte
0013BC  3  A5 23                LDA     FCBPTR+3        ;
0013BE  3  69 01                ADC     #$01            ;
0013C0  3  85 23                STA     FCBPTR+3        ;
0013C2  3  C9 B8                CMP     #>Ram_top       ; are we at the end of RAM?
0013C4  3  F0 13                BEQ     DOS65LOAD_4
0013C6  3               
0013C6  3               DOS65LOAD_3C:
0013C6  3  A9 99                LDA     #<FCB           ; READ record buffer from disk file
0013C8  3  A0 16                LDY     #>FCB           ;
0013CA  3  A2 14                LDX     #20             ;
0013CC  3  20 85 12             JSR     PEM             ;
0013CF  3  A0 00                LDY     #$00            ; RESET INDEX
0013D1  3  C9 00                CMP     #$00            ; is error or EOF
0013D3  3  F0 B6                BEQ     DOS65LOAD_3     ;
0013D5  3  C9 01                CMP     #$01            ; EOF?
0013D7  3  D0 89                BNE     DOS65LOAD_ERR   ; ERROR, do error handling
0013D9  3               DOS65LOAD_4:
0013D9  3  A9 99                LDA     #<FCB           ;
0013DB  3  A0 16                LDY     #>FCB           ;
0013DD  3  A2 10                LDX     #16             ;
0013DF  3  20 85 12             JSR     PEM             ;
0013E2  3                                               ; setup pointers to return to basic
0013E2  3  AD 40 14             LDA     EndOfBas
0013E5  3  85 7B                STA     Svarl
0013E7  3  85 7D                STA     Sarryl
0013E9  3  85 7F                STA     Earryl
0013EB  3  AD 41 14             LDA     EndOfBas+1
0013EE  3  85 7C                STA     Svarh
0013F0  3  85 7E                STA     Sarryh
0013F2  3  85 80                STA     Earryh
0013F4  3  A9 5C                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
0013F6  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
0013F8  3  20 71 27             JSR     LAB_18C3
0013FB  3  4C BC 20             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
