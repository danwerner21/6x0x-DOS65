001209  2  A9 0D                LDA     #13
00120B  2  20 71 12             JSR     WRSER1          ; output upper nybble
00120E  2  A9 0A                LDA     #10
001210  2  20 71 12             JSR     WRSER1          ; output upper nybble
001213  2  AE 6E 12             LDX     TTX
001216  2  AC 6F 12             LDY     TTY
001219  2  AD 70 12             LDA     TTA
