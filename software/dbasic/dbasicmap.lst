001598  3  85 97                STA     Lvarpl          ; save var address low byte
00159A  3  84 98                STY     Lvarph          ; save var address high byte
00159C  3  A5 5F                LDA     <Dtypef         ; IS IT A STRING?
00159E  3  D0 08                BNE     :+              ; YES, CONTINUE ON
0015A0  3  A2 02                LDX     #$02            ; NOPE, SYNTAX ERROR
0015A2  3  20 77 23             JSR     LAB_XERR
0015A5  3  4C 4F 24             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
