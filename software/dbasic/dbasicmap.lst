001C2F  3                                               ; PTEMPW1(Y*35) = PTEMPW1(Y*32)+PTEMPW2(Y*2)+PTEMPW3(Y)
001C2F  3  18                   CLC                     ; Clear the Carry flag before the first addition
001C30  3  AD DE 16             LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
001C33  3  6D E0 16             ADC     PTEMPW2         ; Add the low byte of the second number (plus carry)
001C36  3  8D DE 16             STA     PTEMPW1         ; Store the low byte of the result
001C39  3               
001C39  3  AD DF 16             LDA     PTEMPW1+1       ; Load the high byte of the first number
001C3C  3  6D E1 16             ADC     PTEMPW2+1       ; Add the high byte of the second number (plus carry from previous op)
001C3F  3  8D DF 16             STA     PTEMPW1+1       ; Store the high byte of the result
001C42  3  18                   CLC                     ; Clear the Carry flag before the first addition
001C43  3  AD DE 16             LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
001C46  3  6D E2 16             ADC     PTEMPW3         ; Add the low byte of the second number (plus carry)
001C49  3  8D DE 16             STA     PTEMPW1         ; Store the low byte of the result
001C4C  3               
001C4C  3  AD DF 16             LDA     PTEMPW1+1       ; Load the high byte of the first number
001C4F  3  6D E3 16             ADC     PTEMPW3+1       ; Add the high byte of the second number (plus carry from previous op)
001C52  3  8D DF 16             STA     PTEMPW1+1       ; Store the high byte of the result
001C55  3                                               ;
001C55  3                                               ; PTEMPW1 IS NOW THE Y OFFSET
001C55  3                                               ; if quad hires double it.
001C55  3  AD D9 16             LDA     VIDEOMODE
001C58  3  29 10                AND     #$10
001C5A  3  C9 00                CMP     #00
001C5C  3  D0 06                BNE     :+
001C5E  3  0E DE 16             ASL     PTEMPW1
001C61  3  2E DF 16             ROL     PTEMPW1+1       ; *2
001C64  3               :
001C64  3                                               ; ADD THE X OFFSET
001C64  3  18                   CLC                     ; Clear the Carry flag before the first addition
001C65  3  AD DE 16             LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
001C68  3  6D DC 16             ADC     PTEMPW          ; Add the low byte of the second number (plus carry)
001C6B  3  85 FD                STA     TEMPW           ; Store the low byte of the result
001C6D  3               
001C6D  3  AD DF 16             LDA     PTEMPW1+1       ; Load the high byte of the first number
001C70  3  6D DD 16             ADC     PTEMPW+1        ; Add the high byte of the second number (plus carry from previous op)
001C73  3  85 FE                STA     TEMPW+1         ; Store the high byte of the result
001C75  3                                               ; TEMPW IS NOW THE MEMORY ADDRESS
001C75  3               
001C75  3  A5 FE                LDA     TEMPW+1         ; OK, LET'S CALCULATE THE BANK
001C77  3  29 F0                AND     #$F0
001C79  3  4A                   LSR     A
001C7A  3  4A                   LSR     A
001C7B  3  4A                   LSR     A
001C7C  3  4A                   LSR     A
001C7D  3  18                   CLC
001C7E  3  69 FA                ADC     #$02+VIDEOBANK  ; AREA $2000-?
001C80  3  C9 F8                CMP     #$F8
001C82  3  90 32                BCC     V_PLOT_HIRES_COLOR_RANGE1
001C84  3  A8                   TAY                     ; VIDEO BANK SHOULD BE IN Y
001C85  3  20 D2 19             JSR     PAGE_ENTER
001C88  3  A5 FE                LDA     TEMPW+1
001C8A  3  29 0F                AND     #$0F
001C8C  3  09 A0                ORA     #$A0
001C8E  3  85 FE                STA     TEMPW+1         ; TEMPW NOW REFLECTS MAPPED ADDRESSS
001C90  3  68                   PLA
001C91  3  29 07                AND     #$07            ; WHICH BIT?
001C93  3  AA                   TAX
001C94  3  AD E5 16             LDA     PTEMP4
001C97  3  C9 01                CMP     #$01
001C99  3  D0 0D                BNE     :+
001C9B  3  BD B9 1C             LDA     HIRES_BIT_LOOKUP_SET,X
001C9E  3  A0 00                LDY     #$00
001CA0  3  11 FD                ORA     (TEMPW),Y
001CA2  3  91 FD                STA     (TEMPW),Y
001CA4  3  20 CC 19             JSR     PAGE_EXIT
001CA7  3  60                   RTS
001CA8  3               :
001CA8  3  BD C1 1C             LDA     HIRES_BIT_LOOKUP_RESET,X
001CAB  3  48                   PHA
001CAC  3  A0 00                LDY     #$00
001CAE  3  31 FD                AND     (TEMPW),Y
001CB0  3  91 FD                STA     (TEMPW),Y
001CB2  3  20 CC 19             JSR     PAGE_EXIT
001CB5  3  60                   RTS
001CB6  3               V_PLOT_HIRES_COLOR_RANGE1:
001CB6  3  4C 6B 35             JMP     LAB_2564
001CB9  3               HIRES_BIT_LOOKUP_SET:
001CB9  3  80 40 20 10          .BYTE   %10000000,%01000000,%00100000,%00010000,%00001000,%00000100,%00000010,%00000001
001CBD  3  08 04 02 01  
001CC1  3               HIRES_BIT_LOOKUP_RESET:
001CC1  3  7F BF DF EF          .BYTE   %01111111,%10111111,%11011111,%11101111,%11110111,%11111011,%11111101,%11111110
001CC5  3  F7 FB FD FE  
001CC9  3               
001CC9  3               ;___V_PATTERN________________________________________________
001CC9  3               ;
001CC9  3               ;  DEFINE GRAPHICS PATTERN
001CC9  3               ;
001CC9  3               ;  TAKES 10 PARAMETERS
001CC9  3               ;       PATTERN NUM (0-255)
001CC9  3               ;       PATTERN DATA (8 BYTES)
001CC9  3               ;__________________________________________________________
001CC9  3               LAB_PATTERN
001CC9  3               V_PATTERN:
001CC9  3  20 2C 33             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X
001CCC  3  8A                   TXA
001CCD  3  48                   PHA
001CCE  3  A0 F8                LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001CD0  3  20 D2 19             JSR     PAGE_ENTER
001CD3  3  68                   PLA
001CD4  3  8D 02 A0             STA     VideoCharGenOffset
001CD7  3  A0 08                LDY     #8
001CD9  3               :
001CD9  3  98                   TYA
001CDA  3  48                   PHA
001CDB  3  20 9B 2A             JSR     LAB_1C01        ; GET THE NEXT PARAMETER (AFTER ',') OR SYN ERR
001CDE  3  20 2C 33             JSR     LAB_GTBY        ; GET THE NEXT PARAMETER, RETURN IN X
001CE1  3  68                   PLA
001CE2  3  A8                   TAY
001CE3  3  8A                   TXA
001CE4  3  8D 03 A0             STA     VideoCharGenData
001CE7  3  88                   DEY
001CE8  3  C0 00                CPY     #$00
001CEA  3  D0 ED                BNE     :-
001CEC  3  20 CC 19             JSR     PAGE_EXIT
001CEF  3  60                   RTS
001CF0  3               
001CF0  3               
001CF0  3               LAB_LINE:
001CF0  3  60                   RTS
001CF1  3                       .ELSE
001CF1  3               
001CF1  3               
001CF1  3               ; ENSURE ALL OF THESE SPECIAL COMMANDS GIVE ERRORS IN NORMAL BASIC
001CF1  3               LAB_SPEEK:
001CF1  3               LAB_SPOKE:
001CF1  3               LAB_SCRCLR:
001CF1  3               LAB_SCREEN:
001CF1  3               LAB_PATTERN:
001CF1  3               LAB_PLOT:
001CF1  3               LAB_LOCATE:
001CF1  3               LAB_COLOR:
001CF1  3               LAB_LINE:
001CF1  3                       LDX     #$02            ; error code $02 ("SYNTAX" error)
001CF1  3                       JMP     LAB_XERR        ; do error #X, then warm start
001CF1  3               
001CF1  3                       .ENDIF
