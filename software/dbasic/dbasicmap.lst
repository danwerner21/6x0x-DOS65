001235  2               
001235  2               
001235  2               PRINT_BYTE:
001235  2  8E 6E 12             STX     TTX
001238  2  8C 6F 12             STY     TTY
00123B  2  8D 70 12             STA     TTA
00123E  2  8E 6D 12             STX     SAVX            ; save X
001241  2  20 58 12             JSR     ASCTWO          ; get hex chars for byte in X (lower) and A (upper)
001244  2  20 71 12             JSR     WRSER1          ; output upper nybble
001247  2  8A                   TXA                     ; transfer lower to A
001248  2  AE 6D 12             LDX     SAVX            ; restore X
00124B  2  20 71 12             JSR     WRSER1          ; output lower nybble
00124E  2  AE 6E 12             LDX     TTX
001251  2  AC 6F 12             LDY     TTY
001254  2  AD 70 12             LDA     TTA
001257  2  60                   RTS
001258  2               ASCTWO:
001258  2  48                   PHA                     ; save byte
001259  2  20 62 12             JSR     ASCII           ; do low nybble
00125C  2  AA                   TAX                     ; save in X
00125D  2  68                   PLA                     ; restore byte
00125E  2  4A                   LSR     A               ; shift upper nybble down
00125F  2  4A                   LSR     A
001260  2  4A                   LSR     A
001261  2  4A                   LSR     A
001262  2               ; convert low nybble in A to hex digit
001262  2               ASCII:
001262  2  29 0F                AND     #$0F            ; clear upper nibble
001264  2  C9 0A                CMP     #$0A            ; if less than A, skip next step
001266  2  90 02                BCC     ASC1
001268  2  69 06                ADC     #6              ; skip ascii chars between 9 and A
00126A  2               ASC1:
00126A  2  69 30                ADC     #$30            ; add ascii char 0 to value
00126C  2  60                   RTS
00126D  2               SAVX:
