0016E5  3               ;* MEMORY MAP
0016E5  3               ;  VIDEO CARD IS A 32K AREA (MAPPED IN BANKS TO $AXXX)
0016E5  3               ;  $0x00 0x01=soft_scanline_emulation, 0x02 NO soft_scanline_emulation
0016E5  3               ;  $0x01 0x01=page1, 0x02 page2
0016E5  3               ;  $0x02  character generator write offset (data << 3)
0016E5  3               ;  $0x03 character generator write DATA
0016E5  3               ;  $0x04 EXECUTE device command
0016E5  3               ;        0x00- reset to the default configuration
0016E5  3               ;        0x01- reset to the saved configuration
0016E5  3               ;	0x02- save the current configuration
0016E5  3               ;
0016E5  3               ;  $0x05  0x01=soft_text=true, 0x02=soft_text=false
0016E5  3               ;  $0x06 Lores Mode=0X01,NO lores Mode=0x02
0016E5  3               ;  $0x07 Double Lores Mode=0X01,NO Double lores Mode=0x02
0016E5  3               ;  $0x08 Hires Mode=0X01,NO Hires Mode=0x02
0016E5  3               ;  $0x09 Double Hires Mode=0X01,NO Double Hires lores Mode=0x02
0016E5  3               ;  $0x0A 80COL Mode=0X01,NO 80COL Mode=0x02
0016E5  3               ;  $0x0B MIXED Mode=0X01,NO MIXED Mode=0x02
0016E5  3               ;  $0x0C QUAD Hires Mode=0X01,NO QUAD Hires lores Mode=0x02
0016E5  3               ;  $0x0D MONO Hires Mode=0X01,NO MONO Hires lores Mode=0x02
