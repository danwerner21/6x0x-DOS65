001DFB  3  A9 33                LDA     #51
001DFD  3  85 32                STA     farfunct
001DFF  3  20 F0 FF             JSR     DO_FARCALL
001E02  3  98                   TYA
001E03  3               
001E03  3  20 94 1E             JSR     BCD_TO_HEX
001E06  3  A8                   TAY
001E07  3  A9 00                LDA     #0              ; Get high byte
