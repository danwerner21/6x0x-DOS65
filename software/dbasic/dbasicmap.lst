0011B3  2                                               ; TEMPW  = Y*8 + Y*32  (Y*40)
0011B3  2  18                   CLC                     ; Clear the Carry flag before the first addition
0011B4  2  AD FA 16             LDA     PTEMPW          ; Load the low byte of the first number into the accumulator
0011B7  2  6D FC 16             ADC     PTEMPW1         ; Add the low byte of the second number (plus carry)
0011BA  2  85 FD                STA     TEMPW           ; Store the low byte of the result
0011BC  2  AD FB 16             LDA     PTEMPW+1        ; Load the high byte of the first number
0011BF  2  6D FD 16             ADC     PTEMPW1+1       ; Add the high byte of the second number (plus carry from previous op)
0011C2  2  85 FE                STA     TEMPW+1         ; Store the high byte of the result
