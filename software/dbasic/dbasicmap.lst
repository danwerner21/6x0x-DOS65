001EE6  3  A5 11                LDA     Itempl
001EE8  3  8D E5 18             STA     LINEX2
001EEB  3                                               ; GET Y2
001EEB  3  20 93 2E             JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
001EEE  3  20 24 37             JSR     LAB_GTBY        ; RETURN IN X
001EF1  3  8E E7 18             STX     LINEY2          ; STORE IN LINEY2
001EF4  3                                               ; GET COLOR
001EF4  3  20 93 2E             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001EF7  3  20 24 37             JSR     LAB_GTBY        ; RETURN IN X
001EFA  3  8E E0 18             STX     LINECOLOR       ; STORE IN COLOR
001EFD  3  A9 00                LDA     #$00
001EFF  3  8D E4 18             STA     LINEY1+1
001F02  3  8D E8 18             STA     LINEY2+1
001F05  3                                               ; LINE COORDS AND COLOR STORED IN PROPER PLACE
001F05  3                                               ; CALCULATE DELTAX
001F05  3  38                   SEC                     ; Set Carry flag (represents "no borrow" for 1st byte)
001F06  3  AD E1 18             LDA     LINEX1          ; Load low byte of number 1
001F09  3  ED E5 18             SBC     LINEX2          ; Subtract low byte of number 2 with carry
001F0C  3  8D E9 18             STA     DELTAX          ; Store result low byte
001F0F  3  AD E2 18             LDA     LINEX1+1        ; Load high byte of number 1
001F12  3  ED E6 18             SBC     LINEX2+1        ; Subtract high byte of number 2 with borrow
001F15  3  8D EA 18             STA     DELTAX+1        ; Store result high byte
001F18  3  B0 20                BCS     :+              ; BRANCH IF X1>=X2
001F1A  3                                               ; X1 < X2
001F1A  3  A9 00                LDA     #0
001F1C  3  8D F1 18             STA     PTEMP           ; IF X2>X1 (PTEMP=x0)
001F1F  3  A9 FF                LDA     #$FF            ; TAKE ABSOLUTE VALUE OF DELTAX
001F21  3  4D EA 18             EOR     DELTAX+1        ; Invert high byte (one's complement)
001F24  3  8D EA 18             STA     DELTAX+1
001F27  3  A9 FF                LDA     #$FF            ;
001F29  3  4D E9 18             EOR     DELTAX          ; Invert low byte
001F2C  3  8D E9 18             STA     DELTAX          ;
001F2F  3  EE E9 18             INC     DELTAX          ; Add 1 to the low byte
001F32  3  D0 0B                BNE     :++             ; If no carry from low byte INC, we are done
001F34  3  EE EA 18             INC     DELTAX+1        ; Increment high byte if carry occurred
001F37  3  4C 3F 1F             JMP     :++
001F3A  3               :
001F3A  3  A9 01                LDA     #1
001F3C  3  8D F1 18             STA     PTEMP           ; IF X1>X2 (PTEMP=x1)
001F3F  3               :
001F3F  3                                               ; CALCULATE DELTAY
001F3F  3  A9 00                LDA     #0
001F41  3  8D EC 18             STA     DELTAY+1
001F44  3  38                   SEC                     ; Set Carry flag
001F45  3  AD E3 18             LDA     LINEY1          ; Load low byte of number 1
001F48  3  ED E7 18             SBC     LINEY2          ; Subtract low byte of number 2 with carry
001F4B  3  8D EB 18             STA     DELTAY          ; Store result low byte
001F4E  3  B0 16                BCS     :+              ; BRANCH IF Y1>=Y2
001F50  3                                               ; Y1 < Y2
001F50  3  AD F1 18             LDA     PTEMP
001F53  3  29 01                AND     #1
001F55  3  8D F1 18             STA     PTEMP           ; IF Y2>Y1 (PTEMP=0x)
001F58  3                                               ; TAKE ABSOLUTE VALUE OF DELTAY
001F58  3  A9 FF                LDA     #$FF
001F5A  3  4D EB 18             EOR     DELTAY          ; Flip all bits (one's complement)
001F5D  3  8D EB 18             STA     DELTAY
001F60  3  EE EB 18             INC     DELTAY          ; Add 1 (two's complement)
001F63  3  4C 6E 1F             JMP     :++
001F66  3               :
001F66  3  AD F1 18             LDA     PTEMP
001F69  3  09 10                ORA     #$10
001F6B  3  8D F1 18             STA     PTEMP           ; IF Y1>Y2 (PTEMP=1x)
001F6E  3               :
001F6E  3                                               ; SLOPE DETERMINED, AND DELTAS CALCULATED
001F6E  3                                               ; OK, LET'S FIND OUT IF THIS IS A HORIZONTAL-ISH
001F6E  3                                               ; OR VERTICAL-ISH LINE
001F6E  3  38                   SEC                     ; Set Carry Flag (for subtraction)
001F6F  3  AD E9 18             LDA     DELTAX          ; Load low byte of DELTAX
001F72  3  ED EB 18             SBC     DELTAY          ; Subtract low byte of DELTAY
001F75  3  AD EA 18             LDA     DELTAX+1        ; Load high byte of DELTAX
001F78  3  ED EC 18             SBC     DELTAY+1        ; Subtract high byte of DELTAY (with borrow)
001F7B  3                                               ; Flags now reflect the 16-bit comparison
001F7B  3  90 03                BCC     LINEVERT        ; If Carry clear, LINE IS VERTICAL-ISH
001F7D  3  4C 16 20             JMP     LINEHORZ
001F80  3               LINEVERT:
001F80  3                                               ; FOR A VERTICAL-ISH LINE WE STEP ALONG THE
001F80  3                                               ; Y AXIS (STEEP GRADIENT)
001F80  3                                               ; FIND LARGER Y . . .
001F80  3  AD E3 18             LDA     LINEY1
001F83  3  CD E7 18             CMP     LINEY2
001F86  3  B0 03                BCS     :+
001F88  3  20 AD 20             JSR     LINESWAPXY
001F8B  3               :
001F8B  3                                               ; Initialize error = DELTAY / 2
001F8B  3  AD EB 18             LDA     DELTAY
001F8E  3  8D F2 18             STA     LINEERR
001F91  3  AD EC 18             LDA     DELTAY+1
001F94  3  8D F3 18             STA     LINEERR+1
001F97  3  4E F3 18             LSR     LINEERR+1
001F9A  3  6E F2 18             ROR     LINEERR
001F9D  3               LINEVERTLOOP:
001F9D  3  AD E3 18             LDA     LINEY1          ; OK LET'S PLOT A POINT
001FA0  3  8D DD 18             STA     PLOTY
001FA3  3  AD E4 18             LDA     LINEY1+1
001FA6  3  8D DE 18             STA     PLOTY+1
001FA9  3  AD E1 18             LDA     LINEX1
001FAC  3  8D DB 18             STA     PLOTX
001FAF  3  AD E2 18             LDA     LINEX1+1
001FB2  3  8D DC 18             STA     PLOTX+1
001FB5  3  AD E0 18             LDA     LINECOLOR
001FB8  3  8D DF 18             STA     PLOTCOLOR
001FBB  3  20 14 1C             JSR     DOPLOTXY
001FBE  3                                               ; NOW MOVE LINE1 CLOSER TO LINE2
001FBE  3  CE E3 18             DEC     LINEY1          ; BY STEPPING ALONG Y AXIS
001FC1  3               
001FC1  3                                               ; BRESENHAM: err -= DELTAX
001FC1  3  38                   SEC
001FC2  3  AD F2 18             LDA     LINEERR
001FC5  3  ED E9 18             SBC     DELTAX
001FC8  3  8D F2 18             STA     LINEERR
001FCB  3  AD F3 18             LDA     LINEERR+1
001FCE  3  ED EA 18             SBC     DELTAX+1
001FD1  3  8D F3 18             STA     LINEERR+1
001FD4  3  10 37                BPL     LINEVERT_NOSTEP ; IF ERR >= 0, NO X STEP NEEDED
001FD6  3                                               ; ERR += DELTAY (RESTORE ERROR)
001FD6  3  18                   CLC
001FD7  3  AD F2 18             LDA     LINEERR
001FDA  3  6D EB 18             ADC     DELTAY
001FDD  3  8D F2 18             STA     LINEERR
001FE0  3  AD F3 18             LDA     LINEERR+1
001FE3  3  6D EC 18             ADC     DELTAY+1
001FE6  3  8D F3 18             STA     LINEERR+1
001FE9  3                                               ; STEP X TOWARD X2 (16-BIT)
001FE9  3  AD E5 18             LDA     LINEX2
001FEC  3  CD E1 18             CMP     LINEX1
001FEF  3  AD E6 18             LDA     LINEX2+1
001FF2  3  ED E2 18             SBC     LINEX1+1
001FF5  3  90 0B                BCC     LINEVERT_DECX   ; X2 < X1, DECREMENT X1
001FF7  3  EE E1 18             INC     LINEX1          ; X2 >= X1, INCREMENT X1
001FFA  3  D0 11                BNE     LINEVERT_NOSTEP
001FFC  3  EE E2 18             INC     LINEX1+1
001FFF  3  4C 0D 20             JMP     LINEVERT_NOSTEP
002002  3               LINEVERT_DECX:
002002  3  AD E1 18             LDA     LINEX1
002005  3  D0 03                BNE     :+
002007  3  CE E2 18             DEC     LINEX1+1
00200A  3  CE E1 18     :       DEC     LINEX1
00200D  3               LINEVERT_NOSTEP:
00200D  3               
00200D  3  AD E3 18             LDA     LINEY1
002010  3  CD E7 18             CMP     LINEY2
002013  3  D0 88                BNE     LINEVERTLOOP
002015  3  60                   RTS                     ; DONE
002016  3               
002016  3               LINEHORZ:
002016  3               ; FOR A HORIZONTAL-ISH LINE WE STEP ALONG THE
002016  3               ; X AXIS (SHALLOW GRADIENT)
002016  3               ; FIND LARGER X . . .
002016  3  38                   SEC                     ; Set carry flag for subtraction
002017  3  AD E5 18             LDA     LINEX2          ; Load low byte of first number
00201A  3  ED E1 18             SBC     LINEX1          ; Subtract low byte of second number
00201D  3  AD E6 18             LDA     LINEX2+1        ; Load high byte of first number
002020  3  ED E2 18             SBC     LINEX1+1        ; Subtract high byte of second number
002023  3                                               ; Result flags (N, Z, C) now reflect: Val1 - Val2
002023  3  B0 03                BCS     :+              ; If carry is set, LINEX2 >= LINEX1
002025  3  20 AD 20             JSR     LINESWAPXY
002028  3               :
002028  3                                               ; Initialize error = DELTAX / 2
002028  3  AD E9 18             LDA     DELTAX
00202B  3  8D F2 18             STA     LINEERR
00202E  3  AD EA 18             LDA     DELTAX+1
002031  3  8D F3 18             STA     LINEERR+1
002034  3  4E F3 18             LSR     LINEERR+1
002037  3  6E F2 18             ROR     LINEERR
00203A  3               LINEHORZLOOP:
00203A  3  AD E3 18             LDA     LINEY1          ; OK LET'S PLOT A POINT
00203D  3  8D DD 18             STA     PLOTY
002040  3  AD E4 18             LDA     LINEY1+1
002043  3  8D DE 18             STA     PLOTY+1
002046  3  AD E1 18             LDA     LINEX1
002049  3  8D DB 18             STA     PLOTX
00204C  3  AD E2 18             LDA     LINEX1+1
00204F  3  8D DC 18             STA     PLOTX+1
002052  3  AD E0 18             LDA     LINECOLOR
002055  3  8D DF 18             STA     PLOTCOLOR
002058  3  20 14 1C             JSR     DOPLOTXY
00205B  3                                               ; NOW MOVE LINE1 CLOSER TO LINE2
00205B  3  EE E1 18             INC     LINEX1          ; BY STEPPING ALONG X AXIS
00205E  3  D0 03                BNE     :+
002060  3  EE E2 18             INC     LINEX1+1
002063  3               :
002063  3                                               ; BRESENHAM: err -= DELTAY
002063  3  38                   SEC
002064  3  AD F2 18             LDA     LINEERR
002067  3  ED EB 18             SBC     DELTAY
00206A  3  8D F2 18             STA     LINEERR
00206D  3  AD F3 18             LDA     LINEERR+1
002070  3  ED EC 18             SBC     DELTAY+1
002073  3  8D F3 18             STA     LINEERR+1
002076  3  10 24                BPL     LINEHORZ_NOSTEP ; IF ERR >= 0, NO Y STEP NEEDED
002078  3                                               ; ERR += DELTAX (RESTORE ERROR)
002078  3  18                   CLC
002079  3  AD F2 18             LDA     LINEERR
00207C  3  6D E9 18             ADC     DELTAX
00207F  3  8D F2 18             STA     LINEERR
002082  3  AD F3 18             LDA     LINEERR+1
002085  3  6D EA 18             ADC     DELTAX+1
002088  3  8D F3 18             STA     LINEERR+1
00208B  3                                               ; STEP Y TOWARD Y2
00208B  3  AD E7 18             LDA     LINEY2
00208E  3  CD E3 18             CMP     LINEY1
002091  3  90 06                BCC     LINEHORZ_DECY   ; Y2 < Y1, DECREMENT
002093  3  EE E3 18             INC     LINEY1          ; Y2 >= Y1, INCREMENT
002096  3  4C 9C 20             JMP     LINEHORZ_NOSTEP
002099  3               LINEHORZ_DECY:
002099  3  CE E3 18             DEC     LINEY1
00209C  3               LINEHORZ_NOSTEP:
00209C  3               
00209C  3  AD E1 18             LDA     LINEX1
00209F  3  CD E5 18             CMP     LINEX2
0020A2  3  D0 96                BNE     LINEHORZLOOP
0020A4  3  AD E2 18             LDA     LINEX1+1
0020A7  3  CD E6 18             CMP     LINEX2+1
0020AA  3  D0 8E                BNE     LINEHORZLOOP
0020AC  3  60                   RTS                     ; DONE
0020AD  3               
0020AD  3               LINESWAPXY:
0020AD  3  AD E1 18             LDA     LINEX1
0020B0  3  AC E5 18             LDY     LINEX2
0020B3  3  8C E1 18             STY     LINEX1
0020B6  3  8D E5 18             STA     LINEX2
0020B9  3  AD E2 18             LDA     LINEX1+1
0020BC  3  AC E6 18             LDY     LINEX2+1
0020BF  3  8C E2 18             STY     LINEX1+1
0020C2  3  8D E6 18             STA     LINEX2+1
0020C5  3               ;
0020C5  3  AD E3 18             LDA     LINEY1
0020C8  3  AC E7 18             LDY     LINEY2
0020CB  3  8C E3 18             STY     LINEY1
0020CE  3  8D E7 18             STA     LINEY2
0020D1  3  AD E4 18             LDA     LINEY1+1
0020D4  3  AC E8 18             LDY     LINEY2+1
0020D7  3  8C E4 18             STY     LINEY1+1
0020DA  3  8D E8 18             STA     LINEY2+1
0020DD  3  60                   RTS
0020DE  3                       .ELSE
0020DE  3               
0020DE  3               
0020DE  3               ; ENSURE ALL OF THESE SPECIAL COMMANDS GIVE ERRORS IN NORMAL BASIC
0020DE  3               LAB_SPEEK:
0020DE  3               LAB_SPOKE:
0020DE  3               LAB_SCRCLR:
0020DE  3               LAB_SCREEN:
0020DE  3               LAB_PATTERN:
0020DE  3               LAB_PLOT:
0020DE  3               LAB_LOCATE:
0020DE  3               LAB_COLOR:
0020DE  3               LAB_LINE:
0020DE  3                       LDX     #$02            ; error code $02 ("SYNTAX" error)
0020DE  3                       JMP     LAB_XERR        ; do error #X, then warm start
0020DE  3               
0020DE  3                       .ENDIF
0020DE  3               
0020DE  2                       .INCLUDE "sid.asm"
0020DE  3               
0020DE  3               
0020DE  3                       .IFDEF  MEMORYMAPPEDSCREEN
0020DE  3               
0020DE  3               PC6502_IO       = $E000
0020DE  3               SID_BASE        = PC6502_IO+$100
0020DE  3               
0020DE  3               ;___SOUND__________________________________________________
0020DE  3               ;
0020DE  3               ; PLAY SOUND
0020DE  3               ;
0020DE  3               ;  SOUND VOICE, FREQ, DUTY, WAVEFORM, ATTACK, SUSTAIN, DECAY, RELEASE
0020DE  3               ;
0020DE  3               ;
0020DE  3               ;__________________________________________________________
0020DE  3               LAB_SOUND:
0020DE  3  20 24 37             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (VOICE)
0020E1  3  8A                   TXA
0020E2  3  29 03                AND     #3
0020E4  3  0A                   ASL     A
0020E5  3  AA                   TAX
0020E6  3  BD 60 21             LDA     SIDVOICELOOKUP,X
0020E9  3  85 FD                STA     TEMPW
0020EB  3  BD 61 21             LDA     SIDVOICELOOKUP+1,X
0020EE  3  85 FE                STA     TEMPW+1
0020F0  3                                               ; OK, TEMPW POINTS TO SID REGISTER TO MODIFY
0020F0  3  20 93 2E             JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
0020F3  3  20 61 2D             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
0020F6  3                                               ; else do type mismatch
0020F6  3  20 8A 37             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
0020F9  3  A0 00                LDY     #0              ; SET FREQUENCY
0020FB  3  A5 11                LDA     Itempl
0020FD  3  91 FD                STA     (TEMPW),Y
0020FF  3  A5 12                LDA     Itemph
002101  3  E8                   INX
002102  3  91 FD                STA     (TEMPW),Y
002104  3  20 93 2E             JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
002107  3  20 61 2D             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
00210A  3                                               ; else do type mismatch
00210A  3  20 8A 37             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
00210D  3  A0 02                LDY     #2              ; SET DUTY CYCLE
00210F  3  A5 11                LDA     Itempl
002111  3  91 FD                STA     (TEMPW),Y
002113  3  A5 12                LDA     Itemph
002115  3  C8                   INY
002116  3  91 FD                STA     (TEMPW),Y
002118  3  20 93 2E             JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
00211B  3  20 24 37             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (WAVEFORM)
00211E  3  8A                   TXA
00211F  3  A0 04                LDY     #4              ; SET WAVEFORM CYCLE
002121  3  91 FD                STA     (TEMPW),Y
002123  3  20 93 2E             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
002126  3  20 24 37             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (ATTACK)
002129  3  8A                   TXA
00212A  3  4A                   LSR     A
00212B  3  4A                   LSR     A
00212C  3  4A                   LSR     A
00212D  3  4A                   LSR     A
00212E  3  8D ED 18             STA     PTEMPW
002131  3  20 93 2E             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
002134  3  20 24 37             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (DECAY)
002137  3  8A                   TXA
002138  3  29 0F                AND     #$0F
00213A  3  0D ED 18             ORA     PTEMPW
00213D  3  A0 05                LDY     #5              ; SET ATTACK/DECAY
00213F  3  91 FD                STA     (TEMPW),Y
002141  3  20 93 2E             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
002144  3  20 24 37             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (SUSTAIN)
002147  3  8A                   TXA
002148  3  4A                   LSR     A
002149  3  4A                   LSR     A
00214A  3  4A                   LSR     A
00214B  3  4A                   LSR     A
00214C  3  8D ED 18             STA     PTEMPW
00214F  3  20 93 2E             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
002152  3  20 24 37             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (RELEASE)
002155  3  8A                   TXA
002156  3  29 0F                AND     #$0F
002158  3  0D ED 18             ORA     PTEMPW
00215B  3  A0 06                LDY     #6              ; SET SUSTAIN/RELEASE
00215D  3  91 FD                STA     (TEMPW),Y
00215F  3  60                   RTS
002160  3               SIDVOICELOOKUP:
002160  3  00 E1 07 E1          .WORD   SID_BASE,SID_BASE+7,SID_BASE+$12
002164  3  12 E1        
002166  3               
002166  3               ;___FILTER_________________________________________________
002166  3               ;
002166  3               ; SET SID FILTERS
002166  3               ;
002166  3               ;  FILTER CUTOFF, RESONANCE, VOICE 1 ENABLE, VOICE 2 ENABLE, VOICE 3 ENABLE, EXTERNAL ENABLE, FILTER MODE, VOLUME
002166  3               ;
002166  3               ;
002166  3               ;__________________________________________________________
002166  3               LAB_FILTER:
002166  3  20 61 2D             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
002169  3                                               ; else do type mismatch
002169  3  20 8A 37             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
00216C  3                                               ; SET CUTOFF
00216C  3  A5 11                LDA     Itempl
00216E  3  8D 15 E1             STA     SID_BASE+$15
002171  3  A5 12                LDA     Itemph
002173  3  8D 16 E1             STA     SID_BASE+$16
002176  3  20 93 2E             JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
002179  3  20 24 37             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (RESONANCE)
00217C  3  8A                   TXA
00217D  3  4A                   LSR     A
00217E  3  4A                   LSR     A
00217F  3  4A                   LSR     A
002180  3  4A                   LSR     A
002181  3  8D ED 18             STA     PTEMPW
002184  3  20 93 2E             JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
002187  3  20 24 37             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 1 ENABLE)
00218A  3  8A                   TXA
00218B  3  29 01                AND     #1
00218D  3  0D ED 18             ORA     PTEMPW
002190  3  8D ED 18             STA     PTEMPW
002193  3  20 93 2E             JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
002196  3  20 24 37             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 2 ENABLE)
002199  3  8A                   TXA
00219A  3  29 01                AND     #1
00219C  3  4A                   LSR     A
00219D  3  0D ED 18             ORA     PTEMPW
0021A0  3  8D ED 18             STA     PTEMPW
0021A3  3  20 93 2E             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
0021A6  3  20 24 37             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 3 ENABLE)
0021A9  3  8A                   TXA
0021AA  3  29 01                AND     #1
0021AC  3  4A                   LSR     A
0021AD  3  4A                   LSR     A
0021AE  3  0D ED 18             ORA     PTEMPW
0021B1  3  8D ED 18             STA     PTEMPW
0021B4  3  20 93 2E             JSR     LAB_1C01        ; GET THE SIXTH PARAMETER (AFTER ',') OR SYN ERR
0021B7  3  20 24 37             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (EXTERNAL AUDIO ENABLE)
0021BA  3  8A                   TXA
0021BB  3  29 01                AND     #1
0021BD  3  4A                   LSR     A
0021BE  3  4A                   LSR     A
0021BF  3  4A                   LSR     A
0021C0  3  0D ED 18             ORA     PTEMPW
0021C3  3  8D 17 E1             STA     SID_BASE+$17
0021C6  3  20 93 2E             JSR     LAB_1C01        ; GET THE SEVENTH PARAMETER (AFTER ',') OR SYN ERR
0021C9  3  20 24 37             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (FILTER MODE)
0021CC  3  8A                   TXA
0021CD  3  4A                   LSR     A
0021CE  3  4A                   LSR     A
0021CF  3  4A                   LSR     A
0021D0  3  4A                   LSR     A
0021D1  3  8D ED 18             STA     PTEMPW
0021D4  3  20 93 2E             JSR     LAB_1C01        ; GET THE EIGHTH PARAMETER (AFTER ',') OR SYN ERR
0021D7  3  20 24 37             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOLUME)
