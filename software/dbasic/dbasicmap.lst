001BD0  3                                               ; PARAMETERS PARSED, GO TO PROPER MODE CODE
001BD0  3  AD 94 18             LDA     VIDEOMODE
001BD3  3  29 0F                AND     #$0F
001BD5  3  C9 01                CMP     #$01
001BD7  3  F0 14                BEQ     V_PLOT_LORES
001BD9  3  AD 94 18             LDA     VIDEOMODE
001BDC  3  29 2F                AND     #$2F
001BDE  3  C9 02                CMP     #$02
