0012D1  3               ;___SAVE____________________________________________________
0012D1  3               ;
0012D1  3               ; SAVE COMMAND
0012D1  3               ;
0012D1  3               ;  SAVE THE BASIC PROGRAM IN MEMORY TO DISK
0012D1  3               ;
0012D1  3               ;__________________________________________________________
0012D1  3               V_SAVE: ; save BASIC program
0012D1  3               DOS65SAVE:
0012D1  3  20 46 14             JSR     DOS65FCBPREP    ; parse parameters into FCB
0012D4  3  B0 29                BCS     DOS65SAVE_ERR1  ; Error?, if so abort
0012D6  3  A2 0D                LDX     #13             ;
0012D8  3  20 CB 12             JSR     PEM             ;
0012DB  3  A9 EE                LDA     #<FCB           ; CREATE File
0012DD  3  A0 16                LDY     #>FCB           ;
0012DF  3  A2 16                LDX     #22             ;
0012E1  3  20 CB 12             JSR     PEM             ;
0012E4  3  A9 00                LDA     #0              ; clear
0012E6  3  8D 0E 17             STA     FCB+32          ; record number
0012E9  3  A9 EE                LDA     #<FCB           ; Open File
0012EB  3  A0 16                LDY     #>FCB           ;
0012ED  3  A2 0F                LDX     #15             ;
0012EF  3  20 CB 12             JSR     PEM             ;
0012F2  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
0012F4  3  D0 0C                BNE     DOS65SAVE_1     ;
0012F6  3               DOS65SAVE_ERR:
0012F6  3  A9 AB                LDA     #<FILEERROR2    ; NO, ERROR OUT
0012F8  3  A0 0F                LDY     #>FILEERROR2
0012FA  3  A2 09                LDX     #9              ; Print error message
0012FC  3  20 CB 12             JSR     PEM             ;
0012FF  3               DOS65SAVE_ERR1:
0012FF  3  4C 1F 26             JMP     LAB_REM         ; comment out the remainder of the line (if any)
001302  3               DOS65SAVE_1:
001302  3  A9 A9                LDA     #<FCBBUFFER     ; SETUP BUFFER
001304  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
001306  3  A0 3F                LDY     #>FCBBUFFER     ;
001308  3  84 21                STY     FCBPTR+1        ;
00130A  3  A2 1A                LDX     #26             ; Setup Buffer
00130C  3  20 CB 12             JSR     PEM             ;
00130F  3               DOS65SAVE_2:
00130F  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
001311  3  85 22                STA     FCBPTR+2        ; point to base of RAM
001313  3  A5 7A                LDA     <Smemh          ;
001315  3  85 23                STA     FCBPTR+3        ;
001317  3  A2 00                LDX     #$00            ; x=0 (null counter)
001319  3               DOS65SAVE_2A:
001319  3  A0 00                LDY     #$00            ; y=0 (Loop Index)
00131B  3               DOS65SAVE_3:
00131B  3  B1 22                LDA     (FCBPTR+2),Y    ; load from RAM
00131D  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
00131F  3  C9 00                CMP     #$00            ; is Zero?
001321  3  D0 1E                BNE     DOS65SAVE_3A    ; No, continue
001323  3  E8                   INX                     ; yes, bump Null Counter
001324  3  E0 03                CPX     #$03            ; Three nulls in a row?
001326  3  D0 1B                BNE     DOS65SAVE_3B    ; No, continue
001328  3                                               ; FINISH FILLING BUFFER WITH NULLS
001328  3               :
001328  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
00132A  3  C8                   INY                     ; bump index
00132B  3  C0 80                CPY     #$80            ; end of buffer?
00132D  3  D0 F9                BNE     :-              ; no, loop
00132F  3  A9 EE                LDA     #<FCB           ; Write record in buffer to disk file AND END
001331  3  A0 16                LDY     #>FCB           ;
001333  3  A2 15                LDX     #21             ;
001335  3  20 CB 12             JSR     PEM             ;
001338  3  29 FE                AND     #$FE            ; strip out extension
00133A  3  C9 00                CMP     #$00            ; is error
00133C  3  D0 B8                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
00133E  3  4C 6E 13             JMP     DOS65SAVE_4
001341  3               DOS65SAVE_3A:                   ;
001341  3  A2 00                LDX     #$00            ; prior char not null, reset null counter
001343  3               DOS65SAVE_3B:                   ;
001343  3  C8                   INY                     ; bump index
001344  3  C0 80                CPY     #$80            ; end of buffer?
001346  3  D0 D3                BNE     DOS65SAVE_3     ; no, loop
001348  3               DOS65SAVE_3C:
001348  3  A9 EE                LDA     #<FCB           ; Write record in buffer to disk file
00134A  3  A0 16                LDY     #>FCB           ;
00134C  3  A2 15                LDX     #21             ;
00134E  3  20 CB 12             JSR     PEM             ;
001351  3  29 FE                AND     #$FE            ; strip out extension
001353  3  C9 00                CMP     #$00            ; is error
001355  3  D0 9F                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
001357  3  18                   CLC                     ;
001358  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
00135A  3  69 80                ADC     #$80            ;
00135C  3  85 22                STA     FCBPTR+2        ;
00135E  3  90 B9                BCC     DOS65SAVE_2A    ; is carry?, no loop
001360  3  18                   CLC                     ; yes, carry, inc high byte
001361  3  A5 23                LDA     FCBPTR+3        ;
001363  3  69 01                ADC     #$01            ;
001365  3  85 23                STA     FCBPTR+3        ;
001367  3  C9 B8                CMP     #>Ram_top       ; are we at the end of RAM?
001369  3  F0 03                BEQ     DOS65SAVE_4
00136B  3  4C 19 13             JMP     DOS65SAVE_2A
00136E  3               DOS65SAVE_4:
00136E  3  A9 EE                LDA     #<FCB           ;
001370  3  A0 16                LDY     #>FCB           ;
001372  3  A2 10                LDX     #16             ;
001374  3  20 CB 12             JSR     PEM             ;
001377  3  C9 FF                CMP     #$FF            ;
001379  3  D0 03                BNE     DOS65SAVE_5     ;
00137B  3  4C F6 12             JMP     DOS65SAVE_ERR   ; ERROR, DISPLAY IT
00137E  3               DOS65SAVE_5:
00137E  3  A9 52                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
001380  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
001382  3  20 C6 27             JSR     LAB_18C3
001385  3  4C 11 21             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001388  3               
001388  3               ;___LOAD____________________________________________________
001388  3               ;
001388  3               ; LOAD COMMAND
001388  3               ;
001388  3               ;  LOAD A BASIC PROGRAM FROM DISK TO MEMORY
001388  3               ;
001388  3               ;__________________________________________________________
001388  3               V_LOAD: ; load BASIC program
001388  3               DOS65LOAD:
001388  3  A9 00                LDA     #$00
00138A  3  8D 90 14             STA     NullCounter
00138D  3  20 46 14             JSR     DOS65FCBPREP    ; parse parameters into FCB
001390  3  B0 20                BCS     DOS65LOAD_ERR1  ; Error?, if so abort
001392  3  A2 0D                LDX     #13             ;
001394  3  20 CB 12             JSR     PEM             ;
001397  3  A9 00                LDA     #0              ; clear
001399  3  8D 0E 17             STA     FCB+32          ; record number
00139C  3  A9 EE                LDA     #<FCB           ; Open File
00139E  3  A0 16                LDY     #>FCB           ;
0013A0  3  A2 0F                LDX     #15             ;
0013A2  3  20 CB 12             JSR     PEM             ;
0013A5  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
0013A7  3  D0 0C                BNE     DOS65LOAD_1     ;
0013A9  3               DOS65LOAD_ERR:
0013A9  3  A9 AB                LDA     #<FILEERROR2    ; NO, ERROR OUT
0013AB  3  A0 0F                LDY     #>FILEERROR2
0013AD  3  A2 09                LDX     #9              ; Print error message
0013AF  3  20 CB 12             JSR     PEM             ;
0013B2  3               DOS65LOAD_ERR1:
0013B2  3  4C 1F 26             JMP     LAB_REM         ; comment out the remainder of the line (if any)
0013B5  3               DOS65LOAD_1:
0013B5  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
0013B7  3  85 22                STA     FCBPTR+2        ; point to base of RAM
0013B9  3  8D 8E 14             STA     EndOfBas        ;
0013BC  3  A5 7A                LDA     <Smemh          ;
0013BE  3  85 23                STA     FCBPTR+3        ;
0013C0  3  8D 8F 14             STA     EndOfBas+1      ;
0013C3  3  A9 A9                LDA     #<FCBBUFFER     ; SETUP BUFFER
0013C5  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
0013C7  3  A0 3F                LDY     #>FCBBUFFER     ;
0013C9  3  84 21                STY     FCBPTR+1        ; STORE DEST BUFFER IN FCBPTR
0013CB  3  A2 1A                LDX     #26             ; Setup Buffer
0013CD  3  20 CB 12             JSR     PEM             ;
0013D0  3  4C 0E 14             JMP     DOS65LOAD_3C
0013D3  3               DOS65LOAD_3:
0013D3  3  B1 20                LDA     (FCBPTR),Y      ; load from BUFFER
0013D5  3  91 22                STA     (FCBPTR+2),Y    ; save to RAM
0013D7  3  EE 8E 14             INC     EndOfBas
0013DA  3  D0 03                BNE     :+
0013DC  3  EE 8F 14             INC     EndOfBas+1
0013DF  3               :
0013DF  3  C9 00                CMP     #$00
0013E1  3  D0 0D                BNE     :+
0013E3  3  EE 90 14             INC     NullCounter
0013E6  3  AD 90 14             LDA     NullCounter
0013E9  3  C9 03                CMP     #3
0013EB  3  D0 08                BNE     :++
0013ED  3  4C 21 14             JMP     DOS65LOAD_4
0013F0  3               :
0013F0  3  A9 00                LDA     #$00
0013F2  3  8D 90 14             STA     NullCounter
0013F5  3               :
0013F5  3  C8                   INY                     ; bump index
0013F6  3  C0 80                CPY     #$80            ; end of buffer?
0013F8  3  D0 D9                BNE     DOS65LOAD_3     ; no, loop
0013FA  3  18                   CLC                     ;
0013FB  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
0013FD  3  69 80                ADC     #$80            ;
0013FF  3  85 22                STA     FCBPTR+2        ;
001401  3  90 0B                BCC     DOS65LOAD_3C    ; is carry?, no SKIP
001403  3  18                   CLC                     ; yes, carry, inc high byte
001404  3  A5 23                LDA     FCBPTR+3        ;
001406  3  69 01                ADC     #$01            ;
001408  3  85 23                STA     FCBPTR+3        ;
00140A  3  C9 B8                CMP     #>Ram_top       ; are we at the end of RAM?
00140C  3  F0 13                BEQ     DOS65LOAD_4
00140E  3               
00140E  3               DOS65LOAD_3C:
00140E  3  A9 EE                LDA     #<FCB           ; READ record buffer from disk file
001410  3  A0 16                LDY     #>FCB           ;
001412  3  A2 14                LDX     #20             ;
001414  3  20 CB 12             JSR     PEM             ;
001417  3  A0 00                LDY     #$00            ; RESET INDEX
001419  3  C9 00                CMP     #$00            ; is error or EOF
00141B  3  F0 B6                BEQ     DOS65LOAD_3     ;
00141D  3  C9 01                CMP     #$01            ; EOF?
00141F  3  D0 88                BNE     DOS65LOAD_ERR   ; ERROR, do error handling
001421  3               DOS65LOAD_4:
001421  3  A9 EE                LDA     #<FCB           ;
001423  3  A0 16                LDY     #>FCB           ;
001425  3  A2 10                LDX     #16             ;
001427  3  20 CB 12             JSR     PEM             ;
00142A  3                                               ; setup pointers to return to basic
00142A  3  AD 8E 14             LDA     EndOfBas
00142D  3  85 7B                STA     Svarl
00142F  3  85 7D                STA     Sarryl
001431  3  85 7F                STA     Earryl
001433  3  AD 8F 14             LDA     EndOfBas+1
001436  3  85 7C                STA     Svarh
001438  3  85 7E                STA     Sarryh
00143A  3  85 80                STA     Earryh
00143C  3  A9 52                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
00143E  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
001440  3  20 C6 27             JSR     LAB_18C3
001443  3  4C 11 21             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001446  3               
001446  3               
001446  3               
001446  3               DOS65FCBPREP:
001446  3                       .IFDEF  DUODYNE
001446  3                       JSL     LAB_GBYT        ; scan memory
001446  3                       .ELSE
001446  3  20 C2 00             JSR     LAB_GBYT        ; scan memory
001449  3                       .ENDIF
001449  3               
001449  3  38                   SEC                     ;
00144A  3  E9 40                SBC     #64             ; PARSE DRIVE NUMBER
00144C  3  8D EE 16             STA     DOSDRIVE        ; STORE IT IN FCB
00144F  3                       .IFDEF  DUODYNE
00144F  3                       JSL     LAB_IGBY        ; increment and scan memory
00144F  3                       .ELSE
00144F  3  20 BC 00             JSR     LAB_IGBY        ; increment and scan memory
001452  3                       .ENDIF
001452  3               
001452  3  C9 3A                CMP     #':'            ;
001454  3  F0 0E                BEQ     DOS65FCBPREP_1  ; YES, IT WAS A DRIVE, CONTINUE
001456  3  A9 80                LDA     #<FILEERROR1    ; NO, ERROR OUT
001458  3  A0 0F                LDY     #>FILEERROR1
00145A  3  A2 09                LDX     #9
00145C  3  20 CB 12             JSR     PEM
00145F  3  20 1F 26             JSR     LAB_REM
001462  3  38                   SEC
001463  3  60                   RTS
001464  3               DOS65FCBPREP_1:
001464  3  A9 EE                LDA     #<FCB           ; SETUP FCBPTR
001466  3  85 20                STA     FCBPTR          ;
001468  3  A9 16                LDA     #>FCB           ;
00146A  3  85 21                STA     FCBPTR+1        ;
00146C  3  A0 01                LDY     #$01            ; POINT Y TO FCB FILE NAME
00146E  3  A9 20                LDA     #$20            ; LOAD SPACE CHAR INTO A
001470  3               DOS65FCBPREP_1A:                ; BLANK OUT FCB
001470  3  91 20                STAINDIRECTY FCBPTR     ;
001472  3  C8                   INY                     ;
001473  3  C0 09                CPY     #$09            ; IS DONE
001475  3  D0 F9                BNE     DOS65FCBPREP_1A ; NO, LOOP
001477  3  A0 01                LDY     #$01            ; POINT Y TO FCB FILE NAME
001479  3               DOS65FCBPREP_2:                 ; COPY FILE NAME PARAMETER INTO FCB
001479  3                       .IFDEF  DUODYNE
001479  3                       JSL     LAB_IGBY        ; increment and scan memory
001479  3                       .ELSE
001479  3  20 BC 00             JSR     LAB_IGBY        ; increment and scan memory
00147C  3                       .ENDIF
00147C  3  F0 0E                BEQ     DOS65FCBPREP_3  ;
00147E  3  C9 2E                CMP     #'.'
001480  3  F0 0A                BEQ     DOS65FCBPREP_3  ;
001482  3  91 20                STAINDIRECTY FCBPTR     ;
001484  3  C8                   INY                     ;
001485  3  C0 09                CPY     #$09            ;
001487  3  F0 03                BEQ     DOS65FCBPREP_3  ;
001489  3  4C 79 14             JMP     DOS65FCBPREP_2  ;
00148C  3               DOS65FCBPREP_3:                 ;
00148C  3  18                   CLC
00148D  3  60                   RTS                     ;
