001200  2  AD 32 17             LDA     VIDEOWIDTH      ; If 80 col, double again
001203  2  C9 50                CMP     #80
001205  2  D0 04                BNE     :+
001207  2  06 FD                ASL     TEMPW
001209  2  26 FE                ROL     TEMPW+1         ; *2  (80)
00120B  2               :
00120B  2  A5 FE                LDA     TEMPW+1
00120D  2  09 A0                ORA     #$A0            ; add in the bank#
00120F  2  85 FE                STA     TEMPW+1
001211  2               
001211  2  A0 F9                LDY     #$01+VIDEOBANK  ; SCREEN AREA $1000-$1FFF
001213  2  20 29 1A             JSR     PAGE_ENTER
001216  2  A0 00                LDY     #0
001218  2               :
001218  2  B1 FD                LDA     (TEMPW),Y
00121A  2  99 81 40             STA     Ibuffs,Y
00121D  2  C8                   INY
00121E  2  CC 32 17             CPY     VIDEOWIDTH
001221  2  D0 F5                BNE     :-
001223  2               
001223  2  20 23 1A             JSR     PAGE_EXIT
001226  2  60                   RTS
001227  2  60                   RTS
001228  2               
001228  2                       .ENDIF
