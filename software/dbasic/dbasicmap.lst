001228  2  A9 20                LDA     #32
00122A  2  20 73 12             JSR     WRSER1          ; output upper nybble
00122D  2  AE 70 12             LDX     TTX
001230  2  AC 71 12             LDY     TTY
001233  2  AD 72 12             LDA     TTA
