0017E9  3  A0 00                LDY     #0
0017EB  3  B1 11                LDA     (Itempl),Y
0017ED  3  A8                   TAY
0017EE  3  A9 00                LDA     #$00
0017F0  3  8D E0 EF             STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 00
0017F3  3  4C 5B 2F             JMP     LAB_1FD0        ; convert Y to byte in FAC1 and return
