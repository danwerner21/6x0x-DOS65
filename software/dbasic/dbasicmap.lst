001A53  3  20 83 33             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X
001A56  3  8E 33 17             STX     PTEMPW          ; STORE X COORD IN OFFSET ADDRESS
001A59  3  A9 00                LDA     #00
001A5B  3  8D 34 17             STA     PTEMPW+1
