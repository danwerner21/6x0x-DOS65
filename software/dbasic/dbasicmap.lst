00199B  3               ;___V_SCREEN_________________________________________________
00199B  3               ;
00199B  3               ;  SET SCREEN MODE
00199B  3               ;
00199B  3               ;  TAKES UP TO THREE PARAMETERS
00199B  3               ;  FIRST PARAMETER SCREEN MODE
00199B  3               ;  0=TEXT MODE
00199B  3               ;  1=LORES MODE
00199B  3               ;  2=HIRES MODE
00199B  3               ;
00199B  3               ;  TEXT MODE PARAMETERS
00199B  3               ;  0=40 COLUMNS
00199B  3               ;  1=80 COLUMNS
00199B  3               ;
00199B  3               ;  LORES MODE SECOND PARAMETER
00199B  3               ;  0=SINGLE LORES
00199B  3               ;  1=DOUBLE LORES
00199B  3               ;  LORES MODE THIRD PARAMETER
00199B  3               ;  0=MIXED MODE
00199B  3               ;  1=FULL SCREEN MODE
00199B  3               ;
00199B  3               ;  HIRES MODE SECOND PARAMETER
00199B  3               ;  0=SINGLE HIRES
00199B  3               ;  1=DOUBLE HIRES
00199B  3               ;  2=QUAD HIRES
00199B  3               ;  3=MONO HIRES
00199B  3               ;  HIRES MODE THIRD PARAMETER
00199B  3               ;  1=MIXED MODE
00199B  3               ;  0=FULL SCREEN MODE
00199B  3               ;
00199B  3               ;__________________________________________________________
00199B  3               LAB_SCREEN:
00199B  3               V_SCREEN:
00199B  3  20 E0 36             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (MODE)
