00141F  3                       JSL     LAB_GBYT        ; scan memory
00141F  3                       .ELSE
00141F  3  20 C2 00             JSR     LAB_GBYT        ; scan memory
001422  3                       .ENDIF
001422  3               
001422  3  38                   SEC                     ;
001423  3  E9 40                SBC     #64             ; PARSE DRIVE NUMBER
001425  3  8D C7 16             STA     DOSDRIVE        ; STORE IT IN FCB
001428  3                       .IFDEF  DUODYNE
001428  3                       JSL     LAB_IGBY        ; increment and scan memory
001428  3                       .ELSE
001428  3  20 BC 00             JSR     LAB_IGBY        ; increment and scan memory
00142B  3                       .ENDIF
00142B  3               
00142B  3  C9 3A                CMP     #':'            ;
00142D  3  F0 0E                BEQ     DOS65FCBPREP_1  ; YES, IT WAS A DRIVE, CONTINUE
00142F  3  A9 93                LDA     #<FILEERROR1    ; NO, ERROR OUT
001431  3  A0 0F                LDY     #>FILEERROR1
001433  3  A2 09                LDX     #9
001435  3  20 A4 12             JSR     PEM
001438  3  20 FD 25             JSR     LAB_REM
00143B  3  38                   SEC
00143C  3  60                   RTS
00143D  3               DOS65FCBPREP_1:
00143D  3  A9 C7                LDA     #<FCB           ; SETUP FCBPTR
00143F  3  85 20                STA     FCBPTR          ;
001441  3  A9 16                LDA     #>FCB           ;
001443  3  85 21                STA     FCBPTR+1        ;
001445  3  A0 01                LDY     #$01            ; POINT Y TO FCB FILE NAME
001447  3  A9 20                LDA     #$20            ; LOAD SPACE CHAR INTO A
001449  3               DOS65FCBPREP_1A:                ; BLANK OUT FCB
001449  3  91 20                STAINDIRECTY FCBPTR     ;
00144B  3  C8                   INY                     ;
00144C  3  C0 09                CPY     #$09            ; IS DONE
00144E  3  D0 F9                BNE     DOS65FCBPREP_1A ; NO, LOOP
001450  3  A0 01                LDY     #$01            ; POINT Y TO FCB FILE NAME
001452  3               DOS65FCBPREP_2:                 ; COPY FILE NAME PARAMETER INTO FCB
001452  3                       .IFDEF  DUODYNE
001452  3                       JSL     LAB_IGBY        ; increment and scan memory
001452  3                       .ELSE
001452  3  20 BC 00             JSR     LAB_IGBY        ; increment and scan memory
001455  3                       .ENDIF
001455  3  F0 0E                BEQ     DOS65FCBPREP_3  ;
001457  3  C9 2E                CMP     #'.'
001459  3  F0 0A                BEQ     DOS65FCBPREP_3  ;
00145B  3  91 20                STAINDIRECTY FCBPTR     ;
00145D  3  C8                   INY                     ;
00145E  3  C0 09                CPY     #$09            ;
001460  3  F0 03                BEQ     DOS65FCBPREP_3  ;
001462  3  4C 52 14             JMP     DOS65FCBPREP_2  ;
