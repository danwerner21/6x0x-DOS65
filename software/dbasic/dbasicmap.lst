00127D  2               ;
00127D  2               ;	WRITE CHARACTER(A) TO UART
00127D  2               ;________________________________________________________________________________________________________________________________
00127D  2               ;
00127D  2               WRSER1:
00127D  2  48                   PHA
00127E  2               WRSER1a:
00127E  2  AD 85 EF             LDA     UART1STATUS     ; GET STATUS
001281  2  29 10                AND     #%00010000      ; IS TX READY
001283  2  F0 F9                BEQ     WRSER1a         ; NO, WAIT FOR IT
001285  2  68                   PLA
001286  2  8D 84 EF             STA     UART1DATA       ; WRITE DATA
001289  2  60                   RTS
