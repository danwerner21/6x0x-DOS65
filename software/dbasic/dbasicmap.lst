001709  3                       .IFDEF  MEMORYMAPPEDSCREEN
001709  3               
001709  3               ;* MEMORY MAP
001709  3               ;  VIDEO CARD IS A 32K AREA (MAPPED IN BANKS TO $AXXX)
001709  3               ;  $0x00 0x01=soft_scanline_emulation, 0x02 NO soft_scanline_emulation
001709  3               ;  $0x01 0x01=page1, 0x02 page2
001709  3               ;  $0x02  character generator write offset (data << 3)
001709  3               ;  $0x03 character generator write DATA
001709  3               ;  $0x04 EXECUTE device command
001709  3               ;        0x00- reset to the default configuration
001709  3               ;        0x01- reset to the saved configuration
001709  3               ;	0x02- save the current configuration
001709  3               ;
001709  3               ;  $0x05  0x01=soft_text=true, 0x02=soft_text=false
001709  3               ;  $0x06 Lores Mode=0X01,NO lores Mode=0x02
001709  3               ;  $0x07 Double Lores Mode=0X01,NO Double lores Mode=0x02
001709  3               ;  $0x08 Hires Mode=0X01,NO Hires Mode=0x02
