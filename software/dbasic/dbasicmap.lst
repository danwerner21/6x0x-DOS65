001D48  2                       .INCLUDE "sid.asm"
001D48  3               
001D48  3               
001D48  3                       .IFDEF  MEMORYMAPPEDSCREEN
001D48  3               
001D48  3               PC6502_IO       = $E000
001D48  3               SID_BASE        = PC6502_IO+$100
001D48  3               
001D48  3               ;___SOUND__________________________________________________
001D48  3               ;
001D48  3               ; PLAY SOUND
001D48  3               ;
001D48  3               ;  SOUND VOICE, FREQ, DUTY, WAVEFORM, ATTACK, SUSTAIN, DECAY, RELEASE
001D48  3               ;
001D48  3               ;
001D48  3               ;__________________________________________________________
001D48  3               LAB_SOUND:
001D48  3  20 83 33             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (VOICE)
001D4B  3  8A                   TXA
001D4C  3  29 03                AND     #3
001D4E  3  0A                   ASL     A
001D4F  3  AA                   TAX
001D50  3  BD CA 1D             LDA     SIDVOICELOOKUP,X
001D53  3  85 FD                STA     TEMPW
001D55  3  BD CB 1D             LDA     SIDVOICELOOKUP+1,X
001D58  3  85 FE                STA     TEMPW+1
001D5A  3                                               ; OK, TEMPW POINTS TO SID REGISTER TO MODIFY
001D5A  3  20 F2 2A             JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001D5D  3  20 C0 29             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001D60  3                                               ; else do type mismatch
001D60  3  20 E9 33             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001D63  3  A0 00                LDY     #0              ; SET FREQUENCY
001D65  3  A5 11                LDA     Itempl
001D67  3  91 FD                STA     (TEMPW),Y
001D69  3  A5 12                LDA     Itemph
001D6B  3  E8                   INX
001D6C  3  91 FD                STA     (TEMPW),Y
001D6E  3  20 F2 2A             JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001D71  3  20 C0 29             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001D74  3                                               ; else do type mismatch
001D74  3  20 E9 33             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001D77  3  A0 02                LDY     #2              ; SET DUTY CYCLE
001D79  3  A5 11                LDA     Itempl
001D7B  3  91 FD                STA     (TEMPW),Y
001D7D  3  A5 12                LDA     Itemph
001D7F  3  C8                   INY
001D80  3  91 FD                STA     (TEMPW),Y
001D82  3  20 F2 2A             JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
001D85  3  20 83 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (WAVEFORM)
001D88  3  8A                   TXA
001D89  3  A0 04                LDY     #4              ; SET WAVEFORM CYCLE
001D8B  3  91 FD                STA     (TEMPW),Y
001D8D  3  20 F2 2A             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001D90  3  20 83 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (ATTACK)
001D93  3  8A                   TXA
001D94  3  4A                   LSR     A
001D95  3  4A                   LSR     A
001D96  3  4A                   LSR     A
001D97  3  4A                   LSR     A
001D98  3  8D 33 17             STA     PTEMPW
001D9B  3  20 F2 2A             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001D9E  3  20 83 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (DECAY)
001DA1  3  8A                   TXA
001DA2  3  29 0F                AND     #$0F
001DA4  3  0D 33 17             ORA     PTEMPW
001DA7  3  A0 05                LDY     #5              ; SET ATTACK/DECAY
001DA9  3  91 FD                STA     (TEMPW),Y
001DAB  3  20 F2 2A             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001DAE  3  20 83 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (SUSTAIN)
001DB1  3  8A                   TXA
001DB2  3  4A                   LSR     A
001DB3  3  4A                   LSR     A
001DB4  3  4A                   LSR     A
001DB5  3  4A                   LSR     A
001DB6  3  8D 33 17             STA     PTEMPW
001DB9  3  20 F2 2A             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001DBC  3  20 83 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (RELEASE)
001DBF  3  8A                   TXA
001DC0  3  29 0F                AND     #$0F
001DC2  3  0D 33 17             ORA     PTEMPW
001DC5  3  A0 06                LDY     #6              ; SET SUSTAIN/RELEASE
001DC7  3  91 FD                STA     (TEMPW),Y
001DC9  3  60                   RTS
001DCA  3               SIDVOICELOOKUP:
001DCA  3  00 E1 07 E1          .WORD   SID_BASE,SID_BASE+7,SID_BASE+$12
001DCE  3  12 E1        
001DD0  3               
001DD0  3               ;___FILTER_________________________________________________
001DD0  3               ;
001DD0  3               ; SET SID FILTERS
001DD0  3               ;
001DD0  3               ;  FILTER CUTOFF, RESONANCE, VOICE 1 ENABLE, VOICE 2 ENABLE, VOICE 3 ENABLE, EXTERNAL ENABLE, FILTER MODE, VOLUME
001DD0  3               ;
001DD0  3               ;
001DD0  3               ;__________________________________________________________
001DD0  3               LAB_FILTER:
001DD0  3  20 C0 29             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001DD3  3                                               ; else do type mismatch
001DD3  3  20 E9 33             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001DD6  3                                               ; SET CUTOFF
001DD6  3  A5 11                LDA     Itempl
001DD8  3  8D 15 E1             STA     SID_BASE+$15
001DDB  3  A5 12                LDA     Itemph
001DDD  3  8D 16 E1             STA     SID_BASE+$16
001DE0  3  20 F2 2A             JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001DE3  3  20 83 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (RESONANCE)
001DE6  3  8A                   TXA
001DE7  3  4A                   LSR     A
001DE8  3  4A                   LSR     A
001DE9  3  4A                   LSR     A
001DEA  3  4A                   LSR     A
001DEB  3  8D 33 17             STA     PTEMPW
001DEE  3  20 F2 2A             JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001DF1  3  20 83 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 1 ENABLE)
001DF4  3  8A                   TXA
001DF5  3  29 01                AND     #1
001DF7  3  0D 33 17             ORA     PTEMPW
001DFA  3  8D 33 17             STA     PTEMPW
001DFD  3  20 F2 2A             JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
001E00  3  20 83 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 2 ENABLE)
001E03  3  8A                   TXA
001E04  3  29 01                AND     #1
001E06  3  4A                   LSR     A
001E07  3  0D 33 17             ORA     PTEMPW
001E0A  3  8D 33 17             STA     PTEMPW
001E0D  3  20 F2 2A             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001E10  3  20 83 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 3 ENABLE)
001E13  3  8A                   TXA
001E14  3  29 01                AND     #1
001E16  3  4A                   LSR     A
001E17  3  4A                   LSR     A
001E18  3  0D 33 17             ORA     PTEMPW
001E1B  3  8D 33 17             STA     PTEMPW
001E1E  3  20 F2 2A             JSR     LAB_1C01        ; GET THE SIXTH PARAMETER (AFTER ',') OR SYN ERR
001E21  3  20 83 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (EXTERNAL AUDIO ENABLE)
001E24  3  8A                   TXA
001E25  3  29 01                AND     #1
001E27  3  4A                   LSR     A
001E28  3  4A                   LSR     A
001E29  3  4A                   LSR     A
001E2A  3  0D 33 17             ORA     PTEMPW
001E2D  3  8D 17 E1             STA     SID_BASE+$17
001E30  3  20 F2 2A             JSR     LAB_1C01        ; GET THE SEVENTH PARAMETER (AFTER ',') OR SYN ERR
001E33  3  20 83 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (FILTER MODE)
001E36  3  8A                   TXA
001E37  3  4A                   LSR     A
001E38  3  4A                   LSR     A
001E39  3  4A                   LSR     A
001E3A  3  4A                   LSR     A
001E3B  3  8D 33 17             STA     PTEMPW
001E3E  3  20 F2 2A             JSR     LAB_1C01        ; GET THE EIGHTH PARAMETER (AFTER ',') OR SYN ERR
001E41  3  20 83 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOLUME)
001E44  3  8A                   TXA
001E45  3  29 0F                AND     #$0F
001E47  3  0D 33 17             ORA     PTEMPW
001E4A  3  8D 18 E1             STA     SID_BASE+$18
001E4D  3  60                   RTS
001E4E  3               
001E4E  3                       .ELSE
001E4E  3               
001E4E  3               
001E4E  3               ; ENSURE ALL OF THESE SPECIAL COMMANDS GIVE ERRORS IN NORMAL BASIC
001E4E  3               LAB_SOUND:
001E4E  3               LAB_FILTER:
001E4E  3                       LDX     #$02            ; error code $02 ("SYNTAX" error)
001E4E  3                       JMP     LAB_XERR        ; do error #X, then warm start
