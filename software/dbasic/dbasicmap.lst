001C2E  3  2E E1 16             ROL     PTEMPW1+1       ; *2 (*32)
001C31  3                                               ;
001C31  3                                               ; PTEMPW1(Y*35) = PTEMPW1(Y*32)+PTEMPW2(Y*2)+PTEMPW3(Y)
001C31  3  18                   CLC                     ; Clear the Carry flag before the first addition
001C32  3  AD E0 16             LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
001C35  3  6D E2 16             ADC     PTEMPW2         ; Add the low byte of the second number (plus carry)
001C38  3  8D E0 16             STA     PTEMPW1         ; Store the low byte of the result
001C3B  3               
001C3B  3  AD E1 16             LDA     PTEMPW1+1       ; Load the high byte of the first number
001C3E  3  6D E3 16             ADC     PTEMPW2+1       ; Add the high byte of the second number (plus carry from previous op)
001C41  3  8D E1 16             STA     PTEMPW1+1       ; Store the high byte of the result
001C44  3  18                   CLC                     ; Clear the Carry flag before the first addition
001C45  3  AD E0 16             LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
001C48  3  6D E4 16             ADC     PTEMPW3         ; Add the low byte of the second number (plus carry)
001C4B  3  8D E0 16             STA     PTEMPW1         ; Store the low byte of the result
001C4E  3               
001C4E  3  AD E1 16             LDA     PTEMPW1+1       ; Load the high byte of the first number
001C51  3  6D E5 16             ADC     PTEMPW3+1       ; Add the high byte of the second number (plus carry from previous op)
001C54  3  8D E1 16             STA     PTEMPW1+1       ; Store the high byte of the result
001C57  3                                               ;
001C57  3                                               ; PTEMPW1 IS NOW THE Y OFFSET
001C57  3                                               ; if quad hires double it.
001C57  3  AD DB 16             LDA     VIDEOMODE
001C5A  3  29 10                AND     #$10
001C5C  3  C9 00                CMP     #00
001C5E  3  D0 06                BNE     :+
001C60  3  0E E0 16             ASL     PTEMPW1
001C63  3  2E E1 16             ROL     PTEMPW1+1       ; *2
001C66  3               :
001C66  3                                               ; ADD THE X OFFSET
001C66  3  18                   CLC                     ; Clear the Carry flag before the first addition
001C67  3  AD E0 16             LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
001C6A  3  6D DE 16             ADC     PTEMPW          ; Add the low byte of the second number (plus carry)
001C6D  3  85 FD                STA     TEMPW           ; Store the low byte of the result
001C6F  3               
001C6F  3  AD E1 16             LDA     PTEMPW1+1       ; Load the high byte of the first number
001C72  3  6D DF 16             ADC     PTEMPW+1        ; Add the high byte of the second number (plus carry from previous op)
001C75  3  85 FE                STA     TEMPW+1         ; Store the high byte of the result
001C77  3                                               ; TEMPW IS NOW THE MEMORY ADDRESS
001C77  3               
001C77  3  A5 FE                LDA     TEMPW+1         ; OK, LET'S CALCULATE THE BANK
001C79  3  29 F0                AND     #$F0
001C7B  3  4A                   LSR     A
001C7C  3  4A                   LSR     A
001C7D  3  4A                   LSR     A
001C7E  3  4A                   LSR     A
001C7F  3  18                   CLC
001C80  3  69 FA                ADC     #$02+VIDEOBANK  ; AREA $2000-?
001C82  3  C9 F8                CMP     #$F8
001C84  3  90 32                BCC     V_PLOT_HIRES_COLOR_RANGE1
001C86  3  A8                   TAY                     ; VIDEO BANK SHOULD BE IN Y
001C87  3  20 D4 19             JSR     PAGE_ENTER
001C8A  3  A5 FE                LDA     TEMPW+1
001C8C  3  29 0F                AND     #$0F
001C8E  3  09 A0                ORA     #$A0
001C90  3  85 FE                STA     TEMPW+1         ; TEMPW NOW REFLECTS MAPPED ADDRESSS
001C92  3  68                   PLA
001C93  3  29 07                AND     #$07            ; WHICH BIT?
001C95  3  AA                   TAX
001C96  3  AD E7 16             LDA     PTEMP4
001C99  3  C9 01                CMP     #$01
001C9B  3  D0 0D                BNE     :+
001C9D  3  BD BB 1C             LDA     HIRES_BIT_LOOKUP_SET,X
001CA0  3  A0 00                LDY     #$00
001CA2  3  11 FD                ORA     (TEMPW),Y
001CA4  3  91 FD                STA     (TEMPW),Y
001CA6  3  20 CE 19             JSR     PAGE_EXIT
001CA9  3  60                   RTS
001CAA  3               :
001CAA  3  BD C3 1C             LDA     HIRES_BIT_LOOKUP_RESET,X
001CAD  3  48                   PHA
001CAE  3  A0 00                LDY     #$00
001CB0  3  31 FD                AND     (TEMPW),Y
001CB2  3  91 FD                STA     (TEMPW),Y
001CB4  3  20 CE 19             JSR     PAGE_EXIT
001CB7  3  60                   RTS
001CB8  3               V_PLOT_HIRES_COLOR_RANGE1:
001CB8  3  4C 6D 35             JMP     LAB_2564
001CBB  3               HIRES_BIT_LOOKUP_SET:
001CBB  3  80 40 20 10          .BYTE   %10000000,%01000000,%00100000,%00010000,%00001000,%00000100,%00000010,%00000001
001CBF  3  08 04 02 01  
001CC3  3               HIRES_BIT_LOOKUP_RESET:
001CC3  3  7F BF DF EF          .BYTE   %01111111,%10111111,%11011111,%11101111,%11110111,%11111011,%11111101,%11111110
001CC7  3  F7 FB FD FE  
001CCB  3               
001CCB  3               ;___V_PATTERN________________________________________________
001CCB  3               ;
001CCB  3               ;  DEFINE GRAPHICS PATTERN
001CCB  3               ;
001CCB  3               ;  TAKES 10 PARAMETERS
001CCB  3               ;       PATTERN NUM (0-255)
001CCB  3               ;       PATTERN DATA (8 BYTES)
001CCB  3               ;__________________________________________________________
001CCB  3               LAB_PATTERN
001CCB  3               V_PATTERN:
001CCB  3  20 2E 33             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X
001CCE  3  8A                   TXA
001CCF  3  48                   PHA
001CD0  3  A0 F8                LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001CD2  3  20 D4 19             JSR     PAGE_ENTER
001CD5  3  68                   PLA
001CD6  3  8D 02 A0             STA     VideoCharGenOffset
001CD9  3  A0 08                LDY     #8
001CDB  3               :
001CDB  3  98                   TYA
001CDC  3  48                   PHA
001CDD  3  20 9D 2A             JSR     LAB_1C01        ; GET THE NEXT PARAMETER (AFTER ',') OR SYN ERR
001CE0  3  20 2E 33             JSR     LAB_GTBY        ; GET THE NEXT PARAMETER, RETURN IN X
001CE3  3  68                   PLA
001CE4  3  A8                   TAY
001CE5  3  8A                   TXA
001CE6  3  8D 03 A0             STA     VideoCharGenData
001CE9  3  88                   DEY
001CEA  3  C0 00                CPY     #$00
001CEC  3  D0 ED                BNE     :-
001CEE  3  20 CE 19             JSR     PAGE_EXIT
001CF1  3  60                   RTS
001CF2  3               
001CF2  3               
001CF2  3               LAB_LINE:
001CF2  3  60                   RTS
001CF3  3                       .ELSE
001CF3  3               
001CF3  3               
001CF3  3               ; ENSURE ALL OF THESE SPECIAL COMMANDS GIVE ERRORS IN NORMAL BASIC
001CF3  3               LAB_SPEEK:
001CF3  3               LAB_SPOKE:
001CF3  3               LAB_SCRCLR:
001CF3  3               LAB_SCREEN:
001CF3  3               LAB_PATTERN:
001CF3  3               LAB_PLOT:
001CF3  3               LAB_LOCATE:
001CF3  3               LAB_COLOR:
001CF3  3               LAB_LINE:
001CF3  3                       LDX     #$02            ; error code $02 ("SYNTAX" error)
001CF3  3                       JMP     LAB_XERR        ; do error #X, then warm start
001CF3  3               
001CF3  3                       .ENDIF
001CF3  3               
001CF3  2                       .INCLUDE "sid.asm"
001CF3  3               
001CF3  3               
001CF3  3                       .IFDEF  MEMORYMAPPEDSCREEN
001CF3  3               
001CF3  3               PC6502_IO       = $E000
001CF3  3               SID_BASE        = PC6502_IO+$100
001CF3  3               
001CF3  3               ;___SOUND__________________________________________________
001CF3  3               ;
001CF3  3               ; PLAY SOUND
001CF3  3               ;
001CF3  3               ;  SOUND VOICE, FREQ, DUTY, WAVEFORM, ATTACK, SUSTAIN, DECAY, RELEASE
001CF3  3               ;
001CF3  3               ;
001CF3  3               ;__________________________________________________________
001CF3  3               LAB_SOUND:
001CF3  3  20 2E 33             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (VOICE)
001CF6  3  8A                   TXA
001CF7  3  29 03                AND     #3
001CF9  3  0A                   ASL     A
001CFA  3  AA                   TAX
001CFB  3  BD 75 1D             LDA     SIDVOICELOOKUP,X
001CFE  3  85 FD                STA     TEMPW
001D00  3  BD 76 1D             LDA     SIDVOICELOOKUP+1,X
001D03  3  85 FE                STA     TEMPW+1
001D05  3                                               ; OK, TEMPW POINTS TO SID REGISTER TO MODIFY
001D05  3  20 9D 2A             JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001D08  3  20 6B 29             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001D0B  3                                               ; else do type mismatch
001D0B  3  20 94 33             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001D0E  3  A0 00                LDY     #0              ; SET FREQUENCY
001D10  3  A5 11                LDA     Itempl
001D12  3  91 FD                STA     (TEMPW),Y
001D14  3  A5 12                LDA     Itemph
001D16  3  E8                   INX
001D17  3  91 FD                STA     (TEMPW),Y
001D19  3  20 9D 2A             JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001D1C  3  20 6B 29             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001D1F  3                                               ; else do type mismatch
001D1F  3  20 94 33             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001D22  3  A0 02                LDY     #2              ; SET DUTY CYCLE
001D24  3  A5 11                LDA     Itempl
001D26  3  91 FD                STA     (TEMPW),Y
001D28  3  A5 12                LDA     Itemph
001D2A  3  C8                   INY
001D2B  3  91 FD                STA     (TEMPW),Y
001D2D  3  20 9D 2A             JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
001D30  3  20 2E 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (WAVEFORM)
001D33  3  8A                   TXA
001D34  3  A0 04                LDY     #4              ; SET WAVEFORM CYCLE
001D36  3  91 FD                STA     (TEMPW),Y
001D38  3  20 9D 2A             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001D3B  3  20 2E 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (ATTACK)
001D3E  3  8A                   TXA
001D3F  3  4A                   LSR     A
001D40  3  4A                   LSR     A
001D41  3  4A                   LSR     A
001D42  3  4A                   LSR     A
001D43  3  8D DE 16             STA     PTEMPW
001D46  3  20 9D 2A             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001D49  3  20 2E 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (DECAY)
001D4C  3  8A                   TXA
001D4D  3  29 0F                AND     #$0F
001D4F  3  0D DE 16             ORA     PTEMPW
001D52  3  A0 05                LDY     #5              ; SET ATTACK/DECAY
001D54  3  91 FD                STA     (TEMPW),Y
001D56  3  20 9D 2A             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001D59  3  20 2E 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (SUSTAIN)
001D5C  3  8A                   TXA
001D5D  3  4A                   LSR     A
001D5E  3  4A                   LSR     A
001D5F  3  4A                   LSR     A
001D60  3  4A                   LSR     A
001D61  3  8D DE 16             STA     PTEMPW
001D64  3  20 9D 2A             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001D67  3  20 2E 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (RELEASE)
001D6A  3  8A                   TXA
001D6B  3  29 0F                AND     #$0F
001D6D  3  0D DE 16             ORA     PTEMPW
001D70  3  A0 06                LDY     #6              ; SET SUSTAIN/RELEASE
001D72  3  91 FD                STA     (TEMPW),Y
001D74  3  60                   RTS
001D75  3               SIDVOICELOOKUP:
001D75  3  00 E1 07 E1          .WORD   SID_BASE,SID_BASE+7,SID_BASE+$12
001D79  3  12 E1        
001D7B  3               
001D7B  3               ;___FILTER_________________________________________________
001D7B  3               ;
001D7B  3               ; SET SID FILTERS
001D7B  3               ;
001D7B  3               ;  FILTER CUTOFF, RESONANCE, VOICE 1 ENABLE, VOICE 2 ENABLE, VOICE 3 ENABLE, EXTERNAL ENABLE, FILTER MODE, VOLUME
001D7B  3               ;
001D7B  3               ;
001D7B  3               ;__________________________________________________________
001D7B  3               LAB_FILTER:
001D7B  3  20 6B 29             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001D7E  3                                               ; else do type mismatch
001D7E  3  20 94 33             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001D81  3                                               ; SET CUTOFF
001D81  3  A5 11                LDA     Itempl
001D83  3  8D 15 E1             STA     SID_BASE+$15
001D86  3  A5 12                LDA     Itemph
001D88  3  8D 16 E1             STA     SID_BASE+$16
001D8B  3  20 9D 2A             JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001D8E  3  20 2E 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (RESONANCE)
001D91  3  8A                   TXA
001D92  3  4A                   LSR     A
001D93  3  4A                   LSR     A
001D94  3  4A                   LSR     A
001D95  3  4A                   LSR     A
001D96  3  8D DE 16             STA     PTEMPW
001D99  3  20 9D 2A             JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001D9C  3  20 2E 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 1 ENABLE)
001D9F  3  8A                   TXA
001DA0  3  29 01                AND     #1
001DA2  3  0D DE 16             ORA     PTEMPW
001DA5  3  8D DE 16             STA     PTEMPW
001DA8  3  20 9D 2A             JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
001DAB  3  20 2E 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 2 ENABLE)
001DAE  3  8A                   TXA
001DAF  3  29 01                AND     #1
001DB1  3  4A                   LSR     A
001DB2  3  0D DE 16             ORA     PTEMPW
001DB5  3  8D DE 16             STA     PTEMPW
001DB8  3  20 9D 2A             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001DBB  3  20 2E 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 3 ENABLE)
001DBE  3  8A                   TXA
001DBF  3  29 01                AND     #1
001DC1  3  4A                   LSR     A
001DC2  3  4A                   LSR     A
001DC3  3  0D DE 16             ORA     PTEMPW
001DC6  3  8D DE 16             STA     PTEMPW
001DC9  3  20 9D 2A             JSR     LAB_1C01        ; GET THE SIXTH PARAMETER (AFTER ',') OR SYN ERR
001DCC  3  20 2E 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (EXTERNAL AUDIO ENABLE)
001DCF  3  8A                   TXA
001DD0  3  29 01                AND     #1
001DD2  3  4A                   LSR     A
001DD3  3  4A                   LSR     A
001DD4  3  4A                   LSR     A
001DD5  3  0D DE 16             ORA     PTEMPW
001DD8  3  8D 17 E1             STA     SID_BASE+$17
001DDB  3  20 9D 2A             JSR     LAB_1C01        ; GET THE SEVENTH PARAMETER (AFTER ',') OR SYN ERR
001DDE  3  20 2E 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (FILTER MODE)
001DE1  3  8A                   TXA
001DE2  3  4A                   LSR     A
001DE3  3  4A                   LSR     A
001DE4  3  4A                   LSR     A
001DE5  3  4A                   LSR     A
001DE6  3  8D DE 16             STA     PTEMPW
001DE9  3  20 9D 2A             JSR     LAB_1C01        ; GET THE EIGHTH PARAMETER (AFTER ',') OR SYN ERR
001DEC  3  20 2E 33             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOLUME)
001DEF  3  8A                   TXA
001DF0  3  29 0F                AND     #$0F
001DF2  3  0D DE 16             ORA     PTEMPW
001DF5  3  8D 18 E1             STA     SID_BASE+$18
001DF8  3  60                   RTS
001DF9  3               
001DF9  3                       .ELSE
001DF9  3               
001DF9  3               
001DF9  3               ; ENSURE ALL OF THESE SPECIAL COMMANDS GIVE ERRORS IN NORMAL BASIC
001DF9  3               LAB_SOUND:
001DF9  3               LAB_FILTER:
001DF9  3                       LDX     #$02            ; error code $02 ("SYNTAX" error)
001DF9  3                       JMP     LAB_XERR        ; do error #X, then warm start
