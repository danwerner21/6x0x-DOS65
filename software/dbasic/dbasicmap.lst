001B95  3               ;___V_PLOT__________________________________________________
001B95  3               ;
001B95  3               ;  PLOT ON SCREEN
001B95  3               ;         TAKES THREE PARAMETERS,  X,Y,COLOR
001B95  3               ;
001B95  3               ;__________________________________________________________
001B95  3               LAB_PLOT:
001B95  3               V_PLOT:
001B95  3  20 09 2D             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001B98  3                                               ; else do type mismatch
001B98  3  20 32 37             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001B9B  3  A5 12                LDA     Itemph
001B9D  3  8D 84 18             STA     PLOTX+1
001BA0  3  A5 11                LDA     Itempl
001BA2  3  8D 83 18             STA     PLOTX
001BA5  3  20 3B 2E             JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001BA8  3  20 CC 36             JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
001BAB  3  8E 85 18             STX     PLOTY           ; STORE IN PLOTY
001BAE  3  A9 00                LDA     #$00
001BB0  3  8D 86 18             STA     PLOTY+1
001BB3  3  20 3B 2E             JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001BB6  3  20 CC 36             JSR     LAB_GTBY        ; RETURN IN X
001BB9  3  8E 87 18             STX     PLOTCOLOR
001BBC  3               DOPLOTXY:
001BBC  3                                               ; PARAMETERS PARSED, GO TO PROPER MODE CODE
001BBC  3  AD 80 18             LDA     VIDEOMODE
001BBF  3  29 0F                AND     #$0F
001BC1  3  C9 01                CMP     #$01
001BC3  3  F0 14                BEQ     V_PLOT_LORES
001BC5  3  AD 80 18             LDA     VIDEOMODE
001BC8  3  29 2F                AND     #$2F
001BCA  3  C9 02                CMP     #$02
001BCC  3  D0 03                BNE     :+
001BCE  3  4C 7C 1C             JMP     V_PLOT_HIRES_COLOR
001BD1  3               :
001BD1  3  C9 22                CMP     #$22
001BD3  3  D0 03                BNE     :+
001BD5  3  4C 58 1D             JMP     V_PLOT_HIRES_MONO
001BD8  3               :
001BD8  3  60                   RTS
001BD9  3               
001BD9  3               V_PLOT_LORES:
001BD9  3  AD 85 18             LDA     PLOTY
001BDC  3  48                   PHA
001BDD  3  4A                   LSR     A               ; 2 LINES PER BYTE
001BDE  3  8D 85 18             STA     PLOTY
001BE1  3                                               ; MULTIPLY Y (PTEMPW) COORD BY 40 OR 80 (SINGLE OR DOUBLE LORES)
001BE1  3  18                   CLC
001BE2  3  0E 85 18             ASL     PLOTY
001BE5  3  2E 86 18             ROL     PLOTY+1         ; *2
001BE8  3  0E 85 18             ASL     PLOTY
001BEB  3  2E 86 18             ROL     PLOTY+1         ; *2 (*4)
001BEE  3  0E 85 18             ASL     PLOTY
001BF1  3  2E 86 18             ROL     PLOTY+1         ; *2 (*8)
001BF4  3  AD 85 18             LDA     PLOTY
001BF7  3  8D 95 18             STA     PTEMPW
001BFA  3  AD 86 18             LDA     PLOTY+1
001BFD  3  8D 96 18             STA     PTEMPW+1        ; STORE Y*8 INTO PTEMPW
001C00  3  0E 85 18             ASL     PLOTY
001C03  3  2E 86 18             ROL     PLOTY+1         ; *2 (*16)
001C06  3  0E 85 18             ASL     PLOTY
001C09  3  2E 86 18             ROL     PLOTY+1         ; *2 (*32)
001C0C  3               ; NOW TAKE Y*8(PTEMPW) + Y*32(PLOTY) == Y*40 STORE IN PLOTY
001C0C  3  18                   CLC                     ; Clear the Carry flag before the first addition
001C0D  3               
001C0D  3  AD 85 18             LDA     PLOTY           ; Load the low byte of the first number into the accumulator
001C10  3  6D 95 18             ADC     PTEMPW          ; Add the low byte of the second number (plus carry)
