001224  2               UART1DATA       = $EF84         ; SERIAL PORT 1 (I/O Card)
001224  2               UART1STATUS     = $EF85         ; SERIAL PORT 1 (I/O Card)
001224  2               UART1COMMAND    = $EF86         ; SERIAL PORT 1 (I/O Card)
001224  2               UART1CONTROL    = $EF87         ; SERIAL PORT 1 (I/O Card)
001224  2               
001224  2               PRINT_CRLF:
001224  2  8E 92 12             STX     TTX
001227  2  8C 93 12             STY     TTY
00122A  2  8D 94 12             STA     TTA
00122D  2  A9 0D                LDA     #13
00122F  2  20 95 12             JSR     WRSER1          ; output upper nybble
001232  2  A9 0A                LDA     #10
001234  2  20 95 12             JSR     WRSER1          ; output upper nybble
001237  2  AE 92 12             LDX     TTX
00123A  2  AC 93 12             LDY     TTY
00123D  2  AD 94 12             LDA     TTA
001240  2  60                   RTS
001241  2               
001241  2               PRINT_SPACE:
001241  2  8E 92 12             STX     TTX
001244  2  8C 93 12             STY     TTY
001247  2  8D 94 12             STA     TTA
00124A  2  A9 20                LDA     #32
00124C  2  20 95 12             JSR     WRSER1          ; output upper nybble
00124F  2  AE 92 12             LDX     TTX
001252  2  AC 93 12             LDY     TTY
001255  2  AD 94 12             LDA     TTA
001258  2  60                   RTS
001259  2               
001259  2               
001259  2               PRINT_BYTE:
001259  2  8E 92 12             STX     TTX
00125C  2  8C 93 12             STY     TTY
00125F  2  8D 94 12             STA     TTA
001262  2  8E 91 12             STX     SAVX            ; save X
001265  2  20 7C 12             JSR     ASCTWO          ; get hex chars for byte in X (lower) and A (upper)
001268  2  20 95 12             JSR     WRSER1          ; output upper nybble
00126B  2  8A                   TXA                     ; transfer lower to A
00126C  2  AE 91 12             LDX     SAVX            ; restore X
00126F  2  20 95 12             JSR     WRSER1          ; output lower nybble
001272  2  AE 92 12             LDX     TTX
001275  2  AC 93 12             LDY     TTY
001278  2  AD 94 12             LDA     TTA
00127B  2  60                   RTS
00127C  2               ASCTWO:
00127C  2  48                   PHA                     ; save byte
00127D  2  20 86 12             JSR     ASCII           ; do low nybble
001280  2  AA                   TAX                     ; save in X
001281  2  68                   PLA                     ; restore byte
001282  2  4A                   LSR     A               ; shift upper nybble down
001283  2  4A                   LSR     A
001284  2  4A                   LSR     A
001285  2  4A                   LSR     A
001286  2               ; convert low nybble in A to hex digit
001286  2               ASCII:
001286  2  29 0F                AND     #$0F            ; clear upper nibble
001288  2  C9 0A                CMP     #$0A            ; if less than A, skip next step
00128A  2  90 02                BCC     ASC1
00128C  2  69 06                ADC     #6              ; skip ascii chars between 9 and A
00128E  2               ASC1:
00128E  2  69 30                ADC     #$30            ; add ascii char 0 to value
001290  2  60                   RTS
001291  2               SAVX:
001291  2  00                   .BYTE   00
001292  2               TTX:
001292  2  00                   .BYTE   00
001293  2               TTY:
001293  2  00                   .BYTE   00
001294  2               TTA:
001294  2  00                   .BYTE   00
001295  2               ;__WRSER1________________________________________________________________________________________________________________________
001295  2               ;
001295  2               ;	WRITE CHARACTER(A) TO UART
001295  2               ;________________________________________________________________________________________________________________________________
001295  2               ;
001295  2               WRSER1:
001295  2  48                   PHA
001296  2               WRSER1a:
001296  2  AD 85 EF             LDA     UART1STATUS     ; GET STATUS
001299  2  29 10                AND     #%00010000      ; IS TX READY
00129B  2  F0 F9                BEQ     WRSER1a         ; NO, WAIT FOR IT
00129D  2  68                   PLA
00129E  2  8D 84 EF             STA     UART1DATA       ; WRITE DATA
0012A1  2  60                   RTS
