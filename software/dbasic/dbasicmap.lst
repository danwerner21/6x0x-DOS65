0014C1  3               ;
0014C1  3               ; OPEN A FILE
0014C1  3               ;
0014C1  3               ;
0014C1  3               ; BASIC COMMAND EXPECTS FOUR VARS
0014C1  3               
0014C1  3               ; DRIVE,MODE, FILENAME$,FILE$
0014C1  3               ;
0014C1  3               ; FILE$ = STRING TO HOLD 33 BYTE FCB
0014C1  3               ; DRIVE = NUMERIC DRIVE -- 0=A, 1=B, 2= . . .
0014C1  3               ; MODE = 0=EXISTING, 1=CREATE
0014C1  3               ; FILENAME$ = FILENAME STRING
0014C1  3               ;__________________________________________________________
0014C1  3               V_OPEN:
0014C1  3               ; CLEAR FCB
