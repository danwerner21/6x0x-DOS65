001C3A  3  0E EA 16             ASL     PLOTY
001C3D  3  2E EB 16             ROL     PLOTY+1         ; *2
001C40  3               :
001C40  3               ; ADD THE X OFFSET
001C40  3  18                   CLC                     ; Clear the Carry flag before the first addition
001C41  3  AD EA 16             LDA     PLOTY           ; Load the low byte of the first number into the accumulator
001C44  3  6D E8 16             ADC     PLOTX           ; Add the low byte of the second number (plus carry)
001C47  3  85 FD                STA     TEMPW           ; Store the low byte of the result
001C49  3               
001C49  3  AD EB 16             LDA     PLOTY+1         ; Load the high byte of the first number
001C4C  3  6D E9 16             ADC     PLOTX+1         ; Add the high byte of the second number (plus carry from previous op)
001C4F  3  85 FE                STA     TEMPW+1         ; Store the high byte of the result
001C51  3                                               ; TEMPW IS NOW THE MEMORY ADDRESS
001C51  3               
001C51  3  A5 FE                LDA     TEMPW+1         ; OK, LET'S CALCULATE THE BANK
001C53  3  29 F0                AND     #$F0
001C55  3  4A                   LSR     A
001C56  3  4A                   LSR     A
001C57  3  4A                   LSR     A
001C58  3  4A                   LSR     A
001C59  3  18                   CLC
001C5A  3  69 FA                ADC     #$02+VIDEOBANK  ; AREA $2000-?
001C5C  3  C9 F8                CMP     #$F8
001C5E  3  90 32                BCC     V_PLOT_HIRES_COLOR_RANGE1
001C60  3  A8                   TAY                     ; VIDEO BANK SHOULD BE IN Y
001C61  3  20 ED 19             JSR     PAGE_ENTER
001C64  3  A5 FE                LDA     TEMPW+1
001C66  3  29 0F                AND     #$0F
001C68  3  09 A0                ORA     #$A0
001C6A  3  85 FE                STA     TEMPW+1         ; TEMPW NOW REFLECTS MAPPED ADDRESSS
001C6C  3  68                   PLA
001C6D  3  29 07                AND     #$07            ; WHICH BIT?
001C6F  3  AA                   TAX
001C70  3  AD EC 16             LDA     PLOTCOLOR
001C73  3  C9 01                CMP     #$01
001C75  3  D0 0D                BNE     :+
001C77  3  BD 95 1C             LDA     HIRES_BIT_LOOKUP_SET,X
001C7A  3  A0 00                LDY     #$00
001C7C  3  11 FD                ORA     (TEMPW),Y
001C7E  3  91 FD                STA     (TEMPW),Y
001C80  3  20 E7 19             JSR     PAGE_EXIT
001C83  3  60                   RTS
001C84  3               :
001C84  3  BD 9D 1C             LDA     HIRES_BIT_LOOKUP_RESET,X
001C87  3  48                   PHA
001C88  3  A0 00                LDY     #$00
001C8A  3  31 FD                AND     (TEMPW),Y
001C8C  3  91 FD                STA     (TEMPW),Y
001C8E  3  20 E7 19             JSR     PAGE_EXIT
001C91  3  60                   RTS
001C92  3               V_PLOT_HIRES_COLOR_RANGE1:
001C92  3  4C 65 37             JMP     LAB_2564
001C95  3               HIRES_BIT_LOOKUP_SET:
001C95  3  80 40 20 10          .BYTE   %10000000,%01000000,%00100000,%00010000,%00001000,%00000100,%00000010,%00000001
001C99  3  08 04 02 01  
001C9D  3               HIRES_BIT_LOOKUP_RESET:
001C9D  3  7F BF DF EF          .BYTE   %01111111,%10111111,%11011111,%11101111,%11110111,%11111011,%11111101,%11111110
001CA1  3  F7 FB FD FE  
001CA5  3               
001CA5  3               ;___V_PATTERN________________________________________________
001CA5  3               ;
001CA5  3               ;  DEFINE GRAPHICS PATTERN
001CA5  3               ;
001CA5  3               ;  TAKES 10 PARAMETERS
001CA5  3               ;       PATTERN NUM (0-255)
001CA5  3               ;       PATTERN DATA (8 BYTES)
001CA5  3               ;__________________________________________________________
001CA5  3               LAB_PATTERN
001CA5  3               V_PATTERN:
001CA5  3  20 26 35             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X
001CA8  3  8A                   TXA
001CA9  3  48                   PHA
001CAA  3  A0 F8                LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001CAC  3  20 ED 19             JSR     PAGE_ENTER
001CAF  3  68                   PLA
001CB0  3  8D 02 A0             STA     VideoCharGenOffset
001CB3  3  A0 08                LDY     #8
001CB5  3               :
001CB5  3  98                   TYA
001CB6  3  48                   PHA
001CB7  3  20 95 2C             JSR     LAB_1C01        ; GET THE NEXT PARAMETER (AFTER ',') OR SYN ERR
001CBA  3  20 26 35             JSR     LAB_GTBY        ; GET THE NEXT PARAMETER, RETURN IN X
001CBD  3  68                   PLA
001CBE  3  A8                   TAY
001CBF  3  8A                   TXA
001CC0  3  8D 03 A0             STA     VideoCharGenData
001CC3  3  88                   DEY
001CC4  3  C0 00                CPY     #$00
001CC6  3  D0 ED                BNE     :-
001CC8  3  20 E7 19             JSR     PAGE_EXIT
001CCB  3  60                   RTS
001CCC  3               
001CCC  3               ;___LAB_LINE_______________________________________________
001CCC  3               ;
001CCC  3               ;  DRAW LINE USING THE BRESENHAM LINE DRAWING ALGORITHM
001CCC  3               ;
001CCC  3               ;  TAKES 5 PARAMETERS
001CCC  3               ;       START X,Y
001CCC  3               ;       DESTINATION X,Y
001CCC  3               ;       COLOR
001CCC  3               ;__________________________________________________________
001CCC  3               LAB_LINE:
001CCC  3               ; GET X1
001CCC  3  20 63 2B             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001CCF  3                                               ; else do type mismatch
001CCF  3  20 8C 35             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001CD2  3  A5 12                LDA     Itemph
001CD4  3  8D EF 16             STA     LINEX1+1
001CD7  3  A5 11                LDA     Itempl
001CD9  3  8D EE 16             STA     LINEX1
001CDC  3                                               ; GET Y1
001CDC  3  20 95 2C             JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001CDF  3  20 26 35             JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
001CE2  3  8E F0 16             STX     LINEY1          ; STORE IN LINEY1
001CE5  3               
001CE5  3               ; GET X2
001CE5  3  20 95 2C             JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001CE8  3  20 63 2B             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001CEB  3                                               ; else do type mismatch
001CEB  3  20 8C 35             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001CEE  3  A5 12                LDA     Itemph
001CF0  3  8D F3 16             STA     LINEX2+1
001CF3  3  A5 11                LDA     Itempl
001CF5  3  8D F2 16             STA     LINEX2
001CF8  3                                               ; GET Y2
001CF8  3  20 95 2C             JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
001CFB  3  20 26 35             JSR     LAB_GTBY        ; RETURN IN X
001CFE  3  8E F4 16             STX     LINEY2          ; STORE IN LINEY2
001D01  3                                               ; GET COLOR
001D01  3  20 95 2C             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001D04  3  20 26 35             JSR     LAB_GTBY        ; RETURN IN X
001D07  3  8E ED 16             STX     LINECOLOR       ; STORE IN COLOR
001D0A  3  A9 00                LDA     #$00
001D0C  3  8D F1 16             STA     LINEY1+1
001D0F  3  8D F5 16             STA     LINEY2+1
001D12  3                                               ; LINE COORDS AND COLOR STORED IN PROPER PLACE
001D12  3                                               ; CALCULATE DELTAX
001D12  3  38                   SEC                     ; Set Carry flag (represents "no borrow" for 1st byte)
001D13  3  AD EE 16             LDA     LINEX1          ; Load low byte of number 1
001D16  3  ED F2 16             SBC     LINEX2          ; Subtract low byte of number 2 with carry
001D19  3  8D F6 16             STA     DELTAX          ; Store result low byte
001D1C  3  AD EF 16             LDA     LINEX1+1        ; Load high byte of number 1
001D1F  3  ED F3 16             SBC     LINEX2+1        ; Subtract high byte of number 2 with borrow
001D22  3  8D F7 16             STA     DELTAX+1        ; Store result high byte
001D25  3  B0 20                BCS     :+              ; BRANCH IF X1>=X2
001D27  3                                               ; X1 < X2
001D27  3  A9 00                LDA     #0
001D29  3  8D FE 16             STA     PTEMP           ; IF X2>X1 (PTEMP=x0)
001D2C  3  A9 FF                LDA     #$FF            ; TAKE ABSOLUTE VALUE OF DELTAX
001D2E  3  4D F7 16             EOR     DELTAX+1        ; Invert high byte (one's complement)
001D31  3  8D F7 16             STA     DELTAX+1
001D34  3  A9 FF                LDA     #$FF            ;
001D36  3  4D F6 16             EOR     DELTAX          ; Invert low byte
001D39  3  8D F6 16             STA     DELTAX          ;
001D3C  3  EE F6 16             INC     DELTAX          ; Add 1 to the low byte
001D3F  3  D0 0B                BNE     :++             ; If no carry from low byte INC, we are done
001D41  3  EE F7 16             INC     DELTAX+1        ; Increment high byte if carry occurred
001D44  3  4C 4C 1D             JMP     :++
001D47  3               :
001D47  3  A9 01                LDA     #1
001D49  3  8D FE 16             STA     PTEMP           ; IF X1>X2 (PTEMP=x1)
001D4C  3               :
001D4C  3                                               ; CALCULATE DELTAY
001D4C  3  A9 00                LDA     #0
001D4E  3  8D F9 16             STA     DELTAY+1
001D51  3  38                   SEC                     ; Set Carry flag
001D52  3  AD F0 16             LDA     LINEY1          ; Load low byte of number 1
001D55  3  ED F4 16             SBC     LINEY2          ; Subtract low byte of number 2 with carry
001D58  3  8D F8 16             STA     DELTAY          ; Store result low byte
001D5B  3  B0 16                BCS     :+              ; BRANCH IF Y1>=Y2
001D5D  3                                               ; Y1 < Y2
001D5D  3  AD FE 16             LDA     PTEMP
001D60  3  29 01                AND     #1
001D62  3  8D FE 16             STA     PTEMP           ; IF Y2>Y1 (PTEMP=0x)
001D65  3                                               ; TAKE ABSOLUTE VALUE OF DELTAY
001D65  3  A9 FF                LDA     #$FF
001D67  3  4D F8 16             EOR     DELTAY          ; Flip all bits (one's complement)
001D6A  3  8D F8 16             STA     DELTAY
001D6D  3  EE F8 16             INC     DELTAY          ; Add 1 (two's complement)
001D70  3  4C 7B 1D             JMP     :++
001D73  3               :
001D73  3  AD FE 16             LDA     PTEMP
001D76  3  09 10                ORA     #$10
001D78  3  8D FE 16             STA     PTEMP           ; IF Y1>Y2 (PTEMP=1x)
001D7B  3               :
001D7B  3                                               ; SLOPE DETERMINED, AND DELTAS CALCULATED
001D7B  3                                               ; OK, LET'S FIND OUT IF THIS IS A HORIZONTAL-ISH
001D7B  3                                               ; OR VERTICAL-ISH LINE
001D7B  3  38                   SEC                     ; Set Carry Flag (for subtraction)
001D7C  3  AD F6 16             LDA     DELTAX          ; Load low byte of DELTAX
001D7F  3  ED F8 16             SBC     DELTAY          ; Subtract low byte of DELTAY
001D82  3  AD F7 16             LDA     DELTAX+1        ; Load high byte of DELTAX
001D85  3  ED F9 16             SBC     DELTAY+1        ; Subtract high byte of DELTAY (with borrow)
001D88  3                                               ; Flags now reflect the 16-bit comparison
001D88  3  90 03                BCC     LINEVERT        ; If Carry clear, LINE IS VERTICAL-ISH
001D8A  3  4C 23 1E             JMP     LINEHORZ
001D8D  3               LINEVERT:
001D8D  3                                               ; FOR A VERTICAL-ISH LINE WE STEP ALONG THE
001D8D  3                                               ; Y AXIS (STEEP GRADIENT)
001D8D  3                                               ; FIND LARGER Y . . .
001D8D  3  AD F0 16             LDA     LINEY1
001D90  3  CD F4 16             CMP     LINEY2
001D93  3  B0 03                BCS     :+
001D95  3  20 BA 1E             JSR     LINESWAPXY
001D98  3               :
001D98  3                                               ; Initialize error = DELTAY / 2
001D98  3  AD F8 16             LDA     DELTAY
001D9B  3  8D FF 16             STA     LINEERR
001D9E  3  AD F9 16             LDA     DELTAY+1
001DA1  3  8D 00 17             STA     LINEERR+1
001DA4  3  4E 00 17             LSR     LINEERR+1
001DA7  3  6E FF 16             ROR     LINEERR
001DAA  3               LINEVERTLOOP:
001DAA  3  AD F0 16             LDA     LINEY1          ; OK LET'S PLOT A POINT
001DAD  3  8D EA 16             STA     PLOTY
001DB0  3  AD F1 16             LDA     LINEY1+1
001DB3  3  8D EB 16             STA     PLOTY+1
001DB6  3  AD EE 16             LDA     LINEX1
001DB9  3  8D E8 16             STA     PLOTX
001DBC  3  AD EF 16             LDA     LINEX1+1
001DBF  3  8D E9 16             STA     PLOTX+1
001DC2  3  AD ED 16             LDA     LINECOLOR
001DC5  3  8D EC 16             STA     PLOTCOLOR
001DC8  3  20 21 1A             JSR     DOPLOTXY
001DCB  3                                               ; NOW MOVE LINE1 CLOSER TO LINE2
001DCB  3  CE F0 16             DEC     LINEY1          ; BY STEPPING ALONG Y AXIS
001DCE  3               
001DCE  3                                               ; BRESENHAM: err -= DELTAX
001DCE  3  38                   SEC
001DCF  3  AD FF 16             LDA     LINEERR
001DD2  3  ED F6 16             SBC     DELTAX
001DD5  3  8D FF 16             STA     LINEERR
001DD8  3  AD 00 17             LDA     LINEERR+1
001DDB  3  ED F7 16             SBC     DELTAX+1
001DDE  3  8D 00 17             STA     LINEERR+1
001DE1  3  10 37                BPL     LINEVERT_NOSTEP ; IF ERR >= 0, NO X STEP NEEDED
001DE3  3                                               ; ERR += DELTAY (RESTORE ERROR)
001DE3  3  18                   CLC
001DE4  3  AD FF 16             LDA     LINEERR
001DE7  3  6D F8 16             ADC     DELTAY
001DEA  3  8D FF 16             STA     LINEERR
001DED  3  AD 00 17             LDA     LINEERR+1
001DF0  3  6D F9 16             ADC     DELTAY+1
001DF3  3  8D 00 17             STA     LINEERR+1
001DF6  3                                               ; STEP X TOWARD X2 (16-BIT)
001DF6  3  AD F2 16             LDA     LINEX2
001DF9  3  CD EE 16             CMP     LINEX1
001DFC  3  AD F3 16             LDA     LINEX2+1
001DFF  3  ED EF 16             SBC     LINEX1+1
001E02  3  90 0B                BCC     LINEVERT_DECX   ; X2 < X1, DECREMENT X1
001E04  3  EE EE 16             INC     LINEX1          ; X2 >= X1, INCREMENT X1
001E07  3  D0 11                BNE     LINEVERT_NOSTEP
001E09  3  EE EF 16             INC     LINEX1+1
001E0C  3  4C 1A 1E             JMP     LINEVERT_NOSTEP
001E0F  3               LINEVERT_DECX:
001E0F  3  AD EE 16             LDA     LINEX1
001E12  3  D0 03                BNE     :+
001E14  3  CE EF 16             DEC     LINEX1+1
001E17  3  CE EE 16     :       DEC     LINEX1
001E1A  3               LINEVERT_NOSTEP:
001E1A  3               
001E1A  3  AD F0 16             LDA     LINEY1
001E1D  3  CD F4 16             CMP     LINEY2
001E20  3  D0 88                BNE     LINEVERTLOOP
001E22  3  60                   RTS                     ; DONE
001E23  3               
001E23  3               LINEHORZ:
001E23  3               ; FOR A HORIZONTAL-ISH LINE WE STEP ALONG THE
001E23  3               ; X AXIS (SHALLOW GRADIENT)
001E23  3               ; FIND LARGER X . . .
001E23  3  38                   SEC                     ; Set carry flag for subtraction
001E24  3  AD F2 16             LDA     LINEX2          ; Load low byte of first number
001E27  3  ED EE 16             SBC     LINEX1          ; Subtract low byte of second number
001E2A  3  AD F3 16             LDA     LINEX2+1        ; Load high byte of first number
001E2D  3  ED EF 16             SBC     LINEX1+1        ; Subtract high byte of second number
001E30  3                                               ; Result flags (N, Z, C) now reflect: Val1 - Val2
001E30  3  B0 03                BCS     :+              ; If carry is set, LINEX2 >= LINEX1
001E32  3  20 BA 1E             JSR     LINESWAPXY
001E35  3               :
001E35  3                                               ; Initialize error = DELTAX / 2
001E35  3  AD F6 16             LDA     DELTAX
001E38  3  8D FF 16             STA     LINEERR
001E3B  3  AD F7 16             LDA     DELTAX+1
001E3E  3  8D 00 17             STA     LINEERR+1
001E41  3  4E 00 17             LSR     LINEERR+1
001E44  3  6E FF 16             ROR     LINEERR
001E47  3               LINEHORZLOOP:
001E47  3  AD F0 16             LDA     LINEY1          ; OK LET'S PLOT A POINT
001E4A  3  8D EA 16             STA     PLOTY
001E4D  3  AD F1 16             LDA     LINEY1+1
001E50  3  8D EB 16             STA     PLOTY+1
001E53  3  AD EE 16             LDA     LINEX1
001E56  3  8D E8 16             STA     PLOTX
001E59  3  AD EF 16             LDA     LINEX1+1
001E5C  3  8D E9 16             STA     PLOTX+1
001E5F  3  AD ED 16             LDA     LINECOLOR
001E62  3  8D EC 16             STA     PLOTCOLOR
001E65  3  20 21 1A             JSR     DOPLOTXY
001E68  3                                               ; NOW MOVE LINE1 CLOSER TO LINE2
001E68  3  EE EE 16             INC     LINEX1          ; BY STEPPING ALONG X AXIS
001E6B  3  D0 03                BNE     :+
001E6D  3  EE EF 16             INC     LINEX1+1
001E70  3               :
001E70  3                                               ; BRESENHAM: err -= DELTAY
001E70  3  38                   SEC
001E71  3  AD FF 16             LDA     LINEERR
001E74  3  ED F8 16             SBC     DELTAY
001E77  3  8D FF 16             STA     LINEERR
001E7A  3  AD 00 17             LDA     LINEERR+1
001E7D  3  ED F9 16             SBC     DELTAY+1
001E80  3  8D 00 17             STA     LINEERR+1
001E83  3  10 24                BPL     LINEHORZ_NOSTEP ; IF ERR >= 0, NO Y STEP NEEDED
001E85  3                                               ; ERR += DELTAX (RESTORE ERROR)
001E85  3  18                   CLC
001E86  3  AD FF 16             LDA     LINEERR
001E89  3  6D F6 16             ADC     DELTAX
001E8C  3  8D FF 16             STA     LINEERR
001E8F  3  AD 00 17             LDA     LINEERR+1
001E92  3  6D F7 16             ADC     DELTAX+1
001E95  3  8D 00 17             STA     LINEERR+1
001E98  3                                               ; STEP Y TOWARD Y2
001E98  3  AD F4 16             LDA     LINEY2
001E9B  3  CD F0 16             CMP     LINEY1
001E9E  3  90 06                BCC     LINEHORZ_DECY   ; Y2 < Y1, DECREMENT
001EA0  3  EE F0 16             INC     LINEY1          ; Y2 >= Y1, INCREMENT
001EA3  3  4C A9 1E             JMP     LINEHORZ_NOSTEP
001EA6  3               LINEHORZ_DECY:
001EA6  3  CE F0 16             DEC     LINEY1
001EA9  3               LINEHORZ_NOSTEP:
001EA9  3               
001EA9  3  AD EE 16             LDA     LINEX1
001EAC  3  CD F2 16             CMP     LINEX2
001EAF  3  D0 96                BNE     LINEHORZLOOP
001EB1  3  AD EF 16             LDA     LINEX1+1
001EB4  3  CD F3 16             CMP     LINEX2+1
001EB7  3  D0 8E                BNE     LINEHORZLOOP
001EB9  3  60                   RTS                     ; DONE
001EBA  3               
001EBA  3               LINESWAPXY:
001EBA  3  AD EE 16             LDA     LINEX1
001EBD  3  AC F2 16             LDY     LINEX2
001EC0  3  8C EE 16             STY     LINEX1
001EC3  3  8D F2 16             STA     LINEX2
001EC6  3  AD EF 16             LDA     LINEX1+1
001EC9  3  AC F3 16             LDY     LINEX2+1
001ECC  3  8C EF 16             STY     LINEX1+1
001ECF  3  8D F3 16             STA     LINEX2+1
001ED2  3               ;
001ED2  3  AD F0 16             LDA     LINEY1
001ED5  3  AC F4 16             LDY     LINEY2
001ED8  3  8C F0 16             STY     LINEY1
001EDB  3  8D F4 16             STA     LINEY2
001EDE  3  AD F1 16             LDA     LINEY1+1
001EE1  3  AC F5 16             LDY     LINEY2+1
001EE4  3  8C F1 16             STY     LINEY1+1
001EE7  3  8D F5 16             STA     LINEY2+1
001EEA  3  60                   RTS
001EEB  3                       .ELSE
001EEB  3               
001EEB  3               
001EEB  3               ; ENSURE ALL OF THESE SPECIAL COMMANDS GIVE ERRORS IN NORMAL BASIC
001EEB  3               LAB_SPEEK:
001EEB  3               LAB_SPOKE:
001EEB  3               LAB_SCRCLR:
001EEB  3               LAB_SCREEN:
001EEB  3               LAB_PATTERN:
001EEB  3               LAB_PLOT:
001EEB  3               LAB_LOCATE:
001EEB  3               LAB_COLOR:
001EEB  3               LAB_LINE:
001EEB  3                       LDX     #$02            ; error code $02 ("SYNTAX" error)
001EEB  3                       JMP     LAB_XERR        ; do error #X, then warm start
001EEB  3               
001EEB  3                       .ENDIF
001EEB  3               
001EEB  2                       .INCLUDE "sid.asm"
001EEB  3               
001EEB  3               
001EEB  3                       .IFDEF  MEMORYMAPPEDSCREEN
001EEB  3               
001EEB  3               PC6502_IO       = $E000
001EEB  3               SID_BASE        = PC6502_IO+$100
001EEB  3               
001EEB  3               ;___SOUND__________________________________________________
001EEB  3               ;
001EEB  3               ; PLAY SOUND
001EEB  3               ;
001EEB  3               ;  SOUND VOICE, FREQ, DUTY, WAVEFORM, ATTACK, SUSTAIN, DECAY, RELEASE
001EEB  3               ;
001EEB  3               ;
001EEB  3               ;__________________________________________________________
001EEB  3               LAB_SOUND:
001EEB  3  20 26 35             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (VOICE)
001EEE  3  8A                   TXA
001EEF  3  29 03                AND     #3
001EF1  3  0A                   ASL     A
001EF2  3  AA                   TAX
001EF3  3  BD 6D 1F             LDA     SIDVOICELOOKUP,X
001EF6  3  85 FD                STA     TEMPW
001EF8  3  BD 6E 1F             LDA     SIDVOICELOOKUP+1,X
001EFB  3  85 FE                STA     TEMPW+1
001EFD  3                                               ; OK, TEMPW POINTS TO SID REGISTER TO MODIFY
001EFD  3  20 95 2C             JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001F00  3  20 63 2B             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001F03  3                                               ; else do type mismatch
001F03  3  20 8C 35             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001F06  3  A0 00                LDY     #0              ; SET FREQUENCY
001F08  3  A5 11                LDA     Itempl
001F0A  3  91 FD                STA     (TEMPW),Y
001F0C  3  A5 12                LDA     Itemph
001F0E  3  E8                   INX
001F0F  3  91 FD                STA     (TEMPW),Y
