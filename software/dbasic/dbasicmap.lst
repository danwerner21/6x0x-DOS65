001361  3               ;  LOAD A BASIC PROGRAM FROM DISK TO MEMORY
001361  3               ;
001361  3               ;__________________________________________________________
001361  3               V_LOAD: ; load BASIC program
001361  3               DOS65LOAD:
001361  3  A9 00                LDA     #$00
001363  3  8D 69 14             STA     NullCounter
001366  3  20 1F 14             JSR     DOS65FCBPREP    ; parse parameters into FCB
001369  3  B0 20                BCS     DOS65LOAD_ERR1  ; Error?, if so abort
00136B  3  A2 0D                LDX     #13             ;
00136D  3  20 A4 12             JSR     PEM             ;
001370  3  A9 00                LDA     #0              ; clear
001372  3  8D E7 16             STA     FCB+32          ; record number
001375  3  A9 C7                LDA     #<FCB           ; Open File
001377  3  A0 16                LDY     #>FCB           ;
001379  3  A2 0F                LDX     #15             ;
00137B  3  20 A4 12             JSR     PEM             ;
00137E  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
001380  3  D0 0C                BNE     DOS65LOAD_1     ;
001382  3               DOS65LOAD_ERR:
001382  3  A9 BE                LDA     #<FILEERROR2    ; NO, ERROR OUT
001384  3  A0 0F                LDY     #>FILEERROR2
001386  3  A2 09                LDX     #9              ; Print error message
001388  3  20 A4 12             JSR     PEM             ;
00138B  3               DOS65LOAD_ERR1:
00138B  3  4C FD 25             JMP     LAB_REM         ; comment out the remainder of the line (if any)
00138E  3               DOS65LOAD_1:
00138E  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
001390  3  85 22                STA     FCBPTR+2        ; point to base of RAM
001392  3  8D 67 14             STA     EndOfBas        ;
001395  3  A5 7A                LDA     <Smemh          ;
001397  3  85 23                STA     FCBPTR+3        ;
001399  3  8D 68 14             STA     EndOfBas+1      ;
00139C  3  A9 DA                LDA     #<FCBBUFFER     ; SETUP BUFFER
00139E  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
0013A0  3  A0 3F                LDY     #>FCBBUFFER     ;
0013A2  3  84 21                STY     FCBPTR+1        ; STORE DEST BUFFER IN FCBPTR
0013A4  3  A2 1A                LDX     #26             ; Setup Buffer
0013A6  3  20 A4 12             JSR     PEM             ;
0013A9  3  4C E7 13             JMP     DOS65LOAD_3C
0013AC  3               DOS65LOAD_3:
0013AC  3  B1 20                LDA     (FCBPTR),Y      ; load from BUFFER
0013AE  3  91 22                STA     (FCBPTR+2),Y    ; save to RAM
0013B0  3  EE 67 14             INC     EndOfBas
0013B3  3  D0 03                BNE     :+
0013B5  3  EE 68 14             INC     EndOfBas+1
0013B8  3               :
0013B8  3  C9 00                CMP     #$00
0013BA  3  D0 0D                BNE     :+
0013BC  3  EE 69 14             INC     NullCounter
0013BF  3  AD 69 14             LDA     NullCounter
0013C2  3  C9 03                CMP     #3
0013C4  3  D0 08                BNE     :++
0013C6  3  4C FA 13             JMP     DOS65LOAD_4
0013C9  3               :
0013C9  3  A9 00                LDA     #$00
0013CB  3  8D 69 14             STA     NullCounter
0013CE  3               :
0013CE  3  C8                   INY                     ; bump index
0013CF  3  C0 80                CPY     #$80            ; end of buffer?
0013D1  3  D0 D9                BNE     DOS65LOAD_3     ; no, loop
0013D3  3  18                   CLC                     ;
0013D4  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
0013D6  3  69 80                ADC     #$80            ;
0013D8  3  85 22                STA     FCBPTR+2        ;
0013DA  3  90 0B                BCC     DOS65LOAD_3C    ; is carry?, no SKIP
0013DC  3  18                   CLC                     ; yes, carry, inc high byte
0013DD  3  A5 23                LDA     FCBPTR+3        ;
0013DF  3  69 01                ADC     #$01            ;
0013E1  3  85 23                STA     FCBPTR+3        ;
0013E3  3  C9 B8                CMP     #>Ram_top       ; are we at the end of RAM?
0013E5  3  F0 13                BEQ     DOS65LOAD_4
0013E7  3               
0013E7  3               DOS65LOAD_3C:
0013E7  3  A9 C7                LDA     #<FCB           ; READ record buffer from disk file
0013E9  3  A0 16                LDY     #>FCB           ;
0013EB  3  A2 14                LDX     #20             ;
0013ED  3  20 A4 12             JSR     PEM             ;
0013F0  3  A0 00                LDY     #$00            ; RESET INDEX
0013F2  3  C9 00                CMP     #$00            ; is error or EOF
0013F4  3  F0 B6                BEQ     DOS65LOAD_3     ;
0013F6  3  C9 01                CMP     #$01            ; EOF?
0013F8  3  D0 88                BNE     DOS65LOAD_ERR   ; ERROR, do error handling
0013FA  3               DOS65LOAD_4:
0013FA  3  A9 C7                LDA     #<FCB           ;
0013FC  3  A0 16                LDY     #>FCB           ;
0013FE  3  A2 10                LDX     #16             ;
001400  3  20 A4 12             JSR     PEM             ;
001403  3                                               ; setup pointers to return to basic
001403  3  AD 67 14             LDA     EndOfBas
001406  3  85 7B                STA     Svarl
001408  3  85 7D                STA     Sarryl
00140A  3  85 7F                STA     Earryl
00140C  3  AD 68 14             LDA     EndOfBas+1
00140F  3  85 7C                STA     Svarh
001411  3  85 7E                STA     Sarryh
001413  3  85 80                STA     Earryh
001415  3  A9 65                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
001417  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
001419  3  20 B2 27             JSR     LAB_18C3
00141C  3  4C EA 20             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
00141F  3               
00141F  3               
