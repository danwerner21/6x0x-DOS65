001DDC  3               
001DDC  3               V_PLOT_HIRES_MONO:
001DDC  3  AD 07 19             LDA     PLOTX
001DDF  3  48                   PHA
001DE0  3  4E 08 19             LSR     PLOTX+1
001DE3  3  6E 07 19             ROR     PLOTX
001DE6  3  4E 08 19             LSR     PLOTX+1
001DE9  3  6E 07 19             ROR     PLOTX
001DEC  3  4E 08 19             LSR     PLOTX+1
001DEF  3  6E 07 19             ROR     PLOTX           ; 8 PIXEL PER BYTE
001DF2  3  A9 00                LDA     #00
001DF4  3  8D 08 19             STA     PLOTX+1
001DF7  3  8D 1C 19             STA     PTEMPW1+1
001DFA  3  AD 09 19             LDA     PLOTY
001DFD  3  8D 1B 19             STA     PTEMPW1
001E00  3                                               ; MULTIPLY Y COORD BY 35 OR 70 (MONO OR QUAD HIRES)
001E00  3  0E 09 19             ASL     PLOTY
001E03  3  2E 0A 19             ROL     PLOTY+1         ; *2
001E06  3  AD 09 19             LDA     PLOTY
001E09  3  8D 19 19             STA     PTEMPW
001E0C  3  AD 0A 19             LDA     PLOTY+1
001E0F  3  8D 1A 19             STA     PTEMPW+1        ; STORE *2 INTO PTEMPW
001E12  3  0E 09 19             ASL     PLOTY
001E15  3  2E 0A 19             ROL     PLOTY+1         ; *2 (*4)
001E18  3  0E 09 19             ASL     PLOTY
001E1B  3  2E 0A 19             ROL     PLOTY+1         ; *2 (*8)
001E1E  3  0E 09 19             ASL     PLOTY
001E21  3  2E 0A 19             ROL     PLOTY+1         ; *2 (*16)
001E24  3  0E 09 19             ASL     PLOTY
001E27  3  2E 0A 19             ROL     PLOTY+1         ; *2 (*32)
001E2A  3               ;
001E2A  3               ; PLOTY(Y*35) = PLOTY(Y*32)+PTEMPW(Y*2)+PTEMPW1(Y)
001E2A  3  18                   CLC                     ; Clear the Carry flag before the first addition
001E2B  3  AD 09 19             LDA     PLOTY           ; Load the low byte of the first number into the accumulator
001E2E  3  6D 19 19             ADC     PTEMPW          ; Add the low byte of the second number (plus carry)
001E31  3  8D 09 19             STA     PLOTY           ; Store the low byte of the result
001E34  3               
001E34  3  AD 0A 19             LDA     PLOTY+1         ; Load the high byte of the first number
001E37  3  6D 1A 19             ADC     PTEMPW+1        ; Add the high byte of the second number (plus carry from previous op)
001E3A  3  8D 0A 19             STA     PLOTY+1         ; Store the high byte of the result
001E3D  3  18                   CLC                     ; Clear the Carry flag before the first addition
001E3E  3  AD 09 19             LDA     PLOTY           ; Load the low byte of the first number into the accumulator
001E41  3  6D 1B 19             ADC     PTEMPW1         ; Add the low byte of the second number (plus carry)
001E44  3  8D 09 19             STA     PLOTY           ; Store the low byte of the result
001E47  3               
001E47  3  AD 0A 19             LDA     PLOTY+1         ; Load the high byte of the first number
001E4A  3  6D 1C 19             ADC     PTEMPW1+1       ; Add the high byte of the second number (plus carry from previous op)
001E4D  3  8D 0A 19             STA     PLOTY+1         ; Store the high byte of the result
001E50  3               ;
001E50  3               ; PLOTY IS NOW THE Y OFFSET
001E50  3               ; if quad hires double it.
001E50  3  AD 04 19             LDA     VIDEOMODE
001E53  3  29 10                AND     #$10
001E55  3  C9 00                CMP     #00
001E57  3  D0 06                BNE     :+
001E59  3  0E 09 19             ASL     PLOTY
001E5C  3  2E 0A 19             ROL     PLOTY+1         ; *2
001E5F  3               :
001E5F  3               ; ADD THE X OFFSET
001E5F  3  18                   CLC                     ; Clear the Carry flag before the first addition
001E60  3  AD 09 19             LDA     PLOTY           ; Load the low byte of the first number into the accumulator
001E63  3  6D 07 19             ADC     PLOTX           ; Add the low byte of the second number (plus carry)
001E66  3  85 FD                STA     TEMPW           ; Store the low byte of the result
001E68  3               
001E68  3  AD 0A 19             LDA     PLOTY+1         ; Load the high byte of the first number
001E6B  3  6D 08 19             ADC     PLOTX+1         ; Add the high byte of the second number (plus carry from previous op)
001E6E  3  85 FE                STA     TEMPW+1         ; Store the high byte of the result
001E70  3                                               ; TEMPW IS NOW THE MEMORY ADDRESS
001E70  3               
001E70  3  A5 FE                LDA     TEMPW+1         ; OK, LET'S CALCULATE THE BANK
001E72  3  29 F0                AND     #$F0
001E74  3  4A                   LSR     A
001E75  3  4A                   LSR     A
001E76  3  4A                   LSR     A
001E77  3  4A                   LSR     A
001E78  3  18                   CLC
001E79  3  69 FA                ADC     #$02+VIDEOBANK  ; AREA $2000-?
001E7B  3  C9 F8                CMP     #$F8
001E7D  3  90 32                BCC     V_PLOT_HIRES_COLOR_RANGE1
001E7F  3  A8                   TAY                     ; VIDEO BANK SHOULD BE IN Y
001E80  3  20 0C 1C             JSR     PAGE_ENTER
001E83  3  A5 FE                LDA     TEMPW+1
001E85  3  29 0F                AND     #$0F
001E87  3  09 A0                ORA     #$A0
001E89  3  85 FE                STA     TEMPW+1         ; TEMPW NOW REFLECTS MAPPED ADDRESSS
001E8B  3  68                   PLA
001E8C  3  29 07                AND     #$07            ; WHICH BIT?
001E8E  3  AA                   TAX
001E8F  3  AD 0B 19             LDA     PLOTCOLOR
001E92  3  C9 01                CMP     #$01
001E94  3  D0 0D                BNE     :+
001E96  3  BD B4 1E             LDA     HIRES_BIT_LOOKUP_SET,X
001E99  3  A0 00                LDY     #$00
001E9B  3  11 FD                ORA     (TEMPW),Y
001E9D  3  91 FD                STA     (TEMPW),Y
001E9F  3  20 06 1C             JSR     PAGE_EXIT
001EA2  3  60                   RTS
001EA3  3               :
