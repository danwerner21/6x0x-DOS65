001C5B  3               V_PLOT_LORES:
001C5B  3  AD 07 19             LDA     PLOTY
001C5E  3  48                   PHA
001C5F  3  4A                   LSR     A               ; 2 LINES PER BYTE
001C60  3  8D 07 19             STA     PLOTY
001C63  3                                               ; MULTIPLY Y (PTEMPW) COORD BY 40 OR 80 (SINGLE OR DOUBLE LORES)
001C63  3  18                   CLC
001C64  3  0E 07 19             ASL     PLOTY
001C67  3  2E 08 19             ROL     PLOTY+1         ; *2
001C6A  3  0E 07 19             ASL     PLOTY
001C6D  3  2E 08 19             ROL     PLOTY+1         ; *2 (*4)
001C70  3  0E 07 19             ASL     PLOTY
001C73  3  2E 08 19             ROL     PLOTY+1         ; *2 (*8)
001C76  3  AD 07 19             LDA     PLOTY
001C79  3  8D 17 19             STA     PTEMPW
001C7C  3  AD 08 19             LDA     PLOTY+1
001C7F  3  8D 18 19             STA     PTEMPW+1        ; STORE Y*8 INTO PTEMPW
001C82  3  0E 07 19             ASL     PLOTY
001C85  3  2E 08 19             ROL     PLOTY+1         ; *2 (*16)
001C88  3  0E 07 19             ASL     PLOTY
001C8B  3  2E 08 19             ROL     PLOTY+1         ; *2 (*32)
001C8E  3               ; NOW TAKE Y*8(PTEMPW) + Y*32(PLOTY) == Y*40 STORE IN PLOTY
001C8E  3  18                   CLC                     ; Clear the Carry flag before the first addition
001C8F  3               
001C8F  3  AD 07 19             LDA     PLOTY           ; Load the low byte of the first number into the accumulator
001C92  3  6D 17 19             ADC     PTEMPW          ; Add the low byte of the second number (plus carry)
001C95  3  8D 07 19             STA     PLOTY           ; Store the low byte of the result
001C98  3               
001C98  3  AD 08 19             LDA     PLOTY+1         ; Load the high byte of the first number
001C9B  3  6D 18 19             ADC     PTEMPW+1        ; Add the high byte of the second number (plus carry from previous op)
001C9E  3  8D 08 19             STA     PLOTY+1         ; Store the high byte of the result
001CA1  3               
001CA1  3               ; if double lores columns double it.
001CA1  3  AD 02 19             LDA     VIDEOMODE
001CA4  3  29 10                AND     #$10
001CA6  3  C9 00                CMP     #00
001CA8  3  F0 06                BEQ     :+
001CAA  3  0E 07 19             ASL     PLOTY
001CAD  3  2E 08 19             ROL     PLOTY+1         ; *2
001CB0  3               :
001CB0  3               ; OK, Y OFFSET IS IN PTEMPW1, X IS IN PTEMPW
001CB0  3  A9 A0                LDA     #$A0            ; ADD THE MEMORY OFFSET TO PTEMPW (BECAUSE IT IS EASY)
001CB2  3  8D 06 19             STA     PLOTX+1         ; THEN ADD PTEMPW1 TO PTEMPW THAT SHOULD BE THE MEMORY ADDRESS TO UPDATE
001CB5  3                                               ;
001CB5  3  18                   CLC                     ; Clear the Carry flag before the first addition
001CB6  3  AD 05 19             LDA     PLOTX           ; Load the low byte of the first number into the accumulator
001CB9  3  6D 07 19             ADC     PLOTY           ; Add the low byte of the second number (plus carry)
001CBC  3  85 FD                STA     TEMPW           ; Store the low byte of the result
001CBE  3               
001CBE  3  AD 06 19             LDA     PLOTX+1         ; Load the high byte of the first number
001CC1  3  6D 08 19             ADC     PLOTY+1         ; Add the high byte of the second number (plus carry from previous op)
001CC4  3  85 FE                STA     TEMPW+1         ; Store the high byte of the result
001CC6  3                                               ; PTEMPW IS THE MEMORY OFFSET TO UPDATE
001CC6  3  68                   PLA
001CC7  3  4A                   LSR     A               ; TOP OR BOTTOM PIXEL?
001CC8  3  90 20                BCC     :+
001CCA  3                                               ; TOP PIXEL
001CCA  3  A0 FA                LDY     #$02+VIDEOBANK  ; AREA $2000-$2FFF
001CCC  3  20 0A 1C             JSR     PAGE_ENTER
001CCF  3  A0 00                LDY     #$00
001CD1  3  B1 FD                LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
001CD3  3  29 0F                AND     #$0F
001CD5  3  48                   PHA
001CD6  3  AD 09 19             LDA     PLOTCOLOR
001CD9  3  0A                   ASL     A
001CDA  3  0A                   ASL     A
001CDB  3  0A                   ASL     A
001CDC  3  0A                   ASL     A
001CDD  3  8D 09 19             STA     PLOTCOLOR
001CE0  3  68                   PLA
001CE1  3  0D 09 19             ORA     PLOTCOLOR
001CE4  3  91 FD                STA     (TEMPW),Y       ; STORE  DOUBLE PIXEL
001CE6  3  20 04 1C             JSR     PAGE_EXIT
001CE9  3  60                   RTS
001CEA  3               :
001CEA  3                                               ; BOTTOM PIXEL
001CEA  3  A0 FA                LDY     #$02+VIDEOBANK  ; AREA $2000-$2FFF
001CEC  3  20 0A 1C             JSR     PAGE_ENTER
001CEF  3  A0 00                LDY     #$00
001CF1  3  B1 FD                LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
001CF3  3  29 F0                AND     #$F0
001CF5  3  0D 09 19             ORA     PLOTCOLOR
001CF8  3  91 FD                STA     (TEMPW),Y       ; STORE  DOUBLE PIXEL
001CFA  3  20 04 1C             JSR     PAGE_EXIT
001CFD  3  60                   RTS
