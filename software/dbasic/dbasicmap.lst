00152E  3                                               ; space returns with A = length, X=$71=pointer low byte,
00152E  3                                               ; Y=$72=pointer high byte
00152E  3  85 AC                STA     str_ln          ; set string length
001530  3  86 AD                STX     str_pl          ; set string pointer low byte
001532  3  84 AE                STY     str_ph          ; set string pointer high byte
001534  3                                               ; STORE IN FILENAME AND EXTENSION
001534  3  A2 00                LDX     #0
001536  3  A0 00                LDY     #0
001538  3               :
001538  3  B1 AD                LDA     (str_pl),Y
00153A  3  C9 2E                CMP     #'.'
00153C  3  F0 1E                BEQ     V_OPEN_EXTENSION
00153E  3  C4 AC                CPY     str_ln
001540  3  F0 35                BEQ     V_OPEN_FNEND
001542  3  C8                   INY
001543  3  99 3E 18             STA     FCB,Y
001546  3  C0 08                CPY     #8
001548  3  D0 EE                BNE     :-
00154A  3  88                   DEY
00154B  3               :
00154B  3  C8                   INY
00154C  3  B1 AD                LDA     (str_pl),Y
00154E  3  C9 2E                CMP     #'.'
001550  3  F0 0A                BEQ     V_OPEN_EXTENSION
001552  3  C4 AC                CPY     str_ln
001554  3  F0 21                BEQ     V_OPEN_FNEND
001556  3  4C 4B 15             JMP     :-
001559  3  4C 77 15             JMP     V_OPEN_FNEND
00155C  3               V_OPEN_EXTENSION:
00155C  3  A2 09                LDX     #9
00155E  3               :
