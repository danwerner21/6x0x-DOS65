001DE1  3  6E 05 19             ROR     PLOTX
001DE4  3  4E 06 19             LSR     PLOTX+1
001DE7  3  6E 05 19             ROR     PLOTX
001DEA  3  4E 06 19             LSR     PLOTX+1
001DED  3  6E 05 19             ROR     PLOTX           ; 8 PIXEL PER BYTE
001DF0  3  A9 00                LDA     #00
001DF2  3  8D 06 19             STA     PLOTX+1
001DF5  3  8D 1A 19             STA     PTEMPW1+1
001DF8  3  AD 07 19             LDA     PLOTY
001DFB  3  8D 19 19             STA     PTEMPW1
001DFE  3                                               ; MULTIPLY Y COORD BY 35 OR 70 (MONO OR QUAD HIRES)
001DFE  3  0E 07 19             ASL     PLOTY
001E01  3  2E 08 19             ROL     PLOTY+1         ; *2
001E04  3  AD 07 19             LDA     PLOTY
001E07  3  8D 17 19             STA     PTEMPW
001E0A  3  AD 08 19             LDA     PLOTY+1
001E0D  3  8D 18 19             STA     PTEMPW+1        ; STORE *2 INTO PTEMPW
001E10  3  0E 07 19             ASL     PLOTY
001E13  3  2E 08 19             ROL     PLOTY+1         ; *2 (*4)
001E16  3  0E 07 19             ASL     PLOTY
001E19  3  2E 08 19             ROL     PLOTY+1         ; *2 (*8)
001E1C  3  0E 07 19             ASL     PLOTY
001E1F  3  2E 08 19             ROL     PLOTY+1         ; *2 (*16)
001E22  3  0E 07 19             ASL     PLOTY
001E25  3  2E 08 19             ROL     PLOTY+1         ; *2 (*32)
001E28  3               ;
001E28  3               ; PLOTY(Y*35) = PLOTY(Y*32)+PTEMPW(Y*2)+PTEMPW1(Y)
001E28  3  18                   CLC                     ; Clear the Carry flag before the first addition
001E29  3  AD 07 19             LDA     PLOTY           ; Load the low byte of the first number into the accumulator
001E2C  3  6D 17 19             ADC     PTEMPW          ; Add the low byte of the second number (plus carry)
001E2F  3  8D 07 19             STA     PLOTY           ; Store the low byte of the result
001E32  3               
