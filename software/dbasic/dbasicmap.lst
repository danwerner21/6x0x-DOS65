001EE9  3               ;___LAB_LINE_______________________________________________
001EE9  3               ;
001EE9  3               ;  DRAW LINE USING THE BRESENHAM LINE DRAWING ALGORITHM
001EE9  3               ;
001EE9  3               ;  TAKES 5 PARAMETERS
001EE9  3               ;       START X,Y
001EE9  3               ;       DESTINATION X,Y
001EE9  3               ;       COLOR
001EE9  3               ;__________________________________________________________
001EE9  3               LAB_LINE:
001EE9  3               ; GET X1
001EE9  3  20 F1 2D             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001EEC  3                                               ; else do type mismatch
001EEC  3  20 1A 38             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001EEF  3  A5 12                LDA     Itemph
001EF1  3  8D 0C 19             STA     LINEX1+1
001EF4  3  A5 11                LDA     Itempl
001EF6  3  8D 0B 19             STA     LINEX1
001EF9  3                                               ; GET Y1
001EF9  3  20 23 2F             JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001EFC  3  20 B4 37             JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
001EFF  3  8E 0D 19             STX     LINEY1          ; STORE IN LINEY1
001F02  3               
001F02  3               ; GET X2
001F02  3  20 23 2F             JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001F05  3  20 F1 2D             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001F08  3                                               ; else do type mismatch
001F08  3  20 1A 38             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001F0B  3  A5 12                LDA     Itemph
001F0D  3  8D 10 19             STA     LINEX2+1
001F10  3  A5 11                LDA     Itempl
001F12  3  8D 0F 19             STA     LINEX2
001F15  3                                               ; GET Y2
001F15  3  20 23 2F             JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
001F18  3  20 B4 37             JSR     LAB_GTBY        ; RETURN IN X
001F1B  3  8E 11 19             STX     LINEY2          ; STORE IN LINEY2
001F1E  3                                               ; GET COLOR
001F1E  3  20 23 2F             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001F21  3  20 B4 37             JSR     LAB_GTBY        ; RETURN IN X
001F24  3  8E 0A 19             STX     LINECOLOR       ; STORE IN COLOR
001F27  3  A9 00                LDA     #$00
001F29  3  8D 0E 19             STA     LINEY1+1
001F2C  3  8D 12 19             STA     LINEY2+1
001F2F  3                                               ; LINE COORDS AND COLOR STORED IN PROPER PLACE
001F2F  3                                               ; CALCULATE DELTAX
001F2F  3  38                   SEC                     ; Set Carry flag (represents "no borrow" for 1st byte)
001F30  3  AD 0B 19             LDA     LINEX1          ; Load low byte of number 1
001F33  3  ED 0F 19             SBC     LINEX2          ; Subtract low byte of number 2 with carry
001F36  3  8D 13 19             STA     DELTAX          ; Store result low byte
001F39  3  AD 0C 19             LDA     LINEX1+1        ; Load high byte of number 1
001F3C  3  ED 10 19             SBC     LINEX2+1        ; Subtract high byte of number 2 with borrow
001F3F  3  8D 14 19             STA     DELTAX+1        ; Store result high byte
001F42  3  B0 20                BCS     :+              ; BRANCH IF X1>=X2
001F44  3                                               ; X1 < X2
001F44  3  A9 00                LDA     #0
001F46  3  8D 1B 19             STA     PTEMP           ; IF X2>X1 (PTEMP=x0)
001F49  3  A9 FF                LDA     #$FF            ; TAKE ABSOLUTE VALUE OF DELTAX
001F4B  3  4D 14 19             EOR     DELTAX+1        ; Invert high byte (one's complement)
001F4E  3  8D 14 19             STA     DELTAX+1
001F51  3  A9 FF                LDA     #$FF            ;
001F53  3  4D 13 19             EOR     DELTAX          ; Invert low byte
001F56  3  8D 13 19             STA     DELTAX          ;
001F59  3  EE 13 19             INC     DELTAX          ; Add 1 to the low byte
001F5C  3  D0 0B                BNE     :++             ; If no carry from low byte INC, we are done
001F5E  3  EE 14 19             INC     DELTAX+1        ; Increment high byte if carry occurred
001F61  3  4C 69 1F             JMP     :++
001F64  3               :
001F64  3  A9 01                LDA     #1
001F66  3  8D 1B 19             STA     PTEMP           ; IF X1>X2 (PTEMP=x1)
001F69  3               :
001F69  3                                               ; CALCULATE DELTAY
001F69  3  A9 00                LDA     #0
001F6B  3  8D 16 19             STA     DELTAY+1
001F6E  3  38                   SEC                     ; Set Carry flag
001F6F  3  AD 0D 19             LDA     LINEY1          ; Load low byte of number 1
001F72  3  ED 11 19             SBC     LINEY2          ; Subtract low byte of number 2 with carry
001F75  3  8D 15 19             STA     DELTAY          ; Store result low byte
001F78  3  B0 16                BCS     :+              ; BRANCH IF Y1>=Y2
001F7A  3                                               ; Y1 < Y2
001F7A  3  AD 1B 19             LDA     PTEMP
001F7D  3  29 01                AND     #1
001F7F  3  8D 1B 19             STA     PTEMP           ; IF Y2>Y1 (PTEMP=0x)
001F82  3                                               ; TAKE ABSOLUTE VALUE OF DELTAY
001F82  3  A9 FF                LDA     #$FF
001F84  3  4D 15 19             EOR     DELTAY          ; Flip all bits (one's complement)
001F87  3  8D 15 19             STA     DELTAY
001F8A  3  EE 15 19             INC     DELTAY          ; Add 1 (two's complement)
001F8D  3  4C 98 1F             JMP     :++
001F90  3               :
001F90  3  AD 1B 19             LDA     PTEMP
001F93  3  09 10                ORA     #$10
001F95  3  8D 1B 19             STA     PTEMP           ; IF Y1>Y2 (PTEMP=1x)
001F98  3               :
001F98  3                                               ; SLOPE DETERMINED, AND DELTAS CALCULATED
001F98  3                                               ; OK, LET'S FIND OUT IF THIS IS A HORIZONTAL-ISH
001F98  3                                               ; OR VERTICAL-ISH LINE
001F98  3  38                   SEC                     ; Set Carry Flag (for subtraction)
001F99  3  AD 13 19             LDA     DELTAX          ; Load low byte of DELTAX
001F9C  3  ED 15 19             SBC     DELTAY          ; Subtract low byte of DELTAY
001F9F  3  AD 14 19             LDA     DELTAX+1        ; Load high byte of DELTAX
001FA2  3  ED 16 19             SBC     DELTAY+1        ; Subtract high byte of DELTAY (with borrow)
001FA5  3                                               ; Flags now reflect the 16-bit comparison
001FA5  3  90 03                BCC     LINEVERT        ; If Carry clear, LINE IS VERTICAL-ISH
001FA7  3  4C 40 20             JMP     LINEHORZ
001FAA  3               LINEVERT:
001FAA  3                                               ; FOR A VERTICAL-ISH LINE WE STEP ALONG THE
001FAA  3                                               ; Y AXIS (STEEP GRADIENT)
001FAA  3                                               ; FIND LARGER Y . . .
001FAA  3  AD 0D 19             LDA     LINEY1
001FAD  3  CD 11 19             CMP     LINEY2
001FB0  3  B0 03                BCS     :+
001FB2  3  20 D7 20             JSR     LINESWAPXY
001FB5  3               :
001FB5  3                                               ; Initialize error = DELTAY / 2
001FB5  3  AD 15 19             LDA     DELTAY
001FB8  3  8D 1C 19             STA     LINEERR
001FBB  3  AD 16 19             LDA     DELTAY+1
001FBE  3  8D 1D 19             STA     LINEERR+1
001FC1  3  4E 1D 19             LSR     LINEERR+1
001FC4  3  6E 1C 19             ROR     LINEERR
001FC7  3               LINEVERTLOOP:
001FC7  3  AD 0D 19             LDA     LINEY1          ; OK LET'S PLOT A POINT
001FCA  3  8D 07 19             STA     PLOTY
001FCD  3  AD 0E 19             LDA     LINEY1+1
001FD0  3  8D 08 19             STA     PLOTY+1
001FD3  3  AD 0B 19             LDA     LINEX1
001FD6  3  8D 05 19             STA     PLOTX
001FD9  3  AD 0C 19             LDA     LINEX1+1
001FDC  3  8D 06 19             STA     PLOTX+1
001FDF  3  AD 0A 19             LDA     LINECOLOR
001FE2  3  8D 09 19             STA     PLOTCOLOR
001FE5  3  20 3E 1C             JSR     DOPLOTXY
001FE8  3                                               ; NOW MOVE LINE1 CLOSER TO LINE2
001FE8  3  CE 0D 19             DEC     LINEY1          ; BY STEPPING ALONG Y AXIS
001FEB  3               
001FEB  3               ; BRESENHAM: err -= DELTAX
001FEB  3  38                   SEC
001FEC  3  AD 1C 19             LDA     LINEERR
001FEF  3  ED 13 19             SBC     DELTAX
001FF2  3  8D 1C 19             STA     LINEERR
001FF5  3  AD 1D 19             LDA     LINEERR+1
001FF8  3  ED 14 19             SBC     DELTAX+1
001FFB  3  8D 1D 19             STA     LINEERR+1
001FFE  3  10 37                BPL     LINEVERT_NOSTEP ; IF ERR >= 0, NO X STEP NEEDED
002000  3                                               ; ERR += DELTAY (RESTORE ERROR)
002000  3  18                   CLC
002001  3  AD 1C 19             LDA     LINEERR
002004  3  6D 15 19             ADC     DELTAY
002007  3  8D 1C 19             STA     LINEERR
00200A  3  AD 1D 19             LDA     LINEERR+1
00200D  3  6D 16 19             ADC     DELTAY+1
002010  3  8D 1D 19             STA     LINEERR+1
002013  3                                               ; STEP X TOWARD X2 (16-BIT)
002013  3  AD 0F 19             LDA     LINEX2
002016  3  CD 0B 19             CMP     LINEX1
002019  3  AD 10 19             LDA     LINEX2+1
00201C  3  ED 0C 19             SBC     LINEX1+1
00201F  3  90 0B                BCC     LINEVERT_DECX   ; X2 < X1, DECREMENT X1
002021  3  EE 0B 19             INC     LINEX1          ; X2 >= X1, INCREMENT X1
002024  3  D0 11                BNE     LINEVERT_NOSTEP
002026  3  EE 0C 19             INC     LINEX1+1
002029  3  4C 37 20             JMP     LINEVERT_NOSTEP
00202C  3               LINEVERT_DECX:
00202C  3  AD 0B 19             LDA     LINEX1
00202F  3  D0 03                BNE     :+
002031  3  CE 0C 19             DEC     LINEX1+1
002034  3               :
002034  3  CE 0B 19             DEC     LINEX1
002037  3               LINEVERT_NOSTEP:
002037  3               
002037  3  AD 0D 19             LDA     LINEY1
00203A  3  CD 11 19             CMP     LINEY2
00203D  3  D0 88                BNE     LINEVERTLOOP
00203F  3  60                   RTS                     ; DONE
002040  3               
002040  3               LINEHORZ:
002040  3               ; FOR A HORIZONTAL-ISH LINE WE STEP ALONG THE
002040  3               ; X AXIS (SHALLOW GRADIENT)
002040  3               ; FIND LARGER X . . .
002040  3  38                   SEC                     ; Set carry flag for subtraction
002041  3  AD 0F 19             LDA     LINEX2          ; Load low byte of first number
002044  3  ED 0B 19             SBC     LINEX1          ; Subtract low byte of second number
002047  3  AD 10 19             LDA     LINEX2+1        ; Load high byte of first number
00204A  3  ED 0C 19             SBC     LINEX1+1        ; Subtract high byte of second number
00204D  3                                               ; Result flags (N, Z, C) now reflect: Val1 - Val2
00204D  3  B0 03                BCS     :+              ; If carry is set, LINEX2 >= LINEX1
00204F  3  20 D7 20             JSR     LINESWAPXY
002052  3               :
002052  3                                               ; Initialize error = DELTAX / 2
002052  3  AD 13 19             LDA     DELTAX
002055  3  8D 1C 19             STA     LINEERR
002058  3  AD 14 19             LDA     DELTAX+1
00205B  3  8D 1D 19             STA     LINEERR+1
00205E  3  4E 1D 19             LSR     LINEERR+1
002061  3  6E 1C 19             ROR     LINEERR
002064  3               LINEHORZLOOP:
002064  3  AD 0D 19             LDA     LINEY1          ; OK LET'S PLOT A POINT
002067  3  8D 07 19             STA     PLOTY
00206A  3  AD 0E 19             LDA     LINEY1+1
00206D  3  8D 08 19             STA     PLOTY+1
002070  3  AD 0B 19             LDA     LINEX1
002073  3  8D 05 19             STA     PLOTX
002076  3  AD 0C 19             LDA     LINEX1+1
002079  3  8D 06 19             STA     PLOTX+1
00207C  3  AD 0A 19             LDA     LINECOLOR
00207F  3  8D 09 19             STA     PLOTCOLOR
002082  3  20 3E 1C             JSR     DOPLOTXY
002085  3                                               ; NOW MOVE LINE1 CLOSER TO LINE2
002085  3  EE 0B 19             INC     LINEX1          ; BY STEPPING ALONG X AXIS
002088  3  D0 03                BNE     :+
00208A  3  EE 0C 19             INC     LINEX1+1
00208D  3               :
00208D  3                                               ; BRESENHAM: err -= DELTAY
00208D  3  38                   SEC
00208E  3  AD 1C 19             LDA     LINEERR
002091  3  ED 15 19             SBC     DELTAY
002094  3  8D 1C 19             STA     LINEERR
002097  3  AD 1D 19             LDA     LINEERR+1
00209A  3  ED 16 19             SBC     DELTAY+1
00209D  3  8D 1D 19             STA     LINEERR+1
0020A0  3  10 24                BPL     LINEHORZ_NOSTEP ; IF ERR >= 0, NO Y STEP NEEDED
0020A2  3                                               ; ERR += DELTAX (RESTORE ERROR)
0020A2  3  18                   CLC
0020A3  3  AD 1C 19             LDA     LINEERR
0020A6  3  6D 13 19             ADC     DELTAX
0020A9  3  8D 1C 19             STA     LINEERR
0020AC  3  AD 1D 19             LDA     LINEERR+1
0020AF  3  6D 14 19             ADC     DELTAX+1
0020B2  3  8D 1D 19             STA     LINEERR+1
0020B5  3                                               ; STEP Y TOWARD Y2
0020B5  3  AD 11 19             LDA     LINEY2
0020B8  3  CD 0D 19             CMP     LINEY1
0020BB  3  90 06                BCC     LINEHORZ_DECY   ; Y2 < Y1, DECREMENT
0020BD  3  EE 0D 19             INC     LINEY1          ; Y2 >= Y1, INCREMENT
0020C0  3  4C C6 20             JMP     LINEHORZ_NOSTEP
0020C3  3               LINEHORZ_DECY:
0020C3  3  CE 0D 19             DEC     LINEY1
0020C6  3               LINEHORZ_NOSTEP:
0020C6  3               
0020C6  3  AD 0B 19             LDA     LINEX1
0020C9  3  CD 0F 19             CMP     LINEX2
0020CC  3  D0 96                BNE     LINEHORZLOOP
0020CE  3  AD 0C 19             LDA     LINEX1+1
0020D1  3  CD 10 19             CMP     LINEX2+1
0020D4  3  D0 8E                BNE     LINEHORZLOOP
0020D6  3  60                   RTS                     ; DONE
0020D7  3               
0020D7  3               LINESWAPXY:
0020D7  3  AD 0B 19             LDA     LINEX1
0020DA  3  AC 0F 19             LDY     LINEX2
0020DD  3  8C 0B 19             STY     LINEX1
0020E0  3  8D 0F 19             STA     LINEX2
0020E3  3  AD 0C 19             LDA     LINEX1+1
0020E6  3  AC 10 19             LDY     LINEX2+1
0020E9  3  8C 0C 19             STY     LINEX1+1
0020EC  3  8D 10 19             STA     LINEX2+1
0020EF  3               ;
0020EF  3  AD 0D 19             LDA     LINEY1
0020F2  3  AC 11 19             LDY     LINEY2
0020F5  3  8C 0D 19             STY     LINEY1
0020F8  3  8D 11 19             STA     LINEY2
0020FB  3  AD 0E 19             LDA     LINEY1+1
0020FE  3  AC 12 19             LDY     LINEY2+1
002101  3  8C 0E 19             STY     LINEY1+1
002104  3  8D 12 19             STA     LINEY2+1
002107  3  60                   RTS
002108  3                       .ELSE
002108  3               
002108  3               
002108  3               ; ENSURE ALL OF THESE SPECIAL COMMANDS GIVE ERRORS IN NORMAL BASIC
002108  3               LAB_SPEEK:
002108  3               LAB_SPOKE:
002108  3               LAB_SCRCLR:
002108  3               LAB_SCREEN:
002108  3               LAB_PATTERN:
002108  3               LAB_PLOT:
002108  3               LAB_LOCATE:
002108  3               LAB_COLOR:
002108  3               LAB_LINE:
002108  3                       LDX     #$02            ; error code $02 ("SYNTAX" error)
002108  3                       JMP     LAB_XERR        ; do error #X, then warm start
002108  3               
002108  3                       .ENDIF
002108  3               
002108  2                       .INCLUDE "ay38910.asm"
002108  3               
002108  3                       .IFNDEF  DUODYNE
002108  3               .pc02
002108  3               
002108  3               VIA_BASE        = $E1E0
002108  3               via1regb        = VIA_BASE+0         ; Register
002108  3               via1rega        = VIA_BASE+1         ; Register
002108  3               via1ddrb        = VIA_BASE+2         ; Register
002108  3               via1ddra        = VIA_BASE+3         ; Register
002108  3               via1t1cl        = VIA_BASE+4         ; Register
002108  3               via1t1ch        = VIA_BASE+5         ; Register
002108  3               via1t1ll        = VIA_BASE+6         ; Register
002108  3               via1t1lh        = VIA_BASE+7         ; Register
002108  3               via1t2cl        = VIA_BASE+8         ; Register
002108  3               via1t2ch        = VIA_BASE+9         ; Register
002108  3               via1sr          = VIA_BASE+$A         ; Register
002108  3               via1acr         = VIA_BASE+$B         ; Register
002108  3               via1pcr         = VIA_BASE+$C         ; Register
002108  3               via1ifr         = VIA_BASE+$D         ; Register
002108  3               via1ier         = VIA_BASE+$E         ; Register
002108  3               via1ora         = VIA_BASE+$F         ; Register
