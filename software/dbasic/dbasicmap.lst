001C6E  3  0E 35 17             ASL     PTEMPW1
001C71  3  2E 36 17             ROL     PTEMPW1+1       ; *2 (*4)
001C74  3  0E 35 17             ASL     PTEMPW1
001C77  3  2E 36 17             ROL     PTEMPW1+1       ; *2 (*8)
001C7A  3  0E 35 17             ASL     PTEMPW1
001C7D  3  2E 36 17             ROL     PTEMPW1+1       ; *2 (*16)
001C80  3  0E 35 17             ASL     PTEMPW1
001C83  3  2E 36 17             ROL     PTEMPW1+1       ; *2 (*32)
001C86  3                                               ;
001C86  3                                               ; PTEMPW1(Y*35) = PTEMPW1(Y*32)+PTEMPW2(Y*2)+PTEMPW3(Y)
001C86  3  18                   CLC                     ; Clear the Carry flag before the first addition
001C87  3  AD 35 17             LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
001C8A  3  6D 37 17             ADC     PTEMPW2         ; Add the low byte of the second number (plus carry)
001C8D  3  8D 35 17             STA     PTEMPW1         ; Store the low byte of the result
001C90  3               
001C90  3  AD 36 17             LDA     PTEMPW1+1       ; Load the high byte of the first number
001C93  3  6D 38 17             ADC     PTEMPW2+1       ; Add the high byte of the second number (plus carry from previous op)
001C96  3  8D 36 17             STA     PTEMPW1+1       ; Store the high byte of the result
001C99  3  18                   CLC                     ; Clear the Carry flag before the first addition
001C9A  3  AD 35 17             LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
001C9D  3  6D 39 17             ADC     PTEMPW3         ; Add the low byte of the second number (plus carry)
001CA0  3  8D 35 17             STA     PTEMPW1         ; Store the low byte of the result
001CA3  3               
001CA3  3  AD 36 17             LDA     PTEMPW1+1       ; Load the high byte of the first number
001CA6  3  6D 3A 17             ADC     PTEMPW3+1       ; Add the high byte of the second number (plus carry from previous op)
001CA9  3  8D 36 17             STA     PTEMPW1+1       ; Store the high byte of the result
001CAC  3                                               ;
001CAC  3                                               ; PTEMPW1 IS NOW THE Y OFFSET
001CAC  3                                               ; if quad hires double it.
001CAC  3  AD 30 17             LDA     VIDEOMODE
001CAF  3  29 10                AND     #$10
001CB1  3  C9 00                CMP     #00
001CB3  3  D0 06                BNE     :+
001CB5  3  0E 35 17             ASL     PTEMPW1
001CB8  3  2E 36 17             ROL     PTEMPW1+1       ; *2
001CBB  3               :
001CBB  3                                               ; ADD THE X OFFSET
001CBB  3  18                   CLC                     ; Clear the Carry flag before the first addition
001CBC  3  AD 35 17             LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
001CBF  3  6D 33 17             ADC     PTEMPW          ; Add the low byte of the second number (plus carry)
001CC2  3  85 FD                STA     TEMPW           ; Store the low byte of the result
001CC4  3               
001CC4  3  AD 36 17             LDA     PTEMPW1+1       ; Load the high byte of the first number
001CC7  3  6D 34 17             ADC     PTEMPW+1        ; Add the high byte of the second number (plus carry from previous op)
001CCA  3  85 FE                STA     TEMPW+1         ; Store the high byte of the result
001CCC  3                                               ; TEMPW IS NOW THE MEMORY ADDRESS
001CCC  3               
001CCC  3  A5 FE                LDA     TEMPW+1         ; OK, LET'S CALCULATE THE BANK
001CCE  3  29 F0                AND     #$F0
001CD0  3  4A                   LSR     A
001CD1  3  4A                   LSR     A
001CD2  3  4A                   LSR     A
001CD3  3  4A                   LSR     A
001CD4  3  18                   CLC
001CD5  3  69 FA                ADC     #$02+VIDEOBANK  ; AREA $2000-?
001CD7  3  C9 F8                CMP     #$F8
001CD9  3  90 32                BCC     V_PLOT_HIRES_COLOR_RANGE1
001CDB  3  A8                   TAY                     ; VIDEO BANK SHOULD BE IN Y
001CDC  3  20 29 1A             JSR     PAGE_ENTER
001CDF  3  A5 FE                LDA     TEMPW+1
001CE1  3  29 0F                AND     #$0F
001CE3  3  09 A0                ORA     #$A0
001CE5  3  85 FE                STA     TEMPW+1         ; TEMPW NOW REFLECTS MAPPED ADDRESSS
001CE7  3  68                   PLA
001CE8  3  29 07                AND     #$07            ; WHICH BIT?
001CEA  3  AA                   TAX
001CEB  3  AD 3C 17             LDA     PTEMP4
001CEE  3  C9 01                CMP     #$01
001CF0  3  D0 0D                BNE     :+
001CF2  3  BD 10 1D             LDA     HIRES_BIT_LOOKUP_SET,X
001CF5  3  A0 00                LDY     #$00
001CF7  3  11 FD                ORA     (TEMPW),Y
001CF9  3  91 FD                STA     (TEMPW),Y
001CFB  3  20 23 1A             JSR     PAGE_EXIT
001CFE  3  60                   RTS
001CFF  3               :
001CFF  3  BD 18 1D             LDA     HIRES_BIT_LOOKUP_RESET,X
001D02  3  48                   PHA
001D03  3  A0 00                LDY     #$00
001D05  3  31 FD                AND     (TEMPW),Y
001D07  3  91 FD                STA     (TEMPW),Y
001D09  3  20 23 1A             JSR     PAGE_EXIT
001D0C  3  60                   RTS
001D0D  3               V_PLOT_HIRES_COLOR_RANGE1:
001D0D  3  4C C2 35             JMP     LAB_2564
001D10  3               HIRES_BIT_LOOKUP_SET:
001D10  3  80 40 20 10          .BYTE   %10000000,%01000000,%00100000,%00010000,%00001000,%00000100,%00000010,%00000001
001D14  3  08 04 02 01  
001D18  3               HIRES_BIT_LOOKUP_RESET:
001D18  3  7F BF DF EF          .BYTE   %01111111,%10111111,%11011111,%11101111,%11110111,%11111011,%11111101,%11111110
001D1C  3  F7 FB FD FE  
001D20  3               
001D20  3               ;___V_PATTERN________________________________________________
001D20  3               ;
001D20  3               ;  DEFINE GRAPHICS PATTERN
001D20  3               ;
001D20  3               ;  TAKES 10 PARAMETERS
001D20  3               ;       PATTERN NUM (0-255)
001D20  3               ;       PATTERN DATA (8 BYTES)
001D20  3               ;__________________________________________________________
001D20  3               LAB_PATTERN
001D20  3               V_PATTERN:
001D20  3  20 83 33             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X
001D23  3  8A                   TXA
001D24  3  48                   PHA
001D25  3  A0 F8                LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001D27  3  20 29 1A             JSR     PAGE_ENTER
001D2A  3  68                   PLA
001D2B  3  8D 02 A0             STA     VideoCharGenOffset
001D2E  3  A0 08                LDY     #8
001D30  3               :
001D30  3  98                   TYA
001D31  3  48                   PHA
001D32  3  20 F2 2A             JSR     LAB_1C01        ; GET THE NEXT PARAMETER (AFTER ',') OR SYN ERR
001D35  3  20 83 33             JSR     LAB_GTBY        ; GET THE NEXT PARAMETER, RETURN IN X
001D38  3  68                   PLA
001D39  3  A8                   TAY
001D3A  3  8A                   TXA
001D3B  3  8D 03 A0             STA     VideoCharGenData
001D3E  3  88                   DEY
001D3F  3  C0 00                CPY     #$00
001D41  3  D0 ED                BNE     :-
001D43  3  20 23 1A             JSR     PAGE_EXIT
001D46  3  60                   RTS
001D47  3               
001D47  3               
001D47  3               LAB_LINE:
001D47  3  60                   RTS
001D48  3                       .ELSE
001D48  3               
001D48  3               
001D48  3               ; ENSURE ALL OF THESE SPECIAL COMMANDS GIVE ERRORS IN NORMAL BASIC
001D48  3               LAB_SPEEK:
001D48  3               LAB_SPOKE:
001D48  3               LAB_SCRCLR:
001D48  3               LAB_SCREEN:
001D48  3               LAB_PATTERN:
001D48  3               LAB_PLOT:
001D48  3               LAB_LOCATE:
001D48  3               LAB_COLOR:
001D48  3               LAB_LINE:
001D48  3                       LDX     #$02            ; error code $02 ("SYNTAX" error)
001D48  3                       JMP     LAB_XERR        ; do error #X, then warm start
001D48  3               
001D48  3                       .ENDIF
