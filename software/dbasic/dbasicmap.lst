001ED9  3  20 BE 37             JSR     LAB_GTBY        ; GET THE NEXT PARAMETER, RETURN IN X
001EDC  3  68                   PLA
001EDD  3  A8                   TAY
001EDE  3  8A                   TXA
001EDF  3  8D 03 A0             STA     VideoCharGenData
001EE2  3  88                   DEY
001EE3  3  C0 00                CPY     #$00
001EE5  3  D0 ED                BNE     :-
001EE7  3  20 06 1C             JSR     PAGE_EXIT
001EEA  3  60                   RTS
001EEB  3               
001EEB  3               ;___LAB_LINE_______________________________________________
001EEB  3               ;
001EEB  3               ;  DRAW LINE USING THE BRESENHAM LINE DRAWING ALGORITHM
001EEB  3               ;
001EEB  3               ;  TAKES 5 PARAMETERS
001EEB  3               ;       START X,Y
001EEB  3               ;       DESTINATION X,Y
001EEB  3               ;       COLOR
001EEB  3               ;__________________________________________________________
001EEB  3               LAB_LINE:
001EEB  3               ; GET X1
001EEB  3  20 FB 2D             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001EEE  3                                               ; else do type mismatch
001EEE  3  20 24 38             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001EF1  3  A5 12                LDA     Itemph
001EF3  3  8D 0E 19             STA     LINEX1+1
001EF6  3  A5 11                LDA     Itempl
001EF8  3  8D 0D 19             STA     LINEX1
001EFB  3                                               ; GET Y1
001EFB  3  20 2D 2F             JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001EFE  3  20 BE 37             JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
001F01  3  8E 0F 19             STX     LINEY1          ; STORE IN LINEY1
001F04  3               
001F04  3               ; GET X2
001F04  3  20 2D 2F             JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001F07  3  20 FB 2D             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001F0A  3                                               ; else do type mismatch
001F0A  3  20 24 38             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001F0D  3  A5 12                LDA     Itemph
001F0F  3  8D 12 19             STA     LINEX2+1
001F12  3  A5 11                LDA     Itempl
001F14  3  8D 11 19             STA     LINEX2
001F17  3                                               ; GET Y2
001F17  3  20 2D 2F             JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
001F1A  3  20 BE 37             JSR     LAB_GTBY        ; RETURN IN X
001F1D  3  8E 13 19             STX     LINEY2          ; STORE IN LINEY2
001F20  3                                               ; GET COLOR
001F20  3  20 2D 2F             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001F23  3  20 BE 37             JSR     LAB_GTBY        ; RETURN IN X
001F26  3  8E 0C 19             STX     LINECOLOR       ; STORE IN COLOR
001F29  3  A9 00                LDA     #$00
001F2B  3  8D 10 19             STA     LINEY1+1
001F2E  3  8D 14 19             STA     LINEY2+1
001F31  3                                               ; LINE COORDS AND COLOR STORED IN PROPER PLACE
001F31  3                                               ; CALCULATE DELTAX
001F31  3  38                   SEC                     ; Set Carry flag (represents "no borrow" for 1st byte)
001F32  3  AD 0D 19             LDA     LINEX1          ; Load low byte of number 1
001F35  3  ED 11 19             SBC     LINEX2          ; Subtract low byte of number 2 with carry
001F38  3  8D 15 19             STA     DELTAX          ; Store result low byte
001F3B  3  AD 0E 19             LDA     LINEX1+1        ; Load high byte of number 1
001F3E  3  ED 12 19             SBC     LINEX2+1        ; Subtract high byte of number 2 with borrow
001F41  3  8D 16 19             STA     DELTAX+1        ; Store result high byte
001F44  3  B0 20                BCS     :+              ; BRANCH IF X1>=X2
001F46  3                                               ; X1 < X2
001F46  3  A9 00                LDA     #0
001F48  3  8D 1D 19             STA     PTEMP           ; IF X2>X1 (PTEMP=x0)
001F4B  3  A9 FF                LDA     #$FF            ; TAKE ABSOLUTE VALUE OF DELTAX
001F4D  3  4D 16 19             EOR     DELTAX+1        ; Invert high byte (one's complement)
001F50  3  8D 16 19             STA     DELTAX+1
001F53  3  A9 FF                LDA     #$FF            ;
001F55  3  4D 15 19             EOR     DELTAX          ; Invert low byte
001F58  3  8D 15 19             STA     DELTAX          ;
001F5B  3  EE 15 19             INC     DELTAX          ; Add 1 to the low byte
001F5E  3  D0 0B                BNE     :++             ; If no carry from low byte INC, we are done
001F60  3  EE 16 19             INC     DELTAX+1        ; Increment high byte if carry occurred
001F63  3  4C 6B 1F             JMP     :++
001F66  3               :
001F66  3  A9 01                LDA     #1
001F68  3  8D 1D 19             STA     PTEMP           ; IF X1>X2 (PTEMP=x1)
001F6B  3               :
001F6B  3                                               ; CALCULATE DELTAY
001F6B  3  A9 00                LDA     #0
001F6D  3  8D 18 19             STA     DELTAY+1
001F70  3  38                   SEC                     ; Set Carry flag
001F71  3  AD 0F 19             LDA     LINEY1          ; Load low byte of number 1
001F74  3  ED 13 19             SBC     LINEY2          ; Subtract low byte of number 2 with carry
001F77  3  8D 17 19             STA     DELTAY          ; Store result low byte
001F7A  3  B0 16                BCS     :+              ; BRANCH IF Y1>=Y2
001F7C  3                                               ; Y1 < Y2
001F7C  3  AD 1D 19             LDA     PTEMP
001F7F  3  29 01                AND     #1
001F81  3  8D 1D 19             STA     PTEMP           ; IF Y2>Y1 (PTEMP=0x)
001F84  3                                               ; TAKE ABSOLUTE VALUE OF DELTAY
001F84  3  A9 FF                LDA     #$FF
001F86  3  4D 17 19             EOR     DELTAY          ; Flip all bits (one's complement)
001F89  3  8D 17 19             STA     DELTAY
001F8C  3  EE 17 19             INC     DELTAY          ; Add 1 (two's complement)
001F8F  3  4C 9A 1F             JMP     :++
001F92  3               :
001F92  3  AD 1D 19             LDA     PTEMP
001F95  3  09 10                ORA     #$10
001F97  3  8D 1D 19             STA     PTEMP           ; IF Y1>Y2 (PTEMP=1x)
001F9A  3               :
001F9A  3                                               ; SLOPE DETERMINED, AND DELTAS CALCULATED
001F9A  3                                               ; OK, LET'S FIND OUT IF THIS IS A HORIZONTAL-ISH
001F9A  3                                               ; OR VERTICAL-ISH LINE
001F9A  3  38                   SEC                     ; Set Carry Flag (for subtraction)
001F9B  3  AD 15 19             LDA     DELTAX          ; Load low byte of DELTAX
001F9E  3  ED 17 19             SBC     DELTAY          ; Subtract low byte of DELTAY
001FA1  3  AD 16 19             LDA     DELTAX+1        ; Load high byte of DELTAX
001FA4  3  ED 18 19             SBC     DELTAY+1        ; Subtract high byte of DELTAY (with borrow)
001FA7  3                                               ; Flags now reflect the 16-bit comparison
001FA7  3  90 03                BCC     LINEVERT        ; If Carry clear, LINE IS VERTICAL-ISH
001FA9  3  4C 42 20             JMP     LINEHORZ
001FAC  3               LINEVERT:
001FAC  3                                               ; FOR A VERTICAL-ISH LINE WE STEP ALONG THE
001FAC  3                                               ; Y AXIS (STEEP GRADIENT)
001FAC  3                                               ; FIND LARGER Y . . .
001FAC  3  AD 0F 19             LDA     LINEY1
001FAF  3  CD 13 19             CMP     LINEY2
001FB2  3  B0 03                BCS     :+
001FB4  3  20 D9 20             JSR     LINESWAPXY
001FB7  3               :
001FB7  3                                               ; Initialize error = DELTAY / 2
001FB7  3  AD 17 19             LDA     DELTAY
001FBA  3  8D 1E 19             STA     LINEERR
001FBD  3  AD 18 19             LDA     DELTAY+1
001FC0  3  8D 1F 19             STA     LINEERR+1
001FC3  3  4E 1F 19             LSR     LINEERR+1
001FC6  3  6E 1E 19             ROR     LINEERR
001FC9  3               LINEVERTLOOP:
001FC9  3  AD 0F 19             LDA     LINEY1          ; OK LET'S PLOT A POINT
001FCC  3  8D 09 19             STA     PLOTY
001FCF  3  AD 10 19             LDA     LINEY1+1
001FD2  3  8D 0A 19             STA     PLOTY+1
001FD5  3  AD 0D 19             LDA     LINEX1
001FD8  3  8D 07 19             STA     PLOTX
001FDB  3  AD 0E 19             LDA     LINEX1+1
001FDE  3  8D 08 19             STA     PLOTX+1
001FE1  3  AD 0C 19             LDA     LINECOLOR
001FE4  3  8D 0B 19             STA     PLOTCOLOR
001FE7  3  20 40 1C             JSR     DOPLOTXY
001FEA  3                                               ; NOW MOVE LINE1 CLOSER TO LINE2
001FEA  3  CE 0F 19             DEC     LINEY1          ; BY STEPPING ALONG Y AXIS
001FED  3               
001FED  3               ; BRESENHAM: err -= DELTAX
001FED  3  38                   SEC
001FEE  3  AD 1E 19             LDA     LINEERR
001FF1  3  ED 15 19             SBC     DELTAX
001FF4  3  8D 1E 19             STA     LINEERR
001FF7  3  AD 1F 19             LDA     LINEERR+1
001FFA  3  ED 16 19             SBC     DELTAX+1
001FFD  3  8D 1F 19             STA     LINEERR+1
002000  3  10 37                BPL     LINEVERT_NOSTEP ; IF ERR >= 0, NO X STEP NEEDED
002002  3                                               ; ERR += DELTAY (RESTORE ERROR)
002002  3  18                   CLC
002003  3  AD 1E 19             LDA     LINEERR
002006  3  6D 17 19             ADC     DELTAY
002009  3  8D 1E 19             STA     LINEERR
00200C  3  AD 1F 19             LDA     LINEERR+1
00200F  3  6D 18 19             ADC     DELTAY+1
002012  3  8D 1F 19             STA     LINEERR+1
002015  3                                               ; STEP X TOWARD X2 (16-BIT)
002015  3  AD 11 19             LDA     LINEX2
002018  3  CD 0D 19             CMP     LINEX1
00201B  3  AD 12 19             LDA     LINEX2+1
00201E  3  ED 0E 19             SBC     LINEX1+1
002021  3  90 0B                BCC     LINEVERT_DECX   ; X2 < X1, DECREMENT X1
002023  3  EE 0D 19             INC     LINEX1          ; X2 >= X1, INCREMENT X1
002026  3  D0 11                BNE     LINEVERT_NOSTEP
002028  3  EE 0E 19             INC     LINEX1+1
00202B  3  4C 39 20             JMP     LINEVERT_NOSTEP
00202E  3               LINEVERT_DECX:
00202E  3  AD 0D 19             LDA     LINEX1
002031  3  D0 03                BNE     :+
002033  3  CE 0E 19             DEC     LINEX1+1
002036  3               :
002036  3  CE 0D 19             DEC     LINEX1
002039  3               LINEVERT_NOSTEP:
002039  3               
002039  3  AD 0F 19             LDA     LINEY1
00203C  3  CD 13 19             CMP     LINEY2
00203F  3  D0 88                BNE     LINEVERTLOOP
002041  3  60                   RTS                     ; DONE
002042  3               
002042  3               LINEHORZ:
002042  3               ; FOR A HORIZONTAL-ISH LINE WE STEP ALONG THE
002042  3               ; X AXIS (SHALLOW GRADIENT)
002042  3               ; FIND LARGER X . . .
002042  3  38                   SEC                     ; Set carry flag for subtraction
002043  3  AD 11 19             LDA     LINEX2          ; Load low byte of first number
002046  3  ED 0D 19             SBC     LINEX1          ; Subtract low byte of second number
002049  3  AD 12 19             LDA     LINEX2+1        ; Load high byte of first number
00204C  3  ED 0E 19             SBC     LINEX1+1        ; Subtract high byte of second number
00204F  3                                               ; Result flags (N, Z, C) now reflect: Val1 - Val2
00204F  3  B0 03                BCS     :+              ; If carry is set, LINEX2 >= LINEX1
002051  3  20 D9 20             JSR     LINESWAPXY
002054  3               :
002054  3                                               ; Initialize error = DELTAX / 2
002054  3  AD 15 19             LDA     DELTAX
002057  3  8D 1E 19             STA     LINEERR
00205A  3  AD 16 19             LDA     DELTAX+1
00205D  3  8D 1F 19             STA     LINEERR+1
002060  3  4E 1F 19             LSR     LINEERR+1
002063  3  6E 1E 19             ROR     LINEERR
002066  3               LINEHORZLOOP:
002066  3  AD 0F 19             LDA     LINEY1          ; OK LET'S PLOT A POINT
002069  3  8D 09 19             STA     PLOTY
00206C  3  AD 10 19             LDA     LINEY1+1
00206F  3  8D 0A 19             STA     PLOTY+1
002072  3  AD 0D 19             LDA     LINEX1
002075  3  8D 07 19             STA     PLOTX
002078  3  AD 0E 19             LDA     LINEX1+1
00207B  3  8D 08 19             STA     PLOTX+1
00207E  3  AD 0C 19             LDA     LINECOLOR
002081  3  8D 0B 19             STA     PLOTCOLOR
002084  3  20 40 1C             JSR     DOPLOTXY
002087  3                                               ; NOW MOVE LINE1 CLOSER TO LINE2
002087  3  EE 0D 19             INC     LINEX1          ; BY STEPPING ALONG X AXIS
00208A  3  D0 03                BNE     :+
00208C  3  EE 0E 19             INC     LINEX1+1
00208F  3               :
00208F  3                                               ; BRESENHAM: err -= DELTAY
00208F  3  38                   SEC
002090  3  AD 1E 19             LDA     LINEERR
002093  3  ED 17 19             SBC     DELTAY
002096  3  8D 1E 19             STA     LINEERR
002099  3  AD 1F 19             LDA     LINEERR+1
00209C  3  ED 18 19             SBC     DELTAY+1
00209F  3  8D 1F 19             STA     LINEERR+1
0020A2  3  10 24                BPL     LINEHORZ_NOSTEP ; IF ERR >= 0, NO Y STEP NEEDED
0020A4  3                                               ; ERR += DELTAX (RESTORE ERROR)
0020A4  3  18                   CLC
0020A5  3  AD 1E 19             LDA     LINEERR
0020A8  3  6D 15 19             ADC     DELTAX
0020AB  3  8D 1E 19             STA     LINEERR
0020AE  3  AD 1F 19             LDA     LINEERR+1
0020B1  3  6D 16 19             ADC     DELTAX+1
0020B4  3  8D 1F 19             STA     LINEERR+1
0020B7  3                                               ; STEP Y TOWARD Y2
0020B7  3  AD 13 19             LDA     LINEY2
0020BA  3  CD 0F 19             CMP     LINEY1
0020BD  3  90 06                BCC     LINEHORZ_DECY   ; Y2 < Y1, DECREMENT
0020BF  3  EE 0F 19             INC     LINEY1          ; Y2 >= Y1, INCREMENT
0020C2  3  4C C8 20             JMP     LINEHORZ_NOSTEP
0020C5  3               LINEHORZ_DECY:
0020C5  3  CE 0F 19             DEC     LINEY1
0020C8  3               LINEHORZ_NOSTEP:
0020C8  3               
0020C8  3  AD 0D 19             LDA     LINEX1
0020CB  3  CD 11 19             CMP     LINEX2
0020CE  3  D0 96                BNE     LINEHORZLOOP
0020D0  3  AD 0E 19             LDA     LINEX1+1
0020D3  3  CD 12 19             CMP     LINEX2+1
0020D6  3  D0 8E                BNE     LINEHORZLOOP
0020D8  3  60                   RTS                     ; DONE
0020D9  3               
0020D9  3               LINESWAPXY:
0020D9  3  AD 0D 19             LDA     LINEX1
0020DC  3  AC 11 19             LDY     LINEX2
0020DF  3  8C 0D 19             STY     LINEX1
0020E2  3  8D 11 19             STA     LINEX2
0020E5  3  AD 0E 19             LDA     LINEX1+1
0020E8  3  AC 12 19             LDY     LINEX2+1
0020EB  3  8C 0E 19             STY     LINEX1+1
0020EE  3  8D 12 19             STA     LINEX2+1
0020F1  3               ;
0020F1  3  AD 0F 19             LDA     LINEY1
0020F4  3  AC 13 19             LDY     LINEY2
0020F7  3  8C 0F 19             STY     LINEY1
0020FA  3  8D 13 19             STA     LINEY2
0020FD  3  AD 10 19             LDA     LINEY1+1
002100  3  AC 14 19             LDY     LINEY2+1
002103  3  8C 10 19             STY     LINEY1+1
002106  3  8D 14 19             STA     LINEY2+1
002109  3  60                   RTS
00210A  3                       .ELSE
00210A  3               
00210A  3               
00210A  3               ; ENSURE ALL OF THESE SPECIAL COMMANDS GIVE ERRORS IN NORMAL BASIC
00210A  3               LAB_SPEEK:
00210A  3               LAB_SPOKE:
00210A  3               LAB_SCRCLR:
00210A  3               LAB_SCREEN:
00210A  3               LAB_PATTERN:
00210A  3               LAB_PLOT:
00210A  3               LAB_LOCATE:
00210A  3               LAB_COLOR:
00210A  3               LAB_LINE:
00210A  3                       LDX     #$02            ; error code $02 ("SYNTAX" error)
00210A  3                       JMP     LAB_XERR        ; do error #X, then warm start
00210A  3               
00210A  3                       .ENDIF
00210A  3               
00210A  2                       .INCLUDE "ay38910.asm"
00210A  3               
00210A  3                       .IFNDEF  DUODYNE
00210A  3               .pc02
00210A  3               
00210A  3               PPI_BASE        = $E230
00210A  3               
00210A  3               ppiPortA        = PPI_BASE+0         ; Register
00210A  3               ppiPortB        = PPI_BASE+1         ; Register
00210A  3               ppiPortC        = PPI_BASE+2         ; Register
00210A  3               ppiControl      = PPI_BASE+3         ; Register
