001A64  3  20 83 33             JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
001A67  3                                               ; FIGURE THE BUFFER OFFSET
001A67  3  8A                   TXA                     ; Y COORD IN X
001A68  3  48                   PHA
001A69  3  4A                   LSR     A               ; 2 LINES PER BYTE
001A6A  3  8D 35 17             STA     PTEMPW1
001A6D  3                                               ; MULTIPLY Y (PTEMPW) COORD BY 40 OR 80 (SINGLE OR DOUBLE LORES)
001A6D  3  18                   CLC
001A6E  3  0E 35 17             ASL     PTEMPW1
001A71  3  2E 36 17             ROL     PTEMPW1+1       ; *2
001A74  3  0E 35 17             ASL     PTEMPW1
001A77  3  2E 36 17             ROL     PTEMPW1+1       ; *2 (*4)
001A7A  3  0E 35 17             ASL     PTEMPW1
001A7D  3  2E 36 17             ROL     PTEMPW1+1       ; *2 (*8)
001A80  3  AD 35 17             LDA     PTEMPW1
001A83  3  8D 37 17             STA     PTEMPW2
001A86  3  AD 36 17             LDA     PTEMPW1+1
001A89  3  8D 38 17             STA     PTEMPW2+1       ; STORE Y*8 INTO PTEMPW2
001A8C  3  0E 35 17             ASL     PTEMPW1
001A8F  3  2E 36 17             ROL     PTEMPW1+1       ; *2 (*16)
001A92  3  0E 35 17             ASL     PTEMPW1
001A95  3  2E 36 17             ROL     PTEMPW1+1       ; *2 (*32)
