0011EF  2                                               ; TEMPW  = Y*8 + Y*32  (Y*40)
0011EF  2  18                   CLC                     ; Clear the Carry flag before the first addition
0011F0  2  AD 33 17             LDA     PTEMPW          ; Load the low byte of the first number into the accumulator
0011F3  2  6D 35 17             ADC     PTEMPW1         ; Add the low byte of the second number (plus carry)
0011F6  2  85 FD                STA     TEMPW           ; Store the low byte of the result
0011F8  2  AD 34 17             LDA     PTEMPW+1        ; Load the high byte of the first number
0011FB  2  6D 36 17             ADC     PTEMPW1+1       ; Add the high byte of the second number (plus carry from previous op)
0011FE  2  85 FE                STA     TEMPW+1         ; Store the high byte of the result
