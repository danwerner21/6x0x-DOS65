0014E3  3               ;___OPEN____________________________________________________
0014E3  3               ;
0014E3  3               ; OPEN A FILE
0014E3  3               ;
0014E3  3               ;
0014E3  3               ; BASIC COMMAND EXPECTS FOUR VARS
0014E3  3               
0014E3  3               ; DRIVE,MODE, FILENAME$,FILE$
0014E3  3               ;
0014E3  3               ; FILE$ = STRING TO HOLD 33 BYTE FCB
0014E3  3               ; DRIVE = NUMERIC DRIVE -- 0=CURRENT, 1=A, 2=B . . .
0014E3  3               ; MODE = 0=EXISTING, 1=CREATE
0014E3  3               ; FILENAME$ = FILENAME STRING
0014E3  3               ;__________________________________________________________
0014E3  3               V_OPEN:
0014E3  3               ; CLEAR FCB
0014E3  3  A9 00                LDA     #0              ; FILL WITH NULL
0014E5  3  A0 00                LDY     #0              ;
0014E7  3               :
0014E7  3  99 3E 18             STA     FCB,Y           ;
0014EA  3  C8                   INY                     ;
0014EB  3  C0 21                CPY     #33             ;
0014ED  3  D0 F8                BNE     :-              ;
0014EF  3                                               ;
0014EF  3  A9 20                LDA     #32             ; FILL FILENAME AND EXTENSION WITH SPACES
0014F1  3  A0 01                LDY     #1              ;
0014F3  3               :
0014F3  3  99 3E 18             STA     FCB,Y           ;
0014F6  3  C8                   INY                     ;
0014F7  3  C0 0C                CPY     #12             ;
0014F9  3  D0 F8                BNE     :-              ;
0014FB  3                                               ;
0014FB  3  20 CC 36             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (DRIVE)
0014FE  3  8A                   TXA
0014FF  3  8D 3E 18             STA     FCB             ; STORE DRIVE IN FCB
001502  3                                               ;
001502  3  20 3B 2E             JSR     LAB_1C01        ; (AFTER ',') OR SYN ERR
001505  3  20 CC 36             JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X (MODE)
001508  3                                               ;
001508  3  E0 00                CPX     #0
00150A  3  D0 08                BNE     :+
00150C  3  A9 0F                LDA     #15
00150E  3  8D C2 15             STA     OPNTMP
001511  3  4C 19 15             JMP     V_OPEN1
001514  3               :
001514  3  A9 16                LDA     #22
001516  3  8D C2 15             STA     OPNTMP          ;
001519  3               V_OPEN1:
001519  3  20 3B 2E             JSR     LAB_1C01        ; (AFTER ',') OR SYN ERR
00151C  3  20 1D 2D             JSR     LAB_EVEX        ; GET THE THIRD PARAMETER
00151F  3  A5 5F                LDA     <Dtypef         ; IS IT A STRING?
001521  3  D0 08                BNE     :+              ; YES, CONTINUE ON
001523  3  A2 02                LDX     #$02            ; NOPE, SYNTAX ERROR
001525  3  20 77 23             JSR     LAB_XERR
001528  3  4C 4F 24             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
00152B  3               :
