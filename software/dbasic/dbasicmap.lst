0015B8  3  E0 00                CPX     #0              ;
0015BA  3  D0 F5                BNE     :-              ;
0015BC  3                                               ;
0015BC  3  20 C5 33             JSR     LAB_RTST        ; STORE STRING
0015BF  3  4C 0E 2A             JMP     LAB_17D5        ; do string LET and return
0015C2  3               
0015C2  3               OPNTMP:
0015C2  3  00                   .BYTE   00
