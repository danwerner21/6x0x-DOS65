001299  2               
001299  2               PRINT_SPACE:
001299  2  8E EA 12             STX     TTX
00129C  2  8C EB 12             STY     TTY
00129F  2  8D EC 12             STA     TTA
0012A2  2  A9 20                LDA     #32
0012A4  2  20 ED 12             JSR     WRSER1          ; output upper nybble
0012A7  2  AE EA 12             LDX     TTX
0012AA  2  AC EB 12             LDY     TTY
0012AD  2  AD EC 12             LDA     TTA
0012B0  2  60                   RTS
0012B1  2               
0012B1  2               
0012B1  2               PRINT_BYTE:
0012B1  2  8E EA 12             STX     TTX
0012B4  2  8C EB 12             STY     TTY
0012B7  2  8D EC 12             STA     TTA
0012BA  2  8E E9 12             STX     SAVX            ; save X
0012BD  2  20 D4 12             JSR     ASCTWO          ; get hex chars for byte in X (lower) and A (upper)
0012C0  2  20 ED 12             JSR     WRSER1          ; output upper nybble
0012C3  2  8A                   TXA                     ; transfer lower to A
0012C4  2  AE E9 12             LDX     SAVX            ; restore X
0012C7  2  20 ED 12             JSR     WRSER1          ; output lower nybble
0012CA  2  AE EA 12             LDX     TTX
0012CD  2  AC EB 12             LDY     TTY
0012D0  2  AD EC 12             LDA     TTA
0012D3  2  60                   RTS
0012D4  2               ASCTWO:
0012D4  2  48                   PHA                     ; save byte
0012D5  2  20 DE 12             JSR     ASCII           ; do low nybble
0012D8  2  AA                   TAX                     ; save in X
0012D9  2  68                   PLA                     ; restore byte
0012DA  2  4A                   LSR     A               ; shift upper nybble down
0012DB  2  4A                   LSR     A
0012DC  2  4A                   LSR     A
0012DD  2  4A                   LSR     A
0012DE  2               ; convert low nybble in A to hex digit
0012DE  2               ASCII:
0012DE  2  29 0F                AND     #$0F            ; clear upper nibble
0012E0  2  C9 0A                CMP     #$0A            ; if less than A, skip next step
0012E2  2  90 02                BCC     ASC1
0012E4  2  69 06                ADC     #6              ; skip ascii chars between 9 and A
0012E6  2               ASC1:
0012E6  2  69 30                ADC     #$30            ; add ascii char 0 to value
0012E8  2  60                   RTS
0012E9  2               SAVX:
0012E9  2  00                   .BYTE   00
0012EA  2               TTX:
0012EA  2  00                   .BYTE   00
0012EB  2               TTY:
0012EB  2  00                   .BYTE   00
0012EC  2               TTA:
0012EC  2  00                   .BYTE   00
