001C0C  3  A9 01                LDA     #$01            ; MODIFY TASK 01 (DRIVER TASK)
001C0E  3  A2 0A                LDX     #$0A            ; MAP $AXXX
001C10  3  20 F6 FF             JSR     SETPAGE         ; CALL SETPAGE
001C13  3  A9 01                LDA     #$01
001C15  3  8D E0 EF             STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 01
001C18  3  60                   RTS
001C19  3               
001C19  3               ;___V_PLOT__________________________________________________
001C19  3               ;
001C19  3               ;  PLOT ON SCREEN
001C19  3               ;         TAKES THREE PARAMETERS,  X,Y,COLOR
001C19  3               ;
001C19  3               ;__________________________________________________________
001C19  3               LAB_PLOT:
001C19  3               V_PLOT:
001C19  3  20 FB 2D             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001C1C  3                                               ; else do type mismatch
001C1C  3  20 24 38             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001C1F  3  A5 12                LDA     Itemph
001C21  3  8D 08 19             STA     PLOTX+1
001C24  3  A5 11                LDA     Itempl
001C26  3  8D 07 19             STA     PLOTX
001C29  3  20 2D 2F             JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001C2C  3  20 BE 37             JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
001C2F  3  8E 09 19             STX     PLOTY           ; STORE IN PLOTY
001C32  3  A9 00                LDA     #$00
001C34  3  8D 0A 19             STA     PLOTY+1
001C37  3  20 2D 2F             JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001C3A  3  20 BE 37             JSR     LAB_GTBY        ; RETURN IN X
001C3D  3  8E 0B 19             STX     PLOTCOLOR
001C40  3               DOPLOTXY:
001C40  3                                               ; PARAMETERS PARSED, GO TO PROPER MODE CODE
001C40  3  AD 04 19             LDA     VIDEOMODE
001C43  3  29 0F                AND     #$0F
001C45  3  C9 01                CMP     #$01
001C47  3  F0 14                BEQ     V_PLOT_LORES
001C49  3  AD 04 19             LDA     VIDEOMODE
001C4C  3  29 2F                AND     #$2F
001C4E  3  C9 02                CMP     #$02
001C50  3  D0 03                BNE     :+
001C52  3  4C 00 1D             JMP     V_PLOT_HIRES_COLOR
001C55  3               :
001C55  3  C9 22                CMP     #$22
001C57  3  D0 03                BNE     :+
001C59  3  4C DC 1D             JMP     V_PLOT_HIRES_MONO
001C5C  3               :
001C5C  3  60                   RTS
001C5D  3               
001C5D  3               V_PLOT_LORES:
001C5D  3  AD 09 19             LDA     PLOTY
001C60  3  48                   PHA
001C61  3  4A                   LSR     A               ; 2 LINES PER BYTE
001C62  3  8D 09 19             STA     PLOTY
001C65  3                                               ; MULTIPLY Y (PTEMPW) COORD BY 40 OR 80 (SINGLE OR DOUBLE LORES)
001C65  3  18                   CLC
001C66  3  0E 09 19             ASL     PLOTY
001C69  3  2E 0A 19             ROL     PLOTY+1         ; *2
001C6C  3  0E 09 19             ASL     PLOTY
001C6F  3  2E 0A 19             ROL     PLOTY+1         ; *2 (*4)
001C72  3  0E 09 19             ASL     PLOTY
001C75  3  2E 0A 19             ROL     PLOTY+1         ; *2 (*8)
001C78  3  AD 09 19             LDA     PLOTY
001C7B  3  8D 19 19             STA     PTEMPW
001C7E  3  AD 0A 19             LDA     PLOTY+1
001C81  3  8D 1A 19             STA     PTEMPW+1        ; STORE Y*8 INTO PTEMPW
001C84  3  0E 09 19             ASL     PLOTY
001C87  3  2E 0A 19             ROL     PLOTY+1         ; *2 (*16)
001C8A  3  0E 09 19             ASL     PLOTY
001C8D  3  2E 0A 19             ROL     PLOTY+1         ; *2 (*32)
001C90  3               ; NOW TAKE Y*8(PTEMPW) + Y*32(PLOTY) == Y*40 STORE IN PLOTY
001C90  3  18                   CLC                     ; Clear the Carry flag before the first addition
001C91  3               
001C91  3  AD 09 19             LDA     PLOTY           ; Load the low byte of the first number into the accumulator
001C94  3  6D 19 19             ADC     PTEMPW          ; Add the low byte of the second number (plus carry)
001C97  3  8D 09 19             STA     PLOTY           ; Store the low byte of the result
001C9A  3               
001C9A  3  AD 0A 19             LDA     PLOTY+1         ; Load the high byte of the first number
001C9D  3  6D 1A 19             ADC     PTEMPW+1        ; Add the high byte of the second number (plus carry from previous op)
001CA0  3  8D 0A 19             STA     PLOTY+1         ; Store the high byte of the result
001CA3  3               
001CA3  3               ; if double lores columns double it.
001CA3  3  AD 04 19             LDA     VIDEOMODE
001CA6  3  29 10                AND     #$10
001CA8  3  C9 00                CMP     #00
001CAA  3  F0 06                BEQ     :+
001CAC  3  0E 09 19             ASL     PLOTY
001CAF  3  2E 0A 19             ROL     PLOTY+1         ; *2
001CB2  3               :
001CB2  3               ; OK, Y OFFSET IS IN PTEMPW1, X IS IN PTEMPW
001CB2  3  A9 A0                LDA     #$A0            ; ADD THE MEMORY OFFSET TO PTEMPW (BECAUSE IT IS EASY)
001CB4  3  8D 08 19             STA     PLOTX+1         ; THEN ADD PTEMPW1 TO PTEMPW THAT SHOULD BE THE MEMORY ADDRESS TO UPDATE
001CB7  3                                               ;
001CB7  3  18                   CLC                     ; Clear the Carry flag before the first addition
001CB8  3  AD 07 19             LDA     PLOTX           ; Load the low byte of the first number into the accumulator
001CBB  3  6D 09 19             ADC     PLOTY           ; Add the low byte of the second number (plus carry)
001CBE  3  85 FD                STA     TEMPW           ; Store the low byte of the result
001CC0  3               
001CC0  3  AD 08 19             LDA     PLOTX+1         ; Load the high byte of the first number
001CC3  3  6D 0A 19             ADC     PLOTY+1         ; Add the high byte of the second number (plus carry from previous op)
001CC6  3  85 FE                STA     TEMPW+1         ; Store the high byte of the result
001CC8  3                                               ; PTEMPW IS THE MEMORY OFFSET TO UPDATE
001CC8  3  68                   PLA
001CC9  3  4A                   LSR     A               ; TOP OR BOTTOM PIXEL?
001CCA  3  90 20                BCC     :+
001CCC  3                                               ; TOP PIXEL
001CCC  3  A0 FA                LDY     #$02+VIDEOBANK  ; AREA $2000-$2FFF
001CCE  3  20 0C 1C             JSR     PAGE_ENTER
001CD1  3  A0 00                LDY     #$00
001CD3  3  B1 FD                LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
001CD5  3  29 0F                AND     #$0F
001CD7  3  48                   PHA
001CD8  3  AD 0B 19             LDA     PLOTCOLOR
001CDB  3  0A                   ASL     A
001CDC  3  0A                   ASL     A
001CDD  3  0A                   ASL     A
001CDE  3  0A                   ASL     A
001CDF  3  8D 0B 19             STA     PLOTCOLOR
001CE2  3  68                   PLA
001CE3  3  0D 0B 19             ORA     PLOTCOLOR
001CE6  3  91 FD                STA     (TEMPW),Y       ; STORE  DOUBLE PIXEL
001CE8  3  20 06 1C             JSR     PAGE_EXIT
001CEB  3  60                   RTS
001CEC  3               :
001CEC  3                                               ; BOTTOM PIXEL
001CEC  3  A0 FA                LDY     #$02+VIDEOBANK  ; AREA $2000-$2FFF
001CEE  3  20 0C 1C             JSR     PAGE_ENTER
001CF1  3  A0 00                LDY     #$00
001CF3  3  B1 FD                LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
001CF5  3  29 F0                AND     #$F0
001CF7  3  0D 0B 19             ORA     PLOTCOLOR
001CFA  3  91 FD                STA     (TEMPW),Y       ; STORE  DOUBLE PIXEL
001CFC  3  20 06 1C             JSR     PAGE_EXIT
001CFF  3  60                   RTS
001D00  3               
001D00  3               V_PLOT_HIRES_COLOR:
001D00  3  AD 07 19             LDA     PLOTX
001D03  3  48                   PHA                     ; PUSH LOW BYTE OF X (FOR EVEN/ODD LATER)
001D04  3  4E 08 19             LSR     PLOTX+1
001D07  3  6E 07 19             ROR     PLOTX           ; 2 PIXEL PER BYTE
001D0A  3  AD 07 19             LDA     PLOTX           ;
001D0D  3                                               ; FIGURE THE BUFFER OFFSET
001D0D  3  18                   CLC                     ; MULTIPLY Y COORD BY 70 OR 140 (SINGLE OR DOUBLE HIRES)
001D0E  3  0E 09 19             ASL     PLOTY
001D11  3  2E 0A 19             ROL     PLOTY+1         ; *2
001D14  3  AD 09 19             LDA     PLOTY
001D17  3  8D 19 19             STA     PTEMPW
001D1A  3  AD 0A 19             LDA     PLOTY+1
001D1D  3  8D 1A 19             STA     PTEMPW+1        ; STORE Y*2 INTO PTEMPW
001D20  3  0E 09 19             ASL     PLOTY
001D23  3  2E 0A 19             ROL     PLOTY+1         ; *2 (*4)
001D26  3  AD 09 19             LDA     PLOTY
001D29  3  8D 1B 19             STA     PTEMPW1
001D2C  3  AD 0A 19             LDA     PLOTY+1
001D2F  3  8D 1C 19             STA     PTEMPW1+1       ; STORE Y*4 INTO PTEMPW1
001D32  3  0E 09 19             ASL     PLOTY
001D35  3  2E 0A 19             ROL     PLOTY+1         ; *2 (*8)
001D38  3  0E 09 19             ASL     PLOTY
001D3B  3  2E 0A 19             ROL     PLOTY+1         ; *2 (*16)
001D3E  3  0E 09 19             ASL     PLOTY
001D41  3  2E 0A 19             ROL     PLOTY+1         ; *2 (*32)
001D44  3  0E 09 19             ASL     PLOTY
001D47  3  2E 0A 19             ROL     PLOTY+1         ; *2 (*64)
001D4A  3                                               ; RESULT OFFSET PLOTY = PLOTY(Y*64)+PTEMPW(Y*2)+PTEMPW1(Y*4)
001D4A  3  18                   CLC                     ; Clear the Carry flag before the first addition
001D4B  3  AD 09 19             LDA     PLOTY           ; Load the low byte of the first number into the accumulator
001D4E  3  6D 19 19             ADC     PTEMPW          ; Add the low byte of the second number (plus carry)
001D51  3  8D 09 19             STA     PLOTY           ; Store the low byte of the result
001D54  3  AD 0A 19             LDA     PLOTY+1         ; Load the high byte of the first number
001D57  3  6D 1A 19             ADC     PTEMPW+1        ; Add the high byte of the second number (plus carry from previous op)
001D5A  3  8D 0A 19             STA     PLOTY+1         ; Store the high byte of the result
001D5D  3               
001D5D  3  18                   CLC                     ; Clear the Carry flag before the first addition
001D5E  3  AD 09 19             LDA     PLOTY           ; Load the low byte of the first number into the accumulator
001D61  3  6D 1B 19             ADC     PTEMPW1         ; Add the low byte of the second number (plus carry)
001D64  3  8D 09 19             STA     PLOTY           ; Store the low byte of the result
001D67  3  AD 0A 19             LDA     PLOTY+1         ; Load the high byte of the first number
001D6A  3  6D 1C 19             ADC     PTEMPW1+1       ; Add the high byte of the second number (plus carry from previous op)
001D6D  3  8D 0A 19             STA     PLOTY+1         ; Store the high byte of the result
001D70  3               
001D70  3               ; if double hires double it.
001D70  3  AD 04 19             LDA     VIDEOMODE
001D73  3  29 10                AND     #$10
001D75  3  C9 00                CMP     #00
001D77  3  F0 06                BEQ     :+
001D79  3  0E 09 19             ASL     PLOTY
001D7C  3  2E 0A 19             ROL     PLOTY+1         ; *2
001D7F  3               :
001D7F  3               ; PLOTY IS NOW Y OFFSET, ADD X OFFSET FOR MEMORY ADDRESS INTO TEMPW
001D7F  3  18                   CLC                     ; Clear the Carry flag before the first addition
001D80  3  AD 09 19             LDA     PLOTY           ; Load the low byte of the first number into the accumulator
001D83  3  6D 07 19             ADC     PLOTX           ; Add the low byte of the second number (plus carry)
001D86  3  85 FD                STA     TEMPW           ; Store the low byte of the result
001D88  3  AD 0A 19             LDA     PLOTY+1         ; Load the high byte of the first number
001D8B  3  6D 08 19             ADC     PLOTX+1         ; Add the high byte of the second number (plus carry from previous op)
001D8E  3  85 FE                STA     TEMPW+1         ; Store the high byte of the result
001D90  3               
001D90  3  A5 FE                LDA     TEMPW+1         ; OK, LET'S CALCULATE THE BANK
001D92  3  29 F0                AND     #$F0
001D94  3  4A                   LSR     A
001D95  3  4A                   LSR     A
001D96  3  4A                   LSR     A
001D97  3  4A                   LSR     A
001D98  3  18                   CLC
001D99  3  69 FA                ADC     #$02+VIDEOBANK  ; AREA $2000-?
001D9B  3  C9 F8                CMP     #$F8
001D9D  3  90 3A                BCC     V_PLOT_HIRES_COLOR_RANGE
001D9F  3  A8                   TAY                     ; VIDEO BANK SHOULD BE IN Y
001DA0  3  20 0C 1C             JSR     PAGE_ENTER
001DA3  3               
001DA3  3  A5 FE                LDA     TEMPW+1
001DA5  3  29 0F                AND     #$0F
001DA7  3  09 A0                ORA     #$A0
001DA9  3  85 FE                STA     TEMPW+1         ; TEMPW NOW REFLECTS MAPPED ADDRESSS
001DAB  3  68                   PLA
001DAC  3  4A                   LSR     A               ; LEFT OR RIGHT PIXEL?
001DAD  3  90 1B                BCC     :+
001DAF  3                                               ; LEFT PIXEL
001DAF  3  A0 00                LDY     #$00
001DB1  3  B1 FD                LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
001DB3  3  29 0F                AND     #$0F
001DB5  3  48                   PHA
001DB6  3  AD 0B 19             LDA     PLOTCOLOR
001DB9  3  0A                   ASL     A
001DBA  3  0A                   ASL     A
001DBB  3  0A                   ASL     A
001DBC  3  0A                   ASL     A
001DBD  3  8D 0B 19             STA     PLOTCOLOR
001DC0  3  68                   PLA
001DC1  3  0D 0B 19             ORA     PLOTCOLOR
001DC4  3  91 FD                STA     (TEMPW),Y       ; WRITE THE PIXEL BACK OUT
001DC6  3  20 06 1C             JSR     PAGE_EXIT
001DC9  3  60                   RTS
001DCA  3               :
001DCA  3               ; RIGHT PIXEL
001DCA  3  A0 00                LDY     #$00
001DCC  3  B1 FD                LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
001DCE  3  29 F0                AND     #$F0
001DD0  3  0D 0B 19             ORA     PLOTCOLOR
001DD3  3  91 FD                STA     (TEMPW),Y       ; WRITE THE PIXEL BACK OUT
001DD5  3  20 06 1C             JSR     PAGE_EXIT
001DD8  3  60                   RTS
