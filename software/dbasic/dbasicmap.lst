001226  2  A9 20                LDA     #32
001228  2  20 71 12             JSR     WRSER1          ; output upper nybble
00122B  2  AE 6E 12             LDX     TTX
00122E  2  AC 6F 12             LDY     TTY
001231  2  AD 70 12             LDA     TTA
