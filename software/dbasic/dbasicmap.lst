001237  2               
001237  2               
001237  2               PRINT_BYTE:
001237  2  8E 70 12             STX     TTX
00123A  2  8C 71 12             STY     TTY
00123D  2  8D 72 12             STA     TTA
001240  2  8E 6F 12             STX     SAVX            ; save X
001243  2  20 5A 12             JSR     ASCTWO          ; get hex chars for byte in X (lower) and A (upper)
001246  2  20 73 12             JSR     WRSER1          ; output upper nybble
001249  2  8A                   TXA                     ; transfer lower to A
00124A  2  AE 6F 12             LDX     SAVX            ; restore X
00124D  2  20 73 12             JSR     WRSER1          ; output lower nybble
001250  2  AE 70 12             LDX     TTX
001253  2  AC 71 12             LDY     TTY
001256  2  AD 72 12             LDA     TTA
001259  2  60                   RTS
00125A  2               ASCTWO:
00125A  2  48                   PHA                     ; save byte
00125B  2  20 64 12             JSR     ASCII           ; do low nybble
00125E  2  AA                   TAX                     ; save in X
00125F  2  68                   PLA                     ; restore byte
001260  2  4A                   LSR     A               ; shift upper nybble down
001261  2  4A                   LSR     A
001262  2  4A                   LSR     A
001263  2  4A                   LSR     A
001264  2               ; convert low nybble in A to hex digit
001264  2               ASCII:
001264  2  29 0F                AND     #$0F            ; clear upper nibble
001266  2  C9 0A                CMP     #$0A            ; if less than A, skip next step
001268  2  90 02                BCC     ASC1
00126A  2  69 06                ADC     #6              ; skip ascii chars between 9 and A
00126C  2               ASC1:
00126C  2  69 30                ADC     #$30            ; add ascii char 0 to value
00126E  2  60                   RTS
00126F  2               SAVX:
00126F  2  00                   .BYTE   00
