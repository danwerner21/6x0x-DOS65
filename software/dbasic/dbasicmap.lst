001E27  3               ;___LAB_SECOND______________________________________________
001E27  3               ;
001E27  3               ; RETURN SYSTEM SECONDS
001E27  3               ;
001E27  3               ;__________________________________________________________
001E27  3               LAB_SECOND:
001E27  3  A2 00                LDX     #RTCSECONDS
001E29  3  A9 33                LDA     #51
001E2B  3  85 32                STA     farfunct
001E2D  3  20 F0 FF             JSR     DO_FARCALL
001E30  3  98                   TYA
001E31  3               
001E31  3  20 C2 1E             JSR     BCD_TO_HEX
001E34  3  A8                   TAY
001E35  3  A9 00                LDA     #0              ; Get high byte
001E37  3  20 3A 2F             JSR     LAB_AYFC
001E3A  3  60                   RTS
