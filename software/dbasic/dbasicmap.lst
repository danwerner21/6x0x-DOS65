001ECF  3  A9 FF                LDA     #$FF            ;
001ED1  3  4D 91 18             EOR     DELTAX          ; Invert low byte
001ED4  3  8D 91 18             STA     DELTAX          ;
001ED7  3  EE 91 18             INC     DELTAX          ; Add 1 to the low byte
001EDA  3  D0 0B                BNE     :++             ; If no carry from low byte INC, we are done
001EDC  3  EE 92 18             INC     DELTAX+1        ; Increment high byte if carry occurred
001EDF  3  4C E7 1E             JMP     :++
001EE2  3               :
001EE2  3  A9 01                LDA     #1
001EE4  3  8D 99 18             STA     PTEMP           ; IF X1>X2 (PTEMP=x1)
001EE7  3               :
001EE7  3                                               ; CALCULATE DELTAY
001EE7  3  A9 00                LDA     #0
001EE9  3  8D 94 18             STA     DELTAY+1
001EEC  3  38                   SEC                     ; Set Carry flag
001EED  3  AD 8B 18             LDA     LINEY1          ; Load low byte of number 1
001EF0  3  ED 8F 18             SBC     LINEY2          ; Subtract low byte of number 2 with carry
001EF3  3  8D 93 18             STA     DELTAY          ; Store result low byte
001EF6  3  B0 16                BCS     :+              ; BRANCH IF Y1>=Y2
001EF8  3                                               ; Y1 < Y2
001EF8  3  AD 99 18             LDA     PTEMP
001EFB  3  29 01                AND     #1
001EFD  3  8D 99 18             STA     PTEMP           ; IF Y2>Y1 (PTEMP=0x)
001F00  3                                               ; TAKE ABSOLUTE VALUE OF DELTAY
001F00  3  A9 FF                LDA     #$FF
001F02  3  4D 93 18             EOR     DELTAY          ; Flip all bits (one's complement)
001F05  3  8D 93 18             STA     DELTAY
001F08  3  EE 93 18             INC     DELTAY          ; Add 1 (two's complement)
001F0B  3  4C 16 1F             JMP     :++
001F0E  3               :
001F0E  3  AD 99 18             LDA     PTEMP
001F11  3  09 10                ORA     #$10
001F13  3  8D 99 18             STA     PTEMP           ; IF Y1>Y2 (PTEMP=1x)
001F16  3               :
001F16  3                                               ; SLOPE DETERMINED, AND DELTAS CALCULATED
001F16  3                                               ; OK, LET'S FIND OUT IF THIS IS A HORIZONTAL-ISH
001F16  3                                               ; OR VERTICAL-ISH LINE
001F16  3  38                   SEC                     ; Set Carry Flag (for subtraction)
001F17  3  AD 91 18             LDA     DELTAX          ; Load low byte of DELTAX
001F1A  3  ED 93 18             SBC     DELTAY          ; Subtract low byte of DELTAY
001F1D  3  AD 92 18             LDA     DELTAX+1        ; Load high byte of DELTAX
001F20  3  ED 94 18             SBC     DELTAY+1        ; Subtract high byte of DELTAY (with borrow)
001F23  3                                               ; Flags now reflect the 16-bit comparison
001F23  3  90 03                BCC     LINEVERT        ; If Carry clear, LINE IS VERTICAL-ISH
001F25  3  4C BE 1F             JMP     LINEHORZ
001F28  3               LINEVERT:
001F28  3                                               ; FOR A VERTICAL-ISH LINE WE STEP ALONG THE
001F28  3                                               ; Y AXIS (STEEP GRADIENT)
001F28  3                                               ; FIND LARGER Y . . .
001F28  3  AD 8B 18             LDA     LINEY1
001F2B  3  CD 8F 18             CMP     LINEY2
001F2E  3  B0 03                BCS     :+
001F30  3  20 55 20             JSR     LINESWAPXY
001F33  3               :
001F33  3                                               ; Initialize error = DELTAY / 2
001F33  3  AD 93 18             LDA     DELTAY
001F36  3  8D 9A 18             STA     LINEERR
001F39  3  AD 94 18             LDA     DELTAY+1
001F3C  3  8D 9B 18             STA     LINEERR+1
001F3F  3  4E 9B 18             LSR     LINEERR+1
001F42  3  6E 9A 18             ROR     LINEERR
001F45  3               LINEVERTLOOP:
001F45  3  AD 8B 18             LDA     LINEY1          ; OK LET'S PLOT A POINT
001F48  3  8D 85 18             STA     PLOTY
001F4B  3  AD 8C 18             LDA     LINEY1+1
001F4E  3  8D 86 18             STA     PLOTY+1
001F51  3  AD 89 18             LDA     LINEX1
001F54  3  8D 83 18             STA     PLOTX
001F57  3  AD 8A 18             LDA     LINEX1+1
001F5A  3  8D 84 18             STA     PLOTX+1
001F5D  3  AD 88 18             LDA     LINECOLOR
001F60  3  8D 87 18             STA     PLOTCOLOR
001F63  3  20 BC 1B             JSR     DOPLOTXY
001F66  3                                               ; NOW MOVE LINE1 CLOSER TO LINE2
001F66  3  CE 8B 18             DEC     LINEY1          ; BY STEPPING ALONG Y AXIS
001F69  3               
001F69  3                                               ; BRESENHAM: err -= DELTAX
001F69  3  38                   SEC
001F6A  3  AD 9A 18             LDA     LINEERR
001F6D  3  ED 91 18             SBC     DELTAX
001F70  3  8D 9A 18             STA     LINEERR
001F73  3  AD 9B 18             LDA     LINEERR+1
001F76  3  ED 92 18             SBC     DELTAX+1
001F79  3  8D 9B 18             STA     LINEERR+1
001F7C  3  10 37                BPL     LINEVERT_NOSTEP ; IF ERR >= 0, NO X STEP NEEDED
001F7E  3                                               ; ERR += DELTAY (RESTORE ERROR)
001F7E  3  18                   CLC
001F7F  3  AD 9A 18             LDA     LINEERR
001F82  3  6D 93 18             ADC     DELTAY
001F85  3  8D 9A 18             STA     LINEERR
001F88  3  AD 9B 18             LDA     LINEERR+1
001F8B  3  6D 94 18             ADC     DELTAY+1
001F8E  3  8D 9B 18             STA     LINEERR+1
001F91  3                                               ; STEP X TOWARD X2 (16-BIT)
001F91  3  AD 8D 18             LDA     LINEX2
001F94  3  CD 89 18             CMP     LINEX1
001F97  3  AD 8E 18             LDA     LINEX2+1
001F9A  3  ED 8A 18             SBC     LINEX1+1
001F9D  3  90 0B                BCC     LINEVERT_DECX   ; X2 < X1, DECREMENT X1
001F9F  3  EE 89 18             INC     LINEX1          ; X2 >= X1, INCREMENT X1
001FA2  3  D0 11                BNE     LINEVERT_NOSTEP
001FA4  3  EE 8A 18             INC     LINEX1+1
001FA7  3  4C B5 1F             JMP     LINEVERT_NOSTEP
001FAA  3               LINEVERT_DECX:
001FAA  3  AD 89 18             LDA     LINEX1
001FAD  3  D0 03                BNE     :+
001FAF  3  CE 8A 18             DEC     LINEX1+1
001FB2  3  CE 89 18     :       DEC     LINEX1
001FB5  3               LINEVERT_NOSTEP:
001FB5  3               
001FB5  3  AD 8B 18             LDA     LINEY1
001FB8  3  CD 8F 18             CMP     LINEY2
001FBB  3  D0 88                BNE     LINEVERTLOOP
001FBD  3  60                   RTS                     ; DONE
001FBE  3               
001FBE  3               LINEHORZ:
001FBE  3               ; FOR A HORIZONTAL-ISH LINE WE STEP ALONG THE
001FBE  3               ; X AXIS (SHALLOW GRADIENT)
001FBE  3               ; FIND LARGER X . . .
001FBE  3  38                   SEC                     ; Set carry flag for subtraction
001FBF  3  AD 8D 18             LDA     LINEX2          ; Load low byte of first number
001FC2  3  ED 89 18             SBC     LINEX1          ; Subtract low byte of second number
001FC5  3  AD 8E 18             LDA     LINEX2+1        ; Load high byte of first number
001FC8  3  ED 8A 18             SBC     LINEX1+1        ; Subtract high byte of second number
001FCB  3                                               ; Result flags (N, Z, C) now reflect: Val1 - Val2
001FCB  3  B0 03                BCS     :+              ; If carry is set, LINEX2 >= LINEX1
001FCD  3  20 55 20             JSR     LINESWAPXY
001FD0  3               :
001FD0  3                                               ; Initialize error = DELTAX / 2
001FD0  3  AD 91 18             LDA     DELTAX
001FD3  3  8D 9A 18             STA     LINEERR
001FD6  3  AD 92 18             LDA     DELTAX+1
001FD9  3  8D 9B 18             STA     LINEERR+1
001FDC  3  4E 9B 18             LSR     LINEERR+1
001FDF  3  6E 9A 18             ROR     LINEERR
001FE2  3               LINEHORZLOOP:
001FE2  3  AD 8B 18             LDA     LINEY1          ; OK LET'S PLOT A POINT
001FE5  3  8D 85 18             STA     PLOTY
001FE8  3  AD 8C 18             LDA     LINEY1+1
001FEB  3  8D 86 18             STA     PLOTY+1
001FEE  3  AD 89 18             LDA     LINEX1
001FF1  3  8D 83 18             STA     PLOTX
001FF4  3  AD 8A 18             LDA     LINEX1+1
001FF7  3  8D 84 18             STA     PLOTX+1
001FFA  3  AD 88 18             LDA     LINECOLOR
001FFD  3  8D 87 18             STA     PLOTCOLOR
002000  3  20 BC 1B             JSR     DOPLOTXY
002003  3                                               ; NOW MOVE LINE1 CLOSER TO LINE2
002003  3  EE 89 18             INC     LINEX1          ; BY STEPPING ALONG X AXIS
002006  3  D0 03                BNE     :+
002008  3  EE 8A 18             INC     LINEX1+1
00200B  3               :
00200B  3                                               ; BRESENHAM: err -= DELTAY
00200B  3  38                   SEC
00200C  3  AD 9A 18             LDA     LINEERR
00200F  3  ED 93 18             SBC     DELTAY
002012  3  8D 9A 18             STA     LINEERR
002015  3  AD 9B 18             LDA     LINEERR+1
002018  3  ED 94 18             SBC     DELTAY+1
00201B  3  8D 9B 18             STA     LINEERR+1
00201E  3  10 24                BPL     LINEHORZ_NOSTEP ; IF ERR >= 0, NO Y STEP NEEDED
002020  3                                               ; ERR += DELTAX (RESTORE ERROR)
002020  3  18                   CLC
002021  3  AD 9A 18             LDA     LINEERR
002024  3  6D 91 18             ADC     DELTAX
002027  3  8D 9A 18             STA     LINEERR
00202A  3  AD 9B 18             LDA     LINEERR+1
00202D  3  6D 92 18             ADC     DELTAX+1
002030  3  8D 9B 18             STA     LINEERR+1
002033  3                                               ; STEP Y TOWARD Y2
002033  3  AD 8F 18             LDA     LINEY2
002036  3  CD 8B 18             CMP     LINEY1
002039  3  90 06                BCC     LINEHORZ_DECY   ; Y2 < Y1, DECREMENT
00203B  3  EE 8B 18             INC     LINEY1          ; Y2 >= Y1, INCREMENT
00203E  3  4C 44 20             JMP     LINEHORZ_NOSTEP
002041  3               LINEHORZ_DECY:
002041  3  CE 8B 18             DEC     LINEY1
002044  3               LINEHORZ_NOSTEP:
002044  3               
002044  3  AD 89 18             LDA     LINEX1
002047  3  CD 8D 18             CMP     LINEX2
00204A  3  D0 96                BNE     LINEHORZLOOP
00204C  3  AD 8A 18             LDA     LINEX1+1
00204F  3  CD 8E 18             CMP     LINEX2+1
002052  3  D0 8E                BNE     LINEHORZLOOP
002054  3  60                   RTS                     ; DONE
002055  3               
002055  3               LINESWAPXY:
002055  3  AD 89 18             LDA     LINEX1
002058  3  AC 8D 18             LDY     LINEX2
00205B  3  8C 89 18             STY     LINEX1
00205E  3  8D 8D 18             STA     LINEX2
002061  3  AD 8A 18             LDA     LINEX1+1
002064  3  AC 8E 18             LDY     LINEX2+1
002067  3  8C 8A 18             STY     LINEX1+1
00206A  3  8D 8E 18             STA     LINEX2+1
00206D  3               ;
00206D  3  AD 8B 18             LDA     LINEY1
002070  3  AC 8F 18             LDY     LINEY2
002073  3  8C 8B 18             STY     LINEY1
002076  3  8D 8F 18             STA     LINEY2
002079  3  AD 8C 18             LDA     LINEY1+1
00207C  3  AC 90 18             LDY     LINEY2+1
00207F  3  8C 8C 18             STY     LINEY1+1
002082  3  8D 90 18             STA     LINEY2+1
002085  3  60                   RTS
002086  3                       .ELSE
002086  3               
002086  3               
002086  3               ; ENSURE ALL OF THESE SPECIAL COMMANDS GIVE ERRORS IN NORMAL BASIC
002086  3               LAB_SPEEK:
002086  3               LAB_SPOKE:
002086  3               LAB_SCRCLR:
002086  3               LAB_SCREEN:
002086  3               LAB_PATTERN:
002086  3               LAB_PLOT:
002086  3               LAB_LOCATE:
002086  3               LAB_COLOR:
002086  3               LAB_LINE:
002086  3                       LDX     #$02            ; error code $02 ("SYNTAX" error)
002086  3                       JMP     LAB_XERR        ; do error #X, then warm start
002086  3               
002086  3                       .ENDIF
002086  3               
002086  2                       .INCLUDE "sid.asm"
002086  3               
002086  3               
002086  3                       .IFDEF  MEMORYMAPPEDSCREEN
002086  3               
002086  3               PC6502_IO       = $E000
002086  3               SID_BASE        = PC6502_IO+$100
002086  3               
002086  3               ;___SOUND__________________________________________________
002086  3               ;
002086  3               ; PLAY SOUND
002086  3               ;
002086  3               ;  SOUND VOICE, FREQ, DUTY, WAVEFORM, ATTACK, SUSTAIN, DECAY, RELEASE
002086  3               ;
002086  3               ;
002086  3               ;__________________________________________________________
002086  3               LAB_SOUND:
002086  3  20 CC 36             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (VOICE)
002089  3  8A                   TXA
00208A  3  29 03                AND     #3
00208C  3  0A                   ASL     A
00208D  3  AA                   TAX
00208E  3  BD 08 21             LDA     SIDVOICELOOKUP,X
002091  3  85 FD                STA     TEMPW
002093  3  BD 09 21             LDA     SIDVOICELOOKUP+1,X
002096  3  85 FE                STA     TEMPW+1
002098  3                                               ; OK, TEMPW POINTS TO SID REGISTER TO MODIFY
002098  3  20 3B 2E             JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
00209B  3  20 09 2D             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
00209E  3                                               ; else do type mismatch
00209E  3  20 32 37             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
0020A1  3  A0 00                LDY     #0              ; SET FREQUENCY
0020A3  3  A5 11                LDA     Itempl
0020A5  3  91 FD                STA     (TEMPW),Y
0020A7  3  A5 12                LDA     Itemph
0020A9  3  E8                   INX
0020AA  3  91 FD                STA     (TEMPW),Y
0020AC  3  20 3B 2E             JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
0020AF  3  20 09 2D             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
0020B2  3                                               ; else do type mismatch
0020B2  3  20 32 37             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
0020B5  3  A0 02                LDY     #2              ; SET DUTY CYCLE
0020B7  3  A5 11                LDA     Itempl
0020B9  3  91 FD                STA     (TEMPW),Y
0020BB  3  A5 12                LDA     Itemph
0020BD  3  C8                   INY
0020BE  3  91 FD                STA     (TEMPW),Y
0020C0  3  20 3B 2E             JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
0020C3  3  20 CC 36             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (WAVEFORM)
0020C6  3  8A                   TXA
0020C7  3  A0 04                LDY     #4              ; SET WAVEFORM CYCLE
0020C9  3  91 FD                STA     (TEMPW),Y
0020CB  3  20 3B 2E             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
0020CE  3  20 CC 36             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (ATTACK)
0020D1  3  8A                   TXA
0020D2  3  4A                   LSR     A
0020D3  3  4A                   LSR     A
0020D4  3  4A                   LSR     A
0020D5  3  4A                   LSR     A
0020D6  3  8D 95 18             STA     PTEMPW
0020D9  3  20 3B 2E             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
0020DC  3  20 CC 36             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (DECAY)
0020DF  3  8A                   TXA
0020E0  3  29 0F                AND     #$0F
0020E2  3  0D 95 18             ORA     PTEMPW
0020E5  3  A0 05                LDY     #5              ; SET ATTACK/DECAY
0020E7  3  91 FD                STA     (TEMPW),Y
0020E9  3  20 3B 2E             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
0020EC  3  20 CC 36             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (SUSTAIN)
0020EF  3  8A                   TXA
0020F0  3  4A                   LSR     A
0020F1  3  4A                   LSR     A
0020F2  3  4A                   LSR     A
0020F3  3  4A                   LSR     A
0020F4  3  8D 95 18             STA     PTEMPW
0020F7  3  20 3B 2E             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
0020FA  3  20 CC 36             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (RELEASE)
0020FD  3  8A                   TXA
0020FE  3  29 0F                AND     #$0F
002100  3  0D 95 18             ORA     PTEMPW
002103  3  A0 06                LDY     #6              ; SET SUSTAIN/RELEASE
002105  3  91 FD                STA     (TEMPW),Y
002107  3  60                   RTS
002108  3               SIDVOICELOOKUP:
002108  3  00 E1 07 E1          .WORD   SID_BASE,SID_BASE+7,SID_BASE+$12
00210C  3  12 E1        
00210E  3               
00210E  3               ;___FILTER_________________________________________________
00210E  3               ;
00210E  3               ; SET SID FILTERS
00210E  3               ;
00210E  3               ;  FILTER CUTOFF, RESONANCE, VOICE 1 ENABLE, VOICE 2 ENABLE, VOICE 3 ENABLE, EXTERNAL ENABLE, FILTER MODE, VOLUME
00210E  3               ;
00210E  3               ;
00210E  3               ;__________________________________________________________
00210E  3               LAB_FILTER:
00210E  3  20 09 2D             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
002111  3                                               ; else do type mismatch
002111  3  20 32 37             JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
002114  3                                               ; SET CUTOFF
002114  3  A5 11                LDA     Itempl
002116  3  8D 15 E1             STA     SID_BASE+$15
002119  3  A5 12                LDA     Itemph
00211B  3  8D 16 E1             STA     SID_BASE+$16
00211E  3  20 3B 2E             JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
002121  3  20 CC 36             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (RESONANCE)
002124  3  8A                   TXA
002125  3  4A                   LSR     A
002126  3  4A                   LSR     A
002127  3  4A                   LSR     A
002128  3  4A                   LSR     A
002129  3  8D 95 18             STA     PTEMPW
00212C  3  20 3B 2E             JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
00212F  3  20 CC 36             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 1 ENABLE)
002132  3  8A                   TXA
002133  3  29 01                AND     #1
002135  3  0D 95 18             ORA     PTEMPW
002138  3  8D 95 18             STA     PTEMPW
00213B  3  20 3B 2E             JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
00213E  3  20 CC 36             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 2 ENABLE)
002141  3  8A                   TXA
002142  3  29 01                AND     #1
002144  3  4A                   LSR     A
002145  3  0D 95 18             ORA     PTEMPW
002148  3  8D 95 18             STA     PTEMPW
00214B  3  20 3B 2E             JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
00214E  3  20 CC 36             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 3 ENABLE)
002151  3  8A                   TXA
002152  3  29 01                AND     #1
002154  3  4A                   LSR     A
002155  3  4A                   LSR     A
002156  3  0D 95 18             ORA     PTEMPW
002159  3  8D 95 18             STA     PTEMPW
00215C  3  20 3B 2E             JSR     LAB_1C01        ; GET THE SIXTH PARAMETER (AFTER ',') OR SYN ERR
00215F  3  20 CC 36             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (EXTERNAL AUDIO ENABLE)
002162  3  8A                   TXA
002163  3  29 01                AND     #1
002165  3  4A                   LSR     A
002166  3  4A                   LSR     A
002167  3  4A                   LSR     A
002168  3  0D 95 18             ORA     PTEMPW
00216B  3  8D 17 E1             STA     SID_BASE+$17
00216E  3  20 3B 2E             JSR     LAB_1C01        ; GET THE SEVENTH PARAMETER (AFTER ',') OR SYN ERR
002171  3  20 CC 36             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (FILTER MODE)
002174  3  8A                   TXA
002175  3  4A                   LSR     A
002176  3  4A                   LSR     A
002177  3  4A                   LSR     A
002178  3  4A                   LSR     A
002179  3  8D 95 18             STA     PTEMPW
00217C  3  20 3B 2E             JSR     LAB_1C01        ; GET THE EIGHTH PARAMETER (AFTER ',') OR SYN ERR
00217F  3  20 CC 36             JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOLUME)
002182  3  8A                   TXA
002183  3  29 0F                AND     #$0F
002185  3  0D 95 18             ORA     PTEMPW
002188  3  8D 18 E1             STA     SID_BASE+$18
00218B  3  60                   RTS
00218C  3               
00218C  3                       .ELSE
00218C  3               
00218C  3               
00218C  3               ; ENSURE ALL OF THESE SPECIAL COMMANDS GIVE ERRORS IN NORMAL BASIC
00218C  3               LAB_SOUND:
00218C  3               LAB_FILTER:
00218C  3                       LDX     #$02            ; error code $02 ("SYNTAX" error)
00218C  3                       JMP     LAB_XERR        ; do error #X, then warm start
00218C  3               
00218C  3                       .ENDIF
00218C  3               
00218C  2                       .INCLUDE "rtc.asm"
00218C  3               
00218C  3               
00218C  3               RTCSECONDS      = 0
00218C  3               RTCMINUTES      = 1
00218C  3               RTCHOUR         = 2
00218C  3               RTCDATE         = 3
00218C  3               RTCMONTH        = 4
00218C  3               RTCYEAR         = 6
00218C  3               
00218C  3               ;___LAB_SECOND______________________________________________
00218C  3               ;
00218C  3               ; RETURN SYSTEM SECONDS
00218C  3               ;
00218C  3               ;__________________________________________________________
00218C  3               LAB_SECOND:
00218C  3  A2 00                LDX     #RTCSECONDS
00218E  3  A9 33                LDA     #51
002190  3  85 32                STA     farfunct
002192  3  20 F0 FF             JSR     DO_FARCALL
002195  3  98                   TYA
002196  3               
002196  3  20 27 22             JSR     BCD_TO_HEX
002199  3  A8                   TAY
00219A  3  A9 00                LDA     #0              ; Get high byte
00219C  3  20 97 32             JSR     LAB_AYFC
00219F  3  60                   RTS
0021A0  3               LAB_PSECOND:
0021A0  3  46 5F                LSR     <Dtypef         ; clear data type flag, $FF=string, $00=numeric
0021A2  3  20 BC 00             JSR     LAB_IGBY        ; increment and scan memory then do function
0021A5  3  60                   RTS
0021A6  3               ;___LAB_MINUTE______________________________________________
0021A6  3               ;
0021A6  3               ; RETURN SYSTEM MINUTE
0021A6  3               ;
