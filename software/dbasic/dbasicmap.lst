00103B  2  68                   PLA                     ; restore byte
00103C  2  4A                   LSR     A               ; shift upper nybble down
00103D  2  4A                   LSR     A
00103E  2  4A                   LSR     A
00103F  2  4A                   LSR     A
001040  2               ; convert low nybble in A to hex digit
001040  2               ASCII:
