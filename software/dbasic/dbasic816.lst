0010C1  2  08                   PHP
0010C2  2  A9 01                LDA     #$01
0010C4  2  8D 58 10             STA     printflag
0010C7  2  28                   PLP
0010C8  2  20 E0 1C             JSR     LAB_LIST
0010CB  2  A9 00                LDA     #$00
0010CD  2  8D 58 10             STA     printflag
0010D0  2  60                   RTS
