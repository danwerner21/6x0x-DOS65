003F58  1  A5 B3                LDA     FAC2_e          ; get exponent
003F5A  1  4A                   LSR     A               ; check odd/even
003F5B  1  B0 0E                BCS     LAB_SQE2        ; if odd only 1 shift first time
003F5D  1               
003F5D  1               LAB_SQE1:
003F5D  1  06 B6                ASL     FAC2_3          ; shift highest bit of number ..
003F5F  1  26 B5                ROL     FAC2_2          ; ..
003F61  1  26 B4                ROL     FAC2_1          ; ..
003F63  1  26 77                ROL     FACt_3          ; .. into remainder
003F65  1  26 76                ROL     FACt_2          ; ..
003F67  1  26 75                ROL     FACt_1          ; ..
003F69  1  26 78                ROL     TempB           ; .. never overflows
003F6B  1               LAB_SQE2:
003F6B  1  06 B6                ASL     FAC2_3          ; shift highest bit of number ..
003F6D  1  26 B5                ROL     FAC2_2          ; ..
003F6F  1  26 B4                ROL     FAC2_1          ; ..
003F71  1  26 77                ROL     FACt_3          ; .. into remainder
003F73  1  26 76                ROL     FACt_2          ; ..
003F75  1  26 75                ROL     FACt_1          ; ..
003F77  1  26 78                ROL     TempB           ; .. never overflows
003F79  1               
003F79  1  06 AF                ASL     FAC1_3          ; root = root * 2
003F7B  1  26 AE                ROL     FAC1_2          ; ..
003F7D  1  26 AD                ROL     FAC1_1          ; .. never overflows
003F7F  1               
003F7F  1  A5 AF                LDA     FAC1_3          ; get root low byte
003F81  1  2A                   ROL     A               ; *2
003F82  1  85 5B                STA     Temp3           ; save partial low byte
003F84  1  A5 AE                LDA     FAC1_2          ; get root low mid byte
003F86  1  2A                   ROL     A               ; *2
003F87  1  85 5C                STA     Temp3+1         ; save partial low mid byte
003F89  1  A5 AD                LDA     FAC1_1          ; get root high mid byte
003F8B  1  2A                   ROL     A               ; *2
003F8C  1  85 5D                STA     Temp3+2         ; save partial high mid byte
003F8E  1  A9 00                LDA     #$00            ; get root high byte (always $00)
003F90  1  2A                   ROL     A               ; *2
003F91  1  85 5E                STA     Temp3+3         ; save partial high byte
003F93  1               
003F93  1               ; carry clear for subtract +1
003F93  1  A5 77                LDA     FACt_3          ; get remainder low byte
003F95  1  E5 5B                SBC     Temp3           ; subtract partial low byte
003F97  1  85 5B                STA     Temp3           ; save partial low byte
003F99  1               
003F99  1  A5 76                LDA     FACt_2          ; get remainder low mid byte
003F9B  1  E5 5C                SBC     Temp3+1         ; subtract partial low mid byte
003F9D  1  85 5C                STA     Temp3+1         ; save partial low mid byte
003F9F  1               
003F9F  1  A5 75                LDA     FACt_1          ; get remainder high mid byte
003FA1  1  E5 5D                SBC     Temp3+2         ; subtract partial high mid byte
003FA3  1  A8                   TAY                     ; copy partial high mid byte
003FA4  1               
003FA4  1  A5 78                LDA     TempB           ; get remainder high byte
003FA6  1  E5 5E                SBC     Temp3+3         ; subtract partial high byte
003FA8  1  90 0E                BCC     LAB_SQNS        ; skip sub if remainder smaller
003FAA  1               
003FAA  1  85 78                STA     TempB           ; save remainder high byte
003FAC  1               
003FAC  1  84 75                STY     FACt_1          ; save remainder high mid byte
003FAE  1               
