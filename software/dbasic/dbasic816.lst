0012E8  3  D0 E5                BNE     DOS65FCBPREP_1A ; NO, LOOP
0012EA  3  A0 01                LDY     #$01            ; POINT Y TO FCB FILE NAME
0012EC  3               DOS65FCBPREP_2:                 ; COPY FILE NAME PARAMETER INTO FCB
0012EC  3                       .IFDEF  DUODYNE
0012EC  3  22 BC 00 00          JSL     LAB_IGBY        ; increment and scan memory
0012F0  3                       .ELSE
0012F0  3                       JSR     LAB_IGBY        ; increment and scan memory
0012F0  3                       .ENDIF
