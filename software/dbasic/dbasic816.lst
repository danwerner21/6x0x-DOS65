00113C  2               ;	WRITE CHARACTER(A) TO UART
00113C  2               ;________________________________________________________________________________________________________________________________
00113C  2               ;
00113C  2               WRSER1:
00113C  2  48                   PHA
00113D  2               WRSER1a:
00113D  2  AD 85 EF             LDA     UART1STATUS     ; GET STATUS
001140  2  29 10                AND     #%00010000      ; IS TX READY
001142  2  F0 F9                BEQ     WRSER1a         ; NO, WAIT FOR IT
001144  2  68                   PLA
001145  2  8D 84 EF             STA     UART1DATA       ; WRITE DATA
001148  2  60                   RTS
