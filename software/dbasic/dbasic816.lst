001457  3  20 FE 26             JSR     LAB_GVAR        ; GET THE FOURTH PARAMETER
00145A  3  85 97                STA     Lvarpl          ; save var address low byte
00145C  3  84 98                STY     Lvarph          ; save var address high byte
00145E  3  A5 5F                LDA     <Dtypef         ; IS IT A STRING?
001460  3  D0 08                BNE     :+              ; YES, CONTINUE ON
001462  3  A2 02                LDX     #$02            ; NOPE, SYNTAX ERROR
001464  3  20 D5 18             JSR     LAB_XERR
001467  3  4C B1 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
00146A  3               :
00146A  3  A9 22                LDA     #34
00146C  3  20 3D 2B             JSR     LAB_MSSP        ; make string space A bytes long A=$AC=length,
00146F  3                                               ; X=$AD=<Sutill=ptr low byte, Y=$AE=<Sutilh=ptr high byte
00146F  3                                               ; COPY FCB TO STRING
00146F  3  A2 21                LDX     #33             ;
001471  3  A0 21                LDY     #33             ;
001473  3               :
001473  3  CA                   DEX
001474  3  88                   DEY
001475  3  BD F5 15             LDA     FCB,X
001478  3  91 AD                STA     (str_pl),Y      ;
00147A  3  E0 00                CPX     #0              ;
00147C  3  D0 F5                BNE     :-              ;
00147E  3                                               ;
00147E  3  20 9E 2B             JSR     LAB_RTST        ; STORE STRING
001481  3  4C 8E 1F             JMP     LAB_17D5        ; do string LET and return
001484  3               
001484  3               OPNTMP:
001484  3  00                   .BYTE   00
