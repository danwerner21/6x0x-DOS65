001099  2               ;___ScreenEditor____________________________________________
001099  2               ;
001099  2               ; Basic Screen editor code
001099  2               ;
001099  2               ;__________________________________________________________
001099  2               ScreenEditor:
001099  2               ; allow prepopulate of screen
001099  2               ploop:
001099  2                       LDA     #58
001099  2                       STA     farfunct
001099  2                       JSR     DO_FARCALL      ; PAINT cursor
001099  2               ploop1:
001099  2                       LDA     #20
001099  2                       STA     farfunct
001099  2                       JSR     DO_FARCALL      ; GET KEYSTROKE
001099  2                       CMP     #$FF
001099  2                       BEQ     ploop1
001099  2                       PHA
001099  2                       LDA     #59
001099  2                       STA     farfunct
001099  2                       JSR     DO_FARCALL      ; UNPAINT cursor
001099  2                       PLA
001099  2                       CMP     #$F6
001099  2                       BEQ     crsrup
001099  2                       CMP     #$F7
001099  2                       BEQ     crsrdn
001099  2                       CMP     #$F8
001099  2                       BEQ     crsrlt
001099  2                       CMP     #$F9
001099  2                       BEQ     Lcrsrrt
001099  2                       CMP     #$0A
001099  2                       BEQ     ploop
001099  2                       CMP     #13
001099  2                       BEQ     Lpexit
001099  2               
001099  2                       PHA
001099  2                       LDA     #19
001099  2                       STA     farfunct
001099  2                       PLA
001099  2                       JSR     DO_FARCALL
001099  2                       JMP     ploop
001099  2               Lpexit:
001099  2                       JMP     pexit
001099  2               Lcrsrrt:
001099  2                       JMP     crsrrt
001099  2               
001099  2               crsrup:
001099  2                       LDA     CURY
001099  2                       CMP     #00
001099  2                       BEQ     ploop
001099  2                       DEC     CURY
001099  2                       JMP     ploop
001099  2               crsrdn:
001099  2                       LDA     CURY
001099  2                       CMP     #23
001099  2                       BEQ     crsrdn_1
001099  2                       INC     CURY
001099  2                       JMP     ploop
001099  2               crsrdn_1:
001099  2                       LDA     #56
001099  2                       STA     farfunct
001099  2                       JSR     DO_FARCALL
001099  2                       JMP     ploop
001099  2               crsrlt:
001099  2                       LDA     CURX
001099  2                       CMP     #00
001099  2                       BEQ     crsrlt_1
001099  2                       DEC     CURX
001099  2                       JMP     ploop
001099  2               crsrlt_1:
001099  2                       LDA     CURY
001099  2                       CMP     #00
001099  2                       BEQ     :+
001099  2                       LDX     VIDEOWIDTH
001099  2                       DEX
001099  2                       STX     CURX
001099  2                       LDY     CURY
001099  2                       DEY
001099  2                       STY     CURY
001099  2               :
001099  2                       JMP     ploop
001099  2               crsrrt:
001099  2                       LDX     VIDEOWIDTH
001099  2                       DEX
001099  2                       CPX     CURX
001099  2                       BEQ     crsrrt_1
001099  2                       INC     CURX
001099  2                       JMP     ploop
001099  2               crsrrt_1:
001099  2                       LDA     #00
001099  2                       STA     CURX
001099  2                       JMP     crsrdn
001099  2               pexit:
001099  2                       JSR     LdKbBuffer
001099  2                       LDX     #80
001099  2                       LDA     #$00
001099  2                       STA     Ibuffs,X
001099  2               TERMLOOP:
001099  2                       DEX
001099  2                       LDA     Ibuffs,X
001099  2                       CMP     #32
001099  2                       BEQ     TERMLOOP_B
001099  2                       CMP     #00
001099  2                       BEQ     TERMLOOP_C
001099  2                       JMP     TERMLOOP_A
001099  2               TERMLOOP_B:
001099  2                       LDA     #00
001099  2                       STA     Ibuffs,X
001099  2               TERMLOOP_C:
001099  2                       CPX     #00
001099  2                       BNE     TERMLOOP
001099  2               TERMLOOP_A:
001099  2                       LDA     #19
001099  2                       STA     farfunct
001099  2                       LDA     #13
001099  2                       JSR     DO_FARCALL
001099  2                       LDA     #19
001099  2                       STA     farfunct
001099  2                       LDA     #10
001099  2                       JSR     DO_FARCALL
001099  2                       RTS
001099  2               
001099  2               LdKbBuffer:
001099  2               ; clear input buffer
001099  2                       LDX     #81
001099  2               :
001099  2                       LDA     #00
001099  2                       STA     Ibuffs-1,X
001099  2                       DEX
001099  2                       BNE     :-
001099  2               
001099  2                       LDY     CURY
001099  2               
001099  2                       STY     PTEMPW
001099  2                       LDA     #0
001099  2                       STA     PTEMPW+1
001099  2                       CLC
001099  2                       ASL     PTEMPW
001099  2                       ROL     PTEMPW+1        ; *2
001099  2                       ASL     PTEMPW
001099  2                       ROL     PTEMPW+1        ; *4
001099  2                       ASL     PTEMPW
001099  2                       ROL     PTEMPW+1        ; *8
001099  2                       LDA     PTEMPW
001099  2                       STA     PTEMPW1
001099  2                       LDA     PTEMPW+1
001099  2                       STA     PTEMPW1+1       ; PTEMPW1=Y*8
001099  2                       ASL     PTEMPW
001099  2                       ROL     PTEMPW+1        ; *16
001099  2                       ASL     PTEMPW
001099  2                       ROL     PTEMPW+1        ; *32
001099  2                                               ; TEMPW  = Y*8 + Y*32  (Y*40)
001099  2                       CLC                     ; Clear the Carry flag before the first addition
001099  2                       LDA     PTEMPW          ; Load the low byte of the first number into the accumulator
001099  2                       ADC     PTEMPW1         ; Add the low byte of the second number (plus carry)
001099  2                       STA     TEMPW           ; Store the low byte of the result
001099  2                       LDA     PTEMPW+1        ; Load the high byte of the first number
001099  2                       ADC     PTEMPW1+1       ; Add the high byte of the second number (plus carry from previous op)
001099  2                       STA     TEMPW+1         ; Store the high byte of the result
001099  2               
001099  2                       LDA     VIDEOWIDTH      ; If 80 col, double again
001099  2                       CMP     #80
001099  2                       BNE     :+
001099  2                       ASL     TEMPW
001099  2                       ROL     TEMPW+1         ; *2  (80)
001099  2               :
001099  2                       LDA     TEMPW+1
001099  2                       ORA     #$A0            ; add in the bank#
001099  2                       STA     TEMPW+1
001099  2               
001099  2                       LDY     #$01+VIDEOBANK  ; SCREEN AREA $1000-$1FFF
001099  2                       JSR     PAGE_ENTER
001099  2                       LDY     #0
001099  2               :
001099  2                       LDA     (TEMPW),Y
001099  2                       STA     Ibuffs,Y
001099  2                       INY
001099  2                       CPY     VIDEOWIDTH
001099  2                       BNE     :-
001099  2               
001099  2                       JSR     PAGE_EXIT
001099  2                       RTS
001099  2                       RTS
001099  2               
001099  2                       .ENDIF
