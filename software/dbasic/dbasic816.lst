0016E2  3  86 AD                STX     str_pl          ; set string pointer low byte
0016E4  3  84 AE                STY     str_ph          ; set string pointer high byte
0016E6  3                                               ; STORE IN FILENAME AND EXTENSION
0016E6  3  A2 00                LDX     #0
0016E8  3  A0 00                LDY     #0
0016EA  3               :
0016EA  3  B1 AD                LDA     (str_pl),Y
