001259  2                       .INCLUDE "screencmds.asm"
001259  3               
001259  3               
001259  3                       .IFDEF  MEMORYMAPPEDSCREEN
001259  3               
001259  3               ;* MEMORY MAP
001259  3               ;  VIDEO CARD IS A 32K AREA
001259  3               ;  $0x00 0x01=soft_scanline_emulation, 0x02 NO soft_scanline_emulation
001259  3               ;  $0x01 0x01=page1, 0x02 page2
001259  3               ;  $0x02  character generator write offset (data << 3)
001259  3               ;  $0x03 character generator write DATA
001259  3               ;  $0x04 EXECUTE device command
001259  3               ;        0x00- reset to the default configuration
001259  3               ;        0x01- reset to the saved configuration
001259  3               ;	0x02- save the current configuration
001259  3               ;
001259  3               ;  $0x05  0x01=soft_text=true, 0x02=soft_text=false
001259  3               ;  $0x06 Lores Mode=0X01,NO lores Mode=0x02
001259  3               ;  $0x07 Double Lores Mode=0X01,NO Double lores Mode=0x02
001259  3               ;  $0x08 Hires Mode=0X01,NO Hires Mode=0x02
001259  3               ;  $0x09 Double Hires Mode=0X01,NO Double Hires lores Mode=0x02
001259  3               ;  $0x0A 80COL Mode=0X01,NO 80COL Mode=0x02
001259  3               ;  $0x0B MIXED Mode=0X01,NO MIXED Mode=0x02
001259  3               ;  $0x0C QUAD Hires Mode=0X01,NO QUAD Hires lores Mode=0x02
001259  3               ;  $0x0D MONO Hires Mode=0X01,NO MONO Hires lores Mode=0x02
001259  3               ;
001259  3               ; 	VRAM Memory Map
001259  3               ;	$1000-$177F	40/80 Text Page 1
001259  3               ;	$1800-$1F7F	40/80 Color Page 1
001259  3               ;	$2000-$277F	40/80 Text Page 2
001259  3               ;	$2800-$2F7F	40/80 Color Page 2
001259  3               ;	$2000-$5FFF	HIRES PAGE 1
001259  3               ;	$6000-$8FFF	HIRES PAGE 2
001259  3               ;	$2000-$BFFF	DOUBLE HIRES
001259  3               
001259  3               VIDEOBANK       = $F8
001259  3               PC6502_IOSPACE  = $EF00
001259  3               ; PAGER
001259  3               PC6502_ACT_TASK = PC6502_IOSPACE+$E0
001259  3               PC6502_MAP_SETUP = PC6502_IOSPACE+$E1
001259  3               PC6502_MMU_ENA  = PC6502_IOSPACE+$E2
001259  3               PC6502_MAP_SPACE = PC6502_IOSPACE+$D0
001259  3               
001259  3               VideoDisplayPage = $B001
001259  3               VideoCharGenOffset = $B002
001259  3               VideoCharGenData = $B003
001259  3               VideoTextMode   = $B005
001259  3               VideoLoresMode  = $B006
001259  3               VideoDoubleLores = $B007
001259  3               VideoHiresMode  = $B008
001259  3               VideoDoubleHires = $B009
001259  3               Video80col      = $B00A
001259  3               VideoMixedMode  = $B00b
001259  3               VideoQuadHires  = $B00c
001259  3               VideoMonoHires  = $B00d
001259  3               
001259  3               
001259  3               VIDEOMODE:
001259  3                       .BYTE   $00
001259  3               CLRTMP:
001259  3                       .BYTE   $00
001259  3               VIDEOWIDTH:
001259  3                       .BYTE   $00
001259  3               
001259  3               PTEMPW:
001259  3                       .BYTE   $00,$00
001259  3               PTEMPW1:
001259  3                       .BYTE   $00,$00
001259  3               PTEMPW2:
001259  3                       .BYTE   $00,$00
001259  3               PTEMPW3:
001259  3                       .BYTE   $00,$00
001259  3               PTEMP:
001259  3                       .BYTE   $00
001259  3               
001259  3               ;___V_SPEEK()______________________________________________
001259  3               ;
001259  3               ; GET VALUE FROM SCREEN MEMORY
001259  3               ;
001259  3               ;  TAKES ONE PARAMETER (ADDRESS), RETURNS VALUE
001259  3               ;
001259  3               ;__________________________________________________________
001259  3               LAB_SPEEK:
001259  3               V_SPEEK:
001259  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001259  3                       LDA     Itemph
001259  3                       JSR     PRINT_BYTE
001259  3                       TAY
001259  3                       AND     #$0F
001259  3                       ORA     #$B0
001259  3                       STA     Itemph
001259  3                       JSR     PRINT_BYTE
001259  3                       TYA
001259  3                       AND     #$F0
001259  3                       LSR     A
001259  3                       LSR     A
001259  3                       LSR     A
001259  3                       LSR     A
001259  3                       AND     #$07
001259  3                       CLC
001259  3                       ADC     #VIDEOBANK
001259  3                       TAY
001259  3                       JSR     PRINT_BYTE
001259  3                       LDA     #$01            ; MODIFY TASK 01 (DRIVER TASK)
001259  3                       LDX     #$0B            ; MAP $BXXX
001259  3                       JSR     $FFF6           ; CALL SETPAGE
001259  3                       LDA     #$01
001259  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 01
001259  3                       LDY     #0
001259  3                       LDA     (Itempl),Y
001259  3                       JSR     PRINT_BYTE
001259  3                       TAY
001259  3                       LDA     #$00
001259  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 00
001259  3                       JMP     LAB_1FD0        ; convert Y to byte in FAC1 and return
001259  3               
001259  3               
001259  3               
001259  3               ;___V_SPOKE_________________________________________________
001259  3               ;
001259  3               ; PUT VALUE IN SCREEN MEMORY
001259  3               ;
001259  3               ;  TAKES TWO PARAMETERS ADDRESS,VALUE
001259  3               ;
001259  3               ;__________________________________________________________
001259  3               LAB_SPOKE:
001259  3               V_SPOKE:
001259  3                       JSR     LAB_GADB        ; get two parameters for POKE or WAIT
001259  3                       TXA                     ; BYTE ARGUMENT IS IN X
001259  3                       PHA                     ; PUSH BYTE ARGUMENT TO STACK
001259  3                       LDA     Itemph
001259  3                       TAY
001259  3                       AND     #$0F
001259  3                       ORA     #$B0
001259  3                       STA     Itemph
001259  3                       TYA
001259  3                       AND     #$F0
001259  3                       LSR     A
001259  3                       LSR     A
001259  3                       LSR     A
001259  3                       LSR     A
001259  3                       AND     #$07
001259  3                       CLC
001259  3                       ADC     #VIDEOBANK
001259  3                       TAY
001259  3               
001259  3                       LDY     #0
001259  3                       PLA                     ; PULL BYTE ARGUMENT
001259  3                       STA     (Itempl),Y
001259  3                       LDA     #$00
001259  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 00
001259  3                       RTS
001259  3               
001259  3               ;___V_SCREEN_________________________________________________
001259  3               ;
001259  3               ;  SET SCREEN MODE
001259  3               ;
001259  3               ;  TAKES UP TO THREE PARAMETERS
001259  3               ;  FIRST PARAMETER SCREEN MODE
001259  3               ;  0=TEXT MODE
001259  3               ;  1=LORES MODE
001259  3               ;  2=HIRES MODE
001259  3               ;
001259  3               ;  TEXT MODE PARAMETERS
001259  3               ;  0=40 COLUMNS
001259  3               ;  1=80 COLUMNS
001259  3               ;
001259  3               ;  LORES MODE SECOND PARAMETER
001259  3               ;  0=SINGLE LORES
001259  3               ;  1=DOUBLE LORES
001259  3               ;  LORES MODE THIRD PARAMETER
001259  3               ;  0=MIXED MODE
001259  3               ;  1=FULL SCREEN MODE
001259  3               ;
001259  3               ;  HIRES MODE SECOND PARAMETER
001259  3               ;  0=SINGLE HIRES
001259  3               ;  1=DOUBLE HIRES
001259  3               ;  2=QUAD HIRES
001259  3               ;  3=MONO HIRES
001259  3               ;  HIRES MODE THIRD PARAMETER
001259  3               ;  1=MIXED MODE
001259  3               ;  0=FULL SCREEN MODE
001259  3               ;
001259  3               ;__________________________________________________________
001259  3               LAB_SCREEN:
001259  3               V_SCREEN:
001259  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (MODE)
001259  3               V_SCREEN1:
001259  3                       STX     VIDEOMODE
001259  3                       CPX     #00
001259  3                       BNE     *+5
001259  3                       JMP     SETUPMODE0
001259  3                       CPX     #01
001259  3                       BNE     *+5
001259  3                       JMP     SETUPMODE1
001259  3                       CPX     #02
001259  3                       BNE     *+5
001259  3                       JMP     SETUPMODE2
001259  3               
001259  3                       LDX     #$02            ; SYNTAX ERROR
001259  3                       JSR     LAB_XERR
001259  3                       JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001259  3                       RTS
001259  3               
001259  3               SETUPMODE0:                     ; TEXT MODE
001259  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001259  3                       JSR     PAGE_ENTER
001259  3                       LDA     #$01
001259  3                       STA     VideoTextMode
001259  3                       LDA     #$02
001259  3                       STA     VideoLoresMode
001259  3                       STA     VideoHiresMode
001259  3                       JSR     PAGE_EXIT
001259  3               
001259  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001259  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
001259  3                       CPX     #$00
001259  3                       BNE     SETUPMODE0_80
001259  3               
001259  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001259  3                       JSR     PAGE_ENTER
001259  3                       LDA     #$02
001259  3                       STA     Video80col
001259  3                       JSR     PAGE_EXIT
001259  3                       LDA     #40
001259  3                       STA     VIDEOWIDTH
001259  3                       JMP     SETUPMODE0_CLEAR
001259  3               SETUPMODE0_80:
001259  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001259  3                       JSR     PAGE_ENTER
001259  3                       LDA     #$01
001259  3                       STA     Video80col
001259  3                       JSR     PAGE_EXIT
001259  3                       LDA     #80
001259  3                       STA     VIDEOWIDTH
001259  3               SETUPMODE0_CLEAR:
001259  3                       JMP     V_SCNCLR
001259  3                       RTS
001259  3               
001259  3               SETUPMODE1:                     ; LORES MODE
001259  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001259  3                       JSR     PAGE_ENTER
001259  3                       LDA     #$01
001259  3                       STA     VideoLoresMode
001259  3                       LDA     #$02
001259  3                       STA     VideoTextMode
001259  3                       STA     VideoHiresMode
001259  3                       JSR     PAGE_EXIT
001259  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001259  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
001259  3               
001259  3                       CPX     #$00
001259  3                       BNE     SETUPMODE1_DOUBLE
001259  3               
001259  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001259  3                       JSR     PAGE_ENTER
001259  3                       LDA     #$02
001259  3                       STA     VideoDoubleLores
001259  3                       JSR     PAGE_EXIT
001259  3                       JMP     SETUPMODE1_CLEAR
001259  3               SETUPMODE1_DOUBLE:
001259  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001259  3                       JSR     PAGE_ENTER
001259  3                       LDA     #$01
001259  3                       STA     VideoDoubleLores
001259  3                       JSR     PAGE_EXIT
001259  3                       LDA     #$11
001259  3                       STA     VIDEOMODE
001259  3               SETUPMODE1_CLEAR:               ;    ($2000-$2800)
001259  3                       LDY     #$02+VIDEOBANK  ; AREA $2000-$2FFF
001259  3                       JSR     PAGE_ENTER
001259  3                       LDA     #$00
001259  3                       STA     TEMPW
001259  3                       LDA     #$B0
001259  3                       STA     TEMPW+1
001259  3                       LDY     #$00
001259  3                       LDA     #$00
001259  3               :
001259  3                       STA     (TEMPW),Y
001259  3                       INC     TEMPW
001259  3                       BNE     :-
001259  3                       INC     TEMPW+1
001259  3               
001259  3                       LDX     TEMPW+1
001259  3                       CPX     #$B8
001259  3                       BNE     :-
001259  3                       JSR     PAGE_EXIT
001259  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001259  3                       JSR     LAB_GTBY        ; GET THE THIRD PARAMETER, RETURN IN X
001259  3                       CPX     #$00
001259  3                       BNE     SETUPMODE1_MIXED
001259  3               
001259  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001259  3                       JSR     PAGE_ENTER
001259  3                       LDA     #$02
001259  3                       STA     VideoMixedMode
001259  3                       JSR     PAGE_EXIT
001259  3                       RTS
001259  3               SETUPMODE1_MIXED:
001259  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001259  3                       JSR     PAGE_ENTER
001259  3                       LDA     #$01
001259  3                       STA     VideoMixedMode
001259  3                       JSR     PAGE_EXIT
001259  3                       LDA     VIDEOMODE
001259  3                       ORA     #$80
001259  3                       STA     VIDEOMODE
001259  3                       RTS
001259  3               
001259  3               
001259  3               SETUPMODE2:                     ; HIRES MODE
001259  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001259  3                       JSR     PAGE_ENTER
001259  3                       LDA     #$01
001259  3                       STA     VideoHiresMode
001259  3                       LDA     #$02
001259  3                       STA     VideoTextMode
001259  3                       STA     VideoLoresMode
001259  3                       JSR     PAGE_EXIT
001259  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001259  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
001259  3               
001259  3                       CPX     #$00
001259  3                       BNE     SETUPMODE2_DOUBLE
001259  3               
001259  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001259  3                       JSR     PAGE_ENTER
001259  3                       LDA     #$02
001259  3                       STA     VideoDoubleHires
001259  3                       STA     VideoQuadHires
001259  3                       STA     VideoMonoHires
001259  3                       JSR     PAGE_EXIT
001259  3                       JMP     SETUPMODE2_CLEAR
001259  3               SETUPMODE2_DOUBLE:
001259  3                       CPX     #$01
001259  3                       BNE     SETUPMODE2_QUAD
001259  3               
001259  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001259  3                       JSR     PAGE_ENTER
001259  3                       LDA     #$01
001259  3                       STA     VideoDoubleHires
001259  3                       LDA     #$02
001259  3                       STA     VideoQuadHires
001259  3                       STA     VideoMonoHires
001259  3                       JSR     PAGE_EXIT
001259  3                       LDA     #$12
001259  3                       STA     VIDEOMODE
001259  3                       JMP     SETUPMODE2_CLEAR
001259  3               SETUPMODE2_QUAD:
001259  3                       CPX     #$02
001259  3                       BNE     SETUPMODE2_MONO
001259  3               
001259  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001259  3                       JSR     PAGE_ENTER
001259  3                       LDA     #$01
001259  3                       STA     VideoQuadHires
001259  3                       LDA     #$02
001259  3                       STA     VideoDoubleHires
001259  3                       STA     VideoMonoHires
001259  3                       JSR     PAGE_EXIT
001259  3                       LDA     #$22
001259  3                       STA     VIDEOMODE
001259  3                       JMP     SETUPMODE2_CLEAR
001259  3               SETUPMODE2_MONO:
001259  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001259  3                       JSR     PAGE_ENTER
001259  3                       LDA     #$01
001259  3                       STA     VideoMonoHires
001259  3                       LDA     #$02
001259  3                       STA     VideoDoubleHires
001259  3                       STA     VideoQuadHires
001259  3                       JSR     PAGE_EXIT
001259  3                       LDA     #$32
001259  3                       STA     VIDEOMODE
001259  3               
001259  3               SETUPMODE2_CLEAR:               ; ($2000-$7FFF)
001259  3                       LDY     #$02+VIDEOBANK
001259  3                       STY     CLRTMP
001259  3               
001259  3               :
001259  3                       LDY     CLRTMP
001259  3                       JSR     PAGE_ENTER
001259  3               
001259  3                       LDA     #$00
001259  3                       TAY
001259  3                       STA     TEMPW
001259  3                       LDA     #$B0
001259  3                       STA     TEMPW+1
001259  3                       LDA     #$00
001259  3               :
001259  3                       STA     (TEMPW),Y
001259  3                       INC     TEMPW
001259  3                       BNE     :-
001259  3                       INC     TEMPW+1
001259  3                       LDX     TEMPW+1
001259  3                       CPX     #$C0
001259  3                       BNE     :-
001259  3                       LDX     #$B0
001259  3                       INC     CLRTMP
001259  3                       LDX     CLRTMP
001259  3                       CPX     #$00
001259  3                       BNE     :--
001259  3                       JSR     PAGE_EXIT
001259  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001259  3                       JSR     LAB_GTBY        ; GET THE THIRD PARAMETER, RETURN IN X
001259  3                       CPX     #$00
001259  3                       BNE     SETUPMODE2_MIXED
001259  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001259  3                       JSR     PAGE_ENTER
001259  3                       LDA     #$02
001259  3                       STA     VideoMixedMode
001259  3                       JSR     PAGE_EXIT
001259  3                       RTS
001259  3               SETUPMODE2_MIXED:
001259  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001259  3                       JSR     PAGE_ENTER
001259  3                       LDA     #$01
001259  3                       STA     VideoMixedMode
001259  3                       JSR     PAGE_EXIT
001259  3                       LDA     VIDEOMODE
001259  3                       ORA     #$80
001259  3                       STA     VIDEOMODE
001259  3                       RTS
001259  3               
001259  3               LAB_SCRCLR:
001259  3               V_SCNCLR:
001259  3                       RTS
001259  3               
001259  3               PAGE_EXIT:
001259  3                       LDA     #$00
001259  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 00
001259  3                       RTS
001259  3               
001259  3               PAGE_ENTER:
001259  3               ; Set "Y" register to video page ($YXXX)
001259  3                       LDA     #$01            ; MODIFY TASK 01 (DRIVER TASK)
001259  3                       LDX     #$0B            ; MAP $BXXX
001259  3                       JSR     $FFF6           ; CALL SETPAGE
001259  3                       LDA     #$01
001259  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 01
001259  3                       RTS
001259  3               
001259  3               ;___V_PLOT__________________________________________________
001259  3               ;
001259  3               ;  PLOT ON SCREEN
001259  3               ;         TAKES THREE PARAMETERS,  X,Y,COLOR
001259  3               ;
001259  3               ;__________________________________________________________
001259  3               LAB_PLOT:
001259  3               V_PLOT:
001259  3                       LDA     VIDEOMODE
001259  3                       AND     #$0F
001259  3                       CMP     #$01
001259  3                       BEQ     V_PLOT_LORES
001259  3                       LDA     VIDEOMODE
001259  3                       AND     #$2F
001259  3                       CMP     #$02
001259  3                       BNE     :+
001259  3                       JMP    V_PLOT_HIRES_COLOR
001259  3               :
001259  3                       CMP     #$22
001259  3                       BNE     :+
001259  3                       JMP     V_PLOT_HIRES_MONO
001259  3               :
001259  3                       RTS
001259  3               
001259  3               V_PLOT_LORES:
001259  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X
001259  3                       STX     PTEMPW          ; STORE X COORD IN OFFSET ADDRESS
001259  3                       LDA     #00
001259  3                       STA     PTEMPW+1
001259  3                       STA     PTEMPW1+1
001259  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001259  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
001259  3                                               ; FIGURE THE BUFFER OFFSET
001259  3                       TXA                     ; Y COORD IN X
001259  3                       PHA
001259  3                       LSR     A               ; 2 LINES PER BYTE
001259  3                       STA     PTEMPW1
001259  3                                               ; MULTIPLY Y (PTEMPW) COORD BY 40 OR 80 (SINGLE OR DOUBLE LORES)
001259  3                       CLC
001259  3                       ASL     PTEMPW1
001259  3                       ROL     PTEMPW1+1       ; *2
001259  3                       ASL     PTEMPW1
001259  3                       ROL     PTEMPW1+1       ; *2 (*4)
001259  3                       ASL     PTEMPW1
001259  3                       ROL     PTEMPW1+1       ; *2 (*8)
001259  3                       LDA     PTEMPW1
001259  3                       STA     PTEMPW2
001259  3                       LDA     PTEMPW1+1
001259  3                       STA     PTEMPW2+1       ; STORE Y*8 INTO PTEMPW2
001259  3                       ASL     PTEMPW1
001259  3                       ROL     PTEMPW1+1       ; *2 (*16)
001259  3                       ASL     PTEMPW1
001259  3                       ROL     PTEMPW1+1       ; *2 (*32)
001259  3                                               ; NOW TAKE Y*8(PTEMPW2) + Y*32(PTEMPW1) == Y*40 STORE IN PTEMPW1
001259  3                       CLC                     ; Clear the Carry flag before the first addition
001259  3               
001259  3                       LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
001259  3                       ADC     PTEMPW2         ; Add the low byte of the second number (plus carry)
001259  3                       STA     PTEMPW1         ; Store the low byte of the result
001259  3               
001259  3                       LDA     PTEMPW1+1       ; Load the high byte of the first number
001259  3                       ADC     PTEMPW2+1       ; Add the high byte of the second number (plus carry from previous op)
001259  3                       STA     PTEMPW1+1       ; Store the high byte of the result
001259  3               
001259  3               ; if double lores columns double it.
001259  3                       LDA     VIDEOMODE
001259  3                       AND     #$10
001259  3                       CMP     #00
001259  3                       BEQ     :+
001259  3                       ASL     PTEMPW1
001259  3                       ROL     PTEMPW1+1       ; *2
001259  3               :
001259  3                                               ; OK, Y OFFSET IS IN PTEMPW1, X IS IN PTEMPW
001259  3                       LDA     #$B0            ; ADD THE MEMORY OFFSET TO PTEMPW (BECAUSE IT IS EASY)
001259  3                       STA     PTEMPW+1        ; THEN ADD PTEMPW1 TO PTEMPW THAT SHOULD BE THE MEMORY ADDRESS TO UPDATE
001259  3                                               ;
001259  3                       CLC                     ; Clear the Carry flag before the first addition
001259  3                       LDA     PTEMPW          ; Load the low byte of the first number into the accumulator
001259  3                       ADC     PTEMPW1         ; Add the low byte of the second number (plus carry)
001259  3                       STA     TEMPW           ; Store the low byte of the result
001259  3               
001259  3                       LDA     PTEMPW+1        ; Load the high byte of the first number
001259  3                       ADC     PTEMPW1+1       ; Add the high byte of the second number (plus carry from previous op)
001259  3                       STA     TEMPW+1         ; Store the high byte of the result
001259  3                                               ; PTEMPW IS THE MEMORY OFFSET TO UPDATE
001259  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001259  3                       JSR     LAB_GTBY        ; GET THE THIRD PARAMETER, RETURN IN X (PATTERN)
001259  3                       TXA
001259  3                       AND     #$0F
001259  3                       STA     PTEMP           ; SAVE COLOR IN PTEMP
001259  3                       PLA
001259  3                       LSR     A               ; TOP OR BOTTOM PIXEL?
001259  3                       BCC     :+
001259  3                                               ; TOP PIXEL
001259  3                       LDY     #$02+VIDEOBANK  ; AREA $2000-$2FFF
001259  3                       JSR     PAGE_ENTER
001259  3                       LDY     #$00
001259  3                       LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
001259  3                       AND     #$0F
001259  3                       PHA
001259  3                       LDA     PTEMP
001259  3                       ASL     A
001259  3                       ASL     A
001259  3                       ASL     A
001259  3                       ASL     A
001259  3                       STA     PTEMP
001259  3                       PLA
001259  3                       ORA     PTEMP
001259  3                       STA     (TEMPW),Y       ; STORE  DOUBLE PIXEL
001259  3                       JSR     PAGE_EXIT
001259  3                       RTS
001259  3               :
001259  3                                               ; BOTTOM PIXEL
001259  3                       LDY     #$02+VIDEOBANK  ; AREA $2000-$2FFF
001259  3                       JSR     PAGE_ENTER
001259  3                       LDY     #$00
001259  3                       LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
001259  3                       AND     #$F0
001259  3                       ORA     PTEMP
001259  3                       STA     (TEMPW),Y       ; STORE  DOUBLE PIXEL
001259  3                       JSR     PAGE_EXIT
001259  3                       RTS
001259  3               
001259  3               V_PLOT_HIRES_COLOR:
001259  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X
001259  3                       TXA
001259  3                       PHA
001259  3                       LSR     A               ; 2 PIXEL PER BYTE
001259  3                       STA     PTEMPW          ; STORE X COORD IN OFFSET ADDRESS
001259  3                       LDA     #$00
001259  3                       STA     PTEMPW+1
001259  3                       STA     PTEMPW1+1
001259  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001259  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
001259  3                                               ; FIGURE THE BUFFER OFFSET
001259  3                       LDA     #$00
001259  3               
001259  3                       TXA                     ; GET Y COORD
001259  3                       STX     PTEMPW1
001259  3                       CLC                     ; MULTIPLY Y COORD BY 70 OR 140 (SINGLE OR DOUBLE HIRES)
001259  3                       ASL     PTEMPW1
001259  3                       ROL     PTEMPW1+1       ; *2
001259  3                       LDA     PTEMPW1
001259  3                       STA     PTEMPW2
001259  3                       LDA     PTEMPW1+1
001259  3                       STA     PTEMPW2+1       ; STORE Y*2 INTO PTEMPW2
001259  3                       ASL     PTEMPW1
001259  3                       ROL     PTEMPW1+1       ; *2 (*4)
001259  3                       LDA     PTEMPW1
001259  3                       STA     PTEMPW3
001259  3                       LDA     PTEMPW1+1
001259  3                       STA     PTEMPW3+1       ; STORE Y*4 INTO PTEMPW3
001259  3                       ASL     PTEMPW1
001259  3                       ROL     PTEMPW1+1       ; *2 (*8)
001259  3                       ASL     PTEMPW1
001259  3                       ROL     PTEMPW1+1       ; *2 (*16)
001259  3                       ASL     PTEMPW1
001259  3                       ROL     PTEMPW1+1       ; *2 (*32)
001259  3                       ASL     PTEMPW1
001259  3                       ROL     PTEMPW1+1       ; *2 (*64)
001259  3                                               ; RESULT OFFSET PTEMPW1 = PTEMPW1(Y*64)+PTEMPW2(Y*2)+PTEMPW3(Y*4)
001259  3                       CLC                     ; Clear the Carry flag before the first addition
001259  3                       LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
001259  3                       ADC     PTEMPW2         ; Add the low byte of the second number (plus carry)
001259  3                       STA     PTEMPW1         ; Store the low byte of the result
001259  3               
001259  3                       LDA     PTEMPW1+1       ; Load the high byte of the first number
001259  3                       ADC     PTEMPW2+1       ; Add the high byte of the second number (plus carry from previous op)
001259  3                       STA     PTEMPW1+1       ; Store the high byte of the result
001259  3                       CLC                     ; Clear the Carry flag before the first addition
001259  3                       LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
001259  3                       ADC     PTEMPW3         ; Add the low byte of the second number (plus carry)
001259  3                       STA     PTEMPW1         ; Store the low byte of the result
001259  3               
001259  3                       LDA     PTEMPW1+1       ; Load the high byte of the first number
001259  3                       ADC     PTEMPW3+1       ; Add the high byte of the second number (plus carry from previous op)
001259  3                       STA     PTEMPW1+1       ; Store the high byte of the result
001259  3               
001259  3               ; if double hires double it.
001259  3                       LDA     VIDEOMODE
001259  3                       AND     #$10
001259  3                       CMP     #00
001259  3                       BEQ     :+
001259  3                       ASL     PTEMPW1
001259  3                       ROL     PTEMPW1+1       ; *2 (*4)
001259  3               :
001259  3                                               ; PTEMPW1 IS NOW Y OFFSET, ADD X OFFSET FOR MEMORY ADDRESS INTO TEMPW
001259  3                       CLC                     ; Clear the Carry flag before the first addition
001259  3                       LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
001259  3                       ADC     PTEMPW          ; Add the low byte of the second number (plus carry)
001259  3                       STA     TEMPW           ; Store the low byte of the result
001259  3               
001259  3                       LDA     PTEMPW1+1        ; Load the high byte of the first number
001259  3                       ADC     PTEMPW+1        ; Add the high byte of the second number (plus carry from previous op)
001259  3                       STA     TEMPW+1         ; Store the high byte of the result
001259  3               
001259  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001259  3                       JSR     LAB_GTBY        ; GET THE THIRD PARAMETER, RETURN IN X (PATTERN)
001259  3                       TXA
001259  3                       AND     #$0F
001259  3                       STA     PTEMP          ; SAVE COLOR IN TEMP
001259  3                       LDA     TEMPW           ; OK, LET'S CALCULATE THE BANK
001259  3                       AND     #$F0
001259  3                       LSR     A
001259  3                       LSR     A
001259  3                       LSR     A
001259  3                       LSR     A
001259  3                       CLC
001259  3                       ADC     #$02+VIDEOBANK  ; AREA $2000-?
001259  3                       TAY                     ; VIDEO BANK SHOULD BE IN Y
001259  3                       JSR     PAGE_ENTER
001259  3                       LDA     TEMPW+1
001259  3                       AND     #$0F
001259  3                       ORA     #$B0
001259  3                       STA     TEMPW+1         ; TEMPW NOW REFLECTS MAPPED ADDRESSS
001259  3                       PLA
001259  3                       LSR     A               ; LEFT OR RIGHT PIXEL?
001259  3                       BCC     :+
001259  3                                               ; LEFT PIXEL
001259  3                       LDY     #$00
001259  3                       LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
001259  3                       AND     #$0F
001259  3                       PHA
001259  3                       LDA     PTEMP
001259  3                       ASL     A
001259  3                       ASL     A
001259  3                       ASL     A
001259  3                       ASL     A
001259  3                       STA     PTEMP
001259  3                       PLA
001259  3                       ORA     PTEMP
001259  3                       STA     (TEMPW),Y       ; WRITE THE PIXEL BACK OUT
001259  3                       JSR     PAGE_EXIT
001259  3                       RTS
001259  3               :
001259  3               ; RIGHT PIXEL
001259  3                       LDY     #$00
001259  3                       LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
001259  3                       AND     #$F0
001259  3                       ORA     PTEMP
001259  3                       STA     (TEMPW),Y       ; WRITE THE PIXEL BACK OUT
001259  3                       JSR     PAGE_EXIT
001259  3                       RTS
001259  3               
001259  3               V_PLOT_HIRES_MONO:
001259  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X
001259  3                       TXA
001259  3                       PHA
001259  3                       LSR     A               ; 8 PIXEL PER BYTE
001259  3                       LSR     A
001259  3                       LSR     A
001259  3               
001259  3                       STA     PTEMPW         ; STORE X COORD IN OFFSET ADDRESS
001259  3                       LDA     #00
001259  3                       STA     PTEMPW+1
001259  3                       STA     PTEMPW1+1
001259  3                       STA     PTEMPW3+1
001259  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001259  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
001259  3                                               ; FIGURE THE BUFFER OFFSET
001259  3                       TXA                     ; GET Y COORD
001259  3                       STX     PTEMPW1
001259  3                       STX     PTEMPW3
001259  3                                               ; MULTIPLY Y COORD BY 35 OR 70 (MONO OR QUAD HIRES)
001259  3                       ASL     PTEMPW1
001259  3                       ROL     PTEMPW1+1       ; *2
001259  3                       LDA     PTEMPW1
001259  3                       STA     PTEMPW2
001259  3                       LDA     PTEMPW1+1
001259  3                       STA     PTEMPW2+1       ; STORE *2 INTO PTEMPW2
001259  3                       ASL     PTEMPW1
001259  3                       ROL     PTEMPW1+1       ; *2 (*4)
001259  3                       ASL     PTEMPW1
001259  3                       ROL     PTEMPW1+1       ; *2 (*8)
001259  3                       ASL     PTEMPW1
001259  3                       ROL     PTEMPW1+1       ; *2 (*16)
001259  3                       ASL     PTEMPW1
001259  3                       ROL     PTEMPW1+1       ; *2 (*32)
001259  3                                               ;
001259  3                                               ; PTEMPW1(Y*35) = PTEMPW1(Y*32)+PTEMPW2(Y*2)+PTEMPW3(Y)
001259  3                       CLC                     ; Clear the Carry flag before the first addition
001259  3                       LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
001259  3                       ADC     PTEMPW2         ; Add the low byte of the second number (plus carry)
001259  3                       STA     PTEMPW1         ; Store the low byte of the result
001259  3               
001259  3                       LDA     PTEMPW1+1       ; Load the high byte of the first number
001259  3                       ADC     PTEMPW2+1       ; Add the high byte of the second number (plus carry from previous op)
001259  3                       STA     PTEMPW1+1       ; Store the high byte of the result
001259  3                       CLC                     ; Clear the Carry flag before the first addition
001259  3                       LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
001259  3                       ADC     PTEMPW3         ; Add the low byte of the second number (plus carry)
001259  3                       STA     PTEMPW1         ; Store the low byte of the result
001259  3               
001259  3                       LDA     PTEMPW1+1       ; Load the high byte of the first number
001259  3                       ADC     PTEMPW3+1       ; Add the high byte of the second number (plus carry from previous op)
001259  3                       STA     PTEMPW1+1       ; Store the high byte of the result
001259  3                                               ;
001259  3                                               ; PTEMPW1 IS NOW THE Y OFFSET
001259  3                                               ; if quad hires double it.
001259  3                       LDA     VIDEOMODE
001259  3                       AND     #$10
001259  3                       CMP     #00
001259  3                       BNE     :+
001259  3                       ASL     PTEMPW1
001259  3                       ROL     PTEMPW1+1       ; *2
001259  3               :
001259  3                                               ; ADD THE X OFFSET
001259  3                       CLC                     ; Clear the Carry flag before the first addition
001259  3                       LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
001259  3                       ADC     PTEMPW          ; Add the low byte of the second number (plus carry)
001259  3                       STA     TEMPW           ; Store the low byte of the result
001259  3               
001259  3                       LDA     PTEMPW1+1       ; Load the high byte of the first number
001259  3                       ADC     PTEMPW+1        ; Add the high byte of the second number (plus carry from previous op)
001259  3                       STA     TEMPW+1         ; Store the high byte of the result
001259  3                                               ; TEMPW IS NOW THE MEMORY ADDRESS
001259  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001259  3                       JSR     LAB_GTBY        ; GET THE THIRD PARAMETER, RETURN IN X (PATTERN)
001259  3                       LDA     TEMPW           ; OK, LET'S CALCULATE THE BANK
001259  3                       AND     #$F0
001259  3                       LSR     A
001259  3                       LSR     A
001259  3                       LSR     A
001259  3                       LSR     A
001259  3                       CLC
001259  3                       ADC     #$02+VIDEOBANK  ; AREA $2000-?
001259  3                       TAY                     ; VIDEO BANK SHOULD BE IN Y
001259  3                       JSR     PAGE_ENTER
001259  3                       LDA     TEMPW+1
001259  3                       AND     #$0F
001259  3                       ORA     #$B0
001259  3                       STA     TEMPW+1         ; TEMPW NOW REFLECTS MAPPED ADDRESSS
001259  3                       TXA
001259  3                       AND     #$01
001259  3                       STA     PTEMP          ; SAVE COLOR IN TEMP
001259  3                       PLA
001259  3                       AND     #$07            ; WHICH BIT?
001259  3                       TAX
001259  3                       LDA     PTEMP
001259  3                       CMP     #$01
001259  3                       BNE     :+
001259  3                       LDA     HIRES_BIT_LOOKUP_SET,X
001259  3                       LDY     #$00
001259  3                       ORA     (TEMPW),Y
001259  3                       STA     (TEMPW),Y
001259  3                       JSR     PAGE_EXIT
001259  3                       RTS
001259  3               :
001259  3                       LDA     HIRES_BIT_LOOKUP_RESET,X
001259  3                       PHA
001259  3                       LDY     #$00
001259  3                       AND     (TEMPW),Y
001259  3                       STA     (TEMPW),Y
001259  3                       JSR     PAGE_EXIT
001259  3                       RTS
001259  3               HIRES_BIT_LOOKUP_SET:
001259  3                       .BYTE   %10000000,%01000000,%00100000,%00010000,%00001000,%00000100,%00000010,%00000001
001259  3               HIRES_BIT_LOOKUP_RESET:
001259  3                       .BYTE   %01111111,%10111111,%11011111,%11101111,%11110111,%11111011,%11111101,%11111110
001259  3               
001259  3               ;___V_PATTERN________________________________________________
001259  3               ;
001259  3               ;  DEFINE GRAPHICS PATTERN
001259  3               ;
001259  3               ;  TAKES 10 PARAMETERS
001259  3               ;       PATTERN NUM (0-255)
001259  3               ;       PATTERN DATA (8 BYTES)
001259  3               ;__________________________________________________________
001259  3               LAB_PATTERN
001259  3               V_PATTERN:
001259  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X
001259  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001259  3                       JSR     PAGE_ENTER
001259  3                       TXA
001259  3                       STA     VideoCharGenOffset
001259  3                       LDY     #8
001259  3               :
001259  3                       TYA
001259  3                       PHA
001259  3                       JSR     LAB_1C01        ; GET THE NEXT PARAMETER (AFTER ',') OR SYN ERR
001259  3                       JSR     LAB_GTBY        ; GET THE NEXT PARAMETER, RETURN IN X
001259  3                       PLA
001259  3                       TAY
001259  3                       TXA
001259  3                       STA     VideoCharGenData
001259  3                       DEY
001259  3                       CPY     #$00
001259  3                       BNE     :-
001259  3                       JSR     PAGE_EXIT
001259  3                       RTS
001259  3               
001259  3               
001259  3               
001259  3                       .ELSE
001259  3               
001259  3               
001259  3               ; ENSURE ALL OF THESE SPECIAL COMMANDS GIVE ERRORS IN NORMAL BASIC
001259  3               LAB_SPEEK:
001259  3               LAB_SPOKE:
001259  3               LAB_SCRCLR:
001259  3               LAB_SCREEN:
001259  3               LAB_PATTERN:
001259  3               LAB_PLOT:
001259  3  A2 02                LDX     #$02            ; error code $02 ("SYNTAX" error)
00125B  3  4C 41 14             JMP     LAB_XERR        ; do error #X, then warm start
00125E  3               
00125E  3                       .ENDIF
00125E  3               
00125E  2                       .INCLUDE "sid.asm"
00125E  3               
00125E  3               
00125E  2                       .INCLUDE "rtc.asm"
00125E  3               
00125E  3               
00125E  2               
00125E  1               
00125E  1               ; This start can be changed to suit your system (TEA START)
00125E  1               
00125E  1               BASICBEGIN:
00125E  1  AD 04 01             LDA     $0104
001261  1  8D 5D 10             STA     PEMVEC
001264  1  AD 05 01             LDA     $0105
001267  1  8D 5E 10             STA     PEMVEC+1
00126A  1               
00126A  1               
00126A  1               LAB_COLD:
00126A  1  A0 04                LDY     #PG2_TABE-PG2_TABS-1
00126C  1               ; byte count-1
00126C  1               LAB_2D13:
00126C  1  B9 33 08             LDA     PG2_TABS,Y      ; get byte
00126F  1  99 00 06             STA     ccflag,Y        ; store in page 2
001272  1  88                   DEY                     ; decrement count
001273  1  10 F7                BPL     LAB_2D13        ; loop if not done
001275  1               
001275  1  A2 FF                LDX     #$FF            ; set byte
001277  1  86 88                STX     Clineh          ; set current line high byte (set immediate mode)
001279  1               
001279  1  A9 4C                LDA     #$4C            ; code for JMP
00127B  1  85 A1                STA     Fnxjmp          ; save for jump vector for functions
00127D  1               
00127D  1               ; copy block from LAB_2CEE to $00BC - $00D3
00127D  1               
00127D  1  A0 1D                LDY     #StrTab-LAB_2CEE; set byte count
00127F  1               LAB_2D4E:
00127F  1  BE 02 08             LDX     LAB_2CEE-1,Y    ; get byte from table
001282  1  96 BB                STX     LAB_IGBY-1,Y    ; save byte in page zero
001284  1  88                   DEY                     ; decrement count
001285  1  D0 F8                BNE     LAB_2D4E        ; loop if not all done
001287  1               
001287  1               ; copy block from StrTab to $0000 - $0012
001287  1               
001287  1               LAB_GMEM:
001287  1  A0 12                LDY     #EndTab-StrTab-1; set byte count-1
001289  1               TabLoop:
