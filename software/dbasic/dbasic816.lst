001246  3  A9 EA                LDA     #<FCBBUFFER     ; SETUP BUFFER
001248  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
00124A  3  A0 3F                LDY     #>FCBBUFFER     ;
00124C  3  84 21                STY     FCBPTR+1        ; STORE DEST BUFFER IN FCBPTR
00124E  3  A2 1A                LDX     #26             ; Setup Buffer
001250  3  20 4E 11             JSR     PEM             ;
001253  3  4C 91 12             JMP     DOS65LOAD_3C
