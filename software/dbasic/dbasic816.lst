001262  3               DOS65LOAD_1:
001262  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
001264  3  85 22                STA     FCBPTR+2        ; point to base of RAM
001266  3  8D 66 13             STA     EndOfBas        ;
001269  3  A5 7A                LDA     <Smemh          ;
00126B  3  85 23                STA     FCBPTR+3        ;
00126D  3  8D 67 13             STA     EndOfBas+1      ;
001270  3  A9 BB                LDA     #<FCBBUFFER     ; SETUP BUFFER
001272  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
001274  3  A0 3F                LDY     #>FCBBUFFER     ;
001276  3  84 21                STY     FCBPTR+1        ; STORE DEST BUFFER IN FCBPTR
001278  3  A2 1A                LDX     #26             ; Setup Buffer
00127A  3  20 78 11             JSR     PEM             ;
00127D  3  4C BB 12             JMP     DOS65LOAD_3C
001280  3               DOS65LOAD_3:
001280  3  B1 20                LDA     (FCBPTR),Y      ; load from BUFFER
001282  3  91 22                STA     (FCBPTR+2),Y    ; save to RAM
001284  3  EE 66 13             INC     EndOfBas
001287  3  D0 03                BNE     :+
001289  3  EE 67 13             INC     EndOfBas+1
00128C  3               :
00128C  3  C9 00                CMP     #$00
00128E  3  D0 0D                BNE     :+
001290  3  EE 68 13             INC     NullCounter
001293  3  AD 68 13             LDA     NullCounter
001296  3  C9 03                CMP     #3
001298  3  D0 08                BNE     :++
00129A  3  4C CE 12             JMP     DOS65LOAD_4
00129D  3               :
00129D  3  A9 00                LDA     #$00
00129F  3  8D 68 13             STA     NullCounter
0012A2  3               :
0012A2  3  C8                   INY                     ; bump index
0012A3  3  C0 80                CPY     #$80            ; end of buffer?
0012A5  3  D0 D9                BNE     DOS65LOAD_3     ; no, loop
0012A7  3  18                   CLC                     ;
0012A8  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
0012AA  3  69 80                ADC     #$80            ;
0012AC  3  85 22                STA     FCBPTR+2        ;
0012AE  3  90 0B                BCC     DOS65LOAD_3C    ; is carry?, no SKIP
0012B0  3  18                   CLC                     ; yes, carry, inc high byte
0012B1  3  A5 23                LDA     FCBPTR+3        ;
0012B3  3  69 01                ADC     #$01            ;
0012B5  3  85 23                STA     FCBPTR+3        ;
0012B7  3  C9 D0                CMP     #>Ram_top       ; are we at the end of RAM?
0012B9  3  F0 13                BEQ     DOS65LOAD_4
0012BB  3               
0012BB  3               DOS65LOAD_3C:
0012BB  3  A9 40                LDA     #<FCB           ; READ record buffer from disk file
0012BD  3  A0 16                LDY     #>FCB           ;
0012BF  3  A2 14                LDX     #20             ;
0012C1  3  20 78 11             JSR     PEM             ;
0012C4  3  A0 00                LDY     #$00            ; RESET INDEX
0012C6  3  C9 00                CMP     #$00            ; is error or EOF
0012C8  3  F0 B6                BEQ     DOS65LOAD_3     ;
0012CA  3  C9 01                CMP     #$01            ; EOF?
0012CC  3  D0 88                BNE     DOS65LOAD_ERR   ; ERROR, do error handling
0012CE  3               DOS65LOAD_4:
0012CE  3  A9 40                LDA     #<FCB           ;
0012D0  3  A0 16                LDY     #>FCB           ;
0012D2  3  A2 10                LDX     #16             ;
0012D4  3  20 78 11             JSR     PEM             ;
