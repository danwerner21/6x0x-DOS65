0011A7  3                       .ENDIF
0011A7  3               
0011A7  3  C9 3A                CMP     #':'            ;
0011A9  3  F0 0E                BEQ     DOS65FCBPREP_1  ; YES, IT WAS A DRIVE, CONTINUE
0011AB  3  A9 DD                LDA     #<FILEERROR1    ; NO, ERROR OUT
0011AD  3  A0 0E                LDY     #>FILEERROR1
0011AF  3  A2 09                LDX     #9
0011B1  3  20 62 10             JSR     PEM
0011B4  3  20 57 1A             JSR     LAB_REM
0011B7  3  38                   SEC
