001138  3               ;___SAVE____________________________________________________
001138  3               ;
001138  3               ; SAVE COMMAND
001138  3               ;
001138  3               ;  SAVE THE BASIC PROGRAM IN MEMORY TO DISK
001138  3               ;
001138  3               ;__________________________________________________________
001138  3               V_SAVE: ; save BASIC program
001138  3               DOS65SAVE:
001138  3  20 AB 12             JSR     DOS65FCBPREP    ; parse parameters into FCB
00113B  3  B0 28                BCS     DOS65SAVE_ERR1  ; Error?, if so abort
00113D  3  A2 0D                LDX     #13             ;
00113F  3  20 32 11             JSR     PEM             ;
001142  3  A9 EB                LDA     #<FCB           ; CREATE File
001144  3  A0 15                LDY     #>FCB           ;
001146  3  A2 16                LDX     #22             ;
001148  3  20 32 11             JSR     PEM             ;
00114B  3  A9 00                LDA     #0              ; clear
00114D  3  8D 0B 16             STA     FCB+32          ; record number
001150  3  A9 EB                LDA     #<FCB           ; Open File
001152  3  A0 15                LDY     #>FCB           ;
001154  3  A2 0F                LDX     #15             ;
001156  3  20 32 11             JSR     PEM             ;
001159  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
00115B  3  D0 0B                BNE     DOS65SAVE_1     ;
00115D  3               DOS65SAVE_ERR:
00115D  3  A2 24                LDX     #$24            ; IO ERROR
00115F  3  20 CB 18             JSR     LAB_XERR
001162  3  4C A7 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001165  3               DOS65SAVE_ERR1:
001165  3  4C DC 1E             JMP     LAB_REM         ; comment out the remainder of the line (if any)
001168  3               DOS65SAVE_1:
001168  3  A9 66                LDA     #<FCBBUFFER     ; SETUP BUFFER
00116A  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
00116C  3  A0 3F                LDY     #>FCBBUFFER     ;
00116E  3  84 21                STY     FCBPTR+1        ;
001170  3  A2 1A                LDX     #26             ; Setup Buffer
001172  3  20 32 11             JSR     PEM             ;
001175  3               DOS65SAVE_2:
001175  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
001177  3  85 22                STA     FCBPTR+2        ; point to base of RAM
001179  3  A5 7A                LDA     <Smemh          ;
00117B  3  85 23                STA     FCBPTR+3        ;
00117D  3  A2 00                LDX     #$00            ; x=0 (null counter)
00117F  3               DOS65SAVE_2A:
00117F  3  A0 00                LDY     #$00            ; y=0 (Loop Index)
001181  3               DOS65SAVE_3:
001181  3  B1 22                LDA     (FCBPTR+2),Y    ; load from RAM
001183  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
001185  3  C9 00                CMP     #$00            ; is Zero?
001187  3  D0 1E                BNE     DOS65SAVE_3A    ; No, continue
001189  3  E8                   INX                     ; yes, bump Null Counter
00118A  3  E0 03                CPX     #$03            ; Three nulls in a row?
00118C  3  D0 1B                BNE     DOS65SAVE_3B    ; No, continue
00118E  3                                               ; FINISH FILLING BUFFER WITH NULLS
00118E  3               :
00118E  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
001190  3  C8                   INY                     ; bump index
001191  3  C0 80                CPY     #$80            ; end of buffer?
001193  3  D0 F9                BNE     :-              ; no, loop
001195  3  A9 EB                LDA     #<FCB           ; Write record in buffer to disk file AND END
001197  3  A0 15                LDY     #>FCB           ;
001199  3  A2 15                LDX     #21             ;
00119B  3  20 32 11             JSR     PEM             ;
00119E  3  29 FE                AND     #$FE            ; strip out extension
0011A0  3  C9 00                CMP     #$00            ; is error
0011A2  3  D0 B9                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
0011A4  3  4C D4 11             JMP     DOS65SAVE_4
0011A7  3               DOS65SAVE_3A:                   ;
0011A7  3  A2 00                LDX     #$00            ; prior char not null, reset null counter
0011A9  3               DOS65SAVE_3B:                   ;
0011A9  3  C8                   INY                     ; bump index
0011AA  3  C0 80                CPY     #$80            ; end of buffer?
0011AC  3  D0 D3                BNE     DOS65SAVE_3     ; no, loop
0011AE  3               DOS65SAVE_3C:
0011AE  3  A9 EB                LDA     #<FCB           ; Write record in buffer to disk file
0011B0  3  A0 15                LDY     #>FCB           ;
0011B2  3  A2 15                LDX     #21             ;
0011B4  3  20 32 11             JSR     PEM             ;
0011B7  3  29 FE                AND     #$FE            ; strip out extension
0011B9  3  C9 00                CMP     #$00            ; is error
0011BB  3  D0 A0                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
0011BD  3  18                   CLC                     ;
0011BE  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
0011C0  3  69 80                ADC     #$80            ;
0011C2  3  85 22                STA     FCBPTR+2        ;
0011C4  3  90 B9                BCC     DOS65SAVE_2A    ; is carry?, no loop
0011C6  3  18                   CLC                     ; yes, carry, inc high byte
0011C7  3  A5 23                LDA     FCBPTR+3        ;
0011C9  3  69 01                ADC     #$01            ;
0011CB  3  85 23                STA     FCBPTR+3        ;
0011CD  3  C9 D0                CMP     #>Ram_top       ; are we at the end of RAM?
0011CF  3  F0 03                BEQ     DOS65SAVE_4
0011D1  3  4C 7F 11             JMP     DOS65SAVE_2A
0011D4  3               DOS65SAVE_4:
0011D4  3  A9 EB                LDA     #<FCB           ;
0011D6  3  A0 15                LDY     #>FCB           ;
0011D8  3  A2 10                LDX     #16             ;
0011DA  3  20 32 11             JSR     PEM             ;
0011DD  3  C9 FF                CMP     #$FF            ;
0011DF  3  D0 03                BNE     DOS65SAVE_5     ;
0011E1  3  4C 5D 11             JMP     DOS65SAVE_ERR   ; ERROR, DISPLAY IT
0011E4  3               DOS65SAVE_5:
0011E4  3  A9 5D                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
0011E6  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
0011E8  3  20 6D 21             JSR     LAB_18C3
0011EB  3  4C A7 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
