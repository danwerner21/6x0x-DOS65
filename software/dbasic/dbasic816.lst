0012E5  3  85 7E                STA     Sarryh
0012E7  3  85 80                STA     Earryh
0012E9  3  A9 53                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
0012EB  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
0012ED  3  20 C2 21             JSR     LAB_18C3
0012F0  3  4C FC 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
