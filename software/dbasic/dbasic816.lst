00112A  2               
00112A  2               
00112A  2               PRINT_BYTE:
00112A  2  8E 63 11             STX     TTX
00112D  2  8C 64 11             STY     TTY
001130  2  8D 65 11             STA     TTA
001133  2  8E 62 11             STX     SAVX            ; save X
001136  2  20 4D 11             JSR     ASCTWO          ; get hex chars for byte in X (lower) and A (upper)
001139  2  20 66 11             JSR     WRSER1          ; output upper nybble
00113C  2  8A                   TXA                     ; transfer lower to A
00113D  2  AE 62 11             LDX     SAVX            ; restore X
001140  2  20 66 11             JSR     WRSER1          ; output lower nybble
001143  2  AE 63 11             LDX     TTX
001146  2  AC 64 11             LDY     TTY
001149  2  AD 65 11             LDA     TTA
00114C  2  60                   RTS
00114D  2               ASCTWO:
00114D  2  48                   PHA                     ; save byte
00114E  2  20 57 11             JSR     ASCII           ; do low nybble
001151  2  AA                   TAX                     ; save in X
001152  2  68                   PLA                     ; restore byte
001153  2  4A                   LSR     A               ; shift upper nybble down
001154  2  4A                   LSR     A
001155  2  4A                   LSR     A
001156  2  4A                   LSR     A
001157  2               ; convert low nybble in A to hex digit
001157  2               ASCII:
001157  2  29 0F                AND     #$0F            ; clear upper nibble
001159  2  C9 0A                CMP     #$0A            ; if less than A, skip next step
00115B  2  90 02                BCC     ASC1
00115D  2  69 06                ADC     #6              ; skip ascii chars between 9 and A
00115F  2               ASC1:
00115F  2  69 30                ADC     #$30            ; add ascii char 0 to value
001161  2  60                   RTS
