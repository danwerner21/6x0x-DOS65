00140B  3  8A                   TXA
00140C  3  8D 40 16             STA     FCB             ; STORE DRIVE IN FCB
00140F  3                                               ;
00140F  3  20 6E 25             JSR     LAB_1C01        ; (AFTER ',') OR SYN ERR
001412  3  20 FC 30             JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X (MODE)
001415  3                                               ;
001415  3  E0 00                CPX     #0
001417  3  D0 08                BNE     :+
001419  3  A9 0F                LDA     #15
00141B  3  8D CF 14             STA     OPNTMP
00141E  3  4C 26 14             JMP     V_OPEN1
001421  3               :
001421  3  A9 16                LDA     #22
001423  3  8D CF 14             STA     OPNTMP          ;
