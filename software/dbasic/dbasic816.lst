0013F0  3               ;
0013F0  3               ; OPEN A FILE
0013F0  3               ;
0013F0  3               ;
0013F0  3               ; BASIC COMMAND EXPECTS FOUR VARS
0013F0  3               
0013F0  3               ; DRIVE,MODE, FILENAME$,FILE$
0013F0  3               ;
0013F0  3               ; FILE$ = STRING TO HOLD 33 BYTE FCB
0013F0  3               ; DRIVE = NUMERIC DRIVE -- 0=A, 1=B, 2= . . .
0013F0  3               ; MODE = 0=EXISTING, 1=CREATE
0013F0  3               ; FILENAME$ = FILENAME STRING
0013F0  3               ;__________________________________________________________
0013F0  3               V_OPEN:
0013F0  3               ; CLEAR FCB
