0017E6  3                       .IFDEF  MEMORYMAPPEDSCREEN
0017E6  3               
0017E6  3               ;* MEMORY MAP
0017E6  3               ;  VIDEO CARD IS A 32K AREA (MAPPED IN BANKS TO $AXXX)
0017E6  3               ;  $0x00 0x01=soft_scanline_emulation, 0x02 NO soft_scanline_emulation
0017E6  3               ;  $0x01 0x01=page1, 0x02 page2
0017E6  3               ;  $0x02  character generator write offset (data << 3)
0017E6  3               ;  $0x03 character generator write DATA
0017E6  3               ;  $0x04 EXECUTE device command
0017E6  3               ;        0x00- reset to the default configuration
0017E6  3               ;        0x01- reset to the saved configuration
0017E6  3               ;	0x02- save the current configuration
0017E6  3               ;
0017E6  3               ;  $0x05  0x01=soft_text=true, 0x02=soft_text=false
0017E6  3               ;  $0x06 Lores Mode=0X01,NO lores Mode=0x02
0017E6  3               ;  $0x07 Double Lores Mode=0X01,NO Double lores Mode=0x02
0017E6  3               ;  $0x08 Hires Mode=0X01,NO Hires Mode=0x02
0017E6  3               ;  $0x09 Double Hires Mode=0X01,NO Double Hires lores Mode=0x02
0017E6  3               ;  $0x0A 80COL Mode=0X01,NO 80COL Mode=0x02
0017E6  3               ;  $0x0B MIXED Mode=0X01,NO MIXED Mode=0x02
0017E6  3               ;  $0x0C QUAD Hires Mode=0X01,NO QUAD Hires lores Mode=0x02
0017E6  3               ;  $0x0D MONO Hires Mode=0X01,NO MONO Hires lores Mode=0x02
0017E6  3               ;
0017E6  3               ; 	VRAM Memory Map
0017E6  3               ;	$1000-$177F	40/80 Text Page 1
0017E6  3               ;	$1800-$1F7F	40/80 Color Page 1
0017E6  3               ;	$2000-$277F	40/80 Text Page 2
0017E6  3               ;	$2800-$2F7F	40/80 Color Page 2
0017E6  3               ;	$2000-$5FFF	HIRES PAGE 1
0017E6  3               ;	$6000-$8FFF	HIRES PAGE 2
0017E6  3               ;	$2000-$BFFF	DOUBLE HIRES
0017E6  3               
0017E6  3               VIDEOBANK       = $F8
0017E6  3               PC6502_IOSPACE  = $EF00
0017E6  3               ; PAGER
0017E6  3               PC6502_ACT_TASK = PC6502_IOSPACE+$E0
0017E6  3               PC6502_MAP_SETUP = PC6502_IOSPACE+$E1
0017E6  3               PC6502_MMU_ENA  = PC6502_IOSPACE+$E2
0017E6  3               PC6502_MAP_SPACE = PC6502_IOSPACE+$D0
0017E6  3               
0017E6  3               VideoDisplayPage = $A001
0017E6  3               VideoCharGenOffset = $A002
0017E6  3               VideoCharGenData = $A003
0017E6  3               VideoTextMode   = $A005
0017E6  3               VideoLoresMode  = $A006
0017E6  3               VideoDoubleLores = $A007
0017E6  3               VideoHiresMode  = $A008
0017E6  3               VideoDoubleHires = $A009
0017E6  3               Video80col      = $A00A
0017E6  3               VideoMixedMode  = $A00b
0017E6  3               VideoQuadHires  = $A00c
0017E6  3               VideoMonoHires  = $A00d
0017E6  3               
0017E6  3               CURX            = $0647         ; CURRENT CURSOR POSITION (MEMORY MAPPED)
0017E6  3               CURY            = $0648
0017E6  3               SHOWCRSR        = $0649         ; SHOW CURSOR (1-YES, 0-NO) (MEMORY MAPPED)
0017E6  3               CURCOLOR        = $064A         ; CURRENT PRINT COLOR (MEMORY MAPPED)
0017E6  3               CSRCOLOR        = $064B         ; CURRENT CURSOR COLOR (MEMORY MAPPED)
0017E6  3               BVIDEOMODE      = $064C         ; CURRENT VIDEO MODE (MEMORY MAPPED) 00=40 COL, 01=80 COL
0017E6  3               
0017E6  3               
0017E6  3               VIDEOMODE:
0017E6  3                       .BYTE   $00
0017E6  3               CLRTMP:
0017E6  3                       .BYTE   $00
0017E6  3               VIDEOWIDTH:
0017E6  3                       .BYTE   80
0017E6  3               PLOTX:
0017E6  3                       .BYTE   $00,$00
0017E6  3               PLOTY:
0017E6  3                       .BYTE   $00,$00
0017E6  3               PLOTCOLOR:
0017E6  3                       .BYTE   $00
0017E6  3               LINECOLOR:
0017E6  3                       .BYTE   $00
0017E6  3               LINEX1:
0017E6  3                       .BYTE   $00,$00
0017E6  3               LINEY1:
0017E6  3                       .BYTE   $00,$00
0017E6  3               LINEX2:
0017E6  3                       .BYTE   $00,$00
0017E6  3               LINEY2:
0017E6  3                       .BYTE   $00,$00
