0012BF  3  A9 66                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
0012C1  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
0012C3  3  20 AB 21             JSR     LAB_18C3
0012C6  3  4C D2 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
