0016DC  3               BCD_TO_HEX:
0016DC  3  85 12                STA     nums_2          ; Store in TEMP2
0016DE  3  29 F0                AND     #$F0
0016E0  3  4A                   LSR     A               ; (shift 1 times to /2)
0016E1  3  85 11                STA     nums_1          ; Store the /2 into TEMP
0016E3  3  4A                   LSR     A               ;
0016E4  3  4A                   LSR     A               ; Shift two more times to /8
0016E5  3  18                   CLC
0016E6  3  65 11                ADC     nums_1          ; add /8 + /2 to get /10
0016E8  3  85 11                STA     nums_1          ; Store tens digit into TEMP
0016EA  3  A5 12                LDA     nums_2          ; Get Ones
0016EC  3  29 0F                AND     #$0F
0016EE  3  18                   CLC
0016EF  3  65 11                ADC     nums_1
0016F1  3  60                   RTS                     ; Return from subroutine
0016F2  3               
0016F2  2               
0016F2  1               
0016F2  1               ; This start can be changed to suit your system (TEA START)
0016F2  1               
0016F2  1               BASICBEGIN:
0016F2  1  AD 04 01             LDA     $0104
0016F5  1  8D 37 11             STA     PEMVEC
0016F8  1  AD 05 01             LDA     $0105
0016FB  1  8D 38 11             STA     PEMVEC+1
0016FE  1               
0016FE  1                       .IFDEF  MEMORYMAPPEDSCREEN
0016FE  1                       LDA     #0
0016FE  1                       STA     SHOWCRSR        ; TURN OFF CURSOR
0016FE  1                       LDA     #38
0016FE  1                       STA     farfunct
0016FE  1                       JSR     DO_FARCALL      ; CLEAR SCREEN
0016FE  1                       LDA     #59
0016FE  1                       STA     farfunct
0016FE  1                       JSR     DO_FARCALL      ; UNPAINT CURSOR
0016FE  1                       .ENDIF
0016FE  1               
0016FE  1               LAB_COLD:
0016FE  1  A0 04                LDY     #PG2_TABE-PG2_TABS-1
001700  1               ; byte count-1
001700  1               LAB_2D13:
001700  1  B9 33 08             LDA     PG2_TABS,Y      ; get byte
001703  1  99 00 06             STA     ccflag,Y        ; store in page 2
001706  1  88                   DEY                     ; decrement count
001707  1  10 F7                BPL     LAB_2D13        ; loop if not done
001709  1               
001709  1  A2 FF                LDX     #$FF            ; set byte
00170B  1  86 88                STX     Clineh          ; set current line high byte (set immediate mode)
