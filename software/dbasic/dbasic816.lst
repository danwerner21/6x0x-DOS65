003EEE  1               
003EEE  1  E0 10                CPX     #$10            ; else make min width = 16d
003EF0  1  90 46                BCC     TabErr          ; if less do function call error and exit
003EF2  1               
003EF2  1               ; this next compare ensures that we can't exit WIDTH via an error leaving the
003EF2  1               ; tab size greater than the line length.
003EF2  1               
003EF2  1  E4 64                CPX     TabSiz          ; compare with tab size
003EF4  1  B0 02                BCS     LAB_NSTT        ; branch if >= tab size
003EF6  1               
003EF6  1  86 64                STX     TabSiz          ; else make tab size = terminal width
003EF8  1               LAB_NSTT:
003EF8  1  86 0F                STX     TWidth          ; set the terminal width
003EFA  1                       .IFDEF  DUODYNE
003EFA  1  22 C2 00 00          JSL     LAB_GBYT        ; scan memory
003EFE  1                       .ELSE
003EFE  1                       JSR     LAB_GBYT        ; scan memory
003EFE  1                       .ENDIF
003EFE  1               
003EFE  1  F0 1A                BEQ     WExit           ; exit if no following
003F00  1               
003F00  1  C9 2C                CMP     #','            ; else is it ","
003F02  1  D0 A6                BNE     LAB_MMSE        ; if not do syntax error
003F04  1               
003F04  1               LAB_TBSZ:
003F04  1  20 E1 30             JSR     LAB_SGBY        ; scan and get byte parameter
003F07  1  8A                   TXA                     ; copy TAB size
003F08  1  30 2E                BMI     TabErr          ; if >127 do function call error and exit
003F0A  1               
003F0A  1  E0 01                CPX     #$01            ; compare with min-1
003F0C  1  90 2A                BCC     TabErr          ; if <=1 do function call error and exit
003F0E  1               
003F0E  1  A5 0F                LDA     TWidth          ; set flags for width
003F10  1  F0 06                BEQ     LAB_SVTB        ; skip check if infinite line
003F12  1               
003F12  1  E4 0F                CPX     TWidth          ; compare TAB with width
003F14  1  F0 02                BEQ     LAB_SVTB        ; ok if =
003F16  1               
003F16  1  B0 20                BCS     TabErr          ; branch if too big
003F18  1               
003F18  1               LAB_SVTB:
003F18  1  86 64                STX     TabSiz          ; save TAB size
003F1A  1               
003F1A  1               ; calculate tab column limit from TAB size. The Iclim is set to the last tab
003F1A  1               ; position on a line that still has at least one whole tab width between it
003F1A  1               ; and the end of the line.
003F1A  1               
003F1A  1               WExit:
003F1A  1  A5 0F                LDA     TWidth          ; get width
003F1C  1  F0 06                BEQ     LAB_SULP        ; branch if infinite line
003F1E  1               
003F1E  1  C5 64                CMP     TabSiz          ; compare with tab size
003F20  1  B0 03                BCS     LAB_WDLP        ; branch if >= tab size
003F22  1               
003F22  1  85 64                STA     TabSiz          ; else make tab size = terminal width
003F24  1               LAB_SULP:
003F24  1  38                   SEC                     ; set carry for subtract
003F25  1               LAB_WDLP:
003F25  1  E5 64                SBC     TabSiz          ; subtract tab size
003F27  1  B0 FC                BCS     LAB_WDLP        ; loop while no borrow
003F29  1               
003F29  1  65 64                ADC     TabSiz          ; add tab size back
003F2B  1  18                   CLC                     ; clear carry for add
003F2C  1  65 64                ADC     TabSiz          ; add tab size back again
003F2E  1  85 10                STA     Iclim           ; save for now
003F30  1  A5 0F                LDA     TWidth          ; get width back
003F32  1  38                   SEC                     ; set carry for subtract
003F33  1  E5 10                SBC     Iclim           ; subtract remainder
003F35  1  85 10                STA     Iclim           ; save tab column limit
003F37  1               LAB_NOSQ:
003F37  1  60                   RTS
003F38  1               
003F38  1               TabErr:
003F38  1  4C C0 28             JMP     LAB_FCER        ; do function call error then warm start
003F3B  1               
003F3B  1               ; perform SQR()
003F3B  1               
003F3B  1               LAB_SQR:
003F3B  1  A5 B0                LDA     FAC1_s          ; get FAC1 sign
003F3D  1  30 F9                BMI     TabErr          ; if -ve do function call error
003F3F  1               
003F3F  1  A5 AC                LDA     FAC1_e          ; get exponent
003F41  1  F0 F4                BEQ     LAB_NOSQ        ; if zero just return
003F43  1               
003F43  1               ; else do root
003F43  1  20 CB 36             JSR     LAB_27AB        ; round and copy FAC1 to FAC2
003F46  1  A9 00                LDA     #$00            ; clear A
003F48  1               
003F48  1  85 77                STA     FACt_3          ; clear remainder
003F4A  1  85 76                STA     FACt_2          ; ..
003F4C  1  85 75                STA     FACt_1          ; ..
003F4E  1  85 78                STA     TempB           ; ..
003F50  1               
003F50  1  85 AF                STA     FAC1_3          ; clear root
003F52  1  85 AE                STA     FAC1_2          ; ..
003F54  1  85 AD                STA     FAC1_1          ; ..
003F56  1               
