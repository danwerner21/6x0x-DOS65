0012E7  3  A9 A4                LDA     #<FCB           ; SETUP FCBPTR
0012E9  3  85 20                STA     FCBPTR          ;
0012EB  3  A9 17                LDA     #>FCB           ;
0012ED  3  85 21                STA     FCBPTR+1        ;
0012EF  3  A0 01                LDY     #$01            ; POINT Y TO FCB FILE NAME
0012F1  3  A9 20                LDA     #$20            ; LOAD SPACE CHAR INTO A
0012F3  3               DOS65FCBPREP_1A:                ; BLANK OUT FCB
0012F3  3  8B DA 48 A2          STAINDIRECTY FCBPTR     ;
0012F7  3  01 B5 20 C9  
0012FB  3  00 D0 04 A2  
001309  3  C8                   INY                     ;
