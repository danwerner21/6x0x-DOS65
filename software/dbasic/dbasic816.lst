00145C  3  20 4E 11             JSR     PEM             ;
00145F  3  AE A5 14             LDX     OPNTMP          ; OPEN OR CREATE
001462  3  A9 16                LDA     #<FCB           ; FCB
001464  3  A0 16                LDY     #>FCB           ; FCB
001466  3  20 4E 11             JSR     PEM
001469  3  C9 FF                CMP     #$FF
00146B  3  D0 08                BNE     :+
00146D  3  A2 24                LDX     #$24            ; IO ERROR
00146F  3  20 F6 18             JSR     LAB_XERR
001472  3  4C D2 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001475  3               :
001475  3  20 57 25             JSR     LAB_1C01        ; (AFTER ',') OR SYN ERR
001478  3  20 32 27             JSR     LAB_GVAR        ; GET THE FOURTH PARAMETER
00147B  3  85 97                STA     Lvarpl          ; save var address low byte
00147D  3  84 98                STY     Lvarph          ; save var address high byte
00147F  3  A5 5F                LDA     <Dtypef         ; IS IT A STRING?
001481  3  D0 08                BNE     :+              ; YES, CONTINUE ON
001483  3  A2 02                LDX     #$02            ; NOPE, SYNTAX ERROR
001485  3  20 F6 18             JSR     LAB_XERR
001488  3  4C D2 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
00148B  3               :
00148B  3  A9 22                LDA     #34
00148D  3  20 71 2B             JSR     LAB_MSSP        ; make string space A bytes long A=$AC=length,
001490  3                                               ; X=$AD=<Sutill=ptr low byte, Y=$AE=<Sutilh=ptr high byte
001490  3                                               ; COPY FCB TO STRING
001490  3  A2 21                LDX     #33             ;
001492  3  A0 21                LDY     #33             ;
001494  3               :
001494  3  CA                   DEX
001495  3  88                   DEY
001496  3  BD 16 16             LDA     FCB,X
001499  3  91 AD                STA     (str_pl),Y       ;
00149B  3  E0 00                CPX     #0              ;
00149D  3  D0 F5                BNE     :-              ;
00149F  3                                               ;
00149F  3  20 D2 2B             JSR     LAB_RTST        ; STORE STRING
0014A2  3  4C C2 1F             JMP     LAB_17D5        ; do string LET and return
0014A5  3               
0014A5  3               OPNTMP:
0014A5  3  00                   .BYTE 00
