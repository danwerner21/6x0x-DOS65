00115A  3               ;___SAVE____________________________________________________
00115A  3               ;
00115A  3               ; SAVE COMMAND
00115A  3               ;
00115A  3               ;  SAVE THE BASIC PROGRAM IN MEMORY TO DISK
00115A  3               ;
00115A  3               ;__________________________________________________________
00115A  3               V_SAVE: ; save BASIC program
00115A  3               DOS65SAVE:
00115A  3  20 CD 12             JSR     DOS65FCBPREP    ; parse parameters into FCB
00115D  3  B0 28                BCS     DOS65SAVE_ERR1  ; Error?, if so abort
00115F  3  A2 0D                LDX     #13             ;
001161  3  20 54 11             JSR     PEM             ;
001164  3  A9 A4                LDA     #<FCB           ; CREATE File
001166  3  A0 17                LDY     #>FCB           ;
001168  3  A2 16                LDX     #22             ;
00116A  3  20 54 11             JSR     PEM             ;
00116D  3  A9 00                LDA     #0              ; clear
00116F  3  8D C4 17             STA     FCB+32          ; record number
001172  3  A9 A4                LDA     #<FCB           ; Open File
001174  3  A0 17                LDY     #>FCB           ;
001176  3  A2 0F                LDX     #15             ;
001178  3  20 54 11             JSR     PEM             ;
00117B  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
00117D  3  D0 0B                BNE     DOS65SAVE_1     ;
00117F  3               DOS65SAVE_ERR:
00117F  3  A2 24                LDX     #$24            ; IO ERROR
001181  3  20 84 1A             JSR     LAB_XERR
001184  3  4C 60 1B             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001187  3               DOS65SAVE_ERR1:
001187  3  4C 92 20             JMP     LAB_REM         ; comment out the remainder of the line (if any)
00118A  3               DOS65SAVE_1:
00118A  3  A9 1A                LDA     #<FCBBUFFER     ; SETUP BUFFER
00118C  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
00118E  3  A0 41                LDY     #>FCBBUFFER     ;
001190  3  84 21                STY     FCBPTR+1        ;
001192  3  A2 1A                LDX     #26             ; Setup Buffer
001194  3  20 54 11             JSR     PEM             ;
001197  3               DOS65SAVE_2:
001197  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
001199  3  85 22                STA     FCBPTR+2        ; point to base of RAM
00119B  3  A5 7A                LDA     <Smemh          ;
00119D  3  85 23                STA     FCBPTR+3        ;
00119F  3  A2 00                LDX     #$00            ; x=0 (null counter)
0011A1  3               DOS65SAVE_2A:
0011A1  3  A0 00                LDY     #$00            ; y=0 (Loop Index)
0011A3  3               DOS65SAVE_3:
0011A3  3  B1 22                LDA     (FCBPTR+2),Y    ; load from RAM
0011A5  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
0011A7  3  C9 00                CMP     #$00            ; is Zero?
0011A9  3  D0 1E                BNE     DOS65SAVE_3A    ; No, continue
0011AB  3  E8                   INX                     ; yes, bump Null Counter
0011AC  3  E0 03                CPX     #$03            ; Three nulls in a row?
0011AE  3  D0 1B                BNE     DOS65SAVE_3B    ; No, continue
0011B0  3                                               ; FINISH FILLING BUFFER WITH NULLS
0011B0  3               :
0011B0  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
0011B2  3  C8                   INY                     ; bump index
0011B3  3  C0 80                CPY     #$80            ; end of buffer?
0011B5  3  D0 F9                BNE     :-              ; no, loop
0011B7  3  A9 A4                LDA     #<FCB           ; Write record in buffer to disk file AND END
0011B9  3  A0 17                LDY     #>FCB           ;
0011BB  3  A2 15                LDX     #21             ;
0011BD  3  20 54 11             JSR     PEM             ;
0011C0  3  29 FE                AND     #$FE            ; strip out extension
0011C2  3  C9 00                CMP     #$00            ; is error
0011C4  3  D0 B9                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
0011C6  3  4C F6 11             JMP     DOS65SAVE_4
0011C9  3               DOS65SAVE_3A:                   ;
0011C9  3  A2 00                LDX     #$00            ; prior char not null, reset null counter
0011CB  3               DOS65SAVE_3B:                   ;
0011CB  3  C8                   INY                     ; bump index
0011CC  3  C0 80                CPY     #$80            ; end of buffer?
0011CE  3  D0 D3                BNE     DOS65SAVE_3     ; no, loop
0011D0  3               DOS65SAVE_3C:
0011D0  3  A9 A4                LDA     #<FCB           ; Write record in buffer to disk file
0011D2  3  A0 17                LDY     #>FCB           ;
0011D4  3  A2 15                LDX     #21             ;
0011D6  3  20 54 11             JSR     PEM             ;
0011D9  3  29 FE                AND     #$FE            ; strip out extension
0011DB  3  C9 00                CMP     #$00            ; is error
0011DD  3  D0 A0                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
0011DF  3  18                   CLC                     ;
0011E0  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
0011E2  3  69 80                ADC     #$80            ;
0011E4  3  85 22                STA     FCBPTR+2        ;
0011E6  3  90 B9                BCC     DOS65SAVE_2A    ; is carry?, no loop
0011E8  3  18                   CLC                     ; yes, carry, inc high byte
0011E9  3  A5 23                LDA     FCBPTR+3        ;
0011EB  3  69 01                ADC     #$01            ;
0011ED  3  85 23                STA     FCBPTR+3        ;
0011EF  3  C9 D0                CMP     #>Ram_top       ; are we at the end of RAM?
0011F1  3  F0 03                BEQ     DOS65SAVE_4
0011F3  3  4C A1 11             JMP     DOS65SAVE_2A
0011F6  3               DOS65SAVE_4:
0011F6  3  A9 A4                LDA     #<FCB           ;
0011F8  3  A0 17                LDY     #>FCB           ;
0011FA  3  A2 10                LDX     #16             ;
0011FC  3  20 54 11             JSR     PEM             ;
0011FF  3  C9 FF                CMP     #$FF            ;
001201  3  D0 03                BNE     DOS65SAVE_5     ;
001203  3  4C 7F 11             JMP     DOS65SAVE_ERR   ; ERROR, DISPLAY IT
001206  3               DOS65SAVE_5:
001206  3  A9 7F                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
001208  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
00120A  3  20 23 23             JSR     LAB_18C3
00120D  3  4C 60 1B             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
