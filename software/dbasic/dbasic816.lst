001687  3               
001687  3               ;___FILTER_________________________________________________
001687  3               ;
001687  3               ; SET SID FILTERS
001687  3               ;
001687  3               ;  FILTER CUTOFF, RESONANCE, VOICE 1 ENABLE, VOICE 2 ENABLE, VOICE 3 ENABLE, EXTERNAL ENABLE, FILTER MODE, VOLUME
001687  3               ;
001687  3               ;
001687  3               ;__________________________________________________________
001687  3               LAB_FILTER:
001687  3                       JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001687  3                                               ; else do type mismatch
001687  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001687  3                                               ; SET CUTOFF
001687  3                       LDA     Itempl
001687  3                       STA     SID_BASE+$15
001687  3                       LDA     Itemph
001687  3                       STA     SID_BASE+$16
001687  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001687  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (RESONANCE)
001687  3                       TXA
001687  3                       LSR     A
001687  3                       LSR     A
001687  3                       LSR     A
001687  3                       LSR     A
001687  3                       STA     PTEMPW
001687  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001687  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 1 ENABLE)
001687  3                       TXA
001687  3                       AND     #1
001687  3                       ORA     PTEMPW
001687  3                       STA     PTEMPW
001687  3                       JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
001687  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 2 ENABLE)
001687  3                       TXA
001687  3                       AND     #1
001687  3                       LSR     A
001687  3                       ORA     PTEMPW
001687  3                       STA     PTEMPW
001687  3                       JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001687  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 3 ENABLE)
001687  3                       TXA
001687  3                       AND     #1
001687  3                       LSR     A
001687  3                       LSR     A
001687  3                       ORA     PTEMPW
001687  3                       STA     PTEMPW
001687  3                       JSR     LAB_1C01        ; GET THE SIXTH PARAMETER (AFTER ',') OR SYN ERR
001687  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (EXTERNAL AUDIO ENABLE)
001687  3                       TXA
001687  3                       AND     #1
001687  3                       LSR     A
001687  3                       LSR     A
001687  3                       LSR     A
001687  3                       ORA     PTEMPW
001687  3                       STA     SID_BASE+$17
001687  3                       JSR     LAB_1C01        ; GET THE SEVENTH PARAMETER (AFTER ',') OR SYN ERR
001687  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (FILTER MODE)
001687  3                       TXA
001687  3                       LSR     A
001687  3                       LSR     A
001687  3                       LSR     A
001687  3                       LSR     A
001687  3                       STA     PTEMPW
001687  3                       JSR     LAB_1C01        ; GET THE EIGHTH PARAMETER (AFTER ',') OR SYN ERR
001687  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOLUME)
001687  3                       TXA
001687  3                       AND     #$0F
001687  3                       ORA     PTEMPW
001687  3                       STA     SID_BASE+$18
001687  3                       RTS
001687  3               
001687  3                       .ELSE
001687  3               
