001399  3               ;___OPEN____________________________________________________
001399  3               ;
001399  3               ; OPEN A FILE
001399  3               ;
001399  3               ;
001399  3               ; BASIC COMMAND EXPECTS FOUR VARS
001399  3               
001399  3               ; DRIVE,MODE, FILENAME$,FILE$
001399  3               ;
001399  3               ; FILE$ = STRING TO HOLD 33 BYTE FCB
001399  3               ; DRIVE = NUMERIC DRIVE -- 0=A, 1=B, 2= . . .
001399  3               ; MODE = 0=EXISTING, 1=CREATE
001399  3               ; FILENAME$ = FILENAME STRING
001399  3               ;__________________________________________________________
001399  3               V_OPEN:
001399  3               ; CLEAR FCB
001399  3  A9 00                LDA     #0              ; FILL WITH NULL
00139B  3  A0 00                LDY     #0              ;
00139D  3               :
00139D  3  99 E9 15             STA     FCB,Y           ;
0013A0  3  C8                   INY                     ;
0013A1  3  C0 21                CPY     #33             ;
0013A3  3  D0 F8                BNE     :-              ;
0013A5  3                                               ;
0013A5  3  A9 20                LDA     #32             ; FILL FILENAME AND EXTENSION WITH SPACES
0013A7  3  A0 01                LDY     #1              ;
0013A9  3               :
0013A9  3  99 E9 15             STA     FCB,Y           ;
0013AC  3  C8                   INY                     ;
0013AD  3  C0 0C                CPY     #12             ;
0013AF  3  D0 F8                BNE     :-              ;
0013B1  3                                               ;
0013B1  3  20 A5 30             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (DRIVE)
0013B4  3  8A                   TXA
0013B5  3  8D E9 15             STA     FCB             ; STORE DRIVE IN FCB
0013B8  3                                               ;
0013B8  3  20 17 25             JSR     LAB_1C01        ; (AFTER ',') OR SYN ERR
0013BB  3  20 A5 30             JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X (MODE)
0013BE  3                                               ;
0013BE  3  E0 00                CPX     #0
0013C0  3  D0 08                BNE     :+
0013C2  3  A9 0F                LDA     #15
0013C4  3  8D 78 14             STA     OPNTMP
0013C7  3  4C CF 13             JMP     V_OPEN1
0013CA  3               :
0013CA  3  A9 16                LDA     #22
0013CC  3  8D 78 14             STA     OPNTMP          ;
0013CF  3               V_OPEN1:
0013CF  3  20 17 25             JSR     LAB_1C01        ; (AFTER ',') OR SYN ERR
0013D2  3  20 F5 23             JSR     LAB_EVEX        ; GET THE THIRD PARAMETER
0013D5  3  A5 5F                LDA     <Dtypef         ; IS IT A STRING?
0013D7  3  D0 08                BNE     :+              ; YES, CONTINUE ON
0013D9  3  A2 02                LDX     #$02            ; NOPE, SYNTAX ERROR
0013DB  3  20 C9 18             JSR     LAB_XERR
0013DE  3  4C A5 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
0013E1  3               :
0013E1  3  20 1C 2E             JSR     LAB_22B6        ; pop string off descriptor stack, or from top of string
0013E4  3                                               ; space returns with A = length, X=$71=pointer low byte,
0013E4  3                                               ; Y=$72=pointer high byte
0013E4  3  85 AC                STA     str_ln          ; set string length
0013E6  3  86 AD                STX     str_pl          ; set string pointer low byte
0013E8  3  84 AE                STY     str_ph          ; set string pointer high byte
0013EA  3                                               ; STORE IN FILENAME AND EXTENSION
0013EA  3  A2 00                LDX     #0
0013EC  3  A0 00                LDY     #0
0013EE  3               :
0013EE  3  B1 AD                LDA     (str_pl),Y
0013F0  3  C9 2E                CMP     #'.'
0013F2  3  F0 1E                BEQ     V_OPEN_EXTENSION
0013F4  3  C4 AC                CPY     str_ln
0013F6  3  F0 35                BEQ     V_OPEN_FNEND
