001142  2               ;
001142  2               WRSER1:
001142  2  48                   PHA
001143  2               WRSER1a:
001143  2  AD 85 EF             LDA     UART1STATUS     ; GET STATUS
001146  2  29 10                AND     #%00010000      ; IS TX READY
001148  2  F0 F9                BEQ     WRSER1a         ; NO, WAIT FOR IT
00114A  2  68                   PLA
00114B  2  8D 84 EF             STA     UART1DATA       ; WRITE DATA
00114E  2  60                   RTS
