001273  3  A9 EB                LDA     #<FCB           ; READ record buffer from disk file
001275  3  A0 15                LDY     #>FCB           ;
001277  3  A2 14                LDX     #20             ;
001279  3  20 32 11             JSR     PEM             ;
00127C  3  A0 00                LDY     #$00            ; RESET INDEX
00127E  3  C9 00                CMP     #$00            ; is error or EOF
001280  3  F0 B6                BEQ     DOS65LOAD_3     ;
001282  3  C9 01                CMP     #$01            ; EOF?
001284  3  D0 89                BNE     DOS65LOAD_ERR   ; ERROR, do error handling
001286  3               DOS65LOAD_4:
001286  3  A9 EB                LDA     #<FCB           ;
001288  3  A0 15                LDY     #>FCB           ;
00128A  3  A2 10                LDX     #16             ;
