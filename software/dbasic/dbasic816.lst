001136  3               ;___SAVE____________________________________________________
001136  3               ;
001136  3               ; SAVE COMMAND
001136  3               ;
001136  3               ;  SAVE THE BASIC PROGRAM IN MEMORY TO DISK
001136  3               ;
001136  3               ;__________________________________________________________
001136  3               V_SAVE: ; save BASIC program
001136  3               DOS65SAVE:
001136  3  20 A9 12             JSR     DOS65FCBPREP    ; parse parameters into FCB
001139  3  B0 28                BCS     DOS65SAVE_ERR1  ; Error?, if so abort
00113B  3  A2 0D                LDX     #13             ;
00113D  3  20 30 11             JSR     PEM             ;
001140  3  A9 E9                LDA     #<FCB           ; CREATE File
001142  3  A0 15                LDY     #>FCB           ;
001144  3  A2 16                LDX     #22             ;
001146  3  20 30 11             JSR     PEM             ;
001149  3  A9 00                LDA     #0              ; clear
00114B  3  8D 09 16             STA     FCB+32          ; record number
00114E  3  A9 E9                LDA     #<FCB           ; Open File
001150  3  A0 15                LDY     #>FCB           ;
001152  3  A2 0F                LDX     #15             ;
001154  3  20 30 11             JSR     PEM             ;
001157  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
001159  3  D0 0B                BNE     DOS65SAVE_1     ;
00115B  3               DOS65SAVE_ERR:
00115B  3  A2 24                LDX     #$24            ; IO ERROR
00115D  3  20 C9 18             JSR     LAB_XERR
001160  3  4C A5 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001163  3               DOS65SAVE_ERR1:
001163  3  4C DA 1E             JMP     LAB_REM         ; comment out the remainder of the line (if any)
001166  3               DOS65SAVE_1:
001166  3  A9 64                LDA     #<FCBBUFFER     ; SETUP BUFFER
001168  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
00116A  3  A0 3F                LDY     #>FCBBUFFER     ;
00116C  3  84 21                STY     FCBPTR+1        ;
00116E  3  A2 1A                LDX     #26             ; Setup Buffer
001170  3  20 30 11             JSR     PEM             ;
001173  3               DOS65SAVE_2:
001173  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
001175  3  85 22                STA     FCBPTR+2        ; point to base of RAM
001177  3  A5 7A                LDA     <Smemh          ;
001179  3  85 23                STA     FCBPTR+3        ;
00117B  3  A2 00                LDX     #$00            ; x=0 (null counter)
00117D  3               DOS65SAVE_2A:
00117D  3  A0 00                LDY     #$00            ; y=0 (Loop Index)
00117F  3               DOS65SAVE_3:
00117F  3  B1 22                LDA     (FCBPTR+2),Y    ; load from RAM
001181  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
001183  3  C9 00                CMP     #$00            ; is Zero?
001185  3  D0 1E                BNE     DOS65SAVE_3A    ; No, continue
001187  3  E8                   INX                     ; yes, bump Null Counter
001188  3  E0 03                CPX     #$03            ; Three nulls in a row?
00118A  3  D0 1B                BNE     DOS65SAVE_3B    ; No, continue
00118C  3                                               ; FINISH FILLING BUFFER WITH NULLS
00118C  3               :
00118C  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
00118E  3  C8                   INY                     ; bump index
00118F  3  C0 80                CPY     #$80            ; end of buffer?
001191  3  D0 F9                BNE     :-              ; no, loop
001193  3  A9 E9                LDA     #<FCB           ; Write record in buffer to disk file AND END
001195  3  A0 15                LDY     #>FCB           ;
001197  3  A2 15                LDX     #21             ;
001199  3  20 30 11             JSR     PEM             ;
00119C  3  29 FE                AND     #$FE            ; strip out extension
00119E  3  C9 00                CMP     #$00            ; is error
0011A0  3  D0 B9                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
0011A2  3  4C D2 11             JMP     DOS65SAVE_4
0011A5  3               DOS65SAVE_3A:                   ;
0011A5  3  A2 00                LDX     #$00            ; prior char not null, reset null counter
0011A7  3               DOS65SAVE_3B:                   ;
0011A7  3  C8                   INY                     ; bump index
0011A8  3  C0 80                CPY     #$80            ; end of buffer?
0011AA  3  D0 D3                BNE     DOS65SAVE_3     ; no, loop
0011AC  3               DOS65SAVE_3C:
0011AC  3  A9 E9                LDA     #<FCB           ; Write record in buffer to disk file
0011AE  3  A0 15                LDY     #>FCB           ;
0011B0  3  A2 15                LDX     #21             ;
0011B2  3  20 30 11             JSR     PEM             ;
0011B5  3  29 FE                AND     #$FE            ; strip out extension
0011B7  3  C9 00                CMP     #$00            ; is error
0011B9  3  D0 A0                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
0011BB  3  18                   CLC                     ;
0011BC  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
0011BE  3  69 80                ADC     #$80            ;
0011C0  3  85 22                STA     FCBPTR+2        ;
0011C2  3  90 B9                BCC     DOS65SAVE_2A    ; is carry?, no loop
0011C4  3  18                   CLC                     ; yes, carry, inc high byte
0011C5  3  A5 23                LDA     FCBPTR+3        ;
0011C7  3  69 01                ADC     #$01            ;
0011C9  3  85 23                STA     FCBPTR+3        ;
0011CB  3  C9 D0                CMP     #>Ram_top       ; are we at the end of RAM?
0011CD  3  F0 03                BEQ     DOS65SAVE_4
0011CF  3  4C 7D 11             JMP     DOS65SAVE_2A
0011D2  3               DOS65SAVE_4:
0011D2  3  A9 E9                LDA     #<FCB           ;
0011D4  3  A0 15                LDY     #>FCB           ;
0011D6  3  A2 10                LDX     #16             ;
0011D8  3  20 30 11             JSR     PEM             ;
0011DB  3  C9 FF                CMP     #$FF            ;
0011DD  3  D0 03                BNE     DOS65SAVE_5     ;
0011DF  3  4C 5B 11             JMP     DOS65SAVE_ERR   ; ERROR, DISPLAY IT
0011E2  3               DOS65SAVE_5:
0011E2  3  A9 5B                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
0011E4  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
0011E6  3  20 6B 21             JSR     LAB_18C3
0011E9  3  4C A5 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
