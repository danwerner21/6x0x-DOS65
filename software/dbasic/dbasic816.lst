00123A  3  85 22                STA     FCBPTR+2        ; point to base of RAM
00123C  3  8D 3C 13             STA     EndOfBas        ;
00123F  3  A5 7A                LDA     <Smemh          ;
001241  3  85 23                STA     FCBPTR+3        ;
