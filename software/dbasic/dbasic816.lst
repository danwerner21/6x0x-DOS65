003EBC  1  25 AD                AND     FAC1_1          ; AND FAC1 mantissa1 (AND in sign bit)
003EBE  1  48                   PHA                     ; push on stack
003EBF  1  A5 AE                LDA     FAC1_2          ; get FAC1 mantissa2
003EC1  1  48                   PHA                     ; push on stack
003EC2  1  A5 AF                LDA     FAC1_3          ; get FAC1 mantissa3
003EC4  1  48                   PHA                     ; push on stack
003EC5  1  A5 AC                LDA     FAC1_e          ; get FAC1 exponent
003EC7  1  48                   PHA                     ; push on stack
