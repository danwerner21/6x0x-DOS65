001210  3               ;  LOAD A BASIC PROGRAM FROM DISK TO MEMORY
001210  3               ;
001210  3               ;__________________________________________________________
001210  3               V_LOAD: ; load BASIC program
001210  3               DOS65LOAD:
001210  3  A9 00                LDA     #$00
001212  3  8D 3C 13             STA     NullCounter
001215  3  20 CD 12             JSR     DOS65FCBPREP    ; parse parameters into FCB
001218  3  B0 1F                BCS     DOS65LOAD_ERR1  ; Error?, if so abort
00121A  3  A2 0D                LDX     #13             ;
00121C  3  20 54 11             JSR     PEM             ;
00121F  3  A9 00                LDA     #0              ; clear
001221  3  8D C4 17             STA     FCB+32          ; record number
001224  3  A9 A4                LDA     #<FCB           ; Open File
001226  3  A0 17                LDY     #>FCB           ;
001228  3  A2 0F                LDX     #15             ;
00122A  3  20 54 11             JSR     PEM             ;
00122D  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
00122F  3  D0 0B                BNE     DOS65LOAD_1     ;
001231  3               DOS65LOAD_ERR:
001231  3  A2 24                LDX     #$24            ; IO ERROR
001233  3  20 84 1A             JSR     LAB_XERR
001236  3  4C 60 1B             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001239  3               DOS65LOAD_ERR1:
001239  3  4C 92 20             JMP     LAB_REM         ; comment out the remainder of the line (if any)
00123C  3               DOS65LOAD_1:
00123C  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
00123E  3  85 22                STA     FCBPTR+2        ; point to base of RAM
001240  3  8D 3A 13             STA     EndOfBas        ;
001243  3  A5 7A                LDA     <Smemh          ;
001245  3  85 23                STA     FCBPTR+3        ;
001247  3  8D 3B 13             STA     EndOfBas+1      ;
00124A  3  A9 1A                LDA     #<FCBBUFFER     ; SETUP BUFFER
00124C  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
00124E  3  A0 41                LDY     #>FCBBUFFER     ;
001250  3  84 21                STY     FCBPTR+1        ; STORE DEST BUFFER IN FCBPTR
001252  3  A2 1A                LDX     #26             ; Setup Buffer
001254  3  20 54 11             JSR     PEM             ;
001257  3  4C 95 12             JMP     DOS65LOAD_3C
00125A  3               DOS65LOAD_3:
00125A  3  B1 20                LDA     (FCBPTR),Y      ; load from BUFFER
00125C  3  91 22                STA     (FCBPTR+2),Y    ; save to RAM
00125E  3  EE 3A 13             INC     EndOfBas
001261  3  D0 03                BNE     :+
001263  3  EE 3B 13             INC     EndOfBas+1
001266  3               :
001266  3  C9 00                CMP     #$00
001268  3  D0 0D                BNE     :+
00126A  3  EE 3C 13             INC     NullCounter
00126D  3  AD 3C 13             LDA     NullCounter
001270  3  C9 03                CMP     #3
001272  3  D0 08                BNE     :++
001274  3  4C A8 12             JMP     DOS65LOAD_4
001277  3               :
001277  3  A9 00                LDA     #$00
001279  3  8D 3C 13             STA     NullCounter
00127C  3               :
00127C  3  C8                   INY                     ; bump index
00127D  3  C0 80                CPY     #$80            ; end of buffer?
00127F  3  D0 D9                BNE     DOS65LOAD_3     ; no, loop
001281  3  18                   CLC                     ;
001282  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
001284  3  69 80                ADC     #$80            ;
001286  3  85 22                STA     FCBPTR+2        ;
001288  3  90 0B                BCC     DOS65LOAD_3C    ; is carry?, no SKIP
00128A  3  18                   CLC                     ; yes, carry, inc high byte
00128B  3  A5 23                LDA     FCBPTR+3        ;
00128D  3  69 01                ADC     #$01            ;
00128F  3  85 23                STA     FCBPTR+3        ;
001291  3  C9 D0                CMP     #>Ram_top       ; are we at the end of RAM?
001293  3  F0 13                BEQ     DOS65LOAD_4
001295  3               
001295  3               DOS65LOAD_3C:
001295  3  A9 A4                LDA     #<FCB           ; READ record buffer from disk file
001297  3  A0 17                LDY     #>FCB           ;
001299  3  A2 14                LDX     #20             ;
00129B  3  20 54 11             JSR     PEM             ;
00129E  3  A0 00                LDY     #$00            ; RESET INDEX
0012A0  3  C9 00                CMP     #$00            ; is error or EOF
0012A2  3  F0 B6                BEQ     DOS65LOAD_3     ;
0012A4  3  C9 01                CMP     #$01            ; EOF?
0012A6  3  D0 89                BNE     DOS65LOAD_ERR   ; ERROR, do error handling
0012A8  3               DOS65LOAD_4:
0012A8  3  A9 A4                LDA     #<FCB           ;
0012AA  3  A0 17                LDY     #>FCB           ;
0012AC  3  A2 10                LDX     #16             ;
0012AE  3  20 54 11             JSR     PEM             ;
0012B1  3                                               ; setup pointers to return to basic
0012B1  3  AD 3A 13             LDA     EndOfBas
0012B4  3  85 7B                STA     Svarl
0012B6  3  85 7D                STA     Sarryl
0012B8  3  85 7F                STA     Earryl
0012BA  3  AD 3B 13             LDA     EndOfBas+1
0012BD  3  85 7C                STA     Svarh
0012BF  3  85 7E                STA     Sarryh
0012C1  3  85 80                STA     Earryh
0012C3  3  A9 7F                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
0012C5  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
0012C7  3  20 23 23             JSR     LAB_18C3
0012CA  3  4C 60 1B             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
