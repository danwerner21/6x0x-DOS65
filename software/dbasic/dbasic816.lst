0012BD  3  A2 26                LDX     #$26            ; IO ERROR
0012BF  3  20 CB 18             JSR     LAB_XERR
0012C2  3  4C A7 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
