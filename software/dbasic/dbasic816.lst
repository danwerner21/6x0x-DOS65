0010D5  2  08                   PHP
0010D6  2  A9 01                LDA     #$01
0010D8  2  8D 7C 10             STA     printflag
0010DB  2  28                   PLP
0010DC  2  20 27 21             JSR     LAB_PRINT
0010DF  2  A9 00                LDA     #$00
0010E1  2  8D 7C 10             STA     printflag
0010E4  2  60                   RTS
