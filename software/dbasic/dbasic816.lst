001142  3               ;___SAVE____________________________________________________
001142  3               ;
001142  3               ; SAVE COMMAND
001142  3               ;
001142  3               ;  SAVE THE BASIC PROGRAM IN MEMORY TO DISK
001142  3               ;
001142  3               ;__________________________________________________________
001142  3               V_SAVE: ; save BASIC program
001142  3               DOS65SAVE:
001142  3  20 B5 12             JSR     DOS65FCBPREP    ; parse parameters into FCB
001145  3  B0 28                BCS     DOS65SAVE_ERR1  ; Error?, if so abort
001147  3  A2 0D                LDX     #13             ;
001149  3  20 3C 11             JSR     PEM             ;
00114C  3  A9 F5                LDA     #<FCB           ; CREATE File
00114E  3  A0 15                LDY     #>FCB           ;
001150  3  A2 16                LDX     #22             ;
001152  3  20 3C 11             JSR     PEM             ;
001155  3  A9 00                LDA     #0              ; clear
001157  3  8D 15 16             STA     FCB+32          ; record number
00115A  3  A9 F5                LDA     #<FCB           ; Open File
00115C  3  A0 15                LDY     #>FCB           ;
00115E  3  A2 0F                LDX     #15             ;
001160  3  20 3C 11             JSR     PEM             ;
001163  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
001165  3  D0 0B                BNE     DOS65SAVE_1     ;
001167  3               DOS65SAVE_ERR:
001167  3  A2 24                LDX     #$24            ; IO ERROR
001169  3  20 D5 18             JSR     LAB_XERR
00116C  3  4C B1 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
00116F  3               DOS65SAVE_ERR1:
00116F  3  4C E6 1E             JMP     LAB_REM         ; comment out the remainder of the line (if any)
001172  3               DOS65SAVE_1:
001172  3  A9 70                LDA     #<FCBBUFFER     ; SETUP BUFFER
001174  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
001176  3  A0 3F                LDY     #>FCBBUFFER     ;
001178  3  84 21                STY     FCBPTR+1        ;
00117A  3  A2 1A                LDX     #26             ; Setup Buffer
00117C  3  20 3C 11             JSR     PEM             ;
00117F  3               DOS65SAVE_2:
00117F  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
001181  3  85 22                STA     FCBPTR+2        ; point to base of RAM
001183  3  A5 7A                LDA     <Smemh          ;
001185  3  85 23                STA     FCBPTR+3        ;
001187  3  A2 00                LDX     #$00            ; x=0 (null counter)
001189  3               DOS65SAVE_2A:
001189  3  A0 00                LDY     #$00            ; y=0 (Loop Index)
00118B  3               DOS65SAVE_3:
00118B  3  B1 22                LDA     (FCBPTR+2),Y    ; load from RAM
00118D  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
00118F  3  C9 00                CMP     #$00            ; is Zero?
001191  3  D0 1E                BNE     DOS65SAVE_3A    ; No, continue
001193  3  E8                   INX                     ; yes, bump Null Counter
001194  3  E0 03                CPX     #$03            ; Three nulls in a row?
001196  3  D0 1B                BNE     DOS65SAVE_3B    ; No, continue
001198  3                                               ; FINISH FILLING BUFFER WITH NULLS
001198  3               :
001198  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
00119A  3  C8                   INY                     ; bump index
00119B  3  C0 80                CPY     #$80            ; end of buffer?
00119D  3  D0 F9                BNE     :-              ; no, loop
00119F  3  A9 F5                LDA     #<FCB           ; Write record in buffer to disk file AND END
0011A1  3  A0 15                LDY     #>FCB           ;
0011A3  3  A2 15                LDX     #21             ;
0011A5  3  20 3C 11             JSR     PEM             ;
0011A8  3  29 FE                AND     #$FE            ; strip out extension
0011AA  3  C9 00                CMP     #$00            ; is error
0011AC  3  D0 B9                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
0011AE  3  4C DE 11             JMP     DOS65SAVE_4
0011B1  3               DOS65SAVE_3A:                   ;
0011B1  3  A2 00                LDX     #$00            ; prior char not null, reset null counter
0011B3  3               DOS65SAVE_3B:                   ;
0011B3  3  C8                   INY                     ; bump index
0011B4  3  C0 80                CPY     #$80            ; end of buffer?
0011B6  3  D0 D3                BNE     DOS65SAVE_3     ; no, loop
0011B8  3               DOS65SAVE_3C:
0011B8  3  A9 F5                LDA     #<FCB           ; Write record in buffer to disk file
0011BA  3  A0 15                LDY     #>FCB           ;
0011BC  3  A2 15                LDX     #21             ;
0011BE  3  20 3C 11             JSR     PEM             ;
0011C1  3  29 FE                AND     #$FE            ; strip out extension
0011C3  3  C9 00                CMP     #$00            ; is error
0011C5  3  D0 A0                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
0011C7  3  18                   CLC                     ;
0011C8  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
0011CA  3  69 80                ADC     #$80            ;
0011CC  3  85 22                STA     FCBPTR+2        ;
0011CE  3  90 B9                BCC     DOS65SAVE_2A    ; is carry?, no loop
0011D0  3  18                   CLC                     ; yes, carry, inc high byte
0011D1  3  A5 23                LDA     FCBPTR+3        ;
0011D3  3  69 01                ADC     #$01            ;
0011D5  3  85 23                STA     FCBPTR+3        ;
0011D7  3  C9 D0                CMP     #>Ram_top       ; are we at the end of RAM?
0011D9  3  F0 03                BEQ     DOS65SAVE_4
0011DB  3  4C 89 11             JMP     DOS65SAVE_2A
0011DE  3               DOS65SAVE_4:
0011DE  3  A9 F5                LDA     #<FCB           ;
0011E0  3  A0 15                LDY     #>FCB           ;
0011E2  3  A2 10                LDX     #16             ;
0011E4  3  20 3C 11             JSR     PEM             ;
0011E7  3  C9 FF                CMP     #$FF            ;
0011E9  3  D0 03                BNE     DOS65SAVE_5     ;
0011EB  3  4C 67 11             JMP     DOS65SAVE_ERR   ; ERROR, DISPLAY IT
0011EE  3               DOS65SAVE_5:
0011EE  3  A9 67                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
0011F0  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
0011F2  3  20 77 21             JSR     LAB_18C3
0011F5  3  4C B1 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
