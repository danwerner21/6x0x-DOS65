0010B1  2                       CMP     #$FF
0010B1  2                       BEQ     ploop1
0010B1  2                       PHA
0010B1  2                       LDA     #59
0010B1  2                       STA     farfunct
0010B1  2                       JSR     DO_FARCALL      ; UNPAINT cursor
0010B1  2                       PLA
0010B1  2                       CMP     #$F0
0010B1  2                       BEQ     insert
0010B1  2                       CMP     #$F1
0010B1  2                       BEQ     delete
0010B1  2                       CMP     #$F6
0010B1  2                       BEQ     crsrup
