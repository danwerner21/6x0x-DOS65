0012B5  3               DOS65FCBPREP:
0012B5  3                       .IFDEF  DUODYNE
0012B5  3  22 C2 00 00          JSL     LAB_GBYT        ; scan memory
0012B9  3                       .ELSE
0012B9  3                       JSR     LAB_GBYT        ; scan memory
0012B9  3                       .ENDIF
0012B9  3               
0012B9  3  38                   SEC                     ;
0012BA  3  E9 40                SBC     #64             ; PARSE DRIVE NUMBER
0012BC  3  8D F5 15             STA     DOSDRIVE        ; STORE IT IN FCB
0012BF  3                       .IFDEF  DUODYNE
0012BF  3  22 BC 00 00          JSL     LAB_IGBY        ; increment and scan memory
0012C3  3                       .ELSE
0012C3  3                       JSR     LAB_IGBY        ; increment and scan memory
0012C3  3                       .ENDIF
0012C3  3               
0012C3  3  C9 3A                CMP     #':'            ;
0012C5  3  F0 08                BEQ     DOS65FCBPREP_1  ; YES, IT WAS A DRIVE, CONTINUE
0012C7  3  A2 26                LDX     #$26            ; IO ERROR
0012C9  3  20 D5 18             JSR     LAB_XERR
0012CC  3  4C B1 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
0012CF  3               
0012CF  3               DOS65FCBPREP_1:
0012CF  3  A9 F5                LDA     #<FCB           ; SETUP FCBPTR
0012D1  3  85 20                STA     FCBPTR          ;
0012D3  3  A9 15                LDA     #>FCB           ;
0012D5  3  85 21                STA     FCBPTR+1        ;
0012D7  3  A0 01                LDY     #$01            ; POINT Y TO FCB FILE NAME
0012D9  3  A9 20                LDA     #$20            ; LOAD SPACE CHAR INTO A
0012DB  3               DOS65FCBPREP_1A:                ; BLANK OUT FCB
0012DB  3  8B DA 48 A2          STAINDIRECTY FCBPTR     ;
0012DF  3  01 B5 20 C9  
0012E3  3  00 D0 04 A2  
0012F1  3  C8                   INY                     ;
0012F2  3  C0 09                CPY     #$09            ; IS DONE
0012F4  3  D0 E5                BNE     DOS65FCBPREP_1A ; NO, LOOP
0012F6  3  A0 01                LDY     #$01            ; POINT Y TO FCB FILE NAME
0012F8  3               DOS65FCBPREP_2:                 ; COPY FILE NAME PARAMETER INTO FCB
0012F8  3                       .IFDEF  DUODYNE
0012F8  3  22 BC 00 00          JSL     LAB_IGBY        ; increment and scan memory
0012FC  3                       .ELSE
0012FC  3                       JSR     LAB_IGBY        ; increment and scan memory
0012FC  3                       .ENDIF
0012FC  3  F0 22                BEQ     DOS65FCBPREP_3  ;
0012FE  3  C9 2E                CMP     #'.'
