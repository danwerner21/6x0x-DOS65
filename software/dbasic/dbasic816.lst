001279  3  C0 80                CPY     #$80            ; end of buffer?
00127B  3  D0 D9                BNE     DOS65LOAD_3     ; no, loop
00127D  3  18                   CLC                     ;
00127E  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
001280  3  69 80                ADC     #$80            ;
001282  3  85 22                STA     FCBPTR+2        ;
001284  3  90 0B                BCC     DOS65LOAD_3C    ; is carry?, no SKIP
001286  3  18                   CLC                     ; yes, carry, inc high byte
001287  3  A5 23                LDA     FCBPTR+3        ;
001289  3  69 01                ADC     #$01            ;
00128B  3  85 23                STA     FCBPTR+3        ;
00128D  3  C9 D0                CMP     #>Ram_top       ; are we at the end of RAM?
00128F  3  F0 13                BEQ     DOS65LOAD_4
