001302  3  8B DA 48 A2          STAINDIRECTY FCBPTR     ;
001306  3  01 B5 20 C9  
00130A  3  00 D0 04 A2  
001318  3  C8                   INY                     ;
001319  3  C0 09                CPY     #$09            ;
00131B  3  F0 03                BEQ     DOS65FCBPREP_3  ;
00131D  3  4C F8 12             JMP     DOS65FCBPREP_2  ;
