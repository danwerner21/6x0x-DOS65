0013A5  3               ;___OPEN____________________________________________________
0013A5  3               ;
0013A5  3               ; OPEN A FILE
0013A5  3               ;
0013A5  3               ;
0013A5  3               ; BASIC COMMAND EXPECTS FOUR VARS
0013A5  3               
0013A5  3               ; DRIVE,MODE, FILENAME$,FILE$
0013A5  3               ;
0013A5  3               ; FILE$ = STRING TO HOLD 33 BYTE FCB
0013A5  3               ; DRIVE = NUMERIC DRIVE -- 0=A, 1=B, 2= . . .
0013A5  3               ; MODE = 0=EXISTING, 1=CREATE
0013A5  3               ; FILENAME$ = FILENAME STRING
0013A5  3               ;__________________________________________________________
0013A5  3               V_OPEN:
0013A5  3               ; CLEAR FCB
0013A5  3  A9 00                LDA     #0              ; FILL WITH NULL
0013A7  3  A0 00                LDY     #0              ;
0013A9  3               :
0013A9  3  99 F5 15             STA     FCB,Y           ;
0013AC  3  C8                   INY                     ;
0013AD  3  C0 21                CPY     #33             ;
0013AF  3  D0 F8                BNE     :-              ;
0013B1  3                                               ;
0013B1  3  A9 20                LDA     #32             ; FILL FILENAME AND EXTENSION WITH SPACES
0013B3  3  A0 01                LDY     #1              ;
0013B5  3               :
0013B5  3  99 F5 15             STA     FCB,Y           ;
0013B8  3  C8                   INY                     ;
0013B9  3  C0 0C                CPY     #12             ;
0013BB  3  D0 F8                BNE     :-              ;
0013BD  3                                               ;
0013BD  3  20 B1 30             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (DRIVE)
0013C0  3  8A                   TXA
0013C1  3  8D F5 15             STA     FCB             ; STORE DRIVE IN FCB
0013C4  3                                               ;
0013C4  3  20 23 25             JSR     LAB_1C01        ; (AFTER ',') OR SYN ERR
0013C7  3  20 B1 30             JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X (MODE)
0013CA  3                                               ;
0013CA  3  E0 00                CPX     #0
0013CC  3  D0 08                BNE     :+
0013CE  3  A9 0F                LDA     #15
0013D0  3  8D 84 14             STA     OPNTMP
0013D3  3  4C DB 13             JMP     V_OPEN1
0013D6  3               :
0013D6  3  A9 16                LDA     #22
0013D8  3  8D 84 14             STA     OPNTMP          ;
0013DB  3               V_OPEN1:
0013DB  3  20 23 25             JSR     LAB_1C01        ; (AFTER ',') OR SYN ERR
0013DE  3  20 01 24             JSR     LAB_EVEX        ; GET THE THIRD PARAMETER
0013E1  3  A5 5F                LDA     <Dtypef         ; IS IT A STRING?
0013E3  3  D0 08                BNE     :+              ; YES, CONTINUE ON
0013E5  3  A2 02                LDX     #$02            ; NOPE, SYNTAX ERROR
0013E7  3  20 D5 18             JSR     LAB_XERR
0013EA  3  4C B1 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
0013ED  3               :
0013ED  3  20 28 2E             JSR     LAB_22B6        ; pop string off descriptor stack, or from top of string
0013F0  3                                               ; space returns with A = length, X=$71=pointer low byte,
0013F0  3                                               ; Y=$72=pointer high byte
0013F0  3  85 AC                STA     str_ln          ; set string length
0013F2  3  86 AD                STX     str_pl          ; set string pointer low byte
0013F4  3  84 AE                STY     str_ph          ; set string pointer high byte
0013F6  3                                               ; STORE IN FILENAME AND EXTENSION
0013F6  3  A2 00                LDX     #0
0013F8  3  A0 00                LDY     #0
0013FA  3               :
0013FA  3  B1 AD                LDA     (str_pl),Y
0013FC  3  C9 2E                CMP     #'.'
0013FE  3  F0 1E                BEQ     V_OPEN_EXTENSION
001400  3  C4 AC                CPY     str_ln
001402  3  F0 35                BEQ     V_OPEN_FNEND
001404  3  C8                   INY
001405  3  99 F5 15             STA     FCB,Y
001408  3  C0 08                CPY     #8
00140A  3  D0 EE                BNE     :-
00140C  3               :
00140C  3  C8                   INY
00140D  3  B9 F5 15             LDA     FCB,Y
001410  3  C9 2E                CMP     #'.'
001412  3  F0 0A                BEQ     V_OPEN_EXTENSION
001414  3  C4 AC                CPY     str_ln
001416  3  F0 21                BEQ     V_OPEN_FNEND
001418  3  4C 0C 14             JMP     :-
00141B  3  4C 39 14             JMP     V_OPEN_FNEND
00141E  3               V_OPEN_EXTENSION:
00141E  3  A2 09                LDX     #9
001420  3               :
001420  3  C8                   INY
001421  3  B1 AD                LDA     (str_pl),Y
001423  3  C4 AC                CPY     str_ln
001425  3  F0 12                BEQ     V_OPEN_FNEND
