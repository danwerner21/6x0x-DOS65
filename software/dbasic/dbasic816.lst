00120F  3  A2 26                LDX     #$26            ; IO ERROR
001211  3  20 CB 18             JSR     LAB_XERR
001214  3  4C A7 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001217  3               DOS65LOAD_ERR1:
001217  3  4C DC 1E             JMP     LAB_REM         ; comment out the remainder of the line (if any)
00121A  3               DOS65LOAD_1:
00121A  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
00121C  3  85 22                STA     FCBPTR+2        ; point to base of RAM
00121E  3  8D 18 13             STA     EndOfBas        ;
001221  3  A5 7A                LDA     <Smemh          ;
001223  3  85 23                STA     FCBPTR+3        ;
001225  3  8D 19 13             STA     EndOfBas+1      ;
001228  3  A9 66                LDA     #<FCBBUFFER     ; SETUP BUFFER
00122A  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
00122C  3  A0 3F                LDY     #>FCBBUFFER     ;
00122E  3  84 21                STY     FCBPTR+1        ; STORE DEST BUFFER IN FCBPTR
001230  3  A2 1A                LDX     #26             ; Setup Buffer
