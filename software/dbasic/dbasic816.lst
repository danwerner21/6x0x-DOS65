001293  3  A0 16                LDY     #>FCB           ;
001295  3  A2 14                LDX     #20             ;
001297  3  20 4E 11             JSR     PEM             ;
00129A  3  A0 00                LDY     #$00            ; RESET INDEX
00129C  3  C9 00                CMP     #$00            ; is error or EOF
00129E  3  F0 B6                BEQ     DOS65LOAD_3     ;
0012A0  3  C9 01                CMP     #$01            ; EOF?
0012A2  3  D0 88                BNE     DOS65LOAD_ERR   ; ERROR, do error handling
0012A4  3               DOS65LOAD_4:
