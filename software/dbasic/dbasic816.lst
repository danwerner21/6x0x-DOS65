0010D6  2  20 3C 11             JSR     WRSER1          ; output upper nybble
0010D9  2  A9 0A                LDA     #10
0010DB  2  20 3C 11             JSR     WRSER1          ; output upper nybble
0010DE  2  AE 39 11             LDX     TTX
0010E1  2  AC 3A 11             LDY     TTY
0010E4  2  AD 3B 11             LDA     TTA
