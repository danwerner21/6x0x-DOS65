003ECC  1  20 21 24             JSR     LAB_EVNM        ; evaluate expression and check is numeric,
003ECF  1               ; else do type mismatch
003ECF  1               
003ECF  1               ; pop FAC2 (MAX/MIN expression so far)
003ECF  1  68                   PLA                     ; pop exponent
003ED0  1  85 B3                STA     FAC2_e          ; save FAC2 exponent
003ED2  1  68                   PLA                     ; pop mantissa3
003ED3  1  85 B6                STA     FAC2_3          ; save FAC2 mantissa3
003ED5  1  68                   PLA                     ; pop mantissa1
003ED6  1  85 B5                STA     FAC2_2          ; save FAC2 mantissa2
003ED8  1  68                   PLA                     ; pop sign/mantissa1
003ED9  1  85 B4                STA     FAC2_1          ; save FAC2 sign/mantissa1
003EDB  1  85 B7                STA     FAC2_s          ; save FAC2 sign
003EDD  1               
003EDD  1               ; compare FAC1 with (packed) FAC2
003EDD  1  A9 B3                LDA     #<FAC2_e        ; set pointer low byte to FAC2
003EDF  1  A0 00                LDY     #>FAC2_e        ; set pointer high byte to FAC2
003EE1  1  4C 18 37             JMP     LAB_27F8        ; compare FAC1 with FAC2 (AY) and return
003EE4  1               ; returns A=$00 if FAC1 = (AY)
003EE4  1               ; returns A=$01 if FAC1 > (AY)
003EE4  1               ; returns A=$FF if FAC1 < (AY)
003EE4  1               
003EE4  1               ; perform WIDTH
003EE4  1               
003EE4  1               LAB_WDTH:
003EE4  1  C9 2C                CMP     #','            ; is next byte ","
