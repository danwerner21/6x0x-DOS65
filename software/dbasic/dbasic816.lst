0010B9  2               UART1CONTROL    = $EF87         ; SERIAL PORT 1 (I/O Card)
0010B9  2               
0010B9  2               PRINT_CRLF:
0010B9  2  8E 27 11             STX     TTX
0010BC  2  8C 28 11             STY     TTY
0010BF  2  8D 29 11             STA     TTA
0010C2  2  A9 0D                LDA     #13
0010C4  2  20 2A 11             JSR     WRSER1          ; output upper nybble
0010C7  2  A9 0A                LDA     #10
0010C9  2  20 2A 11             JSR     WRSER1          ; output upper nybble
0010CC  2  AE 27 11             LDX     TTX
0010CF  2  AC 28 11             LDY     TTY
0010D2  2  AD 29 11             LDA     TTA
0010D5  2  60                   RTS
0010D6  2               
0010D6  2               PRINT_SPACE:
0010D6  2  8E 27 11             STX     TTX
0010D9  2  8C 28 11             STY     TTY
0010DC  2  8D 29 11             STA     TTA
0010DF  2  A9 20                LDA     #32
0010E1  2  20 2A 11             JSR     WRSER1          ; output upper nybble
0010E4  2  AE 27 11             LDX     TTX
0010E7  2  AC 28 11             LDY     TTY
0010EA  2  AD 29 11             LDA     TTA
0010ED  2  60                   RTS
0010EE  2               
0010EE  2               
0010EE  2               PRINT_BYTE:
0010EE  2  8E 27 11             STX     TTX
0010F1  2  8C 28 11             STY     TTY
0010F4  2  8D 29 11             STA     TTA
0010F7  2  8E 26 11             STX     SAVX            ; save X
0010FA  2  20 11 11             JSR     ASCTWO          ; get hex chars for byte in X (lower) and A (upper)
0010FD  2  20 2A 11             JSR     WRSER1          ; output upper nybble
001100  2  8A                   TXA                     ; transfer lower to A
001101  2  AE 26 11             LDX     SAVX            ; restore X
001104  2  20 2A 11             JSR     WRSER1          ; output lower nybble
001107  2  AE 27 11             LDX     TTX
00110A  2  AC 28 11             LDY     TTY
00110D  2  AD 29 11             LDA     TTA
001110  2  60                   RTS
001111  2               ASCTWO:
001111  2  48                   PHA                     ; save byte
001112  2  20 1B 11             JSR     ASCII           ; do low nybble
001115  2  AA                   TAX                     ; save in X
001116  2  68                   PLA                     ; restore byte
001117  2  4A                   LSR     A               ; shift upper nybble down
001118  2  4A                   LSR     A
001119  2  4A                   LSR     A
00111A  2  4A                   LSR     A
00111B  2               ; convert low nybble in A to hex digit
00111B  2               ASCII:
00111B  2  29 0F                AND     #$0F            ; clear upper nibble
00111D  2  C9 0A                CMP     #$0A            ; if less than A, skip next step
00111F  2  90 02                BCC     ASC1
001121  2  69 06                ADC     #6              ; skip ascii chars between 9 and A
001123  2               ASC1:
001123  2  69 30                ADC     #$30            ; add ascii char 0 to value
001125  2  60                   RTS
001126  2               SAVX:
001126  2  00                   .BYTE   00
001127  2               TTX:
001127  2  00                   .BYTE   00
001128  2               TTY:
001128  2  00                   .BYTE   00
001129  2               TTA:
001129  2  00                   .BYTE   00
00112A  2               ;__WRSER1________________________________________________________________________________________________________________________
00112A  2               ;
00112A  2               ;	WRITE CHARACTER(A) TO UART
00112A  2               ;________________________________________________________________________________________________________________________________
00112A  2               ;
00112A  2               WRSER1:
00112A  2  48                   PHA
00112B  2               WRSER1a:
00112B  2  AD 85 EF             LDA     UART1STATUS     ; GET STATUS
00112E  2  29 10                AND     #%00010000      ; IS TX READY
001130  2  F0 F9                BEQ     WRSER1a         ; NO, WAIT FOR IT
001132  2  68                   PLA
001133  2  8D 84 EF             STA     UART1DATA       ; WRITE DATA
001136  2  60                   RTS
