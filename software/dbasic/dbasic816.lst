0017D7  3               
0017D7  3               
0017D7  3                       .IFDEF  MEMORYMAPPEDSCREEN
0017D7  3               
0017D7  3               PC6502_IO       = $E000
0017D7  3               SID_BASE        = PC6502_IO+$100
0017D7  3               
0017D7  3               ;___SOUND__________________________________________________
0017D7  3               ;
0017D7  3               ; PLAY SOUND
0017D7  3               ;
0017D7  3               ;  SOUND VOICE, FREQ, DUTY, WAVEFORM, ATTACK, SUSTAIN, DECAY, RELEASE
0017D7  3               ;
0017D7  3               ;
0017D7  3               ;__________________________________________________________
0017D7  3               LAB_SOUND:
0017D7  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (VOICE)
0017D7  3                       TXA
0017D7  3                       AND     #3
0017D7  3                       ASL     A
0017D7  3                       TAX
0017D7  3                       LDA     SIDVOICELOOKUP,X
0017D7  3                       STA     TEMPW
0017D7  3                       LDA     SIDVOICELOOKUP+1,X
0017D7  3                       STA     TEMPW+1
0017D7  3                                               ; OK, TEMPW POINTS TO SID REGISTER TO MODIFY
0017D7  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
0017D7  3                       JSR     LAB_EVNM        ; evaluate expression and check is numeric,
0017D7  3                                               ; else do type mismatch
0017D7  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
0017D7  3                       LDY     #0              ; SET FREQUENCY
0017D7  3                       LDA     Itempl
0017D7  3                       STA     (TEMPW),Y
0017D7  3                       LDA     Itemph
0017D7  3                       INX
0017D7  3                       STA     (TEMPW),Y
0017D7  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
0017D7  3                       JSR     LAB_EVNM        ; evaluate expression and check is numeric,
0017D7  3                                               ; else do type mismatch
0017D7  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
0017D7  3                       LDY     #2              ; SET DUTY CYCLE
0017D7  3                       LDA     Itempl
0017D7  3                       STA     (TEMPW),Y
0017D7  3                       LDA     Itemph
0017D7  3                       INY
0017D7  3                       STA     (TEMPW),Y
0017D7  3                       JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
0017D7  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (WAVEFORM)
0017D7  3                       TXA
0017D7  3                       LDY     #4              ; SET WAVEFORM CYCLE
0017D7  3                       STA     (TEMPW),Y
0017D7  3                       JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
0017D7  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (ATTACK)
0017D7  3                       TXA
0017D7  3                       LSR     A
0017D7  3                       LSR     A
0017D7  3                       LSR     A
0017D7  3                       LSR     A
0017D7  3                       STA     PTEMPW
0017D7  3                       JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
0017D7  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (DECAY)
0017D7  3                       TXA
0017D7  3                       AND     #$0F
0017D7  3                       ORA     PTEMPW
0017D7  3                       LDY     #5              ; SET ATTACK/DECAY
0017D7  3                       STA     (TEMPW),Y
0017D7  3                       JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
0017D7  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (SUSTAIN)
0017D7  3                       TXA
0017D7  3                       LSR     A
0017D7  3                       LSR     A
0017D7  3                       LSR     A
0017D7  3                       LSR     A
0017D7  3                       STA     PTEMPW
0017D7  3                       JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
0017D7  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (RELEASE)
0017D7  3                       TXA
0017D7  3                       AND     #$0F
0017D7  3                       ORA     PTEMPW
0017D7  3                       LDY     #6              ; SET SUSTAIN/RELEASE
0017D7  3                       STA     (TEMPW),Y
0017D7  3                       RTS
0017D7  3               SIDVOICELOOKUP:
0017D7  3                       .WORD   SID_BASE,SID_BASE+7,SID_BASE+$12
0017D7  3               
0017D7  3               ;___FILTER_________________________________________________
0017D7  3               ;
0017D7  3               ; SET SID FILTERS
0017D7  3               ;
0017D7  3               ;  FILTER CUTOFF, RESONANCE, VOICE 1 ENABLE, VOICE 2 ENABLE, VOICE 3 ENABLE, EXTERNAL ENABLE, FILTER MODE, VOLUME
0017D7  3               ;
0017D7  3               ;
0017D7  3               ;__________________________________________________________
0017D7  3               LAB_FILTER:
0017D7  3                       JSR     LAB_EVNM        ; evaluate expression and check is numeric,
0017D7  3                                               ; else do type mismatch
0017D7  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
0017D7  3                                               ; SET CUTOFF
0017D7  3                       LDA     Itempl
0017D7  3                       STA     SID_BASE+$15
0017D7  3                       LDA     Itemph
0017D7  3                       STA     SID_BASE+$16
0017D7  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
0017D7  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (RESONANCE)
0017D7  3                       TXA
0017D7  3                       LSR     A
0017D7  3                       LSR     A
0017D7  3                       LSR     A
0017D7  3                       LSR     A
0017D7  3                       STA     PTEMPW
0017D7  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
0017D7  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 1 ENABLE)
0017D7  3                       TXA
0017D7  3                       AND     #1
0017D7  3                       ORA     PTEMPW
0017D7  3                       STA     PTEMPW
0017D7  3                       JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
0017D7  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 2 ENABLE)
0017D7  3                       TXA
0017D7  3                       AND     #1
0017D7  3                       LSR     A
0017D7  3                       ORA     PTEMPW
0017D7  3                       STA     PTEMPW
0017D7  3                       JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
0017D7  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 3 ENABLE)
0017D7  3                       TXA
0017D7  3                       AND     #1
0017D7  3                       LSR     A
0017D7  3                       LSR     A
0017D7  3                       ORA     PTEMPW
0017D7  3                       STA     PTEMPW
0017D7  3                       JSR     LAB_1C01        ; GET THE SIXTH PARAMETER (AFTER ',') OR SYN ERR
0017D7  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (EXTERNAL AUDIO ENABLE)
0017D7  3                       TXA
0017D7  3                       AND     #1
0017D7  3                       LSR     A
0017D7  3                       LSR     A
0017D7  3                       LSR     A
0017D7  3                       ORA     PTEMPW
0017D7  3                       STA     SID_BASE+$17
0017D7  3                       JSR     LAB_1C01        ; GET THE SEVENTH PARAMETER (AFTER ',') OR SYN ERR
0017D7  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (FILTER MODE)
0017D7  3                       TXA
0017D7  3                       LSR     A
0017D7  3                       LSR     A
0017D7  3                       LSR     A
0017D7  3                       LSR     A
0017D7  3                       STA     PTEMPW
0017D7  3                       JSR     LAB_1C01        ; GET THE EIGHTH PARAMETER (AFTER ',') OR SYN ERR
0017D7  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOLUME)
0017D7  3                       TXA
0017D7  3                       AND     #$0F
0017D7  3                       ORA     PTEMPW
0017D7  3                       STA     SID_BASE+$18
0017D7  3                       RTS
0017D7  3               
0017D7  3                       .ELSE
0017D7  3               
0017D7  3               
0017D7  3               ; ENSURE ALL OF THESE SPECIAL COMMANDS GIVE ERRORS IN NORMAL BASIC
0017D7  3               LAB_SOUND:
0017D7  3               LAB_FILTER:
0017D7  3  A2 02                LDX     #$02            ; error code $02 ("SYNTAX" error)
0017D9  3  4C 70 1A             JMP     LAB_XERR        ; do error #X, then warm start
0017DC  3               
0017DC  3                       .ENDIF
