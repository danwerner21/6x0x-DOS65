001485  3               ;___CLOSE____________________________________________________
001485  3               ;
001485  3               ; CLOSE A FILE
001485  3               ;
001485  3               ; BASIC COMMAND EXPECTS ONE VAR
001485  3               ;
001485  3               ; FILE$
001485  3               ;
001485  3               ; FILE$ = STRING HOLDING 33 BYTE FCB
001485  3               ;__________________________________________________________
001485  3               V_CLOSE:
001485  3  20 FE 26             JSR     LAB_GVAR        ; GET THE FIRST PARAMETER
001488  3  20 F2 23             JSR     LAB_CTST        ; check if source is string, else do type mismatch
00148B  3  A0 02                LDY     #$02            ; index to string pointer high byte
00148D  3  8B DA A2 01          LDAINDIRECTY Cvaral     ; get string pointer high byte
001491  3  B5 95 C9 00  
001495  3  D0 04 A2 00  
0014A3  3  85 FE                STA     TEMPW+1         ; set string pointer high byte
0014A5  3  88                   DEY                     ; index to string pointer low byte
0014A6  3  8B DA A2 01          LDAINDIRECTY Cvaral     ; get string pointer low byte
0014AA  3  B5 95 C9 00  
0014AE  3  D0 04 A2 00  
0014BC  3  85 FD                STA     TEMPW           ; set string pointer low byte
0014BE  3  A2 10                LDX     #16             ; CLOSE
0014C0  3  A5 FD                LDA     TEMPW           ; FCB
0014C2  3  A4 FE                LDY     TEMPW+1         ; FCB
0014C4  3  20 3C 11             JSR     PEM
0014C7  3  C9 FF                CMP     #$FF
0014C9  3  D0 08                BNE     :+
0014CB  3  A2 24                LDX     #$24            ; IO ERROR
0014CD  3  20 D5 18             JSR     LAB_XERR
0014D0  3  4C B1 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
0014D3  3               :
0014D3  3  60                   RTS
