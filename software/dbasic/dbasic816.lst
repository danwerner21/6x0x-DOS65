0011FD  3  20 B5 12             JSR     DOS65FCBPREP    ; parse parameters into FCB
001200  3  B0 1F                BCS     DOS65LOAD_ERR1  ; Error?, if so abort
001202  3  A2 0D                LDX     #13             ;
001204  3  20 3C 11             JSR     PEM             ;
001207  3  A9 00                LDA     #0              ; clear
001209  3  8D 15 16             STA     FCB+32          ; record number
00120C  3  A9 F5                LDA     #<FCB           ; Open File
00120E  3  A0 15                LDY     #>FCB           ;
001210  3  A2 0F                LDX     #15             ;
001212  3  20 3C 11             JSR     PEM             ;
001215  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
001217  3  D0 0B                BNE     DOS65LOAD_1     ;
001219  3               DOS65LOAD_ERR:
001219  3  A2 26                LDX     #$26            ; IO ERROR
00121B  3  20 D5 18             JSR     LAB_XERR
00121E  3  4C B1 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001221  3               DOS65LOAD_ERR1:
001221  3  4C E6 1E             JMP     LAB_REM         ; comment out the remainder of the line (if any)
001224  3               DOS65LOAD_1:
001224  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
001226  3  85 22                STA     FCBPTR+2        ; point to base of RAM
001228  3  8D 22 13             STA     EndOfBas        ;
00122B  3  A5 7A                LDA     <Smemh          ;
00122D  3  85 23                STA     FCBPTR+3        ;
00122F  3  8D 23 13             STA     EndOfBas+1      ;
001232  3  A9 70                LDA     #<FCBBUFFER     ; SETUP BUFFER
001234  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
001236  3  A0 3F                LDY     #>FCBBUFFER     ;
001238  3  84 21                STY     FCBPTR+1        ; STORE DEST BUFFER IN FCBPTR
00123A  3  A2 1A                LDX     #26             ; Setup Buffer
00123C  3  20 3C 11             JSR     PEM             ;
00123F  3  4C 7D 12             JMP     DOS65LOAD_3C
001242  3               DOS65LOAD_3:
001242  3  B1 20                LDA     (FCBPTR),Y      ; load from BUFFER
001244  3  91 22                STA     (FCBPTR+2),Y    ; save to RAM
001246  3  EE 22 13             INC     EndOfBas
001249  3  D0 03                BNE     :+
00124B  3  EE 23 13             INC     EndOfBas+1
00124E  3               :
00124E  3  C9 00                CMP     #$00
001250  3  D0 0D                BNE     :+
001252  3  EE 24 13             INC     NullCounter
001255  3  AD 24 13             LDA     NullCounter
001258  3  C9 03                CMP     #3
00125A  3  D0 08                BNE     :++
00125C  3  4C 90 12             JMP     DOS65LOAD_4
00125F  3               :
00125F  3  A9 00                LDA     #$00
001261  3  8D 24 13             STA     NullCounter
001264  3               :
001264  3  C8                   INY                     ; bump index
001265  3  C0 80                CPY     #$80            ; end of buffer?
001267  3  D0 D9                BNE     DOS65LOAD_3     ; no, loop
001269  3  18                   CLC                     ;
00126A  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
00126C  3  69 80                ADC     #$80            ;
00126E  3  85 22                STA     FCBPTR+2        ;
001270  3  90 0B                BCC     DOS65LOAD_3C    ; is carry?, no SKIP
001272  3  18                   CLC                     ; yes, carry, inc high byte
001273  3  A5 23                LDA     FCBPTR+3        ;
001275  3  69 01                ADC     #$01            ;
001277  3  85 23                STA     FCBPTR+3        ;
001279  3  C9 D0                CMP     #>Ram_top       ; are we at the end of RAM?
00127B  3  F0 13                BEQ     DOS65LOAD_4
00127D  3               
00127D  3               DOS65LOAD_3C:
00127D  3  A9 F5                LDA     #<FCB           ; READ record buffer from disk file
00127F  3  A0 15                LDY     #>FCB           ;
001281  3  A2 14                LDX     #20             ;
001283  3  20 3C 11             JSR     PEM             ;
001286  3  A0 00                LDY     #$00            ; RESET INDEX
001288  3  C9 00                CMP     #$00            ; is error or EOF
00128A  3  F0 B6                BEQ     DOS65LOAD_3     ;
00128C  3  C9 01                CMP     #$01            ; EOF?
00128E  3  D0 89                BNE     DOS65LOAD_ERR   ; ERROR, do error handling
001290  3               DOS65LOAD_4:
001290  3  A9 F5                LDA     #<FCB           ;
001292  3  A0 15                LDY     #>FCB           ;
001294  3  A2 10                LDX     #16             ;
001296  3  20 3C 11             JSR     PEM             ;
001299  3                                               ; setup pointers to return to basic
001299  3  AD 22 13             LDA     EndOfBas
00129C  3  85 7B                STA     Svarl
00129E  3  85 7D                STA     Sarryl
0012A0  3  85 7F                STA     Earryl
0012A2  3  AD 23 13             LDA     EndOfBas+1
0012A5  3  85 7C                STA     Svarh
0012A7  3  85 7E                STA     Sarryh
0012A9  3  85 80                STA     Earryh
0012AB  3  A9 67                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
0012AD  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
0012AF  3  20 77 21             JSR     LAB_18C3
0012B2  3  4C B1 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
