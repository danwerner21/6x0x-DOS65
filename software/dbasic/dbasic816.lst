0010CB  2                       STX     DBGX
0010CB  2                       LDA     #19
0010CB  2                       STA     farfunct
0010CB  2                       LDA     DBGA
0010CB  2                       JSR     DO_FARCALL
0010CB  2                       LDA     DBGA
0010CB  2                       LDY     DBGY
0010CB  2                       LDX     DBGX
