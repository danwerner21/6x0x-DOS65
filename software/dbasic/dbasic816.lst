00144E  3  99 16 16             STA     FCB,Y
001451  3  E6 E3                INC     Rbyte2
001453  3  A4 E4                LDY     Rbyte3
001455  3  E8                   INX
001456  3  E0 0C                CPX     #12
001458  3  D0 E7                BNE     :-
