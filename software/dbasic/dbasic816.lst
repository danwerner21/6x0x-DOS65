001658  2                       .INCLUDE "screencmds.asm"
001658  3               
001658  3                       .IFDEF  MEMORYMAPPEDSCREEN
001658  3               
001658  3               ;* MEMORY MAP
001658  3               ;  VIDEO CARD IS A 32K AREA (MAPPED IN BANKS TO $AXXX)
001658  3               ;  $0x00 0x01=soft_scanline_emulation, 0x02 NO soft_scanline_emulation
001658  3               ;  $0x01 0x01=page1, 0x02 page2
001658  3               ;  $0x02  character generator write offset (data << 3)
001658  3               ;  $0x03 character generator write DATA
001658  3               ;  $0x04 EXECUTE device command
001658  3               ;        0x00- reset to the default configuration
001658  3               ;        0x01- reset to the saved configuration
001658  3               ;	0x02- save the current configuration
001658  3               ;
001658  3               ;  $0x05  0x01=soft_text=true, 0x02=soft_text=false
001658  3               ;  $0x06 Lores Mode=0X01,NO lores Mode=0x02
001658  3               ;  $0x07 Double Lores Mode=0X01,NO Double lores Mode=0x02
001658  3               ;  $0x08 Hires Mode=0X01,NO Hires Mode=0x02
001658  3               ;  $0x09 Double Hires Mode=0X01,NO Double Hires lores Mode=0x02
001658  3               ;  $0x0A 80COL Mode=0X01,NO 80COL Mode=0x02
001658  3               ;  $0x0B MIXED Mode=0X01,NO MIXED Mode=0x02
001658  3               ;  $0x0C QUAD Hires Mode=0X01,NO QUAD Hires lores Mode=0x02
001658  3               ;  $0x0D MONO Hires Mode=0X01,NO MONO Hires lores Mode=0x02
001658  3               ;
001658  3               ; 	VRAM Memory Map
001658  3               ;	$1000-$177F	40/80 Text Page 1
001658  3               ;	$1800-$1F7F	40/80 Color Page 1
001658  3               ;	$2000-$277F	40/80 Text Page 2
001658  3               ;	$2800-$2F7F	40/80 Color Page 2
001658  3               ;	$2000-$5FFF	HIRES PAGE 1
001658  3               ;	$6000-$8FFF	HIRES PAGE 2
001658  3               ;	$2000-$BFFF	DOUBLE HIRES
001658  3               
001658  3               VIDEOBANK       = $F8
001658  3               PC6502_IOSPACE  = $EF00
001658  3               ; PAGER
001658  3               PC6502_ACT_TASK = PC6502_IOSPACE+$E0
001658  3               PC6502_MAP_SETUP = PC6502_IOSPACE+$E1
001658  3               PC6502_MMU_ENA  = PC6502_IOSPACE+$E2
001658  3               PC6502_MAP_SPACE = PC6502_IOSPACE+$D0
001658  3               
001658  3               VideoDisplayPage = $A001
001658  3               VideoCharGenOffset = $A002
001658  3               VideoCharGenData = $A003
001658  3               VideoTextMode   = $A005
001658  3               VideoLoresMode  = $A006
001658  3               VideoDoubleLores = $A007
001658  3               VideoHiresMode  = $A008
001658  3               VideoDoubleHires = $A009
001658  3               Video80col      = $A00A
001658  3               VideoMixedMode  = $A00b
001658  3               VideoQuadHires  = $A00c
001658  3               VideoMonoHires  = $A00d
001658  3               
001658  3               CURX            = $0647         ; CURRENT CURSOR POSITION (MEMORY MAPPED)
001658  3               CURY            = $0648
001658  3               SHOWCRSR        = $0649         ; SHOW CURSOR (1-YES, 0-NO) (MEMORY MAPPED)
001658  3               CURCOLOR        = $064A         ; CURRENT PRINT COLOR (MEMORY MAPPED)
001658  3               CSRCOLOR        = $064B         ; CURRENT CURSOR COLOR (MEMORY MAPPED)
001658  3               BVIDEOMODE      = $064C         ; CURRENT VIDEO MODE (MEMORY MAPPED) 00=40 COL, 01=80 COL
001658  3               
001658  3               
001658  3               VIDEOMODE:
001658  3                       .BYTE   $00
001658  3               CLRTMP:
001658  3                       .BYTE   $00
001658  3               VIDEOWIDTH:
001658  3                       .BYTE   80
001658  3               
001658  3               PTEMPW:
001658  3                       .BYTE   $00,$00
001658  3               PTEMPW1:
001658  3                       .BYTE   $00,$00
001658  3               PTEMPW2:
001658  3                       .BYTE   $00,$00
001658  3               PTEMPW3:
001658  3                       .BYTE   $00,$00
001658  3               PTEMP:
001658  3                       .BYTE   $00
001658  3               PTEMP4:
001658  3                       .BYTE   $00
001658  3               
001658  3               
001658  3               ;___V_SCRCLR________________________________________________
001658  3               ;
001658  3               ; CLEAR SCREEN
001658  3               ;
001658  3               ;__________________________________________________________
001658  3               LAB_SCRCLR:
001658  3               V_SCNCLR:
001658  3                       STA     DBGA
001658  3                       STY     DBGY
001658  3                       STX     DBGX
001658  3                       LDA     #38
001658  3                       STA     farfunct
001658  3                       JSR     DO_FARCALL
001658  3                       LDA     #59
001658  3                       STA     farfunct
001658  3                       JSR     DO_FARCALL
001658  3                       LDA     DBGA
001658  3                       LDY     DBGY
001658  3                       LDX     DBGX
001658  3                       RTS
001658  3               
001658  3               
001658  3               
001658  3               ;___V_LOCATE________________________________________________
001658  3               ;
001658  3               ; SET CURSOR LOCATION
001658  3               ;
001658  3               ;       LOCATE X,Y
001658  3               ;
001658  3               ;__________________________________________________________
001658  3               V_LOCATE:
001658  3               LAB_LOCATE:
001658  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (MODE)
001658  3                       STX     DBGX
001658  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001658  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
001658  3                       TXA
001658  3                       TAY
001658  3                       LDX     DBGX
001658  3                       LDA     #37
001658  3                       STA     farfunct
001658  3                       JSR     DO_FARCALL
001658  3                       RTS
001658  3               
001658  3               ;___V_COLOR_________________________________________________
001658  3               ;
001658  3               ; SET COLOR FG,BG,CFG,CBG
001658  3               ;
001658  3               ;__________________________________________________________
001658  3               LAB_COLOR:
001658  3               V_COLOR:
001658  3                       LDA     #$00            ; CLEAR TEMP SPACE
001658  3                       STA     PTEMPW
001658  3                       STA     PTEMPW+1
001658  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (MODE)
001658  3                       TXA
001658  3                       AND     #$0F
001658  3                       STA     PTEMPW
001658  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001658  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
001658  3                       TXA
001658  3                       ASL     A
001658  3                       ASL     A
001658  3                       ASL     A
001658  3                       ASL     A
001658  3                       ORA     PTEMPW
001658  3                       STA     PTEMPW
001658  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001658  3                       JSR     LAB_GTBY        ; GET THE THIRD PARAMETER, RETURN IN X
001658  3                       TXA
001658  3                       AND     #$0F
001658  3                       STA     PTEMPW+1
001658  3                       JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
001658  3                       JSR     LAB_GTBY        ; GET THE FOURTH PARAMETER, RETURN IN X
001658  3                       TXA
001658  3                       ASL     A
001658  3                       ASL     A
001658  3                       ASL     A
001658  3                       ASL     A
001658  3                       ORA     PTEMPW+1
001658  3                       STA     PTEMPW+1
001658  3                       LDX     PTEMPW
001658  3                       LDY     PTEMPW+1
001658  3                       LDA     #39
001658  3                       STA     farfunct
001658  3                       JSR     DO_FARCALL
001658  3                       RTS
001658  3               
001658  3               
001658  3               
001658  3               ;___V_SPEEK()______________________________________________
001658  3               ;
001658  3               ; GET VALUE FROM SCREEN MEMORY
001658  3               ;
001658  3               ;  TAKES ONE PARAMETER (ADDRESS), RETURNS VALUE
001658  3               ;
001658  3               ;__________________________________________________________
001658  3               LAB_SPEEK:
001658  3               V_SPEEK:
001658  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001658  3                       LDA     Itemph
001658  3                       TAY
001658  3                       AND     #$0F
001658  3                       ORA     #$A0
001658  3                       STA     Itemph
001658  3                       TYA
001658  3                       AND     #$F0
001658  3                       LSR     A
001658  3                       LSR     A
001658  3                       LSR     A
001658  3                       LSR     A
001658  3                       AND     #$07
001658  3                       CLC
001658  3                       ADC     #VIDEOBANK
001658  3                       TAY
001658  3                       LDA     #$01            ; MODIFY TASK 01 (DRIVER TASK)
001658  3                       LDX     #$0A            ; MAP $AXXX
001658  3                       JSR     SETPAGE         ; CALL SETPAGE
001658  3                       LDA     #$01
001658  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 01
001658  3                       LDY     #0
001658  3                       LDA     (Itempl),Y
001658  3                       TAY
001658  3                       LDA     #$00
001658  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 00
001658  3                       JMP     LAB_1FD0        ; convert Y to byte in FAC1 and return
001658  3               
001658  3               
001658  3               
001658  3               ;___V_SPOKE_________________________________________________
001658  3               ;
001658  3               ; PUT VALUE IN SCREEN MEMORY
001658  3               ;
001658  3               ;  TAKES TWO PARAMETERS ADDRESS,VALUE
001658  3               ;
001658  3               ;__________________________________________________________
001658  3               LAB_SPOKE:
001658  3               V_SPOKE:
001658  3                       JSR     LAB_GADB        ; get two parameters for POKE or WAIT
001658  3                       TXA                     ; BYTE ARGUMENT IS IN X
001658  3                       PHA                     ; PUSH BYTE ARGUMENT TO STACK
001658  3                       LDA     Itemph
001658  3                       TAY
001658  3                       AND     #$0F
001658  3                       ORA     #$A0
001658  3                       STA     Itemph
001658  3                       TYA
001658  3                       AND     #$F0
001658  3                       LSR     A
001658  3                       LSR     A
001658  3                       LSR     A
001658  3                       LSR     A
001658  3                       AND     #$07
001658  3                       CLC
001658  3                       ADC     #VIDEOBANK
001658  3                       TAY
001658  3                       LDA     #$01            ; MODIFY TASK 01 (DRIVER TASK)
001658  3                       LDX     #$0A            ; MAP $AXXX
001658  3                       JSR     SETPAGE         ; CALL SETPAGE
001658  3                       LDA     #$01
001658  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 01
001658  3                       LDY     #0
001658  3                       PLA                     ; PULL BYTE ARGUMENT
001658  3                       STA     (Itempl),Y
001658  3                       LDA     #$00
001658  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 00
001658  3                       RTS
001658  3               
001658  3               ;___V_SCREEN_________________________________________________
001658  3               ;
001658  3               ;  SET SCREEN MODE
001658  3               ;
001658  3               ;  TAKES UP TO THREE PARAMETERS
001658  3               ;  FIRST PARAMETER SCREEN MODE
001658  3               ;  0=TEXT MODE
001658  3               ;  1=LORES MODE
001658  3               ;  2=HIRES MODE
001658  3               ;
001658  3               ;  TEXT MODE PARAMETERS
001658  3               ;  0=40 COLUMNS
001658  3               ;  1=80 COLUMNS
001658  3               ;
001658  3               ;  LORES MODE SECOND PARAMETER
001658  3               ;  0=SINGLE LORES
001658  3               ;  1=DOUBLE LORES
001658  3               ;  LORES MODE THIRD PARAMETER
001658  3               ;  0=MIXED MODE
001658  3               ;  1=FULL SCREEN MODE
001658  3               ;
001658  3               ;  HIRES MODE SECOND PARAMETER
001658  3               ;  0=SINGLE HIRES
001658  3               ;  1=DOUBLE HIRES
001658  3               ;  2=QUAD HIRES
001658  3               ;  3=MONO HIRES
001658  3               ;  HIRES MODE THIRD PARAMETER
001658  3               ;  1=MIXED MODE
001658  3               ;  0=FULL SCREEN MODE
001658  3               ;
001658  3               ;__________________________________________________________
001658  3               LAB_SCREEN:
001658  3               V_SCREEN:
001658  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (MODE)
001658  3               V_SCREEN1:
001658  3                       STX     VIDEOMODE
001658  3                       CPX     #00
001658  3                       BNE     *+5
001658  3                       JMP     SETUPMODE0
001658  3                       CPX     #01
001658  3                       BNE     *+5
001658  3                       JMP     SETUPMODE1
001658  3                       CPX     #02
001658  3                       BNE     *+5
001658  3                       JMP     SETUPMODE2
001658  3               
001658  3                       LDX     #$02            ; SYNTAX ERROR
001658  3                       JSR     LAB_XERR
001658  3                       JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001658  3                       RTS
001658  3               
001658  3               SETUPMODE0:                     ; TEXT MODE
001658  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001658  3                       JSR     PAGE_ENTER
001658  3                       LDA     #$01
001658  3                       STA     VideoTextMode
001658  3                       LDA     #$02
001658  3                       STA     VideoLoresMode
001658  3                       STA     VideoHiresMode
001658  3                       JSR     PAGE_EXIT
001658  3               
001658  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001658  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
001658  3                       CPX     #$00
001658  3                       BNE     SETUPMODE0_80
001658  3               
001658  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001658  3                       JSR     PAGE_ENTER
001658  3                       LDA     #$02
001658  3                       STA     Video80col
001658  3                       JSR     PAGE_EXIT
001658  3                       LDA     #40
001658  3                       STA     VIDEOWIDTH
001658  3                       LDA     #0
001658  3                       STA     BVIDEOMODE
001658  3                       JMP     SETUPMODE0_CLEAR
001658  3               SETUPMODE0_80:
001658  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001658  3                       JSR     PAGE_ENTER
001658  3                       LDA     #$01
001658  3                       STA     Video80col
001658  3                       JSR     PAGE_EXIT
001658  3                       LDA     #80
001658  3                       STA     VIDEOWIDTH
001658  3                       LDA     #1
001658  3                       STA     BVIDEOMODE
001658  3               SETUPMODE0_CLEAR:
001658  3                       JMP     V_SCNCLR
001658  3                       RTS
001658  3               
001658  3               SETUPMODE1:                     ; LORES MODE
001658  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001658  3                       JSR     PAGE_ENTER
001658  3                       LDA     #$01
001658  3                       STA     VideoLoresMode
001658  3                       LDA     #$02
001658  3                       STA     VideoTextMode
001658  3                       STA     VideoHiresMode
001658  3                       JSR     PAGE_EXIT
001658  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001658  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
001658  3               
001658  3                       CPX     #$00
001658  3                       BNE     SETUPMODE1_DOUBLE
001658  3               
001658  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001658  3                       JSR     PAGE_ENTER
001658  3                       LDA     #$02
001658  3                       STA     VideoDoubleLores
001658  3                       JSR     PAGE_EXIT
001658  3                       JMP     SETUPMODE1_CLEAR
001658  3               SETUPMODE1_DOUBLE:
001658  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001658  3                       JSR     PAGE_ENTER
001658  3                       LDA     #$01
001658  3                       STA     VideoDoubleLores
001658  3                       JSR     PAGE_EXIT
001658  3                       LDA     #$11
001658  3                       STA     VIDEOMODE
001658  3               SETUPMODE1_CLEAR:               ;    ($2000-$2800)
001658  3                       LDY     #$02+VIDEOBANK  ; AREA $2000-$2FFF
001658  3                       JSR     PAGE_ENTER
001658  3                       LDA     #$00
001658  3                       STA     TEMPW
001658  3                       LDA     #$A0
001658  3                       STA     TEMPW+1
001658  3                       LDY     #$00
001658  3                       LDA     #$00
001658  3               :
001658  3                       STA     (TEMPW),Y
001658  3                       INC     TEMPW
001658  3                       BNE     :-
001658  3                       INC     TEMPW+1
001658  3               
001658  3                       LDX     TEMPW+1
001658  3                       CPX     #$A8
001658  3                       BNE     :-
001658  3                       JSR     PAGE_EXIT
001658  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001658  3                       JSR     LAB_GTBY        ; GET THE THIRD PARAMETER, RETURN IN X
001658  3                       CPX     #$00
001658  3                       BNE     SETUPMODE1_MIXED
001658  3               
001658  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001658  3                       JSR     PAGE_ENTER
001658  3                       LDA     #$02
001658  3                       STA     VideoMixedMode
001658  3                       JSR     PAGE_EXIT
001658  3                       RTS
001658  3               SETUPMODE1_MIXED:
001658  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001658  3                       JSR     PAGE_ENTER
001658  3                       LDA     #$01
001658  3                       STA     VideoMixedMode
001658  3                       JSR     PAGE_EXIT
001658  3                       LDA     VIDEOMODE
001658  3                       ORA     #$80
001658  3                       STA     VIDEOMODE
001658  3                       RTS
001658  3               
001658  3               
001658  3               SETUPMODE2:                     ; HIRES MODE
001658  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001658  3                       JSR     PAGE_ENTER
001658  3                       LDA     #$01
001658  3                       STA     VideoHiresMode
001658  3                       LDA     #$02
001658  3                       STA     VideoTextMode
001658  3                       STA     VideoLoresMode
001658  3                       JSR     PAGE_EXIT
001658  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001658  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
001658  3               
001658  3                       CPX     #$00
001658  3                       BNE     SETUPMODE2_DOUBLE
001658  3               
001658  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001658  3                       JSR     PAGE_ENTER
001658  3                       LDA     #$02
001658  3                       STA     VideoDoubleHires
001658  3                       STA     VideoQuadHires
001658  3                       STA     VideoMonoHires
001658  3                       JSR     PAGE_EXIT
001658  3                       JMP     SETUPMODE2_CLEAR
001658  3               SETUPMODE2_DOUBLE:
001658  3                       CPX     #$01
001658  3                       BNE     SETUPMODE2_QUAD
001658  3               
001658  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001658  3                       JSR     PAGE_ENTER
001658  3                       LDA     #$01
001658  3                       STA     VideoDoubleHires
001658  3                       LDA     #$02
001658  3                       STA     VideoQuadHires
001658  3                       STA     VideoMonoHires
001658  3                       JSR     PAGE_EXIT
001658  3                       LDA     #$12
001658  3                       STA     VIDEOMODE
001658  3                       JMP     SETUPMODE2_CLEAR
001658  3               SETUPMODE2_QUAD:
001658  3                       CPX     #$02
001658  3                       BNE     SETUPMODE2_MONO
001658  3               
001658  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001658  3                       JSR     PAGE_ENTER
001658  3                       LDA     #$01
001658  3                       STA     VideoQuadHires
001658  3                       LDA     #$02
001658  3                       STA     VideoDoubleHires
001658  3                       STA     VideoMonoHires
001658  3                       JSR     PAGE_EXIT
001658  3                       LDA     #$22
001658  3                       STA     VIDEOMODE
001658  3                       JMP     SETUPMODE2_CLEAR
001658  3               SETUPMODE2_MONO:
001658  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001658  3                       JSR     PAGE_ENTER
001658  3                       LDA     #$01
001658  3                       STA     VideoMonoHires
001658  3                       LDA     #$02
001658  3                       STA     VideoDoubleHires
001658  3                       STA     VideoQuadHires
001658  3                       JSR     PAGE_EXIT
001658  3                       LDA     #$32
001658  3                       STA     VIDEOMODE
001658  3               
001658  3               SETUPMODE2_CLEAR:               ; ($2000-$7FFF)
001658  3                       LDY     #$02+VIDEOBANK
001658  3                       STY     CLRTMP
001658  3               
001658  3               :
001658  3                       LDY     CLRTMP
001658  3                       JSR     PAGE_ENTER
001658  3               
001658  3                       LDA     #$00
001658  3                       TAY
001658  3                       STA     TEMPW
001658  3                       LDA     #$A0
001658  3                       STA     TEMPW+1
001658  3                       LDA     #$00
001658  3               :
001658  3                       STA     (TEMPW),Y
001658  3                       INC     TEMPW
001658  3                       BNE     :-
001658  3                       INC     TEMPW+1
001658  3                       LDX     TEMPW+1
001658  3                       CPX     #$B0
001658  3                       BNE     :-
001658  3                       LDX     #$A0
001658  3                       INC     CLRTMP
001658  3                       LDX     CLRTMP
001658  3                       CPX     #$00
001658  3                       BNE     :--
001658  3                       JSR     PAGE_EXIT
001658  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001658  3                       JSR     LAB_GTBY        ; GET THE THIRD PARAMETER, RETURN IN X
001658  3                       CPX     #$00
001658  3                       BNE     SETUPMODE2_MIXED
001658  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001658  3                       JSR     PAGE_ENTER
001658  3                       LDA     #$02
001658  3                       STA     VideoMixedMode
001658  3                       JSR     PAGE_EXIT
001658  3                       RTS
001658  3               SETUPMODE2_MIXED:
001658  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001658  3                       JSR     PAGE_ENTER
001658  3                       LDA     #$01
001658  3                       STA     VideoMixedMode
001658  3                       JSR     PAGE_EXIT
001658  3                       LDA     VIDEOMODE
001658  3                       ORA     #$80
001658  3                       STA     VIDEOMODE
001658  3                       RTS
001658  3               
001658  3               
001658  3               
001658  3               PAGE_EXIT:
001658  3                       LDA     #$00
001658  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 00
001658  3                       RTS
001658  3               
001658  3               PAGE_ENTER:
001658  3               ; Set "Y" register to video page ($YXXX)
001658  3                       LDA     #$01            ; MODIFY TASK 01 (DRIVER TASK)
001658  3                       LDX     #$0A            ; MAP $AXXX
001658  3                       JSR     SETPAGE         ; CALL SETPAGE
001658  3                       LDA     #$01
001658  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 01
001658  3                       RTS
001658  3               
001658  3               ;___V_PLOT__________________________________________________
001658  3               ;
001658  3               ;  PLOT ON SCREEN
001658  3               ;         TAKES THREE PARAMETERS,  X,Y,COLOR
001658  3               ;
001658  3               ;__________________________________________________________
001658  3               LAB_PLOT:
001658  3               V_PLOT:
001658  3                       LDA     VIDEOMODE
001658  3                       AND     #$0F
001658  3                       CMP     #$01
001658  3                       BEQ     V_PLOT_LORES
001658  3                       LDA     VIDEOMODE
001658  3                       AND     #$2F
001658  3                       CMP     #$02
001658  3                       BNE     :+
001658  3                       JMP     V_PLOT_HIRES_COLOR
001658  3               :
001658  3                       CMP     #$22
001658  3                       BNE     :+
001658  3                       JMP     V_PLOT_HIRES_MONO
001658  3               :
001658  3                       RTS
001658  3               
001658  3               V_PLOT_LORES:
001658  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X
001658  3                       STX     PTEMPW          ; STORE X COORD IN OFFSET ADDRESS
001658  3                       LDA     #00
001658  3                       STA     PTEMPW+1
001658  3                       STA     PTEMPW1+1
001658  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001658  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
001658  3                                               ; FIGURE THE BUFFER OFFSET
001658  3                       TXA                     ; Y COORD IN X
001658  3                       PHA
001658  3                       LSR     A               ; 2 LINES PER BYTE
001658  3                       STA     PTEMPW1
001658  3                                               ; MULTIPLY Y (PTEMPW) COORD BY 40 OR 80 (SINGLE OR DOUBLE LORES)
001658  3                       CLC
001658  3                       ASL     PTEMPW1
001658  3                       ROL     PTEMPW1+1       ; *2
001658  3                       ASL     PTEMPW1
001658  3                       ROL     PTEMPW1+1       ; *2 (*4)
001658  3                       ASL     PTEMPW1
001658  3                       ROL     PTEMPW1+1       ; *2 (*8)
001658  3                       LDA     PTEMPW1
001658  3                       STA     PTEMPW2
001658  3                       LDA     PTEMPW1+1
001658  3                       STA     PTEMPW2+1       ; STORE Y*8 INTO PTEMPW2
001658  3                       ASL     PTEMPW1
001658  3                       ROL     PTEMPW1+1       ; *2 (*16)
001658  3                       ASL     PTEMPW1
001658  3                       ROL     PTEMPW1+1       ; *2 (*32)
001658  3                                               ; NOW TAKE Y*8(PTEMPW2) + Y*32(PTEMPW1) == Y*40 STORE IN PTEMPW1
001658  3                       CLC                     ; Clear the Carry flag before the first addition
001658  3               
001658  3                       LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
001658  3                       ADC     PTEMPW2         ; Add the low byte of the second number (plus carry)
001658  3                       STA     PTEMPW1         ; Store the low byte of the result
001658  3               
001658  3                       LDA     PTEMPW1+1       ; Load the high byte of the first number
001658  3                       ADC     PTEMPW2+1       ; Add the high byte of the second number (plus carry from previous op)
001658  3                       STA     PTEMPW1+1       ; Store the high byte of the result
001658  3               
001658  3               ; if double lores columns double it.
001658  3                       LDA     VIDEOMODE
001658  3                       AND     #$10
001658  3                       CMP     #00
001658  3                       BEQ     :+
001658  3                       ASL     PTEMPW1
001658  3                       ROL     PTEMPW1+1       ; *2
001658  3               :
001658  3                                               ; OK, Y OFFSET IS IN PTEMPW1, X IS IN PTEMPW
001658  3                       LDA     #$A0            ; ADD THE MEMORY OFFSET TO PTEMPW (BECAUSE IT IS EASY)
001658  3                       STA     PTEMPW+1        ; THEN ADD PTEMPW1 TO PTEMPW THAT SHOULD BE THE MEMORY ADDRESS TO UPDATE
001658  3                                               ;
001658  3                       CLC                     ; Clear the Carry flag before the first addition
001658  3                       LDA     PTEMPW          ; Load the low byte of the first number into the accumulator
001658  3                       ADC     PTEMPW1         ; Add the low byte of the second number (plus carry)
001658  3                       STA     TEMPW           ; Store the low byte of the result
001658  3               
001658  3                       LDA     PTEMPW+1        ; Load the high byte of the first number
001658  3                       ADC     PTEMPW1+1       ; Add the high byte of the second number (plus carry from previous op)
001658  3                       STA     TEMPW+1         ; Store the high byte of the result
001658  3                                               ; PTEMPW IS THE MEMORY OFFSET TO UPDATE
001658  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001658  3                       JSR     LAB_GTBY        ; GET THE THIRD PARAMETER, RETURN IN X (PATTERN)
001658  3                       TXA
001658  3                       AND     #$0F
001658  3                       STA     PTEMP           ; SAVE COLOR IN PTEMP
001658  3                       PLA
001658  3                       LSR     A               ; TOP OR BOTTOM PIXEL?
001658  3                       BCC     :+
001658  3                                               ; TOP PIXEL
001658  3                       LDY     #$02+VIDEOBANK  ; AREA $2000-$2FFF
001658  3                       JSR     PAGE_ENTER
001658  3                       LDY     #$00
001658  3                       LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
001658  3                       AND     #$0F
001658  3                       PHA
001658  3                       LDA     PTEMP
001658  3                       ASL     A
001658  3                       ASL     A
001658  3                       ASL     A
001658  3                       ASL     A
001658  3                       STA     PTEMP
001658  3                       PLA
001658  3                       ORA     PTEMP
001658  3                       STA     (TEMPW),Y       ; STORE  DOUBLE PIXEL
001658  3                       JSR     PAGE_EXIT
001658  3                       RTS
001658  3               :
001658  3                                               ; BOTTOM PIXEL
001658  3                       LDY     #$02+VIDEOBANK  ; AREA $2000-$2FFF
001658  3                       JSR     PAGE_ENTER
001658  3                       LDY     #$00
001658  3                       LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
001658  3                       AND     #$F0
001658  3                       ORA     PTEMP
001658  3                       STA     (TEMPW),Y       ; STORE  DOUBLE PIXEL
001658  3                       JSR     PAGE_EXIT
001658  3                       RTS
001658  3               
001658  3               V_PLOT_HIRES_COLOR:
001658  3                       JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001658  3               ; else do type mismatch
001658  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001658  3                       LDA     Itemph
001658  3                       STA     PTEMPW+1
001658  3                       LDA     Itempl
001658  3                       PHA                     ; PUSH LOW BYTE OF X (FOR EVEN/ODD LATER)
001658  3                       LSR     Itemph
001658  3                       ROR     Itempl          ; 2 PIXEL PER BYTE
001658  3                       LDA     Itempl          ;
001658  3                       STA     PTEMPW          ;
001658  3                       LDA     Itemph          ;
001658  3                       STA     PTEMPW+1        ; STORE X COORD IN OFFSET ADDRESS;
001658  3                       LDA     #$00
001658  3                       STA     PTEMPW1+1
001658  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001658  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
001658  3                                               ; FIGURE THE BUFFER OFFSET
001658  3                       LDA     #$00
001658  3                       TXA                     ; GET Y COORD
001658  3                       STX     PTEMPW1
001658  3               
001658  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001658  3                       JSR     LAB_GTBY        ; GET THE THIRD PARAMETER, RETURN IN X (PATTERN)
001658  3                       TXA
001658  3                       AND     #$0F
001658  3                       STA     PTEMP4          ; SAVE COLOR IN PTEMP4
001658  3                       CLC                     ; MULTIPLY Y COORD BY 70 OR 140 (SINGLE OR DOUBLE HIRES)
001658  3                       ASL     PTEMPW1
001658  3                       ROL     PTEMPW1+1       ; *2
001658  3                       LDA     PTEMPW1
001658  3                       STA     PTEMPW2
001658  3                       LDA     PTEMPW1+1
001658  3                       STA     PTEMPW2+1       ; STORE Y*2 INTO PTEMPW2
001658  3                       ASL     PTEMPW1
001658  3                       ROL     PTEMPW1+1       ; *2 (*4)
001658  3                       LDA     PTEMPW1
001658  3                       STA     PTEMPW3
001658  3                       LDA     PTEMPW1+1
001658  3                       STA     PTEMPW3+1       ; STORE Y*4 INTO PTEMPW3
001658  3                       ASL     PTEMPW1
001658  3                       ROL     PTEMPW1+1       ; *2 (*8)
001658  3                       ASL     PTEMPW1
001658  3                       ROL     PTEMPW1+1       ; *2 (*16)
001658  3                       ASL     PTEMPW1
001658  3                       ROL     PTEMPW1+1       ; *2 (*32)
001658  3                       ASL     PTEMPW1
001658  3                       ROL     PTEMPW1+1       ; *2 (*64)
001658  3                                               ; RESULT OFFSET PTEMPW1 = PTEMPW1(Y*64)+PTEMPW2(Y*2)+PTEMPW3(Y*4)
001658  3                       CLC                     ; Clear the Carry flag before the first addition
001658  3                       LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
001658  3                       ADC     PTEMPW2         ; Add the low byte of the second number (plus carry)
001658  3                       STA     PTEMPW1         ; Store the low byte of the result
001658  3                       LDA     PTEMPW1+1       ; Load the high byte of the first number
001658  3                       ADC     PTEMPW2+1       ; Add the high byte of the second number (plus carry from previous op)
001658  3                       STA     PTEMPW1+1       ; Store the high byte of the result
001658  3               
001658  3                       CLC                     ; Clear the Carry flag before the first addition
001658  3                       LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
001658  3                       ADC     PTEMPW3         ; Add the low byte of the second number (plus carry)
001658  3                       STA     PTEMPW1         ; Store the low byte of the result
001658  3                       LDA     PTEMPW1+1       ; Load the high byte of the first number
001658  3                       ADC     PTEMPW3+1       ; Add the high byte of the second number (plus carry from previous op)
001658  3                       STA     PTEMPW1+1       ; Store the high byte of the result
001658  3               
001658  3               ; if double hires double it.
001658  3                       LDA     VIDEOMODE
001658  3                       AND     #$10
001658  3                       CMP     #00
001658  3                       BEQ     :+
001658  3                       ASL     PTEMPW1
001658  3                       ROL     PTEMPW1+1       ; *2
001658  3               :
001658  3                                               ; PTEMPW1 IS NOW Y OFFSET, ADD X OFFSET FOR MEMORY ADDRESS INTO TEMPW
001658  3                       CLC                     ; Clear the Carry flag before the first addition
001658  3                       LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
001658  3                       ADC     PTEMPW          ; Add the low byte of the second number (plus carry)
001658  3                       STA     TEMPW           ; Store the low byte of the result
001658  3                       LDA     PTEMPW1+1       ; Load the high byte of the first number
001658  3                       ADC     PTEMPW+1        ; Add the high byte of the second number (plus carry from previous op)
001658  3                       STA     TEMPW+1         ; Store the high byte of the result
001658  3               
001658  3                       LDA     TEMPW+1         ; OK, LET'S CALCULATE THE BANK
001658  3                       AND     #$F0
001658  3                       LSR     A
001658  3                       LSR     A
001658  3                       LSR     A
001658  3                       LSR     A
001658  3                       CLC
001658  3                       ADC     #$02+VIDEOBANK  ; AREA $2000-?
001658  3                       CMP     #$F8
001658  3                       BCC     V_PLOT_HIRES_COLOR_RANGE
001658  3                       TAY                     ; VIDEO BANK SHOULD BE IN Y
001658  3                       JSR     PAGE_ENTER
001658  3               
001658  3                       LDA     TEMPW+1
001658  3                       AND     #$0F
001658  3                       ORA     #$A0
001658  3                       STA     TEMPW+1         ; TEMPW NOW REFLECTS MAPPED ADDRESSS
001658  3                       PLA
001658  3                       LSR     A               ; LEFT OR RIGHT PIXEL?
001658  3                       BCS     :+
001658  3                                               ; LEFT PIXEL
001658  3                       LDY     #$00
001658  3                       LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
001658  3                       AND     #$0F
001658  3                       PHA
001658  3                       LDA     PTEMP4
001658  3                       ASL     A
001658  3                       ASL     A
001658  3                       ASL     A
001658  3                       ASL     A
001658  3                       STA     PTEMP4
001658  3                       PLA
001658  3                       ORA     PTEMP4
001658  3                       STA     (TEMPW),Y       ; WRITE THE PIXEL BACK OUT
001658  3                       JSR     PAGE_EXIT
001658  3                       RTS
001658  3               :
001658  3               ; RIGHT PIXEL
001658  3                       LDY     #$00
001658  3                       LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
001658  3                       AND     #$F0
001658  3                       ORA     PTEMP4
001658  3                       STA     (TEMPW),Y       ; WRITE THE PIXEL BACK OUT
001658  3                       JSR     PAGE_EXIT
001658  3                       RTS
001658  3               
001658  3               V_PLOT_HIRES_COLOR_RANGE:
001658  3                       JMP     LAB_2564
001658  3               
001658  3               V_PLOT_HIRES_MONO:
001658  3                       JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001658  3                                               ; else do type mismatch
001658  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001658  3                       LDA     Itempl
001658  3                       PHA
001658  3                       LSR     Itemph
001658  3                       ROR     Itempl
001658  3                       LSR     Itemph
001658  3                       ROR     Itempl
001658  3                       LSR     Itemph
001658  3                       ROR     Itempl          ; 8 PIXEL PER BYTE
001658  3                       LDA     Itempl
001658  3                       STA     PTEMPW          ; STORE X COORD IN OFFSET ADDRESS
001658  3                       LDA     #00
001658  3                       STA     PTEMPW+1
001658  3                       STA     PTEMPW1+1
001658  3                       STA     PTEMPW3+1
001658  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001658  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
001658  3                                               ; FIGURE THE BUFFER OFFSET
001658  3                       STX     PTEMPW1         ; STORE Y COORD
001658  3                       STX     PTEMPW3
001658  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001658  3                       JSR     LAB_GTBY        ; GET THE THIRD PARAMETER, RETURN IN X (PATTERN)
001658  3                       TXA
001658  3                       AND     #$01
001658  3                       STA     PTEMP4          ; STORE COLOR IN PTEMP4
001658  3                       LDA     PTEMPW3
001658  3                                               ; MULTIPLY Y COORD BY 35 OR 70 (MONO OR QUAD HIRES)
001658  3                       ASL     PTEMPW1
001658  3                       ROL     PTEMPW1+1       ; *2
001658  3                       LDA     PTEMPW1
001658  3                       STA     PTEMPW2
001658  3                       LDA     PTEMPW1+1
001658  3                       STA     PTEMPW2+1       ; STORE *2 INTO PTEMPW2
001658  3                       ASL     PTEMPW1
001658  3                       ROL     PTEMPW1+1       ; *2 (*4)
001658  3                       ASL     PTEMPW1
001658  3                       ROL     PTEMPW1+1       ; *2 (*8)
001658  3                       ASL     PTEMPW1
001658  3                       ROL     PTEMPW1+1       ; *2 (*16)
001658  3                       ASL     PTEMPW1
001658  3                       ROL     PTEMPW1+1       ; *2 (*32)
001658  3                                               ;
001658  3                                               ; PTEMPW1(Y*35) = PTEMPW1(Y*32)+PTEMPW2(Y*2)+PTEMPW3(Y)
001658  3                       CLC                     ; Clear the Carry flag before the first addition
001658  3                       LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
001658  3                       ADC     PTEMPW2         ; Add the low byte of the second number (plus carry)
001658  3                       STA     PTEMPW1         ; Store the low byte of the result
001658  3               
001658  3                       LDA     PTEMPW1+1       ; Load the high byte of the first number
001658  3                       ADC     PTEMPW2+1       ; Add the high byte of the second number (plus carry from previous op)
001658  3                       STA     PTEMPW1+1       ; Store the high byte of the result
001658  3                       CLC                     ; Clear the Carry flag before the first addition
001658  3                       LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
001658  3                       ADC     PTEMPW3         ; Add the low byte of the second number (plus carry)
001658  3                       STA     PTEMPW1         ; Store the low byte of the result
001658  3               
001658  3                       LDA     PTEMPW1+1       ; Load the high byte of the first number
001658  3                       ADC     PTEMPW3+1       ; Add the high byte of the second number (plus carry from previous op)
001658  3                       STA     PTEMPW1+1       ; Store the high byte of the result
001658  3                                               ;
001658  3                                               ; PTEMPW1 IS NOW THE Y OFFSET
001658  3                                               ; if quad hires double it.
001658  3                       LDA     VIDEOMODE
001658  3                       AND     #$10
001658  3                       CMP     #00
001658  3                       BNE     :+
001658  3                       ASL     PTEMPW1
001658  3                       ROL     PTEMPW1+1       ; *2
001658  3               :
001658  3                                               ; ADD THE X OFFSET
001658  3                       CLC                     ; Clear the Carry flag before the first addition
001658  3                       LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
001658  3                       ADC     PTEMPW          ; Add the low byte of the second number (plus carry)
001658  3                       STA     TEMPW           ; Store the low byte of the result
001658  3               
001658  3                       LDA     PTEMPW1+1       ; Load the high byte of the first number
001658  3                       ADC     PTEMPW+1        ; Add the high byte of the second number (plus carry from previous op)
001658  3                       STA     TEMPW+1         ; Store the high byte of the result
001658  3                                               ; TEMPW IS NOW THE MEMORY ADDRESS
001658  3               
001658  3                       LDA     TEMPW+1         ; OK, LET'S CALCULATE THE BANK
001658  3                       AND     #$F0
001658  3                       LSR     A
001658  3                       LSR     A
001658  3                       LSR     A
001658  3                       LSR     A
001658  3                       CLC
001658  3                       ADC     #$02+VIDEOBANK  ; AREA $2000-?
001658  3                       CMP     #$F8
001658  3                       BCC     V_PLOT_HIRES_COLOR_RANGE1
001658  3                       TAY                     ; VIDEO BANK SHOULD BE IN Y
001658  3                       JSR     PAGE_ENTER
001658  3                       LDA     TEMPW+1
001658  3                       AND     #$0F
001658  3                       ORA     #$A0
001658  3                       STA     TEMPW+1         ; TEMPW NOW REFLECTS MAPPED ADDRESSS
001658  3                       PLA
001658  3                       AND     #$07            ; WHICH BIT?
001658  3                       TAX
001658  3                       LDA     PTEMP4
001658  3                       CMP     #$01
001658  3                       BNE     :+
001658  3                       LDA     HIRES_BIT_LOOKUP_SET,X
001658  3                       LDY     #$00
001658  3                       ORA     (TEMPW),Y
001658  3                       STA     (TEMPW),Y
001658  3                       JSR     PAGE_EXIT
001658  3                       RTS
001658  3               :
001658  3                       LDA     HIRES_BIT_LOOKUP_RESET,X
001658  3                       PHA
001658  3                       LDY     #$00
001658  3                       AND     (TEMPW),Y
001658  3                       STA     (TEMPW),Y
001658  3                       JSR     PAGE_EXIT
001658  3                       RTS
001658  3               V_PLOT_HIRES_COLOR_RANGE1:
001658  3                       JMP     LAB_2564
001658  3               HIRES_BIT_LOOKUP_SET:
001658  3                       .BYTE   %10000000,%01000000,%00100000,%00010000,%00001000,%00000100,%00000010,%00000001
001658  3               HIRES_BIT_LOOKUP_RESET:
001658  3                       .BYTE   %01111111,%10111111,%11011111,%11101111,%11110111,%11111011,%11111101,%11111110
001658  3               
001658  3               ;___V_PATTERN________________________________________________
001658  3               ;
001658  3               ;  DEFINE GRAPHICS PATTERN
001658  3               ;
001658  3               ;  TAKES 10 PARAMETERS
001658  3               ;       PATTERN NUM (0-255)
001658  3               ;       PATTERN DATA (8 BYTES)
001658  3               ;__________________________________________________________
001658  3               LAB_PATTERN
001658  3               V_PATTERN:
001658  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X
001658  3                       TXA
001658  3                       PHA
001658  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001658  3                       JSR     PAGE_ENTER
001658  3                       PLA
001658  3                       STA     VideoCharGenOffset
001658  3                       LDY     #8
001658  3               :
001658  3                       TYA
001658  3                       PHA
001658  3                       JSR     LAB_1C01        ; GET THE NEXT PARAMETER (AFTER ',') OR SYN ERR
001658  3                       JSR     LAB_GTBY        ; GET THE NEXT PARAMETER, RETURN IN X
001658  3                       PLA
001658  3                       TAY
001658  3                       TXA
001658  3                       STA     VideoCharGenData
001658  3                       DEY
001658  3                       CPY     #$00
001658  3                       BNE     :-
001658  3                       JSR     PAGE_EXIT
001658  3                       RTS
001658  3               
001658  3               
001658  3               LAB_LINE:
001658  3                       rts
001658  3                       .ELSE
001658  3               
001658  3               
001658  3               ; ENSURE ALL OF THESE SPECIAL COMMANDS GIVE ERRORS IN NORMAL BASIC
001658  3               LAB_SPEEK:
001658  3               LAB_SPOKE:
001658  3               LAB_SCRCLR:
001658  3               LAB_SCREEN:
001658  3               LAB_PATTERN:
001658  3               LAB_PLOT:
001658  3               LAB_LOCATE:
001658  3               LAB_COLOR:
001658  3               LAB_LINE:
001658  3  A2 02                LDX     #$02            ; error code $02 ("SYNTAX" error)
00165A  3  4C F6 18             JMP     LAB_XERR        ; do error #X, then warm start
00165D  3               
00165D  3                       .ENDIF
00165D  3               
00165D  2                       .INCLUDE "sid.asm"
00165D  3               
00165D  3               
00165D  3                       .IFDEF  MEMORYMAPPEDSCREEN
00165D  3               
00165D  3               PC6502_IO       = $E000
00165D  3               SID_BASE        = PC6502_IO+$100
00165D  3               
00165D  3               ;___SOUND__________________________________________________
00165D  3               ;
00165D  3               ; PLAY SOUND
00165D  3               ;
00165D  3               ;  SOUND VOICE, FREQ, DUTY, WAVEFORM, ATTACK, SUSTAIN, DECAY, RELEASE
00165D  3               ;
00165D  3               ;
00165D  3               ;__________________________________________________________
00165D  3               LAB_SOUND:
00165D  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (VOICE)
00165D  3                       TXA
00165D  3                       AND     #3
00165D  3                       ASL     A
00165D  3                       TAX
00165D  3                       LDA     SIDVOICELOOKUP,X
00165D  3                       STA     TEMPW
00165D  3                       LDA     SIDVOICELOOKUP+1,X
00165D  3                       STA     TEMPW+1
00165D  3                                               ; OK, TEMPW POINTS TO SID REGISTER TO MODIFY
00165D  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
00165D  3                       JSR     LAB_EVNM        ; evaluate expression and check is numeric,
00165D  3                                               ; else do type mismatch
00165D  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
00165D  3                       LDY     #0              ; SET FREQUENCY
00165D  3                       LDA     Itempl
00165D  3                       STA     (TEMPW),Y
00165D  3                       LDA     Itemph
00165D  3                       INX
00165D  3                       STA     (TEMPW),Y
00165D  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
00165D  3                       JSR     LAB_EVNM        ; evaluate expression and check is numeric,
00165D  3                                               ; else do type mismatch
00165D  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
00165D  3                       LDY     #2              ; SET DUTY CYCLE
00165D  3                       LDA     Itempl
00165D  3                       STA     (TEMPW),Y
00165D  3                       LDA     Itemph
00165D  3                       INY
00165D  3                       STA     (TEMPW),Y
00165D  3                       JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
00165D  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (WAVEFORM)
00165D  3                       TXA
00165D  3                       LDY     #4              ; SET WAVEFORM CYCLE
00165D  3                       STA     (TEMPW),Y
00165D  3                       JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
00165D  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (ATTACK)
00165D  3                       TXA
00165D  3                       LSR     A
00165D  3                       LSR     A
00165D  3                       LSR     A
00165D  3                       LSR     A
00165D  3                       STA     PTEMPW
00165D  3                       JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
00165D  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (DECAY)
00165D  3                       TXA
00165D  3                       AND     #$0F
00165D  3                       ORA     PTEMPW
00165D  3                       LDY     #5              ; SET ATTACK/DECAY
00165D  3                       STA     (TEMPW),Y
00165D  3                       JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
00165D  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (SUSTAIN)
00165D  3                       TXA
00165D  3                       LSR     A
00165D  3                       LSR     A
00165D  3                       LSR     A
00165D  3                       LSR     A
00165D  3                       STA     PTEMPW
00165D  3                       JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
00165D  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (RELEASE)
00165D  3                       TXA
00165D  3                       AND     #$0F
00165D  3                       ORA     PTEMPW
00165D  3                       LDY     #6              ; SET SUSTAIN/RELEASE
00165D  3                       STA     (TEMPW),Y
00165D  3                       RTS
00165D  3               SIDVOICELOOKUP:
00165D  3                       .WORD  SID_BASE,SID_BASE+7,SID_BASE+$12
00165D  3               
00165D  3               ;___FILTER_________________________________________________
00165D  3               ;
00165D  3               ; SET SID FILTERS
00165D  3               ;
00165D  3               ;  FILTER CUTOFF, RESONANCE, VOICE 1 ENABLE, VOICE 2 ENABLE, VOICE 3 ENABLE, EXTERNAL ENABLE, FILTER MODE, VOLUME
00165D  3               ;
00165D  3               ;
00165D  3               ;__________________________________________________________
00165D  3               LAB_FILTER:
00165D  3                       JSR     LAB_EVNM        ; evaluate expression and check is numeric,
00165D  3                                               ; else do type mismatch
00165D  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
00165D  3                                               ; SET CUTOFF
00165D  3                       LDA     Itempl
00165D  3                       STA     SID_BASE+$15
00165D  3                       LDA     Itemph
00165D  3                       STA     SID_BASE+$16
00165D  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
00165D  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (RESONANCE)
00165D  3                       TXA
00165D  3                       LSR     A
00165D  3                       LSR     A
00165D  3                       LSR     A
00165D  3                       LSR     A
00165D  3                       STA     PTEMPW
00165D  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
00165D  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 1 ENABLE)
00165D  3                       TXA
00165D  3                       AND     #1
00165D  3                       ORA     PTEMPW
00165D  3                       STA     PTEMPW
00165D  3                       JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
00165D  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 2 ENABLE)
00165D  3                       TXA
00165D  3                       AND     #1
00165D  3                       LSR     A
00165D  3                       ORA     PTEMPW
00165D  3                       STA     PTEMPW
00165D  3                       JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
00165D  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 3 ENABLE)
00165D  3                       TXA
00165D  3                       AND     #1
00165D  3                       LSR     A
00165D  3                       LSR     A
00165D  3                       ORA     PTEMPW
00165D  3                       STA     PTEMPW
00165D  3                       JSR     LAB_1C01        ; GET THE SIXTH PARAMETER (AFTER ',') OR SYN ERR
00165D  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (EXTERNAL AUDIO ENABLE)
00165D  3                       TXA
00165D  3                       AND     #1
00165D  3                       LSR     A
00165D  3                       LSR     A
00165D  3                       LSR     A
00165D  3                       ORA     PTEMPW
00165D  3                       STA     SID_BASE+$17
00165D  3                       JSR     LAB_1C01        ; GET THE SEVENTH PARAMETER (AFTER ',') OR SYN ERR
00165D  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (FILTER MODE)
00165D  3                       TXA
00165D  3                       LSR     A
00165D  3                       LSR     A
00165D  3                       LSR     A
00165D  3                       LSR     A
00165D  3                       STA     PTEMPW
00165D  3                       JSR     LAB_1C01        ; GET THE EIGHTH PARAMETER (AFTER ',') OR SYN ERR
00165D  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOLUME)
00165D  3                       TXA
00165D  3                       AND     #$0F
00165D  3                       ORA     PTEMPW
00165D  3                       STA     SID_BASE+$18
00165D  3                       RTS
00165D  3               
00165D  3                       .ELSE
