00162D  3                       .IFDEF  MEMORYMAPPEDSCREEN
00162D  3               
00162D  3               ;* MEMORY MAP
00162D  3               ;  VIDEO CARD IS A 32K AREA (MAPPED IN BANKS TO $AXXX)
00162D  3               ;  $0x00 0x01=soft_scanline_emulation, 0x02 NO soft_scanline_emulation
00162D  3               ;  $0x01 0x01=page1, 0x02 page2
00162D  3               ;  $0x02  character generator write offset (data << 3)
00162D  3               ;  $0x03 character generator write DATA
00162D  3               ;  $0x04 EXECUTE device command
00162D  3               ;        0x00- reset to the default configuration
00162D  3               ;        0x01- reset to the saved configuration
00162D  3               ;	0x02- save the current configuration
00162D  3               ;
00162D  3               ;  $0x05  0x01=soft_text=true, 0x02=soft_text=false
00162D  3               ;  $0x06 Lores Mode=0X01,NO lores Mode=0x02
00162D  3               ;  $0x07 Double Lores Mode=0X01,NO Double lores Mode=0x02
00162D  3               ;  $0x08 Hires Mode=0X01,NO Hires Mode=0x02
00162D  3               ;  $0x09 Double Hires Mode=0X01,NO Double Hires lores Mode=0x02
00162D  3               ;  $0x0A 80COL Mode=0X01,NO 80COL Mode=0x02
00162D  3               ;  $0x0B MIXED Mode=0X01,NO MIXED Mode=0x02
00162D  3               ;  $0x0C QUAD Hires Mode=0X01,NO QUAD Hires lores Mode=0x02
00162D  3               ;  $0x0D MONO Hires Mode=0X01,NO MONO Hires lores Mode=0x02
00162D  3               ;
00162D  3               ; 	VRAM Memory Map
00162D  3               ;	$1000-$177F	40/80 Text Page 1
00162D  3               ;	$1800-$1F7F	40/80 Color Page 1
00162D  3               ;	$2000-$277F	40/80 Text Page 2
00162D  3               ;	$2800-$2F7F	40/80 Color Page 2
00162D  3               ;	$2000-$5FFF	HIRES PAGE 1
00162D  3               ;	$6000-$8FFF	HIRES PAGE 2
00162D  3               ;	$2000-$BFFF	DOUBLE HIRES
00162D  3               
00162D  3               VIDEOBANK       = $F8
00162D  3               PC6502_IOSPACE  = $EF00
00162D  3               ; PAGER
00162D  3               PC6502_ACT_TASK = PC6502_IOSPACE+$E0
00162D  3               PC6502_MAP_SETUP = PC6502_IOSPACE+$E1
00162D  3               PC6502_MMU_ENA  = PC6502_IOSPACE+$E2
00162D  3               PC6502_MAP_SPACE = PC6502_IOSPACE+$D0
00162D  3               
00162D  3               VideoDisplayPage = $A001
00162D  3               VideoCharGenOffset = $A002
00162D  3               VideoCharGenData = $A003
00162D  3               VideoTextMode   = $A005
00162D  3               VideoLoresMode  = $A006
00162D  3               VideoDoubleLores = $A007
00162D  3               VideoHiresMode  = $A008
00162D  3               VideoDoubleHires = $A009
00162D  3               Video80col      = $A00A
00162D  3               VideoMixedMode  = $A00b
00162D  3               VideoQuadHires  = $A00c
00162D  3               VideoMonoHires  = $A00d
00162D  3               
00162D  3               CURX            = $0647         ; CURRENT CURSOR POSITION (MEMORY MAPPED)
00162D  3               CURY            = $0648
00162D  3               SHOWCRSR        = $0649         ; SHOW CURSOR (1-YES, 0-NO) (MEMORY MAPPED)
00162D  3               CURCOLOR        = $064A         ; CURRENT PRINT COLOR (MEMORY MAPPED)
00162D  3               CSRCOLOR        = $064B         ; CURRENT CURSOR COLOR (MEMORY MAPPED)
00162D  3               BVIDEOMODE      = $064C         ; CURRENT VIDEO MODE (MEMORY MAPPED) 00=40 COL, 01=80 COL
00162D  3               
00162D  3               
00162D  3               VIDEOMODE:
00162D  3                       .BYTE   $00
00162D  3               CLRTMP:
00162D  3                       .BYTE   $00
00162D  3               VIDEOWIDTH:
00162D  3                       .BYTE   80
00162D  3               
00162D  3               PTEMPW:
00162D  3                       .BYTE   $00,$00
00162D  3               PTEMPW1:
00162D  3                       .BYTE   $00,$00
00162D  3               PTEMPW2:
00162D  3                       .BYTE   $00,$00
00162D  3               PTEMPW3:
00162D  3                       .BYTE   $00,$00
00162D  3               PTEMP:
00162D  3                       .BYTE   $00
00162D  3               PTEMP4:
00162D  3                       .BYTE   $00
00162D  3               
00162D  3               
00162D  3               ;___V_SCRCLR________________________________________________
00162D  3               ;
00162D  3               ; CLEAR SCREEN
00162D  3               ;
00162D  3               ;__________________________________________________________
00162D  3               LAB_SCRCLR:
00162D  3               V_SCNCLR:
00162D  3                       STA     DBGA
00162D  3                       STY     DBGY
00162D  3                       STX     DBGX
00162D  3                       LDA     #38
00162D  3                       STA     farfunct
00162D  3                       JSR     DO_FARCALL
00162D  3                       LDA     #59
00162D  3                       STA     farfunct
00162D  3                       JSR     DO_FARCALL
00162D  3                       LDA     DBGA
00162D  3                       LDY     DBGY
00162D  3                       LDX     DBGX
00162D  3                       RTS
00162D  3               
00162D  3               
00162D  3               
00162D  3               ;___V_LOCATE________________________________________________
00162D  3               ;
00162D  3               ; SET CURSOR LOCATION
00162D  3               ;
00162D  3               ;       LOCATE X,Y
00162D  3               ;
00162D  3               ;__________________________________________________________
00162D  3               V_LOCATE:
00162D  3               LAB_LOCATE:
00162D  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (MODE)
00162D  3                       STX     DBGX
00162D  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
00162D  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
00162D  3                       TXA
00162D  3                       TAY
00162D  3                       LDX     DBGX
00162D  3                       LDA     #37
00162D  3                       STA     farfunct
00162D  3                       JSR     DO_FARCALL
00162D  3                       RTS
00162D  3               
00162D  3               ;___V_COLOR_________________________________________________
00162D  3               ;
00162D  3               ; SET COLOR FG,BG,CFG,CBG
00162D  3               ;
00162D  3               ;__________________________________________________________
00162D  3               LAB_COLOR:
00162D  3               V_COLOR:
00162D  3                       LDA     #$00            ; CLEAR TEMP SPACE
00162D  3                       STA     PTEMPW
00162D  3                       STA     PTEMPW+1
00162D  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (MODE)
00162D  3                       TXA
00162D  3                       AND     #$0F
00162D  3                       STA     PTEMPW
00162D  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
00162D  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
00162D  3                       TXA
00162D  3                       ASL     A
00162D  3                       ASL     A
00162D  3                       ASL     A
00162D  3                       ASL     A
00162D  3                       ORA     PTEMPW
00162D  3                       STA     PTEMPW
00162D  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
00162D  3                       JSR     LAB_GTBY        ; GET THE THIRD PARAMETER, RETURN IN X
00162D  3                       TXA
00162D  3                       AND     #$0F
00162D  3                       STA     PTEMPW+1
00162D  3                       JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
00162D  3                       JSR     LAB_GTBY        ; GET THE FOURTH PARAMETER, RETURN IN X
00162D  3                       TXA
00162D  3                       ASL     A
00162D  3                       ASL     A
00162D  3                       ASL     A
00162D  3                       ASL     A
00162D  3                       ORA     PTEMPW+1
00162D  3                       STA     PTEMPW+1
00162D  3                       LDX     PTEMPW
00162D  3                       LDY     PTEMPW+1
00162D  3                       LDA     #39
00162D  3                       STA     farfunct
00162D  3                       JSR     DO_FARCALL
00162D  3                       RTS
00162D  3               
00162D  3               
00162D  3               
00162D  3               ;___V_SPEEK()______________________________________________
00162D  3               ;
00162D  3               ; GET VALUE FROM SCREEN MEMORY
00162D  3               ;
00162D  3               ;  TAKES ONE PARAMETER (ADDRESS), RETURNS VALUE
00162D  3               ;
00162D  3               ;__________________________________________________________
00162D  3               LAB_SPEEK:
00162D  3               V_SPEEK:
00162D  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
00162D  3                       LDA     Itemph
00162D  3                       TAY
00162D  3                       AND     #$0F
00162D  3                       ORA     #$A0
00162D  3                       STA     Itemph
00162D  3                       TYA
00162D  3                       AND     #$F0
00162D  3                       LSR     A
00162D  3                       LSR     A
00162D  3                       LSR     A
00162D  3                       LSR     A
00162D  3                       AND     #$07
00162D  3                       CLC
00162D  3                       ADC     #VIDEOBANK
00162D  3                       TAY
00162D  3                       LDA     #$01            ; MODIFY TASK 01 (DRIVER TASK)
00162D  3                       LDX     #$0A            ; MAP $AXXX
00162D  3                       JSR     SETPAGE         ; CALL SETPAGE
00162D  3                       LDA     #$01
00162D  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 01
00162D  3                       LDY     #0
00162D  3                       LDA     (Itempl),Y
00162D  3                       TAY
00162D  3                       LDA     #$00
00162D  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 00
00162D  3                       JMP     LAB_1FD0        ; convert Y to byte in FAC1 and return
00162D  3               
00162D  3               
00162D  3               
00162D  3               ;___V_SPOKE_________________________________________________
00162D  3               ;
00162D  3               ; PUT VALUE IN SCREEN MEMORY
00162D  3               ;
00162D  3               ;  TAKES TWO PARAMETERS ADDRESS,VALUE
00162D  3               ;
00162D  3               ;__________________________________________________________
00162D  3               LAB_SPOKE:
00162D  3               V_SPOKE:
00162D  3                       JSR     LAB_GADB        ; get two parameters for POKE or WAIT
00162D  3                       TXA                     ; BYTE ARGUMENT IS IN X
00162D  3                       PHA                     ; PUSH BYTE ARGUMENT TO STACK
00162D  3                       LDA     Itemph
00162D  3                       TAY
00162D  3                       AND     #$0F
00162D  3                       ORA     #$A0
00162D  3                       STA     Itemph
00162D  3                       TYA
00162D  3                       AND     #$F0
00162D  3                       LSR     A
00162D  3                       LSR     A
00162D  3                       LSR     A
00162D  3                       LSR     A
00162D  3                       AND     #$07
00162D  3                       CLC
00162D  3                       ADC     #VIDEOBANK
00162D  3                       TAY
00162D  3                       LDA     #$01            ; MODIFY TASK 01 (DRIVER TASK)
00162D  3                       LDX     #$0A            ; MAP $AXXX
00162D  3                       JSR     SETPAGE         ; CALL SETPAGE
00162D  3                       LDA     #$01
00162D  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 01
00162D  3                       LDY     #0
00162D  3                       PLA                     ; PULL BYTE ARGUMENT
00162D  3                       STA     (Itempl),Y
00162D  3                       LDA     #$00
00162D  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 00
00162D  3                       RTS
00162D  3               
00162D  3               ;___V_SCREEN_________________________________________________
00162D  3               ;
00162D  3               ;  SET SCREEN MODE
00162D  3               ;
00162D  3               ;  TAKES UP TO THREE PARAMETERS
00162D  3               ;  FIRST PARAMETER SCREEN MODE
00162D  3               ;  0=TEXT MODE
00162D  3               ;  1=LORES MODE
00162D  3               ;  2=HIRES MODE
00162D  3               ;
00162D  3               ;  TEXT MODE PARAMETERS
00162D  3               ;  0=40 COLUMNS
00162D  3               ;  1=80 COLUMNS
00162D  3               ;
00162D  3               ;  LORES MODE SECOND PARAMETER
00162D  3               ;  0=SINGLE LORES
00162D  3               ;  1=DOUBLE LORES
00162D  3               ;  LORES MODE THIRD PARAMETER
00162D  3               ;  0=MIXED MODE
00162D  3               ;  1=FULL SCREEN MODE
00162D  3               ;
00162D  3               ;  HIRES MODE SECOND PARAMETER
00162D  3               ;  0=SINGLE HIRES
00162D  3               ;  1=DOUBLE HIRES
00162D  3               ;  2=QUAD HIRES
00162D  3               ;  3=MONO HIRES
00162D  3               ;  HIRES MODE THIRD PARAMETER
00162D  3               ;  1=MIXED MODE
00162D  3               ;  0=FULL SCREEN MODE
00162D  3               ;
00162D  3               ;__________________________________________________________
00162D  3               LAB_SCREEN:
00162D  3               V_SCREEN:
00162D  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (MODE)
00162D  3               V_SCREEN1:
00162D  3                       STX     VIDEOMODE
00162D  3                       CPX     #00
00162D  3                       BNE     *+5
00162D  3                       JMP     SETUPMODE0
00162D  3                       CPX     #01
00162D  3                       BNE     *+5
00162D  3                       JMP     SETUPMODE1
00162D  3                       CPX     #02
00162D  3                       BNE     *+5
00162D  3                       JMP     SETUPMODE2
00162D  3               
00162D  3                       LDX     #$02            ; SYNTAX ERROR
00162D  3                       JSR     LAB_XERR
00162D  3                       JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
00162D  3                       RTS
00162D  3               
00162D  3               SETUPMODE0:                     ; TEXT MODE
00162D  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00162D  3                       JSR     PAGE_ENTER
00162D  3                       LDA     #$01
00162D  3                       STA     VideoTextMode
00162D  3                       LDA     #$02
00162D  3                       STA     VideoLoresMode
00162D  3                       STA     VideoHiresMode
00162D  3                       JSR     PAGE_EXIT
00162D  3               
00162D  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
00162D  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
00162D  3                       CPX     #$00
00162D  3                       BNE     SETUPMODE0_80
00162D  3               
00162D  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00162D  3                       JSR     PAGE_ENTER
00162D  3                       LDA     #$02
00162D  3                       STA     Video80col
00162D  3                       JSR     PAGE_EXIT
00162D  3                       LDA     #40
00162D  3                       STA     VIDEOWIDTH
00162D  3                       LDA     #0
00162D  3                       STA     BVIDEOMODE
00162D  3                       JMP     SETUPMODE0_CLEAR
00162D  3               SETUPMODE0_80:
00162D  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00162D  3                       JSR     PAGE_ENTER
00162D  3                       LDA     #$01
00162D  3                       STA     Video80col
00162D  3                       JSR     PAGE_EXIT
00162D  3                       LDA     #80
00162D  3                       STA     VIDEOWIDTH
00162D  3                       LDA     #1
00162D  3                       STA     BVIDEOMODE
00162D  3               SETUPMODE0_CLEAR:
00162D  3                       JMP     V_SCNCLR
00162D  3                       RTS
00162D  3               
00162D  3               SETUPMODE1:                     ; LORES MODE
00162D  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00162D  3                       JSR     PAGE_ENTER
00162D  3                       LDA     #$01
00162D  3                       STA     VideoLoresMode
00162D  3                       LDA     #$02
00162D  3                       STA     VideoTextMode
00162D  3                       STA     VideoHiresMode
00162D  3                       JSR     PAGE_EXIT
00162D  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
00162D  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
00162D  3               
00162D  3                       CPX     #$00
00162D  3                       BNE     SETUPMODE1_DOUBLE
00162D  3               
00162D  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00162D  3                       JSR     PAGE_ENTER
00162D  3                       LDA     #$02
00162D  3                       STA     VideoDoubleLores
00162D  3                       JSR     PAGE_EXIT
00162D  3                       JMP     SETUPMODE1_CLEAR
00162D  3               SETUPMODE1_DOUBLE:
00162D  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00162D  3                       JSR     PAGE_ENTER
00162D  3                       LDA     #$01
00162D  3                       STA     VideoDoubleLores
00162D  3                       JSR     PAGE_EXIT
00162D  3                       LDA     #$11
00162D  3                       STA     VIDEOMODE
00162D  3               SETUPMODE1_CLEAR:               ;    ($2000-$2800)
00162D  3                       LDY     #$02+VIDEOBANK  ; AREA $2000-$2FFF
00162D  3                       JSR     PAGE_ENTER
00162D  3                       LDA     #$00
00162D  3                       STA     TEMPW
00162D  3                       LDA     #$A0
00162D  3                       STA     TEMPW+1
00162D  3                       LDY     #$00
00162D  3                       LDA     #$00
00162D  3               :
00162D  3                       STA     (TEMPW),Y
00162D  3                       INC     TEMPW
00162D  3                       BNE     :-
00162D  3                       INC     TEMPW+1
00162D  3               
00162D  3                       LDX     TEMPW+1
00162D  3                       CPX     #$A8
00162D  3                       BNE     :-
00162D  3                       JSR     PAGE_EXIT
00162D  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
00162D  3                       JSR     LAB_GTBY        ; GET THE THIRD PARAMETER, RETURN IN X
00162D  3                       CPX     #$00
00162D  3                       BNE     SETUPMODE1_MIXED
00162D  3               
00162D  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00162D  3                       JSR     PAGE_ENTER
00162D  3                       LDA     #$02
00162D  3                       STA     VideoMixedMode
00162D  3                       JSR     PAGE_EXIT
00162D  3                       RTS
00162D  3               SETUPMODE1_MIXED:
00162D  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00162D  3                       JSR     PAGE_ENTER
00162D  3                       LDA     #$01
00162D  3                       STA     VideoMixedMode
00162D  3                       JSR     PAGE_EXIT
00162D  3                       LDA     VIDEOMODE
00162D  3                       ORA     #$80
00162D  3                       STA     VIDEOMODE
00162D  3                       RTS
00162D  3               
00162D  3               
00162D  3               SETUPMODE2:                     ; HIRES MODE
00162D  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00162D  3                       JSR     PAGE_ENTER
00162D  3                       LDA     #$01
00162D  3                       STA     VideoHiresMode
00162D  3                       LDA     #$02
00162D  3                       STA     VideoTextMode
00162D  3                       STA     VideoLoresMode
00162D  3                       JSR     PAGE_EXIT
00162D  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
00162D  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
00162D  3               
00162D  3                       CPX     #$00
00162D  3                       BNE     SETUPMODE2_DOUBLE
00162D  3               
00162D  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00162D  3                       JSR     PAGE_ENTER
00162D  3                       LDA     #$02
00162D  3                       STA     VideoDoubleHires
00162D  3                       STA     VideoQuadHires
00162D  3                       STA     VideoMonoHires
00162D  3                       JSR     PAGE_EXIT
00162D  3                       JMP     SETUPMODE2_CLEAR
00162D  3               SETUPMODE2_DOUBLE:
00162D  3                       CPX     #$01
00162D  3                       BNE     SETUPMODE2_QUAD
00162D  3               
00162D  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00162D  3                       JSR     PAGE_ENTER
00162D  3                       LDA     #$01
00162D  3                       STA     VideoDoubleHires
00162D  3                       LDA     #$02
00162D  3                       STA     VideoQuadHires
00162D  3                       STA     VideoMonoHires
00162D  3                       JSR     PAGE_EXIT
00162D  3                       LDA     #$12
00162D  3                       STA     VIDEOMODE
00162D  3                       JMP     SETUPMODE2_CLEAR
00162D  3               SETUPMODE2_QUAD:
00162D  3                       CPX     #$02
00162D  3                       BNE     SETUPMODE2_MONO
00162D  3               
00162D  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00162D  3                       JSR     PAGE_ENTER
00162D  3                       LDA     #$01
00162D  3                       STA     VideoQuadHires
00162D  3                       LDA     #$02
00162D  3                       STA     VideoDoubleHires
00162D  3                       STA     VideoMonoHires
00162D  3                       JSR     PAGE_EXIT
00162D  3                       LDA     #$22
00162D  3                       STA     VIDEOMODE
00162D  3                       JMP     SETUPMODE2_CLEAR
00162D  3               SETUPMODE2_MONO:
00162D  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00162D  3                       JSR     PAGE_ENTER
00162D  3                       LDA     #$01
00162D  3                       STA     VideoMonoHires
00162D  3                       LDA     #$02
00162D  3                       STA     VideoDoubleHires
00162D  3                       STA     VideoQuadHires
00162D  3                       JSR     PAGE_EXIT
00162D  3                       LDA     #$32
00162D  3                       STA     VIDEOMODE
00162D  3               
00162D  3               SETUPMODE2_CLEAR:               ; ($2000-$7FFF)
00162D  3                       LDY     #$02+VIDEOBANK
00162D  3                       STY     CLRTMP
00162D  3               
00162D  3               :
00162D  3                       LDY     CLRTMP
00162D  3                       JSR     PAGE_ENTER
00162D  3               
00162D  3                       LDA     #$00
00162D  3                       TAY
00162D  3                       STA     TEMPW
00162D  3                       LDA     #$A0
00162D  3                       STA     TEMPW+1
00162D  3                       LDA     #$00
00162D  3               :
00162D  3                       STA     (TEMPW),Y
00162D  3                       INC     TEMPW
00162D  3                       BNE     :-
00162D  3                       INC     TEMPW+1
00162D  3                       LDX     TEMPW+1
00162D  3                       CPX     #$B0
00162D  3                       BNE     :-
00162D  3                       LDX     #$A0
00162D  3                       INC     CLRTMP
00162D  3                       LDX     CLRTMP
00162D  3                       CPX     #$00
00162D  3                       BNE     :--
00162D  3                       JSR     PAGE_EXIT
00162D  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
00162D  3                       JSR     LAB_GTBY        ; GET THE THIRD PARAMETER, RETURN IN X
00162D  3                       CPX     #$00
00162D  3                       BNE     SETUPMODE2_MIXED
00162D  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00162D  3                       JSR     PAGE_ENTER
00162D  3                       LDA     #$02
00162D  3                       STA     VideoMixedMode
00162D  3                       JSR     PAGE_EXIT
00162D  3                       RTS
00162D  3               SETUPMODE2_MIXED:
00162D  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00162D  3                       JSR     PAGE_ENTER
00162D  3                       LDA     #$01
00162D  3                       STA     VideoMixedMode
00162D  3                       JSR     PAGE_EXIT
00162D  3                       LDA     VIDEOMODE
00162D  3                       ORA     #$80
00162D  3                       STA     VIDEOMODE
00162D  3                       RTS
00162D  3               
00162D  3               
00162D  3               
00162D  3               PAGE_EXIT:
00162D  3                       LDA     #$00
00162D  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 00
00162D  3                       RTS
00162D  3               
00162D  3               PAGE_ENTER:
00162D  3               ; Set "Y" register to video page ($YXXX)
00162D  3                       LDA     #$01            ; MODIFY TASK 01 (DRIVER TASK)
00162D  3                       LDX     #$0A            ; MAP $AXXX
00162D  3                       JSR     SETPAGE         ; CALL SETPAGE
00162D  3                       LDA     #$01
00162D  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 01
00162D  3                       RTS
00162D  3               
00162D  3               ;___V_PLOT__________________________________________________
00162D  3               ;
00162D  3               ;  PLOT ON SCREEN
00162D  3               ;         TAKES THREE PARAMETERS,  X,Y,COLOR
00162D  3               ;
00162D  3               ;__________________________________________________________
00162D  3               LAB_PLOT:
00162D  3               V_PLOT:
00162D  3                       LDA     VIDEOMODE
00162D  3                       AND     #$0F
00162D  3                       CMP     #$01
00162D  3                       BEQ     V_PLOT_LORES
00162D  3                       LDA     VIDEOMODE
00162D  3                       AND     #$2F
00162D  3                       CMP     #$02
00162D  3                       BNE     :+
00162D  3                       JMP     V_PLOT_HIRES_COLOR
00162D  3               :
00162D  3                       CMP     #$22
00162D  3                       BNE     :+
00162D  3                       JMP     V_PLOT_HIRES_MONO
00162D  3               :
00162D  3                       RTS
00162D  3               
00162D  3               V_PLOT_LORES:
00162D  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X
00162D  3                       STX     PTEMPW          ; STORE X COORD IN OFFSET ADDRESS
00162D  3                       LDA     #00
00162D  3                       STA     PTEMPW+1
00162D  3                       STA     PTEMPW1+1
00162D  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
00162D  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
00162D  3                                               ; FIGURE THE BUFFER OFFSET
00162D  3                       TXA                     ; Y COORD IN X
00162D  3                       PHA
00162D  3                       LSR     A               ; 2 LINES PER BYTE
00162D  3                       STA     PTEMPW1
00162D  3                                               ; MULTIPLY Y (PTEMPW) COORD BY 40 OR 80 (SINGLE OR DOUBLE LORES)
00162D  3                       CLC
00162D  3                       ASL     PTEMPW1
00162D  3                       ROL     PTEMPW1+1       ; *2
00162D  3                       ASL     PTEMPW1
00162D  3                       ROL     PTEMPW1+1       ; *2 (*4)
00162D  3                       ASL     PTEMPW1
00162D  3                       ROL     PTEMPW1+1       ; *2 (*8)
00162D  3                       LDA     PTEMPW1
00162D  3                       STA     PTEMPW2
00162D  3                       LDA     PTEMPW1+1
00162D  3                       STA     PTEMPW2+1       ; STORE Y*8 INTO PTEMPW2
00162D  3                       ASL     PTEMPW1
00162D  3                       ROL     PTEMPW1+1       ; *2 (*16)
00162D  3                       ASL     PTEMPW1
00162D  3                       ROL     PTEMPW1+1       ; *2 (*32)
00162D  3                                               ; NOW TAKE Y*8(PTEMPW2) + Y*32(PTEMPW1) == Y*40 STORE IN PTEMPW1
00162D  3                       CLC                     ; Clear the Carry flag before the first addition
00162D  3               
00162D  3                       LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
00162D  3                       ADC     PTEMPW2         ; Add the low byte of the second number (plus carry)
00162D  3                       STA     PTEMPW1         ; Store the low byte of the result
00162D  3               
00162D  3                       LDA     PTEMPW1+1       ; Load the high byte of the first number
00162D  3                       ADC     PTEMPW2+1       ; Add the high byte of the second number (plus carry from previous op)
00162D  3                       STA     PTEMPW1+1       ; Store the high byte of the result
00162D  3               
00162D  3               ; if double lores columns double it.
00162D  3                       LDA     VIDEOMODE
00162D  3                       AND     #$10
00162D  3                       CMP     #00
00162D  3                       BEQ     :+
00162D  3                       ASL     PTEMPW1
00162D  3                       ROL     PTEMPW1+1       ; *2
00162D  3               :
00162D  3                                               ; OK, Y OFFSET IS IN PTEMPW1, X IS IN PTEMPW
00162D  3                       LDA     #$A0            ; ADD THE MEMORY OFFSET TO PTEMPW (BECAUSE IT IS EASY)
00162D  3                       STA     PTEMPW+1        ; THEN ADD PTEMPW1 TO PTEMPW THAT SHOULD BE THE MEMORY ADDRESS TO UPDATE
00162D  3                                               ;
00162D  3                       CLC                     ; Clear the Carry flag before the first addition
00162D  3                       LDA     PTEMPW          ; Load the low byte of the first number into the accumulator
00162D  3                       ADC     PTEMPW1         ; Add the low byte of the second number (plus carry)
00162D  3                       STA     TEMPW           ; Store the low byte of the result
00162D  3               
00162D  3                       LDA     PTEMPW+1        ; Load the high byte of the first number
00162D  3                       ADC     PTEMPW1+1       ; Add the high byte of the second number (plus carry from previous op)
00162D  3                       STA     TEMPW+1         ; Store the high byte of the result
00162D  3                                               ; PTEMPW IS THE MEMORY OFFSET TO UPDATE
00162D  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
00162D  3                       JSR     LAB_GTBY        ; GET THE THIRD PARAMETER, RETURN IN X (PATTERN)
00162D  3                       TXA
00162D  3                       AND     #$0F
00162D  3                       STA     PTEMP           ; SAVE COLOR IN PTEMP
00162D  3                       PLA
00162D  3                       LSR     A               ; TOP OR BOTTOM PIXEL?
00162D  3                       BCC     :+
00162D  3                                               ; TOP PIXEL
00162D  3                       LDY     #$02+VIDEOBANK  ; AREA $2000-$2FFF
00162D  3                       JSR     PAGE_ENTER
00162D  3                       LDY     #$00
00162D  3                       LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
00162D  3                       AND     #$0F
00162D  3                       PHA
00162D  3                       LDA     PTEMP
00162D  3                       ASL     A
00162D  3                       ASL     A
00162D  3                       ASL     A
00162D  3                       ASL     A
00162D  3                       STA     PTEMP
00162D  3                       PLA
00162D  3                       ORA     PTEMP
00162D  3                       STA     (TEMPW),Y       ; STORE  DOUBLE PIXEL
00162D  3                       JSR     PAGE_EXIT
00162D  3                       RTS
00162D  3               :
00162D  3                                               ; BOTTOM PIXEL
00162D  3                       LDY     #$02+VIDEOBANK  ; AREA $2000-$2FFF
00162D  3                       JSR     PAGE_ENTER
00162D  3                       LDY     #$00
00162D  3                       LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
00162D  3                       AND     #$F0
00162D  3                       ORA     PTEMP
00162D  3                       STA     (TEMPW),Y       ; STORE  DOUBLE PIXEL
00162D  3                       JSR     PAGE_EXIT
00162D  3                       RTS
00162D  3               
00162D  3               V_PLOT_HIRES_COLOR:
00162D  3                       JSR     LAB_EVNM        ; evaluate expression and check is numeric,
00162D  3               ; else do type mismatch
00162D  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
00162D  3                       LDA     Itemph
00162D  3                       STA     PTEMPW+1
00162D  3                       LDA     Itempl
00162D  3                       PHA                     ; PUSH LOW BYTE OF X (FOR EVEN/ODD LATER)
00162D  3                       LSR     Itemph
00162D  3                       ROR     Itempl          ; 2 PIXEL PER BYTE
00162D  3                       LDA     Itempl          ;
00162D  3                       STA     PTEMPW          ;
00162D  3                       LDA     Itemph          ;
00162D  3                       STA     PTEMPW+1        ; STORE X COORD IN OFFSET ADDRESS;
00162D  3                       LDA     #$00
00162D  3                       STA     PTEMPW1+1
00162D  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
00162D  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
00162D  3                                               ; FIGURE THE BUFFER OFFSET
00162D  3                       LDA     #$00
00162D  3                       TXA                     ; GET Y COORD
00162D  3                       STX     PTEMPW1
00162D  3               
00162D  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
00162D  3                       JSR     LAB_GTBY        ; GET THE THIRD PARAMETER, RETURN IN X (PATTERN)
00162D  3                       TXA
00162D  3                       AND     #$0F
00162D  3                       STA     PTEMP4          ; SAVE COLOR IN PTEMP4
00162D  3                       CLC                     ; MULTIPLY Y COORD BY 70 OR 140 (SINGLE OR DOUBLE HIRES)
00162D  3                       ASL     PTEMPW1
00162D  3                       ROL     PTEMPW1+1       ; *2
00162D  3                       LDA     PTEMPW1
00162D  3                       STA     PTEMPW2
00162D  3                       LDA     PTEMPW1+1
00162D  3                       STA     PTEMPW2+1       ; STORE Y*2 INTO PTEMPW2
00162D  3                       ASL     PTEMPW1
00162D  3                       ROL     PTEMPW1+1       ; *2 (*4)
00162D  3                       LDA     PTEMPW1
00162D  3                       STA     PTEMPW3
00162D  3                       LDA     PTEMPW1+1
00162D  3                       STA     PTEMPW3+1       ; STORE Y*4 INTO PTEMPW3
00162D  3                       ASL     PTEMPW1
00162D  3                       ROL     PTEMPW1+1       ; *2 (*8)
00162D  3                       ASL     PTEMPW1
00162D  3                       ROL     PTEMPW1+1       ; *2 (*16)
00162D  3                       ASL     PTEMPW1
00162D  3                       ROL     PTEMPW1+1       ; *2 (*32)
00162D  3                       ASL     PTEMPW1
00162D  3                       ROL     PTEMPW1+1       ; *2 (*64)
00162D  3                                               ; RESULT OFFSET PTEMPW1 = PTEMPW1(Y*64)+PTEMPW2(Y*2)+PTEMPW3(Y*4)
00162D  3                       CLC                     ; Clear the Carry flag before the first addition
00162D  3                       LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
00162D  3                       ADC     PTEMPW2         ; Add the low byte of the second number (plus carry)
00162D  3                       STA     PTEMPW1         ; Store the low byte of the result
00162D  3                       LDA     PTEMPW1+1       ; Load the high byte of the first number
00162D  3                       ADC     PTEMPW2+1       ; Add the high byte of the second number (plus carry from previous op)
00162D  3                       STA     PTEMPW1+1       ; Store the high byte of the result
00162D  3               
00162D  3                       CLC                     ; Clear the Carry flag before the first addition
00162D  3                       LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
00162D  3                       ADC     PTEMPW3         ; Add the low byte of the second number (plus carry)
00162D  3                       STA     PTEMPW1         ; Store the low byte of the result
00162D  3                       LDA     PTEMPW1+1       ; Load the high byte of the first number
00162D  3                       ADC     PTEMPW3+1       ; Add the high byte of the second number (plus carry from previous op)
00162D  3                       STA     PTEMPW1+1       ; Store the high byte of the result
00162D  3               
00162D  3               ; if double hires double it.
00162D  3                       LDA     VIDEOMODE
00162D  3                       AND     #$10
00162D  3                       CMP     #00
00162D  3                       BEQ     :+
00162D  3                       ASL     PTEMPW1
00162D  3                       ROL     PTEMPW1+1       ; *2
00162D  3               :
00162D  3                                               ; PTEMPW1 IS NOW Y OFFSET, ADD X OFFSET FOR MEMORY ADDRESS INTO TEMPW
00162D  3                       CLC                     ; Clear the Carry flag before the first addition
00162D  3                       LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
00162D  3                       ADC     PTEMPW          ; Add the low byte of the second number (plus carry)
00162D  3                       STA     TEMPW           ; Store the low byte of the result
00162D  3                       LDA     PTEMPW1+1       ; Load the high byte of the first number
00162D  3                       ADC     PTEMPW+1        ; Add the high byte of the second number (plus carry from previous op)
00162D  3                       STA     TEMPW+1         ; Store the high byte of the result
00162D  3               
00162D  3                       LDA     TEMPW+1         ; OK, LET'S CALCULATE THE BANK
00162D  3                       AND     #$F0
00162D  3                       LSR     A
00162D  3                       LSR     A
00162D  3                       LSR     A
00162D  3                       LSR     A
00162D  3                       CLC
00162D  3                       ADC     #$02+VIDEOBANK  ; AREA $2000-?
00162D  3                       CMP     #$F8
00162D  3                       BCC     V_PLOT_HIRES_COLOR_RANGE
00162D  3                       TAY                     ; VIDEO BANK SHOULD BE IN Y
00162D  3                       JSR     PAGE_ENTER
00162D  3               
00162D  3                       LDA     TEMPW+1
00162D  3                       AND     #$0F
00162D  3                       ORA     #$A0
00162D  3                       STA     TEMPW+1         ; TEMPW NOW REFLECTS MAPPED ADDRESSS
00162D  3                       PLA
00162D  3                       LSR     A               ; LEFT OR RIGHT PIXEL?
00162D  3                       BCS     :+
00162D  3                                               ; LEFT PIXEL
00162D  3                       LDY     #$00
00162D  3                       LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
00162D  3                       AND     #$0F
00162D  3                       PHA
00162D  3                       LDA     PTEMP4
00162D  3                       ASL     A
00162D  3                       ASL     A
00162D  3                       ASL     A
00162D  3                       ASL     A
00162D  3                       STA     PTEMP4
00162D  3                       PLA
00162D  3                       ORA     PTEMP4
00162D  3                       STA     (TEMPW),Y       ; WRITE THE PIXEL BACK OUT
00162D  3                       JSR     PAGE_EXIT
00162D  3                       RTS
00162D  3               :
00162D  3               ; RIGHT PIXEL
00162D  3                       LDY     #$00
00162D  3                       LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
00162D  3                       AND     #$F0
00162D  3                       ORA     PTEMP4
00162D  3                       STA     (TEMPW),Y       ; WRITE THE PIXEL BACK OUT
00162D  3                       JSR     PAGE_EXIT
00162D  3                       RTS
00162D  3               
00162D  3               V_PLOT_HIRES_COLOR_RANGE:
00162D  3                       JMP     LAB_2564
00162D  3               
00162D  3               V_PLOT_HIRES_MONO:
00162D  3                       JSR     LAB_EVNM        ; evaluate expression and check is numeric,
00162D  3                                               ; else do type mismatch
00162D  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
00162D  3                       LDA     Itempl
00162D  3                       PHA
00162D  3                       LSR     Itemph
00162D  3                       ROR     Itempl
00162D  3                       LSR     Itemph
00162D  3                       ROR     Itempl
00162D  3                       LSR     Itemph
00162D  3                       ROR     Itempl          ; 8 PIXEL PER BYTE
00162D  3                       LDA     Itempl
00162D  3                       STA     PTEMPW          ; STORE X COORD IN OFFSET ADDRESS
00162D  3                       LDA     #00
00162D  3                       STA     PTEMPW+1
00162D  3                       STA     PTEMPW1+1
00162D  3                       STA     PTEMPW3+1
00162D  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
00162D  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
00162D  3                                               ; FIGURE THE BUFFER OFFSET
00162D  3                       STX     PTEMPW1         ; STORE Y COORD
00162D  3                       STX     PTEMPW3
00162D  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
00162D  3                       JSR     LAB_GTBY        ; GET THE THIRD PARAMETER, RETURN IN X (PATTERN)
00162D  3                       TXA
00162D  3                       AND     #$01
00162D  3                       STA     PTEMP4          ; STORE COLOR IN PTEMP4
00162D  3                       LDA     PTEMPW3
00162D  3                                               ; MULTIPLY Y COORD BY 35 OR 70 (MONO OR QUAD HIRES)
00162D  3                       ASL     PTEMPW1
00162D  3                       ROL     PTEMPW1+1       ; *2
00162D  3                       LDA     PTEMPW1
00162D  3                       STA     PTEMPW2
00162D  3                       LDA     PTEMPW1+1
00162D  3                       STA     PTEMPW2+1       ; STORE *2 INTO PTEMPW2
00162D  3                       ASL     PTEMPW1
00162D  3                       ROL     PTEMPW1+1       ; *2 (*4)
00162D  3                       ASL     PTEMPW1
00162D  3                       ROL     PTEMPW1+1       ; *2 (*8)
00162D  3                       ASL     PTEMPW1
00162D  3                       ROL     PTEMPW1+1       ; *2 (*16)
00162D  3                       ASL     PTEMPW1
00162D  3                       ROL     PTEMPW1+1       ; *2 (*32)
00162D  3                                               ;
00162D  3                                               ; PTEMPW1(Y*35) = PTEMPW1(Y*32)+PTEMPW2(Y*2)+PTEMPW3(Y)
00162D  3                       CLC                     ; Clear the Carry flag before the first addition
00162D  3                       LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
00162D  3                       ADC     PTEMPW2         ; Add the low byte of the second number (plus carry)
00162D  3                       STA     PTEMPW1         ; Store the low byte of the result
00162D  3               
00162D  3                       LDA     PTEMPW1+1       ; Load the high byte of the first number
00162D  3                       ADC     PTEMPW2+1       ; Add the high byte of the second number (plus carry from previous op)
00162D  3                       STA     PTEMPW1+1       ; Store the high byte of the result
00162D  3                       CLC                     ; Clear the Carry flag before the first addition
00162D  3                       LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
00162D  3                       ADC     PTEMPW3         ; Add the low byte of the second number (plus carry)
00162D  3                       STA     PTEMPW1         ; Store the low byte of the result
00162D  3               
00162D  3                       LDA     PTEMPW1+1       ; Load the high byte of the first number
00162D  3                       ADC     PTEMPW3+1       ; Add the high byte of the second number (plus carry from previous op)
00162D  3                       STA     PTEMPW1+1       ; Store the high byte of the result
00162D  3                                               ;
00162D  3                                               ; PTEMPW1 IS NOW THE Y OFFSET
00162D  3                                               ; if quad hires double it.
00162D  3                       LDA     VIDEOMODE
00162D  3                       AND     #$10
00162D  3                       CMP     #00
00162D  3                       BNE     :+
00162D  3                       ASL     PTEMPW1
00162D  3                       ROL     PTEMPW1+1       ; *2
00162D  3               :
00162D  3                                               ; ADD THE X OFFSET
00162D  3                       CLC                     ; Clear the Carry flag before the first addition
00162D  3                       LDA     PTEMPW1         ; Load the low byte of the first number into the accumulator
00162D  3                       ADC     PTEMPW          ; Add the low byte of the second number (plus carry)
00162D  3                       STA     TEMPW           ; Store the low byte of the result
00162D  3               
00162D  3                       LDA     PTEMPW1+1       ; Load the high byte of the first number
00162D  3                       ADC     PTEMPW+1        ; Add the high byte of the second number (plus carry from previous op)
00162D  3                       STA     TEMPW+1         ; Store the high byte of the result
00162D  3                                               ; TEMPW IS NOW THE MEMORY ADDRESS
00162D  3               
00162D  3                       LDA     TEMPW+1         ; OK, LET'S CALCULATE THE BANK
00162D  3                       AND     #$F0
00162D  3                       LSR     A
00162D  3                       LSR     A
00162D  3                       LSR     A
00162D  3                       LSR     A
00162D  3                       CLC
00162D  3                       ADC     #$02+VIDEOBANK  ; AREA $2000-?
00162D  3                       CMP     #$F8
00162D  3                       BCC     V_PLOT_HIRES_COLOR_RANGE1
00162D  3                       TAY                     ; VIDEO BANK SHOULD BE IN Y
00162D  3                       JSR     PAGE_ENTER
00162D  3                       LDA     TEMPW+1
00162D  3                       AND     #$0F
00162D  3                       ORA     #$A0
00162D  3                       STA     TEMPW+1         ; TEMPW NOW REFLECTS MAPPED ADDRESSS
00162D  3                       PLA
00162D  3                       AND     #$07            ; WHICH BIT?
00162D  3                       TAX
00162D  3                       LDA     PTEMP4
00162D  3                       CMP     #$01
00162D  3                       BNE     :+
00162D  3                       LDA     HIRES_BIT_LOOKUP_SET,X
00162D  3                       LDY     #$00
00162D  3                       ORA     (TEMPW),Y
00162D  3                       STA     (TEMPW),Y
00162D  3                       JSR     PAGE_EXIT
00162D  3                       RTS
00162D  3               :
00162D  3                       LDA     HIRES_BIT_LOOKUP_RESET,X
00162D  3                       PHA
00162D  3                       LDY     #$00
00162D  3                       AND     (TEMPW),Y
00162D  3                       STA     (TEMPW),Y
00162D  3                       JSR     PAGE_EXIT
00162D  3                       RTS
00162D  3               V_PLOT_HIRES_COLOR_RANGE1:
00162D  3                       JMP     LAB_2564
00162D  3               HIRES_BIT_LOOKUP_SET:
00162D  3                       .BYTE   %10000000,%01000000,%00100000,%00010000,%00001000,%00000100,%00000010,%00000001
00162D  3               HIRES_BIT_LOOKUP_RESET:
00162D  3                       .BYTE   %01111111,%10111111,%11011111,%11101111,%11110111,%11111011,%11111101,%11111110
00162D  3               
00162D  3               ;___V_PATTERN________________________________________________
00162D  3               ;
00162D  3               ;  DEFINE GRAPHICS PATTERN
00162D  3               ;
00162D  3               ;  TAKES 10 PARAMETERS
00162D  3               ;       PATTERN NUM (0-255)
00162D  3               ;       PATTERN DATA (8 BYTES)
00162D  3               ;__________________________________________________________
00162D  3               LAB_PATTERN
00162D  3               V_PATTERN:
00162D  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X
00162D  3                       TXA
00162D  3                       PHA
00162D  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
00162D  3                       JSR     PAGE_ENTER
00162D  3                       PLA
00162D  3                       STA     VideoCharGenOffset
00162D  3                       LDY     #8
00162D  3               :
00162D  3                       TYA
00162D  3                       PHA
00162D  3                       JSR     LAB_1C01        ; GET THE NEXT PARAMETER (AFTER ',') OR SYN ERR
00162D  3                       JSR     LAB_GTBY        ; GET THE NEXT PARAMETER, RETURN IN X
00162D  3                       PLA
00162D  3                       TAY
00162D  3                       TXA
00162D  3                       STA     VideoCharGenData
00162D  3                       DEY
00162D  3                       CPY     #$00
00162D  3                       BNE     :-
00162D  3                       JSR     PAGE_EXIT
00162D  3                       RTS
00162D  3               
00162D  3               
00162D  3               LAB_LINE:
00162D  3                       RTS
00162D  3                       .ELSE
00162D  3               
00162D  3               
00162D  3               ; ENSURE ALL OF THESE SPECIAL COMMANDS GIVE ERRORS IN NORMAL BASIC
00162D  3               LAB_SPEEK:
00162D  3               LAB_SPOKE:
00162D  3               LAB_SCRCLR:
00162D  3               LAB_SCREEN:
00162D  3               LAB_PATTERN:
00162D  3               LAB_PLOT:
00162D  3               LAB_LOCATE:
00162D  3               LAB_COLOR:
00162D  3               LAB_LINE:
00162D  3  A2 02                LDX     #$02            ; error code $02 ("SYNTAX" error)
00162F  3  4C CB 18             JMP     LAB_XERR        ; do error #X, then warm start
001632  3               
001632  3                       .ENDIF
001632  3               
001632  2                       .INCLUDE "sid.asm"
001632  3               
001632  3               
001632  3                       .IFDEF  MEMORYMAPPEDSCREEN
001632  3               
001632  3               PC6502_IO       = $E000
001632  3               SID_BASE        = PC6502_IO+$100
001632  3               
001632  3               ;___SOUND__________________________________________________
001632  3               ;
001632  3               ; PLAY SOUND
001632  3               ;
001632  3               ;  SOUND VOICE, FREQ, DUTY, WAVEFORM, ATTACK, SUSTAIN, DECAY, RELEASE
001632  3               ;
001632  3               ;
001632  3               ;__________________________________________________________
001632  3               LAB_SOUND:
001632  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (VOICE)
001632  3                       TXA
001632  3                       AND     #3
001632  3                       ASL     A
001632  3                       TAX
001632  3                       LDA     SIDVOICELOOKUP,X
001632  3                       STA     TEMPW
001632  3                       LDA     SIDVOICELOOKUP+1,X
001632  3                       STA     TEMPW+1
001632  3                                               ; OK, TEMPW POINTS TO SID REGISTER TO MODIFY
001632  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001632  3                       JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001632  3                                               ; else do type mismatch
001632  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001632  3                       LDY     #0              ; SET FREQUENCY
001632  3                       LDA     Itempl
001632  3                       STA     (TEMPW),Y
001632  3                       LDA     Itemph
001632  3                       INX
001632  3                       STA     (TEMPW),Y
001632  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001632  3                       JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001632  3                                               ; else do type mismatch
001632  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001632  3                       LDY     #2              ; SET DUTY CYCLE
001632  3                       LDA     Itempl
001632  3                       STA     (TEMPW),Y
001632  3                       LDA     Itemph
001632  3                       INY
001632  3                       STA     (TEMPW),Y
001632  3                       JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
001632  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (WAVEFORM)
001632  3                       TXA
001632  3                       LDY     #4              ; SET WAVEFORM CYCLE
001632  3                       STA     (TEMPW),Y
001632  3                       JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001632  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (ATTACK)
001632  3                       TXA
001632  3                       LSR     A
001632  3                       LSR     A
001632  3                       LSR     A
001632  3                       LSR     A
001632  3                       STA     PTEMPW
001632  3                       JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001632  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (DECAY)
001632  3                       TXA
001632  3                       AND     #$0F
001632  3                       ORA     PTEMPW
001632  3                       LDY     #5              ; SET ATTACK/DECAY
001632  3                       STA     (TEMPW),Y
001632  3                       JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001632  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (SUSTAIN)
001632  3                       TXA
001632  3                       LSR     A
001632  3                       LSR     A
001632  3                       LSR     A
001632  3                       LSR     A
001632  3                       STA     PTEMPW
001632  3                       JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001632  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (RELEASE)
001632  3                       TXA
001632  3                       AND     #$0F
001632  3                       ORA     PTEMPW
001632  3                       LDY     #6              ; SET SUSTAIN/RELEASE
001632  3                       STA     (TEMPW),Y
001632  3                       RTS
001632  3               SIDVOICELOOKUP:
001632  3                       .WORD   SID_BASE,SID_BASE+7,SID_BASE+$12
