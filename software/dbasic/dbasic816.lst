001637  2                       .INCLUDE "screencmds.asm"
001637  3               
001637  3                       .IFDEF  MEMORYMAPPEDSCREEN
001637  3               
001637  3               ;* MEMORY MAP
001637  3               ;  VIDEO CARD IS A 32K AREA (MAPPED IN BANKS TO $AXXX)
001637  3               ;  $0x00 0x01=soft_scanline_emulation, 0x02 NO soft_scanline_emulation
001637  3               ;  $0x01 0x01=page1, 0x02 page2
001637  3               ;  $0x02  character generator write offset (data << 3)
001637  3               ;  $0x03 character generator write DATA
001637  3               ;  $0x04 EXECUTE device command
001637  3               ;        0x00- reset to the default configuration
001637  3               ;        0x01- reset to the saved configuration
001637  3               ;	0x02- save the current configuration
001637  3               ;
001637  3               ;  $0x05  0x01=soft_text=true, 0x02=soft_text=false
001637  3               ;  $0x06 Lores Mode=0X01,NO lores Mode=0x02
001637  3               ;  $0x07 Double Lores Mode=0X01,NO Double lores Mode=0x02
001637  3               ;  $0x08 Hires Mode=0X01,NO Hires Mode=0x02
001637  3               ;  $0x09 Double Hires Mode=0X01,NO Double Hires lores Mode=0x02
001637  3               ;  $0x0A 80COL Mode=0X01,NO 80COL Mode=0x02
001637  3               ;  $0x0B MIXED Mode=0X01,NO MIXED Mode=0x02
001637  3               ;  $0x0C QUAD Hires Mode=0X01,NO QUAD Hires lores Mode=0x02
001637  3               ;  $0x0D MONO Hires Mode=0X01,NO MONO Hires lores Mode=0x02
001637  3               ;
001637  3               ; 	VRAM Memory Map
001637  3               ;	$1000-$177F	40/80 Text Page 1
001637  3               ;	$1800-$1F7F	40/80 Color Page 1
001637  3               ;	$2000-$277F	40/80 Text Page 2
001637  3               ;	$2800-$2F7F	40/80 Color Page 2
001637  3               ;	$2000-$5FFF	HIRES PAGE 1
001637  3               ;	$6000-$8FFF	HIRES PAGE 2
001637  3               ;	$2000-$BFFF	DOUBLE HIRES
001637  3               
001637  3               VIDEOBANK       = $F8
001637  3               PC6502_IOSPACE  = $EF00
001637  3               ; PAGER
001637  3               PC6502_ACT_TASK = PC6502_IOSPACE+$E0
001637  3               PC6502_MAP_SETUP = PC6502_IOSPACE+$E1
001637  3               PC6502_MMU_ENA  = PC6502_IOSPACE+$E2
001637  3               PC6502_MAP_SPACE = PC6502_IOSPACE+$D0
001637  3               
001637  3               VideoDisplayPage = $A001
001637  3               VideoCharGenOffset = $A002
001637  3               VideoCharGenData = $A003
001637  3               VideoTextMode   = $A005
001637  3               VideoLoresMode  = $A006
001637  3               VideoDoubleLores = $A007
001637  3               VideoHiresMode  = $A008
001637  3               VideoDoubleHires = $A009
001637  3               Video80col      = $A00A
001637  3               VideoMixedMode  = $A00b
001637  3               VideoQuadHires  = $A00c
001637  3               VideoMonoHires  = $A00d
001637  3               
001637  3               CURX            = $0647         ; CURRENT CURSOR POSITION (MEMORY MAPPED)
001637  3               CURY            = $0648
001637  3               SHOWCRSR        = $0649         ; SHOW CURSOR (1-YES, 0-NO) (MEMORY MAPPED)
001637  3               CURCOLOR        = $064A         ; CURRENT PRINT COLOR (MEMORY MAPPED)
001637  3               CSRCOLOR        = $064B         ; CURRENT CURSOR COLOR (MEMORY MAPPED)
001637  3               BVIDEOMODE      = $064C         ; CURRENT VIDEO MODE (MEMORY MAPPED) 00=40 COL, 01=80 COL
001637  3               
001637  3               
001637  3               VIDEOMODE:
001637  3                       .BYTE   $00
001637  3               CLRTMP:
001637  3                       .BYTE   $00
001637  3               VIDEOWIDTH:
001637  3                       .BYTE   80
001637  3               PLOTX:
001637  3                       .BYTE   $00,$00
001637  3               PLOTY:
001637  3                       .BYTE   $00,$00
001637  3               PLOTCOLOR:
001637  3                       .BYTE   $00
001637  3               LINECOLOR:
001637  3                       .BYTE   $00
001637  3               LINEX1:
001637  3                       .BYTE   $00,$00
001637  3               LINEY1:
001637  3                       .BYTE   $00,$00
001637  3               LINEX2:
001637  3                       .BYTE   $00,$00
001637  3               LINEY2:
001637  3                       .BYTE   $00,$00
001637  3               DELTAX:
001637  3                       .BYTE   $00,$00
001637  3               DELTAY:
001637  3                       .BYTE   $00,$00
001637  3               PTEMPW:
001637  3                       .BYTE   $00,$00
001637  3               PTEMPW1:
001637  3                       .BYTE   $00,$00
001637  3               PTEMP:
001637  3                       .BYTE   $00
001637  3               LINEERR:
001637  3                       .BYTE   $00,$00
001637  3               
001637  3               
001637  3               ;___V_SCRCLR________________________________________________
001637  3               ;
001637  3               ; CLEAR SCREEN
001637  3               ;
001637  3               ;__________________________________________________________
001637  3               LAB_SCRCLR:
001637  3               V_SCNCLR:
001637  3                       STA     DBGA
001637  3                       STY     DBGY
001637  3                       STX     DBGX
001637  3                       LDA     #38
001637  3                       STA     farfunct
001637  3                       JSR     DO_FARCALL
001637  3                       LDA     #59
001637  3                       STA     farfunct
001637  3                       JSR     DO_FARCALL
001637  3                       LDA     DBGA
001637  3                       LDY     DBGY
001637  3                       LDX     DBGX
001637  3                       RTS
001637  3               
001637  3               
001637  3               
001637  3               ;___V_LOCATE________________________________________________
001637  3               ;
001637  3               ; SET CURSOR LOCATION
001637  3               ;
001637  3               ;       LOCATE X,Y
001637  3               ;
001637  3               ;__________________________________________________________
001637  3               V_LOCATE:
001637  3               LAB_LOCATE:
001637  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (MODE)
001637  3                       STX     DBGX
001637  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001637  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
001637  3                       TXA
001637  3                       TAY
001637  3                       LDX     DBGX
001637  3                       LDA     #37
001637  3                       STA     farfunct
001637  3                       JSR     DO_FARCALL
001637  3                       RTS
001637  3               
001637  3               ;___V_COLOR_________________________________________________
001637  3               ;
001637  3               ; SET COLOR FG,BG,CFG,CBG
001637  3               ;
001637  3               ;__________________________________________________________
001637  3               LAB_COLOR:
001637  3               V_COLOR:
001637  3                       LDA     #$00            ; CLEAR TEMP SPACE
001637  3                       STA     PTEMPW
001637  3                       STA     PTEMPW+1
001637  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (MODE)
001637  3                       TXA
001637  3                       AND     #$0F
001637  3                       STA     PTEMPW
001637  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001637  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
001637  3                       TXA
001637  3                       ASL     A
001637  3                       ASL     A
001637  3                       ASL     A
001637  3                       ASL     A
001637  3                       ORA     PTEMPW
001637  3                       STA     PTEMPW
001637  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001637  3                       JSR     LAB_GTBY        ; GET THE THIRD PARAMETER, RETURN IN X
001637  3                       TXA
001637  3                       AND     #$0F
001637  3                       STA     PTEMPW+1
001637  3                       JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
001637  3                       JSR     LAB_GTBY        ; GET THE FOURTH PARAMETER, RETURN IN X
001637  3                       TXA
001637  3                       ASL     A
001637  3                       ASL     A
001637  3                       ASL     A
001637  3                       ASL     A
001637  3                       ORA     PTEMPW+1
001637  3                       STA     PTEMPW+1
001637  3                       LDX     PTEMPW
001637  3                       LDY     PTEMPW+1
001637  3                       LDA     #39
001637  3                       STA     farfunct
001637  3                       JSR     DO_FARCALL
001637  3                       RTS
001637  3               
001637  3               
001637  3               
001637  3               ;___V_SPEEK()______________________________________________
001637  3               ;
001637  3               ; GET VALUE FROM SCREEN MEMORY
001637  3               ;
001637  3               ;  TAKES ONE PARAMETER (ADDRESS), RETURNS VALUE
001637  3               ;
001637  3               ;__________________________________________________________
001637  3               LAB_SPEEK:
001637  3               V_SPEEK:
001637  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001637  3                       LDA     Itemph
001637  3                       TAY
001637  3                       AND     #$0F
001637  3                       ORA     #$A0
001637  3                       STA     Itemph
001637  3                       TYA
001637  3                       AND     #$F0
001637  3                       LSR     A
001637  3                       LSR     A
001637  3                       LSR     A
001637  3                       LSR     A
001637  3                       AND     #$07
001637  3                       CLC
001637  3                       ADC     #VIDEOBANK
001637  3                       TAY
001637  3                       LDA     #$01            ; MODIFY TASK 01 (DRIVER TASK)
001637  3                       LDX     #$0A            ; MAP $AXXX
001637  3                       JSR     SETPAGE         ; CALL SETPAGE
001637  3                       LDA     #$01
001637  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 01
001637  3                       LDY     #0
001637  3                       LDA     (Itempl),Y
001637  3                       TAY
001637  3                       LDA     #$00
001637  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 00
001637  3                       JMP     LAB_1FD0        ; convert Y to byte in FAC1 and return
001637  3               
001637  3               
001637  3               
001637  3               ;___V_SPOKE_________________________________________________
001637  3               ;
001637  3               ; PUT VALUE IN SCREEN MEMORY
001637  3               ;
001637  3               ;  TAKES TWO PARAMETERS ADDRESS,VALUE
001637  3               ;
001637  3               ;__________________________________________________________
001637  3               LAB_SPOKE:
001637  3               V_SPOKE:
001637  3                       JSR     LAB_GADB        ; get two parameters for POKE or WAIT
001637  3                       TXA                     ; BYTE ARGUMENT IS IN X
001637  3                       PHA                     ; PUSH BYTE ARGUMENT TO STACK
001637  3                       LDA     Itemph
001637  3                       TAY
001637  3                       AND     #$0F
001637  3                       ORA     #$A0
001637  3                       STA     Itemph
001637  3                       TYA
001637  3                       AND     #$F0
001637  3                       LSR     A
001637  3                       LSR     A
001637  3                       LSR     A
001637  3                       LSR     A
001637  3                       AND     #$07
001637  3                       CLC
001637  3                       ADC     #VIDEOBANK
001637  3                       TAY
001637  3                       LDA     #$01            ; MODIFY TASK 01 (DRIVER TASK)
001637  3                       LDX     #$0A            ; MAP $AXXX
001637  3                       JSR     SETPAGE         ; CALL SETPAGE
001637  3                       LDA     #$01
001637  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 01
001637  3                       LDY     #0
001637  3                       PLA                     ; PULL BYTE ARGUMENT
001637  3                       STA     (Itempl),Y
001637  3                       LDA     #$00
001637  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 00
001637  3                       RTS
001637  3               
001637  3               ;___V_SCREEN_________________________________________________
001637  3               ;
001637  3               ;  SET SCREEN MODE
001637  3               ;
001637  3               ;  TAKES UP TO THREE PARAMETERS
001637  3               ;  FIRST PARAMETER SCREEN MODE
001637  3               ;  0=TEXT MODE
001637  3               ;  1=LORES MODE
001637  3               ;  2=HIRES MODE
001637  3               ;
001637  3               ;  TEXT MODE PARAMETERS
001637  3               ;  0=40 COLUMNS
001637  3               ;  1=80 COLUMNS
001637  3               ;
001637  3               ;  LORES MODE SECOND PARAMETER
001637  3               ;  0=SINGLE LORES
001637  3               ;  1=DOUBLE LORES
001637  3               ;  LORES MODE THIRD PARAMETER
001637  3               ;  0=MIXED MODE
001637  3               ;  1=FULL SCREEN MODE
001637  3               ;
001637  3               ;  HIRES MODE SECOND PARAMETER
001637  3               ;  0=SINGLE HIRES
001637  3               ;  1=DOUBLE HIRES
001637  3               ;  2=QUAD HIRES
001637  3               ;  3=MONO HIRES
001637  3               ;  HIRES MODE THIRD PARAMETER
001637  3               ;  1=MIXED MODE
001637  3               ;  0=FULL SCREEN MODE
001637  3               ;
001637  3               ;__________________________________________________________
001637  3               LAB_SCREEN:
001637  3               V_SCREEN:
001637  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (MODE)
001637  3               V_SCREEN1:
001637  3                       STX     VIDEOMODE
001637  3                       CPX     #00
001637  3                       BNE     *+5
001637  3                       JMP     SETUPMODE0
001637  3                       CPX     #01
001637  3                       BNE     *+5
001637  3                       JMP     SETUPMODE1
001637  3                       CPX     #02
001637  3                       BNE     *+5
001637  3                       JMP     SETUPMODE2
001637  3               
001637  3                       LDX     #$02            ; SYNTAX ERROR
001637  3                       JSR     LAB_XERR
001637  3                       JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001637  3                       RTS
001637  3               
001637  3               SETUPMODE0:                     ; TEXT MODE
001637  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001637  3                       JSR     PAGE_ENTER
001637  3                       LDA     #$01
001637  3                       STA     VideoTextMode
001637  3                       LDA     #$02
001637  3                       STA     VideoLoresMode
001637  3                       STA     VideoHiresMode
001637  3                       JSR     PAGE_EXIT
001637  3               
001637  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001637  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
001637  3                       CPX     #$00
001637  3                       BNE     SETUPMODE0_80
001637  3               
001637  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001637  3                       JSR     PAGE_ENTER
001637  3                       LDA     #$02
001637  3                       STA     Video80col
001637  3                       JSR     PAGE_EXIT
001637  3                       LDA     #40
001637  3                       STA     VIDEOWIDTH
001637  3                       LDA     #0
001637  3                       STA     BVIDEOMODE
001637  3                       JMP     SETUPMODE0_CLEAR
001637  3               SETUPMODE0_80:
001637  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001637  3                       JSR     PAGE_ENTER
001637  3                       LDA     #$01
001637  3                       STA     Video80col
001637  3                       JSR     PAGE_EXIT
001637  3                       LDA     #80
001637  3                       STA     VIDEOWIDTH
001637  3                       LDA     #1
001637  3                       STA     BVIDEOMODE
001637  3               SETUPMODE0_CLEAR:
001637  3                       JMP     V_SCNCLR
001637  3                       RTS
001637  3               
001637  3               SETUPMODE1:                     ; LORES MODE
001637  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001637  3                       JSR     PAGE_ENTER
001637  3                       LDA     #$01
001637  3                       STA     VideoLoresMode
001637  3                       LDA     #$02
001637  3                       STA     VideoTextMode
001637  3                       STA     VideoHiresMode
001637  3                       JSR     PAGE_EXIT
001637  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001637  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
001637  3               
001637  3                       CPX     #$00
001637  3                       BNE     SETUPMODE1_DOUBLE
001637  3               
001637  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001637  3                       JSR     PAGE_ENTER
001637  3                       LDA     #$02
001637  3                       STA     VideoDoubleLores
001637  3                       JSR     PAGE_EXIT
001637  3                       JMP     SETUPMODE1_CLEAR
001637  3               SETUPMODE1_DOUBLE:
001637  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001637  3                       JSR     PAGE_ENTER
001637  3                       LDA     #$01
001637  3                       STA     VideoDoubleLores
001637  3                       JSR     PAGE_EXIT
001637  3                       LDA     #$11
001637  3                       STA     VIDEOMODE
001637  3               SETUPMODE1_CLEAR:               ;    ($2000-$2800)
001637  3                       LDY     #$02+VIDEOBANK  ; AREA $2000-$2FFF
001637  3                       JSR     PAGE_ENTER
001637  3                       LDA     #$00
001637  3                       STA     TEMPW
001637  3                       LDA     #$A0
001637  3                       STA     TEMPW+1
001637  3                       LDY     #$00
001637  3                       LDA     #$00
001637  3               :
001637  3                       STA     (TEMPW),Y
001637  3                       INC     TEMPW
001637  3                       BNE     :-
001637  3                       INC     TEMPW+1
001637  3               
001637  3                       LDX     TEMPW+1
001637  3                       CPX     #$A8
001637  3                       BNE     :-
001637  3                       JSR     PAGE_EXIT
001637  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001637  3                       JSR     LAB_GTBY        ; GET THE THIRD PARAMETER, RETURN IN X
001637  3                       CPX     #$00
001637  3                       BNE     SETUPMODE1_MIXED
001637  3               
001637  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001637  3                       JSR     PAGE_ENTER
001637  3                       LDA     #$02
001637  3                       STA     VideoMixedMode
001637  3                       JSR     PAGE_EXIT
001637  3                       RTS
001637  3               SETUPMODE1_MIXED:
001637  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001637  3                       JSR     PAGE_ENTER
001637  3                       LDA     #$01
001637  3                       STA     VideoMixedMode
001637  3                       JSR     PAGE_EXIT
001637  3                       LDA     VIDEOMODE
001637  3                       ORA     #$80
001637  3                       STA     VIDEOMODE
001637  3                       RTS
001637  3               
001637  3               
001637  3               SETUPMODE2:                     ; HIRES MODE
001637  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001637  3                       JSR     PAGE_ENTER
001637  3                       LDA     #$01
001637  3                       STA     VideoHiresMode
001637  3                       LDA     #$02
001637  3                       STA     VideoTextMode
001637  3                       STA     VideoLoresMode
001637  3                       JSR     PAGE_EXIT
001637  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001637  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
001637  3               
001637  3                       CPX     #$00
001637  3                       BNE     SETUPMODE2_DOUBLE
001637  3               
001637  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001637  3                       JSR     PAGE_ENTER
001637  3                       LDA     #$02
001637  3                       STA     VideoDoubleHires
001637  3                       STA     VideoQuadHires
001637  3                       STA     VideoMonoHires
001637  3                       JSR     PAGE_EXIT
001637  3                       JMP     SETUPMODE2_CLEAR
001637  3               SETUPMODE2_DOUBLE:
001637  3                       CPX     #$01
001637  3                       BNE     SETUPMODE2_QUAD
001637  3               
001637  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001637  3                       JSR     PAGE_ENTER
001637  3                       LDA     #$01
001637  3                       STA     VideoDoubleHires
001637  3                       LDA     #$02
001637  3                       STA     VideoQuadHires
001637  3                       STA     VideoMonoHires
001637  3                       JSR     PAGE_EXIT
001637  3                       LDA     #$12
001637  3                       STA     VIDEOMODE
001637  3                       JMP     SETUPMODE2_CLEAR
001637  3               SETUPMODE2_QUAD:
001637  3                       CPX     #$02
001637  3                       BNE     SETUPMODE2_MONO
001637  3               
001637  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001637  3                       JSR     PAGE_ENTER
001637  3                       LDA     #$01
001637  3                       STA     VideoQuadHires
001637  3                       LDA     #$02
001637  3                       STA     VideoDoubleHires
001637  3                       STA     VideoMonoHires
001637  3                       JSR     PAGE_EXIT
001637  3                       LDA     #$22
001637  3                       STA     VIDEOMODE
001637  3                       JMP     SETUPMODE2_CLEAR
001637  3               SETUPMODE2_MONO:
001637  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001637  3                       JSR     PAGE_ENTER
001637  3                       LDA     #$01
001637  3                       STA     VideoMonoHires
001637  3                       LDA     #$02
001637  3                       STA     VideoDoubleHires
001637  3                       STA     VideoQuadHires
001637  3                       JSR     PAGE_EXIT
001637  3                       LDA     #$32
001637  3                       STA     VIDEOMODE
001637  3               
001637  3               SETUPMODE2_CLEAR:               ; ($2000-$7FFF)
001637  3                       LDY     #$02+VIDEOBANK
001637  3                       STY     CLRTMP
001637  3               
001637  3               :
001637  3                       LDY     CLRTMP
001637  3                       JSR     PAGE_ENTER
001637  3               
001637  3                       LDA     #$00
001637  3                       TAY
001637  3                       STA     TEMPW
001637  3                       LDA     #$A0
001637  3                       STA     TEMPW+1
001637  3                       LDA     #$00
001637  3               :
001637  3                       STA     (TEMPW),Y
001637  3                       INC     TEMPW
001637  3                       BNE     :-
001637  3                       INC     TEMPW+1
001637  3                       LDX     TEMPW+1
001637  3                       CPX     #$B0
001637  3                       BNE     :-
001637  3                       LDX     #$A0
001637  3                       INC     CLRTMP
001637  3                       LDX     CLRTMP
001637  3                       CPX     #$00
001637  3                       BNE     :--
001637  3                       JSR     PAGE_EXIT
001637  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001637  3                       JSR     LAB_GTBY        ; GET THE THIRD PARAMETER, RETURN IN X
001637  3                       CPX     #$00
001637  3                       BNE     SETUPMODE2_MIXED
001637  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001637  3                       JSR     PAGE_ENTER
001637  3                       LDA     #$02
001637  3                       STA     VideoMixedMode
001637  3                       JSR     PAGE_EXIT
001637  3                       RTS
001637  3               SETUPMODE2_MIXED:
001637  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001637  3                       JSR     PAGE_ENTER
001637  3                       LDA     #$01
001637  3                       STA     VideoMixedMode
001637  3                       JSR     PAGE_EXIT
001637  3                       LDA     VIDEOMODE
001637  3                       ORA     #$80
001637  3                       STA     VIDEOMODE
001637  3                       RTS
001637  3               
001637  3               
001637  3               
001637  3               PAGE_EXIT:
001637  3                       LDA     #$00
001637  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 00
001637  3                       RTS
001637  3               
001637  3               PAGE_ENTER:
001637  3               ; Set "Y" register to video page ($YXXX)
001637  3                       LDA     #$01            ; MODIFY TASK 01 (DRIVER TASK)
001637  3                       LDX     #$0A            ; MAP $AXXX
001637  3                       JSR     SETPAGE         ; CALL SETPAGE
001637  3                       LDA     #$01
001637  3                       STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 01
001637  3                       RTS
001637  3               
001637  3               ;___V_PLOT__________________________________________________
001637  3               ;
001637  3               ;  PLOT ON SCREEN
001637  3               ;         TAKES THREE PARAMETERS,  X,Y,COLOR
001637  3               ;
001637  3               ;__________________________________________________________
001637  3               LAB_PLOT:
001637  3               V_PLOT:
001637  3                       JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001637  3                                               ; else do type mismatch
001637  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001637  3                       LDA     Itemph
001637  3                       STA     PLOTX+1
001637  3                       LDA     Itempl
001637  3                       STA     PLOTX
001637  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001637  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
001637  3                       STX     PLOTY           ; STORE IN PLOTY
001637  3                       LDA     #$00
001637  3                       STA     PLOTY+1
001637  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001637  3                       JSR     LAB_GTBY        ; RETURN IN X
001637  3                       STX     PLOTCOLOR
001637  3               DOPLOTXY:
001637  3                                               ; PARAMETERS PARSED, GO TO PROPER MODE CODE
001637  3                       LDA     VIDEOMODE
001637  3                       AND     #$0F
001637  3                       CMP     #$01
001637  3                       BEQ     V_PLOT_LORES
001637  3                       LDA     VIDEOMODE
001637  3                       AND     #$2F
001637  3                       CMP     #$02
001637  3                       BNE     :+
001637  3                       JMP     V_PLOT_HIRES_COLOR
001637  3               :
001637  3                       CMP     #$22
001637  3                       BNE     :+
001637  3                       JMP     V_PLOT_HIRES_MONO
001637  3               :
001637  3                       RTS
001637  3               
001637  3               V_PLOT_LORES:
001637  3                       LDA     PLOTY
001637  3                       PHA
001637  3                       LSR     A               ; 2 LINES PER BYTE
001637  3                       STA     PLOTY
001637  3                                               ; MULTIPLY Y (PTEMPW) COORD BY 40 OR 80 (SINGLE OR DOUBLE LORES)
001637  3                       CLC
001637  3                       ASL     PLOTY
001637  3                       ROL     PLOTY+1         ; *2
001637  3                       ASL     PLOTY
001637  3                       ROL     PLOTY+1         ; *2 (*4)
001637  3                       ASL     PLOTY
001637  3                       ROL     PLOTY+1         ; *2 (*8)
001637  3                       LDA     PLOTY
001637  3                       STA     PTEMPW
001637  3                       LDA     PLOTY+1
001637  3                       STA     PTEMPW+1        ; STORE Y*8 INTO PTEMPW
001637  3                       ASL     PLOTY
001637  3                       ROL     PLOTY+1         ; *2 (*16)
001637  3                       ASL     PLOTY
001637  3                       ROL     PLOTY+1         ; *2 (*32)
001637  3               ; NOW TAKE Y*8(PTEMPW) + Y*32(PLOTY) == Y*40 STORE IN PLOTY
001637  3                       CLC                     ; Clear the Carry flag before the first addition
001637  3               
001637  3                       LDA     PLOTY           ; Load the low byte of the first number into the accumulator
001637  3                       ADC     PTEMPW          ; Add the low byte of the second number (plus carry)
001637  3                       STA     PLOTY           ; Store the low byte of the result
001637  3               
001637  3                       LDA     PLOTY+1         ; Load the high byte of the first number
001637  3                       ADC     PTEMPW+1        ; Add the high byte of the second number (plus carry from previous op)
001637  3                       STA     PLOTY+1         ; Store the high byte of the result
001637  3               
001637  3               ; if double lores columns double it.
001637  3                       LDA     VIDEOMODE
001637  3                       AND     #$10
001637  3                       CMP     #00
001637  3                       BEQ     :+
001637  3                       ASL     PLOTY
001637  3                       ROL     PLOTY+1         ; *2
001637  3               :
001637  3               ; OK, Y OFFSET IS IN PTEMPW1, X IS IN PTEMPW
001637  3                       LDA     #$A0            ; ADD THE MEMORY OFFSET TO PTEMPW (BECAUSE IT IS EASY)
001637  3                       STA     PLOTX+1         ; THEN ADD PTEMPW1 TO PTEMPW THAT SHOULD BE THE MEMORY ADDRESS TO UPDATE
001637  3                                               ;
001637  3                       CLC                     ; Clear the Carry flag before the first addition
001637  3                       LDA     PLOTX           ; Load the low byte of the first number into the accumulator
001637  3                       ADC     PLOTY           ; Add the low byte of the second number (plus carry)
001637  3                       STA     TEMPW           ; Store the low byte of the result
001637  3               
001637  3                       LDA     PLOTX+1         ; Load the high byte of the first number
001637  3                       ADC     PLOTY+1         ; Add the high byte of the second number (plus carry from previous op)
001637  3                       STA     TEMPW+1         ; Store the high byte of the result
001637  3                                               ; PTEMPW IS THE MEMORY OFFSET TO UPDATE
001637  3                       PLA
001637  3                       LSR     A               ; TOP OR BOTTOM PIXEL?
001637  3                       BCC     :+
001637  3                                               ; TOP PIXEL
001637  3                       LDY     #$02+VIDEOBANK  ; AREA $2000-$2FFF
001637  3                       JSR     PAGE_ENTER
001637  3                       LDY     #$00
001637  3                       LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
001637  3                       AND     #$0F
001637  3                       PHA
001637  3                       LDA     PLOTCOLOR
001637  3                       ASL     A
001637  3                       ASL     A
001637  3                       ASL     A
001637  3                       ASL     A
001637  3                       STA     PLOTCOLOR
001637  3                       PLA
001637  3                       ORA     PLOTCOLOR
001637  3                       STA     (TEMPW),Y       ; STORE  DOUBLE PIXEL
001637  3                       JSR     PAGE_EXIT
001637  3                       RTS
001637  3               :
001637  3                                               ; BOTTOM PIXEL
001637  3                       LDY     #$02+VIDEOBANK  ; AREA $2000-$2FFF
001637  3                       JSR     PAGE_ENTER
001637  3                       LDY     #$00
001637  3                       LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
001637  3                       AND     #$F0
001637  3                       ORA     PLOTCOLOR
001637  3                       STA     (TEMPW),Y       ; STORE  DOUBLE PIXEL
001637  3                       JSR     PAGE_EXIT
001637  3                       RTS
001637  3               
001637  3               V_PLOT_HIRES_COLOR:
001637  3                       LDA     PLOTX
001637  3                       PHA                     ; PUSH LOW BYTE OF X (FOR EVEN/ODD LATER)
001637  3                       LSR     PLOTX+1
001637  3                       ROR     PLOTX           ; 2 PIXEL PER BYTE
001637  3                       LDA     PLOTX           ;
001637  3                                               ; FIGURE THE BUFFER OFFSET
001637  3                       CLC                     ; MULTIPLY Y COORD BY 70 OR 140 (SINGLE OR DOUBLE HIRES)
001637  3                       ASL     PLOTY
001637  3                       ROL     PLOTY+1         ; *2
001637  3                       LDA     PLOTY
001637  3                       STA     PTEMPW
001637  3                       LDA     PLOTY+1
001637  3                       STA     PTEMPW+1        ; STORE Y*2 INTO PTEMPW
001637  3                       ASL     PLOTY
001637  3                       ROL     PLOTY+1         ; *2 (*4)
001637  3                       LDA     PLOTY
001637  3                       STA     PTEMPW1
001637  3                       LDA     PLOTY+1
001637  3                       STA     PTEMPW1+1       ; STORE Y*4 INTO PTEMPW1
001637  3                       ASL     PLOTY
001637  3                       ROL     PLOTY+1         ; *2 (*8)
001637  3                       ASL     PLOTY
001637  3                       ROL     PLOTY+1         ; *2 (*16)
001637  3                       ASL     PLOTY
001637  3                       ROL     PLOTY+1         ; *2 (*32)
001637  3                       ASL     PLOTY
001637  3                       ROL     PLOTY+1         ; *2 (*64)
001637  3                                               ; RESULT OFFSET PLOTY = PLOTY(Y*64)+PTEMPW(Y*2)+PTEMPW1(Y*4)
001637  3                       CLC                     ; Clear the Carry flag before the first addition
001637  3                       LDA     PLOTY           ; Load the low byte of the first number into the accumulator
001637  3                       ADC     PTEMPW          ; Add the low byte of the second number (plus carry)
001637  3                       STA     PLOTY           ; Store the low byte of the result
001637  3                       LDA     PLOTY+1         ; Load the high byte of the first number
001637  3                       ADC     PTEMPW+1        ; Add the high byte of the second number (plus carry from previous op)
001637  3                       STA     PLOTY+1         ; Store the high byte of the result
001637  3               
001637  3                       CLC                     ; Clear the Carry flag before the first addition
001637  3                       LDA     PLOTY           ; Load the low byte of the first number into the accumulator
001637  3                       ADC     PTEMPW1         ; Add the low byte of the second number (plus carry)
001637  3                       STA     PLOTY           ; Store the low byte of the result
001637  3                       LDA     PLOTY+1         ; Load the high byte of the first number
001637  3                       ADC     PTEMPW1+1       ; Add the high byte of the second number (plus carry from previous op)
001637  3                       STA     PLOTY+1         ; Store the high byte of the result
001637  3               
001637  3               ; if double hires double it.
001637  3                       LDA     VIDEOMODE
001637  3                       AND     #$10
001637  3                       CMP     #00
001637  3                       BEQ     :+
001637  3                       ASL     PLOTY
001637  3                       ROL     PLOTY+1         ; *2
001637  3               :
001637  3               ; PLOTY IS NOW Y OFFSET, ADD X OFFSET FOR MEMORY ADDRESS INTO TEMPW
001637  3                       CLC                     ; Clear the Carry flag before the first addition
001637  3                       LDA     PLOTY           ; Load the low byte of the first number into the accumulator
001637  3                       ADC     PLOTX           ; Add the low byte of the second number (plus carry)
001637  3                       STA     TEMPW           ; Store the low byte of the result
001637  3                       LDA     PLOTY+1         ; Load the high byte of the first number
001637  3                       ADC     PLOTX+1         ; Add the high byte of the second number (plus carry from previous op)
001637  3                       STA     TEMPW+1         ; Store the high byte of the result
001637  3               
001637  3                       LDA     TEMPW+1         ; OK, LET'S CALCULATE THE BANK
001637  3                       AND     #$F0
001637  3                       LSR     A
001637  3                       LSR     A
001637  3                       LSR     A
001637  3                       LSR     A
001637  3                       CLC
001637  3                       ADC     #$02+VIDEOBANK  ; AREA $2000-?
001637  3                       CMP     #$F8
001637  3                       BCC     V_PLOT_HIRES_COLOR_RANGE
001637  3                       TAY                     ; VIDEO BANK SHOULD BE IN Y
001637  3                       JSR     PAGE_ENTER
001637  3               
001637  3                       LDA     TEMPW+1
001637  3                       AND     #$0F
001637  3                       ORA     #$A0
001637  3                       STA     TEMPW+1         ; TEMPW NOW REFLECTS MAPPED ADDRESSS
001637  3                       PLA
001637  3                       LSR     A               ; LEFT OR RIGHT PIXEL?
001637  3                       BCC     :+
001637  3                                               ; LEFT PIXEL
001637  3                       LDY     #$00
001637  3                       LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
001637  3                       AND     #$0F
001637  3                       PHA
001637  3                       LDA     PLOTCOLOR
001637  3                       ASL     A
001637  3                       ASL     A
001637  3                       ASL     A
001637  3                       ASL     A
001637  3                       STA     PLOTCOLOR
001637  3                       PLA
001637  3                       ORA     PLOTCOLOR
001637  3                       STA     (TEMPW),Y       ; WRITE THE PIXEL BACK OUT
001637  3                       JSR     PAGE_EXIT
001637  3                       RTS
001637  3               :
001637  3               ; RIGHT PIXEL
001637  3                       LDY     #$00
001637  3                       LDA     (TEMPW),Y       ; GET EXISTING DOUBLE PIXEL
001637  3                       AND     #$F0
001637  3                       ORA     PLOTCOLOR
001637  3                       STA     (TEMPW),Y       ; WRITE THE PIXEL BACK OUT
001637  3                       JSR     PAGE_EXIT
001637  3                       RTS
001637  3               
001637  3               V_PLOT_HIRES_COLOR_RANGE:
001637  3                       JMP     LAB_2564
001637  3               
001637  3               V_PLOT_HIRES_MONO:
001637  3                       LDA     PLOTX
001637  3                       PHA
001637  3                       LSR     PLOTX+1
001637  3                       ROR     PLOTX
001637  3                       LSR     PLOTX+1
001637  3                       ROR     PLOTX
001637  3                       LSR     PLOTX+1
001637  3                       ROR     PLOTX           ; 8 PIXEL PER BYTE
001637  3                       LDA     #00
001637  3                       STA     PLOTX+1
001637  3                       STA     PTEMPW1+1
001637  3                       LDA     PLOTY
001637  3                       STA     PTEMPW1
001637  3                                               ; MULTIPLY Y COORD BY 35 OR 70 (MONO OR QUAD HIRES)
001637  3                       ASL     PLOTY
001637  3                       ROL     PLOTY+1         ; *2
001637  3                       LDA     PLOTY
001637  3                       STA     PTEMPW
001637  3                       LDA     PLOTY+1
001637  3                       STA     PTEMPW+1        ; STORE *2 INTO PTEMPW
001637  3                       ASL     PLOTY
001637  3                       ROL     PLOTY+1         ; *2 (*4)
001637  3                       ASL     PLOTY
001637  3                       ROL     PLOTY+1         ; *2 (*8)
001637  3                       ASL     PLOTY
001637  3                       ROL     PLOTY+1         ; *2 (*16)
001637  3                       ASL     PLOTY
001637  3                       ROL     PLOTY+1         ; *2 (*32)
001637  3               ;
001637  3               ; PLOTY(Y*35) = PLOTY(Y*32)+PTEMPW(Y*2)+PTEMPW1(Y)
001637  3                       CLC                     ; Clear the Carry flag before the first addition
001637  3                       LDA     PLOTY           ; Load the low byte of the first number into the accumulator
001637  3                       ADC     PTEMPW          ; Add the low byte of the second number (plus carry)
001637  3                       STA     PLOTY           ; Store the low byte of the result
001637  3               
001637  3                       LDA     PLOTY+1         ; Load the high byte of the first number
001637  3                       ADC     PTEMPW+1        ; Add the high byte of the second number (plus carry from previous op)
001637  3                       STA     PLOTY+1         ; Store the high byte of the result
001637  3                       CLC                     ; Clear the Carry flag before the first addition
001637  3                       LDA     PLOTY           ; Load the low byte of the first number into the accumulator
001637  3                       ADC     PTEMPW1         ; Add the low byte of the second number (plus carry)
001637  3                       STA     PLOTY           ; Store the low byte of the result
001637  3               
001637  3                       LDA     PLOTY+1         ; Load the high byte of the first number
001637  3                       ADC     PTEMPW1+1       ; Add the high byte of the second number (plus carry from previous op)
001637  3                       STA     PLOTY+1         ; Store the high byte of the result
001637  3               ;
001637  3               ; PLOTY IS NOW THE Y OFFSET
001637  3               ; if quad hires double it.
001637  3                       LDA     VIDEOMODE
001637  3                       AND     #$10
001637  3                       CMP     #00
001637  3                       BNE     :+
001637  3                       ASL     PLOTY
001637  3                       ROL     PLOTY+1         ; *2
001637  3               :
001637  3               ; ADD THE X OFFSET
001637  3                       CLC                     ; Clear the Carry flag before the first addition
001637  3                       LDA     PLOTY           ; Load the low byte of the first number into the accumulator
001637  3                       ADC     PLOTX           ; Add the low byte of the second number (plus carry)
001637  3                       STA     TEMPW           ; Store the low byte of the result
001637  3               
001637  3                       LDA     PLOTY+1         ; Load the high byte of the first number
001637  3                       ADC     PLOTX+1         ; Add the high byte of the second number (plus carry from previous op)
001637  3                       STA     TEMPW+1         ; Store the high byte of the result
001637  3                                               ; TEMPW IS NOW THE MEMORY ADDRESS
001637  3               
001637  3                       LDA     TEMPW+1         ; OK, LET'S CALCULATE THE BANK
001637  3                       AND     #$F0
001637  3                       LSR     A
001637  3                       LSR     A
001637  3                       LSR     A
001637  3                       LSR     A
001637  3                       CLC
001637  3                       ADC     #$02+VIDEOBANK  ; AREA $2000-?
001637  3                       CMP     #$F8
001637  3                       BCC     V_PLOT_HIRES_COLOR_RANGE1
001637  3                       TAY                     ; VIDEO BANK SHOULD BE IN Y
001637  3                       JSR     PAGE_ENTER
001637  3                       LDA     TEMPW+1
001637  3                       AND     #$0F
001637  3                       ORA     #$A0
001637  3                       STA     TEMPW+1         ; TEMPW NOW REFLECTS MAPPED ADDRESSS
001637  3                       PLA
001637  3                       AND     #$07            ; WHICH BIT?
001637  3                       TAX
001637  3                       LDA     PLOTCOLOR
001637  3                       CMP     #$01
001637  3                       BNE     :+
001637  3                       LDA     HIRES_BIT_LOOKUP_SET,X
001637  3                       LDY     #$00
001637  3                       ORA     (TEMPW),Y
001637  3                       STA     (TEMPW),Y
001637  3                       JSR     PAGE_EXIT
001637  3                       RTS
001637  3               :
001637  3                       LDA     HIRES_BIT_LOOKUP_RESET,X
001637  3                       PHA
001637  3                       LDY     #$00
001637  3                       AND     (TEMPW),Y
001637  3                       STA     (TEMPW),Y
001637  3                       JSR     PAGE_EXIT
001637  3                       RTS
001637  3               V_PLOT_HIRES_COLOR_RANGE1:
001637  3                       JMP     LAB_2564
001637  3               HIRES_BIT_LOOKUP_SET:
001637  3                       .BYTE   %10000000,%01000000,%00100000,%00010000,%00001000,%00000100,%00000010,%00000001
001637  3               HIRES_BIT_LOOKUP_RESET:
001637  3                       .BYTE   %01111111,%10111111,%11011111,%11101111,%11110111,%11111011,%11111101,%11111110
001637  3               
001637  3               ;___V_PATTERN________________________________________________
001637  3               ;
001637  3               ;  DEFINE GRAPHICS PATTERN
001637  3               ;
001637  3               ;  TAKES 10 PARAMETERS
001637  3               ;       PATTERN NUM (0-255)
001637  3               ;       PATTERN DATA (8 BYTES)
001637  3               ;__________________________________________________________
001637  3               LAB_PATTERN
001637  3               V_PATTERN:
001637  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X
001637  3                       TXA
001637  3                       PHA
001637  3                       LDY     #$00+VIDEOBANK  ; AREA $0000-$0FFF
001637  3                       JSR     PAGE_ENTER
001637  3                       PLA
001637  3                       STA     VideoCharGenOffset
001637  3                       LDY     #8
001637  3               :
001637  3                       TYA
001637  3                       PHA
001637  3                       JSR     LAB_1C01        ; GET THE NEXT PARAMETER (AFTER ',') OR SYN ERR
001637  3                       JSR     LAB_GTBY        ; GET THE NEXT PARAMETER, RETURN IN X
001637  3                       PLA
001637  3                       TAY
001637  3                       TXA
001637  3                       STA     VideoCharGenData
001637  3                       DEY
001637  3                       CPY     #$00
001637  3                       BNE     :-
001637  3                       JSR     PAGE_EXIT
001637  3                       RTS
001637  3               
001637  3               ;___LAB_LINE_______________________________________________
001637  3               ;
001637  3               ;  DRAW LINE USING THE BRESENHAM LINE DRAWING ALGORITHM
001637  3               ;
001637  3               ;  TAKES 5 PARAMETERS
001637  3               ;       START X,Y
001637  3               ;       DESTINATION X,Y
001637  3               ;       COLOR
001637  3               ;__________________________________________________________
001637  3               LAB_LINE:
001637  3               ; GET X1
001637  3                       JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001637  3                                               ; else do type mismatch
001637  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001637  3                       LDA     Itemph
001637  3                       STA     LINEX1+1
001637  3                       LDA     Itempl
001637  3                       STA     LINEX1
001637  3                                               ; GET Y1
001637  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
001637  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
001637  3                       STX     LINEY1          ; STORE IN LINEY1
001637  3               
001637  3               ; GET X2
001637  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
001637  3                       JSR     LAB_EVNM        ; evaluate expression and check is numeric,
001637  3                                               ; else do type mismatch
001637  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
001637  3                       LDA     Itemph
001637  3                       STA     LINEX2+1
001637  3                       LDA     Itempl
001637  3                       STA     LINEX2
001637  3                                               ; GET Y2
001637  3                       JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
001637  3                       JSR     LAB_GTBY        ; RETURN IN X
001637  3                       STX     LINEY2          ; STORE IN LINEY2
001637  3                                               ; GET COLOR
001637  3                       JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
001637  3                       JSR     LAB_GTBY        ; RETURN IN X
001637  3                       STX     LINECOLOR       ; STORE IN COLOR
001637  3                       LDA     #$00
001637  3                       STA     LINEY1+1
001637  3                       STA     LINEY2+1
001637  3                                               ; LINE COORDS AND COLOR STORED IN PROPER PLACE
001637  3                                               ; CALCULATE DELTAX
001637  3                       SEC                     ; Set Carry flag (represents "no borrow" for 1st byte)
001637  3                       LDA     LINEX1          ; Load low byte of number 1
001637  3                       SBC     LINEX2          ; Subtract low byte of number 2 with carry
001637  3                       STA     DELTAX          ; Store result low byte
001637  3                       LDA     LINEX1+1        ; Load high byte of number 1
001637  3                       SBC     LINEX2+1        ; Subtract high byte of number 2 with borrow
001637  3                       STA     DELTAX+1        ; Store result high byte
001637  3                       BCS     :+              ; BRANCH IF X1>=X2
001637  3                                               ; X1 < X2
001637  3                       LDA     #0
001637  3                       STA     PTEMP           ; IF X2>X1 (PTEMP=x0)
001637  3                       LDA     #$FF            ; TAKE ABSOLUTE VALUE OF DELTAX
001637  3                       EOR     DELTAX+1        ; Invert high byte (one's complement)
001637  3                       STA     DELTAX+1
001637  3                       LDA     #$FF            ;
001637  3                       EOR     DELTAX          ; Invert low byte
001637  3                       STA     DELTAX          ;
001637  3                       INC     DELTAX          ; Add 1 to the low byte
001637  3                       BNE     :++             ; If no carry from low byte INC, we are done
001637  3                       INC     DELTAX+1        ; Increment high byte if carry occurred
001637  3                       JMP     :++
001637  3               :
001637  3                       LDA     #1
001637  3                       STA     PTEMP           ; IF X1>X2 (PTEMP=x1)
001637  3               :
001637  3                                               ; CALCULATE DELTAY
001637  3                       LDA     #0
001637  3                       STA     DELTAY+1
001637  3                       SEC                     ; Set Carry flag
001637  3                       LDA     LINEY1          ; Load low byte of number 1
001637  3                       SBC     LINEY2          ; Subtract low byte of number 2 with carry
001637  3                       STA     DELTAY          ; Store result low byte
001637  3                       BCS     :+              ; BRANCH IF Y1>=Y2
001637  3                                               ; Y1 < Y2
001637  3                       LDA     PTEMP
001637  3                       AND     #1
001637  3                       STA     PTEMP           ; IF Y2>Y1 (PTEMP=0x)
001637  3                                               ; TAKE ABSOLUTE VALUE OF DELTAY
001637  3                       LDA     #$FF
001637  3                       EOR     DELTAY          ; Flip all bits (one's complement)
001637  3                       STA     DELTAY
001637  3                       INC     DELTAY          ; Add 1 (two's complement)
001637  3                       JMP     :++
001637  3               :
001637  3                       LDA     PTEMP
001637  3                       ORA     #$10
001637  3                       STA     PTEMP           ; IF Y1>Y2 (PTEMP=1x)
001637  3               :
001637  3                                               ; SLOPE DETERMINED, AND DELTAS CALCULATED
001637  3                                               ; OK, LET'S FIND OUT IF THIS IS A HORIZONTAL-ISH
001637  3                                               ; OR VERTICAL-ISH LINE
001637  3                       SEC                     ; Set Carry Flag (for subtraction)
001637  3                       LDA     DELTAX          ; Load low byte of DELTAX
001637  3                       SBC     DELTAY          ; Subtract low byte of DELTAY
001637  3                       LDA     DELTAX+1        ; Load high byte of DELTAX
001637  3                       SBC     DELTAY+1        ; Subtract high byte of DELTAY (with borrow)
001637  3                                               ; Flags now reflect the 16-bit comparison
001637  3                       BCC     LINEVERT        ; If Carry clear, LINE IS VERTICAL-ISH
001637  3                       JMP     LINEHORZ
001637  3               LINEVERT:
001637  3                                               ; FOR A VERTICAL-ISH LINE WE STEP ALONG THE
001637  3                                               ; Y AXIS (STEEP GRADIENT)
001637  3                                               ; FIND LARGER Y . . .
001637  3                       LDA     LINEY1
001637  3                       CMP     LINEY2
001637  3                       BCS     :+
001637  3                       JSR     LINESWAPXY
001637  3               :
001637  3                                               ; Initialize error = DELTAY / 2
001637  3                       LDA     DELTAY
001637  3                       STA     LINEERR
001637  3                       LDA     DELTAY+1
001637  3                       STA     LINEERR+1
001637  3                       LSR     LINEERR+1
001637  3                       ROR     LINEERR
001637  3               LINEVERTLOOP:
001637  3                       LDA     LINEY1          ; OK LET'S PLOT A POINT
001637  3                       STA     PLOTY
001637  3                       LDA     LINEY1+1
001637  3                       STA     PLOTY+1
001637  3                       LDA     LINEX1
001637  3                       STA     PLOTX
001637  3                       LDA     LINEX1+1
001637  3                       STA     PLOTX+1
001637  3                       LDA     LINECOLOR
001637  3                       STA     PLOTCOLOR
001637  3                       JSR     DOPLOTXY
001637  3                                               ; NOW MOVE LINE1 CLOSER TO LINE2
001637  3                       DEC     LINEY1          ; BY STEPPING ALONG Y AXIS
001637  3               
001637  3                                               ; BRESENHAM: err -= DELTAX
001637  3                       SEC
001637  3                       LDA     LINEERR
001637  3                       SBC     DELTAX
001637  3                       STA     LINEERR
001637  3                       LDA     LINEERR+1
001637  3                       SBC     DELTAX+1
001637  3                       STA     LINEERR+1
001637  3                       BPL     LINEVERT_NOSTEP ; IF ERR >= 0, NO X STEP NEEDED
001637  3                                               ; ERR += DELTAY (RESTORE ERROR)
001637  3                       CLC
001637  3                       LDA     LINEERR
001637  3                       ADC     DELTAY
001637  3                       STA     LINEERR
001637  3                       LDA     LINEERR+1
001637  3                       ADC     DELTAY+1
001637  3                       STA     LINEERR+1
001637  3                                               ; STEP X TOWARD X2 (16-BIT)
001637  3                       LDA     LINEX2
001637  3                       CMP     LINEX1
001637  3                       LDA     LINEX2+1
001637  3                       SBC     LINEX1+1
001637  3                       BCC     LINEVERT_DECX   ; X2 < X1, DECREMENT X1
001637  3                       INC     LINEX1          ; X2 >= X1, INCREMENT X1
001637  3                       BNE     LINEVERT_NOSTEP
001637  3                       INC     LINEX1+1
001637  3                       JMP     LINEVERT_NOSTEP
001637  3               LINEVERT_DECX:
001637  3                       LDA     LINEX1
001637  3                       BNE     :+
001637  3                       DEC     LINEX1+1
001637  3               :       DEC     LINEX1
001637  3               LINEVERT_NOSTEP:
001637  3               
001637  3                       LDA     LINEY1
001637  3                       CMP     LINEY2
001637  3                       BNE     LINEVERTLOOP
001637  3                       RTS                     ; DONE
001637  3               
001637  3               LINEHORZ:
001637  3               ; FOR A HORIZONTAL-ISH LINE WE STEP ALONG THE
001637  3               ; X AXIS (SHALLOW GRADIENT)
001637  3               ; FIND LARGER X . . .
001637  3                       SEC                     ; Set carry flag for subtraction
001637  3                       LDA     LINEX2          ; Load low byte of first number
001637  3                       SBC     LINEX1          ; Subtract low byte of second number
001637  3                       LDA     LINEX2+1        ; Load high byte of first number
001637  3                       SBC     LINEX1+1        ; Subtract high byte of second number
001637  3                                               ; Result flags (N, Z, C) now reflect: Val1 - Val2
001637  3                       BCS     :+              ; If carry is set, LINEX2 >= LINEX1
001637  3                       JSR     LINESWAPXY
001637  3               :
001637  3                                               ; Initialize error = DELTAX / 2
001637  3                       LDA     DELTAX
001637  3                       STA     LINEERR
001637  3                       LDA     DELTAX+1
001637  3                       STA     LINEERR+1
001637  3                       LSR     LINEERR+1
001637  3                       ROR     LINEERR
001637  3               LINEHORZLOOP:
001637  3                       LDA     LINEY1          ; OK LET'S PLOT A POINT
001637  3                       STA     PLOTY
001637  3                       LDA     LINEY1+1
001637  3                       STA     PLOTY+1
001637  3                       LDA     LINEX1
001637  3                       STA     PLOTX
001637  3                       LDA     LINEX1+1
001637  3                       STA     PLOTX+1
001637  3                       LDA     LINECOLOR
001637  3                       STA     PLOTCOLOR
001637  3                       JSR     DOPLOTXY
001637  3                                               ; NOW MOVE LINE1 CLOSER TO LINE2
001637  3                       INC     LINEX1          ; BY STEPPING ALONG X AXIS
001637  3                       BNE     :+
001637  3                       INC     LINEX1+1
001637  3               :
001637  3                                               ; BRESENHAM: err -= DELTAY
001637  3                       SEC
001637  3                       LDA     LINEERR
001637  3                       SBC     DELTAY
001637  3                       STA     LINEERR
001637  3                       LDA     LINEERR+1
001637  3                       SBC     DELTAY+1
001637  3                       STA     LINEERR+1
001637  3                       BPL     LINEHORZ_NOSTEP ; IF ERR >= 0, NO Y STEP NEEDED
001637  3                                               ; ERR += DELTAX (RESTORE ERROR)
001637  3                       CLC
001637  3                       LDA     LINEERR
001637  3                       ADC     DELTAX
001637  3                       STA     LINEERR
001637  3                       LDA     LINEERR+1
001637  3                       ADC     DELTAX+1
001637  3                       STA     LINEERR+1
001637  3                                               ; STEP Y TOWARD Y2
001637  3                       LDA     LINEY2
001637  3                       CMP     LINEY1
001637  3                       BCC     LINEHORZ_DECY   ; Y2 < Y1, DECREMENT
001637  3                       INC     LINEY1          ; Y2 >= Y1, INCREMENT
001637  3                       JMP     LINEHORZ_NOSTEP
001637  3               LINEHORZ_DECY:
001637  3                       DEC     LINEY1
001637  3               LINEHORZ_NOSTEP:
001637  3               
001637  3                       LDA     LINEX1
001637  3                       CMP     LINEX2
001637  3                       BNE     LINEHORZLOOP
001637  3                       LDA     LINEX1+1
001637  3                       CMP     LINEX2+1
001637  3                       BNE     LINEHORZLOOP
001637  3                       RTS                     ; DONE
001637  3               
001637  3               LINESWAPXY:
001637  3                       LDA     LINEX1
001637  3                       LDY     LINEX2
001637  3                       STY     LINEX1
001637  3                       STA     LINEX2
001637  3                       LDA     LINEX1+1
001637  3                       LDY     LINEX2+1
001637  3                       STY     LINEX1+1
001637  3                       STA     LINEX2+1
001637  3               ;
001637  3                       LDA     LINEY1
001637  3                       LDY     LINEY2
001637  3                       STY     LINEY1
001637  3                       STA     LINEY2
001637  3                       LDA     LINEY1+1
001637  3                       LDY     LINEY2+1
001637  3                       STY     LINEY1+1
001637  3                       STA     LINEY2+1
001637  3                       RTS
001637  3                       .ELSE
001637  3               
001637  3               
001637  3               ; ENSURE ALL OF THESE SPECIAL COMMANDS GIVE ERRORS IN NORMAL BASIC
001637  3               LAB_SPEEK:
001637  3               LAB_SPOKE:
001637  3               LAB_SCRCLR:
001637  3               LAB_SCREEN:
001637  3               LAB_PATTERN:
001637  3               LAB_PLOT:
001637  3               LAB_LOCATE:
001637  3               LAB_COLOR:
001637  3               LAB_LINE:
001637  3  A2 02                LDX     #$02            ; error code $02 ("SYNTAX" error)
001639  3  4C D5 18             JMP     LAB_XERR        ; do error #X, then warm start
00163C  3               
00163C  3                       .ENDIF
00163C  3               
00163C  2                       .INCLUDE "sid.asm"
00163C  3               
00163C  3               
00163C  3                       .IFDEF  MEMORYMAPPEDSCREEN
00163C  3               
00163C  3               PC6502_IO       = $E000
00163C  3               SID_BASE        = PC6502_IO+$100
00163C  3               
00163C  3               ;___SOUND__________________________________________________
00163C  3               ;
00163C  3               ; PLAY SOUND
00163C  3               ;
00163C  3               ;  SOUND VOICE, FREQ, DUTY, WAVEFORM, ATTACK, SUSTAIN, DECAY, RELEASE
00163C  3               ;
00163C  3               ;
00163C  3               ;__________________________________________________________
00163C  3               LAB_SOUND:
00163C  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (VOICE)
00163C  3                       TXA
00163C  3                       AND     #3
00163C  3                       ASL     A
00163C  3                       TAX
00163C  3                       LDA     SIDVOICELOOKUP,X
00163C  3                       STA     TEMPW
00163C  3                       LDA     SIDVOICELOOKUP+1,X
00163C  3                       STA     TEMPW+1
00163C  3                                               ; OK, TEMPW POINTS TO SID REGISTER TO MODIFY
00163C  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
00163C  3                       JSR     LAB_EVNM        ; evaluate expression and check is numeric,
00163C  3                                               ; else do type mismatch
00163C  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
00163C  3                       LDY     #0              ; SET FREQUENCY
00163C  3                       LDA     Itempl
00163C  3                       STA     (TEMPW),Y
00163C  3                       LDA     Itemph
00163C  3                       INX
00163C  3                       STA     (TEMPW),Y
00163C  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
00163C  3                       JSR     LAB_EVNM        ; evaluate expression and check is numeric,
00163C  3                                               ; else do type mismatch
00163C  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
00163C  3                       LDY     #2              ; SET DUTY CYCLE
00163C  3                       LDA     Itempl
00163C  3                       STA     (TEMPW),Y
00163C  3                       LDA     Itemph
00163C  3                       INY
00163C  3                       STA     (TEMPW),Y
00163C  3                       JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
00163C  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (WAVEFORM)
00163C  3                       TXA
00163C  3                       LDY     #4              ; SET WAVEFORM CYCLE
00163C  3                       STA     (TEMPW),Y
00163C  3                       JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
00163C  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (ATTACK)
00163C  3                       TXA
00163C  3                       LSR     A
00163C  3                       LSR     A
00163C  3                       LSR     A
00163C  3                       LSR     A
00163C  3                       STA     PTEMPW
00163C  3                       JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
00163C  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (DECAY)
00163C  3                       TXA
00163C  3                       AND     #$0F
00163C  3                       ORA     PTEMPW
00163C  3                       LDY     #5              ; SET ATTACK/DECAY
00163C  3                       STA     (TEMPW),Y
00163C  3                       JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
00163C  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (SUSTAIN)
00163C  3                       TXA
00163C  3                       LSR     A
00163C  3                       LSR     A
00163C  3                       LSR     A
00163C  3                       LSR     A
00163C  3                       STA     PTEMPW
00163C  3                       JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
00163C  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (RELEASE)
00163C  3                       TXA
00163C  3                       AND     #$0F
00163C  3                       ORA     PTEMPW
00163C  3                       LDY     #6              ; SET SUSTAIN/RELEASE
00163C  3                       STA     (TEMPW),Y
00163C  3                       RTS
00163C  3               SIDVOICELOOKUP:
00163C  3                       .WORD   SID_BASE,SID_BASE+7,SID_BASE+$12
00163C  3               
00163C  3               ;___FILTER_________________________________________________
00163C  3               ;
00163C  3               ; SET SID FILTERS
00163C  3               ;
00163C  3               ;  FILTER CUTOFF, RESONANCE, VOICE 1 ENABLE, VOICE 2 ENABLE, VOICE 3 ENABLE, EXTERNAL ENABLE, FILTER MODE, VOLUME
00163C  3               ;
00163C  3               ;
00163C  3               ;__________________________________________________________
00163C  3               LAB_FILTER:
00163C  3                       JSR     LAB_EVNM        ; evaluate expression and check is numeric,
00163C  3                                               ; else do type mismatch
00163C  3                       JSR     LAB_F2FX        ; save integer part of FAC1 in temporary integer
00163C  3                                               ; SET CUTOFF
00163C  3                       LDA     Itempl
00163C  3                       STA     SID_BASE+$15
00163C  3                       LDA     Itemph
00163C  3                       STA     SID_BASE+$16
00163C  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
00163C  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (RESONANCE)
00163C  3                       TXA
00163C  3                       LSR     A
00163C  3                       LSR     A
00163C  3                       LSR     A
00163C  3                       LSR     A
00163C  3                       STA     PTEMPW
00163C  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
00163C  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 1 ENABLE)
00163C  3                       TXA
00163C  3                       AND     #1
00163C  3                       ORA     PTEMPW
00163C  3                       STA     PTEMPW
00163C  3                       JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
00163C  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 2 ENABLE)
00163C  3                       TXA
00163C  3                       AND     #1
00163C  3                       LSR     A
00163C  3                       ORA     PTEMPW
00163C  3                       STA     PTEMPW
00163C  3                       JSR     LAB_1C01        ; GET THE FIFTH PARAMETER (AFTER ',') OR SYN ERR
00163C  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOICE 3 ENABLE)
00163C  3                       TXA
00163C  3                       AND     #1
00163C  3                       LSR     A
00163C  3                       LSR     A
00163C  3                       ORA     PTEMPW
00163C  3                       STA     PTEMPW
00163C  3                       JSR     LAB_1C01        ; GET THE SIXTH PARAMETER (AFTER ',') OR SYN ERR
00163C  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (EXTERNAL AUDIO ENABLE)
00163C  3                       TXA
00163C  3                       AND     #1
00163C  3                       LSR     A
00163C  3                       LSR     A
00163C  3                       LSR     A
00163C  3                       ORA     PTEMPW
00163C  3                       STA     SID_BASE+$17
00163C  3                       JSR     LAB_1C01        ; GET THE SEVENTH PARAMETER (AFTER ',') OR SYN ERR
00163C  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (FILTER MODE)
00163C  3                       TXA
00163C  3                       LSR     A
00163C  3                       LSR     A
00163C  3                       LSR     A
00163C  3                       LSR     A
00163C  3                       STA     PTEMPW
00163C  3                       JSR     LAB_1C01        ; GET THE EIGHTH PARAMETER (AFTER ',') OR SYN ERR
00163C  3                       JSR     LAB_GTBY        ; GET THE PARAMETER, RETURN IN X (VOLUME)
00163C  3                       TXA
00163C  3                       AND     #$0F
00163C  3                       ORA     PTEMPW
00163C  3                       STA     SID_BASE+$18
00163C  3                       RTS
00163C  3               
00163C  3                       .ELSE
00163C  3               
00163C  3               
00163C  3               ; ENSURE ALL OF THESE SPECIAL COMMANDS GIVE ERRORS IN NORMAL BASIC
00163C  3               LAB_SOUND:
00163C  3               LAB_FILTER:
00163C  3  A2 02                LDX     #$02            ; error code $02 ("SYNTAX" error)
00163E  3  4C D5 18             JMP     LAB_XERR        ; do error #X, then warm start
001641  3               
001641  3                       .ENDIF
