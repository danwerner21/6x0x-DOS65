001456  3  A2 02                LDX     #$02            ; NOPE, SYNTAX ERROR
001458  3  20 C9 18             JSR     LAB_XERR
00145B  3  4C A5 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
