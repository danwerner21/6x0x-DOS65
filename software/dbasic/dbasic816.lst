0010AF  2               PRINT_CRLF:
0010AF  2  8E 1D 11             STX     TTX
0010B2  2  8C 1E 11             STY     TTY
0010B5  2  8D 1F 11             STA     TTA
0010B8  2  A9 0D                LDA     #13
0010BA  2  20 20 11             JSR     WRSER1          ; output upper nybble
0010BD  2  A9 0A                LDA     #10
0010BF  2  20 20 11             JSR     WRSER1          ; output upper nybble
0010C2  2  AE 1D 11             LDX     TTX
0010C5  2  AC 1E 11             LDY     TTY
0010C8  2  AD 1F 11             LDA     TTA
0010CB  2  60                   RTS
0010CC  2               
0010CC  2               PRINT_SPACE:
0010CC  2  8E 1D 11             STX     TTX
0010CF  2  8C 1E 11             STY     TTY
0010D2  2  8D 1F 11             STA     TTA
0010D5  2  A9 20                LDA     #32
0010D7  2  20 20 11             JSR     WRSER1          ; output upper nybble
0010DA  2  AE 1D 11             LDX     TTX
0010DD  2  AC 1E 11             LDY     TTY
0010E0  2  AD 1F 11             LDA     TTA
0010E3  2  60                   RTS
0010E4  2               
0010E4  2               
0010E4  2               PRINT_BYTE:
0010E4  2  8E 1D 11             STX     TTX
0010E7  2  8C 1E 11             STY     TTY
0010EA  2  8D 1F 11             STA     TTA
0010ED  2  8E 1C 11             STX     SAVX            ; save X
0010F0  2  20 07 11             JSR     ASCTWO          ; get hex chars for byte in X (lower) and A (upper)
0010F3  2  20 20 11             JSR     WRSER1          ; output upper nybble
0010F6  2  8A                   TXA                     ; transfer lower to A
0010F7  2  AE 1C 11             LDX     SAVX            ; restore X
0010FA  2  20 20 11             JSR     WRSER1          ; output lower nybble
0010FD  2  AE 1D 11             LDX     TTX
001100  2  AC 1E 11             LDY     TTY
001103  2  AD 1F 11             LDA     TTA
001106  2  60                   RTS
001107  2               ASCTWO:
001107  2  48                   PHA                     ; save byte
001108  2  20 11 11             JSR     ASCII           ; do low nybble
00110B  2  AA                   TAX                     ; save in X
00110C  2  68                   PLA                     ; restore byte
00110D  2  4A                   LSR     A               ; shift upper nybble down
00110E  2  4A                   LSR     A
00110F  2  4A                   LSR     A
001110  2  4A                   LSR     A
001111  2               ; convert low nybble in A to hex digit
001111  2               ASCII:
001111  2  29 0F                AND     #$0F            ; clear upper nibble
001113  2  C9 0A                CMP     #$0A            ; if less than A, skip next step
001115  2  90 02                BCC     ASC1
001117  2  69 06                ADC     #6              ; skip ascii chars between 9 and A
001119  2               ASC1:
001119  2  69 30                ADC     #$30            ; add ascii char 0 to value
00111B  2  60                   RTS
00111C  2               SAVX:
00111C  2  00                   .BYTE   00
00111D  2               TTX:
00111D  2  00                   .BYTE   00
00111E  2               TTY:
00111E  2  00                   .BYTE   00
00111F  2               TTA:
00111F  2  00                   .BYTE   00
001120  2               ;__WRSER1________________________________________________________________________________________________________________________
001120  2               ;
001120  2               ;	WRITE CHARACTER(A) TO UART
001120  2               ;________________________________________________________________________________________________________________________________
001120  2               ;
001120  2               WRSER1:
001120  2  48                   PHA
001121  2               WRSER1a:
001121  2  AD 85 EF             LDA     UART1STATUS     ; GET STATUS
001124  2  29 10                AND     #%00010000      ; IS TX READY
001126  2  F0 F9                BEQ     WRSER1a         ; NO, WAIT FOR IT
001128  2  68                   PLA
001129  2  8D 84 EF             STA     UART1DATA       ; WRITE DATA
00112C  2  60                   RTS
