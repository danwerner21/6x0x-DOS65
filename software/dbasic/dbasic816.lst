00117E  3               ;___SAVE____________________________________________________
00117E  3               ;
00117E  3               ; SAVE COMMAND
00117E  3               ;
00117E  3               ;  SAVE THE BASIC PROGRAM IN MEMORY TO DISK
00117E  3               ;
00117E  3               ;__________________________________________________________
00117E  3               V_SAVE: ; save BASIC program
00117E  3               DOS65SAVE:
00117E  3  20 F3 12             JSR     DOS65FCBPREP    ; parse parameters into FCB
001181  3  B0 29                BCS     DOS65SAVE_ERR1  ; Error?, if so abort
001183  3  A2 0D                LDX     #13             ;
001185  3  20 78 11             JSR     PEM             ;
001188  3  A9 40                LDA     #<FCB           ; CREATE File
00118A  3  A0 16                LDY     #>FCB           ;
00118C  3  A2 16                LDX     #22             ;
00118E  3  20 78 11             JSR     PEM             ;
001191  3  A9 00                LDA     #0              ; clear
001193  3  8D 60 16             STA     FCB+32          ; record number
001196  3  A9 40                LDA     #<FCB           ; Open File
001198  3  A0 16                LDY     #>FCB           ;
00119A  3  A2 0F                LDX     #15             ;
00119C  3  20 78 11             JSR     PEM             ;
00119F  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
0011A1  3  D0 0C                BNE     DOS65SAVE_1     ;
0011A3  3               DOS65SAVE_ERR:
0011A3  3  A9 AC                LDA     #<FILEERROR2    ; NO, ERROR OUT
0011A5  3  A0 0F                LDY     #>FILEERROR2
0011A7  3  A2 09                LDX     #9              ; Print error message
0011A9  3  20 78 11             JSR     PEM             ;
0011AC  3               DOS65SAVE_ERR1:
0011AC  3  4C 31 1F             JMP     LAB_REM         ; comment out the remainder of the line (if any)
0011AF  3               DOS65SAVE_1:
0011AF  3  A9 BB                LDA     #<FCBBUFFER     ; SETUP BUFFER
0011B1  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
0011B3  3  A0 3F                LDY     #>FCBBUFFER     ;
0011B5  3  84 21                STY     FCBPTR+1        ;
0011B7  3  A2 1A                LDX     #26             ; Setup Buffer
0011B9  3  20 78 11             JSR     PEM             ;
0011BC  3               DOS65SAVE_2:
0011BC  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
0011BE  3  85 22                STA     FCBPTR+2        ; point to base of RAM
0011C0  3  A5 7A                LDA     <Smemh          ;
0011C2  3  85 23                STA     FCBPTR+3        ;
0011C4  3  A2 00                LDX     #$00            ; x=0 (null counter)
0011C6  3               DOS65SAVE_2A:
0011C6  3  A0 00                LDY     #$00            ; y=0 (Loop Index)
0011C8  3               DOS65SAVE_3:
0011C8  3  B1 22                LDA     (FCBPTR+2),Y    ; load from RAM
0011CA  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
0011CC  3  C9 00                CMP     #$00            ; is Zero?
0011CE  3  D0 1E                BNE     DOS65SAVE_3A    ; No, continue
0011D0  3  E8                   INX                     ; yes, bump Null Counter
0011D1  3  E0 03                CPX     #$03            ; Three nulls in a row?
0011D3  3  D0 1B                BNE     DOS65SAVE_3B    ; No, continue
0011D5  3                                               ; FINISH FILLING BUFFER WITH NULLS
0011D5  3               :
0011D5  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
0011D7  3  C8                   INY                     ; bump index
0011D8  3  C0 80                CPY     #$80            ; end of buffer?
0011DA  3  D0 F9                BNE     :-              ; no, loop
0011DC  3  A9 40                LDA     #<FCB           ; Write record in buffer to disk file AND END
0011DE  3  A0 16                LDY     #>FCB           ;
0011E0  3  A2 15                LDX     #21             ;
0011E2  3  20 78 11             JSR     PEM             ;
0011E5  3  29 FE                AND     #$FE            ; strip out extension
0011E7  3  C9 00                CMP     #$00            ; is error
0011E9  3  D0 B8                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
0011EB  3  4C 1B 12             JMP     DOS65SAVE_4
0011EE  3               DOS65SAVE_3A:                   ;
0011EE  3  A2 00                LDX     #$00            ; prior char not null, reset null counter
0011F0  3               DOS65SAVE_3B:                   ;
0011F0  3  C8                   INY                     ; bump index
0011F1  3  C0 80                CPY     #$80            ; end of buffer?
0011F3  3  D0 D3                BNE     DOS65SAVE_3     ; no, loop
0011F5  3               DOS65SAVE_3C:
0011F5  3  A9 40                LDA     #<FCB           ; Write record in buffer to disk file
0011F7  3  A0 16                LDY     #>FCB           ;
0011F9  3  A2 15                LDX     #21             ;
0011FB  3  20 78 11             JSR     PEM             ;
0011FE  3  29 FE                AND     #$FE            ; strip out extension
001200  3  C9 00                CMP     #$00            ; is error
001202  3  D0 9F                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
001204  3  18                   CLC                     ;
001205  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
001207  3  69 80                ADC     #$80            ;
001209  3  85 22                STA     FCBPTR+2        ;
00120B  3  90 B9                BCC     DOS65SAVE_2A    ; is carry?, no loop
00120D  3  18                   CLC                     ; yes, carry, inc high byte
00120E  3  A5 23                LDA     FCBPTR+3        ;
001210  3  69 01                ADC     #$01            ;
001212  3  85 23                STA     FCBPTR+3        ;
001214  3  C9 D0                CMP     #>Ram_top       ; are we at the end of RAM?
001216  3  F0 03                BEQ     DOS65SAVE_4
001218  3  4C C6 11             JMP     DOS65SAVE_2A
00121B  3               DOS65SAVE_4:
00121B  3  A9 40                LDA     #<FCB           ;
00121D  3  A0 16                LDY     #>FCB           ;
00121F  3  A2 10                LDX     #16             ;
001221  3  20 78 11             JSR     PEM             ;
001224  3  C9 FF                CMP     #$FF            ;
001226  3  D0 03                BNE     DOS65SAVE_5     ;
001228  3  4C A3 11             JMP     DOS65SAVE_ERR   ; ERROR, DISPLAY IT
00122B  3               DOS65SAVE_5:
00122B  3  A9 53                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
00122D  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
00122F  3  20 C2 21             JSR     LAB_18C3
001232  3  4C FC 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
