001439  3  A2 0D                LDX     #13             ; INITIALIZE SYSTEM
00143B  3  20 3C 11             JSR     PEM             ;
00143E  3  AE 84 14             LDX     OPNTMP          ; OPEN OR CREATE
001441  3  A9 F5                LDA     #<FCB           ; FCB
001443  3  A0 15                LDY     #>FCB           ; FCB
001445  3  20 3C 11             JSR     PEM
001448  3  C9 FF                CMP     #$FF
00144A  3  D0 08                BNE     :+
00144C  3  A2 24                LDX     #$24            ; IO ERROR
00144E  3  20 D5 18             JSR     LAB_XERR
001451  3  4C B1 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001454  3               :
