0012A1  3  A9 5D                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
0012A3  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
0012A5  3  20 6D 21             JSR     LAB_18C3
0012A8  3  4C A7 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
