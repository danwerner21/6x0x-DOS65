001252  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
001254  3  D0 0C                BNE     DOS65LOAD_1     ;
001256  3               DOS65LOAD_ERR:
001256  3  A9 AC                LDA     #<FILEERROR2    ; NO, ERROR OUT
001258  3  A0 0F                LDY     #>FILEERROR2
