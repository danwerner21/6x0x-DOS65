001401  3  B9 E9 15             LDA     FCB,Y
001404  3  C9 2E                CMP     #'.'
001406  3  F0 0A                BEQ     V_OPEN_EXTENSION
001408  3  C4 AC                CPY     str_ln
00140A  3  F0 21                BEQ     V_OPEN_FNEND
00140C  3  4C 00 14             JMP     :-
00140F  3  4C 2D 14             JMP     V_OPEN_FNEND
