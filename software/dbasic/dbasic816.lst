0014A6  3               ;___CLOSE____________________________________________________
0014A6  3               ;
0014A6  3               ; CLOSE A FILE
0014A6  3               ;
0014A6  3               ; BASIC COMMAND EXPECTS ONE VAR
0014A6  3               ;
0014A6  3               ; FILE$
0014A6  3               ;
0014A6  3               ; FILE$ = STRING HOLDING 33 BYTE FCB
0014A6  3               ;__________________________________________________________
0014A6  3               V_CLOSE:
0014A6  3  20 32 27             JSR     LAB_GVAR        ; GET THE FIRST PARAMETER
0014A9  3  20 26 24             JSR     LAB_CTST        ; check if source is string, else do type mismatch
0014AC  3  A0 02                LDY     #$02            ; index to string pointer high byte
0014AE  3  8B DA A2 01          LDAINDIRECTY Cvaral     ; get string pointer high byte
0014B2  3  B5 95 C9 00  
0014B6  3  D0 04 A2 00  
0014C4  3  85 FE                STA     TEMPW+1         ; set string pointer high byte
0014C6  3  88                   DEY                     ; index to string pointer low byte
0014C7  3  8B DA A2 01          LDAINDIRECTY Cvaral     ; get string pointer low byte
0014CB  3  B5 95 C9 00  
0014CF  3  D0 04 A2 00  
0014DD  3  85 FD                STA     TEMPW           ; set string pointer low byte
0014DF  3  A2 10                LDX     #16             ; CLOSE
0014E1  3  A5 FD                LDA     TEMPW           ; FCB
0014E3  3  A4 FE                LDY     TEMPW+1         ; FCB
0014E5  3  20 4E 11             JSR     PEM
0014E8  3  C9 FF                CMP     #$FF
0014EA  3  D0 08                BNE     :+
0014EC  3  A2 24                LDX     #$24            ; IO ERROR
0014EE  3  20 F6 18             JSR     LAB_XERR
0014F1  3  4C D2 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
0014F4  3               :
0014F4  3  60                   RTS
