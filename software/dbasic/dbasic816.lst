001463  3                                               ; X=$AD=<Sutill=ptr low byte, Y=$AE=<Sutilh=ptr high byte
001463  3                                               ; COPY FCB TO STRING
001463  3  A2 21                LDX     #33             ;
001465  3  A0 21                LDY     #33             ;
