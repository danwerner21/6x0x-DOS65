0011B9  3               DOS65FCBPREP_1:
0011B9  3  A9 38                LDA     #<FCB           ; SETUP FCBPTR
0011BB  3  85 20                STA     FCBPTR          ;
0011BD  3  A9 12                LDA     #>FCB           ;
0011BF  3  85 21                STA     FCBPTR+1        ;
0011C1  3  A0 01                LDY     #$01            ; POINT Y TO FCB FILE NAME
0011C3  3  A9 20                LDA     #$20            ; LOAD SPACE CHAR INTO A
0011C5  3               DOS65FCBPREP_1A:                ; BLANK OUT FCB
0011C5  3  8B DA 48 A2          STAINDIRECTY FCBPTR     ;
0011C9  3  01 B5 20 C9  
0011CD  3  00 D0 04 A2  
0011DB  3  C8                   INY                     ;
0011DC  3  C0 09                CPY     #$09            ; IS DONE
0011DE  3  D0 E5                BNE     DOS65FCBPREP_1A ; NO, LOOP
0011E0  3  A0 01                LDY     #$01            ; POINT Y TO FCB FILE NAME
0011E2  3               DOS65FCBPREP_2:                 ; COPY FILE NAME PARAMETER INTO FCB
0011E2  3                       .IFDEF  DUODYNE
0011E2  3  22 BC 00 00          JSL     LAB_IGBY        ; increment and scan memory
0011E6  3                       .ELSE
0011E6  3                       JSR     LAB_IGBY        ; increment and scan memory
0011E6  3                       .ENDIF
0011E6  3  F0 22                BEQ     DOS65FCBPREP_3  ;
0011E8  3  C9 2E                CMP     #'.'
0011EA  3  F0 1E                BEQ     DOS65FCBPREP_3  ;
0011EC  3  8B DA 48 A2          STAINDIRECTY FCBPTR     ;
0011F0  3  01 B5 20 C9  
0011F4  3  00 D0 04 A2  
001202  3  C8                   INY                     ;
001203  3  C0 09                CPY     #$09            ;
001205  3  F0 03                BEQ     DOS65FCBPREP_3  ;
001207  3  4C E2 11             JMP     DOS65FCBPREP_2  ;
00120A  3               DOS65FCBPREP_3:                 ;
00120A  3  18                   CLC
