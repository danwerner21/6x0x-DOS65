00131A  3  8B DA 48 A2          STAINDIRECTY FCBPTR     ;
00131E  3  01 B5 20 C9  
001322  3  00 D0 04 A2  
001330  3  C8                   INY                     ;
001331  3  C0 09                CPY     #$09            ;
001333  3  F0 03                BEQ     DOS65FCBPREP_3  ;
