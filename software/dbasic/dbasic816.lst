0012D7  3                       .IFDEF  DUODYNE
0012D7  3  22 BC 00 00          JSL     LAB_IGBY        ; increment and scan memory
0012DB  3                       .ELSE
0012DB  3                       JSR     LAB_IGBY        ; increment and scan memory
0012DB  3                       .ENDIF
0012DB  3               
0012DB  3  C9 3A                CMP     #':'            ;
0012DD  3  F0 08                BEQ     DOS65FCBPREP_1  ; YES, IT WAS A DRIVE, CONTINUE
0012DF  3  A2 26                LDX     #$26            ; IO ERROR
0012E1  3  20 84 1A             JSR     LAB_XERR
0012E4  3  4C 60 1B             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
0012E7  3               
