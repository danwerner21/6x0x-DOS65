0010B4  2  8D 58 10             STA     printflag
0010B7  2  28                   PLP
0010B8  2  20 74 22             JSR     LAB_PRINT
0010BB  2  A9 00                LDA     #$00
0010BD  2  8D 58 10             STA     printflag
0010C0  2  60                   RTS
