0010E8  2  8E 39 11             STX     TTX
0010EB  2  8C 3A 11             STY     TTY
0010EE  2  8D 3B 11             STA     TTA
0010F1  2  A9 20                LDA     #32
0010F3  2  20 3C 11             JSR     WRSER1          ; output upper nybble
0010F6  2  AE 39 11             LDX     TTX
0010F9  2  AC 3A 11             LDY     TTY
0010FC  2  AD 3B 11             LDA     TTA
0010FF  2  60                   RTS
001100  2               
001100  2               
001100  2               PRINT_BYTE:
001100  2  8E 39 11             STX     TTX
001103  2  8C 3A 11             STY     TTY
001106  2  8D 3B 11             STA     TTA
001109  2  8E 38 11             STX     SAVX            ; save X
00110C  2  20 23 11             JSR     ASCTWO          ; get hex chars for byte in X (lower) and A (upper)
00110F  2  20 3C 11             JSR     WRSER1          ; output upper nybble
001112  2  8A                   TXA                     ; transfer lower to A
001113  2  AE 38 11             LDX     SAVX            ; restore X
001116  2  20 3C 11             JSR     WRSER1          ; output lower nybble
001119  2  AE 39 11             LDX     TTX
00111C  2  AC 3A 11             LDY     TTY
00111F  2  AD 3B 11             LDA     TTA
001122  2  60                   RTS
001123  2               ASCTWO:
001123  2  48                   PHA                     ; save byte
001124  2  20 2D 11             JSR     ASCII           ; do low nybble
001127  2  AA                   TAX                     ; save in X
001128  2  68                   PLA                     ; restore byte
001129  2  4A                   LSR     A               ; shift upper nybble down
00112A  2  4A                   LSR     A
00112B  2  4A                   LSR     A
00112C  2  4A                   LSR     A
00112D  2               ; convert low nybble in A to hex digit
00112D  2               ASCII:
00112D  2  29 0F                AND     #$0F            ; clear upper nibble
00112F  2  C9 0A                CMP     #$0A            ; if less than A, skip next step
001131  2  90 02                BCC     ASC1
001133  2  69 06                ADC     #6              ; skip ascii chars between 9 and A
001135  2               ASC1:
001135  2  69 30                ADC     #$30            ; add ascii char 0 to value
001137  2  60                   RTS
001138  2               SAVX:
001138  2  00                   .BYTE   00
001139  2               TTX:
001139  2  00                   .BYTE   00
00113A  2               TTY:
00113A  2  00                   .BYTE   00
00113B  2               TTA:
00113B  2  00                   .BYTE   00
