0017D2  3               ;___V_SCRCLR________________________________________________
0017D2  3               ;
0017D2  3               ; CLEAR SCREEN
0017D2  3               ;
0017D2  3               ;__________________________________________________________
0017D2  3               LAB_SCRCLR:
0017D2  3               V_SCNCLR:
0017D2  3                       STA     DBGA
0017D2  3                       STY     DBGY
0017D2  3                       STX     DBGX
0017D2  3                       LDA     #38
0017D2  3                       STA     farfunct
0017D2  3                       JSR     DO_FARCALL
0017D2  3                       LDA     #59
0017D2  3                       STA     farfunct
0017D2  3                       JSR     DO_FARCALL
0017D2  3                       LDA     DBGA
0017D2  3                       LDY     DBGY
0017D2  3                       LDX     DBGX
0017D2  3                       RTS
0017D2  3               
0017D2  3               
0017D2  3               
0017D2  3               ;___V_LOCATE________________________________________________
0017D2  3               ;
0017D2  3               ; SET CURSOR LOCATION
0017D2  3               ;
0017D2  3               ;       LOCATE X,Y
0017D2  3               ;
0017D2  3               ;__________________________________________________________
0017D2  3               V_LOCATE:
0017D2  3               LAB_LOCATE:
0017D2  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (MODE)
0017D2  3                       STX     DBGX
0017D2  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
0017D2  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
0017D2  3                       TXA
0017D2  3                       TAY
0017D2  3                       LDX     DBGX
0017D2  3                       LDA     #37
0017D2  3                       STA     farfunct
0017D2  3                       JSR     DO_FARCALL
0017D2  3                       RTS
0017D2  3               
0017D2  3               ;___V_COLOR_________________________________________________
0017D2  3               ;
0017D2  3               ; SET COLOR FG,BG,CFG,CBG
0017D2  3               ;
0017D2  3               ;__________________________________________________________
0017D2  3               LAB_COLOR:
0017D2  3               V_COLOR:
0017D2  3                       LDA     #$00            ; CLEAR TEMP SPACE
0017D2  3                       STA     PTEMPW
0017D2  3                       STA     PTEMPW+1
0017D2  3                       JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (MODE)
0017D2  3                       TXA
0017D2  3                       AND     #$0F
0017D2  3                       STA     PTEMPW
0017D2  3                       JSR     LAB_1C01        ; GET THE SECOND PARAMETER (AFTER ',') OR SYN ERR
0017D2  3                       JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X
0017D2  3                       TXA
0017D2  3                       ASL     A
0017D2  3                       ASL     A
0017D2  3                       ASL     A
0017D2  3                       ASL     A
0017D2  3                       ORA     PTEMPW
0017D2  3                       STA     PTEMPW
0017D2  3                       JSR     LAB_1C01        ; GET THE THIRD PARAMETER (AFTER ',') OR SYN ERR
0017D2  3                       JSR     LAB_GTBY        ; GET THE THIRD PARAMETER, RETURN IN X
0017D2  3                       TXA
0017D2  3                       AND     #$0F
0017D2  3                       STA     PTEMPW+1
0017D2  3                       JSR     LAB_1C01        ; GET THE FOURTH PARAMETER (AFTER ',') OR SYN ERR
0017D2  3                       JSR     LAB_GTBY        ; GET THE FOURTH PARAMETER, RETURN IN X
0017D2  3                       TXA
0017D2  3                       ASL     A
0017D2  3                       ASL     A
0017D2  3                       ASL     A
0017D2  3                       ASL     A
0017D2  3                       ORA     PTEMPW+1
0017D2  3                       STA     PTEMPW+1
0017D2  3                       LDX     PTEMPW
0017D2  3                       LDY     PTEMPW+1
0017D2  3                       LDA     #39
0017D2  3                       STA     farfunct
0017D2  3                       JSR     DO_FARCALL
0017D2  3                       RTS
0017D2  3               
