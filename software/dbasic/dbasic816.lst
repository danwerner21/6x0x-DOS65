001641  3               ;___LAB_SECOND______________________________________________
001641  3               ;
001641  3               ; RETURN SYSTEM SECONDS
001641  3               ;
001641  3               ;__________________________________________________________
001641  3               LAB_SECOND:
001641  3  A2 00                LDX     #RTCSECONDS
001643  3  A9 33                LDA     #51
001645  3  85 32                STA     farfunct
001647  3  20 F0 FF             JSR     DO_FARCALL
00164A  3  98                   TYA
00164B  3               
00164B  3  20 DC 16             JSR     BCD_TO_HEX
00164E  3  A8                   TAY
00164F  3  A9 00                LDA     #0              ; Get high byte
001651  3  20 CC 29             JSR     LAB_AYFC
001654  3  60                   RTS
001655  3               LAB_PSECOND:
001655  3  46 5F                LSR     <Dtypef         ; clear data type flag, $FF=string, $00=numeric
001657  3  20 BC 00             JSR     LAB_IGBY        ; increment and scan memory then do function
00165A  3  60                   RTS
