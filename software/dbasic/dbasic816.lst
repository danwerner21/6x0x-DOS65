0011F1  3  20 A9 12             JSR     DOS65FCBPREP    ; parse parameters into FCB
0011F4  3  B0 1F                BCS     DOS65LOAD_ERR1  ; Error?, if so abort
0011F6  3  A2 0D                LDX     #13             ;
0011F8  3  20 30 11             JSR     PEM             ;
0011FB  3  A9 00                LDA     #0              ; clear
0011FD  3  8D 09 16             STA     FCB+32          ; record number
001200  3  A9 E9                LDA     #<FCB           ; Open File
001202  3  A0 15                LDY     #>FCB           ;
001204  3  A2 0F                LDX     #15             ;
001206  3  20 30 11             JSR     PEM             ;
001209  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
00120B  3  D0 0B                BNE     DOS65LOAD_1     ;
00120D  3               DOS65LOAD_ERR:
00120D  3  A2 26                LDX     #$26            ; IO ERROR
00120F  3  20 C9 18             JSR     LAB_XERR
001212  3  4C A5 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001215  3               DOS65LOAD_ERR1:
001215  3  4C DA 1E             JMP     LAB_REM         ; comment out the remainder of the line (if any)
001218  3               DOS65LOAD_1:
001218  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
00121A  3  85 22                STA     FCBPTR+2        ; point to base of RAM
00121C  3  8D 16 13             STA     EndOfBas        ;
00121F  3  A5 7A                LDA     <Smemh          ;
001221  3  85 23                STA     FCBPTR+3        ;
001223  3  8D 17 13             STA     EndOfBas+1      ;
001226  3  A9 64                LDA     #<FCBBUFFER     ; SETUP BUFFER
001228  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
00122A  3  A0 3F                LDY     #>FCBBUFFER     ;
00122C  3  84 21                STY     FCBPTR+1        ; STORE DEST BUFFER IN FCBPTR
00122E  3  A2 1A                LDX     #26             ; Setup Buffer
001230  3  20 30 11             JSR     PEM             ;
001233  3  4C 71 12             JMP     DOS65LOAD_3C
001236  3               DOS65LOAD_3:
001236  3  B1 20                LDA     (FCBPTR),Y      ; load from BUFFER
001238  3  91 22                STA     (FCBPTR+2),Y    ; save to RAM
00123A  3  EE 16 13             INC     EndOfBas
00123D  3  D0 03                BNE     :+
00123F  3  EE 17 13             INC     EndOfBas+1
001242  3               :
001242  3  C9 00                CMP     #$00
001244  3  D0 0D                BNE     :+
001246  3  EE 18 13             INC     NullCounter
001249  3  AD 18 13             LDA     NullCounter
00124C  3  C9 03                CMP     #3
00124E  3  D0 08                BNE     :++
001250  3  4C 84 12             JMP     DOS65LOAD_4
001253  3               :
001253  3  A9 00                LDA     #$00
001255  3  8D 18 13             STA     NullCounter
001258  3               :
001258  3  C8                   INY                     ; bump index
001259  3  C0 80                CPY     #$80            ; end of buffer?
00125B  3  D0 D9                BNE     DOS65LOAD_3     ; no, loop
00125D  3  18                   CLC                     ;
00125E  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
001260  3  69 80                ADC     #$80            ;
001262  3  85 22                STA     FCBPTR+2        ;
001264  3  90 0B                BCC     DOS65LOAD_3C    ; is carry?, no SKIP
001266  3  18                   CLC                     ; yes, carry, inc high byte
001267  3  A5 23                LDA     FCBPTR+3        ;
001269  3  69 01                ADC     #$01            ;
00126B  3  85 23                STA     FCBPTR+3        ;
00126D  3  C9 D0                CMP     #>Ram_top       ; are we at the end of RAM?
00126F  3  F0 13                BEQ     DOS65LOAD_4
001271  3               
001271  3               DOS65LOAD_3C:
001271  3  A9 E9                LDA     #<FCB           ; READ record buffer from disk file
001273  3  A0 15                LDY     #>FCB           ;
001275  3  A2 14                LDX     #20             ;
001277  3  20 30 11             JSR     PEM             ;
00127A  3  A0 00                LDY     #$00            ; RESET INDEX
00127C  3  C9 00                CMP     #$00            ; is error or EOF
00127E  3  F0 B6                BEQ     DOS65LOAD_3     ;
001280  3  C9 01                CMP     #$01            ; EOF?
001282  3  D0 89                BNE     DOS65LOAD_ERR   ; ERROR, do error handling
001284  3               DOS65LOAD_4:
001284  3  A9 E9                LDA     #<FCB           ;
001286  3  A0 15                LDY     #>FCB           ;
001288  3  A2 10                LDX     #16             ;
00128A  3  20 30 11             JSR     PEM             ;
00128D  3                                               ; setup pointers to return to basic
00128D  3  AD 16 13             LDA     EndOfBas
001290  3  85 7B                STA     Svarl
001292  3  85 7D                STA     Sarryl
001294  3  85 7F                STA     Earryl
001296  3  AD 17 13             LDA     EndOfBas+1
001299  3  85 7C                STA     Svarh
00129B  3  85 7E                STA     Sarryh
00129D  3  85 80                STA     Earryh
00129F  3  A9 5B                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
0012A1  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
0012A3  3  20 6B 21             JSR     LAB_18C3
0012A6  3  4C A5 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
