00169F  3               ;___RENAME_________________________________________________
00169F  3               ;
00169F  3               ; RENAME A FILE
00169F  3               ;
00169F  3               ;
00169F  3               ; BASIC COMMAND EXPECTS THREE VARS
00169F  3               ; DRIVE, FILENAME$, NEWFILENAME$
00169F  3               ;
00169F  3               ; DRIVE = NUMERIC DRIVE -- 0=CURRENT, 1=A, 2=B . . .
00169F  3               ; FILENAME$ = OLD FILENAME STRING
00169F  3               ; FILENAME$ = NEW FILENAME STRING
00169F  3               ;__________________________________________________________
00169F  3               V_RENAME:
00169F  3               ; CLEAR FCB
00169F  3  A9 00                LDA     #0              ; FILL WITH NULL
0016A1  3  A0 00                LDY     #0              ;
0016A3  3               :
0016A3  3  99 A4 17             STA     FCB,Y           ;
0016A6  3  C8                   INY                     ;
0016A7  3  C0 21                CPY     #33             ;
0016A9  3  D0 F8                BNE     :-              ;
0016AB  3                                               ;
0016AB  3  A9 20                LDA     #32             ; FILL FILENAME AND EXTENSION WITH SPACES
0016AD  3  A0 01                LDY     #1              ;
0016AF  3               :
0016AF  3  99 A4 17             STA     FCB,Y           ;
0016B2  3  C8                   INY                     ;
0016B3  3  C0 0C                CPY     #12             ;
0016B5  3  D0 F8                BNE     :-              ;
0016B7  3  A0 11                LDY     #17             ;
0016B9  3               :
0016B9  3  99 A4 17             STA     FCB,Y           ;
0016BC  3  C8                   INY                     ;
0016BD  3  C0 1D                CPY     #29             ;
0016BF  3  D0 F8                BNE     :-              ;
0016C1  3                                               ;
0016C1  3  20 5B 32             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (DRIVE)
0016C4  3  8A                   TXA
0016C5  3  8D A4 17             STA     FCB             ; STORE DRIVE IN FCB
0016C8  3  8D B4 17             STA     FCB+16          ; STORE DRIVE IN FCB
0016CB  3                                               ;
0016CB  3  20 CD 26             JSR     LAB_1C01        ; (AFTER ',') OR SYN ERR
0016CE  3  20 AB 25             JSR     LAB_EVEX        ; GET THE SECOND PARAMETER
0016D1  3  A5 5F                LDA     <Dtypef         ; IS IT A STRING?
0016D3  3  D0 08                BNE     :+              ; YES, CONTINUE ON
0016D5  3  A2 02                LDX     #$02            ; NOPE, SYNTAX ERROR
0016D7  3  20 84 1A             JSR     LAB_XERR
0016DA  3  4C 60 1B             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
0016DD  3               :
0016DD  3  20 D2 2F             JSR     LAB_22B6        ; pop string off descriptor stack, or from top of string
0016E0  3                                               ; space returns with A = length, X=$71=pointer low byte,
0016E0  3                                               ; Y=$72=pointer high byte
