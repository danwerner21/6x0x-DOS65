003E92  1               
003E92  1  F0 F9                BEQ     LAB_MIN         ; branch if no swap to do
003E94  1               
003E94  1  A5 B4                LDA     FAC2_1          ; get FAC2 mantissa1
003E96  1  09 80                ORA     #$80            ; set top bit (clear sign from compare)
003E98  1  85 B4                STA     FAC2_1          ; save FAC2 mantissa1
003E9A  1  20 CE 32             JSR     LAB_279B        ; copy FAC2 to FAC1
003E9D  1  F0 EE                BEQ     LAB_MIN         ; go do next (branch always)
003E9F  1               
003E9F  1               ; exit routine. don't bother returning to the loop code
003E9F  1               ; check for correct exit, else so syntax error
003E9F  1               
003E9F  1               LAB_MMEC:
003E9F  1  C9 29                CMP     #')'            ; is it end of function?
003EA1  1  D0 07                BNE     LAB_MMSE        ; if not do MAX MIN syntax error
003EA3  1               
003EA3  1  68                   PLA                     ; dump return address low byte
003EA4  1  68                   PLA                     ; dump return address high byte
003EA5  1                       .IFDEF  DUODYNE
003EA5  1  22 BC 00 00          JSL     LAB_IGBY        ; increment and scan memory
003EA9  1                       .ELSE
003EA9  1                       JSR     LAB_IGBY        ; increment and scan memory
003EA9  1                       .ENDIF
