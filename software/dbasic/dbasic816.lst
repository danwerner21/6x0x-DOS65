003EC8  1                       .IFDEF  DUODYNE
003EC8  1  22 BC 00 00          JSL     LAB_IGBY        ; increment and scan memory
003ECC  1                       .ELSE
003ECC  1                       JSR     LAB_IGBY        ; increment and scan memory
003ECC  1                       .ENDIF
