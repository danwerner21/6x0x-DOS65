0010AC  2  60                   RTS
0010AD  2               
0010AD  2               
0010AD  2               UART1DATA       = $EF84         ; SERIAL PORT 1 (I/O Card)
0010AD  2               UART1STATUS     = $EF85         ; SERIAL PORT 1 (I/O Card)
0010AD  2               UART1COMMAND    = $EF86         ; SERIAL PORT 1 (I/O Card)
0010AD  2               UART1CONTROL    = $EF87         ; SERIAL PORT 1 (I/O Card)
0010AD  2               
0010AD  2               PRINT_CRLF:
0010AD  2  8E 1B 11             STX     TTX
0010B0  2  8C 1C 11             STY     TTY
0010B3  2  8D 1D 11             STA     TTA
0010B6  2  A9 0D                LDA     #13
0010B8  2  20 1E 11             JSR     WRSER1          ; output upper nybble
0010BB  2  A9 0A                LDA     #10
0010BD  2  20 1E 11             JSR     WRSER1          ; output upper nybble
0010C0  2  AE 1B 11             LDX     TTX
0010C3  2  AC 1C 11             LDY     TTY
0010C6  2  AD 1D 11             LDA     TTA
0010C9  2  60                   RTS
0010CA  2               
0010CA  2               PRINT_SPACE:
0010CA  2  8E 1B 11             STX     TTX
0010CD  2  8C 1C 11             STY     TTY
0010D0  2  8D 1D 11             STA     TTA
0010D3  2  A9 20                LDA     #32
0010D5  2  20 1E 11             JSR     WRSER1          ; output upper nybble
0010D8  2  AE 1B 11             LDX     TTX
0010DB  2  AC 1C 11             LDY     TTY
0010DE  2  AD 1D 11             LDA     TTA
0010E1  2  60                   RTS
0010E2  2               
0010E2  2               
0010E2  2               PRINT_BYTE:
0010E2  2  8E 1B 11             STX     TTX
0010E5  2  8C 1C 11             STY     TTY
0010E8  2  8D 1D 11             STA     TTA
0010EB  2  8E 1A 11             STX     SAVX            ; save X
0010EE  2  20 05 11             JSR     ASCTWO          ; get hex chars for byte in X (lower) and A (upper)
0010F1  2  20 1E 11             JSR     WRSER1          ; output upper nybble
0010F4  2  8A                   TXA                     ; transfer lower to A
0010F5  2  AE 1A 11             LDX     SAVX            ; restore X
0010F8  2  20 1E 11             JSR     WRSER1          ; output lower nybble
0010FB  2  AE 1B 11             LDX     TTX
0010FE  2  AC 1C 11             LDY     TTY
001101  2  AD 1D 11             LDA     TTA
001104  2  60                   RTS
001105  2               ASCTWO:
001105  2  48                   PHA                     ; save byte
001106  2  20 0F 11             JSR     ASCII           ; do low nybble
001109  2  AA                   TAX                     ; save in X
00110A  2  68                   PLA                     ; restore byte
00110B  2  4A                   LSR     A               ; shift upper nybble down
00110C  2  4A                   LSR     A
00110D  2  4A                   LSR     A
00110E  2  4A                   LSR     A
00110F  2               ; convert low nybble in A to hex digit
00110F  2               ASCII:
00110F  2  29 0F                AND     #$0F            ; clear upper nibble
001111  2  C9 0A                CMP     #$0A            ; if less than A, skip next step
001113  2  90 02                BCC     ASC1
001115  2  69 06                ADC     #6              ; skip ascii chars between 9 and A
001117  2               ASC1:
001117  2  69 30                ADC     #$30            ; add ascii char 0 to value
001119  2  60                   RTS
00111A  2               SAVX:
00111A  2  00                   .BYTE   00
00111B  2               TTX:
00111B  2  00                   .BYTE   00
00111C  2               TTY:
00111C  2  00                   .BYTE   00
00111D  2               TTA:
00111D  2  00                   .BYTE   00
00111E  2               ;__WRSER1________________________________________________________________________________________________________________________
00111E  2               ;
00111E  2               ;	WRITE CHARACTER(A) TO UART
00111E  2               ;________________________________________________________________________________________________________________________________
00111E  2               ;
00111E  2               WRSER1:
00111E  2  48                   PHA
00111F  2               WRSER1a:
00111F  2  AD 85 EF             LDA     UART1STATUS     ; GET STATUS
001122  2  29 10                AND     #%00010000      ; IS TX READY
001124  2  F0 F9                BEQ     WRSER1a         ; NO, WAIT FOR IT
001126  2  68                   PLA
001127  2  8D 84 EF             STA     UART1DATA       ; WRITE DATA
00112A  2  60                   RTS
