0010D1  2               PRINT_CRLF:
0010D1  2  8E 3F 11             STX     TTX
0010D4  2  8C 40 11             STY     TTY
0010D7  2  8D 41 11             STA     TTA
0010DA  2  A9 0D                LDA     #13
0010DC  2  20 42 11             JSR     WRSER1          ; output upper nybble
0010DF  2  A9 0A                LDA     #10
0010E1  2  20 42 11             JSR     WRSER1          ; output upper nybble
0010E4  2  AE 3F 11             LDX     TTX
0010E7  2  AC 40 11             LDY     TTY
0010EA  2  AD 41 11             LDA     TTA
0010ED  2  60                   RTS
0010EE  2               
0010EE  2               PRINT_SPACE:
0010EE  2  8E 3F 11             STX     TTX
0010F1  2  8C 40 11             STY     TTY
0010F4  2  8D 41 11             STA     TTA
0010F7  2  A9 20                LDA     #32
0010F9  2  20 42 11             JSR     WRSER1          ; output upper nybble
0010FC  2  AE 3F 11             LDX     TTX
0010FF  2  AC 40 11             LDY     TTY
001102  2  AD 41 11             LDA     TTA
001105  2  60                   RTS
001106  2               
001106  2               
001106  2               PRINT_BYTE:
001106  2  8E 3F 11             STX     TTX
001109  2  8C 40 11             STY     TTY
00110C  2  8D 41 11             STA     TTA
00110F  2  8E 3E 11             STX     SAVX            ; save X
001112  2  20 29 11             JSR     ASCTWO          ; get hex chars for byte in X (lower) and A (upper)
001115  2  20 42 11             JSR     WRSER1          ; output upper nybble
001118  2  8A                   TXA                     ; transfer lower to A
001119  2  AE 3E 11             LDX     SAVX            ; restore X
00111C  2  20 42 11             JSR     WRSER1          ; output lower nybble
00111F  2  AE 3F 11             LDX     TTX
001122  2  AC 40 11             LDY     TTY
001125  2  AD 41 11             LDA     TTA
001128  2  60                   RTS
001129  2               ASCTWO:
001129  2  48                   PHA                     ; save byte
00112A  2  20 33 11             JSR     ASCII           ; do low nybble
00112D  2  AA                   TAX                     ; save in X
00112E  2  68                   PLA                     ; restore byte
00112F  2  4A                   LSR     A               ; shift upper nybble down
001130  2  4A                   LSR     A
001131  2  4A                   LSR     A
001132  2  4A                   LSR     A
001133  2               ; convert low nybble in A to hex digit
001133  2               ASCII:
001133  2  29 0F                AND     #$0F            ; clear upper nibble
001135  2  C9 0A                CMP     #$0A            ; if less than A, skip next step
001137  2  90 02                BCC     ASC1
001139  2  69 06                ADC     #6              ; skip ascii chars between 9 and A
00113B  2               ASC1:
00113B  2  69 30                ADC     #$30            ; add ascii char 0 to value
00113D  2  60                   RTS
00113E  2               SAVX:
00113E  2  00                   .BYTE   00
00113F  2               TTX:
00113F  2  00                   .BYTE   00
001140  2               TTY:
