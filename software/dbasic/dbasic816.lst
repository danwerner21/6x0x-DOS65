00123A  3  91 22                STA     (FCBPTR+2),Y    ; save to RAM
00123C  3  EE 18 13             INC     EndOfBas
00123F  3  D0 03                BNE     :+
001241  3  EE 19 13             INC     EndOfBas+1
001244  3               :
001244  3  C9 00                CMP     #$00
001246  3  D0 0D                BNE     :+
001248  3  EE 1A 13             INC     NullCounter
00124B  3  AD 1A 13             LDA     NullCounter
00124E  3  C9 03                CMP     #3
001250  3  D0 08                BNE     :++
001252  3  4C 86 12             JMP     DOS65LOAD_4
001255  3               :
001255  3  A9 00                LDA     #$00
001257  3  8D 1A 13             STA     NullCounter
00125A  3               :
00125A  3  C8                   INY                     ; bump index
00125B  3  C0 80                CPY     #$80            ; end of buffer?
00125D  3  D0 D9                BNE     DOS65LOAD_3     ; no, loop
00125F  3  18                   CLC                     ;
001260  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
001262  3  69 80                ADC     #$80            ;
001264  3  85 22                STA     FCBPTR+2        ;
001266  3  90 0B                BCC     DOS65LOAD_3C    ; is carry?, no SKIP
001268  3  18                   CLC                     ; yes, carry, inc high byte
001269  3  A5 23                LDA     FCBPTR+3        ;
00126B  3  69 01                ADC     #$01            ;
00126D  3  85 23                STA     FCBPTR+3        ;
00126F  3  C9 D0                CMP     #>Ram_top       ; are we at the end of RAM?
001271  3  F0 13                BEQ     DOS65LOAD_4
001273  3               
