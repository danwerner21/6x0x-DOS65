00115A  3               ;___SAVE____________________________________________________
00115A  3               ;
00115A  3               ; SAVE COMMAND
00115A  3               ;
00115A  3               ;  SAVE THE BASIC PROGRAM IN MEMORY TO DISK
00115A  3               ;
00115A  3               ;__________________________________________________________
00115A  3               V_SAVE: ; save BASIC program
00115A  3               DOS65SAVE:
00115A  3  20 CD 12             JSR     DOS65FCBPREP    ; parse parameters into FCB
00115D  3  B0 28                BCS     DOS65SAVE_ERR1  ; Error?, if so abort
00115F  3  A2 0D                LDX     #13             ;
001161  3  20 54 11             JSR     PEM             ;
001164  3  A9 90                LDA     #<FCB           ; CREATE File
001166  3  A0 17                LDY     #>FCB           ;
001168  3  A2 16                LDX     #22             ;
00116A  3  20 54 11             JSR     PEM             ;
00116D  3  A9 00                LDA     #0              ; clear
00116F  3  8D B0 17             STA     FCB+32          ; record number
001172  3  A9 90                LDA     #<FCB           ; Open File
001174  3  A0 17                LDY     #>FCB           ;
001176  3  A2 0F                LDX     #15             ;
001178  3  20 54 11             JSR     PEM             ;
00117B  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
00117D  3  D0 0B                BNE     DOS65SAVE_1     ;
00117F  3               DOS65SAVE_ERR:
00117F  3  A2 24                LDX     #$24            ; IO ERROR
001181  3  20 70 1A             JSR     LAB_XERR
001184  3  4C 4C 1B             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001187  3               DOS65SAVE_ERR1:
001187  3  4C 7E 20             JMP     LAB_REM         ; comment out the remainder of the line (if any)
00118A  3               DOS65SAVE_1:
00118A  3  A9 06                LDA     #<FCBBUFFER     ; SETUP BUFFER
00118C  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
00118E  3  A0 41                LDY     #>FCBBUFFER     ;
001190  3  84 21                STY     FCBPTR+1        ;
001192  3  A2 1A                LDX     #26             ; Setup Buffer
001194  3  20 54 11             JSR     PEM             ;
001197  3               DOS65SAVE_2:
001197  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
001199  3  85 22                STA     FCBPTR+2        ; point to base of RAM
00119B  3  A5 7A                LDA     <Smemh          ;
00119D  3  85 23                STA     FCBPTR+3        ;
00119F  3  A2 00                LDX     #$00            ; x=0 (null counter)
0011A1  3               DOS65SAVE_2A:
0011A1  3  A0 00                LDY     #$00            ; y=0 (Loop Index)
0011A3  3               DOS65SAVE_3:
0011A3  3  B1 22                LDA     (FCBPTR+2),Y    ; load from RAM
0011A5  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
0011A7  3  C9 00                CMP     #$00            ; is Zero?
0011A9  3  D0 1E                BNE     DOS65SAVE_3A    ; No, continue
0011AB  3  E8                   INX                     ; yes, bump Null Counter
0011AC  3  E0 03                CPX     #$03            ; Three nulls in a row?
0011AE  3  D0 1B                BNE     DOS65SAVE_3B    ; No, continue
0011B0  3                                               ; FINISH FILLING BUFFER WITH NULLS
0011B0  3               :
0011B0  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
0011B2  3  C8                   INY                     ; bump index
0011B3  3  C0 80                CPY     #$80            ; end of buffer?
0011B5  3  D0 F9                BNE     :-              ; no, loop
0011B7  3  A9 90                LDA     #<FCB           ; Write record in buffer to disk file AND END
0011B9  3  A0 17                LDY     #>FCB           ;
0011BB  3  A2 15                LDX     #21             ;
0011BD  3  20 54 11             JSR     PEM             ;
0011C0  3  29 FE                AND     #$FE            ; strip out extension
0011C2  3  C9 00                CMP     #$00            ; is error
0011C4  3  D0 B9                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
0011C6  3  4C F6 11             JMP     DOS65SAVE_4
0011C9  3               DOS65SAVE_3A:                   ;
0011C9  3  A2 00                LDX     #$00            ; prior char not null, reset null counter
0011CB  3               DOS65SAVE_3B:                   ;
0011CB  3  C8                   INY                     ; bump index
0011CC  3  C0 80                CPY     #$80            ; end of buffer?
0011CE  3  D0 D3                BNE     DOS65SAVE_3     ; no, loop
0011D0  3               DOS65SAVE_3C:
0011D0  3  A9 90                LDA     #<FCB           ; Write record in buffer to disk file
0011D2  3  A0 17                LDY     #>FCB           ;
0011D4  3  A2 15                LDX     #21             ;
0011D6  3  20 54 11             JSR     PEM             ;
0011D9  3  29 FE                AND     #$FE            ; strip out extension
0011DB  3  C9 00                CMP     #$00            ; is error
0011DD  3  D0 A0                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
0011DF  3  18                   CLC                     ;
0011E0  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
0011E2  3  69 80                ADC     #$80            ;
0011E4  3  85 22                STA     FCBPTR+2        ;
0011E6  3  90 B9                BCC     DOS65SAVE_2A    ; is carry?, no loop
0011E8  3  18                   CLC                     ; yes, carry, inc high byte
0011E9  3  A5 23                LDA     FCBPTR+3        ;
0011EB  3  69 01                ADC     #$01            ;
0011ED  3  85 23                STA     FCBPTR+3        ;
0011EF  3  C9 D0                CMP     #>Ram_top       ; are we at the end of RAM?
0011F1  3  F0 03                BEQ     DOS65SAVE_4
0011F3  3  4C A1 11             JMP     DOS65SAVE_2A
0011F6  3               DOS65SAVE_4:
0011F6  3  A9 90                LDA     #<FCB           ;
0011F8  3  A0 17                LDY     #>FCB           ;
0011FA  3  A2 10                LDX     #16             ;
0011FC  3  20 54 11             JSR     PEM             ;
0011FF  3  C9 FF                CMP     #$FF            ;
001201  3  D0 03                BNE     DOS65SAVE_5     ;
001203  3  4C 7F 11             JMP     DOS65SAVE_ERR   ; ERROR, DISPLAY IT
001206  3               DOS65SAVE_5:
001206  3  A9 7F                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
001208  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
00120A  3  20 0F 23             JSR     LAB_18C3
00120D  3  4C 4C 1B             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001210  3               
001210  3               ;___LOAD____________________________________________________
001210  3               ;
001210  3               ; LOAD COMMAND
001210  3               ;
001210  3               ;  LOAD A BASIC PROGRAM FROM DISK TO MEMORY
001210  3               ;
001210  3               ;__________________________________________________________
001210  3               V_LOAD: ; load BASIC program
001210  3               DOS65LOAD:
001210  3  A9 00                LDA     #$00
001212  3  8D 3C 13             STA     NullCounter
001215  3  20 CD 12             JSR     DOS65FCBPREP    ; parse parameters into FCB
001218  3  B0 1F                BCS     DOS65LOAD_ERR1  ; Error?, if so abort
00121A  3  A2 0D                LDX     #13             ;
00121C  3  20 54 11             JSR     PEM             ;
00121F  3  A9 00                LDA     #0              ; clear
001221  3  8D B0 17             STA     FCB+32          ; record number
001224  3  A9 90                LDA     #<FCB           ; Open File
001226  3  A0 17                LDY     #>FCB           ;
001228  3  A2 0F                LDX     #15             ;
00122A  3  20 54 11             JSR     PEM             ;
00122D  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
00122F  3  D0 0B                BNE     DOS65LOAD_1     ;
001231  3               DOS65LOAD_ERR:
001231  3  A2 24                LDX     #$24            ; IO ERROR
001233  3  20 70 1A             JSR     LAB_XERR
001236  3  4C 4C 1B             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
001239  3               DOS65LOAD_ERR1:
001239  3  4C 7E 20             JMP     LAB_REM         ; comment out the remainder of the line (if any)
00123C  3               DOS65LOAD_1:
00123C  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
00123E  3  85 22                STA     FCBPTR+2        ; point to base of RAM
001240  3  8D 3A 13             STA     EndOfBas        ;
001243  3  A5 7A                LDA     <Smemh          ;
001245  3  85 23                STA     FCBPTR+3        ;
001247  3  8D 3B 13             STA     EndOfBas+1      ;
00124A  3  A9 06                LDA     #<FCBBUFFER     ; SETUP BUFFER
00124C  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
00124E  3  A0 41                LDY     #>FCBBUFFER     ;
001250  3  84 21                STY     FCBPTR+1        ; STORE DEST BUFFER IN FCBPTR
001252  3  A2 1A                LDX     #26             ; Setup Buffer
001254  3  20 54 11             JSR     PEM             ;
001257  3  4C 95 12             JMP     DOS65LOAD_3C
00125A  3               DOS65LOAD_3:
00125A  3  B1 20                LDA     (FCBPTR),Y      ; load from BUFFER
00125C  3  91 22                STA     (FCBPTR+2),Y    ; save to RAM
00125E  3  EE 3A 13             INC     EndOfBas
001261  3  D0 03                BNE     :+
001263  3  EE 3B 13             INC     EndOfBas+1
001266  3               :
001266  3  C9 00                CMP     #$00
001268  3  D0 0D                BNE     :+
00126A  3  EE 3C 13             INC     NullCounter
00126D  3  AD 3C 13             LDA     NullCounter
001270  3  C9 03                CMP     #3
001272  3  D0 08                BNE     :++
001274  3  4C A8 12             JMP     DOS65LOAD_4
001277  3               :
001277  3  A9 00                LDA     #$00
001279  3  8D 3C 13             STA     NullCounter
00127C  3               :
00127C  3  C8                   INY                     ; bump index
00127D  3  C0 80                CPY     #$80            ; end of buffer?
00127F  3  D0 D9                BNE     DOS65LOAD_3     ; no, loop
001281  3  18                   CLC                     ;
001282  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
001284  3  69 80                ADC     #$80            ;
001286  3  85 22                STA     FCBPTR+2        ;
001288  3  90 0B                BCC     DOS65LOAD_3C    ; is carry?, no SKIP
00128A  3  18                   CLC                     ; yes, carry, inc high byte
00128B  3  A5 23                LDA     FCBPTR+3        ;
00128D  3  69 01                ADC     #$01            ;
00128F  3  85 23                STA     FCBPTR+3        ;
001291  3  C9 D0                CMP     #>Ram_top       ; are we at the end of RAM?
001293  3  F0 13                BEQ     DOS65LOAD_4
001295  3               
001295  3               DOS65LOAD_3C:
001295  3  A9 90                LDA     #<FCB           ; READ record buffer from disk file
001297  3  A0 17                LDY     #>FCB           ;
001299  3  A2 14                LDX     #20             ;
00129B  3  20 54 11             JSR     PEM             ;
00129E  3  A0 00                LDY     #$00            ; RESET INDEX
0012A0  3  C9 00                CMP     #$00            ; is error or EOF
0012A2  3  F0 B6                BEQ     DOS65LOAD_3     ;
0012A4  3  C9 01                CMP     #$01            ; EOF?
0012A6  3  D0 89                BNE     DOS65LOAD_ERR   ; ERROR, do error handling
0012A8  3               DOS65LOAD_4:
0012A8  3  A9 90                LDA     #<FCB           ;
0012AA  3  A0 17                LDY     #>FCB           ;
0012AC  3  A2 10                LDX     #16             ;
0012AE  3  20 54 11             JSR     PEM             ;
0012B1  3                                               ; setup pointers to return to basic
0012B1  3  AD 3A 13             LDA     EndOfBas
0012B4  3  85 7B                STA     Svarl
0012B6  3  85 7D                STA     Sarryl
0012B8  3  85 7F                STA     Earryl
0012BA  3  AD 3B 13             LDA     EndOfBas+1
0012BD  3  85 7C                STA     Svarh
0012BF  3  85 7E                STA     Sarryh
0012C1  3  85 80                STA     Earryh
0012C3  3  A9 7F                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
0012C5  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
0012C7  3  20 0F 23             JSR     LAB_18C3
0012CA  3  4C 4C 1B             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
0012CD  3               
0012CD  3               
0012CD  3               
0012CD  3               DOS65FCBPREP:
0012CD  3                       .IFDEF  DUODYNE
0012CD  3  22 C2 00 00          JSL     LAB_GBYT        ; scan memory
0012D1  3                       .ELSE
0012D1  3                       JSR     LAB_GBYT        ; scan memory
0012D1  3                       .ENDIF
0012D1  3               
0012D1  3  38                   SEC                     ;
0012D2  3  E9 40                SBC     #64             ; PARSE DRIVE NUMBER
0012D4  3  8D 90 17             STA     DOSDRIVE        ; STORE IT IN FCB
0012D7  3                       .IFDEF  DUODYNE
0012D7  3  22 BC 00 00          JSL     LAB_IGBY        ; increment and scan memory
0012DB  3                       .ELSE
0012DB  3                       JSR     LAB_IGBY        ; increment and scan memory
0012DB  3                       .ENDIF
0012DB  3               
0012DB  3  C9 3A                CMP     #':'            ;
0012DD  3  F0 08                BEQ     DOS65FCBPREP_1  ; YES, IT WAS A DRIVE, CONTINUE
0012DF  3  A2 26                LDX     #$26            ; IO ERROR
0012E1  3  20 70 1A             JSR     LAB_XERR
0012E4  3  4C 4C 1B             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
0012E7  3               
0012E7  3               DOS65FCBPREP_1:
0012E7  3  A9 90                LDA     #<FCB           ; SETUP FCBPTR
0012E9  3  85 20                STA     FCBPTR          ;
0012EB  3  A9 17                LDA     #>FCB           ;
0012ED  3  85 21                STA     FCBPTR+1        ;
0012EF  3  A0 01                LDY     #$01            ; POINT Y TO FCB FILE NAME
0012F1  3  A9 20                LDA     #$20            ; LOAD SPACE CHAR INTO A
0012F3  3               DOS65FCBPREP_1A:                ; BLANK OUT FCB
0012F3  3  8B DA 48 A2          STAINDIRECTY FCBPTR     ;
0012F7  3  01 B5 20 C9  
0012FB  3  00 D0 04 A2  
001309  3  C8                   INY                     ;
00130A  3  C0 09                CPY     #$09            ; IS DONE
00130C  3  D0 E5                BNE     DOS65FCBPREP_1A ; NO, LOOP
00130E  3  A0 01                LDY     #$01            ; POINT Y TO FCB FILE NAME
001310  3               DOS65FCBPREP_2:                 ; COPY FILE NAME PARAMETER INTO FCB
001310  3                       .IFDEF  DUODYNE
001310  3  22 BC 00 00          JSL     LAB_IGBY        ; increment and scan memory
001314  3                       .ELSE
001314  3                       JSR     LAB_IGBY        ; increment and scan memory
001314  3                       .ENDIF
001314  3  F0 22                BEQ     DOS65FCBPREP_3  ;
001316  3  C9 2E                CMP     #'.'
