00188B  3               BCD_TO_HEX:
00188B  3  85 12                STA     nums_2          ; Store in TEMP2
00188D  3  29 F0                AND     #$F0
00188F  3  4A                   LSR     A               ; (shift 1 times to /2)
001890  3  85 11                STA     nums_1          ; Store the /2 into TEMP
001892  3  4A                   LSR     A               ;
001893  3  4A                   LSR     A               ; Shift two more times to /8
001894  3  18                   CLC
001895  3  65 11                ADC     nums_1          ; add /8 + /2 to get /10
001897  3  85 11                STA     nums_1          ; Store tens digit into TEMP
001899  3  A5 12                LDA     nums_2          ; Get Ones
00189B  3  29 0F                AND     #$0F
00189D  3  18                   CLC
00189E  3  65 11                ADC     nums_1
0018A0  3  60                   RTS                     ; Return from subroutine
