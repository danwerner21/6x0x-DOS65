0012A9  3  22 C2 00 00          JSL     LAB_GBYT        ; scan memory
0012AD  3                       .ELSE
0012AD  3                       JSR     LAB_GBYT        ; scan memory
0012AD  3                       .ENDIF
0012AD  3               
0012AD  3  38                   SEC                     ;
0012AE  3  E9 40                SBC     #64             ; PARSE DRIVE NUMBER
0012B0  3  8D E9 15             STA     DOSDRIVE        ; STORE IT IN FCB
0012B3  3                       .IFDEF  DUODYNE
0012B3  3  22 BC 00 00          JSL     LAB_IGBY        ; increment and scan memory
0012B7  3                       .ELSE
0012B7  3                       JSR     LAB_IGBY        ; increment and scan memory
0012B7  3                       .ENDIF
0012B7  3               
0012B7  3  C9 3A                CMP     #':'            ;
0012B9  3  F0 08                BEQ     DOS65FCBPREP_1  ; YES, IT WAS A DRIVE, CONTINUE
0012BB  3  A2 26                LDX     #$26            ; IO ERROR
0012BD  3  20 C9 18             JSR     LAB_XERR
0012C0  3  4C A5 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
0012C3  3               
0012C3  3               DOS65FCBPREP_1:
0012C3  3  A9 E9                LDA     #<FCB           ; SETUP FCBPTR
0012C5  3  85 20                STA     FCBPTR          ;
0012C7  3  A9 15                LDA     #>FCB           ;
0012C9  3  85 21                STA     FCBPTR+1        ;
0012CB  3  A0 01                LDY     #$01            ; POINT Y TO FCB FILE NAME
0012CD  3  A9 20                LDA     #$20            ; LOAD SPACE CHAR INTO A
0012CF  3               DOS65FCBPREP_1A:                ; BLANK OUT FCB
0012CF  3  8B DA 48 A2          STAINDIRECTY FCBPTR     ;
0012D3  3  01 B5 20 C9  
0012D7  3  00 D0 04 A2  
0012E5  3  C8                   INY                     ;
