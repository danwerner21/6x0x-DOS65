001877  3               BCD_TO_HEX:
001877  3  85 12                STA     nums_2          ; Store in TEMP2
001879  3  29 F0                AND     #$F0
00187B  3  4A                   LSR     A               ; (shift 1 times to /2)
00187C  3  85 11                STA     nums_1          ; Store the /2 into TEMP
00187E  3  4A                   LSR     A               ;
00187F  3  4A                   LSR     A               ; Shift two more times to /8
001880  3  18                   CLC
001881  3  65 11                ADC     nums_1          ; add /8 + /2 to get /10
001883  3  85 11                STA     nums_1          ; Store tens digit into TEMP
001885  3  A5 12                LDA     nums_2          ; Get Ones
001887  3  29 0F                AND     #$0F
001889  3  18                   CLC
00188A  3  65 11                ADC     nums_1
00188C  3  60                   RTS                     ; Return from subroutine
