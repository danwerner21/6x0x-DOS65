0013C6  3               ;___OPEN____________________________________________________
0013C6  3               ;
0013C6  3               ; OPEN A FILE
0013C6  3               ;
0013C6  3               ;
0013C6  3               ; BASIC COMMAND EXPECTS FOUR VARS
0013C6  3               
0013C6  3               ; DRIVE,MODE, FILENAME$,FILE$
0013C6  3               ;
0013C6  3               ; FILE$ = STRING TO HOLD 33 BYTE FCB
0013C6  3               ; DRIVE = NUMERIC DRIVE -- 0=A, 1=B, 2= . . .
0013C6  3               ; MODE = 0=EXISTING, 1=CREATE
0013C6  3               ; FILENAME$ = FILENAME STRING
0013C6  3               ;__________________________________________________________
0013C6  3               V_OPEN:
0013C6  3                                               ; CLEAR FCB
0013C6  3  A9 00                LDA     #0              ; FILL WITH NULL
0013C8  3  A0 00                LDY     #0              ;
0013CA  3               :
0013CA  3  99 16 16             STA     FCB,Y           ;
0013CD  3  C8                   INY                     ;
0013CE  3  C0 21                CPY     #33             ;
0013D0  3  D0 F8                BNE     :-              ;
0013D2  3                                               ;
0013D2  3  A9 20                LDA     #32             ; FILL FILENAME AND EXTENSION WITH SPACES
0013D4  3  A0 01                LDY     #1              ;
0013D6  3               :
0013D6  3  99 16 16             STA     FCB,Y           ;
0013D9  3  C8                   INY                     ;
0013DA  3  C0 0C                CPY     #12             ;
0013DC  3  D0 F8                BNE     :-              ;
0013DE  3                                               ;
0013DE  3  20 E5 30             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (DRIVE)
0013E1  3  8A                   TXA
0013E2  3  8D 16 16             STA     FCB             ; STORE DRIVE IN FCB
0013E5  3                                               ;
0013E5  3  20 57 25             JSR     LAB_1C01        ; (AFTER ',') OR SYN ERR
0013E8  3  20 E5 30             JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X (MODE)
0013EB  3                                               ;
0013EB  3  E0 00                CPX     #0
0013ED  3  D0 08                BNE     :+
0013EF  3  A9 0F                LDA     #15
0013F1  3  8D A5 14             STA     OPNTMP
0013F4  3  4C FC 13             JMP     V_OPEN1
0013F7  3               :
0013F7  3  A9 16                LDA     #22
0013F9  3  8D A5 14             STA     OPNTMP          ;
0013FC  3               V_OPEN1:
0013FC  3  20 57 25             JSR     LAB_1C01        ; (AFTER ',') OR SYN ERR
0013FF  3  20 35 24             JSR     LAB_EVEX        ; GET THE THIRD PARAMETER
001402  3  A5 5F                LDA     <Dtypef         ; IS IT A STRING?
001404  3  D0 08                BNE     :+              ; YES, CONTINUE ON
001406  3  A2 02                LDX     #$02            ; NOPE, SYNTAX ERROR
001408  3  20 F6 18             JSR     LAB_XERR
00140B  3  4C D2 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
00140E  3               :
00140E  3  20 5C 2E             JSR     LAB_22B6        ; pop string off descriptor stack, or from top of string
001411  3                                               ; space returns with A = length, X=$71=pointer low byte,
001411  3                                               ; Y=$72=pointer high byte
001411  3  85 AC                STA     str_ln          ; set string length
001413  3  86 AD                STX     str_pl          ; set string pointer low byte
001415  3  84 AE                STY     str_ph          ; set string pointer high byte
001417  3                                               ; STORE IN FILENAME AND EXTENSION
001417  3  A2 00                LDX     #0
001419  3  A0 00                LDY     #0
00141B  3               :
00141B  3  B1 AD                LDA     (str_pl),Y
00141D  3  C9 2E                CMP     #'.'
00141F  3  F0 1E                BEQ     V_OPEN_EXTENSION
001421  3  C4 AC                CPY     str_ln
001423  3  F0 35                BEQ     V_OPEN_FNEND
001425  3  C8                   INY
001426  3  99 16 16             STA     FCB,Y
001429  3  C0 08                CPY     #8
00142B  3  D0 EE                BNE     :-
00142D  3               :
00142D  3  C8                   INY
00142E  3  B9 16 16             LDA     FCB,Y
001431  3  C9 2E                CMP     #'.'
001433  3  F0 0A                BEQ     V_OPEN_EXTENSION
001435  3  C4 AC                CPY     str_ln
001437  3  F0 21                BEQ     V_OPEN_FNEND
001439  3  4C 2D 14             JMP     :-
00143C  3  4C 5A 14             JMP     V_OPEN_FNEND
00143F  3               V_OPEN_EXTENSION:
00143F  3  A2 09                LDX     #9
001441  3               :
001441  3  C8                   INY
001442  3  B1 AD                LDA     (str_pl),Y
001444  3  C4 AC                CPY     str_ln
001446  3  F0 12                BEQ     V_OPEN_FNEND
