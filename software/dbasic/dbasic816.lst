00130C  3  D0 E5                BNE     DOS65FCBPREP_1A ; NO, LOOP
00130E  3  A0 01                LDY     #$01            ; POINT Y TO FCB FILE NAME
001310  3               DOS65FCBPREP_2:                 ; COPY FILE NAME PARAMETER INTO FCB
001310  3                       .IFDEF  DUODYNE
001310  3  22 BC 00 00          JSL     LAB_IGBY        ; increment and scan memory
001314  3                       .ELSE
001314  3                       JSR     LAB_IGBY        ; increment and scan memory
001314  3                       .ENDIF
