001154  3               ;___SAVE____________________________________________________
001154  3               ;
001154  3               ; SAVE COMMAND
001154  3               ;
001154  3               ;  SAVE THE BASIC PROGRAM IN MEMORY TO DISK
001154  3               ;
001154  3               ;__________________________________________________________
001154  3               V_SAVE: ; save BASIC program
001154  3               DOS65SAVE:
001154  3  20 C9 12             JSR     DOS65FCBPREP    ; parse parameters into FCB
001157  3  B0 29                BCS     DOS65SAVE_ERR1  ; Error?, if so abort
001159  3  A2 0D                LDX     #13             ;
00115B  3  20 4E 11             JSR     PEM             ;
00115E  3  A9 16                LDA     #<FCB           ; CREATE File
001160  3  A0 16                LDY     #>FCB           ;
001162  3  A2 16                LDX     #22             ;
001164  3  20 4E 11             JSR     PEM             ;
001167  3  A9 00                LDA     #0              ; clear
001169  3  8D 36 16             STA     FCB+32          ; record number
00116C  3  A9 16                LDA     #<FCB           ; Open File
00116E  3  A0 16                LDY     #>FCB           ;
001170  3  A2 0F                LDX     #15             ;
001172  3  20 4E 11             JSR     PEM             ;
001175  3  C9 FF                CMP     #$FF            ; error?, if NOT, continue
001177  3  D0 0C                BNE     DOS65SAVE_1     ;
001179  3               DOS65SAVE_ERR:
001179  3  A9 BF                LDA     #<FILEERROR2    ; NO, ERROR OUT
00117B  3  A0 0F                LDY     #>FILEERROR2
00117D  3  A2 09                LDX     #9              ; Print error message
00117F  3  20 4E 11             JSR     PEM             ;
001182  3               DOS65SAVE_ERR1:
001182  3  4C 0C 1F             JMP     LAB_REM         ; comment out the remainder of the line (if any)
001185  3               DOS65SAVE_1:
001185  3  A9 EA                LDA     #<FCBBUFFER     ; SETUP BUFFER
001187  3  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
001189  3  A0 3F                LDY     #>FCBBUFFER     ;
00118B  3  84 21                STY     FCBPTR+1        ;
00118D  3  A2 1A                LDX     #26             ; Setup Buffer
00118F  3  20 4E 11             JSR     PEM             ;
001192  3               DOS65SAVE_2:
001192  3  A5 79                LDA     <Smeml          ; All is well, file opened and continue
001194  3  85 22                STA     FCBPTR+2        ; point to base of RAM
001196  3  A5 7A                LDA     <Smemh          ;
001198  3  85 23                STA     FCBPTR+3        ;
00119A  3  A2 00                LDX     #$00            ; x=0 (null counter)
00119C  3               DOS65SAVE_2A:
00119C  3  A0 00                LDY     #$00            ; y=0 (Loop Index)
00119E  3               DOS65SAVE_3:
00119E  3  B1 22                LDA     (FCBPTR+2),Y    ; load from RAM
0011A0  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
0011A2  3  C9 00                CMP     #$00            ; is Zero?
0011A4  3  D0 1E                BNE     DOS65SAVE_3A    ; No, continue
0011A6  3  E8                   INX                     ; yes, bump Null Counter
0011A7  3  E0 03                CPX     #$03            ; Three nulls in a row?
0011A9  3  D0 1B                BNE     DOS65SAVE_3B    ; No, continue
0011AB  3                                               ; FINISH FILLING BUFFER WITH NULLS
0011AB  3               :
0011AB  3  91 20                STA     (FCBPTR),Y      ; save to Buffer
0011AD  3  C8                   INY                     ; bump index
0011AE  3  C0 80                CPY     #$80            ; end of buffer?
0011B0  3  D0 F9                BNE     :-              ; no, loop
0011B2  3  A9 16                LDA     #<FCB           ; Write record in buffer to disk file AND END
0011B4  3  A0 16                LDY     #>FCB           ;
0011B6  3  A2 15                LDX     #21             ;
0011B8  3  20 4E 11             JSR     PEM             ;
0011BB  3  29 FE                AND     #$FE            ; strip out extension
0011BD  3  C9 00                CMP     #$00            ; is error
0011BF  3  D0 B8                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
0011C1  3  4C F1 11             JMP     DOS65SAVE_4
0011C4  3               DOS65SAVE_3A:                   ;
0011C4  3  A2 00                LDX     #$00            ; prior char not null, reset null counter
0011C6  3               DOS65SAVE_3B:                   ;
0011C6  3  C8                   INY                     ; bump index
0011C7  3  C0 80                CPY     #$80            ; end of buffer?
0011C9  3  D0 D3                BNE     DOS65SAVE_3     ; no, loop
0011CB  3               DOS65SAVE_3C:
0011CB  3  A9 16                LDA     #<FCB           ; Write record in buffer to disk file
0011CD  3  A0 16                LDY     #>FCB           ;
0011CF  3  A2 15                LDX     #21             ;
0011D1  3  20 4E 11             JSR     PEM             ;
0011D4  3  29 FE                AND     #$FE            ; strip out extension
0011D6  3  C9 00                CMP     #$00            ; is error
0011D8  3  D0 9F                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
0011DA  3  18                   CLC                     ;
0011DB  3  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
0011DD  3  69 80                ADC     #$80            ;
0011DF  3  85 22                STA     FCBPTR+2        ;
0011E1  3  90 B9                BCC     DOS65SAVE_2A    ; is carry?, no loop
0011E3  3  18                   CLC                     ; yes, carry, inc high byte
0011E4  3  A5 23                LDA     FCBPTR+3        ;
0011E6  3  69 01                ADC     #$01            ;
0011E8  3  85 23                STA     FCBPTR+3        ;
0011EA  3  C9 D0                CMP     #>Ram_top       ; are we at the end of RAM?
0011EC  3  F0 03                BEQ     DOS65SAVE_4
0011EE  3  4C 9C 11             JMP     DOS65SAVE_2A
0011F1  3               DOS65SAVE_4:
0011F1  3  A9 16                LDA     #<FCB           ;
0011F3  3  A0 16                LDY     #>FCB           ;
0011F5  3  A2 10                LDX     #16             ;
0011F7  3  20 4E 11             JSR     PEM             ;
0011FA  3  C9 FF                CMP     #$FF            ;
0011FC  3  D0 03                BNE     DOS65SAVE_5     ;
0011FE  3  4C 79 11             JMP     DOS65SAVE_ERR   ; ERROR, DISPLAY IT
001201  3               DOS65SAVE_5:
001201  3  A9 66                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
001203  3  A0 0F                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
001205  3  20 AB 21             JSR     LAB_18C3
001208  3  4C D2 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
