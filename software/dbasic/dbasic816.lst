003EAA  1               
003EAA  1               LAB_MMSE:
003EAA  1  4C 5B 25             JMP     LAB_SNER        ; do syntax error then warm start
003EAD  1               
003EAD  1               ; check for next, evaluate and return or exit
003EAD  1               ; this is the routine that does most of the work
003EAD  1               
003EAD  1               LAB_PHFA:
003EAD  1                       .IFDEF  DUODYNE
003EAD  1  22 C2 00 00          JSL     LAB_GBYT        ; scan memory
003EB1  1                       .ELSE
003EB1  1                       JSR     LAB_GBYT        ; scan memory
