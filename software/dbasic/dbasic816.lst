00139B  3               ;___OPEN____________________________________________________
00139B  3               ;
00139B  3               ; OPEN A FILE
00139B  3               ;
00139B  3               ;
00139B  3               ; BASIC COMMAND EXPECTS FOUR VARS
00139B  3               
00139B  3               ; DRIVE,MODE, FILENAME$,FILE$
00139B  3               ;
00139B  3               ; FILE$ = STRING TO HOLD 33 BYTE FCB
00139B  3               ; DRIVE = NUMERIC DRIVE -- 0=A, 1=B, 2= . . .
00139B  3               ; MODE = 0=EXISTING, 1=CREATE
00139B  3               ; FILENAME$ = FILENAME STRING
00139B  3               ;__________________________________________________________
00139B  3               V_OPEN:
00139B  3               ; CLEAR FCB
00139B  3  A9 00                LDA     #0              ; FILL WITH NULL
00139D  3  A0 00                LDY     #0              ;
00139F  3               :
00139F  3  99 EB 15             STA     FCB,Y           ;
0013A2  3  C8                   INY                     ;
0013A3  3  C0 21                CPY     #33             ;
0013A5  3  D0 F8                BNE     :-              ;
0013A7  3                                               ;
0013A7  3  A9 20                LDA     #32             ; FILL FILENAME AND EXTENSION WITH SPACES
0013A9  3  A0 01                LDY     #1              ;
0013AB  3               :
0013AB  3  99 EB 15             STA     FCB,Y           ;
0013AE  3  C8                   INY                     ;
0013AF  3  C0 0C                CPY     #12             ;
0013B1  3  D0 F8                BNE     :-              ;
0013B3  3                                               ;
0013B3  3  20 A7 30             JSR     LAB_GTBY        ; GET THE FIRST PARAMETER, RETURN IN X (DRIVE)
0013B6  3  8A                   TXA
0013B7  3  8D EB 15             STA     FCB             ; STORE DRIVE IN FCB
0013BA  3                                               ;
0013BA  3  20 19 25             JSR     LAB_1C01        ; (AFTER ',') OR SYN ERR
0013BD  3  20 A7 30             JSR     LAB_GTBY        ; GET THE SECOND PARAMETER, RETURN IN X (MODE)
0013C0  3                                               ;
0013C0  3  E0 00                CPX     #0
0013C2  3  D0 08                BNE     :+
0013C4  3  A9 0F                LDA     #15
0013C6  3  8D 7A 14             STA     OPNTMP
0013C9  3  4C D1 13             JMP     V_OPEN1
0013CC  3               :
0013CC  3  A9 16                LDA     #22
0013CE  3  8D 7A 14             STA     OPNTMP          ;
0013D1  3               V_OPEN1:
0013D1  3  20 19 25             JSR     LAB_1C01        ; (AFTER ',') OR SYN ERR
0013D4  3  20 F7 23             JSR     LAB_EVEX        ; GET THE THIRD PARAMETER
0013D7  3  A5 5F                LDA     <Dtypef         ; IS IT A STRING?
0013D9  3  D0 08                BNE     :+              ; YES, CONTINUE ON
0013DB  3  A2 02                LDX     #$02            ; NOPE, SYNTAX ERROR
0013DD  3  20 CB 18             JSR     LAB_XERR
0013E0  3  4C A7 19             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
0013E3  3               :
0013E3  3  20 1E 2E             JSR     LAB_22B6        ; pop string off descriptor stack, or from top of string
0013E6  3                                               ; space returns with A = length, X=$71=pointer low byte,
0013E6  3                                               ; Y=$72=pointer high byte
0013E6  3  85 AC                STA     str_ln          ; set string length
0013E8  3  86 AD                STX     str_pl          ; set string pointer low byte
0013EA  3  84 AE                STY     str_ph          ; set string pointer high byte
0013EC  3                                               ; STORE IN FILENAME AND EXTENSION
0013EC  3  A2 00                LDX     #0
0013EE  3  A0 00                LDY     #0
0013F0  3               :
0013F0  3  B1 AD                LDA     (str_pl),Y
0013F2  3  C9 2E                CMP     #'.'
0013F4  3  F0 1E                BEQ     V_OPEN_EXTENSION
0013F6  3  C4 AC                CPY     str_ln
0013F8  3  F0 35                BEQ     V_OPEN_FNEND
