0031C0  1                       .IFDEF  DUODYNE
0031C0  1                       JSL     LAB_IGBY        ; increment and scan memory
0031C0  1                       .ELSE
0031C0  1  20 BC 00             JSR     LAB_IGBY        ; increment and scan memory
0031C3  1                       .ENDIF
0031C3  1               
0031C3  1  C9 3A                CMP     #':'            ;
0031C5  1  F0 0E                BEQ     DOS65FCBPREP_1  ; YES, IT WAS A DRIVE, CONTINUE
0031C7  1  A9 2B                LDA     #<FILEERROR1    ; NO, ERROR OUT
0031C9  1  A0 32                LDY     #>FILEERROR1
0031CB  1  A2 09                LDX     #9
0031CD  1  20 80 30             JSR     PEM
0031D0  1  20 1E 0F             JSR     LAB_REM
0031D3  1  38                   SEC
0031D4  1  60                   RTS
