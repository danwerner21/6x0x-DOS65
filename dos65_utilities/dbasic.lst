00309B  1  8D 9B 32             STA     FCB+32          ; record number
00309E  1  A9 7B                LDA     #<FCB           ; Open File
0030A0  1  A0 32                LDY     #>FCB           ;
0030A2  1  A2 0F                LDX     #15             ;
0030A4  1  20 80 30             JSR     PEM             ;
0030A7  1  C9 FF                CMP     #$FF            ; error?, if NOT, continue
0030A9  1  D0 0C                BNE     DOS65SAVE_1     ;
0030AB  1               DOS65SAVE_ERR:
0030AB  1  A9 56                LDA     #<FILEERROR2    ; NO, ERROR OUT
0030AD  1  A0 32                LDY     #>FILEERROR2
0030AF  1  A2 09                LDX     #9              ; Print error message
0030B1  1  20 80 30             JSR     PEM             ;
0030B4  1               DOS65SAVE_ERR1:
0030B4  1  4C 1E 0F             JMP     LAB_REM         ; comment out the remainder of the line (if any)
0030B7  1               DOS65SAVE_1:
0030B7  1  A9 9C                LDA     #<FCBBUFFER     ; SETUP BUFFER
0030B9  1  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
0030BB  1  A0 32                LDY     #>FCBBUFFER     ;
0030BD  1  84 21                STY     FCBPTR+1        ;
0030BF  1  A2 1A                LDX     #26             ; Setup Buffer
0030C1  1  20 80 30             JSR     PEM             ;
0030C4  1               DOS65SAVE_2:
0030C4  1  A5 79                LDA     <Smeml          ; All is well, file opened and continue
0030C6  1  85 22                STA     FCBPTR+2        ; point to base of RAM
0030C8  1  A5 7A                LDA     <Smemh          ;
0030CA  1  85 23                STA     FCBPTR+3        ;
0030CC  1  A2 00                LDX     #$00            ; x=0 (null counter)
0030CE  1               DOS65SAVE_2A:
0030CE  1  A0 00                LDY     #$00            ; y=0 (Loop Index)
0030D0  1               DOS65SAVE_3:
0030D0  1  B1 22                LDA     (FCBPTR+2),Y    ; load from RAM
0030D2  1  91 20                STA     (FCBPTR),Y      ; save to Buffer
0030D4  1  C9 00                CMP     #$00            ; is Zero?
0030D6  1  D0 17                BNE     DOS65SAVE_3A    ; No, continue
0030D8  1  E8                   INX                     ; yes, bump Null Counter
0030D9  1  E0 03                CPX     #$03            ; Three nulls in a row?
0030DB  1  D0 14                BNE     DOS65SAVE_3B    ; No, continue
0030DD  1  A9 7B                LDA     #<FCB           ; Write record in buffer to disk file AND END
0030DF  1  A0 32                LDY     #>FCB           ;
0030E1  1  A2 15                LDX     #21             ;
0030E3  1  20 80 30             JSR     PEM             ;
0030E6  1  29 FE                AND     #$FE            ; strip out extension
0030E8  1  C9 00                CMP     #$00            ; is error
0030EA  1  D0 BF                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
0030EC  1  4C 1C 31             JMP     DOS65SAVE_4
0030EF  1               DOS65SAVE_3A:                   ;
0030EF  1  A2 00                LDX     #$00            ; prior char not null, reset null counter
0030F1  1               DOS65SAVE_3B:                   ;
0030F1  1  C8                   INY                     ; bump index
0030F2  1  C0 80                CPY     #$80            ; end of buffer?
0030F4  1  D0 DA                BNE     DOS65SAVE_3     ; no, loop
0030F6  1               DOS65SAVE_3C:
0030F6  1  A9 7B                LDA     #<FCB           ; Write record in buffer to disk file
0030F8  1  A0 32                LDY     #>FCB           ;
0030FA  1  A2 15                LDX     #21             ;
0030FC  1  20 80 30             JSR     PEM             ;
0030FF  1  29 FE                AND     #$FE            ; strip out extension
003101  1  C9 00                CMP     #$00            ; is error
003103  1  D0 A6                BNE     DOS65SAVE_ERR   ; ERROR, do error handling
003105  1  18                   CLC                     ;
003106  1  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
003108  1  69 80                ADC     #$80            ;
00310A  1  85 22                STA     FCBPTR+2        ;
00310C  1  90 C0                BCC     DOS65SAVE_2A    ; is carry?, no loop
00310E  1  18                   CLC                     ; yes, carry, inc high byte
00310F  1  A5 23                LDA     FCBPTR+3        ;
003111  1  69 01                ADC     #$01            ;
003113  1  85 23                STA     FCBPTR+3        ;
003115  1  C9 B8                CMP     #>Ram_top       ; are we at the end of RAM?
003117  1  F0 03                BEQ     DOS65SAVE_4
003119  1  4C CE 30             JMP     DOS65SAVE_2A
00311C  1               DOS65SAVE_4:
00311C  1  A9 7B                LDA     #<FCB           ;
00311E  1  A0 32                LDY     #>FCB           ;
003120  1  A2 10                LDX     #16             ;
003122  1  20 80 30             JSR     PEM             ;
003125  1  C9 FF                CMP     #$FF            ;
003127  1  D0 03                BNE     DOS65SAVE_5     ;
003129  1  4C AB 30             JMP     DOS65SAVE_ERR   ; ERROR, DISPLAY IT
00312C  1               DOS65SAVE_5:
00312C  1  A9 02                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
00312E  1  A0 30                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
003130  1  20 D3 10             JSR     LAB_18C3
003133  1  4C 10 0A             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
