0028FF  1               
0028FF  1               ; page 0 initialisation table from $C2
0028FF  1               ; scan memory
0028FF  1                       .IFDEF  DUODYNE
0028FF  1               LAB_2CF4:
0028FF  1                       LDA     $FFFFFF         ; get byte to scan (addr set by call routine)
0028FF  1                       CMP     #TK_ELSE        ; compare with the token for ELSE
0028FF  1                       BEQ     LAB_2D05        ; exit if ELSE, not numeric, carry set
0028FF  1               
0028FF  1                       CMP     #':'            ; compare with ":"
0028FF  1                       BCS     LAB_2D05        ; exit if >= ":", not numeric, carry set
0028FF  1               
0028FF  1                       CMP     #' '            ; compare with " "
0028FF  1                       BEQ     LAB_2CEE        ; if " " go do next
0028FF  1               
0028FF  1                       SEC                     ; set carry for SBC
0028FF  1                       SBC     #'0'            ; subtract "0"
0028FF  1                       SEC                     ; set carry for SBC
0028FF  1                       SBC     #$D0            ; subtract -"0"
0028FF  1               ; clear carry if byte = "0"-"9"
0028FF  1               LAB_2D05:
0028FF  1                       RTL
0028FF  1                       .ELSE
0028FF  1               LAB_2CF4:
0028FF  1  AD FF FF             LDA     $FFFF           ; get byte to scan (addr set by call routine)
002902  1  C9 AD                CMP     #TK_ELSE        ; compare with the token for ELSE
002904  1  F0 0E                BEQ     LAB_2D05        ; exit if ELSE, not numeric, carry set
002906  1               
002906  1  C9 3A                CMP     #':'            ; compare with ":"
002908  1  B0 0A                BCS     LAB_2D05        ; exit if >= ":", not numeric, carry set
00290A  1               
00290A  1  C9 20                CMP     #' '            ; compare with " "
00290C  1  F0 EB                BEQ     LAB_2CEE        ; if " " go do next
00290E  1               
00290E  1  38                   SEC                     ; set carry for SBC
00290F  1  E9 30                SBC     #'0'            ; subtract "0"
002911  1  38                   SEC                     ; set carry for SBC
002912  1  E9 D0                SBC     #$D0            ; subtract -"0"
002914  1               ; clear carry if byte = "0"-"9"
002914  1               LAB_2D05:
002914  1  60                   RTS
002915  1                       .ENDIF
