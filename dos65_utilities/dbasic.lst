003139  1  B0 20                BCS     DOS65LOAD_ERR1  ; Error?, if so abort
00313B  1  A2 0D                LDX     #13             ;
00313D  1  20 80 30             JSR     PEM             ;
003140  1  A9 00                LDA     #0              ; clear
003142  1  8D 9B 32             STA     FCB+32          ; record number
003145  1  A9 7B                LDA     #<FCB           ; Open File
003147  1  A0 32                LDY     #>FCB           ;
003149  1  A2 0F                LDX     #15             ;
00314B  1  20 80 30             JSR     PEM             ;
00314E  1  C9 FF                CMP     #$FF            ; error?, if NOT, continue
003150  1  D0 0C                BNE     DOS65LOAD_1     ;
003152  1               DOS65LOAD_ERR:
003152  1  A9 56                LDA     #<FILEERROR2    ; NO, ERROR OUT
003154  1  A0 32                LDY     #>FILEERROR2
003156  1  A2 09                LDX     #9              ; Print error message
003158  1  20 80 30             JSR     PEM             ;
00315B  1               DOS65LOAD_ERR1:
00315B  1  4C 1E 0F             JMP     LAB_REM         ; comment out the remainder of the line (if any)
00315E  1               DOS65LOAD_1:
00315E  1  A5 79                LDA     <Smeml          ; All is well, file opened and continue
003160  1  85 22                STA     FCBPTR+2        ; point to base of RAM
003162  1  A5 7A                LDA     <Smemh          ;
003164  1  85 23                STA     FCBPTR+3        ;
003166  1  A9 9C                LDA     #<FCBBUFFER     ; SETUP BUFFER
003168  1  85 20                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
00316A  1  A0 32                LDY     #>FCBBUFFER     ;
00316C  1  84 21                STY     FCBPTR+1        ; STORE DEST BUFFER IN FCBPTR
00316E  1  A2 1A                LDX     #26             ; Setup Buffer
003170  1  20 80 30             JSR     PEM             ;
003173  1  4C 93 31             JMP     DOS65LOAD_3C
003176  1               DOS65LOAD_3:
003176  1  B1 20                LDA     (FCBPTR),Y      ; load from BUFFER
003178  1  91 22                STA     (FCBPTR+2),Y    ; save to RAM
00317A  1  C8                   INY                     ; bump index
00317B  1  C0 80                CPY     #$80            ; end of buffer?
00317D  1  D0 F7                BNE     DOS65LOAD_3     ; no, loop
00317F  1  18                   CLC                     ;
003180  1  A5 22                LDA     FCBPTR+2        ; add $80 to base counter
003182  1  69 80                ADC     #$80            ;
003184  1  85 22                STA     FCBPTR+2        ;
003186  1  90 0B                BCC     DOS65LOAD_3C    ; is carry?, no SKIP
003188  1  18                   CLC                     ; yes, carry, inc high byte
003189  1  A5 23                LDA     FCBPTR+3        ;
00318B  1  69 01                ADC     #$01            ;
00318D  1  85 23                STA     FCBPTR+3        ;
00318F  1  C9 B8                CMP     #>Ram_top       ; are we at the end of RAM?
003191  1  F0 11                BEQ     DOS65LOAD_4
003193  1               
003193  1               DOS65LOAD_3C:
