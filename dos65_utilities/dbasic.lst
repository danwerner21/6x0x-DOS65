00319E  1  F0 D6                BEQ     DOS65LOAD_3     ;
0031A0  1  C9 01                CMP     #$01            ; EOF?
0031A2  1  D0 AE                BNE     DOS65LOAD_ERR   ; ERROR, do error handling
0031A4  1               DOS65LOAD_4:
0031A4  1  A9 7B                LDA     #<FCB           ;
0031A6  1  A0 32                LDY     #>FCB           ;
0031A8  1  A2 10                LDX     #16             ;
0031AA  1  20 80 30             JSR     PEM             ;
0031AD  1  A9 02                LDA     #<LAB_RMSG      ; point to "Ready" message low byte
0031AF  1  A0 30                LDY     #>LAB_RMSG      ; point to "Ready" message high byte
0031B1  1  20 D3 10             JSR     LAB_18C3
0031B4  1  4C 10 0A             JMP     LAB_1319        ; RESET VARS, STACK AND RETURN CONTROL TO BASIC
