0031E6  1  D0 F9                BNE     DOS65FCBPREP_1A ; NO, LOOP
0031E8  1  A0 01                LDY     #$01            ; POINT Y TO FCB FILE NAME
0031EA  1               DOS65FCBPREP_2:                 ; COPY FILE NAME PARAMETER INTO FCB
0031EA  1                       .IFDEF  DUODYNE
0031EA  1                       JSL     LAB_IGBY        ; increment and scan memory
0031EA  1                       .ELSE
0031EA  1  20 BC 00             JSR     LAB_IGBY        ; increment and scan memory
0031ED  1                       .ENDIF
0031ED  1  F0 0E                BEQ     DOS65FCBPREP_3  ;
0031EF  1  C9 2E                CMP     #'.'
