0031D5  1  A9 7B                LDA     #<FCB           ; SETUP FCBPTR
0031D7  1  85 20                STA     FCBPTR          ;
0031D9  1  A9 32                LDA     #>FCB           ;
0031DB  1  85 21                STA     FCBPTR+1        ;
0031DD  1  A0 01                LDY     #$01            ; POINT Y TO FCB FILE NAME
0031DF  1  A9 20                LDA     #$20            ; LOAD SPACE CHAR INTO A
0031E1  1               DOS65FCBPREP_1A:                ; BLANK OUT FCB
0031E1  1  91 20                STAINDIRECTY FCBPTR     ;
0031E3  1  C8                   INY                     ;
