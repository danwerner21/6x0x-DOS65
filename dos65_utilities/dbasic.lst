0032B0  1               UART1DATA       = $EF84; SERIAL PORT 1 (I/O Card)
0032B0  1               UART1STATUS     = $EF85; SERIAL PORT 1 (I/O Card)
0032B0  1               UART1COMMAND    = $EF86; SERIAL PORT 1 (I/O Card)
0032B0  1               UART1CONTROL    = $EF87; SERIAL PORT 1 (I/O Card)
0032B0  1               
0032B0  1               PRINT_BYTE:
0032B0  1  8E E9 32             STX     TTX
0032B3  1  8C EA 32             STY     TTY
0032B6  1  8D EB 32             STA     TTA
0032B9  1  8E E8 32             STX     SAVX            ; save X
0032BC  1  20 D3 32             JSR     ASCTWO          ; get hex chars for byte in X (lower) and A (upper)
0032BF  1  20 EC 32             JSR     WRSER1          ; output upper nybble
0032C2  1  8A                   TXA                     ; transfer lower to A
0032C3  1  AE E8 32             LDX     SAVX            ; restore X
0032C6  1  20 EC 32             JSR     WRSER1           ; output lower nybble
0032C9  1  AE E9 32             LDX     TTX
0032CC  1  AC EA 32             LDY     TTY
0032CF  1  AD EB 32             LDA     TTA
0032D2  1  60                   RTS
0032D3  1               ASCTWO:
0032D3  1  48                   PHA                     ; save byte
0032D4  1  20 DD 32             JSR     ASCII           ; do low nybble
0032D7  1  AA                   TAX                     ; save in X
0032D8  1  68                   PLA                     ; restore byte
0032D9  1  4A                   LSR     A               ; shift upper nybble down
0032DA  1  4A                   LSR     A
0032DB  1  4A                   LSR     A
0032DC  1  4A                   LSR     A
0032DD  1               ; convert low nybble in A to hex digit
0032DD  1               ASCII:
0032DD  1  29 0F                AND     #$0F            ; clear upper nibble
0032DF  1  C9 0A                CMP     #$0A            ; if less than A, skip next step
0032E1  1  90 02                BCC     ASC1
0032E3  1  69 06                ADC     #6              ; skip ascii chars between 9 and A
0032E5  1               ASC1:
0032E5  1  69 30                ADC     #$30            ; add ascii char 0 to value
0032E7  1  60                   RTS
