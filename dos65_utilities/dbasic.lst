0028F9  1               ; character get subroutine for zero page
0028F9  1               
0028F9  1               ; For a 1.8432MHz 6502 including the JSR and RTS
0028F9  1               ; fastest (>=":")	=  29 cycles =  15.7uS
0028F9  1               ; slowest (<":")	=  40 cycles =  21.7uS
0028F9  1               ; space skip	= +21 cycles = +11.4uS
0028F9  1               ; inc across page	=  +4 cycles =  +2.2uS
0028F9  1               
0028F9  1               ; the target address for the LDA at LAB_2CF4 becomes the BASIC execute pointer once the
0028F9  1               ; block is copied to it's destination, any non zero page address will do at assembly
0028F9  1               ; time, to assemble a three byte instruction.
0028F9  1               
0028F9  1               ; page 0 initialisation table from $BC
0028F9  1               ; increment and scan memory
