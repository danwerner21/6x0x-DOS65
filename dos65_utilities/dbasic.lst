0031F3  1  91 20                STAINDIRECTY FCBPTR     ;
0031F5  1  C8                   INY                     ;
0031F6  1  C0 09                CPY     #$09            ;
0031F8  1  F0 03                BEQ     DOS65FCBPREP_3  ;
0031FA  1  4C EA 31             JMP     DOS65FCBPREP_2  ;
