000000r 1               TK_LOAD         = TK_WAIT+1     ; LOAD token
000000r 1               TK_SAVE         = TK_LOAD+1     ; SAVE token
000000r 1               TK_DEF          = TK_SAVE+1     ; DEF token
000000r 1               TK_POKE         = TK_DEF+1      ; POKE token
