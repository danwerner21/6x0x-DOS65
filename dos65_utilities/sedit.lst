000C69  1               ;__CRSRLEFT______________________________________________________________________________________________________________________
000C69  1               ;
000C69  1               ; 	MOVE THE CURSOR LEFT ONE POSITION, DEC THE BUFFER POINTER AND SCROLL UP IF NECESSARY
000C69  1               ;
000C69  1               ;________________________________________________________________________________________________________________________________
000C69  1               ;
000C69  1               CRSRLEFT:
000C69  1  A5 0D                LDA     EDTPOS          ;
000C6B  1  D0 07                BNE     CRSRLEFT1       ; CHECK TO SEE IF POINTER IS AT THE VERY TOP OF THE
000C6D  1  A5 0E                LDA     EDTPOS+1        ; BUFFER.  IF IT IS, DO NOTHING.
000C6F  1  C9 18                CMP     #>BUFFER        ;
000C71  1  D0 01                BNE     CRSRLEFT1       ;
000C73  1  60                   RTS                     ;
000C74  1               CRSRLEFT1:
000C74  1  C6 0B                DEC     CSRPOSX         ; DEC THE CURSOR POSITION
000C76  1  A5 0B                LDA     CSRPOSX         ; CHECK TO SEE IF WE WERE AT THE LEFT MOST POSITION
000C78  1  C9 FF                CMP     #$FF            ;
000C7A  1  F0 06                BEQ     CRSRLEFT2       ; IF WE WERE, DO SOME SPECIAL STUFF
000C7C  1  20 EC 0D             JSR     DECEDTPOS       ; MOVE EDTPOS 1 TO THE LEFT
000C7F  1  4C A9 0D             JMP     CHKPOS          ; POSITION THE CURSOR
000C82  1               CRSRLEFT2:                      ; CURSOR IS AT THE LEFT MOST LINE
000C82  1  A9 4F                LDA     #MAXCOL-1       ;
000C84  1  85 0B                STA     CSRPOSX         ;
000C86  1  AA                   TAX                     ;
000C87  1               CRSRLEFT2A:
000C87  1  20 E5 0D             JSR     INCEDTPOS       ;
000C8A  1  CA                   DEX                     ;
000C8B  1  D0 FA                BNE     CRSRLEFT2A      ;
000C8D  1  4C 1D 0C             JMP     CRSRUP          ; MOVE UP ONE LINE
000C90  1               
000C90  1               
000C90  1               ;__CRSRRIGHT_____________________________________________________________________________________________________________________
000C90  1               ;
000C90  1               ; 	MOVE THE CURSOR RIGHT ONE POSITION, INC THE BUFFER POINTER AND SCROLL IF NECESSARY
000C90  1               ;
000C90  1               ;________________________________________________________________________________________________________________________________
000C90  1               ;
000C90  1               CRSRRIGHT:
000C90  1  A5 0C                LDA     CSRPOSY         ; IS CURSOR ON LAST POSITION OF SCREEN?
000C92  1  C9 13                CMP     #LASTROW-1      ; IF NOT, BRANCH TO CSRRIGHT1, OTHERWISE
000C94  1  D0 09                BNE     CRSRRIGHT1      ; SCROLL SCREEN
000C96  1  A5 0B                LDA     CSRPOSX         ;
000C98  1  C9 4F                CMP     #MAXCOL-1       ;
000C9A  1  D0 03                BNE     CRSRRIGHT1      ;
000C9C  1               ;
000C9C  1  20 46 0D             JSR     SCROLLDOWN      ;
000C9F  1               ;
000C9F  1               CRSRRIGHT1:                     ;
000C9F  1  20 15 10             JSR     GOCSR           ; POSITION CURSOR
000CA2  1  A0 00                LDY     #$00            ;
000CA4  1  B1 0D                LDA     (EDTPOS),Y      ; GET CHAR FROM EDIT BUFFER
000CA6  1  20 6A 10             JSR     TOCONSOLE       ; PLACE CHAR ON SCREEN
000CA9  1               ;
000CA9  1  20 E5 0D             JSR     INCEDTPOS       ; MOVE EDTPOS 1 TO THE RIGHT
000CAC  1               ;
000CAC  1  A5 0E                LDA     EDTPOS+1        ;
000CAE  1  C9 B8                CMP     #>Ram_top       ; are we at the end of RAM?
000CB0  1  D0 11                BNE     CRSRRIGHT2      ; NO, EXIT
000CB2  1  20 EC 0D             JSR     DECEDTPOS       ; OTHERWISE BACK POINTER OFF ONE
