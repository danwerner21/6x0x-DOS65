0008B5  1  20 69 0C             JSR     CRSRLEFT        ; MOVE CSR BACK 1
0008B8  1  20 DE 08             JSR     EDITCHECK       ;
0008BB  1  4C 1C 08             JMP     EDITLOOP        ;
