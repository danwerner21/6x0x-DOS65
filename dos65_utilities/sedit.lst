00106A  1               ;__TOCONSOLE_____________________________________________________________________________________________________________________
00106A  1               ;
00106A  1               ; 	TRANSLATE BUFFER TO CONSOLE
00106A  1               ;	A: CHAR TO OUTPUT
00106A  1               ;
00106A  1               ;
00106A  1               ;________________________________________________________________________________________________________________________________
00106A  1               ;
00106A  1               TOCONSOLE:
00106A  1  85 08                STA     TEMP
00106C  1  8A                   TXA
00106D  1  48                   PHA
00106E  1  98                   TYA
00106F  1  48                   PHA
001070  1  A5 08                LDA     TEMP
001072  1  C9 0D                CMP     #$0D            ;  IS CHAR A <CR>?
001074  1  D0 0C                BNE     TOCONSOLE1      ;  NO, CONTINUE
001076  1  A9 A3                LDA     #<PRINTCR
001078  1  A0 10                LDY     #>PRINTCR
00107A  1  A2 09                LDX     #9              ;
00107C  1  20 03 01             JSR     PEM             ;
00107F  1  4C 8D 10             JMP     TOCONSOLE1B     ;
001082  1               TOCONSOLE1:
001082  1  C9 00                CMP     #$00            ; IS NULL?
001084  1  D0 02                BNE     TOCONSOLE1A     ;  NO, CONTINUE
001086  1  A9 20                LDA     #32             ; CHANGE NULL TO SPACE
001088  1               TOCONSOLE1A:
001088  1  A2 02                LDX     #2              ;  OUTPUT THE CHAR TO THE CONSOLE
00108A  1  20 03 01             JSR     PEM             ;
00108D  1               TOCONSOLE1B:
00108D  1  E6 0B                INC     CSRPOSX         ;  MOVE THE CURSOR
00108F  1  A5 0B                LDA     CSRPOSX         ;  ARE WE AT THE END OF THE LINE?
001091  1  C9 50                CMP     #MAXCOL         ;
001093  1  D0 09                BNE     TOCONSOLE2      ;  NO, EXIT
001095  1               
001095  1  A9 00                LDA     #$00            ; MOVE CRSR TO START OF LINE
001097  1  85 0B                STA     CSRPOSX         ;
001099  1  E6 0C                INC     CSRPOSY         ; ADVANCE TO NEXT ROW
00109B  1  20 15 10             JSR     GOCSR           ; MOVE CRSR
