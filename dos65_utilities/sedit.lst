0015B7  1               DOS65FCBPREP:
0015B7  1  AD 51 14             LDA     FNBUFFER+1      ; GET ":"
0015BA  1  C9 3A                CMP     #':'            ;
0015BC  1  F0 0C                BEQ     DOS65FCBPREP_1  ; YES, IT WAS A DRIVE, CONTINUE
0015BE  1  A9 0B                LDA     #<FILEERROR1    ; NO, ERROR OUT
0015C0  1  A0 16                LDY     #>FILEERROR1
0015C2  1  A2 09                LDX     #9
0015C4  1  20 03 01             JSR     PEM
0015C7  1  A9 FF                LDA     #$FF
0015C9  1  60                   RTS
0015CA  1               DOS65FCBPREP_1:
0015CA  1  AD 50 14             LDA     FNBUFFER        ; GET DRIVE LETTER
0015CD  1  38                   SEC                     ;
0015CE  1  E9 40                SBC     #64             ; PARSE DRIVE NUMBER
0015D0  1  8D 07 01             STA     DFLFCB+0        ; STORE IT IN FCB
0015D3  1               
0015D3  1  A0 01                LDY     #$01            ; POINT Y TO FCB FILE NAME
0015D5  1  A9 20                LDA     #$20            ; LOAD SPACE CHAR INTO A
0015D7  1               DOS65FCBPREP_1A:                ; BLANK OUT FCB
0015D7  1  99 07 01             STA     DFLFCB,Y        ;
0015DA  1  C8                   INY                     ;
0015DB  1  C0 09                CPY     #$09            ; IS DONE
0015DD  1  D0 F8                BNE     DOS65FCBPREP_1A ; NO, LOOP
0015DF  1  A0 01                LDY     #$01            ; POINT Y TO FCB FILE NAME
0015E1  1  A2 00                LDX     #$00            ;
0015E3  1               DOS65FCBPREP_2:                 ; COPY FILE NAME PARAMETER INTO FCB
0015E3  1  BD 52 14             LDA     FNBUFFER+2,X    ;
0015E6  1  E8                   INX                     ;
0015E7  1  C9 2E                CMP     #'.'            ;
0015E9  1  F0 0B                BEQ     DOS65FCBPREP_3  ;
0015EB  1  99 07 01             STA     DFLFCB,Y        ;
0015EE  1  C8                   INY                     ;
0015EF  1  C0 09                CPY     #$09            ;
0015F1  1  F0 03                BEQ     DOS65FCBPREP_3  ;
0015F3  1  4C E3 15             JMP     DOS65FCBPREP_2  ;
0015F6  1               DOS65FCBPREP_3:                 ;
0015F6  1  BD 52 14             LDA     FNBUFFER+2,X    ;
0015F9  1  8D 10 01             STA     DFLFCB+9        ;
0015FC  1  BD 53 14             LDA     FNBUFFER+3,X    ;
0015FF  1  8D 11 01             STA     DFLFCB+10       ;
001602  1  BD 54 14             LDA     FNBUFFER+4,X    ;
001605  1  8D 12 01             STA     DFLFCB+11       ;
