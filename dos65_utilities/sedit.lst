0014E6  1               ;__DOS65SAVE_____________________________________________________________________________________________________________________
0014E6  1               ;
0014E6  1               ; 	SAVE A DOS/65 FILE FROM THE EDIT BUFFER
0014E6  1               ;
0014E6  1               ;
0014E6  1               ;
0014E6  1               ;________________________________________________________________________________________________________________________________
0014E6  1               ;
0014E6  1               DOS65SAVE:
0014E6  1  A9 00                LDA     #0              ; clear
0014E8  1  8D 27 01             STA     DFLFCB+32       ; record number
0014EB  1  A9 07                LDA     #<DFLFCB        ; Open File
0014ED  1  A0 01                LDY     #>DFLFCB        ;
0014EF  1  A2 13                LDX     #19             ;
0014F1  1  20 03 01             JSR     PEM             ;
0014F4  1               
0014F4  1  A9 00                LDA     #0              ; clear
0014F6  1  8D 27 01             STA     DFLFCB+32       ; record number
0014F9  1  A9 07                LDA     #<DFLFCB        ; ATTEMPT TO CREATE File
0014FB  1  A0 01                LDY     #>DFLFCB        ;
0014FD  1  A2 16                LDX     #22             ;
0014FF  1  20 03 01             JSR     PEM             ;
001502  1  C9 FF                CMP     #$FF            ; error?, if NOT, continue
001504  1  D0 0A                BNE     DOS65SAVE_1     ;
001506  1               
001506  1               DOS65SAVE_ERR:
001506  1  A9 32                LDA     #<FILEERROR2A   ; NO, ERROR OUT
001508  1  A0 16                LDY     #>FILEERROR2A
00150A  1  A2 09                LDX     #9              ; Print error message
00150C  1  20 03 01             JSR     PEM             ;
00150F  1  60                   RTS                     ; RETURN
001510  1               DOS65SAVE_1:
001510  1  A9 00                LDA     #0              ; clear
001512  1  8D 27 01             STA     DFLFCB+32       ; record number
001515  1  A9 00                LDA     #<BUFFER        ; SETUP BUFFER
001517  1  85 09                STA     FCBPTR          ; STORE SRC BUFFER IN FCBPTR
001519  1  A9 18                LDA     #>BUFFER        ;
00151B  1  85 0A                STA     FCBPTR+1        ; STORE SRC BUFFER IN FCBPTR
00151D  1               
00151D  1  A9 F2                LDA     #<FCBBUFFER     ; SETUP BUFFER
00151F  1  85 0F                STA     TMPPOS          ;
001521  1  A0 16                LDY     #>FCBBUFFER
001523  1  84 10                STY     TMPPOS+1        ;
001525  1  A2 1A                LDX     #26             ; Setup Buffer
001527  1  20 03 01             JSR     PEM
00152A  1               
00152A  1  A2 00                LDX     #$00            ;
00152C  1  86 11                STX     TEMP1           ;
00152E  1               DOS65SAVE_2:
00152E  1  A5 13                LDA     CURRENTLEN+1    ; AT END PAGE?
001530  1  C5 0A                CMP     FCBPTR+1        ;
001532  1  D0 0D                BNE     DOS65SAVE_2B    ;
001534  1  A5 09                LDA     FCBPTR          ;
001536  1  C5 12                CMP     CURRENTLEN      ;
001538  1  90 07                BCC     DOS65SAVE_2B    ; IF WE ARE NOT PAST THE END, PROCEED AS USUAL
00153A  1  F0 05                BEQ     DOS65SAVE_2B    ;
00153C  1  A9 1A                LDA     #$1A            ; WE ARE AT END SO PAD WITH EOF
00153E  1  4C 53 15             JMP     DOS65SAVE_2C    ;
001541  1               
001541  1               DOS65SAVE_2B:
001541  1  A0 00                LDY     #$00
001543  1  B1 09                LDA     (FCBPTR),Y      ; GET NEXT BUFFER BYTE
001545  1  E6 09                INC     FCBPTR          ; INC 16 BIT BUFFER POINTER
001547  1  D0 02                BNE     *+4             ;
001549  1  E6 0A                INC     FCBPTR+1        ;
00154B  1  C9 00                CMP     #$00            ; IS NULL?
00154D  1  F0 DF                BEQ     DOS65SAVE_2     ; YES SKIP
00154F  1  C9 0A                CMP     #10             ; IS LF?
001551  1  F0 DB                BEQ     DOS65SAVE_2     ; YES SKIP
001553  1               
001553  1               DOS65SAVE_2C:
001553  1  A4 11                LDY     TEMP1           ;
001555  1  91 0F                STA     (TMPPOS),Y      ; NO STORE IN BUFFER
001557  1  E6 11                INC     TEMP1           ; INC BUFFER POINTER
001559  1  C9 0D                CMP     #13             ; IF NOT CR
00155B  1  D0 03                BNE     *+5             ; CONTINUE
00155D  1  20 90 15             JSR     DOS65SAVE_LF    ; OTHERWISE INSERT LF
001560  1               
001560  1  A6 11                LDX     TEMP1           ;
001562  1  E0 80                CPX     #$80            ; PAST END?
001564  1  D0 C8                BNE     DOS65SAVE_2     ; NO LOOP TILL BUFFER IS FULL
001566  1               
001566  1               DOS65SAVE_2D:
001566  1  A9 07                LDA     #<DFLFCB        ; WRITE record buffer from disk file
001568  1  A0 01                LDY     #>DFLFCB        ;
00156A  1  A2 15                LDX     #21             ;
00156C  1  20 03 01             JSR     PEM             ;
00156F  1  C9 00                CMP     #$00            ; is SUCCESSFUL?
001571  1  F0 03                BEQ     *+5             ;
001573  1  4C 06 15             JMP     DOS65SAVE_ERR   ; ERROR, do error handling
001576  1               
001576  1               
001576  1  A5 0A                LDA     FCBPTR+1        ;
001578  1  C5 13                CMP     CURRENTLEN+1    ; AT END?
00157A  1  90 03                BCC     DOS65SAVE_3     ;
00157C  1  4C 86 15             JMP     DOS65SAVE_4     ; CLOSE FILE
00157F  1               
00157F  1               DOS65SAVE_3:
00157F  1  A2 00                LDX     #$00            ;
001581  1  86 11                STX     TEMP1           ;
001583  1  4C 2E 15             JMP     DOS65SAVE_2     ; SAVE NEXT SECTOR
001586  1               
001586  1               DOS65SAVE_4:
001586  1  A9 07                LDA     #<DFLFCB        ; CLOSE FILE
001588  1  A0 01                LDY     #>DFLFCB        ;
00158A  1  A2 10                LDX     #16             ;
00158C  1  20 03 01             JSR     PEM             ;
00158F  1  60                   RTS
001590  1               
001590  1               
001590  1               DOS65SAVE_LF:
001590  1               
001590  1  A6 11                LDX     TEMP1           ;
001592  1  E0 80                CPX     #$80            ; PAST END?
001594  1  D0 03                BNE     *+5             ; NO
001596  1  20 A2 15             JSR     DOS65SAVE_LF1   ;
001599  1               
001599  1  A4 11                LDY     TEMP1           ; WRITE LF
00159B  1  A9 0A                LDA     #10             ;
00159D  1  91 0F                STA     (TMPPOS),Y      ; NO STORE IN BUFFER
00159F  1  E6 11                INC     TEMP1           ; INC BUFFER POINTER
0015A1  1  60                   RTS
0015A2  1               
0015A2  1               DOS65SAVE_LF1:
0015A2  1  A9 07                LDA     #<DFLFCB        ; WRITE record buffer from disk file
0015A4  1  A0 01                LDY     #>DFLFCB        ;
0015A6  1  A2 15                LDX     #21             ;
0015A8  1  20 03 01             JSR     PEM             ;
0015AB  1  C9 00                CMP     #$00            ; is SUCCESSFUL?
0015AD  1  F0 03                BEQ     *+5             ;
0015AF  1  4C 06 15             JMP     DOS65SAVE_ERR   ; ERROR, do error handling
0015B2  1  A2 00                LDX     #$00            ;
0015B4  1  86 11                STX     TEMP1           ;
0015B6  1  60                   RTS
