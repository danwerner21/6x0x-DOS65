0011BE  1               ;__CLEARBUFFER___________________________________________________________________________________________________________________
0011BE  1               ;
0011BE  1               ; 	CLEAR THE EDIT BUFFER
0011BE  1               ;
0011BE  1               ;
0011BE  1               ;
0011BE  1               ;________________________________________________________________________________________________________________________________
0011BE  1               ;
0011BE  1               CLEARBUFFER:
0011BE  1  A9 00                LDA     #<BUFFER        ; SETUP BUFFER
0011C0  1  85 0D                STA     EDTPOS          ;
0011C2  1  A9 18                LDA     #>BUFFER        ;
0011C4  1  85 0E                STA     EDTPOS+1        ;
0011C6  1  A0 00                LDY     #$00            ;
0011C8  1               
0011C8  1               CLEARBUFFER1:
0011C8  1  A9 00                LDA     #00
0011CA  1  91 0D                STA     (EDTPOS),Y
0011CC  1  C8                   INY
0011CD  1  D0 F9                BNE     CLEARBUFFER1
0011CF  1  E6 0E                INC     EDTPOS+1
0011D1  1  A5 0E                LDA     EDTPOS+1
0011D3  1  C9 B8                CMP     #>Ram_top       ; are we at the end of RAM?
0011D5  1  D0 F1                BNE     CLEARBUFFER1
0011D7  1               
0011D7  1  60                   RTS
0011D8  1               
0011D8  1               
0011D8  1               ;__DOS65LOAD_____________________________________________________________________________________________________________________
0011D8  1               ;
0011D8  1               ; 	LOAD A DOS/65 FILE INTO THE EDIT BUFFER
0011D8  1               ;		FILE IS LOADED INTO 80 COLUMN LINES TO SIMPLIFY SCROLLING
0011D8  1               ;
0011D8  1               ;
0011D8  1               ;________________________________________________________________________________________________________________________________
0011D8  1               ;
0011D8  1               DOS65LOAD:
0011D8  1  A9 00                LDA     #0              ; clear
0011DA  1  8D 27 01             STA     DFLFCB+32       ; record number
0011DD  1  A9 07                LDA     #<DFLFCB        ; Open File
0011DF  1  A0 01                LDY     #>DFLFCB        ;
0011E1  1  A2 0F                LDX     #15             ;
0011E3  1  20 03 01             JSR     PEM             ;
0011E6  1  C9 FF                CMP     #$FF            ; error?, if NOT, continue
0011E8  1  D0 22                BNE     DOS65LOAD_1     ;
0011EA  1               
0011EA  1  A9 00                LDA     #<BUFFER        ; SETUP BUFFER
0011EC  1  85 09                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
0011EE  1  A9 18                LDA     #>BUFFER        ;
0011F0  1  85 0A                STA     FCBPTR+1        ; STORE DEST BUFFER IN FCBPTR
0011F2  1  A5 09                LDA     FCBPTR          ;
0011F4  1  85 12                STA     CURRENTLEN      ;
0011F6  1  A5 0A                LDA     FCBPTR+1        ;
0011F8  1  85 13                STA     CURRENTLEN+1    ;
0011FA  1  A9 0D                LDA     #13
0011FC  1  20 90 12             JSR     DOS65LOAD_STOREBT
0011FF  1  60                   RTS                     ; OPEN EDITOR, BLANK FILE
001200  1               
001200  1               DOS65LOAD_ERR:
001200  1  A9 3E                LDA     #<FILEERROR2    ; NO, ERROR OUT
001202  1  A0 16                LDY     #>FILEERROR2
001204  1  A2 09                LDX     #9              ; Print error message
001206  1  20 03 01             JSR     PEM             ;
001209  1  4C 00 01             JMP     BOOT            ; WARM BOOT DOS/65
00120C  1               DOS65LOAD_1:
00120C  1  A9 00                LDA     #0              ; clear
00120E  1  8D 27 01             STA     DFLFCB+32       ; record number
001211  1  85 12                STA     CURRENTLEN      ; LENGTH COUNTER
001213  1  A9 00                LDA     #<BUFFER        ; SETUP BUFFER
001215  1  85 09                STA     FCBPTR          ; STORE DEST BUFFER IN FCBPTR
001217  1  A9 18                LDA     #>BUFFER        ;
001219  1  85 0A                STA     FCBPTR+1        ; STORE DEST BUFFER IN FCBPTR
00121B  1               
00121B  1  A9 F2                LDA     #<FCBBUFFER     ; SETUP BUFFER
00121D  1  85 0F                STA     TMPPOS          ;
00121F  1  A0 16                LDY     #>FCBBUFFER
001221  1  84 10                STY     TMPPOS+1        ;
001223  1  A2 1A                LDX     #26             ; Setup Buffer
001225  1  20 03 01             JSR     PEM
001228  1               
001228  1               DOS65LOAD_2:
001228  1  A9 07                LDA     #<DFLFCB        ; READ record buffer from disk file
00122A  1  A0 01                LDY     #>DFLFCB        ;
00122C  1  A2 14                LDX     #20             ;
00122E  1  20 03 01             JSR     PEM             ;
001231  1  C9 00                CMP     #$00            ; is error or EOF
001233  1  F0 07                BEQ     DOS65LOAD_3     ;
001235  1  C9 01                CMP     #$01            ; EOF?
001237  1  F0 40                BEQ     DOS65LOAD_EOF   ; YES, END
001239  1  4C 00 12             JMP     DOS65LOAD_ERR   ; ERROR, do error handling
00123C  1               DOS65LOAD_3:
00123C  1  A2 00                LDX     #$00            ; CLEAR COUNTERS
00123E  1  A0 00                LDY     #$00            ;
001240  1               DOS65LOAD_3A:
001240  1  B1 0F                LDA     (TMPPOS),Y      ; LOAD BYTE FROM BUFFER
001242  1  C8                   INY                     ; INC BUFFER COUNTER
001243  1  C9 1A                CMP     #$1A            ; IF EOF, SIGNAL END
001245  1  F0 37                BEQ     DOS65LOAD_4     ;
001247  1  C9 0D                CMP     #$0D            ; IF CR PLACE IT IN BUFFER AND PAD WITH SPACES TO MAXCOL
001249  1  F0 12                BEQ     DOS65LOAD_3D    ;
00124B  1  C9 20                CMP     #32             ; IF UNPRINTABLE, DO NOT PLACE IN BUFFER
00124D  1  90 07                BCC     DOS65LOAD_3C    ;
00124F  1  C9 7F                CMP     #127            ;
001251  1  B0 03                BCS     DOS65LOAD_3C    ;
001253  1  20 90 12             JSR     DOS65LOAD_STOREBT; STORE THE BYTE IN THE BUFFER
001256  1               DOS65LOAD_3C:
001256  1  C0 80                CPY     #$80            ; ARE WE AT THE END OF THE SOURCE BUFFER?
001258  1  D0 E6                BNE     DOS65LOAD_3A    ; NO, LOOP
00125A  1               
00125A  1  4C 28 12             JMP     DOS65LOAD_2     ; KEEP GOING!
00125D  1               
00125D  1               DOS65LOAD_3D:                   ; IN ORDER TO MAKE SCROLLING EASIER <CR> LINES NEED PADDED TO MAXCOL
00125D  1  20 90 12             JSR     DOS65LOAD_STOREBT; STORE THE <CR> BYTE
001260  1               DOS65LOAD_3D1:
001260  1  A5 12                LDA     CURRENTLEN      ;
001262  1  C9 50                CMP     #MAXCOL         ;
001264  1  F0 0C                BEQ     DOS65LOAD_3D2   ;
001266  1  A9 00                LDA     #$00            ;
001268  1  81 09                STA     (FCBPTR,X)      ; PLACE CHAR IN BUFFER
00126A  1  E6 12                INC     CURRENTLEN      ; INC THE LENGTH COUNTER
00126C  1  20 9E 12             JSR     DOS65LOAD_STOREBT1; INC THE BUFFER POINTER
00126F  1  4C 60 12             JMP     DOS65LOAD_3D1   ;
001272  1               DOS65LOAD_3D2:
001272  1  A9 00                LDA     #$00            ;
001274  1  85 12                STA     CURRENTLEN      ;
001276  1  4C 56 12             JMP     DOS65LOAD_3C    ;
001279  1               DOS65LOAD_EOF:
001279  1  A9 0D                LDA     #13
00127B  1  20 90 12             JSR     DOS65LOAD_STOREBT
00127E  1               
00127E  1               DOS65LOAD_4:
00127E  1  A9 07                LDA     #<DFLFCB        ; CLOSE FILE
001280  1  A0 01                LDY     #>DFLFCB        ;
001282  1  A2 10                LDX     #16             ;
001284  1  20 03 01             JSR     PEM             ;
001287  1  A5 09                LDA     FCBPTR          ;
001289  1  85 12                STA     CURRENTLEN      ;
00128B  1  A5 0A                LDA     FCBPTR+1        ;
00128D  1  85 13                STA     CURRENTLEN+1    ;
00128F  1  60                   RTS
001290  1               
001290  1               
001290  1               DOS65LOAD_STOREBT:
001290  1  81 09                STA     (FCBPTR,X)      ; PLACE CHAR IN BUFFER
001292  1  E6 12                INC     CURRENTLEN      ; INC THE LENGTH COUNTER
001294  1  A5 12                LDA     CURRENTLEN      ;
001296  1  C9 50                CMP     #MAXCOL         ; WRAP THE COUNTER ON MAXCOL
001298  1  D0 04                BNE     DOS65LOAD_STOREBT1;
00129A  1  A9 00                LDA     #$00            ;
00129C  1  85 12                STA     CURRENTLEN      ;
00129E  1               DOS65LOAD_STOREBT1:
00129E  1  E6 09                INC     FCBPTR          ; add to base counter
0012A0  1  D0 08                BNE     DOS65LOAD_STOREBT2
