000C1D  1               ;__CRSRUP________________________________________________________________________________________________________________________
000C1D  1               ;
000C1D  1               ; 	MOVE THE CURSOR UP ONE POSITION, DEC THE BUFFER POINTER AND SCROLL UP IF NECESSARY
000C1D  1               ;
000C1D  1               ;________________________________________________________________________________________________________________________________
000C1D  1               ;
000C1D  1               CRSRUP:
000C1D  1  A5 0D                LDA     EDTPOS          ;
000C1F  1  D0 07                BNE     CRSRUP1         ; CHECK TO SEE IF POINTER IS AT THE VERY TOP OF THE
000C21  1  A5 0E                LDA     EDTPOS+1        ; BUFFER.  IF IT IS, DO NOTHING.
000C23  1  C9 18                CMP     #>BUFFER        ;
000C25  1  D0 01                BNE     CRSRUP1         ;
000C27  1  60                   RTS                     ;
000C28  1               CRSRUP1:
000C28  1  A2 00                LDX     #$00            ;
000C2A  1  A5 0C                LDA     CSRPOSY         ; FIRST LINE?
000C2C  1  C9 00                CMP     #$00            ; THEN SCROLL UP
000C2E  1  D0 04                BNE     CRSRUP2         ;
000C30  1  20 C7 0C             JSR     SCROLLUP        ;
000C33  1  60                   RTS
000C34  1               
000C34  1               CRSRUP2:
000C34  1  20 EC 0D             JSR     DECEDTPOS       ; MOVE POINTER BACK ONE
000C37  1  E8                   INX                     ; INC COUNTER
000C38  1  E0 50                CPX     #MAXCOL         ; HAVE WE GONE BACK MAXCOL POSITIONS?
000C3A  1  D0 F8                BNE     CRSRUP2         ; YES, EXIT
000C3C  1               
000C3C  1  C6 0C                DEC     CSRPOSY         ;
000C3E  1  20 A9 0D             JSR     CHKPOS          ; WE ARE DONE! POSITION THE CURSOR AND EXIT
000C41  1  60                   RTS                     ;
000C42  1               
000C42  1               
000C42  1               ;__CRSRDN________________________________________________________________________________________________________________________
000C42  1               ;
000C42  1               ; 	MOVE THE CURSOR DOWN ONE POSITION, INC THE BUFFER POINTER AND SCROLL IF NECESSARY
000C42  1               ;
000C42  1               ;________________________________________________________________________________________________________________________________
000C42  1               ;
000C42  1               CRSRDN:
000C42  1               
000C42  1  A5 0C                LDA     CSRPOSY         ; HAVE WE REACHED THE END OF THE SCREEN?
000C44  1  C9 13                CMP     #LASTROW-1      ;
000C46  1  D0 03                BNE     CRSRDN1         ; NO, JUST MOVE DOWN
000C48  1  20 46 0D             JSR     SCROLLDOWN      ; SCROLL
000C4B  1               
000C4B  1               CRSRDN1:
000C4B  1  A2 00                LDX     #$00
000C4D  1               CRSRDN2:
000C4D  1  20 E5 0D             JSR     INCEDTPOS       ; MOVE EDTPOS 1 TO THE RIGHT
000C50  1  E8                   INX
000C51  1  E0 50                CPX     #MAXCOL
000C53  1  F0 0B                BEQ     CRSRDN3         ; YES, DONE
000C55  1  A5 0E                LDA     EDTPOS+1        ; WILL NEXT MOVE SEND US PAST THE END OF RAM?
000C57  1  C9 B8                CMP     #>Ram_top       ; are we at the end of RAM?
000C59  1  F0 0B                BEQ     CRSRDN4         ; YES, DONE THEN
000C5B  1  A5 0E                LDA     EDTPOS+1        ;
000C5D  1               
000C5D  1               CRSRDN2A:
000C5D  1  4C 4D 0C             JMP     CRSRDN2         ; NO, KEEP GOING
000C60  1               CRSRDN3:
000C60  1  E6 0C                INC     CSRPOSY         ;
000C62  1  20 A9 0D             JSR     CHKPOS          ; WE ARE DONE! POSITION THE CURSOR AND EXIT
000C65  1  60                   RTS                     ;
000C66  1               CRSRDN4:
