000000r 1               ut1_ph          = ut1_pl+1      ; utility pointer 1 high byte
000000r 1               ut2_pl          = $73           ; utility pointer 2 low byte
000000r 1               ut2_ph          = ut2_pl+1      ; utility pointer 2 high byte
000000r 1               
