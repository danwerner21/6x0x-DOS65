003B17  1               ; Ibuffs can now be anywhere in RAM AS LONG AS IT IS BEFORE RAM_BASE AND IS NOT PAGE ALIGNED!, ensure that the max length is < $80
003B17  1               
003B17  1               Ibuffs          = (ENDOFBASIC & $FF00)+$181
003B17  1               Ibuffe          = Ibuffs+$47    ; end of input buffer
003B17  1               
003B17  1               Ram_base        = (Ibuffe & $FF00)+$100; start of user RAM (set as needed, should be page aligned)
003B17  1                       .IFDEF  DUODYNE
003B17  1               Ram_top         = $D000         ; end of user RAM+1 (set as needed, should be page aligned)
003B17  1                       .ELSE
