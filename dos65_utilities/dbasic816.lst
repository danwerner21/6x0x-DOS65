003ACE  1               
003ACE  1               PRINT_BYTE:
003ACE  1  8E 07 3B             STX     TTX
003AD1  1  8C 08 3B             STY     TTY
003AD4  1  8D 09 3B             STA     TTA
003AD7  1  8E 06 3B             STX     SAVX            ; save X
003ADA  1  20 F1 3A             JSR     ASCTWO          ; get hex chars for byte in X (lower) and A (upper)
003ADD  1  20 0A 3B             JSR     WRSER1          ; output upper nybble
003AE0  1  8A                   TXA                     ; transfer lower to A
003AE1  1  AE 06 3B             LDX     SAVX            ; restore X
003AE4  1  20 0A 3B             JSR     WRSER1           ; output lower nybble
003AE7  1  AE 07 3B             LDX     TTX
003AEA  1  AC 08 3B             LDY     TTY
003AED  1  AD 09 3B             LDA     TTA
003AF0  1  60                   RTS
003AF1  1               ASCTWO:
003AF1  1  48                   PHA                     ; save byte
003AF2  1  20 FB 3A             JSR     ASCII           ; do low nybble
003AF5  1  AA                   TAX                     ; save in X
003AF6  1  68                   PLA                     ; restore byte
003AF7  1  4A                   LSR     A               ; shift upper nybble down
003AF8  1  4A                   LSR     A
003AF9  1  4A                   LSR     A
003AFA  1  4A                   LSR     A
003AFB  1               ; convert low nybble in A to hex digit
003AFB  1               ASCII:
003AFB  1  29 0F                AND     #$0F            ; clear upper nibble
003AFD  1  C9 0A                CMP     #$0A            ; if less than A, skip next step
003AFF  1  90 02                BCC     ASC1
003B01  1  69 06                ADC     #6              ; skip ascii chars between 9 and A
003B03  1               ASC1:
003B03  1  69 30                ADC     #$30            ; add ascii char 0 to value
003B05  1  60                   RTS
