000937  1               ;__GETDECIMAL__________________________________________________
000937  1               ;
000937  1               ; CONVERT A STRING (DECIMAL) TO A 8 BIT NUMBER IN TEMPWORD
000937  1               ;
000937  1               ;______________________________________________________________
000937  1               GETDECIMAL:
000937  1  A2 00                LDX     #$00
000939  1  86 3B                STX     TEMPWORD
00093B  1               
