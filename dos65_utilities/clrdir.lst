0009A6  1               ;__PRINT_BYTE__________________________________________________
0009A6  1               ;
0009A6  1               ; PRINT OUT ACCUMULATOR AS HEX NUMBER
0009A6  1               ;
0009A6  1               ;______________________________________________________________
0009A6  1               PRINT_BYTE:
0009A6  1  48                   PHA                     ; SAVE A REGISTER
0009A7  1  4A                   LSR     A               ; SHIFT HIGH NIBBLE TO LOW NIBBLE
0009A8  1  4A                   LSR     A               ;
0009A9  1  4A                   LSR     A               ;
0009AA  1  4A                   LSR     A               ;
0009AB  1  18                   CLC                     ; CLEAR CARRY
0009AC  1  20 B3 09             JSR     PRINT_DIGIT     ; PRINT LOW NIBBLE
0009AF  1  68                   PLA                     ; RESTORE ACCUMULATOR
0009B0  1  4C B3 09             JMP     PRINT_DIGIT     ; PRINT LOW NIBBLE
0009B3  1               
0009B3  1               ;__PRINT_DIGIT_________________________________________________
0009B3  1               ;
0009B3  1               ; PRINT OUT LOW NIBBLE OF ACCUMULATOR IN HEX
0009B3  1               ;
0009B3  1               ;______________________________________________________________
0009B3  1               PRINT_DIGIT:
0009B3  1  29 0F                AND     #$0F            ; STRIP OFF HIGH NIBBLE
0009B5  1  09 30                ORA     #$30            ; ADD $30 TO PRODUCE ASCII
0009B7  1  C9 3A                CMP     #$3A            ; IS GREATER THAN 9
0009B9  1  30 03                BMI     :+              ; NO, SKIP ADD
0009BB  1  18                   CLC                     ; CLEAR CARRY
0009BC  1  69 07                ADC     #$07            ; ADD ON FOR LETTER VALUES
0009BE  1               :       ;
0009BE  1  48                   PHA
0009BF  1  A9 00                LDA     #00
0009C1  1  85 32                STA     farfunct
0009C3  1  68                   PLA
