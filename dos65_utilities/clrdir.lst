00099B  1               ;__PRINT_BYTE__________________________________________________
00099B  1               ;
00099B  1               ; PRINT OUT ACCUMULATOR AS HEX NUMBER
00099B  1               ;
00099B  1               ;______________________________________________________________
00099B  1               PRINT_BYTE:
00099B  1  48                   PHA                     ; SAVE A REGISTER
00099C  1  4A                   LSR     A               ; SHIFT HIGH NIBBLE TO LOW NIBBLE
00099D  1  4A                   LSR     A               ;
00099E  1  4A                   LSR     A               ;
00099F  1  4A                   LSR     A               ;
0009A0  1  18                   CLC                     ; CLEAR CARRY
0009A1  1  20 A8 09             JSR     PRINT_DIGIT     ; PRINT LOW NIBBLE
0009A4  1  68                   PLA                     ; RESTORE ACCUMULATOR
0009A5  1  4C A8 09             JMP     PRINT_DIGIT     ; PRINT LOW NIBBLE
0009A8  1               
0009A8  1               ;__PRINT_DIGIT_________________________________________________
0009A8  1               ;
