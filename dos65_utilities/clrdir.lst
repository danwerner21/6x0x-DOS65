000984  1  8D 10 06             STA     debcyll         ; SLICE OFFSET LSB
000987  1  18                   CLC                     ; VOODOO MATH TO TAKE SLICE*$4000
000988  1  6E 11 06             ROR     debcylm
00098B  1  6E 10 06             ROR     debcyll
00098E  1  6E 11 06             ROR     debcylm
000991  1  6E 10 06             ROR     debcyll
000994  1               
000994  1  A5 3B                LDA     TEMPWORD        ; GET SLICE#
000996  1  18                   CLC
