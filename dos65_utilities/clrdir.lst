0009AC  1  C9 3A                CMP     #$3A            ; IS GREATER THAN 9
0009AE  1  30 03                BMI     :+              ; NO, SKIP ADD
0009B0  1  18                   CLC                     ; CLEAR CARRY
0009B1  1  69 07                ADC     #$07            ; ADD ON FOR LETTER VALUES
