00095F  1               OUTSTR:
00095F  1  A9 00                LDA     #00
000961  1  85 32                STA     farfunct
000963  1  A0 00                LDY     #$00            ; LOAD $00 INTO Y
000965  1               OUTSTRLP:
000965  1  B1 41                LDA     (STRPTR),Y      ; LOAD NEXT CHAR FROM STRING INTO ACC
000967  1  C9 00                CMP     #$00            ; IS NULL?
