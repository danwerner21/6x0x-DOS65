00093B  1  BD C2 0A             LDA     CBUFF,X
00093E  1  C9 FF                CMP     #$FF
000940  1  F0 1C                BEQ     GETDECIMAL_DONE
000942  1               
000942  1               ; MULTIPLY TEMPWORD*10
000942  1  A5 3B                LDA     TEMPWORD
000944  1  85 3D                STA     TEMPWORD1
000946  1               
000946  1  A5 3B                LDA     TEMPWORD
000948  1  0A                   ASL     A               ;*2
000949  1  0A                   ASL     A               ;*2
00094A  1  0A                   ASL     A               ;*2
00094B  1               
00094B  1  18                   CLC
00094C  1  65 3D                ADC     TEMPWORD1
00094E  1  65 3D                ADC     TEMPWORD1
000950  1  85 3B                STA     TEMPWORD        ; store sum
000952  1  BD C2 0A             LDA     CBUFF,X         ; add new decimal digit
000955  1  E8                   INX
000956  1  18                   CLC
000957  1  65 3B                ADC     TEMPWORD
000959  1  85 3B                STA     TEMPWORD        ; store sum
00095B  1  4C 3B 09             JMP     GETDECIMAL_LOOP
