001208  2               ;__________________________________________________________________________________________________
001208  2               KBD_GETDATAX:
001208  2               ;
001208  2               ; GET A RAW DATA BYTE FROM KEYBOARD INTERFACE INTO A WITH NO TIMEOUT
001208  2               ;
001208  2  AD FF E3             LDA     KBD_ST          ; STATUS PORT
00120B  2  29 01                AND     #$01            ; ISOLATE INPUT PENDING BIT
00120D  2  C9 00                CMP     #$00
00120F  2  D0 F2                BNE     KBD_GETDATA1A   ; BYTE PENDING, GO GET IT
001211  2  A9 00                LDA     #$00
001213  2  38                   SEC                     ; NO DATA, RETURN ZERO
001214  2  60                   RTS
001215  2               ;
001215  2               ;__________________________________________________________________________________________________
001215  2               ; RESET KEYBOARD
001215  2               ;__________________________________________________________________________________________________
001215  2               ;
001215  2               KBD_RESET:
001215  2  A9 FF                LDA     #$FF            ; RESET COMMAND
001217  2  20 B5 11             JSR     KBD_PUTDATA     ; SEND IT
00121A  2  20 D9 11             JSR     KBD_GETDATA     ; GET THE ACK
00121D  2  A2 00                LDX     #$00            ; SETUP LOOP COUNTER
00121F  2  A0 F1                LDY     #$F1            ; SETUP LOOP COUNTER
001221  2               KBD_RESET0:
001221  2  20 D9 11             JSR     KBD_GETDATA     ; TRY TO GET THE RESPONSE
001224  2  90 0C                BCC     KBD_RESET1      ; GOT A BYTE?  IF SO, GET OUT OF LOOP
001226  2  CA                   DEX
001227  2  E0 00                CPX     #$00
001229  2  D0 F6                BNE     KBD_RESET0      ; LOOP TILL COUNTER EXHAUSTED
00122B  2  88                   DEY
00122C  2  C0 00                CPY     #$00
00122E  2  D0 F1                BNE     KBD_RESET0      ; LOOP TILL COUNTER EXHAUSTED
001230  2  38                   SEC                     ; SIGNAL FAILURE
001231  2  60                   RTS                     ; DONE
001232  2               KBD_RESET1:
001232  2  18                   CLC                     ; SIGNAL SUCCESS (RESPONSE IS IGNORED...)
001233  2  60                   RTS                     ; DONE
001234  2               ;
001234  2               ;__________________________________________________________________________________________________
001234  2               ; UPDATE KEYBOARD LEDS BASED ON CURRENT TOGGLE FLAGS
001234  2               ;__________________________________________________________________________________________________
001234  2               ;
001234  2               KBD_SETLEDS:
001234  2  A9 ED                LDA     #$ED            ; SET/RESET LED'S COMMAND
001236  2  20 B5 11             JSR     KBD_PUTDATA     ; SEND THE COMMAND
001239  2  20 D9 11             JSR     KBD_GETDATA     ; READ THE RESPONSE
00123C  2  C9 FA                CMP     #$FA            ; MAKE SURE WE GET ACK
00123E  2  F0 02                BEQ     :+
001240  2               
001240  2  38                   SEC
001241  2  60                   RTS                     ; ABORT IF NO ACK
001242  2               :
001242  2  AD CB 10             LDA     KBD_STATE       ; LOAD THE STATE BYTE
001245  2  6A                   ROR     A               ; ROTATE TOGGLE KEY BITS AS NEEDED
001246  2  6A                   ROR     A
001247  2  6A                   ROR     A
001248  2  6A                   ROR     A
001249  2  29 07                AND     #$07            ; CLEAR THE IRRELEVANT BITS
00124B  2  20 B5 11             JSR     KBD_PUTDATA     ; SEND THE LED DATA
00124E  2  20 D9 11             JSR     KBD_GETDATA     ; READ THE ACK
001251  2  C9 FA                CMP     #$FA            ; MAKE SURE WE GET ACK
001253  2  F0 02                BEQ     :+
001255  2               
001255  2  38                   SEC
001256  2  60                   RTS                     ; ABORT IF NO ACK
001257  2               :
001257  2  A9 00                LDA     #$00            ; A=0
001259  2  8D CE 10             STA     KBD_STATUS      ; CLEAR STATUS
00125C  2  18                   CLC
00125D  2  60                   RTS
00125E  2               ;
00125E  2               ;__________________________________________________________________________________________________
00125E  2               ; UPDATE KEYBOARD REPEAT RATE BASED ON CURRENT SETTING
00125E  2               ;__________________________________________________________________________________________________
00125E  2               ;
00125E  2               KBD_SETRPT:
00125E  2  A9 F3                LDA     #$F3            ; COMMAND = SET TYPEMATIC RATE/DELAY
001260  2  20 B5 11             JSR     KBD_PUTDATA     ; SEND IT
001263  2  20 D9 11             JSR     KBD_GETDATA     ; GET THE ACK
001266  2  C9 FA                CMP     #$FA            ; MAKE SURE WE GET ACK
001268  2  F0 02                BEQ     :+
00126A  2               
00126A  2  38                   SEC
00126B  2  60                   RTS                     ; ABORT IF NO ACK
00126C  2               :
00126C  2  AD CF 10             LDA     KBD_REPEAT      ; LOAD THE CURRENT RATE/DELAY BYTE
00126F  2  20 B5 11             JSR     KBD_PUTDATA     ; SEND IT
001272  2  20 D9 11             JSR     KBD_GETDATA     ; GET THE ACK
001275  2  C9 FA                CMP     #$FA            ; MAKE SURE WE GET ACK
001277  2  F0 02                BEQ     :+
001279  2               
001279  2  38                   SEC
00127A  2  60                   RTS                     ; ABORT IF NO ACK
00127B  2               :
00127B  2  18                   CLC
00127C  2  60                   RTS
