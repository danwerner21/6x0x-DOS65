001191  2               ;__________________________________________________________________________________________________
001191  2               KBD_PUTCMD:
001191  2               ; PUT A CMD BYTE FROM A TO THE KEYBOARD INTERFACE WITH TIMEOUT
001191  2               ;
001191  2  48                   PHA
001192  2  A2 FF                LDX     #<KBD_WAITTO    ; SETUP TO LOOP
001194  2  A0 30                LDY     #>KBD_WAITTO    ; SETUP TO LOOP
001196  2               KBD_PUTCMD0:
001196  2  AD FF E3             LDA     KBD_ST          ; STATUS PORT
001199  2  29 02                AND     #$02            ; ISOLATE EMPTY BIT
00119B  2  C9 00                CMP     #$00
00119D  2  F0 10                BEQ     KBD_PUTCMD1     ; EMPTY, GO TO WRITE
00119F  2  20 6A 14             JSR     DELAY           ; WAIT A BIT
0011A2  2  CA                   DEX
0011A3  2  E0 00                CPX     #$00
0011A5  2  D0 EF                BNE     KBD_PUTCMD0     ; LOOP UNTIL COUNTER EXHAUSTED
0011A7  2  88                   DEY
0011A8  2  C0 00                CPY     #$00
0011AA  2  D0 EA                BNE     KBD_PUTCMD0     ; LOOP UNTIL COUNTER EXHAUSTED
