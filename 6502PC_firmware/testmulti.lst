0011D4  2  8D FE E3             STA     KBD_DAT         ; WRITE TO DATA PORT
0011D7  2  18                   CLC                     ; SIGNAL SUCCESS
0011D8  2  60                   RTS
0011D9  2               ;
0011D9  2               ;__________________________________________________________________________________________________
0011D9  2               KBD_GETDATA:
0011D9  2               ;
