0010FF  2  A9 D4                LDA     #<MIOMESSAGE5   ;
001101  2  85 41                STA     STRPTR          ;
001103  2  A9 14                LDA     #>MIOMESSAGE5   ;
001105  2  85 42                STA     STRPTR+1        ;
001107  2  20 84 10             JSR     WRSTR           ; DO PROMPT
00110A  2  20 79 10             JSR     LFCR            ; AND CRLF
00110D  2               
00110D  2  A9 00                LDA     #$00
00110F  2  8D F0 E3             STA     LPT_0           ; PORT 0 (DATA)
