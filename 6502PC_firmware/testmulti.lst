001462  2               KBD_DECNEW:                     ; START NEW KEYPRESS (CLEAR ALL STATUS BITS)
001462  2  A9 00                LDA     #$00            ; A=0
001464  2  8D CE 10             STA     KBD_STATUS      ; CLEAR STATUS
001467  2  4C 9E 12             JMP     KBD_DEC1        ; RESTART THE ENGINE
