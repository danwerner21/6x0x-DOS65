00167B  2               ;
00167B  2               ; BYTE OUTPUT
00167B  2               ;
00167B  2               LPT_OUT:
00167B  2  48                   PHA
00167C  2  A2 FF                LDX     #<LPT_WAITTO
00167E  2  A0 30                LDY     #>LPT_WAITTO
001680  2               :
001680  2  20 A8 16             JSR     LPT_OST         ; READY TO SEND?
001683  2  D0 0D                BNE     :+              ; GO IF READY
001685  2  CA                   DEX
001686  2  E0 00                CPX     #$00
001688  2  D0 F6                BNE     :-              ; LOOP IF NOT READY
00168A  2  88                   DEY
00168B  2  C0 00                CPY     #$00
00168D  2  D0 F1                BNE     :-              ; LOOP IF NOT READY
00168F  2  68                   PLA
001690  2  38                   SEC                     ; SIGNAL ERROR
001691  2  60                   RTS
001692  2               :
001692  2  68                   PLA
001693  2  8D F0 E3             STA     LPT_0           ; OUTPUT TO PORT 0 (DATA)
001696  2  A9 0D                LDA     #%00001101      ; SELECT & STROBE, LEDS OFF
001698  2  8D F2 E3             STA     LPT_2           ; OUTPUT DATA TO PORT
00169B  2  20 6A 14             JSR     DELAY
00169E  2  A9 0C                LDA     #%00001100      ; SELECT, LEDS OFF
0016A0  2  8D F2 E3             STA     LPT_2           ; OUTPUT DATA TO PORT
0016A3  2  20 6A 14             JSR     DELAY
0016A6  2  18                   CLC
0016A7  2  60                   RTS
