00127D  2               KBD_GETKEY:
00127D  2  20 95 12             JSR     KBD_DECODE
001280  2  90 04                BCC     :+
001282  2  A9 FF                LDA     #$FF            ;
001284  2  38                   SEC
001285  2  60                   RTS
001286  2               :
001286  2  AD CA 10             LDA     KBD_KEYCODE
001289  2  48                   PHA
00128A  2  AD CE 10             LDA     KBD_STATUS
00128D  2  29 7F                AND     #$7F
00128F  2  8D CE 10             STA     KBD_STATUS
