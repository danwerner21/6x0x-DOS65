0010C8  2               ;__MULTI IO DRIVERS______________________________________________________________________________________________________________
0010C8  2               ;
0010C8  2               ; 	DOS/65 ISA MULTI IO drivers for 6502PC
0010C8  2               ;
0010C8  2               ;	Entry points:
0010C8  2               ;		MULTIOINIT  - CALLED during OS init
0010C8  2               ;		KBD_GETKEY  - read a character from the ps/2 keyboard ('A' POINTS TO BYTE)
0010C8  2               ;		LPT_OUT	    - send a character to the printer
0010C8  2               ;________________________________________________________________________________________________________________________________
0010C8  2               ;
0010C8  2               ;*
0010C8  2               ;*        HARDWARE I/O ADDRESSES
0010C8  2               ;*
0010C8  2               ;
0010C8  2               MULTIO_BASE     = PC6502_IO+$3E0
0010C8  2               KBD_DAT         = MULTIO_BASE+$1E
0010C8  2               KBD_ST          = MULTIO_BASE+$1F
0010C8  2               KBD_CMD         = MULTIO_BASE+$1F
0010C8  2               
0010C8  2               LPT_0           = MULTIO_BASE+$10
0010C8  2               LPT_1           = MULTIO_BASE+$11
0010C8  2               LPT_2           = MULTIO_BASE+$12
0010C8  2               
0010C8  2               
0010C8  2               ;__________________________________________________________________________________________________
0010C8  2               ;
0010C8  2               ; STATUS BITS (FOR KBD_STATUS)
0010C8  2               ;
0010C8  2               KBD_EXT         = $01           ; BIT 0, EXTENDED SCANCODE ACTIVE
0010C8  2               KBD_BREAK       = $02           ; BIT 1, THIS IS A KEY UP (BREAK) EVENT
0010C8  2               KBD_KEYRDY      = $80           ; BIT 7, INDICATES A DECODED KEYCODE IS READY
0010C8  2               ;
0010C8  2               ; STATE BITS (FOR KBD_STATE, KBD_LSTATE, KBD_RSTATE)
0010C8  2               ;
0010C8  2               KBD_SHIFT       = $01           ; BIT 0, SHIFT ACTIVE (PRESSED)
0010C8  2               KBD_CTRL        = $02           ; BIT 1, CONTROL ACTIVE (PRESSED)
0010C8  2               KBD_ALT         = $04           ; BIT 2, ALT ACTIVE (PRESSED)
0010C8  2               KBD_WIN         = $08           ; BIT 3, WIN ACTIVE (PRESSED)
0010C8  2               KBD_SCRLCK      = $10           ; BIT 4, CAPS LOCK ACTIVE (TOGGLED ON)
0010C8  2               KBD_NUMLCK      = $20           ; BIT 5, NUM LOCK ACTIVE (TOGGLED ON)
0010C8  2               KBD_CAPSLCK     = $40           ; BIT 6, SCROLL LOCK ACTIVE (TOGGLED ON)
0010C8  2               KBD_NUMPAD      = $80           ; BIT 7, NUM PAD KEY (KEY PRESSED IS ON NUM PAD)
0010C8  2               NOT_KBD_NUMPAD  = $7F           ; BIT 7, NUM PAD KEY (KEY PRESSED IS ON NUM PAD)
0010C8  2               ;
0010C8  2               KBD_DEFRPT      = $40           ; DEFAULT REPEAT RATE (.5 SEC DELAY, 30CPS)
0010C8  2               KBD_DEFSTATE    = KBD_NUMLCK|KBD_CAPSLCK|KBD_SCRLCK
0010C8  2               ;
0010C8  2               ; DEFAULT STATE (NUM LOCK ON)
0010C8  2               
0010C8  2               KBD_WAITTO      = $30FF         ; DEFAULT TIMEOUT
0010C8  2               LPT_WAITTO      = $30FF         ; DEFAULT TIMEOUT
0010C8  2               ;
0010C8  2               ;__________________________________________________________________________________________________
0010C8  2               ; DATA
0010C8  2               ;__________________________________________________________________________________________________
0010C8  2               ;
0010C8  2               TMPKEY:
0010C8  2  00                   .BYTE   0
0010C9  2               KBD_SCANCODE:
0010C9  2  00                   .BYTE   0               ; RAW SCANCODE
0010CA  2               KBD_KEYCODE:
0010CA  2  00                   .BYTE   0               ; RESULTANT KEYCODE AFTER DECODING
0010CB  2               KBD_STATE:
0010CB  2  70                   .BYTE   KBD_DEFSTATE    ; STATE BITS (SEE ABOVE)
0010CC  2               KBD_LSTATE:
0010CC  2  00                   .BYTE   0               ; STATE BITS FOR "LEFT" KEYS
0010CD  2               KBD_RSTATE:
0010CD  2  00                   .BYTE   0               ; STATE BITS FOR "RIGHT" KEYS
0010CE  2               KBD_STATUS:
0010CE  2  00                   .BYTE   0               ; CURRENT STATUS BITS (SEE ABOVE)
0010CF  2               KBD_REPEAT:
0010CF  2  40                   .BYTE   KBD_DEFRPT      ; CURRENT REPEAT RATE
0010D0  2               KBD_IDLE:
0010D0  2  00                   .BYTE   0               ; IDLE COUNT
0010D1  2               KBD_TEMP:
0010D1  2  00 00                .BYTE   0,0             ; WORKING STORAGE
0010D3  2               
0010D3  2               ;
0010D3  2               ;  IBM PC STANDARD PARALLEL PORT (SPP):
0010D3  2               ;
0010D3  2               ;  PORT 0 (OUTPUT):
0010D3  2               ;
0010D3  2               ;	D7	D6	D5	D4	D3	D2	D1	D0
0010D3  2               ;     +-------+-------+-------+-------+-------+-------+-------+-------+
0010D3  2               ;     | PD7   | PD6   | PD5   | PD4   | PD3   | PD2   | PD1   | PD0   |
0010D3  2               ;     +-------+-------+-------+-------+-------+-------+-------+-------+
0010D3  2               ;
0010D3  2               ;  PORT 1 (INPUT):
0010D3  2               ;
0010D3  2               ;	D7	D6	D5	D4	D3	D2	D1	D0
0010D3  2               ;     +-------+-------+-------+-------+-------+-------+-------+-------+
0010D3  2               ;     | /BUSY | /ACK  | POUT  | SEL   | /ERR  | 0     | 0     | 0     |
0010D3  2               ;     +-------+-------+-------+-------+-------+-------+-------+-------+
0010D3  2               ;
0010D3  2               ;  PORT 2 (OUTPUT):
0010D3  2               ;
0010D3  2               ;	D7	D6	D5	D4	D3	D2	D1	D0
0010D3  2               ;     +-------+-------+-------+-------+-------+-------+-------+-------+
0010D3  2               ;     | STAT1 | STAT0 | ENBL  | PINT  | SEL   | RES   | LF    | STB   |
0010D3  2               ;     +-------+-------+-------+-------+-------+-------+-------+-------+
0010D3  2               ;
0010D3  2               ;
0010D3  2               ;
0010D3  2               ;
0010D3  2               ;  IEC PORT (OUTPUT):
0010D3  2               ;
0010D3  2               ;	D7	D6	D5	D4	D3	D2	D1	D0
0010D3  2               ;     +-------+-------+-------+-------+-------+-------+-------+-------+
0010D3  2               ;     | 0     | 0     | 0     | 0     | 0     | SERDTA| SERCLK| SERATN|
0010D3  2               ;     +-------+-------+-------+-------+-------+-------+-------+-------+
0010D3  2               ;
0010D3  2               ;  IEC PORT (OUTPUT):
0010D3  2               ;
0010D3  2               ;	D7	D6	D5	D4	D3	D2	D1	D0
0010D3  2               ;     +-------+-------+-------+-------+-------+-------+-------+-------+
0010D3  2               ;     | 0     | 0     | 0     | 0     | 0     | 0     | SERDTA| SERCLK|
0010D3  2               ;     +-------+-------+-------+-------+-------+-------+-------+-------+
0010D3  2               ;
0010D3  2               ;__________________________________________________________________________________________________
0010D3  2               ; MULTI IO INITIALIZATION
0010D3  2               ;__________________________________________________________________________________________________
0010D3  2               ;
0010D3  2               MULTIOINIT:
0010D3  2               ;
0010D3  2  20 79 10             JSR     LFCR            ; AND CRLF
0010D6  2  A9 98                LDA     #<MIOMESSAGE1   ;
0010D8  2  85 41                STA     STRPTR          ;
0010DA  2  A9 14                LDA     #>MIOMESSAGE1   ;
0010DC  2  85 42                STA     STRPTR+1        ;
0010DE  2  20 84 10             JSR     WRSTR           ; DO PROMPT
0010E1  2  20 79 10             JSR     LFCR            ; AND CRLF
0010E4  2               ; KEYBOARD INITIALIZATION
0010E4  2  A9 BF                LDA     #<MESSAGE2      ;
0010E6  2  85 41                STA     STRPTR          ;
0010E8  2  A9 10                LDA     #>MESSAGE2      ;
0010EA  2  85 42                STA     STRPTR+1        ;
0010EC  2  20 84 10             JSR     WRSTR           ; DO PROMPT
0010EF  2  A9 E3                LDA     #>MULTIO_BASE   ; GET BASE PORT
0010F1  2  20 99 10             JSR     PRINT_BYTE      ; PRINT BASE PORT
0010F4  2  A9 E0                LDA     #<MULTIO_BASE   ; GET BASE PORT
0010F6  2  20 99 10             JSR     PRINT_BYTE      ; PRINT BASE PORT
0010F9  2  20 79 10             JSR     LFCR            ; AND CRLF
0010FC  2               ;
0010FC  2  20 23 11             JSR     KBD_PROBE       ; DETECT A KEYBOARD
0010FF  2               
