001295  2               ;
001295  2               ;__________________________________________________________________________________________________
001295  2               ; DECODING ENGINE
001295  2               ;__________________________________________________________________________________________________
001295  2               ;
001295  2               ;__________________________________________________________________________________________________
001295  2               KBD_DECODE:
001295  2               ;
001295  2               ;  RUN THE DECODING ENGINE UNTIL EITHER: 1) NO MORE SCANCODES ARE AVAILABLE
001295  2               ;  FROM THE KEYBOARD, OR 2) A DECODED KEY VALUE IS AVAILABLE
001295  2               ;
001295  2               ;  RETURNS A=0 AND Z SET IF NO KEYCODE READY, OTHERWISE A DECODED KEY VALUE IS AVAILABLE.
001295  2               ;  THE DECODED KEY VALUE AND KEY STATE IS STORED IN KBD_KEYCODE AND KBD_STATE.
001295  2               ;
001295  2               ;  KBD_STATUS IS NOT CLEARED AT START. IT IS THE JSR ER'S RESPONSIBILITY
001295  2               ;  TO CLEAR KBD_STATUS WHEN IT HAS RETRIEVED A PENDING VALUE.  IF DECODE IS JSR ED
001295  2               ;  WITH A KEYCODE STILL PENDING, IT WILL JUST RETURN WITHOUT DOING ANYTHING.
001295  2               ;
001295  2               ; Step 0: Check keycode buffer
001295  2               ;   if status[keyrdy]
001295  2               ;     return
001295  2               ;
001295  2               ; Step 1: Get scancode
001295  2               ;   if no scancode ready
001295  2               ;     return
001295  2               ;   read scancode
001295  2               ;
001295  2               ; Step 2: Detect and handle special keycodes
001295  2               ;   if scancode == $AA
001295  2               ;     *** handle hot insert somehow ***
001295  2               ;
001295  2               ; Step 3: Detect and handle scancode prefixes
001295  2               ;   if scancode == $E0
001295  2               ;     set status[extended]
001295  2               ;     goto Step 1
001295  2               ;
001295  2               ;   if scancode == $E1
001295  2               ;     *** handle pause key somehow ***
001295  2               ;
001295  2               ; Step 4: Detect and flag break event
001295  2               ;   *** scancode set #1 variation ***
001295  2               ;     set status[break] = high bit of scancode
001295  2               ;     clear high order bit
001295  2               ;     continue to Step 5
001295  2               ;   *** scancode set #2 variation ***
001295  2               ;     if scancode == $F0
001295  2               ;       set status[break]
001295  2               ;       goto Step 1
001295  2               ;
001295  2               ; Step 5: Map scancode to keycode
001295  2               ;   if status[extended]
001295  2               ;     apply extended-map[scancode] -> keycode
001295  2               ;   else if state[shifted]
001295  2               ;     apply shifted-map[scancode] -> keycode
001295  2               ;   else
001295  2               ;     apply normal-map[scancode] -> keycode
001295  2               ;
001295  2               ; Step 6: Handle modifier keys
001295  2               ;   if keycode is modifier (shift, ctrl, alt, win)
001295  2               ;     set (l/r)state[<modifier>] = not status[break]
001295  2               ;     clear modifier bits in state
001295  2               ;     set state = (lstate OR rstate OR state)
001295  2               ;     goto New Key
001295  2               ;
001295  2               ; Step 7: Complete procesing of key break events
001295  2               ;   if status[break]
001295  2               ;     goto New Key
001295  2               ;
001295  2               ; Step 8: Handle toggle keys
001295  2               ;   if keycode is toggle (capslock, numlock, scrolllock)
001295  2               ;     invert (XOR) state[<toggle>]
001295  2               ;     update keyboard LED's
001295  2               ;     goto New Key
001295  2               ;
001295  2               ; Step 9: Adjust keycode for control modifier
001295  2               ;   if state[ctrl]
001295  2               ;     if keycode is 'a'-'z'
001295  2               ;       subtract 20 (clear bit 5) from keycode
001295  2               ;     if keycode is '@'-'_'
001295  2               ;       subtract 40 (clear bit 6) from keycode
001295  2               ;
001295  2               ; Step 10: Adjust keycode for caps lock
001295  2               ;   if state[capslock]
001295  2               ;     if keycode is 'a'-'z' OR 'A'-'Z'
001295  2               ;       toggle (XOR) bit 5 of keycode
001295  2               ;
001295  2               ; Step 11: Handle num pad keys
001295  2               ;   clear state[numpad]
001295  2               ;   if keycode is numpad
001295  2               ;     set state[numpad]
001295  2               ;     if state[numlock]
001295  2               ;       toggle (XOR) bit 4 of keycode
001295  2               ;     apply numpad-map[keycode] -> keycode
001295  2               ;
001295  2               ; Step 12: Detect unknown/invalid keycodes
001295  2               ;   if keycode == $FF
001295  2               ;     goto New Key
001295  2               ;
001295  2               ; Step 13: Done
001295  2               ;   set status[keyrdy]
001295  2               ;   return
001295  2               ;
001295  2               ; New Key:
001295  2               ;   clear status
001295  2               ;   goto Step 1
001295  2               ;
001295  2               KBD_DEC0:                       ; CHECK KEYCODE BUFFER
001295  2  AD CE 10             LDA     KBD_STATUS      ; GET CURRENT STATUS
001298  2  29 80                AND     #KBD_KEYRDY     ; ISOLATE KEY READY FLAG
00129A  2  F0 02                BEQ     KBD_DEC1
00129C  2  38                   SEC
00129D  2  60                   RTS                     ; ABORT IF KEY IS ALREADY PENDING
00129E  2               
00129E  2               KBD_DEC1:                       ; PROCESS NEXT SCANCODE
00129E  2  20 08 12             JSR     KBD_GETDATAX    ; GET THE SCANCODE
0012A1  2  90 02                BCC     KBD_DEC2
0012A3  2  38                   SEC
0012A4  2  60                   RTS                     ; NO KEY READY, RETURN WITH A=0, SET ERROR
0012A5  2               
0012A5  2               KBD_DEC2:                       ; DETECT AND HANDLE SPECIAL KEYCODES
0012A5  2  8D C9 10             STA     KBD_SCANCODE    ; SAVE SCANCODE
0012A8  2  C9 AA                CMP     #$AA            ; KEYBOARD INSERTION?
0012AA  2  D0 0F                BNE     KBD_DEC3        ; NOPE, BYPASS
0012AC  2  20 7C 14             JSR     LDELAY          ; WAIT A BIT
0012AF  2  20 15 12             JSR     KBD_RESET       ; RESET KEYBOARD
0012B2  2  20 34 12             JSR     KBD_SETLEDS     ; SET LEDS
0012B5  2  20 5E 12             JSR     KBD_SETRPT      ; SET REPEAT RATE
0012B8  2  4C 62 14             JMP     KBD_DECNEW      ; RESTART THE ENGINE
0012BB  2               
0012BB  2               KBD_DEC3:                       ; DETECT AND HANDLE SCANCODE PREFIXES
0012BB  2  C9 E0                CMP     #$E0            ; EXTENDED KEY PREFIX $E0?
0012BD  2  D0 0D                BNE     KBD_DEC3B       ; NOPE MOVE ON
0012BF  2  48                   PHA
0012C0  2  AD CE 10             LDA     KBD_STATUS      ; GET STATUS
0012C3  2  09 01                ORA     #KBD_EXT        ; SET EXTENDED BIT
0012C5  2  8D CE 10             STA     KBD_STATUS      ; SAVE STATUS
0012C8  2  68                   PLA
0012C9  2  4C 9E 12             JMP     KBD_DEC1        ; LOOP TO DO NEXT SCANCODE
0012CC  2               
0012CC  2               KBD_DEC3B:                      ; HANDLE SCANCODE PREFIX $E1 (PAUSE KEY)
0012CC  2  C9 E1                CMP     #$E1            ; EXTENDED KEY PREFIX $E1
0012CE  2  D0 10                BNE     KBD_DEC4        ; NOPE MOVE ON
0012D0  2  A9 EE                LDA     #$EE            ; MAP TO KEYCODE $EE
0012D2  2  8D CA 10             STA     KBD_KEYCODE     ; SAVE IT
0012D5  2               ; SWALLOW NEXT 7 SCANCODES
0012D5  2  A2 07                LDX     #7              ; LOOP 7 TIMES
0012D7  2               KBD_DEC3B1:
0012D7  2  20 D9 11             JSR     KBD_GETDATA     ; RETRIEVE NEXT SCANCODE
0012DA  2  CA                   DEX
0012DB  2  D0 FA                BNE     KBD_DEC3B1      ; LOOP AS NEEDED
0012DD  2  4C 3A 13             JMP     KBD_DEC6        ; RESUME AFTER MAPPING
0012E0  2               
0012E0  2               KBD_DEC4:                       ; DETECT AND FLAG BREAK EVENT
0012E0  2  C9 F0                CMP     #$F0            ; BREAK (KEY UP) PREFIX?
0012E2  2  D0 0D                BNE     KBD_DEC5        ; NOPE MOVE ON
0012E4  2  48                   PHA
0012E5  2  AD CE 10             LDA     KBD_STATUS      ; GET STATUS
0012E8  2  09 02                ORA     #KBD_BREAK      ; SET BREAK BIT
0012EA  2  8D CE 10             STA     KBD_STATUS      ; SAVE STATUS
0012ED  2  68                   PLA
0012EE  2  4C 9E 12             JMP     KBD_DEC1        ; LOOP TO DO NEXT SCANCODE
0012F1  2               
0012F1  2               KBD_DEC5:                       ; MAP SCANCODE TO KEYCODE
0012F1  2  AD CE 10             LDA     KBD_STATUS      ; GET STATUS
0012F4  2  29 01                AND     #KBD_EXT        ; EXTENDED BIT SET?
0012F6  2  F0 20                BEQ     KBD_DEC5C       ; NOPE, MOVE ON
0012F8  2               
0012F8  2               ; PERFORM EXTENDED KEY MAPPING
0012F8  2  AE C9 10             LDX     KBD_SCANCODE    ; GET SCANCODE
0012FB  2               KBD_DEC5A:
0012FB  2  BD 2D 16             LDA     KBD_MAPEXT,X    ; GET FIRST BYTE OF PAIR FROM EXT MAP TABLE
0012FE  2  E8                   INX
0012FF  2  C9 00                CMP     #$00            ; END OF TABLE?
001301  2  F0 09                BEQ     :+              ; UNKNOWN OR BOGUS, START OVER
001303  2  CD C9 10             CMP     KBD_SCANCODE    ; DOES MATCH BYTE EQUAL SCANCODE?
001306  2  F0 07                BEQ     KBD_DEC5B       ; YES! JUMP OUT
001308  2  E8                   INX                     ; BUMP TO START OF NEXT PAIR
001309  2  4C FB 12             JMP     KBD_DEC5A       ; LOOP TO CHECK NEXT TABLE ENTRY
00130C  2               :
00130C  2  4C 62 14             JMP     KBD_DECNEW
00130F  2               KBD_DEC5B:
00130F  2  BD 2D 16             LDA     KBD_MAPEXT,X    ; GET THE KEYCODE VIA MAPPING TABLE
001312  2  8D CA 10             STA     KBD_KEYCODE     ; SAVE IT
001315  2  4C 3A 13             JMP     KBD_DEC6
001318  2               
001318  2               KBD_DEC5C:                      ; PERFORM REGULAR KEY (NOT EXTENDED) KEY MAPPING
001318  2  AD C9 10             LDA     KBD_SCANCODE    ; GET THE SCANCODE
00131B  2  C9 85                CMP     #KBD_MAPSIZ     ; COMPARE TO SIZE OF TABLE
00131D  2  F0 02                BEQ     :+
00131F  2  B0 19                BCS     KBD_DEC6        ; PAST END, SKIP OVER LOOKUP
001321  2               :
001321  2               ; SETUP POINTER TO MAPPING TABLE BASED ON SHIFTED OR UNSHIFTED STATE
001321  2  AD CB 10             LDA     KBD_STATE       ; GET STATE
001324  2  29 01                AND     #KBD_SHIFT      ; SHIFT ACTIVE?
001326  2  F0 09                BEQ     KBD_DEC5D       ; NON-SHIFTED, MOVE ON
001328  2               
001328  2  AE C9 10             LDX     KBD_SCANCODE    ; GET THE SCANCODE
00132B  2  BD A8 15             LDA     KBD_MAPSHIFT,X  ; GET SHIFTED
00132E  2  4C 37 13             JMP     :+
001331  2               KBD_DEC5D:
001331  2  AE C9 10             LDX     KBD_SCANCODE    ; GET THE SCANCODE
001334  2  BD 23 15             LDA     KBD_MAPSTD,X    ; GET STANDARD
001337  2               :
001337  2  8D CA 10             STA     KBD_KEYCODE     ; SAVE KEYCODE
00133A  2               
00133A  2               KBD_DEC6:                       ; HANDLE MODIFIER KEYS
00133A  2  AD CA 10             LDA     KBD_KEYCODE     ; MAKE SURE WE HAVE KEYCODE
00133D  2  C9 B8                CMP     #$B8            ; END OF MODIFIER KEYS
00133F  2  B0 5F                BCS     KBD_DEC7         ; BYPASS MODIFIER KEY CHECKING
001341  2  C9 B0                CMP     #$B0            ; START OF MODIFIER KEYS
001343  2  90 5B                BCC     KBD_DEC7        ; BYPASS MODIFIER KEY CHECKING
001345  2  A2 04                LDX     #4              ; LOOP COUNTER TO LOOP THRU 4 MODIFIER BITS
001347  2  38                   SEC
001348  2  E9 AF                SBC     #$AF            ; SETUP A TO DECREMENT THROUGH MODIFIER VALUES
00134A  2  8D C8 10             STA     TMPKEY
00134D  2  A9 00                LDA     #$00            ; SETUP A TO ROATE THROUGH MODIFIER STATE BITS
00134F  2  38                   SEC                     ; SET CARRY FOR ROTATE
001350  2               
001350  2               KBD_DEC6A:
001350  2  2A                   ROL     A               ; SHIFT TO NEXT MODIFIER STATE BIT
001351  2  CE C8 10             DEC     TMPKEY          ; L-MODIFIER?
001354  2  F0 0B                BEQ     KBD_DEC6B       ; YES, HANDLE L-MODIFIER MAKE/BREAK
001356  2  CE C8 10             DEC     TMPKEY          ; R-MODIFIER?
001359  2  F0 0B                BEQ     KBD_DEC6C       ; YES, HANDLE R-MODIFIER MAKE/BREAK
00135B  2  CA                   DEX
00135C  2  D0 F2                BNE     KBD_DEC6A       ; LOOP THRU 4 MODIFIER BITS
00135E  2  4C A0 13             JMP     KBD_DEC7        ; FAILSAFE, SHOULD NEVER GET HERE!
001361  2               
001361  2               KBD_DEC6B:
001361  2  A2 00                LDX     #0              ; POINT TO LEFT STATE BYTE
001363  2  4C 68 13             JMP     KBD_DEC6D       ; CONTINUE
001366  2               
001366  2               KBD_DEC6C:
001366  2  A2 01                LDX     #1              ; POINT TO RIGHT STATE BYTE
001368  2               
001368  2               KBD_DEC6D:                      ; BRANCH BASED ON WHETHER THIS IS A MAKE OR BREAK EVENT
001368  2  8D C8 10             STA     TMPKEY
00136B  2  AD CE 10             LDA     KBD_STATUS      ; GET STATUS FLAGS
00136E  2  29 02                AND     #KBD_BREAK      ; BREAK EVENT?
001370  2  F0 03                BEQ     KBD_DEC6E       ; NO, HANDLE A MODIFIER KEY MAKE EVENT
001372  2  4C 81 13             JMP     KBD_DEC6F       ; YES, HANDLE A MODIFIER BREAK EVENT
001375  2               
001375  2               KBD_DEC6E:                      ; HANDLE STATE KEY MAKE EVENT
001375  2  AD C8 10             LDA     TMPKEY
001378  2  1D CC 10             ORA     KBD_LSTATE,X    ; OR IN THE BIT TO SET
00137B  2  9D CC 10             STA     KBD_LSTATE,X    ; SAVE THE RESULT
00137E  2  4C 8F 13             JMP     KBD_DEC6G       ; CONTINUE
001381  2               
001381  2               KBD_DEC6F:                      ; HANDLE STATE KEY BREAK EVENT
001381  2  AD C8 10             LDA     TMPKEY
001384  2  49 FF                EOR     #$FF            ; FLIP ALL BITS TO SETUP FOR A CLEAR OPERATION
001386  2  3D CC 10             AND     KBD_LSTATE,X    ; AND IN THE FLIPPED BITS TO CLEAR DESIRED BIT
001389  2  9D CC 10             STA     KBD_LSTATE,X    ; SAVE THE RESULT
00138C  2  4C 8F 13             JMP     KBD_DEC6G       ; CONTINUE
00138F  2               
00138F  2               KBD_DEC6G:                      ; COALESCE L/R STATE FLAGS
00138F  2  AD CB 10             LDA     KBD_STATE       ; GET EXISTING STATE BITS
001392  2  29 F0                AND     #$F0            ; GET RID OF OLD MODIFIER BITS
001394  2  0D CC 10             ORA     KBD_LSTATE      ; MERGE IN LEFT STATE BITS
001397  2  0D CD 10             ORA     KBD_RSTATE      ; MERGE IN RIGHT STATE BITS
00139A  2  8D CB 10             STA     KBD_STATE       ; SAVE IT
00139D  2               :
00139D  2  4C 62 14             JMP     KBD_DECNEW      ; DONE WITH CURRENT KEYSTROKE
0013A0  2               
0013A0  2               KBD_DEC7:                       ; COMPLETE PROCESSING OF EXTENDED AND KEY BREAK EVENTS
0013A0  2  AD CE 10             LDA     KBD_STATUS      ; GET CURRENT STATUS FLAGS
0013A3  2  29 02                AND     #KBD_BREAK      ; IS THIS A KEY BREAK EVENT?
0013A5  2  D0 F6                BNE     :-              ; PROCESS NEXT KEY
0013A7  2               
0013A7  2               KBD_DEC8:                       ; HANDLE TOGGLE KEYS
0013A7  2  AD CA 10             LDA     KBD_KEYCODE     ; GET THE CURRENT KEYCODE INTO A
0013AA  2  A0 40                LDY     #KBD_CAPSLCK    ; SETUP E WITH CAPS LOCK STATE BIT
0013AC  2  C9 BC                CMP     #$BC            ; IS THIS THE CAPS LOCK KEY?
0013AE  2  F0 0F                BEQ     KBD_DEC8A       ; YES, GO TO BIT SET ROUTINE
0013B0  2  A0 20                LDY     #KBD_NUMLCK     ; SETUP E WITH NUM LOCK STATE BIT
0013B2  2  C9 BD                CMP     #$BD            ; IS THIS THE NUM LOCK KEY?
0013B4  2  F0 09                BEQ     KBD_DEC8A       ; YES, GO TO BIT SET ROUTINE
0013B6  2  A0 10                LDY     #KBD_SCRLCK     ; SETUP E WITH SCROLL LOCK STATE BIT
0013B8  2  C9 BE                CMP     #$BE            ; IS THIS THE SCROLL LOCK KEY?
0013BA  2  F0 03                BEQ     KBD_DEC8A       ; YES, GO TO BIT SET ROUTINE
0013BC  2  4C CC 13             JMP     KBD_DEC9        ; NOT A TOGGLE KEY, CONTINUE
0013BF  2               
0013BF  2               KBD_DEC8A:                      ; RECORD THE TOGGLE
0013BF  2  98                   TYA
0013C0  2  4D CB 10             EOR     KBD_STATE       ; SET THE TOGGLE KEY BIT FROM ABOVE
0013C3  2  8D CB 10             STA     KBD_STATE       ; SAVE IT
0013C6  2  20 34 12             JSR     KBD_SETLEDS     ; UPDATE LED LIGHTS ON KBD
0013C9  2  4C 62 14             JMP     KBD_DECNEW      ; RESTART DECODER FOR A NEW KEY
0013CC  2               
0013CC  2               KBD_DEC9:                       ; ADJUST KEYCODE FOR CONTROL MODIFIER
0013CC  2  AD CB 10             LDA     KBD_STATE       ; GET THE CURRENT STATE BITS
0013CF  2  29 02                AND     #KBD_CTRL       ; CHECK THE CONTROL BIT
0013D1  2  F0 1E                BEQ     KBD_DEC10       ; CONTROL KEY NOT PRESSED, MOVE ON
0013D3  2  AD CA 10             LDA     KBD_KEYCODE     ; GET CURRENT KEYCODE IN A
0013D6  2  C9 61                CMP     #'a'            ; COMPARE TO LOWERCASE A
0013D8  2  90 08                BCC     KBD_DEC9A       ; BELOW IT, BYPASS
0013DA  2  C9 7A                CMP     #'z'            ; COMPARE TO LOWERCASE Z+1
0013DC  2  F0 02                BEQ     :+
0013DE  2  B0 02                BCS     KBD_DEC9A       ; ABOVE IT, BYPASS
0013E0  2               :
0013E0  2  29 DF                AND     #$DF            ; KEYCODE IN LOWERCASE A-Z RANGE CLEAR BIT 5 TO MAKE IT UPPERCASE
0013E2  2               KBD_DEC9A:
0013E2  2  C9 40                CMP     #'@'            ; COMPARE TO @
0013E4  2  90 0B                BCC     KBD_DEC10       ; BELOW IT, BYPASS
0013E6  2  C9 5F                CMP     #'_'            ; COMPARE TO _+1
0013E8  2  F0 02                BEQ     :+
0013EA  2  B0 05                BCS     KBD_DEC10       ; ABOVE IT, BYPASS
0013EC  2               :
0013EC  2  29 BF                AND     #$BF            ; CONVERT TO CONTROL VALUE BY CLEARING BIT 6
0013EE  2  8D CA 10             STA     KBD_KEYCODE     ; UPDATE KEYCODE TO CONTROL VALUE
0013F1  2               
0013F1  2               KBD_DEC10:                      ; ADJUST KEYCODE FOR CAPS LOCK
0013F1  2  AD CB 10             LDA     KBD_STATE       ; LOAD THE STATE FLAGS
0013F4  2  29 40                AND     #KBD_CAPSLCK    ; CHECK CAPS LOCK
0013F6  2  F0 25                BEQ     KBD_DEC11       ; CAPS LOCK NOT ACTIVE, MOVE ON
0013F8  2  AD CA 10             LDA     KBD_KEYCODE     ; GET THE CURRENT KEYCODE VALUE
0013FB  2  C9 61                CMP     #'a'            ; COMPARE TO LOWERCASE A
0013FD  2  90 09                BCC     KBD_DEC10A      ; BELOW IT, BYPASS
0013FF  2  C9 7A                CMP     #'z'            ; COMPARE TO LOWERCASE Z+1
001401  2  F0 02                BEQ     :+
001403  2  B0 03                BCS     KBD_DEC10A      ; ABOVE IT, BYPASS
001405  2               :
001405  2  4C 15 14             JMP     KBD_DEC10B      ; IN RANGE LOWERCASE A-Z, GO TO CASE SWAPPING LOGIC
001408  2               KBD_DEC10A:
001408  2  C9 41                CMP     #'A'            ; COMPARE TO UPPERCASE A
00140A  2  90 11                BCC     KBD_DEC11       ; BELOW IT, BYPASS
00140C  2  C9 5A                CMP     #'Z'            ; COMPARE TO UPPERCASE Z+1
00140E  2  F0 02                BEQ     :+
001410  2  B0 0B                BCS     KBD_DEC11       ; ABOVE IT, BYPASS
001412  2               :
001412  2  4C 15 14             JMP     KBD_DEC10B      ; IN RANGE UPPERCASE A-Z, GO TO CASE SWAPPING LOGIC
001415  2               KBD_DEC10B:
001415  2  AD CA 10             LDA     KBD_KEYCODE     ; GET THE CURRENT KEYCODE
001418  2  49 20                EOR     #$20            ; FLIP BIT 5 TO SWAP UPPER/LOWER CASE
00141A  2  8D CA 10             STA     KBD_KEYCODE     ; SAVE IT
00141D  2               
00141D  2               KBD_DEC11:                      ; HANDLE NUM PAD KEYS
00141D  2  AD CB 10             LDA     KBD_STATE       ; GET THE CURRENT STATE FLAGS
001420  2  29 7F                AND     #NOT_KBD_NUMPAD ; ASSUME NOT A NUMPAD KEY, CLEAR THE NUMPAD BIT
001422  2  8D CB 10             STA     KBD_STATE       ; SAVE IT
001425  2               
001425  2  AD CA 10             LDA     KBD_KEYCODE     ; GET THE CURRENT KEYCODE
001428  2  29 E0                AND     #%11100000      ; ISOLATE TOP 3 BITS
00142A  2  C9 C0                CMP     #%11000000      ; IS IN NUMPAD RANGE?
00142C  2  D0 21                BNE     KBD_DEC12       ; NOPE, GET OUT
00142E  2               
00142E  2  AD CB 10             LDA     KBD_STATE       ; LOAD THE CURRENT STATE FLAGS
001431  2  09 80                ORA     #KBD_NUMPAD     ; TURN ON THE NUMPAD BIT
001433  2  8D CB 10             STA     KBD_STATE       ; SAVE IT
001436  2               
001436  2  29 20                AND     #KBD_NUMLCK     ; IS NUM LOCK BIT SET?
001438  2  F0 08                BEQ     KBD_DEC11A      ; NO, SKIP NUMLOCK PROCESSING
00143A  2  AD CA 10             LDA     KBD_KEYCODE     ; GET THE KEYCODE
00143D  2  49 10                EOR     #$10            ; FLIP VALUES FOR NUMLOCK
00143F  2  8D CA 10             STA     KBD_KEYCODE     ; SAVE IT
001442  2               
001442  2               KBD_DEC11A:                     ; APPLY NUMPAD MAPPING
001442  2  AD CA 10             LDA     KBD_KEYCODE     ; GET THE CURRENT KEYCODE
001445  2  38                   SEC
001446  2  E9 C0                SBC     #$C0            ; KEYCODES START AT $C0
001448  2  AA                   TAX
001449  2  BD 5B 16             LDA     KBD_MAPNUMPAD,X ; GET IT IN A
00144C  2  8D CA 10             STA     KBD_KEYCODE     ; SAVE IT
00144F  2               
00144F  2               KBD_DEC12:                      ; DETECT UNKNOWN/INVALID KEYCODES
00144F  2  AD CA 10             LDA     KBD_KEYCODE     ; GET THE FINAL KEYCODE
001452  2  C9 FF                CMP     #$FF            ; IS IT $FF (UNKNOWN/INVALID)
001454  2  F0 0C                BEQ     KBD_DECNEW      ; IF SO, JUST RESTART THE ENGINE
001456  2               
001456  2               KBD_DEC13:                      ; DONE - RECORD RESULTS
001456  2  AD CE 10             LDA     KBD_STATUS      ; GET CURRENT STATUS
001459  2  09 80                ORA     #KBD_KEYRDY     ; SET KEY READY BIT
00145B  2  8D CE 10             STA     KBD_STATUS      ; SAVE IT
00145E  2  A9 00                LDA     #$00            ; A=0
001460  2  18                   CLC                     ; SIGNAL SUCCESS WITH A=1, CARRY CLEAR
001461  2  60                   RTS
