0011E1  2  AD FF E3             LDA     KBD_ST          ; GET STATUS PORT
0011E4  2  29 01                AND     #$01            ; ISOLATE INPUT PENDING BIT
0011E6  2  C9 00                CMP     #$00
0011E8  2  D0 15                BNE     KBD_GETDATA1    ; READY, GET DATA
0011EA  2  20 6A 14             JSR     DELAY           ; WAIT A BIT
0011ED  2  CA                   DEX
0011EE  2  E0 00                CPX     #$00
0011F0  2  D0 EF                BNE     KBD_GETDATA0    ; LOOP UNTIL COUNTER EXHAUSTED
0011F2  2  88                   DEY
0011F3  2  C0 00                CPY     #$00
0011F5  2  D0 EA                BNE     KBD_GETDATA0    ; LOOP UNTIL COUNTER EXHAUSTED
0011F7  2  68                   PLA
0011F8  2  A8                   TAY
0011F9  2  68                   PLA
0011FA  2  AA                   TAX
0011FB  2  A9 00                LDA     #$00
