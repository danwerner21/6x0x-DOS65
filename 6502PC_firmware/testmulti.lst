001084  1               ;__WRSTR_______________________________________________________
001084  1               ;
001084  1               ; OUTPUT THE STRING POINTED TO BY OUTSTR TO THE SCREEN
001084  1               ;
001084  1               ;______________________________________________________________
001084  1               WRSTR:
001084  1  A0 00                LDY     #$00            ; LOAD $00 INTO Y
001086  1               OUTSTRLP:
001086  1  B1 41                LDA     (STRPTR),Y      ; LOAD NEXT CHAR FROM STRING INTO ACC
001088  1  C9 00                CMP     #$00            ; IS NULL?
00108A  1  F0 0C                BEQ     ENDOUTSTR       ; YES, END PRINT OUT
00108C  1  20 6C 10             JSR     DFT_CONSOLE_OUT ; PRINT CHAR IN ACC
00108F  1  E6 41                INC     STRPTR
001091  1  D0 F3                BNE     OUTSTRLP
001093  1  E6 42                INC     STRPTR+1
001095  1  4C 86 10             JMP     OUTSTRLP        ; DO NEXT CHAR
001098  1               ENDOUTSTR:
001098  1  60                   RTS                     ; RETURN
001099  1               
001099  1               PRINT_BYTE:
001099  1  8E BE 10             STX     SAVX            ; save X
00109C  1  20 A9 10             JSR     ASCTWO          ; get hex chars for byte in X (lower) and A (upper)
00109F  1  20 6C 10             JSR     DFT_CONSOLE_OUT ; output upper nybble
0010A2  1  8A                   TXA                     ; transfer lower to A
0010A3  1  AE BE 10             LDX     SAVX            ; restore X
0010A6  1  4C 6C 10             JMP     DFT_CONSOLE_OUT ; output lower nybble
0010A9  1               ASCTWO:
0010A9  1  48                   PHA                     ; save byte
0010AA  1  20 B3 10             JSR     ASCII           ; do low nybble
0010AD  1  AA                   TAX                     ; save in X
0010AE  1  68                   PLA                     ; restore byte
0010AF  1  4A                   LSR     A               ; shift upper nybble down
0010B0  1  4A                   LSR     A
0010B1  1  4A                   LSR     A
0010B2  1  4A                   LSR     A
0010B3  1               ; convert low nybble in A to hex digit
0010B3  1               ASCII:
0010B3  1  29 0F                AND     #$0F            ; clear upper nibble
0010B5  1  C9 0A                CMP     #$0A            ; if less than A, skip next step
0010B7  1  90 02                BCC     ASC1
0010B9  1  69 06                ADC     #6              ; skip ascii chars between 9 and A
0010BB  1               ASC1:
0010BB  1  69 30                ADC     #$30            ; add ascii char 0 to value
0010BD  1  60                   RTS
