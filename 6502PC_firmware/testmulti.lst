0011BF  2  C9 00                CMP     #$00
0011C1  2  F0 10                BEQ     KBD_PUTDATA1    ; EMPTY, GO TO WRITE
0011C3  2  20 6A 14             JSR     DELAY           ; WAIT A BIT
0011C6  2  CA                   DEX
0011C7  2  E0 00                CPX     #$00
