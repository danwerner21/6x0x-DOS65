001131  2  F0 32                BEQ     :+              ; IF SO, CONTINUE
001133  2  A9 A6                LDA     #<MIOMESSAGE3   ;
001135  2  85 41                STA     STRPTR          ;
001137  2  A9 14                LDA     #>MIOMESSAGE3   ;
001139  2  85 42                STA     STRPTR+1        ;
00113B  2  20 84 10             JSR     WRSTR
00113E  2  20 79 10             JSR     LFCR            ; AND CRLF
