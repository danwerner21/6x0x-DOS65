00F770  2  28                   PLP                     ; restore processor status
00F771  2  60                   RTS
00F772  2               
00F772  2               ; load the input value and fall through to print it
00F772  2               PRINUM:
00F772  2  48                   PHA                     ; save accumulator
00F773  2  A5 C1                LDA     TMP0            ; copy input low byte to work buffer
00F775  2  85 D2                STA     U0AA0+2
00F777  2  A5 C2                LDA     TMP0+1          ; copy input high byte to work buffer
00F779  2  85 D1                STA     U0AA0+1
