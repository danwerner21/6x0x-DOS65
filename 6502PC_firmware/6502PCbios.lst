000000r 2               ;________________________________________________________________________________________________________________________________
000000r 2               ;
000000r 2               ;	DOS/65 base addresses and definitions
000000r 2               ;
000000r 2               ;  DWERNER 04/24/2022 	Initial
000000r 2               ;________________________________________________________________________________________________________________________________
000000r 2               
000000r 2               ;base addresses and definitions
000000r 2               btejmp          = $0100         ; warm boot jump
000000r 2               pemjmp          = $0103         ; jump to pem
000000r 2               iostat          = $0106         ; i/o status
000000r 2               dflfcb          = $0107         ; default fcb
000000r 2               dflbuf          = $0128         ; default buffer
000000r 2               memmovr         = $0200         ; 0200-02ff subr to move data from ram/rom disks
000000r 2               MD_PAGERA       = $0200         ; PAGE DRIVER ADDRESS
000000r 2               IO              = $0300         ; 0300-03FF Memory mapped IO
000000r 2               MPCL_ROM        = $037C         ; ROM MAPPER
000000r 2               MPCL_RAM        = $0378         ; RAM MAPPER
000000r 2               hstbuf          = $0400         ; 0400-05ff host buffer
000000r 2               ;
000000r 2               ; DRIVER WORKING STORAGE
000000r 2               ;
000000r 2               
000000r 2               
000000r 2               DSKY_BUF        = $0600         ; Eight Bytes DSKY display buffer
000000r 2               DSKY_BUFLEN     = 8             ;
000000r 2               DSKY_HEXBUF     = $0608         ; Four Bytes DSKY hex buffer
000000r 2               DSKY_HEXBUFLEN  = 4             ;
000000r 2               sektrk          = $060C         ; seek track number
000000r 2               seksec          = $060E         ; seek sector number
000000r 2               debcyll         = $0610         ; DEBLOCKED CYLINDER LSB
000000r 2               debcylm         = $0611         ; DEBLOCKED CYLINDER MSB
000000r 2               debsehd         = $0612         ; DEBLOCKED SECTOR AND HEAD (HS)
000000r 2               sekdsk          = $0616         ; seek disk number
000000r 2               dskcfg          = $0617         ; 16 bytes disk configuration table
000000r 2               DSKUNIT         = $0628         ; seek disk number
000000r 2               slicetmp        = $0631         ; (word)
000000r 2               STACKA          = $0635
000000r 2               nmsstr          = $0636
000000r 2               FLRETRY         = $0637         ;
000000r 2               FLRETRY1        = $0638         ;
000000r 2               ST0             = $0639         ;
000000r 2               FLERR           = $063A         ;
000000r 2               FCMD            = $063B         ;
000000r 2               PPIDEINDEX      = $063C
000000r 2               currentDrive    = $063D
000000r 2               DSKY_X_STORAGE  = $063E
000000r 2               DSKY_Y_STORAGE  = $063F
000000r 2               DSKY_TEMP_VAL   = $0640
000000r 2               DSKY_PPIX_VAL   = $0641
000000r 2               FLOPPY_DETCT    = $0642
000000r 2               DSKY_PRESENT    = $0643
000000r 2               Cdebcyll        = $0644         ; DEBLOCKED CYLINDER LSB (IN CACHE)
000000r 2               Cdebcylm        = $0645         ; DEBLOCKED CYLINDER MSB (IN CACHE)
000000r 2               Cdebsehd        = $0646         ; DEBLOCKED SECTOR AND HEAD (HS)  (IN CACHE)
000000r 2               
000000r 2               
000000r 2               tea             = $800          ;tea start
000000r 2               
000000r 2               ;zero page for setup
000000r 2               addinp          = $02           ;initialized to a,y
000000r 2               bufadd          = $04           ;buffer address
000000r 2               alcpnt          = $06           ;allocation map pointer
000000r 2               chkpnt          = $08           ;checksum map pointer
000000r 2               numvar          = 8             ;eight bytes
000000r 2               
000000r 2               
000000r 2               msgptr          = chkpnt+2      ;message pointer
000000r 2               movptr          = msgptr        ;and move pointer
000000r 2               dcbloc          = msgptr+2      ;pointer to dcb
000000r 2               
000000r 2               dcbpc           = $2C           ;pointer to DCB table
000000r 2               dskcfpc         = $2E           ;pointer to disk configuration table
000000r 2               cmdlnp          = $30           ;pointer to command line buffer
000000r 2               farfunct        = $32           ; function to call in driver area
000000r 2               farpointer      = $33           ;
000000r 2               IRQVECTOR       = $35           ; VECTOR FOR USER IRQ RTN
000000r 2               NMIVECTOR       = $37           ; VECTOR FOR USER NMI RTN
000000r 2               CONSOLE         = $3A
000000r 2               TEMPWORD        = $3B           ;
000000r 2               TEMPWORD1       = $3D           ;
000000r 2               TEMPWORD2       = $3F           ;
000000r 2               STRPTR          = $41           ;
000000r 2               DSKYMODE        = $43           ; DSKY MODE (0=NONE, 1=DSKY, 2=DSKY NG
000000r 2               
000000r 2               
000000r 2               DO_FARCALL      = $FFF0
000000r 2               
000000r 2               ;page zero and system ram assignments
000000r 2               DEST            = $EC           ;pointer for OutMsg
000000r 2               SRC             = $EE           ;pointer for OutMsg
000000r 2               OUTMSG_W        = $F0           ;pointer for OutMsg
000000r 2               dmaadr          = $f4           ;pointer for r/w
000000r 2               
000000r 2               
000000r 2               ;pem constants on entry to write
000000r 2               wrall           = 0             ;write to allocated
000000r 2               wrdir           = 1             ;write to directory
000000r 2               wrual           = 2             ;write to unallocated
000000r 2               
000000r 2               ;fixed parameters
000000r 2               lf              = $a            ;linefeeed
000000r 2               cr              = $d            ;return
000000r 2               eof             = $1a           ;end of file
000000r 2               null            = 0             ;null
000000r 2               ctlc            = 3             ;abort
000000r 2               ctle            = 5             ;physical cr lf
000000r 2               ctli            = 9             ;tab character
000000r 2               ctlp            = $10           ;toggle printer
000000r 2               ctlr            = $12           ;repeat line
000000r 2               ctls            = $13           ;freeze
000000r 2               ctlx            = $18           ;cancel
000000r 2               semico          = $3b           ;semicolon
000000r 2               delete          = $08           ;delete character
000000r 2               numcmd          = 36            ;number commands
000000r 2               DEFDRV          = 0             ; SET TO DEFAULT DRIVE LETTER
000000r 2               
000000r 2               
000000r 2                       .IFDEF  RBC6X0X
000000r 2                       .DEFINE COMSUFFIX "COM"
000000r 2                       .ENDIF
000000r 2               
000000r 2                       .IFDEF  NHYODYNE
000000r 2                       .DEFINE COMSUFFIX "CO6"
000000r 2                       .ENDIF
000000r 2               
000000r 2               DEBUG           = 0
000000r 2               BANKED_DRIVER_DISPATCHER=$8800
000000r 2               
000000r 1               
000000r 1               STARTOS         = $B800
000000r 1               
000000r 1                       .SEGMENT "TROM"
000000r 1                       .ORG    $F000
00F000  1               
00F000  1               
00F000  1               ;__COLD_START___________________________________________________
00F000  1               ;
00F000  1               ; PERFORM SYSTEM COLD INIT
00F000  1               ;
00F000  1               ;_______________________________________________________________
00F000  1               COLD_START:
00F000  1  78                   SEI                     ; DISABLE INTERRUPTS
00F001  1  D8                   CLD                     ;  VERIFY DECIMAL MODE IS OFF
00F002  1  A2 FF                LDX     #$FF            ;
00F004  1  9A                   TXS                     ; CLEAR STACK
00F005  1  8A                   TXA
00F006  1               ;;;
00F006  1               
00F006  1  A9 2F                LDA     #<IRQROUTINE
00F008  1  85 35                STA     IRQVECTOR
00F00A  1  85 37                STA     NMIVECTOR
00F00C  1  A9 F0                LDA     #>IRQROUTINE
00F00E  1  85 36                STA     IRQVECTOR+1
00F010  1  85 38                STA     NMIVECTOR+1
00F012  1               ;
00F012  1               ;       INIT PAGING
00F012  1  20 12 FA             JSR     INITPAGES       ;
00F015  1               
00F015  1               ;	INIT HARDWARE
00F015  1  20 D0 F9             JSR     SERIALINIT
00F018  1               
00F018  1  20 50 FA             JSR     PAGE_ENTER
00F01B  1  A9 7E                LDA     #<STARTUP       ; OUTPUT STARTUP STRING
00F01D  1  85 41                STA     STRPTR          ;
00F01F  1  A9 FA                LDA     #>STARTUP       ;
00F021  1  85 42                STA     STRPTR+1        ;
00F023  1  20 61 FA             JSR     OUTSTR          ;
00F026  1  20 48 FA             JSR     PAGE_EXIT
00F029  1               
00F029  1               
00F029  1  A9 00                LDA     #$00            ;
00F02B  1  8D 00 03             STA     INBUFFER        ; MAKE SURE INPUT BUFFER IS EMPTY
00F02E  1               
00F02E  1  00                   BRK                     ; PERFORM BRK (START MONITOR)
00F02F  1               
00F02F  1               ;__IRQROUTINE___________________________________________________
00F02F  1               ;
00F02F  1               ; HANDLE INTERRUPT PROCESING
00F02F  1               ;
00F02F  1               ;_______________________________________________________________
00F02F  1               IRQROUTINE:
00F02F  1  58                   CLI                     ; ENABLE INTERRUPTS AGAIN
00F030  1  40                   RTI
00F031  1               
00F031  1               ;__INTERRUPT____________________________________________________
00F031  1               ;
00F031  1               ; HANDLE IRQ INTERRUPT AND DETERMINE IF IT IS A BRK OR AN IRQ
00F031  1               ;
00F031  1               ;_______________________________________________________________
00F031  1               INTERRUPT:
00F031  1  78                   SEI                     ; DISABLE INTERRUPTS
00F032  1  85 3B                STA     TEMPWORD
00F034  1  68                   PLA                     ; GET STATUS REGISTER
00F035  1  48                   PHA                     ; SAVE STATUS REGISTER
00F036  1  29 10                AND     #$10            ; MASK BRK
00F038  1  D0 03                BNE     BRKCMD          ; BRK CMD
00F03A  1  6C 35 00             JMP     (IRQVECTOR)     ; LET USER ROUTINE HAVE IT (USER DEFINED IRQ)
00F03D  1               BRKCMD:
00F03D  1  A5 3B                LDA     TEMPWORD
00F03F  1  48                   PHA
00F040  1  8A                   TXA
00F041  1  48                   PHA
00F042  1  98                   TYA
00F043  1  48                   PHA
00F044  1  4C 4A F0             JMP     BRKROUTINE      ; MONITOR BRK ROUTINE
00F047  1               
00F047  1               NINTERRUPT:
00F047  1  6C 37 00             JMP     (NMIVECTOR)     ; LET USER ROUTINE HAVE IT (USER DEFINED NMI)
00F04A  1               
00F04A  1                       .INCLUDE "../supermon/supermon.asm"
00F04A  2               ; ********************************
00F04A  2               ; * SUPERMON+ 64 JIM BUTTERFIELD *
00F04A  2               ; * V1.2   AUGUST 20 1985        *
00F04A  2               ; ********************************
00F04A  2               
00F04A  2               ; Reformatted and annotated in late 2016/early 2017 by J.B. Langston.
00F04A  2               ; Modified for Nhyodyne/Retrobrew 3/12/2023 D. Werner
00F04A  2               ;
00F04A  2               ; Mr. Butterfield . . you inspired many of us, thank you.
00F04A  2               ;
00F04A  2               ; -----------------------------------------------------------------------------
00F04A  2               ; temporary pointers
00F04A  2               TMP0            = $C1           ; used to return input, often holds end address
00F04A  2               TMP2            = $C3           ; usually holds start address
00F04A  2               
00F04A  2               ; these 7 locations are used to store the registers when
00F04A  2               ; entering the monitor and restore them when exiting.
00F04A  2               
00F04A  2               PCH             = $B0           ; program counter high byte
00F04A  2               PCL             = $B1           ; program counter low byte
00F04A  2               SR              = $B2           ; status register
00F04A  2               ACC             = $B3           ; accumulator
00F04A  2               XR              = $B4           ; X register
00F04A  2               YR              = $B5           ; Y register
00F04A  2               SP              = $B6           ; stack pointer
00F04A  2               STORE           = $B7           ; 2-byte temp storage
00F04A  2               CHRPNT          = $B9           ; current position in input buffer
00F04A  2               SAVY            = $BA           ; temp storage, often to save Y register
00F04A  2               U9F             = $BB           ; index into assembler work buffer
00F04A  2               CKSM            = $BC           ; S19 loader checksum store
00F04A  2               LOADADR         = $BD           ; S19 load address
00F04A  2               LOADWRK         = $BF           ; S19 load work
00F04A  2               
00F04A  2               ;-----------------------------------------------------------------------------
00F04A  2               ; variables
00F04A  2               ACMD            = $C5           ; addressing command
00F04A  2               LENGTH          = $C6           ; length of operand
00F04A  2               MNEMW           = $C7           ; 3 letter mnemonic buffer
00F04A  2               SAVX            = $CA           ; 1 byte temp storage, often to save X register
00F04A  2               OPCODE          = $CB           ; current opcode for assembler/disassembler
00F04A  2               UPFLG           = $CC           ; flag: count up (bit 7 clear) or down (bit 7 set)
00F04A  2               DIGCNT          = $CB           ; digit count
00F04A  2               INDIG           = $CC           ; numeric value of single digit
00F04A  2               NUMBIT          = $CD           ; numeric base of input
00F04A  2               STASH           = $CE           ; 2-byte temp storage
00F04A  2               U0AA0           = $D0           ; 10 byte work buffer
00F04A  2               U0AAE           = $D0+10        ; end of 10 byte work buffer
00F04A  2               STAGE           = $DA           ; 30 byte staging buffer for filename, search, etc.
00F04A  2               ESTAGE          = $DA+30        ; end of 30 byte staging buffer for filename, search, etc.
00F04A  2               INBUFF          = $0400
00F04A  2               CHROUT          = IOF_OUTCH
00F04A  2               
00F04A  2               
00F04A  2               ; -----------------------------------------------------------------------------
00F04A  2               ; BRK handler
00F04A  2               BRKROUTINE:
00F04A  2               BREAK:
00F04A  2  A2 05                LDX     #$05            ; pull registers off the stack
00F04C  2               BSTACK:
00F04C  2  68                   PLA                     ; order: Y,X,A,SR,PCL,PCH
00F04D  2  95 B0                STA     PCH,X           ; store in memory
00F04F  2  CA                   DEX
00F050  2  10 FA                BPL     BSTACK
00F052  2  D8                   CLD                     ; disable bcd mode
00F053  2  BA                   TSX                     ; store stack pointer in memory
00F054  2  86 B6                STX     SP
00F056  2  58                   CLI                     ; enable interupts
00F057  2               
00F057  2               ; -----------------------------------------------------------------------------
00F057  2               ; display registers [R]
00F057  2               DSPLYR:
00F057  2  A0 00                LDY     #MSG2-MSGBAS    ; display headers
00F059  2  20 D4 F7             JSR     SNDCLR
00F05C  2  A9 3B                LDA     #$3B            ; prefix registers with "; " to allow editing
00F05E  2  20 E0 F9             JSR     CHROUT
00F061  2  A9 20                LDA     #$20
00F063  2  20 E0 F9             JSR     CHROUT
00F066  2  A5 B0                LDA     PCH             ; print 2-byte program counter
00F068  2  20 6E F6             JSR     WRTWO
00F06B  2  A0 01                LDY     #1              ; start 1 byte after PC high byte
00F06D  2               DISJ:
00F06D  2  B9 B0 00             LDA     PCH,Y           ; loop through rest of the registers
00F070  2  20 4E F6             JSR     WRBYTE          ; print 1-byte register value
00F073  2  C8                   INY
00F074  2  C0 07                CPY     #7              ; there are a total of 5 registers to print
00F076  2  90 F5                BCC     DISJ
00F078  2               
00F078  2               ; -----------------------------------------------------------------------------
00F078  2               ; main loop
00F078  2               STRT:
00F078  2  20 59 F6             JSR     CRLF            ; new line
00F07B  2  A2 00                LDX     #0              ; point at start of input buffer
00F07D  2  86 B9                STX     CHRPNT
00F07F  2               SMOVE:
00F07F  2  20 FB F9             JSR     IOF_CONINW      ; CHRIN kernal call to input a character
00F082  2               
00F082  2  C9 08                CMP     #$08            ; IS BACKSPACE?
00F084  2  D0 1A                BNE     :+              ; NO, SKUP BACKSPACE RTN
00F086  2  E0 00                CPX     #$00            ; IS INDEX =0 ?
00F088  2  F0 F5                BEQ     SMOVE           ; YES, SKIP BACKSPACE
00F08A  2  20 E0 F9             JSR     IOF_OUTCH       ; BACK UP CURSOR
00F08D  2  A9 20                LDA     #$20
00F08F  2  20 E0 F9             JSR     IOF_OUTCH       ; SPACE ON SCREEN
00F092  2  A9 08                LDA     #$08
00F094  2  20 E0 F9             JSR     IOF_OUTCH       ; BACK UP CURSOR
00F097  2               
00F097  2  A9 00                LDA     #0
00F099  2  9D 00 04             STA     INBUFF,X        ; store in input buffer
00F09C  2  CA                   DEX
00F09D  2  4C 7F F0             JMP     SMOVE
00F0A0  2               :
00F0A0  2  20 E0 F9             JSR     IOF_OUTCH       ; OUTPUT CHAR TO SCREEN
00F0A3  2               
00F0A3  2  9D 00 04             STA     INBUFF,X        ; store in input buffer
00F0A6  2  E8                   INX
00F0A7  2  E0 00                CPX     #00             ; error if buffer is full
00F0A9  2  F0 1C                BEQ     ERROR
00F0AB  2  C9 0D                CMP     #$0D            ; keep reading until CR
00F0AD  2  D0 D0                BNE     SMOVE
00F0AF  2  A9 00                LDA     #0              ; null-terminate input buffer
00F0B1  2  9D FF 03             STA     INBUFF-1,X      ; (replacing the CR)
00F0B4  2               ST1:
00F0B4  2  20 93 F6             JSR     GETCHR          ; get a character from the buffer
00F0B7  2  F0 BF                BEQ     STRT            ; start over if buffer is empty
00F0B9  2  C9 20                CMP     #$20            ; skip leading spaces
00F0BB  2  F0 F7                BEQ     ST1
00F0BD  2               S0:
00F0BD  2  A2 13                LDX     #KEYTOP-KEYW    ; loop through valid command characters
00F0BF  2               S1:
00F0BF  2  DD 97 F9             CMP     KEYW,X          ; see if input character matches
00F0C2  2  F0 0B                BEQ     S2              ; command matched, dispatch it
00F0C4  2  CA                   DEX                     ; no match, check next command
00F0C5  2  10 F8                BPL     S1              ; keep trying until we've checked them all
00F0C7  2                                               ; then fall through to error handler
00F0C7  2               
00F0C7  2               ; -----------------------------------------------------------------------------
00F0C7  2               ; handle error
00F0C7  2               ERROR:
00F0C7  2  A0 1E                LDY     #MSG3-MSGBAS    ; display "?" to indicate error and go to new line
00F0C9  2  20 E7 F7             JSR     SNDMSG
00F0CC  2  4C 78 F0             JMP     STRT            ; back to main loop
00F0CF  2               
00F0CF  2               ; -----------------------------------------------------------------------------
00F0CF  2               ; dispatch command
00F0CF  2               S2:
00F0CF  2  E0 0E                CPX     #$0E            ; next 4 commands are base conversions
00F0D1  2  B0 0E                BCS     CNVLNK          ;   which are handled by the same subroutine
00F0D3  2  8A                   TXA                     ; remaining commands dispatch through vector table
00F0D4  2  0A                   ASL     A               ; multiply index of command by 2
00F0D5  2  AA                   TAX                     ;   since table contains 2-byte addresses
00F0D6  2  BD AB F9             LDA     KADDR+1,X       ; push address from vector table onto stack
00F0D9  2  48                   PHA                     ;   so that the RTS from GETPAR will jump there
00F0DA  2  BD AA F9             LDA     KADDR,X
00F0DD  2  48                   PHA
00F0DE  2  4C 8D F5             JMP     GETPAR          ; get the first parameter for the command
00F0E1  2               CNVLNK:
00F0E1  2  4C 28 F7             JMP     CONVRT          ; handle base conversion
00F0E4  2               
00F0E4  2               
00F0E4  2               ; -----------------------------------------------------------------------------
00F0E4  2               ; display memory [M]
00F0E4  2               DSPLYM:
00F0E4  2  B0 08                BCS     DSPM11          ; start from previous end addr if no address given
00F0E6  2  20 A9 F6             JSR     COPY12          ; save start address in TMP2
00F0E9  2  20 8D F5             JSR     GETPAR          ; get end address in TMP0
00F0EC  2  90 06                BCC     DSMNEW          ; did user specify one?
00F0EE  2               DSPM11:
00F0EE  2  A9 0B                LDA     #$0B            ; if not, show 12 lines by default
00F0F0  2  85 C1                STA     TMP0
00F0F2  2  D0 0E                BNE     DSPBYT          ; always true, but BNE uses 1 byte less than JMP
00F0F4  2               DSMNEW:
00F0F4  2  20 B2 F6             JSR     SUB12           ; end addr given, calc bytes between start and end
00F0F7  2  90 1E                BCC     MERROR          ; error if start is after end
00F0F9  2  A2 03                LDX     #3              ; divide by 8 (shift right 3 times)
00F0FB  2               DSPM01:
00F0FB  2  46 C2                LSR     TMP0+1
00F0FD  2  66 C1                ROR     TMP0
00F0FF  2  CA                   DEX
00F100  2  D0 F9                BNE     DSPM01
00F102  2               DSPBYT:
00F102  2  20 F5 F7             JSR     STOP            ; check for stop key
00F105  2  F0 0D                BEQ     DSPMX           ; exit early if pressed
00F107  2  20 7B F1             JSR     DISPMEM         ; display 1 line containing 8 bytes
00F10A  2  A9 08                LDA     #8              ; increase start address by 8 bytes
00F10C  2  20 E2 F6             JSR     BUMPAD2
00F10F  2  20 C0 F6             JSR     SUBA1           ; decrement line counter
00F112  2  B0 EE                BCS     DSPBYT          ; show another line until it's < 0
00F114  2               DSPMX:
00F114  2  4C 78 F0             JMP     STRT            ; back to main loop
00F117  2               MERROR:
00F117  2  4C C7 F0             JMP     ERROR           ; handle error
00F11A  2               
00F11A  2               ; -----------------------------------------------------------------------------
00F11A  2               ; alter registers [;]
00F11A  2               ALTR:
00F11A  2  20 FA F6             JSR     COPY1P          ; store first parameter in PC
00F11D  2  A0 00                LDY     #0              ; init counter
00F11F  2               ALTR1:
00F11F  2  20 8D F5             JSR     GETPAR          ; get value for next register
00F122  2  B0 0A                BCS     ALTRX           ; exit early if no more values given
00F124  2  A5 C1                LDA     TMP0            ; store in memory, offset from SR
00F126  2  99 B2 00             STA     SR,Y            ; these locations will be transferred to the
00F129  2  C8                   INY                     ;   actual registers before exiting the monitor
00F12A  2  C0 05                CPY     #$05            ; have we updated all 5 yet?
00F12C  2  90 F1                BCC     ALTR1           ; if not, get next
00F12E  2               ALTRX:
00F12E  2  4C 78 F0             JMP     STRT            ; back to main loop
00F131  2               
00F131  2               ; -----------------------------------------------------------------------------
00F131  2               ; alter memory [>]
00F131  2               ALTM:
00F131  2  B0 13                BCS     ALTMX           ; exit if no parameter provided
00F133  2  20 A9 F6             JSR     COPY12          ; copy parameter to start address
00F136  2  A0 00                LDY     #0
00F138  2               ALTM1:
00F138  2  20 8D F5             JSR     GETPAR          ; get value for next byte of memory
00F13B  2  B0 09                BCS     ALTMX           ; if none given, exit early
00F13D  2  A5 C1                LDA     TMP0            ; poke value into memory at start address + Y
00F13F  2  91 C3                STA     (TMP2),Y
00F141  2  C8                   INY                     ; next byte
00F142  2  C0 08                CPY     #8              ; have we read 8 bytes yet?
00F144  2  90 F2                BCC     ALTM1           ; if not, read the next one
00F146  2               ALTMX:
00F146  2  A9 91                LDA     #$91            ; move cursor up
00F148  2  20 E0 F9             JSR     CHROUT
00F14B  2  20 7B F1             JSR     DISPMEM         ; re-display line to make ascii match hex
00F14E  2  4C 78 F0             JMP     STRT            ; back to main loop
00F151  2               
00F151  2               ; -----------------------------------------------------------------------------
00F151  2               ; goto (run) [G]
00F151  2               GOTO:
00F151  2  A6 B6                LDX     SP              ; load stack pointer from memory
00F153  2  9A                   TXS                     ; save in SP register
00F154  2               GOTO2:
00F154  2  20 FA F6             JSR     COPY1P          ; copy provided address to PC
00F157  2  78                   SEI                     ; disable interrupts
00F158  2  A5 B0                LDA     PCH             ; push PC high byte on stack
00F15A  2  48                   PHA
00F15B  2  A5 B1                LDA     PCL             ; push PC low byte on stack
00F15D  2  48                   PHA
00F15E  2  A5 B2                LDA     SR              ; push status byte on stack
00F160  2  48                   PHA
00F161  2  A5 B3                LDA     ACC             ; load accumulator from memory
00F163  2  A6 B4                LDX     XR              ; load X from memory
00F165  2  A4 B5                LDY     YR              ; load Y from memory
00F167  2  40                   RTI                     ; return from interrupt (pops PC and SR)
00F168  2               
00F168  2               ; jump to subroutine [J]
00F168  2               JSUB:
00F168  2  A6 B6                LDX     SP              ; load stack pointer from memory
00F16A  2  9A                   TXS                     ; save value in SP register
00F16B  2  20 54 F1             JSR     GOTO2           ; same as goto command
00F16E  2  84 B5                STY     YR              ; save Y to memory
00F170  2  86 B4                STX     XR              ; save X to memory
00F172  2  85 B3                STA     ACC             ; save accumulator to memory
00F174  2  08                   PHP                     ; push processor status on stack
00F175  2  68                   PLA                     ; pull processor status into A
00F176  2  85 B2                STA     SR              ; save processor status to memory
00F178  2  4C 57 F0             JMP     DSPLYR          ; display registers
00F17B  2               
00F17B  2               ; -----------------------------------------------------------------------------
00F17B  2               ; display 8 bytes of memory
00F17B  2               DISPMEM:
00F17B  2  20 59 F6             JSR     CRLF            ; new line
00F17E  2  A9 3E                LDA     #'>'            ; prefix > so memory can be edited in place
00F180  2  20 E0 F9             JSR     CHROUT
00F183  2  20 44 F6             JSR     SHOWAD          ; show address of first byte on line
00F186  2  A0 00                LDY     #0
00F188  2  F0 03                BEQ     DMEMGO          ; SHOWAD already printed a space after the address
00F18A  2               DMEMLP:
00F18A  2  20 51 F6             JSR     SPACE           ; print space between bytes
00F18D  2               DMEMGO:
00F18D  2  B1 C3                LDA     (TMP2),Y        ; load byte from start address + Y
00F18F  2  20 6E F6             JSR     WRTWO           ; output hex digits for byte
00F192  2  C8                   INY                     ; next byte
00F193  2  C0 08                CPY     #8              ; have we output 8 bytes yet?
00F195  2  90 F3                BCC     DMEMLP          ; if not, output next byte
00F197  2  A0 26                LDY     #MSG5-MSGBAS    ; if so, output : and turn on reverse video
00F199  2  20 E7 F7             JSR     SNDMSG          ;   before displaying ascii representation
00F19C  2  A0 00                LDY     #0              ; back to first byte in line
00F19E  2               DCHAR:
00F19E  2  B1 C3                LDA     (TMP2),Y        ; load byte at start address + Y
00F1A0  2  C9 20                CMP     #$20            ; is it a printable character (>= $20)?
00F1A2  2  90 04                BCC     DDOT            ; if NOT printable, output '.'
00F1A4  2  C9 80                CMP     #$80
00F1A6  2  90 02                BCC     DCHROK          ; if printable, output character
00F1A8  2               DDOT:
00F1A8  2  A9 2E                LDA     #$2E            ; if not, output '.' instaed
00F1AA  2               DCHROK:
00F1AA  2  20 E0 F9             JSR     CHROUT
00F1AD  2  C8                   INY                     ; next byte
00F1AE  2  C0 08                CPY     #8              ; have we output 8 bytes yet?
00F1B0  2  90 EC                BCC     DCHAR           ; if not, output next byte
00F1B2  2  60                   RTS
00F1B3  2               
00F1B3  2               ; -----------------------------------------------------------------------------
00F1B3  2               ; compare memory [C]
00F1B3  2               COMPAR:
00F1B3  2  A9 00                LDA     #0              ; bit 7 clear signals compare
00F1B5  2  2C                   .BYTE   $2C             ; absolute BIT opcode consumes next word (LDA #$80)
00F1B6  2               
00F1B6  2               ; transfer memory [T]
00F1B6  2               TRANS:
00F1B6  2  A9 80                LDA     #$80            ; bit 7 set signals transfer
00F1B8  2  85 BA                STA     SAVY            ; save compare/transfer flag in SAVY
00F1BA  2  A9 00                LDA     #0              ; assume we're counting up (bit 7 clear)
00F1BC  2  85 CC                STA     UPFLG           ; save direction flag
00F1BE  2  20 05 F7             JSR     GETDIF          ; get two addresses and calculate difference
00F1C1  2                                               ;   TMP2 = source start
00F1C1  2                                               ;   STASH = source end
00F1C1  2                                               ;   STORE = length
00F1C1  2  B0 05                BCS     TERROR          ; carry set indicates error
00F1C3  2  20 8D F5             JSR     GETPAR          ; get destination address in TMP0
00F1C6  2  90 03                BCC     TOKAY           ; carry set indicates error
00F1C8  2               TERROR:
00F1C8  2  4C C7 F0             JMP     ERROR           ; handle error
00F1CB  2               TOKAY:
00F1CB  2  24 BA                BIT     SAVY            ; transfer or compare?
00F1CD  2  10 23                BPL     COMPAR1         ; high bit clear indicates compare
00F1CF  2  A5 C3                LDA     TMP2            ; if it's a transfer, we must take steps
00F1D1  2  C5 C1                CMP     TMP0            ;   to avoid overwriting the source bytes before
00F1D3  2  A5 C4                LDA     TMP2+1          ;   they have been transferred
00F1D5  2  E5 C2                SBC     TMP0+1          ; compare source (TMP2) to destination (TMP0)
00F1D7  2  B0 19                BCS     COMPAR1         ; and count up if source is before than desitnation
00F1D9  2  A5 B7                LDA     STORE           ; otherwise, start at end and count down...
00F1DB  2  65 C1                ADC     TMP0            ; add length (STORE) to desintation (TMP0)
00F1DD  2  85 C1                STA     TMP0            ; to calculate end of destination
00F1DF  2  A5 B8                LDA     STORE+1
00F1E1  2  65 C2                ADC     TMP0+1
00F1E3  2  85 C2                STA     TMP0+1
00F1E5  2  A2 01                LDX     #1              ; change source pointer from beginning to end
00F1E7  2               TDOWN:
00F1E7  2  B5 CE                LDA     STASH,X         ; TMP2 = source end (STASH)
00F1E9  2  95 C3                STA     TMP2,X
00F1EB  2  CA                   DEX
00F1EC  2  10 F9                BPL     TDOWN
00F1EE  2  A9 80                LDA     #$80            ; high bit set in UPFLG means count down
00F1F0  2  85 CC                STA     UPFLG
00F1F2  2               COMPAR1:
00F1F2  2  20 59 F6             JSR     CRLF            ; new line
00F1F5  2  A0 00                LDY     #0              ; no offset from pointer
00F1F7  2               TCLOOP:
00F1F7  2  20 F5 F7             JSR     STOP            ; check for stop key
00F1FA  2  F0 2F                BEQ     TEXIT           ; exit if pressed
00F1FC  2  B1 C3                LDA     (TMP2),Y        ; load byte from source
00F1FE  2  24 BA                BIT     SAVY            ; transfer or compare?
00F200  2  10 02                BPL     COMPAR2         ; skip store if comparing
00F202  2  91 C1                STA     (TMP0),Y        ; otherwise, store in destination
00F204  2               COMPAR2:
00F204  2  D1 C1                CMP     (TMP0),Y        ; compare to destination
00F206  2  F0 03                BEQ     TMVAD           ; don't show address if equal
00F208  2  20 44 F6             JSR     SHOWAD          ; show address
00F20B  2               TMVAD:
00F20B  2  24 CC                BIT     UPFLG           ; counting up or down?
00F20D  2  30 0B                BMI     TDECAD          ; high bit set means we're counting down
00F20F  2  E6 C1                INC     TMP0            ; increment destination low byte
00F211  2  D0 10                BNE     TINCOK
00F213  2  E6 C2                INC     TMP0+1          ; carry to high byte if necessary
00F215  2  D0 0C                BNE     TINCOK
00F217  2  4C C7 F0             JMP     ERROR           ; error if high byte overflowed
00F21A  2               TDECAD:
00F21A  2  20 C0 F6             JSR     SUBA1           ; decrement destination (TMP0)
00F21D  2  20 EC F6             JSR     SUB21           ; decrement source (TMP2)
00F220  2  4C 26 F2             JMP     TMOR
00F223  2               TINCOK:
00F223  2  20 E0 F6             JSR     ADDA2           ; increment source (TMP2)
00F226  2               TMOR:
00F226  2  20 D2 F6             JSR     SUB13           ; decrement length
00F229  2  B0 CC                BCS     TCLOOP          ; loop until length is 0
00F22B  2               TEXIT:
00F22B  2  4C 78 F0             JMP     STRT            ; back to main loop
00F22E  2               
00F22E  2               ; -----------------------------------------------------------------------------
00F22E  2               ; hunt memory [H]
00F22E  2               HUNT:
00F22E  2  20 05 F7             JSR     GETDIF          ; get start (TMP2) and end (TMP0) of haystack
00F231  2  B0 57                BCS     HERROR          ; carry indicates error
00F233  2  A0 00                LDY     #0
00F235  2  20 93 F6             JSR     GETCHR          ; get a single character
00F238  2  C9 27                CMP     #39             ; is it a single quote?
00F23A  2  D0 16                BNE     NOSTRH          ; if not, input needle as hex bytes
00F23C  2  20 93 F6             JSR     GETCHR          ; if so, input needle as string
00F23F  2  C9 00                CMP     #0
00F241  2  F0 47                BEQ     HERROR          ; error if needle isn't at least one byte
00F243  2               HPAR:
00F243  2  99 DA 00             STA     STAGE,Y         ; save char in staging area
00F246  2  C8                   INY
00F247  2  20 93 F6             JSR     GETCHR          ; get another char
00F24A  2  F0 18                BEQ     HTGO            ; if it's null start searching
00F24C  2  C0 1E                CPY     #ESTAGE-STAGE   ; have we filled up the needle staging area?
00F24E  2  D0 F3                BNE     HPAR            ; if not, get another character
00F250  2  F0 12                BEQ     HTGO            ; if so, start searching
00F252  2               NOSTRH:
00F252  2  20 8B F5             JSR     RDPAR           ; read hex bytes if string not indicated
00F255  2               HLP:
00F255  2  A5 C1                LDA     TMP0            ; save last read byte in staging area
00F257  2  99 DA 00             STA     STAGE,Y
00F25A  2  C8                   INY                     ; get another hex byte
00F25B  2  20 8D F5             JSR     GETPAR
00F25E  2  B0 04                BCS     HTGO            ; if there is none, start searching
00F260  2  C0 1E                CPY     #ESTAGE-STAGE   ; have we filled up the needle staging area?
00F262  2  D0 F1                BNE     HLP             ; if not, get another byte
00F264  2               HTGO:
00F264  2  84 BA                STY     SAVY            ; save length of needle
00F266  2  20 59 F6             JSR     CRLF            ; new line
00F269  2               HSCAN:
00F269  2  A0 00                LDY     #0
00F26B  2               HLP3:
00F26B  2  B1 C3                LDA     (TMP2),Y        ; get first byte in haystack
00F26D  2  D9 DA 00             CMP     STAGE,Y         ; compare it to first byte of needle
00F270  2  D0 08                BNE     HNOFT           ; if it doesn't match, we haven't found anything
00F272  2  C8                   INY                     ; if it does, check the next byte
00F273  2  C4 BA                CPY     SAVY            ; have we reached the end of the needle?
00F275  2  D0 F4                BNE     HLP3            ; if not, keep comparing bytes
00F277  2  20 44 F6             JSR     SHOWAD          ; match found, show address
00F27A  2               HNOFT:
00F27A  2  20 F5 F7             JSR     STOP            ; no match, check for stop key
00F27D  2  F0 08                BEQ     HEXIT           ; exit prematurely if pressed
00F27F  2  20 E0 F6             JSR     ADDA2           ; increment haystack pointer
00F282  2  20 D2 F6             JSR     SUB13           ; decrement haystack length
00F285  2  B0 E2                BCS     HSCAN           ; still more haystack? keep searching
00F287  2               HEXIT:
00F287  2  4C 78 F0             JMP     STRT            ; back to main loop
00F28A  2               HERROR:
00F28A  2  4C C7 F0             JMP     ERROR           ; handle error
00F28D  2               
00F28D  2               
00F28D  2               ; -----------------------------------------------------------------------------
00F28D  2               ; fill memory [F]
00F28D  2               FILL:
00F28D  2  20 05 F7             JSR     GETDIF          ; start in TMP2, end in STASH, length in STORE
00F290  2  B0 20                BCS     FERROR          ; carry set indicates error
00F292  2  20 8D F5             JSR     GETPAR          ; get value to fill in TMP0
00F295  2  B0 1B                BCS     FERROR          ; carry set indicates error
00F297  2  20 93 F6             JSR     GETCHR          ; any more characters triggers an error
00F29A  2  D0 16                BNE     FERROR
00F29C  2  A0 00                LDY     #0              ; no offset
00F29E  2               FILLP:
00F29E  2  A5 C1                LDA     TMP0            ; load value to fill in accumulator
00F2A0  2  91 C3                STA     (TMP2),Y        ; store fill value in current address
00F2A2  2  20 F5 F7             JSR     STOP            ; check for stop key
00F2A5  2  F0 08                BEQ     FSTART          ; if pressed, back to main loop
00F2A7  2  20 E0 F6             JSR     ADDA2           ; increment address
00F2AA  2  20 D2 F6             JSR     SUB13           ; decrement length
00F2AD  2  B0 EF                BCS     FILLP           ; keep going until length reaches 0
00F2AF  2               FSTART:
00F2AF  2  4C 78 F0             JMP     STRT            ; back to main loop
00F2B2  2               FERROR:
00F2B2  2  4C C7 F0             JMP     ERROR           ; handle error
00F2B5  2               ; -----------------------------------------------------------------------------
00F2B5  2               ; Boot System [B]
00F2B5  2               BOOT:
00F2B5  2  B0 21                BCS     BOOTX           ; exit with error if no parameter given
00F2B7  2  A5 C1                LDA     TMP0
00F2B9  2  29 0F                AND     #$0F
00F2BB  2  8D 28 06             STA     DSKUNIT
00F2BE  2  A9 00                LDA     #$00
00F2C0  2  8D 10 06             STA     debcyll         ;
00F2C3  2  8D 11 06             STA     debcylm         ;
00F2C6  2  8D 12 06             STA     debsehd         ;
00F2C9  2  20 8D F5             JSR     GETPAR          ; get value for next byte of memory
00F2CC  2  B0 0A                BCS     BOOTX           ; exit with error if no parameter given
00F2CE  2  A5 C1                LDA     TMP0
00F2D0  2  85 32                STA     farfunct
00F2D2  2  20 F0 FF             JSR     DO_FARCALL
00F2D5  2  4C 00 04             JMP     hstbuf
00F2D8  2               BOOTX:
00F2D8  2  4C C7 F0             JMP     ERROR           ; back to main loop
00F2DB  2               
00F2DB  2               
00F2DB  2               
00F2DB  2               ; -----------------------------------------------------------------------------
00F2DB  2               ; assemble [A.]
00F2DB  2               ; read in mnemonic
00F2DB  2               ASTART:
00F2DB  2  4C 78 F0             JMP     STRT            ; back to main loop
00F2DE  2               ASSEM:
00F2DE  2  B0 31                BCS     AERROR          ; error if no address given
00F2E0  2  20 A9 F6             JSR     COPY12          ; copy address to TMP2
00F2E3  2               AGET1:
00F2E3  2  A2 00                LDX     #0
00F2E5  2  86 D1                STX     U0AA0+1         ; clear byte that mnemonic gets shifted into
00F2E7  2  86 CB                STX     DIGCNT          ; clear digit count
00F2E9  2               AGET2:
00F2E9  2  20 93 F6             JSR     GETCHR          ; get a char
00F2EC  2  D0 04                BNE     ALMOR           ; proceed if the character isn't null
00F2EE  2  E0 00                CPX     #0              ; it's null, have read a mnemonic yet?
00F2F0  2  F0 E9                BEQ     ASTART          ; if not, silently go back to main loop
00F2F2  2               ALMOR:
00F2F2  2  C9 20                CMP     #$20            ; skip leading spaces
00F2F4  2  F0 ED                BEQ     AGET1
00F2F6  2  95 C7                STA     MNEMW,X         ; put character in mnemonic buffer
00F2F8  2  E8                   INX
00F2F9  2  E0 03                CPX     #3              ; have we read 3 characters yet?
00F2FB  2  D0 EC                BNE     AGET2           ; if not, get next character
00F2FD  2               
00F2FD  2               ; compress mnemonic into two bytes
00F2FD  2               ASQEEZ:
00F2FD  2  CA                   DEX                     ; move to previous char
00F2FE  2  30 14                BMI     AOPRND          ; if we're done with mnemonic, look for operand
00F300  2  B5 C7                LDA     MNEMW,X         ; get current character
00F302  2  38                   SEC                     ; pack 3-letter mnemonic into 2 bytes (15 bits)
00F303  2  E9 3F                SBC     #$3F            ; subtract $3F from ascii code so A-Z = 2 to 27
00F305  2  A0 05                LDY     #$05            ; letters now fit in 5 bits; shift them out
00F307  2               ASHIFT:
00F307  2  4A                   LSR     A               ;   into the first two bytes of the inst buffer
00F308  2  66 D1                ROR     U0AA0+1         ; catch the low bit from accumulator in right byte
00F30A  2  66 D0                ROR     U0AA0           ; catch the low bit from right byte in left byte
00F30C  2  88                   DEY                     ; count down bits
00F30D  2  D0 F8                BNE     ASHIFT          ; keep looping until we reach zero
00F30F  2  F0 EC                BEQ     ASQEEZ          ; unconditional branch to handle next char
00F311  2               AERROR:
00F311  2  4C C7 F0             JMP     ERROR           ; handle error
00F314  2               
00F314  2               ; parse operand
00F314  2               AOPRND:
00F314  2  A2 02                LDX     #2              ; mnemonic is in first two bytes so start at third
00F316  2               ASCAN:
00F316  2  A5 CB                LDA     DIGCNT          ; did we find address digits last time?
00F318  2  D0 28                BNE     AFORM1          ; if so, look for mode chars
00F31A  2  20 B2 F5             JSR     RDVAL           ; otherwise, look for an address
00F31D  2  F0 21                BEQ     AFORM0          ; we didn't find an address, look for characters
00F31F  2  B0 F0                BCS     AERROR          ; carry flag indicates error
00F321  2  A9 24                LDA     #'$'
00F323  2  95 D0                STA     U0AA0,X         ; prefix addresses with $
00F325  2  E8                   INX                     ; next position in buffer
00F326  2  A0 04                LDY     #4              ; non-zero page addresses are 4 hex digits
00F328  2  A5 CD                LDA     NUMBIT          ; check numeric base in which address was given
00F32A  2  C9 08                CMP     #8              ; for addresses given in octal or binary
00F32C  2  90 04                BCC     AADDR           ;   use only the high byte to determine page
00F32E  2  C4 CB                CPY     DIGCNT          ; for decimal or hex, force non-zero page addressing
00F330  2  F0 06                BEQ     AFILL0          ;   if address was given with four digits or more
00F332  2               AADDR:
00F332  2  A5 C2                LDA     TMP0+1          ; check whether high byte of address is zero
00F334  2  D0 02                BNE     AFILL0          ; non-zero high byte means we're not in zero page
00F336  2  A0 02                LDY     #2              ; if it's in zero page, addr is 2 hex digits
00F338  2               AFILL0:
00F338  2  A9 30                LDA     #$30            ; use 0 as placeholder for each hex digit in addr
00F33A  2               AFIL0L:
00F33A  2  95 D0                STA     U0AA0,X         ; put placeholder in assembly buffer
00F33C  2  E8                   INX                     ; move to next byte in buffer
00F33D  2  88                   DEY                     ; decrement number of remaining digits
00F33E  2  D0 FA                BNE     AFIL0L          ; loop until all digits have been placed
00F340  2               AFORM0:
00F340  2  C6 B9                DEC     CHRPNT          ; non-numeric input; back 1 char to see what it was
00F342  2               AFORM1:
00F342  2  20 93 F6             JSR     GETCHR          ; get next character
00F345  2  F0 0D                BEQ     AESCAN          ; if there is none, we're finished scanning
00F347  2  C9 20                CMP     #$20            ; skip spaces
00F349  2  F0 CB                BEQ     ASCAN
00F34B  2  95 D0                STA     U0AA0,X         ; store character in assembly buffer
00F34D  2  E8                   INX                     ; move to next byte in buffer
00F34E  2  E0 0A                CPX     #U0AAE-U0AA0    ; is instruction buffer full?
00F350  2  90 C4                BCC     ASCAN           ; if not, keep scanning
00F352  2  B0 BD                BCS     AERROR          ; error if buffer is full
00F354  2               
00F354  2               ; find matching opcode
00F354  2               AESCAN:
00F354  2  86 B7                STX     STORE           ; save number of bytes in assembly buffer
00F356  2  A2 00                LDX     #0              ; start at opcode $00 and check every one until
00F358  2  86 CB                STX     OPCODE          ;   we find one that matches our criteria
00F35A  2               ATRYOP:
00F35A  2  A2 00                LDX     #0
00F35C  2  86 BB                STX     U9F             ; reset index into work buffer
00F35E  2  A5 CB                LDA     OPCODE
00F360  2  20 23 F5             JSR     INSTXX          ; look up instruction format for current opcode
00F363  2  A6 C5                LDX     ACMD            ; save addressing command for later
00F365  2  86 B8                STX     STORE+1
00F367  2  AA                   TAX                     ; use current opcode as index
00F368  2  BD 53 F9             LDA     MNEMR,X         ; check right byte of compressed mnemonic
00F36B  2  20 59 F4             JSR     CHEKOP
00F36E  2  BD 13 F9             LDA     MNEML,X         ; check left byte of compressed mnemonic
00F371  2  20 59 F4             JSR     CHEKOP
00F374  2  A2 06                LDX     #6              ; 6 possible characters to check against operand
00F376  2               TRYIT:
00F376  2  E0 03                CPX     #3              ; are we on character 3?
00F378  2  D0 12                BNE     TRYMOD          ; if not, check operand characters
00F37A  2  A4 C6                LDY     LENGTH          ; otherwise, check number of bytes in operand
00F37C  2  F0 0E                BEQ     TRYMOD          ; if zero, check operand characters
00F37E  2               TRYAD:
00F37E  2  A5 C5                LDA     ACMD            ; otherwise, look for an address
00F380  2  C9 E8                CMP     #$E8            ; special case for relative addressing mode
00F382  2                                               ;   since it's specified with 4 digits in assembly
00F382  2                                               ;   but encoded with only 1 byte in object code
00F382  2  A9 30                LDA     #$30            ; '0' is the digit placeholder we're looking for
00F384  2  B0 1D                BCS     TRY4B           ; ACMD >= $E8 indicates relative addressing
00F386  2  20 56 F4             JSR     CHEK2B          ; ACMD < $E8 indicates normal addressing
00F389  2  88                   DEY                     ; consume byte
00F38A  2  D0 F2                BNE     TRYAD           ; check for 2 more digits if not zero-page
00F38C  2               TRYMOD:
00F38C  2  06 C5                ASL     ACMD            ; shift a bit out of the addressing command
00F38E  2  90 0E                BCC     UB4DF           ; if it's zero, skip checking current character
00F390  2  BD 06 F9             LDA     CHAR1-1,X
00F393  2  20 59 F4             JSR     CHEKOP          ; otherwise first character against operand
00F396  2  BD 0C F9             LDA     CHAR2-1,X       ; get second character to check
00F399  2  F0 03                BEQ     UB4DF           ; if it's zero, skip checking it
00F39B  2  20 59 F4             JSR     CHEKOP          ; otherwise check it against hte operand
00F39E  2               UB4DF:
00F39E  2  CA                   DEX                     ; move to next character
00F39F  2  D0 D5                BNE     TRYIT           ; repeat tests
00F3A1  2  F0 06                BEQ     TRYBRAN
00F3A3  2               TRY4B:
00F3A3  2  20 56 F4             JSR     CHEK2B          ; check for 4 digit address placeholder
00F3A6  2  20 56 F4             JSR     CHEK2B          ;   by checking for 2 digits twice
00F3A9  2               TRYBRAN:
00F3A9  2  A5 B7                LDA     STORE           ; get number of bytes in assembly buffer
00F3AB  2  C5 BB                CMP     U9F             ; more bytes left to check?
00F3AD  2  F0 03                BEQ     ABRAN           ; if not, we've found a match; build instruction
00F3AF  2  4C 63 F4             JMP     BUMPOP          ; if so, this opcode doesn't match; try the next
00F3B2  2               
00F3B2  2               ; convert branches to relative address
00F3B2  2               ABRAN:
00F3B2  2  A4 C6                LDY     LENGTH          ; get number of bytes in operand
00F3B4  2  F0 33                BEQ     A1BYTE          ; if none, just output the opcode
00F3B6  2  A5 B8                LDA     STORE+1         ; otherwise check the address format
00F3B8  2  C9 9D                CMP     #$9D            ; is it a relative branch?
00F3BA  2  D0 25                BNE     OBJPUT          ; if not, skip relative branch calculation
00F3BC  2  A5 C1                LDA     TMP0            ; calculate the difference between the current
00F3BE  2  E5 C3                SBC     TMP2            ;   address and the branch target (low byte)
00F3C0  2  AA                   TAX                     ; save it in X
00F3C1  2  A5 C2                LDA     TMP0+1          ; borrow from the high byte if necessary
00F3C3  2  E5 C4                SBC     TMP2+1
00F3C5  2  90 0B                BCC     ABBACK          ; if result is negative, we're branching back
00F3C7  2  F0 03                BEQ     :++             ; high bytes must be equal when branching forward
00F3C9  2               :
00F3C9  2  4C 53 F4             JMP     SERROR
00F3CC  2               :
00F3CC  2  E0 82                CPX     #$82            ; difference between low bytes must be < 130
00F3CE  2  B0 F9                BCS     :--             ; error if the address is too far away
00F3D0  2  90 08                BCC     ABRANX
00F3D2  2               ABBACK:
00F3D2  2  A8                   TAY                     ; when branching backward high byte of target must
00F3D3  2  C8                   INY                     ;   be 1 less than high byte of current address
00F3D4  2  D0 7D                BNE     SERROR          ; if not, it's too far away
00F3D6  2  E0 82                CPX     #$82            ; difference between low bytes must be < 130
00F3D8  2  90 79                BCC     SERROR          ; if not, it's too far away
00F3DA  2               ABRANX:
00F3DA  2  CA                   DEX                     ; adjust branch target relative to the
00F3DB  2  CA                   DEX                     ;   instruction following this one
00F3DC  2  8A                   TXA
00F3DD  2  A4 C6                LDY     LENGTH          ; load length of operand
00F3DF  2  D0 03                BNE     OBJP2           ; don't use the absolute address
00F3E1  2               
00F3E1  2               ; assemble machine code
00F3E1  2               OBJPUT:
00F3E1  2  B9 C0 00             LDA     TMP0-1,Y        ; get the operand
00F3E4  2               OBJP2:
00F3E4  2  91 C3                STA     (TMP2),Y        ; store it after the opcode
00F3E6  2  88                   DEY
00F3E7  2  D0 F8                BNE     OBJPUT          ; copy the other byte of operand if there is one
00F3E9  2               A1BYTE:
00F3E9  2  A5 CB                LDA     OPCODE          ; put opcode into instruction
00F3EB  2  91 C3                STA     (TMP2),Y
00F3ED  2  A9 0D                LDA     #$0D            ; cr
00F3EF  2  20 E0 F9             JSR     CHROUT
00F3F2  2  A0 2E                LDY     #MSG7-MSGBAS    ; "A " prefix
00F3F4  2  20 D4 F7             JSR     SNDCLR          ; clear line
00F3F7  2  A9 41                LDA     #'A'
00F3F9  2  20 E0 F9             JSR     CHROUT
00F3FC  2  A9 20                LDA     #' '
00F3FE  2  20 E0 F9             JSR     CHROUT
00F401  2  20 AB F4             JSR     DISLIN          ; disassemble the instruction we just assembled
00F404  2  E6 C6                INC     LENGTH          ; instruction length = operand length + 1 byte
00F406  2  A5 C6                LDA     LENGTH          ;   for the opcode
00F408  2  20 E2 F6             JSR     BUMPAD2         ; increment address by length of instruction
00F40B  2                                               ; setup for the next assemble command
00F40B  2  20 59 F6             JSR     CRLF
00F40E  2  A9 41                LDA     #'A'            ; stuff keyboard buffer with next assemble command:
00F410  2  8D 00 04             STA     INBUFF
00F413  2  20 E0 F9             JSR     IOF_OUTCH
00F416  2  A9 20                LDA     #' '            ;   after the previously assembled instruction
00F418  2  8D 01 04             STA     INBUFF+1
00F41B  2  20 E0 F9             JSR     IOF_OUTCH
00F41E  2  A5 C4                LDA     TMP2+1          ; convert high byte of next address to hex
00F420  2  20 7C F6             JSR     ASCTWO
00F423  2  8D 02 04             STA     INBUFF+2        ; put it in the keyboard buffer
00F426  2  20 E0 F9             JSR     IOF_OUTCH
00F429  2  8E 03 04             STX     INBUFF+3
00F42C  2  8A                   TXA
00F42D  2  20 E0 F9             JSR     IOF_OUTCH
00F430  2  A5 C3                LDA     TMP2            ; convert low byte of next address to hex
00F432  2  20 7C F6             JSR     ASCTWO
00F435  2  8D 04 04             STA     INBUFF+4        ; put it in the keyboard buffer
00F438  2  20 E0 F9             JSR     IOF_OUTCH
00F43B  2  8E 05 04             STX     INBUFF+5
00F43E  2  8A                   TXA
00F43F  2  20 E0 F9             JSR     IOF_OUTCH
00F442  2  A9 20                LDA     #' '            ;   after the previously assembled instruction
00F444  2  8D 06 04             STA     INBUFF+6
00F447  2  20 E0 F9             JSR     IOF_OUTCH
00F44A  2  A2 07                LDX     #7              ; set number of chars in keyboard buffer
00F44C  2  A9 00                LDA     #$00
00F44E  2  85 B9                STA     CHRPNT
00F450  2  4C 7F F0             JMP     SMOVE           ; back to main loop
00F453  2               SERROR:
00F453  2  4C C7 F0             JMP     ERROR           ; handle error
00F456  2               
00F456  2               ; check characters in operand
00F456  2               CHEK2B:
00F456  2  20 59 F4             JSR     CHEKOP          ; check two bytes against value in accumulator
00F459  2               CHEKOP:
00F459  2  86 CA                STX     SAVX            ; stash X
00F45B  2  A6 BB                LDX     U9F             ; get current index into work buffer
00F45D  2  D5 D0                CMP     U0AA0,X         ; check whether this opcode matches the buffer
00F45F  2  F0 09                BEQ     OPOK            ;   matching so far, check the next criteria
00F461  2  68                   PLA                     ; didn't match, so throw away return address
00F462  2  68                   PLA                     ;   on the stack because we're starting over
00F463  2               BUMPOP:
00F463  2  E6 CB                INC     OPCODE          ; check the next opcode
00F465  2  F0 EC                BEQ     SERROR          ; error if we tried every opcode and none fit
00F467  2  4C 5A F3             JMP     ATRYOP          ; start over with new opcode
00F46A  2               OPOK:
00F46A  2  E6 BB                INC     U9F             ; opcode matches so far; check the next criteria
00F46C  2  A6 CA                LDX     SAVX            ; restore X
00F46E  2  60                   RTS
00F46F  2               
00F46F  2               ; -----------------------------------------------------------------------------
00F46F  2               ; disassemble [D]
00F46F  2               DISASS:
00F46F  2  B0 08                BCS     DIS0AD          ; if no address was given, start from last address
00F471  2  20 A9 F6             JSR     COPY12          ; copy start address to TMP2
00F474  2  20 8D F5             JSR     GETPAR          ; get end address in TMP0
00F477  2  90 06                BCC     DIS2AD          ; if one was given, skip default
00F479  2               DIS0AD:
00F479  2  A9 14                LDA     #$14            ; disassemble 14 bytes by default
00F47B  2  85 C1                STA     TMP0            ; store length in TMP0
00F47D  2  D0 05                BNE     DISGO           ; skip length calculation
00F47F  2               DIS2AD:
00F47F  2  20 B2 F6             JSR     SUB12           ; calculate number of bytes between start and end
00F482  2  90 1C                BCC     DERROR          ; error if end address is before start address
00F484  2               DISGO:
00F484  2  20 CE F7             JSR     CLINE           ; clear the current line
00F487  2  20 F5 F7             JSR     STOP            ; check for stop key
00F48A  2  F0 11                BEQ     DISEXIT         ; exit early if pressed
00F48C  2  20 A3 F4             JSR     DSOUT1          ; output disassembly prefix ". "
00F48F  2  E6 C6                INC     LENGTH
00F491  2  A5 C6                LDA     LENGTH          ; add length of last instruction to start address
00F493  2  20 E2 F6             JSR     BUMPAD2
00F496  2  A5 C6                LDA     LENGTH          ; subtract length of last inst from end address
00F498  2  20 C2 F6             JSR     SUBA2
00F49B  2  B0 E7                BCS     DISGO
00F49D  2               DISEXIT:
00F49D  2  4C 78 F0             JMP     STRT            ; back to mainloop
00F4A0  2               DERROR:
00F4A0  2  4C C7 F0             JMP     ERROR
00F4A3  2               
00F4A3  2               DSOUT1:
00F4A3  2  A9 2E                LDA     #'.'            ; output ". " prefix to allow edit and reassemble
00F4A5  2  20 E0 F9             JSR     CHROUT
00F4A8  2  20 51 F6             JSR     SPACE
00F4AB  2               
00F4AB  2               DISLIN:
00F4AB  2  20 44 F6             JSR     SHOWAD          ; show the address of the instruction
00F4AE  2  20 51 F6             JSR     SPACE           ; insert a space
00F4B1  2  A0 00                LDY     #0              ; no offset
00F4B3  2  B1 C3                LDA     (TMP2),Y        ; load operand of current instruction
00F4B5  2  20 23 F5             JSR     INSTXX          ; get mnemonic and addressing mode for opcode
00F4B8  2  48                   PHA                     ; save index into mnemonic table
00F4B9  2  A6 C6                LDX     LENGTH          ; get length of operand
00F4BB  2  E8                   INX                     ; add 1 byte for opcode
00F4BC  2               DSBYT:
00F4BC  2  CA                   DEX                     ; decrement index
00F4BD  2  10 0C                BPL     DSHEX           ; show hex for byte being disassembled
00F4BF  2  84 BA                STY     SAVY            ; save index
00F4C1  2  A0 30                LDY     #MSG8-MSGBAS    ; skip 3 spaces
00F4C3  2  20 E7 F7             JSR     SNDMSG
00F4C6  2  A4 BA                LDY     SAVY            ; restore index
00F4C8  2  4C D0 F4             JMP     NXBYT
00F4CB  2               DSHEX:
00F4CB  2  B1 C3                LDA     (TMP2),Y        ; show hex for byte
00F4CD  2  20 4E F6             JSR     WRBYTE
00F4D0  2               
00F4D0  2               NXBYT:
00F4D0  2  C8                   INY                     ; next byte
00F4D1  2  C0 03                CPY     #3              ; have we output 3 bytes yet?
00F4D3  2  90 E7                BCC     DSBYT           ; if not, loop
00F4D5  2  68                   PLA                     ; restore index into mnemonic table
00F4D6  2  A2 03                LDX     #3              ; 3 letters in mnemonic
00F4D8  2  20 69 F5             JSR     PROPXX          ; print mnemonic
00F4DB  2  A2 06                LDX     #6              ; 6 possible address mode character combos
00F4DD  2               PRADR1:
00F4DD  2  E0 03                CPX     #3              ; have we checked the third combo yet?
00F4DF  2  D0 14                BNE     PRADR3          ; if so, output the leading characters
00F4E1  2  A4 C6                LDY     LENGTH          ; get the length of the operand
00F4E3  2  F0 10                BEQ     PRADR3          ; if it's zero, there's no operand to print
00F4E5  2               PRADR2:
00F4E5  2  A5 C5                LDA     ACMD            ; otherwise, get the addressing mode
00F4E7  2  C9 E8                CMP     #$E8            ; check for relative addressing
00F4E9  2  08                   PHP                     ; save result of check
00F4EA  2  B1 C3                LDA     (TMP2),Y        ; get the operand
00F4EC  2  28                   PLP                     ; restore result of check
00F4ED  2  B0 1C                BCS     RELAD           ; handle a relative address
00F4EF  2  20 6E F6             JSR     WRTWO           ; output digits from address
00F4F2  2  88                   DEY
00F4F3  2  D0 F0                BNE     PRADR2          ; repeat for next byte of operand, if there is one
00F4F5  2               PRADR3:
00F4F5  2  06 C5                ASL     ACMD            ; check whether addr mode uses the current char
00F4F7  2  90 0E                BCC     PRADR4          ; if not, skip it
00F4F9  2  BD 06 F9             LDA     CHAR1-1,X       ; look up the first char in the table
00F4FC  2  20 E0 F9             JSR     CHROUT          ; print first char
00F4FF  2  BD 0C F9             LDA     CHAR2-1,X       ; look up the second char in the table
00F502  2  F0 03                BEQ     PRADR4          ; if there's no second character, skip it
00F504  2  20 E0 F9             JSR     CHROUT          ; print second char
00F507  2               PRADR4:
00F507  2  CA                   DEX                     ; next potential address mode character
00F508  2  D0 D3                BNE     PRADR1          ; loop if we haven't checked them all yet
00F50A  2  60                   RTS                     ; back to caller
00F50B  2               RELAD:
00F50B  2  20 17 F5             JSR     UB64D           ; calculate absolute address from relative
00F50E  2  18                   CLC
00F50F  2  69 01                ADC     #1              ; adjust address relative to next instruction
00F511  2  D0 01                BNE     RELEND          ; don't increment high byte unless we overflowed
00F513  2  E8                   INX                     ; increment high byte
00F514  2               RELEND:
00F514  2  4C 48 F6             JMP     WRADDR          ; print address
00F517  2               
00F517  2               UB64D:
00F517  2  A6 C4                LDX     TMP2+1          ; get high byte of current address
00F519  2  A8                   TAY                     ; is relative address positive or negative?
00F51A  2  10 01                BPL     RELC2           ; if positive, leave high byte alone
00F51C  2  CA                   DEX                     ; if negative, decrement high byte
00F51D  2               RELC2:
00F51D  2  65 C3                ADC     TMP2            ; add relative address to low byte
00F51F  2  90 01                BCC     RELC3           ; if there's no carry, we're done
00F521  2  E8                   INX                     ; if there's a carry, increment the high byte
00F522  2               RELC3:
00F522  2  60                   RTS
00F523  2               
00F523  2               ; -----------------------------------------------------------------------------
00F523  2               ; get opcode mode and length
00F523  2               
00F523  2               ; Note: the labels are different, but the code of this subroutine is almost
00F523  2               ; identical to the INSDS2 subroutine of the Apple Mini-Assembler on page 78 of
00F523  2               ; the Apple II Red Book. I'm not sure exactly where this code originated
00F523  2               ; (MOS or Apple) but it's clear that this part of Supermon64 and the
00F523  2               ; Mini-Asssembler share a common heritage.  The comments showing the way the
00F523  2               ; opcodes are transformed into indexes for the mnemonic lookup table come
00F523  2               ; from the Mini-Assembler source.
00F523  2               
00F523  2               INSTXX:
00F523  2  A8                   TAY                     ; stash opcode in accumulator in Y for later
00F524  2  4A                   LSR     A               ; is opcode even or odd?
00F525  2  90 0B                BCC     IEVEN
00F527  2  4A                   LSR     A
00F528  2  B0 17                BCS     ERR             ; invalid opcodes XXXXXX11
00F52A  2  C9 22                CMP     #$22
00F52C  2  F0 13                BEQ     ERR             ; invalid opcode 10001001
00F52E  2  29 07                AND     #$07            ; mask bits to 10000XXX
00F530  2  09 80                ORA     #$80
00F532  2               IEVEN:
00F532  2  4A                   LSR     A               ; LSB determines whether to use left/right nybble
00F533  2  AA                   TAX                     ; get format index using remaining high bytes
00F534  2  BD B5 F8             LDA     MODE,X
00F537  2  B0 04                BCS     RTMODE          ; look at left or right nybble based on carry bit
00F539  2  4A                   LSR     A               ; if carry = 0, use left nybble
00F53A  2  4A                   LSR     A
00F53B  2  4A                   LSR     A
00F53C  2  4A                   LSR     A
00F53D  2               RTMODE:
00F53D  2  29 0F                AND     #$0F            ; if carry = 1, use right nybble
00F53F  2  D0 04                BNE     GETFMT
00F541  2               ERR:
00F541  2  A0 80                LDY     #$80            ; substitute 10000000 for invalid opcodes
00F543  2  A9 00                LDA     #0
00F545  2               GETFMT:
00F545  2  AA                   TAX
00F546  2  BD F9 F8             LDA     MODE2,X         ; lookup operand format using selected nybble
00F549  2  85 C5                STA     ACMD            ; save for later use
00F54B  2  29 03                AND     #$03            ; lower 2 bits indicate number of bytes in operand
00F54D  2  85 C6                STA     LENGTH
00F54F  2  98                   TYA                     ; restore original opcode
00F550  2  29 8F                AND     #$8F            ; mask bits to X000XXXX
00F552  2  AA                   TAX                     ; save it
00F553  2  98                   TYA                     ; restore original opcode
00F554  2  A0 03                LDY     #3
00F556  2  E0 8A                CPX     #$8A            ; check if opcode = 1XXX1010
00F558  2  F0 0B                BEQ     GTFM4
00F55A  2               GTFM2:
00F55A  2  4A                   LSR     A               ; transform opcode into index for mnemonic table
00F55B  2  90 08                BCC     GTFM4
00F55D  2  4A                   LSR     A               ; opcodes transformed as follows:
00F55E  2               GTFM3:
00F55E  2  4A                   LSR     A               ; 1XXX1010->00101XXX
00F55F  2  09 20                ORA     #$20            ; XXXYYY01->00111XXX
00F561  2  88                   DEY                     ; XXXYYY10->00111XXX
00F562  2  D0 FA                BNE     GTFM3           ; XXXYY100->00110XXX
00F564  2  C8                   INY                     ; XXXXX000->000XXXXX
00F565  2               GTFM4:
00F565  2  88                   DEY
00F566  2  D0 F2                BNE     GTFM2
00F568  2  60                   RTS
00F569  2               
00F569  2               ; -----------------------------------------------------------------------------
00F569  2               ; extract and print packed mnemonics
00F569  2               PROPXX:
00F569  2  A8                   TAY                     ; use index in accumulator to look up mnemonic
00F56A  2  B9 13 F9             LDA     MNEML,Y         ;   and place a temporary copy in STORE
00F56D  2  85 B7                STA     STORE
00F56F  2  B9 53 F9             LDA     MNEMR,Y
00F572  2  85 B8                STA     STORE+1
00F574  2               PRMN1:
00F574  2  A9 00                LDA     #0              ; clear accumulator
00F576  2  A0 05                LDY     #$05            ; shift 5 times
00F578  2               PRMN2:
00F578  2  06 B8                ASL     STORE+1         ; shift right byte
00F57A  2  26 B7                ROL     STORE           ; rotate bits from right byte into left byte
00F57C  2  2A                   ROL     A               ; rotate bits from left byte into accumulator
00F57D  2  88                   DEY                     ; next bit
00F57E  2  D0 F8                BNE     PRMN2           ; loop until all bits shifted
00F580  2  69 3F                ADC     #$3F            ; calculate ascii code for letter by adding to '?'
00F582  2  20 E0 F9             JSR     CHROUT          ; output letter
00F585  2  CA                   DEX                     ; next letter
00F586  2  D0 EC                BNE     PRMN1           ; loop until all 3 letters are output
00F588  2  4C 51 F6             JMP     SPACE           ; output space
00F58B  2               
00F58B  2               ; -----------------------------------------------------------------------------
00F58B  2               ; read parameters
00F58B  2               RDPAR:
00F58B  2  C6 B9                DEC     CHRPNT          ; back up one char
00F58D  2               GETPAR:
00F58D  2  20 B2 F5             JSR     RDVAL           ; read the value
00F590  2  B0 15                BCS     GTERR           ; carry set indicates error
00F592  2  20 91 F6             JSR     GOTCHR          ; check previous character
00F595  2  D0 08                BNE     CKTERM          ; if it's not null, check if it's a valid separator
00F597  2  C6 B9                DEC     CHRPNT          ; back up one char
00F599  2  A5 CB                LDA     DIGCNT          ; get number of digits read
00F59B  2  D0 11                BNE     GETGOT          ; found some digits
00F59D  2  F0 0D                BEQ     GTNIL           ; didn't find any digits
00F59F  2               CKTERM:
00F59F  2  C9 20                CMP     #$20            ; space or comma are valid separators
00F5A1  2  F0 0B                BEQ     GETGOT          ; anything else is an error
00F5A3  2  C9 2C                CMP     #','
00F5A5  2  F0 07                BEQ     GETGOT
00F5A7  2               GTERR:
00F5A7  2  68                   PLA                     ; encountered error
00F5A8  2  68                   PLA                     ; get rid of command vector pushed on stack
00F5A9  2  4C C7 F0             JMP     ERROR           ; handle error
00F5AC  2               GTNIL:
00F5AC  2  38                   SEC                     ; set carry to indicate no parameter found
00F5AD  2  24                   .BYTE   $24             ; BIT ZP opcode consumes next byte (CLC)
00F5AE  2               GETGOT:
00F5AE  2  18                   CLC                     ; clear carry to indicate paremeter returned
00F5AF  2  A5 CB                LDA     DIGCNT          ; return number of digits in A
00F5B1  2  60                   RTS                     ; return to address pushed from vector table
00F5B2  2               
00F5B2  2               ; -----------------------------------------------------------------------------
00F5B2  2               ; read a value in the specified base
00F5B2  2               RDVAL:
00F5B2  2  A9 00                LDA     #0              ; clear temp
00F5B4  2  85 C1                STA     TMP0
00F5B6  2  85 C2                STA     TMP0+1
00F5B8  2  85 CB                STA     DIGCNT          ; clear digit counter
00F5BA  2  8A                   TXA                     ; save X and Y
00F5BB  2  48                   PHA
00F5BC  2  98                   TYA
00F5BD  2  48                   PHA
00F5BE  2               RDVMOR:
00F5BE  2  20 93 F6             JSR     GETCHR          ; get next character from input buffer
00F5C1  2  F0 1C                BEQ     RDNILK          ; null at end of buffer
00F5C3  2  C9 20                CMP     #$20            ; skip spaces
00F5C5  2  F0 F7                BEQ     RDVMOR
00F5C7  2  A2 03                LDX     #3              ; check numeric base [$+&%]
00F5C9  2               GNMODE:
00F5C9  2  DD A6 F9             CMP     HIKEY,X
00F5CC  2  F0 06                BEQ     GOTMOD          ; got a match, set up base
00F5CE  2  CA                   DEX
00F5CF  2  10 F8                BPL     GNMODE          ; check next base
00F5D1  2  E8                   INX                     ; default to hex
00F5D2  2  C6 B9                DEC     CHRPNT          ; back up one character
00F5D4  2               GOTMOD:
00F5D4  2  BC C8 F9             LDY     MODTAB,X        ; get base value
00F5D7  2  BD CC F9             LDA     LENTAB,X        ; get bits per digit
00F5DA  2  85 CD                STA     NUMBIT          ; store bits per digit
00F5DC  2               NUDIG:
00F5DC  2  20 93 F6             JSR     GETCHR          ; get next char in A
00F5DF  2               RDNILK:
00F5DF  2  F0 59                BEQ     RDNIL           ; end of number if no more characters
00F5E1  2  38                   SEC
00F5E2  2  E9 30                SBC     #$30            ; subtract ascii value of 0 to get numeric value
00F5E4  2  90 54                BCC     RDNIL           ; end of number if character was less than 0
00F5E6  2  C9 0A                CMP     #$0A
00F5E8  2  90 06                BCC     DIGMOR          ; not a hex digit if less than A
00F5EA  2  E9 07                SBC     #$07            ; 7 chars between ascii 9 and A, so subtract 7
00F5EC  2  C9 10                CMP     #$10            ; end of number if char is greater than F
00F5EE  2  B0 4A                BCS     RDNIL
00F5F0  2               DIGMOR:
00F5F0  2  85 CC                STA     INDIG           ; store the digit
00F5F2  2  C4 CC                CPY     INDIG           ; compare base with the digit
00F5F4  2  90 42                BCC     RDERR           ; error if the digit >= the base
00F5F6  2  F0 40                BEQ     RDERR
00F5F8  2  E6 CB                INC     DIGCNT          ; increment the number of digits
00F5FA  2  C0 0A                CPY     #10
00F5FC  2  D0 09                BNE     NODECM          ; skip the next part if not using base 10
00F5FE  2  A2 01                LDX     #1
00F600  2               DECLP1:
00F600  2  B5 C1                LDA     TMP0,X          ; stash the previous 16-bit value for later use
00F602  2  95 CE                STA     STASH,X
00F604  2  CA                   DEX
00F605  2  10 F9                BPL     DECLP1
00F607  2               NODECM:
00F607  2  A6 CD                LDX     NUMBIT          ; number of bits to shift
00F609  2               TIMES2:
00F609  2  06 C1                ASL     TMP0            ; shift 16-bit value by specified number of bits
00F60B  2  26 C2                ROL     TMP0+1
00F60D  2  B0 29                BCS     RDERR           ; error if we overflowed 16 bits
00F60F  2  CA                   DEX
00F610  2  D0 F7                BNE     TIMES2          ; shift remaining bits
00F612  2  C0 0A                CPY     #10
00F614  2  D0 14                BNE     NODEC2          ; skip the next part if not using base 10
00F616  2  06 CE                ASL     STASH           ; shift the previous 16-bit value one bit left
00F618  2  26 CF                ROL     STASH+1
00F61A  2  B0 1C                BCS     RDERR           ; error if we overflowed 16 bits
00F61C  2  A5 CE                LDA     STASH           ; add shifted previous value to current value
00F61E  2  65 C1                ADC     TMP0
00F620  2  85 C1                STA     TMP0
00F622  2  A5 CF                LDA     STASH+1
00F624  2  65 C2                ADC     TMP0+1
00F626  2  85 C2                STA     TMP0+1
00F628  2  B0 0E                BCS     RDERR           ; error if we overflowed 16 bits
00F62A  2               NODEC2:
00F62A  2  18                   CLC
00F62B  2  A5 CC                LDA     INDIG           ; load current digit
00F62D  2  65 C1                ADC     TMP0            ; add current digit to low byte
00F62F  2  85 C1                STA     TMP0            ; and store result back in low byte
00F631  2  8A                   TXA                     ; A=0
00F632  2  65 C2                ADC     TMP0+1          ; add carry to high byte
00F634  2  85 C2                STA     TMP0+1          ; and store result back in high byte
00F636  2  90 A4                BCC     NUDIG           ; get next digit if we didn't overflow
00F638  2               RDERR:
00F638  2  38                   SEC                     ; set carry to indicate error
00F639  2  24                   .BYTE   $24             ; BIT ZP opcode consumes next byte (CLC)
00F63A  2               RDNIL:
00F63A  2  18                   CLC                     ; clear carry to indicate success
00F63B  2  84 CD                STY     NUMBIT          ; save base of number
00F63D  2  68                   PLA                     ; restore X and Y
00F63E  2  A8                   TAY
00F63F  2  68                   PLA
00F640  2  AA                   TAX
00F641  2  A5 CB                LDA     DIGCNT          ; return number of digits in A
00F643  2  60                   RTS
00F644  2               
00F644  2               ; -----------------------------------------------------------------------------
00F644  2               ; print address
00F644  2               SHOWAD:
00F644  2  A5 C3                LDA     TMP2
00F646  2  A6 C4                LDX     TMP2+1
00F648  2               
00F648  2               WRADDR:
00F648  2  48                   PHA                     ; save low byte
00F649  2  8A                   TXA                     ; put high byte in A
00F64A  2  20 6E F6             JSR     WRTWO           ; output high byte
00F64D  2  68                   PLA                     ; restore low byte
00F64E  2               
00F64E  2               WRBYTE:
00F64E  2  20 6E F6             JSR     WRTWO           ; output byte in A
00F651  2               
00F651  2               SPACE:
00F651  2  A9 20                LDA     #$20            ; output space
00F653  2  D0 0B                BNE     FLIP
00F655  2               
00F655  2               CHOUT:
00F655  2  C9 0D                CMP     #$0D            ; output char with special handling of CR
00F657  2  D0 07                BNE     FLIP
00F659  2               CRLF:
00F659  2  A9 0D                LDA     #$0D            ; load CR in A
00F65B  2  20 E0 F9             JSR     CHROUT          ; otherwise output CR+LF
00F65E  2  A9 0A                LDA     #$0A            ; output LF
00F660  2               FLIP:
00F660  2  4C E0 F9             JMP     CHROUT
00F663  2               
00F663  2               FRESH:
00F663  2  20 59 F6             JSR     CRLF            ; output CR
00F666  2  A9 20                LDA     #$20            ; load space in A
00F668  2  20 E0 F9             JSR     CHROUT
00F66B  2  4C D7 F7             JMP     SNCLR
00F66E  2               
00F66E  2               ; -----------------------------------------------------------------------------
00F66E  2               ; output two hex digits for byte
00F66E  2               WRTWO:
00F66E  2  86 CA                STX     SAVX            ; save X
00F670  2  20 7C F6             JSR     ASCTWO          ; get hex chars for byte in X (lower) and A (upper)
00F673  2  20 E0 F9             JSR     CHROUT          ; output upper nybble
00F676  2  8A                   TXA                     ; transfer lower to A
00F677  2  A6 CA                LDX     SAVX            ; restore X
00F679  2  4C E0 F9             JMP     CHROUT          ; output lower nybble
00F67C  2               
00F67C  2               ; -----------------------------------------------------------------------------
00F67C  2               ; convert byte in A to hex digits
00F67C  2               ASCTWO:
00F67C  2  48                   PHA                     ; save byte
00F67D  2  20 86 F6             JSR     ASCII           ; do low nybble
00F680  2  AA                   TAX                     ; save in X
00F681  2  68                   PLA                     ; restore byte
00F682  2  4A                   LSR     A               ; shift upper nybble down
00F683  2  4A                   LSR     A
00F684  2  4A                   LSR     A
00F685  2  4A                   LSR     A
00F686  2               
00F686  2               ; convert low nybble in A to hex digit
00F686  2               ASCII:
00F686  2  29 0F                AND     #$0F            ; clear upper nibble
00F688  2  C9 0A                CMP     #$0A            ; if less than A, skip next step
00F68A  2  90 02                BCC     ASC1
00F68C  2  69 06                ADC     #6              ; skip ascii chars between 9 and A
00F68E  2               ASC1:
00F68E  2  69 30                ADC     #$30            ; add ascii char 0 to value
00F690  2  60                   RTS
00F691  2               
00F691  2               ; -----------------------------------------------------------------------------
00F691  2               ; get prev char from input buffer
00F691  2               GOTCHR:
00F691  2  C6 B9                DEC     CHRPNT
00F693  2               
00F693  2               ; get next char from input buffer
00F693  2               GETCHR:
00F693  2  86 CA                STX     SAVX
00F695  2  A6 B9                LDX     CHRPNT          ; get pointer to next char
00F697  2  BD 00 04             LDA     INBUFF,X        ; load next char in A
00F69A  2  F0 06                BEQ     NOCHAR          ; null, :, or ? signal end of buffer
00F69C  2  C9 3A                CMP     #':'
00F69E  2  F0 02                BEQ     NOCHAR
00F6A0  2  C9 3F                CMP     #'?'
00F6A2  2               NOCHAR:
00F6A2  2  08                   PHP
00F6A3  2  E6 B9                INC     CHRPNT          ; next char
00F6A5  2  A6 CA                LDX     SAVX
00F6A7  2  28                   PLP                     ; Z flag will signal last character
00F6A8  2  60                   RTS
00F6A9  2               
00F6A9  2               ; -----------------------------------------------------------------------------
00F6A9  2               ; copy TMP0 to TMP2
00F6A9  2               COPY12:
00F6A9  2  A5 C1                LDA     TMP0            ; low byte
00F6AB  2  85 C3                STA     TMP2
00F6AD  2  A5 C2                LDA     TMP0+1          ; high byte
00F6AF  2  85 C4                STA     TMP2+1
00F6B1  2  60                   RTS
00F6B2  2               
00F6B2  2               ; -----------------------------------------------------------------------------
00F6B2  2               ; subtract TMP2 from TMP0
00F6B2  2               SUB12:
00F6B2  2  38                   SEC
00F6B3  2  A5 C1                LDA     TMP0            ; subtract low byte
00F6B5  2  E5 C3                SBC     TMP2
00F6B7  2  85 C1                STA     TMP0
00F6B9  2  A5 C2                LDA     TMP0+1
00F6BB  2  E5 C4                SBC     TMP2+1          ; subtract high byte
00F6BD  2  85 C2                STA     TMP0+1
00F6BF  2  60                   RTS
00F6C0  2               
00F6C0  2               ; -----------------------------------------------------------------------------
00F6C0  2               ; subtract from TMP0
00F6C0  2               SUBA1:
00F6C0  2  A9 01                LDA     #1              ; shortcut to decrement by 1
00F6C2  2               SUBA2:
00F6C2  2  85 CA                STA     SAVX            ; subtrahend in accumulator
00F6C4  2  38                   SEC
00F6C5  2  A5 C1                LDA     TMP0            ; minuend in low byte
00F6C7  2  E5 CA                SBC     SAVX
00F6C9  2  85 C1                STA     TMP0
00F6CB  2  A5 C2                LDA     TMP0+1          ; borrow from high byte
00F6CD  2  E9 00                SBC     #0
00F6CF  2  85 C2                STA     TMP0+1
00F6D1  2  60                   RTS
00F6D2  2               
00F6D2  2               ; -----------------------------------------------------------------------------
00F6D2  2               ; subtract 1 from STORE
00F6D2  2               SUB13:
00F6D2  2  38                   SEC
00F6D3  2  A5 B7                LDA     STORE
00F6D5  2  E9 01                SBC     #1              ; decrement low byte
00F6D7  2  85 B7                STA     STORE
00F6D9  2  A5 B8                LDA     STORE+1
00F6DB  2  E9 00                SBC     #0              ; borrow from high byte
00F6DD  2  85 B8                STA     STORE+1
00F6DF  2  60                   RTS
00F6E0  2               
00F6E0  2               ; -----------------------------------------------------------------------------
00F6E0  2               ; add to TMP2
00F6E0  2               ADDA2:
00F6E0  2  A9 01                LDA     #1              ; shortcut to increment by 1
00F6E2  2               BUMPAD2:
00F6E2  2  18                   CLC
00F6E3  2  65 C3                ADC     TMP2            ; add value in accumulator to low byte
00F6E5  2  85 C3                STA     TMP2
00F6E7  2  90 02                BCC     BUMPEX
00F6E9  2  E6 C4                INC     TMP2+1          ; carry to high byte
00F6EB  2               BUMPEX:
00F6EB  2  60                   RTS
00F6EC  2               
00F6EC  2               ; -----------------------------------------------------------------------------
00F6EC  2               ; subtract 1 from TMP2
00F6EC  2               SUB21:
00F6EC  2  38                   SEC
00F6ED  2  A5 C3                LDA     TMP2            ; decrement low byte
00F6EF  2  E9 01                SBC     #1
00F6F1  2  85 C3                STA     TMP2
00F6F3  2  A5 C4                LDA     TMP2+1          ; borrow from high byte
00F6F5  2  E9 00                SBC     #0
00F6F7  2  85 C4                STA     TMP2+1
00F6F9  2  60                   RTS
00F6FA  2               
00F6FA  2               ; -----------------------------------------------------------------------------
00F6FA  2               ; copy TMP0 to PC
00F6FA  2               COPY1P:
00F6FA  2  B0 08                BCS     CPY1PX          ; do nothing if parameter is empty
00F6FC  2  A5 C1                LDA     TMP0            ; copy low byte
00F6FE  2  A4 C2                LDY     TMP0+1          ; copy high byte
00F700  2  85 B1                STA     PCL
00F702  2  84 B0                STY     PCH
00F704  2               CPY1PX:
00F704  2  60                   RTS
00F705  2               
00F705  2               ; -----------------------------------------------------------------------------
00F705  2               ; get start/end addresses and calc difference
00F705  2               GETDIF:
00F705  2  B0 1F                BCS     GDIFX           ; exit with error if no parameter given
00F707  2  20 A9 F6             JSR     COPY12          ; save start address in TMP2
00F70A  2  20 8D F5             JSR     GETPAR          ; get end address in TMP0
00F70D  2  B0 17                BCS     GDIFX           ; exit with error if no parameter given
00F70F  2  A5 C1                LDA     TMP0            ; save end address in STASH
00F711  2  85 CE                STA     STASH
00F713  2  A5 C2                LDA     TMP0+1
00F715  2  85 CF                STA     STASH+1
00F717  2  20 B2 F6             JSR     SUB12           ; subtract start address from end address
00F71A  2  A5 C1                LDA     TMP0
00F71C  2  85 B7                STA     STORE           ; save difference in STORE
00F71E  2  A5 C2                LDA     TMP0+1
00F720  2  85 B8                STA     STORE+1
00F722  2  90 02                BCC     GDIFX           ; error if start address is after end address
00F724  2  18                   CLC                     ; clear carry to indicate success
00F725  2  24                   .BYTE   $24             ; BIT ZP opcode consumes next byte (SEC)
00F726  2               GDIFX:
00F726  2  38                   SEC                     ; set carry to indicate error
00F727  2  60                   RTS
00F728  2               
00F728  2               ; -----------------------------------------------------------------------------
00F728  2               ; convert base [$+&%]
00F728  2               CONVRT:
00F728  2  20 8B F5             JSR     RDPAR           ; read a parameter
00F72B  2  20 63 F6             JSR     FRESH           ; next line and clear
00F72E  2  A9 24                LDA     #'$'            ; output $ sigil for hex
00F730  2  20 E0 F9             JSR     CHROUT
00F733  2  A5 C1                LDA     TMP0            ; load the 16-bit value entered
00F735  2  A6 C2                LDX     TMP0+1
00F737  2  20 48 F6             JSR     WRADDR          ; print it in 4 hex digits
00F73A  2  20 63 F6             JSR     FRESH
00F73D  2  A9 2B                LDA     #'+'            ; output + sigil for decimal
00F73F  2  20 E0 F9             JSR     CHROUT
00F742  2  20 73 F7             JSR     CVTDEC          ; convert to BCD using hardware mode
00F745  2  A9 00                LDA     #0              ; clear digit counter
00F747  2  A2 06                LDX     #6              ; max digits + 1
00F749  2  A0 03                LDY     #3              ; bits per digit - 1
00F74B  2  20 A6 F7             JSR     NMPRNT          ; print result without leading zeros
00F74E  2  20 63 F6             JSR     FRESH           ; next line and clear
00F751  2  A9 26                LDA     #'&'            ; print & sigil for octal
00F753  2  20 E0 F9             JSR     CHROUT
00F756  2  A9 00                LDA     #0              ; clear digit counter
00F758  2  A2 08                LDX     #8              ; max digits + 1
00F75A  2  A0 02                LDY     #2              ; bits per digit - 1
00F75C  2  20 98 F7             JSR     PRINUM          ; output number
00F75F  2  20 63 F6             JSR     FRESH           ; next line and clear
00F762  2  A9 25                LDA     #'%'            ; print % sigil for binary
00F764  2  20 E0 F9             JSR     CHROUT
00F767  2  A9 00                LDA     #0              ; clear digit counter
00F769  2  A2 18                LDX     #$18            ; max digits + 1
00F76B  2  A0 00                LDY     #0              ; bits per digit - 1
00F76D  2  20 98 F7             JSR     PRINUM          ; output number
00F770  2  4C 78 F0             JMP     STRT            ; back to mainloop
00F773  2               
00F773  2               ; -----------------------------------------------------------------------------
00F773  2               ; convert binary to BCD
00F773  2               
00F773  2               CVTDEC:
00F773  2  20 A9 F6             JSR     COPY12          ; copy value from TMP0 to TMP2
00F776  2  A9 00                LDA     #0
00F778  2  A2 02                LDX     #2              ; clear 3 bytes in work buffer
00F77A  2               DECML1:
00F77A  2  95 D0                STA     U0AA0,X
00F77C  2  CA                   DEX
00F77D  2  10 FB                BPL     DECML1
00F77F  2  A0 10                LDY     #16             ; 16 bits in input
00F781  2  08                   PHP                     ; save status register
00F782  2  78                   SEI                     ; make sure no interrupts occur with BCD enabled
00F783  2  F8                   SED
00F784  2               DECML2:
00F784  2  06 C3                ASL     TMP2            ; rotate bytes out of input low byte
00F786  2  26 C4                ROL     TMP2+1          ; .. into high byte and carry bit
00F788  2  A2 02                LDX     #2              ; process 3 bytes
00F78A  2               DECDBL:
00F78A  2  B5 D0                LDA     U0AA0,X         ; load current value of byte
00F78C  2  75 D0                ADC     U0AA0,X         ; add it to itself plus the carry bit
00F78E  2  95 D0                STA     U0AA0,X         ; store it back in the same location
00F790  2  CA                   DEX                     ; decrement byte counter
00F791  2  10 F7                BPL     DECDBL          ; loop until all bytes processed
00F793  2  88                   DEY                     ; decrement bit counter
00F794  2  D0 EE                BNE     DECML2          ; loop until all bits processed
00F796  2  28                   PLP                     ; restore processor status
00F797  2  60                   RTS
00F798  2               
00F798  2               ; load the input value and fall through to print it
00F798  2               PRINUM:
00F798  2  48                   PHA                     ; save accumulator
00F799  2  A5 C1                LDA     TMP0            ; copy input low byte to work buffer
00F79B  2  85 D2                STA     U0AA0+2
00F79D  2  A5 C2                LDA     TMP0+1          ; copy input high byte to work buffer
00F79F  2  85 D1                STA     U0AA0+1
00F7A1  2  A9 00                LDA     #0              ; clear overflow byte in work buffer
00F7A3  2  85 D0                STA     U0AA0
00F7A5  2  68                   PLA                     ; restore accumulator
00F7A6  2               
00F7A6  2               ; print number in specified base without leading zeros
00F7A6  2               NMPRNT:
00F7A6  2  85 CB                STA     DIGCNT          ; number of digits in accumulator
00F7A8  2  84 CD                STY     NUMBIT          ; bits per digit passed in Y register
00F7AA  2               DIGOUT:
00F7AA  2  A4 CD                LDY     NUMBIT          ; get bits to process
00F7AC  2  A9 00                LDA     #0              ; clear accumulator
00F7AE  2               ROLBIT:
00F7AE  2  06 D2                ASL     U0AA0+2         ; shift bits out of low byte
00F7B0  2  26 D1                ROL     U0AA0+1         ; ... into high byte
00F7B2  2  26 D0                ROL     U0AA0           ; ... into overflow byte
00F7B4  2  2A                   ROL     A               ; ... into accumulator
00F7B5  2  88                   DEY                     ; decrement bit counter
00F7B6  2  10 F6                BPL     ROLBIT          ; loop until all bits processed
00F7B8  2  A8                   TAY                     ; check whether accumulator is 0
00F7B9  2  D0 08                BNE     NZERO           ; if not, print it
00F7BB  2  E0 01                CPX     #1              ; have we output the max number of digits?
00F7BD  2  F0 04                BEQ     NZERO           ; if not, print it
00F7BF  2  A4 CB                LDY     DIGCNT          ; how many digits have we output?
00F7C1  2  F0 07                BEQ     ZERSUP          ; skip output if digit is 0
00F7C3  2               NZERO:
00F7C3  2  E6 CB                INC     DIGCNT          ; increment digit counter
00F7C5  2  09 30                ORA     #$30            ; add numeric value to ascii '0' to get ascii char
00F7C7  2  20 E0 F9             JSR     CHROUT          ; output character
00F7CA  2               ZERSUP:
00F7CA  2  CA                   DEX                     ; decrement number of leading zeros
00F7CB  2  D0 DD                BNE     DIGOUT          ; next digit
00F7CD  2  60                   RTS
00F7CE  2               
00F7CE  2               
00F7CE  2               ; -----------------------------------------------------------------------------
00F7CE  2               ; print and clear routines
00F7CE  2               CLINE:
00F7CE  2  20 59 F6             JSR     CRLF
00F7D1  2  4C D7 F7             JMP     SNCLR           ; clear line
00F7D4  2               SNDCLR:
00F7D4  2  20 E7 F7             JSR     SNDMSG
00F7D7  2               SNCLR:
00F7D7  2  A0 28                LDY     #$28            ; loop 40 times
00F7D9  2               SNCLP:
00F7D9  2  A9 20                LDA     #$20            ; output space character
00F7DB  2  20 E0 F9             JSR     CHROUT
00F7DE  2  88                   DEY
00F7DF  2  D0 F8                BNE     SNCLP
00F7E1  2  A9 0D                LDA     #13             ; output CR
00F7E3  2  20 E0 F9             JSR     CHROUT          ; send CR
00F7E6  2  60                   RTS
00F7E7  2               
00F7E7  2               ; -----------------------------------------------------------------------------
00F7E7  2               ; display message from table
00F7E7  2               SNDMSG:
00F7E7  2  B9 82 F8             LDA     MSGBAS,Y        ; Y contains offset in msg table
00F7EA  2  08                   PHP
00F7EB  2  29 7F                AND     #$7F            ; strip high bit before output
00F7ED  2  20 55 F6             JSR     CHOUT
00F7F0  2  C8                   INY
00F7F1  2  28                   PLP
00F7F2  2  10 F3                BPL     SNDMSG          ; loop until high bit is set
00F7F4  2  60                   RTS
00F7F5  2               
00F7F5  2               ; -----------------------------------------------------------------------------
00F7F5  2               ; check for stop key
00F7F5  2               STOP:
00F7F5  2  20 ED F9             JSR     IOF_CONIN
00F7F8  2  C9 03                CMP     #$03
00F7FA  2  F0 03                BEQ     :+
00F7FC  2  A9 FF                LDA     #$FF
00F7FE  2  60                   RTS
00F7FF  2               :
00F7FF  2  A9 00                LDA     #$00
00F801  2  60                   RTS
00F802  2               
00F802  2               ; -----------------------------------------------------------------------------
00F802  2               ; LOAD A MOTOROLA FORMATTED HEX FILE
00F802  2               LOADS19:
00F802  2  20 FB F9             JSR     IOF_CONINW      ;
00F805  2  C9 53                CMP     #'S'            ;
00F807  2  D0 F9                BNE     LOADS19         ; FIRST CHAR NOT (S)
00F809  2  20 FB F9             JSR     IOF_CONINW      ; READ CHAR
00F80C  2  C9 39                CMP     #'9'            ;
00F80E  2  F0 33                BEQ     LOAD21          ;
00F810  2  C9 31                CMP     #'1'            ;
00F812  2  D0 EE                BNE     LOADS19         ; SECOND CHAR NOT (1)
00F814  2  A9 00                LDA     #$00            ;
00F816  2  85 BC                STA     CKSM            ; ZERO CHECKSUM
00F818  2  20 44 F8             JSR     S19GETBYTE      ; READ BYTE
00F81B  2  E9 01                SBC     #$01            ;
00F81D  2  85 CB                STA     DIGCNT          ; BYTE COUNT
00F81F  2  20 71 F8             JSR     BADDR           ; BUILD ADDRESS
00F822  2  A0 00                LDY     #$00            ;
00F824  2               LOAD11:
00F824  2  20 44 F8             JSR     S19GETBYTE      ;
00F827  2  C6 CB                DEC     DIGCNT          ;
00F829  2  F0 0F                BEQ     LOAD15          ; ZERO BYTE COUNT
00F82B  2  91 BD                STA     (LOADADR),Y     ; STORE DATA
00F82D  2  E6 BD                INC     LOADADR         ; INCREMENT LOWBYTE
00F82F  2  A5 BD                LDA     LOADADR
00F831  2  C9 00                CMP     #$00
00F833  2  D0 EF                BNE     LOAD11          ; NOT ZERO?, LOOP
00F835  2  E6 BE                INC     LOADADR+1       ; ZERO, INC HIGH BYTE
00F837  2  4C 24 F8             JMP     LOAD11          ;
00F83A  2               
00F83A  2               LOAD15:
00F83A  2  E6 BC                INC     CKSM            ;
00F83C  2  F0 C4                BEQ     LOADS19         ;
00F83E  2               LOAD19:
00F83E  2  A9 3F                LDA     #'?'            ;
00F840  2  20 E0 F9             JSR     IOF_OUTCH       ;
00F843  2               LOAD21:
00F843  2  60                   RTS
00F844  2               S19GETBYTE:
00F844  2  20 5C F8             JSR     INHEX           ; GET HEX CHAR
00F847  2  0A                   ASL                     ;
00F848  2  0A                   ASL                     ;
00F849  2  0A                   ASL                     ;
00F84A  2  0A                   ASL                     ;
00F84B  2  85 BF                STA     LOADWRK         ;
00F84D  2  20 5C F8             JSR     INHEX           ;
00F850  2  29 0F                AND     #$0F            ; MASK TO 4 BITS
00F852  2  05 BF                ORA     LOADWRK         ;
00F854  2  48                   PHA                     ;
00F855  2  18                   CLC                     ;
00F856  2  65 BC                ADC     CKSM            ;
00F858  2  85 BC                STA     CKSM            ;
00F85A  2  68                   PLA                     ;
00F85B  2  60                   RTS                     ;
00F85C  2               ; INPUT HEX CHAR
00F85C  2               INHEX:
00F85C  2  20 FB F9             JSR     IOF_CONINW      ;
00F85F  2  48                   PHA                     ;
00F860  2  20 E0 F9             JSR     IOF_OUTCH       ;
00F863  2  68                   PLA                     ;
00F864  2  C9 3A                CMP     #$3A            ; LESS THAN 9?
00F866  2  B0 02                BCS     INHEX_BIG       ; NO, SKIP NEXT
00F868  2  E9 2F                SBC     #$2F            ; CONVERT 0-9
00F86A  2               INHEX_BIG:
00F86A  2  C9 41                CMP     #$41            ; A OR MORE?
00F86C  2  90 02                BCC     INHEX_SMALL     ; NO, SKIP NEXT
00F86E  2  E9 37                SBC     #$37            ; CONVERT A-F
00F870  2               INHEX_SMALL:
00F870  2  60                   RTS                     ;
00F871  2               ; BUILD ADDRESS
00F871  2               BADDR:
00F871  2  20 44 F8             JSR     S19GETBYTE      ; READ 2 FRAMES
00F874  2  85 BE                STA     LOADADR+1       ;
00F876  2  20 44 F8             JSR     S19GETBYTE      ;
00F879  2  85 BD                STA     LOADADR         ;
00F87B  2  60                   RTS
00F87C  2               LOAD:
00F87C  2  20 02 F8             JSR     LOADS19
00F87F  2  4C 78 F0             JMP     STRT            ; back to main loop
00F882  2               
00F882  2               
00F882  2               ; -----------------------------------------------------------------------------
00F882  2               ; message table; last character has high bit set
00F882  2               MSGBAS:
00F882  2               
00F882  2               MSG2:
00F882  2  0D                   .BYTE   $0D             ; header for registers
00F883  2  20 20 20 50          .BYTE   "   PC  SR AC XR YR SP   V1.2"
00F887  2  43 20 20 53  
00F88B  2  52 20 41 43  
00F89F  2  8D                   .BYTE   $0D+$80
00F8A0  2               MSG3:
00F8A0  2  20 BF                .BYTE   $20,$3F+$80     ; syntax error: move right, display "?"
00F8A2  2               MSG4:
00F8A2  2  2E 2E 53 59          .BYTE   "..SYS"         ; SYS call to enter monitor
00F8A6  2  53           
00F8A7  2  A0                   .BYTE   $20+$80
00F8A8  2               MSG5:
00F8A8  2  3A A0                .BYTE   $3A,$20+$80     ; ":" then RVS ON for memory ASCII dump
00F8AA  2               MSG6:
00F8AA  2  20 45 52 52          .BYTE   " ERRO"         ; I/O error: display " ERROR"
00F8AE  2  4F           
00F8AF  2  D2                   .BYTE   'R'+$80
00F8B0  2               MSG7:
00F8B0  2  41 A0                .BYTE   $41,$20+$80     ; assemble next instruction: "A " + addr
00F8B2  2               MSG8:
00F8B2  2  20 20                .BYTE   "  "            ; pad non-existent byte: skip 3 spaces
00F8B4  2  A0                   .BYTE   $20+$80
