00F7CA  2  C8                   INY
00F7CB  2  28                   PLP
00F7CC  2  10 F3                BPL     SNDMSG          ; loop until high bit is set
00F7CE  2  60                   RTS
00F7CF  2               
00F7CF  2               ; -----------------------------------------------------------------------------
00F7CF  2               ; check for stop key
00F7CF  2               STOP:
00F7CF  2  20 C7 F9             JSR     IOF_CONIN
00F7D2  2  C9 03                CMP     #$03
00F7D4  2  F0 03                BEQ     :+
00F7D6  2  A9 FF                LDA     #$FF
00F7D8  2  60                   RTS
00F7D9  2               :
00F7D9  2  A9 00                LDA     #$00
00F7DB  2  60                   RTS
00F7DC  2               
00F7DC  2               ; -----------------------------------------------------------------------------
00F7DC  2               ; LOAD A MOTOROLA FORMATTED HEX FILE
00F7DC  2               LOADS19:
00F7DC  2  20 D5 F9             JSR     IOF_CONINW      ;
00F7DF  2  C9 53                CMP     #'S'            ;
00F7E1  2  D0 F9                BNE     LOADS19         ; FIRST CHAR NOT (S)
00F7E3  2  20 D5 F9             JSR     IOF_CONINW      ; READ CHAR
00F7E6  2  C9 39                CMP     #'9'            ;
00F7E8  2  F0 33                BEQ     LOAD21          ;
00F7EA  2  C9 31                CMP     #'1'            ;
00F7EC  2  D0 EE                BNE     LOADS19         ; SECOND CHAR NOT (1)
00F7EE  2  A9 00                LDA     #$00            ;
00F7F0  2  85 BC                STA     CKSM            ; ZERO CHECKSUM
00F7F2  2  20 1E F8             JSR     S19GETBYTE      ; READ BYTE
00F7F5  2  E9 01                SBC     #$01            ;
00F7F7  2  85 CB                STA     DIGCNT          ; BYTE COUNT
00F7F9  2  20 4B F8             JSR     BADDR           ; BUILD ADDRESS
00F7FC  2  A0 00                LDY     #$00            ;
00F7FE  2               LOAD11:
00F7FE  2  20 1E F8             JSR     S19GETBYTE      ;
00F801  2  C6 CB                DEC     DIGCNT          ;
00F803  2  F0 0F                BEQ     LOAD15          ; ZERO BYTE COUNT
00F805  2  91 BD                STA     (LOADADR),Y     ; STORE DATA
00F807  2  E6 BD                INC     LOADADR         ; INCREMENT LOWBYTE
00F809  2  A5 BD                LDA     LOADADR
00F80B  2  C9 00                CMP     #$00
00F80D  2  D0 EF                BNE     LOAD11          ; NOT ZERO?, LOOP
00F80F  2  E6 BE                INC     LOADADR+1       ; ZERO, INC HIGH BYTE
00F811  2  4C FE F7             JMP     LOAD11          ;
00F814  2               
00F814  2               LOAD15:
00F814  2  E6 BC                INC     CKSM            ;
00F816  2  F0 C4                BEQ     LOADS19         ;
00F818  2               LOAD19:
00F818  2  A9 3F                LDA     #'?'            ;
00F81A  2  20 BA F9             JSR     IOF_OUTCH       ;
00F81D  2               LOAD21:
00F81D  2  60                   RTS
00F81E  2               S19GETBYTE:
00F81E  2  20 36 F8             JSR     INHEX           ; GET HEX CHAR
00F821  2  0A                   ASL                     ;
00F822  2  0A                   ASL                     ;
00F823  2  0A                   ASL                     ;
00F824  2  0A                   ASL                     ;
00F825  2  85 BF                STA     LOADWRK         ;
00F827  2  20 36 F8             JSR     INHEX           ;
00F82A  2  29 0F                AND     #$0F            ; MASK TO 4 BITS
00F82C  2  05 BF                ORA     LOADWRK         ;
00F82E  2  48                   PHA                     ;
00F82F  2  18                   CLC                     ;
00F830  2  65 BC                ADC     CKSM            ;
00F832  2  85 BC                STA     CKSM            ;
00F834  2  68                   PLA                     ;
00F835  2  60                   RTS                     ;
00F836  2               ; INPUT HEX CHAR
00F836  2               INHEX:
00F836  2  20 D5 F9             JSR     IOF_CONINW      ;
00F839  2  48                   PHA                     ;
00F83A  2  20 BA F9             JSR     IOF_OUTCH       ;
00F83D  2  68                   PLA                     ;
00F83E  2  C9 3A                CMP     #$3A            ; LESS THAN 9?
00F840  2  B0 02                BCS     INHEX_BIG       ; NO, SKIP NEXT
00F842  2  E9 2F                SBC     #$2F            ; CONVERT 0-9
00F844  2               INHEX_BIG:
00F844  2  C9 41                CMP     #$41            ; A OR MORE?
00F846  2  90 02                BCC     INHEX_SMALL     ; NO, SKIP NEXT
00F848  2  E9 37                SBC     #$37            ; CONVERT A-F
00F84A  2               INHEX_SMALL:
00F84A  2  60                   RTS                     ;
00F84B  2               ; BUILD ADDRESS
00F84B  2               BADDR:
00F84B  2  20 1E F8             JSR     S19GETBYTE      ; READ 2 FRAMES
00F84E  2  85 BE                STA     LOADADR+1       ;
00F850  2  20 1E F8             JSR     S19GETBYTE      ;
00F853  2  85 BD                STA     LOADADR         ;
00F855  2  60                   RTS
00F856  2               LOAD:
00F856  2  20 DC F7             JSR     LOADS19
00F859  2  4C 78 F0             JMP     STRT            ; back to main loop
00F85C  2               
00F85C  2               
00F85C  2               ; -----------------------------------------------------------------------------
00F85C  2               ; message table; last character has high bit set
00F85C  2               MSGBAS:
00F85C  2               
00F85C  2               MSG2:
00F85C  2  0D                   .BYTE   $0D             ; header for registers
00F85D  2  20 20 20 50          .BYTE   "   PC  SR AC XR YR SP   V1.2"
00F861  2  43 20 20 53  
00F865  2  52 20 41 43  
00F879  2  8D                   .BYTE   $0D+$80
00F87A  2               MSG3:
00F87A  2  20 BF                .BYTE   $20,$3F+$80     ; syntax error: move right, display "?"
00F87C  2               MSG4:
00F87C  2  2E 2E 53 59          .BYTE   "..SYS"         ; SYS call to enter monitor
00F880  2  53           
00F881  2  A0                   .BYTE   $20+$80
00F882  2               MSG5:
00F882  2  3A A0                .BYTE   $3A,$20+$80     ; ":" then RVS ON for memory ASCII dump
00F884  2               MSG6:
00F884  2  20 45 52 52          .BYTE   " ERRO"         ; I/O error: display " ERROR"
00F888  2  4F           
00F889  2  D2                   .BYTE   'R'+$80
00F88A  2               MSG7:
00F88A  2  41 A0                .BYTE   $41,$20+$80     ; assemble next instruction: "A " + addr
00F88C  2               MSG8:
00F88C  2  20 20                .BYTE   "  "            ; pad non-existent byte: skip 3 spaces
00F88E  2  A0                   .BYTE   $20+$80
00F88F  2               
00F88F  2               ; -----------------------------------------------------------------------------
00F88F  2               ; addressing mode table - nybbles provide index into MODE2 table
00F88F  2               ; for opcodes XXXXXXY0, use XXXXXX as index into table
00F88F  2               ; for opcodes WWWXXY01  use $40 + XX as index into table
00F88F  2               ; use right nybble if Y=0; use left nybble if Y=1
00F88F  2               
00F88F  2               MODE:
00F88F  2  40 02 45 03          .BYTE   $40,$02,$45,$03 ; even opcodes
00F893  2  D0 08 40 09          .BYTE   $D0,$08,$40,$09
00F897  2  30 22 45 33          .BYTE   $30,$22,$45,$33
00F89B  2  D0 08 40 09          .BYTE   $D0,$08,$40,$09
00F89F  2  40 02 45 33          .BYTE   $40,$02,$45,$33
00F8A3  2  D0 08 40 09          .BYTE   $D0,$08,$40,$09
00F8A7  2  40 02 45 B3          .BYTE   $40,$02,$45,$B3
00F8AB  2  D0 08 40 09          .BYTE   $D0,$08,$40,$09
00F8AF  2  00 22 44 33          .BYTE   $00,$22,$44,$33
00F8B3  2  D0 8C 44 00          .BYTE   $D0,$8C,$44,$00
00F8B7  2  11 22 44 33          .BYTE   $11,$22,$44,$33
00F8BB  2  D0 8C 44 9A          .BYTE   $D0,$8C,$44,$9A
00F8BF  2  10 22 44 33          .BYTE   $10,$22,$44,$33
00F8C3  2  D0 08 40 09          .BYTE   $D0,$08,$40,$09
00F8C7  2  10 22 44 33          .BYTE   $10,$22,$44,$33
00F8CB  2  D0 08 40 09          .BYTE   $D0,$08,$40,$09
00F8CF  2  62 13 78 A9          .BYTE   $62,$13,$78,$A9 ; opcodes ending in 01
00F8D3  2               
00F8D3  2               ; addressing mode format definitions indexed by nybbles from MODE table
00F8D3  2               
00F8D3  2               ; left 6 bits define which characters appear in the assembly operand
00F8D3  2               ; left 3 bits are before the address; next 3 bits are after
00F8D3  2               
00F8D3  2               ; right-most 2 bits define length of binary operand
00F8D3  2               
00F8D3  2               ; index               654 321
00F8D3  2               ; 1st character       $(# ,),
00F8D3  2               ; 2nd character        $$ X Y    length  format      idx mode
00F8D3  2               MODE2:
00F8D3  2  00                   .BYTE   $00             ; 000 000    00                  0   error
00F8D4  2  21                   .BYTE   $21             ; 001 000    01      #$00        1   immediate
00F8D5  2  81                   .BYTE   $81             ; 100 000    01      $00         2   zero-page
00F8D6  2  82                   .BYTE   $82             ; 100 000    10      $0000       3   absolute
00F8D7  2  00                   .BYTE   $00             ; 000 000    00                  4   implied
00F8D8  2  00                   .BYTE   $00             ; 000 000    00                  5   accumulator
00F8D9  2  59                   .BYTE   $59             ; 010 110    01      ($00,X)     6   indirect,X
00F8DA  2  4D                   .BYTE   $4D             ; 010 011    01      ($00),Y     7   indirect,Y
00F8DB  2  91                   .BYTE   $91             ; 100 100    01      $00,X       8   zero-page,X
00F8DC  2  92                   .BYTE   $92             ; 100 100    10      $0000,X     9   absolute,X
00F8DD  2  86                   .BYTE   $86             ; 100 001    10      $0000,Y     A   absolute,Y
00F8DE  2  4A                   .BYTE   $4A             ; 010 010    10      ($0000)     B   indirect
00F8DF  2  85                   .BYTE   $85             ; 100 001    01      $00,Y       C   zero-page,Y
00F8E0  2  9D                   .BYTE   $9D             ; 100 111    01      $0000*      D   relative
00F8E1  2               
00F8E1  2               ; * relative is special-cased so format bits don't match
00F8E1  2               
00F8E1  2               
00F8E1  2               ; character lookup tables for the format definitions in MODE2
00F8E1  2               
00F8E1  2               CHAR1:
00F8E1  2  2C 29 2C             .BYTE   $2C,$29,$2C     ; ","  ")"  ","
00F8E4  2  23 28 24             .BYTE   $23,$28,$24     ; "#"  "("  "$"
00F8E7  2               
00F8E7  2               CHAR2:
00F8E7  2  59 00 58             .BYTE   $59,$00,$58     ; "Y"   0   "X"
00F8EA  2  24 24 00             .BYTE   $24,$24,$00     ; "$"  "$"   0
