00F6F4  2  A5 C1                LDA     TMP0
00F6F6  2  85 B7                STA     STORE           ; save difference in STORE
00F6F8  2  A5 C2                LDA     TMP0+1
00F6FA  2  85 B8                STA     STORE+1
00F6FC  2  90 02                BCC     GDIFX           ; error if start address is after end address
00F6FE  2  18                   CLC                     ; clear carry to indicate success
00F6FF  2  24                   .BYTE   $24             ; BIT ZP opcode consumes next byte (SEC)
00F700  2               GDIFX:
00F700  2  38                   SEC                     ; set carry to indicate error
00F701  2  60                   RTS
00F702  2               
00F702  2               ; -----------------------------------------------------------------------------
00F702  2               ; convert base [$+&%]
00F702  2               CONVRT:
00F702  2  20 65 F5             JSR     RDPAR           ; read a parameter
00F705  2  20 3D F6             JSR     FRESH           ; next line and clear
00F708  2  A9 24                LDA     #'$'            ; output $ sigil for hex
00F70A  2  20 BA F9             JSR     CHROUT
00F70D  2  A5 C1                LDA     TMP0            ; load the 16-bit value entered
00F70F  2  A6 C2                LDX     TMP0+1
00F711  2  20 22 F6             JSR     WRADDR          ; print it in 4 hex digits
00F714  2  20 3D F6             JSR     FRESH
00F717  2  A9 2B                LDA     #'+'            ; output + sigil for decimal
00F719  2  20 BA F9             JSR     CHROUT
00F71C  2  20 4D F7             JSR     CVTDEC          ; convert to BCD using hardware mode
00F71F  2  A9 00                LDA     #0              ; clear digit counter
00F721  2  A2 06                LDX     #6              ; max digits + 1
00F723  2  A0 03                LDY     #3              ; bits per digit - 1
00F725  2  20 80 F7             JSR     NMPRNT          ; print result without leading zeros
00F728  2  20 3D F6             JSR     FRESH           ; next line and clear
00F72B  2  A9 26                LDA     #'&'            ; print & sigil for octal
00F72D  2  20 BA F9             JSR     CHROUT
