00F68C  2               
00F68C  2               ; -----------------------------------------------------------------------------
00F68C  2               ; subtract TMP2 from TMP0
00F68C  2               SUB12:
00F68C  2  38                   SEC
00F68D  2  A5 C1                LDA     TMP0            ; subtract low byte
00F68F  2  E5 C3                SBC     TMP2
00F691  2  85 C1                STA     TMP0
00F693  2  A5 C2                LDA     TMP0+1
00F695  2  E5 C4                SBC     TMP2+1          ; subtract high byte
00F697  2  85 C2                STA     TMP0+1
00F699  2  60                   RTS
00F69A  2               
00F69A  2               ; -----------------------------------------------------------------------------
00F69A  2               ; subtract from TMP0
00F69A  2               SUBA1:
00F69A  2  A9 01                LDA     #1              ; shortcut to decrement by 1
00F69C  2               SUBA2:
00F69C  2  85 CA                STA     SAVX            ; subtrahend in accumulator
00F69E  2  38                   SEC
00F69F  2  A5 C1                LDA     TMP0            ; minuend in low byte
