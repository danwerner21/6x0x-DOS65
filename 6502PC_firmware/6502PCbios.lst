000000r 2               PC6502BIOS = 1
000000r 2               PC6502_IOSPACE   = $EF00
000000r 2               PC6502_SHADOW_ROM = $F000
000000r 2               FUNCTION_DISPATCHER = $C000
000000r 2               
000000r 2               ; PAGER
000000r 2               PC6502_ACT_TASK  = PC6502_IOSPACE+$E0
000000r 2               PC6502_MAP_SETUP = PC6502_IOSPACE+$E1
000000r 2               PC6502_MMU_ENA   = PC6502_IOSPACE+$E2
000000r 2               PC6502_MAP_SPACE = PC6502_IOSPACE+$D0
