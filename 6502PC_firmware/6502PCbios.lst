00F9D0  1                       .INCLUDE "bios_serial.asm"
00F9D0  2               ;__SERIAL DRIVERS________________________________________________________________________________________________________________
00F9D0  2               ;
00F9D0  2               ; 	serial drivers
00F9D0  2               ;
00F9D0  2               ;	Entry points:
00F9D0  2               ;		SERIALINIT  - called during OS init
00F9D0  2               ;		RDSER1	    - read a byte from serial port ('A' POINTS TO BYTE)
00F9D0  2               ;		WRSER1	    - write a byte from serial port  ('A' POINTS TO BYTE)
00F9D0  2               ;		RDSER1W	    - read a byte from serial port ('A' POINTS TO BYTE, WAIT FOR INPUT)
00F9D0  2               ;		SERIALSTATUS- GET UART STATUS
00F9D0  2               ;________________________________________________________________________________________________________________________________
00F9D0  2               ;
00F9D0  2               
00F9D0  2               
00F9D0  2               ;*
00F9D0  2               ;* HARDWARE I/O ADDRESSES
00F9D0  2               ;*
00F9D0  2               
00F9D0  2               UART1DATA       = PC6502_IOSPACE+$84; SERIAL PORT 1 (I/O Card)
00F9D0  2               UART1STATUS     = PC6502_IOSPACE+$85; SERIAL PORT 1 (I/O Card)
00F9D0  2               UART1COMMAND    = PC6502_IOSPACE+$86; SERIAL PORT 1 (I/O Card)
00F9D0  2               UART1CONTROL    = PC6502_IOSPACE+$87; SERIAL PORT 1 (I/O Card)
00F9D0  2               
00F9D0  2               
00F9D0  2               ;Command Register
00F9D0  2               ;No bit is affected by a software reset, however, all bits are set to zero on a hardware reset.
00F9D0  2               ;Bit 7 6 5  configuration
00F9D0  2               ;    x x 0  no parity bit
00F9D0  2               ;    0 0 1  send and receive with odd parity
00F9D0  2               ;    0 1 1  send and receive with even parity
00F9D0  2               ;    1 0 1  send: parity=1; receive: parity not evaluated
00F9D0  2               ;    1 1 1  send: parity=0; receive: parity not evaluated
00F9D0  2               ;
00F9D0  2               ;Bit 4  0: no echo
00F9D0  2               ;       1: echo (received characters are being sent again,
00F9D0  2               ;                bits 2 and 3 must be 0 for that)
00F9D0  2               ;
00F9D0  2               ;Bit 3 2  sender interr.   RTS level   sender
00F9D0  2               ;    0 0  no               high        off
00F9D0  2               ;    0 1  yes              low         on
00F9D0  2               ;    1 0  no               low         on
00F9D0  2               ;    1 1  no               low         send BRK
00F9D0  2               ;
00F9D0  2               ;Bit 1  0: interrupt gets triggered by bit 3 in status register
00F9D0  2               ;       1: no interrupt
00F9D0  2               ;
00F9D0  2               ;Bit 0  0: disable transceiver and interrupts, /DTR high
00F9D0  2               ;       1: enable transceiver and interrupts, /DTR low
00F9D0  2               ;
00F9D0  2               ;Control Register
00F9D0  2               ;Bits 0 to 3 are set to zero on a software reset, and all bits are set to zero on a hardware reset.
00F9D0  2               ;Bit 7  0: 1 stop bit
00F9D0  2               ;       1: a) with 8 data bits and 1 parity bit: 1 stop bit
00F9D0  2               ;          b) with 5 data bits and no parity bit: 1.5 stop bits
00F9D0  2               ;          c) otherwise 2 stop bits
00F9D0  2               ;
00F9D0  2               ;Bit 6 5  data bits
00F9D0  2               ;    0 0  8
00F9D0  2               ;    0 1  7
00F9D0  2               ;    1 0  6
00F9D0  2               ;    1 1  5
00F9D0  2               ;
00F9D0  2               ;Bit 4  0: external receive clock
00F9D0  2               ;       1: builtin clock as receive clock
00F9D0  2               ;
00F9D0  2               ;Bit 3 2 1 0  baud rate
00F9D0  2               ;    0 0 0 0  1/16 times external clock
00F9D0  2               ;    0 0 0 1  50 bps
00F9D0  2               ;    0 0 1 0  75 bps
00F9D0  2               ;    0 0 1 1  109.92 bps
00F9D0  2               ;    0 1 0 0  134.58 bps
00F9D0  2               ;    0 1 0 1  150 bps
00F9D0  2               ;    0 1 1 0  300 bps
00F9D0  2               ;    0 1 1 1  600 bps
00F9D0  2               ;    1 0 0 0  1200 bps
00F9D0  2               ;    1 0 0 1  1800 bps
00F9D0  2               ;    1 0 1 0  2400 bps
00F9D0  2               ;    1 0 1 1  3600 bps
00F9D0  2               ;    1 1 0 0  4800 bps
00F9D0  2               ;    1 1 0 1  7200 bps
00F9D0  2               ;    1 1 1 0  9600 bps
00F9D0  2               ;    1 1 1 1  19200 bps
00F9D0  2               
00F9D0  2               
00F9D0  2               
00F9D0  2               ;__SERIALINIT____________________________________________________________________________________________________________________
00F9D0  2               ;
00F9D0  2               ;	INITIALIZE SERIAL PORTS
00F9D0  2               ;________________________________________________________________________________________________________________________________
00F9D0  2               ;
00F9D0  2               SERIALINIT:
00F9D0  2  A9 00                LDA     #$00            ; RESET UART
00F9D2  2  8D 85 EF             STA     UART1STATUS     ;
00F9D5  2  A9 0B                LDA     #$0B            ;
00F9D7  2  8D 86 EF             STA     UART1COMMAND    ;
00F9DA  2  A9 1E                LDA     #$1E            ; 9600, 8 BITS, NO PARITY, 1 STOP BIT
00F9DC  2  8D 87 EF             STA     UART1CONTROL    ;
00F9DF  2  60                   RTS
00F9E0  2               
00F9E0  2               
00F9E0  2               
00F9E0  2               ;__WRSER1________________________________________________________________________________________________________________________
00F9E0  2               ;
00F9E0  2               ;	WRITE CHARACTER(A) TO UART
00F9E0  2               ;________________________________________________________________________________________________________________________________
00F9E0  2               ;
00F9E0  2               IOF_OUTCH:
00F9E0  2               WRSER1:
00F9E0  2  48                   PHA
00F9E1  2               WRSER1a:
00F9E1  2  AD 85 EF             LDA     UART1STATUS     ; GET STATUS
00F9E4  2  29 10                AND     #%00010000      ; IS TX READY
00F9E6  2  F0 F9                BEQ     WRSER1a         ; NO, WAIT FOR IT
00F9E8  2  68                   PLA
00F9E9  2  8D 84 EF             STA     UART1DATA       ; WRITE DATA
00F9EC  2  60                   RTS
00F9ED  2               
00F9ED  2               ;__RDSER1________________________________________________________________________________________________________________________
00F9ED  2               ;
00F9ED  2               ;	READ CHARACTER FROM UART TO (A)
00F9ED  2               ;________________________________________________________________________________________________________________________________
00F9ED  2               ;
00F9ED  2               IOF_CONIN:
00F9ED  2               RDSER1:
00F9ED  2  AD 85 EF             LDA     UART1STATUS     ; GET STATUS REGISTER
00F9F0  2  29 08                AND     #%00001000      ; IS RX READY
00F9F2  2  F0 04                BEQ     RDSER1N         ; NO, INDICATE NO CHAR
00F9F4  2  AD 84 EF             LDA     UART1DATA       ; GET DATA CHAR
00F9F7  2  60                   RTS
00F9F8  2               RDSER1N:
00F9F8  2  A9 00                LDA     #$00            ;
00F9FA  2  60                   RTS                     ;
00F9FB  2               
00F9FB  2               ;__RDSER1W_______________________________________________________________________________________________________________________
00F9FB  2               ;
00F9FB  2               ;	READ CHARACTER FROM UART TO (A) - WAIT FOR CHAR
00F9FB  2               ;________________________________________________________________________________________________________________________________
00F9FB  2               ;
00F9FB  2               IOF_CONINW:
00F9FB  2               RDSER1W:
00F9FB  2  20 ED F9             JSR     RDSER1
00F9FE  2  C9 00                CMP     #$00
00FA00  2  F0 F9                BEQ     RDSER1W
00FA02  2  29 7F                AND     #$7F
00FA04  2  60                   RTS
00FA05  2               
00FA05  2               ;__SERIALSTATUS__________________________________________________________________________________________________________________
00FA05  2               ;
00FA05  2               ;	READ UARD STATUS
00FA05  2               ;________________________________________________________________________________________________________________________________
00FA05  2               ;
00FA05  2               SERIALSTATUS:
00FA05  2  AD 85 EF             LDA     UART1STATUS     ; GET STATUS REGISTER
00FA08  2  29 08                AND     #%00001000      ; IS RX READY
00FA0A  2  D0 03                BNE     RDSTAT1         ; INDICATE CHAR
00FA0C  2  A9 00                LDA     #$00            ; NO CHAR
00FA0E  2  60                   RTS
00FA0F  2               RDSTAT1:
00FA0F  2  A9 FF                LDA     #$FF            ; DATA CHAR
00FA11  2  60                   RTS
00FA12  2               
00FA12  1                       .INCLUDE "bios_pager.ASM"
00FA12  2               ;__BIOS PAGERS__________________________________________________________________________________________________________________
00FA12  2               ;
00FA12  2               ; 	Memory Page Management Functions
00FA12  2               ;
00FA12  2               ;________________________________________________________________________________________________________________________________
00FA12  2               ;
00FA12  2               
00FA12  2               ;__INITPAGES____________________________________________________
00FA12  2               ;
00FA12  2               ; SETUP MMU FOR BIOS PAGED MEMORY OPERATION
00FA12  2               ;
00FA12  2               ; SETUP:
00FA12  2               ; 	TASK 0, NORMAL OPERATION
00FA12  2               ;       TASK 1, ADDITIONAL RAM PAGED INTO C000-D000 (10,11)
00FA12  2               ;	TASKS 2-15 -- OPEN FOR OS/USER USE
00FA12  2               ;_______________________________________________________________
00FA12  2               ;  The 6502PC has a flexible hardware MMU. There are 64 programmable task contexts, each with 16 4K banks ($BXXX).
00FA12  2               ;  The MMU has several Registers.
00FA12  2               ;     $xFE0- Write only-Task Register, Sets which context is active, when the mmu is enabled (0-63)
00FA12  2               ;     $xFE1- Write only-Setup Register, Sets which context is being setup (exposed in the edit window) (0-63)
00FA12  2               ;     $xFE2- Write only-Enable Register 0=MMU Disabled, 1=MMU Enabled
00FA12  2               ;     $xFE4- Read Only- Active Task Register (only lower 6 bits)
00FA12  2               ;     $xFE6- Read Only- hit ISA TC Bit
00FA12  2               ;     $xFE7- Read Only- Current IO Page (only lower 4 bits)
00FA12  2               ;
00FA12  2               ;     $xfDx- read or write task edit window
00FA12  2               ;
00FA12  2               ;_______________________________________________________________
00FA12  2               INITPAGES:
00FA12  2  A9 00                LDA     #$00            ; ENSURE MMU IS DISABLED (SHOULD BE ALREADY, BUT . . . )
00FA14  2  8D E2 EF             STA     PC6502_MMU_ENA
00FA17  2  A9 01                LDA     #$01
00FA19  2  8D E1 EF             STA     PC6502_MAP_SETUP ; Fill TASK 1
00FA1C  2  20 3C FA             JSR     INITPAGE        ; FILL TASK 1 WITH A 1:1 MAP
00FA1F  2  A9 10                LDA     #$10            ; BUT, MAP Cxxx AND Dxxx TO RAM 10xxx AND 11xxx RATHER THAN RAM
00FA21  2  8D DC EF             STA     PC6502_MAP_SPACE+$0C
00FA24  2  A9 11                LDA     #$11
00FA26  2  8D DD EF             STA     PC6502_MAP_SPACE+$0D
00FA29  2  A9 00                LDA     #$00
00FA2B  2  8D E1 EF             STA     PC6502_MAP_SETUP ; Then do task 0
00FA2E  2  20 3C FA             JSR     INITPAGE        ; FILL TASK 0 WITH A 1:1 MAP
00FA31  2               ;  Why task 1 before task 0??   On some boards every write to the register also writes to task 0
00FA31  2               ;  so it is important to write task 0 last (or not use it)
00FA31  2  A9 00                LDA     #$00
00FA33  2  8D E0 EF             STA     PC6502_ACT_TASK  ; SET ACTIVE TASK TO 00
00FA36  2  A9 01                LDA     #$01
00FA38  2  8D E2 EF             STA     PC6502_MMU_ENA   ; ENABLE MMU --- FEEEEEL THE POOOOWERRRR
00FA3B  2  60                   RTS
00FA3C  2               
00FA3C  2               INITPAGE:
00FA3C  2  A2 00                LDX     #$00
00FA3E  2               :
00FA3E  2  8A                   TXA
00FA3F  2  9D D0 EF             STA     PC6502_MAP_SPACE,X; CREATE A 1:1 MAP OF BANK
00FA42  2  E8                   INX
00FA43  2  E0 10                CPX     #$10
00FA45  2  D0 F7                BNE     :-
00FA47  2  60                   RTS
00FA48  2               PAGE_EXIT:
00FA48  2  48                   PHA
00FA49  2  A9 00                LDA     #$00
00FA4B  2  8D E0 EF             STA     PC6502_ACT_TASK  ; SET ACTIVE TASK TO 00
00FA4E  2  68                   PLA
00FA4F  2  60                   RTS
00FA50  2               PAGE_ENTER:
00FA50  2  48                   PHA
00FA51  2  A9 01                LDA     #$01
00FA53  2  8D E0 EF             STA     PC6502_ACT_TASK  ; SET ACTIVE TASK TO 01
00FA56  2  68                   PLA
00FA57  2  60                   RTS
00FA58  2               
00FA58  2               
00FA58  2               DO_FARCALL_ACTUAL:
00FA58  2  20 50 FA             JSR     PAGE_ENTER
00FA5B  2  20 00 C0             JSR     FUNCTION_DISPATCHER
00FA5E  2  4C 48 FA             JMP     PAGE_EXIT
00FA61  2               
00FA61  1               
00FA61  1               
00FA61  1               ;__OUTSTR______________________________________________________
00FA61  1               ;
00FA61  1               ; OUTPUT THE STRING POINTED TO BY OUTSTR TO THE SCREEN
00FA61  1               ;
00FA61  1               ;______________________________________________________________
00FA61  1               OUTSTR:
00FA61  1  A0 00                LDY     #$00            ; LOAD $00 INTO Y
00FA63  1               OUTSTRLP:
00FA63  1  B1 41                LDA     (STRPTR),Y      ; LOAD NEXT CHAR FROM STRING INTO ACC
00FA65  1  C9 00                CMP     #$00            ; IS NULL?
00FA67  1  F0 0C                BEQ     ENDOUTSTR       ; YES, END PRINT OUT
00FA69  1  20 E0 F9             JSR     IOF_OUTCH       ; PRINT CHAR IN ACC
00FA6C  1  E6 41                INC     STRPTR
00FA6E  1  D0 F3                BNE     OUTSTRLP
00FA70  1  E6 42                INC     STRPTR+1
00FA72  1  4C 63 FA             JMP     OUTSTRLP        ; DO NEXT CHAR
00FA75  1               ENDOUTSTR:
00FA75  1  60                   RTS                     ; RETURN
00FA76  1               
00FA76  1               DSKYMSG:
00FA76  1  7C 06 3F 6D          .BYTE   $7C, $6, $3F, $6D, $0, $3E, $73, $0
00FA7A  1  00 3E 73 00  
00FA7E  1               STARTUP:
00FA7E  1  0D 0A                .BYTE   $0D,$0A
00FA80  1  20 20 5F 5F          .BYTE   "  __  ____   ___ ____    ___  ___",$0D,$0A
