00F732  2  A2 08                LDX     #8              ; max digits + 1
00F734  2  A0 02                LDY     #2              ; bits per digit - 1
00F736  2  20 72 F7             JSR     PRINUM          ; output number
00F739  2  20 3D F6             JSR     FRESH           ; next line and clear
