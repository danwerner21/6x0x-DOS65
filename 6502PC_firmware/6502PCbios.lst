00FBD1  1  20 20 5F 5F          .BYTE   "  __  ____   ___ ____    ___  ___",$0D,$0A
00FBD5  1  20 20 5F 5F  
00FBD9  1  5F 5F 20 20  
00FBF4  1  20 2F 20 2F          .BYTE   " / /_| ___| / _ \___ \  / _ \/ __\",$0D,$0A
00FBF8  1  5F 7C 20 5F  
00FBFC  1  5F 5F 7C 20  
00FC18  1  7C 20 27 5F          .BYTE   "| '_ \___ \| | | |__) |/ /_)/ /",$0D,$0A
00FC1C  1  20 5C 5F 5F  
00FC20  1  5F 20 5C 7C  
00FC39  1  7C 20 28 5F          .BYTE   "| (_) |__) | |_| / __// ___/ /___",$0D,$0A
00FC3D  1  29 20 7C 5F  
00FC41  1  5F 29 20 7C  
00FC5C  1  20 5C 5F 5F          .BYTE   " \___/____/ \___/_____\/   \____/",$0D,$0A,$0D,$0A
00FC60  1  5F 2F 5F 5F  
00FC64  1  5F 5F 2F 20  
00FC81  1               
00FC81  1                       .SEGMENT "IVECTOR"
00FC81  1                       .ORG    $FFF0
00FFF0  1  4C A9 FB             JMP     DO_FARCALL_ACTUAL
00FFF3  1  4C DC F7             JMP     LOADS19
00FFF6  1               
00FFF6  1                       .SEGMENT "VECTORS"
00FFF6  1                       .ORG    $FFFA
00FFFA  1               NNTVECTOR:
00FFFA  1  47 F0                .WORD   NINTERRUPT      ;
00FFFC  1               RSTVECTOR:
00FFFC  1  00 F0                .WORD   COLD_START      ;
00FFFE  1               INTVECTOR:
