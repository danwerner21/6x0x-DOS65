00F9AA  2               
00F9AA  1                       .INCLUDE "bios_serial.asm"
00F9AA  2               ;__SERIAL DRIVERS________________________________________________________________________________________________________________
00F9AA  2               ;
00F9AA  2               ; 	serial drivers
00F9AA  2               ;
00F9AA  2               ;	Entry points:
00F9AA  2               ;		SERIALINIT  - called during OS init
00F9AA  2               ;		RDSER1	    - read a byte from serial port ('A' POINTS TO BYTE)
00F9AA  2               ;		WRSER1	    - write a byte from serial port  ('A' POINTS TO BYTE)
00F9AA  2               ;		RDSER1W	    - read a byte from serial port ('A' POINTS TO BYTE, WAIT FOR INPUT)
00F9AA  2               ;		SERIALSTATUS- GET UART STATUS
00F9AA  2               ;________________________________________________________________________________________________________________________________
00F9AA  2               ;
00F9AA  2               
00F9AA  2               
00F9AA  2               ;*
00F9AA  2               ;* HARDWARE I/O ADDRESSES
00F9AA  2               ;*
00F9AA  2               
00F9AA  2               UART1DATA       = PC6502_IOSPACE+$84; SERIAL PORT 1 (I/O Card)
00F9AA  2               UART1STATUS     = PC6502_IOSPACE+$85; SERIAL PORT 1 (I/O Card)
00F9AA  2               UART1COMMAND    = PC6502_IOSPACE+$86; SERIAL PORT 1 (I/O Card)
00F9AA  2               UART1CONTROL    = PC6502_IOSPACE+$87; SERIAL PORT 1 (I/O Card)
00F9AA  2               
00F9AA  2               
00F9AA  2               ;Command Register
00F9AA  2               ;No bit is affected by a software reset, however, all bits are set to zero on a hardware reset.
00F9AA  2               ;Bit 7 6 5  configuration
00F9AA  2               ;    x x 0  no parity bit
00F9AA  2               ;    0 0 1  send and receive with odd parity
00F9AA  2               ;    0 1 1  send and receive with even parity
00F9AA  2               ;    1 0 1  send: parity=1; receive: parity not evaluated
00F9AA  2               ;    1 1 1  send: parity=0; receive: parity not evaluated
00F9AA  2               ;
00F9AA  2               ;Bit 4  0: no echo
00F9AA  2               ;       1: echo (received characters are being sent again,
00F9AA  2               ;                bits 2 and 3 must be 0 for that)
00F9AA  2               ;
00F9AA  2               ;Bit 3 2  sender interr.   RTS level   sender
00F9AA  2               ;    0 0  no               high        off
00F9AA  2               ;    0 1  yes              low         on
00F9AA  2               ;    1 0  no               low         on
00F9AA  2               ;    1 1  no               low         send BRK
00F9AA  2               ;
00F9AA  2               ;Bit 1  0: interrupt gets triggered by bit 3 in status register
00F9AA  2               ;       1: no interrupt
00F9AA  2               ;
00F9AA  2               ;Bit 0  0: disable transceiver and interrupts, /DTR high
00F9AA  2               ;       1: enable transceiver and interrupts, /DTR low
00F9AA  2               ;
00F9AA  2               ;Control Register
00F9AA  2               ;Bits 0 to 3 are set to zero on a software reset, and all bits are set to zero on a hardware reset.
00F9AA  2               ;Bit 7  0: 1 stop bit
00F9AA  2               ;       1: a) with 8 data bits and 1 parity bit: 1 stop bit
00F9AA  2               ;          b) with 5 data bits and no parity bit: 1.5 stop bits
00F9AA  2               ;          c) otherwise 2 stop bits
00F9AA  2               ;
00F9AA  2               ;Bit 6 5  data bits
00F9AA  2               ;    0 0  8
00F9AA  2               ;    0 1  7
00F9AA  2               ;    1 0  6
00F9AA  2               ;    1 1  5
00F9AA  2               ;
00F9AA  2               ;Bit 4  0: external receive clock
00F9AA  2               ;       1: builtin clock as receive clock
00F9AA  2               ;
00F9AA  2               ;Bit 3 2 1 0  baud rate
00F9AA  2               ;    0 0 0 0  1/16 times external clock
00F9AA  2               ;    0 0 0 1  50 bps
00F9AA  2               ;    0 0 1 0  75 bps
00F9AA  2               ;    0 0 1 1  109.92 bps
00F9AA  2               ;    0 1 0 0  134.58 bps
00F9AA  2               ;    0 1 0 1  150 bps
00F9AA  2               ;    0 1 1 0  300 bps
00F9AA  2               ;    0 1 1 1  600 bps
00F9AA  2               ;    1 0 0 0  1200 bps
00F9AA  2               ;    1 0 0 1  1800 bps
00F9AA  2               ;    1 0 1 0  2400 bps
00F9AA  2               ;    1 0 1 1  3600 bps
00F9AA  2               ;    1 1 0 0  4800 bps
00F9AA  2               ;    1 1 0 1  7200 bps
00F9AA  2               ;    1 1 1 0  9600 bps
00F9AA  2               ;    1 1 1 1  19200 bps
00F9AA  2               
00F9AA  2               
00F9AA  2               
00F9AA  2               ;__SERIALINIT____________________________________________________________________________________________________________________
00F9AA  2               ;
00F9AA  2               ;	INITIALIZE SERIAL PORTS
00F9AA  2               ;________________________________________________________________________________________________________________________________
00F9AA  2               ;
00F9AA  2               SERIALINIT:
00F9AA  2  A9 00                LDA     #$00            ; RESET UART
00F9AC  2  8D 85 EF             STA     UART1STATUS     ;
00F9AF  2  A9 0B                LDA     #$0B            ;
00F9B1  2  8D 86 EF             STA     UART1COMMAND    ;
00F9B4  2  A9 1E                LDA     #$1E            ; 9600, 8 BITS, NO PARITY, 1 STOP BIT
00F9B6  2  8D 87 EF             STA     UART1CONTROL    ;
00F9B9  2  60                   RTS
00F9BA  2               
00F9BA  2               
00F9BA  2               
00F9BA  2               ;__WRSER1________________________________________________________________________________________________________________________
00F9BA  2               ;
00F9BA  2               ;	WRITE CHARACTER(A) TO UART
00F9BA  2               ;________________________________________________________________________________________________________________________________
00F9BA  2               ;
00F9BA  2               IOF_OUTCH:
00F9BA  2               WRSER1:
00F9BA  2  48                   PHA
00F9BB  2               WRSER1a:
00F9BB  2  AD 85 EF             LDA     UART1STATUS     ; GET STATUS
00F9BE  2  29 10                AND     #%00010000      ; IS TX READY
00F9C0  2  F0 F9                BEQ     WRSER1a         ; NO, WAIT FOR IT
00F9C2  2  68                   PLA
00F9C3  2  8D 84 EF             STA     UART1DATA       ; WRITE DATA
00F9C6  2  60                   RTS
00F9C7  2               
00F9C7  2               ;__RDSER1________________________________________________________________________________________________________________________
00F9C7  2               ;
00F9C7  2               ;	READ CHARACTER FROM UART TO (A)
00F9C7  2               ;________________________________________________________________________________________________________________________________
00F9C7  2               ;
00F9C7  2               IOF_CONIN:
00F9C7  2               RDSER1:
00F9C7  2  AD 85 EF             LDA     UART1STATUS     ; GET STATUS REGISTER
00F9CA  2  29 08                AND     #%00001000      ; IS RX READY
00F9CC  2  F0 04                BEQ     RDSER1N         ; NO, INDICATE NO CHAR
00F9CE  2  AD 84 EF             LDA     UART1DATA       ; GET DATA CHAR
00F9D1  2  60                   RTS
00F9D2  2               RDSER1N:
00F9D2  2  A9 00                LDA     #$00            ;
00F9D4  2  60                   RTS                     ;
00F9D5  2               
00F9D5  2               ;__RDSER1W_______________________________________________________________________________________________________________________
00F9D5  2               ;
00F9D5  2               ;	READ CHARACTER FROM UART TO (A) - WAIT FOR CHAR
00F9D5  2               ;________________________________________________________________________________________________________________________________
00F9D5  2               ;
00F9D5  2               IOF_CONINW:
00F9D5  2               RDSER1W:
00F9D5  2  20 C7 F9             JSR     RDSER1
00F9D8  2  C9 00                CMP     #$00
00F9DA  2  F0 F9                BEQ     RDSER1W
00F9DC  2  29 7F                AND     #$7F
00F9DE  2  60                   RTS
00F9DF  2               
00F9DF  2               ;__SERIALSTATUS__________________________________________________________________________________________________________________
00F9DF  2               ;
00F9DF  2               ;	READ UARD STATUS
00F9DF  2               ;________________________________________________________________________________________________________________________________
00F9DF  2               ;
00F9DF  2               SERIALSTATUS:
00F9DF  2  AD 85 EF             LDA     UART1STATUS     ; GET STATUS REGISTER
00F9E2  2  29 08                AND     #%00001000      ; IS RX READY
00F9E4  2  D0 03                BNE     RDSTAT1         ; INDICATE CHAR
00F9E6  2  A9 00                LDA     #$00            ; NO CHAR
00F9E8  2  60                   RTS
00F9E9  2               RDSTAT1:
00F9E9  2  A9 FF                LDA     #$FF            ; DATA CHAR
00F9EB  2  60                   RTS
00F9EC  2               
00F9EC  1                       .INCLUDE "bios_ide.asm"
00F9EC  2               ;__IDE DRIVERS___________________________________________________________________________________________________________________
00F9EC  2               ;
00F9EC  2               ; 	DOS/65 IDE disk drivers 6502PC - XT IDE ISA CARD
00F9EC  2               ;
00F9EC  2               ;	Entry points:
00F9EC  2               ;		XTIDE_INIT   	- CALLED DURING OS INIT
00F9EC  2               ;		IDE_READ_SECTOR  - read a sector from drive
00F9EC  2               ;		IDE_WRITE_SECTOR - write a sector to drive
00F9EC  2               ;________________________________________________________________________________________________________________________________
00F9EC  2               ;
00F9EC  2               PC6502_IO       = $E000
00F9EC  2               
00F9EC  2               XTIDE_DATA_LO   = PC6502_IO+$300
00F9EC  2               XTIDE_DATA_HI   = PC6502_IO+$301
00F9EC  2               XTIDE_ERR       = PC6502_IO+$302
00F9EC  2               XTIDE_FECODE    = PC6502_IO+$302
00F9EC  2               XTIDE_SEC_CNT   = PC6502_IO+$304
00F9EC  2               XTIDE_LBALOW    = PC6502_IO+$306
00F9EC  2               XTIDE_LBAMID    = PC6502_IO+$308
00F9EC  2               XTIDE_LBAHI     = PC6502_IO+$30A
00F9EC  2               XTIDE_DEVICE    = PC6502_IO+$30C
00F9EC  2               XTIDE_COMMAND   = PC6502_IO+$30E
00F9EC  2               XTIDE_STATUS    = PC6502_IO+$30E
00F9EC  2               
00F9EC  2               
00F9EC  2               
00F9EC  2               
00F9EC  2               ;IDE COMMAND CONSTANTS.  THESE SHOULD NEVER CHANGE.
00F9EC  2               XTIDE_CMD_RECAL = $10
00F9EC  2               XTIDE_CMD_READ  = $20
00F9EC  2               XTIDE_CMD_WRITE = $30
00F9EC  2               XTIDE_CMD_INIT  = $91
00F9EC  2               XTIDE_CMD_ID    = $EC
00F9EC  2               XTIDE_CMD_FEAT  = $EF
00F9EC  2               XTIDE_CMD_SPINDOWN = $E0
00F9EC  2               XTIDE_CMD_SPINUP = $E1
00F9EC  2               
00F9EC  2               
00F9EC  2               
00F9EC  2                       .IFDEF  PC6502BIOS
00F9EC  2               XTIDE_INIT:
00F9EC  2  20 06 FA             JSR     XTIDE_PROBE
00F9EF  2  A9 E0                LDA     #$E0            ; E0=MST  F0=SLV
00F9F1  2  8D 0C E3             STA     XTIDE_DEVICE
00F9F4  2               
00F9F4  2  20 84 FA             JSR     IDE_WAIT_NOT_BUSY;MAKE SURE DRIVE IS READY
00F9F7  2  C9 00                CMP     #$00
00F9F9  2  D0 0A                BNE     :+
00F9FB  2               
00F9FB  2  A9 01                LDA     #$01            ; ENABLE 8-BIT MODE (XT-CF-LITE)
00F9FD  2  8D 02 E3             STA     XTIDE_FECODE
00FA00  2  A9 EF                LDA     #XTIDE_CMD_FEAT
00FA02  2  8D 0E E3             STA     XTIDE_COMMAND
00FA05  2               :
00FA05  2               
00FA05  2  60                   RTS
00FA06  2                       .ENDIF
00FA06  2               
00FA06  2               
00FA06  2                       .IFNDEF PC6502BIOS
00FA06  2               XTIDETIMEOUT:
00FA06  2                       .BYTE   $00,$00
00FA06  2               
00FA06  2               
00FA06  2               
00FA06  2               ;__XTIDE_INIT________________________________________________________________________________________
00FA06  2               ;
00FA06  2               ;  INIT AND DISPLAY IDE INFO
00FA06  2               ;____________________________________________________________________________________________________
00FA06  2               ;
00FA06  2               XTIDE_INIT:
00FA06  2                       JSR     LFCR            ; AND CRLF
00FA06  2                       LDA     #<MESSAGE1      ;
00FA06  2                       STA     STRPTR          ;
00FA06  2                       LDA     #>MESSAGE1      ;
00FA06  2                       STA     STRPTR+1        ;
00FA06  2                       JSR     WRSTR
00FA06  2                       JSR     LFCR            ; AND CRLF
00FA06  2               ;
00FA06  2                       LDA     #<MESSAGE2      ;
00FA06  2                       STA     STRPTR          ;
00FA06  2                       LDA     #>MESSAGE2      ;
00FA06  2                       STA     STRPTR+1        ;
00FA06  2                       JSR     WRSTR           ; DO PROMPT
00FA06  2               
00FA06  2                       LDA     #>XTIDE_DATA_LO ; GET BASE PORT
00FA06  2                       JSR     PRINT_BYTE      ; PRINT BASE PORT
00FA06  2                       LDA     #<XTIDE_DATA_LO ; GET BASE PORT
00FA06  2                       JSR     PRINT_BYTE      ; PRINT BASE PORT
00FA06  2               ;
00FA06  2                       JSR     XTIDE_PROBE     ; DETECT AN ATA DEVICE, ABORT IF NOT FOUND
00FA06  2                       CMP     #$00
00FA06  2                       BNE     IDE_ABORT
00FA06  2                       JMP     IDE_PRINT_INFO
00FA06  2               IDE_ABORT:
00FA06  2                       LDA     #<MESSAGE3      ;
00FA06  2                       STA     STRPTR          ;
00FA06  2                       LDA     #>MESSAGE3      ;
00FA06  2                       STA     STRPTR+1        ;
00FA06  2                       JSR     WRSTR           ; DO PROMPT
00FA06  2                       JMP     IDE_INITA
00FA06  2               IDE_PRINT_INFO:
00FA06  2                       JSR     LFCR            ; AND CRLF
00FA06  2                       LDA     #<MESSAGE4      ;
00FA06  2                       STA     STRPTR          ;
00FA06  2                       LDA     #>MESSAGE4      ;
00FA06  2                       STA     STRPTR+1        ;
00FA06  2                       JSR     WRSTR           ; DO PROMPT
00FA06  2                       LDA     #$00
00FA06  2                       JSR     IDE_READ_INFO   ; GET DRIVE INFO, ABORT IF ERROR
00FA06  2                       LDA     #<MESSAGE5      ;
00FA06  2                       STA     STRPTR          ;
00FA06  2                       LDA     #>MESSAGE5      ;
00FA06  2                       STA     STRPTR+1        ;
00FA06  2                       JSR     WRSTR           ; DO PROMPT
00FA06  2                       LDA     #$01
00FA06  2                       JSR     IDE_READ_INFO   ; GET DRIVE INFO, ABORT IF ERROR
00FA06  2               IDE_INITA:
00FA06  2                       RTS                     ; DONE
00FA06  2                       .ENDIF
00FA06  2               ;
00FA06  2               ;__XTIDE_PROBE_______________________________________________________________________________________
00FA06  2               ;
00FA06  2               ;  XTPROBE FOR IDE HARDWARE
00FA06  2               ;____________________________________________________________________________________________________
00FA06  2               ;
00FA06  2               XTIDE_PROBE:
00FA06  2               ;
00FA06  2               ; RESET PORTS
00FA06  2  A2 00                LDX     #$00
00FA08  2  A9 FF                LDA     #$FF
00FA0A  2               :
00FA0A  2  9D 00 E3             STA     XTIDE_DATA_LO,X
00FA0D  2  E8                   INX
00FA0E  2  E0 31                CPX     #$31
00FA10  2  D0 F8                BNE     :-
00FA12  2               
00FA12  2  A2 00                LDX     #$00
00FA14  2  A9 00                LDA     #$00
00FA16  2               :
00FA16  2  9D 00 E3             STA     XTIDE_DATA_LO,X
00FA19  2  E8                   INX
00FA1A  2  E0 31                CPX     #$31
00FA1C  2  D0 F8                BNE     :-
00FA1E  2               ; CHECK SIGNATURE
00FA1E  2  A0 00                LDY     #$00
00FA20  2  A2 00                LDX     #$00
00FA22  2               ;       SOMETIMES THE CF-XTIDE WILL ONLY READ 80, THIS CAN BE RESET BY WRITING ZEROS UNTIL VALUES ARE PROPERLY READ
00FA22  2               :
00FA22  2  AD 00 E3             LDA     XTIDE_DATA_LO
00FA25  2  C9 80                CMP     #$80
00FA27  2  D0 2F                BNE     :+
00FA29  2  A9 00                LDA     #$00
00FA2B  2  8D 00 E3             STA     XTIDE_DATA_LO
00FA2E  2  EA                   NOP
00FA2F  2  8D 01 E3             STA     XTIDE_DATA_HI
00FA32  2  EA                   NOP
00FA33  2  8D 06 E3             STA     XTIDE_LBALOW
00FA36  2  EA                   NOP
00FA37  2  8D 08 E3             STA     XTIDE_LBAMID
00FA3A  2  EA                   NOP
00FA3B  2  8D 0A E3             STA     XTIDE_LBAHI
00FA3E  2  EA                   NOP
00FA3F  2  8D 0C E3             STA     XTIDE_DEVICE
00FA42  2  EA                   NOP
00FA43  2  8D 0E E3             STA     XTIDE_COMMAND
00FA46  2  EA                   NOP
00FA47  2  8D 0E E3             STA     XTIDE_STATUS
00FA4A  2  EA                   NOP
00FA4B  2  E8                   INX
00FA4C  2  E0 00                CPX     #$00
00FA4E  2  D0 D2                BNE     :-
00FA50  2  C8                   INY
00FA51  2  C0 03                CPY     #$03
00FA53  2  D0 CD                BNE     :-
00FA55  2  4C 62 FA             JMP     XTIDE_PROBE_FAIL; TIMED OUT
00FA58  2               :
00FA58  2  20 84 FA             JSR     IDE_WAIT_NOT_BUSY;MAKE SURE DRIVE IS READY
00FA5B  2  C9 00                CMP     #$00
00FA5D  2  D0 03                BNE     XTIDE_PROBE_FAIL
00FA5F  2  4C 65 FA             JMP     XTIDE_PROBE_SUCCESS
00FA62  2               XTIDE_PROBE_FAIL:
00FA62  2  A9 FF                LDA     #$FF
00FA64  2  60                   RTS
00FA65  2               XTIDE_PROBE_SUCCESS:
00FA65  2  A9 00                LDA     #$00
00FA67  2  60                   RTS                     ; DONE, NOTE THAT A=0 AND Z IS SET
00FA68  2               
00FA68  2                       .IFNDEF PC6502BIOS
00FA68  2               ;*__IDE_READ_INFO___________________________________________________________________________________
00FA68  2               ;*
00FA68  2               ;*  READ IDE INFORMATION
00FA68  2               ;*	CARRY SET ON ERROR
00FA68  2               ;* 	A=MST/SLV
00FA68  2               ;*____________________________________________________________________________________________________
00FA68  2               IDE_READ_INFO:
00FA68  2               ; SET DRIVE BIT
00FA68  2                       AND     #$01            ; ONLY WANT THE 1 BIT (MST/SLV)
00FA68  2                       ASL     A               ; SHIFT 4
00FA68  2                       ASL     A               ;
00FA68  2                       ASL     A               ;
00FA68  2                       ASL     A               ;
00FA68  2                       ORA     #$E0            ; E0=MST  F0=SLV
00FA68  2                       STA     XTIDE_DEVICE
00FA68  2               
00FA68  2                       JSR     IDE_WAIT_NOT_BUSY;MAKE SURE DRIVE IS READY
00FA68  2                       CMP     #$00
00FA68  2                       BNE     IDE_READ_INFO_ABORT
00FA68  2               
00FA68  2                       LDA     #$01            ; ENABLE 8-BIT MODE (XT-CF-LITE)
00FA68  2                       STA     XTIDE_FECODE
00FA68  2                       LDA     #XTIDE_CMD_FEAT
00FA68  2                       STA     XTIDE_COMMAND
00FA68  2               
00FA68  2                       NOP                     ; TINY DELAY, JUST IN CASE
00FA68  2                       NOP
00FA68  2                       NOP
00FA68  2                       NOP
00FA68  2                       NOP
00FA68  2                       NOP
00FA68  2                       NOP
00FA68  2                       NOP
00FA68  2                       NOP
00FA68  2                       NOP
00FA68  2                       NOP
00FA68  2               
00FA68  2               
00FA68  2                       LDA     #XTIDE_CMD_ID   ; ID COMMAND
00FA68  2                       STA     XTIDE_COMMAND
00FA68  2               
00FA68  2                       JSR     IDE_WAIT_DRQ    ;WAIT UNTIL IT'S GOT THE DATA
00FA68  2                       CMP     #$00
00FA68  2                       BNE     IDE_READ_INFO_ABORT
00FA68  2               
00FA68  2                       JSR     IDE_READ_BUFFER ; GRAB THE 256 WORDS FROM THE BUFFER
00FA68  2               
00FA68  2                       LDA     #<MESSAGE6      ;
00FA68  2                       STA     STRPTR          ;
00FA68  2                       LDA     #>MESSAGE6      ;
00FA68  2                       STA     STRPTR+1        ;
00FA68  2                       JSR     WRSTR
00FA68  2                       LDA     hstbuf+123
00FA68  2                       JSR     PRINT_BYTE
00FA68  2                       LDA     hstbuf+122
00FA68  2                       JSR     PRINT_BYTE
00FA68  2                       LDA     hstbuf+121
00FA68  2                       JSR     PRINT_BYTE
00FA68  2                       LDA     hstbuf+120
00FA68  2                       JSR     PRINT_BYTE
00FA68  2                       JMP     IDE_READ_INFO_OK
00FA68  2               IDE_READ_INFO_ABORT:
00FA68  2                       LDA     #<MESSAGE3      ;
00FA68  2                       STA     STRPTR          ;
00FA68  2                       LDA     #>MESSAGE3      ;
00FA68  2                       STA     STRPTR+1        ;
00FA68  2                       JSR     WRSTR           ;DO PROMPT
00FA68  2                       JSR     LFCR            ;AND CRLF
00FA68  2                       LDA     #$FF
00FA68  2                       RTS                     ;
00FA68  2               IDE_READ_INFO_OK:
00FA68  2                       JSR     LFCR            ; AND CRLF
00FA68  2                       LDA     #$00
00FA68  2                       RTS
00FA68  2                       .ENDIF
00FA68  2               
00FA68  2               
00FA68  2               ;*__IDE_READ_SECTOR___________________________________________________________________________________
00FA68  2               ;*
00FA68  2               ;*  READ IDE SECTOR (IN LBA) INTO BUFFER
00FA68  2               ;*
00FA68  2               ;*____________________________________________________________________________________________________
00FA68  2               IDE_READ_SECTOR:
00FA68  2                       .IFNDEF PC6502BIOS
00FA68  2                       JSR     IDE_CONVERT_SECTOR_LBA
00FA68  2                       LDA     debsehd         ; STORE CURRENT PARMS
00FA68  2                       CMP     Cdebsehd        ;
00FA68  2                       BNE     IDE_READ_SECTOR_DIRTY
00FA68  2                       LDA     debcylm         ;
00FA68  2                       CMP     Cdebcylm        ;
00FA68  2                       BNE     IDE_READ_SECTOR_DIRTY
00FA68  2                       LDA     debcyll         ;
00FA68  2                       CMP     Cdebcyll        ;
00FA68  2                       BNE     IDE_READ_SECTOR_DIRTY
00FA68  2                       LDA     sekdsk          ;
00FA68  2                       CMP     currentDrive
00FA68  2                       BNE     IDE_READ_SECTOR_DIRTY
00FA68  2                       LDA     #$00            ; ZERO = 1 ON RETURN = OPERATION OK
00FA68  2                       RTS
00FA68  2                       .ENDIF
00FA68  2               IDE_READ_SECTOR_DIRTY:
00FA68  2  20 84 FA             JSR     IDE_WAIT_NOT_BUSY;MAKE SURE DRIVE IS READY
00FA6B  2  C9 00                CMP     #$00
00FA6D  2  D0 12                BNE     IDE_READ_SECTOR_ERROR; IF TIMEOUT, REPORT NO IDE PRESENT
00FA6F  2               IDE_READ_SECTOR_1:
00FA6F  2                       .IFNDEF PC6502BIOS
00FA6F  2                       JSR     IDE_SETUP_LBA   ;TELL IT WHICH SECTOR WE WANT
00FA6F  2                       .ENDIF
00FA6F  2  A9 20                LDA     #XTIDE_CMD_READ
00FA71  2  8D 0E E3             STA     XTIDE_COMMAND
00FA74  2               
00FA74  2  20 AD FA             JSR     IDE_WAIT_DRQ    ; WAIT UNTIL IT'S GOT THE DATA
00FA77  2  C9 00                CMP     #$00
00FA79  2  D0 06                BNE     IDE_READ_SECTOR_ERROR; IF TIMEOUT, REPORT NO IDE PRESENT
00FA7B  2  20 D0 FA             JSR     IDE_READ_BUFFER ; GRAB THE 256 WORDS FROM THE BUFFER
00FA7E  2                       .IFNDEF PC6502BIOS
00FA7E  2                       LDA     debsehd         ; STORE CURRENT PARMS
00FA7E  2                       STA     Cdebsehd        ;
00FA7E  2                       LDA     debcyll         ;
00FA7E  2                       STA     Cdebcyll        ;
00FA7E  2                       LDA     debcylm         ;
00FA7E  2                       STA     Cdebcylm        ;
00FA7E  2                       .ENDIF
00FA7E  2               
00FA7E  2  A9 00                LDA     #$00            ; ZERO = 1 ON RETURN = OPERATION OK
00FA80  2  60                   RTS
00FA81  2               IDE_READ_SECTOR_ERROR:
00FA81  2  A9 FF                LDA     #$FF            ; ZERO = 1 ON RETURN = OPERATION OK
00FA83  2  60                   RTS
00FA84  2               
00FA84  2               
00FA84  2               ;*__IDE_WAIT_NOT_BUSY_______________________________________________________________________________
00FA84  2               ;*
00FA84  2               ;*  WAIT FOR IDE CHANNEL TO BECOME READY
00FA84  2               ;*
00FA84  2               ;*____________________________________________________________________________________________________
00FA84  2               IDE_WAIT_NOT_BUSY:
00FA84  2  8A                   TXA
00FA85  2  48                   PHA
00FA86  2  98                   TYA
00FA87  2  48                   PHA
00FA88  2  A9 00                LDA     #$00
00FA8A  2  85 F0                STA     XTIDETIMEOUT
00FA8C  2  85 F1                STA     XTIDETIMEOUT+1
00FA8E  2               IDE_WAIT_NOT_BUSY1:
00FA8E  2  AD 0E E3             LDA     XTIDE_STATUS    ;WAIT FOR RDY BIT TO BE SET
00FA91  2  29 80                AND     #$80
00FA93  2  C9 00                CMP     #$00
00FA95  2  F0 0F                BEQ     IDE_WAIT_NOT_BUSY2
00FA97  2  E6 F0                INC     XTIDETIMEOUT
00FA99  2  D0 F3                BNE     IDE_WAIT_NOT_BUSY1
00FA9B  2  E6 F1                INC     XTIDETIMEOUT+1
00FA9D  2  D0 EF                BNE     IDE_WAIT_NOT_BUSY1
00FA9F  2  68                   PLA
00FAA0  2  A8                   TAY
00FAA1  2  68                   PLA
00FAA2  2  AA                   TAX
00FAA3  2  A9 FF                LDA     #$FF
00FAA5  2  60                   RTS
00FAA6  2               IDE_WAIT_NOT_BUSY2:
00FAA6  2  68                   PLA
00FAA7  2  A8                   TAY
00FAA8  2  68                   PLA
00FAA9  2  AA                   TAX
00FAAA  2  A9 00                LDA     #$00
00FAAC  2  60                   RTS
00FAAD  2               
00FAAD  2               ;*__IDE_WAIT_DRQ______________________________________________________________________________________
00FAAD  2               ;*
00FAAD  2               ;*	WAIT FOR THE DRIVE TO BE READY TO TRANSFER DATA.
00FAAD  2               ;*
00FAAD  2               ;*____________________________________________________________________________________________________
00FAAD  2               IDE_WAIT_DRQ:
00FAAD  2  A9 00                LDA     #$00
00FAAF  2  85 F0                STA     XTIDETIMEOUT
00FAB1  2  85 F1                STA     XTIDETIMEOUT+1
00FAB3  2               IDE_WAIT_DRQ1:
00FAB3  2  AD 0E E3             LDA     XTIDE_STATUS    ;WAIT FOR DRQ BIT TO BE SET
00FAB6  2  29 88                AND     #%10001000      ; MASK OFF BUSY(7) AND DRQ(3)
00FAB8  2  C9 08                CMP     #%00001000      ; WE WANT BUSY(7) TO BE 0 AND DRQ (3) TO BE 1
00FABA  2  F0 11                BEQ     IDE_WAIT_DRQ2
00FABC  2  29 01                AND     #%00000001      ; IS ERROR?
00FABE  2  C9 01                CMP     #%00000001      ;
00FAC0  2  F0 08                BEQ     IDE_WAIT_DRQE
00FAC2  2  E6 F0                INC     XTIDETIMEOUT
00FAC4  2  D0 ED                BNE     IDE_WAIT_DRQ1
00FAC6  2  E6 F1                INC     XTIDETIMEOUT+1
00FAC8  2  D0 E9                BNE     IDE_WAIT_DRQ1
00FACA  2               IDE_WAIT_DRQE:
00FACA  2  A9 FF                LDA     #$FF
00FACC  2  60                   RTS
00FACD  2               IDE_WAIT_DRQ2:
00FACD  2  A9 00                LDA     #$00
00FACF  2  60                   RTS
00FAD0  2               
00FAD0  2               
00FAD0  2               ;*__IDE_READ_BUFFER___________________________________________________________________________________
00FAD0  2               ;*
00FAD0  2               ;*  READ IDE BUFFER LITTLE ENDIAN
00FAD0  2               ;*
00FAD0  2               ;*____________________________________________________________________________________________________
00FAD0  2               IDE_READ_BUFFER:
00FAD0  2  A0 00                LDY     #$00            ; INDEX
00FAD2  2               :
00FAD2  2  AD 00 E3             LDA     XTIDE_DATA_LO
00FAD5  2  99 00 04             STA     hstbuf,Y        ;
00FAD8  2  C8                   INY
00FAD9  2  AD 01 E3             LDA     XTIDE_DATA_HI
00FADC  2  99 00 04             STA     hstbuf,Y        ;
00FADF  2  C8                   INY
00FAE0  2  C0 00                CPY     #$00            ;
00FAE2  2  D0 EE                BNE     :-
00FAE4  2               :
00FAE4  2               ;
00FAE4  2  AD 00 E3             LDA     XTIDE_DATA_LO
00FAE7  2  99 00 05             STA     hstbuf+$100,Y   ;
00FAEA  2  C8                   INY
00FAEB  2  AD 01 E3             LDA     XTIDE_DATA_HI
00FAEE  2  99 00 05             STA     hstbuf+$100,Y   ;
00FAF1  2  C8                   INY
00FAF2  2  C0 00                CPY     #$00            ;
00FAF4  2  D0 EE                BNE     :-              ;
00FAF6  2  60                   RTS                     ;
00FAF7  2               
00FAF7  2               ;*__IDE_WRITE_SECTOR__________________________________________________________________________________
00FAF7  2               ;*
00FAF7  2               ;*  WRITE IDE SECTOR (IN LBA) FROM BUFFER
00FAF7  2               ;*
00FAF7  2               ;*____________________________________________________________________________________________________
00FAF7  2               IDE_WRITE_SECTOR:
00FAF7  2                       .IFNDEF PC6502BIOS
00FAF7  2                       JSR     IDE_CONVERT_SECTOR_LBA
00FAF7  2                       .ENDIF
00FAF7  2  20 84 FA             JSR     IDE_WAIT_NOT_BUSY;MAKE SURE DRIVE IS READY
00FAFA  2  C9 00                CMP     #$00
00FAFC  2  D0 19                BNE     IDE_WRITE_SECTOR_ERROR; IF TIMEOUT, REPORT NO IDE PRESENT
00FAFE  2                       .IFNDEF PC6502BIOS
00FAFE  2                       JSR     IDE_SETUP_LBA   ;TELL IT WHICH SECTOR WE WANT
00FAFE  2                       .ENDIF
00FAFE  2  A9 30                LDA     #XTIDE_CMD_WRITE
00FB00  2  8D 0E E3             STA     XTIDE_COMMAND
00FB03  2  20 AD FA             JSR     IDE_WAIT_DRQ    ;WAIT UNIT IT WANTS THE DATA
00FB06  2  C9 00                CMP     #$00
00FB08  2  D0 0D                BNE     IDE_WRITE_SECTOR_ERROR; IF TIMEOUT, REPORT NO IDE PRESENT
00FB0A  2  20 1A FB             JSR     IDE_WRITE_BUFFER;GIVE THE DATA TO THE DRIVE
00FB0D  2  20 84 FA             JSR     IDE_WAIT_NOT_BUSY;WAIT UNTIL THE WRITE IS COMPLETE
00FB10  2  C9 00                CMP     #$00
00FB12  2  D0 03                BNE     IDE_WRITE_SECTOR_ERROR; IF TIMEOUT, REPORT NO IDE PRESENT
00FB14  2                       .IFNDEF PC6502BIOS
00FB14  2                       LDA     #$FF            ; INVALIDATE CACHE
00FB14  2                       STA     Cdebsehd        ;
00FB14  2                       STA     Cdebcyll        ;
00FB14  2                       STA     Cdebcylm        ;
00FB14  2                       .ENDIF
00FB14  2  A9 00                LDA     #$00            ; ZERO = 1 ON RETURN = OPERATION OK
00FB16  2  60                   RTS
00FB17  2               IDE_WRITE_SECTOR_ERROR:
00FB17  2  A9 FF                LDA     #$FF
00FB19  2  60                   RTS
00FB1A  2               
00FB1A  2               ;*__IDE_WRITE_BUFFER___________________________________________________________________________________
00FB1A  2               ;*
00FB1A  2               ;*  WRITE IDE BUFFER LITTLE ENDIAN
00FB1A  2               ;*
00FB1A  2               ;*____________________________________________________________________________________________________
00FB1A  2               IDE_WRITE_BUFFER:
00FB1A  2  A0 00                LDY     #$00            ; INDEX
00FB1C  2               :
00FB1C  2  B9 00 04             LDA     hstbuf,Y        ;
00FB1F  2  8D 00 E3             STA     XTIDE_DATA_LO
00FB22  2  C8                   INY
00FB23  2  B9 00 04             LDA     hstbuf,Y        ;
00FB26  2  8D 01 E3             STA     XTIDE_DATA_HI
00FB29  2  C8                   INY
00FB2A  2  C0 00                CPY     #$00            ;
00FB2C  2  D0 EE                BNE     :-              ;
00FB2E  2               :
00FB2E  2  B9 00 05             LDA     hstbuf+$100,Y   ;
00FB31  2  8D 00 E3             STA     XTIDE_DATA_LO
00FB34  2  C8                   INY
00FB35  2  B9 00 05             LDA     hstbuf+$100,Y   ;
00FB38  2  8D 01 E3             STA     XTIDE_DATA_HI
00FB3B  2  C8                   INY
00FB3C  2  C0 00                CPY     #$00            ;
00FB3E  2  D0 EE                BNE     :-              ;
00FB40  2  60                   RTS                     ;
00FB41  2               
00FB41  2                       .IFNDEF PC6502BIOS
00FB41  2               MESSAGE1:
00FB41  2                       .BYTE   "XT-IDE:"
00FB41  2                       .BYTE   00
00FB41  2               MESSAGE2:
00FB41  2                       .BYTE   " IO=0x"
00FB41  2                       .BYTE   00
00FB41  2               MESSAGE3:
00FB41  2                       .BYTE   " NOT PRESENT"
00FB41  2                       .BYTE   00
00FB41  2               MESSAGE4:
00FB41  2                       .BYTE   " XT-IDE0: BLOCKS="
00FB41  2                       .BYTE   00
00FB41  2               MESSAGE5:
00FB41  2                       .BYTE   " XT-IDE1: BLOCKS="
00FB41  2                       .BYTE   00
00FB41  2               MESSAGE6:
00FB41  2                       .BYTE   "0x"
00FB41  2                       .BYTE   00
00FB41  2               
00FB41  2               
00FB41  2               ;___IDE_CONVERT_SECTOR_LBA_______________________________________________________________________________
00FB41  2               ;
00FB41  2               ; 	TRANSLATE LBA SECTORS
00FB41  2               ;________________________________________________________________________________________________________
00FB41  2               IDE_CONVERT_SECTOR_LBA:
00FB41  2                       LDA     sektrk          ; LOAD TRACK # (LOW BYTE)
00FB41  2                       AND     #$0F            ; ISOLATE HEAD IN LOW 4 BITS
00FB41  2                       ASL     a               ; MOVE TO HIGH BYTE
00FB41  2                       ASL     a
00FB41  2                       ASL     a
00FB41  2                       ASL     a
00FB41  2                       TAX                     ; PARK IN X
00FB41  2                       LDA     seksec          ; LOAD SECTOR # (LOW BYTE)
00FB41  2                       LSR     A               ;
00FB41  2                       LSR     A               ; DIVIDE BY 4 (FOR BLOCKING)
00FB41  2                       AND     #$0F            ; CLEAR UPPER 4 BITS (JUST 'CAUSE)
00FB41  2                       STA     debsehd         ; STORE IN SECTOR/HEAD
00FB41  2                       TXA                     ; GET HEAD BACK
00FB41  2                       ORA     debsehd
00FB41  2                       STA     debsehd         ; STORE IN SECTOR/HEAD
00FB41  2               
00FB41  2                       LDA     sektrk
00FB41  2                       STA     debcyll         ; STORE IN TRACK (lsb)
00FB41  2                       LDA     sektrk+1
00FB41  2                       STA     debcylm         ; STORE IN TRACK (msb)
00FB41  2               ; REMOVE HEAD FROM TRACK VALUE (DIV/4)
00FB41  2                       LDA     debcylm
00FB41  2                       LSR     A
00FB41  2                       STA     debcylm
00FB41  2                       LDA     debcyll
00FB41  2                       ROR     A
00FB41  2                       STA     debcyll
00FB41  2               
00FB41  2                       LDA     debcylm
00FB41  2                       LSR     A
00FB41  2                       STA     debcylm
00FB41  2                       LDA     debcyll
00FB41  2                       ROR     A
00FB41  2                       STA     debcyll
00FB41  2               
00FB41  2                       LDA     debcylm
00FB41  2                       LSR     A
00FB41  2                       STA     debcylm
00FB41  2                       LDA     debcyll
00FB41  2                       ROR     A
00FB41  2                       STA     debcyll
00FB41  2               
00FB41  2                       LDA     debcylm
00FB41  2                       LSR     A
00FB41  2                       STA     debcylm
00FB41  2                       LDA     debcyll
00FB41  2                       ROR     A
00FB41  2                       STA     debcyll
00FB41  2               ;	ADD SLICE OFFSET
00FB41  2                       LDA     sekdsk          ; GET DRIVE#
00FB41  2                       AND     #7              ; ONLY FIRST 8 DEVICES SUPPORTED
00FB41  2                       ASL     a               ; DOUBLE NUMBER FOR TABLE LOOKUP
00FB41  2                       TAX                     ; MOVE TO X REGISTER
00FB41  2                       INX                     ; WANT SECOND BYTE OF ENTRY
00FB41  2                       LDA     dskcfg,X        ; GET SLICE#
00FB41  2                       STA     slicetmp+1      ; SLICE OFFSET MSB
00FB41  2                       LDA     #0              ; GET SLICE#
00FB41  2                       STA     slicetmp        ; SLICE OFFSET LSB
00FB41  2                       CLC                     ; VOODOO MATH TO TAKE SLICE*$4000
00FB41  2                       ROR     slicetmp+1
00FB41  2                       ROR     slicetmp
00FB41  2                       ROR     slicetmp+1
00FB41  2                       ROR     slicetmp
00FB41  2               
00FB41  2                       LDA     dskcfg,X        ; GET SLICE#
00FB41  2                       CLC
00FB41  2                       ADC     slicetmp
00FB41  2                       STA     slicetmp
00FB41  2                       LDA     #$00            ; LOGIC ERROR FOR SLICES THAT CARRY?
00FB41  2                       ADC     slicetmp+1      ;
00FB41  2                       STA     slicetmp+1      ;
00FB41  2               
00FB41  2               ; ADD SLICE OFFSET TO TRACK #
00FB41  2                       LDA     slicetmp
00FB41  2                       ADC     debcyll
00FB41  2                       STA     debcyll         ; store sum of LSBs
00FB41  2                       LDA     slicetmp+1
00FB41  2                       ADC     debcylm         ; add the MSBs using carry from
00FB41  2                       STA     debcylm         ; the previous calculation
00FB41  2                       RTS
00FB41  2               
00FB41  2               ;*__IDE_SETUP_LBA_____________________________________________________________________________________
00FB41  2               ;*
00FB41  2               ;*  SETUP LBA DATA
00FB41  2               ;*  A= DRIVE DEVICE
00FB41  2               ;*____________________________________________________________________________________________________
00FB41  2               IDE_SETUP_LBA:
00FB41  2                       LDA     currentDrive
00FB41  2                       AND     #$01            ; only want drive cfg
00FB41  2                       ASL     a               ; SHIFT 4
00FB41  2                       ASL     a               ;
00FB41  2                       ASL     a               ;
00FB41  2                       ASL     a               ;
00FB41  2                       ORA     #$E0            ; E0=MST  F0=SLV
00FB41  2                       TAX
00FB41  2                       LDY     #$00
00FB41  2                       STA     XTIDE_DEVICE
00FB41  2               
00FB41  2                       LDA     debcylm
00FB41  2                       STA     XTIDE_LBAHI
00FB41  2               
00FB41  2                       LDA     debcyll
00FB41  2                       STA     XTIDE_LBAMID
00FB41  2               
00FB41  2                       LDA     debsehd
00FB41  2                       STA     XTIDE_LBALOW
00FB41  2               
00FB41  2                       LDA     #$01
00FB41  2                       STA     XTIDE_SEC_CNT
00FB41  2                       RTS
00FB41  2               
00FB41  2                       .ENDIF
00FB41  2               
00FB41  2                       .IFDEF  PC6502BIOS
00FB41  2               ; Boot System [B]
00FB41  2               BOOT:
00FB41  2  B0 1D                BCS     BOOTX           ; exit with error if no parameter given
00FB43  2  A5 C1                LDA     TMP0
00FB45  2  29 0F                AND     #$0F
00FB47  2  8D 28 06             STA     DSKUNIT
00FB4A  2  A9 00                LDA     #$00
00FB4C  2  8D 10 06             STA     debcyll         ;
00FB4F  2  8D 11 06             STA     debcylm         ;
00FB52  2  8D 12 06             STA     debsehd         ;
00FB55  2  20 67 F5             JSR     GETPAR          ; get value for next byte of memory
00FB58  2  B0 06                BCS     BOOTX           ; exit with error if no parameter given
00FB5A  2  20 68 FA             JSR     IDE_READ_SECTOR
00FB5D  2  4C 00 04             JMP     hstbuf
00FB60  2               BOOTX:
00FB60  2  4C C7 F0             JMP     ERROR           ; back to main loop
00FB63  2                       .ENDIF
00FB63  2               
00FB63  1                       .INCLUDE "bios_pager.ASM"
00FB63  2               ;__BIOS PAGERS__________________________________________________________________________________________________________________
00FB63  2               ;
00FB63  2               ; 	Memory Page Management Functions
00FB63  2               ;
00FB63  2               ;________________________________________________________________________________________________________________________________
00FB63  2               ;
00FB63  2               
00FB63  2               ;__INITPAGES____________________________________________________
00FB63  2               ;
00FB63  2               ; SETUP MMU FOR BIOS PAGED MEMORY OPERATION
00FB63  2               ;
00FB63  2               ; SETUP:
00FB63  2               ; 	TASK 0, NORMAL OPERATION
00FB63  2               ;       TASK 1, ADDITIONAL RAM PAGED INTO C000-D000 (10,11)
00FB63  2               ;	TASKS 2-15 -- OPEN FOR OS/USER USE
00FB63  2               ;_______________________________________________________________
00FB63  2               ;  The 6502PC has a flexible hardware MMU. There are 64 programmable task contexts, each with 16 4K banks ($BXXX).
00FB63  2               ;  The MMU has several Registers.
00FB63  2               ;     $xFE0- Write only-Task Register, Sets which context is active, when the mmu is enabled (0-63)
00FB63  2               ;     $xFE1- Write only-Setup Register, Sets which context is being setup (exposed in the edit window) (0-63)
00FB63  2               ;     $xFE2- Write only-Enable Register 0=MMU Disabled, 1=MMU Enabled
00FB63  2               ;     $xFE4- Read Only- Active Task Register (only lower 6 bits)
00FB63  2               ;     $xFE6- Read Only- hit ISA TC Bit
00FB63  2               ;     $xFE7- Read Only- Current IO Page (only lower 4 bits)
00FB63  2               ;
00FB63  2               ;     $xfDx- read or write task edit window
00FB63  2               ;
00FB63  2               ;_______________________________________________________________
00FB63  2               INITPAGES:
00FB63  2  A9 00                LDA     #$00            ; ENSURE MMU IS DISABLED (SHOULD BE ALREADY, BUT . . . )
00FB65  2  8D E2 EF             STA     PC6502_MMU_ENA
00FB68  2  A9 01                LDA     #$01
00FB6A  2  8D E1 EF             STA     PC6502_MAP_SETUP; Fill TASK 1
00FB6D  2  20 8D FB             JSR     INITPAGE        ; FILL TASK 1 WITH A 1:1 MAP
00FB70  2  A9 10                LDA     #$10            ; BUT, MAP Cxxx AND Dxxx TO RAM 10xxx AND 11xxx RATHER THAN RAM
00FB72  2  8D DC EF             STA     PC6502_MAP_SPACE+$0C
00FB75  2  A9 11                LDA     #$11
00FB77  2  8D DD EF             STA     PC6502_MAP_SPACE+$0D
00FB7A  2  A9 00                LDA     #$00
00FB7C  2  8D E1 EF             STA     PC6502_MAP_SETUP; Then do task 0
00FB7F  2  20 8D FB             JSR     INITPAGE        ; FILL TASK 0 WITH A 1:1 MAP
00FB82  2               ;  Why task 1 before task 0??   On some boards every write to the register also writes to task 0
00FB82  2               ;  so it is important to write task 0 last (or not use it)
00FB82  2  A9 00                LDA     #$00
00FB84  2  8D E0 EF             STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 00
00FB87  2  A9 01                LDA     #$01
00FB89  2  8D E2 EF             STA     PC6502_MMU_ENA  ; ENABLE MMU --- FEEEEEL THE POOOOWERRRR
00FB8C  2  60                   RTS
00FB8D  2               
00FB8D  2               INITPAGE:
00FB8D  2  A2 00                LDX     #$00
00FB8F  2               :
00FB8F  2  8A                   TXA
00FB90  2  9D D0 EF             STA     PC6502_MAP_SPACE,X; CREATE A 1:1 MAP OF BANK
00FB93  2  E8                   INX
00FB94  2  E0 10                CPX     #$10
00FB96  2  D0 F7                BNE     :-
00FB98  2  60                   RTS
00FB99  2               PAGE_EXIT:
00FB99  2  48                   PHA
00FB9A  2  A9 00                LDA     #$00
00FB9C  2  8D E0 EF             STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 00
00FB9F  2  68                   PLA
00FBA0  2  60                   RTS
00FBA1  2               PAGE_ENTER:
00FBA1  2  48                   PHA
00FBA2  2  A9 01                LDA     #$01
00FBA4  2  8D E0 EF             STA     PC6502_ACT_TASK ; SET ACTIVE TASK TO 01
00FBA7  2  68                   PLA
00FBA8  2  60                   RTS
00FBA9  2               
00FBA9  2               
00FBA9  2               DO_FARCALL_ACTUAL:
00FBA9  2  20 A1 FB             JSR     PAGE_ENTER
00FBAC  2  20 00 C0             JSR     FUNCTION_DISPATCHER
00FBAF  2  4C 99 FB             JMP     PAGE_EXIT
00FBB2  2               
00FBB2  1               
00FBB2  1               
00FBB2  1               ;__OUTSTR______________________________________________________
00FBB2  1               ;
00FBB2  1               ; OUTPUT THE STRING POINTED TO BY OUTSTR TO THE SCREEN
00FBB2  1               ;
00FBB2  1               ;______________________________________________________________
00FBB2  1               OUTSTR:
00FBB2  1  A0 00                LDY     #$00            ; LOAD $00 INTO Y
00FBB4  1               OUTSTRLP:
00FBB4  1  B1 41                LDA     (STRPTR),Y      ; LOAD NEXT CHAR FROM STRING INTO ACC
00FBB6  1  C9 00                CMP     #$00            ; IS NULL?
00FBB8  1  F0 0C                BEQ     ENDOUTSTR       ; YES, END PRINT OUT
00FBBA  1  20 BA F9             JSR     IOF_OUTCH       ; PRINT CHAR IN ACC
00FBBD  1  E6 41                INC     STRPTR
00FBBF  1  D0 F3                BNE     OUTSTRLP
00FBC1  1  E6 42                INC     STRPTR+1
00FBC3  1  4C B4 FB             JMP     OUTSTRLP        ; DO NEXT CHAR
00FBC6  1               ENDOUTSTR:
00FBC6  1  60                   RTS                     ; RETURN
00FBC7  1               
00FBC7  1               DSKYMSG:
00FBC7  1  7C 06 3F 6D          .BYTE   $7C, $6, $3F, $6D, $0, $3E, $73, $0
00FBCB  1  00 3E 73 00  
