00F766  2  75 D0                ADC     U0AA0,X         ; add it to itself plus the carry bit
00F768  2  95 D0                STA     U0AA0,X         ; store it back in the same location
00F76A  2  CA                   DEX                     ; decrement byte counter
00F76B  2  10 F7                BPL     DECDBL          ; loop until all bytes processed
00F76D  2  88                   DEY                     ; decrement bit counter
