00F63A  2               FLIP:
00F63A  2  4C BA F9             JMP     CHROUT
00F63D  2               
00F63D  2               FRESH:
00F63D  2  20 33 F6             JSR     CRLF            ; output CR
00F640  2  A9 20                LDA     #$20            ; load space in A
00F642  2  20 BA F9             JSR     CHROUT
00F645  2  4C B1 F7             JMP     SNCLR
00F648  2               
00F648  2               ; -----------------------------------------------------------------------------
00F648  2               ; output two hex digits for byte
00F648  2               WRTWO:
00F648  2  86 CA                STX     SAVX            ; save X
00F64A  2  20 56 F6             JSR     ASCTWO          ; get hex chars for byte in X (lower) and A (upper)
00F64D  2  20 BA F9             JSR     CHROUT          ; output upper nybble
00F650  2  8A                   TXA                     ; transfer lower to A
00F651  2  A6 CA                LDX     SAVX            ; restore X
00F653  2  4C BA F9             JMP     CHROUT          ; output lower nybble
00F656  2               
00F656  2               ; -----------------------------------------------------------------------------
00F656  2               ; convert byte in A to hex digits
00F656  2               ASCTWO:
00F656  2  48                   PHA                     ; save byte
00F657  2  20 60 F6             JSR     ASCII           ; do low nybble
00F65A  2  AA                   TAX                     ; save in X
00F65B  2  68                   PLA                     ; restore byte
00F65C  2  4A                   LSR     A               ; shift upper nybble down
00F65D  2  4A                   LSR     A
00F65E  2  4A                   LSR     A
00F65F  2  4A                   LSR     A
00F660  2               
00F660  2               ; convert low nybble in A to hex digit
00F660  2               ASCII:
00F660  2  29 0F                AND     #$0F            ; clear upper nibble
00F662  2  C9 0A                CMP     #$0A            ; if less than A, skip next step
00F664  2  90 02                BCC     ASC1
00F666  2  69 06                ADC     #6              ; skip ascii chars between 9 and A
00F668  2               ASC1:
00F668  2  69 30                ADC     #$30            ; add ascii char 0 to value
00F66A  2  60                   RTS
00F66B  2               
00F66B  2               ; -----------------------------------------------------------------------------
00F66B  2               ; get prev char from input buffer
00F66B  2               GOTCHR:
00F66B  2  C6 B9                DEC     CHRPNT
00F66D  2               
00F66D  2               ; get next char from input buffer
00F66D  2               GETCHR:
00F66D  2  86 CA                STX     SAVX
00F66F  2  A6 B9                LDX     CHRPNT          ; get pointer to next char
00F671  2  BD 00 04             LDA     INBUFF,X        ; load next char in A
00F674  2  F0 06                BEQ     NOCHAR          ; null, :, or ? signal end of buffer
00F676  2  C9 3A                CMP     #':'
00F678  2  F0 02                BEQ     NOCHAR
00F67A  2  C9 3F                CMP     #'?'
00F67C  2               NOCHAR:
00F67C  2  08                   PHP
00F67D  2  E6 B9                INC     CHRPNT          ; next char
00F67F  2  A6 CA                LDX     SAVX
00F681  2  28                   PLP                     ; Z flag will signal last character
00F682  2  60                   RTS
00F683  2               
00F683  2               ; -----------------------------------------------------------------------------
00F683  2               ; copy TMP0 to TMP2
