00F759  2  A0 10                LDY     #16             ; 16 bits in input
00F75B  2  08                   PHP                     ; save status register
00F75C  2  78                   SEI                     ; make sure no interrupts occur with BCD enabled
00F75D  2  F8                   SED
00F75E  2               DECML2:
00F75E  2  06 C3                ASL     TMP2            ; rotate bytes out of input low byte
