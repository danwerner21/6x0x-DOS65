000000r 2               ;ZERO PAGE	ADDRESS			; FUNCTION
000000r 2               
000000r 2               ;
000000r 2               ; DRIVER WORKING STORAGE
000000r 2               ;
000000r 2               FLATCH_STORE    = $02FD         ;
000000r 2               PPIDETIMEOUT    = $02FE         ; (word)
000000r 2               INBUFFER        = $0300         ;
