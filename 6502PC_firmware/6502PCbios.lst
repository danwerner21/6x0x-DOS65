00FFFA  1               NNTVECTOR:
00FFFA  1  47 F0                .WORD   NINTERRUPT      ;
00FFFC  1               RSTVECTOR:
00FFFC  1  00 F0                .WORD   COLD_START      ;
00FFFE  1               INTVECTOR:
00FFFE  1  31 F0                .WORD   INTERRUPT       ; ROM VECTOR FOR IRQ
