00F6B7  2  85 B8                STA     STORE+1
00F6B9  2  60                   RTS
00F6BA  2               
00F6BA  2               ; -----------------------------------------------------------------------------
00F6BA  2               ; add to TMP2
00F6BA  2               ADDA2:
00F6BA  2  A9 01                LDA     #1              ; shortcut to increment by 1
00F6BC  2               BUMPAD2:
00F6BC  2  18                   CLC
00F6BD  2  65 C3                ADC     TMP2            ; add value in accumulator to low byte
00F6BF  2  85 C3                STA     TMP2
