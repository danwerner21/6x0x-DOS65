00F594  2  8A                   TXA                     ; save X and Y
00F595  2  48                   PHA
00F596  2  98                   TYA
00F597  2  48                   PHA
00F598  2               RDVMOR:
00F598  2  20 6D F6             JSR     GETCHR          ; get next character from input buffer
00F59B  2  F0 1C                BEQ     RDNILK          ; null at end of buffer
00F59D  2  C9 20                CMP     #$20            ; skip spaces
00F59F  2  F0 F7                BEQ     RDVMOR
00F5A1  2  A2 03                LDX     #3              ; check numeric base [$+&%]
00F5A3  2               GNMODE:
00F5A3  2  DD 80 F9             CMP     HIKEY,X
00F5A6  2  F0 06                BEQ     GOTMOD          ; got a match, set up base
00F5A8  2  CA                   DEX
00F5A9  2  10 F8                BPL     GNMODE          ; check next base
00F5AB  2  E8                   INX                     ; default to hex
00F5AC  2  C6 B9                DEC     CHRPNT          ; back up one character
00F5AE  2               GOTMOD:
00F5AE  2  BC A2 F9             LDY     MODTAB,X        ; get base value
00F5B1  2  BD A6 F9             LDA     LENTAB,X        ; get bits per digit
00F5B4  2  85 CD                STA     NUMBIT          ; store bits per digit
00F5B6  2               NUDIG:
00F5B6  2  20 6D F6             JSR     GETCHR          ; get next char in A
00F5B9  2               RDNILK:
00F5B9  2  F0 59                BEQ     RDNIL           ; end of number if no more characters
00F5BB  2  38                   SEC
00F5BC  2  E9 30                SBC     #$30            ; subtract ascii value of 0 to get numeric value
00F5BE  2  90 54                BCC     RDNIL           ; end of number if character was less than 0
00F5C0  2  C9 0A                CMP     #$0A
00F5C2  2  90 06                BCC     DIGMOR          ; not a hex digit if less than A
00F5C4  2  E9 07                SBC     #$07            ; 7 chars between ascii 9 and A, so subtract 7
00F5C6  2  C9 10                CMP     #$10            ; end of number if char is greater than F
00F5C8  2  B0 4A                BCS     RDNIL
00F5CA  2               DIGMOR:
00F5CA  2  85 CC                STA     INDIG           ; store the digit
00F5CC  2  C4 CC                CPY     INDIG           ; compare base with the digit
00F5CE  2  90 42                BCC     RDERR           ; error if the digit >= the base
00F5D0  2  F0 40                BEQ     RDERR
00F5D2  2  E6 CB                INC     DIGCNT          ; increment the number of digits
00F5D4  2  C0 0A                CPY     #10
00F5D6  2  D0 09                BNE     NODECM          ; skip the next part if not using base 10
00F5D8  2  A2 01                LDX     #1
00F5DA  2               DECLP1:
00F5DA  2  B5 C1                LDA     TMP0,X          ; stash the previous 16-bit value for later use
00F5DC  2  95 CE                STA     STASH,X
00F5DE  2  CA                   DEX
00F5DF  2  10 F9                BPL     DECLP1
00F5E1  2               NODECM:
00F5E1  2  A6 CD                LDX     NUMBIT          ; number of bits to shift
00F5E3  2               TIMES2:
00F5E3  2  06 C1                ASL     TMP0            ; shift 16-bit value by specified number of bits
00F5E5  2  26 C2                ROL     TMP0+1
00F5E7  2  B0 29                BCS     RDERR           ; error if we overflowed 16 bits
00F5E9  2  CA                   DEX
00F5EA  2  D0 F7                BNE     TIMES2          ; shift remaining bits
00F5EC  2  C0 0A                CPY     #10
00F5EE  2  D0 14                BNE     NODEC2          ; skip the next part if not using base 10
00F5F0  2  06 CE                ASL     STASH           ; shift the previous 16-bit value one bit left
00F5F2  2  26 CF                ROL     STASH+1
00F5F4  2  B0 1C                BCS     RDERR           ; error if we overflowed 16 bits
00F5F6  2  A5 CE                LDA     STASH           ; add shifted previous value to current value
00F5F8  2  65 C1                ADC     TMP0
00F5FA  2  85 C1                STA     TMP0
00F5FC  2  A5 CF                LDA     STASH+1
00F5FE  2  65 C2                ADC     TMP0+1
00F600  2  85 C2                STA     TMP0+1
00F602  2  B0 0E                BCS     RDERR           ; error if we overflowed 16 bits
00F604  2               NODEC2:
00F604  2  18                   CLC
00F605  2  A5 CC                LDA     INDIG           ; load current digit
00F607  2  65 C1                ADC     TMP0            ; add current digit to low byte
00F609  2  85 C1                STA     TMP0            ; and store result back in low byte
00F60B  2  8A                   TXA                     ; A=0
00F60C  2  65 C2                ADC     TMP0+1          ; add carry to high byte
00F60E  2  85 C2                STA     TMP0+1          ; and store result back in high byte
00F610  2  90 A4                BCC     NUDIG           ; get next digit if we didn't overflow
00F612  2               RDERR:
00F612  2  38                   SEC                     ; set carry to indicate error
00F613  2  24                   .BYTE   $24             ; BIT ZP opcode consumes next byte (CLC)
00F614  2               RDNIL:
00F614  2  18                   CLC                     ; clear carry to indicate success
00F615  2  84 CD                STY     NUMBIT          ; save base of number
00F617  2  68                   PLA                     ; restore X and Y
00F618  2  A8                   TAY
00F619  2  68                   PLA
00F61A  2  AA                   TAX
00F61B  2  A5 CB                LDA     DIGCNT          ; return number of digits in A
00F61D  2  60                   RTS
00F61E  2               
00F61E  2               ; -----------------------------------------------------------------------------
00F61E  2               ; print address
00F61E  2               SHOWAD:
00F61E  2  A5 C3                LDA     TMP2
00F620  2  A6 C4                LDX     TMP2+1
00F622  2               
00F622  2               WRADDR:
00F622  2  48                   PHA                     ; save low byte
00F623  2  8A                   TXA                     ; put high byte in A
00F624  2  20 48 F6             JSR     WRTWO           ; output high byte
00F627  2  68                   PLA                     ; restore low byte
00F628  2               
00F628  2               WRBYTE:
00F628  2  20 48 F6             JSR     WRTWO           ; output byte in A
00F62B  2               
00F62B  2               SPACE:
00F62B  2  A9 20                LDA     #$20            ; output space
00F62D  2  D0 0B                BNE     FLIP
00F62F  2               
00F62F  2               CHOUT:
00F62F  2  C9 0D                CMP     #$0D            ; output char with special handling of CR
00F631  2  D0 07                BNE     FLIP
00F633  2               CRLF:
00F633  2  A9 0D                LDA     #$0D            ; load CR in A
00F635  2  20 BA F9             JSR     CHROUT          ; otherwise output CR+LF
