00F6DE  2               CPY1PX:
00F6DE  2  60                   RTS
00F6DF  2               
00F6DF  2               ; -----------------------------------------------------------------------------
00F6DF  2               ; get start/end addresses and calc difference
00F6DF  2               GETDIF:
00F6DF  2  B0 1F                BCS     GDIFX           ; exit with error if no parameter given
00F6E1  2  20 83 F6             JSR     COPY12          ; save start address in TMP2
00F6E4  2  20 67 F5             JSR     GETPAR          ; get end address in TMP0
00F6E7  2  B0 17                BCS     GDIFX           ; exit with error if no parameter given
00F6E9  2  A5 C1                LDA     TMP0            ; save end address in STASH
00F6EB  2  85 CE                STA     STASH
00F6ED  2  A5 C2                LDA     TMP0+1
00F6EF  2  85 CF                STA     STASH+1
