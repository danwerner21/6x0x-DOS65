00FA88  1  5F 5F 20 20  
00FAA3  1  20 2F 20 2F          .BYTE   " / /_| ___| / _ \___ \  / _ \/ __\",$0D,$0A
00FAA7  1  5F 7C 20 5F  
00FAAB  1  5F 5F 7C 20  
00FAC7  1  7C 20 27 5F          .BYTE   "| '_ \___ \| | | |__) |/ /_)/ /",$0D,$0A
00FACB  1  20 5C 5F 5F  
00FACF  1  5F 20 5C 7C  
00FAE8  1  7C 20 28 5F          .BYTE   "| (_) |__) | |_| / __// ___/ /___",$0D,$0A
00FAEC  1  29 20 7C 5F  
00FAF0  1  5F 29 20 7C  
00FB0B  1  20 5C 5F 5F          .BYTE   " \___/____/ \___/_____\/   \____/",$0D,$0A,$0D,$0A
00FB0F  1  5F 2F 5F 5F  
00FB13  1  5F 5F 2F 20  
