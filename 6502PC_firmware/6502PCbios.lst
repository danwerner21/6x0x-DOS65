00F6C3  2  E6 C4                INC     TMP2+1          ; carry to high byte
00F6C5  2               BUMPEX:
00F6C5  2  60                   RTS
00F6C6  2               
00F6C6  2               ; -----------------------------------------------------------------------------
00F6C6  2               ; subtract 1 from TMP2
00F6C6  2               SUB21:
00F6C6  2  38                   SEC
00F6C7  2  A5 C3                LDA     TMP2            ; decrement low byte
00F6C9  2  E9 01                SBC     #1
00F6CB  2  85 C3                STA     TMP2
00F6CD  2  A5 C4                LDA     TMP2+1          ; borrow from high byte
00F6CF  2  E9 00                SBC     #0
00F6D1  2  85 C4                STA     TMP2+1
00F6D3  2  60                   RTS
00F6D4  2               
00F6D4  2               ; -----------------------------------------------------------------------------
00F6D4  2               ; copy TMP0 to PC
00F6D4  2               COPY1P:
00F6D4  2  B0 08                BCS     CPY1PX          ; do nothing if parameter is empty
00F6D6  2  A5 C1                LDA     TMP0            ; copy low byte
00F6D8  2  A4 C2                LDY     TMP0+1          ; copy high byte
