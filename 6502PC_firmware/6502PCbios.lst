00F74D  2               ; -----------------------------------------------------------------------------
00F74D  2               ; convert binary to BCD
00F74D  2               
00F74D  2               CVTDEC:
00F74D  2  20 83 F6             JSR     COPY12          ; copy value from TMP0 to TMP2
00F750  2  A9 00                LDA     #0
00F752  2  A2 02                LDX     #2              ; clear 3 bytes in work buffer
00F754  2               DECML1:
00F754  2  95 D0                STA     U0AA0,X
00F756  2  CA                   DEX
