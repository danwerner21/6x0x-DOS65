001270  1  D0 D0        	BNE	CHUSB_WRITE1		; LOOP TILL DONE
001272  1               ;
001272  1               	; FINAL CHECK FOR COMPLETION & SUCCESS
001272  1  20 DF 10     	JSR	CH_POLL			; WAIT FOR COMPLETION
001275  1  C9 14        	CMP	#$14			; SUCCESS?
001277  1  D0 04        	BNE	CHUSB_IOERR1		; IF NOT, HANDLE ERROR
001279  1               ;
001279  1  A9 00                lda     #$00
00127B  1  18           	CLC	        		; SIGNAL SUCCESS
00127C  1  60           	RTS
00127D  1               CHUSB_IOERR1:
00127D  1  4C D3 11             JMP     CHUSB_IOERR
001280  1               ;
001280  1               ; INITIATE A DISK SECTOR READ/WRITE OPERATION
001280  1               ; A: READ OR WRITE OPCODE
001280  1               ;
001280  1               CHUSB_RWSTART:
001280  1  20 AB 10     	JSR	CH_CMD			; SEND R/W COMMAND
001283  1               ;
001283  1               ; SEND LBA, 4 BYTES, LITTLE ENDIAN
001283  1  AD 12 06             LDA     debsehd
001286  1  20 BA 10     	JSR	CH_WR			; SEND BYTE
001289  1  AC 10 06             LDY     debcyll
00128C  1  C8                   INY                             ; CYL 0 reserved for boot image
00128D  1  98                   TYA
00128E  1  20 BA 10     	JSR	CH_WR			; SEND BYTE
001291  1  AD 11 06             LDA     debcylm                 ;
001294  1  20 BA 10     	JSR	CH_WR			; SEND BYTE
001297  1  A9 00                LDA     #0              ;
001299  1  20 BA 10     	JSR	CH_WR			; SEND BYTE
00129C  1               ; REQUEST 1 SECTOR
00129C  1  A9 01                LDA     #1                      ;
00129E  1  20 BA 10     	JSR	CH_WR			; SEND BYTE
0012A1  1  60           	RTS
0012A2  1               ;
0012A2  1               
0012A2  1               MESSAGE2:
0012A2  1  20 20 49 4F          .BYTE   "  IO ADDRESS=0x",00
0012A6  1  20 41 44 44  
0012AA  1  52 45 53 53  
0012B2  1               CHMESSAGE1:
0012B2  1  43 48 33 37          .BYTE   "CH375 USB:",00
0012B6  1  35 20 55 53  
0012BA  1  42 3A 00     
0012BD  1               CHMESSAGE2:
0012BD  1  20 20 43 48          .BYTE   "  CH375 DETECTED.",00
0012C1  1  33 37 35 20  
0012C5  1  44 45 54 45  
0012CF  1               CHMESSAGE3:
0012CF  1  20 20 43 48          .BYTE   "  CH375: BLOCKS=0x",00
0012D3  1  33 37 35 3A  
0012D7  1  20 42 4C 4F  
0012E2  1               CHMESSAGE5:
0012E2  1  20 20 43 48          .BYTE   "  CH375 MEDIA ERROR.",00
0012E6  1  33 37 35 20  
0012EA  1  4D 45 44 49  
0012F7  1               CHMESSAGE6:
0012F7  1  20 20 43 48          .BYTE   "  CH375 NOT DETECTED.",00
0012FB  1  33 37 35 20  
0012FF  1  4E 4F 54 20  
00130D  1               CHMESSAGE7:
00130D  1  20 20 43 48          .BYTE   "  CH375 NO MEDIA.",00
001311  1  33 37 35 20  
001315  1  4E 4F 20 4D  
00131F  1               
00131F  1               ;------------------------------------------------------------------------
00131F  1               LFCR:
00131F  1  A9 0A                lda     #10
001321  1  20 75 13             JSR     IOF_OUTCH       ; PRINT CHAR IN ACC
001324  1  A9 0D                lda     #13
001326  1  20 75 13             JSR     IOF_OUTCH       ; PRINT CHAR IN ACC
001329  1  60                   rts
00132A  1               
00132A  1               STRPTR = $50
00132A  1               
00132A  1               ;__WRSTR_______________________________________________________
00132A  1               ;
00132A  1               ; OUTPUT THE STRING POINTED TO BY OUTSTR TO THE SCREEN
00132A  1               ;
00132A  1               ;______________________________________________________________
00132A  1               WRSTR:
00132A  1  A0 00                LDY     #$00            ; LOAD $00 INTO Y
00132C  1               OUTSTRLP:
00132C  1  B1 50                LDA     (STRPTR),Y      ; LOAD NEXT CHAR FROM STRING INTO ACC
00132E  1  C9 00                CMP     #$00            ; IS NULL?
001330  1  F0 0C                BEQ     ENDOUTSTR       ; YES, END PRINT OUT
001332  1  20 75 13             JSR     IOF_OUTCH       ; PRINT CHAR IN ACC
001335  1  E6 50                INC     STRPTR
001337  1  D0 F3                BNE     OUTSTRLP
001339  1  E6 51                INC     STRPTR+1
00133B  1  4C 2C 13             JMP     OUTSTRLP        ; DO NEXT CHAR
00133E  1               ENDOUTSTR:
00133E  1  60                   RTS                     ; RETURN
00133F  1               
00133F  1               PRINT_BYTE:
00133F  1  8E 64 13             STX     SAVX            ; save X
001342  1  20 4F 13             JSR     ASCTWO          ; get hex chars for byte in X (lower) and A (upper)
001345  1  20 75 13             JSR     IOF_OUTCH      ; output upper nybble
001348  1  8A                   TXA                     ; transfer lower to A
001349  1  AE 64 13             LDX     SAVX            ; restore X
00134C  1  4C 75 13             JMP     IOF_OUTCH       ; output lower nybble
00134F  1               ASCTWO:
00134F  1  48                   PHA                     ; save byte
001350  1  20 59 13             JSR     ASCII           ; do low nybble
001353  1  AA                   TAX                     ; save in X
001354  1  68                   PLA                     ; restore byte
001355  1  4A                   LSR     A               ; shift upper nybble down
001356  1  4A                   LSR     A
001357  1  4A                   LSR     A
001358  1  4A                   LSR     A
001359  1               ; convert low nybble in A to hex digit
001359  1               ASCII:
001359  1  29 0F                AND     #$0F            ; clear upper nibble
00135B  1  C9 0A                CMP     #$0A            ; if less than A, skip next step
00135D  1  90 02                BCC     ASC1
00135F  1  69 06                ADC     #6              ; skip ascii chars between 9 and A
001361  1               ASC1:
001361  1  69 30                ADC     #$30            ; add ascii char 0 to value
001363  1  60                   RTS
001364  1               SAVX:
001364  1  00                   .BYTE 00
001365  1               
001365  1               
001365  1                       .INCLUDE "bios_serial.asm"
001365  2               ;__SERIAL DRIVERS________________________________________________________________________________________________________________
001365  2               ;
001365  2               ; 	serial drivers
001365  2               ;
001365  2               ;	Entry points:
001365  2               ;		SERIALINIT  - called during OS init
001365  2               ;		RDSER1	    - read a byte from serial port ('A' POINTS TO BYTE)
001365  2               ;		WRSER1	    - write a byte from serial port  ('A' POINTS TO BYTE)
001365  2               ;		RDSER1W	    - read a byte from serial port ('A' POINTS TO BYTE, WAIT FOR INPUT)
001365  2               ;		SERIALSTATUS- GET UART STATUS
001365  2               ;________________________________________________________________________________________________________________________________
001365  2               ;
001365  2               
001365  2               
001365  2               ;*
001365  2               ;* HARDWARE I/O ADDRESSES
001365  2               ;*
001365  2               
001365  2               UART1DATA       = PC6502_IOSPACE+$84; SERIAL PORT 1 (I/O Card)
001365  2               UART1STATUS     = PC6502_IOSPACE+$85; SERIAL PORT 1 (I/O Card)
001365  2               UART1COMMAND    = PC6502_IOSPACE+$86; SERIAL PORT 1 (I/O Card)
001365  2               UART1CONTROL    = PC6502_IOSPACE+$87; SERIAL PORT 1 (I/O Card)
001365  2               
001365  2               
001365  2               ;Command Register
001365  2               ;No bit is affected by a software reset, however, all bits are set to zero on a hardware reset.
001365  2               ;Bit 7 6 5  configuration
001365  2               ;    x x 0  no parity bit
001365  2               ;    0 0 1  send and receive with odd parity
001365  2               ;    0 1 1  send and receive with even parity
001365  2               ;    1 0 1  send: parity=1; receive: parity not evaluated
001365  2               ;    1 1 1  send: parity=0; receive: parity not evaluated
001365  2               ;
001365  2               ;Bit 4  0: no echo
001365  2               ;       1: echo (received characters are being sent again,
001365  2               ;                bits 2 and 3 must be 0 for that)
001365  2               ;
001365  2               ;Bit 3 2  sender interr.   RTS level   sender
001365  2               ;    0 0  no               high        off
001365  2               ;    0 1  yes              low         on
001365  2               ;    1 0  no               low         on
001365  2               ;    1 1  no               low         send BRK
001365  2               ;
001365  2               ;Bit 1  0: interrupt gets triggered by bit 3 in status register
001365  2               ;       1: no interrupt
001365  2               ;
001365  2               ;Bit 0  0: disable transceiver and interrupts, /DTR high
001365  2               ;       1: enable transceiver and interrupts, /DTR low
001365  2               ;
001365  2               ;Control Register
001365  2               ;Bits 0 to 3 are set to zero on a software reset, and all bits are set to zero on a hardware reset.
001365  2               ;Bit 7  0: 1 stop bit
001365  2               ;       1: a) with 8 data bits and 1 parity bit: 1 stop bit
001365  2               ;          b) with 5 data bits and no parity bit: 1.5 stop bits
001365  2               ;          c) otherwise 2 stop bits
001365  2               ;
001365  2               ;Bit 6 5  data bits
001365  2               ;    0 0  8
001365  2               ;    0 1  7
001365  2               ;    1 0  6
001365  2               ;    1 1  5
001365  2               ;
001365  2               ;Bit 4  0: external receive clock
001365  2               ;       1: builtin clock as receive clock
001365  2               ;
001365  2               ;Bit 3 2 1 0  baud rate
001365  2               ;    0 0 0 0  1/16 times external clock
001365  2               ;    0 0 0 1  50 bps
001365  2               ;    0 0 1 0  75 bps
001365  2               ;    0 0 1 1  109.92 bps
001365  2               ;    0 1 0 0  134.58 bps
001365  2               ;    0 1 0 1  150 bps
001365  2               ;    0 1 1 0  300 bps
001365  2               ;    0 1 1 1  600 bps
001365  2               ;    1 0 0 0  1200 bps
001365  2               ;    1 0 0 1  1800 bps
001365  2               ;    1 0 1 0  2400 bps
001365  2               ;    1 0 1 1  3600 bps
001365  2               ;    1 1 0 0  4800 bps
001365  2               ;    1 1 0 1  7200 bps
001365  2               ;    1 1 1 0  9600 bps
001365  2               ;    1 1 1 1  19200 bps
001365  2               
001365  2               
001365  2               
001365  2               ;__SERIALINIT____________________________________________________________________________________________________________________
001365  2               ;
001365  2               ;	INITIALIZE SERIAL PORTS
001365  2               ;________________________________________________________________________________________________________________________________
001365  2               ;
001365  2               SERIALINIT:
001365  2  A9 00                LDA     #$00            ; RESET UART
001367  2  8D 85 EF             STA     UART1STATUS     ;
00136A  2  A9 0B                LDA     #$0B            ;
00136C  2  8D 86 EF             STA     UART1COMMAND    ;
00136F  2  A9 1E                LDA     #$1E            ; 9600, 8 BITS, NO PARITY, 1 STOP BIT
001371  2  8D 87 EF             STA     UART1CONTROL    ;
001374  2  60                   RTS
001375  2               
001375  2               
001375  2               
001375  2               ;__WRSER1________________________________________________________________________________________________________________________
001375  2               ;
001375  2               ;	WRITE CHARACTER(A) TO UART
001375  2               ;________________________________________________________________________________________________________________________________
001375  2               ;
001375  2               IOF_OUTCH:
001375  2               WRSER1:
001375  2  48                   PHA
001376  2               WRSER1a:
001376  2  AD 85 EF             LDA     UART1STATUS     ; GET STATUS
001379  2  29 10                AND     #%00010000      ; IS TX READY
00137B  2  F0 F9                BEQ     WRSER1a         ; NO, WAIT FOR IT
00137D  2  68                   PLA
00137E  2  8D 84 EF             STA     UART1DATA       ; WRITE DATA
001381  2  60                   RTS
001382  2               
001382  2               ;__RDSER1________________________________________________________________________________________________________________________
001382  2               ;
001382  2               ;	READ CHARACTER FROM UART TO (A)
001382  2               ;________________________________________________________________________________________________________________________________
001382  2               ;
001382  2               IOF_CONIN:
001382  2               RDSER1:
001382  2  AD 85 EF             LDA     UART1STATUS     ; GET STATUS REGISTER
001385  2  29 08                AND     #%00001000      ; IS RX READY
001387  2  F0 04                BEQ     RDSER1N         ; NO, INDICATE NO CHAR
001389  2  AD 84 EF             LDA     UART1DATA       ; GET DATA CHAR
00138C  2  60                   RTS
00138D  2               RDSER1N:
00138D  2  A9 00                LDA     #$00            ;
00138F  2  60                   RTS                     ;
001390  2               
001390  2               ;__RDSER1W_______________________________________________________________________________________________________________________
001390  2               ;
001390  2               ;	READ CHARACTER FROM UART TO (A) - WAIT FOR CHAR
001390  2               ;________________________________________________________________________________________________________________________________
001390  2               ;
001390  2               IOF_CONINW:
001390  2               RDSER1W:
001390  2  20 82 13             JSR     RDSER1
001393  2  C9 00                CMP     #$00
001395  2  F0 F9                BEQ     RDSER1W
001397  2  29 7F                AND     #$7F
001399  2  60                   RTS
00139A  2               
00139A  2               ;__SERIALSTATUS__________________________________________________________________________________________________________________
00139A  2               ;
00139A  2               ;	READ UARD STATUS
00139A  2               ;________________________________________________________________________________________________________________________________
00139A  2               ;
00139A  2               SERIALSTATUS:
00139A  2  AD 85 EF             LDA     UART1STATUS     ; GET STATUS REGISTER
00139D  2  29 08                AND     #%00001000      ; IS RX READY
00139F  2  D0 03                BNE     RDSTAT1         ; INDICATE CHAR
0013A1  2  A9 00                LDA     #$00            ; NO CHAR
0013A3  2  60                   RTS
0013A4  2               RDSTAT1:
0013A4  2  A9 FF                LDA     #$FF            ; DATA CHAR
0013A6  2  60                   RTS
0013A7  2               
0013A7  1               
0013A7  1               
0013A7  1               debcyll         = $0610         ; DEBLOCKED CYLINDER LSB
0013A7  1               debcylm         = $0611         ; DEBLOCKED CYLINDER MSB
0013A7  1               debsehd         = $0612         ; DEBLOCKED SECTOR AND HEAD (HS)
0013A7  1               HSTBUF          = $0400         ; 0400-05ff host buffer
0013A7  1               TEMPWORD2       = $3F           ;
0013A7  1               
