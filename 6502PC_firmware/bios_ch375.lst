00128B  1  A9 57                LDA     #CH_CMD_DSKWRGO ; CONTINUE DISK READ
00128D  1  20 AB 10             JSR     CH_CMD          ; SEND IT
001290  1  E0 10                CPX     #16
001292  1  D0 D0                BNE     CHUSB_WRITE1    ; LOOP TILL DONE
001294  1               ;
001294  1               ; FINAL CHECK FOR COMPLETION & SUCCESS
001294  1  20 E7 10             JSR     CH_POLL         ; WAIT FOR COMPLETION
001297  1  C9 14                CMP     #$14            ; SUCCESS?
001299  1  D0 04                BNE     CHUSB_IOERR1    ; IF NOT, HANDLE ERROR
00129B  1               ;
00129B  1  A9 00                LDA     #$00
00129D  1  18                   CLC                     ; SIGNAL SUCCESS
00129E  1  60                   RTS
00129F  1               CHUSB_IOERR1:
00129F  1  4C F5 11             JMP     CHUSB_IOERR
0012A2  1               ;
0012A2  1               ; INITIATE A DISK SECTOR READ/WRITE OPERATION
0012A2  1               ; A: READ OR WRITE OPCODE
0012A2  1               ;
0012A2  1               CHUSB_RWSTART:
0012A2  1  20 AB 10             JSR     CH_CMD          ; SEND R/W COMMAND
0012A5  1               ;
0012A5  1               ; SEND LBA, 4 BYTES, LITTLE ENDIAN
0012A5  1  AD 12 06             LDA     debsehd
0012A8  1  20 BA 10             JSR     CH_WR           ; SEND BYTE
0012AB  1  AC 10 06             LDY     debcyll
0012AE  1  C8                   INY                     ; CYL 0 reserved for boot image
0012AF  1  98                   TYA
0012B0  1  20 BA 10             JSR     CH_WR           ; SEND BYTE
0012B3  1  AD 11 06             LDA     debcylm         ;
0012B6  1  20 BA 10             JSR     CH_WR           ; SEND BYTE
0012B9  1  A9 00                LDA     #0              ;
0012BB  1  20 BA 10             JSR     CH_WR           ; SEND BYTE
0012BE  1               ; REQUEST 1 SECTOR
0012BE  1  A9 01                LDA     #1              ;
0012C0  1  20 BA 10             JSR     CH_WR           ; SEND BYTE
0012C3  1  60                   RTS
0012C4  1               ;
0012C4  1               
0012C4  1               MESSAGE2:
0012C4  1  20 20 49 4F          .BYTE   "  IO ADDRESS=0x",00
0012C8  1  20 41 44 44  
0012CC  1  52 45 53 53  
0012D4  1               CHMESSAGE1:
0012D4  1  43 48 33 37          .BYTE   "CH375 USB:",00
0012D8  1  35 20 55 53  
0012DC  1  42 3A 00     
0012DF  1               CHMESSAGE2:
0012DF  1  20 20 43 48          .BYTE   "  CH375 DETECTED.",00
0012E3  1  33 37 35 20  
0012E7  1  44 45 54 45  
0012F1  1               CHMESSAGE3:
0012F1  1  20 20 43 48          .BYTE   "  CH375: BLOCKS=0x",00
0012F5  1  33 37 35 3A  
0012F9  1  20 42 4C 4F  
001304  1               CHMESSAGE5:
001304  1  20 20 43 48          .BYTE   "  CH375 MEDIA ERROR.",00
001308  1  33 37 35 20  
00130C  1  4D 45 44 49  
001319  1               CHMESSAGE6:
001319  1  20 20 43 48          .BYTE   "  CH375 NOT DETECTED.",00
00131D  1  33 37 35 20  
001321  1  4E 4F 54 20  
00132F  1               CHMESSAGE7:
00132F  1  20 20 43 48          .BYTE   "  CH375 NO MEDIA.",00
001333  1  33 37 35 20  
001337  1  4E 4F 20 4D  
001341  1               CHMESSAGE8:
001341  1  20 20 43 48          .BYTE   "  CH375 INIT ERROR=0x",00
001345  1  33 37 35 20  
001349  1  49 4E 49 54  
001357  1               ;------------------------------------------------------------------------
001357  1               LFCR:
001357  1  A9 0A                LDA     #10
001359  1  20 AD 13             JSR     IOF_OUTCH       ; PRINT CHAR IN ACC
00135C  1  A9 0D                LDA     #13
00135E  1  20 AD 13             JSR     IOF_OUTCH       ; PRINT CHAR IN ACC
001361  1  60                   RTS
001362  1               
001362  1               STRPTR          = $50
001362  1               
001362  1               ;__WRSTR_______________________________________________________
001362  1               ;
001362  1               ; OUTPUT THE STRING POINTED TO BY OUTSTR TO THE SCREEN
001362  1               ;
001362  1               ;______________________________________________________________
001362  1               WRSTR:
001362  1  A0 00                LDY     #$00            ; LOAD $00 INTO Y
001364  1               OUTSTRLP:
001364  1  B1 50                LDA     (STRPTR),Y      ; LOAD NEXT CHAR FROM STRING INTO ACC
001366  1  C9 00                CMP     #$00            ; IS NULL?
001368  1  F0 0C                BEQ     ENDOUTSTR       ; YES, END PRINT OUT
00136A  1  20 AD 13             JSR     IOF_OUTCH       ; PRINT CHAR IN ACC
00136D  1  E6 50                INC     STRPTR
00136F  1  D0 F3                BNE     OUTSTRLP
001371  1  E6 51                INC     STRPTR+1
001373  1  4C 64 13             JMP     OUTSTRLP        ; DO NEXT CHAR
001376  1               ENDOUTSTR:
001376  1  60                   RTS                     ; RETURN
001377  1               
001377  1               PRINT_BYTE:
001377  1  8E 9C 13             STX     SAVX            ; save X
00137A  1  20 87 13             JSR     ASCTWO          ; get hex chars for byte in X (lower) and A (upper)
00137D  1  20 AD 13             JSR     IOF_OUTCH       ; output upper nybble
001380  1  8A                   TXA                     ; transfer lower to A
001381  1  AE 9C 13             LDX     SAVX            ; restore X
001384  1  4C AD 13             JMP     IOF_OUTCH       ; output lower nybble
001387  1               ASCTWO:
001387  1  48                   PHA                     ; save byte
001388  1  20 91 13             JSR     ASCII           ; do low nybble
00138B  1  AA                   TAX                     ; save in X
00138C  1  68                   PLA                     ; restore byte
00138D  1  4A                   LSR     A               ; shift upper nybble down
00138E  1  4A                   LSR     A
00138F  1  4A                   LSR     A
001390  1  4A                   LSR     A
001391  1               ; convert low nybble in A to hex digit
001391  1               ASCII:
001391  1  29 0F                AND     #$0F            ; clear upper nibble
001393  1  C9 0A                CMP     #$0A            ; if less than A, skip next step
001395  1  90 02                BCC     ASC1
001397  1  69 06                ADC     #6              ; skip ascii chars between 9 and A
001399  1               ASC1:
001399  1  69 30                ADC     #$30            ; add ascii char 0 to value
00139B  1  60                   RTS
00139C  1               SAVX:
00139C  1  00                   .BYTE   00
00139D  1               
00139D  1               
00139D  1                       .INCLUDE "bios_serial.asm"
00139D  2               ;__SERIAL DRIVERS________________________________________________________________________________________________________________
00139D  2               ;
00139D  2               ; 	serial drivers
00139D  2               ;
00139D  2               ;	Entry points:
00139D  2               ;		SERIALINIT  - called during OS init
00139D  2               ;		RDSER1	    - read a byte from serial port ('A' POINTS TO BYTE)
00139D  2               ;		WRSER1	    - write a byte from serial port  ('A' POINTS TO BYTE)
00139D  2               ;		RDSER1W	    - read a byte from serial port ('A' POINTS TO BYTE, WAIT FOR INPUT)
00139D  2               ;		SERIALSTATUS- GET UART STATUS
00139D  2               ;________________________________________________________________________________________________________________________________
00139D  2               ;
00139D  2               
00139D  2               
00139D  2               ;*
00139D  2               ;* HARDWARE I/O ADDRESSES
00139D  2               ;*
00139D  2               
00139D  2               UART1DATA       = PC6502_IOSPACE+$84; SERIAL PORT 1 (I/O Card)
00139D  2               UART1STATUS     = PC6502_IOSPACE+$85; SERIAL PORT 1 (I/O Card)
00139D  2               UART1COMMAND    = PC6502_IOSPACE+$86; SERIAL PORT 1 (I/O Card)
00139D  2               UART1CONTROL    = PC6502_IOSPACE+$87; SERIAL PORT 1 (I/O Card)
00139D  2               
00139D  2               
00139D  2               ;Command Register
00139D  2               ;No bit is affected by a software reset, however, all bits are set to zero on a hardware reset.
00139D  2               ;Bit 7 6 5  configuration
00139D  2               ;    x x 0  no parity bit
00139D  2               ;    0 0 1  send and receive with odd parity
00139D  2               ;    0 1 1  send and receive with even parity
00139D  2               ;    1 0 1  send: parity=1; receive: parity not evaluated
00139D  2               ;    1 1 1  send: parity=0; receive: parity not evaluated
00139D  2               ;
00139D  2               ;Bit 4  0: no echo
00139D  2               ;       1: echo (received characters are being sent again,
00139D  2               ;                bits 2 and 3 must be 0 for that)
00139D  2               ;
00139D  2               ;Bit 3 2  sender interr.   RTS level   sender
00139D  2               ;    0 0  no               high        off
00139D  2               ;    0 1  yes              low         on
00139D  2               ;    1 0  no               low         on
00139D  2               ;    1 1  no               low         send BRK
00139D  2               ;
00139D  2               ;Bit 1  0: interrupt gets triggered by bit 3 in status register
00139D  2               ;       1: no interrupt
00139D  2               ;
00139D  2               ;Bit 0  0: disable transceiver and interrupts, /DTR high
00139D  2               ;       1: enable transceiver and interrupts, /DTR low
00139D  2               ;
00139D  2               ;Control Register
00139D  2               ;Bits 0 to 3 are set to zero on a software reset, and all bits are set to zero on a hardware reset.
00139D  2               ;Bit 7  0: 1 stop bit
00139D  2               ;       1: a) with 8 data bits and 1 parity bit: 1 stop bit
00139D  2               ;          b) with 5 data bits and no parity bit: 1.5 stop bits
00139D  2               ;          c) otherwise 2 stop bits
00139D  2               ;
00139D  2               ;Bit 6 5  data bits
00139D  2               ;    0 0  8
00139D  2               ;    0 1  7
00139D  2               ;    1 0  6
00139D  2               ;    1 1  5
00139D  2               ;
00139D  2               ;Bit 4  0: external receive clock
00139D  2               ;       1: builtin clock as receive clock
00139D  2               ;
00139D  2               ;Bit 3 2 1 0  baud rate
00139D  2               ;    0 0 0 0  1/16 times external clock
00139D  2               ;    0 0 0 1  50 bps
00139D  2               ;    0 0 1 0  75 bps
00139D  2               ;    0 0 1 1  109.92 bps
00139D  2               ;    0 1 0 0  134.58 bps
00139D  2               ;    0 1 0 1  150 bps
00139D  2               ;    0 1 1 0  300 bps
00139D  2               ;    0 1 1 1  600 bps
00139D  2               ;    1 0 0 0  1200 bps
00139D  2               ;    1 0 0 1  1800 bps
00139D  2               ;    1 0 1 0  2400 bps
00139D  2               ;    1 0 1 1  3600 bps
00139D  2               ;    1 1 0 0  4800 bps
00139D  2               ;    1 1 0 1  7200 bps
00139D  2               ;    1 1 1 0  9600 bps
00139D  2               ;    1 1 1 1  19200 bps
00139D  2               
00139D  2               
00139D  2               
00139D  2               ;__SERIALINIT____________________________________________________________________________________________________________________
00139D  2               ;
00139D  2               ;	INITIALIZE SERIAL PORTS
00139D  2               ;________________________________________________________________________________________________________________________________
00139D  2               ;
00139D  2               SERIALINIT:
00139D  2  A9 00                LDA     #$00            ; RESET UART
00139F  2  8D 85 EF             STA     UART1STATUS     ;
0013A2  2  A9 0B                LDA     #$0B            ;
0013A4  2  8D 86 EF             STA     UART1COMMAND    ;
0013A7  2  A9 1E                LDA     #$1E            ; 9600, 8 BITS, NO PARITY, 1 STOP BIT
0013A9  2  8D 87 EF             STA     UART1CONTROL    ;
0013AC  2  60                   RTS
0013AD  2               
0013AD  2               
0013AD  2               
0013AD  2               ;__WRSER1________________________________________________________________________________________________________________________
0013AD  2               ;
0013AD  2               ;	WRITE CHARACTER(A) TO UART
0013AD  2               ;________________________________________________________________________________________________________________________________
0013AD  2               ;
0013AD  2               IOF_OUTCH:
0013AD  2               WRSER1:
0013AD  2  48                   PHA
0013AE  2               WRSER1a:
0013AE  2  AD 85 EF             LDA     UART1STATUS     ; GET STATUS
0013B1  2  29 10                AND     #%00010000      ; IS TX READY
0013B3  2  F0 F9                BEQ     WRSER1a         ; NO, WAIT FOR IT
0013B5  2  68                   PLA
0013B6  2  8D 84 EF             STA     UART1DATA       ; WRITE DATA
0013B9  2  60                   RTS
0013BA  2               
0013BA  2               ;__RDSER1________________________________________________________________________________________________________________________
0013BA  2               ;
0013BA  2               ;	READ CHARACTER FROM UART TO (A)
0013BA  2               ;________________________________________________________________________________________________________________________________
0013BA  2               ;
0013BA  2               IOF_CONIN:
0013BA  2               RDSER1:
0013BA  2  AD 85 EF             LDA     UART1STATUS     ; GET STATUS REGISTER
0013BD  2  29 08                AND     #%00001000      ; IS RX READY
0013BF  2  F0 04                BEQ     RDSER1N         ; NO, INDICATE NO CHAR
0013C1  2  AD 84 EF             LDA     UART1DATA       ; GET DATA CHAR
0013C4  2  60                   RTS
0013C5  2               RDSER1N:
0013C5  2  A9 00                LDA     #$00            ;
0013C7  2  60                   RTS                     ;
0013C8  2               
0013C8  2               ;__RDSER1W_______________________________________________________________________________________________________________________
0013C8  2               ;
0013C8  2               ;	READ CHARACTER FROM UART TO (A) - WAIT FOR CHAR
0013C8  2               ;________________________________________________________________________________________________________________________________
0013C8  2               ;
0013C8  2               IOF_CONINW:
0013C8  2               RDSER1W:
0013C8  2  20 BA 13             JSR     RDSER1
0013CB  2  C9 00                CMP     #$00
0013CD  2  F0 F9                BEQ     RDSER1W
0013CF  2  29 7F                AND     #$7F
0013D1  2  60                   RTS
0013D2  2               
0013D2  2               ;__SERIALSTATUS__________________________________________________________________________________________________________________
0013D2  2               ;
0013D2  2               ;	READ UARD STATUS
0013D2  2               ;________________________________________________________________________________________________________________________________
0013D2  2               ;
0013D2  2               SERIALSTATUS:
0013D2  2  AD 85 EF             LDA     UART1STATUS     ; GET STATUS REGISTER
0013D5  2  29 08                AND     #%00001000      ; IS RX READY
0013D7  2  D0 03                BNE     RDSTAT1         ; INDICATE CHAR
0013D9  2  A9 00                LDA     #$00            ; NO CHAR
0013DB  2  60                   RTS
0013DC  2               RDSTAT1:
0013DC  2  A9 FF                LDA     #$FF            ; DATA CHAR
0013DE  2  60                   RTS
0013DF  2               
0013DF  1               
0013DF  1               
0013DF  1               debcyll         = $0610         ; DEBLOCKED CYLINDER LSB
0013DF  1               debcylm         = $0611         ; DEBLOCKED CYLINDER MSB
0013DF  1               debsehd         = $0612         ; DEBLOCKED SECTOR AND HEAD (HS)
0013DF  1               HSTBUF          = $2400         ; 0400-05ff host buffer
0013DF  1               TEMPWORD2       = $3F           ;
0013DF  1               
