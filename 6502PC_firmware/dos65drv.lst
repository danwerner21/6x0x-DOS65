00C536  2  29 80                AND     #%10000000
00C538  2  F0 0B                BEQ     CH_POLL2        ; CHECK BIT
00C53A  2  CA                   DEX
00C53B  2  D0 F6                BNE     CH_POLL1        ; INNER LOOP AS NEEDED
00C53D  2  88                   DEY
00C53E  2  D0 F1                BNE     CH_POLL0        ; OUTER LOOP AS NEEDED
00C540  2  A8                   TAY
00C541  2  68                   PLA
