00C5DB  2               CHUSB_NOMEDIA:
00C5DB  2  A9 6D                LDA     #<CHMESSAGE7    ;
00C5DD  2  85 41                STA     STRPTR          ;
00C5DF  2  A9 C7                LDA     #>CHMESSAGE7    ;
00C5E1  2  85 42                STA     STRPTR+1        ;
00C5E3  2  20 6F D0             JSR     WRSTR           ; DO PROMPT
00C5E6  2  20 64 D0             JSR     LFCR            ; AND CRLF
00C5E9  2  68                   PLA
00C5EA  2  A8                   TAY
00C5EB  2  68                   PLA
00C5EC  2  AA                   TAX
00C5ED  2  68                   PLA
00C5EE  2  38                   SEC
