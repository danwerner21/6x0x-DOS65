00C55D  2  8A                   TXA
00C55E  2  48                   PHA
00C55F  2  98                   TYA
00C560  2  48                   PHA
00C561  2               ; RESET THE BUS
00C561  2  A9 15                LDA     #CH_CMD_MODE    ; SET MODE COMMAND
00C563  2  20 F9 C4             JSR     CH_CMD          ; SEND IT
00C566  2  A9 07                LDA     #7              ; RESET BUS
00C568  2  20 08 C5             JSR     CH_WR           ; SEND IT
00C56B  2  20 0C C5             JSR     CH_NAP          ; SMALL WAIT
00C56E  2  20 04 C5             JSR     CH_RD           ; GET RESULT
00C571  2  20 0C C5             JSR     CH_NAP          ; SMALL WAIT
00C574  2               ;
00C574  2               ; ACTIVATE USB MODE
00C574  2  A9 15                LDA     #CH_CMD_MODE    ; SET MODE COMMAND
00C576  2  20 F9 C4             JSR     CH_CMD          ; SEND IT
00C579  2  A9 06                LDA     #6              ; USB ENABLED, SEND SOF
00C57B  2  20 08 C5             JSR     CH_WR           ; SEND IT
00C57E  2  20 0C C5             JSR     CH_NAP          ; SMALL WAIT
00C581  2  20 04 C5             JSR     CH_RD           ; GET RESULT
00C584  2  20 0C C5             JSR     CH_NAP          ; SMALL WAIT
00C587  2               
00C587  2               ;
00C587  2  A0 FF                LDY     #$FF
00C589  2               CH_DISKINIT1:
00C589  2  A9 51                LDA     #CH_CMD_DSKINIT
00C58B  2  20 F9 C4             JSR     CH_CMD          ; SEND COMMAND
00C58E  2  A9 FF                LDA     #$FF
00C590  2  A2 FF                LDX     #$FF
00C592  2               :
00C592  2  CA                   DEX
00C593  2  D0 FD                BNE     :-
00C595  2  AA                   TAX
00C596  2  CA                   DEX
00C597  2  8A                   TXA
00C598  2  A2 FF                LDX     #$FF
00C59A  2  C9 00                CMP     #$00
00C59C  2  D0 F4                BNE     :-
00C59E  2               
00C59E  2  20 2B C5             JSR     CH_POLL
00C5A1  2               
00C5A1  2  C9 14                CMP     #$14            ; SUCCESS?
00C5A3  2  F0 0D                BEQ     CHUSB_RESET1A   ; IF SO, CHECK READY
00C5A5  2  C9 16                CMP     #$16            ; NO MEDIA
00C5A7  2  F0 32                BEQ     CHUSB_NOMEDIA   ; HANDLE IT
00C5A9  2  20 0C C5             JSR     CH_NAP          ; SMALL DELAY
00C5AC  2  88                   DEY
00C5AD  2  D0 DA                BNE     CH_DISKINIT1    ; LOOP AS NEEDED
00C5AF  2  4C D4 C5             JMP     CH_DISKINIT_TO  ; HANDLE TIMEOUT
00C5B2  2               
00C5B2  2               CHUSB_RESET1A:
00C5B2  2  20 F0 C5             JSR     CH_DSKSIZ       ; GET AND RECORD DISK SIZE
00C5B5  2  90 16                BCC     CHUSB_RESET1B
00C5B7  2  48                   PHA
00C5B8  2  A9 7F                LDA     #<CHMESSAGE8    ;
00C5BA  2  85 41                STA     STRPTR          ;
00C5BC  2  A9 C7                LDA     #>CHMESSAGE8    ;
00C5BE  2  85 42                STA     STRPTR+1        ;
00C5C0  2  20 6F D0             JSR     WRSTR           ; DO PROMPT
00C5C3  2  68                   PLA
00C5C4  2  20 84 D0             JSR     PRINT_BYTE
00C5C7  2  20 64 D0             JSR     LFCR
00C5CA  2  4C D4 C5             JMP     CH_DISKINIT_TO
00C5CD  2               
00C5CD  2               CHUSB_RESET1B:
00C5CD  2  68                   PLA
00C5CE  2  A8                   TAY
00C5CF  2  68                   PLA
00C5D0  2  AA                   TAX
00C5D1  2  68                   PLA
00C5D2  2  18                   CLC
00C5D3  2  60                   RTS
