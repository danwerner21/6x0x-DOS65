00D064  1               LFCR:
00D064  1  A9 0A                LDA     #10
00D066  1  20 B5 C0             JSR     WRSER1          ; PRINT CHAR IN ACC
00D069  1  A9 0D                LDA     #13
00D06B  1  20 B5 C0             JSR     WRSER1          ; PRINT CHAR IN ACC
