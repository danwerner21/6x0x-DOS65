00C54A  2  20 0C C5             JSR     CH_NAP          ; SMALL DELAY
00C54D  2  20 04 C5             JSR     CH_RD           ; GET RESULT
00C550  2  8D 5B C5             STA     CHRESULT
00C553  2  68                   PLA
00C554  2  A8                   TAY
00C555  2  68                   PLA
00C556  2  AA                   TAX
