00CA1C  2               :
00CA1C  2  A2 00                LDX     #$00
00CA1E  2  A0 00                LDY     #$00
00CA20  2               :
00CA20  2  AD 02 E1             LDA     ESP_STAT
00CA23  2  29 08                AND     #ESP1_RDY
00CA25  2  D0 10                BNE     :+
00CA27  2  CA                   DEX
00CA28  2  E0 00                CPX     #$00
00CA2A  2  D0 F4                BNE     :-
00CA2C  2  88                   DEY
00CA2D  2  C0 00                CPY     #$00
00CA2F  2  D0 EF                BNE     :-
00CA31  2  68                   PLA
00CA32  2  A8                   TAY
00CA33  2  68                   PLA
00CA34  2  AA                   TAX
00CA35  2  38                   SEC
00CA36  2  60                   RTS
00CA37  2               :
00CA37  2  68                   PLA
00CA38  2  A8                   TAY
00CA39  2  68                   PLA
00CA3A  2  AA                   TAX
00CA3B  2  AD 01 E1             LDA     ESP1_DAT
00CA3E  2  18                   CLC
00CA3F  2  60                   RTS
