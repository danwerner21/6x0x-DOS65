00C637  2               CH_CMD_WR:
00C637  2  A9 2B                LDA     #CH_CMD_WR5
00C639  2  4C F9 C4             JMP     CH_CMD
00C63C  2               
00C63C  2               DSKBUFTMP:
00C63C  2  00 04                .WORD   hstbuf
00C63E  2  40 04                .WORD   hstbuf+64
00C640  2  80 04                .WORD   hstbuf+128
00C642  2  C0 04                .WORD   hstbuf+192
00C644  2  00 05                .WORD   hstbuf+256
00C646  2  40 05                .WORD   hstbuf+320
00C648  2  80 05                .WORD   hstbuf+384
00C64A  2  C0 05                .WORD   hstbuf+448
