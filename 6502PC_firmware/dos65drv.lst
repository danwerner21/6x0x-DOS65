00CA6A  2               
00CA6A  1                       .INCLUDE "bios_multi.asm"
00CA6A  2               ;__MULTI IO DRIVERS______________________________________________________________________________________________________________
00CA6A  2               ;
00CA6A  2               ; 	DOS/65 ISA MULTI IO drivers for 6502PC
00CA6A  2               ;
00CA6A  2               ;	Entry points:
00CA6A  2               ;		MULTIOINIT  - CALLED during OS init
00CA6A  2               ;		KBD_GETKEY  - read a character from the ps/2 keyboard ('A' POINTS TO BYTE)
00CA6A  2               ;		LPT_OUT	    - send a character to the printer
00CA6A  2               ;________________________________________________________________________________________________________________________________
00CA6A  2               ;
00CA6A  2               ;*
00CA6A  2               ;*        HARDWARE I/O ADDRESSES
00CA6A  2               ;*
00CA6A  2               ;
00CA6A  2               MULTIO_BASE     = PC6502_IO+$3E0
00CA6A  2               KBD_DAT         = MULTIO_BASE+$1E
00CA6A  2               KBD_ST          = MULTIO_BASE+$1F
00CA6A  2               KBD_CMD         = MULTIO_BASE+$1F
00CA6A  2               
00CA6A  2               LPT_0           = MULTIO_BASE+$10
00CA6A  2               LPT_1           = MULTIO_BASE+$11
00CA6A  2               LPT_2           = MULTIO_BASE+$12
00CA6A  2               
00CA6A  2               
00CA6A  2               ;__________________________________________________________________________________________________
00CA6A  2               ;
00CA6A  2               ; STATUS BITS (FOR KBD_STATUS)
00CA6A  2               ;
00CA6A  2               KBD_EXT         = $01           ; BIT 0, EXTENDED SCANCODE ACTIVE
00CA6A  2               KBD_BREAK       = $02           ; BIT 1, THIS IS A KEY UP (BREAK) EVENT
00CA6A  2               KBD_KEYRDY      = $80           ; BIT 7, INDICATES A DECODED KEYCODE IS READY
00CA6A  2               ;
00CA6A  2               ; STATE BITS (FOR KBD_STATE, KBD_LSTATE, KBD_RSTATE)
00CA6A  2               ;
00CA6A  2               KBD_SHIFT       = $01           ; BIT 0, SHIFT ACTIVE (PRESSED)
00CA6A  2               KBD_CTRL        = $02           ; BIT 1, CONTROL ACTIVE (PRESSED)
00CA6A  2               KBD_ALT         = $04           ; BIT 2, ALT ACTIVE (PRESSED)
00CA6A  2               KBD_WIN         = $08           ; BIT 3, WIN ACTIVE (PRESSED)
00CA6A  2               KBD_SCRLCK      = $10           ; BIT 4, CAPS LOCK ACTIVE (TOGGLED ON)
00CA6A  2               KBD_NUMLCK      = $20           ; BIT 5, NUM LOCK ACTIVE (TOGGLED ON)
00CA6A  2               KBD_CAPSLCK     = $40           ; BIT 6, SCROLL LOCK ACTIVE (TOGGLED ON)
00CA6A  2               KBD_NUMPAD      = $80           ; BIT 7, NUM PAD KEY (KEY PRESSED IS ON NUM PAD)
00CA6A  2               NOT_KBD_NUMPAD  = $7F           ; BIT 7, NUM PAD KEY (KEY PRESSED IS ON NUM PAD)
00CA6A  2               ;
00CA6A  2               KBD_DEFRPT      = $40           ; DEFAULT REPEAT RATE (.5 SEC DELAY, 30CPS)
00CA6A  2               KBD_DEFSTATE    = KBD_NUMLCK|KBD_CAPSLCK|KBD_SCRLCK
00CA6A  2               ;
00CA6A  2               ; DEFAULT STATE (NUM LOCK ON)
00CA6A  2               
00CA6A  2               KBD_WAITTO      = $30FF         ; DEFAULT TIMEOUT
00CA6A  2               LPT_WAITTO      = $30FF         ; DEFAULT TIMEOUT
00CA6A  2               ;
00CA6A  2               ;__________________________________________________________________________________________________
00CA6A  2               ; DATA
00CA6A  2               ;__________________________________________________________________________________________________
00CA6A  2               ;
00CA6A  2               TMPKEY:
00CA6A  2  00                   .BYTE   0
00CA6B  2               KBD_SCANCODE:
00CA6B  2  00                   .BYTE   0               ; RAW SCANCODE
00CA6C  2               KBD_KEYCODE:
00CA6C  2  00                   .BYTE   0               ; RESULTANT KEYCODE AFTER DECODING
00CA6D  2               KBD_STATE:
00CA6D  2  70                   .BYTE   KBD_DEFSTATE    ; STATE BITS (SEE ABOVE)
00CA6E  2               KBD_LSTATE:
00CA6E  2  00                   .BYTE   0               ; STATE BITS FOR "LEFT" KEYS
00CA6F  2               KBD_RSTATE:
00CA6F  2  00                   .BYTE   0               ; STATE BITS FOR "RIGHT" KEYS
00CA70  2               KBD_STATUS:
00CA70  2  00                   .BYTE   0               ; CURRENT STATUS BITS (SEE ABOVE)
00CA71  2               KBD_REPEAT:
00CA71  2  40                   .BYTE   KBD_DEFRPT      ; CURRENT REPEAT RATE
00CA72  2               KBD_IDLE:
00CA72  2  00                   .BYTE   0               ; IDLE COUNT
00CA73  2               KBD_TEMP:
00CA73  2  00 00                .BYTE   0,0             ; WORKING STORAGE
00CA75  2               
00CA75  2               ;
00CA75  2               ;  IBM PC STANDARD PARALLEL PORT (SPP):
00CA75  2               ;
00CA75  2               ;  PORT 0 (OUTPUT):
00CA75  2               ;
00CA75  2               ;	D7	D6	D5	D4	D3	D2	D1	D0
00CA75  2               ;     +-------+-------+-------+-------+-------+-------+-------+-------+
00CA75  2               ;     | PD7   | PD6   | PD5   | PD4   | PD3   | PD2   | PD1   | PD0   |
00CA75  2               ;     +-------+-------+-------+-------+-------+-------+-------+-------+
00CA75  2               ;
00CA75  2               ;  PORT 1 (INPUT):
00CA75  2               ;
00CA75  2               ;	D7	D6	D5	D4	D3	D2	D1	D0
00CA75  2               ;     +-------+-------+-------+-------+-------+-------+-------+-------+
00CA75  2               ;     | /BUSY | /ACK  | POUT  | SEL   | /ERR  | 0     | 0     | 0     |
00CA75  2               ;     +-------+-------+-------+-------+-------+-------+-------+-------+
00CA75  2               ;
00CA75  2               ;  PORT 2 (OUTPUT):
00CA75  2               ;
00CA75  2               ;	D7	D6	D5	D4	D3	D2	D1	D0
00CA75  2               ;     +-------+-------+-------+-------+-------+-------+-------+-------+
00CA75  2               ;     | STAT1 | STAT0 | ENBL  | PINT  | SEL   | RES   | LF    | STB   |
00CA75  2               ;     +-------+-------+-------+-------+-------+-------+-------+-------+
00CA75  2               ;
00CA75  2               ;
00CA75  2               ;
00CA75  2               ;
00CA75  2               ;  IEC PORT (OUTPUT):
00CA75  2               ;
00CA75  2               ;	D7	D6	D5	D4	D3	D2	D1	D0
00CA75  2               ;     +-------+-------+-------+-------+-------+-------+-------+-------+
00CA75  2               ;     | 0     | 0     | 0     | 0     | 0     | SERDTA| SERCLK| SERATN|
00CA75  2               ;     +-------+-------+-------+-------+-------+-------+-------+-------+
00CA75  2               ;
00CA75  2               ;  IEC PORT (OUTPUT):
00CA75  2               ;
00CA75  2               ;	D7	D6	D5	D4	D3	D2	D1	D0
00CA75  2               ;     +-------+-------+-------+-------+-------+-------+-------+-------+
00CA75  2               ;     | 0     | 0     | 0     | 0     | 0     | 0     | SERDTA| SERCLK|
00CA75  2               ;     +-------+-------+-------+-------+-------+-------+-------+-------+
00CA75  2               ;
00CA75  2               ;__________________________________________________________________________________________________
00CA75  2               ; MULTI IO INITIALIZATION
00CA75  2               ;__________________________________________________________________________________________________
00CA75  2               ;
00CA75  2               MULTIOINIT:
00CA75  2               ;
00CA75  2  20 64 D0             JSR     LFCR            ; AND CRLF
00CA78  2  A9 3A                LDA     #<MIOMESSAGE1   ;
00CA7A  2  85 41                STA     STRPTR          ;
00CA7C  2  A9 CE                LDA     #>MIOMESSAGE1   ;
00CA7E  2  85 42                STA     STRPTR+1        ;
00CA80  2  20 6F D0             JSR     WRSTR           ; DO PROMPT
00CA83  2  20 64 D0             JSR     LFCR            ; AND CRLF
00CA86  2               ; KEYBOARD INITIALIZATION
00CA86  2  A9 55                LDA     #<MESSAGE2      ;
00CA88  2  85 41                STA     STRPTR          ;
00CA8A  2  A9 C3                LDA     #>MESSAGE2      ;
00CA8C  2  85 42                STA     STRPTR+1        ;
00CA8E  2  20 6F D0             JSR     WRSTR           ; DO PROMPT
00CA91  2  A9 E3                LDA     #>MULTIO_BASE   ; GET BASE PORT
00CA93  2  20 84 D0             JSR     PRINT_BYTE      ; PRINT BASE PORT
00CA96  2  A9 E0                LDA     #<MULTIO_BASE   ; GET BASE PORT
00CA98  2  20 84 D0             JSR     PRINT_BYTE      ; PRINT BASE PORT
00CA9B  2  20 64 D0             JSR     LFCR            ; AND CRLF
00CA9E  2               ;
00CA9E  2  20 C5 CA             JSR     KBD_PROBE       ; DETECT A KEYBOARD
00CAA1  2               
00CAA1  2               ; LPT INITIALIZATION ROUTINE
00CAA1  2  A9 76                LDA     #<MIOMESSAGE5   ;
00CAA3  2  85 41                STA     STRPTR          ;
00CAA5  2  A9 CE                LDA     #>MIOMESSAGE5   ;
00CAA7  2  85 42                STA     STRPTR+1        ;
00CAA9  2  20 6F D0             JSR     WRSTR           ; DO PROMPT
00CAAC  2  20 64 D0             JSR     LFCR            ; AND CRLF
00CAAF  2               
00CAAF  2  A9 00                LDA     #$00
00CAB1  2  8D F0 E3             STA     LPT_0           ; PORT 0 (DATA)
00CAB4  2  A9 08                LDA     #%00001000      ; SELECT AND ASSERT RESET, LEDS OFF
00CAB6  2  8D F2 E3             STA     LPT_2           ; PORT 2 (STATUS)
00CAB9  2  20 1E CE             JSR     LDELAY          ; HALF SECOND DELAY
00CABC  2  A9 0C                LDA     #%00001100      ; SELECT AND DEASSERT RESET, LEDS OFF
00CABE  2  8D F2 E3             STA     LPT_2           ; PORT 2 (STATUS)
00CAC1  2               ;
00CAC1  2  18                   CLC                     ; SIGNAL SUCCESS
00CAC2  2  60                   RTS                     ; RETURN
00CAC3  2               :
00CAC3  2  38                   SEC
00CAC4  2  60                   RTS                     ; DONE
00CAC5  2               
00CAC5  2               
00CAC5  2               KBD_PROBE:
00CAC5  2               ;
00CAC5  2  A9 AA                LDA     #$AA            ; CONTROLLER SELF TEST
00CAC7  2  20 33 CB             JSR     KBD_PUTCMD      ; SEND IT
00CACA  2  B0 19                BCS     KBD_TIMEOUT1
00CACC  2  20 7B CB             JSR     KBD_GETDATA     ; CONTROLLER SHOULD RESPOND WITH $55 (ACK)
00CACF  2  B0 25                BCS     KBD_TIMEOUT2
00CAD1  2               ;
00CAD1  2  C9 55                CMP     #$55            ; IS IT THERE?
00CAD3  2  F0 32                BEQ     :+              ; IF SO, CONTINUE
00CAD5  2  A9 48                LDA     #<MIOMESSAGE3   ;
00CAD7  2  85 41                STA     STRPTR          ;
00CAD9  2  A9 CE                LDA     #>MIOMESSAGE3   ;
00CADB  2  85 42                STA     STRPTR+1        ;
00CADD  2  20 6F D0             JSR     WRSTR
00CAE0  2  20 64 D0             JSR     LFCR            ; AND CRLF
00CAE3  2               ;
00CAE3  2               KBD_ERROR:
00CAE3  2  38                   SEC                     ; SET ERROR
00CAE4  2  60                   RTS                     ; BAIL OUT
00CAE5  2               KBD_TIMEOUT1:
00CAE5  2  A9 8A                LDA     #<MIOMESSAGE6   ;
00CAE7  2  85 41                STA     STRPTR          ;
00CAE9  2  A9 CE                LDA     #>MIOMESSAGE6   ;
00CAEB  2  85 42                STA     STRPTR+1        ;
00CAED  2  20 6F D0             JSR     WRSTR
00CAF0  2  20 64 D0             JSR     LFCR            ; AND CRLF
00CAF3  2  4C E3 CA             JMP     KBD_ERROR
00CAF6  2               KBD_TIMEOUT2:
00CAF6  2  A9 A8                LDA     #<MIOMESSAGE7   ;
00CAF8  2  85 41                STA     STRPTR          ;
00CAFA  2  A9 CE                LDA     #>MIOMESSAGE7   ;
00CAFC  2  85 42                STA     STRPTR+1        ;
00CAFE  2  20 6F D0             JSR     WRSTR
00CB01  2  20 64 D0             JSR     LFCR            ; AND CRLF
00CB04  2  4C E3 CA             JMP     KBD_ERROR
00CB07  2               
00CB07  2               ;
00CB07  2               :
00CB07  2  A9 62                LDA     #<MIOMESSAGE4   ;
00CB09  2  85 41                STA     STRPTR          ;
00CB0B  2  A9 CE                LDA     #>MIOMESSAGE4   ;
00CB0D  2  85 42                STA     STRPTR+1        ;
00CB0F  2  20 6F D0             JSR     WRSTR
00CB12  2  20 64 D0             JSR     LFCR            ; AND CRLF
00CB15  2               
00CB15  2               ;
00CB15  2  A9 60                LDA     #$60            ; SET COMMAND REGISTER
00CB17  2  20 33 CB             JSR     KBD_PUTCMD      ; SEND IT
00CB1A  2  B0 C7                BCS     KBD_ERROR
00CB1C  2  A9 20                LDA     #$20            ; XLAT DISABLED, MOUSE DISABLED, NO INTS
00CB1E  2  20 57 CB             JSR     KBD_PUTDATA     ; SEND IT
00CB21  2  B0 C0                BCS     KBD_ERROR
00CB23  2               
00CB23  2  20 7B CB             JSR     KBD_GETDATA     ; GOBBLE UP $AA FROM POWER UP, AS NEEDED
00CB26  2  B0 BB                BCS     KBD_ERROR
00CB28  2               
00CB28  2  20 B7 CB             JSR     KBD_RESET       ; RESET THE KEYBOARD
00CB2B  2  20 D6 CB             JSR     KBD_SETLEDS     ; UPDATE LEDS BASED ON CURRENT TOGGLE STATE BITS
00CB2E  2  20 00 CC             JSR     KBD_SETRPT      ; UPDATE REPEAT RATE BASED ON CURRENT SETTING
00CB31  2               
00CB31  2  18                   CLC                     ; SIGNAL SUCCESS
00CB32  2  60                   RTS
00CB33  2               
00CB33  2               
00CB33  2               ;
00CB33  2               ;__________________________________________________________________________________________________
00CB33  2               ; HARDWARE INTERFACE
00CB33  2               ;__________________________________________________________________________________________________
00CB33  2               ;
00CB33  2               ;__________________________________________________________________________________________________
00CB33  2               KBD_PUTCMD:
00CB33  2               ; PUT A CMD BYTE FROM A TO THE KEYBOARD INTERFACE WITH TIMEOUT
00CB33  2               ;
00CB33  2  48                   PHA
00CB34  2  A2 FF                LDX     #<KBD_WAITTO    ; SETUP TO LOOP
00CB36  2  A0 30                LDY     #>KBD_WAITTO    ; SETUP TO LOOP
00CB38  2               KBD_PUTCMD0:
00CB38  2  AD FF E3             LDA     KBD_ST          ; STATUS PORT
00CB3B  2  29 02                AND     #$02            ; ISOLATE EMPTY BIT
00CB3D  2  C9 00                CMP     #$00
00CB3F  2  F0 10                BEQ     KBD_PUTCMD1     ; EMPTY, GO TO WRITE
00CB41  2  20 0C CE             JSR     DELAY           ; WAIT A BIT
00CB44  2  CA                   DEX
00CB45  2  E0 00                CPX     #$00
00CB47  2  D0 EF                BNE     KBD_PUTCMD0     ; LOOP UNTIL COUNTER EXHAUSTED
00CB49  2  88                   DEY
00CB4A  2  C0 00                CPY     #$00
00CB4C  2  D0 EA                BNE     KBD_PUTCMD0     ; LOOP UNTIL COUNTER EXHAUSTED
00CB4E  2  68                   PLA
00CB4F  2  38                   SEC                     ; TIMED OUT
00CB50  2  60                   RTS
00CB51  2               KBD_PUTCMD1:
00CB51  2  68                   PLA
00CB52  2  8D FF E3             STA     KBD_CMD         ; WRITE TO COMMAND PORT
00CB55  2  18                   CLC                     ; SIGNAL SUCCESS
00CB56  2  60                   RTS
00CB57  2               ;
00CB57  2               ;__________________________________________________________________________________________________
00CB57  2               KBD_PUTDATA:
00CB57  2               ;
00CB57  2               ; PUT A DATA BYTE FROM A TO THE KEYBOARD INTERFACE WITH TIMEOUT
00CB57  2               ;
00CB57  2  48                   PHA
00CB58  2  A2 FF                LDX     #<KBD_WAITTO    ; SETUP TO LOOP
00CB5A  2  A0 30                LDY     #>KBD_WAITTO    ; SETUP TO LOOP
00CB5C  2               KBD_PUTDATA0:
00CB5C  2  AD FF E3             LDA     KBD_ST          ; STATUS PORT
00CB5F  2  29 02                AND     #$02            ; ISOLATE OUTPUT EMPTY BIT
00CB61  2  C9 00                CMP     #$00
00CB63  2  F0 10                BEQ     KBD_PUTDATA1    ; EMPTY, GO TO WRITE
00CB65  2  20 0C CE             JSR     DELAY           ; WAIT A BIT
00CB68  2  CA                   DEX
00CB69  2  E0 00                CPX     #$00
00CB6B  2  D0 EF                BNE     KBD_PUTDATA0    ; LOOP UNTIL COUNTER EXHAUSTED
00CB6D  2  88                   DEY
00CB6E  2  C0 00                CPY     #$00
00CB70  2  D0 EA                BNE     KBD_PUTDATA0    ; LOOP UNTIL COUNTER EXHAUSTED
00CB72  2  68                   PLA
00CB73  2  38                   SEC                     ; TIMED OUT
00CB74  2  60                   RTS
00CB75  2               KBD_PUTDATA1:
00CB75  2  68                   PLA
00CB76  2  8D FE E3             STA     KBD_DAT         ; WRITE TO DATA PORT
00CB79  2  18                   CLC                     ; SIGNAL SUCCESS
00CB7A  2  60                   RTS
00CB7B  2               ;
00CB7B  2               ;__________________________________________________________________________________________________
00CB7B  2               KBD_GETDATA:
00CB7B  2               ;
00CB7B  2               ; GET A RAW DATA BYTE FROM KEYBOARD INTERFACE INTO A WITH TIMEOUT
00CB7B  2               ;
00CB7B  2  8A                   TXA
00CB7C  2  48                   PHA
00CB7D  2  98                   TYA
00CB7E  2  48                   PHA
00CB7F  2  A2 FF                LDX     #<KBD_WAITTO    ; SETUP TO LOOP
00CB81  2  A0 30                LDY     #>KBD_WAITTO    ; SETUP TO LOOP
00CB83  2               KBD_GETDATA0:
00CB83  2  AD FF E3             LDA     KBD_ST          ; GET STATUS PORT
00CB86  2  29 01                AND     #$01            ; ISOLATE INPUT PENDING BIT
00CB88  2  C9 00                CMP     #$00
00CB8A  2  D0 15                BNE     KBD_GETDATA1    ; READY, GET DATA
00CB8C  2  20 0C CE             JSR     DELAY           ; WAIT A BIT
00CB8F  2  CA                   DEX
00CB90  2  E0 00                CPX     #$00
00CB92  2  D0 EF                BNE     KBD_GETDATA0    ; LOOP UNTIL COUNTER EXHAUSTED
00CB94  2  88                   DEY
00CB95  2  C0 00                CPY     #$00
00CB97  2  D0 EA                BNE     KBD_GETDATA0    ; LOOP UNTIL COUNTER EXHAUSTED
00CB99  2  68                   PLA
00CB9A  2  A8                   TAY
00CB9B  2  68                   PLA
00CB9C  2  AA                   TAX
00CB9D  2  A9 00                LDA     #$00
00CB9F  2  38                   SEC                     ; NO DATA, RETURN ZERO
00CBA0  2  60                   RTS
00CBA1  2               KBD_GETDATA1:
00CBA1  2  68                   PLA
00CBA2  2  A8                   TAY
00CBA3  2  68                   PLA
00CBA4  2  AA                   TAX
00CBA5  2  AD FE E3             LDA     KBD_DAT         ; GET DATA PORT
00CBA8  2  18                   CLC                     ; SET FLAGS
00CBA9  2  60                   RTS
00CBAA  2               ;
00CBAA  2               ;__________________________________________________________________________________________________
00CBAA  2               KBD_GETDATAX:
00CBAA  2               ;
00CBAA  2               ; GET A RAW DATA BYTE FROM KEYBOARD INTERFACE INTO A WITH NO TIMEOUT
00CBAA  2               ;
00CBAA  2  AD FF E3             LDA     KBD_ST          ; STATUS PORT
00CBAD  2  29 01                AND     #$01            ; ISOLATE INPUT PENDING BIT
00CBAF  2  C9 00                CMP     #$00
00CBB1  2  D0 EE                BNE     KBD_GETDATA1    ; BYTE PENDING, GO GET IT
00CBB3  2  A9 00                LDA     #$00
00CBB5  2  38                   SEC                     ; NO DATA, RETURN ZERO
00CBB6  2  60                   RTS
00CBB7  2               ;
00CBB7  2               ;__________________________________________________________________________________________________
00CBB7  2               ; RESET KEYBOARD
00CBB7  2               ;__________________________________________________________________________________________________
00CBB7  2               ;
00CBB7  2               KBD_RESET:
00CBB7  2  A9 FF                LDA     #$FF            ; RESET COMMAND
00CBB9  2  20 57 CB             JSR     KBD_PUTDATA     ; SEND IT
00CBBC  2  20 7B CB             JSR     KBD_GETDATA     ; GET THE ACK
00CBBF  2  A2 00                LDX     #$00            ; SETUP LOOP COUNTER
00CBC1  2  A0 F1                LDY     #$F1            ; SETUP LOOP COUNTER
00CBC3  2               KBD_RESET0:
00CBC3  2  20 7B CB             JSR     KBD_GETDATA     ; TRY TO GET THE RESPONSE
00CBC6  2  D0 0C                BNE     KBD_RESET1      ; GOT A BYTE?  IF SO, GET OUT OF LOOP
00CBC8  2  CA                   DEX
00CBC9  2  E0 00                CPX     #$00
00CBCB  2  D0 F6                BNE     KBD_RESET0      ; LOOP TILL COUNTER EXHAUSTED
00CBCD  2  88                   DEY
00CBCE  2  C0 00                CPY     #$00
00CBD0  2  D0 F1                BNE     KBD_RESET0      ; LOOP TILL COUNTER EXHAUSTED
00CBD2  2  38                   SEC                     ; SIGNAL FAILURE
00CBD3  2  60                   RTS                     ; DONE
00CBD4  2               KBD_RESET1:
00CBD4  2  18                   CLC                     ; SIGNAL SUCCESS (RESPONSE IS IGNORED...)
00CBD5  2  60                   RTS                     ; DONE
00CBD6  2               ;
00CBD6  2               ;__________________________________________________________________________________________________
00CBD6  2               ; UPDATE KEYBOARD LEDS BASED ON CURRENT TOGGLE FLAGS
00CBD6  2               ;__________________________________________________________________________________________________
00CBD6  2               ;
00CBD6  2               KBD_SETLEDS:
00CBD6  2  A9 ED                LDA     #$ED            ; SET/RESET LED'S COMMAND
00CBD8  2  20 57 CB             JSR     KBD_PUTDATA     ; SEND THE COMMAND
00CBDB  2  20 7B CB             JSR     KBD_GETDATA     ; READ THE RESPONSE
00CBDE  2  C9 FA                CMP     #$FA            ; MAKE SURE WE GET ACK
00CBE0  2  F0 02                BEQ     :+
00CBE2  2               
00CBE2  2  38                   SEC
00CBE3  2  60                   RTS                     ; ABORT IF NO ACK
00CBE4  2               :
00CBE4  2  AD 6D CA             LDA     KBD_STATE       ; LOAD THE STATE BYTE
00CBE7  2  6A                   ROR     A               ; ROTATE TOGGLE KEY BITS AS NEEDED
00CBE8  2  6A                   ROR     A
00CBE9  2  6A                   ROR     A
00CBEA  2  6A                   ROR     A
00CBEB  2  29 07                AND     #$07            ; CLEAR THE IRRELEVANT BITS
00CBED  2  20 57 CB             JSR     KBD_PUTDATA     ; SEND THE LED DATA
00CBF0  2  20 7B CB             JSR     KBD_GETDATA     ; READ THE ACK
00CBF3  2  C9 FA                CMP     #$FA            ; MAKE SURE WE GET ACK
00CBF5  2  F0 02                BEQ     :+
00CBF7  2               
00CBF7  2  38                   SEC
00CBF8  2  60                   RTS                     ; ABORT IF NO ACK
00CBF9  2               :
00CBF9  2  A9 00                LDA     #$00            ; A=0
00CBFB  2  8D 70 CA             STA     KBD_STATUS      ; CLEAR STATUS
00CBFE  2  18                   CLC
00CBFF  2  60                   RTS
00CC00  2               ;
00CC00  2               ;__________________________________________________________________________________________________
00CC00  2               ; UPDATE KEYBOARD REPEAT RATE BASED ON CURRENT SETTING
00CC00  2               ;__________________________________________________________________________________________________
00CC00  2               ;
00CC00  2               KBD_SETRPT:
00CC00  2  A9 F3                LDA     #$F3            ; COMMAND = SET TYPEMATIC RATE/DELAY
00CC02  2  20 57 CB             JSR     KBD_PUTDATA     ; SEND IT
00CC05  2  20 7B CB             JSR     KBD_GETDATA     ; GET THE ACK
00CC08  2  C9 FA                CMP     #$FA            ; MAKE SURE WE GET ACK
00CC0A  2  F0 02                BEQ     :+
00CC0C  2               
00CC0C  2  38                   SEC
00CC0D  2  60                   RTS                     ; ABORT IF NO ACK
00CC0E  2               :
00CC0E  2  AD 71 CA             LDA     KBD_REPEAT      ; LOAD THE CURRENT RATE/DELAY BYTE
00CC11  2  20 57 CB             JSR     KBD_PUTDATA     ; SEND IT
00CC14  2  20 7B CB             JSR     KBD_GETDATA     ; GET THE ACK
00CC17  2  C9 FA                CMP     #$FA            ; MAKE SURE WE GET ACK
00CC19  2  F0 02                BEQ     :+
00CC1B  2               
00CC1B  2  38                   SEC
00CC1C  2  60                   RTS                     ; ABORT IF NO ACK
00CC1D  2               :
00CC1D  2  18                   CLC
00CC1E  2  60                   RTS
00CC1F  2               
00CC1F  2               ;__GETKEY__________________________________________________________________________________________
00CC1F  2               ; Get char from Keyboard, return in A
00CC1F  2               ;__________________________________________________________________________________________________
00CC1F  2               KBD_GETKEY:
00CC1F  2  20 37 CC             JSR     KBD_DECODE
00CC22  2  90 04                BCC     :+
00CC24  2  A9 FF                LDA     #$FF            ;
00CC26  2  38                   SEC
00CC27  2  60                   RTS
00CC28  2               :
00CC28  2  AD 6C CA             LDA     KBD_KEYCODE
00CC2B  2  48                   PHA
00CC2C  2  AD 70 CA             LDA     KBD_STATUS
00CC2F  2  29 7F                AND     #$7F
00CC31  2  8D 70 CA             STA     KBD_STATUS
00CC34  2  68                   PLA
00CC35  2  18                   CLC
00CC36  2  60                   RTS
00CC37  2               
00CC37  2               ;
00CC37  2               ;__________________________________________________________________________________________________
00CC37  2               ; DECODING ENGINE
00CC37  2               ;__________________________________________________________________________________________________
00CC37  2               ;
00CC37  2               ;__________________________________________________________________________________________________
00CC37  2               KBD_DECODE:
00CC37  2               ;
00CC37  2               ;  RUN THE DECODING ENGINE UNTIL EITHER: 1) NO MORE SCANCODES ARE AVAILABLE
00CC37  2               ;  FROM THE KEYBOARD, OR 2) A DECODED KEY VALUE IS AVAILABLE
00CC37  2               ;
00CC37  2               ;  RETURNS A=0 AND Z SET IF NO KEYCODE READY, OTHERWISE A DECODED KEY VALUE IS AVAILABLE.
00CC37  2               ;  THE DECODED KEY VALUE AND KEY STATE IS STORED IN KBD_KEYCODE AND KBD_STATE.
00CC37  2               ;
00CC37  2               ;  KBD_STATUS IS NOT CLEARED AT START. IT IS THE JSR ER'S RESPONSIBILITY
00CC37  2               ;  TO CLEAR KBD_STATUS WHEN IT HAS RETRIEVED A PENDING VALUE.  IF DECODE IS JSR ED
00CC37  2               ;  WITH A KEYCODE STILL PENDING, IT WILL JUST RETURN WITHOUT DOING ANYTHING.
00CC37  2               ;
00CC37  2               ; Step 0: Check keycode buffer
00CC37  2               ;   if status[keyrdy]
00CC37  2               ;     return
00CC37  2               ;
00CC37  2               ; Step 1: Get scancode
00CC37  2               ;   if no scancode ready
00CC37  2               ;     return
00CC37  2               ;   read scancode
00CC37  2               ;
00CC37  2               ; Step 2: Detect and handle special keycodes
00CC37  2               ;   if scancode == $AA
00CC37  2               ;     *** handle hot insert somehow ***
00CC37  2               ;
00CC37  2               ; Step 3: Detect and handle scancode prefixes
00CC37  2               ;   if scancode == $E0
00CC37  2               ;     set status[extended]
00CC37  2               ;     goto Step 1
00CC37  2               ;
00CC37  2               ;   if scancode == $E1
00CC37  2               ;     *** handle pause key somehow ***
00CC37  2               ;
00CC37  2               ; Step 4: Detect and flag break event
00CC37  2               ;   *** scancode set #1 variation ***
00CC37  2               ;     set status[break] = high bit of scancode
00CC37  2               ;     clear high order bit
00CC37  2               ;     continue to Step 5
00CC37  2               ;   *** scancode set #2 variation ***
00CC37  2               ;     if scancode == $F0
00CC37  2               ;       set status[break]
00CC37  2               ;       goto Step 1
00CC37  2               ;
00CC37  2               ; Step 5: Map scancode to keycode
00CC37  2               ;   if status[extended]
00CC37  2               ;     apply extended-map[scancode] -> keycode
00CC37  2               ;   else if state[shifted]
00CC37  2               ;     apply shifted-map[scancode] -> keycode
00CC37  2               ;   else
00CC37  2               ;     apply normal-map[scancode] -> keycode
00CC37  2               ;
00CC37  2               ; Step 6: Handle modifier keys
00CC37  2               ;   if keycode is modifier (shift, ctrl, alt, win)
00CC37  2               ;     set (l/r)state[<modifier>] = not status[break]
00CC37  2               ;     clear modifier bits in state
00CC37  2               ;     set state = (lstate OR rstate OR state)
00CC37  2               ;     goto New Key
00CC37  2               ;
00CC37  2               ; Step 7: Complete procesing of key break events
00CC37  2               ;   if status[break]
00CC37  2               ;     goto New Key
00CC37  2               ;
00CC37  2               ; Step 8: Handle toggle keys
00CC37  2               ;   if keycode is toggle (capslock, numlock, scrolllock)
00CC37  2               ;     invert (XOR) state[<toggle>]
00CC37  2               ;     update keyboard LED's
00CC37  2               ;     goto New Key
00CC37  2               ;
00CC37  2               ; Step 9: Adjust keycode for control modifier
00CC37  2               ;   if state[ctrl]
00CC37  2               ;     if keycode is 'a'-'z'
00CC37  2               ;       subtract 20 (clear bit 5) from keycode
00CC37  2               ;     if keycode is '@'-'_'
00CC37  2               ;       subtract 40 (clear bit 6) from keycode
00CC37  2               ;
00CC37  2               ; Step 10: Adjust keycode for caps lock
00CC37  2               ;   if state[capslock]
00CC37  2               ;     if keycode is 'a'-'z' OR 'A'-'Z'
00CC37  2               ;       toggle (XOR) bit 5 of keycode
00CC37  2               ;
00CC37  2               ; Step 11: Handle num pad keys
00CC37  2               ;   clear state[numpad]
00CC37  2               ;   if keycode is numpad
00CC37  2               ;     set state[numpad]
00CC37  2               ;     if state[numlock]
00CC37  2               ;       toggle (XOR) bit 4 of keycode
00CC37  2               ;     apply numpad-map[keycode] -> keycode
00CC37  2               ;
00CC37  2               ; Step 12: Detect unknown/invalid keycodes
00CC37  2               ;   if keycode == $FF
00CC37  2               ;     goto New Key
00CC37  2               ;
00CC37  2               ; Step 13: Done
00CC37  2               ;   set status[keyrdy]
00CC37  2               ;   return
00CC37  2               ;
00CC37  2               ; New Key:
00CC37  2               ;   clear status
00CC37  2               ;   goto Step 1
00CC37  2               ;
00CC37  2               KBD_DEC0:                       ; CHECK KEYCODE BUFFER
00CC37  2  AD 70 CA             LDA     KBD_STATUS      ; GET CURRENT STATUS
00CC3A  2  29 80                AND     #KBD_KEYRDY     ; ISOLATE KEY READY FLAG
00CC3C  2  F0 02                BEQ     KBD_DEC1
00CC3E  2  38                   SEC
00CC3F  2  60                   RTS                     ; ABORT IF KEY IS ALREADY PENDING
00CC40  2               
00CC40  2               KBD_DEC1:                       ; PROCESS NEXT SCANCODE
00CC40  2  20 AA CB             JSR     KBD_GETDATAX    ; GET THE SCANCODE
00CC43  2  90 02                BCC     KBD_DEC2
00CC45  2  38                   SEC
00CC46  2  60                   RTS                     ; NO KEY READY, RETURN WITH A=0, SET ERROR
00CC47  2               
00CC47  2               KBD_DEC2:                       ; DETECT AND HANDLE SPECIAL KEYCODES
00CC47  2  8D 6B CA             STA     KBD_SCANCODE    ; SAVE SCANCODE
00CC4A  2  C9 AA                CMP     #$AA            ; KEYBOARD INSERTION?
00CC4C  2  D0 0F                BNE     KBD_DEC3        ; NOPE, BYPASS
00CC4E  2  20 1E CE             JSR     LDELAY          ; WAIT A BIT
00CC51  2  20 B7 CB             JSR     KBD_RESET       ; RESET KEYBOARD
00CC54  2  20 D6 CB             JSR     KBD_SETLEDS     ; SET LEDS
00CC57  2  20 00 CC             JSR     KBD_SETRPT      ; SET REPEAT RATE
00CC5A  2  4C 04 CE             JMP     KBD_DECNEW      ; RESTART THE ENGINE
00CC5D  2               
00CC5D  2               KBD_DEC3:                       ; DETECT AND HANDLE SCANCODE PREFIXES
00CC5D  2  C9 E0                CMP     #$E0            ; EXTENDED KEY PREFIX $E0?
00CC5F  2  D0 0D                BNE     KBD_DEC3B       ; NOPE MOVE ON
00CC61  2  48                   PHA
00CC62  2  AD 70 CA             LDA     KBD_STATUS      ; GET STATUS
00CC65  2  09 01                ORA     #KBD_EXT        ; SET EXTENDED BIT
00CC67  2  8D 70 CA             STA     KBD_STATUS      ; SAVE STATUS
00CC6A  2  68                   PLA
00CC6B  2  4C 40 CC             JMP     KBD_DEC1        ; LOOP TO DO NEXT SCANCODE
00CC6E  2               
00CC6E  2               KBD_DEC3B:                      ; HANDLE SCANCODE PREFIX $E1 (PAUSE KEY)
00CC6E  2  C9 E1                CMP     #$E1            ; EXTENDED KEY PREFIX $E1
00CC70  2  D0 10                BNE     KBD_DEC4        ; NOPE MOVE ON
00CC72  2  A9 EE                LDA     #$EE            ; MAP TO KEYCODE $EE
00CC74  2  8D 6C CA             STA     KBD_KEYCODE     ; SAVE IT
00CC77  2               ; SWALLOW NEXT 7 SCANCODES
00CC77  2  A2 07                LDX     #7              ; LOOP 7 TIMES
00CC79  2               KBD_DEC3B1:
00CC79  2  20 7B CB             JSR     KBD_GETDATA     ; RETRIEVE NEXT SCANCODE
00CC7C  2  CA                   DEX
00CC7D  2  D0 FA                BNE     KBD_DEC3B1      ; LOOP AS NEEDED
00CC7F  2  4C DC CC             JMP     KBD_DEC6        ; RESUME AFTER MAPPING
00CC82  2               
00CC82  2               KBD_DEC4:                       ; DETECT AND FLAG BREAK EVENT
00CC82  2  C9 F0                CMP     #$F0            ; BREAK (KEY UP) PREFIX?
00CC84  2  D0 0D                BNE     KBD_DEC5        ; NOPE MOVE ON
00CC86  2  48                   PHA
00CC87  2  AD 70 CA             LDA     KBD_STATUS      ; GET STATUS
00CC8A  2  09 02                ORA     #KBD_BREAK      ; SET BREAK BIT
00CC8C  2  8D 70 CA             STA     KBD_STATUS      ; SAVE STATUS
00CC8F  2  68                   PLA
00CC90  2  4C 40 CC             JMP     KBD_DEC1        ; LOOP TO DO NEXT SCANCODE
00CC93  2               
00CC93  2               KBD_DEC5:                       ; MAP SCANCODE TO KEYCODE
00CC93  2  AD 70 CA             LDA     KBD_STATUS      ; GET STATUS
00CC96  2  29 01                AND     #KBD_EXT        ; EXTENDED BIT SET?
00CC98  2  F0 20                BEQ     KBD_DEC5C       ; NOPE, MOVE ON
00CC9A  2               
00CC9A  2               ; PERFORM EXTENDED KEY MAPPING
00CC9A  2  AE 6B CA             LDX     KBD_SCANCODE    ; GET SCANCODE
00CC9D  2               KBD_DEC5A:
00CC9D  2  BD CF CF             LDA     KBD_MAPEXT,X    ; GET FIRST BYTE OF PAIR FROM EXT MAP TABLE
00CCA0  2  E8                   INX
00CCA1  2  C9 00                CMP     #$00            ; END OF TABLE?
00CCA3  2  F0 09                BEQ     :+              ; UNKNOWN OR BOGUS, START OVER
00CCA5  2  CD 6B CA             CMP     KBD_SCANCODE    ; DOES MATCH BYTE EQUAL SCANCODE?
00CCA8  2  F0 07                BEQ     KBD_DEC5B       ; YES! JUMP OUT
00CCAA  2  E8                   INX                     ; BUMP TO START OF NEXT PAIR
00CCAB  2  4C 9D CC             JMP     KBD_DEC5A       ; LOOP TO CHECK NEXT TABLE ENTRY
00CCAE  2               :
00CCAE  2  4C 04 CE             JMP     KBD_DECNEW
00CCB1  2               KBD_DEC5B:
00CCB1  2  BD CF CF             LDA     KBD_MAPEXT,X    ; GET THE KEYCODE VIA MAPPING TABLE
00CCB4  2  8D 6C CA             STA     KBD_KEYCODE     ; SAVE IT
00CCB7  2  4C DC CC             JMP     KBD_DEC6
00CCBA  2               
00CCBA  2               KBD_DEC5C:                      ; PERFORM REGULAR KEY (NOT EXTENDED) KEY MAPPING
00CCBA  2  AD 6B CA             LDA     KBD_SCANCODE    ; GET THE SCANCODE
00CCBD  2  C9 85                CMP     #KBD_MAPSIZ     ; COMPARE TO SIZE OF TABLE
00CCBF  2  F0 02                BEQ     :+
00CCC1  2  B0 19                BCS     KBD_DEC6        ; PAST END, SKIP OVER LOOKUP
00CCC3  2               :
00CCC3  2               ; SETUP POINTER TO MAPPING TABLE BASED ON SHIFTED OR UNSHIFTED STATE
00CCC3  2  AD 6D CA             LDA     KBD_STATE       ; GET STATE
00CCC6  2  29 01                AND     #KBD_SHIFT      ; SHIFT ACTIVE?
00CCC8  2  F0 09                BEQ     KBD_DEC5D       ; NON-SHIFTED, MOVE ON
00CCCA  2               
00CCCA  2  AE 6B CA             LDX     KBD_SCANCODE    ; GET THE SCANCODE
00CCCD  2  BD 4A CF             LDA     KBD_MAPSHIFT,X  ; GET SHIFTED
00CCD0  2  4C D9 CC             JMP     :+
00CCD3  2               KBD_DEC5D:
00CCD3  2  AE 6B CA             LDX     KBD_SCANCODE    ; GET THE SCANCODE
00CCD6  2  BD C5 CE             LDA     KBD_MAPSTD,X    ; GET STANDARD
00CCD9  2               :
00CCD9  2  8D 6C CA             STA     KBD_KEYCODE     ; SAVE KEYCODE
00CCDC  2               
00CCDC  2               KBD_DEC6:                       ; HANDLE MODIFIER KEYS
00CCDC  2  AD 6C CA             LDA     KBD_KEYCODE     ; MAKE SURE WE HAVE KEYCODE
00CCDF  2  C9 B8                CMP     #$B8            ; END OF MODIFIER KEYS
00CCE1  2  B0 5F                BCS     KBD_DEC7        ; BYPASS MODIFIER KEY CHECKING
00CCE3  2  C9 B0                CMP     #$B0            ; START OF MODIFIER KEYS
00CCE5  2  90 5B                BCC     KBD_DEC7        ; BYPASS MODIFIER KEY CHECKING
00CCE7  2               
00CCE7  2  A2 04                LDX     #4              ; LOOP COUNTER TO LOOP THRU 4 MODIFIER BITS
00CCE9  2  38                   SEC
00CCEA  2  E9 AF                SBC     #$AF            ; SETUP A TO DECREMENT THROUGH MODIFIER VALUES
00CCEC  2  8D 6A CA             STA     TMPKEY
00CCEF  2  A9 00                LDA     #$00            ; SETUP A TO ROATE THROUGH MODIFIER STATE BITS
00CCF1  2  38                   SEC                     ; SET CARRY FOR ROTATE
00CCF2  2               
00CCF2  2               KBD_DEC6A:
00CCF2  2  2A                   ROL     A               ; SHIFT TO NEXT MODIFIER STATE BIT
00CCF3  2  CE 6A CA             DEC     TMPKEY          ; L-MODIFIER?
00CCF6  2  F0 0B                BEQ     KBD_DEC6B       ; YES, HANDLE L-MODIFIER MAKE/BREAK
00CCF8  2  CE 6A CA             DEC     TMPKEY          ; R-MODIFIER?
00CCFB  2  F0 0B                BEQ     KBD_DEC6C       ; YES, HANDLE R-MODIFIER MAKE/BREAK
00CCFD  2  CA                   DEX
00CCFE  2  D0 F2                BNE     KBD_DEC6A       ; LOOP THRU 4 MODIFIER BITS
00CD00  2  4C 42 CD             JMP     KBD_DEC7        ; FAILSAFE, SHOULD NEVER GET HERE!
00CD03  2               
00CD03  2               KBD_DEC6B:
00CD03  2  A2 00                LDX     #0              ; POINT TO LEFT STATE BYTE
00CD05  2  4C 0D CD             JMP     KBD_DEC6D       ; CONTINUE
00CD08  2               
00CD08  2               KBD_DEC6C:
00CD08  2  A2 01                LDX     #1              ; POINT TO RIGHT STATE BYTE
00CD0A  2  4C 0D CD             JMP     KBD_DEC6D       ; CONTINUE
00CD0D  2               
00CD0D  2               KBD_DEC6D:                      ; BRANCH BASED ON WHETHER THIS IS A MAKE OR BREAK EVENT
00CD0D  2  AD 70 CA             LDA     KBD_STATUS      ; GET STATUS FLAGS
00CD10  2  29 02                AND     #KBD_BREAK      ; BREAK EVENT?
00CD12  2  F0 03                BEQ     KBD_DEC6E       ; NO, HANDLE A MODIFIER KEY MAKE EVENT
00CD14  2  4C 23 CD             JMP     KBD_DEC6F       ; YES, HANDLE A MODIFIER BREAK EVENT
00CD17  2               
00CD17  2               KBD_DEC6E:                      ; HANDLE STATE KEY MAKE EVENT
00CD17  2  AD 6A CA             LDA     TMPKEY
00CD1A  2  1D 6E CA             ORA     KBD_LSTATE,X    ; OR IN THE BIT TO SET
00CD1D  2  9D 6E CA             STA     KBD_LSTATE,X    ; SAVE THE RESULT
00CD20  2  4C 31 CD             JMP     KBD_DEC6G       ; CONTINUE
00CD23  2               
00CD23  2               KBD_DEC6F:                      ; HANDLE STATE KEY BREAK EVENT
00CD23  2  AD 6A CA             LDA     TMPKEY
00CD26  2  49 FF                EOR     #$FF            ; FLIP ALL BITS TO SETUP FOR A CLEAR OPERATION
00CD28  2  3D 6E CA             AND     KBD_LSTATE,X    ; AND IN THE FLIPPED BITS TO CLEAR DESIRED BIT
00CD2B  2  9D 6E CA             STA     KBD_LSTATE,X    ; SAVE THE RESULT
00CD2E  2  4C 31 CD             JMP     KBD_DEC6G       ; CONTINUE
00CD31  2               
00CD31  2               KBD_DEC6G:                      ; COALESCE L/R STATE FLAGS
00CD31  2  AD 6D CA             LDA     KBD_STATE       ; GET EXISTING STATE BITS
00CD34  2  29 F0                AND     #$F0            ; GET RID OF OLD MODIFIER BITS
00CD36  2  0D 6E CA             ORA     KBD_LSTATE      ; MERGE IN LEFT STATE BITS
00CD39  2  0D 6F CA             ORA     KBD_RSTATE      ; MERGE IN RIGHT STATE BITS
00CD3C  2  8D 6D CA             STA     KBD_STATE       ; SAVE IT
00CD3F  2               :
00CD3F  2  4C 04 CE             JMP     KBD_DECNEW      ; DONE WITH CURRENT KEYSTROKE
00CD42  2               
00CD42  2               KBD_DEC7:                       ; COMPLETE PROCESSING OF EXTENDED AND KEY BREAK EVENTS
00CD42  2  AD 70 CA             LDA     KBD_STATUS      ; GET CURRENT STATUS FLAGS
00CD45  2  29 02                AND     #KBD_BREAK      ; IS THIS A KEY BREAK EVENT?
00CD47  2  D0 F6                BNE     :-              ; PROCESS NEXT KEY
00CD49  2               
00CD49  2               KBD_DEC8:                       ; HANDLE TOGGLE KEYS
00CD49  2  AD 6C CA             LDA     KBD_KEYCODE     ; GET THE CURRENT KEYCODE INTO A
00CD4C  2  A0 40                LDY     #KBD_CAPSLCK    ; SETUP E WITH CAPS LOCK STATE BIT
00CD4E  2  C9 BC                CMP     #$BC            ; IS THIS THE CAPS LOCK KEY?
00CD50  2  F0 0F                BEQ     KBD_DEC8A       ; YES, GO TO BIT SET ROUTINE
00CD52  2  A0 20                LDY     #KBD_NUMLCK     ; SETUP E WITH NUM LOCK STATE BIT
00CD54  2  C9 BD                CMP     #$BD            ; IS THIS THE NUM LOCK KEY?
00CD56  2  F0 09                BEQ     KBD_DEC8A       ; YES, GO TO BIT SET ROUTINE
00CD58  2  A0 10                LDY     #KBD_SCRLCK     ; SETUP E WITH SCROLL LOCK STATE BIT
00CD5A  2  C9 BE                CMP     #$BE            ; IS THIS THE SCROLL LOCK KEY?
00CD5C  2  F0 03                BEQ     KBD_DEC8A       ; YES, GO TO BIT SET ROUTINE
00CD5E  2  4C 6E CD             JMP     KBD_DEC9        ; NOT A TOGGLE KEY, CONTINUE
00CD61  2               
00CD61  2               KBD_DEC8A:                      ; RECORD THE TOGGLE
00CD61  2  98                   TYA
00CD62  2  4D 6D CA             EOR     KBD_STATE       ; SET THE TOGGLE KEY BIT FROM ABOVE
00CD65  2  8D 6D CA             STA     KBD_STATE       ; SAVE IT
00CD68  2  20 D6 CB             JSR     KBD_SETLEDS     ; UPDATE LED LIGHTS ON KBD
00CD6B  2  4C 04 CE             JMP     KBD_DECNEW      ; RESTART DECODER FOR A NEW KEY
00CD6E  2               
00CD6E  2               KBD_DEC9:                       ; ADJUST KEYCODE FOR CONTROL MODIFIER
00CD6E  2  AD 6D CA             LDA     KBD_STATE       ; GET THE CURRENT STATE BITS
00CD71  2  29 02                AND     #KBD_CTRL       ; CHECK THE CONTROL BIT
00CD73  2  F0 1E                BEQ     KBD_DEC10       ; CONTROL KEY NOT PRESSED, MOVE ON
00CD75  2  AD 6C CA             LDA     KBD_KEYCODE     ; GET CURRENT KEYCODE IN A
00CD78  2  C9 61                CMP     #'a'            ; COMPARE TO LOWERCASE A
00CD7A  2  90 08                BCC     KBD_DEC9A       ; BELOW IT, BYPASS
00CD7C  2  C9 7A                CMP     #'z'            ; COMPARE TO LOWERCASE Z+1
00CD7E  2  F0 02                BEQ     :+
00CD80  2  B0 02                BCS     KBD_DEC9A       ; ABOVE IT, BYPASS
00CD82  2               :
00CD82  2  29 DF                AND     #$DF            ; KEYCODE IN LOWERCASE A-Z RANGE CLEAR BIT 5 TO MAKE IT UPPERCASE
00CD84  2               KBD_DEC9A:
00CD84  2  C9 40                CMP     #'@'            ; COMPARE TO @
00CD86  2  90 0B                BCC     KBD_DEC10       ; BELOW IT, BYPASS
00CD88  2  C9 5F                CMP     #'_'            ; COMPARE TO _+1
00CD8A  2  F0 02                BEQ     :+
00CD8C  2  B0 05                BCS     KBD_DEC10       ; ABOVE IT, BYPASS
00CD8E  2               :
00CD8E  2  29 BF                AND     #$BF            ; CONVERT TO CONTROL VALUE BY CLEARING BIT 6
00CD90  2  8D 6C CA             STA     KBD_KEYCODE     ; UPDATE KEYCODE TO CONTROL VALUE
00CD93  2               
00CD93  2               KBD_DEC10:                      ; ADJUST KEYCODE FOR CAPS LOCK
00CD93  2  AD 6D CA             LDA     KBD_STATE       ; LOAD THE STATE FLAGS
00CD96  2  29 40                AND     #KBD_CAPSLCK    ; CHECK CAPS LOCK
00CD98  2  F0 25                BEQ     KBD_DEC11       ; CAPS LOCK NOT ACTIVE, MOVE ON
00CD9A  2  AD 6C CA             LDA     KBD_KEYCODE     ; GET THE CURRENT KEYCODE VALUE
00CD9D  2  C9 61                CMP     #'a'            ; COMPARE TO LOWERCASE A
00CD9F  2  90 09                BCC     KBD_DEC10A      ; BELOW IT, BYPASS
00CDA1  2  C9 7A                CMP     #'z'            ; COMPARE TO LOWERCASE Z+1
00CDA3  2  F0 02                BEQ     :+
00CDA5  2  B0 03                BCS     KBD_DEC10A      ; ABOVE IT, BYPASS
00CDA7  2               :
00CDA7  2  4C B7 CD             JMP     KBD_DEC10B      ; IN RANGE LOWERCASE A-Z, GO TO CASE SWAPPING LOGIC
00CDAA  2               KBD_DEC10A:
00CDAA  2  C9 41                CMP     #'A'            ; COMPARE TO UPPERCASE A
00CDAC  2  90 11                BCC     KBD_DEC11       ; BELOW IT, BYPASS
00CDAE  2  C9 5A                CMP     #'Z'            ; COMPARE TO UPPERCASE Z+1
00CDB0  2  F0 02                BEQ     :+
00CDB2  2  B0 0B                BCS     KBD_DEC11       ; ABOVE IT, BYPASS
00CDB4  2               :
00CDB4  2  4C B7 CD             JMP     KBD_DEC10B      ; IN RANGE UPPERCASE A-Z, GO TO CASE SWAPPING LOGIC
00CDB7  2               KBD_DEC10B:
00CDB7  2  AD 6C CA             LDA     KBD_KEYCODE     ; GET THE CURRENT KEYCODE
00CDBA  2  49 20                EOR     #$20            ; FLIP BIT 5 TO SWAP UPPER/LOWER CASE
00CDBC  2  8D 6C CA             STA     KBD_KEYCODE     ; SAVE IT
00CDBF  2               
00CDBF  2               KBD_DEC11:                      ; HANDLE NUM PAD KEYS
00CDBF  2  AD 6D CA             LDA     KBD_STATE       ; GET THE CURRENT STATE FLAGS
00CDC2  2  29 7F                AND     #NOT_KBD_NUMPAD ; ASSUME NOT A NUMPAD KEY, CLEAR THE NUMPAD BIT
00CDC4  2  8D 6D CA             STA     KBD_STATE       ; SAVE IT
00CDC7  2               
00CDC7  2  AD 6C CA             LDA     KBD_KEYCODE     ; GET THE CURRENT KEYCODE
00CDCA  2  29 E0                AND     #%11100000      ; ISOLATE TOP 3 BITS
00CDCC  2  C9 C0                CMP     #%11000000      ; IS IN NUMPAD RANGE?
00CDCE  2  D0 21                BNE     KBD_DEC12       ; NOPE, GET OUT
00CDD0  2               
00CDD0  2  AD 6D CA             LDA     KBD_STATE       ; LOAD THE CURRENT STATE FLAGS
00CDD3  2  09 80                ORA     #KBD_NUMPAD     ; TURN ON THE NUMPAD BIT
00CDD5  2  8D 6D CA             STA     KBD_STATE       ; SAVE IT
00CDD8  2               
00CDD8  2  29 20                AND     #KBD_NUMLCK     ; IS NUM LOCK BIT SET?
00CDDA  2  F0 08                BEQ     KBD_DEC11A      ; NO, SKIP NUMLOCK PROCESSING
00CDDC  2  AD 6C CA             LDA     KBD_KEYCODE     ; GET THE KEYCODE
00CDDF  2  49 10                EOR     #$10            ; FLIP VALUES FOR NUMLOCK
00CDE1  2  8D 6C CA             STA     KBD_KEYCODE     ; SAVE IT
00CDE4  2               
00CDE4  2               KBD_DEC11A:                     ; APPLY NUMPAD MAPPING
00CDE4  2  AD 6C CA             LDA     KBD_KEYCODE     ; GET THE CURRENT KEYCODE
00CDE7  2  38                   SEC
00CDE8  2  E9 C0                SBC     #$C0            ; KEYCODES START AT $C0
00CDEA  2  AA                   TAX
00CDEB  2  BD FD CF             LDA     KBD_MAPNUMPAD,X ; GET IT IN A
00CDEE  2  8D 6C CA             STA     KBD_KEYCODE     ; SAVE IT
00CDF1  2               
00CDF1  2               KBD_DEC12:                      ; DETECT UNKNOWN/INVALID KEYCODES
00CDF1  2  AD 6C CA             LDA     KBD_KEYCODE     ; GET THE FINAL KEYCODE
00CDF4  2  C9 FF                CMP     #$FF            ; IS IT $FF (UNKNOWN/INVALID)
00CDF6  2  F0 0C                BEQ     KBD_DECNEW      ; IF SO, JUST RESTART THE ENGINE
00CDF8  2               
00CDF8  2               KBD_DEC13:                      ; DONE - RECORD RESULTS
00CDF8  2  AD 70 CA             LDA     KBD_STATUS      ; GET CURRENT STATUS
00CDFB  2  09 80                ORA     #KBD_KEYRDY     ; SET KEY READY BIT
00CDFD  2  8D 70 CA             STA     KBD_STATUS      ; SAVE IT
00CE00  2  A9 00                LDA     #$00            ; A=0
00CE02  2  18                   CLC                     ; SIGNAL SUCCESS WITH A=1, CARRY CLEAR
00CE03  2  60                   RTS
00CE04  2               
00CE04  2               KBD_DECNEW:                     ; START NEW KEYPRESS (CLEAR ALL STATUS BITS)
00CE04  2  A9 00                LDA     #$00            ; A=0
00CE06  2  8D 70 CA             STA     KBD_STATUS      ; CLEAR STATUS
00CE09  2  4C 40 CC             JMP     KBD_DEC1        ; RESTART THE ENGINE
