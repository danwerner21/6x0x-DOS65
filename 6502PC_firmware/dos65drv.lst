00D01D  2               LPT_OUT:
00D01D  2  48                   PHA
00D01E  2  A2 FF                LDX     #<LPT_WAITTO
00D020  2  A0 30                LDY     #>LPT_WAITTO
00D022  2               :
00D022  2  20 4A D0             JSR     LPT_OST         ; READY TO SEND?
00D025  2  D0 0D                BNE     :+              ; GO IF READY
00D027  2  CA                   DEX
00D028  2  E0 00                CPX     #$00
00D02A  2  D0 F6                BNE     :-              ; LOOP IF NOT READY
00D02C  2  88                   DEY
00D02D  2  C0 00                CPY     #$00
00D02F  2  D0 F1                BNE     :-              ; LOOP IF NOT READY
00D031  2  68                   PLA
00D032  2  38                   SEC                     ; SIGNAL ERROR
00D033  2  60                   RTS
00D034  2               :
00D034  2  68                   PLA
00D035  2  8D F0 E3             STA     LPT_0           ; OUTPUT TO PORT 0 (DATA)
00D038  2  A9 0D                LDA     #%00001101      ; SELECT & STROBE, LEDS OFF
00D03A  2  8D F2 E3             STA     LPT_2           ; OUTPUT DATA TO PORT
00D03D  2  20 0C CE             JSR     DELAY
00D040  2  A9 0C                LDA     #%00001100      ; SELECT, LEDS OFF
00D042  2  8D F2 E3             STA     LPT_2           ; OUTPUT DATA TO PORT
00D045  2  20 0C CE             JSR     DELAY
00D048  2  18                   CLC
00D049  2  60                   RTS
