00C5F8  2               
00C5F8  2  C9 14                CMP     #$14            ; SUCCESS?
00C5FA  2  D0 30                BNE     CHUSB_CMDERR    ; HANDLE CMD ERROR
00C5FC  2  20 32 C6             JSR     CH_CMD_RD       ; SEND READ USB DATA CMD
00C5FF  2  20 04 C5             JSR     CH_RD           ; GET RD DATA LEN
00C602  2               
00C602  2  C9 08                CMP     #$08            ; MAKE SURE IT IS 8
00C604  2  D0 26                BNE     CHUSB_CMDERR    ; HANDLE CMD ERROR
00C606  2               
00C606  2  20 04 C5             JSR     CH_RD
00C609  2  8D 00 04             STA     hstbuf
00C60C  2  20 04 C5             JSR     CH_RD
00C60F  2  8D 01 04             STA     hstbuf+1
00C612  2  20 04 C5             JSR     CH_RD
00C615  2  8D 02 04             STA     hstbuf+2
00C618  2  20 04 C5             JSR     CH_RD
00C61B  2  8D 03 04             STA     hstbuf+3
00C61E  2  20 04 C5             JSR     CH_RD
