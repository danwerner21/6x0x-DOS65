00C64D  2  A9 54                LDA     #CH_CMD_DSKRD   ; DISK READ COMMAND
00C64F  2  20 ED C6             JSR     CHUSB_RWSTART   ; SEND CMD AND LBA
00C652  2               ;
00C652  2               ; READ THE SECTOR IN 64 BYTE CHUNKS
00C652  2  A9 00                LDA     #00
00C654  2  8D 4C C6             STA     DSKBUFCNT
00C657  2               CHUSB_READ1:
00C657  2  AE 4C C6             LDX     DSKBUFCNT
00C65A  2  BD 3C C6             LDA     DSKBUFTMP,X
00C65D  2  85 3F                STA     TEMPWORD2
00C65F  2  E8                   INX
00C660  2  BD 3C C6             LDA     DSKBUFTMP,X
00C663  2  85 40                STA     TEMPWORD2+1
00C665  2  E8                   INX
00C666  2  8E 4C C6             STX     DSKBUFCNT
00C669  2  20 2B C5             JSR     CH_POLL         ; WAIT FOR DATA READY
00C66C  2  C9 1D                CMP     #$1D            ; DATA READY TO READ?
00C66E  2  D0 BE                BNE     CHUSB_IOERR     ; HANDLE IO ERROR
00C670  2  20 32 C6             JSR     CH_CMD_RD       ; SEND READ USB DATA CMD
00C673  2  20 04 C5             JSR     CH_RD           ; READ DATA BLOCK LENGTH
00C676  2  C9 40                CMP     #64             ; AS EXPECTED?
00C678  2  D0 B4                BNE     CHUSB_IOERR     ; IF NOT, HANDLE ERROR
00C67A  2  A0 00                LDY     #0              ; 8 CHUNKS OF 64 FOR 512 BYTE SECTOR
00C67C  2               ; BYTE READ LOOP
00C67C  2               
00C67C  2               CHUSB_READ2:
00C67C  2  20 04 C5             JSR     CH_RD           ; GET NEXT BYTE
00C67F  2  91 3F                STA     (TEMPWORD2),Y   ; SAVE IT
00C681  2  C8                   INY
00C682  2  C0 40                CPY     #64
00C684  2  D0 F6                BNE     CHUSB_READ2     ; LOOP AS NEEDED
00C686  2               ;
00C686  2               ; PREPARE FOR NEXT CHUNK
00C686  2  A9 55                LDA     #CH_CMD_DSKRDGO ; CONTINUE DISK READ
00C688  2  20 F9 C4             JSR     CH_CMD          ; SEND IT
00C68B  2  AE 4C C6             LDX     DSKBUFCNT
00C68E  2  E0 10                CPX     #16
00C690  2  D0 C5                BNE     CHUSB_READ1     ; LOOP TILL DONE
00C692  2               ;
00C692  2               ; FINAL CHECK FOR COMPLETION & SUCCESS
00C692  2  20 2B C5             JSR     CH_POLL         ; WAIT FOR COMPLETION
00C695  2  C9 14                CMP     #$14            ; SUCCESS?
00C697  2  D0 95                BNE     CHUSB_IOERR     ; IF NOT, HANDLE ERROR
00C699  2               ;
00C699  2  A9 00                LDA     #$00
00C69B  2  60                   RTS
00C69C  2               ;
00C69C  2               ;
00C69C  2               ;
00C69C  2               CH_WRITESEC:
00C69C  2  A9 56                LDA     #CH_CMD_DSKWR   ; DISK WRITE COMMAND
00C69E  2  20 ED C6             JSR     CHUSB_RWSTART   ; SEND CMD AND LBA
00C6A1  2               ;
00C6A1  2               ; WRITE THE SECTOR IN 64 BYTE CHUNKS
00C6A1  2  A9 00                LDA     #00
00C6A3  2  8D 4C C6             STA     DSKBUFCNT
00C6A6  2               CHUSB_WRITE1:
00C6A6  2  AE 4C C6             LDX     DSKBUFCNT
00C6A9  2  BD 3C C6             LDA     DSKBUFTMP,X
00C6AC  2  85 3F                STA     TEMPWORD2
00C6AE  2  E8                   INX
00C6AF  2  BD 3C C6             LDA     DSKBUFTMP,X
00C6B2  2  85 40                STA     TEMPWORD2+1
00C6B4  2  E8                   INX
00C6B5  2  8E 4C C6             STX     DSKBUFCNT
00C6B8  2  20 2B C5             JSR     CH_POLL         ; WAIT FOR DATA READY
00C6BB  2  C9 1E                CMP     #$1E            ; DATA READY TO WRITE
00C6BD  2  D0 2B                BNE     CHUSB_IOERR1    ; HANDLE IO ERROR
00C6BF  2  20 37 C6             JSR     CH_CMD_WR       ; SEND WRITE USB DATA CMD
00C6C2  2  A9 40                LDA     #64             ; 64 BYTE CHUNK
00C6C4  2  20 08 C5             JSR     CH_WR           ; SEND DATA BLOCK LENGTH
00C6C7  2  A0 00                LDY     #0              ; 8 CHUNKS OF 64 FOR 512 BYTE SECTOR
00C6C9  2               ;
00C6C9  2               ; BYTE WRITE LOOP
00C6C9  2               CHUSB_WRITE2:
00C6C9  2  B1 3F                LDA     (TEMPWORD2),Y   ; GET NEXT BYTE
00C6CB  2  20 08 C5             JSR     CH_WR           ; WRITE NEXT BYTE
00C6CE  2  C8                   INY
00C6CF  2  C0 40                CPY     #64
00C6D1  2  D0 F6                BNE     CHUSB_WRITE2    ; LOOP AS NEEDED
00C6D3  2               ;
00C6D3  2               ; PREPARE FOR NEXT CHUNK
00C6D3  2  A9 57                LDA     #CH_CMD_DSKWRGO ; CONTINUE DISK READ
00C6D5  2  20 F9 C4             JSR     CH_CMD          ; SEND IT
00C6D8  2  AE 4C C6             LDX     DSKBUFCNT
00C6DB  2  E0 10                CPX     #16
00C6DD  2  D0 C7                BNE     CHUSB_WRITE1    ; LOOP TILL DONE
00C6DF  2               ;
00C6DF  2               ; FINAL CHECK FOR COMPLETION & SUCCESS
00C6DF  2  20 2B C5             JSR     CH_POLL         ; WAIT FOR COMPLETION
00C6E2  2  C9 14                CMP     #$14            ; SUCCESS?
00C6E4  2  D0 04                BNE     CHUSB_IOERR1    ; IF NOT, HANDLE ERROR
00C6E6  2               ;
00C6E6  2  A9 00                LDA     #$00
00C6E8  2  18                   CLC                     ; SIGNAL SUCCESS
00C6E9  2  60                   RTS
00C6EA  2               CHUSB_IOERR1:
00C6EA  2  4C 2E C6             JMP     CHUSB_IOERR
00C6ED  2               ;
00C6ED  2               ; INITIATE A DISK SECTOR READ/WRITE OPERATION
00C6ED  2               ; A: READ OR WRITE OPCODE
00C6ED  2               ;
00C6ED  2               CHUSB_RWSTART:
00C6ED  2  48                   PHA
00C6EE  2  20 90 C3             JSR     IDE_CONVERT_SECTOR_LBA
00C6F1  2  68                   PLA
00C6F2  2  20 F9 C4             JSR     CH_CMD          ; SEND R/W COMMAND
00C6F5  2               ;
00C6F5  2               ; SEND LBA, 4 BYTES, LITTLE ENDIAN
00C6F5  2  AD 12 06             LDA     debsehd
00C6F8  2  20 08 C5             JSR     CH_WR           ; SEND BYTE
00C6FB  2  AD 10 06             LDA     debcyll
00C6FE  2  20 08 C5             JSR     CH_WR           ; SEND BYTE
00C701  2  AD 11 06             LDA     debcylm         ;
00C704  2  20 08 C5             JSR     CH_WR           ; SEND BYTE
00C707  2  A9 00                LDA     #0              ;
00C709  2  20 08 C5             JSR     CH_WR           ; SEND BYTE
00C70C  2               ; REQUEST 1 SECTOR
00C70C  2  A9 01                LDA     #1              ;
00C70E  2  20 08 C5             JSR     CH_WR           ; SEND BYTE
00C711  2  60                   RTS
