00D06F  1               ;__WRSTR_______________________________________________________
00D06F  1               ;
00D06F  1               ; OUTPUT THE STRING POINTED TO BY OUTSTR TO THE SCREEN
00D06F  1               ;
00D06F  1               ;______________________________________________________________
00D06F  1               WRSTR:
00D06F  1  A0 00                LDY     #$00            ; LOAD $00 INTO Y
00D071  1               OUTSTRLP:
00D071  1  B1 41                LDA     (STRPTR),Y      ; LOAD NEXT CHAR FROM STRING INTO ACC
00D073  1  C9 00                CMP     #$00            ; IS NULL?
00D075  1  F0 0C                BEQ     ENDOUTSTR       ; YES, END PRINT OUT
00D077  1  20 B5 C0             JSR     WRSER1          ; PRINT CHAR IN ACC
00D07A  1  E6 41                INC     STRPTR
00D07C  1  D0 F3                BNE     OUTSTRLP
00D07E  1  E6 42                INC     STRPTR+1
00D080  1  4C 71 D0             JMP     OUTSTRLP        ; DO NEXT CHAR
00D083  1               ENDOUTSTR:
00D083  1  60                   RTS                     ; RETURN
00D084  1               
00D084  1               PRINT_BYTE:
00D084  1  8E A9 D0             STX     SAVX            ; save X
00D087  1  20 94 D0             JSR     ASCTWO          ; get hex chars for byte in X (lower) and A (upper)
00D08A  1  20 B5 C0             JSR     WRSER1          ; output upper nybble
00D08D  1  8A                   TXA                     ; transfer lower to A
00D08E  1  AE A9 D0             LDX     SAVX            ; restore X
00D091  1  4C B5 C0             JMP     WRSER1          ; output lower nybble
00D094  1               ASCTWO:
00D094  1  48                   PHA                     ; save byte
00D095  1  20 9E D0             JSR     ASCII           ; do low nybble
00D098  1  AA                   TAX                     ; save in X
00D099  1  68                   PLA                     ; restore byte
00D09A  1  4A                   LSR     A               ; shift upper nybble down
00D09B  1  4A                   LSR     A
00D09C  1  4A                   LSR     A
00D09D  1  4A                   LSR     A
00D09E  1               ; convert low nybble in A to hex digit
00D09E  1               ASCII:
00D09E  1  29 0F                AND     #$0F            ; clear upper nibble
00D0A0  1  C9 0A                CMP     #$0A            ; if less than A, skip next step
00D0A2  1  90 02                BCC     ASC1
00D0A4  1  69 06                ADC     #6              ; skip ascii chars between 9 and A
00D0A6  1               ASC1:
00D0A6  1  69 30                ADC     #$30            ; add ascii char 0 to value
00D0A8  1  60                   RTS
00D0A9  1               SAVX:
00D0A9  1  00                   .BYTE   00
00D0A9  1               
